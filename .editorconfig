root = true

# ----------------------------------------------
# SuperUI code style
# ----------------------------------------------
[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4

# BL0007: Component parameter should be auto property.
# These parameters are intentionally non-auto: their setters trigger
# StateHasChanged / coerce values (Open, ActiveTabIndex, obsolete TagName alias).
[SuperUI/Components/**]
dotnet_diagnostic.BL0007.severity = none