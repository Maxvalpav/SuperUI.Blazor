@inherits SuperUI.Tests.BunitContext

@code {
    private List<Person> People => TestData.People();

    private IRenderedComponent<SgDataGrid<Person>> RenderGrid(
        bool allowMultiSelect = true,
        EventCallback<IReadOnlyCollection<Person>>? selectionChanged = null)
    {
        JSInterop.SetupModule("/_content/SuperUI/superui.js")
                 .SetupVoid("init", _ => true);
        return Render<SgDataGrid<Person>>(
            @<SgDataGrid TItem="Person"
                        Items="People"
                        AllowMultiSelect="allowMultiSelect"
                        SelectedItemsChanged="selectionChanged ?? default">
                <SgDataGridColumn TItem="Person" Title="ID"     Value="p => p.Id" />
                <SgDataGridColumn TItem="Person" Title="Name"   Value="p => p.Name" />
                <SgDataGridColumn TItem="Person" Title="Dept"   Value="p => p.Dept" />
                <SgDataGridColumn TItem="Person" Title="Salary" Value="p => p.Salary" />
            </SgDataGrid>
        );
    }

    [Fact]
    public void Renders_all_rows_and_columns()
    {
        var cut = RenderGrid();

        Assert.Equal(5, cut.FindAll("tbody tr").Count);
        var headers = cut.FindAll("thead th.sg-th").Select(n => n.TextContent.Trim()).ToArray();
        Assert.Contains(headers, h => h.StartsWith("ID"));
        Assert.Contains(headers, h => h.StartsWith("Name"));
        Assert.Contains(headers, h => h.StartsWith("Dept"));
        Assert.Contains(headers, h => h.StartsWith("Salary"));
    }

    [Fact]
    public void Sort_ascending_then_descending_on_header_click()
    {
        var cut = RenderGrid();

        cut.FindAll(".sg-th-title")[1].Click();
        var col1 = cut.FindAll("tbody tr td.sg-td")
            .Where((_, i) => i % 4 == 1).Select(n => n.TextContent.Trim()).ToArray();
        Assert.Equal(new[] { "Alice", "Bob", "Carol", "Dave", "Eve" }, col1);

        cut.FindAll(".sg-th-title")[1].Click();
        var col2 = cut.FindAll("tbody tr td.sg-td")
            .Where((_, i) => i % 4 == 1).Select(n => n.TextContent.Trim()).ToArray();
        Assert.Equal(new[] { "Eve", "Dave", "Carol", "Bob", "Alice" }, col2);
    }

    [Fact]
    public void Sort_third_click_clears_sort()
    {
        var cut = RenderGrid();

        cut.FindAll(".sg-th-title")[1].Click();
        cut.FindAll(".sg-th-title")[1].Click();
        cut.FindAll(".sg-th-title")[1].Click();

        Assert.Empty(cut.FindAll(".sg-sort-ind"));
    }

    [Fact]
    public void Filter_menu_shows_distinct_values()
    {
        var cut = RenderGrid();
        var filterBtns = cut.FindAll(".sg-filter-btn");
        filterBtns[2].Click();

        var items = cut.FindAll(".sg-filter-item span").Select(n => n.TextContent.Trim()).ToArray();
        Assert.Equal(new[] { "HR", "IT", "Sales" }, items);
    }

    [Fact]
    public void Filter_limits_rows()
    {
        var cut = RenderGrid();
        cut.FindAll(".sg-filter-btn")[2].Click();

        cut.Find(".sg-filter-all input").Change(false);

        var itCheckbox = cut.FindAll(".sg-filter-item input")
            .Zip(cut.FindAll(".sg-filter-item span"), (cb, span) => (cb, text: span.TextContent.Trim()))
            .First(x => x.text == "IT").cb;
        itCheckbox.Change(true);

        cut.Find(".sg-filter-foot .primary").Click();

        var names = cut.FindAll("tbody tr td.sg-td")
            .Where((_, i) => i % 4 == 1).Select(n => n.TextContent.Trim()).ToArray();
        Assert.Equal(new[] { "Alice", "Carol", "Eve" }, names);
    }

    [Fact]
    public void Search_filters_rows_across_columns()
    {
        var cut = RenderGrid();
        cut.Find(".sg-search").Input("bob");

        Assert.Single(cut.FindAll("tbody tr"));
        Assert.Contains("Bob", cut.Find("tbody tr").TextContent);
    }

    [Fact]
    public void MultiSelect_toggles_single_row()
    {
        IReadOnlyCollection<Person>? captured = null;
        var cb = EventCallback.Factory.Create<IReadOnlyCollection<Person>>(this, v => captured = v);

        var cut = RenderGrid(selectionChanged: cb);

        var firstRowCheckbox = cut.FindAll("tbody tr td.sg-col-check input")[0];
        firstRowCheckbox.Change(true);

        Assert.NotNull(captured);
        Assert.Single(captured!);
        Assert.Equal(1, captured!.First().Id);
    }

    [Fact]
    public void MultiSelect_toggle_all_selects_all_visible()
    {
        IReadOnlyCollection<Person>? captured = null;
        var cb = EventCallback.Factory.Create<IReadOnlyCollection<Person>>(this, v => captured = v);

        var cut = RenderGrid(selectionChanged: cb);

        cut.Find("thead th.sg-col-check input").Change(true);

        Assert.NotNull(captured);
        Assert.Equal(5, captured!.Count);
    }

    [Fact]
    public void MultiSelect_disabled_hides_checkboxes()
    {
        var cut = RenderGrid(allowMultiSelect: false);

        Assert.Empty(cut.FindAll("th.sg-col-check"));
        Assert.Empty(cut.FindAll("td.sg-col-check"));
    }

    [Fact]
    public void Empty_data_shows_empty_text()
    {
        JSInterop.SetupModule("/_content/SuperUI/superui.js")
                 .SetupVoid("init", _ => true);
        var cut = Render<SgDataGrid<Person>>(
            @<SgDataGrid TItem="Person" Items="new List<Person>()" EmptyText="Nothing here">
                <SgDataGridColumn TItem="Person" Title="ID" Value="p => p.Id" />
            </SgDataGrid>
        );

        Assert.Contains("Nothing here", cut.Find(".sg-empty").TextContent);
    }

    [Fact]
    public void Footer_shows_counts()
    {
        var cut = RenderGrid();
        Assert.Contains("из 5", cut.Find(".sg-foot-info").TextContent);
    }
}

