@namespace SuperUI.Demo.Components

<tr>
    <td><code class="param-name">@Name</code></td>
    <td><code class="param-type">@Type</code></td>
    <td>@Description</td>
    <td><span class="param-values">@Values</span></td>
    <td><code class="param-default">@DefaultValue</code></td>
</tr>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Type { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string Values { get; set; } = "-";
    [Parameter] public string DefaultValue { get; set; } = "-";
}
