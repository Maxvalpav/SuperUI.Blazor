@namespace SuperUI.Demo.Components
@using SuperUI.Demo.Models

<div class="component-doc">
    @if (!string.IsNullOrEmpty(Title))
    {
        <h2 class="component-doc-title">@Title</h2>
    }
    
    @if (!string.IsNullOrEmpty(Description))
    {
        <p class="component-doc-description">@Description</p>
    }
    
    <div class="component-doc-content">
        @ChildContent
    </div>
    
    @if (Parameters?.Count > 0)
    {
        <div class="component-doc-section">
            <h3>Parameters</h3>
            <table class="component-doc-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Default</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var param in Parameters)
                    {
                        <tr>
                            <td>@param.Name</td>
                            <td><code>@param.Type</code></td>
                            <td>@param.Default</td>
                            <td>@param.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    
    @if (Events?.Count > 0)
    {
        <div class="component-doc-section">
            <h3>Events</h3>
            <table class="component-doc-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evt in Events)
                    {
                        <tr>
                            <td>@evt.Name</td>
                            <td><code>@evt.Type</code></td>
                            <td>@evt.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public List<ComponentParameter>? Parameters { get; set; }

    [Parameter]
    public List<ComponentEvent>? Events { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
