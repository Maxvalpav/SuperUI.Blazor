@using SuperUI.Components

<table class="sgc-property-table">
    <thead>
        <tr>
            <th><SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Свойство</SgTypography></th>
            <th><SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Тип</SgTypography></th>
            <th><SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Описание</SgTypography></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var prop in Items)
        {
            <tr>
                <td class="sgc-prop-label">
                    <code class="sgc-prop-name">@prop.Label</code>
                </td>
                <td class="sgc-prop-type">
                    <SgTypography Font="SgTypographyFont.Mono" Size="SgTypographySize.Xs" Color="var(--sg-color-primary)">
                        @prop.Value
                    </SgTypography>
                </td>
                <td class="sgc-prop-desc">
                    <div class="sgc-prop-desc-inner">
                        @if (!string.IsNullOrEmpty(prop.BadgeText))
                        {
                            <SgBadge Text="@prop.BadgeText" Variant="@prop.BadgeVariant" Size="SgSize.Sm" />
                        }
                        @if (!string.IsNullOrEmpty(prop.Description))
                        {
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">@prop.Description</SgTypography>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter]
    public List<PropertyPanelItem> Items { get; set; } = new();
}
