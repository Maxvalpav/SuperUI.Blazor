@using SuperUI.Components

<table style="width: 100%; border-collapse: collapse; font-size: 13px;">
    <thead>
        <tr style="background: var(--sui-toolbar-bg); border-bottom: 1px solid var(--sui-border);">
            <th style="padding: 8px; text-align: left; font-weight: 600;">Свойство</th>
            <th style="padding: 8px; text-align: left; font-weight: 600;">Тип</th>
            <th style="padding: 8px; text-align: left; font-weight: 600;">Описание</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var prop in Items)
        {
            <tr style="border-bottom: 1px solid var(--sui-border);">
                <td style="padding: 8px; font-weight: 500;">@prop.Label</td>
                <td style="padding: 8px; color: var(--sui-text-muted); font-family: monospace; font-size: 12px;">@prop.Value</td>
                <td style="padding: 8px;">@prop.BadgeText</td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter]
    public List<PropertyPanelItem> Items { get; set; } = new();
}
