@inherits LayoutComponentBase

<div class="sui-shell">
    <AppNav />

    <div class="sui-main">
        <SgHeader Title="SUI">
            <ActionsContent>
                <SgTooltip Text="GitHub">
                    <a href="https://github.com" target="_blank" style="color:#fff; text-decoration:none; font-size:18px;">⌥</a>
                </SgTooltip>
            </ActionsContent>
        </SgHeader>

        <div class="sui-content">
            @Body
        </div>

        <SgFooter Copyright="© 2026 SUI" Version="1.0.0" />
    </div>
</div>

<SgToastHost />
<SgConfirmHost />

<div id="blazor-error-ui" data-nosnippet>
    <span>Произошла ошибка.</span>
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">🗙</span>
</div>

