@inherits LayoutComponentBase
@using SuperUI.Components

<div class="sui-shell">
    <AppNav @ref="_appNav" />

    <div class="sui-main">
        <SgHeader Title="SuperUI">
            <LeadingContent>
                <button type="button"
                        class="sui-mobile-menu-btn"
                        aria-label="Меню"
                        @onclick="ToggleNavAsync">
                    <span></span><span></span><span></span>
                </button>
            </LeadingContent>
            <ActionsContent>
               @*  <SgLanguageSwitcher /> *@
                <SgNotificationBell />
                <div style="width: 1px; height: 20px; background: var(--sui-border); margin: 0 4px;"></div>
                <SgThemeSwitcher />
                <div style="width: 1px; height: 20px; background: var(--sui-border); margin: 0 4px;"></div>
                <SgTooltip Text="GitHub">
                    <a href="https://github.com/Maxvalpav/SuperUI.Blazor" target="_blank" style="color: var(--sui-text-primary); text-decoration:none; font-size:18px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                    </a>
                </SgTooltip>
            </ActionsContent>
        </SgHeader>

        <div class="sui-content">
            @Body
        </div>

        <SgFooter Copyright="© 2026 SUI" Version="1.0.20" />
    </div>
</div>

<SgToastHost />
<SgConfirmHost />

<div id="blazor-error-ui" data-nosnippet>
    <span>Произошла ошибка.</span>
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private AppNav? _appNav;

    private Task ToggleNavAsync() =>
        _appNav?.ToggleAsync() ?? Task.CompletedTask;
}
