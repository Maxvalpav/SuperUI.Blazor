@inherits LayoutComponentBase
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Services
@inject SgPageTabsService TabsService
@inject SgSettingsService SettingsService
@inject NavigationManager NavigationManager
@implements IDisposable

<SgNavigation />

<div class="sui-shell @(_navOrientation == SgOrientation.Horizontal ? "sui-shell-horizontal" : "")">
    @if (_navOrientation == SgOrientation.Vertical)
    {
        <AppNav @ref="_appNav" @bind-Orientation="_navOrientation" />
    }

    <div class="sui-main">
        @if (_navOrientation == SgOrientation.Horizontal)
        {
            <SgHeader>
                <ChildContent>
                    <div class="sui-horizontal-nav-in-header">
                        <span class="sui-horizontal-nav-brand">SuperUI</span>
                        <AppNav @bind-Orientation="_navOrientation" />
                    </div>
                </ChildContent>
                <ActionsContent>
                   @*  <SgLanguageSwitcher /> *@
                    <SgNotificationBell />
                    <div style="width: 1px; height: 20px; background: var(--sui-border); margin: 0 4px;"></div>
                    <SgThemeSwitcher />
                    <div style="width: 1px; height: 20px; background: var(--sui-border); margin: 0 4px;"></div>
                    <SgTooltip Text="Настройки">
                        <SgIconButton Icon="@SgIcons.Settings" OnClick="() => _showSettings = true" Variant="SgButtonVariant.Ghost" />
                    </SgTooltip>
                    <div style="width: 1px; height: 20px; background: var(--sui-border); margin: 0 4px;"></div>
                    <SgTooltip Text="Боковая панель">
                        <button type="button" class="sui-mode-toggle-btn" @onclick="() => _navOrientation = SgOrientation.Vertical">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><rect x="3" y="3" width="6" height="18" rx="1"/></svg>
                        </button>
                    </SgTooltip>
                    <div style="width: 1px; height: 20px; background: var(--sui-border); margin: 0 4px;"></div>
                    <SgTooltip Text="GitHub">
                        <a href="https://github.com/Maxvalpav/SuperUI.Blazor" target="_blank" style="color: var(--sui-text-primary); text-decoration:none; font-size:18px;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                        </a>
                    </SgTooltip>
                </ActionsContent>
            </SgHeader>
        }
        else
        {
            <SgHeader Title="SuperUI">
                <LeadingContent>
                    <button type="button"
                            class="sui-mobile-menu-btn"
                            aria-label="Меню"
                            @onclick="ToggleNavAsync">
                        <span></span><span></span><span></span>
                    </button>
                </LeadingContent>
                <ActionsContent>
                   @*  <SgLanguageSwitcher /> *@
                    <SgNotificationBell />
                    <div style="width: 1px; height: 20px; background: var(--sui-border); margin: 0 4px;"></div>
                    <SgThemeSwitcher />
                    <div style="width: 1px; height: 20px; background: var(--sui-border); margin: 0 4px;"></div>
                    <SgTooltip Text="Настройки">
                        <SgIconButton Icon="@SgIcons.Settings" OnClick="() => _showSettings = true" Variant="SgButtonVariant.Ghost" />
                    </SgTooltip>
                    <div style="width: 1px; height: 20px; background: var(--sui-border); margin: 0 4px;"></div>
                    <SgTooltip Text="GitHub">
                        <a href="https://github.com/Maxvalpav/SuperUI.Blazor" target="_blank" style="color: var(--sui-text-primary); text-decoration:none; font-size:18px;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                        </a>
                    </SgTooltip>
                </ActionsContent>
            </SgHeader>
        }

        @if (SettingsService.IsTabbedMode)
        {
            <SgPageTabs />
        }

        <div class="sui-content">
            @Body
        </div>

        <SgFooter Copyright="© 2026 SUI" Version="1.0.35" />
    </div>
</div>

<SgToastHost />
<SgNotificationToastHost Position="SgPlacement.BottomEnd" />
<SgConfirmHost />
<SgDrawerProvider />
<SgClickHeatmap AutoStart="true" InitialAdminMode="false" />

<SgBackTop Target=".sui-content" VisibilityHeight="400" />
<SgBackBottom Target=".sui-content" VisibilityHeight="400" Bottom="84" />

@if (_showSettings)
{
    <SgDrawer Title="Параметры SuperUI" 
              @bind-Visible="_showSettings" 
              Size="800px" 
              Placement="SgPlacement.Right"
              CssClass="sgc-settings-drawer">
        <SgSettings Style="border: none; border-radius: 0; min-height: calc(100vh - 80px);" />
    </SgDrawer>
}

<div id="blazor-error-ui" data-nosnippet>
    <span>Произошла ошибка.</span>
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private AppNav? _appNav;
    private bool _showSettings;
    private SgOrientation _navOrientation = SgOrientation.Vertical;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        SettingsService.OnSettingsChanged += OnSettingsChanged;
        // Initial page
        UpdateTabs(NavigationManager.Uri);
    }

    private void OnSettingsChanged()
    {
        UpdateTabs(NavigationManager.Uri);
        StateHasChanged();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateTabs(e.Location);
        StateHasChanged();
    }

    private void UpdateTabs(string uri)
    {
        if (!SettingsService.IsTabbedMode) return;

        var relativeUri = NavigationManager.ToBaseRelativePath(uri);
        // Extract title from URI or some mapping
        var title = GetTitleFromUri(relativeUri);
        
        TabsService.OpenTab(relativeUri, title);
    }

    private string GetTitleFromUri(string uri)
    {
        if (string.IsNullOrEmpty(uri)) return "Home";
        
        // Simple heuristic: convert kebab-case to Title Case
        var parts = uri.Split('/');
        var lastPart = parts[^1];
        if (lastPart.EndsWith("-demo")) lastPart = lastPart[..^5];
        
        var textInfo = System.Globalization.CultureInfo.CurrentCulture.TextInfo;
        return textInfo.ToTitleCase(lastPart.Replace("-", " "));
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        SettingsService.OnSettingsChanged -= OnSettingsChanged;
    }

    private Task ToggleNavAsync() =>
        _appNav?.ToggleAsync() ?? Task.CompletedTask;
}

