    .sgc-nav-footer-btn:hover {
        color: var(--sg-primary);
        background: color-mix(in srgb, var(--sg-primary) 10%, transparent);
        border-color: color-mix(in srgb, var(--sg-primary) 25%, transparent);
    }
    .sgc-nav-footer-btn:active {
        transform: scale(0.92);
