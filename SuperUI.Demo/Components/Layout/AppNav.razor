@namespace SuperUI.Demo.Components.Layout

<SgNavMenu @ref="_nav">
    <LogoContent>
        <div style="display:flex;align-items:center;gap:15px;padding:12px 16px;">
            <div style="display:grid; grid-template-columns: repeat(3, 10px); grid-template-rows: repeat(3, 10px); gap: 2px;">
                <div style="background:rgba(255,255,255,0.4);"></div>
                <div style="background:rgba(255,255,255,0.7);"></div>
                <div style="background:rgba(255,255,255,0.3);"></div>
                
                <div style="background:#fff; display:flex; align-items:center; justify-content:center; color:var(--sui-accent); font-weight:900; font-size:8px;">S</div>
                <div style="background:rgba(255,255,255,0.9); display:flex; align-items:center; justify-content:center; color:var(--sui-accent); font-weight:900; font-size:8px;">U</div>
                <div style="background:rgba(255,255,255,0.6); display:flex; align-items:center; justify-content:center; color:var(--sui-accent); font-weight:900; font-size:8px;">I</div>
                
                <div style="background:rgba(255,255,255,0.2);"></div>
                <div style="background:rgba(255,255,255,0.5);"></div>
                <div style="background:rgba(255,255,255,0.4);"></div>
            </div>
            <div style="display:flex;flex-direction:column;line-height:1;">
                <span style="font-size:18px;font-weight:900;color:#fff;letter-spacing:1.5px;text-shadow:0 1px 2px rgba(0,0,0,0.1);">SUI</span>
            </div>
        </div>
    </LogoContent>
    <ChildContent>     
        <SgNavLink Href="" Icon="@Icons.Home" Text="Главная" Match="NavLinkMatch.All" />

        <SgNavGroup Title="Foundation" Icon="@Icons.Box" Expanded="true">
            <SgNavLink Href="demo/button" Icon="@Icons.Zap" Text="Button" />
            <SgNavLink Href="demo/textbox" Icon="@Icons.Type" Text="TextBox" />
            <SgNavLink Href="demo/checkbox" Icon="@Icons.CheckSquare" Text="CheckBox" />
            <SgNavLink Href="demo/card" Icon="@Icons.Square" Text="Card" />
            <SgNavLink Href="demo/alert" Icon="@Icons.AlertCircle" Text="Alert" />
            <SgNavLink Href="demo/badge" Icon="@Icons.Tag" Text="Badge" />
        </SgNavGroup>

        <SgNavGroup Title="Input Components" Icon="@Icons.Form" Expanded="true">
            <SgNavLink Href="demo/switch" Icon="@Icons.Sliders" Text="Switch" />
            <SgNavLink Href="demo/textarea" Icon="@Icons.AlignLeft" Text="TextArea" />
            <SgNavLink Href="demo/numberinput" Icon="@Icons.Hash" Text="NumberInput" />
            <SgNavLink Href="demo/select" Icon="@Icons.ChevronDown" Text="Select" />
            <SgNavLink Href="demo/radiogroup" Icon="@Icons.ListTree" Text="RadioGroup" />
            <SgNavLink Href="demo/maskedinput" Icon="@Icons.Toolbar" Text="MaskedInput" />
            <SgNavLink Href="demo/datepicker" Icon="@Icons.Calendar" Text="DatePicker" />
            <SgNavLink Href="demo/timepicker" Icon="@Icons.Clock" Text="TimePicker" />
            <SgNavLink Href="demo/multiselect" Icon="@Icons.Layers" Text="MultiSelect" />
        </SgNavGroup>

        <SgNavGroup Title="Navigation" Icon="@Icons.Route" Expanded="true">
            <SgNavLink Href="demo/tabs" Icon="@Icons.Columns" Text="Tabs" />
            <SgNavLink Href="demo/accordion" Icon="@Icons.List" Text="Accordion" />
            <SgNavLink Href="demo/breadcrumb" Icon="@Icons.MoreHorizontal" Text="Breadcrumb" />
        </SgNavGroup>

        <SgNavGroup Title="Display & Overlay" Icon="@Icons.Layout" Expanded="true">
            <SgNavLink Href="demo/avatar" Icon="@Icons.User" Text="Avatar" />
            <SgNavLink Href="demo/progress" Icon="@Icons.Activity" Text="Progress" />
            <SgNavLink Href="demo/modal" Icon="@Icons.Maximize" Text="Modal" />
        </SgNavGroup>
    </ChildContent>
    <FooterContent>
        SUI v1.0.38
    </FooterContent>
</SgNavMenu>

