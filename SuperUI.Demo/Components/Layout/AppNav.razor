                <div style="background:rgba(255,255,255,0.2);"></div>
                <div style="background:rgba(255,255,255,0.5);"></div>
                <div style="background:rgba(255,255,255,0.4);"></div>
            </div>
            <div style="display:flex;flex-direction:column;line-height:1;">
