<style>
    .sgc-nav-header-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: var(--sg-radius-md, 4px);
