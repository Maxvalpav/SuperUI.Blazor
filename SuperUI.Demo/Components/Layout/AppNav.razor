@code {
    private SgNavMenu? _nav;

    /// <summary>
    /// Gets or sets the navigation orientation.
    /// </summary>
    [Parameter] public SgOrientation Orientation { get; set; } = SgOrientation.Vertical;

    /// <summary>
    /// Fired when the orientation changes.
    /// </summary>
    [Parameter] public EventCallback<SgOrientation> OrientationChanged { get; set; }

    /// <summary>
    /// Fired when the user requests opening settings.
    /// </summary>
    [Parameter] public EventCallback OnSettingsRequested { get; set; }

    public Task ToggleAsync() =>
        _nav?.ToggleMobileAsync() ?? Task.CompletedTask;

    private async Task ExpandAll()
    {
        if (_nav is not null) await _nav.ExpandAllAsync();
    }

    private async Task CollapseAll()
    {
        if (_nav is not null) await _nav.CollapseAllAsync();
    }

    private async Task ToggleOrientation()
    {
        Orientation = Orientation == SgOrientation.Vertical ? SgOrientation.Horizontal : SgOrientation.Vertical;
        await OrientationChanged.InvokeAsync(Orientation);
    }

    private async Task OpenSettings()
    {
        await OnSettingsRequested.InvokeAsync();
    }

    private async Task OnOrientationChanged(SgOrientation value)
    {
        Orientation = value;
        await OrientationChanged.InvokeAsync(value);
    }

