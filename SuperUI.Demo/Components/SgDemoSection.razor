@namespace SuperUI.Demo.Components

<section class="demo-doc-section">
    <div class="demo-doc-section-header">
        <div class="demo-doc-section-copy">
            @if (!string.IsNullOrWhiteSpace(Eyebrow))
            {
                <div class="demo-doc-eyebrow">@Eyebrow</div>
            }
            <h2 class="demo-doc-section-title">@Title</h2>
            @if (!string.IsNullOrEmpty(Description))
            {
                <p class="demo-doc-section-desc">@Description</p>
            }
        </div>
    </div>

    <div class="demo-doc-section-body @BodyClass">
        @ChildContent
    </div>

    @if (CodeContent is not null)
    {
        <div class="demo-doc-code">
            <pre><code>@CodeContent</code></pre>
        </div>
    }
</section>

@code {
    [Parameter] public string Title { get; set; } = "Example";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? BodyClass { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? CodeContent { get; set; }
}
