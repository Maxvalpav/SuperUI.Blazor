@page "/countdown-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Demo.Components
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Countdown — SuperUI</PageTitle>

<SgSeoHead Description="Customizable countdown with units, labels, progress, events, loop, and live constructor." />

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="SgCountdown — Live Timer" Subtitle="Customizable countdown with units, labels, progress, events, loop, and live constructor." />
    </HeaderContent>
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Basic Examples                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Basic Countdown
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Flexible countdown timer with configurable units, sizes, and display modes.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Sizes & Units" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Small
                        </SgTypography>
                        <SgCountdown TargetDate="@DateTime.Now.AddMinutes(30)" Size="Small" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Medium (default)
                        </SgTypography>
                        <SgCountdown TargetDate="@DateTime.Now.AddDays(1)" Size="Medium" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Large
                        </SgTypography>
                        <SgCountdown TargetDate="@DateTime.Now.AddDays(3).AddHours(5)" Size="Large" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Hours + Minutes only
                        </SgTypography>
                        <SgCountdown TargetDate="@DateTime.Now.AddHours(5).AddMinutes(45)" ShowDays="false" />
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Display Variants" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With Progress Bar
                            <SgTag Variant="SgTagVariant.Info" Size="SgSize.Sm" Style="margin-left:8px;">ShowProgress</SgTag>
                        </SgTypography>
                        <SgCountdown TargetDate="@DateTime.Now.AddSeconds(30)" Size="Medium" ShowProgress="true" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Without Separators
                        </SgTypography>
                        <SgCountdown TargetDate="@DateTime.Now.AddDays(2)" ShowSeparators="false" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Without Labels
                            <SgTag Variant="SgTagVariant.Success" Size="SgSize.Sm" Style="margin-left:8px;">ShowLabels=false</SgTag>
                        </SgTypography>
                        <SgCountdown TargetDate="@DateTime.Now.AddHours(3)" ShowLabels="false" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Always Show Days
                        </SgTypography>
                        <SgCountdown TargetDate="@DateTime.Now.AddMinutes(45)" AlwaysShowDays="true" />
                    </div>
                </SgStack>
            </SgCard>
        </div>

        <DemoCodeBlock Code="@_basicCode" Title="Basic countdown examples" />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Interactive Controls                                            -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Interactive Countdown
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Control the countdown with start, stop, reset, pause, and loop. Watch the progress bar update in real time.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Md">
            <SgCol Xs="12" Md="8">
                <SgCard Title="Controls" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
                        <SgCountdown @ref="_interactiveCd"
                                     TargetDate="@DateTime.Now.AddSeconds(30)"
                                     Size="Large"
                                     ShowProgress="true"
                                     Animated="true"
                                     FinishedMessage="Time's up!"
                                     OnFinish="@OnInteractiveFinish"
                                     Loop="@_interactiveLoop" />

                        <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center;">
                            <SgButton Text="Start" Variant="SgButtonVariant.Success"
                                      Icon="@(new RenderFragment(b => b.AddContent(0, (MarkupString)SgIcons.Play)))"
                                      Disabled="@(_interactiveCd?.IsFinished == false && _interactiveCd != null)"
                                      OnClick="@StartInteractive" />
                            <SgButton Text="Pause" Variant="SgButtonVariant.Outlined"
                                      Icon="@(new RenderFragment(b => b.AddContent(0, (MarkupString)SgIcons.Pause)))"
                                      Disabled="@(_interactiveCd?.IsFinished != false)"
                                      OnClick="@PauseInteractive" />
                            <SgButton Text="Reset 30s" Variant="SgButtonVariant.Ghost"
                                      Icon="@(new RenderFragment(b => b.AddContent(0, (MarkupString)SgIcons.Refresh)))"
                                      OnClick="@ResetInteractive" />
                        </div>

                        <SgStack Horizontal Space="SgSize.Lg" Align="SgAlignItems.Center">
                            <SgSwitch @bind-Value="_interactiveLoop"
                                      Label="Loop"
                                      LabelPosition="SgLabelPosition.Right" />
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                                Finished: <SgBadge Text="@_interactiveFinished.ToString()" Variant="@(_interactiveFinished ? SgBadgeVariant.Success : SgBadgeVariant.Muted)" Size="SgSize.Sm" Standalone="true" />
                            </SgTypography>
                        </SgStack>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Md="4">
                <SgCard Title="Events" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Status</SgTypography>
                            <SgBadge Text="@(_interactiveCd?.IsFinished == true ? "Finished" : "Running")"
                                     Variant="@(_interactiveCd?.IsFinished == true ? SgBadgeVariant.Success : SgBadgeVariant.Info)" />
                        </SgStack>
                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Progress</SgTypography>
                            <SgBadge Text="@_statusProgress" Standalone="true" />
                        </SgStack>
                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Remaining</SgTypography>
                            <SgBadge Text="@_statusRemaining" Variant="SgBadgeVariant.Warn" />
                        </SgStack>
                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Loop</SgTypography>
                            <SgBadge Text="@(_interactiveLoop ? "On" : "Off")" Variant="@(_interactiveLoop ? SgBadgeVariant.Success : SgBadgeVariant.Muted)" />
                        </SgStack>
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>

        <DemoCodeBlock Code="@_interactiveCode" Title="Interactive countdown with controls" />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Timer Modes                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Timer Modes
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Countdown supports absolute date targets and relative durations via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">TargetDate</SgTypography> or <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">InitialTimeLeft</SgTypography>.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Md">
            <SgCol Md="6">
                <SgCard Title="TargetDate (Absolute)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
                        <SgCountdown TargetDate="@(_nextYearDate)" Size="Medium" ShowLabels="true" />
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                            Counting down to @(_nextYearDate.ToString("MMMM yyyy"))
                        </SgTypography>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="InitialTimeLeft (Relative)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
                        <SgCountdown InitialTimeLeft="@TimeSpan.FromHours(3).Add(TimeSpan.FromMinutes(45))" Size="Medium" ShowProgress="true" />
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                            3 hours 45 minutes — relative countdown
                        </SgTypography>
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>

        <DemoCodeBlock Code="@_timerModeCode" Title="Timer modes: TargetDate vs InitialTimeLeft" />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Finish Event & Loop                                             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Finish Event & Loop
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">OnFinish</SgTypography> fires when the countdown reaches zero. <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Loop</SgTypography> auto-restarts.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="OnFinish Event" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
                    <SgCountdown TargetDate="@DateTime.Now.AddSeconds(10)"
                                 FinishedMessage="Countdown completed!"
                                 OnFinish="@(() => { _finishFired = true; StateHasChanged(); })" />
                    @if (_finishFired)
                    {
                        <SgAlert Variant="SgAlertVariant.Success" Dismissible="true" @bind-Visible="_finishFired">
                            OnFinish event fired!
                        </SgAlert>
                    }
                    else
                    {
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Waiting for countdown to finish (10s)...</SgTypography>
                    }
                </SgStack>
            </SgCard>

            <SgCard Title="Loop Mode" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
                    <SgCountdown InitialTimeLeft="@TimeSpan.FromSeconds(5)"
                                 Loop="true"
                                 FinishedMessage="Restarting..."
                                 Size="Medium" />
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                        Automatically restarts every 5 seconds
                    </SgTypography>
                </SgStack>
            </SgCard>
        </div>

        <DemoCodeBlock Code="@_finishCode" Title="OnFinish event and Loop mode" />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Live Constructor                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live Countdown Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure parameters and see the result in real time. Copy the generated code.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Size -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                            <SgSegmented TValue="string"
                                         Value="@_ctorSize"
                                         ValueChanged="v => { _ctorSize = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="@_sizeSegOptions" />
                        </SgStack>

                        <!-- Display Options -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="4">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Labels</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorLabels"
                                                 ValueChanged="v => { _ctorLabels = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="4">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Separators</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorSeparators"
                                                 ValueChanged="v => { _ctorSeparators = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="4">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Progress</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorProgress"
                                                 ValueChanged="v => { _ctorProgress = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Unit Toggles -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Days</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorDays"
                                                 ValueChanged="v => { _ctorDays = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Hours</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorHours"
                                                 ValueChanged="v => { _ctorHours = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Minutes</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorMinutes"
                                                 ValueChanged="v => { _ctorMinutes = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Seconds</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorSeconds"
                                                 ValueChanged="v => { _ctorSeconds = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Additional options -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Always Days</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorAlwaysDays"
                                                 ValueChanged="v => { _ctorAlwaysDays = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Animated</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorAnimated"
                                                 ValueChanged="v => { _ctorAnimated = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorSize" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Units</SgTypography>
                                    <SgStack Horizontal Gap="4px">
                                        @if (_ctorDays) { <SgBadge Variant="SgBadgeVariant.Default" Text="D" Size="SgSize.Sm" Standalone="true" /> }
                                        @if (_ctorHours) { <SgBadge Variant="SgBadgeVariant.Default" Text="H" Size="SgSize.Sm" Standalone="true" /> }
                                        @if (_ctorMinutes) { <SgBadge Variant="SgBadgeVariant.Default" Text="M" Size="SgSize.Sm" Standalone="true" /> }
                                        @if (_ctorSeconds) { <SgBadge Variant="SgBadgeVariant.Default" Text="S" Size="SgSize.Sm" Standalone="true" /> }
                                    </SgStack>
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Display</SgTypography>
                                    <SgStack Horizontal Gap="4px">
                                        @if (_ctorLabels) { <SgBadge Variant="SgBadgeVariant.Success" Text="Labels" Size="SgSize.Sm" Standalone="true" /> }
                                        @if (_ctorSeparators) { <SgBadge Variant="SgBadgeVariant.Success" Text="Sep" Size="SgSize.Sm" Standalone="true" /> }
                                        @if (_ctorProgress) { <SgBadge Variant="SgBadgeVariant.Info" Text="Progress" Size="SgSize.Sm" Standalone="true" /> }
                                    </SgStack>
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <div class="constructor-preview" style="display:flex;justify-content:center;padding:24px;">
                                <SgCountdown TargetDate="@DateTime.Now.AddDays(2).AddHours(8).AddMinutes(15)"
                                             Size="@_ctorSize"
                                             ShowLabels="@_ctorLabels"
                                             ShowSeparators="@_ctorSeparators"
                                             ShowProgress="@_ctorProgress"
                                             ShowDays="@_ctorDays"
                                             ShowHours="@_ctorHours"
                                             ShowMinutes="@_ctorMinutes"
                                             ShowSeconds="@_ctorSeconds"
                                             AlwaysShowDays="@_ctorAlwaysDays"
                                             Animated="@_ctorAnimated" />
                            </div>
                        </SgStack>

                        <!-- Code with Copy -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                    <span id="copy-icon">@_copyIcon</span>
                                    <span id="copy-text" style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                </button>
                            </div>
                            <div class="code-block" id="code-block">
                                @foreach (var line in _generatedCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. Properties                                                      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Properties
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Full list of configurable parameters for <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgCountdown</SgTypography>.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Sm" Radius="SgSize.Lg">
            <PropertyTable Items="@_countdownProperties" />
        </SgCard>
    </div>

    </ChildContent>
</SgCard>

<style>
    .demo-section { margin-top: 48px; }
    .demo-section-header { margin-bottom: 20px; }

    .demo-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }
    @@media (max-width: 768px) {
        .demo-two-col { grid-template-columns: 1fr; }
    }

    .constructor-preview {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        transition: all 0.3s ease;
    }
    .ctrl-summary {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 12px 14px;
    }
    .code-block {
        background: #0f172a;
        color: #7dd3fc;
        padding: 14px 16px;
        border-radius: 8px;
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 12px;
        line-height: 1.9;
        overflow-x: auto;
        position: relative;
    }
    .code-block code {
        background: none;
        padding: 0;
        color: inherit;
        font-size: inherit;
        display: block;
        white-space: pre;
    }
    .demo-copy-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 6px;
        padding: 4px 10px;
        cursor: pointer;
        color: var(--sg-text-muted);
        transition: all 0.2s ease;
        font-family: inherit;
    }
    .demo-copy-btn:hover {
        color: var(--sg-primary);
        border-color: var(--sg-primary);
        background: color-mix(in srgb, var(--sg-primary) 8%, transparent);
    }
    .demo-copy-btn:active { transform: scale(0.95); }
    .demo-copy-btn.copied {
        color: var(--sg-color-success);
        border-color: var(--sg-color-success);
    }
</style>

@code {
    // ── Main header ─────────────────────────────────────────────────
    // ── Interactive state ───────────────────────────────────────────
    private SgCountdown? _interactiveCd;
    private bool _interactiveLoop;
    private bool _interactiveFinished;
    private bool _finishFired;

    private DateTime _nextYearDate => new(DateTime.Now.Year + 1, 1, 1);

    private string _statusProgress => _interactiveCd is null
        ? "0%"
        : $"{(_interactiveCd.Progress * 100).ToString("F0", System.Globalization.CultureInfo.InvariantCulture)}%";

    private string _statusRemaining => _interactiveCd is null
        ? "0s"
        : $"{_interactiveCd.TimeLeft.TotalSeconds.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)}s";

    private void StartInteractive()
    {
        if (_interactiveCd is not null && _interactiveCd.IsFinished)
        {
            _interactiveCd.Restart();
            _interactiveFinished = false;
        }
        else
        {
            _interactiveCd?.Start();
        }
    }

    private void PauseInteractive() => _interactiveCd?.Stop();
    private void ResetInteractive()
    {
        _interactiveCd?.Reset(TimeSpan.FromSeconds(30));
        _interactiveFinished = false;
    }
    private void OnInteractiveFinish()
    {
        _interactiveFinished = true;
        StateHasChanged();
    }

    // ── Constructor state ───────────────────────────────────────────
    private string _ctorSize = "Medium";
    private bool _ctorLabels = true;
    private bool _ctorSeparators = true;
    private bool _ctorProgress;
    private bool _ctorDays = true;
    private bool _ctorHours = true;
    private bool _ctorMinutes = true;
    private bool _ctorSeconds = true;
    private bool _ctorAlwaysDays;
    private bool _ctorAnimated;

    private string[] _generatedCodeLines = Array.Empty<string>();
    private string _copyIcon = "📋";
    private string _copyLabel = "Copy";

    // ── Segmented options ───────────────────────────────────────────
    private readonly List<SgSegmentedOption<string>> _sizeSegOptions = new()
    {
        new() { Value = "Small", Label = "Sm" },
        new() { Value = "Medium", Label = "Md" },
        new() { Value = "Large", Label = "Lg" },
    };

    private readonly List<SgSegmentedOption<bool>> _boolSegOptions = new()
    {
        new() { Value = false, Label = "Off" },
        new() { Value = true, Label = "On" },
    };

    // ── Lifecycle ───────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add("<SgCountdown TargetDate=\"DateTime.Now.AddDays(2).AddHours(8).AddMinutes(15)\"");

        if (_ctorSize != "Medium")
            lines.Add($"            Size=\"{_ctorSize}\"");

        if (!_ctorLabels) lines.Add("            ShowLabels=\"false\"");
        if (!_ctorSeparators) lines.Add("            ShowSeparators=\"false\"");
        if (_ctorProgress) lines.Add("            ShowProgress=\"true\"");
        if (!_ctorDays) lines.Add("            ShowDays=\"false\"");
        if (!_ctorHours) lines.Add("            ShowHours=\"false\"");
        if (!_ctorMinutes) lines.Add("            ShowMinutes=\"false\"");
        if (!_ctorSeconds) lines.Add("            ShowSeconds=\"false\"");
        if (_ctorAlwaysDays) lines.Add("            AlwaysShowDays=\"true\"");
        if (_ctorAnimated) lines.Add("            Animated=\"true\"");

        lines.Add("            FinishedMessage=\"Done!\" />");

        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

    // ── Icons ───────────────────────────────────────────────────────
    private static class SgIcons
    {
        public const string Play = @"<svg width=""16"" height=""16"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2.5"" stroke-linecap=""round"" stroke-linejoin=""round""><polygon points=""5 3 19 12 5 21 5 3""/></svg>";
        public const string Pause = @"<svg width=""16"" height=""16"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2.5"" stroke-linecap=""round"" stroke-linejoin=""round""><rect x=""6"" y=""4"" width=""4"" height=""16""/><rect x=""14"" y=""4"" width=""4"" height=""16""/></svg>";
        public const string Refresh = @"<svg width=""16"" height=""16"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2.5"" stroke-linecap=""round"" stroke-linejoin=""round""><polyline points=""23 4 23 10 17 10""/><polyline points=""1 20 1 14 7 14""/><path d=""M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15""/></svg>";
    }

    // ── Demo code snippets ──────────────────────────────────────────
    private string _basicCode => @"<!-- Sizes -->
<SgCountdown TargetDate=""DateTime.Now.AddMinutes(30)"" Size=""Small"" />
<SgCountdown TargetDate=""DateTime.Now.AddDays(1)"" Size=""Medium"" />
<SgCountdown TargetDate=""DateTime.Now.AddDays(3).AddHours(5)"" Size=""Large"" />

<!-- Hours + Minutes only -->
<SgCountdown TargetDate=""DateTime.Now.AddHours(5).AddMinutes(45)"" ShowDays=""false"" />";

    private string _interactiveCode => @"<SgCountdown @ref=""_cd""
             TargetDate=""DateTime.Now.AddSeconds(30)""
             Size=""Large""
             ShowProgress=""true""
             Animated=""true""
             FinishedMessage=""Time's up!""
             Loop=""false"" />

<button @onclick=""() => _cd?.Start()"">Start</button>
<button @onclick=""() => _cd?.Stop()"">Pause</button>
<button @onclick=""() => _cd?.Restart()"">Reset</button>";

    private string _timerModeCode => @"<!-- Absolute target date -->
<SgCountdown TargetDate=""new DateTime(2026, 1, 1)"" />

<!-- Relative duration -->
<SgCountdown InitialTimeLeft=""TimeSpan.FromHours(3).Add(TimeSpan.FromMinutes(45))"" />";

    private string _finishCode => @"<!-- OnFinish event -->
<SgCountdown TargetDate=""DateTime.Now.AddSeconds(10)""
             FinishedMessage=""Countdown completed!""
             OnFinish=""() => { /* handle finish */ }"" />

<!-- Loop mode (auto-restart) -->
<SgCountdown InitialTimeLeft=""TimeSpan.FromSeconds(5)""
             Loop=""true""
             FinishedMessage=""Restarting..."" />";

    // ── Property table ──────────────────────────────────────────────
    private List<PropertyPanelItem> _countdownProperties = new()
    {
        new() { Label = "TargetDate",      Value = "DateTime?",              BadgeText = "Target",     BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "InitialTimeLeft", Value = "TimeSpan?",              BadgeText = "Duration",   BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "ShowDays",        Value = "bool (true)",            BadgeText = "Days",       BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "ShowHours",       Value = "bool (true)",            BadgeText = "Hours",      BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "ShowMinutes",     Value = "bool (true)",            BadgeText = "Minutes",    BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "ShowSeconds",     Value = "bool (true)",            BadgeText = "Seconds",    BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "ShowLabels",      Value = "bool (true)",            BadgeText = "Labels",     BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "ShowSeparators",  Value = "bool (true)",            BadgeText = "Separators", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "AlwaysShowDays",  Value = "bool",                   BadgeText = "Always Days",BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Size",            Value = "Small|Medium|Large",     BadgeText = "Size",       BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "ShowProgress",    Value = "bool",                   BadgeText = "Progress",   BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Animated",        Value = "bool",                   BadgeText = "Animation",  BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "FinishedMessage", Value = "string?",                BadgeText = "Message",    BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "OnFinish",        Value = "EventCallback",          BadgeText = "Event",      BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnTick",          Value = "EventCallback<TimeSpan>",BadgeText = "Every Tick", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Loop",            Value = "bool",                   BadgeText = "Auto-Restart",BadgeVariant = SgBadgeVariant.Info   },
        new() { Label = "Paused",          Value = "bool",                   BadgeText = "Pause",      BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "AutoStart",       Value = "bool (true)",            BadgeText = "Auto Start", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "CssClass",        Value = "string?",                BadgeText = "CSS Class",  BadgeVariant = SgBadgeVariant.Default },
    };
}
