@page "/countdown-demo"
@using SuperUI.Components

<PageTitle>Countdown — SuperUI</PageTitle>

<SgCard Title="SgCountdown — Обратный отсчет"
        Subtitle="Компонент для отображения красивого и функционального обратного отсчета. Поддерживает дни, часы, минуты и секунды.">
    
    <!-- Базовые примеры -->
    <div style="margin-top: 32px;">
        <h2>Базовые примеры</h2>
        <p>Различные варианты отображения обратного отсчета.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="До конца года">
                <SgCountdown TargetDate="new DateTime(DateTime.Now.Year + 1, 1, 1)" 
                            ShowLabels="true" 
                            Size="Medium" />
            </SgCard>

            <SgCard Title="Только часы и минуты">
                <SgCountdown TargetDate="DateTime.Now.AddHours(5)" 
                            ShowDays="false" 
                            ShowSeparators="true" 
                            Size="Medium" />
            </SgCard>

            <SgCard Title="Маленький размер (Small)">
                <SgCountdown TargetDate="DateTime.Now.AddMinutes(30)" 
                            Size="Small" 
                            ShowLabels="true" />
            </SgCard>

            <SgCard Title="Большой размер (Large)">
                <SgCountdown TargetDate="DateTime.Now.AddDays(10)" 
                            Size="Large" 
                            ShowLabels="true" />
            </SgCard>
        </div>
    </div>

    <!-- Текстовый режим -->
    <div style="margin-top: 32px;">
        <h2>Текстовый режим</h2>
        <p>Отображение без блоков, только текст.</p>
        
        <SgCard Title="Пример" Style="margin-top: 16px;">
            <SgCountdown TargetDate="DateTime.Now.AddHours(2)" 
                        ShowLabels="false" 
                        Size="Medium" />
        </SgCard>
    </div>

    <!-- Событие завершения -->
    <div style="margin-top: 32px;">
        <h2>Событие завершения</h2>
        <p>Отображение сообщения и вызов события при завершении.</p>
        
        <SgCard Title="Пример" Style="margin-top: 16px;">
            <SgCountdown TargetDate="DateTime.Now.AddSeconds(10)" 
                        FinishedMessage="Отсчет завершен!" 
                        Size="Medium" 
                        OnFinish="() => OnCountdownFinished()" />
            @if (_finished)
            {
                <div style="margin-top: 12px; padding: 12px; background: var(--sui-success-bg); border-radius: 8px;">
                    Событие завершения отсчета сработало!
                </div>
            }
        </SgCard>
    </div>

    <!-- Использование TimeSpan -->
    <div style="margin-top: 32px;">
        <h2>Использование TimeSpan</h2>
        <p>Отсчет без привязки к конкретной дате.</p>
        
        <SgCard Title="Пример" Style="margin-top: 16px;">
            <SgCountdown InitialTimeLeft="TimeSpan.FromHours(3)" 
                        Size="Medium" 
                        ShowLabels="true" />
        </SgCard>
    </div>

    <!-- Свойства компонента -->
    <div style="margin-top: 32px;">
        <h2>Свойства</h2>
        <SgCard Title="Параметры SgCountdown" Style="margin-top: 16px;">
            <PropertyTable Items="_countdownProperties" />
        </SgCard>
    </div>

</SgCard>

@code {
    private bool _finished = false;
    private List<PropertyPanelItem> _countdownProperties = new()
    {
        new() { Label = "TargetDate", Value = "DateTime?", BadgeText = "Целевая дата", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "InitialTimeLeft", Value = "TimeSpan?", BadgeText = "Интервал", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ShowDays", Value = "bool (true)", BadgeText = "Дни", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowHours", Value = "bool (true)", BadgeText = "Часы", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowMinutes", Value = "bool (true)", BadgeText = "Минуты", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowSeconds", Value = "bool (true)", BadgeText = "Секунды", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Size", Value = "Small|Medium|Large", BadgeText = "Размер", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "OnFinish", Value = "EventCallback", BadgeText = "Завершение", BadgeVariant = SgBadgeVariant.Success },
    };

    private void OnCountdownFinished()
    {
        _finished = true;
        StateHasChanged();
    }
}
