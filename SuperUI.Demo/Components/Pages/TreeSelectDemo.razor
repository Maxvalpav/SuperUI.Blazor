@page "/treeselect-demo"
@using SuperUI.Components

<PageTitle>TreeSelect - SUI</PageTitle>

<SgCard Title="SgTreeSelect - Tree Dropdown"
        Subtitle="Select from a hierarchical tree inside a dropdown. Supports search and filtering.">

    <div style="margin-top: 32px;">
        <h2>Basic Usage</h2>
        <p>Select a single node from a tree structure.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Department picker</div>
                        <SgTreeSelect Nodes="_nodes" @bind-Value="_selected" Placeholder="Select a department" />
                        <div style="margin-top: 8px; font-size: 12px;">
                            Selected: <strong>@_selected</strong>
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_basicProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>With Search</h2>
        <p>Filter tree nodes by typing in the search box.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <SgTreeSelect Nodes="_nodes" @bind-Value="_selectedSearch" Placeholder="Search departments..." ShowSearch="true" />
                <div style="margin-top: 8px; font-size: 12px; color: var(--sui-text-muted);">
                    Try typing "front" or "design".
                </div>
            </SgCard>

            <SgCard Title="Search Properties">
                <PropertyTable Items="_searchProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Code example -->
    <div style="margin-top: 32px;">
        <h2>Примеры кода</h2>
    </div>

</SgCard>

@code {
    private string? _selected;
    private string? _selectedSearch;

    private List<TreeNode> _nodes = new()
    {
        new TreeNode
        {
            Key = "engineering", Text = "Engineering",
            Children = new()
            {
                new TreeNode { Key = "frontend", Text = "Frontend" },
                new TreeNode { Key = "backend", Text = "Backend" },
                new TreeNode { Key = "devops", Text = "DevOps" }
            }
        },
        new TreeNode
        {
            Key = "design", Text = "Design",
            Children = new()
            {
                new TreeNode { Key = "ui", Text = "UI Design" },
                new TreeNode { Key = "ux", Text = "UX Research" }
            }
        },
        new TreeNode
        {
            Key = "marketing", Text = "Marketing",
            Children = new()
            {
                new TreeNode { Key = "content", Text = "Content" },
                new TreeNode { Key = "seo", Text = "SEO" },
                new TreeNode { Key = "social", Text = "Social Media" }
            }
        }
    };

    private List<PropertyPanelItem> _basicProperties = new()
    {
        new() { Label = "Nodes", Value = "List<TreeNode>", BadgeText = "Tree data" },
        new() { Label = "Value", Value = "string?", BadgeText = "Selected key (two-way)" },
        new() { Label = "Placeholder", Value = "string?", BadgeText = "Placeholder text" },
        new() { Label = "Disabled", Value = "bool", BadgeText = "Disabled state" }
    };

    private List<PropertyPanelItem> _searchProperties = new()
    {
        new() { Label = "ShowSearch",        Value = "bool",                  BadgeText = "Enable search" },
        new() { Label = "SearchPlaceholder", Value = "string",                BadgeText = "Search hint" },
        new() { Label = "TextSelector",      Value = "Func<TreeNode, string>?",BadgeText = "Custom text" }
    };
}
