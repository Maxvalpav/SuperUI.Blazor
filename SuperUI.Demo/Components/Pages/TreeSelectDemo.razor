    protected override void OnInitialized() => UpdateConstructorCode();

    private void HandlePlaceholderChange(ChangeEventArgs e)
    {
        _ctorPlaceholder = (string?)e.Value ?? "";
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string> { "<SgTreeSelect", "    Nodes=\"_myNodes\"", $"    Placeholder=\"{_ctorPlaceholder}\"" };
        if (_ctorSize != SgSize.Md) lines.Add($"    Size=\"SgSize.{_ctorSize}\"");
        if (_ctorVariant != SgCascaderVariant.Outlined) lines.Add($"    Variant=\"SgCascaderVariant.{_ctorVariant}\"");
        if (_ctorPlacement != SgPlacement.BottomStart) lines.Add($"    Placement=\"SgPlacement.{_ctorPlacement}\"");
        if (_ctorMultiple) lines.Add("    Multiple=\"true\"");
        if (_ctorSearch) lines.Add("    ShowSearch=\"true\"");
        if (_ctorClear) lines.Add("    Clearable=\"true\"");
        if (!_ctorBlock) lines.Add("    Block=\"false\"");
        lines.Add("    @bind-Value=\"_myValue\" />");
        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", string.Join("\n", _generatedCodeLines)); _copyIcon = "✓"; _copyLabel = "Copied!"; StateHasChanged(); await Task.Delay(2000); _copyIcon = "📋"; _copyLabel = "Copy"; StateHasChanged(); }
        catch { _copyIcon = "✗"; _copyLabel = "Failed"; StateHasChanged(); await Task.Delay(1500); _copyIcon = "📋"; _copyLabel = "Copy"; StateHasChanged(); }
    }

