@page "/treeselect-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>TreeSelect — SgTreeSelect — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- 1. Basic Usage -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgTreeSelect — Basic Usage
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Single and multi-select from a hierarchical tree. <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Multiple</SgTypography> enables checkbox mode, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Cascade</SgTypography> propagates to children.
            </SgTypography>
        </div>
        <SgRow Space="SgSize.Lg">
            <SgCol Md="4">
                <SgCard Title="Single Select" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgTreeSelect Nodes="_departments" @bind-Value="_selSingle" Placeholder="Pick a department…" />
                        <div class="demo-selected"><SgTag Size="SgSize.Sm" Variant="SgTagVariant.Primary">@(_selSingle ?? "none")</SgTag></div>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Multi-Select" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgTreeSelect Nodes="_departments" Multiple="true" @bind-Values="_selMulti" Placeholder="Choose skills…" Cascade="true" />
                        <div class="demo-selected">
                            @if (_selMulti.Any())
                            {
                                @foreach (var v in _selMulti) { <SgTag Size="SgSize.Sm">@v</SgTag> }
                            }
                            else { <SgTag Size="SgSize.Sm" Variant="SgTagVariant.Subtle">none</SgTag> }
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Disabled & Clearable" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgTreeSelect Nodes="_departments" Placeholder="Disabled" Disabled="true" />
                        <SgTreeSelect Nodes="_departments" Placeholder="Clearable" Clearable="true" />
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="12"><SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm"><PropertyTable Items="_basicProperties" /></SgCard></SgCol>
        </SgRow>
    </div>

    <!-- 2. Variants, Sizes, MaxHeight -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Variants, Sizes & MaxHeight
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Three visual variants, three sizes, and configurable dropdown height.
            </SgTypography>
        </div>
        <SgRow Space="SgSize.Lg">
            <SgCol Md="4">
                <SgCard Title="Outlined (default)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTreeSelect Nodes="_departments" Placeholder="Outlined" Variant="SgCascaderVariant.Outlined" />
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Borderless" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTreeSelect Nodes="_departments" Placeholder="Borderless" Variant="SgCascaderVariant.Borderless" />
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Filled" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTreeSelect Nodes="_departments" Placeholder="Filled" Variant="SgCascaderVariant.Filled" />
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Sizes" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgTreeSelect Nodes="_simple" Placeholder="Small" Size="SgSize.Sm" />
                        <SgTreeSelect Nodes="_simple" Placeholder="Medium (default)" Size="SgSize.Md" />
                        <SgTreeSelect Nodes="_simple" Placeholder="Large" Size="SgSize.Lg" />
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="MaxHeight" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTreeSelect Nodes="_largeFlat" Placeholder="Max 140px" MaxHeight="140px" />
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Loading State" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTreeSelect Nodes="_simple" Placeholder="Loading…" Loading="true" />
                </SgCard>
            </SgCol>
            <SgCol Md="12"><SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm"><PropertyTable Items="_styleProperties" /></SgCard></SgCol>
        </SgRow>
    </div>

    <!-- 3. Search & Highlight -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Search & Highlight
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Set <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ShowSearch</SgTypography> to filter the tree. Matching text is highlighted with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">&lt;mark&gt;</SgTypography>.
            </SgTypography>
        </div>
        <div class="demo-two-col">
            <SgCard Title="Searchable Departments" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgTreeSelect Nodes="_departmentStore" ShowSearch="true" Placeholder="Type to filter…" />
            </SgCard>
            <SgCard Title="Search Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_searchProperties" />
            </SgCard>
        </div>
    </div>

    <!-- 4. Checkable / Cascade -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Checkable — Cascade & LeafOnly
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Multiple</SgTypography> with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Cascade</SgTypography> propagates selection to descendants. <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">LeafOnly</SgTypography> restricts selection to leaf nodes.
            </SgTypography>
        </div>
        <SgRow Space="SgSize.Lg">
            <SgCol Md="4">
                <SgCard Title="Cascade = true (default)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgTreeSelect Nodes="_locations" Multiple="true" Cascade="true" Placeholder="Select regions" />
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Checking a parent checks all children.</SgTypography>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Cascade = false" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgTreeSelect Nodes="_locations" Multiple="true" Cascade="false" Placeholder="Select individually" />
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Each node toggles independently.</SgTypography>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="LeafOnly" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgTreeSelect Nodes="_locations" Multiple="true" LeafOnly="true" Placeholder="Select leaves only" />
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Only leaf nodes can be selected.</SgTypography>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="12"><SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm"><PropertyTable Items="_checkProperties" /></SgCard></SgCol>
        </SgRow>
    </div>

    <!-- 5. Placement -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Placement
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Dropdown menu placement relative to the trigger. JS-powered positioning with viewport clamping.
            </SgTypography>
        </div>
        <SgRow Space="SgSize.Lg">
            <SgCol Md="3">
                <SgCard Title="BottomStart (default)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTreeSelect Nodes="_departments" Placeholder="Bottom start" Placement="SgPlacement.BottomStart" />
                </SgCard>
            </SgCol>
            <SgCol Md="3">
                <SgCard Title="BottomEnd" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTreeSelect Nodes="_departments" Placeholder="Bottom end" Placement="SgPlacement.BottomEnd" />
                </SgCard>
            </SgCol>
            <SgCol Md="3">
                <SgCard Title="TopStart" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTreeSelect Nodes="_departments" Placeholder="Top start" Placement="SgPlacement.TopStart" />
                </SgCard>
            </SgCol>
            <SgCol Md="3">
                <SgCard Title="TopEnd" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTreeSelect Nodes="_departments" Placeholder="Top end" Placement="SgPlacement.TopEnd" />
                </SgCard>
            </SgCol>
            <SgCol Md="12"><SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm"><PropertyTable Items="_placementProperties" /></SgCard></SgCol>
        </SgRow>
    </div>

    <!-- 6. Advanced — DisabledOption, OnChange, NodeTemplate, Icons -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Advanced — DisabledOption, OnChange, Templates
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Dynamic disable logic, change callback, custom node rendering, and rich options with badges and icons.
            </SgTypography>
        </div>
        <SgRow Space="SgSize.Lg">
            <SgCol Md="4">
                <SgCard Title="DisabledOption Callback" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgTreeSelect Nodes="_departments" Placeholder="Dynamic disable" DisabledOption="@(n => n.Key == "frontend")" />
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Frontend is disabled via callback.</SgTypography>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="OnChange Callback" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgTreeSelect Nodes="_departments" Placeholder="Select…" OnChange="HandleOnChange" />
                        <div class="demo-selected"><SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">@_onChangeLog</SgTypography></div>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="NodeTemplate" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTreeSelect Nodes="_iconOptions" Placeholder="Custom template…">
                        <NodeTemplate Context="n">
                            <span style="display:flex;align-items:center;gap:6px;width:100%;">
                                <span style="width:6px;height:6px;border-radius:50%;background:@(n.Children.Count > 0 ? "#8b5cf6" : "#10b981");flex-shrink:0;"></span>
                                <span style="flex:1;font-size:12px;">@n.Text</span>
                                @if (n.Children.Count == 0) { <span style="font-size:9px;color:var(--sg-fg-muted)">leaf</span> }
                            </span>
                        </NodeTemplate>
                    </SgTreeSelect>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Icons & Badges" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTreeSelect Nodes="_iconOptions" Placeholder="Select…" ShowSearch="true" />
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="EmptyContent Override" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTreeSelect Nodes="_simple" Placeholder="Type 'xyz'…" ShowSearch="true">
                        <EmptyContent><div style="padding:24px;text-align:center;color:var(--sg-color-warning);font-size:12px;">✨ Nothing found</div></EmptyContent>
                    </SgTreeSelect>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- 7. Live Constructor -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live SgTreeSelect Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure all parameters and see the result live. Click <strong>Copy</strong> for generated code.
            </SgTypography>
        </div>
        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Placeholder</SgTypography>
                            <input type="text" class="demo-ctor-input" value="@_ctorPlaceholder" @onchange="HandlePlaceholderChange" />
                        </SgStack>
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgSegmented TValue="SgSize" Value="@_ctorSize" ValueChanged="v => { _ctorSize = v; UpdateConstructorCode(); }" Block="true" Size="sm" Options="_sizeOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Variant</SgTypography>
                                    <SgSegmented TValue="SgCascaderVariant" Value="@_ctorVariant" ValueChanged="v => { _ctorVariant = v; UpdateConstructorCode(); }" Block="true" Size="sm" Options="_variantOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Placement</SgTypography>
                                    <SgSelect TValue="SgPlacement" Value="@_ctorPlacement" ValueChanged="v => { _ctorPlacement = v; UpdateConstructorCode(); }" Items="_placementItems" LabelSelector="x => x.ToString()" Block="true" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Multiple</SgTypography>
                                    <SgSegmented TValue="bool" Value="_ctorMultiple" ValueChanged="v => { _ctorMultiple = v; UpdateConstructorCode(); }" Block="true" Size="sm" Options="_boolSeg" />
                                </SgStack>
                            </SgCol>
                        </SgRow>
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="4">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Search</SgTypography>
                                    <SgSegmented TValue="bool" Value="_ctorSearch" ValueChanged="v => { _ctorSearch = v; UpdateConstructorCode(); }" Block="true" Size="sm" Options="_boolSeg" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="4">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Clear</SgTypography>
                                    <SgSegmented TValue="bool" Value="_ctorClear" ValueChanged="v => { _ctorClear = v; UpdateConstructorCode(); }" Block="true" Size="sm" Options="_boolSeg2" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="4">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Block</SgTypography>
                                    <SgSegmented TValue="bool" Value="_ctorBlock" ValueChanged="v => { _ctorBlock = v; UpdateConstructorCode(); }" Block="true" Size="sm" Options="_boolSeg" />
                                </SgStack>
                            </SgCol>
                        </SgRow>
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorSize.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Variant</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorVariant.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Placement</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorPlacement.ToString()" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>
                    </SgStack>
                </SgCol>
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <div class="constructor-preview">
                                <SgTreeSelect Nodes="_constructorOptions"
                                            Placeholder="@_ctorPlaceholder"
                                            Size="@_ctorSize"
                                            Variant="@_ctorVariant"
                                            Placement="@_ctorPlacement"
                                            Multiple="@_ctorMultiple"
                                            ShowSearch="@_ctorSearch"
                                            Clearable="@_ctorClear"
                                            Block="@_ctorBlock" />
                            </div>
                        </SgStack>
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" @onclick="CopyCodeToClipboard">
                                    <span>@_copyIcon</span>
                                    <span style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                </button>
                            </div>
                            <div class="code-block">
                                @foreach (var line in _generatedCodeLines) { <code>@line</code> }
                            </div>
                        </SgStack>
                    </SgStack>
                </SgCol>
            </SgRow>
        </SgCard>
    </div>

</ChildContent>
</SgCard>

<style>
    .demo-section { margin-top: 48px; }
    .demo-section-header { margin-bottom: 20px; }

    .demo-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }
    @@media (max-width: 768px) {
        .demo-two-col { grid-template-columns: 1fr; }
    }

    .demo-selected {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 10px 14px;
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }
    .demo-ctor-input { width:100%; padding:6px 10px; border:1px solid var(--sg-border); border-radius:var(--sg-radius-md); background:var(--sg-bg); color:var(--sg-fg); font-size:13px; font-family:inherit; outline:none; transition:border-color .15s ease; box-sizing:border-box; }
    .demo-ctor-input:focus { border-color:var(--sg-color-primary); box-shadow:var(--sg-focus-ring); }
    .constructor-preview { background:var(--sg-surface-alt); border:1px solid var(--sg-border); border-radius:8px; padding:16px; min-height:60px; transition:all .3s ease; }
    .ctrl-summary { background:var(--sg-surface-alt); border:1px solid var(--sg-border); border-radius:8px; padding:12px 14px; }
    .code-block { background:#0f172a; color:#7dd3fc; padding:14px 16px; border-radius:8px; font-family:'JetBrains Mono','Fira Code',monospace; font-size:12px; line-height:1.9; overflow-x:auto; }
    .code-block code { background:none; padding:0; color:inherit; font-size:inherit; display:block; white-space:pre; }
    .demo-copy-btn { display:inline-flex; align-items:center; gap:4px; background:var(--sg-surface-alt); border:1px solid var(--sg-border); border-radius:6px; padding:4px 10px; cursor:pointer; color:var(--sg-text-muted); transition:all .2s ease; font-family:inherit; }
    .demo-copy-btn:hover { color:var(--sg-primary); border-color:var(--sg-primary); background:color-mix(in srgb, var(--sg-primary) 8%, transparent); }
    .demo-copy-btn:active { transform:scale(.95); }
</style>

@code {
    private RenderFragment _mainHeader => __builder =>
    {
        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
            <div style="display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,var(--sg-primary),#8b5cf6);color:#fff;flex-shrink:0;">
