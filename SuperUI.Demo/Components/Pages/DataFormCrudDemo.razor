@page "/data-form-crud"
@inject SgToastService Toasts

<PageTitle>CRUD Пример — SUI</PageTitle>

<div style="display:flex; flex-direction:column; gap:18px;">
    <SgCard Title="Управление сотрудниками (CRUD)">
        <div style="margin-bottom:16px; display:flex; justify-content:space-between; align-items:center;">
            <SgAlert Dense="true" Text="Полноценный CRUD-пример: SgDataGrid для списка и SgDataForm для редактирования в модальном окне." />
            <SgButton Text="Добавить сотрудника" Variant="SgButtonVariant.Primary" OnClick="OnAdd" />
        </div>

        <SgDataGrid TItem="Employee"
                    @ref="_grid"
                    Items="_employees"
                    ShowSearch="true"
                    PageSize="10">
            <SgDataGridColumn TItem="Employee" Title="ID" Value="e => e.Id" Width="60px" />
            <SgDataGridColumn TItem="Employee" Title="Имя" Value="e => e.FirstName" />
            <SgDataGridColumn TItem="Employee" Title="Фамилия" Value="e => e.LastName" />
            <SgDataGridColumn TItem="Employee" Title="Отдел" Value="e => e.Department" />
            <SgDataGridColumn TItem="Employee" Title="Зарплата" Value="e => e.Salary" Format="N0" />
            <SgDataGridColumn TItem="Employee" Title="Действия" Width="120px" Sortable="false" Filterable="false">
                <Template Context="e">
                    <div style="display:flex; gap:4px;">
                        <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="() => OnEdit(e)" title="Редактировать">✎</SgButton>
                        <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="() => OnDelete(e)" title="Удалить">🗑</SgButton>
                    </div>
                </Template>
            </SgDataGridColumn>
        </SgDataGrid>
    </SgCard>
</div>

<SgModal @bind-Visible="_modalVisible" Title="@(_isNew ? "Новый сотрудник" : "Редактирование")" Width="640px">
    <ChildContent>
        @if (_editingItem != null)
        {
            <SgDataForm TModel="Employee"
                        Model="_editingItem"
                        Columns="2"
                        SubmitText="@(_isNew ? "Создать" : "Сохранить")"
                        OnValidSubmit="HandleSubmit" />
        }
    </ChildContent>
</SgModal>

@code {
    private SgDataGrid<Employee>? _grid;
    private List<Employee> _employees = new();
    private Employee? _editingItem;
    private bool _modalVisible;
    private bool _isNew;

    protected override void OnInitialized()
    {
        // Начальные данные
        _employees.Add(new Employee { Id = 1, FirstName = "Иван", LastName = "Иванов", Department = DepartmentType.Engineering, Salary = 120000 });
        _employees.Add(new Employee { Id = 2, FirstName = "Анна", LastName = "Смирнова", Department = DepartmentType.Design, Salary = 110000 });
        _employees.Add(new Employee { Id = 3, FirstName = "Петр", LastName = "Петров", Department = DepartmentType.Marketing, Salary = 95000 });
    }

    private void OnAdd()
    {
        _isNew = true;
        _editingItem = new Employee { Id = _employees.Count > 0 ? _employees.Max(e => e.Id) + 1 : 1 };
        _modalVisible = true;
    }

    private void OnEdit(Employee item)
    {
        _isNew = false;
        // Создаем копию для редактирования
        _editingItem = new Employee
        {
            Id = item.Id,
            FirstName = item.FirstName,
            LastName = item.LastName,
            Email = item.Email,
            Department = item.Department,
            Salary = item.Salary,
            HireDate = item.HireDate,
            IsActive = item.IsActive,
            Notes = item.Notes
        };
        _modalVisible = true;
    }

    private void HandleSubmit(Employee model)
    {
        if (_isNew)
        {
            _employees.Add(model);
            Toasts.Success("Сотрудник добавлен");
        }
        else
        {
            var index = _employees.FindIndex(e => e.Id == model.Id);
            if (index != -1)
            {
                _employees[index] = model;
                Toasts.Success("Данные обновлены");
            }
        }
        _modalVisible = false;
        _editingItem = null;
        _grid?.Refresh(); // Refresh grid after changes
    }

    private void OnDelete(Employee item)
    {
        _employees.Remove(item);
        Toasts.Info("Сотрудник удален");
        _grid?.Refresh(); // Refresh grid after delete
    }
}

