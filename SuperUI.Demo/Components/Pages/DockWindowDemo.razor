@page "/dock-window-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Demo.Components

<PageTitle>Плавающее окно - SUI</PageTitle>

<div class="sgc-card" style="padding: 24px; border: 1px solid var(--sui-border); border-radius: var(--sui-radius);">
    <SgTypography Variant="SgTypographyVariant.Heading3" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 12px; display: block;; margin: 0 0 8px; font-size: 24px;">SgDockWindow - Плавающее окно</SgTypography>
    <p style="margin: 0 0 24px; color: var(--sui-text-muted);">Перетаскиваемое и изменяемое по размеру плавающее окно. Поддерживает минимизацию, максимизацию, несколько окон одновременно и управление z-index.</p>

    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Примеры использования</SgTypography>
        <p>Нажмите кнопку — откроется плавающее окно. Его можно перетаскивать за заголовок и изменять размер за правый нижний угол.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <div class="sgc-card" style="padding: 16px; border: 1px solid var(--sui-border); border-radius: var(--sui-radius);">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;; margin-top: 0;">Открыть окна</SgTypography>
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Базовые окна</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <SgButton Text="Окно 1" Variant="SgButtonVariant.Primary"
                                      OnClick="async () => { if (_win1Ref != null) await _win1Ref.OpenAsync(); }" />
                            <SgButton Text="Окно 2"
                                      OnClick="async () => { if (_win2Ref != null) await _win2Ref.OpenAsync(); }" />
                            <SgButton Text="Окно 3" Variant="SgButtonVariant.Outlined"
                                      OnClick="async () => { if (_win3Ref != null) await _win3Ref.OpenAsync(); }" />
                            <SgButton Text="Без портала" Variant="SgButtonVariant.Outlined"
                                      OnClick="async () => { if (_winNoPortalRef != null) await _winNoPortalRef.OpenAsync(); }" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Специальные варианты</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <SgButton Text="Без кнопок" Variant="SgButtonVariant.Outlined"
                                      OnClick="async () => { if (_winNoButtonsRef != null) await _winNoButtonsRef.OpenAsync(); }" />
                            <SgButton Text="С футером" Variant="SgButtonVariant.Outlined"
                                      OnClick="async () => { if (_winFooterRef != null) await _winFooterRef.OpenAsync(); }" />
                            <SgButton Text="Большое" Variant="SgButtonVariant.Outlined"
                                      OnClick="async () => { if (_winLargeRef != null) await _winLargeRef.OpenAsync(); }" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Массовые действия</div>
                        <SgButton Text="Открыть все" Variant="SgButtonVariant.Success" OnClick="OpenAll" />
                        <SgButton Text="Закрыть все" Variant="SgButtonVariant.Danger" CssClass="ms-2" OnClick="CloseAll" />
                    </div>
                </div>
            </div>

            <div class="sgc-card" style="padding: 16px; border: 1px solid var(--sui-border); border-radius: var(--sui-radius);">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;; margin-top: 0;">Свойства компонента</SgTypography>
                <PropertyTable Items="_properties" />
            </div>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Возможности</SgTypography>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 16px;">
            <div class="sgc-card" style="padding: 12px; border: 1px solid var(--sui-border); border-radius: var(--sui-radius);">
                <h4 style="margin: 0 0 8px;">Перетаскивание</h4>
                <p style="font-size: 13px; color: var(--sui-text-muted); margin: 0;">
                    Захватите окно за заголовок и перетащите в любое место экрана.
                </p>
            </div>
            <div class="sgc-card" style="padding: 12px; border: 1px solid var(--sui-border); border-radius: var(--sui-radius);">
                <h4 style="margin: 0 0 8px;">Изменение размера</h4>
                <p style="font-size: 13px; color: var(--sui-text-muted); margin: 0;">
                    Потяните за правый нижний угол чтобы изменить размер окна.
                </p>
            </div>
            <div class="sgc-card" style="padding: 12px; border: 1px solid var(--sui-border); border-radius: var(--sui-radius);">
                <h4 style="margin: 0 0 8px;">Несколько окон</h4>
                <p style="font-size: 13px; color: var(--sui-text-muted); margin: 0;">
                    Несколько окон одновременно. Клик по окну выводит его на передний план.
                </p>
            </div>
        </div>
    </div>
</div>

<SgDockWindow @ref="_win1Ref" @bind-Visible="_win1"
              Title="Окно 1 — Базовое"
              Left="60" Top="120"
              Width="380" Height="240">
    <ChildContent>
        <div style="padding: 8px; display: flex; flex-direction: column; gap: 12px;">
            <SgAlert Variant="SgAlertVariant.Info" Dense="true" Text="Это базовое плавающее окно. Перетащите его за заголовок." />
            <SgTextBox TValue="string" @bind-Value="_win1Text" Label="Введите текст" Placeholder="Текст..." />
            <div style="font-size: 12px; color: var(--sui-text-muted);">Значение: @(_win1Text ?? "—")</div>
        </div>
    </ChildContent>
</SgDockWindow>

<SgDockWindow @ref="_win2Ref" @bind-Visible="_win2"
              Title="Окно 2 — Статистика"
              Left="160" Top="180"
              Width="340" Height="260">
    <ChildContent>
        <div style="padding: 8px;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <SgStatistic Title="Пользователи"  Value="1 234"  TrendValue="0.12" />
                <SgStatistic Title="Заказы"        Value="342"    TrendValue="0.08" />
                <SgStatistic Title="Доход"         Value="98 765 ₽" TrendValue="0.25" />
                <SgStatistic Title="Конверсия"     Value="3.2%"   TrendValue="-0.02" />
            </div>
        </div>
    </ChildContent>
</SgDockWindow>

<SgDockWindow @ref="_win3Ref" @bind-Visible="_win3"
              Title="Окно 3 — Список задач"
              Left="260" Top="140"
              Width="320" Height="280">
    <ChildContent>
        <div style="padding: 8px; display: flex; flex-direction: column; gap: 8px;">
            @foreach (var task in _tasks)
            {
                <div @key="task.Title" style="display: flex; align-items: center; gap: 10px; padding: 6px 8px; border: 1px solid var(--sui-border); border-radius: 6px;">
                    <SgCheckBox @bind-Value="task.Done" />
                    <span style="flex: 1; @(task.Done ? "text-decoration: line-through; color: var(--sui-text-muted);" : "")">@task.Title</span>
                    <SgBadge Text="@task.Priority" Variant="@task.BadgeVariant" />
                </div>
            }
        </div>
    </ChildContent>
</SgDockWindow>

<SgDockWindow @ref="_winNoPortalRef" @bind-Visible="_winNoPortal"
              Title="Локальное окно"
              UsePortal="false"
              Left="320" Top="200"
              Width="300" Height="180">
    <ChildContent>
        <div style="padding: 12px;">
            <p style="margin: 0; font-size: 13px;">Это окно отрендерено без использования портала. Оно находится прямо внутри DOM-дерева страницы, а не в конце &lt;body&gt;.</p>
            <div style="margin-top: 12px; font-size: 11px; color: var(--sui-text-muted)">
                Контейнер: SuperUI.Demo.Components.Pages.DockWindowDemo
            </div>
        </div>
    </ChildContent>
</SgDockWindow>

<SgDockWindow @ref="_winNoButtonsRef" @bind-Visible="_winNoButtons"
              Title="Без кнопок управления"
              Left="100" Top="200"
              Width="300" Height="180"
              ShowMinimize="false"
              ShowMaximize="false">
    <ChildContent>
        <div style="padding: 8px;">
            <p style="margin: 0 0 12px; font-size: 13px;">Это окно без кнопок минимизации и максимизации. Только закрытие.</p>
            <SgButton Text="Закрыть" Variant="SgButtonVariant.Danger" Size="SgSize.Sm" OnClick="@(() => _winNoButtons = false)" />
        </div>
    </ChildContent>
</SgDockWindow>

<SgDockWindow @ref="_winFooterRef" @bind-Visible="_winFooter"
              Title="Окно с футером"
              Left="200" Top="160"
              Width="360" Height="220">
    <ChildContent>
        <div style="padding: 8px; display: flex; flex-direction: column; gap: 12px;">
            <SgTextBox TValue="string" @bind-Value="_footerName" Label="Имя" Placeholder="Введите имя..." />
            <SgTextBox TValue="string" @bind-Value="_footerEmail" Label="Email" Placeholder="email@example.com" Type="email" />
        </div>
    </ChildContent>
    <FooterContent>
        <div style="display: flex; gap: 8px; justify-content: flex-end;">
            <SgButton Text="Отмена" Size="SgSize.Sm" OnClick="@(() => _winFooter = false)" />
            <SgButton Text="Сохранить" Variant="SgButtonVariant.Primary" Size="SgSize.Sm" OnClick="@(() => _winFooter = false)" />
        </div>
    </FooterContent>
</SgDockWindow>

<SgDockWindow @ref="_winLargeRef" @bind-Visible="_winLarge"
              Title="Большое окно — Таблица"
              Left="80" Top="100"
              Width="600" Height="360">
    <ChildContent>
        <div style="padding: 8px;">
            <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                <thead>
                    <tr style="background: var(--sui-bg-secondary);">
                        <th style="padding: 8px; text-align: left; border-bottom: 1px solid var(--sui-border);">Имя</th>
                        <th style="padding: 8px; text-align: left; border-bottom: 1px solid var(--sui-border);">Отдел</th>
                        <th style="padding: 8px; text-align: right; border-bottom: 1px solid var(--sui-border);">Зарплата</th>
                        <th style="padding: 8px; text-align: center; border-bottom: 1px solid var(--sui-border);">Статус</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in _employees)
                    {
                        <tr @key="emp.Name" style="border-bottom: 1px solid var(--sui-border);">
                            <td style="padding: 8px;">@emp.Name</td>
                            <td style="padding: 8px; color: var(--sui-text-muted);">@emp.Dept</td>
                            <td style="padding: 8px; text-align: right;">@emp.Salary.ToString("N0") ₽</td>
                            <td style="padding: 8px; text-align: center;">
                                <SgBadge Text="@(emp.Active ? "Активен" : "Неактивен")"
                                         Variant="@(emp.Active ? SgBadgeVariant.Success : SgBadgeVariant.Muted)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </ChildContent>
</SgDockWindow>

@code {
    private bool _win1;
    private bool _win2;
    private bool _win3;
    private bool _winNoPortal;
    private bool _winNoButtons;
    private bool _winFooter;
    private bool _winLarge;

    private SgDockWindow? _win1Ref;
    private SgDockWindow? _win2Ref;
    private SgDockWindow? _win3Ref;
    private SgDockWindow? _winNoPortalRef;
    private SgDockWindow? _winNoButtonsRef;
    private SgDockWindow? _winFooterRef;
    private SgDockWindow? _winLargeRef;

    private string? _win1Text;
    private string? _footerName;
    private string? _footerEmail;

    private async Task OpenAll()
    {
        if (_win1Ref != null) await _win1Ref.OpenAsync();
        if (_win2Ref != null) await _win2Ref.OpenAsync();
        if (_win3Ref != null) await _win3Ref.OpenAsync();
        if (_winNoPortalRef != null) await _winNoPortalRef.OpenAsync();
        if (_winNoButtonsRef != null) await _winNoButtonsRef.OpenAsync();
        if (_winFooterRef != null) await _winFooterRef.OpenAsync();
        if (_winLargeRef != null) await _winLargeRef.OpenAsync();
    }

    private void CloseAll()
    {
        _win1 = _win2 = _win3 = _winNoPortal = _winNoButtons = _winFooter = _winLarge = false;
    }

    public class TaskItem
    {
        public string Title { get; set; } = "";
        public string Priority { get; set; } = "";
        public SgBadgeVariant BadgeVariant { get; set; } = SgBadgeVariant.Default;
        public bool Done { get; set; }
    }

    private List<TaskItem> _tasks = new()
    {
        new() { Title = "Обновить документацию",  Priority = "Высокий", BadgeVariant = SgBadgeVariant.Danger },
        new() { Title = "Написать тесты",          Priority = "Средний", BadgeVariant = SgBadgeVariant.Warn,    Done = true },
        new() { Title = "Ревью кода",              Priority = "Высокий", BadgeVariant = SgBadgeVariant.Danger },
        new() { Title = "Деплой на staging",       Priority = "Низкий",  BadgeVariant = SgBadgeVariant.Muted,   Done = true },
        new() { Title = "Встреча с командой",      Priority = "Средний", BadgeVariant = SgBadgeVariant.Warn },
    };

    public record EmpRow(string Name, string Dept, int Salary, bool Active);

    private List<EmpRow> _employees = new()
    {
        new("Иван Петров",    "Разработка", 145000, true),
        new("Мария Сидорова", "Дизайн",     120000, true),
        new("Алексей Козлов", "Маркетинг",   95000, false),
        new("Елена Новикова", "Продукт",    130000, true),
        new("Дмитрий Волков", "HR",          88000, true),
    };

    private List<PropertyPanelItem> _properties = new()
    {
        new() { Label = "Visible",       Value = "bool",                BadgeText = "Видимость",         BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Title",         Value = "string",              BadgeText = "Заголовок",         BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Left",          Value = "double",              BadgeText = "Позиция X (px)",    BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Top",           Value = "double",              BadgeText = "Позиция Y (px)",    BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Width",         Value = "double",              BadgeText = "Ширина (px)",       BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Height",        Value = "double",              BadgeText = "Высота (px)",       BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ShowClose",     Value = "bool",                BadgeText = "Кнопка закрытия",  BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowMinimize",  Value = "bool",                BadgeText = "Минимизация",       BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowMaximize",  Value = "bool",                BadgeText = "Максимизация",      BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Draggable",     Value = "bool",                BadgeText = "Перетаскивание",    BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Resizable",     Value = "bool",                BadgeText = "Изменение размера", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ChildContent",  Value = "RenderFragment",      BadgeText = "Содержимое",        BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "FooterContent", Value = "RenderFragment",      BadgeText = "Футер",             BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "BoundsChanged", Value = "EventCallback<WindowBounds>", BadgeText = "Позиция/размер", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "VisibleChanged", Value = "EventCallback<bool>", BadgeText = "Событие изменения", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnClose",       Value = "EventCallback",       BadgeText = "Закрытие",          BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "UsePortal",     Value = "bool",                BadgeText = "Использовать портал", BadgeVariant = SgBadgeVariant.Warn },
    };
}
