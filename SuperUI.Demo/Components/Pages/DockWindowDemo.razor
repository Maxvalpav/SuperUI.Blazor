@page "/dock-window-demo"
@using SuperUI.Components

<PageTitle>Плавающее окно - SUI</PageTitle>

<SgCard Title="SgDockWindow - Плавающее окно"
        Subtitle="Перетаскиваемое и изменяемое по размеру плавающее окно. Поддерживает минимизацию, максимизацию, несколько окон одновременно и управление z-index.">

    <!-- Кнопки открытия -->
    <div style="margin-top: 32px;">
        <h2>Примеры использования</h2>
        <p>Нажмите кнопку — откроется плавающее окно. Его можно перетаскивать за заголовок и изменять размер за правый нижний угол.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Открыть окна">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Базовые окна</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <SgButton Text="Открыть окно 1" Variant="primary"
                                      OnClick="@(() => _win1 = true)" />
                            <SgButton Text="Открыть окно 2"
                                      OnClick="@(() => _win2 = true)" />
                            <SgButton Text="Открыть окно 3" Variant="outlined"
                                      OnClick="@(() => _win3 = true)" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Специальные варианты</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <SgButton Text="Без кнопок управления" Variant="ghost"
                                      OnClick="@(() => _winNoButtons = true)" />
                            <SgButton Text="С футером" Variant="ghost"
                                      OnClick="@(() => _winFooter = true)" />
                            <SgButton Text="Большое окно" Variant="ghost"
                                      OnClick="@(() => _winLarge = true)" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Открыть все сразу</div>
                        <SgButton Text="Открыть все окна" Variant="success" OnClick="OpenAll" />
                        <SgButton Text="Закрыть все" Variant="danger" CssClass="ms-2" OnClick="CloseAll" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_properties" />
            </SgCard>
        </div>
    </div>

    <!-- Описание возможностей -->
    <div style="margin-top: 32px;">
        <h2>Возможности</h2>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 16px;">
            <SgCard Title="🖱️ Перетаскивание">
                <p style="font-size: 13px; color: var(--sui-text-muted); margin: 0;">
                    Захватите окно за заголовок и перетащите в любое место экрана.
                </p>
            </SgCard>
            <SgCard Title="↔️ Изменение размера">
                <p style="font-size: 13px; color: var(--sui-text-muted); margin: 0;">
                    Потяните за правый нижний угол чтобы изменить размер окна.
                </p>
            </SgCard>
            <SgCard Title="🪟 Несколько окон">
                <p style="font-size: 13px; color: var(--sui-text-muted); margin: 0;">
                    Несколько окон одновременно. Клик по окну выводит его на передний план.
                </p>
            </SgCard>
            <SgCard Title="— Минимизация">
                <p style="font-size: 13px; color: var(--sui-text-muted); margin: 0;">
                    Кнопка «—» сворачивает окно до заголовка. Повторный клик разворачивает.
                </p>
            </SgCard>
            <SgCard Title="▢ Максимизация">
                <p style="font-size: 13px; color: var(--sui-text-muted); margin: 0;">
                    Кнопка «▢» разворачивает окно на весь экран. «❐» возвращает обратно.
                </p>
            </SgCard>
            <SgCard Title="× Закрытие">
                <p style="font-size: 13px; color: var(--sui-text-muted); margin: 0;">
                    Кнопка «×» закрывает окно. Можно переоткрыть кнопкой на странице.
                </p>
            </SgCard>
        </div>
    </div>

</SgCard>

<!-- Окно 1 — базовое -->
<SgDockWindow @bind-Visible="_win1"
              Title="Окно 1 — Базовое"
              Left="60" Top="120"
              Width="380" Height="240">
    <ChildContent>
        <div style="padding: 8px; display: flex; flex-direction: column; gap: 12px;">
            <SgAlert Variant="info" Dense="true" Text="Это базовое плавающее окно. Перетащите его за заголовок." />
            <SgTextBox TValue="string" @bind-Value="_win1Text" Label="Введите текст" Placeholder="Текст..." />
            <div style="font-size: 12px; color: var(--sui-text-muted);">Значение: @(_win1Text ?? "—")</div>
        </div>
    </ChildContent>
</SgDockWindow>

<!-- Окно 2 — с данными -->
<SgDockWindow @bind-Visible="_win2"
              Title="Окно 2 — Статистика"
              Left="160" Top="180"
              Width="340" Height="260">
    <ChildContent>
        <div style="padding: 8px;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <SgStatistic Title="Пользователи"  Value="1 234"  TrendValue="0.12" />
                <SgStatistic Title="Заказы"        Value="342"    TrendValue="0.08" />
                <SgStatistic Title="Доход"         Value="98 765 ₽" TrendValue="0.25" />
                <SgStatistic Title="Конверсия"     Value="3.2%"   TrendValue="-0.02" />
            </div>
        </div>
    </ChildContent>
</SgDockWindow>

<!-- Окно 3 — список -->
<SgDockWindow @bind-Visible="_win3"
              Title="Окно 3 — Список задач"
              Left="260" Top="140"
              Width="320" Height="280">
    <ChildContent>
        <div style="padding: 8px; display: flex; flex-direction: column; gap: 8px;">
            @foreach (var task in _tasks)
            {
                var t = task;
                <div style="display: flex; align-items: center; gap: 10px; padding: 6px 8px; border: 1px solid var(--sui-border); border-radius: 6px;">
                    <SgCheckBox @bind-Value="t.Done" />
                    <span style="flex: 1; @(t.Done ? "text-decoration: line-through; color: var(--sui-text-muted);" : "")">@t.Title</span>
                    <SgBadge Text="@t.Priority" Variant="@t.BadgeVariant" />
                </div>
            }
        </div>
    </ChildContent>
</SgDockWindow>

<!-- Окно без кнопок управления -->
<SgDockWindow @bind-Visible="_winNoButtons"
              Title="Без кнопок управления"
              Left="100" Top="200"
              Width="300" Height="180"
              ShowMinimize="false"
              ShowMaximize="false">
    <ChildContent>
        <div style="padding: 8px;">
            <p style="margin: 0 0 12px; font-size: 13px;">Это окно без кнопок минимизации и максимизации. Только закрытие.</p>
            <SgButton Text="Закрыть" Variant="danger" Size="sm" OnClick="@(() => _winNoButtons = false)" />
        </div>
    </ChildContent>
</SgDockWindow>

<!-- Окно с футером -->
<SgDockWindow @bind-Visible="_winFooter"
              Title="Окно с футером"
              Left="200" Top="160"
              Width="360" Height="220">
    <ChildContent>
        <div style="padding: 8px; display: flex; flex-direction: column; gap: 12px;">
            <SgTextBox TValue="string" @bind-Value="_footerName" Label="Имя" Placeholder="Введите имя..." />
            <SgTextBox TValue="string" @bind-Value="_footerEmail" Label="Email" Placeholder="email@example.com" Type="email" />
        </div>
    </ChildContent>
    <FooterContent>
        <div style="display: flex; gap: 8px; justify-content: flex-end;">
            <SgButton Text="Отмена" Size="sm" OnClick="@(() => _winFooter = false)" />
            <SgButton Text="Сохранить" Variant="primary" Size="sm" OnClick="@(() => _winFooter = false)" />
        </div>
    </FooterContent>
</SgDockWindow>

<!-- Большое окно -->
<SgDockWindow @bind-Visible="_winLarge"
              Title="Большое окно — Таблица"
              Left="80" Top="100"
              Width="600" Height="360">
    <ChildContent>
        <div style="padding: 8px;">
            <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                <thead>
                    <tr style="background: var(--sui-bg-secondary);">
                        <th style="padding: 8px; text-align: left; border-bottom: 1px solid var(--sui-border);">Имя</th>
                        <th style="padding: 8px; text-align: left; border-bottom: 1px solid var(--sui-border);">Отдел</th>
                        <th style="padding: 8px; text-align: right; border-bottom: 1px solid var(--sui-border);">Зарплата</th>
                        <th style="padding: 8px; text-align: center; border-bottom: 1px solid var(--sui-border);">Статус</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in _employees)
                    {
                        <tr style="border-bottom: 1px solid var(--sui-border);">
                            <td style="padding: 8px;">@emp.Name</td>
                            <td style="padding: 8px; color: var(--sui-text-muted);">@emp.Dept</td>
                            <td style="padding: 8px; text-align: right;">@emp.Salary.ToString("N0") ₽</td>
                            <td style="padding: 8px; text-align: center;">
                                <SgBadge Text="@(emp.Active ? "Активен" : "Неактивен")"
                                         Variant="@(emp.Active ? "success" : "muted")" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </ChildContent>
</SgDockWindow>

@code {
    private bool _win1;
    private bool _win2;
    private bool _win3;
    private bool _winNoButtons;
    private bool _winFooter;
    private bool _winLarge;

    private string? _win1Text;
    private string? _footerName;
    private string? _footerEmail;

    private void OpenAll()
    {
        _win1 = true; _win2 = true; _win3 = true;
        _winFooter = true; _winLarge = true;
    }

    private void CloseAll()
    {
        _win1 = false; _win2 = false; _win3 = false;
        _winNoButtons = false; _winFooter = false; _winLarge = false;
    }

    private class TaskItem
    {
        public string Title { get; set; } = "";
        public string Priority { get; set; } = "";
        public string BadgeVariant { get; set; } = "default";
        public bool Done { get; set; }
    }

    private List<TaskItem> _tasks = new()
    {
        new() { Title = "Обновить документацию",  Priority = "Высокий", BadgeVariant = "danger" },
        new() { Title = "Написать тесты",          Priority = "Средний", BadgeVariant = "warn",    Done = true },
        new() { Title = "Ревью кода",              Priority = "Высокий", BadgeVariant = "danger" },
        new() { Title = "Деплой на staging",       Priority = "Низкий",  BadgeVariant = "muted",   Done = true },
        new() { Title = "Встреча с командой",      Priority = "Средний", BadgeVariant = "warn" },
    };

    private record EmpRow(string Name, string Dept, int Salary, bool Active);

    private List<EmpRow> _employees = new()
    {
        new("Иван Петров",    "Разработка", 145000, true),
        new("Мария Сидорова", "Дизайн",     120000, true),
        new("Алексей Козлов", "Маркетинг",   95000, false),
        new("Елена Новикова", "Продукт",    130000, true),
        new("Дмитрий Волков", "HR",          88000, true),
    };

    private List<PropertyPanelItem> _properties = new()
    {
        new() { Label = "Visible",      Value = "bool",               BadgeText = "Видимо",           BadgeVariant = "warn" },
        new() { Label = "Title",        Value = "string",             BadgeText = "Заголовок",         BadgeVariant = "info" },
        new() { Label = "Left",         Value = "double",             BadgeText = "Позиция X (px)",    BadgeVariant = "info" },
        new() { Label = "Top",          Value = "double",             BadgeText = "Позиция Y (px)",    BadgeVariant = "info" },
        new() { Label = "Width",        Value = "double",             BadgeText = "Ширина (px)",       BadgeVariant = "info" },
        new() { Label = "Height",       Value = "double",             BadgeText = "Высота (px)",       BadgeVariant = "info" },
        new() { Label = "ShowClose",    Value = "bool",               BadgeText = "Кнопка закрытия",  BadgeVariant = "warn" },
        new() { Label = "ShowMinimize", Value = "bool",               BadgeText = "Минимизация",       BadgeVariant = "warn" },
        new() { Label = "ShowMaximize", Value = "bool",               BadgeText = "Максимизация",      BadgeVariant = "warn" },
        new() { Label = "ChildContent", Value = "RenderFragment",     BadgeText = "Содержимое",        BadgeVariant = "info" },
        new() { Label = "FooterContent",Value = "RenderFragment",     BadgeText = "Футер",             BadgeVariant = "info" },
        new() { Label = "VisibleChanged",Value = "EventCallback<bool>",BadgeText = "Событие",         BadgeVariant = "success" },
        new() { Label = "OnClose",      Value = "EventCallback",      BadgeText = "Закрытие",          BadgeVariant = "success" },
    };
}
