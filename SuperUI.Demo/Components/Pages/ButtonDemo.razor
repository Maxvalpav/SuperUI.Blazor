@page "/demo/button"
@using SuperUI.Demo.Components

<div class="demo-page">
    <div class="demo-hero">
        <section class="demo-hero-main">
            <div class="demo-header">
                <div class="demo-kicker">Input Components</div>
                <h1 class="demo-title">SgButton</h1>
                <p class="demo-subtitle">
                    Universal action component with variants, sizes, loading state, toggle behavior and optional debounce support.
                    Works well for static SSR, interactive server and WebAssembly render modes.
                </p>
            </div>
        </section>

        <aside class="demo-hero-side">
            <div class="demo-side-title">Highlights</div>
            <div class="demo-pill-list">
                <span class="demo-pill demo-pill-accent">SSR Safe</span>
                <span class="demo-pill">Debounce</span>
                <span class="demo-pill">Toggle Mode</span>
                <span class="demo-pill">Fluent CSS</span>
            </div>

            <div class="demo-meta-grid">
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Variants</span>
                    <span class="demo-meta-value">Default, Primary, Success, Danger, Ghost, Outlined</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Sizes</span>
                    <span class="demo-meta-value">Sm, Md, Lg, Xl</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Accessibility</span>
                    <span class="demo-meta-value">`aria-busy`, `aria-disabled`, `aria-pressed`</span>
                </div>
            </div>
        </aside>
    </div>

    <SgDemoSection Eyebrow="Usage" Title="Examples" Description="Common button patterns used across dashboards, forms and command surfaces.">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Variants</h3>
                    <p class="demo-showcase-desc">Use semantic variants to emphasize action priority.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <div class="demo-row">
                            <SgButton Text="Default" Variant="SgButtonVariant.Default" />
                            <SgButton Text="Primary" Variant="SgButtonVariant.Primary" />
                            <SgButton Text="Success" Variant="SgButtonVariant.Success" />
                            <SgButton Text="Danger" Variant="SgButtonVariant.Danger" />
                            <SgButton Text="Ghost" Variant="SgButtonVariant.Ghost" />
                            <SgButton Text="Outlined" Variant="SgButtonVariant.Outlined" />
                        </div>
                    </div>
                    <div class="demo-note">Primary is ideal for the main CTA, while Ghost and Outlined fit secondary actions.</div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Sizes</h3>
                    <p class="demo-showcase-desc">Scale actions for dense toolbars or prominent form submissions.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <div class="demo-row">
                            <SgButton Text="Small" Size="SgSize.Sm" Variant="SgButtonVariant.Primary" />
                            <SgButton Text="Medium" Size="SgSize.Md" Variant="SgButtonVariant.Primary" />
                            <SgButton Text="Large" Size="SgSize.Lg" Variant="SgButtonVariant.Primary" />
                            <SgButton Text="Extra Large" Size="SgSize.Xl" Variant="SgButtonVariant.Primary" />
                        </div>
                    </div>
                    <div class="demo-note">`Md` is the default size and usually the best choice for balanced layouts.</div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">States</h3>
                    <p class="demo-showcase-desc">Visual feedback for disabled, async and guarded interactions.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <div class="demo-row">
                            <SgButton Text="Disabled" Disabled="true" Variant="SgButtonVariant.Primary" />
                            <SgButton Text="Loading" Loading="true" Variant="SgButtonVariant.Primary" />
                            <SgButton Text="Debounced 3s" DebounceInterval="3000" Variant="SgButtonVariant.Success" />
                        </div>
                    </div>
                    <div class="demo-note">Debounce is disabled by default and only activates when `DebounceInterval` is explicitly set.</div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Toggle Mode</h3>
                    <p class="demo-showcase-desc">Two-state button with visual feedback for selection.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <div class="demo-row">
                            <SgButton Text="Toggle Me" IsToggle="true" Variant="SgButtonVariant.Outlined" />
                            <SgButton Text="Primary Toggle" IsToggle="true" Variant="SgButtonVariant.Primary" />
                        </div>
                    </div>
                    <div class="demo-note">Perfect for selection tools, filters or on/off switches.</div>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoParams Title="Button Parameters" Description="Parameters for customizing the appearance and behavior of the SgButton component.">
        <SgDemoParam Name="Text" Type="string" Description="The text to display inside the button." DefaultValue="null" />
        <SgDemoParam Name="Variant" Type="SgButtonVariant" Description="The semantic style of the button." Values="Default, Primary, Success, Danger, Ghost, Outlined" DefaultValue="Default" />
        <SgDemoParam Name="Size" Type="SgSize" Description="The size of the button." Values="Sm, Md, Lg, Xl" DefaultValue="Md" />
        <SgDemoParam Name="Disabled" Type="bool" Description="Whether the button is disabled." DefaultValue="false" />
        <SgDemoParam Name="Loading" Type="bool" Description="Whether the button is in a loading state (shows a spinner)." DefaultValue="false" />
        <SgDemoParam Name="Block" Type="bool" Description="Whether the button should take up the full width of its container." DefaultValue="false" />
        <SgDemoParam Name="IsToggle" Type="bool" Description="Whether the button acts as a toggle (two-state)." DefaultValue="false" />
        <SgDemoParam Name="Pressed" Type="bool" Description="The current state of the toggle button." DefaultValue="false" />
        <SgDemoParam Name="DebounceInterval" Type="int" Description="Optional interval in milliseconds that temporarily blocks repeated clicks after activation." DefaultValue="0" />
        <SgDemoParam Name="Icon" Type="RenderFragment" Description="Optional icon to display before the text." DefaultValue="null" />
        <SgDemoParam Name="ChildContent" Type="RenderFragment" Description="Custom content to display inside the button." DefaultValue="null" />
    </SgDemoParams>
</div>

@code {
    private bool _isPressed;
}
