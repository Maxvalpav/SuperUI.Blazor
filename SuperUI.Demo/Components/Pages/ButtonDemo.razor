@page "/button-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models

<PageTitle>Button - SUI</PageTitle>

<SgCard Title="Button Components"
        Subtitle="SgButton, SgIconButton, SgFab, and SgButtonGroup — complete set of button components with variants, sizes, states, and interactive demos."
        CssClass="sgc-card-flush">

    <SgSpace Orientation="SgOrientation.Vertical" Size="large" Style="margin-top: 24px;">

        @* -1;sgbutton *@
        <DemoSection BadgeText="Interactive" BadgeVariant="SgBadgeVariant.Success">
            <HeaderContent>
                <div class="demo-section-header">
                    <SgTypography Variant="SgTypographyVariant.Heading3" Weight="SgTypographyWeight.Semibold">SgButton</SgTypography>
                    <span class="demo-live-badge">Interactive</span>
                </div>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" CssClass="demo-section-desc">
                    Universal button component supporting various variants, sizes, and states. Click the button to see the click counter.
                </SgTypography>
            </HeaderContent>
            <ChildContent>
                <div class="demo-grid-adaptive">
                    <SgCard Title="Usage Examples" CssClass="demo-interactive-card">
                        <div class="demo-flex-col">
                            <div>
                                <div class="demo-label">Variants</div>
                                <div class="demo-flex-row">
                                    <SgButton Text="Default" />
                                    <SgButton Text="Primary"  Variant="SgButtonVariant.Primary" />
                                    <SgButton Text="Success"  Variant="SgButtonVariant.Success" />
                                    <SgButton Text="Danger"   Variant="SgButtonVariant.Danger" />
                                    <SgButton Text="Ghost"    Variant="SgButtonVariant.Ghost" />
                                    <SgButton Text="Outlined" Variant="SgButtonVariant.Outlined" />
                                    <SgButton Text="Dashed"   Variant="SgButtonVariant.Dashed" />
                                </div>
                            </div>
                            <SgDivider />
                            <div>
                                <div class="demo-label">Sizes</div>
                                <div class="demo-flex-row">
                                    <SgButton Text="Small"  Size="SgSize.Sm" Variant="SgButtonVariant.Primary" />
                                    <SgButton Text="Medium" Size="SgSize.Md" Variant="SgButtonVariant.Primary" />
                                    <SgButton Text="Large"  Size="SgSize.Lg" Variant="SgButtonVariant.Primary" />
                                </div>
                            </div>
                            <SgDivider />
                            <div>
                                <div class="demo-label">States</div>
                                <div class="demo-flex-row">
                                    <SgButton Text="Disabled" Disabled="true" />
                                    <SgButton Text="Loading" Loading="true" />
                                    <SgButton Text="Block" Block="true" Variant="SgButtonVariant.Primary" />
                                </div>
                            </div>
                            <SgDivider />
                            <div>
                                <div class="demo-label">Dynamic — Click Counter</div>
                                <div class="demo-flex-row">
                                    <SgButton Text="@($"Clicked: {_btnClickCount}")" Variant="SgButtonVariant.Primary" OnClick="@(() => _btnClickCount++)" />
                                    <SgButton Text="Reset" Variant="SgButtonVariant.Ghost" OnClick="@(() => _btnClickCount = 0)" />
                                    <div class="demo-value-display">
                                        <span class="demo-value-display-label">Clicks</span>
                                        <span class="demo-value-display-value">@_btnClickCount</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </SgCard>
                    <SgCard Title="Component Properties">
                        <PropertyTable Items="_buttonProperties" />
                    </SgCard>
                </div>

                <div class="demo-interactive-controls">
                    <div class="demo-control-group">
                        <SgCheckBox @bind-Value="_btnDisabled" Label="Disabled" />
                    </div>
                    <div class="demo-control-group">
                        <SgCheckBox @bind-Value="_btnLoading" Label="Loading" />
                    </div>
                    <div class="demo-control-group">
                        <SgCheckBox @bind-Value="_btnBlock" Label="Block" />
                    </div>
                </div>

                <div class="sgc-demo-flex-row" style="margin-top:12px;">
                    <SgButton Text="@($"Dynamic Button")" Disabled="_btnDisabled" Loading="_btnLoading" Block="_btnBlock" Variant="SgButtonVariant.Primary" />
                </div>

                <DemoCodeBlock Code="@_buttonCode" Title="SgButton usage" />
            </ChildContent>
        </DemoSection>

        @* -2;sgiconbutton *@
        <DemoSection BadgeText="Interactive" BadgeVariant="SgBadgeVariant.Success">
            <HeaderContent>
                <div class="demo-section-header">
                    <SgTypography Variant="SgTypographyVariant.Heading3" Weight="SgTypographyWeight.Semibold">SgIconButton</SgTypography>
                    <span class="demo-live-badge">Interactive</span>
                </div>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" CssClass="demo-section-desc">
                    Compact icon-only button. Supports round and square shapes, badges, toggle mode, and all color variants.
                </SgTypography>
            </HeaderContent>
            <ChildContent>
                <div class="demo-grid-adaptive">
                    <SgCard Title="Variants and Sizes" CssClass="demo-interactive-card">
                        <div class="demo-flex-col">
                            <div>
                                <div class="demo-label">Variants (Round)</div>
                                <div class="demo-flex-row">
                                    <SgIconButton Icon="@SgIcons.Settings" Title="Default" />
                                    <SgIconButton Icon="@SgIcons.Plus"     Title="Primary"  Variant="SgButtonVariant.Primary" />
                                    <SgIconButton Icon="@SgIcons.Check"    Title="Success"  Variant="SgButtonVariant.Success" />
                                    <SgIconButton Icon="@SgIcons.X"        Title="Danger"   Variant="SgButtonVariant.Danger" />
                                    <SgIconButton Icon="@SgIcons.Search"   Title="Ghost"    Variant="SgButtonVariant.Ghost" />
                                    <SgIconButton Icon="@SgIcons.Edit"     Title="Outlined" Variant="SgButtonVariant.Outlined" />
                                </div>
                            </div>
                            <SgDivider />
                            <div>
                                <div class="demo-label">Square (Round=false)</div>
                                <div class="demo-flex-row">
                                    <SgIconButton Icon="@SgIcons.Settings" Title="Default"  Round="false" />
                                    <SgIconButton Icon="@SgIcons.Plus"     Title="Primary"  Round="false" Variant="SgButtonVariant.Primary" />
                                    <SgIconButton Icon="@SgIcons.Edit"     Title="Outlined" Round="false" Variant="SgButtonVariant.Outlined" />
                                </div>
                            </div>
                            <SgDivider />
                            <div>
                                <div class="demo-label">Sizes</div>
                                <div class="demo-flex-row">
                                    <SgIconButton Icon="@SgIcons.Settings" Title="Sm" Size="SgSize.Sm" Variant="SgButtonVariant.Primary" />
                                    <SgIconButton Icon="@SgIcons.Settings" Title="Md" Size="SgSize.Md" Variant="SgButtonVariant.Primary" />
                                    <SgIconButton Icon="@SgIcons.Settings" Title="Lg" Size="SgSize.Lg" Variant="SgButtonVariant.Primary" />
                                    <SgIconButton Icon="@SgIcons.Settings" Title="Xl" Size="SgSize.Xl" Variant="SgButtonVariant.Primary" />
                                </div>
                            </div>
                            <SgDivider />
                            <div>
                                <div class="demo-label">Badges and Indicators</div>
                                <div class="demo-flex-row">
                                    <SgIconButton Icon="@SgIcons.Settings" Title="3 notifications" BadgeCount="3" />
                                    <SgIconButton Icon="@SgIcons.Settings" Title="99+ notifications" BadgeCount="120" />
                                    <SgIconButton Icon="@SgIcons.Settings" Title="New" BadgeDot="true" />
                                    <SgIconButton Icon="@SgIcons.Settings" Title="Disabled" Disabled="true" />
                                    <SgIconButton Icon="@SgIcons.Settings" Title="Loading" Loading="true" />
                                </div>
                            </div>
                            <SgDivider />
                            <div>
                                <div class="demo-label">Toggle and Group</div>
                                <div class="demo-flex-row">
                                    <SgIconButton Icon="@SgIcons.Check" Title="Toggle" IsToggle="true"
                                                  @bind-Pressed="_togglePressed"
                                                  Variant="@(_togglePressed ? SgButtonVariant.Primary : SgButtonVariant.Default)" />
                                    <SgBadge Text="@(_togglePressed ? "Pressed" : "Not Pressed")"
                                             Variant="@(_togglePressed ? SgBadgeVariant.Info : SgBadgeVariant.Muted)" />
                                    <div class="sgc-icon-btn-group">
                                        <SgIconButton Icon="@SgIcons.ArrowUp"   Title="Up"     Size="SgSize.Sm" />
                                        <SgIconButton Icon="@SgIcons.ArrowDown" Title="Down"   Size="SgSize.Sm" />
                                        <SgIconButton Icon="@SgIcons.Refresh"   Title="Refresh" Size="SgSize.Sm" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </SgCard>
                    <SgCard Title="SgIconButton Properties">
                        <PropertyTable Items="_iconBtnProperties" />
                    </SgCard>
                </div>

                <DemoCodeBlock Code="@_iconButtonCode" Title="SgIconButton usage" />
            </ChildContent>
        </DemoSection>

        @* -3;sgfab *@
        <DemoSection BadgeText="Floating Action" BadgeVariant="SgBadgeVariant.Info">
            <HeaderContent>
                <div class="demo-section-header">
                    <SgTypography Variant="SgTypographyVariant.Heading3" Weight="SgTypographyWeight.Semibold">SgFab</SgTypography>
                    <span class="demo-live-badge">Floating Action</span>
                </div>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" CssClass="demo-section-desc">
                    Floating action button. Supports extended mode with text, different sizes and variants.
                </SgTypography>
            </HeaderContent>
            <ChildContent>
                <div class="demo-grid-adaptive">
                    <SgCard Title="Variants and Modes" CssClass="demo-interactive-card">
                        <div class="demo-flex-col">
                            <div>
                                <div class="demo-label">Variants</div>
                                <div class="demo-flex-row">
                                    <div style="display:flex;flex-direction:column;align-items:center;gap:6px;">
                                        <SgFab Icon="@SgIcons.Plus" Title="Primary" />
                                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Primary</SgTypography>
                                    </div>
                                    <div style="display:flex;flex-direction:column;align-items:center;gap:6px;">
                                        <SgFab Icon="@SgIcons.Edit" Title="Ghost" Variant="SgButtonVariant.Ghost" />
                                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Ghost</SgTypography>
                                    </div>
                                    <div style="display:flex;flex-direction:column;align-items:center;gap:6px;">
                                        <SgFab Icon="@SgIcons.Check" Title="Success" Variant="SgButtonVariant.Success" />
                                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Success</SgTypography>
                                    </div>
                                    <div style="display:flex;flex-direction:column;align-items:center;gap:6px;">
                                        <SgFab Icon="@SgIcons.X" Title="Danger" Variant="SgButtonVariant.Danger" />
                                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Danger</SgTypography>
                                    </div>
                                </div>
                            </div>
                            <SgDivider />
                            <div>
                                <div class="demo-label">Sizes</div>
                                <div class="demo-flex-row">
                                    <div style="display:flex;flex-direction:column;align-items:center;gap:6px;">
                                        <SgFab Icon="@SgIcons.Plus" Title="Small" Size="SgSize.Sm" />
                                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Sm (40px)</SgTypography>
                                    </div>
                                    <div style="display:flex;flex-direction:column;align-items:center;gap:6px;">
                                        <SgFab Icon="@SgIcons.Plus" Title="Medium" />
                                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Md (56px)</SgTypography>
                                    </div>
                                    <div style="display:flex;flex-direction:column;align-items:center;gap:6px;">
                                        <SgFab Icon="@SgIcons.Plus" Title="Large" Size="SgSize.Lg" />
                                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Lg (72px)</SgTypography>
                                    </div>
                                </div>
                            </div>
                            <SgDivider />
                            <div>
                                <div class="demo-label">Extended (with text)</div>
                                <div class="demo-flex-row">
                                    <SgFab Icon="@SgIcons.Plus"     Label="Add"        Extended="true" />
                                    <SgFab Icon="@SgIcons.Edit"     Label="Edit"       Extended="true" Variant="SgButtonVariant.Ghost" />
                                    <SgFab Icon="@SgIcons.Download" Label="Download"   Extended="true" Size="SgSize.Sm" />
                                </div>
                            </div>
                            <SgDivider />
                            <div>
                                <div class="demo-label">States</div>
                                <div class="demo-flex-row">
                                    <SgFab Icon="@SgIcons.Plus" Title="Disabled" Disabled="true" />
                                    <SgFab Icon="@SgIcons.Plus" Title="Loading"  Loading="true" />
                                </div>
                            </div>
                        </div>
                    </SgCard>
                    <SgCard Title="SgFab Properties">
                        <PropertyTable Items="_fabProperties" />
                    </SgCard>
                </div>
            </ChildContent>
        </DemoSection>

        @* -4;sgbtngroup *@
        <DemoSection>
            <HeaderContent>
                <div class="demo-section-header">
                    <SgTypography Variant="SgTypographyVariant.Heading3" Weight="SgTypographyWeight.Semibold">SgButtonGroup</SgTypography>
                </div>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" CssClass="demo-section-desc">
                    Component for grouping buttons into a logical group with shared styling.
                </SgTypography>
            </HeaderContent>
            <ChildContent>
                <div class="demo-grid-adaptive">
                    <SgCard Title="Usage Examples" CssClass="demo-interactive-card">
                        <div class="demo-flex-col">
                            <div>
                                <div class="demo-label">Horizontal Group</div>
                                <div style="margin-top:8px;">
                                    <SgButtonGroup Variant="SgButtonVariant.Primary">
                                        <SgButton Text="L" />
                                        <SgButton Text="M" />
                                        <SgButton Text="R" />
                                    </SgButtonGroup>
                                </div>
                            </div>
                            <SgDivider />
                            <div>
                                <div class="demo-label">Vertical Group</div>
                                <div style="margin-top:8px;">
                                    <SgButtonGroup Orientation="SgOrientation.Vertical">
                                        <SgButton Text="Top" />
                                        <SgButton Text="Middle" />
                                        <SgButton Text="Bottom" />
                                    </SgButtonGroup>
                                </div>
                            </div>
                        </div>
                    </SgCard>
                    <SgCard Title="Component Properties">
                        <PropertyTable Items="_btnGroupProperties" />
                    </SgCard>
                </div>

                <DemoCodeBlock Code="@_btnGroupCode" Title="SgButtonGroup usage" />
            </ChildContent>
        </DemoSection>

        @* -5;sgvariantenum *@
        <DemoSection Title="SgButtonVariant Enum">
            <ChildContent>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" CssClass="demo-section-desc" style="margin-bottom: 16px;">
                    All supported button variant values.
                </SgTypography>
                <SgCard Title="SgButtonVariant Values">
                    <PropertyTable Items="_buttonVariantEnum" />
                </SgCard>
            </ChildContent>
        </DemoSection>

    </SgSpace>

</SgCard>

@code {
    private int _btnClickCount;
    private bool _btnDisabled;
    private bool _btnLoading;
    private bool _btnBlock;
    private bool _togglePressed;

    private string _buttonCode =>
        @"<!-- SgButton with all variants -->
<SgButton Text=""Primary"" Variant=""SgButtonVariant.Primary"" />
<SgButton Text=""Danger""  Variant=""SgButtonVariant.Danger"" />
<SgButton Text=""Clicked: @count"" Variant=""SgButtonVariant.Primary"" OnClick=""@(() => count++)"" />";

    private string _iconButtonCode =>
        @"<!-- SgIconButton variants -->
<SgIconButton Icon=""@SgIcons.Settings"" Title=""Default"" />
<SgIconButton Icon=""@SgIcons.Plus"" Title=""Primary"" Variant=""SgButtonVariant.Primary"" />
<SgIconButton Icon=""@SgIcons.Check"" Title=""Toggle"" IsToggle=""true"" />";

    private string _btnGroupCode =>
        @"<!-- SgButtonGroup -->
<SgButtonGroup Variant=""SgButtonVariant.Primary"">
    <SgButton Text=""L"" />
    <SgButton Text=""M"" />
    <SgButton Text=""R"" />
</SgButtonGroup>";

    private List<PropertyPanelItem> _buttonProperties = new()
    {
        new() { Label = "Text", Value = "string", BadgeText = "Button text", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Variant", Value = "default|primary|danger|success|ghost|outlined|dashed", BadgeText = "Style", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Size", Value = "sm|md|lg", BadgeText = "Size", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Disabled", Value = "bool", BadgeText = "Disable", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Loading", Value = "bool", BadgeText = "Loading", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Block", Value = "bool", BadgeText = "Full width", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "OnClick", Value = "EventCallback<MouseEventArgs>", BadgeText = "Click", BadgeVariant = SgBadgeVariant.Success }
    };

    private List<PropertyPanelItem> _iconBtnProperties = new()
    {
        new() { Label = "Icon",         Value = "string? (SVG)",              BadgeText = "Icon",            BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Title",        Value = "string?",                    BadgeText = "Tooltip / aria",   BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Variant",      Value = "SgButtonVariant",            BadgeText = "Style",            BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Size",         Value = "Sm | Md | Lg | Xl",          BadgeText = "Size",             BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Round",        Value = "bool (default: true)",       BadgeText = "Round shape",      BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "IsToggle",     Value = "bool",                       BadgeText = "Toggle mode",      BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Pressed",      Value = "bool",                       BadgeText = "Pressed",          BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Active",       Value = "bool",                       BadgeText = "Active",           BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "BadgeCount",   Value = "int",                        BadgeText = "Badge counter",    BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "BadgeDot",     Value = "bool",                       BadgeText = "Dot indicator",    BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Disabled",     Value = "bool",                       BadgeText = "Disabled",         BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Loading",      Value = "bool",                       BadgeText = "Loading",          BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "OnClick",      Value = "EventCallback<MouseEventArgs>", BadgeText = "Click",          BadgeVariant = SgBadgeVariant.Success },
    };

    private List<PropertyPanelItem> _fabProperties = new()
    {
        new() { Label = "Icon",      Value = "string? (SVG)",           BadgeText = "Icon",            BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Label",     Value = "string?",                 BadgeText = "Text (Extended)",  BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Title",     Value = "string?",                 BadgeText = "Tooltip",          BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Extended",  Value = "bool",                    BadgeText = "Pill with text",   BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Variant",   Value = "Primary|Ghost|Success|Danger", BadgeText = "Style",       BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Size",      Value = "Sm | Md | Lg",            BadgeText = "Size",             BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Disabled",  Value = "bool",                    BadgeText = "Disabled",         BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Loading",   Value = "bool",                    BadgeText = "Loading",          BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "OnClick",   Value = "EventCallback<MouseEventArgs>", BadgeText = "Click",       BadgeVariant = SgBadgeVariant.Success },
    };

    private List<PropertyPanelItem> _btnGroupProperties = new()
    {
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Buttons inside group" },
        new() { Label = "Orientation", Value = "SgOrientation", BadgeText = "Orientation", Description = "Horizontal/Vertical" },
        new() { Label = "Size", Value = "SgSize?", BadgeText = "Size for all buttons" },
        new() { Label = "Variant", Value = "SgButtonVariant?", BadgeText = "Variant for all buttons" }
    };

    private List<PropertyPanelItem> _buttonVariantEnum = new()
    {
        new() { Label = "SgButtonVariant.Default",  Value = "\"default\"",  BadgeText = "Neutral",     BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "SgButtonVariant.Primary",  Value = "\"primary\"",  BadgeText = "Primary",     BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgButtonVariant.Danger",   Value = "\"danger\"",   BadgeText = "Danger",      BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "SgButtonVariant.Success",  Value = "\"success\"",  BadgeText = "Success",     BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "SgButtonVariant.Ghost",    Value = "\"ghost\"",    BadgeText = "Ghost",       BadgeVariant = SgBadgeVariant.Muted },
        new() { Label = "SgButtonVariant.Outlined", Value = "\"outlined\"", BadgeText = "Outlined",    BadgeVariant = SgBadgeVariant.Muted },
        new() { Label = "SgButtonVariant.Dashed",   Value = "\"dashed\"",   BadgeText = "Dashed",      BadgeVariant = SgBadgeVariant.Muted },
    };
}
