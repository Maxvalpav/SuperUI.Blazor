@page "/button-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>Button Components — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. SgButton                                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgButton — Universal Button
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Supports variants, sizes, states, icons, toggle mode, debounce, and link mode (<SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Href</SgTypography>). Click any button to see the counter.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Variants, Sizes & States" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Variants
                        </SgTypography>
                        <div class="demo-btn-row">
                            <SgButton Text="Default" />
                            <SgButton Text="Primary"  Variant="SgButtonVariant.Primary" />
                            <SgButton Text="Success"  Variant="SgButtonVariant.Success" />
                            <SgButton Text="Danger"   Variant="SgButtonVariant.Danger" />
                            <SgButton Text="Ghost"    Variant="SgButtonVariant.Ghost" />
                            <SgButton Text="Outlined" Variant="SgButtonVariant.Outlined" />
                            <SgButton Text="Dashed"   Variant="SgButtonVariant.Dashed" />
                        </div>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Sizes
                        </SgTypography>
                        <div class="demo-btn-row">
                            <SgButton Text="Small"  Size="SgSize.Sm" Variant="SgButtonVariant.Primary" />
                            <SgButton Text="Medium" Size="SgSize.Md" Variant="SgButtonVariant.Primary" />
                            <SgButton Text="Large"  Size="SgSize.Lg" Variant="SgButtonVariant.Primary" />
                        </div>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Icons
                        </SgTypography>
                        <div class="demo-btn-row">
                            <SgButton Icon="@(new RenderFragment(b => b.AddContent(0, (MarkupString)SgIcons.Search)))" Text="Search" Variant="SgButtonVariant.Primary" />
                            <SgButton Icon="@(new RenderFragment(b => b.AddContent(0, (MarkupString)SgIcons.Download)))" Text="Download" Variant="SgButtonVariant.Success" />
                            <SgButton Icon="@(new RenderFragment(b => b.AddContent(0, (MarkupString)SgIcons.X)))" Text="Delete" Variant="SgButtonVariant.Danger" />
                            <SgButton Icon="@(new RenderFragment(b => b.AddContent(0, (MarkupString)SgIcons.Settings)))" Variant="SgButtonVariant.Ghost" Title="Settings" />
                        </div>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            States
                        </SgTypography>
                        <div class="demo-btn-row">
                            <SgButton Text="Disabled" Disabled="true" />
                            <SgButton Text="Loading" Loading="true" Variant="SgButtonVariant.Primary" />
                            <SgButton Text="Active" Active="true" Variant="SgButtonVariant.Primary" />
                            <SgButton Text="Block" Block="true" Variant="SgButtonVariant.Primary" Style="max-width:200px;" />
                        </div>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Toggle
                        </SgTypography>
                        <div class="demo-btn-row">
                            <SgButton Text="@(_btnToggle ? "ON" : "OFF")"
                                      IsToggle="true"
                                      @bind-Pressed="_btnToggle"
                                      Variant="@(_btnToggle ? SgButtonVariant.Primary : SgButtonVariant.Default)" />
                            <SgButton Text="Ghost Toggle"
                                      IsToggle="true"
                                      @bind-Pressed="_btnGhostToggle"
                                      Variant="SgButtonVariant.Ghost" />
                        </div>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Link Mode (Href)
                        </SgTypography>
                        <div class="demo-btn-row">
                            <SgButton Text="External Link" Href="https://github.com/Maxvalpav/SuperUI.Blazor" Target="_blank" Variant="SgButtonVariant.Outlined" Icon="@(new RenderFragment(b => b.AddContent(0, (MarkupString)SgIcons.ExternalLink)))" />
                            <SgButton Text="Primary Link" Href="/row-demo" Variant="SgButtonVariant.Primary" />
                        </div>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Interactive — Click Counter
                        </SgTypography>
                        <div class="demo-btn-row">
                            <SgButton Text="@($"Clicked {_btnClickCount} times")" Variant="SgButtonVariant.Primary" OnClick="@(() => _btnClickCount++)" />
                            <SgButton Text="Reset" Variant="SgButtonVariant.Ghost" OnClick="@(() => _btnClickCount = 0)" />
                            <div class="demo-value-display">
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Count</SgTypography>
                                <SgTypography Weight="SgTypographyWeight.Bold" Size="SgTypographySize.Lg">@_btnClickCount</SgTypography>
                            </div>
                        </div>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="SgButton Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_buttonProperties" />
            </SgCard>
        </div>

        <DemoCodeBlock Code="@_buttonCode" Title="SgButton examples" />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. SgIconButton                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgIconButton — Compact Icon Button
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Icon-only button with round/square shapes, badges, dot indicators, toggle, and link mode.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Variants, Sizes & Features" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Variants (Round)
                        </SgTypography>
                        <div class="demo-btn-row">
                            <SgIconButton Icon="@SgIcons.Settings" Title="Default" />
                            <SgIconButton Icon="@SgIcons.Plus"     Title="Primary"  Variant="SgButtonVariant.Primary" />
                            <SgIconButton Icon="@SgIcons.Check"    Title="Success"  Variant="SgButtonVariant.Success" />
                            <SgIconButton Icon="@SgIcons.X"        Title="Danger"   Variant="SgButtonVariant.Danger" />
                            <SgIconButton Icon="@SgIcons.Search"   Title="Ghost"    Variant="SgButtonVariant.Ghost" />
                            <SgIconButton Icon="@SgIcons.Edit"     Title="Outlined" Variant="SgButtonVariant.Outlined" />
                        </div>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Square (Round=false)
                        </SgTypography>
                        <div class="demo-btn-row">
                            <SgIconButton Icon="@SgIcons.Settings" Title="Default"  Round="false" />
                            <SgIconButton Icon="@SgIcons.Plus"     Title="Primary"  Round="false" Variant="SgButtonVariant.Primary" />
                            <SgIconButton Icon="@SgIcons.Edit"     Title="Outlined" Round="false" Variant="SgButtonVariant.Outlined" />
                            <SgIconButton Icon="@SgIcons.Edit"     Title="Ghost"    Round="false" Variant="SgButtonVariant.Ghost" />
                        </div>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Sizes
                        </SgTypography>
                        <div class="demo-btn-row">
                            <SgIconButton Icon="@SgIcons.Settings" Title="Sm" Size="SgSize.Sm" Variant="SgButtonVariant.Primary" />
                            <SgIconButton Icon="@SgIcons.Settings" Title="Md" Size="SgSize.Md" Variant="SgButtonVariant.Primary" />
                            <SgIconButton Icon="@SgIcons.Settings" Title="Lg" Size="SgSize.Lg" Variant="SgButtonVariant.Primary" />
                            <SgIconButton Icon="@SgIcons.Settings" Title="Xl" Size="SgSize.Xl" Variant="SgButtonVariant.Primary" />
                        </div>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Badges & Indicators
                        </SgTypography>
                        <div class="demo-btn-row">
                            <SgIconButton Icon="@SgIcons.Settings" Title="3 notifications" BadgeCount="3" />
                            <SgIconButton Icon="@SgIcons.Settings" Title="99+ notifications" BadgeCount="120" />
                            <SgIconButton Icon="@SgIcons.Settings" Title="New" BadgeDot="true" />
                            <SgIconButton Icon="@SgIcons.Settings" Title="Disabled" Disabled="true" />
                            <SgIconButton Icon="@SgIcons.Settings" Title="Loading" Loading="true" />
                            <SgIconButton Icon="@SgIcons.Settings" Title="Active" Active="true" />
                        </div>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Toggle & Active
                        </SgTypography>
                        <div class="demo-btn-row">
                            <SgIconButton Icon="@SgIcons.Check" Title="Toggle" IsToggle="true"
                                          @bind-Pressed="_iconToggle"
                                          Variant="@(_iconToggle ? SgButtonVariant.Primary : SgButtonVariant.Default)" />
                            <SgBadge Text="@(_iconToggle ? "Pressed" : "Not Pressed")"
                                     Variant="@(_iconToggle ? SgBadgeVariant.Info : SgBadgeVariant.Muted)" />
                            <div class="sgc-icon-btn-group">
                                <SgIconButton Icon="@SgIcons.ArrowUp"   Title="Up"     Size="SgSize.Sm" />
                                <SgIconButton Icon="@SgIcons.ArrowDown" Title="Down"   Size="SgSize.Sm" />
                                <SgIconButton Icon="@SgIcons.Refresh"   Title="Refresh" Size="SgSize.Sm" />
                            </div>
                        </div>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Link Mode (Href)
                        </SgTypography>
                        <div class="demo-btn-row">
                            <SgIconButton Icon="@SgIcons.ExternalLink" Title="Open GitHub" Href="https://github.com" Target="_blank" />
                            <SgIconButton Icon="@SgIcons.ExternalLink" Title="Open Link Primary" Href="https://github.com" Target="_blank" Variant="SgButtonVariant.Primary" />
                        </div>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="SgIconButton Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_iconBtnProperties" />
            </SgCard>
        </div>

        <DemoCodeBlock Code="@_iconButtonCode" Title="SgIconButton examples" />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. SgFab — Floating Action Button                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgFab — Floating Action Button
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Circular button with shadow elevation. Supports extended pill mode with label, variants, sizes, and states.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Variants & Modes" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Variants
                        </SgTypography>
                        <div class="demo-btn-row">
                            <div class="demo-fab-item">
                                <SgFab Icon="@SgIcons.Plus" Title="Primary" />
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Primary</SgTypography>
                            </div>
                            <div class="demo-fab-item">
                                <SgFab Icon="@SgIcons.Edit" Title="Ghost" Variant="SgButtonVariant.Ghost" />
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Ghost</SgTypography>
                            </div>
                            <div class="demo-fab-item">
                                <SgFab Icon="@SgIcons.Check" Title="Success" Variant="SgButtonVariant.Success" />
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Success</SgTypography>
                            </div>
                            <div class="demo-fab-item">
                                <SgFab Icon="@SgIcons.X" Title="Danger" Variant="SgButtonVariant.Danger" />
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Danger</SgTypography>
                            </div>
                        </div>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Sizes
                        </SgTypography>
                        <div class="demo-btn-row">
                            <div class="demo-fab-item">
                                <SgFab Icon="@SgIcons.Plus" Title="Small (40px)" Size="SgSize.Sm" />
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Sm</SgTypography>
                            </div>
                            <div class="demo-fab-item">
                                <SgFab Icon="@SgIcons.Plus" Title="Medium (56px)" />
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Md</SgTypography>
                            </div>
                            <div class="demo-fab-item">
                                <SgFab Icon="@SgIcons.Plus" Title="Large (72px)" Size="SgSize.Lg" />
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Lg</SgTypography>
                            </div>
                        </div>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Extended (Pill with Label)
                        </SgTypography>
                        <div class="demo-btn-row">
                            <SgFab Icon="@SgIcons.Plus"     Label="Create"     Extended="true" />
                            <SgFab Icon="@SgIcons.Edit"     Label="Edit"       Extended="true" Variant="SgButtonVariant.Ghost" />
                            <SgFab Icon="@SgIcons.Download" Label="Download"   Extended="true" Size="SgSize.Sm" />
                            <SgFab Icon="@SgIcons.Check"    Label="Complete"   Extended="true" Variant="SgButtonVariant.Success" />
                        </div>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            States
                        </SgTypography>
                        <div class="demo-btn-row">
                            <div class="demo-fab-item">
                                <SgFab Icon="@SgIcons.Plus" Title="Disabled" Disabled="true" />
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Disabled</SgTypography>
                            </div>
                            <div class="demo-fab-item">
                                <SgFab Icon="@SgIcons.Plus" Title="Loading" Loading="true" />
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Loading</SgTypography>
                            </div>
                            <div class="demo-fab-item">
                                <SgFab Icon="@SgIcons.Plus" Title="Active" Active="true" />
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Active</SgTypography>
                            </div>
                        </div>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="SgFab Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_fabProperties" />
            </SgCard>
        </div>

        <DemoCodeBlock Code="@_fabCode" Title="SgFab examples" />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. SgButtonGroup                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgButtonGroup — Grouped Buttons
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Groups buttons horizontally or vertically with shared variant/size. Supports attached (seamless) mode and justify distribution.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Orientation & Modes" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Horizontal (default gap)
                        </SgTypography>
                        <div class="demo-btn-row" style="margin-top:8px;">
                            <SgButtonGroup Variant="SgButtonVariant.Primary">
                                <SgButton Text="Left" />
                                <SgButton Text="Center" />
                                <SgButton Text="Right" />
                            </SgButtonGroup>
                        </div>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Attached (seamless)
                        </SgTypography>
                        <div class="demo-btn-row" style="margin-top:8px;">
                            <SgButtonGroup Variant="SgButtonVariant.Outlined" Attached="true">
                                <SgButton Text="L" Active="true" />
                                <SgButton Text="M" />
                                <SgButton Text="R" />
                            </SgButtonGroup>
                        </div>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Vertical
                        </SgTypography>
                        <SgButtonGroup Orientation="SgOrientation.Vertical" Variant="SgButtonVariant.Default">
                            <SgButton Text="Top" />
                            <SgButton Text="Middle" />
                            <SgButton Text="Bottom" />
                        </SgButtonGroup>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Different Variants inside Group
                        </SgTypography>
                        <div class="demo-btn-row" style="margin-top:8px;">
                            <SgButtonGroup Attached="true">
                                <SgButton Text="Save" Variant="SgButtonVariant.Primary" />
                                <SgButton Text="Delete" Variant="SgButtonVariant.Danger" />
                                <SgButton Text="Cancel" Variant="SgButtonVariant.Ghost" />
                            </SgButtonGroup>
                        </div>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="SgButtonGroup Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_btnGroupProperties" />
            </SgCard>
        </div>

        <DemoCodeBlock Code="@_btnGroupCode" Title="SgButtonGroup examples" />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Advanced Features — Glow, Pulse, Glass, Gradient               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Button Effects — Glow, Pulse, Glass & Gradient
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Visual effects: neon glow, attention-grabbing pulse, glass-morphism and gradient variants. Add some flair to your buttons.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Effects Showcase" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Glow (Neon)
                        </SgTypography>
                        <div class="demo-btn-row">
                            <SgButton Text="Primary Glow" Variant="SgButtonVariant.Primary" Glow="true" />
                            <SgButton Text="Danger Glow" Variant="SgButtonVariant.Danger" Glow="true" />
                            <SgButton Text="Success Glow" Variant="SgButtonVariant.Success" Glow="true" />
                            <SgIconButton Icon="@SgIcons.Settings" Title="Icon Glow" Variant="SgButtonVariant.Primary" Glow="true" />
                        </div>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Pulse (Attention)
                        </SgTypography>
                        <div class="demo-btn-row">
                            <SgButton Text="Pulse" Variant="SgButtonVariant.Primary" Pulse="true" />
                            <SgButton Text="Save" Variant="SgButtonVariant.Success" Pulse="true" />
                            <SgIconButton Icon="@SgIcons.Bell" Title="Notifications" Variant="SgButtonVariant.Primary" Pulse="true" BadgeDot="true" />
                            <SgFab Icon="@SgIcons.Plus" Title="Pulse FAB" Pulse="true" />
                        </div>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Glass (Morphism)
                        </SgTypography>
                        <div class="demo-btn-row" style="background:linear-gradient(135deg,#667eea,#764ba2);padding:20px;border-radius:12px;">
                            <SgButton Text="Glass" Glass="true" />
                            <SgButton Text="Primary" Variant="SgButtonVariant.Primary" Glass="true" />
                            <SgIconButton Icon="@SgIcons.Settings" Title="Glass Icon" Glass="true" />
                            <SgFab Icon="@SgIcons.Plus" Title="Glass FAB" Glass="true" />
                        </div>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Loading Positions & Icon Right
                        </SgTypography>
                        <div class="demo-btn-row">
                            <SgButton Text="Loading Left" Loading="true" LoadingPosition="left" Variant="SgButtonVariant.Primary" />
                            <SgButton Text="Loading Right" Loading="true" LoadingPosition="right" Variant="SgButtonVariant.Primary" />
                            <SgButton Text="Center (default)" Loading="true" LoadingPosition="center" Variant="SgButtonVariant.Primary" />
                            <SgButton Text="Icon Right" Variant="SgButtonVariant.Primary"
                                      IconRight="@(new RenderFragment(b => b.AddContent(0, (MarkupString)SgIcons.ChevronRight)))" />
                        </div>
                    </div>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Danger Confirm & Countdown
                        </SgTypography>
                        <div class="demo-btn-row">
                            <SgButton Text="Delete" Variant="SgButtonVariant.Danger" ConfirmText="Sure?" OnClick="@(() => { })" />
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Click twice to confirm</SgTypography>
                        </div>
                        <div class="demo-btn-row" style="margin-top:8px;">
                            <SgButton Text="Send Code" Variant="SgButtonVariant.Primary" Countdown="10" OnClick="@(() => { })" />
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Disabled for 10s after click</SgTypography>
                        </div>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="New Parameters" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_effectProperties" />
            </SgCard>
        </div>

        <DemoCodeBlock Code="@_effectsCode" Title="Button effects examples" />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. SgSplitButton + SgSpeedDial                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgSplitButton & SgSpeedDial
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Split button with dropdown menu and speed dial — FAB that expands into multiple actions.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Md">
            <SgCol Md="6">
                <SgCard Title="SgSplitButton" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Lg">
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Default
                            </SgTypography>
                            <SgSplitButton Text="Actions" Variant="SgButtonVariant.Primary"
                                           Items="@_splitItems" />
                        </div>
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Danger + Outlined
                            </SgTypography>
                            <SgSplitButton Text="Danger Zone" Variant="SgButtonVariant.Danger"
                                           Items="@_splitDangerItems" />
                        </div>
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Ghost with Glow
                            </SgTypography>
                            <SgSplitButton Text="Share" Variant="SgButtonVariant.Ghost" Glow="true"
                                           Items="@_splitShareItems" />
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="SgSpeedDial" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Lg" Align="SgAlignItems.Center">
                        <div style="margin:40px 0;display:flex;justify-content:center;gap:60px;flex-wrap:wrap;">
                            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Up (click)</SgTypography>
                                <SgSpeedDial Actions="@_speedDialActions" />
                            </SgStack>
                            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Hover</SgTypography>
                                <SgSpeedDial Actions="@_speedDialActions" HoverOpen="true" />
                            </SgStack>
                            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Right</SgTypography>
                                <SgSpeedDial Actions="@_speedDialActions" Direction="SpeedDialDirection.Right" />
                            </SgStack>
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>

        <SgRow Space="SgSize.Md" Style="margin-top:16px;">
            <SgCol Md="6">
                <SgCard Title="SgSplitButton Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_splitBtnProperties" />
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="SgSpeedDial Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_speedDialProperties" />
                </SgCard>
            </SgCol>
        </SgRow>

        <DemoCodeBlock Code="@_splitCode" Title="SgSplitButton & SgSpeedDial examples" />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 7. Button with Loading Progress                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Button with Loading Progress
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Interactive demo showing <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Loading</SgTypography> state with simulated progress.
            </SgTypography>
        </div>
        <div class="demo-two-col">
            <SgCard Title="Progress Inside Button" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
                    <div style="display:flex;gap:16px;flex-wrap:wrap;justify-content:center;align-items:center;">
                        <SgButton Text="Start Download"
                                  OnClick="RunLoadingDemo"
                                  Loading="@_loadingDemoRunning"
                                  Progress="@_loadingDemoProgress"
                                  ProgressType="@_progressType"
                                  ProgressSpinnerType="@_progressSpinnerType"
                                  Variant="SgButtonVariant.Primary" Size="SgSize.Md" />
                        <SgButton Text="Reset" OnClick="ResetLoadingDemo"
                                  Disabled="@(_loadingDemoProgress < 0)"
                                  Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
                    </div>
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Status: @_loadingDemoStatus
                    </SgTypography>
                    <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;padding-top:8px;border-top:1px solid var(--sg-border);">
                        <SgStack Vertical Space="SgSize.Sm" Style="min-width:140px;">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Progress Type</SgTypography>
                            <SgSegmented TValue="SgButtonProgressType"
                                         Value="@_progressType"
                                         ValueChanged="v => { _progressType = v; StateHasChanged(); }"
                                         Block="true" Size="sm"
                                         Options="@_progressTypeSegOptions" />
                        </SgStack>
                        <SgStack Vertical Space="SgSize.Sm" Style="min-width:140px;">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Spinner Type</SgTypography>
                            <SgSegmented TValue="SgSpinnerType"
                                         Value="@_progressSpinnerType"
                                         ValueChanged="v => { _progressSpinnerType = v; StateHasChanged(); }"
                                         Block="true" Size="sm"
                                         Options="@_spinnerTypeSegOptions" />
                        </SgStack>
                    </div>
                </SgStack>
            </SgCard>
            <SgCard Title="Code" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <div class="code-block">
                    <code>&lt;SgButton Text="Start Download"</code><br />
                    <code>          OnClick="@@RunLoadingDemo"</code><br />
                    <code>          Loading="@@_loadingDemoRunning"</code><br />
                    <code>          Progress="@@_loadingDemoProgress"</code><br />
                    <code>          ProgressType="@_progressType"</code><br />
                    <code>          ProgressSpinnerType="@_progressSpinnerType" /&gt;</code>
                </div>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 8. Live Constructor                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live Button Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure button parameters and see the result in real time. Copy the generated code.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Text -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Text</SgTypography>
                            <SgTextBox @bind-Value="_ctorText" Placeholder="Button text" />
                        </SgStack>

                        <!-- Variant -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Variant</SgTypography>
                            <SgSelect TValue="SgButtonVariant"
                                      @bind-Value="_ctorVariant"
                                      Items="@_variantItems"
                                      LabelSelector="x => x.ToString()"
                                      Block="true" />
                        </SgStack>

                        <!-- Size -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                            <SgSegmented TValue="SgSize"
                                         Value="@_ctorSize"
                                         ValueChanged="v => { _ctorSize = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="@_sizeSegOptions" />
                        </SgStack>

                        <!-- Toggles -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Disabled</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorDisabled"
                                                 ValueChanged="v => { _ctorDisabled = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Loading</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorLoading"
                                                 ValueChanged="v => { _ctorLoading = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Block</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorBlock"
                                                 ValueChanged="v => { _ctorBlock = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Active</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorActive"
                                                 ValueChanged="v => { _ctorActive = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Variant</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorVariant.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Success" Text="@_ctorSize.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">States</SgTypography>
                                    <SgStack Horizontal Space="SgSize.Sm">
                                        @if (_ctorDisabled) { <SgBadge Variant="SgBadgeVariant.Warn" Text="Disabled" Size="SgSize.Sm" Standalone="true" /> }
                                        @if (_ctorLoading) { <SgBadge Variant="SgBadgeVariant.Warn" Text="Loading" Size="SgSize.Sm" Standalone="true" /> }
                                        @if (_ctorBlock) { <SgBadge Variant="SgBadgeVariant.Warn" Text="Block" Size="SgSize.Sm" Standalone="true" /> }
                                        @if (_ctorActive) { <SgBadge Variant="SgBadgeVariant.Default" Text="Active" Size="SgSize.Sm" Standalone="true" /> }
                                    </SgStack>
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <div class="constructor-preview" style="display:flex;align-items:center;justify-content:center;min-height:80px;">
                                <SgButton Text="@_ctorText"
                                          Variant="@_ctorVariant"
                                          Size="@_ctorSize"
                                          Disabled="@_ctorDisabled"
                                          Loading="@_ctorLoading"
                                          Block="@_ctorBlock"
                                          Active="@_ctorActive" />
                            </div>
                        </SgStack>

                        <!-- Code with Copy -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                    <span id="copy-icon">@_copyIcon</span>
                                    <span id="copy-text" style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                </button>
                            </div>
                            <div class="code-block">
                                @foreach (var line in _generatedCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 8. Enum Reference                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Enum Reference
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                All supported enum values for button components.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Md">
            <SgCol Md="6">
                <SgCard Title="SgButtonVariant Values" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_buttonVariantEnum" />
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="SgSize Values" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_sizeEnum" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

</ChildContent>
</SgCard>

<style>
    /* ── Section layout ─────────────────────────────────────────────────────── */
    .demo-section {
        margin-top: 48px;
    }
    .demo-section-header {
        margin-bottom: 20px;
    }

    .demo-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }
    @@media (max-width: 768px) {
        .demo-two-col { grid-template-columns: 1fr; }
    }

    /* ── Button row ─────────────────────────────────────────────────────────── */
    .demo-btn-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
    }

    /* ── Fab item ───────────────────────────────────────────────────────────── */
