    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add($"<SgButton Text=\"{_ctorText}\"");
        lines.Add($"         Variant=\"SgButtonVariant.{_ctorVariant}\"");
        if (_ctorSize != SgSize.Md)
            lines.Add($"         Size=\"SgSize.{_ctorSize}\"");
        if (_ctorDisabled)
            lines.Add($"         Disabled=\"true\"");
        if (_ctorLoading)
            lines.Add($"         Loading=\"true\"");
        if (_ctorBlock)
            lines.Add($"         Block=\"true\"");
        if (_ctorActive)
            lines.Add($"         Active=\"true\"");
        lines.Add($"         OnClick=\"@(() => {{ }})\" />");
        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

