    private SgButtonProgressType _progressType = SgButtonProgressType.Ring;
    private SgSpinnerType _progressSpinnerType = SgSpinnerType.Border;

    private async Task RunLoadingDemo()
    {
        _loadingDemoRunning = true;
        _loadingDemoProgress = 0;
        StateHasChanged();
        await Task.Delay(100);
        for (int i = 2; i <= 100; i += 2)
        {
            _loadingDemoProgress = i;
            _loadingDemoStatus = i switch
            {
                < 20 => "Starting...",
                < 40 => "Connecting...",
                < 60 => "Downloading...",
                < 80 => "Processing...",
                < 100 => "Verifying...",
                100 => "Complete!"
            };
            StateHasChanged();
            await Task.Delay(50);
        }
        _loadingDemoRunning = false;
        StateHasChanged();
    }

    private void ResetLoadingDemo()
    {
        _loadingDemoProgress = -1;
        _loadingDemoStatus = "Idle";
        _loadingDemoRunning = false;
        StateHasChanged();
    }

