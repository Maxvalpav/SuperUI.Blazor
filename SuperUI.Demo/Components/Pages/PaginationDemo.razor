@page "/pagination-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgPagination — Pagination — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. SgPagination — Basic Usage                                      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgPagination — Basic Usage
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Full-featured pagination with page buttons, info, jump input, and page size options.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Standard
                        </SgTypography>
                        <SgPagination TotalItems="100" PageSize="10" @bind-Page="_page1" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With Info + Jump
                        </SgTypography>
                        <SgPagination TotalItems="250" PageSize="20" ShowInfo="true" ShowJump="true" @bind-Page="_page2" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Simple Mode
                        </SgTypography>
                        <SgPagination TotalItems="100" PageSize="10" Simple="true" @bind-Page="_page3" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Compact (Siblings=0)
                        </SgTypography>
                        <SgPagination TotalItems="100" PageSize="10" Siblings="0" @bind-Page="_page4" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Large Dataset (5000 items)
                        </SgTypography>
                        <SgPagination TotalItems="5000" PageSize="25" ShowInfo="true" @bind-Page="_page5" />
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="SgPagination Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_paginationProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. SgPagination — Size Variants                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgPagination — Size & Alignment
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Three sizes: <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Sm</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Md</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Lg</SgTypography>. Also supports alignment via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Alignment</SgTypography>.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="4">
                <SgCard Title="Small (Size=Sm)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgPagination TotalItems="50" PageSize="5" Size="SgSize.Sm" @bind-Page="_pageSm" />
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Medium (Size=Md, Default)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgPagination TotalItems="50" PageSize="5" Size="SgSize.Md" @bind-Page="_pageMd" />
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Large (Size=Lg)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgPagination TotalItems="50" PageSize="5" Size="SgSize.Lg" @bind-Page="_pageLg" />
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Alignment = Center" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgPagination TotalItems="80" PageSize="10" Alignment="SgJustifyContent.Center" @bind-Page="_pageCenter" />
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Alignment = End" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgPagination TotalItems="80" PageSize="10" Alignment="SgJustifyContent.End" @bind-Page="_pageEnd" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. SgPagination — Page Size Selector                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgPagination — Page Size Selector
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Let users choose how many items per page via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">PageSizeOptions</SgTypography>.
            </SgTypography>
        </div>

        <SgCard Title="Page Size Selector" Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgStack Vertical Space="SgSize.Lg">
                <div>
                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                        Page size: @_pageSize | Current page: @_pageWithSize
                        <SgTag Variant="SgTagVariant.Info" Size="SgSize.Sm" Style="margin-left:8px;">Try changing</SgTag>
                    </SgTypography>
                    <SgPagination TotalItems="200"
                                  PageSize="@_pageSize"
                                  @bind-Page="_pageWithSize"
                                  PageSizeOptions="@(new[] { 5, 10, 20, 50 })"
                                  PageSizeChanged="OnPageSizeChanged"
                                  ShowInfo="true" />
                </div>
            </SgStack>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Live Constructor                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live SgPagination Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure parameters and see the result in real time. Click the copy button to grab the code.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Total Items -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Total Items</SgTypography>
                            <input type="range" min="10" max="1000" step="10"
                                   value="@_ctorTotal"
                                   @oninput="OnTotalItemsChanged"
                                   style="width:100%;" />
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">@_ctorTotal items</SgTypography>
                        </SgStack>

                        <!-- Page Size -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Page Size</SgTypography>
                            <SgSegmented TValue="int"
                                         Value="@_ctorPageSize"
                                         ValueChanged="v => { _ctorPageSize = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="@(new List<SgSegmentedOption<int>> {
                                             new() { Value = 5, Label = "5" },
                                             new() { Value = 10, Label = "10" },
                                             new() { Value = 20, Label = "20" },
                                             new() { Value = 50, Label = "50" }
                                         })" />
                        </SgStack>

                        <!-- Siblings -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Siblings</SgTypography>
                            <SgSegmented TValue="int"
                                         Value="@_ctorSiblings"
                                         ValueChanged="v => { _ctorSiblings = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="@(new List<SgSegmentedOption<int>> {
                                             new() { Value = 0, Label = "0" },
                                             new() { Value = 1, Label = "1" },
                                             new() { Value = 2, Label = "2" },
                                             new() { Value = 3, Label = "3" }
                                         })" />
                        </SgStack>

                        <!-- Size -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                            <SgSegmented TValue="string"
                                         Value="@_ctorSize"
                                         ValueChanged="v => { _ctorSize = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="@(new List<SgSegmentedOption<string>> {
                                             new() { Value = "Sm", Label = "Sm" },
                                             new() { Value = "Md", Label = "Md" },
                                             new() { Value = "Lg", Label = "Lg" }
                                         })" />
                        </SgStack>

                        <!-- Alignment -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Alignment</SgTypography>
                            <SgSelect TValue="SgJustifyContent"
                                      @bind-Value="_ctorAlignment"
                                      Items="@(Enum.GetValues<SgJustifyContent>().ToList())"
                                      LabelSelector="x => x.ToString()"
                                      Block="true" />
                        </SgStack>

                        <!-- Toggles -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Show Info</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorShowInfo"
                                                 ValueChanged="v => { _ctorShowInfo = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Show Jump</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorShowJump"
                                                 ValueChanged="v => { _ctorShowJump = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Simple</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorSimple"
                                                 ValueChanged="v => { _ctorSimple = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">First/Last</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorShowFirstLast"
                                                 ValueChanged="v => { _ctorShowFirstLast = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions2" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Total Pages</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@(((int)Math.Ceiling((double)_ctorTotal / _ctorPageSize)).ToString())" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Page Size</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Success" Text="@_ctorPageSize.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Mode</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@(_ctorSimple ? "Simple" : "Full")" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <div class="constructor-preview">
                                <SgPagination TotalItems="@_ctorTotal"
                                              PageSize="@_ctorPageSize"
                                              Siblings="@_ctorSiblings"
                                              Size="@GetCtorSize()"
                                              Alignment="@_ctorAlignment"
                                              ShowInfo="@_ctorShowInfo"
                                              ShowJump="@_ctorShowJump"
                                              Simple="@_ctorSimple"
                                              ShowFirstLast="@_ctorShowFirstLast"
                                              @bind-Page="_ctorPage" />
                            </div>
                        </SgStack>

                        <!-- Code with Copy -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                    <span id="p-copy-icon">@_copyIcon</span>
                                    <span id="p-copy-text" style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                </button>
                            </div>
                            <div class="code-block">
                                @foreach (var line in _generatedCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

</ChildContent>
</SgCard>

<style>
    .demo-section { margin-top: 48px; }
    .demo-section-header { margin-bottom: 20px; }
    .demo-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    @@media (max-width: 768px) { .demo-two-col { grid-template-columns: 1fr; } }
    .constructor-preview { background: var(--sg-surface-alt); border: 1px solid var(--sg-border); border-radius: 8px; padding: 16px; min-height: 60px; transition: all 0.3s ease; }
    .ctrl-summary { background: var(--sg-surface-alt); border: 1px solid var(--sg-border); border-radius: 8px; padding: 12px 14px; }
    .code-block { background: #0f172a; color: #7dd3fc; padding: 14px 16px; border-radius: 8px; font-family: 'JetBrains Mono', 'Fira Code', monospace; font-size: 12px; line-height: 1.9; overflow-x: auto; }
    .code-block code { background: none; padding: 0; color: inherit; font-size: inherit; display: block; white-space: pre; }
    .demo-copy-btn { display: inline-flex; align-items: center; gap: 4px; background: var(--sg-surface-alt); border: 1px solid var(--sg-border); border-radius: 6px; padding: 4px 10px; cursor: pointer; color: var(--sg-text-muted); transition: all 0.2s ease; font-family: inherit; }
    .demo-copy-btn:hover { color: var(--sg-primary); border-color: var(--sg-primary); background: color-mix(in srgb, var(--sg-primary) 8%, transparent); }
    .demo-copy-btn:active { transform: scale(0.95); }
    .demo-copy-btn.copied { color: var(--sg-color-success); border-color: var(--sg-color-success); }
</style>

@code {
    // ── Main card header ─────────────────────────────────────────────────
    private RenderFragment _mainHeader => __builder =>
    {
        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
            <div style="display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,var(--sg-primary),#8b5cf6);color:#fff;flex-shrink:0;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
            </div>
            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">SgPagination</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Page navigation for large datasets. Supports page buttons, info display, jump-to-page, page size selector, simple mode, and three size variants.
                </SgTypography>
            </SgStack>
        </SgStack>
    };

    // ── Example pages ────────────────────────────────────────────────────
    private int _page1 = 1;
    private int _page2 = 5;
    private int _page3 = 1;
    private int _page4 = 3;
    private int _page5 = 10;
    private int _pageSm = 1;
    private int _pageMd = 1;
    private int _pageLg = 1;
    private int _pageCenter = 1;
    private int _pageEnd = 1;
    private int _pageWithSize = 1;
    private int _pageSize = 10;

    private void OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _pageWithSize = 1;
    }

    // ── Constructor state ─────────────────────────────────────────────────
    private int _ctorTotal = 200;
    private int _ctorPageSize = 10;
    private int _ctorSiblings = 1;
    private string _ctorSize = "Md";
    private SgJustifyContent _ctorAlignment = SgJustifyContent.Start;
    private bool _ctorShowInfo = true;
    private bool _ctorShowJump;
    private bool _ctorSimple;
    private bool _ctorShowFirstLast = true;
    private int _ctorPage = 1;

    private SgSize GetCtorSize() => _ctorSize switch
    {
        "Sm" => SgSize.Sm,
        "Lg" => SgSize.Lg,
        _ => SgSize.Md
    };

    // ── Code generation ───────────────────────────────────────────────────
    private string[] _generatedCodeLines = Array.Empty<string>();
    private string _copyIcon = "📋";
    private string _copyLabel = "Copy";

    private readonly List<SgSegmentedOption<bool>> _boolSegOptions = new()
    {
        new() { Value = false, Label = "Off" },
        new() { Value = true,  Label = "On" },
    };

    private readonly List<SgSegmentedOption<bool>> _boolSegOptions2 = new()
    {
        new() { Value = true,  Label = "On" },
        new() { Value = false, Label = "Off" },
    };

    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void OnTotalItemsChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
        {
            _ctorTotal = val;
            UpdateConstructorCode();
        }
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add($"<SgPagination");
        lines.Add($"    TotalItems=\"{_ctorTotal}\"");
        lines.Add($"    PageSize=\"{_ctorPageSize}\"");
        lines.Add($"    Siblings=\"{_ctorSiblings}\"");
        if (_ctorSize != "Md")
            lines.Add($"    Size=\"SgSize.{_ctorSize}\"");
        if (_ctorAlignment != SgJustifyContent.Start)
            lines.Add($"    Alignment=\"SgJustifyContent.{_ctorAlignment}\"");
        if (!_ctorShowInfo)
            lines.Add($"    ShowInfo=\"false\"");
        if (_ctorShowJump)
            lines.Add($"    ShowJump=\"true\"");
        if (_ctorSimple)
            lines.Add($"    Simple=\"true\"");
        if (!_ctorShowFirstLast)
            lines.Add($"    ShowFirstLast=\"false\"");
        lines.Add($"    @@bind-Page=\"_page\"");
        lines.Add($" />");
        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

