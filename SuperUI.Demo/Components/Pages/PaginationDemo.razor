@page "/pagination-demo"
@using SuperUI.Components

<PageTitle>Pagination - SUI</PageTitle>

<SgCard Title="SgPagination - Пагинация"
        Subtitle="Компонент для навигации по страницам больших наборов данных. Поддерживает различные режимы отображения, информацию о странице и кастомизацию.">

    <div style="margin-top: 32px;">
        <h2>Примеры использования</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Стандартная пагинация">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Базовая</div>
                        <SgPagination TotalItems="100" PageSize="10" @bind-Page="_page1" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">С информацией</div>
                        <SgPagination TotalItems="100" PageSize="10" ShowInfo="true" @bind-Page="_page2" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Компактная (Siblings=0)</div>
                        <SgPagination TotalItems="100" PageSize="10" Siblings="0" @bind-Page="_page3" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Дополнительные режимы">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Простая (Simple)</div>
                        <SgPagination TotalItems="100" PageSize="10" Simple="true" @bind-Page="_page4" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Большой набор (5000)</div>
                        <SgPagination TotalItems="5000" PageSize="25" ShowInfo="true" @bind-Page="_page5" />
                    </div>
                </div>
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Свойства компонента</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="SgPagination">
                <PropertyTable Items="_paginationProperties" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private int _page1 = 1;
    private int _page2 = 5;
    private int _page3 = 3;
    private int _page4 = 1;
    private int _page5 = 10;

    private List<PropertyPanelItem> _paginationProperties = new()
    {
        new() { Label = "TotalItems", Value = "int", BadgeText = "Всего", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "PageSize", Value = "int", BadgeText = "На странице", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Page", Value = "int", BadgeText = "Текущая", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Siblings", Value = "int", BadgeText = "Соседние", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ShowInfo", Value = "bool", BadgeText = "Информация", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Simple", Value = "bool", BadgeText = "Компактная", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "CssClass", Value = "string", BadgeText = "CSS класс", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "PageChanged", Value = "EventCallback<int>", BadgeText = "Событие", BadgeVariant = SgBadgeVariant.Success }
    };
}
