@page "/document-extractor-demo"
@using SuperUI.Components.DocumentExtractor
@using SuperUI.Components.DocumentExtractor.Models

<PageTitle>Document Extractor — SUI</PageTitle>

<div class="doc-extractor-demo">
    <div class="doc-extractor-demo-header">
        <h1>📄 Document Extractor</h1>
        <p>
            Upload a <code>.pdf</code>, <code>.docx</code>, or image, extract editable fields
            via an LLM (OpenAI-compatible or OpenRouter) <em>or</em> via the built-in DOCX text parser,
            edit them in SuperUI inputs, and save back to the same format.
        </p>
    </div>

    <div class="doc-extractor-demo-layout">
        <div class="doc-extractor-demo-main">
            <SgDocumentExtractor InitialExtractorId="llm"
                                 OnExtracted="OnExtracted"
                                 OnSaved="OnSaved" />
        </div>

        <aside class="doc-extractor-demo-side">
            <h3>How it works</h3>
            <ol>
                <li>Pick a provider (<strong>OpenAI-compatible</strong> or <strong>OpenRouter</strong>).</li>
                <li>Set the Base URL and API key.</li>
                <li>Type a model id by hand <em>or</em> click <strong>Fetch models</strong> to load the catalog.</li>
                <li>Upload a document and press <strong>Extract</strong>.</li>
                <li>Edit fields, then <strong>Save</strong> — the file downloads in its original format.</li>
            </ol>

            <h3>Modular by design</h3>
            <ul>
                <li><code>IDocumentExtractor</code> — LLM + built-in DOCX text parser ship by default.</li>
                <li><code>IDocumentSaver</code> — DOCX round-trip, plain-text, passthrough for PDF/images.</li>
                <li><code>ILlmExtractionClient</code> — swap to point at any OpenAI-compatible endpoint.</li>
            </ul>

            @if (_lastExtraction is not null)
            {
                <h3>Last extraction</h3>
                <p>
                    <strong>Source:</strong> @_lastExtraction.Source?.FileName
                    (@_lastExtraction.Source?.Kind)<br />
                    <strong>Fields:</strong> @_lastExtraction.Fields.Count<br />
                    <strong>Extractor:</strong>
                    @(_lastExtraction.Metadata.TryGetValue("extractor", out var ex) ? ex : "—")
                </p>
            }

            @if (_lastSaved is not null)
            {
                <h3>Last saved</h3>
                <p>
                    <strong>File:</strong> @_lastSaved.FileName<br />
                    <strong>Size:</strong> @_lastSaved.Data.Length.ToString("N0") bytes
                </p>
            }
        </aside>
    </div>
</div>

@code {
    private SgDocumentExtractionResult? _lastExtraction;
    private SgDocumentSource? _lastSaved;

    private void OnExtracted(SgDocumentExtractionResult result)
    {
        _lastExtraction = result;
        StateHasChanged();
    }

    private void OnSaved(SgDocumentSource saved)
    {
        _lastSaved = saved;
        StateHasChanged();
    }
}
