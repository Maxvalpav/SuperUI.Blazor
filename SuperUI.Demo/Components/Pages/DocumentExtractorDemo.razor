@page "/document-extractor-demo"
@using SuperUI.Components
@using SuperUI.Components.DocumentExtractor
@using SuperUI.Components.DocumentExtractor.Models
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-4">
        <div class="me-3 p-3 bg-primary bg-opacity-10 rounded-3 text-primary">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
        </div>
        <div>
            <h1 class="h3 mb-1">Document Extractor</h1>
            <p class="text-muted mb-0">
                Upload a <code>.pdf</code>, <code>.docx</code>, or image, extract editable fields via an LLM or built-in parser, and save back to the same format.
            </p>
        </div>
    </div>

    <SgDocumentExtractor />
</div>

