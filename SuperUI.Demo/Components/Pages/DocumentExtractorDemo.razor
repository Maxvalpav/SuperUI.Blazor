@page "/document-extractor-demo"
@using SuperUI.Components
@using SuperUI.Components.DocumentExtractor
@using SuperUI.Components.DocumentExtractor.Models
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer

<PageTitle>Document Extractor — SUI</PageTitle>
<SgSeoHead Description="Загрузите .pdf, .docx или картинку — компонент извлечёт редактируемые поля через LLM или встроенный парсер и сохранит результат обратно в том же формате." />

<div class="ded-page">
    <header class="ded-header">
        <div class="ded-header-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
        </div>
        <div class="ded-header-text">
            <SgTypography Variant="SgTypographyVariant.Heading3" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 12px; display: block;">Document Extractor</SgTypography>
            <p>
                Загрузите <code>.pdf</code>, <code>.docx</code> или картинку — компонент извлечёт редактируемые поля
                через LLM или встроенный парсер и сохранит результат обратно в том же формате.
            </p>
        </div>
    </header>

    <SgDocumentExtractor />
</div>

<style>
    .ded-page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 20px 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .ded-header {
        display: flex;
        align-items: flex-start;
        gap: 16px;
    }
    .ded-header-icon {
        flex: 0 0 auto;
        width: 48px;
        height: 48px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: var(--sg-color-primary-subtle);
        color: var(--sg-color-primary);
    }
    .ded-header-text h1 { margin: 0 0 4px; font-size: 22px; font-weight: 600; }
    .ded-header-text p  { margin: 0; color: var(--sg-fg-muted); font-size: 13px; line-height: 1.55; }
    .ded-header-text code {
        background: var(--sg-bg-subtle);
        padding: 1px 5px;
        border-radius: 4px;
        font-size: 12px;
    }
</style>
