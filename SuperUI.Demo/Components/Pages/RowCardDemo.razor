@code {
    private RenderFragment _mainHeader => __builder =>
    {
        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
            
            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">Cards & Dashboards</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Universal SgCard containers combined with the adaptive SgRow/SgCol grid for building complex interfaces — from KPI dashboards to content galleries.
                </SgTypography>
            </SgStack>
        </SgStack>
    };

    private bool _loading = true;

    private async Task ToggleLoading()
    {
        _loading = !_loading;
        if (_loading)
        {
            await Task.Delay(2000);
            _loading = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(1500);
        _loading = false;
        StartKpiTimer();
        UpdateCardCode();
    }

    private System.Threading.Timer? _kpiTimer;
    private readonly Random _rng = new();

    private void StartKpiTimer()
    {
        _kpiTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(() =>
            {
                foreach (var kpi in _kpiData)
                {
                    var delta = _rng.Next(-5, 6);
                    kpi.Trend += delta * 0.1;
                    kpi.Trend = Math.Round(Math.Max(-20, Math.Min(20, kpi.Trend)), 1);

                    var baseVal = _kpiBaseValues[kpi.Label];
                    var noise = _rng.NextDouble() * 0.1 - 0.05;
                    if (kpi.Label == "Total Revenue")
                        kpi.Value = $"${(baseVal + noise * 10000):N0}";
                    else if (kpi.Label == "Active Users")
                        kpi.Value = $"{(int)(baseVal + noise * 500):N0}";
                    else if (kpi.Label == "Conversion")
                        kpi.Value = $"{(baseVal + noise * 2):F1}%";
                    else if (kpi.Label == "Server Load")
                        kpi.Value = $"{(baseVal + noise * 10):F0}%";
                }
                StateHasChanged();
            });
        }, null, 3000, 3000);
    }

    private void RefreshKpiData()
    {
        foreach (var kpi in _kpiData)
        {
            var baseVal = _kpiBaseValues[kpi.Label];
            var noise = _rng.NextDouble() * 0.2 - 0.1;
            kpi.Trend = Math.Round(_rng.NextDouble() * 20 - 10, 1);
            if (kpi.Label == "Total Revenue")
                kpi.Value = $"${(baseVal + noise * 10000):N0}";
            else if (kpi.Label == "Active Users")
                kpi.Value = $"{(int)(baseVal + noise * 500):N0}";
            else if (kpi.Label == "Conversion")
                kpi.Value = $"{(baseVal + noise * 2):F1}%";
            else if (kpi.Label == "Server Load")
                kpi.Value = $"{(baseVal + noise * 10):F0}%";
        }
        StateHasChanged();
    }

    private readonly Dictionary<string, double> _kpiBaseValues = new()
    {
        ["Total Revenue"] = 45231,
        ["Active Users"] = 2405,
        ["Conversion"] = 4.8,
        ["Server Load"] = 22
    };

    private class KpiItem
    {
        public string Label { get; set; } = "";
        public string Value { get; set; } = "";
        public double Trend { get; set; }
        public string Icon { get; set; } = "";
        public SgCardStatus Status { get; set; } = SgCardStatus.None;
    }

    private List<KpiItem> _kpiData = new()
    {
        new() { Label = "Total Revenue", Value = "$45,231", Trend = 12.5, Status = SgCardStatus.Success, Icon = SgIcons.DollarSign },
        new() { Label = "Active Users",  Value = "2,405",   Trend = 3.2,  Status = SgCardStatus.Info,    Icon = SgIcons.Users },
        new() { Label = "Conversion",    Value = "4.8%",    Trend = -1.5, Status = SgCardStatus.Warning, Icon = SgIcons.TrendingUp },
        new() { Label = "Server Load",   Value = "22%",     Trend = 0.5,  Status = SgCardStatus.Muted,   Icon = SgIcons.Activity }
    };

    private SgCardVariant _cardVariant = SgCardVariant.Default;
    private SgSize _cardSize = SgSize.Md;
    private SgShadow _cardShadow = SgShadow.Md;
    private SgCardStatus _cardStatus = SgCardStatus.None;
    private SgSize _cardRadius = SgSize.Md;
    private bool _cardHoverable = true;
    private bool _cardClickable;
    private bool _cardCompact;
    private bool _cardGlow;

    private string[] _cardGeneratedCode = Array.Empty<string>();
    private string _cardCopyIcon = "📋";
    private string _cardCopyLabel = "Copy";

    private readonly List<SgSegmentedOption<SgCardVariant>> _variantOptions = new()
    {
        new() { Value = SgCardVariant.Default, Label = "Default" },
        new() { Value = SgCardVariant.Elevated, Label = "Elevated" },
        new() { Value = SgCardVariant.Filled, Label = "Filled" },
        new() { Value = SgCardVariant.Ghost, Label = "Ghost" },
    };

    private readonly List<SgSegmentedOption<SgSize>> _sizeOptions = new()
    {
        new() { Value = SgSize.Sm, Label = "Sm" },
        new() { Value = SgSize.Md, Label = "Md" },
        new() { Value = SgSize.Lg, Label = "Lg" },
        new() { Value = SgSize.Xl, Label = "Xl" },
    };

    private readonly List<SgSegmentedOption<SgShadow>> _shadowOptions = new()
    {
        new() { Value = SgShadow.None, Label = "None" },
        new() { Value = SgShadow.Sm, Label = "Sm" },
        new() { Value = SgShadow.Md, Label = "Md" },
        new() { Value = SgShadow.Lg, Label = "Lg" },
    };

    private readonly List<SgSegmentedOption<SgSize>> _radiusOptions = new()
    {
        new() { Value = SgSize.Sm, Label = "Sm" },
        new() { Value = SgSize.Md, Label = "Md" },
        new() { Value = SgSize.Lg, Label = "Lg" },
    };

    private readonly List<SgSegmentedOption<bool>> _boolOptions = new()
    {
        new() { Value = false, Label = "Off" },
        new() { Value = true, Label = "On" },
    };

    private readonly List<SgSegmentedOption<bool>> _boolOptionsRev = new()
    {
        new() { Value = true, Label = "On" },
        new() { Value = false, Label = "Off" },
    };

    private readonly List<SgCardStatus> _statusItems = Enum.GetValues<SgCardStatus>().ToList();

    private void UpdateCardCode()
    {
        var lines = new List<string>();
        lines.Add($"<SgCard Variant=\"SgCardVariant.{_cardVariant}\"");
        lines.Add($"       Size=\"SgSize.{_cardSize}\"");
        lines.Add($"       Shadow=\"SgShadow.{_cardShadow}\"");
        if (_cardStatus != SgCardStatus.None)
            lines.Add($"       Status=\"SgCardStatus.{_cardStatus}\"");
        if (_cardRadius != SgSize.Md)
            lines.Add($"       Radius=\"SgSize.{_cardRadius}\"");
        if (_cardHoverable)
            lines.Add($"       Hoverable=\"true\"");
        if (_cardClickable)
            lines.Add($"       Clickable=\"true\"");
        if (_cardCompact)
            lines.Add($"       Compact=\"true\"");
        if (_cardGlow)
            lines.Add($"       Glow=\"true\"");
        lines.Add($"       Title=\"Card Title\"");
        lines.Add($"       Subtitle=\"Card subtitle\">");
        lines.Add($"    <SgTypography Size=\"SgTypographySize.Sm\">");
        lines.Add($"        Content goes here...");
        lines.Add($"    </SgTypography>");
        lines.Add("</SgCard>");
        _cardGeneratedCode = lines.ToArray();
    }

    private async Task CopyCardCode()
    {
        var code = string.Join("\n", _cardGeneratedCode);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _cardCopyIcon = "✓";
            _cardCopyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _cardCopyIcon = "📋";
            _cardCopyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _cardCopyIcon = "✗";
            _cardCopyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _cardCopyIcon = "📋";
            _cardCopyLabel = "Copy";
            StateHasChanged();
        }
    }
}
