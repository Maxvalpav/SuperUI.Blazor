@page "/row-card-demo"
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>Cards & Dashboards - SuperUI</PageTitle>

<SgCard Title="Карточки и Дашборды" 
        Subtitle="Универсальные контейнеры SgCard в сочетании с адаптивной сеткой SgRow/SgCol для построения сложных интерфейсов.">

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- 1. Варианты карточек                                                  -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2 class="demo-section-title">Типы и варианты карточек</h2>
        <p>Поддержка различных визуальных стилей: тени, границы, заливка и эффект стекла.</p>

        <SgRow Space="SgSize.Lg" Style="margin-top: 16px;">
            <SgCol Xs="24" Md="8">
                <SgCard Title="Default (Bordered)" Subtitle="Стандартная карточка с границей" Shadow="SgShadow.Xs">
                    Контент по умолчанию. Чистый и минималистичный вид для большинства сценариев.
                </SgCard>
            </SgCol>
            <SgCol Xs="24" Md="8">
                <SgCard Title="Elevated" Subtitle="Карточка с мягкой тенью" Variant="SgCardVariant.Elevated" Shadow="SgShadow.Md">
                    Используйте для выделения важных блоков контента над основной поверхностью.
                </SgCard>
            </SgCol>
            <SgCol Xs="24" Md="8">
                <SgCard Title="Filled" Subtitle="Карточка с фоновой заливкой" Variant="SgCardVariant.Filled">
                    Мягкий акцент без тени. Идеально для второстепенных блоков или списков.
                </SgCard>
            </SgCol>
        </SgRow>

        <SgRow Space="SgSize.Lg" Style="margin-top: 24px;">
            <SgCol Xs="24" Md="12">
                <div style="background: url('https://images.unsplash.com/photo-1557683316-973673baf926?auto=format&fit=crop&w=800&q=80'); padding: 40px; border-radius: 12px;">
                    <SgCard Glass="true" Title="Glassmorphism" Subtitle="Эффект матового стекла" Radius="SgSize.Lg">
                        Адаптивный эффект стекла с размытием фона (backdrop-filter). Шикарно смотрится на ярких фонах.
                    </SgCard>
                </div>
            </SgCol>
            <SgCol Xs="24" Md="12">
                <SgCard Title="Interactive" Subtitle="Hoverable + Clickable" Hoverable="true" Clickable="true" Radius="SgSize.Xl" Status="SgCardStatus.Success">
                    <ChildContent>
                        Приподнимается при наведении и имеет курсор-указатель. Идеально для карточек-ссылок.
                    </ChildContent>
                    <FooterContent>
                        <SgStack Horizontal Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center">
                            <span>Нажмите для перехода</span>
                            <SgIcon Icon="@SgIcons.ChevronRight" />
                        </SgStack>
                    </FooterContent>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- 2. Dashboards / KPI                                                  -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 48px;">
        <h2 class="demo-section-title">Паттерн: KPI Dashboard</h2>
        <p>Использование <code>SgRow</code> и <code>SgCol</code> для создания аналитических панелей.</p>

        <SgRow Space="SgSize.Md" Style="margin-top: 16px;">
            @foreach (var kpi in _kpiData)
            {
                <SgCol Xs="24" Sm="12" Lg="6">
                    <SgCard Title="@kpi.Label" 
                            Icon="@kpi.Icon"
                            Status="@kpi.Status" 
                            Shadow="SgShadow.Sm" 
                            Radius="SgSize.Md"
                            Compact="true">
                        <div style="display:flex; align-items:baseline; gap:8px;">
                            <div style="font-size:22px; font-weight:700; color:var(--sg-text);">@kpi.Value</div>
                            <div style="font-size:12px; display:flex; align-items:center; gap:2px; color:@(kpi.Trend > 0 ? "var(--sg-success)" : "var(--sg-danger)")">
                                <SgIcon Icon="@(kpi.Trend > 0 ? SgIcons.ArrowUp : SgIcons.ArrowDown)" Size="12px" />
                                <span style="font-weight:600;">@Math.Abs(kpi.Trend)%</span>
                            </div>
                            <div style="font-size:11px; color:var(--sg-text-muted); margin-left:auto;">vs last mo.</div>
                        </div>
                    </SgCard>
                </SgCol>
            }
        </SgRow>
    </div>

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- 3. Сложный контент и Skeleton                                         -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 48px;">
        <h2 class="demo-section-title">Сложный контент и состояния</h2>
        
        <SgRow Space="SgSize.Lg" Style="margin-top: 16px;">
            <SgCol Xs="24" Md="12">
                <SgCard Title="Project Overview" Subtitle="Работа с футером и действиями" Shadow="SgShadow.Md">
                    <ActionContent>
                        <SgButton Variant="SgButtonVariant.Ghost" Size="SgSize.Sm">
                            <Icon><SgIcon Icon="@SgIcons.Settings" /></Icon>
                        </SgButton>
                    </ActionContent>
                    <ChildContent>
                        <SgStack Vertical Space="SgSize.Md">
                            <p style="margin:0; font-size:14px; line-height:1.6;">
                                Этот пример демонстрирует использование слотов <code>ActionContent</code> (справа в шапке) 
                                и <code>FooterContent</code> для создания полноценного виджета.
                            </p>
                            <SgProgress Value="65" Status="SgStatus.Processing" Title="Development Progress" />
                        </SgStack>
                    </ChildContent>
                    <FooterContent>
                        <SgStack Horizontal Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center">
                            <SgAvatarGroup MaxCount="3">
                                <SgAvatar Initials="AD" Color="#1890ff" />
                                <SgAvatar Initials="BK" Color="#52c41a" />
                                <SgAvatar Initials="CL" Color="#f5222d" />
                                <SgAvatar Initials="DM" Color="#faad14" />
                            </SgAvatarGroup>
                            <span style="font-size:11px;">Updated 2h ago</span>
                        </SgStack>
                    </FooterContent>
                </SgCard>
            </SgCol>

            <SgCol Xs="24" Md="12">
                <SgCard Title="Loading State" Subtitle="Автоматический скелетон" Loading="_loading">
                    <ActionContent>
                        <SgButton Text="@(_loading ? "Stop" : "Reload")" 
                                  OnClick="ToggleLoading" 
                                  Size="SgSize.Sm" 
                                  Variant="SgButtonVariant.Outlined" />
                    </ActionContent>
                    <ChildContent>
                        Этот текст будет скрыт за скелетоном, пока параметр Loading=true. 
                        Скелетон теперь более детализирован и имитирует структуру карточки.
                    </ChildContent>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

</SgCard>

<style>
    .demo-section-title {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 8px;
        color: var(--sg-text);
        letter-spacing: -0.02em;
    }
    
    .demo-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--sg-text-muted);
        margin-bottom: 12px;
        display: block;
        border-bottom: 1px solid var(--sg-border);
        padding-bottom: 4px;
    }
</style>

@code {
    private bool _loading = true;

    private async Task ToggleLoading()
    {        _loading = !_loading;
        if (_loading)
        {            await Task.Delay(2000);
            _loading = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {        await Task.Delay(1500);
        _loading = false;
    }

    private class KpiItem
    {        public string Label { get; set; } = "";
        public string Value { get; set; } = "";
        public double Trend { get; set; }
        public string Icon { get; set; } = "";
        public SgCardStatus Status { get; set; } = SgCardStatus.None;
    }

    private List<KpiItem> _kpiData = new()
    {
        new() { Label = "Total Revenue", Value = "$45,231", Trend = 12.5, Status = SgCardStatus.Success, Icon = SgIcons.DollarSign },
        new() { Label = "Active Users",  Value = "2,405",   Trend = 3.2,  Status = SgCardStatus.Info,    Icon = SgIcons.Users },
        new() { Label = "Conversion",    Value = "4.8%",    Trend = -1.5, Status = SgCardStatus.Warning, Icon = SgIcons.TrendingUp },
        new() { Label = "Server Load",   Value = "22%",     Trend = 0.5,  Status = SgCardStatus.Muted,   Icon = SgIcons.Activity }
    };
}
