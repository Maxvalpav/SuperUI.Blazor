@page "/row-card-demo"
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>SgCard — Карточки - SUI</PageTitle>

<SgCard Title="Карточки"
        Subtitle="SgCard — универсальный контейнер с вариантами, размерами, статусами, обложкой, выбором и сворачиванием."
        Variant="SgCardVariant.Default">

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SgCard — варианты                                                    -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2>SgCard — Варианты оформления</h2>
        <p>Параметр <code>Variant</code> переключает стиль поверхности: Default, Elevated, Outlined, Filled, Ghost.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <SgRow Gutter="12px">
                    <SgCol Md="6"><SgCard Variant="SgCardVariant.Default"  Title="Default"  Subtitle="Поверхность по умолчанию">Лёгкая тень, тонкая граница.</SgCard></SgCol>
                    <SgCol Md="6"><SgCard Variant="SgCardVariant.Elevated" Title="Elevated" Subtitle="Без рамки, сильная тень">Подходит для приподнятых блоков.</SgCard></SgCol>
                    <SgCol Md="6"><SgCard Variant="SgCardVariant.Outlined" Title="Outlined" Subtitle="Только граница">Без тени — спокойный вид.</SgCard></SgCol>
                    <SgCol Md="6"><SgCard Variant="SgCardVariant.Filled"   Title="Filled"   Subtitle="Заполненный фон">Серый фон, без тени.</SgCard></SgCol>
                    <SgCol Md="12"><SgCard Variant="SgCardVariant.Ghost"   Title="Ghost"    Subtitle="Прозрачный с пунктиром">Хорош как пустое состояние / drop-zone.</SgCard></SgCol>
                </SgRow>
            </SgCard>

            <SgCard Title="Свойства SgCard">
                <PropertyTable Items="_cardProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SgCard — размеры                                                     -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2>SgCard — Размеры и плотность</h2>
        <p>Параметр <code>Size</code> (Sm/Md/Lg/Xl) масштабирует отступы и шрифт. <code>Compact</code> — ещё плотнее. <code>NoPadding</code> — убирает отступы тела.</p>

        <SgRow Gutter="16px" Style="margin-top:16px;">
            <SgCol Md="3"><SgCard Size="SgSize.Sm"  Title="Small"  Subtitle="плотная карточка">Sm</SgCard></SgCol>
            <SgCol Md="3"><SgCard Size="SgSize.Md"  Title="Medium" Subtitle="по умолчанию">Md</SgCard></SgCol>
            <SgCol Md="3"><SgCard Size="SgSize.Lg"  Title="Large"  Subtitle="увеличенные отступы">Lg</SgCard></SgCol>
            <SgCol Md="3"><SgCard Size="SgSize.Xl"  Title="Extra"  Subtitle="максимально просторно">Xl</SgCard></SgCol>
        </SgRow>

        <SgRow Gutter="16px" Style="margin-top:16px;">
            <SgCol Md="6"><SgCard Title="Compact" Compact="true" Subtitle="меньше отступы">Идеально для дашбордов с большим числом карточек.</SgCard></SgCol>
            <SgCol Md="6">
                <SgCard Title="NoPadding" NoPadding="true">
                    <div style="padding: 0; background: linear-gradient(120deg, var(--sui-accent), #4f46e5); color:#fff; padding: 18px;">
                        Содержимое управляет своими отступами само.
                    </div>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SgCard — статусы                                                     -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2>SgCard — Статусные акценты</h2>
        <p>Параметр <code>Status</code> добавляет цветную полоску слева — удобно для индикации состояния (info / success / warning / danger / muted).</p>

        <SgRow Gutter="16px" Style="margin-top:16px;">
            <SgCol Md="4"><SgCard Status="SgCardStatus.Info"    Title="Info"    Subtitle="нейтральная информация">Используйте для подсказок и справочной информации.</SgCard></SgCol>
            <SgCol Md="4"><SgCard Status="SgCardStatus.Success" Title="Success" Subtitle="операция выполнена">Подтверждение успешного действия.</SgCard></SgCol>
            <SgCol Md="4"><SgCard Status="SgCardStatus.Warning" Title="Warning" Subtitle="требуется внимание">Что-то требует проверки или подтверждения.</SgCard></SgCol>
            <SgCol Md="4"><SgCard Status="SgCardStatus.Danger"  Title="Danger"  Subtitle="ошибка или критическое состояние">Деструктивные действия и сбои.</SgCard></SgCol>
            <SgCol Md="4"><SgCard Status="SgCardStatus.Muted"   Title="Muted"   Subtitle="неактивно / архив">Для неактивных или второстепенных элементов.</SgCard></SgCol>
        </SgRow>
    </div>

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SgCard — иконки, действия, обложка                                   -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2>SgCard — Иконки, действия, обложка</h2>
        <p>Заголовок поддерживает <code>Icon</code>, кнопки <code>ActionContent</code>, обложку <code>CoverContent</code> и нижний колонтитул <code>FooterContent</code>.</p>

        <SgRow Gutter="16px" Style="margin-top:16px;">
            <SgCol Md="6">
                <SgCard Title="С иконкой и действиями"
                        Subtitle="иконка слева, кнопки справа"
                        Icon="@SgIcons.Settings">
                    <ActionContent>
                        <SgIconButton Icon="@SgIcons.Refresh" Title="Обновить" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" />
                        <SgIconButton Icon="@SgIcons.X"       Title="Закрыть"  Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" />
                    </ActionContent>
                    <ChildContent>
                        Кнопки в шапке не запускают <code>OnClick</code> карточки — клики останавливаются на уровне actions.
                    </ChildContent>
                </SgCard>
            </SgCol>

            <SgCol Md="6">
                <SgCard Title="С нижним колонтитулом"
                        Subtitle="полезно для статистики">
                    <ChildContent>
                        Используйте <code>FooterContent</code> для метаданных, таймстемпов и итогов.
                    </ChildContent>
                    <FooterContent>
                        <div style="display:flex;justify-content:space-between;">
                            <span>Создано: 09.05.2026</span>
                            <span>Автор: SUI</span>
                        </div>
                    </FooterContent>
                </SgCard>
            </SgCol>

            <SgCol Md="6">
                <SgCard Title="С обложкой" Subtitle="CoverContent над шапкой" OverflowHidden="true">
                    <CoverContent>
                        <div style="height:120px;background:linear-gradient(120deg,#1890ff,#722ed1);"></div>
                    </CoverContent>
                    <ChildContent>
                        Обложка занимает всю ширину и обрезается за счёт <code>OverflowHidden</code>.
                    </ChildContent>
                </SgCard>
            </SgCol>

            <SgCol Md="6">
                <SgCard Title="Загрузка" Loading="true" Subtitle="Loading=true заменяет тело скелетоном" />
            </SgCol>
        </SgRow>
    </div>

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SgCard — выбираемые                                                   -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2>SgCard — Выбираемые карточки</h2>
        <p>
            Параметр <code>Selectable</code> превращает карточку в кнопку (роль <code>button</code>, поддержка клавиатуры,
            <code>aria-pressed</code>). <code>Selected</code> двусторонне привязывается. Подсветка через accent.
        </p>

        <SgRow Gutter="12px" Style="margin-top:16px;">
            @foreach (var p in _plans)
            {
                <SgCol Md="4">
                    <SgCard Selectable="true"
                            Selected="@(p.Id == _selectedPlanId)"
                            SelectedChanged="@(_ => SelectPlan(p.Id))"
                            Title="@p.Name"
                            Subtitle="@p.Tagline"
                            Icon="@SgIcons.Check">
                        <div style="display:flex;flex-direction:column;gap:6px;">
                            <div style="font-size:24px;font-weight:700;">@p.Price <span style="font-size:12px;color:var(--sui-text-muted);">/мес</span></div>
                            <ul style="margin:0;padding-left:18px;color:var(--sui-text-secondary);font-size:12px;">
                                @foreach (var f in p.Features)
                                {
                                    <li>@f</li>
                                }
                            </ul>
                        </div>
                    </SgCard>
                </SgCol>
            }
        </SgRow>
        <div style="margin-top:8px;font-size:12px;color:var(--sui-text-muted);">
            Выбран: @(_plans.FirstOrDefault(x => x.Id == _selectedPlanId)?.Name ?? "—")
        </div>
    </div>

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SgCard — сворачиваемые                                                -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2>SgCard — Сворачиваемые карточки</h2>
        <p><code>Collapsible</code> добавляет кнопку-шеврон. <code>Collapsed</code> — двусторонняя привязка состояния.</p>

        <SgRow Gutter="16px" Style="margin-top:16px;">
            <SgCol Md="6">
                <SgCard Title="Описание API"
                        Subtitle="нажмите шеврон в шапке"
                        Icon="@SgIcons.FileText"
                        Collapsible="true"
                        @bind-Collapsed="_collapsedA">
                    Любые компоненты внутри: формы, списки, изображения. Состояние можно сохранять в localStorage.
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Изначально свёрнута"
                        Icon="@SgIcons.ChevronDown"
                        Collapsible="true"
                        @bind-Collapsed="_collapsedB">
                    Подходит для FAQ-секций и сложных форм с разделами.
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SgCard — паттерны                                                     -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2>Паттерны использования</h2>
        <p>Готовые композиции — карточки и сетка вместе.</p>

        <SgCard Title="Дашборд KPI" Style="margin-top:16px;">
            <SgRow Gutter="16px">
                <SgCol Md="3"><SgCard Variant="SgCardVariant.Filled" Status="SgCardStatus.Info"    Compact="true"><div style="font-size:12px;color:var(--sui-text-muted);">Активных пользователей</div><div style="font-size:24px;font-weight:700;">12 480</div></SgCard></SgCol>
                <SgCol Md="3"><SgCard Variant="SgCardVariant.Filled" Status="SgCardStatus.Success" Compact="true"><div style="font-size:12px;color:var(--sui-text-muted);">Конверсия</div><div style="font-size:24px;font-weight:700;">4.7%</div></SgCard></SgCol>
                <SgCol Md="3"><SgCard Variant="SgCardVariant.Filled" Status="SgCardStatus.Warning" Compact="true"><div style="font-size:12px;color:var(--sui-text-muted);">Отказы</div><div style="font-size:24px;font-weight:700;">8.2%</div></SgCard></SgCol>
                <SgCol Md="3"><SgCard Variant="SgCardVariant.Filled" Status="SgCardStatus.Danger"  Compact="true"><div style="font-size:12px;color:var(--sui-text-muted);">Ошибки</div><div style="font-size:24px;font-weight:700;">19</div></SgCard></SgCol>
            </SgRow>
        </SgCard>
    </div>
</SgCard>

@code {
    // ── Selectable demo ──────────────────────────────────────────────────────
    private record Plan(string Id, string Name, string Tagline, string Price, string[] Features);

    private readonly List<Plan> _plans = new()
    {
        new("free", "Free",  "Для старта",   "0 ₽",     new[] { "1 пользователь", "Базовые компоненты", "Сообщество" }),
        new("pro",  "Pro",   "Командам",    "990 ₽",    new[] { "10 пользователей", "Полный набор", "Поддержка email" }),
        new("ent",  "Enterprise", "Бизнесу", "По запросу", new[] { "Безлимит", "Приоритет SLA", "Внедрение" }),
    };
    private string _selectedPlanId = "pro";

    private void SelectPlan(string id) => _selectedPlanId = id;

    // ── Collapsible state ────────────────────────────────────────────────────
    private bool _collapsedA;
    private bool _collapsedB = true;

    // ── Property tables ──────────────────────────────────────────────────────
    private List<PropertyPanelItem> _cardProperties = new()
    {
        new() { Label = "Title",         Value = "string?",                     BadgeText = "Заголовок",   BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Subtitle",      Value = "string?",                     BadgeText = "Подзаголовок", BadgeVariant = SgBadgeVariant.Info   },
        new() { Label = "Icon",          Value = "string? (SVG)",               BadgeText = "Иконка",      BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Variant",       Value = "Default|Elevated|Outlined|Filled|Ghost", BadgeText = "Стиль", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Size",          Value = "Sm | Md | Lg | Xl",           BadgeText = "Размер",      BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Status",        Value = "None|Info|Success|Warning|Danger|Muted", BadgeText = "Полоска", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Bordered",      Value = "bool (true)",                 BadgeText = "Граница",     BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Hoverable",     Value = "bool",                        BadgeText = "Hover-эффект", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "OverflowHidden",Value = "bool (true)",                 BadgeText = "Обрезка",     BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Compact",       Value = "bool",                        BadgeText = "Плотность",   BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "NoPadding",     Value = "bool",                        BadgeText = "Без отступов", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Loading",       Value = "bool",                        BadgeText = "Загрузка",    BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Selectable",    Value = "bool",                        BadgeText = "Выбираемая",  BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Selected",      Value = "bool (bind)",                 BadgeText = "Выбрана",     BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Disabled",      Value = "bool",                        BadgeText = "Отключена",   BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Collapsible",   Value = "bool",                        BadgeText = "Сворачиваемая",BadgeVariant = SgBadgeVariant.Warn   },
        new() { Label = "Collapsed",     Value = "bool (bind)",                 BadgeText = "Свёрнута",    BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "CoverContent",  Value = "RenderFragment?",             BadgeText = "Обложка",     BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "HeaderContent", Value = "RenderFragment?",             BadgeText = "Свой header", BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "ActionContent", Value = "RenderFragment?",             BadgeText = "Действия",    BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "FooterContent", Value = "RenderFragment?",             BadgeText = "Подвал",      BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "OnClick",       Value = "EventCallback<MouseEventArgs>", BadgeText = "Клик",      BadgeVariant = SgBadgeVariant.Success },
    };
}
