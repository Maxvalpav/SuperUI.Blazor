@page "/row-card-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgCard & Dashboards — Card Gallery — SuperUI</PageTitle>

<SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" Status="SgCardStatus.Info"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Card Variants                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Card Variants
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Support for multiple visual styles: shadows, borders, filled backgrounds, glass effect, and interactive states.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg" Style="margin-top:16px;">
            <SgCol Xs="12" Md="4">
                <SgCard Title="Default (Bordered)" Subtitle="Standard card with border" Shadow="SgShadow.Sm" Hoverable="true">
                    <SgTypography Size="SgTypographySize.Sm">Clean, minimal look for most scenarios. Comes with a subtle border and light shadow on hover.</SgTypography>
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Md="4">
                <SgCard Title="Elevated" Subtitle="Soft shadow depth" Variant="SgCardVariant.Elevated" Shadow="SgShadow.Md" Hoverable="true">
                    <SgTypography Size="SgTypographySize.Sm">Use to highlight important content above the main surface. The medium shadow creates clear visual hierarchy.</SgTypography>
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Md="4">
                <SgCard Title="Filled" Subtitle="Background fill" Variant="SgCardVariant.Filled" Hoverable="true">
                    <SgTypography Size="SgTypographySize.Sm">Soft accent without shadow. Ideal for secondary blocks, lists, or when you need subtle visual grouping.</SgTypography>
                </SgCard>
            </SgCol>
        </SgRow>

        <SgRow Space="SgSize.Lg" Style="margin-top:24px;">
            <SgCol Xs="12" Md="6">
                <div class="glass-bg">
                    <SgCard Glass="true" Title="Glassmorphism" Subtitle="Frosted glass effect" Radius="SgSize.Lg" Shadow="SgShadow.Md" Hoverable="true">
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Sm">Adaptive glass effect with backdrop blur. Looks stunning on vibrant backgrounds.</SgTypography>
                            <SgSpace>
                                <SgBadge Variant="SgBadgeVariant.Success" Text="Glass" Standalone="true" />
                                <SgBadge Variant="SgBadgeVariant.Info" Text="Backdrop" Standalone="true" />
                                <SgBadge Variant="SgBadgeVariant.Warn" Text="Blur" Standalone="true" />
                            </SgSpace>
                        </SgStack>
                    </SgCard>
                </div>
            </SgCol>
            <SgCol Xs="12" Md="6">
                <SgCard Title="Interactive" Subtitle="Hoverable + Clickable + Status" Hoverable="true" Clickable="true" Radius="SgSize.Xl" Status="SgCardStatus.Success" Shadow="SgShadow.Md">
                    <ChildContent>
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Sm">Lifts on hover with pointer cursor. Perfect for clickable card links with status accent stripes.</SgTypography>
                        </SgStack>
                    </ChildContent>
                    <FooterContent>
                        <SgStack Horizontal Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center">
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Click to navigate</SgTypography>
                            <SgIcon Icon="@SgIcons.ChevronRight" Size="16px" Color="var(--sg-text-muted)" />
                        </SgStack>
                    </FooterContent>
                </SgCard>
            </SgCol>
        </SgRow>

        <!-- Variant Showcase Row -->
        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-top:32px;margin-bottom:12px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
            Size Variants & Status Accents
        </SgTypography>
        <SgRow Space="SgSize.Md">
            <SgCol Xs="12" Md="4">
                <SgCard Title="Compact (Sm)" Subtitle="Dense content" Size="SgSize.Sm" Compact="true" Status="SgCardStatus.Info" Hoverable="true">
                    <SgTypography Size="SgTypographySize.Sm">Tight padding for dense dashboards and data-heavy UIs.</SgTypography>
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Md="4">
                <SgCard Title="Default (Md)" Subtitle="Balanced spacing" Size="SgSize.Md" Status="SgCardStatus.Warning" Hoverable="true">
                    <SgTypography Size="SgTypographySize.Sm">Standard padding, ideal for most content types.</SgTypography>
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Md="4">
                <SgCard Title="Large (Lg)" Subtitle="Generous spacing" Size="SgSize.Lg" Status="SgCardStatus.Danger" Hoverable="true">
                    <SgTypography Size="SgTypographySize.Sm">Spacious padding for featured content and call-to-action cards.</SgTypography>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. KPI Dashboard                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Pattern: KPI Dashboard
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Using <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgRow</SgTypography> and <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgCol</SgTypography> to build analytical panels with live-updating KPI cards. Data refreshes every 3 seconds.
            </SgTypography>
            <SgSpace Style="margin-top:8px;">
                <SgBadge Variant="SgBadgeVariant.Success" Text="@($"Live — {DateTime.Now:HH:mm:ss}")" Standalone="true" />
                <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined" OnClick="RefreshKpiData">
                    <Icon><SgIcon Icon="@SgIcons.Refresh" Size="14px" /></Icon>
                    <ChildContent><SgTypography Size="SgTypographySize.Sm">Refresh</SgTypography></ChildContent>
                </SgButton>
            </SgSpace>
        </div>

        <SgRow Space="SgSize.Md" Style="margin-top:16px;">
            @foreach (var kpi in _kpiData)
            {
                <SgCol Xs="12" Sm="6" Lg="3">
                    <SgCard Title="@kpi.Label"
                            Icon="@kpi.Icon"
                            Status="@kpi.Status"
                            Shadow="SgShadow.Sm"
                            Radius="SgSize.Md"
                            Compact="true"
                            Hoverable="true">
                        <div style="display:flex; align-items:baseline; gap:8px;">
                            <SgTypography Weight="SgTypographyWeight.Bold" Size="SgTypographySize.Xxl" Color="var(--sg-text)">@kpi.Value</SgTypography>
                            <SgSpace Size="small">
                                <span style="font-size:12px; display:flex; align-items:center; gap:2px; color:@(kpi.Trend > 0 ? "var(--sg-color-success)" : "var(--sg-color-danger)")">
                                    <SgIcon Icon="@(kpi.Trend > 0 ? SgIcons.ArrowUp : SgIcons.ArrowDown)" Size="12px" Color="@(kpi.Trend > 0 ? "var(--sg-color-success)" : "var(--sg-color-danger)")" />
                                    <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm" Color="@(kpi.Trend > 0 ? "var(--sg-color-success)" : "var(--sg-color-danger)")">@Math.Abs(kpi.Trend)%</SgTypography>
                                </span>
                            </SgSpace>
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Style="margin-left:auto;">vs last mo.</SgTypography>
                        </div>
                    </SgCard>
                </SgCol>
            }
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Complex Content & States                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Complex Content & States
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Cards with slot-based layouts — <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ActionContent</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">FooterContent</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">CoverContent</SgTypography>, and loading skeleton states.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg" Style="margin-top:16px;">
            <SgCol Xs="12" Md="6">
                <SgCard Title="Project Overview" Subtitle="Working with footer and actions" Shadow="SgShadow.Md" Status="SgCardStatus.Info" Hoverable="true">
                    <ActionContent>
                        <SgButton Variant="SgButtonVariant.Ghost" Size="SgSize.Sm">
                            <Icon><SgIcon Icon="@SgIcons.Settings" Size="16px" /></Icon>
                        </SgButton>
                    </ActionContent>
                    <ChildContent>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgTypography Size="SgTypographySize.Sm">
                                This example demonstrates using <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ActionContent</SgTypography> (right side in header)
                                and <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">FooterContent</SgTypography> for a complete widget layout.
                            </SgTypography>
                            <SgProgress Value="65" Status="SgStatus.Processing" Title="Development Progress" />
                        </SgStack>
                    </ChildContent>
                    <FooterContent>
                        <SgStack Horizontal Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center">
                            <SgAvatarGroup MaxCount="3">
                                <SgAvatar Initials="AD" Color="#1890ff" />
                                <SgAvatar Initials="BK" Color="#52c41a" />
                                <SgAvatar Initials="CL" Color="#f5222d" />
                                <SgAvatar Initials="DM" Color="#faad14" />
                            </SgAvatarGroup>
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                                <SgIcon Icon="@SgIcons.Clock" Size="12px" /> Updated 2h ago
                            </SgTypography>
                        </SgStack>
                    </FooterContent>
                </SgCard>
            </SgCol>

            <SgCol Xs="12" Md="6">
                <SgCard Title="Loading State" Subtitle="Automatic skeleton while loading" Loading="_loading" Radius="SgSize.Lg" Status="SgCardStatus.Muted">
                    <ActionContent>
                        <SgButton OnClick="ToggleLoading"
                                  Size="SgSize.Sm"
                                  Variant="SgButtonVariant.Outlined">
                            <ChildContent>
                                <SgSpace Size="small">
                                    <SgIcon Icon="@(_loading ? SgIcons.X : SgIcons.Refresh)" Size="14px" />
                                    <SgTypography Size="SgTypographySize.Sm">@(_loading ? "Stop" : "Reload")</SgTypography>
                                </SgSpace>
                            </ChildContent>
                        </SgButton>
                    </ActionContent>
                    <ChildContent>
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Sm">
                                This content is hidden behind a skeleton while <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Loading=true</SgTypography>.
                                The skeleton mimics the card's structure with animated placeholders.
                            </SgTypography>
                            <SgTag Color="processing">Interactive Demo</SgTag>
                        </SgStack>
                    </ChildContent>
                </SgCard>
            </SgCol>
        </SgRow>

        <!-- Collapsible & Cover Content Row -->
        <SgRow Space="SgSize.Lg" Style="margin-top:24px;">
            <SgCol Xs="12" Md="6">
                <SgCard Title="Collapsible Card" Subtitle="Toggle to collapse body" Collapsible="true" Shadow="SgShadow.Sm" Hoverable="true">
                    <SgTypography Size="SgTypographySize.Sm">
                        Cards can be made collapsible with the <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Collapsible</SgTypography> flag.
                        Click the chevron in the header to expand/collapse the body content.
                        This is great for dashboards with optional detail sections.
                    </SgTypography>
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Md="6">
                <SgCard Title="Selectable Card" Subtitle="Toggle selection state" Selectable="true" Shadow="SgShadow.Sm" Hoverable="true" Status="SgCardStatus.Success">
                    <SgTypography Size="SgTypographySize.Sm">
                        Click this card to toggle its selected state. The <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Selectable</SgTypography> parameter
                        enables row-selection UX with keyboard support (Enter/Space) and aria attributes.
                    </SgTypography>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    </ChildContent>
</SgCard>

<style>
    /* ── Section layout ─────────────────────────────────────────────────────── */
    .demo-section {
        margin-top: 48px;
    }
    .demo-section-header {
        margin-bottom: 20px;
    }

    /* ── Glass background ───────────────────────────────────────────────────── */
    .glass-bg {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 40px;
        border-radius: 12px;
        min-height: 180px;
        display: flex;
        align-items: center;
    }

    /* ── Card hover transitions ─────────────────────────────────────────────── */
    .sgc-card {
        transition: transform var(--sg-transition-md), box-shadow var(--sg-transition-md);
    }
</style>

@code {
    // ── Main card header ─────────────────────────────────────────────────
    private RenderFragment _mainHeader => __builder =>
    {
        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
            <div style="display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,var(--sg-primary),#8b5cf6);color:#fff;flex-shrink:0;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                    <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
                </svg>
            </div>
            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">Cards & Dashboards</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Universal SgCard containers combined with the adaptive SgRow/SgCol grid for building complex interfaces — from KPI dashboards to content galleries.
                </SgTypography>
            </SgStack>
        </SgStack>
    };

    // ── Loading state ────────────────────────────────────────────────────
    private bool _loading = true;

    private async Task ToggleLoading()
    {
        _loading = !_loading;
        if (_loading)
        {
            await Task.Delay(2000);
            _loading = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(1500);
        _loading = false;
        StartKpiTimer();
    }

    // ── Live KPI refresh ─────────────────────────────────────────────────
    private System.Threading.Timer? _kpiTimer;
    private readonly Random _rng = new();

    private void StartKpiTimer()
    {
        _kpiTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(() =>
            {
                foreach (var kpi in _kpiData)
                {
                    var delta = _rng.Next(-5, 6);
                    kpi.Trend += delta * 0.1;
                    kpi.Trend = Math.Round(Math.Max(-20, Math.Min(20, kpi.Trend)), 1);

                    var baseVal = _kpiBaseValues[kpi.Label];
                    var noise = _rng.NextDouble() * 0.1 - 0.05;
                    if (kpi.Label == "Total Revenue")
                        kpi.Value = $"${(baseVal + noise * 10000):N0}";
                    else if (kpi.Label == "Active Users")
                        kpi.Value = $"{(int)(baseVal + noise * 500):N0}";
                    else if (kpi.Label == "Conversion")
                        kpi.Value = $"{(baseVal + noise * 2):F1}%";
                    else if (kpi.Label == "Server Load")
                        kpi.Value = $"{(baseVal + noise * 10):F0}%";
                }
                StateHasChanged();
            });
        }, null, 3000, 3000);
    }

    private void RefreshKpiData()
    {
        foreach (var kpi in _kpiData)
        {
            var baseVal = _kpiBaseValues[kpi.Label];
            var noise = _rng.NextDouble() * 0.2 - 0.1;
            kpi.Trend = Math.Round(_rng.NextDouble() * 20 - 10, 1);
            if (kpi.Label == "Total Revenue")
                kpi.Value = $"${(baseVal + noise * 10000):N0}";
            else if (kpi.Label == "Active Users")
                kpi.Value = $"{(int)(baseVal + noise * 500):N0}";
            else if (kpi.Label == "Conversion")
                kpi.Value = $"{(baseVal + noise * 2):F1}%";
            else if (kpi.Label == "Server Load")
                kpi.Value = $"{(baseVal + noise * 10):F0}%";
        }
        StateHasChanged();
    }

    private readonly Dictionary<string, double> _kpiBaseValues = new()
    {
        ["Total Revenue"] = 45231,
        ["Active Users"] = 2405,
        ["Conversion"] = 4.8,
        ["Server Load"] = 22
    };

    // ── KPI data ─────────────────────────────────────────────────────────
    private class KpiItem
    {
        public string Label { get; set; } = "";
        public string Value { get; set; } = "";
        public double Trend { get; set; }
        public string Icon { get; set; } = "";
        public SgCardStatus Status { get; set; } = SgCardStatus.None;
    }

    private List<KpiItem> _kpiData = new()
    {
        new() { Label = "Total Revenue", Value = "$45,231", Trend = 12.5, Status = SgCardStatus.Success, Icon = SgIcons.DollarSign },
        new() { Label = "Active Users",  Value = "2,405",   Trend = 3.2,  Status = SgCardStatus.Info,    Icon = SgIcons.Users },
        new() { Label = "Conversion",    Value = "4.8%",    Trend = -1.5, Status = SgCardStatus.Warning, Icon = SgIcons.TrendingUp },
        new() { Label = "Server Load",   Value = "22%",     Trend = 0.5,  Status = SgCardStatus.Muted,   Icon = SgIcons.Activity }
    };
}
