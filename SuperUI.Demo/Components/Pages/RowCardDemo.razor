@page "/row-card-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgCard & Dashboards — Card Gallery — SuperUI</PageTitle>

<SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" Status="SgCardStatus.Info" Animated="true"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Card Variants
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Multiple visual styles — shadows, borders, filled backgrounds, glass effect, interactive states, and live configuration.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Xs="12" Md="4">
                <SgCard Title="Default (Bordered)" Subtitle="Standard card with border" Shadow="SgShadow.Sm" Hoverable="true" Animated="true">
                    <SgTypography Size="SgTypographySize.Sm">Clean, minimal look for most scenarios. Comes with a subtle border and light shadow on hover.</SgTypography>
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Md="4">
                <SgCard Title="Elevated" Subtitle="Soft shadow depth" Variant="SgCardVariant.Elevated" Shadow="SgShadow.Md" Hoverable="true" Animated="true">
                    <SgTypography Size="SgTypographySize.Sm">Use to highlight important content above the main surface. The medium shadow creates clear visual hierarchy.</SgTypography>
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Md="4">
                <SgCard Title="Filled" Subtitle="Background fill" Variant="SgCardVariant.Filled" Hoverable="true" Animated="true">
                    <SgTypography Size="SgTypographySize.Sm">Soft accent without shadow. Ideal for secondary blocks, lists, or when you need subtle visual grouping.</SgTypography>
                </SgCard>
            </SgCol>
        </SgRow>

        <SgRow Space="SgSize.Lg" Style="margin-top:24px;">
            <SgCol Xs="12" Md="6">
                <div class="glass-bg">
                    <SgCard Glass="true" Title="Glassmorphism" Subtitle="Frosted glass effect" Radius="SgSize.Lg" Shadow="SgShadow.Md" Hoverable="true" Animated="true">
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Sm">Adaptive glass effect with backdrop blur. Looks stunning on vibrant backgrounds.</SgTypography>
                            <SgSpace>
                                <SgBadge Variant="SgBadgeVariant.Success" Text="Glass" Standalone="true" />
                                <SgBadge Variant="SgBadgeVariant.Info" Text="Backdrop" Standalone="true" />
                                <SgBadge Variant="SgBadgeVariant.Warn" Text="Blur" Standalone="true" />
                            </SgSpace>
                        </SgStack>
                    </SgCard>
                </div>
            </SgCol>
            <SgCol Xs="12" Md="6">
                <SgCard Title="Interactive" Subtitle="Hoverable + Clickable + Status + Glow" Hoverable="true" Clickable="true" Glow="true" Radius="SgSize.Xl" Status="SgCardStatus.Success" Shadow="SgShadow.Md" Animated="true">
                    <ChildContent>
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Sm">Lifts on hover with glow effect. Perfect for clickable card links with status accent stripes.</SgTypography>
                        </SgStack>
                    </ChildContent>
                    <FooterContent>
                        <SgStack Horizontal Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center">
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Click to navigate</SgTypography>
                            <SgIcon Icon="@SgIcons.ChevronRight" Size="16px" Color="var(--sg-text-muted)" />
                        </SgStack>
                    </FooterContent>
                </SgCard>
            </SgCol>
        </SgRow>

        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-top:32px;margin-bottom:12px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
            Size Variants & Status Accents
        </SgTypography>
        <SgRow Space="SgSize.Md">
            <SgCol Xs="12" Md="4">
                <SgCard Title="Compact (Sm)" Subtitle="Dense content" Size="SgSize.Sm" Compact="true" Status="SgCardStatus.Info" Hoverable="true" Animated="true">
                    <SgTypography Size="SgTypographySize.Sm">Tight padding for dense dashboards and data-heavy UIs.</SgTypography>
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Md="4">
                <SgCard Title="Default (Md)" Subtitle="Balanced spacing" Size="SgSize.Md" Status="SgCardStatus.Warning" Hoverable="true" Animated="true">
                    <SgTypography Size="SgTypographySize.Sm">Standard padding, ideal for most content types.</SgTypography>
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Md="4">
                <SgCard Title="Large (Lg)" Subtitle="Generous spacing" Size="SgSize.Lg" Status="SgCardStatus.Danger" Hoverable="true" Animated="true">
                    <SgTypography Size="SgTypographySize.Sm">Spacious padding for featured content and call-to-action cards.</SgTypography>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Pattern: KPI Dashboard
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Using <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgRow</SgTypography> and <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgCol</SgTypography> to build analytical panels with live-updating KPI cards. Data refreshes every 3 seconds.
            </SgTypography>
            <SgSpace Style="margin-top:8px;">
                <SgBadge Variant="SgBadgeVariant.Success" Text="@($"Live — {DateTime.Now:HH:mm:ss}")" Standalone="true" Pulse="true" />
                <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined" OnClick="RefreshKpiData">
                    <Icon><SgIcon Icon="@SgIcons.Refresh" Size="14px" /></Icon>
                    <ChildContent><SgTypography Size="SgTypographySize.Sm">Refresh</SgTypography></ChildContent>
                </SgButton>
            </SgSpace>
        </div>

        <SgRow Space="SgSize.Md" Style="margin-top:16px;">
            @foreach (var kpi in _kpiData)
            {
                var kpiItem = kpi;
                <SgCol Xs="12" Sm="6" Lg="3">
                    <SgCard Title="@kpiItem.Label"
                            Icon="@kpiItem.Icon"
                            Status="@kpiItem.Status"
                            Shadow="SgShadow.Sm"
                            Radius="SgSize.Md"
                            Compact="true"
                            Hoverable="true"
                            Animated="true">
                        <div style="display:flex; align-items:baseline; gap:8px;flex-wrap:wrap;">
                            <SgTypography class="kpi-value" Weight="SgTypographyWeight.Bold" Size="SgTypographySize.Xxl" Color="var(--sg-text)">@kpiItem.Value</SgTypography>
                            <SgSpace Size="small">
                                <span class="kpi-trend @(kpiItem.Trend >= 0 ? "trend-up" : "trend-down")">
                                    <SgIcon Icon="@(kpiItem.Trend >= 0 ? SgIcons.ArrowUp : SgIcons.ArrowDown)" Size="12px" />
                                    <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm">@Math.Abs(kpiItem.Trend)%</SgTypography>
                                </span>
                            </SgSpace>
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Style="margin-left:auto;">vs last mo.</SgTypography>
                        </div>
                    </SgCard>
                </SgCol>
            }
        </SgRow>
    </div>

    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Complex Content & States
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Cards with slot-based layouts — <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ActionContent</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">FooterContent</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">CoverContent</SgTypography>, and loading skeleton states.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg" Style="margin-top:16px;">
            <SgCol Xs="12" Md="6">
                <SgCard Title="Project Overview" Subtitle="Working with footer and actions" Shadow="SgShadow.Md" Status="SgCardStatus.Info" Hoverable="true" Animated="true">
                    <ActionContent>
                        <SgButton Variant="SgButtonVariant.Ghost" Size="SgSize.Sm">
                            <Icon><SgIcon Icon="@SgIcons.Settings" Size="16px" /></Icon>
                        </SgButton>
                    </ActionContent>
                    <ChildContent>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgTypography Size="SgTypographySize.Sm">
                                This example demonstrates using <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ActionContent</SgTypography> (right side in header)
                                and <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">FooterContent</SgTypography> for a complete widget layout.
                            </SgTypography>
                            <SgProgress Value="65" Status="SgStatus.Processing" Title="Development Progress" />
                        </SgStack>
                    </ChildContent>
                    <FooterContent>
                        <SgStack Horizontal Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center">
                            <SgAvatarGroup MaxCount="3">
                                <SgAvatar Initials="AD" Color="#1890ff" />
                                <SgAvatar Initials="BK" Color="#52c41a" />
                                <SgAvatar Initials="CL" Color="#f5222d" />
                                <SgAvatar Initials="DM" Color="#faad14" />
                            </SgAvatarGroup>
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                                <SgIcon Icon="@SgIcons.Clock" Size="12px" /> Updated 2h ago
                            </SgTypography>
                        </SgStack>
                    </FooterContent>
                </SgCard>
            </SgCol>

            <SgCol Xs="12" Md="6">
                <SgCard Title="Loading State" Subtitle="Automatic skeleton while loading" Loading="_loading" Radius="SgSize.Lg" Status="SgCardStatus.Muted" Animated="true">
                    <ActionContent>
                        <SgButton OnClick="ToggleLoading"
                                  Size="SgSize.Sm"
                                  Variant="SgButtonVariant.Outlined">
                            <ChildContent>
                                <SgSpace Size="small">
                                    <SgIcon Icon="@(_loading ? SgIcons.X : SgIcons.Refresh)" Size="14px" />
                                    <SgTypography Size="SgTypographySize.Sm">@(_loading ? "Stop" : "Reload")</SgTypography>
                                </SgSpace>
                            </ChildContent>
                        </SgButton>
                    </ActionContent>
                    <ChildContent>
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Sm">
                                This content is hidden behind a skeleton while <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Loading=true</SgTypography>.
                                The skeleton mimics the card's structure with animated placeholders.
                            </SgTypography>
                            <SgTag Color="processing">Interactive Demo</SgTag>
                        </SgStack>
                    </ChildContent>
                </SgCard>
            </SgCol>
        </SgRow>

        <SgRow Space="SgSize.Lg" Style="margin-top:24px;">
            <SgCol Xs="12" Md="6">
                <SgCard Title="Collapsible Card" Subtitle="Toggle to collapse body" Collapsible="true" Shadow="SgShadow.Sm" Hoverable="true" Animated="true">
                    <SgTypography Size="SgTypographySize.Sm">
                        Cards can be made collapsible with the <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Collapsible</SgTypography> flag.
                        Click the chevron in the header to expand/collapse the body content.
                        This is great for dashboards with optional detail sections.
                    </SgTypography>
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Md="6">
                <SgCard Title="Selectable Card" Subtitle="Toggle selection state" Selectable="true" Shadow="SgShadow.Sm" Hoverable="true" Animated="true" Status="SgCardStatus.Success">
                    <SgTypography Size="SgTypographySize.Sm">
                        Click this card to toggle its selected state. The <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Selectable</SgTypography> parameter
                        enables row-selection UX with keyboard support (Enter/Space) and aria attributes.
                    </SgTypography>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live Card Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure SgCard parameters in real time and copy the generated code. Every toggle updates the preview instantly.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Variant</SgTypography>
                            <SgSegmented TValue="SgCardVariant"
                                         Value="@_cardVariant"
                                         ValueChanged="v => { _cardVariant = v; UpdateCardCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_variantOptions" />
                        </SgStack>

                        <SgRow Space="SgSize.Md">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgSegmented TValue="SgSize"
                                                 Value="@_cardSize"
                                                 ValueChanged="v => { _cardSize = v; UpdateCardCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_sizeOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Shadow</SgTypography>
                                    <SgSegmented TValue="SgShadow"
                                                 Value="@_cardShadow"
                                                 ValueChanged="v => { _cardShadow = v; UpdateCardCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_shadowOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgRow Space="SgSize.Md">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Status</SgTypography>
                                    <SgSelect TValue="SgCardStatus"
                                              @bind-Value="_cardStatus"
                                              Items="_statusItems"
                                              LabelSelector="x => x.ToString()"
                                              Block="true" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Radius</SgTypography>
                                    <SgSegmented TValue="SgSize"
                                                 Value="@_cardRadius"
                                                 ValueChanged="v => { _cardRadius = v; UpdateCardCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_radiusOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Hoverable</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_cardHoverable"
                                                 ValueChanged="v => { _cardHoverable = v; UpdateCardCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Clickable</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_cardClickable"
                                                 ValueChanged="v => { _cardClickable = v; UpdateCardCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Compact</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_cardCompact"
                                                 ValueChanged="v => { _cardCompact = v; UpdateCardCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolOptionsRev" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Glow</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_cardGlow"
                                                 ValueChanged="v => { _cardGlow = v; UpdateCardCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Variant</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_cardVariant.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_cardSize.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Shadow</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_cardShadow.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Status</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_cardStatus.ToString()" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>
                    </SgStack>
                </SgCol>

                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <SgCard Title="Constructed Card"
                                    Subtitle="Live preview of your configuration"
                                    Variant="@_cardVariant"
                                    Size="@_cardSize"
                                    Shadow="@_cardShadow"
                                    Radius="@_cardRadius"
                                    Status="@_cardStatus"
                                    Hoverable="@_cardHoverable"
                                    Clickable="@_cardClickable"
                                    Compact="@_cardCompact"
                                    Glow="@_cardGlow"
                                    Animated="true">
                                <SgTypography Size="SgTypographySize.Sm">
                                    This card updates instantly as you change parameters on the left.
                                    Toggle between variants, sizes, shadows, and effects.
                                </SgTypography>
                            </SgCard>
                        </SgStack>

                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCardCode">
                                    <span>@_cardCopyIcon</span>
                                    <span style="font-size:11px;font-weight:600;">@_cardCopyLabel</span>
                                </button>
                            </div>
                            <div class="code-block">
                                @foreach (var line in _cardGeneratedCode)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>
                    </SgStack>
                </SgCol>
            </SgRow>
        </SgCard>
    </div>

    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Splitter Layouts
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgSplitter</SgTypography> with resizable panels, collapse buttons, keyboard support, and in-memory position persistence. Drag the divider or use arrow keys.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg" Style="margin-top:16px;">
            <SgCol Xs="12" Lg="6">
                <SgCard Title="Horizontal Splitter" Subtitle="Two-pane with collapsible panels" Shadow="SgShadow.Sm" Radius="SgSize.Md" NoPadding="true" OverflowHidden="true" FullHeight="true">
                    <div style="height:280px;">
                        <SgSplitter ShowHandle="true" Collapsible="true" Size="180" Min="80">
                            <First>
                                <div class="splitter-demo-pane" style="background:linear-gradient(135deg, rgba(99,102,241,0.08), rgba(139,92,246,0.08));">
                                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.Center" Style="height:100%;padding:20px;">
                                        <SgIcon Icon="@SgIcons.FileText" Size="24px" Color="var(--sg-color-info)" />
                                        <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm">Left Panel</SgTypography>
