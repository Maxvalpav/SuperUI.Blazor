@page "/qrcode-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgQrCode — QR Code Generator — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Interactive Generator                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="sgc-demo-section">
        <div class="sgc-demo-section-header">
            <div class="sgc-demo-section-header-content">
                <div class="sgc-demo-section-title-row">
                    <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                        Interactive Generator
                    </SgTypography>
                    <span class="demo-live-badge">LIVE</span>
                </div>
                <div class="sgc-demo-section-subtitle">
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Type any text or URL to generate a QR code instantly. Compare Medium and High error correction side by side.
                    </SgTypography>
                </div>
            </div>
        </div>
        <div class="sgc-demo-section-body">
            <div class="sgc-demo-controls">
                <div class="sgc-demo-control-group" style="flex:1;min-width:200px;">
                    <span class="sgc-demo-control-label">Text / URL</span>
                    <SgTextBox @bind-Value="_text" Placeholder="Enter text or URL to encode" Block />
                </div>
                <div class="sgc-demo-control-group" style="min-width:120px;">
                    <span class="sgc-demo-control-label">Size</span>
                    <SgSelect TValue="int" @bind-Value="_size" Items="_sizeItems" LabelSelector="@(x => $"{x}px")" Block />
                </div>
                <div class="sgc-demo-control-group" style="min-width:140px;">
                    <span class="sgc-demo-control-label">Error Correction</span>
                    <SgSelect TValue="SgQrCodeEcc" @bind-Value="_ecc" Items="_eccItems" LabelSelector="@(x => x.ToString())" Block />
                </div>
                <div class="sgc-demo-control-group" style="justify-content:flex-end;">
                    <SgSwitch @bind-Value="_generatorDownloadable" Label="Downloadable" />
                </div>
            </div>

            <SgRow Space="SgSize.Lg" Justify="SgJustifyContent.Center" Align="SgAlignItems.Center">
                <SgCol Xs="12" Md="6">
                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                            Medium ECC (~15% recovery)
                        </SgTypography>
                        <SgQrCode Value="@_text" Size="@_size" ErrorCorrection="SgQrCodeEcc.Medium" Downloadable="@_generatorDownloadable" />
                    </SgStack>
                </SgCol>
                <SgCol Xs="12" Md="6">
                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                            High ECC (~30% recovery)
                        </SgTypography>
                        <SgQrCode Value="@_text" Size="@_size" ErrorCorrection="SgQrCodeEcc.High" Downloadable="@_generatorDownloadable" />
                    </SgStack>
                </SgCol>
            </SgRow>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Color & Styling                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="sgc-demo-section">
        <div class="sgc-demo-section-header">
            <div class="sgc-demo-section-header-content">
                <div class="sgc-demo-section-title-row">
                    <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                        Color &amp; Styling
                    </SgTypography>
                </div>
                <div class="sgc-demo-section-subtitle">
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Customize fill and background colors. Try preset swatches or pick your own.
                    </SgTypography>
                </div>
            </div>
        </div>
        <div class="sgc-demo-section-body">
            <SgRow Space="SgSize.Lg">
                <SgCol Xs="12" Md="6">
                    <SgStack Vertical Space="SgSize.Lg">
                        <SgRow Space="SgSize.Md">
                            <SgCol Xs="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <span class="sgc-demo-control-label">Fill Color</span>
                                    <SgColorPicker @bind-Value="_fillColor" Block />
                                </SgStack>
                            </SgCol>
                            <SgCol Xs="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <span class="sgc-demo-control-label">Background Color</span>
                                    <SgColorPicker @bind-Value="_bgColor" Block />
                                </SgStack>
                            </SgCol>
                        </SgRow>
                        <SgRow Space="SgSize.Sm">
                            @foreach (var swatch in _colorSwatches)
                            {
                                var sw = swatch;
                                <SgCol>
                                    <button type="button" class="sgc-demo-color-swatch"
                                            style="--swatch-fill:@sw.Fill;--swatch-bg:@sw.Background;"
                                            @onclick="() => SelectColorSwatch(sw)"
                                            title="@sw.Name"
                                            aria-label="@sw.Name">
                                        <span class="sgc-demo-color-swatch-dot" style="background:@sw.Fill;"></span>
                                    </button>
                                </SgCol>
                            }
                        </SgRow>
                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                            <SgBadge Text="@($"Fill: {_fillColor}")" Variant="SgBadgeVariant.Info" Size="SgSize.Sm" Standalone />
                            <SgBadge Text="@($"Bg: {_bgColor}")" Variant="SgBadgeVariant.Default" Size="SgSize.Sm" Standalone />
                        </SgStack>
                    </SgStack>
                </SgCol>
                <SgCol Xs="12" Md="6">
                    <SgStack Vertical Space="SgSize.Lg" Align="SgAlignItems.Center">
                        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                            <span class="sgc-demo-control-label">Gradient</span>
                            <SgSwitch @bind-Value="_fillGradient" />
                        </SgStack>
                        @if (_fillGradient)
                        {
                            <SgRow Space="SgSize.Md" Style="width:100%;max-width:320px;">
                                <SgCol Xs="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <span class="sgc-demo-control-label">Gradient Start</span>
                                        <SgColorPicker @bind-Value="_fillGradientStart" Block />
                                    </SgStack>
                                </SgCol>
                                <SgCol Xs="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <span class="sgc-demo-control-label">Gradient End</span>
                                        <SgColorPicker @bind-Value="_fillGradientEnd" Block />
                                    </SgStack>
                                </SgCol>
                            </SgRow>
                        }
                        <SgQrCode Value="@_text" Size="180"
                                   FillColor="@_fillColor" BackgroundColor="@_bgColor"
                                   FillGradient="@_fillGradient"
                                   FillGradientStart="@_fillGradientStart"
                                   FillGradientEnd="@_fillGradientEnd" />
                    </SgStack>
                </SgCol>
            </SgRow>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Visual Styles                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="sgc-demo-section">
        <div class="sgc-demo-section-header">
            <div class="sgc-demo-section-header-content">
                <div class="sgc-demo-section-title-row">
                    <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                        Visual Styles
                    </SgTypography>
                </div>
                <div class="sgc-demo-section-subtitle">
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Eye patterns, module shapes, gradients, and logo overlays.
                    </SgTypography>
                </div>
            </div>
        </div>
        <div class="sgc-demo-section-body">
            <SgRow Space="SgSize.Lg">
                <SgCol Xs="12" Md="6">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                            Eye Style
                        </SgTypography>
                        <SgRow Space="SgSize.Md" Justify="SgJustifyContent.SpaceAround" Align="SgAlignItems.Center">
                            @foreach (var eye in Enum.GetValues<SgQrCodeEyeStyle>())
                            {
                                var e = eye;
                                <SgCol>
                                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">@e.ToString()</SgTypography>
                                        <SgQrCode Value="@_text" Size="110" FillColor="#0d9488" EyeStyle="@e" />
                                    </SgStack>
                                </SgCol>
                            }
                        </SgRow>
                    </SgStack>
                </SgCol>
                <SgCol Xs="12" Md="6">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                            Module Shape
                        </SgTypography>
                        <SgRow Space="SgSize.Md" Justify="SgJustifyContent.SpaceAround" Align="SgAlignItems.Center">
                            @foreach (var mod in Enum.GetValues<SgQrCodeModuleStyle>())
                            {
                                var m = mod;
                                <SgCol>
                                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">@m.ToString()</SgTypography>
                                        <SgQrCode Value="@_text" Size="110" FillColor="#7c3aed" ModuleStyle="@m" />
                                    </SgStack>
                                </SgCol>
                            }
                        </SgRow>
                    </SgStack>
                </SgCol>
            </SgRow>
            <div style="height:24px"></div>
            <SgRow Space="SgSize.Lg">
                <SgCol Xs="12" Md="6">
                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                            Gradient Fill
                        </SgTypography>
                        <SgQrCode Value="@_text" Size="140"
                                   FillGradient="true"
                                   FillGradientStart="#0d9488"
                                   FillGradientEnd="#7c3aed" />
                    </SgStack>
                </SgCol>
                <SgCol Xs="12" Md="6">
                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                            Logo Overlay
                        </SgTypography>
                        <SgQrCode Value="https://github.com/SuperUI/SuperUI" Size="140"
                                   Logo="<svg viewBox='0 0 24 24' width='24' height='24' fill='none' stroke='%230d9488' stroke-width='2'><path d='M12 2L2 7l10 5 10-5-10-5z'/><path d='M2 17l10 5 10-5'/><path d='M2 12l10 5 10-5'/></svg>"
                                   LogoSize="36" />
                    </SgStack>
                </SgCol>
            </SgRow>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Live Constructor                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="sgc-demo-section">
        <div class="sgc-demo-section-header">
            <div class="sgc-demo-section-header-content">
                <div class="sgc-demo-section-title-row">
                    <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                        Live SgQrCode Constructor
                    </SgTypography>
                    <span class="demo-live-badge">INTERACTIVE</span>
                </div>
                <div class="sgc-demo-section-subtitle">
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Tweak every parameter and see the result in real time. Copy the generated Blazor code.
                    </SgTypography>
                </div>
            </div>
        </div>
        <div class="sgc-demo-section-body" style="padding:0;">
            <SgRow Space="SgSize.Sm">
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">
                        <div>
                            <span class="sgc-demo-control-label">Text / URL</span>
                            <SgTextBox Value="@_ctorText" ValueChanged="@((string v) => { _ctorText = v; UpdateConstructorCode(); })" Placeholder="Enter text or URL" Block />
                        </div>

                        <div>
                            <span class="sgc-demo-control-label">Size: @((int)_ctorSize) px</span>
                            <SgSlider TValue="double" Value="@_ctorSize" Min="80" Max="400" Step="10" ShowTooltip="true" FormatValue="@((double v) => $"{v:F0}px")" ValueChanged="@((double v) => { _ctorSize = v; UpdateConstructorCode(); })" />
                        </div>

                        <div>
                            <span class="sgc-demo-control-label">Error Correction</span>
                            <SgSegmented TValue="SgQrCodeEcc" Options="_eccSegOptions"
                                         Value="@_ctorEcc"
                                         ValueChanged="@((SgQrCodeEcc v) => { _ctorEcc = v; UpdateConstructorCode(); })"
                                         Block SizeEnum="SgSize.Sm" />
                        </div>

                        <div>
                            <span class="sgc-demo-control-label">Border</span>
                            <SgSegmented TValue="int" Options="_borderSegOptions"
                                         Value="@_ctorBorder"
                                         ValueChanged="@((int v) => { _ctorBorder = v; UpdateConstructorCode(); })"
                                         Block SizeEnum="SgSize.Sm" />
                        </div>

                        <SgRow Space="SgSize.Md">
                            <SgCol Xs="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <span class="sgc-demo-control-label">Fill Color</span>
                                    <SgColorPicker Value="@_ctorFillColor" ValueChanged="@((string v) => { _ctorFillColor = v; UpdateConstructorCode(); })" Block />
                                </SgStack>
                            </SgCol>
                            <SgCol Xs="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <span class="sgc-demo-control-label">Background</span>
                                    <SgColorPicker Value="@_ctorBgColor" ValueChanged="@((string v) => { _ctorBgColor = v; UpdateConstructorCode(); })" Block />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <div>
                            <span class="sgc-demo-control-label">Eye Style</span>
                            <SgSegmented TValue="SgQrCodeEyeStyle" Options="_eyeStyleSegOptions"
                                         Value="@_ctorEyeStyle"
                                         ValueChanged="@((SgQrCodeEyeStyle v) => { _ctorEyeStyle = v; UpdateConstructorCode(); })"
                                         Block SizeEnum="SgSize.Sm" />
                        </div>

                        <div>
                            <span class="sgc-demo-control-label">Module Style</span>
                            <SgSegmented TValue="SgQrCodeModuleStyle" Options="_moduleStyleSegOptions"
                                         Value="@_ctorModuleStyle"
                                         ValueChanged="@((SgQrCodeModuleStyle v) => { _ctorModuleStyle = v; UpdateConstructorCode(); })"
                                         Block SizeEnum="SgSize.Sm" />
                        </div>

                        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                            <span class="sgc-demo-control-label">Gradient</span>
                            <SgSwitch Value="@_ctorFillGradient" ValueChanged="@((bool v) => { _ctorFillGradient = v; UpdateConstructorCode(); })" />
                        </SgStack>

                        @if (_ctorFillGradient)
                        {
                            <SgRow Space="SgSize.Md">
                                <SgCol Xs="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <span class="sgc-demo-control-label">Start</span>
                                        <SgColorPicker Value="@_ctorFillGradientStart" ValueChanged="@((string v) => { _ctorFillGradientStart = v; UpdateConstructorCode(); })" Block />
                                    </SgStack>
                                </SgCol>
                                <SgCol Xs="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <span class="sgc-demo-control-label">End</span>
                                        <SgColorPicker Value="@_ctorFillGradientEnd" ValueChanged="@((string v) => { _ctorFillGradientEnd = v; UpdateConstructorCode(); })" Block />
                                    </SgStack>
                                </SgCol>
                            </SgRow>
                        }

                        <div>
                            <span class="sgc-demo-control-label">Logo SVG (optional)</span>
                            <SgTextBox Value="@_ctorLogo" ValueChanged="@((string v) => { _ctorLogo = v; UpdateConstructorCode(); })" Placeholder="<svg ...>" Block />
                        </div>

                        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                            <span class="sgc-demo-control-label">Show Label</span>
                            <SgSwitch Value="@_ctorShowLabel" ValueChanged="@((bool v) => { _ctorShowLabel = v; UpdateConstructorCode(); })" />
                            @if (_ctorShowLabel)
                            {
                                <SgTextBox Value="@_ctorLabelText" ValueChanged="@((string v) => { _ctorLabelText = v; UpdateConstructorCode(); })" Placeholder="Label text" Style="flex:1;" />
                            }
                        </SgStack>

                        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                            <SgSwitch Value="@_ctorResponsive" ValueChanged="@((bool v) => { _ctorResponsive = v; UpdateConstructorCode(); })" Label="Responsive" />
                        </SgStack>

                        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                            <SgSwitch Value="@_ctorDownloadable" ValueChanged="@((bool v) => { _ctorDownloadable = v; UpdateConstructorCode(); })" Label="Downloadable" />
                        </SgStack>

                        <div class="sgc-demo-controls" style="margin-bottom:0;">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="width:100%;">
                                Summary
                            </SgTypography>
                            <SgStack Vertical Space="SgSize.Sm" Style="width:100%;">
                                <SgStack Horizontal Space="SgSize.Sm" Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgBadge Text="@($"{(int)_ctorSize}px")" Variant="SgBadgeVariant.Info" Size="SgSize.Sm" Standalone />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">ECC</SgTypography>
                                    <SgBadge Text="@_ctorEcc.ToString()" Variant="SgBadgeVariant.Success" Size="SgSize.Sm" Standalone />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Border</SgTypography>
                                    <SgBadge Text="@_ctorBorder.ToString()" Variant="SgBadgeVariant.Default" Size="SgSize.Sm" Standalone />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Fill</SgTypography>
                                    <SgBadge Text="@_ctorFillColor" Variant="SgBadgeVariant.Default" Size="SgSize.Sm" Standalone />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Background</SgTypography>
                                    <SgBadge Text="@_ctorBgColor" Variant="SgBadgeVariant.Default" Size="SgSize.Sm" Standalone />
                                </SgStack>
                            </SgStack>
                        </div>
                    </SgStack>
                </SgCol>
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">
                        <SgStack Horizontal Space="SgSize.Md" Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                Result
                            </SgTypography>
                        </SgStack>
                        <div class="sgc-demo-controls" style="display:flex;align-items:center;justify-content:center;min-height:240px;margin-bottom:0;">
                            <SgQrCode Value="@_ctorText"
                                       Size="@((int)_ctorSize)"
                                       ErrorCorrection="@_ctorEcc"
                                       Border="@_ctorBorder"
                                       FillColor="@_ctorFillColor"
                                       BackgroundColor="@_ctorBgColor"
                                       EyeStyle="@_ctorEyeStyle"
                                       ModuleStyle="@_ctorModuleStyle"
                                       FillGradient="@_ctorFillGradient"
                                       FillGradientStart="@_ctorFillGradientStart"
                                       FillGradientEnd="@_ctorFillGradientEnd"
                                       Logo="@(string.IsNullOrEmpty(_ctorLogo) ? null : _ctorLogo)"
                                       ShowLabel="@_ctorShowLabel"
                                       LabelText="@_ctorLabelText"
                                       Responsive="@_ctorResponsive"
                                       Downloadable="@_ctorDownloadable" />
                        </div>

                        <div class="sgc-demo-code-card">
                            <SgCard NoPadding Shadow="SgShadow.Sm" Size="SgSize.Sm">
                                <ChildContent>
                                    <div class="sgc-demo-code-header">
                                        <div class="sgc-demo-code-header-left">
                                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                                Generated Code
                                            </SgTypography>
                                        </div>
                                        <div class="sgc-demo-code-header-right">
                                            <span class="sgc-demo-code-copy-status @(_copyLabel == "Copied!" ? "sgc-demo-code-copied" : "")">
                                                <SgTypography Size="SgTypographySize.Xs" Color="@(_copyLabel == "Copied!" ? "var(--sg-color-success)" : "var(--sg-text-muted)")">
                                                    @_copyLabel
                                                </SgTypography>
                                            </span>
                                            <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" @onclick="CopyCodeToClipboard" Icon="@(new RenderFragment(b => b.AddContent(0, (MarkupString)SgHeroicons.Outline.ClipboardDocument)))" />
                                        </div>
                                    </div>
                                    <pre class="sgc-demo-code-pre"><code class="sgc-demo-code-content">@_generatedCode</code></pre>
                                </ChildContent>
                            </SgCard>
                        </div>
                    </SgStack>
                </SgCol>
            </SgRow>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. API Reference                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="sgc-demo-section">
        <div class="sgc-demo-section-header">
            <div class="sgc-demo-section-header-content">
                <div class="sgc-demo-section-title-row">
                    <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                        SgQrCode Properties
                    </SgTypography>
                </div>
                <div class="sgc-demo-section-subtitle">
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        All configurable parameters on the SgQrCode component.
                    </SgTypography>
