    private static void AddSectionLabel(RenderTreeBuilder builder, ref int seq, string text)
    {
        builder.OpenComponent<SgTypography>(seq++);
        builder.AddAttribute(seq++, "Size", "SgTypographySize.Xs");
        builder.AddAttribute(seq++, "Weight", "SgTypographyWeight.Bold");
        builder.AddAttribute(seq++, "Transform", "SgTypographyTransform.Uppercase");
        builder.AddAttribute(seq++, "Tracking", "SgTypographyTracking.Wide");
        builder.AddAttribute(seq++, "Color", "var(--sg-text-muted)");
        builder.AddAttribute(seq++, "ChildContent", (RenderFragment)(b => b.AddContent(0, text)));
        builder.CloseComponent();
    }

    private static void AddControlLabel(RenderTreeBuilder builder, ref int seq, string text)
    {
        builder.OpenComponent<SgStack>(seq++);
        builder.AddAttribute(seq++, "Vertical", true);
        builder.AddAttribute(seq++, "Space", "SgSize.Sm");
        builder.AddAttribute(seq++, "ChildContent", (RenderFragment)(b2 =>
        {
            var s = 0;
            b2.OpenComponent<SgTypography>(s++);
            b2.AddAttribute(s++, "Size", "SgTypographySize.Xs");
            b2.AddAttribute(s++, "Weight", "SgTypographyWeight.Bold");
            b2.AddAttribute(s++, "Transform", "SgTypographyTransform.Uppercase");
            b2.AddAttribute(s++, "Tracking", "SgTypographyTracking.Wide");
            b2.AddAttribute(s++, "Color", "var(--sg-text-muted)");
            b2.AddAttribute(s++, "ChildContent", (RenderFragment)(b3 => b3.AddContent(0, text)));
            b2.CloseComponent();
        }));
        builder.CloseComponent();
    }

    private void AddQrSizePreview(RenderTreeBuilder builder, ref int seq, string label, int size, int border)
    {
        builder.OpenComponent<SgCol>(seq++);
        builder.AddAttribute(seq++, "ChildContent", (RenderFragment)(b =>
        {
            var s = 0;
            b.OpenComponent<SgStack>(s++); b.AddAttribute(s++, "Vertical", true); b.AddAttribute(s++, "Space", "SgSize.Sm"); b.AddAttribute(s++, "Align", "SgAlignItems.Center");
            b.AddAttribute(s++, "ChildContent", (RenderFragment)(b2 =>
            {
                var s2 = 0;
                b2.OpenComponent<SgTypography>(s2++); b2.AddAttribute(s2++, "Size", "SgTypographySize.Xs"); b2.AddAttribute(s2++, "Weight", "SgTypographyWeight.Bold"); b2.AddAttribute(s2++, "Color", "var(--sg-text-muted)"); b2.AddAttribute(s2++, "ChildContent", (RenderFragment)(b3 => b3.AddContent(0, label))); b2.CloseComponent();
                b2.OpenComponent<SgQrCode>(s2++); b2.AddAttribute(s2++, "Value", _text); b2.AddAttribute(s2++, "Size", size); b2.AddAttribute(s2++, "Border", border); b2.CloseComponent();
            }));
            b.CloseComponent();
        }));
        builder.CloseComponent();
    }

    private static void AddSummaryRow(RenderTreeBuilder builder, ref int seq, string label, string valueText, string badgeVariant)
    {
        builder.OpenComponent<SgStack>(seq++);
        builder.AddAttribute(seq++, "Horizontal", true);
        builder.AddAttribute(seq++, "Space", "SgSize.Sm");
        builder.AddAttribute(seq++, "Align", "SgAlignItems.Center");
        builder.AddAttribute(seq++, "Justify", "SgJustifyContent.SpaceBetween");
        builder.AddAttribute(seq++, "ChildContent", (RenderFragment)(b =>
        {
            var s = 0;
            b.OpenComponent<SgTypography>(s++); b.AddAttribute(s++, "Size", "SgTypographySize.Sm"); b.AddAttribute(s++, "Color", "var(--sg-text-muted)"); b.AddAttribute(s++, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, label))); b.CloseComponent();
            b.OpenComponent<SgBadge>(s++); b.AddAttribute(s++, "Variant", SgBadgeVariant.Default); b.AddAttribute(s++, "Text", valueText); b.AddAttribute(s++, "Standalone", true); b.CloseComponent();
        }));
        builder.CloseComponent();
    }

