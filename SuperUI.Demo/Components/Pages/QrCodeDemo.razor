@page "/qrcode-demo"
@using SuperUI.Components

<PageTitle>QR Code - SUI</PageTitle>

<SgCard Title="SgQrCode - QR Code Generator"
        Subtitle="Generate QR codes from text or URLs. Pure C# implementation, no JavaScript required.">

    <div style="margin-top: 32px;">
        <h2>Basic Usage</h2>
        <p>Type text to generate a QR code instantly.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgTextBox @bind-Value="_text" Placeholder="Enter text or URL" Block="true" />
                    <div style="display: flex; gap: 24px; flex-wrap: wrap; align-items: flex-start;">
                        <div>
                            <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Medium ECC</div>
                            <SgQrCode Value="@_text" Size="160" />
                        </div>
                        <div>
                            <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">High ECC</div>
                            <SgQrCode Value="@_text" Size="160" ErrorCorrection="high" />
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_basicProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Custom Colors</h2>
        <p>Adjust fill and background colors to match your theme.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; gap: 24px; flex-wrap: wrap;">
                    <SgQrCode Value="@_text" Size="140" FillColor="#0d9488" BackgroundColor="#f0fdfa" />
                    <SgQrCode Value="@_text" Size="140" FillColor="#be123c" BackgroundColor="#fff1f2" />
                    <SgQrCode Value="@_text" Size="140" FillColor="#1d4ed8" BackgroundColor="#eff6ff" />
                </div>
            </SgCard>

            <SgCard Title="Style Properties">
                <PropertyTable Items="_styleProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>URL Example</h2>
        <p>Generate a scannable link to your project.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <SgQrCode Value="https://github.com/SuperUI/SuperUI" Size="200" />
            </SgCard>

            <SgCard Title="Error Correction">
                <PropertyTable Items="_eccProperties" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private string _text = "Hello from SuperUI!";

    private List<PropertyPanelItem> _basicProperties = new()
    {
        new() { Label = "Value", Value = "string", BadgeText = "Text to encode" },
        new() { Label = "Size", Value = "int (default: 200)", BadgeText = "Display size in px" },
        new() { Label = "Border", Value = "int (default: 2)", BadgeText = "Module border" },
        new() { Label = "ErrorCorrection", Value = "string", BadgeText = "low | medium | quartile | high" }
    };

    private List<PropertyPanelItem> _styleProperties = new()
    {
        new() { Label = "FillColor", Value = "string (default: #000000)", BadgeText = "QR module color" },
        new() { Label = "BackgroundColor", Value = "string (default: #ffffff)", BadgeText = "Background color" },
        new() { Label = "CssClass", Value = "string?", BadgeText = "Custom CSS" }
    };

    private List<PropertyPanelItem> _eccProperties = new()
    {
        new() { Label = "low", Value = "~7%", BadgeText = "Low recovery" },
        new() { Label = "medium", Value = "~15%", BadgeText = "Default" },
        new() { Label = "quartile", Value = "~25%", BadgeText = "High recovery" },
        new() { Label = "high", Value = "~30%", BadgeText = "Maximum recovery" }
    };
}
