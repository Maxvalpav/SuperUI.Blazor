@page "/qrcode-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgQrCode — QR Code Generator — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Interactive Generator                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="sgc-demo-section">
        <div class="sgc-demo-section-header">
            <div class="sgc-demo-section-header-content">
                <div class="sgc-demo-section-title-row">
                    <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Interactive Generator</SgTypography>
                    <span class="demo-live-badge">LIVE</span>
                </div>
                <div class="sgc-demo-section-subtitle">
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Type any text or URL. Compare error correction levels, see stats, and copy with one click.
                    </SgTypography>
                </div>
            </div>
        </div>
        <div class="sgc-demo-section-body">
            <div class="sgc-demo-controls">
                <div class="sgc-demo-control-group" style="flex:1;min-width:200px;">
                    <span class="sgc-demo-control-label">Text / URL</span>
                    <SgTextBox @bind-Value="_text" Placeholder="Enter text or URL to encode..." Block />
                </div>
                <div class="sgc-demo-control-group" style="min-width:100px;">
                    <span class="sgc-demo-control-label">Size</span>
                    <SgSelect TValue="int" @bind-Value="_size" Items="_sizeItems" LabelSelector="@(x => $"{x}px")" Block />
                </div>
                <div class="sgc-demo-control-group" style="min-width:140px;">
                    <span class="sgc-demo-control-label">Error Correction</span>
                    <SgSelect TValue="SgQrCodeEcc" @bind-Value="_ecc" Items="_eccItems" LabelSelector="@(x => FormatEcc(x))" Block />
                </div>
                <div class="sgc-demo-control-group" style="justify-content:flex-end;">
                    <SgSwitch @bind-Value="_generatorDownloadable" Label="Download" />
                </div>
            </div>

            <SgRow Space="SgSize.Lg" Align="SgAlignItems.Stretch">
                <SgCol Xs="12" Lg="8">
                    <SgRow Space="SgSize.Lg" Justify="SgJustifyContent.Center" Align="SgAlignItems.Start">
                        @foreach (var ecc in Enum.GetValues<SgQrCodeEcc>())
                        {
                            var e = ecc;
                            <SgCol Xs="6" Lg="3">
                                <SgCard Size="SgSize.Sm" Shadow="SgShadow.Sm" NoPadding>
                                    <ChildContent>
                                        <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center" Style="padding:16px;">
                                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                                @FormatEcc(e)
                                            </SgTypography>
                                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">@GetEccRecovery(e)</SgTypography>
                                            <SgQrCode Value="@_text" Size="@_size" ErrorCorrection="@e" Animated="true" ShowCopyButton="true" Downloadable="@_generatorDownloadable" />
                                        </SgStack>
                                    </ChildContent>
                                </SgCard>
                            </SgCol>
                        }
                    </SgRow>
                </SgCol>
                <SgCol Xs="12" Lg="4">
                    <SgCard Size="SgSize.Sm" Shadow="SgShadow.Sm" Style="height:100%;">
                        <ChildContent>
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                    QR Code Stats
                                </SgTypography>
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgStack Horizontal Space="SgSize.Sm" Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center" Style="padding:6px 0;border-bottom:1px solid var(--sg-border);">
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Input length</SgTypography>
                                        <SgBadge Text="@(_text.Length.ToString())" Variant="SgBadgeVariant.Info" Size="SgSize.Sm" Standalone />
                                    </SgStack>
                                    <SgStack Horizontal Space="SgSize.Sm" Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center" Style="padding:6px 0;border-bottom:1px solid var(--sg-border);">
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Selected ECC</SgTypography>
                                        <SgBadge Text="@FormatEcc(_ecc)" Variant="SgBadgeVariant.Success" Size="SgSize.Sm" Standalone />
                                    </SgStack>
                                    <SgStack Horizontal Space="SgSize.Sm" Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center" Style="padding:6px 0;border-bottom:1px solid var(--sg-border);">
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Display size</SgTypography>
                                        <SgBadge Text=$"{_size}px" Variant="SgBadgeVariant.Default" Size="SgSize.Sm" Standalone />
                                    </SgStack>
                                    <SgStack Horizontal Space="SgSize.Sm" Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center" Style="padding:6px 0;">
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Value type</SgTypography>
                                        <SgBadge Text="@GetInputType()" Variant="SgBadgeVariant.Default" Size="SgSize.Sm" Standalone />
                                    </SgStack>
                                </SgStack>
                            </SgStack>
                        </ChildContent>
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Color & Styling                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="sgc-demo-section">
        <div class="sgc-demo-section-header">
            <div class="sgc-demo-section-header-content">
                <div class="sgc-demo-section-title-row">
                    <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Color &amp; Styling</SgTypography>
                </div>
                <div class="sgc-demo-section-subtitle">
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Customize fill and background. Try presets, gradients, or pick your own colors.
                    </SgTypography>
                </div>
            </div>
        </div>
        <div class="sgc-demo-section-body">
            <SgRow Space="SgSize.Lg" Align="SgAlignItems.Start">
                <SgCol Xs="12" Md="5">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgRow Space="SgSize.Md">
                            <SgCol Xs="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <span class="sgc-demo-control-label">Fill Color</span>
                                    <SgColorPicker @bind-Value="_fillColor" Block />
                                </SgStack>
                            </SgCol>
                            <SgCol Xs="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <span class="sgc-demo-control-label">Background</span>
                                    <SgColorPicker @bind-Value="_bgColor" Block />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgRow Space="SgSize.Sm">
                            @foreach (var swatch in _colorSwatches)
                            {
                                var sw = swatch;
                                <SgCol>
                                    <button type="button" class="sgc-demo-color-swatch"
                                            style="--swatch-fill:@sw.Fill;--swatch-bg:@sw.Background;"
                                            @onclick="() => SelectColorSwatch(sw)"
                                            title="@sw.Name"
                                            aria-label="@sw.Name">
                                        <span class="sgc-demo-color-swatch-dot" style="background:@sw.Fill;"></span>
                                    </button>
                                </SgCol>
                            }
                        </SgRow>

                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                            <SgBadge Text="@($"Fill: {_fillColor}")" Variant="SgBadgeVariant.Info" Size="SgSize.Sm" Standalone />
                            <SgBadge Text="@($"Bg: {_bgColor}")" Variant="SgBadgeVariant.Default" Size="SgSize.Sm" Standalone />
                        </SgStack>

                        <div style="border-top:1px solid var(--sg-border);padding-top:12px;">
                            <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                                <SgSwitch @bind-Value="_fillGradient" Label="Gradient" />
                            </SgStack>
                            @if (_fillGradient)
                            {
                                <SgRow Space="SgSize.Md" Style="margin-top:8px;">
                                    <SgCol Xs="6">
                                        <SgStack Vertical Space="SgSize.Sm">
                                            <span class="sgc-demo-control-label">Start</span>
                                            <SgColorPicker @bind-Value="_fillGradientStart" Block />
                                        </SgStack>
                                    </SgCol>
                                    <SgCol Xs="6">
                                        <SgStack Vertical Space="SgSize.Sm">
                                            <span class="sgc-demo-control-label">End</span>
                                            <SgColorPicker @bind-Value="_fillGradientEnd" Block />
                                        </SgStack>
                                    </SgCol>
                                </SgRow>
                            }
                        </div>
                    </SgStack>
                </SgCol>
                <SgCol Xs="12" Md="7">
                    <div style="display:flex;align-items:center;justify-content:center;min-height:200px;">
                        <SgQrCode Value="@_text" Size="200"
                                   FillColor="@_fillColor" BackgroundColor="@_bgColor"
                                   FillGradient="@_fillGradient"
                                   FillGradientStart="@_fillGradientStart"
                                   FillGradientEnd="@_fillGradientEnd"
                                   Animated="true" ShowCopyButton="true" />
                    </div>
                </SgCol>
            </SgRow>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Visual Styles                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="sgc-demo-section">
        <div class="sgc-demo-section-header">
            <div class="sgc-demo-section-header-content">
                <div class="sgc-demo-section-title-row">
                    <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Visual Styles</SgTypography>
                </div>
                <div class="sgc-demo-section-subtitle">
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Eye patterns, module shapes, gradients, and logo overlays.
                    </SgTypography>
                </div>
            </div>
        </div>
        <div class="sgc-demo-section-body">
            <SgRow Space="SgSize.Lg">
                <SgCol Xs="12" Lg="6">
                    <SgCard Title="Eye Style" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <SgRow Space="SgSize.Md" Justify="SgJustifyContent.SpaceAround" Align="SgAlignItems.Center">
                            @foreach (var eye in Enum.GetValues<SgQrCodeEyeStyle>())
                            {
                                var e = eye;
                                <SgCol>
                                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">@e.ToString()</SgTypography>
                                        <SgQrCode Value="@_text" Size="100" FillColor="#0d9488" EyeStyle="@e" ShowCopyButton="true" />
                                    </SgStack>
                                </SgCol>
                            }
                        </SgRow>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Lg="6">
                    <SgCard Title="Module Shape" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <SgRow Space="SgSize.Md" Justify="SgJustifyContent.SpaceAround" Align="SgAlignItems.Center">
                            @foreach (var mod in Enum.GetValues<SgQrCodeModuleStyle>())
                            {
                                var m = mod;
                                <SgCol>
                                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">@m.ToString()</SgTypography>
                                        <SgQrCode Value="@_text" Size="100" FillColor="#7c3aed" ModuleStyle="@m" ShowCopyButton="true" />
                                    </SgStack>
                                </SgCol>
                            }
                        </SgRow>
                    </SgCard>
                </SgCol>
            </SgRow>

            <div style="height:20px;"></div>

            <SgRow Space="SgSize.Lg">
                <SgCol Xs="12" Md="6" Lg="3">
                    <SgCard Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <ChildContent>
                            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                    Gradient Fill
                                </SgTypography>
                                <SgQrCode Value="@_text" Size="130"
                                           FillGradient="true"
                                           FillGradientStart="#0d9488"
                                           FillGradientEnd="#7c3aed"
                                           Animated="true" ShowCopyButton="true" />
                            </SgStack>
                        </ChildContent>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Md="6" Lg="3">
                    <SgCard Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <ChildContent>
                            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                    Logo Overlay
                                </SgTypography>
                                <SgQrCode Value="@_qrCodeUrl" Size="130"
                                           Logo="<svg viewBox='0 0 24 24' width='24' height='24' fill='none' stroke='%230d9488' stroke-width='2'><path d='M12 2L2 7l10 5 10-5-10-5z'/><path d='M2 17l10 5 10-5'/><path d='M2 12l10 5 10-5'/></svg>"
                                           LogoSize="32"
                                           Animated="true" ShowCopyButton="true" />
                            </SgStack>
                        </ChildContent>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Md="6" Lg="3">
                    <SgCard Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <ChildContent>
                            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                    With Label
                                </SgTypography>
                                <SgQrCode Value="@_text" Size="130" FillColor="#2563eb"
                                           ShowLabel="true" LabelText="Scan me!"
                                           Animated="true" ShowCopyButton="true" />
                            </SgStack>
                        </ChildContent>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Md="6" Lg="3">
                    <SgCard Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <ChildContent>
                            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                    Responsive
                                </SgTypography>
                                <div style="width:100%;max-width:130px;">
                                    <SgQrCode Value="@_text" Responsive="true" MaxSize="130"
                                               FillColor="#dc2626"
                                               Animated="true" ShowCopyButton="true" />
                                </div>
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Fills container</SgTypography>
                            </SgStack>
                        </ChildContent>
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Batch QR Generator                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="sgc-demo-section">
        <div class="sgc-demo-section-header">
            <div class="sgc-demo-section-header-content">
                <div class="sgc-demo-section-title-row">
                    <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Batch QR Generator</SgTypography>
                    <span class="demo-live-badge">NEW</span>
                </div>
                <div class="sgc-demo-section-subtitle">
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Generate multiple QR codes at once. One per line.
                    </SgTypography>
                </div>
            </div>
        </div>
        <div class="sgc-demo-section-body">
            <SgRow Space="SgSize.Lg">
                <SgCol Xs="12" Md="5">
                    <SgStack Vertical Space="SgSize.Md">
                        <div>
                            <span class="sgc-demo-control-label">Values (one per line)</span>
                            <SgTextBox Style="min-height:140px;resize:vertical;font-family:var(--sg-font-mono,monospace);font-size:13px;" Rows="6" Multiline="true" Value="@_batchText" ValueChanged="@((string v) => { _batchText = v; UpdateBatch(); })" Placeholder="https://example.com&#10;https://github.com&#10;Hello World" Block />
                        </div>
                        <SgRow Space="SgSize.Md">
                            <SgCol Xs="6">
                                <span class="sgc-demo-control-label">Size</span>
                                <SgSelect TValue="int" @bind-Value="_batchSize" Items="_sizeItems" LabelSelector="@(x => $"{x}px")" Block />
                            </SgCol>
                            <SgCol Xs="6">
                                <span class="sgc-demo-control-label">ECC</span>
                                <SgSelect TValue="SgQrCodeEcc" @bind-Value="_batchEcc" Items="_eccItems" LabelSelector="@(x => x.ToString())" Block />
                            </SgCol>
                        </SgRow>
                        <SgBadge Text="@($"Generated: {_batchQrCodes.Count}")" Variant="SgBadgeVariant.Info" Size="SgSize.Sm" Standalone />
                    </SgStack>
                </SgCol>
                <SgCol Xs="12" Md="7">
                    @if (_batchQrCodes.Count == 0)
                    {
                        <div style="display:flex;align-items:center;justify-content:center;min-height:150px;color:var(--sg-text-muted);font-size:14px;">
                            Enter values to generate QR codes
                        </div>
                    }
                    else
                    {
                        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:16px;">
                            @foreach (var item in _batchQrCodes)
                            {
                                <SgCard Size="SgSize.Sm" Shadow="SgShadow.Sm" NoPadding Style="min-width:0;">
                                    <ChildContent>
                                        <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center" Style="padding:12px;min-width:0;">
                                            <SgQrCode Value="@item" Size="@_batchSize" MaxSize="@_batchSize" Responsive="true" ErrorCorrection="@_batchEcc" ShowCopyButton="true" Animated="true" />
                                            <div style="font-size:10px;color:var(--sg-text-muted);max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:center;" title="@item">
                                                @item
                                            </div>
                                        </SgStack>
                                    </ChildContent>
                                </SgCard>
                            }
                        </div>
                    }
                </SgCol>
            </SgRow>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Live Constructor                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="sgc-demo-section">
        <div class="sgc-demo-section-header">
            <div class="sgc-demo-section-header-content">
                <div class="sgc-demo-section-title-row">
                    <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Live SgQrCode Constructor</SgTypography>
                    <span class="demo-live-badge">INTERACTIVE</span>
                </div>
                <div class="sgc-demo-section-subtitle">
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Tweak every parameter. See real-time preview. Copy generated Blazor code.
                    </SgTypography>
                </div>
            </div>
        </div>
        <div class="sgc-demo-section-body" style="padding:0;">
            <SgRow Space="SgSize.Sm">
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">
                        <div>
                            <span class="sgc-demo-control-label">Text / URL</span>
                            <SgTextBox @bind-Value="_ctorText" Placeholder="Enter text or URL" Block />
                        </div>

                        <div>
                            <span class="sgc-demo-control-label">Size: @((int)_ctorSize) px</span>
                            <SgSlider TValue="double" @bind-Value="_ctorSize" Min="80" Max="400" Step="10" ShowTooltip="true" FormatValue="@((double v) => $"{v:F0}px")" />
                        </div>

                        <div>
                            <span class="sgc-demo-control-label">Error Correction</span>
                            <SgSegmented TValue="SgQrCodeEcc" Options="_eccSegOptions" @bind-Value="_ctorEcc" Block SizeEnum="SgSize.Sm" />
                        </div>

                        <div>
                            <span class="sgc-demo-control-label">Border</span>
                            <SgSegmented TValue="int" Options="_borderSegOptions" @bind-Value="_ctorBorder" Block SizeEnum="SgSize.Sm" />
                        </div>

                        <SgRow Space="SgSize.Md">
                            <SgCol Xs="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <span class="sgc-demo-control-label">Fill Color</span>
                                    <SgColorPicker @bind-Value="_ctorFillColor" Block />
                                </SgStack>
                            </SgCol>
                            <SgCol Xs="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <span class="sgc-demo-control-label">Background</span>
                                    <SgColorPicker @bind-Value="_ctorBgColor" Block />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <div>
                            <span class="sgc-demo-control-label">Eye Style</span>
                            <SgSegmented TValue="SgQrCodeEyeStyle" Options="_eyeStyleSegOptions" @bind-Value="_ctorEyeStyle" Block SizeEnum="SgSize.Sm" />
                        </div>

                        <div>
                            <span class="sgc-demo-control-label">Module Style</span>
                            <SgSegmented TValue="SgQrCodeModuleStyle" Options="_moduleStyleSegOptions" @bind-Value="_ctorModuleStyle" Block SizeEnum="SgSize.Sm" />
                        </div>

                        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                            <SgSwitch @bind-Value="_ctorFillGradient" Label="Gradient" />
                        </SgStack>

                        @if (_ctorFillGradient)
                        {
                            <SgRow Space="SgSize.Md">
                                <SgCol Xs="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <span class="sgc-demo-control-label">Start</span>
                                        <SgColorPicker @bind-Value="_ctorFillGradientStart" Block />
                                    </SgStack>
                                </SgCol>
                                <SgCol Xs="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <span class="sgc-demo-control-label">End</span>
                                        <SgColorPicker @bind-Value="_ctorFillGradientEnd" Block />
                                    </SgStack>
                                </SgCol>
                            </SgRow>
                        }

                        <div>
                            <span class="sgc-demo-control-label">Logo SVG (optional)</span>
                            <SgTextBox @bind-Value="_ctorLogo" Placeholder="<svg ...>" Block />
                        </div>

                        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
