@code {
    // ── Header ──────────────────────────────────────────────────────────
    private RenderFragment _mainHeader => __builder =>
    {
        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
            <div style="display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,var(--sg-primary),#8b5cf6);color:#fff;flex-shrink:0;">
                @((MarkupString)SgHeroicons.Outline.QrCode)
            </div>
            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">QR Code Generator</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    SgQrCode — pure C# QR code generation powered by Net.Codecrete.QrCodeGenerator. No JavaScript required for generation.
                </SgTypography>
            </SgStack>
        </SgStack>
    };

    // ── Shared state ────────────────────────────────────────────────────

    private string _text = "https://github.com/SuperUI/SuperUI";
    private int _size = 160;
    private SgQrCodeEcc _ecc = SgQrCodeEcc.Medium;
    private bool _generatorDownloadable = false;

    private readonly List<int> _sizeItems = new() { 80, 100, 120, 140, 160, 180, 200, 220, 240, 260, 280, 300, 350, 400 };
    private readonly List<SgQrCodeEcc> _eccItems = Enum.GetValues<SgQrCodeEcc>().ToList();

    private const string _qrCodeUrl = "https://github.com/SuperUI/SuperUI";

    // ── Color & Styling state ────────────────────────────────────────────

    private string _fillColor = "#0d9488";
    private string _bgColor = "#f0fdfa";
    private bool _fillGradient = false;
    private string _fillGradientStart = "#0d9488";
    private string _fillGradientEnd = "#7c3aed";

    private readonly List<ColorSwatch> _colorSwatches = new()
    {
        new() { Name = "Teal",  Fill = "#0d9488", Background = "#f0fdfa" },
        new() { Name = "Green", Fill = "#16a34a", Background = "#f0fdf4" },
        new() { Name = "Blue",  Fill = "#2563eb", Background = "#eff6ff" },
        new() { Name = "Red",   Fill = "#dc2626", Background = "#fef2f2" },
        new() { Name = "Purple",Fill = "#7c3aed", Background = "#f5f3ff" },
        new() { Name = "Dark",  Fill = "#1e293b", Background = "#f8fafc" },
        new() { Name = "Amber", Fill = "#d97706", Background = "#fffbeb" },
        new() { Name = "Pink",  Fill = "#db2777", Background = "#fdf2f8" },
    };

    private void SelectColorSwatch(ColorSwatch swatch)
    {
        _fillColor = swatch.Fill;
        _bgColor = swatch.Background;
    }

    // ── Batch Generator state ───────────────────────────────────────────

    private string _batchText = "https://github.com/SuperUI/SuperUI\nhttps://www.nuget.org/packages/SuperUI\nHello from SuperUI!";
    private int _batchSize = 120;
    private SgQrCodeEcc _batchEcc = SgQrCodeEcc.Medium;

    private List<string> _batchQrCodes = new();

    // ── Constructor state ───────────────────────────────────────────────

    private string _ctorText = "Hello from SuperUI!";
    private double _ctorSize = 200;
    private SgQrCodeEcc _ctorEcc = SgQrCodeEcc.Medium;
    private int _ctorBorder = 2;
    private string _ctorFillColor = "#000000";
    private string _ctorBgColor = "#ffffff";
    private SgQrCodeEyeStyle _ctorEyeStyle = SgQrCodeEyeStyle.Square;
    private SgQrCodeModuleStyle _ctorModuleStyle = SgQrCodeModuleStyle.Square;
    private bool _ctorFillGradient = false;
    private string _ctorFillGradientStart = "#0d9488";
    private string _ctorFillGradientEnd = "#7c3aed";
    private string _ctorLogo = "";
    private bool _ctorShowLabel = false;
    private string _ctorLabelText = "";
    private bool _ctorResponsive = false;
    private bool _ctorDownloadable = false;

    private string _generatedCode = "";
    private string _copyLabel = "Copy";
    private string _ctorCacheKey = "";

    private readonly List<SgSegmentedOption<SgQrCodeEcc>> _eccSegOptions = new()
    {
        new() { Value = SgQrCodeEcc.Low,      Label = "Low" },
        new() { Value = SgQrCodeEcc.Medium,   Label = "Medium" },
        new() { Value = SgQrCodeEcc.Quartile, Label = "Quartile" },
        new() { Value = SgQrCodeEcc.High,     Label = "High" },
    };

    private readonly List<SgSegmentedOption<int>> _borderSegOptions = new()
    {
        new() { Value = 0, Label = "0" },
        new() { Value = 1, Label = "1" },
        new() { Value = 2, Label = "2" },
        new() { Value = 4, Label = "4" },
        new() { Value = 8, Label = "8" },
    };

    private readonly List<SgSegmentedOption<SgQrCodeEyeStyle>> _eyeStyleSegOptions = new()
    {
        new() { Value = SgQrCodeEyeStyle.Square,  Label = "Square" },
        new() { Value = SgQrCodeEyeStyle.Circle,  Label = "Circle" },
        new() { Value = SgQrCodeEyeStyle.Rounded, Label = "Rounded" },
        new() { Value = SgQrCodeEyeStyle.Diamond, Label = "Diamond" },
        new() { Value = SgQrCodeEyeStyle.Leaf,    Label = "Leaf" },
    };

    private readonly List<SgSegmentedOption<SgQrCodeModuleStyle>> _moduleStyleSegOptions = new()
    {
        new() { Value = SgQrCodeModuleStyle.Square,  Label = "Square" },
        new() { Value = SgQrCodeModuleStyle.Circle,  Label = "Circle" },
        new() { Value = SgQrCodeModuleStyle.Rounded, Label = "Rounded" },
        new() { Value = SgQrCodeModuleStyle.Droplet, Label = "Droplet" },
    };

    // ── Lifecycle ───────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        _ctorCacheKey = BuildCtorCacheKey();
        UpdateBatch();
        UpdateConstructorCode();
    }

    private string BuildCtorCacheKey() => $"{_ctorText}|{_ctorSize}|{_ctorEcc}|{_ctorBorder}|{_ctorFillColor}|{_ctorBgColor}|{_ctorEyeStyle}|{_ctorModuleStyle}|{_ctorFillGradient}|{_ctorFillGradientStart}|{_ctorFillGradientEnd}|{_ctorLogo}|{_ctorShowLabel}|{_ctorLabelText}|{_ctorResponsive}|{_ctorDownloadable}";

    protected override void OnAfterRender(bool firstRender)
    {
        var key = BuildCtorCacheKey();
        if (key != _ctorCacheKey)
        {
            _ctorCacheKey = key;
            UpdateConstructorCode();
            StateHasChanged();
        }
    }

    private void UpdateBatch()
    {
        _batchQrCodes = _batchText
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToList();
    }

    // ── Helpers ─────────────────────────────────────────────────────────

    private static string FormatEcc(SgQrCodeEcc ecc) => ecc switch
    {
        SgQrCodeEcc.Low => "Low (L)",
        SgQrCodeEcc.Medium => "Medium (M)",
        SgQrCodeEcc.Quartile => "Quartile (Q)",
        SgQrCodeEcc.High => "High (H)",
        _ => ecc.ToString()
    };

    private static string GetEccRecovery(SgQrCodeEcc ecc) => ecc switch
    {
        SgQrCodeEcc.Low => "~7% recovery",
        SgQrCodeEcc.Medium => "~15% recovery",
        SgQrCodeEcc.Quartile => "~25% recovery",
        SgQrCodeEcc.High => "~30% recovery",
        _ => ""
    };

    private string GetInputType()
    {
        if (Uri.TryCreate(_text, UriKind.Absolute, out var uri))
            return uri.Scheme == "https" ? "HTTPS URL" : uri.Scheme == "http" ? "HTTP URL" : "URL";
        if (_text.Contains(".") && _text.Contains("/"))
            return "Path";
        return "Text";
    }

    // ── Constructor code generation ─────────────────────────────────────

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        var val = _ctorText.Replace("\"", "&quot;");
        lines.Add("<SgQrCode");
        lines.Add($"    Value=\"{val}\"");
        lines.Add($"    Size=\"{(int)_ctorSize}\"");
        lines.Add($"    ErrorCorrection=\"SgQrCodeEcc.{_ctorEcc}\"");
        lines.Add($"    Border=\"{_ctorBorder}\"");
        if (_ctorFillColor != "#000000")
            lines.Add($"    FillColor=\"{_ctorFillColor}\"");
        if (_ctorBgColor != "#ffffff")
            lines.Add($"    BackgroundColor=\"{_ctorBgColor}\"");
        if (_ctorEyeStyle != SgQrCodeEyeStyle.Square)
            lines.Add($"    EyeStyle=\"SgQrCodeEyeStyle.{_ctorEyeStyle}\"");
        if (_ctorModuleStyle != SgQrCodeModuleStyle.Square)
            lines.Add($"    ModuleStyle=\"SgQrCodeModuleStyle.{_ctorModuleStyle}\"");
        if (_ctorFillGradient)
        {
            lines.Add($"    FillGradient=\"true\"");
            if (!string.IsNullOrEmpty(_ctorFillGradientStart))
                lines.Add($"    FillGradientStart=\"{_ctorFillGradientStart}\"");
            if (!string.IsNullOrEmpty(_ctorFillGradientEnd))
                lines.Add($"    FillGradientEnd=\"{_ctorFillGradientEnd}\"");
        }
        if (!string.IsNullOrEmpty(_ctorLogo))
            lines.Add($"    Logo=\"{_ctorLogo.Replace("\"", "&quot;")}\"");
        if (_ctorShowLabel)
        {
            lines.Add($"    ShowLabel=\"true\"");
            if (!string.IsNullOrEmpty(_ctorLabelText))
                lines.Add($"    LabelText=\"{_ctorLabelText}\"");
        }
        if (_ctorResponsive)
            lines.Add($"    Responsive=\"true\"");
        if (_ctorDownloadable)
            lines.Add($"    Downloadable=\"true\"");
        lines.Add(" />");
        _generatedCode = string.Join("\n", lines);
    }

    private async Task CopyCodeToClipboard()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _generatedCode);
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

