    private readonly List<SgSegmentedOption<SgQrCodeModuleStyle>> _moduleStyleSegOptions = new()
    {
        new() { Value = SgQrCodeModuleStyle.Square,  Label = "Square" },
        new() { Value = SgQrCodeModuleStyle.Circle,  Label = "Circle" },
        new() { Value = SgQrCodeModuleStyle.Rounded, Label = "Rounded" },
        new() { Value = SgQrCodeModuleStyle.Droplet, Label = "Droplet" },
    };

    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        var val = _ctorText.Replace("\"", "&quot;");
        lines.Add("<SgQrCode");
        lines.Add($"    Value=\"{val}\"");
        lines.Add($"    Size=\"{(int)_ctorSize}\"");
        lines.Add($"    ErrorCorrection=\"SgQrCodeEcc.{_ctorEcc}\"");
        lines.Add($"    Border=\"{_ctorBorder}\"");
        if (_ctorFillColor != "#000000")
            lines.Add($"    FillColor=\"{_ctorFillColor}\"");
        if (_ctorBgColor != "#ffffff")
            lines.Add($"    BackgroundColor=\"{_ctorBgColor}\"");
        if (_ctorEyeStyle != SgQrCodeEyeStyle.Square)
            lines.Add($"    EyeStyle=\"SgQrCodeEyeStyle.{_ctorEyeStyle}\"");
        if (_ctorModuleStyle != SgQrCodeModuleStyle.Square)
            lines.Add($"    ModuleStyle=\"SgQrCodeModuleStyle.{_ctorModuleStyle}\"");
        if (_ctorFillGradient)
        {
            lines.Add($"    FillGradient=\"true\"");
            if (!string.IsNullOrEmpty(_ctorFillGradientStart))
                lines.Add($"    FillGradientStart=\"{_ctorFillGradientStart}\"");
            if (!string.IsNullOrEmpty(_ctorFillGradientEnd))
                lines.Add($"    FillGradientEnd=\"{_ctorFillGradientEnd}\"");
        }
        if (!string.IsNullOrEmpty(_ctorLogo))
            lines.Add($"    Logo=\"{_ctorLogo.Replace("\"", "&quot;")}\"");
        if (_ctorShowLabel)
        {
            lines.Add($"    ShowLabel=\"true\"");
            if (!string.IsNullOrEmpty(_ctorLabelText))
                lines.Add($"    LabelText=\"{_ctorLabelText}\"");
        }
        if (_ctorResponsive)
            lines.Add($"    Responsive=\"true\"");
        if (_ctorDownloadable)
            lines.Add($"    Downloadable=\"true\"");
        lines.Add(" />");
        _generatedCode = string.Join("\n", lines);
    }

    private async Task CopyCodeToClipboard()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _generatedCode);
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

