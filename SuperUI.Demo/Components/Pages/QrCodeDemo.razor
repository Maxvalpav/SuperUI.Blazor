@page "/qrcode-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgQrCode — QR Code Generator — SuperUI</PageTitle>
<SgSeoHead Description="Fast, customizable, and animated QR codes with copy-to-clipboard support." />

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="QR Code Generator"
                        Subtitle="Fast, customizable, and animated QR codes with copy-to-clipboard support."
                        Icon="@SgHeroicons.Outline.Squares2x2" />
    </HeaderContent>
    <ChildContent>

    <!-- 1. Interactive Generator -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgStack Horizontal Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Interactive Generator</SgTypography>
                <SgBadge Text="LIVE" Variant="SgBadgeVariant.Success" Size="SgSize.Sm" Standalone />
            </SgStack>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Type any text or URL. Compare error correction levels, see stats, and copy with one click.
            </SgTypography>
        </div>
        
        <div class="demo-controls-bar">
            <SgCard Size="SgSize.Sm" Shadow="SgShadow.Sm">
                <SgStack Horizontal Space="SgSize.Lg" Align="SgAlignItems.End" Wrap="true">
                    <div style="flex: 1; min-width: 250px;">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Color="var(--sg-text-muted)" Style="margin-bottom:4px;display:block;">Text / URL</SgTypography>
                        <SgTextBox @bind-Value="_text" Placeholder="Enter text or URL to encode..." Block />
                    </div>
                    <div style="width: 100px;">
                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Color="var(--sg-text-muted)" Style="margin-bottom:4px;display:block;">Size</SgTypography>
                        <SgSelect TValue="int" @bind-Value="_size" Items="_sizeItems" LabelSelector="@(x => $"{x}px")" Block />
                    </div>
                    <div style="width: 140px;">
                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Color="var(--sg-text-muted)" Style="margin-bottom:4px;display:block;">ECC</SgTypography>
                        <SgSelect TValue="SgQrCodeEcc" @bind-Value="_ecc" Items="_eccItems" LabelSelector="@(x => FormatEcc(x))" Block />
                    </div>
                    <SgSwitch @bind-Value="_generatorDownloadable" Label="Download" Style="margin-bottom: 8px;" />
                </SgStack>
            </SgCard>
        </div>

        <SgRow Space="SgSize.Lg" Align="SgAlignItems.Stretch">
            <SgCol Xs="12" Lg="9">
                <SgRow Space="SgSize.Md">
                    @foreach (var ecc in Enum.GetValues<SgQrCodeEcc>())
                    {
                        var e = ecc;
                        <SgCol Xs="6" Sm="3">
                            <SgCard Size="SgSize.Sm" Shadow="SgShadow.Sm" Style="height:100%;text-align:center;">
                                <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                    <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)">@FormatEcc(e)</SgTypography>
                                    <SgQrCode Value="@_text" Size="@_size" ErrorCorrection="@e" Animated="true" ShowCopyButton="true" Downloadable="@_generatorDownloadable" />
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">@GetEccRecovery(e)</SgTypography>
                                </SgStack>
                            </SgCard>
                        </SgCol>
                    }
                </SgRow>
            </SgCol>
            <SgCol Xs="12" Lg="3">
                <SgCard Title="QR Stats" Size="SgSize.Sm" Shadow="SgShadow.Sm" Style="height:100%;">
                    <SgStack Vertical Space="SgSize.Sm">
                        @StatRow("Length", _text.Length.ToString(), SgBadgeVariant.Info)
                        @StatRow("ECC", FormatEcc(_ecc), SgBadgeVariant.Success)
                        @StatRow("Size", $"{_size}px", SgBadgeVariant.Default)
                        @StatRow("Type", GetInputType(), SgBadgeVariant.Default)
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- 2. Color & Styling -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Color &amp; Styling</SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Customize fill and background. Try presets, gradients, or pick your own colors.
            </SgTypography>
        </div>
        
        <SgRow Space="SgSize.Lg">
            <SgCol Xs="12" Md="6">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgRow Space="SgSize.Md">
                        <SgCol Xs="6">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)" Style="margin-bottom:4px;display:block;">Fill Color</SgTypography>
                            <SgColorPicker @bind-Value="_fillColor" Block />
                        </SgCol>
                        <SgCol Xs="6">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)" Style="margin-bottom:4px;display:block;">Background</SgTypography>
                            <SgColorPicker @bind-Value="_bgColor" Block />
                        </SgCol>
                    </SgRow>

                    <div>
                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)" Style="margin-bottom:8px;display:block;">Presets</SgTypography>
                        <SgStack Horizontal Space="SgSize.Sm" Wrap="true">
                            @foreach (var swatch in _colorSwatches)
                            {
                                var sw = swatch;
                                <button type="button" class="swatch-btn" 
                                        style="background:@sw.Fill; border: 2px solid @(sw.Background == "#ffffff" ? "var(--sg-border)" : sw.Background);"
                                        @onclick="() => SelectColorSwatch(sw)" title="@sw.Name"></button>
                            }
                        </SgStack>
                    </div>

                    <SgDivider />

                    <SgStack Vertical Space="SgSize.Md">
                        <SgSwitch @bind-Value="_fillGradient" Label="Enable Gradient Fill" />
                        @if (_fillGradient)
                        {
                            <SgRow Space="SgSize.Md">
                                <SgCol Xs="6">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)" Style="margin-bottom:4px;display:block;">Start Color</SgTypography>
                                    <SgColorPicker @bind-Value="_fillGradientStart" Block />
                                </SgCol>
                                <SgCol Xs="6">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)" Style="margin-bottom:4px;display:block;">End Color</SgTypography>
                                    <SgColorPicker @bind-Value="_fillGradientEnd" Block />
                                </SgCol>
                            </SgRow>
                        }
                    </SgStack>
                </SgStack>
            </SgCol>
            <SgCol Xs="12" Md="6">
                <div class="preview-box">
                    <SgQrCode Value="@_text" Size="200"
                               FillColor="@_fillColor" BackgroundColor="@_bgColor"
                               FillGradient="@_fillGradient"
                               FillGradientStart="@_fillGradientStart"
                               FillGradientEnd="@_fillGradientEnd"
                               Animated="true" ShowCopyButton="true" />
                </div>
            </SgCol>
        </SgRow>
    </div>

    <!-- 3. Visual Styles -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Visual Styles</SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Eye patterns, module shapes, gradients, and logo overlays.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Xs="12" Lg="6">
                <SgCard Title="Eye Style" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                    <SgStack Horizontal Space="SgSize.Md" Justify="SgJustifyContent.SpaceAround" Wrap="true">
                        @foreach (var eye in Enum.GetValues<SgQrCodeEyeStyle>())
                        {
                            var e = eye;
                            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">@e.ToString()</SgTypography>
                                <SgQrCode Value="@_text" Size="80" FillColor="var(--sg-color-primary)" EyeStyle="@e" ShowCopyButton="true" />
                            </SgStack>
                        }
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Lg="6">
                <SgCard Title="Module Shape" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                    <SgStack Horizontal Space="SgSize.Md" Justify="SgJustifyContent.SpaceAround" Wrap="true">
                        @foreach (var mod in Enum.GetValues<SgQrCodeModuleStyle>())
                        {
                            var m = mod;
                            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">@m.ToString()</SgTypography>
                                <SgQrCode Value="@_text" Size="80" FillColor="var(--sg-color-primary)" ModuleStyle="@m" ShowCopyButton="true" />
                            </SgStack>
                        }
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>

        <div style="height:24px;"></div>

        <SgRow Space="SgSize.Md">
            @VisualCard("Gradient", @<SgQrCode Value="@_text" Size="120" FillGradient="true" FillGradientStart="var(--sg-color-primary)" FillGradientEnd="var(--sg-color-info)" Animated="true" ShowCopyButton="true" />)
            @VisualCard("Logo", @<SgQrCode Value="@_qrCodeUrl" Size="120" Logo="<svg viewBox='0 0 24 24' width='24' height='24' fill='none' stroke='var(--sg-color-primary)' stroke-width='2'><path d='M12 2L2 7l10 5 10-5-10-5z'/><path d='M2 17l10 5 10-5'/><path d='M2 12l10 5 10-5'/></svg>" LogoSize="32" Animated="true" ShowCopyButton="true" />)
            @VisualCard("Label", @<SgQrCode Value="@_text" Size="120" FillColor="var(--sg-color-primary)" ShowLabel="true" LabelText="SCAN" Animated="true" ShowCopyButton="true" />)
            @VisualCard("Clean", @<SgQrCode Value="@_text" Size="120" FillColor="var(--sg-fg)" Animated="true" ShowCopyButton="true" />)
        </SgRow>
    </div>
    </ChildContent>
</SgCard>

<style>
    .demo-section { margin-bottom: 40px; }
    .demo-section:last-child { margin-bottom: 0; }
    .demo-section-header { margin-bottom: 20px; }
    .demo-controls-bar { margin-bottom: 24px; }
    
    .stat-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid var(--sg-border-subtle);
    }
    .stat-row:last-child { border-bottom: none; }

    .swatch-btn {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        cursor: pointer;
        transition: transform 0.1s;
    }
    .swatch-btn:hover { transform: scale(1.1); }

    .preview-box {
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--sg-bg-subtle);
        border: 1px dashed var(--sg-border-strong);
        border-radius: var(--sg-radius-lg);
        min-height: 260px;
    }
</style>

@code {
    private string _text = "https://superui.dev";
    private int _size = 160;
    private SgQrCodeEcc _ecc = SgQrCodeEcc.Medium;
    private bool _generatorDownloadable = true;
    
    private string _fillColor = "var(--sg-fg)";
    private string _bgColor = "var(--sg-bg)";
    private bool _fillGradient = false;
    private string _fillGradientStart = "var(--sg-color-primary)";
    private string _fillGradientEnd = "var(--sg-color-info)";

    private string _qrCodeUrl = "https://github.com/superui-blazor";

    private readonly List<int> _sizeItems = new() { 100, 128, 160, 200, 256, 320 };
    private readonly List<SgQrCodeEcc> _eccItems = Enum.GetValues<SgQrCodeEcc>().ToList();

    private readonly List<ColorSwatch> _colorSwatches = new()
    {
        new("Default", "var(--sg-fg)", "var(--sg-bg)"),
        new("Brand", "var(--sg-color-primary)", "var(--sg-bg)"),
        new("Success", "var(--sg-color-success)", "var(--sg-bg)"),
        new("Warning", "var(--sg-color-warning)", "var(--sg-bg)"),
        new("Danger", "var(--sg-color-danger)", "var(--sg-bg)"),
        new("Dark", "#ffffff", "#1e1e2e"),
        new("Soft", "var(--sg-color-primary)", "var(--sg-color-primary-subtle)")
    };



    private RenderFragment StatRow(string label, string value, SgBadgeVariant variant) => __builder =>
    {
        <div class="stat-row">
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">@label</SgTypography>
            <SgBadge Text="@value" Variant="variant" Size="SgSize.Sm" Standalone />
        </div>
    };

    private RenderFragment VisualCard(string title, RenderFragment qr) => __builder =>
    {
        <SgCol Xs="6" Md="3">
            <SgCard Size="SgSize.Sm" Shadow="SgShadow.Sm" Style="height:100%;text-align:center;">
                <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)" Transform="SgTypographyTransform.Uppercase">@title</SgTypography>
                    @qr
                </SgStack>
            </SgCard>
        </SgCol>
    };

    private void SelectColorSwatch(ColorSwatch swatch)
    {
        _fillColor = swatch.Fill;
        _bgColor = swatch.Background;
        _fillGradient = false;
    }

    private string FormatEcc(SgQrCodeEcc ecc) => ecc switch
    {
        SgQrCodeEcc.Low => "Low (L)",
        SgQrCodeEcc.Medium => "Medium (M)",
        SgQrCodeEcc.Quartile => "Quartile (Q)",
        SgQrCodeEcc.High => "High (H)",
        _ => ecc.ToString()
    };

    private string GetEccRecovery(SgQrCodeEcc ecc) => ecc switch
    {
        SgQrCodeEcc.Low => "~7% recovery",
        SgQrCodeEcc.Medium => "~15% recovery",
        SgQrCodeEcc.Quartile => "~25% recovery",
        SgQrCodeEcc.High => "~30% recovery",
        _ => ""
    };

    private string GetInputType()
    {
        if (string.IsNullOrWhiteSpace(_text)) return "Empty";
        if (_text.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return "URL";
        if (_text.All(char.IsDigit)) return "Numeric";
        return "Alphanumeric";
    }

    private record ColorSwatch(string Name, string Fill, string Background);
}