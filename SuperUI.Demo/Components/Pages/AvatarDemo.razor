@page "/demo/avatar"
@using SuperUI.Demo.Components

<div class="demo-page">
    <div class="demo-hero">
        <section class="demo-hero-main">
            <div class="demo-header">
                <div class="demo-kicker">Display Components</div>
                <h1 class="demo-title">SgAvatar</h1>
                <p class="demo-subtitle">
                    Visual representation of users or entities. Supports images, initials, icons, 
                    status indicators, and automatic color generation.
                </p>
            </div>
        </section>

        <aside class="demo-hero-side">
            <div class="demo-side-title">Highlights</div>
            <div class="demo-pill-list">
                <span class="demo-pill demo-pill-accent">Auto-Color</span>
                <span class="demo-pill">Status Dots</span>
                <span class="demo-pill">Initials</span>
                <span class="demo-pill">Sizes</span>
            </div>
        </aside>
    </div>

    <SgDemoSection Eyebrow="Usage" Title="Examples">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Basic Avatars</h3>
                    <p class="demo-showcase-desc">Using images and initials with different shapes.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <div style="display:flex; gap:15px; align-items:center;">
                            <SgAvatar ImageUrl="https://i.pravatar.cc/150?u=1" Title="User Image" />
                            <SgAvatar Initials="JS" Color="#006fee" />
                            <SgAvatar Title="Max Pavlov" AutoColor="true" />
                            <SgAvatar Shape="SgAvatarShape.Rounded" Initials="RT" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Sizes & Status</h3>
                    <p class="demo-showcase-desc">Scaling and presence indicators.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <div style="display:flex; gap:15px; align-items:center;">
                            <SgAvatar Size="SgSize.Sm" StatusDot="SgAvatarStatus.Online" Title="Small Online" />
                            <SgAvatar Size="SgSize.Md" StatusDot="SgAvatarStatus.Away" Title="Medium Away" />
                            <SgAvatar Size="SgSize.Lg" StatusDot="SgAvatarStatus.Busy" Title="Large Busy" />
                            <SgAvatar Size="SgSize.Xl" StatusDot="SgAvatarStatus.Offline" StatusPulse="true" Title="XL Pulse" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Interactions</h3>
                    <p class="demo-showcase-desc">Clickable avatars with loading states.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <div style="display:flex; gap:15px; align-items:center;">
                            <SgAvatar Clickable="true" Title="Click me" />
                            <SgAvatar Loading="true" />
                            <SgAvatar Bordered="true" ImageUrl="https://i.pravatar.cc/150?u=5" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoParams Title="Avatar Parameters">
        <SgDemoParam Name="ImageUrl" Type="string" Description="Source URL for the avatar image." />
        <SgDemoParam Name="Initials" Type="string" Description="Text to display if image is missing." />
        <SgDemoParam Name="Title" Type="string" Description="Used for initials generation and accessibility." />
        <SgDemoParam Name="AutoColor" Type="bool" Description="Generate deterministic background color from Title." DefaultValue="false" />
        <SgDemoParam Name="Size" Type="SgSize" Description="Preset size." Values="Sm, Md, Lg, Xl" DefaultValue="Md" />
        <SgDemoParam Name="Shape" Type="SgAvatarShape" Description="Border radius style." Values="Circle, Square, Rounded" DefaultValue="Circle" />
        <SgDemoParam Name="StatusDot" Type="SgAvatarStatus" Description="Presence indicator dot." Values="None, Online, Offline, Away, Busy" DefaultValue="None" />
        <SgDemoParam Name="Loading" Type="bool" Description="Show loading spinner overlay." DefaultValue="false" />
    </SgDemoParams>
</div>
