@page "/code-demo"
@using SuperUI.Components

<PageTitle>Code — SUI</PageTitle>

<SgCard Title="SgCode — Блок кода"
        Subtitle="Компонент для отображения фрагментов кода с подсветкой синтаксиса, нумерацией строк и кнопкой копирования.">

    <!-- Базовый пример -->
    <div style="margin-top: 32px;">
        <h2>Базовый пример</h2>
        <p>Простой блок кода с автоматической кнопкой копирования и меткой языка.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Razor / Blazor</div>
                        <SgCode Language="SgCodeLanguage.Razor" Code="@_razorExample" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">C#</div>
                        <SgCode Language="SgCodeLanguage.CSharp" Code="@_csharpExample" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_codeProperties" />
            </SgCard>
        </div>
    </div>

    <!-- С заголовком и нумерацией строк -->
    <div style="margin-top: 32px;">
        <h2>Заголовок и нумерация строк</h2>
        <p>Добавьте заголовок через <code>Title</code> и включите нумерацию строк через <code>ShowLineNumbers</code>.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgCode Language="SgCodeLanguage.CSharp"
                            Title="Program.cs"
                            ShowLineNumbers="true"
                            Code="@_programExample" />
                </div>
            </SgCard>

            <SgCard Title="Код примера">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_titleLineNumbersUsage" />
            </SgCard>
        </div>
    </div>

    <!-- Ограничение высоты -->
    <div style="margin-top: 32px;">
        <h2>Ограничение высоты</h2>
        <p>Параметр <code>MaxHeight</code> ограничивает высоту блока и добавляет вертикальную прокрутку.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <SgCode Language="SgCodeLanguage.CSharp"
                        Title="LongFile.cs"
                        ShowLineNumbers="true"
                        MaxHeight="200"
                        Code="@_longExample" />
            </SgCard>

            <SgCard Title="Код примера">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_maxHeightUsage" />
            </SgCard>
        </div>
    </div>

    <!-- Разные языки -->
    <div style="margin-top: 32px;">
        <h2>Поддерживаемые языки</h2>
        <p>Параметр <code>Language</code> принимает значения перечисления <code>SgCodeLanguage</code>.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="JSON">
                <SgCode Language="SgCodeLanguage.Json" Code="@_jsonExample" />
            </SgCard>
            <SgCard Title="CSS">
                <SgCode Language="SgCodeLanguage.Css" Code="@_cssExample" />
            </SgCard>
            <SgCard Title="Bash">
                <SgCode Language="SgCodeLanguage.Bash" Code="@_bashExample" />
            </SgCard>
            <SgCard Title="SQL">
                <SgCode Language="SgCodeLanguage.Sql" Code="@_sqlExample" />
            </SgCard>
        </div>
    </div>

    <!-- Без кнопки копирования -->
    <div style="margin-top: 32px;">
        <h2>Дополнительные параметры</h2>
        <p>Управление видимостью кнопки копирования и метки языка.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Без кнопки копирования</div>
                        <SgCode Language="SgCodeLanguage.Razor" ShowCopy="false" Code="@_razorExample" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Без метки языка</div>
                        <SgCode Language="SgCodeLanguage.Razor" ShowLanguage="false" Code="@_razorExample" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Только код (без шапки)</div>
                        <SgCode Language="SgCodeLanguage.Razor" ShowCopy="false" ShowLanguage="false" Code="@_razorExample" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства перечисления SgCodeLanguage">
                <PropertyTable Items="_languageEnumValues" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private string _razorExample = """
        <SgBadge Text="Новое" Variant="SgBadgeVariant.Success" />
        <SgBadge Text="В разработке" Variant="SgBadgeVariant.Warn" />
        <SgBadge Text="Архив" Variant="SgBadgeVariant.Muted" />
        """;

    private string _csharpExample = """
        var items = new List<string> { "Alpha", "Beta", "Gamma" };
        var result = items
            .Where(x => x.StartsWith("A"))
            .Select(x => x.ToUpper())
            .ToList();
        """;

    private string _programExample = """
        using SuperUI.Components;

        var builder = WebApplication.CreateBuilder(args);

        builder.Services.AddRazorComponents()
            .AddInteractiveServerComponents();

        builder.Services.AddSuperUI();

        var app = builder.Build();

        app.UseStaticFiles();
        app.UseAntiforgery();

        app.MapRazorComponents<App>()
            .AddInteractiveServerRenderMode();

        app.Run();
        """;

    private string _longExample = """
        namespace SuperUI.Components;

        public enum SgCodeLanguage
        {
            Text,
            Razor,
            CSharp,
            Html,
            Css,
            Json,
            JavaScript,
            TypeScript,
            Xml,
            Bash,
            Sql
        }

        public class SgCodeOptions
        {
            public SgCodeLanguage Language { get; set; } = SgCodeLanguage.Razor;
            public bool ShowCopy { get; set; } = true;
            public bool ShowLineNumbers { get; set; }
            public bool ShowLanguage { get; set; } = true;
            public int? MaxHeight { get; set; }
            public string? Title { get; set; }
        }
        """;

    private string _jsonExample = """
        {
          "name": "SuperUI",
          "version": "1.0.9",
          "components": ["SgButton", "SgBadge", "SgCode"],
          "theme": {
            "primary": "#1568c6",
            "radius": "6px"
          }
        }
        """;

    private string _cssExample = """
        .sgc-badge {
          display: inline-flex;
          align-items: center;
          padding: 2px 8px;
          border-radius: 4px;
          font-size: 12px;
          font-weight: 500;
          line-height: 1.5;
        }

        .sgc-badge.sgc-success {
          background: var(--sui-success-bg);
          color: var(--sui-success-fg);
        }
        """;

    private string _bashExample = """
        # Установка SuperUI
        dotnet add package SuperUI

        # Запуск демо-приложения
        dotnet run --project SuperUI.Demo

        # Публикация
        dotnet publish -c Release -o ./publish
        """;

    private string _sqlExample = """
        SELECT
            e.Id,
            e.FirstName,
            e.LastName,
            d.Name AS Department
        FROM Employees e
        INNER JOIN Departments d ON e.DepartmentId = d.Id
        WHERE e.IsActive = 1
        ORDER BY e.LastName, e.FirstName;
        """;

    private string _titleLineNumbersUsage = """
        <SgCode Language="SgCodeLanguage.CSharp"
                Title="Program.cs"
                ShowLineNumbers="true"
                Code="@_myCode" />
        """;

    private string _maxHeightUsage = """
        <SgCode Language="SgCodeLanguage.CSharp"
                Title="LongFile.cs"
                ShowLineNumbers="true"
                MaxHeight="200"
                Code="@_myCode" />
        """;

    private List<PropertyPanelItem> _codeProperties = new()
    {
        new() { Label = "Code",            Value = "string",          BadgeText = "Код для отображения",       BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Language",        Value = "SgCodeLanguage",  BadgeText = "Язык (enum)",               BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Title",           Value = "string",          BadgeText = "Заголовок блока",           BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ShowCopy",        Value = "bool (true)",     BadgeText = "Кнопка копирования",        BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowLineNumbers", Value = "bool (false)",    BadgeText = "Нумерация строк",           BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowLanguage",    Value = "bool (true)",     BadgeText = "Метка языка",               BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "MaxHeight",       Value = "int?",            BadgeText = "Макс. высота (px)",         BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "CssClass",        Value = "string",          BadgeText = "CSS класс",                 BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Style",           Value = "string",          BadgeText = "Inline стиль",              BadgeVariant = SgBadgeVariant.Info },
    };

    private List<PropertyPanelItem> _languageEnumValues = new()
    {
        new() { Label = "SgCodeLanguage.Text",       Value = "text",       BadgeText = "Простой текст",  BadgeVariant = SgBadgeVariant.Muted },
        new() { Label = "SgCodeLanguage.Razor",      Value = "razor",      BadgeText = "Razor / Blazor", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgCodeLanguage.CSharp",     Value = "csharp",     BadgeText = "C#",             BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgCodeLanguage.Html",       Value = "html",       BadgeText = "HTML",           BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgCodeLanguage.Css",        Value = "css",        BadgeText = "CSS",            BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgCodeLanguage.Json",       Value = "json",       BadgeText = "JSON",           BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgCodeLanguage.JavaScript", Value = "js",         BadgeText = "JavaScript",     BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgCodeLanguage.TypeScript", Value = "ts",         BadgeText = "TypeScript",     BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgCodeLanguage.Bash",       Value = "bash",       BadgeText = "Bash / Shell",   BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgCodeLanguage.Sql",        Value = "sql",        BadgeText = "SQL",            BadgeVariant = SgBadgeVariant.Info },
    };
}
