@page "/micro-frontend-demo"
@using SuperUI.Components
@inject NavigationManager Navigation

<PageTitle>Micro Frontend - SUI</PageTitle>

<SgCard Title="SgMicroFrontend - Микрофронтенды"
        Subtitle="Загрузка внешних модулей и компонентов в рантайме.">

    <div style="margin-top: 32px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Загрузка внешнего компонента</SgTypography>
            <SgButton Text="Перейти к приложению-хосту" 
                      Variant="SgButtonVariant.Primary" 
                      OnClick="@(() => Navigation.NavigateTo("/micro-frontend-app"))">
                <Icon><SgIcon Icon="@SgIcons.ExternalLink" /></Icon>
            </SgButton>
        </div>
        <p>Компонент позволяет загружать внешние JavaScript-бандлы или Blazor-модули и рендерить их внутри приложения.</p>
        
        <div style="margin-top: 16px; padding: 24px; border: 1px solid var(--sui-border-color); border-radius: 8px;">
            <SgMicroFrontend Source="demo" ComponentType="UserProfileCard" />
        </div>
    </div>

</SgCard>
