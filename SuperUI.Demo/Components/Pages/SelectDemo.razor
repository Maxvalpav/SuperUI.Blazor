    private bool _ctorRequired;
    private string[] _ctorCodeLines = Array.Empty<string>();
    private string _copyIcon = "\U0001f4cb";
    private string _copyLabel = "Copy";

    private readonly List<SgSegmentedOption<SgSize>> _sizeSegOpts = new()
    {
        new() { Value = SgSize.Sm, Label = "Sm" },
        new() { Value = SgSize.Md, Label = "Md" },
        new() { Value = SgSize.Lg, Label = "Lg" },
    };
    private readonly List<SgSegmentedOption<bool>> _boolSegOpts = new()
    {
        new() { Value = false, Label = "Off" },
        new() { Value = true,  Label = "On" },
    };

    protected override void OnInitialized()
    {
        _employees = new List<Employee>
        {
            new() { Id = 1, FirstName = "Ivan",   LastName = "Ivanov",    Department = DepartmentType.Engineering },
            new() { Id = 2, FirstName = "Petr",   LastName = "Petrov",    Department = DepartmentType.HR },
            new() { Id = 3, FirstName = "Sergey", LastName = "Sidorov",   Department = DepartmentType.Marketing },
            new() { Id = 4, FirstName = "Alexey", LastName = "Alexeev",   Department = DepartmentType.Engineering },
            new() { Id = 5, FirstName = "Dmitry", LastName = "Dmitriev",  Department = DepartmentType.Product },
            new() { Id = 6, FirstName = "Elena",  LastName = "Egorova",   Department = DepartmentType.Design },
        };
        UpdateCtorCode();
    }

    private void UpdateCtorCode()
    {
        var lines = new List<string>();
        lines.Add("<SgSelect TValue=\"string\"");
        lines.Add($"         Size=\"SgSize.{_ctorSize}\"");
        lines.Add($"         AllowClear=\"{_ctorAllowClear.ToString().ToLowerInvariant()}\"");
        if (!_ctorSearch)
            lines.Add($"         ShowSearch=\"{_ctorSearch.ToString().ToLowerInvariant()}\"");
        if (_ctorDisabled)
            lines.Add($"         Disabled=\"true\"");
        if (_ctorRequired)
            lines.Add($"         Required=\"true\"");
        lines.Add("         Items=\"@_fruits\"");
        lines.Add("         Label=\"Live Select\"");
        lines.Add("         Placeholder=\"Configure me...\" />");
        _ctorCodeLines = lines.ToArray();
    }

    private async Task CopyCtorCode()
    {
        var code = string.Join("\n", _ctorCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "\u2713";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "\U0001f4cb";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "\u2717";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "\U0001f4cb";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

