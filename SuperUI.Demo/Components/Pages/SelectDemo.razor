@page "/select-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models
@inject IJSRuntime JS

<PageTitle>Select — SUI</PageTitle>
<SgSeoHead Description="Explore Select — SuperUI Blazor component library demo with live examples, code snippets, and API documentation." />

<SgCard>
<ChildContent>
    <SgStack Vertical Space="SgSize.Lg">

        @* ── Header ──────────────────────────────────────────────────────── *@
        <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:8px;">
            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                <SgTypography Variant="SgTypographyVariant.Heading3" Weight="SgTypographyWeight.Bold">Select Components</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    SgSelect, SgMultiSelect, SgComboBox — modern dropdowns with search, keyboard nav, enum support, and multi-column extended variants.
                </SgTypography>
            </SgStack>
        </div>

        @* ── 1. SgSelect ─────────────────────────────────────────────────── *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">SgSelect</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Single-value selector with search, custom dropdown, clearable, and full validation support.</SgTypography>
            </div>
            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="8">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgCard Title="Basic Usage" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                            <SgStack Vertical Space="SgSize.Md">
                                <SgSelect TValue="string" @bind-Value="@_selectVal1" Items="@_fruits" Label="Favorite Fruit" Placeholder="Choose a fruit..." />
                                <div style="display:flex;align-items:center;gap:8px;">
                                    <SgBadge Text="Selected:" Variant="SgBadgeVariant.Muted" Standalone="true" />
                                    <SgBadge Text="@(_selectVal1 ?? "-")" Variant="SgBadgeVariant.Info" Standalone="true" />
                                </div>
                            </SgStack>
                        </SgCard>
                        <SgCard Title="Sizes" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                                    Three sizes via <SgTypography As="SgTypographyElement.Code">Size</SgTypography>:
                                    <SgTypography As="SgTypographyElement.Code">SgSize.Sm</SgTypography>,
                                    <SgTypography As="SgTypographyElement.Code">SgSize.Md</SgTypography>,
                                    <SgTypography As="SgTypographyElement.Code">SgSize.Lg</SgTypography>
                                </SgTypography>
                                <SgSpace Size="8px" />
                                <SgSelect TValue="string" Size="SgSize.Sm" Items="@_fruits" Label="Small" Placeholder="sm" />
                                <SgSelect TValue="string" Size="SgSize.Md" Items="@_fruits" Label="Medium" Placeholder="md" />
                                <SgSelect TValue="string" Size="SgSize.Lg" Items="@_fruits" Label="Large" Placeholder="lg" />
                            </SgStack>
                        </SgCard>
                        <SgCard Title="States" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                            <SgRow Space="SgSize.Md">
                                <SgCol Xs="12" Sm="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)">Required</SgTypography>
                                        <SgSelect TValue="string" @bind-Value="@_selectReq" Items="@_fruits" Label="Required Field" Placeholder="Select..." Required="true" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)">Disabled</SgTypography>
                                        <SgSelect TValue="string" Items="@_fruits" Label="Disabled" Disabled="true" Value="@("Cherry")" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)">AllowClear = false</SgTypography>
                                        <SgSelect TValue="string" @bind-Value="@_selectNoClear" Items="@_fruits" Label="No Clear" Placeholder="Sticky value..." AllowClear="false" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)">With Hint</SgTypography>
                                        <SgSelect TValue="string" Items="@_fruits" Label="With Hint" Placeholder="Pick one..." Hint="You can change this later" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>
                        </SgCard>
                    </SgStack>
                </SgCol>
                <SgCol Xs="12" Md="4">
                    <SgCard Title="SgSelect Properties" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <PropertyTable Items="@_selectProps" />
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

        @* ── 2. SgMultiSelect ────────────────────────────────────────────── *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">SgMultiSelect</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Multi-value selector with tags, search, select all / deselect all, and keyboard navigation.</SgTypography>
            </div>
            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="8">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgCard Title="Basic Multi-Select" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                            <SgStack Vertical Space="SgSize.Md">
                                <SgMultiSelect TItem="string" TKey="string"
                                               @bind-Values="@_multiVals"
                                               Items="@_fruits"
                                               KeySelector="s => s"
                                               Label="Pick your fruits"
                                               Placeholder="Select fruits..." />
                                <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                                    <SgBadge Text="Selected:" Variant="SgBadgeVariant.Muted" Standalone="true" />
                                    @if (_multiVals.Any())
                                    {
                                        @foreach (var v in _multiVals)
                                        {
                                            <SgBadge Text="@v" Variant="SgBadgeVariant.Info" Standalone="true" Size="SgSize.Sm" />
                                        }
                                    }
                                    else
                                    {
                                        <SgBadge Text="-" Variant="SgBadgeVariant.Default" Standalone="true" />
                                    }
                                </div>
                            </SgStack>
                        </SgCard>
                        <SgCard Title="Features" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                            <SgRow Space="SgSize.Md">
                                <SgCol Xs="12" Sm="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)">AllowClear</SgTypography>
                                        <SgMultiSelect TItem="string" TKey="string"
                                                       @bind-Values="@_multiClear"
                                                       Items="@_fruits"
                                                       KeySelector="s => s"
                                                       Label="Clearable"
                                                       Placeholder="Select..."
                                                       AllowClear="true" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)">Disabled</SgTypography>
                                        <SgMultiSelect TItem="string" TKey="string"
                                                       Items="@_fruits"
                                                       KeySelector="s => s"
                                                       Label="Disabled"
                                                       Disabled="true"
                                                       Values="@(new[] { "Apple", "Banana" })" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)">MaxDisplayedTags = 3</SgTypography>
                                        <SgMultiSelect TItem="string" TKey="string"
                                                       @bind-Values="@_multiOverflow"
                                                       Items="@_manyItems"
                                                       KeySelector="s => s"
                                                       Label="Many options"
                                                       Placeholder="Select..."
                                                       MaxDisplayedTags="3" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)">AutoFocus</SgTypography>
                                        <SgMultiSelect TItem="string" TKey="string"
                                                       @bind-Values="@_multiAF"
                                                       Items="@_fruits"
                                                       KeySelector="s => s"
                                                       Label="Auto Focus"
                                                       Placeholder="Open to auto-focus search..."
                                                       AutoFocus="true" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>
                        </SgCard>
                        <SgCard Title="Sizes" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                                    Three sizes via <SgTypography As="SgTypographyElement.Code">Size</SgTypography>
                                </SgTypography>
                                <SgSpace Size="8px" />
                                <SgMultiSelect TItem="string" TKey="string" Items="@_fruits" KeySelector="s => s" Label="Small" Size="SgSize.Sm" Placeholder="sm" />
                                <SgMultiSelect TItem="string" TKey="string" Items="@_fruits" KeySelector="s => s" Label="Medium" Size="SgSize.Md" Placeholder="md" />
                                <SgMultiSelect TItem="string" TKey="string" Items="@_fruits" KeySelector="s => s" Label="Large" Size="SgSize.Lg" Placeholder="lg" />
                            </SgStack>
                        </SgCard>
                    </SgStack>
                </SgCol>
                <SgCol Xs="12" Md="4">
                    <SgCard Title="SgMultiSelect Properties" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <PropertyTable Items="@_multiProps" />
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

        @* ── 3. SgComboBox ───────────────────────────────────────────────── *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">SgComboBox</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Single-value select with an optional editable text input for filtering/searching.</SgTypography>
            </div>
            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="8">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgCard Title="ComboBox Examples" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                            <SgRow Space="SgSize.Md">
                                <SgCol Xs="12" Sm="6">
                                    <SgComboBox TValue="string" @bind-Value="@_comboVal1" Items="@_fruits" Label="Standard" Placeholder="Pick one..." AllowClear="true" />
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgComboBox TValue="string" @bind-Value="@_comboVal2" Items="@_fruits" Label="Editable (search)" Placeholder="Type to filter..." Editable="true" />
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgComboBox TValue="string" Items="@_fruits" Label="Disabled" Disabled="true" Value="@("Apple")" />
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgComboBox TValue="string" Items="@_fruits" Label="With Hint" Placeholder="Pick..." Hint="Select your preference" />
                                </SgCol>
                            </SgRow>
                            <SgSpace Size="SgSize.Sm" />
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)">Selected values</SgTypography>
                                <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                                    <SgBadge Text="Standard:" Variant="SgBadgeVariant.Muted" Standalone="true" Size="SgSize.Sm" />
                                    <SgBadge Text="@(_comboVal1 ?? "-")" Variant="SgBadgeVariant.Info" Standalone="true" Size="SgSize.Sm" />
                                    <SgBadge Text="Editable:" Variant="SgBadgeVariant.Muted" Standalone="true" Size="SgSize.Sm" />
                                    <SgBadge Text="@(_comboVal2 ?? "-")" Variant="SgBadgeVariant.Info" Standalone="true" Size="SgSize.Sm" />
                                </div>
                            </SgStack>
                        </SgCard>
                    </SgStack>
                </SgCol>
                <SgCol Xs="12" Md="4">
                    <SgCard Title="SgComboBox Properties" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <PropertyTable Items="@_comboProps" />
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

        @* ── 4. Extended (Ex) Components ─────────────────────────────────── *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">Extended Components (Ex)</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Multi-column dropdowns with headers, descriptions, and rich data for structured content.</SgTypography>
            </div>
            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="6">
                    <SgCard Title="SgMultiSelectEx" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <SgMultiSelectEx TItem="Employee" TKey="int"
                                         Items="@_employees"
                                         @bind-Values="@_selectedEmpIds"
                                         KeySelector="e => e.Id"
                                         LabelSelector="e => e.FirstName"
                                         ColumnsSelector="@(e => (IEnumerable<string>)new[] { e.FirstName, e.LastName, e.Department.ToString() })"
                                         ColumnNames="@(new[] { "Name", "Surname", "Department" })"
                                         Label="Select Employees"
                                         Placeholder="Type to search employees..." />
                        <SgSpace Size="SgSize.Sm" />
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)">Selected: @_selectedEmpIds.Count()</SgTypography>
                            @if (_selectedEmpIds.Any())
                            {
                                <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
                                    @foreach (var id in _selectedEmpIds)
                                    {
                                        var emp = _employees.FirstOrDefault(e => e.Id == id);
                                        if (emp is not null)
                                        {
                                            <SgBadge Text="@($"{emp.FirstName} {emp.LastName}")" Variant="SgBadgeVariant.Info" Standalone="true" Size="SgSize.Sm" />
                                        }
                                    }
                                </div>
                            }
                        </SgStack>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Md="6">
                    <SgCard Title="SgComboBoxEx" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        @{
                            var selEmp = _selectedEmpId.HasValue ? _employees.FirstOrDefault(e => e.Id == _selectedEmpId.Value) : null;
                        }
                        <SgComboBoxEx TItem="Employee" TKey="int?"
                                      Items="@_employees"
                                      @bind-Value="@_selectedEmpId"
                                      KeySelector="e => (int?)e.Id"
                                      LabelSelector="e => e.FirstName"
                                      ColumnsSelector="@(e => (IEnumerable<string>)new[] { e.FirstName, e.LastName, e.Department.ToString() })"
                                      ColumnNames="@(new[] { "Name", "Surname", "Department" })"
                                      Label="Pick an Employee"
                                      Placeholder="Type to search..."
                                      AllowClear="true" />
                        <SgSpace Size="SgSize.Sm" />
                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                            Selected: @(selEmp is not null ? $"{selEmp.FirstName} {selEmp.LastName}" : "-")
                        </SgTypography>
                    </SgCard>
                </SgCol>
            </SgRow>
            <SgSpace Size="SgSize.Md" />
            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="6">
                    <SgCard Title="SgMultiSelectEx Properties" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <PropertyTable Items="@_multiExProps" />
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Md="6">
                    <SgCard Title="SgComboBoxEx Properties" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <PropertyTable Items="@_comboExProps" />
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

        @* ── 5. Enum Support ─────────────────────────────────────────────── *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">Enum Support</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Pass <SgTypography As="SgTypographyElement.Code">EnumType</SgTypography> to auto-populate from any enum.
                    Uses <SgTypography As="SgTypographyElement.Code">[Display]</SgTypography> / <SgTypography As="SgTypographyElement.Code">[Description]</SgTypography> attributes.
                    <SgTypography As="SgTypographyElement.Code">EnumKeyMode</SgTypography> controls key format.
                </SgTypography>
            </div>
            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="4">
                    <SgCard Title="SgSelect with Enum" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <SgStack Vertical Space="SgSize.Md">
                            <SgSelect TValue="string"
                                      @bind-Value="@_enumSelName"
                                      EnumType="typeof(OrderStatus)"
                                      Label="Status (key = Name)"
                                      Placeholder="Select status..." />
                            <SgBadge Text="@(_enumSelName ?? "-")" Variant="SgBadgeVariant.Info" Standalone="true" />

                            <SgSelect TValue="string"
                                      @bind-Value="@_enumSelInt"
                                      EnumType="typeof(OrderStatus)"
                                      EnumKeyMode="SgEnumKeyMode.IntValue"
                                      Label="Status (key = IntValue)"
                                      Placeholder="Select status..." />
                            <SgBadge Text="@(_enumSelInt ?? "-")" Variant="SgBadgeVariant.Info" Standalone="true" />

                            <SgSelect TValue="OrderStatus"
                                      @bind-Value="@_enumSelTyped"
                                      EnumType="typeof(OrderStatus)"
                                      Label="Bound to OrderStatus enum"
                                      Placeholder="Select status..." />
                            <SgBadge Text="@_enumSelTyped.ToString()" Variant="SgBadgeVariant.Info" Standalone="true" />
                        </SgStack>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Md="4">
                    <SgCard Title="SgComboBox with Enum" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <SgStack Vertical Space="SgSize.Md">
                            <SgComboBox TValue="string"
                                        @bind-Value="@_enumComboName"
                                        EnumType="typeof(Priority)"
                                        Label="Priority (key = Name)"
                                        Placeholder="Select priority..."
                                        Editable="true" />
                            <SgBadge Text="@(_enumComboName ?? "-")" Variant="SgBadgeVariant.Info" Standalone="true" />

                            <SgComboBox TValue="string"
                                        @bind-Value="@_enumComboInt"
                                        EnumType="typeof(Priority)"
                                        EnumKeyMode="SgEnumKeyMode.IntValue"
                                        Label="Priority (key = IntValue)"
                                        Placeholder="Select priority..." />
                            <SgBadge Text="@(_enumComboInt ?? "-")" Variant="SgBadgeVariant.Info" Standalone="true" />

                            <SgComboBox TValue="Priority"
                                        @bind-Value="@_enumComboTyped"
                                        EnumType="typeof(Priority)"
                                        Label="Bound to Priority enum"
                                        Placeholder="Select priority..."
                                        AllowClear="true" />
                            <SgBadge Text="@_enumComboTyped.ToString()" Variant="SgBadgeVariant.Info" Standalone="true" />
                        </SgStack>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Md="4">
                    <SgCard Title="SgMultiSelect with Enum" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <SgStack Vertical Space="SgSize.Md">
                            <SgMultiSelect TItem="string" TKey="string"
                                           @bind-Values="@_enumMultiName"
                                           EnumType="typeof(Permission)"
                                           Label="Permissions (key = Name)"
                                           Placeholder="Select permissions..." />
                            <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
                                @if (_enumMultiName.Any())
                                {
                                    @foreach (var p in _enumMultiName)
                                    {
                                        <SgBadge Text="@p" Variant="SgBadgeVariant.Info" Standalone="true" Size="SgSize.Sm" />
                                    }
                                }
                                else
                                {
                                    <SgBadge Text="-" Variant="SgBadgeVariant.Default" Standalone="true" />
                                }
                            </div>
                            <SgSpace Size="SgSize.Sm" />
                            <SgMultiSelect TItem="string" TKey="string"
                                           @bind-Values="@_enumMultiInt"
                                           EnumType="typeof(Permission)"
                                           EnumKeyMode="SgEnumKeyMode.IntValue"
                                           Label="Permissions (key = IntValue)"
                                           Placeholder="Select permissions..." />
                            <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
                                @if (_enumMultiInt.Any())
                                {
                                    @foreach (var p in _enumMultiInt)
                                    {
                                        <SgBadge Text="@p" Variant="SgBadgeVariant.Info" Standalone="true" Size="SgSize.Sm" />
                                    }
                                }
                                else
                                {
                                    <SgBadge Text="-" Variant="SgBadgeVariant.Default" Standalone="true" />
                                }
                            </div>
                        </SgStack>
                    </SgCard>
                    <SgSpace Size="SgSize.Md" />
                    <SgCard Title="Enum Parameters" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <PropertyTable Items="@_enumProps" />
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

        @* ── 6. Live Constructor ─────────────────────────────────────────── *@
        <div class="demo-section">
            <SgCard>
            <ChildContent>
                <SgStack Vertical Space="SgSize.Md">
                    <div class="demo-section-header">
                        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">Live Constructor</SgTypography>
                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Tweak parameters and see the generated markup in real time.</SgTypography>
                    </div>

                    <SgRow Space="SgSize.Md">
                        @* Controls *@
                        <SgCol Xs="12" Md="5" Style="padding:16px;">
                            <SgStack Vertical Space="SgSize.Md">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Controls</SgTypography>

                                <div class="ctrl-summary">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size</SgTypography>
                                            <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorSize.ToString()" Standalone="true" />
                                        </SgStack>
                                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">AllowClear</SgTypography>
                                            <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorAllowClear.ToString()" Standalone="true" />
                                        </SgStack>
                                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">ShowSearch</SgTypography>
                                            <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorSearch.ToString()" Standalone="true" />
                                        </SgStack>
                                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Disabled</SgTypography>
                                            <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorDisabled.ToString()" Standalone="true" />
                                        </SgStack>
                                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Required</SgTypography>
                                            <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorRequired.ToString()" Standalone="true" />
                                        </SgStack>
                                    </SgStack>
                                </div>

                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                                <SgSegmented TValue="SgSize" Value="@_ctorSize" ValueChanged="v => { _ctorSize = v; UpdateCtorCode(); }" Block="true" Size="sm" Options="@_sizeSegOpts" />

                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">AllowClear</SgTypography>
                                <SgSegmented TValue="bool" Value="@_ctorAllowClear" ValueChanged="v => { _ctorAllowClear = v; UpdateCtorCode(); }" Block="true" Size="sm" Options="@_boolSegOpts" />

                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">ShowSearch</SgTypography>
                                <SgSegmented TValue="bool" Value="@_ctorSearch" ValueChanged="v => { _ctorSearch = v; UpdateCtorCode(); }" Block="true" Size="sm" Options="@_boolSegOpts" />

                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Disabled</SgTypography>
                                <SgSegmented TValue="bool" Value="@_ctorDisabled" ValueChanged="v => { _ctorDisabled = v; UpdateCtorCode(); }" Block="true" Size="sm" Options="@_boolSegOpts" />

                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Required</SgTypography>
                                <SgSegmented TValue="bool" Value="@_ctorRequired" ValueChanged="v => { _ctorRequired = v; UpdateCtorCode(); }" Block="true" Size="sm" Options="@_boolSegOpts" />
                            </SgStack>
                        </SgCol>

                        @* Preview + Code *@
                        <SgCol Xs="12" Md="7" Style="padding:24px;">
                            <SgStack Vertical Space="SgSize.Lg">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <div style="display:flex;align-items:center;justify-content:space-between;">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Preview</SgTypography>
                                    </div>
                                    <div class="constructor-preview">
                                        <SgSelect TValue="string"
                                                  Size="@_ctorSize"
                                                  AllowClear="@_ctorAllowClear"
                                                  ShowSearch="@_ctorSearch"
                                                  Disabled="@_ctorDisabled"
                                                  Required="@_ctorRequired"
                                                  Items="@_fruits"
                                                  Label="Live Select"
                                                  Placeholder="Configure me..." />
                                    </div>
                                </SgStack>

                                <SgStack Vertical Space="SgSize.Sm">
                                    <div style="display:flex;align-items:center;justify-content:space-between;">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                        <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCtorCode">
                                            <span id="ctor-copy-icon">@_copyIcon</span>
                                            <span id="ctor-copy-text" style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                        </button>
                                    </div>
                                    <div class="code-block" id="ctor-code-block">
                                        @foreach (var line in _ctorCodeLines)
                                        {
                                            <code>@line</code>
                                        }
                                    </div>
                                </SgStack>
                            </SgStack>
                        </SgCol>
                    </SgRow>
                </SgStack>
            </ChildContent>
            </SgCard>
        </div>

        @* ── 7. Code Examples ────────────────────────────────────────────── *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">Code Examples</SgTypography>
            </div>
            <SgStack Vertical Space="SgSize.Md">
                <DemoCodeBlock Code="@_basicSelectCode" Title="SgSelect basic usage" />
                <DemoCodeBlock Code="@_multiSelectCode" Title="SgMultiSelect with tags" />
                <DemoCodeBlock Code="@_comboBoxCode" Title="SgComboBox with search" />
                <DemoCodeBlock Code="@_exCode" Title="SgMultiSelectEx with multi-column" />
                <DemoCodeBlock Code="@_enumCode" Title="Enum support example" />
            </SgStack>
        </div>

        @* ── Enum Reference ──────────────────────────────────────────────── *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Bold">Enum Reference</SgTypography>
            </div>
            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Sm="6" Md="4">
                    <SgCard Title="OrderStatus" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <SgStack Vertical Space="SgSize.Sm">
                            @foreach (var s in Enum.GetValues<OrderStatus>())
                            {
                                <SgTypography Size="SgTypographySize.Sm">@s</SgTypography>
                            }
                        </SgStack>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Sm="6" Md="4">
                    <SgCard Title="Priority" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <SgStack Vertical Space="SgSize.Sm">
                            @foreach (var p in Enum.GetValues<Priority>())
                            {
                                <SgTypography Size="SgTypographySize.Sm">@p</SgTypography>
                            }
                        </SgStack>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Sm="6" Md="4">
                    <SgCard Title="DepartmentType" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <SgStack Vertical Space="SgSize.Sm">
                            @foreach (var d in Enum.GetValues<DepartmentType>())
                            {
                                <SgTypography Size="SgTypographySize.Sm">@d</SgTypography>
                            }
                        </SgStack>
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

    </SgStack>
</ChildContent>
</SgCard>

<style>
    .demo-section { margin-top: 48px; }
    .demo-section-header { margin-bottom: 20px; }
    .constructor-preview {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 16px;
        min-height: 72px;
        transition: all 0.3s ease;
    }
    .ctrl-summary {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 12px 14px;
    }
    .code-block {
        background: #0f172a;
        color: #7dd3fc;
        padding: 14px 16px;
        border-radius: 8px;
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 12px;
        line-height: 1.9;
        overflow-x: auto;
    }
    .code-block code {
        background: none;
        padding: 0;
        color: inherit;
        font-size: inherit;
        display: block;
        white-space: pre;
    }
    .demo-copy-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 6px;
        padding: 4px 10px;
        cursor: pointer;
        color: var(--sg-text-muted);
        transition: all 0.2s ease;
        font-family: inherit;
    }
    .demo-copy-btn:hover {
        color: var(--sg-color-primary);
        border-color: var(--sg-color-primary);
        background: color-mix(in srgb, var(--sg-color-primary) 8%, transparent);
    }
    .demo-copy-btn:active { transform: scale(0.95); }
    .demo-copy-btn.copied {
        color: var(--sg-color-success);
        border-color: var(--sg-color-success);
    }
    @@media (max-width: 640px) { .demo-section { margin-top: 32px; } }
</style>

@code {
    // ── Data ───────────────────────────────────────────────────────────────
    private List<string> _fruits = new() { "Apple", "Banana", "Cherry", "Grape", "Kiwi", "Lemon", "Mango", "Orange", "Peach", "Pear", "Plum", "Strawberry" };
    private List<string> _manyItems = new() { "Item 1", "Item 2", "Item 3", "Item 4", "Item 5", "Item 6", "Item 7", "Item 8", "Item 9", "Item 10" };

    private string? _selectVal1;
    private string? _selectReq;
    private string? _selectNoClear;

    private IEnumerable<string> _multiVals = new List<string>();
