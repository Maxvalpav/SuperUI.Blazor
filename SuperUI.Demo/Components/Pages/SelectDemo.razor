@page "/select-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models

<PageTitle>Select — SUI</PageTitle>

<SgCard Title="Компоненты выбора"
        Subtitle="SgSelect, SgMultiSelect, SgComboBoxEx, SgMultiSelectEx и поддержка Enum."
        CssClass="sgc-card-flush">

    @* ── SgSelect ─────────────────────────────────────────────────── *@
    <div class="sgc-demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading2">SgSelect</SgTypography>
            <span class="demo-live-badge">Интерактивный</span>
        </div>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" CssClass="demo-section-desc">Компонент для выбора одного значения из списка с поддержкой очистки.</SgTypography>

        <div class="demo-grid-adaptive">
            <SgCard Title="Примеры использования" CssClass="demo-interactive-card">
                <div class="demo-flex-col">
                    <SgSelect TValue="string" @bind-Value="@_selectValue"  Items="@_selectItems" Label="Выберите опцию"    Placeholder="Выберите..." AllowClear="true" />
                    <div class="demo-value-display">
                        <span class="demo-value-display-label">Выбрано</span>
                        <span class="demo-value-display-value">@(_selectValue ?? "—")</span>
                    </div>
                    <SgSelect TValue="string" @bind-Value="@_selectValue2" Items="@_selectItems" Label="Обязательное поле" Placeholder="Выберите..." Required="true" />
                    <SgSelect TValue="string" @bind-Value="@_selectValue3" Items="@_selectItems" Label="Отключённый"       Disabled="true" />
                    <SgDivider />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Размеры <SgTypography As="SgTypographyElement.Code">Size</SgTypography></SgTypography>
                    <div class="demo-flex-row" style="flex-wrap:wrap;gap:8px;align-items:start;">
                        <SgSelect TValue="string" Label="Small" Size="SgSize.Sm" Items="@_selectItems" Placeholder="sm" />
                        <SgSelect TValue="string" Label="Medium" Size="SgSize.Md" Items="@_selectItems" Placeholder="md" />
                        <SgSelect TValue="string" Label="Large" Size="SgSize.Lg" Items="@_selectItems" Placeholder="lg" />
                    </div>
                    <SgDivider />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)"><SgTypography As="SgTypographyElement.Code">AutoFocus</SgTypography> — фокус при загрузке</SgTypography>
                    <SgSelect TValue="string" @bind-Value="@_selectFocusValue" Items="@_selectItems" Label="Автофокус" AutoFocus="true" Placeholder="Автофокус..." AllowClear="true" />
                    <div class="demo-value-display">
                        <span class="demo-value-display-label">Выбрано (AutoFocus)</span>
                        <span class="demo-value-display-value">@(_selectFocusValue ?? "—")</span>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_selectProperties" />
            </SgCard>
        </div>
    </div>

    @* ── SgMultiSelect ────────────────────────────────────────────── *@
    <div class="sgc-demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading2">SgMultiSelect</SgTypography>
            <span class="demo-live-badge">Интерактивный</span>
        </div>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" CssClass="demo-section-desc">Компонент для выбора нескольких значений из списка.</SgTypography>

        <div class="demo-grid-adaptive">
            <SgCard Title="Примеры использования" CssClass="demo-interactive-card">
                <div class="demo-flex-col">
                    <SgMultiSelect TItem="string" TKey="string"
                                   @bind-Values="@_multiValues"
                                   Items="@_selectItems"
                                   KeySelector="s => s"
                                   Label="Выберите несколько"
                                   Placeholder="Выберите..." />
                    <div class="demo-value-display">
                        <span class="demo-value-display-label">Выбрано</span>
                        <span class="demo-value-display-value">@(_multiValues.Any() ? string.Join(", ", _multiValues) : "—")</span>
                    </div>

                    <SgMultiSelect TItem="string" TKey="string"
                                   @bind-Values="@_multiValuesClear"
                                   Items="@_selectItems"
                                   KeySelector="s => s"
                                   Label="С очисткой (AllowClear)"
                                   Placeholder="Выберите..."
                                   AllowClear="true" />
                    <div class="demo-value-display">
                        <span class="demo-value-display-label">Выбрано (AllowClear)</span>
                        <span class="demo-value-display-value">@(_multiValuesClear.Any() ? string.Join(", ", _multiValuesClear) : "—")</span>
                    </div>

                    <SgMultiSelect TItem="string" TKey="string"
                                   @bind-Values="@_multiValues2"
                                   Items="@_selectItems"
                                   KeySelector="s => s"
                                   Label="Отключённый"
                                   Disabled="true" />
                    <SgDivider />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Размеры <SgTypography As="SgTypographyElement.Code">Size</SgTypography></SgTypography>
                    <div class="demo-flex-row" style="flex-wrap:wrap;gap:8px;align-items:start;">
                        <SgMultiSelect TItem="string" TKey="string" Items="@_selectItems" KeySelector="s => s" Label="Small" Size="SgSize.Sm" Placeholder="sm" />
                        <SgMultiSelect TItem="string" TKey="string" Items="@_selectItems" KeySelector="s => s" Label="Medium" Size="SgSize.Md" Placeholder="md" />
                        <SgMultiSelect TItem="string" TKey="string" Items="@_selectItems" KeySelector="s => s" Label="Large" Size="SgSize.Lg" Placeholder="lg" />
                    </div>
                    <SgDivider />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)"><SgTypography As="SgTypographyElement.Code">MaxDisplayedTags</SgTypography> — "+N more" при превышении</SgTypography>
                    <SgMultiSelect TItem="string" TKey="string"
                                   @bind-Values="@_multiOverflow"
                                   Items="@_manyItems"
                                   KeySelector="s => s"
                                   Label="Много значений"
                                   Placeholder="Выберите..."
                                   MaxDisplayedTags="3" />
                    <div class="demo-value-display">
                        <span class="demo-value-display-label">Выбрано</span>
                        <span class="demo-value-display-value">@(_multiOverflow.Any() ? string.Join(", ", _multiOverflow) : "—")</span>
                    </div>
                    <SgDivider />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)"><SgTypography As="SgTypographyElement.Code">AutoFocus</SgTypography> + Select All</SgTypography>
                    <SgMultiSelect TItem="string" TKey="string"
                                   @bind-Values="@_multiAutoFocus"
                                   Items="@_selectItems"
                                   KeySelector="s => s"
                                   Label="Автофокус + Select All"
                                   Placeholder="Откройте и нажмите Select All..."
                                   AutoFocus="true"
                                   AllowClear="true" />
                    <div class="demo-value-display">
                        <span class="demo-value-display-label">Выбрано (AutoFocus)</span>
                        <span class="demo-value-display-value">@(_multiAutoFocus.Any() ? string.Join(", ", _multiAutoFocus) : "—")</span>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_multiSelectProperties" />
            </SgCard>
        </div>
    </div>

    @* ── Extended components ──────────────────────────────────────── *@
    <div class="sgc-demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading2">Расширенные компоненты выбора (Ex)</SgTypography>
        </div>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" CssClass="demo-section-desc">Компоненты с поддержкой множества колонок, поиска и гибкого расположения меток.</SgTypography>

        <div class="demo-flex-col">
            <SgCard Title="SgMultiSelectEx & SgComboBoxEx">
                <div class="demo-flex-col">
                    <SgMultiSelectEx TItem="Employee" TKey="int"
                                     Items="@_employees"
                                     @bind-Values="@_selectedEmployeeIds"
                                     KeySelector="e => e.Id"
                                     LabelSelector="e => e.FirstName"
                                     ColumnsSelector="@(e => (IEnumerable<string>)new[] { e.FirstName, e.LastName, e.Department.ToString() })"
                                     ColumnNames="@(new[] { "Имя", "Фамилия", "Отдел" })"
                                     Label="Множественный выбор"
                                     Placeholder="Выберите сотрудников..." />

                    <SgComboBoxEx TItem="Employee" TKey="int?"
                                   Items="@_employees"
                                   @bind-Value="@_selectedEmployeeId"
                                   KeySelector="e => (int?)e.Id"
                                   LabelSelector="e => e.FirstName"
                                   ColumnsSelector="@(e => (IEnumerable<string>)new[] { e.FirstName, e.LastName, e.Department.ToString() })"
                                   ColumnNames="@(new[] { "Имя", "Фамилия", "Отдел" })"
                                   Label="Одиночный выбор (Ex)"
                                   Placeholder="Выберите одного сотрудника..."
                                   AllowClear="true" />
                </div>
            </SgCard>

            <SgCard Title="Расположение меток (LabelPosition)">
                <div class="demo-grid-two-col">
                    <div class="demo-flex-col">
                        <SgTextBox TValue="string" Label="Метка сверху" LabelPosition="SgLabelPosition.Top" Placeholder="Введите текст..." />
                        <SgTextBox TValue="string" Label="Метка слева" LabelPosition="SgLabelPosition.Left" Placeholder="Введите текст..." />
                    </div>
                    <div class="demo-flex-col">
                        <SgTextBox TValue="string" Label="Метка справа" LabelPosition="SgLabelPosition.Right" Placeholder="Введите текст..." />
                        <SgSelect TValue="string" Label="Селект слева" LabelPosition="SgLabelPosition.Left" Items="@_selectItems" Placeholder="Выберите..." />
                    </div>
                </div>
            </SgCard>
        </div>
    </div>

    @* ── Enum support ─────────────────────────────────────────────── *@
    <div class="sgc-demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading2">Enum-поддержка</SgTypography>
        </div>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" CssClass="demo-section-desc">
            Параметр <SgTypography As="SgTypographyElement.Code">EnumType</SgTypography> автоматически заполняет список из любого enum.
            Атрибуты <SgTypography As="SgTypographyElement.Code">[Display]</SgTypography> и <SgTypography As="SgTypographyElement.Code">[Description]</SgTypography> используются как метки.
            <SgTypography As="SgTypographyElement.Code">EnumKeyMode</SgTypography> определяет, что хранится как ключ — имя члена или целочисленное значение.
        </SgTypography>

        <div class="demo-grid-two-col">
            <SgCard Title="SgSelect — из enum">
                <div class="demo-flex-col">
                    <SgSelect TValue="string"
                              @bind-Value="_enumSelectName"
                              EnumType="typeof(OrderStatus)"
                              Label="Статус заказа (ключ = Name)"
                              Placeholder="Выберите статус..."
                              AllowClear="true" />
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Выбрано: @(_enumSelectName ?? "—")</SgTypography>

                    <SgSelect TValue="string"
                              @bind-Value="_enumSelectInt"
                              EnumType="typeof(OrderStatus)"
                              EnumKeyMode="SgEnumKeyMode.IntValue"
                              Label="Статус заказа (ключ = IntValue)"
                              Placeholder="Выберите статус..."
                              AllowClear="true" />
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Выбрано: @(_enumSelectInt ?? "—")</SgTypography>

                    <SgSelect TValue="OrderStatus"
                              @bind-Value="_enumSelectTyped"
                              EnumType="typeof(OrderStatus)"
                              Label="Привязка к типу enum (OrderStatus)"
                              Placeholder="Выберите статус..."
                              AllowClear="true" />
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Выбрано: @_enumSelectTyped</SgTypography>
                </div>
            </SgCard>

            <SgCard Title="SgComboBox — из enum (с поиском)">
                <div class="demo-flex-col">
                    <SgComboBox TValue="string"
                                @bind-Value="_enumComboName"
                                EnumType="typeof(Priority)"
                                Label="Приоритет (ключ = Name)"
                                Placeholder="Выберите приоритет..."
                                Editable="true" />
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Выбрано: @(_enumComboName ?? "—")</SgTypography>

                    <SgComboBox TValue="string"
                                @bind-Value="_enumComboInt"
                                EnumType="typeof(Priority)"
                                EnumKeyMode="SgEnumKeyMode.IntValue"
                                Label="Приоритет (ключ = IntValue)"
                                Placeholder="Выберите приоритет..."
                                Editable="true" />
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Выбрано: @(_enumComboInt ?? "—")</SgTypography>

                    <SgComboBox TValue="Priority"
                                @bind-Value="_enumComboTyped"
                                EnumType="typeof(Priority)"
                                Label="Привязка к типу enum (Priority)"
                                Placeholder="Выберите приоритет..."
                                AllowClear="true" />
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Выбрано: @_enumComboTyped</SgTypography>
                </div>
            </SgCard>

            <SgCard Title="SgMultiSelect — из enum">
                <div class="demo-flex-col">
                    <SgMultiSelect TItem="string" TKey="string"
                                   @bind-Values="_enumMultiName"
                                   EnumType="typeof(Permission)"
                                   Label="Права доступа (ключ = Name)"
                                   Placeholder="Выберите права..." />
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                        Выбрано: @(string.Join(", ", _enumMultiName.Any() ? _enumMultiName : new[] { "—" }))
                    </SgTypography>

                    <SgMultiSelect TItem="string" TKey="string"
                                   @bind-Values="_enumMultiInt"
                                   EnumType="typeof(Permission)"
                                   EnumKeyMode="SgEnumKeyMode.IntValue"
                                   Label="Права доступа (ключ = IntValue)"
                                   Placeholder="Выберите права..." />
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                        Выбрано: @(string.Join(", ", _enumMultiInt.Any() ? _enumMultiInt : new[] { "—" }))
                    </SgTypography>
                </div>
            </SgCard>

            <SgCard Title="Параметры EnumType">
                <PropertyTable Items="_enumProperties" />
            </SgCard>
        </div>
    </div>

</SgCard>

<style>
    .sgc-card-flush > .sgc-card-body {
        padding: 0 24px 24px;
    }
    @@media (max-width: 640px) {
        .sgc-card-flush > .sgc-card-body {
            padding: 0 12px 12px;
        }
    }
</style>

@code {
    // Select
    private string? _selectValue;
    private string? _selectValue2;
    private string? _selectValue3;
    private string? _selectFocusValue;
    private List<string> _selectItems = new() { "Вариант 1", "Вариант 2", "Вариант 3", "Вариант 4" };

    // MultiSelect
    private IEnumerable<string> _multiValues = new List<string>();
    private IEnumerable<string> _multiValuesClear = new List<string> { "Вариант 1", "Вариант 2" };
    private IEnumerable<string> _multiValues2 = new List<string> { "Вариант 1", "Вариант 3" };
    private IEnumerable<string> _multiOverflow = new List<string> { "Вариант 1", "Вариант 2", "Вариант 3", "Вариант 4" };
    private IEnumerable<string> _multiAutoFocus = new List<string>();
    private List<string> _manyItems = new() { "Вариант 1", "Вариант 2", "Вариант 3", "Вариант 4", "Вариант 5", "Вариант 6", "Вариант 7" };

    // MultiSelectEx
    private List<Employee> _employees = new();
    private IEnumerable<int> _selectedEmployeeIds = new List<int>();
    private int? _selectedEmployeeId;

    protected override void OnInitialized()
    {
        _employees = new List<Employee>
        {
            new() { Id = 1, FirstName = "Иван", LastName = "Иванов", Department = DepartmentType.Engineering },
            new() { Id = 2, FirstName = "Петр", LastName = "Петров", Department = DepartmentType.HR },
            new() { Id = 3, FirstName = "Сергей", LastName = "Сидоров", Department = DepartmentType.Marketing },
            new() { Id = 4, FirstName = "Алексей", LastName = "Алексеев", Department = DepartmentType.Engineering },
            new() { Id = 5, FirstName = "Дмитрий", LastName = "Дмитриев", Department = DepartmentType.Product }
        };
    }

    // Enum-bound values
    private string? _enumSelectName;
    private string? _enumSelectInt;
    private OrderStatus _enumSelectTyped;

    private string? _enumComboName;
    private string? _enumComboInt;
    private Priority _enumComboTyped;

    private IEnumerable<string> _enumMultiName = new List<string>();
    private IEnumerable<string> _enumMultiInt  = new List<string>();

    private List<PropertyPanelItem> _selectProperties = new()
    {
        new() { Label = "Value", Value = "TValue", BadgeText = "Значение", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Items", Value = "IEnumerable&lt;TValue&gt;", BadgeText = "Элементы", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Label", Value = "string", BadgeText = "Метка", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Placeholder", Value = "string", BadgeText = "Подсказка", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "LabelSelector", Value = "Func&lt;TValue, string&gt;", BadgeText = "Метка элемента", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "AllowClear", Value = "bool", BadgeText = "Очистить", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Required", Value = "bool", BadgeText = "Обязательное", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Disabled", Value = "bool", BadgeText = "Отключить", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Size", Value = "Sm | Md | Lg", BadgeText = "Размер", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "AutoFocus", Value = "bool", BadgeText = "Автофокус", BadgeVariant = SgBadgeVariant.Warn }
    };

    private List<PropertyPanelItem> _multiSelectProperties = new()
    {
        new() { Label = "Values", Value = "IEnumerable&lt;TValue&gt;", BadgeText = "Значения", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Items", Value = "IEnumerable&lt;TValue&gt;", BadgeText = "Элементы", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Label", Value = "string", BadgeText = "Метка", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Placeholder", Value = "string", BadgeText = "Подсказка", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "LabelSelector", Value = "Func&lt;TValue, string&gt;", BadgeText = "Метка элемента", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Size", Value = "Sm | Md | Lg", BadgeText = "Размер", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "AllowClear", Value = "bool", BadgeText = "Очистить", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "MaxDisplayedTags", Value = "int", BadgeText = "Макс. тегов", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "AutoFocus", Value = "bool", BadgeText = "Автофокус", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "SearchDebounceMs", Value = "int (300)", BadgeText = "Задержка поиска", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Required", Value = "bool", BadgeText = "Обязательное", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Disabled", Value = "bool", BadgeText = "Отключить", BadgeVariant = SgBadgeVariant.Warn }
    };

    private List<PropertyPanelItem> _enumProperties = new()
    {
        new() { Label = "EnumType",    Value = "Type?",          BadgeText = "Тип enum",          BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "EnumKeyMode", Value = "Name | IntValue", BadgeText = "Ключ",              BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "[Display]",   Value = "Name, Description, GroupName, Order", BadgeText = "Атрибут", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "[Description]", Value = "string",       BadgeText = "Атрибут",           BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "TValue",      Value = "string | int | TEnum", BadgeText = "Тип значения", BadgeVariant = SgBadgeVariant.Info   },
    };
}
