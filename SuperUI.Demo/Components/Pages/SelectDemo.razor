@page "/demo/select"
@using SuperUI.Demo.Components

<div class="demo-page">
    <div class="demo-hero">
        <section class="demo-hero-main">
            <div class="demo-header">
                <div class="demo-kicker">Input Components</div>
                <h1 class="demo-title">SgSelect</h1>
                <p class="demo-subtitle">
                    Select component for constrained choices with support for enums, custom label mapping,
                    placeholders and validation-aware forms.
                </p>
            </div>
        </section>

        <aside class="demo-hero-side">
            <div class="demo-side-title">Highlights</div>
            <div class="demo-pill-list">
                <span class="demo-pill demo-pill-accent">Enum Mode</span>
                <span class="demo-pill">Placeholder</span>
                <span class="demo-pill">Custom Labels</span>
                <span class="demo-pill">Form Ready</span>
            </div>

            <div class="demo-meta-grid">
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Sources</span>
                    <span class="demo-meta-value">Plain items, enums, mapped values</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Scenarios</span>
                    <span class="demo-meta-value">Status pickers, workflow steps, filters</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Accessibility</span>
                    <span class="demo-meta-value">Labeled, required and validation-aware</span>
                </div>
            </div>
        </aside>
    </div>

    <SgDemoSection Eyebrow="Usage" Title="Examples" Description="Selection patterns for forms, filters and system settings.">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Basic Items</h3>
                    <p class="demo-showcase-desc">Use a simple item collection when options are already strongly typed.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgSelect TValue="string"
                                  @bind-Value="_region"
                                  Label="Region"
                                  Placeholder="Select a region"
                                  Items="_regions"
                                  AllowClear="true" />
                        <div class="demo-inline-value">Selected: @(_region ?? "none")</div>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Enum Mode</h3>
                    <p class="demo-showcase-desc">Generate options from enum metadata without manual lists.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgSelect TValue="DeploymentTier"
                                  @bind-Value="_tier"
                                  Label="Deployment Tier"
                                  EnumType="typeof(DeploymentTier)"
                                  Placeholder="Choose tier" />
                        <div class="demo-inline-value">Selected: @_tier</div>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Custom Labels</h3>
                    <p class="demo-showcase-desc">Map complex items to clean display text and stable keys.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgSelect TValue="ProjectOption"
                                  @bind-Value="_selectedProject"
                                  Label="Project"
                                  Items="_projects"
                                  LabelSelector="@(p => $"{p.Code} - {p.Name}")"
                                  ValueSelector="@(p => p.Id)"
                                  Placeholder="Choose project" />
                    </div>
                    <div class="demo-note">Use selectors when UI labels and persisted keys must differ.</div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Disabled And Required</h3>
                    <p class="demo-showcase-desc">Useful for dependent inputs or locked configuration screens.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgSelect TValue="string" Label="Required" Required="true" Items="_regions" Value="_regions[0]" />
                        <SgSelect TValue="string" Label="Disabled" Disabled="true" Items="_regions" Value="_regions[1]" />
                    </div>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoParams Title="Select Parameters" Description="Parameters for customizing the appearance and behavior of the SgSelect component.">
        <SgDemoParam Name="Items" Type="IEnumerable&lt;TValue&gt;" Description="Collection of selectable items." DefaultValue="Empty collection" />
        <SgDemoParam Name="EnumType" Type="Type" Description="Optional enum source used instead of Items." DefaultValue="null" />
        <SgDemoParam Name="EnumKeyMode" Type="SgEnumKeyMode" Description="Determines whether enum values use names or integer keys." Values="Name, IntValue" DefaultValue="Name" />
        <SgDemoParam Name="LabelSelector" Type="Func&lt;TValue, string&gt;" Description="Maps an item to display text." DefaultValue="null" />
        <SgDemoParam Name="ValueSelector" Type="Func&lt;TValue, object&gt;" Description="Maps an item to a stable option key." DefaultValue="null" />
        <SgDemoParam Name="Placeholder" Type="string" Description="Placeholder option displayed when no value is selected." DefaultValue="null" />
        <SgDemoParam Name="AllowClear" Type="bool" Description="Allows clearing selection through the placeholder option." Values="true, false" DefaultValue="false" />
        <SgDemoParam Name="Required" Type="bool" Description="Marks the field as required for forms." Values="true, false" DefaultValue="false" />
        <SgDemoParam Name="Disabled" Type="bool" Description="Disables user interaction." Values="true, false" DefaultValue="false" />
        <SgDemoParam Name="Label" Type="string" Description="Field label shown above the select." DefaultValue="null" />
    </SgDemoParams>
</div>

@code {
    private readonly string[] _regions = ["North America", "Europe", "Asia Pacific", "Latin America"];
    private readonly ProjectOption[] _projects =
    [
        new("p-001", "PRJ-001", "Customer Portal"),
        new("p-002", "PRJ-002", "Billing Engine"),
        new("p-003", "PRJ-003", "Operations Dashboard")
    ];

    private string? _region = "Europe";
    private DeploymentTier _tier = DeploymentTier.Production;
    private ProjectOption? _selectedProject;

    private enum DeploymentTier
    {
        Development,
        Staging,
        Production
    }

    private sealed record ProjectOption(string Id, string Code, string Name);
}
