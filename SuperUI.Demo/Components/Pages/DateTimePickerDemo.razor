@page "/date-time-picker-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models

<SgCard Title="Date &amp; Time Pickers"
        Subtitle="Date pickers, time pickers, date range pickers, and color pickers."
        CssClass="sgc-card-flush">

    @* ── SgDatePicker ─────────────────────────────────────────────── *@
    <div class="sgc-demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading2">SgDatePicker</SgTypography>
            <span class="demo-live-badge">Интерактивный</span>
        </div>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" CssClass="demo-section-desc">Компонент для выбора одной даты с календарём.</SgTypography>

        <div class="demo-grid-adaptive">
            <SgCard Title="Примеры использования" CssClass="demo-interactive-card">
                <div class="demo-flex-col">
                    <SgDatePicker @bind-Value="@_date1" Label="Выберите дату" Placeholder="ДД.ММ.ГГГГ" />
                    <div class="demo-value-display">
                        <span class="demo-value-display-label">Выбрано</span>
                        <span class="demo-value-display-value">@(_date1?.ToString("dd.MM.yyyy") ?? "—")</span>
                    </div>
                    <SgDatePicker @bind-Value="@_date2" Label="С предустановкой" />
                    <SgDatePicker @bind-Value="@_date3" Label="С ограничениями" Min="@_minDate" Max="@_maxDate" />
                    <SgDatePicker @bind-Value="@_date4" Label="Отключённый" Disabled="true" />
                    <SgDivider />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Дополнительные опции</SgTypography>
                    <SgDatePicker @bind-Value="@_date5" Label="С футером (Сегодня/Очистить)" ShowFooter="true" />
                    <SgDatePicker @bind-Value="@_date6" Label="Годовая навигация (10 лет)" YearRange="10" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_datePickerProperties" />
            </SgCard>
        </div>

        <div style="margin-top:16px;">
            <pre class="demo-code-block"><span class="demo-code-comment">&lt;!-- SgDatePicker --&gt;</span>
<span class="demo-code-keyword">&lt;SgDatePicker</span> <span class="demo-code-attr">@@bind-Value</span>=<span class="demo-code-string">"@@_myDate"</span>
             <span class="demo-code-attr">Label</span>=<span class="demo-code-string">"Выберите дату"</span>
             <span class="demo-code-attr">Placeholder</span>=<span class="demo-code-string">"ДД.ММ.ГГГГ"</span> <span class="demo-code-keyword">/&gt;</span>
<span class="demo-code-comment">&lt;!-- With footer and year range --&gt;</span>
<span class="demo-code-keyword">&lt;SgDatePicker</span> <span class="demo-code-attr">@@bind-Value</span>=<span class="demo-code-string">"@@_myDate"</span>
             <span class="demo-code-attr">ShowFooter</span>=<span class="demo-code-string">"true"</span>
             <span class="demo-code-attr">YearRange</span>=<span class="demo-code-string">"10"</span> <span class="demo-code-keyword">/&gt;</span></pre>
        </div>
    </div>

    @* ── SgTimePicker ─────────────────────────────────────────────── *@
    <div class="sgc-demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading2">SgTimePicker</SgTypography>
            <span class="demo-live-badge">Интерактивный</span>
        </div>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" CssClass="demo-section-desc">Компонент для выбора времени (часы, минуты, секунды).</SgTypography>

        <div class="demo-grid-adaptive">
            <SgCard Title="Примеры использования" CssClass="demo-interactive-card">
                <div class="demo-flex-col">
                    <SgTimePicker @bind-Value="@_time1" Label="Простой выбор" Placeholder="--:--" />
                    <div class="demo-value-display">
                        <span class="demo-value-display-label">Выбрано</span>
                        <span class="demo-value-display-value">@(_time1?.ToString(@"hh\:mm") ?? "—")</span>
                    </div>
                    <SgTimePicker @bind-Value="@_time2" Label="С секундами" ShowSeconds="true" />
                    <SgTimePicker @bind-Value="@_time3" Label="Метка слева" LabelPosition="SgLabelPosition.Left" />
                    <SgDivider />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Размеры <SgTypography As="SgTypographyElement.Code">Size</SgTypography></SgTypography>
                    <div class="demo-flex-row" style="flex-wrap:wrap;gap:8px;align-items:start;">
                        <SgTimePicker @bind-Value="@_time4" Label="Small" Size="SgSize.Sm" />
                        <SgTimePicker @bind-Value="@_time5" Label="Medium" Size="SgSize.Md" />
                        <SgTimePicker @bind-Value="@_time6" Label="Large" Size="SgSize.Lg" />
                    </div>
                    <SgDivider />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Новые возможности</SgTypography>
                    <SgTimePicker @bind-Value="@_time7" Label="Формат (HH mm)" Format="HH\:mm" />
                    <SgTimePicker @bind-Value="@_time8" Label="Прямой ввод" AllowInput="true" />
                    <SgTimePicker @bind-Value="@_time9" Label="С кнопкой Now" ShowNow="true" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_timePickerProperties" />
            </SgCard>
        </div>

        <div style="margin-top:16px;">
            <pre class="demo-code-block"><span class="demo-code-comment">&lt;!-- SgTimePicker --&gt;</span>
<span class="demo-code-keyword">&lt;SgTimePicker</span> <span class="demo-code-attr">@@bind-Value</span>=<span class="demo-code-string">"@@_myTime"</span>
             <span class="demo-code-attr">Label</span>=<span class="demo-code-string">"Выберите время"</span> <span class="demo-code-keyword">/&gt;</span>
<span class="demo-code-keyword">&lt;SgTimePicker</span> <span class="demo-code-attr">@@bind-Value</span>=<span class="demo-code-string">"@@_myTime"</span>
             <span class="demo-code-attr">Label</span>=<span class="demo-code-string">"С секундами"</span>
             <span class="demo-code-attr">ShowSeconds</span>=<span class="demo-code-string">"true"</span> <span class="demo-code-keyword">/&gt;</span></pre>
        </div>
    </div>

    @* ── SgDateRangePicker ────────────────────────────────────────── *@
    <div class="sgc-demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading2">SgDateRangePicker</SgTypography>
            <span class="demo-live-badge">Интерактивный</span>
        </div>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" CssClass="demo-section-desc">Компонент для выбора диапазона дат (начальная и конечная дата).</SgTypography>

        <div class="demo-grid-adaptive">
            <SgCard Title="Примеры использования" CssClass="demo-interactive-card">
                <div class="demo-flex-col">
                    <SgDateRangePicker @bind-StartValue="@_rangeStart1" @bind-EndValue="@_rangeEnd1"
                                       Label="Выберите период"
                                       StartPlaceholder="Начало"
                                       EndPlaceholder="Конец" />
                    <div class="demo-value-display">
                        <span class="demo-value-display-label">Диапазон</span>
                        <span class="demo-value-display-value">@(_rangeStart1?.ToString("dd.MM") ?? "?") — @(_rangeEnd1?.ToString("dd.MM") ?? "?")</span>
                    </div>
                    <SgDateRangePicker @bind-StartValue="@_rangeStart2" @bind-EndValue="@_rangeEnd2"
                                       Label="С предустановкой" />
                    <SgDateRangePicker @bind-StartValue="@_rangeStart3" @bind-EndValue="@_rangeEnd3"
                                       Label="Отключённый"
                                       Disabled="true" />
                    <SgDivider />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Новые возможности</SgTypography>
                    <SgDateRangePicker @bind-StartValue="@_rangeStart4" @bind-EndValue="@_rangeEnd4"
                                       Label="Макс. 7 дней"
                                       MaxDateRange="@TimeSpan.FromDays(7)" />
                    <SgDateRangePicker @bind-StartValue="@_rangeStart5" @bind-EndValue="@_rangeEnd5"
                                       Label="ПН как первый день"
                                       FirstDayOfWeek="DayOfWeek.Monday" />
                    <SgDateRangePicker @bind-StartValue="@_rangeStart6" @bind-EndValue="@_rangeEnd6"
                                       Label="Только чтение"
                                       ReadOnly="true" />
                    <SgDivider />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Размеры <SgTypography As="SgTypographyElement.Code">Size</SgTypography></SgTypography>
                    <div class="demo-flex-row" style="flex-wrap:wrap;gap:8px;align-items:start;">
                        <SgDateRangePicker @bind-StartValue="@_rangeStart7" @bind-EndValue="@_rangeEnd7" Size="SgSize.Sm" Label="Small" />
                        <SgDateRangePicker @bind-StartValue="@_rangeStart8" @bind-EndValue="@_rangeEnd8" Size="SgSize.Md" Label="Medium" />
                        <SgDateRangePicker @bind-StartValue="@_rangeStart9" @bind-EndValue="@_rangeEnd9" Size="SgSize.Lg" Label="Large" />
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_dateRangePickerProperties" />
            </SgCard>
        </div>

        <div style="margin-top:16px;">
            <pre class="demo-code-block"><span class="demo-code-comment">&lt;!-- SgDateRangePicker --&gt;</span>
<span class="demo-code-keyword">&lt;SgDateRangePicker</span>
    <span class="demo-code-attr">@@bind-StartValue</span>=<span class="demo-code-string">"@@_start"</span>
    <span class="demo-code-attr">@@bind-EndValue</span>=<span class="demo-code-string">"@@_end"</span>
    <span class="demo-code-attr">Label</span>=<span class="demo-code-string">"Выберите период"</span>
    <span class="demo-code-attr">StartPlaceholder</span>=<span class="demo-code-string">"Начало"</span>
    <span class="demo-code-attr">EndPlaceholder</span>=<span class="demo-code-string">"Конец"</span> <span class="demo-code-keyword">/&gt;</span></pre>
        </div>
    </div>

    @* ── SgColorPicker ────────────────────────────────────────────── *@
    <div class="sgc-demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading2">SgColorPicker</SgTypography>
            <span class="demo-live-badge">Интерактивный</span>
        </div>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" CssClass="demo-section-desc">Компонент для выбора цвета в формате HEX.</SgTypography>

        <div class="demo-grid-adaptive">
            <SgCard Title="Примеры использования" CssClass="demo-interactive-card">
                <div class="demo-flex-col">
                    <SgColorPicker @bind-Value="@_color1" Label="Основной цвет" />
                    <SgColorPicker @bind-Value="@_color2" Label="Вторичный цвет" />
                    <div class="demo-color-swatch-group">
                        <div class="demo-color-swatch" style="background:@_color1;"></div>
                        <div class="demo-color-swatch" style="background:@_color2;"></div>
                        <div class="demo-value-display">
                            <span class="demo-value-display-label">HEX</span>
                            <span class="demo-value-display-value">@_color1</span>
                        </div>
                        <div class="demo-value-display">
                            <span class="demo-value-display-label">HEX</span>
                            <span class="demo-value-display-value">@_color2</span>
                        </div>
                    </div>
                    <SgDivider />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Размеры и опции</SgTypography>
                    <div class="demo-flex-row" style="flex-wrap:wrap;gap:8px;align-items:start;">
                        <SgColorPicker @bind-Value="@_color3" Label="Small" Size="SgSize.Sm" />
                        <SgColorPicker @bind-Value="@_color4" Label="Medium" Size="SgSize.Md" />
                        <SgColorPicker @bind-Value="@_color5" Label="Large" Size="SgSize.Lg" />
                    </div>
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" CssClass="demo-mt-2">Без HEX ввода / без кнопки копирования</SgTypography>
                    <div class="demo-flex-row" style="flex-wrap:wrap;gap:8px;align-items:start;">
                        <SgColorPicker @bind-Value="@_color6" Label="Без HEX" ShowHexInput="false" />
                        <SgColorPicker @bind-Value="@_color7" Label="Без Copy" ShowCopyButton="false" />
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_colorPickerProperties" />
            </SgCard>
        </div>

        <div style="margin-top:16px;">
            <pre class="demo-code-block"><span class="demo-code-comment">&lt;!-- SgColorPicker --&gt;</span>
<span class="demo-code-keyword">&lt;SgColorPicker</span> <span class="demo-code-attr">@@bind-Value</span>=<span class="demo-code-string">"@@_myColor"</span>
              <span class="demo-code-attr">Label</span>=<span class="demo-code-string">"Основной цвет"</span> <span class="demo-code-keyword">/&gt;</span>
<span class="demo-code-keyword">&lt;SgColorPicker</span> <span class="demo-code-attr">@@bind-Value</span>=<span class="demo-code-string">"@@_myColor"</span>
              <span class="demo-code-attr">Size</span>=<span class="demo-code-string">"SgSize.Lg"</span>
              <span class="demo-code-attr">ShowHexInput</span>=<span class="demo-code-string">"false"</span>
              <span class="demo-code-attr">ShowCopyButton</span>=<span class="demo-code-string">"false"</span> <span class="demo-code-keyword">/&gt;</span></pre>
        </div>
    </div>

</SgCard>

<style>
    .sgc-card-flush > .sgc-card-body {
        padding: 0 24px 24px;
    }
    @@media (max-width: 640px) {
        .sgc-card-flush > .sgc-card-body {
            padding: 0 12px 12px;
        }
    }
    .demo-mt-2 { margin-top: 8px; }
</style>

