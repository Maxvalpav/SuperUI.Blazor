@page "/date-time-picker-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models
@using System.Globalization

<PageTitle>Date & Time Pickers — SUI</PageTitle>

<SgCard>
<ChildContent>
    <SgStack Vertical Space="SgSize.Lg">

        @* ── Header ──────────────────────────────────────────────────────── *@
        <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:8px;">
            <div style="display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,var(--sg-color-primary),#8b5cf6);color:#fff;flex-shrink:0;">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
            </div>
            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                <SgTypography Variant="SgTypographyVariant.Heading3" Weight="SgTypographyWeight.Bold">Date &amp; Time Pickers</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    SgDatePicker, SgTimePicker, SgDateRangePicker, SgColorPicker — modern date/time/color inputs with popup calendars, clock faces, range selection, color swatches, and full validation.
                </SgTypography>
            </SgStack>
        </div>

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* 1. SgDatePicker                                                    *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">SgDatePicker</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Single-date selector with a popup calendar, month/year drill-down, min/max constraints, and optional footer.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="8">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgCard Title="Examples" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                            <SgRow Space="SgSize.Md">
                                <SgCol Xs="12" Sm="6">
                                    <SgDatePicker @bind-Value="@_date1" Label="Standard" Placeholder="Pick a date" AllowClear="true" />
                                    <div style="display:flex;align-items:center;gap:8px;margin-top:6px;">
                                        <SgBadge Text="Selected:" Variant="SgBadgeVariant.Muted" Standalone="true" Size="SgSize.Sm" />
                                        <SgBadge Text="@(_date1?.ToString("d") ?? "—")" Variant="SgBadgeVariant.Info" Standalone="true" Size="SgSize.Sm" />
                                    </div>
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgDatePicker @bind-Value="@_date2" Label="With preset" />
                                    <div style="display:flex;align-items:center;gap:8px;margin-top:6px;">
                                        <SgBadge Text="Selected:" Variant="SgBadgeVariant.Muted" Standalone="true" Size="SgSize.Sm" />
                                        <SgBadge Text="@(_date2?.ToString("d") ?? "—")" Variant="SgBadgeVariant.Info" Standalone="true" Size="SgSize.Sm" />
                                    </div>
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgDatePicker @bind-Value="@_date3" Label="With constraints" Min="@_minDate" Max="@_maxDate" />
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgDatePicker @bind-Value="@_date4" Label="Disabled" Disabled="true" />
                                </SgCol>
                            </SgRow>
                            <SgSpace Size="SgSize.Sm" />
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Options &amp; Sizes
                            </SgTypography>
                            <SgSpace Size="SgSize.Sm" />
                            <SgRow Space="SgSize.Md">
                                <SgCol Xs="12" Sm="6">
                                    <SgDatePicker @bind-Value="@_date5" Label="With footer" ShowFooter="true" />
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgDatePicker @bind-Value="@_date6" Label="Year range 10" YearRange="10" />
                                </SgCol>
                                <SgCol Xs="6" Sm="3">
                                    <SgDatePicker @bind-Value="@_date7" Label="Size Sm" Size="SgSize.Sm" />
                                </SgCol>
                                <SgCol Xs="6" Sm="3">
                                    <SgDatePicker @bind-Value="@_date8" Label="Size Md" Size="SgSize.Md" />
                                </SgCol>
                                <SgCol Xs="6" Sm="3">
                                    <SgDatePicker @bind-Value="@_date9" Label="Size Lg" Size="SgSize.Lg" />
                                </SgCol>
                                    <SgCol Xs="6" Sm="3">
                                        <SgDatePicker @bind-Value="@_date10" Label="Compact" Compact="true" Size="SgSize.Sm" />
                                    </SgCol>
                                </SgRow>
                                <SgSpace Size="SgSize.Sm" />
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                    Advanced
                                </SgTypography>
                                <SgSpace Size="SgSize.Sm" />
                                <SgRow Space="SgSize.Md">
                                    <SgCol Xs="12" Sm="6">
                                        <SgDatePicker @bind-Value="@_date11" Label="UsePortal" UsePortal="true" ShowFooter="true" />
                                    </SgCol>
                                    <SgCol Xs="12" Sm="6">
                                        <SgDatePicker @bind-Value="@_date12" Label="Weekends disabled" DisabledDate="@(_ => _.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)" ShowFooter="true" />
                                    </SgCol>
                                    <SgCol Xs="12" Sm="6">
                                        <SgDatePicker @bind-Value="@_date13" Label="Monday first day" FirstDayOfWeek="DayOfWeek.Monday" ShowFooter="true" />
                                    </SgCol>
                                    <SgCol Xs="12" Sm="6">
                                        <SgDatePicker @bind-Value="@_date14" Label="AllowInput" AllowInput="true" />
                                    </SgCol>
                                    <SgCol Xs="12" Sm="6">
                                        <SgDatePicker @bind-Value="@_date15_ro" Label="ReadOnly" ReadOnly="true" />
                                    </SgCol>
                                    <SgCol Xs="12" Sm="6">
                                        <SgDatePicker @bind-Value="@_date16" Label="ShowWeekNumbers" ShowWeekNumbers="true" />
                                    </SgCol>
                                    <SgCol Xs="12" Sm="6">
                                        <SgDatePicker @bind-Value="@_date17" Label="ShowPresets" ShowPresets="true" />
                                    </SgCol>
                                    <SgCol Xs="12" Sm="6">
                                        <SgDatePicker @bind-Value="@_date18" Label="AutoClose=false" AutoClose="false" ShowFooter="true" />
                                    </SgCol>
                                    <SgCol Xs="12" Sm="6">
                                        <SgDatePicker @bind-Value="@_date19" Label="Custom button text" TodayText="Now!" ClearText="Reset" ShowFooter="true" AllowClear="true" />
                                    </SgCol>
                                    <SgCol Xs="12" Sm="6">
                                        <SgDatePicker @bind-Value="@_date20" Label="Locale=de-DE" Locale="de-DE" ShowFooter="true" />
                                    </SgCol>
                                    <SgCol Xs="12">
                                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)">Inline mode</SgTypography>
                                        <SgSpace Size="SgSize.Sm" />
                                        <SgDatePicker @bind-Value="@_date1" Inline="true" ShowFooter="true" ShowWeekNumbers="true" />
                                    </SgCol>
                                </SgRow>
                            </SgCard>
                        </SgStack>
                    </SgCol>
                <SgCol Xs="12" Md="4">
                    <SgCard Title="Properties" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <PropertyTable Items="@_datePickerProps" />
                    </SgCard>
                </SgCol>
            </SgRow>

            <SgSpace Size="SgSize.Sm" />
            <DemoCodeBlock Code="@_datePickerCode" Title="SgDatePicker" />
        </div>

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* 2. SgTimePicker                                                    *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">SgTimePicker</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Time selector with list or analog clock views, seconds, AM/PM, min/max range, direct input, and localization.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="8">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgCard Title="Examples" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                            <SgRow Space="SgSize.Md">
                                <SgCol Xs="12" Sm="6">
                                    <SgTimePicker @bind-Value="@_time1" Label="Standard" Placeholder="--:--" />
                                    <div style="display:flex;align-items:center;gap:8px;margin-top:6px;">
                                        <SgBadge Text="Selected:" Variant="SgBadgeVariant.Muted" Standalone="true" Size="SgSize.Sm" />
                                        <SgBadge Text="@(_time1?.ToString(@"hh\:mm") ?? "—")" Variant="SgBadgeVariant.Info" Standalone="true" Size="SgSize.Sm" />
                                    </div>
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgTimePicker @bind-Value="@_time2" Label="With seconds" ShowSeconds="true" />
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgTimePicker @bind-Value="@_time3" Label="Label left" LabelPosition="SgLabelPosition.Left" />
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgTimePicker @bind-Value="@_time4" Label="Direct input" AllowInput="true" />
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgTimePicker @bind-Value="@_time5" Label="With Now button" ShowNow="true" />
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgTimePicker @bind-Value="@_time6" Label="AM/PM" UseAmPm="true" />
                                </SgCol>
                            </SgRow>
                            <SgSpace Size="SgSize.Sm" />
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Sizes
                            </SgTypography>
                            <SgSpace Size="SgSize.Sm" />
                            <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:start;">
                                <SgTimePicker @bind-Value="@_time7" Label="Sm" Size="SgSize.Sm" />
                                <SgTimePicker @bind-Value="@_time8" Label="Md" Size="SgSize.Md" />
                                <SgTimePicker @bind-Value="@_time9" Label="Lg" Size="SgSize.Lg" />
                                <SgTimePicker @bind-Value="@_time10" Label="Compact" Compact="true" Size="SgSize.Sm" />
                            </div>
                            <SgSpace Size="SgSize.Sm" />
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Advanced
                            </SgTypography>
                            <SgSpace Size="SgSize.Sm" />
                            <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:start;">
                                <SgTimePicker @bind-Value="@_time11" Label="UsePortal" UsePortal="true" ShowNow="true" />
                                <SgTimePicker @bind-Value="@_time12" Label="CloseOnSelect" CloseOnSelect="true" />
                                <SgTimePicker @bind-Value="@_time13" Label="SnapToStep" SnapToStep="true" MinuteStep="15" />
                                <SgTimePicker @bind-Value="@_time14" Label="DefaultToNow" DefaultToNow="true" />
                            </div>
                            <SgSpace Size="SgSize.Sm" />
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Items (preset slots)
                            </SgTypography>
                            <SgSpace Size="SgSize.Sm" />
                            <SgTimePicker @bind-Value="@_time15" Label="Select slot" Items="@_timeSlots" />
                        </SgCard>
                    </SgStack>
                </SgCol>
                <SgCol Xs="12" Md="4">
                    <SgCard Title="Properties" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <PropertyTable Items="@_timePickerProps" />
                    </SgCard>
                </SgCol>
            </SgRow>

            <SgSpace Size="SgSize.Sm" />
            <DemoCodeBlock Code="@_timePickerCode" Title="SgTimePicker" />
        </div>

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* 3. SgDateRangePicker                                              *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">SgDateRangePicker</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Range date selector with dual-purpose calendar, min/max range constraints, first-day-of-week, and read-only mode.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="8">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgCard Title="Examples" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                            <SgRow Space="SgSize.Md">
                                <SgCol Xs="12" Sm="6">
                                    <SgDateRangePicker @bind-StartValue="@_rangeStart1" @bind-EndValue="@_rangeEnd1"
                                                       Label="Standard" StartPlaceholder="Start" EndPlaceholder="End" />
                                    <div style="display:flex;align-items:center;gap:8px;margin-top:6px;">
                                        <SgBadge Text="Range:" Variant="SgBadgeVariant.Muted" Standalone="true" Size="SgSize.Sm" />
                                        <SgBadge Text="@RangeText(_rangeStart1, _rangeEnd1)" Variant="SgBadgeVariant.Info" Standalone="true" Size="SgSize.Sm" />
                                    </div>
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgDateRangePicker @bind-StartValue="@_rangeStart2" @bind-EndValue="@_rangeEnd2"
                                                       Label="With preset" />
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgDateRangePicker @bind-StartValue="@_rangeStart3" @bind-EndValue="@_rangeEnd3"
                                                       Label="Max 7 days" MaxDateRange="@TimeSpan.FromDays(7)" />
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgDateRangePicker @bind-StartValue="@_rangeStart4" @bind-EndValue="@_rangeEnd4"
                                                       Label="Monday first day" FirstDayOfWeek="DayOfWeek.Monday" />
                                </SgCol>
                            </SgRow>
                            <SgSpace Size="SgSize.Sm" />
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Sizes &amp; Modes
                            </SgTypography>
                            <SgSpace Size="SgSize.Sm" />
                            <SgRow Space="SgSize.Md">
                                <SgCol Xs="6" Sm="3">
                                    <SgDateRangePicker @bind-StartValue="@_rangeStart5" @bind-EndValue="@_rangeEnd5" Label="Sm" Size="SgSize.Sm" />
                                </SgCol>
                                <SgCol Xs="6" Sm="3">
                                    <SgDateRangePicker @bind-StartValue="@_rangeStart6" @bind-EndValue="@_rangeEnd6" Label="Md" Size="SgSize.Md" />
                                </SgCol>
                                <SgCol Xs="6" Sm="3">
                                    <SgDateRangePicker @bind-StartValue="@_rangeStart7" @bind-EndValue="@_rangeEnd7" Label="Lg" Size="SgSize.Lg" />
                                </SgCol>
                                    <SgCol Xs="6" Sm="3">
                                        <SgDateRangePicker @bind-StartValue="@_rangeStart8" @bind-EndValue="@_rangeEnd8" Label="Disabled" Disabled="true" />
                                    </SgCol>
                                </SgRow>
                                <SgSpace Size="SgSize.Sm" />
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                    Advanced
                                </SgTypography>
                                <SgSpace Size="SgSize.Sm" />
                                <SgRow Space="SgSize.Md">
                                    <SgCol Xs="12" Sm="6">
                                        <SgDateRangePicker @bind-StartValue="@_rangeStart9" @bind-EndValue="@_rangeEnd9"
                                                           Label="UsePortal" UsePortal="true" />
                                    </SgCol>
                                    <SgCol Xs="12" Sm="6">
                                        <SgDateRangePicker @bind-StartValue="@_rangeStart10" @bind-EndValue="@_rangeEnd10"
                                                           Label="Weekends disabled" DisabledDate="@(_ => _.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)" />
                                    </SgCol>
                                    <SgCol Xs="12" Sm="6">
                                        <SgDateRangePicker @bind-StartValue="@_rangeStart11" @bind-EndValue="@_rangeEnd11"
                                                           Label="ShowPresets" ShowPresets="true" />
                                    </SgCol>
                                    <SgCol Xs="12" Sm="6">
                                        <SgDateRangePicker @bind-StartValue="@_rangeStart12" @bind-EndValue="@_rangeEnd12"
                                                           Label="No footer" ShowFooter="false" />
                                    </SgCol>
                                    <SgCol Xs="12" Sm="6">
                                        <SgDateRangePicker @bind-StartValue="@_rangeStart13" @bind-EndValue="@_rangeEnd13"
                                                           Label="DualPane" DualPane="true" AutoClose="false" />
                                    </SgCol>
                                </SgRow>
                            </SgCard>
                    </SgStack>
                </SgCol>
                <SgCol Xs="12" Md="4">
                    <SgCard Title="Properties" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <PropertyTable Items="@_rangePickerProps" />
                    </SgCard>
                </SgCol>
            </SgRow>

            <SgSpace Size="SgSize.Sm" />
            <DemoCodeBlock Code="@_rangePickerCode" Title="SgDateRangePicker" />
        </div>

        @* ═══════════════════════════════════════════════════════════════════ *@
        @* 4. SgColorPicker                                                   *@
        @* ═══════════════════════════════════════════════════════════════════ *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">SgColorPicker</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Color selector with native picker, hex input, copy-to-clipboard, preset swatches, and multiple sizes.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="8">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgCard Title="Examples" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                            <SgRow Space="SgSize.Md">
                                <SgCol Xs="12" Sm="6">
                                    <SgColorPicker @bind-Value="@_color1" Label="Standard" />
                                    <div class="demo-color-swatch" style="background:@_color1;margin-top:6px;"></div>
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgColorPicker @bind-Value="@_color2" Label="No hex input" ShowHexInput="false" />
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgColorPicker @bind-Value="@_color3" Label="No copy button" ShowCopyButton="false" />
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgColorPicker @bind-Value="@_color4" Label="Disabled" Disabled="true" />
                                </SgCol>
                            </SgRow>
                            <SgSpace Size="SgSize.Sm" />
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Sizes
                            </SgTypography>
                            <SgSpace Size="SgSize.Sm" />
                            <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:end;">
                                <SgColorPicker @bind-Value="@_color5" Label="Sm" Size="SgSize.Sm" />
                                <SgColorPicker @bind-Value="@_color6" Label="Md" Size="SgSize.Md" />
                                <SgColorPicker @bind-Value="@_color7" Label="Lg" Size="SgSize.Lg" />
                                <SgColorPicker @bind-Value="@_color8" Label="Compact" Compact="true" Size="SgSize.Sm" />
                            </div>
                            <SgSpace Size="SgSize.Sm" />
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                With Preset Swatches
                            </SgTypography>
                            <SgSpace Size="SgSize.Sm" />
                            <SgColorPicker @bind-Value="@_color9" Label="Pick a preset" Swatches="@_presetColors" />
                            <div style="display:flex;align-items:center;gap:8px;margin-top:6px;">
                                <SgBadge Text="Value:" Variant="SgBadgeVariant.Muted" Standalone="true" Size="SgSize.Sm" />
                                <SgBadge Text="@_color9" Variant="SgBadgeVariant.Info" Standalone="true" Size="SgSize.Sm" />
                                <div class="demo-color-swatch" style="background:@_color9;width:20px;height:20px;border-radius:4px;"></div>
                            </div>
                            <SgSpace Size="SgSize.Sm" />
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Advanced
                            </SgTypography>
                            <SgSpace Size="SgSize.Sm" />
                            <SgRow Space="SgSize.Md">
                                <SgCol Xs="12" Sm="6">
                                    <SgColorPicker @bind-Value="@_color10" Label="AllowClear" AllowClear="true" />
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
                                    <SgColorPicker @bind-Value="@_color11" Label="ShowAlpha" ShowAlpha="true" AllowClear="true" />
                                </SgCol>
                                <SgCol Xs="12" Sm="6">
