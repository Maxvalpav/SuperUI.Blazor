@page "/pdf-suite-demo"
@using SuperUI.Components
@using SuperUI.Components.Other.Pdf
@using SuperUI.Enums

<PageTitle>PDF Suite - SuperUI</PageTitle>

<div class="sg-demo-header">
    <SgTypography Variant="SgTypographyVariant.Heading3" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 12px; display: block;">PDF Suite</SgTypography>
    <p>Комплекс инструментов для профессиональной работы с PDF документами в браузере.</p>
</div>

<SgTabs>
    <SgTabPanel Title="Аннотации и Редактор">
        <SgStack Vertical Spacing="24" Padding="24">
            <SgAlert Variant="SgAlertVariant.Info" Text="Используйте инструменты рисования поверх PDF. Аннотации сохраняются в C# состоянии." />
            <SgPdfAnnotator FileUrl="https://raw.githubusercontent.com/mozilla/pdf.js/ba2edeae/web/compressed.tracemonkey-pldi-09.pdf" 
                            OnSave="HandleAnnotationsSave" />
        </SgStack>
    </SgTabPanel>

    <SgTabPanel Title="Заполнение Форм">
        <SgStack Vertical Spacing="24" Padding="24">
            <SgAlert Variant="SgAlertVariant.Success" Text="Заполните поля слева, и они будут автоматически впечатаны в PDF документ." />
            <SgPdfFormFiller FileUrl="https://pdf-lib.js.org/assets/dod_character.pdf" />
        </SgStack>
    </SgTabPanel>

    <SgTabPanel Title="Сборка Документа">
        <SgStack Vertical Spacing="24" Padding="24">
            <SgAlert Variant="SgAlertVariant.Warn" Text="Перетаскивайте файлы для изменения их порядка в итоговом документе." />
            @{
                var files = new List<SgPdfMerger.SgPdfFileInfo>
                {
                    new() { Name = "Документ 1", Url = "https://raw.githubusercontent.com/mozilla/pdf.js/ba2edeae/web/compressed.tracemonkey-pldi-09.pdf" },
                    new() { Name = "Документ 2", Url = "https://pdf-lib.js.org/assets/dod_character.pdf" }
                };
            }
            <SgPdfMerger InitialFiles="files" />
        </SgStack>
    </SgTabPanel>

    <SgTabPanel Title="AI Поиск">
        <SgStack Vertical Spacing="24" Padding="24">
            <SgAlert Variant="SgAlertVariant.Info" Text="Текст документа индексируется локально. Вы можете мгновенно находить фрагменты и переходить к ним." />
            <SgPdfAiSearch FileUrl="https://raw.githubusercontent.com/mozilla/pdf.js/ba2edeae/web/compressed.tracemonkey-pldi-09.pdf" />
        </SgStack>
    </SgTabPanel>
</SgTabs>

@code {
    private void HandleAnnotationsSave(List<SgPdfAnnotation> annotations)
    {
        Console.WriteLine($"Сохранено {annotations.Count} аннотаций");
    }
}
