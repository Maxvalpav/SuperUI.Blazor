@page "/sgtable-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models

<PageTitle>SgTable - Легкая таблица</PageTitle>

<SgCard Title="SgTable - Легкая таблица" 
        Subtitle="Простой и быстрый компонент для отображения табличных данных с сортировкой, поиском, пагинацией и экспортом.">
    
    <!-- 1. Основная таблица -->
    <div style="margin-top: 32px;">
        <h2>1. Основная таблица с ресайзом и drag-drop колонок</h2>
        <p>Таблица с явно определёнными колонками, поиском, сортировкой, пагинацией. Колонки можно перетаскивать и изменять их ширину мышкой.</p>
        
        <SgCard Title="Пример использования" Style="margin-top: 16px;">
            <SgTable TItem="Employee" 
                     Items="_employees.Take(50)"
                     Title="Сотрудники"
                     ShowSearch="true"
                     EnablePaging="true"
                     PageSize="10"
                     Height="500px"
                     ShowExportCsv="true"
                     ShowExportExcel="true"
                     AllowPageSizeChange="true"
                     AllowColumnResize="true"
                     AllowColumnReorder="true"
                     RowClass="@(e => !e.IsActive ? "text-danger" : null)"
                     RowStyle="@(e => !e.IsActive ? "background-color: #fff5f5;" : null)">
                <ChildContent>
                    <SgTableColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="60px" />
                    <SgTableColumn TItem="Employee" Title="Имя" Value="@(e => e.FirstName)" />
                    <SgTableColumn TItem="Employee" Title="Фамилия" Value="@(e => e.LastName)" />
                    <SgTableColumn TItem="Employee" Title="Email" Value="@(e => e.Email)" />
                    <SgTableColumn TItem="Employee" Title="Отдел" Value="@(e => e.Department)" />
                    <SgTableColumn TItem="Employee" Title="Активен" Value="@(e => e.IsActive)" Width="100px" />
                    <SgTableColumn TItem="Employee" Title="Зарплата" Value="@(e => e.Salary)" Format="C0"
                                  CellClass="@(e => e.Salary > 100000 ? "text-success font-bold" : null)" />
                    <SgTableColumn TItem="Employee" Title="Дата найма" Value="@(e => e.HireDate)" Format="dd.MM.yyyy" />
                </ChildContent>
            </SgTable>
        </SgCard>
    </div>

    <!-- 2. Автогенерация колонок -->
    <div style="margin-top: 32px;">
        <h2>2. Таблица с группировкой заголовков</h2>
        <p>Таблица с группировкой колонок под общими заголовками (header groups).</p>
        
        <SgCard Title="Группировка заголовков" Style="margin-top: 16px;">
            <SgTable TItem="Employee" 
                     Items="_employees.Take(30)"
                     Title="Сотрудники с группировкой"
                     ShowSearch="true"
                     EnablePaging="true"
                     PageSize="10"
                     Height="450px">
                <ChildContent>
                    <SgTableHeaderGroup TItem="Employee" Title="Личные данные" ColumnCount="3" />
                    <SgTableHeaderGroup TItem="Employee" Title="Работа" ColumnCount="3" />
                    <SgTableHeaderGroup TItem="Employee" Title="Финансы" ColumnCount="2" />
                    
                    <SgTableColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="60px" />
                    <SgTableColumn TItem="Employee" Title="Имя" Value="@(e => e.FirstName)" />
                    <SgTableColumn TItem="Employee" Title="Фамилия" Value="@(e => e.LastName)" />
                    <SgTableColumn TItem="Employee" Title="Отдел" Value="@(e => e.Department)" />
                    <SgTableColumn TItem="Employee" Title="Активен" Value="@(e => e.IsActive)" Width="100px" />
                    <SgTableColumn TItem="Employee" Title="Дата найма" Value="@(e => e.HireDate)" Format="dd.MM.yyyy" />
                    <SgTableColumn TItem="Employee" Title="Зарплата" Value="@(e => e.Salary)" Format="C0" />
                    <SgTableColumn TItem="Employee" Title="Email" Value="@(e => e.Email)" />
                </ChildContent>
            </SgTable>
        </SgCard>
    </div>

    <!-- 3. Автогенерация колонок -->
    <div style="margin-top: 32px;">
        <h2>3. Автогенерация колонок</h2>
        <p>Таблица с автоматическим созданием колонок из свойств модели. Удобно для быстрого прототипирования.</p>
        
        <SgCard Title="Автогенерация" Style="margin-top: 16px;">
            <SgTable TItem="Employee" 
                     Items="_employees.Take(30)"
                     Title="Сотрудники (авто)"
                     ShowSearch="true"
                     EnablePaging="true"
                     PageSize="15"
                     Height="450px"
                     AutoGenerateColumns="true" />
        </SgCard>
    </div>

    <!-- 4. Выбор строк -->
    <div style="margin-top: 32px;">
        <h2>4. Выбор строк</h2>
        <p>Таблица с возможностью выбора одной или нескольких строк.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Множественный выбор">
                <SgTable TItem="Employee" 
                         Items="_employees.Take(30)"
                         Title="Выберите сотрудников"
                         ShowSearch="true"
                         EnablePaging="true"
                         PageSize="10"
                         Height="400px"
                         AllowSelection="true"
                         AllowMultiSelect="true"
                         @bind-SelectedItems="_selectedEmployees">
                    <ChildContent>
                        <SgTableColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="60px" />
                        <SgTableColumn TItem="Employee" Title="Имя" Value="@(e => e.FirstName)" />
                        <SgTableColumn TItem="Employee" Title="Фамилия" Value="@(e => e.LastName)" />
                        <SgTableColumn TItem="Employee" Title="Отдел" Value="@(e => e.Department)" />
                    </ChildContent>
                </SgTable>
                @if (_selectedEmployees.Any())
                {
                    <div style="margin-top: 12px; padding: 12px; background: var(--sui-bg-secondary); border-radius: var(--sui-radius-sm);">
                        <div style="font-size: 12px; font-weight: 600; margin-bottom: 8px;">Выбрано: @_selectedEmployees.Count</div>
                        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                            @foreach (var emp in _selectedEmployees.Take(5))
                            {
                                <SgBadge Variant="SgBadgeVariant.Success">@emp.FirstName @emp.LastName</SgBadge>
                            }
                            @if (_selectedEmployees.Count > 5)
                            {
                                <SgBadge Variant="SgBadgeVariant.Muted">+@(_selectedEmployees.Count - 5) ещё</SgBadge>
                            }
                        </div>
                    </div>
                }
            </SgCard>
            <SgCard Title="Одиночный выбор">
                <SgTable TItem="Employee" 
                         Items="_employees.Take(30)"
                         Title="Выберите сотрудника"
                         ShowSearch="true"
                         EnablePaging="true"
                         PageSize="10"
                         Height="400px"
                         AllowSelection="true"
                         AllowMultiSelect="false"
                         @bind-SelectedItems="_singleSelectedEmployee">
                    <ChildContent>
                        <SgTableColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="60px" />
                        <SgTableColumn TItem="Employee" Title="Имя" Value="@(e => e.FirstName)" />
                        <SgTableColumn TItem="Employee" Title="Фамилия" Value="@(e => e.LastName)" />
                        <SgTableColumn TItem="Employee" Title="Email" Value="@(e => e.Email)" />
                    </ChildContent>
                </SgTable>
                @if (_singleSelectedEmployee.Any())
                {
                    var emp = _singleSelectedEmployee.First();
                    <div style="margin-top: 12px; padding: 12px; background: var(--sui-bg-secondary); border-radius: var(--sui-radius-sm);">
                        <div style="font-size: 12px; font-weight: 600; margin-bottom: 4px;">Выбран:</div>
                        <div style="font-size: 13px;">@emp.FirstName @emp.LastName (@emp.Email)</div>
                    </div>
                }
            </SgCard>
        </div>
    </div>

    <!-- 5. Компактная таблица -->
    <div style="margin-top: 32px;">
        <h2>5. Компактная таблица без пагинации</h2>
        <p>Простая таблица для небольших наборов данных с фиксированной высотой и скроллом.</p>
        
        <SgCard Title="Компактный вид" Style="margin-top: 16px;">
            <SgTable TItem="Employee" 
                     Items="_employees.Take(20)"
                     Title="Топ-20 сотрудников"
                     ShowSearch="false"
                     EnablePaging="false"
                     Height="350px"
                     ShowRowNumbers="true">
                <ChildContent>
                    <SgTableColumn TItem="Employee" Title="Имя" Value="@(e => e.FirstName)" />
                    <SgTableColumn TItem="Employee" Title="Фамилия" Value="@(e => e.LastName)" />
                    <SgTableColumn TItem="Employee" Title="Зарплата" Value="@(e => e.Salary)" Format="C0" />
                </ChildContent>
            </SgTable>
        </SgCard>
    </div>

    <!-- 6. Свойства компонента -->
    <div style="margin-top: 32px;">
        <h2>Свойства компонента</h2>
        <p>Полный список параметров компонента SgTable.</p>
        
        <SgCard Title="Параметры" Style="margin-top: 16px;">
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                    <thead>
                        <tr style="background: var(--sui-bg-secondary); border-bottom: 2px solid var(--sui-border);">
                            <th style="padding: 10px; text-align: left; font-weight: 600;">Свойство</th>
                            <th style="padding: 10px; text-align: left; font-weight: 600;">Тип</th>
                            <th style="padding: 10px; text-align: left; font-weight: 600;">Описание</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prop in _tableProperties)
                        {
                            <tr style="border-bottom: 1px solid var(--sui-border);">
                                <td style="padding: 10px; color: var(--sui-primary); font-family: monospace; font-weight: 600;">@prop.Name</td>
                                <td style="padding: 10px; color: var(--sui-text-muted); font-family: monospace; font-size: 11px;">@prop.Type</td>
                                <td style="padding: 10px;">@prop.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </SgCard>
    </div>

</SgCard>

@code {
    private List<Employee> _employees = new();
    private List<Employee> _selectedEmployees = new();
    private List<Employee> _singleSelectedEmployee = new();

    private List<PropertyInfo> _tableProperties = new()
    {
        new("Items", "IEnumerable<TItem>", "Коллекция данных для отображения"),
        new("Title", "string", "Заголовок таблицы"),
        new("ShowSearch", "bool", "Показать поле поиска (по умолчанию true)"),
        new("SearchPlaceholder", "string", "Текст placeholder для поиска"),
        new("Height", "string", "Фиксированная высота таблицы (например, '500px')"),
        new("EnablePaging", "bool", "Включить пагинацию"),
        new("PageSize", "int", "Количество строк на странице (по умолчанию 20)"),
        new("AllowPageSizeChange", "bool", "Разрешить изменение размера страницы"),
        new("PageSizeOptions", "int[]", "Опции размера страницы"),
        new("ShowExport", "bool", "Показать кнопку экспорта в CSV"),
        new("AllowSelection", "bool", "Разрешить выбор строк"),
        new("AllowMultiSelect", "bool", "Разрешить множественный выбор"),
        new("ShowRowNumbers", "bool", "Показать номера строк"),
        new("AutoGenerateColumns", "bool", "Автоматически создать колонки из свойств модели"),
        new("AllowColumnResize", "bool", "Разрешить изменение ширины колонок мышкой (по умолчанию true)"),
        new("AllowColumnReorder", "bool", "Разрешить перетаскивание колонок (по умолчанию true)"),
        new("FullWidth", "bool", "Растянуть таблицу на всю ширину"),
        new("EmptyText", "string", "Текст при отсутствии данных"),
        new("RowClass", "Func<TItem, string>", "Функция для добавления CSS класса к строке"),
        new("RowStyle", "Func<TItem, string>", "Функция для добавления inline стилей к строке"),
        new("RowClicked", "EventCallback<TItem>", "Событие клика по строке"),
        new("RowDoubleClicked", "EventCallback<TItem>", "Событие двойного клика по строке"),
    };

    protected override void OnInitialized()
    {
        _employees = SampleDataService.GenerateEmployees(200);
    }

    private record PropertyInfo(string Name, string Type, string Description);
}
