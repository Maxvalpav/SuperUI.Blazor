@page "/sgtable-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models

<PageTitle>SgTable - Лёгкая таблица</PageTitle>

<SgCard Title="SgTable - Лёгкая таблица" 
        Subtitle="Простой компонент для отображения табличных данных с сортировкой, общим фильтром, шаблонами и раскраской по условиям.">
    
    <!-- 1. Основная таблица с явными колонками -->
    <div style="margin-top: 32px;">
        <h2>1. Основная таблица - явные колонки</h2>
        <p>Таблица с явно определёнными колонками, поиском, сортировкой и шаблонами для ячеек.</p>
        
        <SgCard Title="Лёгкая таблица" Style="margin-top: 16px;">
            <div style="border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); overflow: hidden;">
                <SgTable TItem="Employee" 
                            Items="_employees"
                            Title="Сотрудники"
                            ShowSearch="true"
                            RowClass="@(e => !e.IsActive ? "text-danger" : null)"
                            RowStyle="@(e => !e.IsActive ? "background-color: #fff5f5;" : null)">
                    <ChildContent>
                        <SgTableColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="60" />
                        <SgTableColumn TItem="Employee" Title="Имя" Value="@(e => e.FirstName)" Width="120" />
                        <SgTableColumn TItem="Employee" Title="Фамилия" Value="@(e => e.LastName)" Width="120" />
                        <SgTableColumn TItem="Employee" Title="Отдел" Value="@(e => e.Department)" Width="120" />
                        <SgTableColumn TItem="Employee" Title="Статус" Value="@(e => e.IsActive)" Width="120">
                            <Template>
                                <SgBadge Variant="@(context.IsActive ? SgBadgeVariant.Success : SgBadgeVariant.Danger)">
                                    @(context.IsActive ? "Активен" : "Неактивен")
                                </SgBadge>
                            </Template>
                        </SgTableColumn>
                        <SgTableColumn TItem="Employee" Title="Зарплата" Value="@(e => e.Salary)" Width="100" Format="C0"
                                      CellClass="@(e => e.Salary > 100000 ? "text-success font-bold" : null)"
                                      CellStyle="@(e => e.Salary > 100000 ? "background-color: #f0fff0;" : null)" />
                        <SgTableColumn TItem="Employee" Title="Дата найма" Value="@(e => e.HireDate)" Width="120" Format="dd.MM.yyyy" />
                    </ChildContent>
                </SgTable>
            </div>
        </SgCard>
    </div>

    <!-- 2. Автогенерация колонок -->
    <div style="margin-top: 32px;">
        <h2>2. Автогенерация колонок</h2>
        <p>Таблица с автоматическим созданием колонок из свойств модели Employee.</p>
        
        <SgCard Title="Автогенерация колонок" Style="margin-top: 16px;">
            <div style="border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); overflow: hidden;">
                <SgTable TItem="Employee" 
                            Items="_employees.Take(20)"
                            Title="Сотрудники (авто)"
                            ShowSearch="true"
                            AutoGenerateColumns="true" />
            </div>
        </SgCard>
    </div>
</SgCard>

@code {
    private List<Employee> _employees = new();

    protected override void OnInitialized()
    {
        _employees = SampleDataService.GenerateEmployees(1000);
    }
}
