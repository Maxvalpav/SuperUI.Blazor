@page "/recorder-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models

<PageTitle>Recorder — Запись аудио и видео - SUI</PageTitle>
<SgSeoHead Description="Explore Recorder — SuperUI Blazor component library demo with live examples, code snippets, and API documentation." />

<SgCard Title="SgRecorder — Запись аудио и видео"
        Subtitle="Запись видео и аудио с вебкамеры и микрофона на базе RecordRTC — поддержка всех популярных форматов, выбор устройств, пауза/возобновление и скачивание.">

    <!-- Основной рекордер -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Демонстрация записи</SgTypography>
        <p>Запишите видео или аудио с вашей камеры и микрофона. Поддерживается переключение между устройствами в реальном времени.</p>

        <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Запись">
                <SgRecorder @ref="_recorder"
                           Title="@_title"
                           Video="@_video"
                           Audio="@_audio"
                           MimeType="@_selectedMimeType"
                           BitsPerSecond="@(_bitsPerSecond > 0 ? _bitsPerSecond : null)"
                           TimeSlice="@(_timeSlice > 0 ? _timeSlice : null)"
                           MaxDuration="@(_maxDuration > 0 ? _maxDuration : null)"
                           ShowDeviceList="@_showDeviceList"
                           ShowReset="@_showReset"
                           ShowDownload="@_showDownload"
                           RequestPermissionsAutomatically="@_requestPermissionsAutomatically"
                           OnPermissionGranted="OnPermissionGranted"
                           OnPermissionDenied="OnPermissionDenied"
                           OnStart="OnStart"
                           OnPause="OnPause"
                           OnResume="OnResume"
                           OnStop="OnStop"
                           OnError="OnError" />
            </SgCard>

            <SgCard Title="Параметры SgRecorder">
                <PropertyTable Items="_basicProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Настройки и результат -->
    <div style="margin-top: 32px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Конфигурация">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <SgTextBox TValue="string" @bind-Value="_title" Label="Заголовок компонента" Placeholder="Например: Запись интервью" />
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <SgCheckBox @bind-Value="_video" Label="Видео" />
                        <SgCheckBox @bind-Value="_audio" Label="Аудио" />
                        <SgCheckBox @bind-Value="_showDeviceList" Label="Список устройств" />
                        <SgCheckBox @bind-Value="_showDownload" Label="Кнопка скачать" />
                    </div>
                    <div>
                        <SgSelect TValue="SgRecorderMimeType"
                                  @bind-Value="_selectedMimeType"
                                  Items="@_allMimeTypes"
                                  Label="Формат записи"
                                  TextField="m => m.ToString()" />
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <SgNumberInput TValue="int?" @bind-Value="_bitsPerSecond" Label="Битрейт (bps)" Min="0" />
                        <SgNumberInput TValue="int?" @bind-Value="_maxDuration" Label="Лимит (сек)" Min="0" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Результаты записи">
                @if (_lastRecording is not null)
                {
                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        <div class="sg-recorder-video-container" style="border-radius: 8px; overflow: hidden; border: 1px solid var(--sui-border);">
                            @if (_lastRecording.MimeType?.StartsWith("audio") == true)
                            {
                                <audio style="display: block; width: 100%;" controls src="@_lastRecording.DataUrl"></audio>
                            }
                            else
                            {
                                <video style="display: block; width: 100%; height: auto;" controls src="@_lastRecording.DataUrl"></video>
                            }
                        </div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <SgBadge Text="@FormatDuration(_lastRecording.Duration)" Variant="SgBadgeVariant.Info" />
                            <SgBadge Text="@FormatFileSize(_lastRecording.Size)" Variant="SgBadgeVariant.Info" />
                            <SgBadge Text="@_lastRecording.MimeType" Variant="SgBadgeVariant.Default" />
                        </div>
                    </div>
                }
                else
                {
                    <div style="color: var(--sui-text-muted); text-align: center; padding: 48px 24px; border: 2px dashed var(--sui-border); border-radius: 8px;">
                        Запишите что-нибудь, чтобы увидеть результат
                    </div>
                }
            </SgCard>
        </div>
    </div>

    <!-- История записей -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">История сессии</SgTypography>
        <SgCard Title="Предыдущие записи" Style="margin-top: 16px;">
            @if (_recordingHistory.Count > 0)
            {
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px;">
                    @foreach (var recording in _recordingHistory)
                    {
                        <div style="display: flex; flex-direction: column; gap: 8px; padding: 12px; background: var(--sui-bg-muted); border-radius: 8px; border: 1px solid var(--sui-border);">
                            <div style="font-weight: 600; font-size: 13px;">Запись @recording.MimeType</div>
                            <div style="display: flex; gap: 8px;">
                                <SgBadge Text="@FormatDuration(recording.Duration)" Variant="SgBadgeVariant.Info" Size="SgSize.Sm" />
                                <SgBadge Text="@FormatFileSize(recording.Size)" Variant="SgBadgeVariant.Info" Size="SgSize.Sm" />
                            </div>
                            <SgButton Text="Воспроизвести" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="() => _lastRecording = recording" />
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="color: var(--sui-text-muted); text-align: center; padding: 24px;">
                    История пуста
                </div>
            }
        </SgCard>
    </div>

</SgCard>

@code {
    private SgRecorder? _recorder;
    private string? _title = "Мой рекордер";
    private bool _video = true;
    private bool _audio = true;
    private bool _showDeviceList = true;
    private bool _showReset = true;
    private bool _showDownload = true;
    private bool _requestPermissionsAutomatically = true;
    private SgRecorderMimeType _selectedMimeType = SgRecorderMimeType.VideoWebM;
    private int? _bitsPerSecond;
    private int? _timeSlice;
    private int? _maxDuration;
    private SgRecorderStoppedEventArgs? _lastRecording;
    private List<SgRecorderStoppedEventArgs> _recordingHistory = new();
    private readonly List<SgRecorderMimeType> _allMimeTypes = Enum.GetValues<SgRecorderMimeType>().ToList();

    private string FormatDuration(double seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.Hours > 0 ? $"{ts:hh\\:mm\\:ss}" : $"{ts:mm\\:ss}";
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        int order = 0;
        double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size /= 1024;
        }
        return $"{size:0.##} {sizes[order]}";
    }

    private void OnPermissionGranted(SgRecorderPermissionGrantedEventArgs e) => Console.WriteLine("Permission granted");
    private void OnPermissionDenied() => Console.WriteLine("Permission denied");
    private void OnStart(SgRecorderStartedEventArgs e) => Console.WriteLine($"Recording started at {e.StartedAt}");
    private void OnPause() => Console.WriteLine("Recording paused");
    private void OnResume() => Console.WriteLine("Recording resumed");
    private void OnStop(SgRecorderStoppedEventArgs e)
    {
        _lastRecording = e;
        _recordingHistory.Insert(0, e);
        StateHasChanged();
    }
    private void OnError(SgRecorderErrorEventArgs e) => Console.WriteLine($"Error: {e.Message}");

    private List<PropertyPanelItem> _basicProperties = new()
    {
        new() { Label = "Video", Value = "bool", BadgeText = "Запись видео", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Audio", Value = "bool", BadgeText = "Запись аудио", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "MimeType", Value = "SgRecorderMimeType", BadgeText = "Формат", BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "MaxDuration", Value = "int?", BadgeText = "Лимит (сек)", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowDeviceList", Value = "bool", BadgeText = "Выбор камер", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "ShowDownload", Value = "bool", BadgeText = "Кнопка скачать", BadgeVariant = SgBadgeVariant.Default }
    };
}
