@page "/octave-analyzer-demo"
@using SuperUI.Components

<PageTitle>Octave Band RTA Analyzer - SuperUI</PageTitle>

<div class="sg-demo-header">
    <SgTypography Variant="SgTypographyVariant.Heading3" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 12px; display: block;">Octave Band RTA Analyzer</SgTypography>
    <p>Анализатор спектра в реальном времени с октавными полосами и взвешиванием A/C/Z.</p>
</div>

<SgStack Vertical Spacing="20">
    <SgCard Title="Управление">
        <SgStack Spacing="16" Align="SgAlignItems.Center" Wrap>
            <SgStack Spacing="8" Align="SgAlignItems.Center">
                <span style="font-size:13px;color:var(--sg-text-secondary);">Взвешивание:</span>
                <SgSegmented TValue="SgWeightingCurve"
                             @bind-Value="_weighting"
                             Options="_weightingOptions"
                             Disabled="_isRunning" />
            </SgStack>

            <SgStack Spacing="8">
                @if (!_isRunning)
                {
                    <SgButton Variant="SgButtonVariant.Primary" OnClick="StartAsync">
                        🎙 Старт
                    </SgButton>
                }
                else
                {
                    <SgButton Variant="SgButtonVariant.Danger" OnClick="StopAsync">
                        ⏹ Стоп
                    </SgButton>
                }
                <SgButton OnClick="ResetPeaks" Disabled="_isRunning">
                    Сбросить пики
                </SgButton>
            </SgStack>
        </SgStack>
    </SgCard>

    <SgCard Title="Спектр">
        <SgOctaveAnalyzer @ref="_analyzer"
                          Weighting="@_weighting"
                          UpdateIntervalMs="100"
                          ShowPeakHold="true"
                          OnReading="OnReading" />
    </SgCard>

    @if (_history.Count > 0)
    {
        <SgCard Title="@($"История измерений ({_history.Count})")">
            <div style="overflow-x:auto;">
                <table class="oa-history-table">
                    <thead>
                        <tr>
                            <th>Время</th>
                            <th>Общий уровень</th>
                            <th>Взвешивание</th>
                            <th>31.5 Гц</th>
                            <th>63 Гц</th>
                            <th>125 Гц</th>
                            <th>250 Гц</th>
                            <th>500 Гц</th>
                            <th>1 кГц</th>
                            <th>2 кГц</th>
                            <th>4 кГц</th>
                            <th>8 кГц</th>
                            <th>16 кГц</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _history.AsEnumerable().Reverse().Take(20))
                        {
                            <tr>
                                <td>@r.Timestamp.ToString("HH:mm:ss.fff")</td>
                                <td><strong>@r.OverallDb.ToString("F1") dB(@r.Weighting)</strong></td>
                                <td>@r.Weighting</td>
                                @foreach (var b in r.Bands)
                                {
                                    <td style="font-family:monospace;font-size:11px;">@b.WeightedDb.ToString("F1")</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_history.Count > 20)
            {
                <div style="text-align:center;padding:8px;font-size:12px;color:var(--sg-text-secondary);">
                    Показаны последние 20 из @_history.Count измерений
                </div>
            }
        </SgCard>
    }
</SgStack>

<style>
    .oa-history-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
    }
    .oa-history-table th {
        padding: 7px 10px;
        text-align: left;
        font-weight: 600;
        color: var(--sg-text-secondary, #6b7280);
        background: var(--sg-bg-secondary, #f8fafc);
        border-bottom: 1px solid var(--sg-border-color, #e5e7eb);
        white-space: nowrap;
    }
    .oa-history-table td {
        padding: 6px 10px;
        border-bottom: 1px solid var(--sg-border-color-light, #f3f4f6);
        white-space: nowrap;
    }
    .oa-history-table tbody tr:hover {
        background: var(--sg-hover-bg, rgba(0,111,238,0.04));
    }
</style>

@code {
    private SgOctaveAnalyzer? _analyzer;
    private SgWeightingCurve _weighting = SgWeightingCurve.A;
    private bool _isRunning;
    private readonly List<SgOctaveReading> _history = new();

    private readonly List<SgSegmentedOption<SgWeightingCurve>> _weightingOptions = new()
    {
        new() { Value = SgWeightingCurve.A, Label = "A" },
        new() { Value = SgWeightingCurve.C, Label = "C" },
        new() { Value = SgWeightingCurve.Z, Label = "Z" },
    };

    private async Task StartAsync()
    {
        if (_analyzer is null) return;
        _isRunning = true;
        StateHasChanged();
        await _analyzer.StartAsync();
    }

    private async Task StopAsync()
    {
        if (_analyzer is null) return;
        await _analyzer.StopAsync();
        _isRunning = false;
        StateHasChanged();
    }

    private void ResetPeaks()
    {
        _analyzer?.ResetPeaks();
    }

    private Task OnReading(SgOctaveReading reading)
    {
        _history.Add(reading);
        // Keep last 200 readings
        if (_history.Count > 200)
            _history.RemoveAt(0);
        StateHasChanged();
        return Task.CompletedTask;
    }
}
