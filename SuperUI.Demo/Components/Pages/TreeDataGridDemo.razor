@page "/tree-datagrid-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models

<PageTitle>Древовидная таблица - SUI</PageTitle>
<SgSeoHead Description="Мощный компонент для отображения иерархических данных в табличном виде. Поддерживает вложенность, кастомные колонки и управление состоянием." />

<SgCard Title="SgTreeDataGrid - Древовидная таблица" 
        Subtitle="Мощный компонент для отображения иерархических данных в табличном виде. Поддерживает вложенность, кастомные колонки и управление состоянием.">

    <!-- Базовое использование -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Демонстрация мощности (SgDataGrid)</SgTypography>
        <p>Поскольку <code>SgTreeDataGrid</code> использует внутри основной <code>SgDataGrid</code>, вам доступны поиск, фильтрация по колонкам, экспорт и другие функции.</p>
        
        <div style="display: grid; grid-template-columns: 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Пример: Структура файлов с поиском и фильтрами">
                <div style="margin-bottom: 16px; display: flex; gap: 8px;">
                    <SgButton Size="SgSize.Sm" OnClick="() => _treeGrid1?.ExpandAllAsync() ?? Task.CompletedTask">Развернуть всё</SgButton>
                    <SgButton Size="SgSize.Sm" OnClick="() => _treeGrid1?.CollapseAllAsync() ?? Task.CompletedTask">Свернуть всё</SgButton>
                </div>
                <SgTreeDataGrid @ref="_treeGrid1"
                                TItem="FileSystemItem" 
                                Items="_files" 
                                ChildrenSelector="x => x.Children"
                                Height="450px"
                                ShowSearch="true"
                                ShowQuickFilters="true"
                                ShowColumnChooser="true"
                                ShowStatusBar="true"
                                AllowMultiSelect="true">
                    <SgDataGridColumn TItem="FileSystemItem" ColumnKey="Name" Title="Имя" Value="x => x.Name" Width="300px" Filterable="true" Sortable="true" />
                    <SgDataGridColumn TItem="FileSystemItem" ColumnKey="Type" Title="Тип" Value="x => x.Type" Width="100px" Filterable="true" />
                    <SgDataGridColumn TItem="FileSystemItem" ColumnKey="Size" Title="Размер" Width="100px" Sortable="true">
                        <Template>
                            @if (context.Type == "File")
                            {
                                <div style="text-align: right; width: 100%; font-family: monospace;">
                                    <span>@context.Size</span>
                                    <span style="color: var(--sui-text-muted); font-size: 11px; margin-left: 2px;">KB</span>
                                </div>
                            }
                        </Template>
                    </SgDataGridColumn>
                    <SgDataGridColumn TItem="FileSystemItem" ColumnKey="Modified" Title="Дата изменения" Value='x => x.Modified.ToString("dd.MM.yyyy HH:mm")' Sortable="true" />
                </SgTreeDataGrid>
            </SgCard>
        </div>
    </div>

    <!-- Управление выделением -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Выделение и детали</SgTypography>
        <p>Поддержка выделения строк и отображение дополнительных данных.</p>
        
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Организационная структура">
                <SgTreeDataGrid TItem="OrgUnit" 
                                Items="_orgStructure" 
                                ChildrenSelector="x => x.SubUnits"
                                @bind-SelectedItem="_selectedUnit"
                                ShowSearch="false">
                    <SgDataGridColumn TItem="OrgUnit" ColumnKey="Name" Title="Подразделение" Value="x => x.Name" Width="250px" />
                    <SgDataGridColumn TItem="OrgUnit" ColumnKey="Manager" Title="Руководитель" Value="x => x.Manager" />
                    <SgDataGridColumn TItem="OrgUnit" ColumnKey="StaffCount" Title="Сотрудники" Value="x => x.StaffCount" Width="120px" />
                </SgTreeDataGrid>
            </SgCard>

            <SgCard Title="Детали выбранного элемента">
                @if (_selectedUnit != null)
                {
                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        <div><b>ID:</b> @_selectedUnit.Id</div>
                        <div><b>Название:</b> @_selectedUnit.Name</div>
                        <div><b>Руководитель:</b> @_selectedUnit.Manager</div>
                        <div><b>Персонал:</b> @_selectedUnit.StaffCount чел.</div>
                        <SgButton Variant="SgButtonVariant.Primary" Size="SgSize.Sm">Редактировать</SgButton>
                    </div>
                }
                else
                {
                    <div style="color: var(--sui-muted);">Выберите элемент в таблице для просмотра деталей.</div>
                }
            </SgCard>
        </div>
    </div>

    <!-- Параметры -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Параметры компонента</SgTypography>
        <SgCard Style="margin-top: 16px;">
            <PropertyTable Items="_treeGridProperties" />
        </SgCard>
    </div>

</SgCard>

@code {
    private SgTreeDataGrid<FileSystemItem>? _treeGrid1;
    private FileSystemItem[] _files = Array.Empty<FileSystemItem>();
    private OrgUnit[] _orgStructure = Array.Empty<OrgUnit>();
    private OrgUnit? _selectedUnit;

    private List<PropertyPanelItem> _treeGridProperties = new()
    {
        new() { Label = "Items",           Value = "IEnumerable<T>",        BadgeText = "Данные",             BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "ChildrenSelector", Value = "Func<T, IEnumerable<T>>", BadgeText = "Селектор дочерних", BadgeVariant = SgBadgeVariant.Warn   },
        new() { Label = "Height",          Value = "string?",               BadgeText = "Высота (прокрутка)", BadgeVariant = SgBadgeVariant.Info   },
        new() { Label = "SelectedItem",    Value = "T?",                    BadgeText = "Выбранный элемент",  BadgeVariant = SgBadgeVariant.Info   },
        new() { Label = "EmptyText",       Value = "string",                BadgeText = "Текст при пустоте",  BadgeVariant = SgBadgeVariant.Info   },
        new() { Label = "ChildContent",    Value = "RenderFragment",        BadgeText = "Колонки",            BadgeVariant = SgBadgeVariant.Info   },
    };

    protected override void OnInitialized()
    {
        _files = new[]
        {
            new FileSystemItem("Project", "Folder", 0, DateTime.Now.AddDays(-5))
            {
                Children = new List<FileSystemItem>
                {
                    new FileSystemItem("src", "Folder", 0, DateTime.Now.AddDays(-3))
                    {
                        Children = new List<FileSystemItem>
                        {
                            new FileSystemItem("App.razor", "File", 12, DateTime.Now.AddHours(-2)),
                            new FileSystemItem("Main.cs", "File", 45, DateTime.Now.AddDays(-1)),
                            new FileSystemItem("Utils.cs", "File", 15, DateTime.Now.AddDays(-2)),
                            new FileSystemItem("Components", "Folder", 0, DateTime.Now.AddDays(-1))
                            {
                                Children = new List<FileSystemItem>
                                {
                                    new FileSystemItem("SgButton.razor", "File", 8, DateTime.Now.AddHours(-5)),
                                    new FileSystemItem("SgDataGrid.razor", "File", 124, DateTime.Now.AddMinutes(-30))
                                }
                            }
                        }
                    },
                    new FileSystemItem("wwwroot", "Folder", 0, DateTime.Now.AddDays(-10))
                    {
                        Children = new List<FileSystemItem>
                        {
                            new FileSystemItem("css", "Folder", 0, DateTime.Now.AddDays(-9))
                            {
                                Children = new List<FileSystemItem>
                                {
                                    new FileSystemItem("site.css", "File", 5, DateTime.Now.AddDays(-8)),
                                    new FileSystemItem("sg-styles.css", "File", 42, DateTime.Now.AddDays(-7))
                                }
                            },
                            new FileSystemItem("images", "Folder", 0, DateTime.Now.AddDays(-12))
                            {
                                Children = new List<FileSystemItem>
                                {
                                    new FileSystemItem("logo.png", "File", 128, DateTime.Now.AddDays(-15)),
                                    new FileSystemItem("banner.jpg", "File", 512, DateTime.Now.AddDays(-14))
                                }
                            }
                        }
                    },
                    new FileSystemItem("README.md", "File", 2, DateTime.Now),
                    new FileSystemItem("package.json", "File", 1, DateTime.Now.AddDays(-20))
                }
            },
            new FileSystemItem("System", "Folder", 0, DateTime.Now.AddYears(-1))
            {
                Children = new List<FileSystemItem>
                {
                    new FileSystemItem("Drivers", "Folder", 0, DateTime.Now.AddMonths(-6)),
                    new FileSystemItem("Config", "Folder", 0, DateTime.Now.AddMonths(-5))
                    {
                        Children = new List<FileSystemItem>
                        {
                            new FileSystemItem("boot.ini", "File", 1, DateTime.Now.AddMonths(-5))
                        }
                    }
                }
            }
        };

        _orgStructure = new[]
        {
            new OrgUnit(1, "Головной офис", "Иванов И.И.", 150)
            {
                SubUnits = new List<OrgUnit>
                {
                    new OrgUnit(2, "Департамент IT", "Петров П.П.", 45)
                    {
                        SubUnits = new List<OrgUnit>
                        {
                            new OrgUnit(4, "Отдел разработки", "Сидоров С.С.", 30),
                            new OrgUnit(5, "Отдел QA", "Кузнецов А.В.", 15),
                            new OrgUnit(6, "Отдел DevOps", "Белов М.А.", 5)
                        }
                    },
                    new OrgUnit(3, "Департамент продаж", "Смирнова Е.А.", 80)
                    {
                        SubUnits = new List<OrgUnit>
                        {
                            new OrgUnit(7, "Регион Север", "Морозов А.Г.", 35),
                            new OrgUnit(8, "Регион Юг", "Павлов Д.В.", 40),
                            new OrgUnit(9, "Зарубежные рынки", "Ли С.", 5)
                        }
                    },
                    new OrgUnit(10, "Финансовый департамент", "Козлов К.М.", 25)
                }
            }
        };
    }

    public class FileSystemItem
    {
        public string Name { get; set; }
        public string Type { get; set; }
        public int Size { get; set; }
        public DateTime Modified { get; set; }
        public List<FileSystemItem>? Children { get; set; }

        public FileSystemItem(string name, string type, int size, DateTime modified)
        {
            Name = name;
            Type = type;
            Size = size;
            Modified = modified;
        }
    }

    public class OrgUnit
    {
        public int Id { get; set; }
        public string Name { get; set; }
        public string Manager { get; set; }
        public int StaffCount { get; set; }
        public List<OrgUnit>? SubUnits { get; set; }

        public OrgUnit(int id, string name, string manager, int staffCount)
        {
            Id = id;
            Name = name;
            Manager = manager;
            StaffCount = staffCount;
        }
    }
}
