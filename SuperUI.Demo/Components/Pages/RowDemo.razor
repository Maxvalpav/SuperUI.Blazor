@page "/row-demo"
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>SgRow & SgCol — Адаптивная сетка — SuperUI</PageTitle>

<SgCard Title="Адаптивная сетка"
        Subtitle="SgRow / SgCol — 12 или 24-колонная Flexbox-сетка с адаптивностью, выравниванием и умным расчётом отступов. SgStack — универсальный flex-контейнер. SgSpace — управление промежутками.">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. SgRow & SgCol — базовая сетка                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <h2 class="demo-section-title">SgRow & SgCol — Базовая сетка</h2>
            <p class="demo-section-desc">Колонки делят строку на 12 (или 24) равных частей. <code>Span</code> задаёт ширину, <code>Space</code> — отступы из дизайн-системы.</p>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Варианты разбивки" Shadow="SgShadow.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <div class="demo-label">Span 12 — полная ширина</div>
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="12">@Col("12", "var(--sg-primary)")</SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div class="demo-label">6 + 6</div>
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="6">@Col("6", "var(--sg-primary)")</SgCol>
                            <SgCol Span="6">@Col("6", "#6366f1")</SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div class="demo-label">4 + 4 + 4</div>
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="4">@Col("4", "var(--sg-primary)")</SgCol>
                            <SgCol Span="4">@Col("4", "#6366f1")</SgCol>
                            <SgCol Span="4">@Col("4", "#8b5cf6")</SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div class="demo-label">3 + 3 + 3 + 3</div>
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="3">@Col("3", "var(--sg-primary)")</SgCol>
                            <SgCol Span="3">@Col("3", "#6366f1")</SgCol>
                            <SgCol Span="3">@Col("3", "#8b5cf6")</SgCol>
                            <SgCol Span="3">@Col("3", "#a855f7")</SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div class="demo-label">8 + 4 (асимметрия)</div>
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="8">@Col("8 — основной контент", "var(--sg-primary)")</SgCol>
                            <SgCol Span="4">@Col("4 — сайдбар", "#6366f1")</SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div class="demo-label">Auto + Fill</div>
                        <SgRow Space="SgSize.Md">
                            <SgCol Auto="true">@ColAuto("Auto")</SgCol>
                            <SgCol Fill="true">@Col("Fill — занимает остаток", "#059669")</SgCol>
                        </SgRow>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Параметры SgRow" Shadow="SgShadow.Sm">
                <PropertyTable Items="_rowProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. SgCol — Offset, Order, 24-колонная сетка                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <h2 class="demo-section-title">SgCol — Offset, Order, Push/Pull</h2>
            <p class="demo-section-desc"><code>Offset</code> сдвигает колонку вправо, <code>Order</code> меняет порядок отображения независимо от разметки.</p>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Примеры" Shadow="SgShadow.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <div class="demo-label">Offset = 3 (сдвиг на 3 колонки)</div>
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="4" Offset="3">@Col("Span 4, Offset 3", "var(--sg-primary)")</SgCol>
                            <SgCol Span="5">@Col("Span 5", "#6366f1")</SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div class="demo-label">Order — визуально меняет порядок</div>
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="6" Order="2">
                                @ColLabeled("Order 2", "В разметке первый", "#ef4444")
                            </SgCol>
                            <SgCol Span="6" Order="1">
                                @ColLabeled("Order 1", "В разметке второй", "#059669")
                            </SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div class="demo-label">24-колонная сетка (Columns=24)</div>
                        <SgRow Space="SgSize.Sm" Columns="24">
                            @for (int i = 0; i < 8; i++)
                            {
                                var idx = i;
                                <SgCol Span="3">@ColThin($"{3}", _palette[idx % _palette.Length])</SgCol>
                            }
                        </SgRow>
                    </div>
                    <div>
                        <div class="demo-label">AlignSelf — индивидуальное выравнивание</div>
                        <SgRow Space="SgSize.Md" MinHeight="80px" Background="var(--sg-surface-alt)" Style="border-radius:6px;padding:8px;">
                            <SgCol Span="4" AlignSelf="SgAlignItems.Start">@ColH("Start", "32px", "var(--sg-primary)")</SgCol>
                            <SgCol Span="4" AlignSelf="SgAlignItems.Center">@ColH("Center", "32px", "#6366f1")</SgCol>
                            <SgCol Span="4" AlignSelf="SgAlignItems.End">@ColH("End", "32px", "#8b5cf6")</SgCol>
                        </SgRow>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Параметры SgCol" Shadow="SgShadow.Sm">
                <PropertyTable Items="_colProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. SgRow — выравнивание / направление                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <h2 class="demo-section-title">SgRow — Выравнивание, направление, перенос</h2>
            <p class="demo-section-desc"><code>Align</code>, <code>Justify</code>, <code>Wrap</code>, <code>Direction</code> — полный контроль над расположением колонок.</p>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Justify = SpaceBetween" Shadow="SgShadow.Sm">
                    <SgRow Space="SgSize.Sm" Justify="SgJustifyContent.SpaceBetween"
                          Background="var(--sg-surface-alt)" Style="padding:12px;border-radius:6px;">
                        <SgCol Auto="true">@ColAuto("A")</SgCol>
                        <SgCol Auto="true">@ColAuto("B")</SgCol>
                        <SgCol Auto="true">@ColAuto("C")</SgCol>
                    </SgRow>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Justify = SpaceEvenly" Shadow="SgShadow.Sm">
                    <SgRow Space="SgSize.Sm" Justify="SgJustifyContent.SpaceEvenly"
                          Background="var(--sg-surface-alt)" Style="padding:12px;border-radius:6px;">
                        <SgCol Auto="true">@ColAuto("X")</SgCol>
                        <SgCol Auto="true">@ColAuto("Y")</SgCol>
                        <SgCol Auto="true">@ColAuto("Z")</SgCol>
                    </SgRow>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Align = Center, разная высота" Shadow="SgShadow.Sm">
                    <SgRow Space="SgSize.Sm" Align="SgAlignItems.Center" MinHeight="80px"
                          Background="var(--sg-surface-alt)" Style="padding:8px;border-radius:6px;">
                        <SgCol Span="4">@ColH("4", "28px", "var(--sg-primary)")</SgCol>
                        <SgCol Span="4">@ColH("4", "52px", "#6366f1")</SgCol>
                        <SgCol Span="4">@ColH("4", "36px", "#8b5cf6")</SgCol>
                    </SgRow>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Direction = Column" Shadow="SgShadow.Sm">
                    <SgRow Space="SgSize.Sm" Direction="SgFlexDirection.Column">
                        <SgCol>@Col("Строка 1", "var(--sg-primary)")</SgCol>
                        <SgCol>@Col("Строка 2", "#6366f1")</SgCol>
                        <SgCol>@Col("Строка 3", "#8b5cf6")</SgCol>
                    </SgRow>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Wrap = NoWrap + горизонтальный скролл" Shadow="SgShadow.Sm">
                    <div style="overflow-x:auto;">
                        <SgRow Space="SgSize.Sm" Wrap="SgFlexWrap.NoWrap" Style="min-width:max-content;">
                            @for (var i = 1; i <= 8; i++)
                            {
                                var idx = i - 1;
                                <SgCol Auto="true">@ColFixed($"{i}", _palette[idx % _palette.Length])</SgCol>
                            }
                        </SgRow>
                    </div>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Wrap = Wrap (перенос)" Shadow="SgShadow.Sm">
                    <SgRow Space="SgSize.Sm" Wrap="SgFlexWrap.Wrap">
                        @for (var i = 1; i <= 6; i++)
                        {
                            var idx = i - 1;
                            <SgCol Span="4">@Col($"Col {i}", _palette[idx % _palette.Length])</SgCol>
                        }
                    </SgRow>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Адаптивные breakpoints                                          -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <h2 class="demo-section-title">SgRow — Адаптивность (xs / sm / md / lg / xl)</h2>
            <p class="demo-section-desc">Измените ширину окна браузера, чтобы увидеть как колонки перестраиваются. Точки: xs &lt; 576, sm ≥ 576, md ≥ 768, lg ≥ 992, xl ≥ 1200.</p>
        </div>

        <SgCard Title="Адаптивная сетка" Shadow="SgShadow.Sm">
            <SgStack Vertical Space="SgSize.Lg">
                <div>
                    <div class="demo-label">xs=12 → sm=6 → md=4 → lg=3</div>
                    <SgRow Space="SgSize.Md">
                        @for (int i = 0; i < 4; i++)
                        {
                            var idx = i;
                            <SgCol Xs="12" Sm="6" Md="4" Lg="3">
                                @ColLabeled($"Col {idx + 1}", "xs=12 sm=6 md=4 lg=3", _palette[idx % _palette.Length])
                            </SgCol>
                        }
                    </SgRow>
                </div>
                <div>
                    <div class="demo-label">Скрытие на мобильных (HideXs)</div>
                    <SgRow Space="SgSize.Md">
                        <SgCol Xs="12" Md="8">@ColLabeled("Основной", "Всегда виден", "var(--sg-primary)")</SgCol>
                        <SgCol Xs="12" Md="4" HideXs="true">@ColLabeled("Сайдбар", "Скрыт на xs", "#6366f1")</SgCol>
                    </SgRow>
                </div>
            </SgStack>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Семантический Tag                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <h2 class="demo-section-title">SgRow — Семантический HTML</h2>
            <p class="demo-section-desc">Параметр <code>Tag</code> рендерит строку как нужный HTML-элемент: <code>div</code>, <code>ul</code>, <code>section</code>, <code>nav</code> и т.д.</p>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Tag='ul' — теги как flex-список" Shadow="SgShadow.Sm">
                <SgRow Tag="ul" Space="SgSize.Sm" Wrap="SgFlexWrap.Wrap">
                    @foreach (var t in _tags)
                    {
                        <li class="demo-tag">@t</li>
                    }
                </SgRow>
            </SgCard>

            <SgCard Title="Tag='nav' — навигационная строка" Shadow="SgShadow.Sm">
                <SgRow Tag="nav" Space="SgSize.Sm" Align="SgAlignItems.Center"
                      Background="var(--sg-surface-alt)" Style="padding:8px 12px;border-radius:6px;">
                    <SgCol Auto="true">
                        <span style="font-weight:700;color:var(--sg-primary);font-size:14px;">SuperUI</span>
                    </SgCol>
                    <SgCol Fill="true"></SgCol>
                    @foreach (var item in _navItems)
                    {
                        <SgCol Auto="true">
                            <span class="demo-nav-item">@item</span>
                        </SgCol>
                    }
                </SgRow>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. SgSpace                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <h2 class="demo-section-title">SgSpace — Управление промежутками</h2>
            <p class="demo-section-desc">Компонент для задания фиксированных промежутков между встроенными элементами без использования сетки. Поддерживает разделители, перенос и вертикальную ориентацию.</p>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Примеры SgSpace" Shadow="SgShadow.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <div class="demo-label">Горизонтальный (по умолчанию)</div>
                        <SgSpace>
                            <SgButton Variant="SgButtonVariant.Primary">Сохранить</SgButton>
                            <SgButton Variant="SgButtonVariant.Outlined">Отмена</SgButton>
                            <SgButton Variant="SgButtonVariant.Ghost">Сбросить</SgButton>
                        </SgSpace>
                    </div>
                    <div>
                        <div class="demo-label">Размеры: small / middle / large</div>
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgSpace Size="small">
                                <SgBadge Variant="SgBadgeVariant.Info" Text="small" Standalone="true" />
                                <SgBadge Variant="SgBadgeVariant.Info" Text="8px" Standalone="true" />
                                <SgBadge Variant="SgBadgeVariant.Info" Text="gap" Standalone="true" />
                            </SgSpace>
                            <SgSpace Size="middle">
                                <SgBadge Variant="SgBadgeVariant.Success" Text="middle" Standalone="true" />
                                <SgBadge Variant="SgBadgeVariant.Success" Text="16px" Standalone="true" />
                                <SgBadge Variant="SgBadgeVariant.Success" Text="gap" Standalone="true" />
                            </SgSpace>
                            <SgSpace Size="large">
                                <SgBadge Variant="SgBadgeVariant.Warn" Text="large" Standalone="true" />
                                <SgBadge Variant="SgBadgeVariant.Warn" Text="24px" Standalone="true" />
                                <SgBadge Variant="SgBadgeVariant.Warn" Text="gap" Standalone="true" />
                            </SgSpace>
                        </SgStack>
                    </div>
                    <div>
                        <div class="demo-label">SgSize enum (Space параметр)</div>
                        <SgSpace Space="SgSize.Lg">
                            <SgButton Variant="SgButtonVariant.Primary" Size="SgSize.Sm">Lg gap</SgButton>
                            <SgButton Variant="SgButtonVariant.Outlined" Size="SgSize.Sm">между</SgButton>
                            <SgButton Variant="SgButtonVariant.Ghost" Size="SgSize.Sm">кнопками</SgButton>
                        </SgSpace>
                    </div>
                    <div>
                        <div class="demo-label">Вертикальная ориентация</div>
                        <SgSpace Orientation="SgOrientation.Vertical" Size="middle">
                            <SgTag>Элемент 1</SgTag>
                            <SgTag>Элемент 2</SgTag>
                            <SgTag>Элемент 3</SgTag>
                        </SgSpace>
                    </div>
                    <div>
                        <div class="demo-label">Wrap — перенос при нехватке места</div>
                        <div style="max-width:320px;padding:8px;border:1px dashed var(--sg-border);border-radius:6px;">
                            <SgSpace Wrap="true" Size="small">
                                @for (int i = 1; i <= 8; i++)
                                {
                                    <SgButton Variant="SgButtonVariant.Outlined" Size="SgSize.Sm">Btn @i</SgButton>
                                }
                            </SgSpace>
                        </div>
                    </div>
                    <div>
                        <div class="demo-label">Split — разделитель между элементами</div>
                        <SgSpace>
                            <ChildContent>
                                <span class="demo-breadcrumb">Главная</span>
                                <span class="demo-breadcrumb">Компоненты</span>
                                <span class="demo-breadcrumb active">SgSpace</span>
                            </ChildContent>
                            <Split>
                                <span style="color:var(--sg-text-muted);padding:0 2px;">/</span>
                            </Split>
                        </SgSpace>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Параметры SgSpace" Shadow="SgShadow.Sm">
                <PropertyTable Items="_spaceProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 7. SgStack                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <h2 class="demo-section-title">SgStack — Универсальный flex-контейнер</h2>
            <p class="demo-section-desc">Мощный примитив для любых flex-раскладок. Поддерживает bool-шорткаты <code>Horizontal</code> / <code>Vertical</code>, разделители, Grow/Fill и все параметры выравнивания.</p>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Horizontal / Vertical шорткаты" Shadow="SgShadow.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <div>
                            <div class="demo-label">Horizontal (по умолчанию)</div>
                            <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <div class="stack-box" style="background:#3b82f6;">A</div>
                                <div class="stack-box" style="background:#6366f1;">B</div>
                                <div class="stack-box" style="background:#8b5cf6;">C</div>
                            </SgStack>
                        </div>
                        <div>
                            <div class="demo-label">Vertical</div>
                            <SgStack Vertical Space="SgSize.Sm">
                                <div class="stack-box wide" style="background:#3b82f6;">Строка 1</div>
                                <div class="stack-box wide" style="background:#6366f1;">Строка 2</div>
                                <div class="stack-box wide" style="background:#8b5cf6;">Строка 3</div>
                            </SgStack>
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>

            <SgCol Md="6">
                <SgCard Title="Justify + Align" Shadow="SgShadow.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <div>
                            <div class="demo-label">Justify = SpaceBetween + Align = Center</div>
                            <SgStack Horizontal Space="SgSize.Sm"
                                     Justify="SgJustifyContent.SpaceBetween"
                                     Align="SgAlignItems.Center"
                                     Style="background:var(--sg-surface-alt);padding:10px;border-radius:6px;min-height:56px;">
                                <SgBadge Variant="SgBadgeVariant.Info" Text="Слева" Standalone="true" />
                                <SgBadge Variant="SgBadgeVariant.Success" Text="Центр" Standalone="true" />
                                <SgBadge Variant="SgBadgeVariant.Warn" Text="Справа" Standalone="true" />
                            </SgStack>
                        </div>
                        <div>
                            <div class="demo-label">Justify = Center</div>
                            <SgStack Horizontal Space="SgSize.Sm"
                                     Justify="SgJustifyContent.Center"
                                     Style="background:var(--sg-surface-alt);padding:10px;border-radius:6px;">
                                <div class="stack-box" style="background:#3b82f6;">1</div>
                                <div class="stack-box" style="background:#6366f1;">2</div>
                                <div class="stack-box" style="background:#8b5cf6;">3</div>
                            </SgStack>
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>

            <SgCol Md="6">
                <SgCard Title="ShowDividers" Shadow="SgShadow.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <div>
                            <div class="demo-label">Горизонтальные разделители</div>
                            <SgStack Horizontal Space="SgSize.Md" ShowDividers="true" Align="SgAlignItems.Center">
                                <span style="font-size:13px;">Файл</span>
                                <span style="font-size:13px;">Правка</span>
                                <span style="font-size:13px;">Вид</span>
                                <span style="font-size:13px;">Помощь</span>
                            </SgStack>
                        </div>
                        <div>
                            <div class="demo-label">Вертикальные разделители</div>
                            <SgStack Vertical Space="SgSize.Sm" ShowDividers="true">
                                <span style="font-size:13px;padding:2px 0;">Пункт меню 1</span>
                                <span style="font-size:13px;padding:2px 0;">Пункт меню 2</span>
                                <span style="font-size:13px;padding:2px 0;">Пункт меню 3</span>
                            </SgStack>
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>

            <SgCol Md="6">
                <SgCard Title="Grow + Fill — реальный layout" Shadow="SgShadow.Sm">
                    <div class="demo-label">Шапка с растягивающимся центром</div>
                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center"
                             Style="background:var(--sg-surface-alt);padding:10px 14px;border-radius:6px;">
                        <SgBadge Variant="SgBadgeVariant.Info" Text="Лого" Standalone="true" />
                        <SgStack Grow="true"></SgStack>
                        <span style="font-size:12px;color:var(--sg-text-muted);">Поиск</span>
                        <SgBadge Variant="SgBadgeVariant.Default" Text="Профиль" Standalone="true" />
                    </SgStack>
                    <div class="demo-label" style="margin-top:16px;">Карточка с footer</div>
                    <SgStack Vertical Space="SgSize.Sm"
                             Style="background:var(--sg-surface-alt);padding:12px;border-radius:6px;min-height:100px;">
                        <SgStack Grow="true">
                            <span style="font-size:13px;color:var(--sg-text-muted);">Контент занимает всё доступное место</span>
                        </SgStack>
                        <SgStack Horizontal Space="SgSize.Sm" Justify="SgJustifyContent.End">
                            <SgButton Variant="SgButtonVariant.Primary" Size="SgSize.Sm">OK</SgButton>
                        </SgStack>
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 8. Живой конструктор                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <h2 class="demo-section-title">Живой конструктор SgRow</h2>
            <p class="demo-section-desc">Настройте параметры и увидите результат в реальном времени.</p>
        </div>

        <SgCard Shadow="SgShadow.Md" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Панель управления ── -->
                <SgCol Xs="12" Md="5" Style="padding:20px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Колонки -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <span class="ctrl-label">Колонок</span>
                            <SgSegmented TValue="int"
                                         Value="_colCount"
                                         ValueChanged="v => _colCount = v"
                                         Block="true"
                                         Size="sm"
                                         Options="_colOptions" />
                        </SgStack>

                        <!-- Space -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <span class="ctrl-label">Space (отступы)</span>
                            <SgSegmented TValue="SgSize"
                                         Value="@(_space ?? SgSize.Md)"
                                         ValueChanged="v => _space = v"
                                         Block="true"
                                         Size="sm"
                                         Options="_spaceSegOptions" />
                        </SgStack>

                        <!-- Wrap -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <span class="ctrl-label">Wrap</span>
                            <SgSegmented TValue="SgFlexWrap"
                                         Value="@(_wrap ?? SgFlexWrap.Wrap)"
                                         ValueChanged="v => _wrap = v"
                                         Block="true"
                                         Size="sm"
                                         Options="_wrapSegOptions" />
                        </SgStack>

                        <!-- Justify + Align рядом -->
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <span class="ctrl-label">Justify</span>
                                    <SgSelect TValue="SgJustifyContent"
                                              @bind-Value="_justify"
                                              Items="_justifyItems"
                                              LabelSelector="x => x.ToString()"
                                              Block="true" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <span class="ctrl-label">Align</span>
                                    <SgSelect TValue="SgAlignItems"
                                              @bind-Value="_align"
                                              Items="_alignItems"
                                              LabelSelector="x => x.ToString()"
                                              Block="true" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Сводка параметров -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <span class="ctrl-summary-key">Columns</span>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_colCount.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <span class="ctrl-summary-key">Span each</span>
                                    <SgBadge Variant="SgBadgeVariant.Success" Text="@((12 / _colCount).ToString())" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <span class="ctrl-summary-key">Justify</span>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_justify.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <span class="ctrl-summary-key">Align</span>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_align.ToString()" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Превью + код ── -->
                <SgCol Xs="12" Md="7" Style="padding:20px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <SgStack Vertical Space="SgSize.Sm">
                            <span class="ctrl-label">Результат</span>
                            <div class="constructor-preview">
                                <SgRow Space="@_space"
                                       Justify="@_justify"
                                       Align="@_align"
                                       Wrap="@_wrap"
                                       MinHeight="72px">
                                    @for (int i = 0; i < _colCount; i++)
                                    {
                                        var idx = i;
                                        var span = 12 / _colCount;
                                        <SgCol Span="@span">
                                            @ColLabeled($"Col {idx + 1}", $"span={span}", _palette[idx % _palette.Length])
                                        </SgCol>
                                    }
                                </SgRow>
                            </div>
                        </SgStack>

                        <SgStack Vertical Space="SgSize.Sm">
                            <span class="ctrl-label">Код</span>
                            <div class="code-block">
<code>&lt;SgRow Space="SgSize.@_space"
      Justify="SgJustifyContent.@_justify"
      Align="SgAlignItems.@_align"
      Wrap="SgFlexWrap.@_wrap"&gt;</code>
                                @for (int i = 0; i < _colCount; i++)
                                {
                                    var span = 12 / _colCount;
<code>  &lt;SgCol Span="@span"&gt;...&lt;/SgCol&gt;</code><br/>
                                }
<code>&lt;/SgRow&gt;</code>
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

</SgCard>

<style>
/* ── Section layout ─────────────────────────────────────────────────────── */
.demo-section {
    margin-top: 48px;
}
.demo-section-header {
    margin-bottom: 20px;
}
