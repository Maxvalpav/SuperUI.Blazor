@page "/row-demo"
@using SuperUI.Components

<PageTitle>SgRow & SgCol — Адаптивная сетка - SUI</PageTitle>

<SgCard Title="Адаптивная сетка"
        Subtitle="SgRow / SgCol — 12-колонная (или 24-колонная) Flexbox-сетка с поддержкой Span/Offset/Order/Push-Pull/Auto-Fill, выравнивания, направления, переноса и breakpoints xs/sm/md/lg/xl.">

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SgRow — базовая сетка                                                 -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2>SgRow & SgCol — Базовая сетка</h2>
        <p>Колонки делят строку на 12 (или 24) равных частей. Параметр <code>Span</code> задаёт ширину, <code>Gutter</code> — расстояние между ними.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Базовая сетка">
                <div style="display:flex;flex-direction:column;gap:12px;">
                    <div>
                        <div style="font-size:12px;color:var(--sui-text-muted);margin-bottom:6px;">12 колонок</div>
                        <SgRow Gutter="8px">
                            <SgCol Span="12">@RenderBox("12")</SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div style="font-size:12px;color:var(--sui-text-muted);margin-bottom:6px;">6 + 6</div>
                        <SgRow Gutter="8px">
                            <SgCol Span="6">@RenderBox("6")</SgCol>
                            <SgCol Span="6">@RenderBox("6")</SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div style="font-size:12px;color:var(--sui-text-muted);margin-bottom:6px;">4 + 4 + 4</div>
                        <SgRow Gutter="8px">
                            <SgCol Span="4">@RenderBox("4")</SgCol>
                            <SgCol Span="4">@RenderBox("4")</SgCol>
                            <SgCol Span="4">@RenderBox("4")</SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div style="font-size:12px;color:var(--sui-text-muted);margin-bottom:6px;">Auto + Fill</div>
                        <SgRow Gutter="8px">
                            <SgCol Auto="true">@RenderBox("Auto")</SgCol>
                            <SgCol Fill="true">@RenderBox("Fill — занимает всё оставшееся")</SgCol>
                        </SgRow>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства SgRow">
                <PropertyTable Items="_rowProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SgCol — Offset, Order, Push/Pull                                      -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2>SgCol — Offset, Order, Push/Pull</h2>
        <p><code>Offset</code> сдвигает колонку вправо, <code>Order</code> меняет порядок отображения, <code>Push/Pull</code> — относительный сдвиг.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display:flex;flex-direction:column;gap:12px;">
                    <div>
                        <div style="font-size:12px;color:var(--sui-text-muted);margin-bottom:6px;">Offset = 4</div>
                        <SgRow Gutter="8px">
                            <SgCol Span="4" Offset="4">@RenderBox("Span 4, Offset 4")</SgCol>
                            <SgCol Span="4">@RenderBox("Span 4")</SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div style="font-size:12px;color:var(--sui-text-muted);margin-bottom:6px;">Order — визуально 2 → 1</div>
                        <SgRow Gutter="8px">
                            <SgCol Span="6" Order="2">@RenderBox("Order 2 (в разметке первый)")</SgCol>
                            <SgCol Span="6" Order="1">@RenderBox("Order 1")</SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div style="font-size:12px;color:var(--sui-text-muted);margin-bottom:6px;">Push/Pull (визуально меняет порядок)</div>
                        <SgRow Gutter="8px">
                            <SgCol Span="6" Push="6">@RenderBox("Push 6")</SgCol>
                            <SgCol Span="6" Pull="6">@RenderBox("Pull 6")</SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div style="font-size:12px;color:var(--sui-text-muted);margin-bottom:6px;">24-колонная сетка</div>
                        <SgRow Gutter="8px" Columns="24">
                            <SgCol Span="6">@RenderBox("6")</SgCol>
                            <SgCol Span="6">@RenderBox("6")</SgCol>
                            <SgCol Span="6">@RenderBox("6")</SgCol>
                            <SgCol Span="6">@RenderBox("6")</SgCol>
                        </SgRow>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства SgCol">
                <PropertyTable Items="_colProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SgRow — выравнивание / направление                                    -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2>SgRow — Выравнивание, направление, перенос</h2>
        <p>Параметры <code>Align</code>, <code>Justify</code>, <code>Wrap</code>, <code>Direction</code> управляют расположением колонок. <code>Inline</code> — рендер inline-flex, <code>Tag</code> — выбор HTML-элемента (<code>section/header/nav/ul/...</code>).</p>

        <SgRow Gutter="16px" Style="margin-top:16px;">
            <SgCol Md="6">
                <SgCard Title="Justify=SpaceBetween">
                    <SgRow Gutter="8px" Justify="SgJustifyContent.SpaceBetween" Style="background:var(--sui-bg-secondary);padding:8px;border-radius:6px;">
                        <SgCol Auto="true">@RenderBox("A")</SgCol>
                        <SgCol Auto="true">@RenderBox("B")</SgCol>
                        <SgCol Auto="true">@RenderBox("C")</SgCol>
                    </SgRow>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Align=Center, высота 80px">
                    <SgRow Gutter="8px" Align="SgAlignItems.Center" Style="height:80px;background:var(--sui-bg-secondary);padding:8px;border-radius:6px;">
                        <SgCol Span="4">@RenderBox("4", "32px")</SgCol>
                        <SgCol Span="4">@RenderBox("4", "48px")</SgCol>
                        <SgCol Span="4">@RenderBox("4", "24px")</SgCol>
                    </SgRow>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Direction=Column">
                    <SgRow Gutter="6px" Direction="SgFlexDirection.Column">
                        <SgCol>@RenderBox("Row 1")</SgCol>
                        <SgCol>@RenderBox("Row 2")</SgCol>
                        <SgCol>@RenderBox("Row 3")</SgCol>
                    </SgRow>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Wrap=NoWrap, скролл">
                    <div style="overflow-x:auto;">
                        <SgRow Gutter="8px" Wrap="SgFlexWrap.NoWrap" Style="min-width:max-content;">
                            @for (var i = 1; i <= 8; i++)
                            {
                                <SgCol Auto="true">@RenderBox($"Item {i}", "auto", "120px")</SgCol>
                            }
                        </SgRow>
                    </div>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SgRow — Gutter axes                                                   -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2>SgRow — Раздельные отступы по осям</h2>
        <p><code>Gutter</code> задаёт общий gap. <code>RowGutter</code> и <code>ColumnGutter</code> позволяют управлять вертикальным и горизонтальным отступами раздельно.</p>

        <SgCard Title="RowGutter=24px, ColumnGutter=4px" Style="margin-top:16px;">
            <SgRow RowGutter="24px" ColumnGutter="4px">
                @for (var i = 1; i <= 8; i++)
                {
                    <SgCol Span="3">@RenderBox($"#{i}")</SgCol>
                }
            </SgRow>
        </SgCard>
    </div>

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SgRow — адаптивные breakpoints                                        -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2>SgRow — Адаптивность (xs/sm/md/lg/xl)</h2>
        <p>Колонки можно настроить под разные ширины экрана. Измените ширину окна — колонки перестроятся. Точки: xs &lt; 576, sm ≥ 576, md ≥ 768, lg ≥ 992, xl ≥ 1200.</p>

        <SgCard Title="Адаптивная сетка" Style="margin-top:16px;">
            <SgRow Gutter="8px">
                <SgCol Xs="12" Sm="6" Md="4" Lg="3">@RenderBox("xs=12 sm=6 md=4 lg=3")</SgCol>
                <SgCol Xs="12" Sm="6" Md="4" Lg="3">@RenderBox("xs=12 sm=6 md=4 lg=3")</SgCol>
                <SgCol Xs="12" Sm="6" Md="4" Lg="3">@RenderBox("xs=12 sm=6 md=4 lg=3")</SgCol>
                <SgCol Xs="12" Sm="6" Md="12" Lg="3">@RenderBox("xs=12 sm=6 md=12 lg=3")</SgCol>
            </SgRow>
        </SgCard>
    </div>

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SgRow — семантический Tag                                             -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2>SgRow — Семантический HTML</h2>
        <p>Параметр <code>Tag</code> рендерит строку как нужный элемент: <code>div</code> (по умолчанию), <code>section</code>, <code>header</code>, <code>footer</code>, <code>nav</code>, <code>main</code>, <code>ul</code>. Для <code>ul</code> сбрасываются стили списка.</p>

        <SgCard Title="Tag=&quot;ul&quot; — список как flex-row" Style="margin-top:16px;">
            <SgRow Tag="ul" Gutter="8px" Wrap="SgFlexWrap.Wrap">
                @foreach (var t in _tags)
                {
                    <li style="background:var(--sui-bg-secondary);padding:6px 12px;border-radius:999px;font-size:12px;color:var(--sui-text-secondary);">@t</li>
                }
            </SgRow>
        </SgCard>
    </div>

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SgRow — паттерны                                                      -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2>Паттерны использования</h2>
        <p>Готовые композиции — типовые лэйауты страниц.</p>

        <SgCard Title="Header / Sidebar / Content" Style="margin-top:16px;">
            <SgRow Direction="SgFlexDirection.Column" Gutter="0" Style="border:1px solid var(--sui-border);border-radius:6px;overflow:hidden;">
                <SgRow Tag="header" Gutter="0" Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center" Style="background:var(--sui-bg-secondary);padding:10px 14px;">
                    <SgCol Auto="true"><b>App Header</b></SgCol>
                    <SgCol Auto="true" Style="font-size:12px;color:var(--sui-text-muted);">user@example.com</SgCol>
                </SgRow>
                <SgRow Gutter="0" NoWrap="true" Style="min-height:140px;">
                    <SgCol Span="3" Tag="div" Style="background:var(--sui-bg-secondary);padding:10px;font-size:12px;border-right:1px solid var(--sui-border);">
                        <div style="font-weight:600;margin-bottom:6px;">Sidebar</div>
                        <div style="color:var(--sui-text-muted);">Меню разделов</div>
                    </SgCol>
                    <SgCol Fill="true" Style="padding:14px;">
                        Основной контент. Используется <code>SgRow Direction=Column</code> снаружи и <code>SgRow NoWrap</code> внутри
                        для разделения на сайдбар и main-area.
                    </SgCol>
                </SgRow>
            </SgRow>
        </SgCard>

        <SgCard Title="Карточная галерея" Style="margin-top:16px;">
            <SgRow Gutter="12px">
                @for (var i = 1; i <= 8; i++)
                {
                    <SgCol Xs="12" Sm="6" Md="4" Lg="3">
                        <SgCard Variant="SgCardVariant.Filled" Compact="true" Hoverable="true">
                            <div style="height:60px;border-radius:4px;background:linear-gradient(120deg,var(--sui-accent),#722ed1);margin-bottom:8px;"></div>
                            <div style="font-weight:600;">Item @i</div>
                            <div style="font-size:11px;color:var(--sui-text-muted);">xs=12 sm=6 md=4 lg=3</div>
                        </SgCard>
                    </SgCol>
                }
            </SgRow>
        </SgCard>
    </div>
</SgCard>

@code {
    private readonly string[] _tags =
    {
        "Blazor", "Components", "Grid", "Flexbox", "Responsive",
        "Layout", "Adaptive", "12-column", "Breakpoints", "Gutter"
    };

    private RenderFragment RenderBox(string text, string height = "auto", string minWidth = "auto") => __builder =>
    {
        <div style="@($"background:var(--sui-accent,#1890ff);color:#fff;padding:10px;border-radius:6px;text-align:center;font-size:12px;height:{height};min-width:{minWidth};display:flex;align-items:center;justify-content:center;")">
            @text
        </div>
    };

    private List<PropertyPanelItem> _rowProperties = new()
    {
        new() { Label = "Gutter",       Value = "string? (CSS length)",       BadgeText = "Отступы",     BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "RowGutter",    Value = "string?",                    BadgeText = "Вертик.",     BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ColumnGutter", Value = "string?",                    BadgeText = "Горизонт.",   BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Columns",      Value = "int (12 / 24)",              BadgeText = "Колонок",     BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Align",        Value = "SgAlignItems",               BadgeText = "Cross-axis",  BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Justify",      Value = "SgJustifyContent",           BadgeText = "Main-axis",   BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Wrap",         Value = "Wrap | NoWrap | WrapReverse",BadgeText = "Перенос",     BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "NoWrap",       Value = "bool (legacy)",              BadgeText = "Без переноса",BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Direction",    Value = "Row|RowReverse|Column|ColumnReverse", BadgeText = "Направление", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Reverse",      Value = "bool (legacy)",              BadgeText = "Реверс",      BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Inline",       Value = "bool",                       BadgeText = "inline-flex", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "FullWidth",    Value = "bool (true)",                BadgeText = "100% ширины", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Tag",          Value = "div|section|header|footer|nav|main|ul", BadgeText = "HTML-тег", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "OnClick",      Value = "EventCallback<MouseEventArgs>", BadgeText = "Клик",     BadgeVariant = SgBadgeVariant.Success },
    };

    private List<PropertyPanelItem> _colProperties = new()
    {
        new() { Label = "Span",   Value = "int? (1..Columns)",      BadgeText = "Ширина",       BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Offset", Value = "int",                    BadgeText = "Сдвиг",        BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Order",  Value = "int?",                   BadgeText = "Порядок",      BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Push",   Value = "int",                    BadgeText = "Сдвиг вправо", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Pull",   Value = "int",                    BadgeText = "Сдвиг влево",  BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Auto",   Value = "bool",                   BadgeText = "По контенту",  BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Fill",   Value = "bool",                   BadgeText = "Остаток",      BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Flex",   Value = "string? (CSS flex)",     BadgeText = "flex shorthand", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "AlignSelf", Value = "SgAlignItems?",       BadgeText = "Выравнивание", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Xs/Sm/Md/Lg/Xl", Value = "int (1..12)",    BadgeText = "Адаптив",      BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "OffsetXs..OffsetXl", Value = "int",        BadgeText = "Адаптивный сдвиг", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "OnClick", Value = "EventCallback<MouseEventArgs>", BadgeText = "Клик", BadgeVariant = SgBadgeVariant.Success },
    };
}
