    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add($"<SgRow Space=\"SgSize.{_space?.ToString() ?? "Md"}\"");
        lines.Add($"       Justify=\"SgJustifyContent.{_justify}\"");
        lines.Add($"       Align=\"SgAlignItems.{_align}\"");
        lines.Add($"       Wrap=\"SgFlexWrap.{_wrap?.ToString() ?? "Wrap"}\"");
        if (_direction != SgFlexDirection.Row)
            lines.Add($"       Direction=\"SgFlexDirection.{_direction}\"");
        if (_inline)
            lines.Add($"       Inline=\"true\"");
        if (!_fullWidth)
            lines.Add($"       FullWidth=\"false\"");
        lines.Add($"       MinHeight=\"72px\">");

        var span = 12 / _colCount;
        for (int i = 0; i < _colCount; i++)
        {
            lines.Add($"    <SgCol Span=\"{span}\">...Col {i + 1}...</SgCol>");
        }
        lines.Add("</SgRow>");
        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

