@page "/row-demo"
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>SgRow & SgCol — Адаптивная сетка - SUI</PageTitle>

<SgCard Title="Адаптивная сетка"
        Subtitle="SgRow / SgCol — 12 или 24-колонная Flexbox-сетка с поддержкой адаптивности и умным расчетом отступов.">

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SgRow — базовая сетка                                                 -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2>SgRow & SgCol — Базовая сетка</h2>
        <p>Колонки делят строку на 12 (или 24) равных частей. Параметр <code>Span</code> задаёт ширину, <code>Space</code> — расстояние между ними из дизайн-системы.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Базовая сетка">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <div class="demo-label">12 колонок (Span 12)</div>
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="12">@RenderBox("12")</SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div class="demo-label">6 + 6</div>
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="6">@RenderBox("6")</SgCol>
                            <SgCol Span="6">@RenderBox("6")</SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div class="demo-label">4 + 4 + 4</div>
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="4">@RenderBox("4")</SgCol>
                            <SgCol Span="4">@RenderBox("4")</SgCol>
                            <SgCol Span="4">@RenderBox("4")</SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div class="demo-label">Auto + Fill</div>
                        <SgRow Space="SgSize.Md">
                            <SgCol Auto="true">@RenderBox("Auto Content")</SgCol>
                            <SgCol Fill="true">@RenderBox("Fill — всё остальное")</SgCol>
                        </SgRow>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Свойства SgRow">
                <PropertyTable Items="_rowProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SgCol — Offset, Order, Push/Pull                                      -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2>SgCol — Offset, Order, Push/Pull</h2>
        <p><code>Offset</code> сдвигает колонку вправо, <code>Order</code> меняет порядок отображения, <code>Push/Pull</code> — относительный сдвиг.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <div class="demo-label">Offset = 4</div>
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="4" Offset="4">@RenderBox("Span 4, Offset 4")</SgCol>
                            <SgCol Span="4">@RenderBox("Span 4")</SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div class="demo-label">Order — визуально 2 → 1</div>
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="6" Order="2">@RenderBox("Order 2 (в разметке первый)")</SgCol>
                            <SgCol Span="6" Order="1">@RenderBox("Order 1")</SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div class="demo-label">24-колонная сетка</div>
                        <SgRow Space="SgSize.Md" Columns="24">
                            <SgCol Span="6">@RenderBox("6")</SgCol>
                            <SgCol Span="6">@RenderBox("6")</SgCol>
                            <SgCol Span="6">@RenderBox("6")</SgCol>
                            <SgCol Span="6">@RenderBox("6")</SgCol>
                        </SgRow>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Свойства SgCol">
                <PropertyTable Items="_colProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SgRow — выравнивание / направление                                    -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2>SgRow — Выравнивание, направление, перенос</h2>
        <p>Параметры <code>Align</code>, <code>Justify</code>, <code>Wrap</code>, <code>Direction</code> управляют расположением колонок.</p>

        <SgRow Space="SgSize.Lg" Style="margin-top:16px;">
            <SgCol Md="6">
                <SgCard Title="Justify=SpaceBetween">
                    <SgRow Space="SgSize.Sm" Justify="SgJustifyContent.SpaceBetween" Style="background:var(--sg-surface-alt);padding:8px;border-radius:6px;">
                        <SgCol Auto="true">@RenderBox("A")</SgCol>
                        <SgCol Auto="true">@RenderBox("B")</SgCol>
                        <SgCol Auto="true">@RenderBox("C")</SgCol>
                    </SgRow>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Align=Center, высота 80px">
                    <SgRow Space="SgSize.Sm" Align="SgAlignItems.Center" Style="height:80px;background:var(--sg-surface-alt);padding:8px;border-radius:6px;">
                        <SgCol Span="4">@RenderBox("4", "32px")</SgCol>
                        <SgCol Span="4">@RenderBox("4", "48px")</SgCol>
                        <SgCol Span="4">@RenderBox("4", "24px")</SgCol>
                    </SgRow>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Direction=Column">
                    <SgRow Space="SgSize.Sm" Direction="SgFlexDirection.Column">
                        <SgCol>@RenderBox("Row 1")</SgCol>
                        <SgCol>@RenderBox("Row 2")</SgCol>
                        <SgCol>@RenderBox("Row 3")</SgCol>
                    </SgRow>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Wrap=NoWrap, скролл">
                    <div style="overflow-x:auto;">
                        <SgRow Space="SgSize.Sm" Wrap="SgFlexWrap.NoWrap" Style="min-width:max-content;">
                            @for (var i = 1; i <= 8; i++)
                            {
                                <SgCol Auto="true">@RenderBox($"{i}", "auto", "60px")</SgCol>
                            }
                        </SgRow>
                    </div>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SgRow — адаптивные breakpoints                                        -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2>SgRow — Адаптивность (xs/sm/md/lg/xl)</h2>
        <p>Колонки можно настроить под разные ширины экрана. Точки: xs &lt; 576, sm &ge; 576, md &ge; 768, lg &ge; 992, xl &ge; 1200.</p>

        <SgCard Title="Адаптивная сетка" Style="margin-top:16px;">
            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Sm="6" Md="4" Lg="3">@RenderBox("xs=12 sm=6 md=4 lg=3")</SgCol>
                <SgCol Xs="12" Sm="6" Md="4" Lg="3">@RenderBox("xs=12 sm=6 md=4 lg=3")</SgCol>
                <SgCol Xs="12" Sm="6" Md="4" Lg="3">@RenderBox("xs=12 sm=6 md=4 lg=3")</SgCol>
                <SgCol Xs="12" Sm="6" Md="12" Lg="3">@RenderBox("xs=12 sm=6 md=12 lg=3")</SgCol>
            </SgRow>
        </SgCard>
    </div>

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SgRow — семантический Tag                                             -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2>SgRow — Семантический HTML</h2>
        <p>Параметр <code>tag</code> рендерит строку как нужный элемент: <code>div</code> (по умолчанию), <code>ul</code>, <code>section</code> и т.д.</p>

        <SgCard Title="Tag='ul' — список как flex-row" Style="margin-top:16px;">
            <SgRow Tag="ul" Space="SgSize.Sm" Wrap="SgFlexWrap.Wrap">
                @foreach (var t in _tags)
                {
                    <li style="background:var(--sg-surface-alt);padding:6px 14px;border-radius:20px;font-size:12px;color:var(--sg-text-muted);border:1px solid var(--sg-border);list-style:none;">@t</li>
                }
            </SgRow>
        </SgCard>
    </div>

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SgSpace — управление отступами                                        -->
    <!-- ─────────────────────────────────────────────────────────────────── -->
    <div style="margin-top: 32px;">
        <h2>SgSpace — Управление отступами</h2>
        <p>Компонент для задания фиксированных промежутков между любыми встроенными элементами без использования сетки.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры Space">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <div class="demo-label">Базовое использование</div>
                        <SgSpace>
                            <SgButton Variant="SgButtonVariant.Primary">Button 1</SgButton>
                            <SgButton Variant="SgButtonVariant.Outlined">Button 2</SgButton>
                            <SgButton Variant="SgButtonVariant.Ghost">Button 3</SgButton>
                        </SgSpace>
                    </div>
                    <div>
                        <div class="demo-label">Вертикальная ориентация</div>
                        <SgSpace Orientation="SgOrientation.Vertical" Size="middle">
                            <SgTag>Item 1</SgTag>
                            <SgTag>Item 2</SgTag>
                            <SgTag>Item 3</SgTag>
                        </SgSpace>
                    </div>
                    <div>
                        <div class="demo-label">Перенос (Wrap)</div>
                        <div style="max-width:300px; padding:8px; border:1px dashed var(--sg-border); border-radius:4px;">
                            <SgSpace Wrap="true" Size="small">
                                @for (int i = 1; i <= 6; i++)
                                {
                                    <SgButton Variant="SgButtonVariant.Outlined" Size="SgSize.Sm">Btn @i</SgButton>
                                }
                            </SgSpace>
                        </div>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Свойства SgSpace">
                <PropertyTable Items="_spaceProperties" />
            </SgCard>
        </div>
    </div>
</SgCard>

<style>
    .demo-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--sg-text-muted);
        margin-bottom: 12px;
        display: block;
        border-bottom: 1px solid var(--sg-border);
        padding-bottom: 4px;
    }
</style>

@code {
    private readonly string[] _tags =
    {
        "Blazor", "Components", "Grid", "Flexbox", "Responsive",
        "Layout", "Adaptive", "12-column", "Breakpoints", "Gutter"
    };

    private RenderFragment RenderBox(string text, string height = "auto", string minWidth = "auto") => __builder =>
    {
        <div style="@($"background:var(--sg-primary);color:white;padding:10px;border-radius:4px;text-align:center;font-size:12px;height:{height};min-width:{minWidth};display:flex;align-items:center;justify-content:center;font-weight:600;")">
            @text
        </div>
    };

    private List<PropertyPanelItem> _rowProperties = new()
    {
        new() { Label = "Space",         Value = "SgSize",                     BadgeText = "Отступы",     BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Gutter",        Value = "string? (CSS length)",       BadgeText = "Custom Gap",  BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Columns",       Value = "int (12 / 24)",              BadgeText = "Колонок",     BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Align",         Value = "SgAlignItems",               BadgeText = "Cross-axis",  BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Justify",       Value = "SgJustifyContent",           BadgeText = "Main-axis",   BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Wrap",          Value = "SgFlexWrap",                 BadgeText = "Перенос",     BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Direction",     Value = "SgFlexDirection",            BadgeText = "Направление", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Tag",           Value = "string (div|ul|...)",        BadgeText = "HTML-тег",    BadgeVariant = SgBadgeVariant.Default },
    };

    private List<PropertyPanelItem> _colProperties = new()
    {
        new() { Label = "Span",   Value = "int? (1..Columns)",      BadgeText = "Ширина",       BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Offset", Value = "int",                    BadgeText = "Сдвиг",        BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Order",  Value = "int?",                   BadgeText = "Порядок",      BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Auto",   Value = "bool",                   BadgeText = "По контенту",  BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Fill",   Value = "bool",                   BadgeText = "Остаток",      BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Xs/Sm/Md/Lg/Xl", Value = "int (1..12)",    BadgeText = "Адаптив",      BadgeVariant = SgBadgeVariant.Warn },
    };

    private List<PropertyPanelItem> _spaceProperties = new()
    {
        new() { Label = "Size",        Value = "string (sm|md|lg|px)", BadgeText = "Отступ",      BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Orientation", Value = "SgOrientation",        BadgeText = "Направление", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Align",       Value = "SgAlignItems",         BadgeText = "Выравнивание", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Wrap",        Value = "bool",                 BadgeText = "Перенос",      BadgeVariant = SgBadgeVariant.Warn },
    };
}
