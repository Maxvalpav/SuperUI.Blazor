@page "/row-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgRow / SgCol / SgStack / SgSpace — SuperUI</PageTitle>

<SgStack Gap="SgSize.Md" Density="@SgDensity.Comfortable" Stretch="false">

    @* ── Hero ─────────────────────────────────────────────────────────── *@
    <SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg" Status="SgCardStatus.Info">
        <HeaderContent>
            <DemoPageHeader Title="Adaptive Grid"
                            Subtitle="SgRow / SgCol — 12 or 24-column Flexbox grid. SgStack — flex container with density, stretch, and item-basis. SgSpace — gap + separator primitive."
                            Icon="@SgHeroicons.Outline.ViewColumns" />
        </HeaderContent>
    </SgCard>

    @* ── 1. Density ────────────────────────────────────────────────────── *@
    <SgCard Title="Density" Subtitle="Compact · Default · Comfortable — scales internal gap via theme tokens."
            Variant="SgCardVariant.Outlined" Status="SgCardStatus.Info">
        <ChildContent>
            <SgRow Gap="@_densityGap" Columns="3" FullHeight="true" Style="min-height:120px;">
                <SgCol Style="padding:12px;border:1px dashed var(--sg-border);border-radius:6px;background:var(--sg-color-info-subtle);">
                    <SgStack Gap="4px" Density="@SgDensity.Compact">
                        <SgTypography Weight="SgTypographyWeight.Bold" Size="SgTypographySize.Sm">Compact</SgTypography>
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">density=Compact · gap 4px</SgTypography>
                        <SgButton Variant="SgButtonVariant.Primary" Size="SgSize.Sm">Action</SgButton>
                        <SgTag>Tag</SgTag>
                    </SgStack>
                </SgCol>
                <SgCol Style="padding:16px;border:1px dashed var(--sg-border);border-radius:6px;background:var(--sg-color-success-subtle);">
                    <SgStack Gap="8px" Density="@SgDensity.Default">
                        <SgTypography Weight="SgTypographyWeight.Bold">Default</SgTypography>
                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">density=Default · gap 8px</SgTypography>
                        <SgButton Variant="SgButtonVariant.Primary">Action</SgButton>
                        <SgTag>Tag</SgTag>
                    </SgStack>
                </SgCol>
                <SgCol Style="padding:24px;border:1px dashed var(--sg-border);border-radius:6px;background:var(--sg-color-warning-subtle);">
                    <SgStack Gap="16px" Density="@SgDensity.Comfortable">
                        <SgTypography Weight="SgTypographyWeight.Bold" Size="SgTypographySize.Lg">Comfortable</SgTypography>
                        <SgTypography Color="var(--sg-text-muted)">density=Comfortable · gap 16px</SgTypography>
                        <SgButton Variant="SgButtonVariant.Primary" Size="SgSize.Lg">Action</SgButton>
                        <SgTag>Tag</SgTag>
                    </SgStack>
                </SgCol>
            </SgRow>
        </ChildContent>
    </SgCard>

    @* ── 2. 12 / 24 columns ────────────────────────────────────────────── *@
    <SgCard Title="Span — 12 & 24 columns" Subtitle="SgCol Span automatically respects the parent SgRow Columns count."
            Variant="SgCardVariant.Outlined" Status="SgCardStatus.Success">
        <ChildContent>
            <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Style="display:block;margin-bottom:6px;">12-column grid (default)</SgTypography>
            <SgRow Gap="6px" Style="margin-bottom:12px;">
                <SgCol Span="1"><div class="rd-cell">1</div></SgCol>
                <SgCol Span="1"><div class="rd-cell">1</div></SgCol>
                <SgCol Span="1"><div class="rd-cell">1</div></SgCol>
                <SgCol Span="1"><div class="rd-cell">1</div></SgCol>
                <SgCol Span="1"><div class="rd-cell">1</div></SgCol>
                <SgCol Span="1"><div class="rd-cell">1</div></SgCol>
                <SgCol Span="1"><div class="rd-cell">1</div></SgCol>
                <SgCol Span="1"><div class="rd-cell">1</div></SgCol>
                <SgCol Span="1"><div class="rd-cell">1</div></SgCol>
                <SgCol Span="1"><div class="rd-cell">1</div></SgCol>
                <SgCol Span="1"><div class="rd-cell">1</div></SgCol>
                <SgCol Span="1"><div class="rd-cell">1</div></SgCol>
            </SgRow>
            <SgRow Gap="6px" Style="margin-bottom:12px;">
                <SgCol Span="6"><div class="rd-cell rd-cell-h">6</div></SgCol>
                <SgCol Span="3"><div class="rd-cell rd-cell-h">3</div></SgCol>
                <SgCol Span="3"><div class="rd-cell rd-cell-h">3</div></SgCol>
            </SgRow>
            <SgRow Gap="6px" Style="margin-bottom:16px;">
                <SgCol Span="4"><div class="rd-cell">4</div></SgCol>
                <SgCol Span="4"><div class="rd-cell">4</div></SgCol>
                <SgCol Span="4"><div class="rd-cell">4</div></SgCol>
            </SgRow>

            <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Style="display:block;margin-bottom:6px;">24-column grid (Columns=24)</SgTypography>
            <SgRow Columns="24" Gap="4px">
                @for (int i = 1; i <= 24; i++)
                {
                    <SgCol Span="1"><div class="rd-cell rd-cell-xs">@i</div></SgCol>
                }
            </SgRow>
        </ChildContent>
    </SgCard>

    @* ── 3. Offset & Order ─────────────────────────────────────────────── *@
    <SgCard Title="Offset & Order" Subtitle="Shift columns right, reorder them via CSS order, hide on demand."
            Variant="SgCardVariant.Outlined" Status="SgCardStatus.Warning">
        <ChildContent>
            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:6px;">Offset</SgTypography>
            <SgRow Gap="6px" Style="margin-bottom:12px;">
                <SgCol Span="2"><div class="rd-cell">2</div></SgCol>
                <SgCol Span="3" OffsetMd="2"><div class="rd-cell rd-cell-accent">3 + offset 2</div></SgCol>
                <SgCol Span="3"><div class="rd-cell">3</div></SgCol>
            </SgRow>

            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:6px;">Reorder (Order)</SgTypography>
            <SgRow Gap="6px" Style="margin-bottom:12px;">
                <SgCol Span="3" Order="3"><div class="rd-cell">A · order=3 (last)</div></SgCol>
                <SgCol Span="3" Order="1"><div class="rd-cell">B · order=1 (first)</div></SgCol>
                <SgCol Span="3" Order="2"><div class="rd-cell">C · order=2</div></SgCol>
            </SgRow>

            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:6px;">Hide at breakpoint</SgTypography>
            <SgRow Gap="6px">
                <SgCol Span="3"><div class="rd-cell">Always</div></SgCol>
                <SgCol Span="3" HideXs="true"><div class="rd-cell rd-cell-accent">Hidden XS</div></SgCol>
                <SgCol Span="3" HideMd="true"><div class="rd-cell">Hidden MD+</div></SgCol>
                <SgCol Span="3" HideLg="true"><div class="rd-cell">Hidden LG+</div></SgCol>
            </SgRow>
        </ChildContent>
    </SgCard>

    @* ── 4. Responsive ─────────────────────────────────────────────────── *@
    <SgCard Title="Responsive breakpoints" Subtitle="XS · SM · MD · LG · XL — resize the window to see them reflow."
            Variant="SgCardVariant.Outlined" Status="SgCardStatus.Info">
        <ChildContent>
            <SgStack Gap="6px">
                <SgStack Horizontal="true" Gap="4px" Wrap="true">
                    <SgTag>XS &lt;576px</SgTag>
                    <SgTag>SM ≥576</SgTag>
                    <SgTag>MD ≥768</SgTag>
                    <SgTag>LG ≥992</SgTag>
                    <SgTag>XL ≥1200</SgTag>
                </SgStack>
                <SgRow Gap="6px">
                    <SgCol Span="12" Sm="6" Md="4" Lg="3" Xl="2"><div class="rd-cell">12 → 6 → 4 → 3 → 2</div></SgCol>
                    <SgCol Span="12" Sm="6" Md="4" Lg="3" Xl="2"><div class="rd-cell">12 → 6 → 4 → 3 → 2</div></SgCol>
                    <SgCol Span="12" Sm="6" Md="4" Lg="3" Xl="2"><div class="rd-cell">12 → 6 → 4 → 3 → 2</div></SgCol>
                    <SgCol Span="12" Sm="6" Md="4" Lg="3" Xl="2"><div class="rd-cell">12 → 6 → 4 → 3 → 2</div></SgCol>
                </SgRow>
                <SgRow Gap="6px">
                    <SgCol Span="6" Md="3" Lg="6" Xl="3" AlignSelfMd="@SgAlignItems.Center"><div class="rd-cell">self=stretch · center MD</div></SgCol>
                    <SgCol Span="6" Md="3" Lg="6" Xl="3" AlignSelfMd="@SgAlignItems.End"><div class="rd-cell">self=stretch · end MD</div></SgCol>
                    <SgCol Span="6" Md="3" Lg="6" Xl="3" AlignSelfMd="@SgAlignItems.Start"><div class="rd-cell">self=stretch · start MD</div></SgCol>
                    <SgCol Span="6" Md="3" Lg="6" Xl="3" AlignSelfMd="@SgAlignItems.Baseline"><div class="rd-cell">self=stretch · baseline MD</div></SgCol>
                </SgRow>
            </SgStack>
        </ChildContent>
    </SgCard>

    @* ── 5. Auto-fit & ItemWidth ───────────────────────────────────────── *@
    <SgCard Title="Auto-fit & ItemWidth" Subtitle="SgRow AutoFit wraps children when they exceed ItemWidth."
            Variant="SgCardVariant.Outlined" Status="SgCardStatus.Danger">
        <ChildContent>
            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:6px;">AutoFit, ItemWidth=180</SgTypography>
            <SgRow AutoFit="true" ItemWidth="180" Gap="8px" Style="margin-bottom:12px;">
                <SgCol><div class="rd-cell">Card 1</div></SgCol>
                <SgCol><div class="rd-cell">Card 2</div></SgCol>
                <SgCol><div class="rd-cell">Card 3</div></SgCol>
                <SgCol><div class="rd-cell">Card 4</div></SgCol>
                <SgCol><div class="rd-cell">Card 5</div></SgCol>
                <SgCol><div class="rd-cell">Card 6</div></SgCol>
                <SgCol><div class="rd-cell">Card 7</div></SgCol>
            </SgRow>

            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:6px;">AutoFit, ItemWidth=120 (tighter)</SgTypography>
            <SgRow AutoFit="true" ItemWidth="120" Gap="8px">
                <SgCol><div class="rd-cell rd-cell-sm">A</div></SgCol>
                <SgCol><div class="rd-cell rd-cell-sm">B</div></SgCol>
                <SgCol><div class="rd-cell rd-cell-sm">C</div></SgCol>
                <SgCol><div class="rd-cell rd-cell-sm">D</div></SgCol>
                <SgCol><div class="rd-cell rd-cell-sm">E</div></SgCol>
                <SgCol><div class="rd-cell rd-cell-sm">F</div></SgCol>
                <SgCol><div class="rd-cell rd-cell-sm">G</div></SgCol>
                <SgCol><div class="rd-cell rd-cell-sm">H</div></SgCol>
            </SgRow>
        </ChildContent>
    </SgCard>

    @* ── 6. Alignment / Direction / Wrap ───────────────────────────────── *@
    <SgCard Title="Alignment · Direction · Wrap" Subtitle="Cross-axis Align, main-axis Justify, direction reverse, wrap toggle."
            Variant="SgCardVariant.Outlined" Status="SgCardStatus.Info">
        <ChildContent>
            <SgRow Columns="2" Gap="12px">
                <SgCol>
                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Style="display:block;margin-bottom:4px;">Align=Center</SgTypography>
                    <SgRow Gap="8px" Align="@SgAlignItems.Center" Style="height:80px;background:var(--sg-bg-subtle);border-radius:6px;padding:6px;">
                        <SgCol Span="2"><div class="rd-cell" style="height:30px;">A</div></SgCol>
                        <SgCol Span="2"><div class="rd-cell" style="height:50px;">B</div></SgCol>
                        <SgCol Span="2"><div class="rd-cell" style="height:24px;">C</div></SgCol>
                        <SgCol Span="2"><div class="rd-cell" style="height:60px;">D</div></SgCol>
                    </SgRow>
                </SgCol>
                <SgCol>
                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Style="display:block;margin-bottom:4px;">Justify=SpaceBetween</SgTypography>
                    <SgRow Gap="8px" Justify="@SgJustifyContent.SpaceBetween" Style="height:80px;background:var(--sg-bg-subtle);border-radius:6px;padding:6px;">
                        <SgCol Span="2"><div class="rd-cell" style="height:30px;">A</div></SgCol>
                        <SgCol Span="2"><div class="rd-cell" style="height:50px;">B</div></SgCol>
                        <SgCol Span="2"><div class="rd-cell" style="height:24px;">C</div></SgCol>
                        <SgCol Span="2"><div class="rd-cell" style="height:60px;">D</div></SgCol>
                    </SgRow>
                </SgCol>
                <SgCol>
                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Style="display:block;margin-bottom:4px;">Reverse</SgTypography>
                    <SgRow Gap="8px" Reverse="true" Style="background:var(--sg-bg-subtle);border-radius:6px;padding:6px;">
                        <SgCol Span="3"><div class="rd-cell">1</div></SgCol>
                        <SgCol Span="3"><div class="rd-cell">2</div></SgCol>
                        <SgCol Span="3"><div class="rd-cell">3</div></SgCol>
                        <SgCol Span="3"><div class="rd-cell">4</div></SgCol>
                    </SgRow>
                </SgCol>
                <SgCol>
                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Style="display:block;margin-bottom:4px;">Wrap (in 320px box)</SgTypography>
                    <div style="max-width:320px;padding:6px;background:var(--sg-bg-subtle);border-radius:6px;">
                        <SgRow Gap="6px" Wrap="@SgFlexWrap.Wrap">
                            <SgCol Span="4"><div class="rd-cell">A</div></SgCol>
                            <SgCol Span="4"><div class="rd-cell">B</div></SgCol>
                            <SgCol Span="4"><div class="rd-cell">C</div></SgCol>
                            <SgCol Span="4"><div class="rd-cell">D</div></SgCol>
                            <SgCol Span="4"><div class="rd-cell">E</div></SgCol>
                            <SgCol Span="4"><div class="rd-cell">F</div></SgCol>
                        </SgRow>
                    </div>
                </SgCol>
            </SgRow>
        </ChildContent>
    </SgCard>

    @* ── 7. Semantic HTML ──────────────────────────────────────────────── *@
    <SgCard Title="Semantic HTML" Subtitle="SgRow Tag parameter maps to a meaningful HTML element."
            Variant="SgCardVariant.Outlined" Status="SgCardStatus.Success">
        <ChildContent>
            <SgStack Gap="6px">
                <SgRow Tag="@SgRowTag.Nav" Gap="8px" Style="background:var(--sg-bg-subtle);padding:8px;border-radius:6px;">
                    <SgTag>Brand</SgTag>
                    <SgTag>Home</SgTag>
                    <SgTag>Docs</SgTag>
                    <SgTag>Blog</SgTag>
                    <SgTag>GitHub</SgTag>
                </SgRow>
                <SgRow Tag="@SgRowTag.Header" Gap="8px" Style="background:var(--sg-color-info-subtle);padding:8px;border-radius:6px;">
                    <SgTypography Weight="SgTypographyWeight.Bold">&lt;header&gt; — page top</SgTypography>
                </SgRow>
                <SgRow Tag="@SgRowTag.Main" Gap="12px" Style="background:var(--sg-color-success-subtle);padding:12px;border-radius:6px;min-height:60px;">
                    <SgCol Span="8"><div class="rd-cell">&lt;main&gt; primary content</div></SgCol>
                    <SgCol Span="4"><div class="rd-cell">&lt;aside&gt;</div></SgCol>
                </SgRow>
                <SgRow Tag="@SgRowTag.Section" Gap="6px" Style="background:var(--sg-color-warning-subtle);padding:8px;border-radius:6px;">
                    <SgTypography Size="SgTypographySize.Sm">&lt;section&gt; — distinct region</SgTypography>
                </SgRow>
                <SgRow Tag="@SgRowTag.Footer" Gap="6px" Style="background:var(--sg-color-danger-subtle);padding:8px;border-radius:6px;">
                    <SgTypography Size="SgTypographySize.Sm">&lt;footer&gt; — page bottom</SgTypography>
                </SgRow>
            </SgStack>
        </ChildContent>
    </SgCard>

    @* ── 8. SgStack ────────────────────────────────────────────────────── *@
    <SgCard Title="SgStack" Subtitle="Linear flex container: orientation, density, stretch, item-basis, dividers, clickable."
            Variant="SgCardVariant.Outlined" Status="SgCardStatus.Info">
        <ChildContent>
            <SgStack Gap="10px">
                <SgStack Horizontal="true" Gap="6px" Wrap="true" Stretch="true" Style="background:var(--sg-bg-subtle);padding:8px;border-radius:6px;">
                    <SgButton Variant="SgButtonVariant.Primary">Save</SgButton>
                    <SgButton Variant="SgButtonVariant.Outlined">Cancel</SgButton>
                    <SgTag>Stretched</SgTag>
                </SgStack>

                <SgStack Orientation="@SgOrientation.Vertical" Gap="6px" ItemBasis="100px" Style="background:var(--sg-color-info-subtle);padding:8px;border-radius:6px;">
                    <SgTag>Item 1 · basis 100</SgTag>
                    <SgTag>Item 2 · basis 100</SgTag>
                    <SgTag>Item 3 · basis 100</SgTag>
                </SgStack>

                <SgStack Horizontal="true" Gap="4px" ShowDividers="true" Justify="@SgJustifyContent.SpaceBetween" Style="background:var(--sg-color-success-subtle);padding:8px;border-radius:6px;">
                    <SgTag>Inbox</SgTag>
                    <SgTag>Archive</SgTag>
                    <SgTag>Trash</SgTag>
                    <SgTag>Spam</SgTag>
                </SgStack>

                <SgStack Horizontal="true" Gap="6px" Clickable="true" @onclick="OnStackClick"
                         Style="background:var(--sg-bg-subtle);padding:8px;border-radius:6px;cursor:pointer;">
                    <SgHeroicon Icon="@SgHeroicons.Outline.CursorArrowRipple" Size="20" />
                    <SgTypography>Clickable stack · clicks: @_clicks</SgTypography>
                </SgStack>
            </SgStack>
        </ChildContent>
    </SgCard>

    @* ── 9. SgSpace ────────────────────────────────────────────────────── *@
    <SgCard Title="SgSpace" Subtitle="Compact spacing primitive: gap, separator, density, orientation, wrap."
            Variant="SgCardVariant.Outlined" Status="SgCardStatus.Warning">
        <ChildContent>
            <SgStack Gap="10px">
                <SgStack Gap="4px">
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Density + Gap</SgTypography>
                    <SgSpace Space="@SgSize.Sm" Density="@SgDensity.Compact">
                        <SgTag>Compact</SgTag><SgTag>8px</SgTag><SgTag>space</SgTag>
                    </SgSpace>
                </SgStack>
                <SgStack Gap="4px">
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Separator (CSS ::after)</SgTypography>
                    <SgSpace Separator=" / ">
                        <span>Home</span><span>Components</span><span>SgSpace</span>
                    </SgSpace>
                </SgStack>
                <SgStack Gap="4px">
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Separator dot</SgTypography>
                    <SgSpace Separator=" • " Space="@SgSize.Sm">
                        <SgTag>Blazor</SgTag><SgTag>Razor</SgTag><SgTag>CSS</SgTag><SgTag>Flexbox</SgTag>
                    </SgSpace>
                </SgStack>
                <SgStack Gap="4px">
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Vertical orientation</SgTypography>
                    <SgSpace Orientation="@SgOrientation.Vertical" Space="@SgSize.Sm" Align="@SgAlignItems.Start">
                        <SgTag>Line 1</SgTag><SgTag>Line 2</SgTag><SgTag>Line 3</SgTag>
                    </SgSpace>
                </SgStack>
                <SgStack Gap="4px">
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Wrap (320px box)</SgTypography>
                    <div style="max-width:320px;">
                        <SgSpace Wrap="true" Space="@SgSize.Sm">
                            @for (int i = 1; i <= 8; i++)
                            {
                                <SgButton Variant="SgButtonVariant.Outlined" Size="SgSize.Sm">Btn @i</SgButton>
                            }
                        </SgSpace>
                    </div>
                </SgStack>
            </SgStack>
        </ChildContent>
    </SgCard>

    @* ── 10. Live constructor ──────────────────────────────────────────── *@
    <SgCard Title="Live constructor" Subtitle="Tweak the controls — the SgRow above reflects the change."
            Variant="SgCardVariant.Filled" Status="SgCardStatus.Muted" Shadow="SgShadow.Lg">
        <ChildContent>
            <SgStack Gap="12px">
                <SgRow Gap="12px" Wrap="@SgFlexWrap.Wrap">
                    <SgCol>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Style="display:block;margin-bottom:4px;">Columns</SgTypography>
                        <SgSegmented TValue="int" Options="@_colOptions" @bind-Value="_colCount" Block="false" />
                    </SgCol>
                    <SgCol>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Style="display:block;margin-bottom:4px;">Space (SgSize)</SgTypography>
                        <SgSegmented TValue="SgSize?" Options="@_spaceSegOptions" @bind-Value="_space" Block="false" />
                    </SgCol>
                    <SgCol>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Style="display:block;margin-bottom:4px;">Direction</SgTypography>
                        <SgSegmented TValue="SgFlexDirection" Options="@_dirSegOptions" @bind-Value="_direction" Block="false" />
                    </SgCol>
                    <SgCol>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Style="display:block;margin-bottom:4px;">Wrap</SgTypography>
                        <SgSegmented TValue="SgFlexWrap?" Options="@_wrapSegOptions" @bind-Value="_wrap" Block="false" />
                    </SgCol>
                    <SgCol>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Style="display:block;margin-bottom:4px;">Density</SgTypography>
                        <SgSegmented TValue="SgDensity" Options="@_densitySegOptions" @bind-Value="_density" Block="false" />
                    </SgCol>
                </SgRow>
                <SgRow Gap="12px" Wrap="@SgFlexWrap.Wrap">
                    <SgCol>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Style="display:block;margin-bottom:4px;">Justify</SgTypography>
                        <SgSegmented TValue="SgJustifyContent" Options="@_justifySegOptions" @bind-Value="_justify" Block="false" />
                    </SgCol>
                    <SgCol>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Style="display:block;margin-bottom:4px;">Align</SgTypography>
                        <SgSegmented TValue="SgAlignItems" Options="@_alignSegOptions" @bind-Value="_align" Block="false" />
                    </SgCol>
                    <SgCol>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Style="display:block;margin-bottom:4px;">ItemWidth</SgTypography>
                        <SgSegmented TValue="int" Options="@_itemWidthOptions" @bind-Value="_itemWidth" Block="false" />
                    </SgCol>
                    <SgCol>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Style="display:block;margin-bottom:4px;">FullWidth</SgTypography>
                        <SgSegmented TValue="bool" Options="@_boolSegOptions" @bind-Value="_fullWidth" Block="false" />
                    </SgCol>
                </SgRow>

                <SgCard Variant="SgCardVariant.Outlined" Status="SgCardStatus.Info" Shadow="SgShadow.None">
                    <ChildContent>
                        <SgRow Space="@_space" Justify="@_justify" Align="@_align"
                               Wrap="@_wrap"
                               Direction="@_direction" Density="@_density"
                               AutoFit="@(_itemWidth > 0)" ItemWidth="@(_itemWidth > 0 ? _itemWidth + "px" : null)"
                               FullWidth="@_fullWidth"
                               MinHeight="80" Gap="0" Style="background:var(--sg-bg-subtle);border-radius:6px;padding:8px;">
                            @for (int i = 0; i < _colCount; i++)
                            {
                                <SgCol Span="@(12 / _colCount)">
                                    <div class="rd-cell rd-cell-@(i + 1)">Col @(i + 1)</div>
                                </SgCol>
                            }
                        </SgRow>
                    </ChildContent>
                </SgCard>
            </SgStack>
        </ChildContent>
    </SgCard>

    @* ── Properties ───────────────────────────────────────────────────── *@
    <SgCard Title="API quick-ref" Subtitle="Most-used parameters at a glance.">
        <ChildContent>
            <SgRow Gap="12px" Wrap="@SgFlexWrap.Wrap">
                <SgCol Span="12" Md="4">
                    <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm" Style="display:block;margin-bottom:6px;">SgRow</SgTypography>
                    <PropertyPanel Items="@_rowProperties" />
                </SgCol>
                <SgCol Span="12" Md="4">
                    <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm" Style="display:block;margin-bottom:6px;">SgCol</SgTypography>
                    <PropertyPanel Items="@_colProperties" />
                </SgCol>
                <SgCol Span="12" Md="4">
                    <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm" Style="display:block;margin-bottom:6px;">SgStack · SgSpace</SgTypography>
                    <PropertyPanel Items="@_stackSpaceProperties" />
                </SgCol>
            </SgRow>
        </ChildContent>
    </SgCard>
</SgStack>

<style>
    .rd-cell {
        background: var(--sg-color-primary-subtle);
        color: var(--sg-fg);
        padding: 8px 6px;
        border-radius: 4px;
        text-align: center;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.2;
        min-height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .rd-cell-h { min-height: 44px; }
    .rd-cell-xs { padding: 4px 2px; font-size: 10px; min-height: 24px; }
    .rd-cell-sm { padding: 4px; min-height: 24px; font-size: 11px; }
    .rd-cell-accent { background: var(--sg-color-warning-subtle); }
    .rd-cell-1 { background: var(--sg-color-primary-subtle); }
    .rd-cell-2 { background: var(--sg-color-info-subtle); }
    .rd-cell-3 { background: var(--sg-color-success-subtle); }
    .rd-cell-4 { background: var(--sg-color-warning-subtle); }
    .rd-cell-5 { background: var(--sg-color-danger-subtle); }
    .rd-cell-6 { background: var(--sg-bg-emphasized); color: var(--sg-fg-inverse); }
</style>

