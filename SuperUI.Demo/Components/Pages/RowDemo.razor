@code {
    // ── Palette ──────────────────────────────────────────────────────────
    private static readonly string[] _palette =
    {
        "#2563eb", "#6366f1", "#8b5cf6", "#a855f7",
        "#059669", "#0891b2", "#d97706", "#dc2626"
    };

    // ── Tags / nav data ───────────────────────────────────────────────────
    private readonly string[] _tags =
    {
        "Blazor", "Components", "Grid", "Flexbox", "Responsive",
        "Layout", "Adaptive", "12-column", "Breakpoints", "Gutter"
    };
    private readonly string[] _navItems = { "Главная", "Компоненты", "Документация", "GitHub" };

    // ── Constructor state ─────────────────────────────────────────────────
    private int _colCount = 3;
    private SgJustifyContent _justify = SgJustifyContent.Start;
    private SgAlignItems _align = SgAlignItems.Stretch;
    private SgSize? _space = SgSize.Md;
    private SgFlexWrap? _wrap = SgFlexWrap.Wrap;

    // SgSegmented options
    private readonly List<SgSegmentedOption<int>> _colOptions = new()
    {
        new() { Value = 1, Label = "1" },
        new() { Value = 2, Label = "2" },
        new() { Value = 3, Label = "3" },
        new() { Value = 4, Label = "4" },
        new() { Value = 6, Label = "6" },
    };

    private readonly List<SgSegmentedOption<SgSize>> _spaceSegOptions = new()
    {
        new() { Value = SgSize.Sm, Label = "Sm" },
        new() { Value = SgSize.Md, Label = "Md" },
        new() { Value = SgSize.Lg, Label = "Lg" },
        new() { Value = SgSize.Xl, Label = "Xl" },
    };

    private readonly List<SgSegmentedOption<SgFlexWrap>> _wrapSegOptions = new()
    {
        new() { Value = SgFlexWrap.Wrap,   Label = "Wrap" },
        new() { Value = SgFlexWrap.NoWrap, Label = "NoWrap" },
    };

    // SgSelect items
    private readonly List<SgJustifyContent> _justifyItems = Enum.GetValues<SgJustifyContent>().ToList();
    private readonly List<SgAlignItems>     _alignItems   = Enum.GetValues<SgAlignItems>().ToList();

    private record LabeledValue<T>(string Label, T Value);

    // ── RenderFragment helpers ────────────────────────────────────────────
    private RenderFragment Col(string text, string color) => __builder =>
    {
        <div class="demo-col-box" style="background:@color;">@text</div>
    };

    private RenderFragment ColLabeled(string text, string sub, string color) => __builder =>
    {
        <div class="demo-col-box" style="background:@color;">
            <span>@text</span>
            <span class="col-sub">@sub</span>
        </div>
    };

    private RenderFragment ColAuto(string text) => __builder =>
    {
        <div class="demo-col-box-auto">@text</div>
    };

    private RenderFragment ColThin(string text, string color) => __builder =>
    {
        <div class="demo-col-thin" style="background:@color;">@text</div>
    };

    private RenderFragment ColFixed(string text, string color) => __builder =>
    {
        <div class="demo-col-fixed" style="background:@color;">@text</div>
    };

    private RenderFragment ColH(string text, string height, string color) => __builder =>
    {
        <div class="demo-col-box" style="background:@color;height:@height;">@text</div>
    };

    // ── Property tables ───────────────────────────────────────────────────
    private List<PropertyPanelItem> _rowProperties = new()
    {
        new() { Label = "Space",      Value = "SgSize",              BadgeText = "Отступы",     BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Gutter",     Value = "string? (CSS)",       BadgeText = "Custom Gap",  BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Columns",    Value = "int (12 / 24)",       BadgeText = "Колонок",     BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Align",      Value = "SgAlignItems",        BadgeText = "Cross-axis",  BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Justify",    Value = "SgJustifyContent",    BadgeText = "Main-axis",   BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Wrap",       Value = "SgFlexWrap",          BadgeText = "Перенос",     BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Direction",  Value = "SgFlexDirection",     BadgeText = "Направление", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "MinHeight",  Value = "string? (CSS)",       BadgeText = "Высота",      BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Background", Value = "string? (CSS)",       BadgeText = "Фон",         BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Tag",        Value = "string (div|ul|...)", BadgeText = "HTML-тег",    BadgeVariant = SgBadgeVariant.Default },
    };

    private List<PropertyPanelItem> _colProperties = new()
    {
        new() { Label = "Span",            Value = "int? (1..Columns)",  BadgeText = "Ширина",      BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Offset",          Value = "int",                BadgeText = "Сдвиг",       BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Order",           Value = "int?",               BadgeText = "Порядок",     BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Auto",            Value = "bool",               BadgeText = "По контенту", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Fill",            Value = "bool",               BadgeText = "Остаток",     BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "AlignSelf",       Value = "SgAlignItems?",      BadgeText = "Self-align",  BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Xs/Sm/Md/Lg/Xl", Value = "int (1..12)",        BadgeText = "Адаптив",     BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "HideXs..HideXl", Value = "bool",               BadgeText = "Скрытие",     BadgeVariant = SgBadgeVariant.Warn    },
    };

    private List<PropertyPanelItem> _spaceProperties = new()
    {
        new() { Label = "Size",        Value = "string (sm|md|lg|px)",  BadgeText = "Отступ",      BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Space",       Value = "SgSize?",               BadgeText = "SgSize enum", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Orientation", Value = "SgOrientation",         BadgeText = "Направление", BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Align",       Value = "SgAlignItems",          BadgeText = "Выравнивание",BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Wrap",        Value = "bool",                  BadgeText = "Перенос",     BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Split",       Value = "RenderFragment?",       BadgeText = "Разделитель", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Inline",      Value = "bool",                  BadgeText = "inline-flex", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "FullWidth",   Value = "bool",                  BadgeText = "100% ширина", BadgeVariant = SgBadgeVariant.Default },
    };
}
