@page "/row-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgRow / SgCol / SgStack / SgSpace — SuperUI</PageTitle>

<div class="rd-shell">
<SgStack Gap="12px" Density="@SgDensity.Compact" Stretch="false" Style="max-width:1600px;margin:0 auto;">

    @* ── Hero ─────────────────────────────────────────────────────────── *@
    <SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Sm" Radius="SgSize.Md" Status="SgCardStatus.Info" Size="SgSize.Sm">
        <ChildContent>
            <SgStack Orientation="SgOrientation.Horizontal" Gap="12px" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween" Wrap="true">
                <SgStack Orientation="SgOrientation.Horizontal" Gap="10px" Align="SgAlignItems.Center">
                    <SgHeroicon Icon="@SgHeroicons.Outline.ViewColumns" Size="32" />
                    <SgStack Gap="2px">
                        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">Adaptive Grid & Flex</SgTypography>
                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">SgRow / SgCol — 12/24-col Flexbox grid · SgStack — flex container · SgSpace — gap + separator</SgTypography>
                    </SgStack>
                </SgStack>
                <SgStack Orientation="SgOrientation.Horizontal" Gap="4px">
                    <SgBadge Variant="SgBadgeVariant.Info" Text="12 cols" Standalone="true" />
                    <SgBadge Variant="SgBadgeVariant.Success" Text="Responsive" Standalone="true" />
                    <SgBadge Variant="SgBadgeVariant.Warn" Text="Density" Standalone="true" />
                    <SgBadge Variant="SgBadgeVariant.Default" Text="Semantic" Standalone="true" />
                </SgStack>
            </SgStack>
        </ChildContent>
    </SgCard>

    @* ── Live constructor (3-col) ─────────────────────────────────────── *@
    <SgCard Title="Constructor" Subtitle="Pick properties on the left — see the result and grab the code."
            Variant="SgCardVariant.Filled" Status="SgCardStatus.Info" Shadow="SgShadow.Md" Size="SgSize.Sm" NoPadding="true">
        <ChildContent>
            <SgRow Gap="0" Wrap="@SgFlexWrap.Wrap">

                @* ── Left: Controls ── *@
                <SgCol Xs="12" Md="4" Lg="3" Style="padding:14px;border-right:1px solid var(--sg-border);">
                    <SgStack Gap="8px">
                        <SgRow Gap="8px">
                            <SgCol Span="6">
                                <SgSelect TValue="int" @bind-Value="_ctColCount" Items="@_colCountItems"
                                          LabelSelector="x => x.ToString()"
                                          Label="Columns" Size="SgSize.Sm" Block="true" />
                            </SgCol>
                            <SgCol Span="6">
                                <SgSelect TValue="SgSize?" @bind-Value="_ctSpace" Items="@_spaceItems"
                                          LabelSelector="@(x => x == null ? "Default" : x.ToString())"
                                          Label="Gap" Size="SgSize.Sm" Block="true" />
                            </SgCol>
                        </SgRow>

                        <SgRow Gap="8px">
                            <SgCol Span="6">
                                <SgSelect TValue="SgFlexDirection" @bind-Value="_ctDir" Items="@_dirItems"
                                          LabelSelector="x => x.ToString()"
                                          Label="Direction" Size="SgSize.Sm" Block="true" />
                            </SgCol>
                            <SgCol Span="6">
                                <SgSelect TValue="SgFlexWrap" @bind-Value="_ctWrap" Items="@_wrapItems"
                                          LabelSelector="x => x.ToString()"
                                          Label="Wrap" Size="SgSize.Sm" Block="true" />
                            </SgCol>
                        </SgRow>

                        <SgRow Gap="8px">
                            <SgCol Span="6">
                                <SgSelect TValue="SgAlignItems" @bind-Value="_ctAlign" Items="@_alignItems"
                                          LabelSelector="x => x.ToString()"
                                          Label="Align" Size="SgSize.Sm" Block="true" />
                            </SgCol>
                            <SgCol Span="6">
                                <SgSelect TValue="SgJustifyContent" @bind-Value="_ctJustify" Items="@_justifyItems"
                                          LabelSelector="x => x.ToString()"
                                          Label="Justify" Size="SgSize.Sm" Block="true" />
                            </SgCol>
                        </SgRow>

                        <SgRow Gap="8px">
                            <SgCol Span="6">
                                <SgSelect TValue="SgRowTag" @bind-Value="_ctTag" Items="@_tagItems"
                                          LabelSelector="x => x.ToString()"
                                          Label="Tag" Size="SgSize.Sm" Block="true" />
                            </SgCol>
                            <SgCol Span="6">
                                <SgSelect TValue="SgDensity" @bind-Value="_ctDensity" Items="@_densityItems"
                                          LabelSelector="x => x.ToString()"
                                          Label="Density" Size="SgSize.Sm" Block="true" />
                            </SgCol>
                        </SgRow>

                        <SgRow Gap="8px">
                            <SgCol Span="6">
                                <SgNumberInput TValue="int" @bind-Value="_ctItemWidth" Label="ItemWidth (px)"
                                               Min="0" Max="500" Step="20" Size="SgSize.Sm" ShowButtons="true" />
                            </SgCol>
                            <SgCol Span="6">
                                <SgNumberInput TValue="int" @bind-Value="_ctGutter" Label="Gutter (px)"
                                               Min="0" Max="64" Step="2" Size="SgSize.Sm" ShowButtons="true" />
                            </SgCol>
                        </SgRow>

                        <SgStack Gap="2px">
                            <SgStack Orientation="SgOrientation.Horizontal" Gap="6px" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                <SgTypography Size="SgTypographySize.Sm">Hoverable</SgTypography>
                                <SgSwitch @bind-Value="_ctHoverable" />
                            </SgStack>
                            <SgStack Orientation="SgOrientation.Horizontal" Gap="6px" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                <SgTypography Size="SgTypographySize.Sm">Reverse</SgTypography>
                                <SgSwitch @bind-Value="_ctReverse" />
                            </SgStack>
                            <SgStack Orientation="SgOrientation.Horizontal" Gap="6px" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                <SgTypography Size="SgTypographySize.Sm">FullWidth</SgTypography>
                                <SgSwitch @bind-Value="_ctFullWidth" />
                            </SgStack>
                            <SgStack Orientation="SgOrientation.Horizontal" Gap="6px" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                <SgTypography Size="SgTypographySize.Sm">AutoFit</SgTypography>
                                <SgSwitch @bind-Value="_ctAutoFit" />
                            </SgStack>
                        </SgStack>
                    </SgStack>
                </SgCol>

                @* ── Center: Live preview ── *@
                <SgCol Xs="12" Md="5" Lg="6" Style="padding:14px;background:var(--sg-bg-subtle);">
                    <SgStack Gap="6px">
                        <SgStack Orientation="SgOrientation.Horizontal" Gap="6px" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Preview</SgTypography>
                            <SgStack Orientation="SgOrientation.Horizontal" Gap="3px">
                                <SgBadge Variant="SgBadgeVariant.Info" Text="@($"Cols={_ctColCount}")" Standalone="true" />
                                <SgBadge Variant="SgBadgeVariant.Success" Text="@($"Gap={_ctSpace?.ToString() ?? "—"}")" Standalone="true" />
                                <SgBadge Variant="SgBadgeVariant.Warn" Text="@_ctDensity.ToString()" Standalone="true" />
                            </SgStack>
                        </SgStack>
                        <div class="rd-preview">
                            <SgRow Space="@_ctSpace" Justify="@_ctJustify" Align="@_ctAlign"
                                   Wrap="@_ctWrap" Direction="@_ctDirection" Density="@_ctDensity"
                                   AutoFit="@(_ctAutoFit && _ctItemWidth > 0)"
                                   ItemWidth="@(_ctAutoFit && _ctItemWidth > 0 ? _ctItemWidth + "px" : null)"
                                   Gutter="@(_ctGutter + "px")"
                                   Reverse="@_ctReverse" Hoverable="@_ctHoverable" FullWidth="@_ctFullWidth"
                                   Tag="@_ctTag"
                                   MinHeight="120">
                                @for (int i = 0; i < _ctColCount; i++)
                                {
                                    var idx = i;
                                    <SgCol Span="@(12 / _ctColCount)">
                                        <div class="rd-cell rd-cell-@((idx % 6) + 1)">
                                            <SgStack Orientation="SgOrientation.Horizontal" Gap="4px" Align="SgAlignItems.Center" Justify="SgJustifyContent.Center">
                                                <SgTag Size="SgSize.Sm">@((char)('A' + idx))</SgTag>
                                                <span style="font-size:11px;">Col @(idx + 1)</span>
                                            </SgStack>
                                        </div>
                                    </SgCol>
                                }
                            </SgRow>
                        </div>
                    </SgStack>
                </SgCol>

                @* ── Right: Code ── *@
                <SgCol Xs="12" Md="3" Lg="3" Style="padding:0;position:relative;">
                    <SgStack Gap="0" Style="height:100%;">
                        <SgStack Orientation="SgOrientation.Horizontal" Gap="6px" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween" Style="padding:8px 12px;border-bottom:1px solid var(--sg-border);background:var(--sg-bg-emphasized);">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Code</SgTypography>
                            <button type="button" class="demo-copy-btn @(_copied ? "copied" : "")" @onclick="CopyCodeToClipboard">
                                <span>@(_copied ? "✓" : "📋")</span><span>@(_copied ? "Copied" : "Copy")</span>
                            </button>
                        </SgStack>
                        <div class="code-block" style="border-radius:0;margin:0;flex:1;min-height:240px;max-height:340px;">
                            @foreach (var line in _generatedCodeLines)
                            {
                                <code>@line</code>
                            }
                        </div>
                    </SgStack>
                </SgCol>

            </SgRow>
        </ChildContent>
    </SgCard>

    @* ── Quick features (3 columns) ───────────────────────────────────── *@
    <SgRow Gap="10px" Wrap="@SgFlexWrap.Wrap">
        <SgCol Xs="12" Md="4">
            <SgCard Title="Density" Subtitle="Compact · Default · Comfortable"
                    Variant="SgCardVariant.Outlined" Status="SgCardStatus.Info" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <ChildContent>
                    <SgRow Gap="6px" Wrap="@SgFlexWrap.Wrap">
                        <SgCol Span="4"><div class="rd-cell rd-cell-sm" style="background:var(--sg-color-info-subtle);">C</div></SgCol>
                        <SgCol Span="4"><div class="rd-cell rd-cell-sm" style="background:var(--sg-color-success-subtle);">D</div></SgCol>
                        <SgCol Span="4"><div class="rd-cell rd-cell-sm" style="background:var(--sg-color-warning-subtle);">+</div></SgCol>
                    </SgRow>
                </ChildContent>
            </SgCard>
        </SgCol>
        <SgCol Xs="12" Md="4">
            <SgCard Title="Responsive" Subtitle="XS · SM · MD · LG · XL"
                    Variant="SgCardVariant.Outlined" Status="SgCardStatus.Success" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <ChildContent>
                    <SgRow Gap="4px" Wrap="@SgFlexWrap.Wrap">
                        <SgCol Span="12" Sm="6" Md="4"><div class="rd-cell rd-cell-sm">12→6→4</div></SgCol>
                        <SgCol Span="12" Sm="6" Md="4"><div class="rd-cell rd-cell-sm">12→6→4</div></SgCol>
                        <SgCol Span="12" Sm="12" Md="4"><div class="rd-cell rd-cell-sm">12→12→4</div></SgCol>
                    </SgRow>
                </ChildContent>
            </SgCard>
        </SgCol>
        <SgCol Xs="12" Md="4">
            <SgCard Title="Semantic HTML" Subtitle="Tag parameter"
                    Variant="SgCardVariant.Outlined" Status="SgCardStatus.Warning" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <ChildContent>
                    <SgStack Gap="3px">
                        <SgRow Tag="SgRowTag.Nav" Gap="4px" Style="background:var(--sg-bg-subtle);padding:4px;border-radius:4px;">
                            <SgTag Size="SgSize.Sm">Home</SgTag>
                            <SgTag Size="SgSize.Sm">Docs</SgTag>
                            <SgTag Size="SgSize.Sm">Blog</SgTag>
                        </SgRow>
                        <SgRow Tag="SgRowTag.Footer" Gap="4px" Style="background:var(--sg-color-danger-subtle);padding:4px;border-radius:4px;">
                            <SgTypography Size="SgTypographySize.Xs">© SuperUI</SgTypography>
                        </SgRow>
                    </SgStack>
                </ChildContent>
            </SgCard>
        </SgCol>
    </SgRow>

    @* ── SgStack + SgSpace (2 cols) ────────────────────────────────────── *@
    <SgRow Gap="10px" Wrap="@SgFlexWrap.Wrap">
        <SgCol Xs="12" Lg="6">
            <SgCard Title="SgStack" Subtitle="Flex container · orientation · density · stretch · item-basis"
                    Variant="SgCardVariant.Outlined" Status="SgCardStatus.Info" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <ChildContent>
                    <SgStack Gap="6px">
                        <SgStack Orientation="SgOrientation.Horizontal" Gap="4px" Wrap="true" Stretch="true" Style="background:var(--sg-bg-subtle);padding:6px;border-radius:4px;">
                            <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Primary">Save</SgButton>
                            <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined">Cancel</SgButton>
                            <SgTag Size="SgSize.Sm">Stretched</SgTag>
                        </SgStack>
                        <SgStack Orientation="SgOrientation.Vertical" Gap="3px" ItemBasis="60px" Style="background:var(--sg-color-info-subtle);padding:6px;border-radius:4px;">
                            <SgTag Size="SgSize.Sm">1</SgTag>
                            <SgTag Size="SgSize.Sm">2</SgTag>
                            <SgTag Size="SgSize.Sm">3</SgTag>
                        </SgStack>
                    </SgStack>
                </ChildContent>
            </SgCard>
        </SgCol>
        <SgCol Xs="12" Lg="6">
            <SgCard Title="SgSpace" Subtitle="Gap · separator · density · orientation"
                    Variant="SgCardVariant.Outlined" Status="SgCardStatus.Warning" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <ChildContent>
                    <SgStack Gap="6px">
                        <SgStack Gap="2px">
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Separator (CSS)</SgTypography>
                            <SgSpace Separator=" / " Space="SgSize.Sm">
                                <SgTag Size="SgSize.Sm">Home</SgTag>
                                <SgTag Size="SgSize.Sm">Components</SgTag>
                                <SgTag Size="SgSize.Sm">SgSpace</SgTag>
                            </SgSpace>
                        </SgStack>
                        <SgStack Gap="2px">
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Separator dot</SgTypography>
                            <SgSpace Separator=" • " Space="SgSize.Sm">
                                <SgTag Size="SgSize.Sm">Blazor</SgTag>
                                <SgTag Size="SgSize.Sm">Razor</SgTag>
                                <SgTag Size="SgSize.Sm">Flex</SgTag>
                            </SgSpace>
                        </SgStack>
                        <SgStack Gap="2px">
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Vertical</SgTypography>
                            <SgSpace Orientation="SgOrientation.Vertical" Space="SgSize.Sm" Align="SgAlignItems.Start">
                                <SgTag Size="SgSize.Sm">Line 1</SgTag>
                                <SgTag Size="SgSize.Sm">Line 2</SgTag>
                                <SgTag Size="SgSize.Sm">Line 3</SgTag>
                            </SgSpace>
                        </SgStack>
                    </SgStack>
                </ChildContent>
            </SgCard>
        </SgCol>
    </SgRow>

</SgStack>
</div>

<style>
    .rd-shell { padding: 0; }
    .rd-preview {
        background: var(--sg-surface);
        border: 1px solid var(--sg-border);
        border-radius: 6px;
        padding: 10px;
        min-height: 120px;
    }
    .rd-cell {
        background: var(--sg-color-primary-subtle);
        color: var(--sg-fg);
        padding: 6px 4px;
        border-radius: 4px;
        text-align: center;
        font-size: 11px;
        font-weight: 600;
        line-height: 1.2;
        min-height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .rd-cell-sm { padding: 4px 2px; font-size: 10px; min-height: 20px; }
    .rd-cell-1 { background: var(--sg-color-primary-subtle); }
    .rd-cell-2 { background: var(--sg-color-info-subtle); }
    .rd-cell-3 { background: var(--sg-color-success-subtle); }
    .rd-cell-4 { background: var(--sg-color-warning-subtle); }
    .rd-cell-5 { background: var(--sg-color-danger-subtle); }
    .rd-cell-6 { background: var(--sg-bg-emphasized); color: var(--sg-fg-inverse); }
</style>

@code {
    private bool _copied;

    // ── Constructor state ──
    private int _ctColCount = 3;
    private SgSize? _ctSpace = SgSize.Md;
    private SgFlexDirection _ctDir = SgFlexDirection.Row;
    private SgFlexWrap _ctWrap = SgFlexWrap.Wrap;
    private SgAlignItems _ctAlign = SgAlignItems.Stretch;
    private SgJustifyContent _ctJustify = SgJustifyContent.Start;
    private SgRowTag _ctTag = SgRowTag.Div;
    private SgDensity _ctDensity = SgDensity.Default;
    private int _ctItemWidth = 0;
    private int _ctGutter = 0;
    private bool _ctHoverable;
    private bool _ctReverse;
    private bool _ctFullWidth = true;
    private bool _ctAutoFit;

    private SgFlexDirection? _ctDirection => _ctReverse && _ctDir == SgFlexDirection.Row
        ? SgFlexDirection.RowReverse
        : _ctReverse && _ctDir == SgFlexDirection.Column
            ? SgFlexDirection.ColumnReverse
            : _ctDir;

    // ── Select option lists ──
    private readonly List<int> _colCountItems = new() { 1, 2, 3, 4, 6 };
    private readonly List<SgSize?> _spaceItems = new() { null, SgSize.Sm, SgSize.Md, SgSize.Lg, SgSize.Xl };
    private readonly List<SgFlexDirection> _dirItems = Enum.GetValues<SgFlexDirection>().ToList();
    private readonly List<SgFlexWrap> _wrapItems = Enum.GetValues<SgFlexWrap>().ToList();
    private readonly List<SgAlignItems> _alignItems = Enum.GetValues<SgAlignItems>().ToList();
    private readonly List<SgJustifyContent> _justifyItems = Enum.GetValues<SgJustifyContent>().ToList();
    private readonly List<SgRowTag> _tagItems = Enum.GetValues<SgRowTag>().ToList();
    private readonly List<SgDensity> _densityItems = Enum.GetValues<SgDensity>().ToList();

    private string[] _generatedCodeLines = Array.Empty<string>();

    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        UpdateConstructorCode();
    }

    protected override void OnParametersSet()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add($"<SgRow");
        if (_ctTag != SgRowTag.Div) lines.Add($"      Tag=\"SgRowTag.{_ctTag}\"");
        if (_ctColCount != 12) lines.Add($"      Columns=\"{_ctColCount}\"");
        if (_ctSpace.HasValue) lines.Add($"      Space=\"SgSize.{_ctSpace}\"");
        if (_ctGutter > 0) lines.Add($"      Gutter=\"{_ctGutter}px\"");
        if (_ctDir != SgFlexDirection.Row) lines.Add($"      Direction=\"SgFlexDirection.{_ctDir}\"");
        if (_ctReverse) lines.Add($"      Reverse=\"true\"");
        if (_ctWrap != SgFlexWrap.Wrap) lines.Add($"      Wrap=\"SgFlexWrap.{_ctWrap}\"");
        if (_ctAlign != SgAlignItems.Stretch) lines.Add($"      Align=\"SgAlignItems.{_ctAlign}\"");
        if (_ctJustify != SgJustifyContent.Start) lines.Add($"      Justify=\"SgJustifyContent.{_ctJustify}\"");
        if (_ctDensity != SgDensity.Default) lines.Add($"      Density=\"SgDensity.{_ctDensity}\"");
        if (_ctAutoFit && _ctItemWidth > 0)
        {
            lines.Add($"      AutoFit=\"true\"");
            lines.Add($"      ItemWidth=\"{_ctItemWidth}px\"");
        }
        if (_ctHoverable) lines.Add($"      Hoverable=\"true\"");
        if (!_ctFullWidth) lines.Add($"      FullWidth=\"false\"");
        lines.Add($"      MinHeight=\"120\">");
        var span = 12 / _ctColCount;
        for (int i = 0; i < _ctColCount; i++)
        {
            lines.Add($"    <SgCol Span=\"{span}\">Col {i + 1}</SgCol>");
        }
        lines.Add($"</SgRow>");
        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copied = true;
            StateHasChanged();
            await Task.Delay(1500);
            _copied = false;
            StateHasChanged();
        }
        catch
        {
            _copied = false;
        }
    }
}
