@page "/row-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgRow & SgCol — Adaptive Grid — SuperUI</PageTitle>

<SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" Status="SgCardStatus.Info" Animated="true" CssClass="rd-demo-page">
    <HeaderContent>
        <DemoPageHeader Title="Adaptive Grid &amp; Flex"
                        Subtitle="SgRow / SgCol — 12 or 24-column Flexbox grid with full responsive control. SgStack — universal flex container with density. SgSpace — gap and separator primitive."
                        Icon="@SgHeroicons.Outline.ViewColumns" />
    </HeaderContent>
    <ChildContent>

        @* ═══════════════════════════════════════════════════════════════════
           1. Span & Columns
           ═══════════════════════════════════════════════════════════════════ *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Span &amp; Columns
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgCol.Span</SgTypography> auto-respects parent <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Columns</SgTypography>.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="4">
                    <SgCard Title="12-column (default)" Subtitle="Standard responsive grid" Shadow="SgShadow.Sm" Hoverable="true" Animated="true">
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgRow Gap="4px">
                                <SgCol Span="6"><div class="rd-cell">6</div></SgCol>
                                <SgCol Span="3"><div class="rd-cell">3</div></SgCol>
                                <SgCol Span="3"><div class="rd-cell">3</div></SgCol>
                            </SgRow>
                            <SgRow Gap="4px">
                                <SgCol Span="4"><div class="rd-cell">4</div></SgCol>
                                <SgCol Span="4"><div class="rd-cell">4</div></SgCol>
                                <SgCol Span="4"><div class="rd-cell">4</div></SgCol>
                            </SgRow>
                            <SgRow Gap="4px">
                                <SgCol Span="3"><div class="rd-cell">3</div></SgCol>
                                <SgCol Span="6"><div class="rd-cell">6</div></SgCol>
                                <SgCol Span="3"><div class="rd-cell">3</div></SgCol>
                            </SgRow>
                        </SgStack>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Md="4">
                    <SgCard Title="24-column" Subtitle="Fine-grained layout for dashboards" Shadow="SgShadow.Sm" Hoverable="true" Animated="true">
                        <SgRow Columns="24" Gap="2px">
                            @for (int i = 1; i <= 24; i++)
                            {
                                <SgCol Span="1"><div class="rd-cell rd-cell-xs">@i</div></SgCol>
                            }
                        </SgRow>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Md="4">
                    <SgCard Title="Custom spans" Subtitle="Mix 8 / 4 / 6 / 6 freely" Shadow="SgShadow.Sm" Hoverable="true" Animated="true">
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgRow Gap="4px">
                                <SgCol Span="8"><div class="rd-cell rd-cell-h">8 — main</div></SgCol>
                                <SgCol Span="4"><div class="rd-cell rd-cell-h">4 — side</div></SgCol>
                            </SgRow>
                            <SgRow Gap="4px">
                                <SgCol Span="6"><div class="rd-cell">6</div></SgCol>
                                <SgCol Span="3"><div class="rd-cell">3</div></SgCol>
                                <SgCol Span="3"><div class="rd-cell">3</div></SgCol>
                            </SgRow>
                            <SgRow Gap="4px">
                                <SgCol Span="12"><div class="rd-cell">12 — full</div></SgCol>
                            </SgRow>
                        </SgStack>
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

        @* ═══════════════════════════════════════════════════════════════════
           2. Responsive Breakpoints
           ═══════════════════════════════════════════════════════════════════ *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Responsive Breakpoints
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    XS &lt;576 · SM ≥576 · MD ≥768 · LG ≥992 · XL ≥1200 — resize the window.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="6">
                    <SgCard Title="Cascading span" Subtitle="12 → 6 → 4 → 3 → 2 across breakpoints" Shadow="SgShadow.Sm" Hoverable="true" Animated="true">
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgStack Horizontal Space="SgSize.Sm">
                                <SgBadge Variant="SgBadgeVariant.Info" Text="XS" Standalone="true" />
                                <SgBadge Variant="SgBadgeVariant.Success" Text="SM" Standalone="true" />
                                <SgBadge Variant="SgBadgeVariant.Warn" Text="MD" Standalone="true" />
                                <SgBadge Variant="SgBadgeVariant.Danger" Text="LG" Standalone="true" />
                                <SgBadge Variant="SgBadgeVariant.Default" Text="XL" Standalone="true" />
                            </SgStack>
                            <SgRow Gap="4px">
                                <SgCol Span="12" Sm="6" Md="4" Lg="3" Xl="2"><div class="rd-cell rd-cell-sm">A</div></SgCol>
                                <SgCol Span="12" Sm="6" Md="4" Lg="3" Xl="2"><div class="rd-cell rd-cell-sm">B</div></SgCol>
                                <SgCol Span="12" Sm="6" Md="4" Lg="3" Xl="2"><div class="rd-cell rd-cell-sm">C</div></SgCol>
                                <SgCol Span="12" Sm="6" Md="4" Lg="3" Xl="2"><div class="rd-cell rd-cell-sm">D</div></SgCol>
                            </SgRow>
                        </SgStack>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Md="6">
                    <SgCard Title="Offset &amp; Order" Subtitle="Shift and reorder columns at any breakpoint" Shadow="SgShadow.Sm" Hoverable="true" Animated="true">
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Weight="SgTypographyWeight.Semibold">OffsetMd="2" — shift right at MD+</SgTypography>
                            <SgRow Gap="4px">
                                <SgCol Span="2"><div class="rd-cell">2</div></SgCol>
                                <SgCol Span="4" OffsetMd="2"><div class="rd-cell rd-cell-accent">4 + offset 2</div></SgCol>
                                <SgCol Span="4"><div class="rd-cell">4</div></SgCol>
                            </SgRow>
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Weight="SgTypographyWeight.Semibold">Order — reorder via CSS</SgTypography>
                            <SgRow Gap="4px">
                                <SgCol Span="3" Order="3"><div class="rd-cell">A · last</div></SgCol>
                                <SgCol Span="3" Order="1"><div class="rd-cell rd-cell-accent">B · first</div></SgCol>
                                <SgCol Span="3" Order="2"><div class="rd-cell">C</div></SgCol>
                            </SgRow>
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Weight="SgTypographyWeight.Semibold">HideXs / HideMd / HideLg</SgTypography>
                            <SgRow Gap="4px">
                                <SgCol Span="3"><div class="rd-cell rd-cell-sm">Always</div></SgCol>
                                <SgCol Span="3" HideXs="true"><div class="rd-cell rd-cell-sm rd-cell-accent">Hidden XS</div></SgCol>
                                <SgCol Span="3" HideMd="true"><div class="rd-cell rd-cell-sm">Hidden MD+</div></SgCol>
                                <SgCol Span="3" HideLg="true"><div class="rd-cell rd-cell-sm">Hidden LG+</div></SgCol>
                            </SgRow>
                        </SgStack>
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

        @* ═══════════════════════════════════════════════════════════════════
           3. Layout Tricks (Alignment · Direction · Wrap · AutoFit · Semantic)
           ═══════════════════════════════════════════════════════════════════ *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Layout Tricks
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Align</SgTypography> · <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Justify</SgTypography> · <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Direction</SgTypography> · <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Wrap</SgTypography> · <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">AutoFit</SgTypography> · <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Tag</SgTypography>.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Lg="6">
                    <SgCard Title="Align &amp; Justify" Subtitle="Cross-axis + main-axis distribution" Shadow="SgShadow.Sm" Hoverable="true" Animated="true">
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgStack Vertical Space="@SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Weight="SgTypographyWeight.Semibold">Align = Center</SgTypography>
                                <SgRow Gap="6px" Align="SgAlignItems.Center" Style="height:60px;background:var(--sg-bg-subtle);border-radius:6px;padding:6px;">
                                    <SgCol Span="2"><div class="rd-cell" style="height:22px;">A</div></SgCol>
                                    <SgCol Span="2"><div class="rd-cell" style="height:42px;">B</div></SgCol>
                                    <SgCol Span="2"><div class="rd-cell" style="height:18px;">C</div></SgCol>
                                    <SgCol Span="2"><div class="rd-cell" style="height:48px;">D</div></SgCol>
                                </SgRow>
                            </SgStack>
                            <SgStack Vertical Space="@SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Weight="SgTypographyWeight.Semibold">Justify = SpaceBetween</SgTypography>
                                <SgRow Gap="6px" Justify="SgJustifyContent.SpaceBetween" Style="height:60px;background:var(--sg-bg-subtle);border-radius:6px;padding:6px;">
                                    <SgCol Span="2"><div class="rd-cell" style="height:22px;">A</div></SgCol>
                                    <SgCol Span="2"><div class="rd-cell" style="height:42px;">B</div></SgCol>
                                    <SgCol Span="2"><div class="rd-cell" style="height:18px;">C</div></SgCol>
                                    <SgCol Span="2"><div class="rd-cell" style="height:48px;">D</div></SgCol>
                                </SgRow>
                            </SgStack>
                        </SgStack>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Lg="6">
                    <SgCard Title="Direction &amp; Wrap" Subtitle="Reverse order · break to new line" Shadow="SgShadow.Sm" Hoverable="true" Animated="true">
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgStack Vertical Space="@SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Weight="SgTypographyWeight.Semibold">Reverse = true</SgTypography>
                                <SgRow Gap="4px" Reverse="true" Style="background:var(--sg-bg-subtle);border-radius:6px;padding:6px;">
                                    <SgCol Span="3"><div class="rd-cell rd-cell-sm">1 · last</div></SgCol>
                                    <SgCol Span="3"><div class="rd-cell rd-cell-sm">2</div></SgCol>
                                    <SgCol Span="3"><div class="rd-cell rd-cell-sm">3</div></SgCol>
                                    <SgCol Span="3"><div class="rd-cell rd-cell-sm">4 · first</div></SgCol>
                                </SgRow>
                            </SgStack>
                            <SgStack Vertical Space="@SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Weight="SgTypographyWeight.Semibold">Wrap in 320px box</SgTypography>
                                <div style="max-width:320px;background:var(--sg-bg-subtle);border-radius:6px;padding:6px;">
                                    <SgRow Gap="4px" Wrap="SgFlexWrap.Wrap">
                                        <SgCol Span="4"><div class="rd-cell rd-cell-sm">A</div></SgCol>
                                        <SgCol Span="4"><div class="rd-cell rd-cell-sm">B</div></SgCol>
                                        <SgCol Span="4"><div class="rd-cell rd-cell-sm">C</div></SgCol>
                                        <SgCol Span="4"><div class="rd-cell rd-cell-sm">D</div></SgCol>
                                        <SgCol Span="4"><div class="rd-cell rd-cell-sm">E</div></SgCol>
                                        <SgCol Span="4"><div class="rd-cell rd-cell-sm">F</div></SgCol>
                                    </SgRow>
                                </div>
                            </SgStack>
                        </SgStack>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Lg="6">
                    <SgCard Title="AutoFit, ItemWidth = 160" Subtitle="Items wrap when they exceed 160px" Shadow="SgShadow.Sm" Hoverable="true" Animated="true">
                        <SgRow AutoFit="true" ItemWidth="160" Gap="6px">
                            @for (int i = 1; i <= 6; i++)
                            {
                                <SgCol><div class="rd-cell">Card @i</div></SgCol>
                            }
                        </SgRow>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Lg="6">
                    <SgCard Title="Semantic elements" Subtitle="nav · main · footer — proper HTML5" Shadow="SgShadow.Sm" Hoverable="true" Animated="true">
                        <SgStack Vertical Space="@SgSize.Sm">
                            <SgRow Tag="SgRowTag.Nav" Gap="6px" Style="background:var(--sg-bg-subtle);padding:6px 8px;border-radius:4px;">
                                <SgTag Size="SgSize.Sm">Brand</SgTag>
                                <SgTag Size="SgSize.Sm">Home</SgTag>
                                <SgTag Size="SgSize.Sm">Docs</SgTag>
                                <SgTag Size="SgSize.Sm">Blog</SgTag>
                                <SgTag Size="SgSize.Sm">GitHub</SgTag>
                            </SgRow>
                            <SgRow Tag="SgRowTag.Main" Gap="6px" Style="background:var(--sg-color-success-subtle);padding:6px;border-radius:4px;min-height:48px;">
                                <SgCol Span="8"><div class="rd-cell rd-cell-sm">main</div></SgCol>
                                <SgCol Span="4"><div class="rd-cell rd-cell-sm">aside</div></SgCol>
                            </SgRow>
                            <SgRow Tag="SgRowTag.Footer" Gap="6px" Style="background:var(--sg-color-danger-subtle);padding:4px 8px;border-radius:4px;">
                                <SgTypography Size="SgTypographySize.Xs">© 2026 SuperUI</SgTypography>
                            </SgRow>
                        </SgStack>
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

        @* ═══════════════════════════════════════════════════════════════════
           4. SgStack & SgSpace
           ═══════════════════════════════════════════════════════════════════ *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    SgStack &amp; SgSpace
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Linear flex containers — orientation, density, stretch, dividers, separators.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="6">
                    <SgCard Title="SgStack" Subtitle="Horizontal · vertical · density · stretch · item-basis" Shadow="SgShadow.Sm" Hoverable="true" Animated="true">
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgStack Horizontal Gap="6px" Wrap="true" Stretch="true" Style="background:var(--sg-bg-subtle);padding:6px;border-radius:4px;">
                                <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Primary">Save</SgButton>
                                <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined">Cancel</SgButton>
                                <SgTag Size="SgSize.Sm">Stretched</SgTag>
                            </SgStack>
                            <SgStack Orientation="SgOrientation.Vertical" Gap="4px" ItemBasis="50px" Style="background:var(--sg-color-info-subtle);padding:6px;border-radius:4px;">
                                <SgTag Size="SgSize.Sm">1 · basis 50</SgTag>
                                <SgTag Size="SgSize.Sm">2 · basis 50</SgTag>
                                <SgTag Size="SgSize.Sm">3 · basis 50</SgTag>
                            </SgStack>
                            <SgStack Horizontal Gap="3px" ShowDividers="true" Justify="SgJustifyContent.SpaceBetween" Style="background:var(--sg-color-warning-subtle);padding:6px;border-radius:4px;">
                                <SgTag Size="SgSize.Sm">Inbox</SgTag>
                                <SgTag Size="SgSize.Sm">Archive</SgTag>
                                <SgTag Size="SgSize.Sm">Trash</SgTag>
                            </SgStack>
                        </SgStack>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Md="6">
                    <SgCard Title="SgSpace" Subtitle="Gap · separator · density · orientation" Shadow="SgShadow.Sm" Hoverable="true" Animated="true">
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgStack Vertical Space="@SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Weight="SgTypographyWeight.Semibold">Separator = " / "</SgTypography>
                                <SgSpace Separator=" / " Space="SgSize.Sm">
                                    <SgTag Size="SgSize.Sm">Home</SgTag>
                                    <SgTag Size="SgSize.Sm">Components</SgTag>
                                    <SgTag Size="SgSize.Sm">SgSpace</SgTag>
                                </SgSpace>
                            </SgStack>
                            <SgStack Vertical Space="@SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Weight="SgTypographyWeight.Semibold">Separator = " • "</SgTypography>
                                <SgSpace Separator=" • " Space="SgSize.Sm">
                                    <SgTag Size="SgSize.Sm">Blazor</SgTag>
                                    <SgTag Size="SgSize.Sm">Razor</SgTag>
                                    <SgTag Size="SgSize.Sm">Flexbox</SgTag>
                                </SgSpace>
                            </SgStack>
                            <SgStack Vertical Space="@SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Weight="SgTypographyWeight.Semibold">Vertical + Stretch</SgTypography>
                                <SgSpace Orientation="SgOrientation.Vertical" Space="SgSize.Sm" Align="SgAlignItems.Start" Stretch="true" Style="background:var(--sg-color-success-subtle);padding:6px;border-radius:4px;">
                                    <SgTag Size="SgSize.Sm">Line 1</SgTag>
                                    <SgTag Size="SgSize.Sm">Line 2</SgTag>
                                    <SgTag Size="SgSize.Sm">Line 3</SgTag>
                                </SgSpace>
                            </SgStack>
                        </SgStack>
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

        @* ═══════════════════════════════════════════════════════════════════
           5. Live SgRow Constructor
           ═══════════════════════════════════════════════════════════════════ *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Live SgRow Constructor
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Configure every SgRow parameter in real time · copy the code.
                </SgTypography>
            </div>

            <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
                <SgRow Space="SgSize.Md">
                    @* ── Control Panel ── *@
                    <SgCol Xs="12" Md="5" Style="padding:14px;border-right:1px solid var(--sg-border);">
                        <SgStack Vertical Space="SgSize.Md">
                            @* Columns *@
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Columns</SgTypography>
                                <SgSegmented TValue="int"
                                             Value="@_ctorCols"
                                             ValueChanged="v => { _ctorCols = v; UpdateCtorCode(); }"
                                             Block="true" Size="sm"
                                             Options="_colCountOptions" />
                            </SgStack>

                            @* Gap + Tag *@
                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Gap (SgSize)</SgTypography>
                                        <SgSegmented TValue="SgSize?"
                                                     Value="@_ctorSpace"
                                                     ValueChanged="v => { _ctorSpace = v; UpdateCtorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_spaceSegOptions" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Tag</SgTypography>
                                        <SgSelect TValue="SgRowTag"
                                                  @bind-Value="_ctorTag"
                                                  Items="_tagItems"
                                                  LabelSelector="x => x.ToString()"
                                                  Block="true" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>

                            @* Direction + Wrap *@
                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Direction</SgTypography>
                                        <SgSegmented TValue="SgFlexDirection"
                                                     Value="@_ctorDir"
                                                     ValueChanged="v => { _ctorDir = v; UpdateCtorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_dirSegOptions" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Wrap</SgTypography>
                                        <SgSegmented TValue="SgFlexWrap"
                                                     Value="@_ctorWrap"
                                                     ValueChanged="v => { _ctorWrap = v; UpdateCtorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_wrapSegOptions" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>

                            @* Align + Justify *@
                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Align</SgTypography>
                                        <SgSegmented TValue="SgAlignItems"
                                                     Value="@_ctorAlign"
                                                     ValueChanged="v => { _ctorAlign = v; UpdateCtorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_alignSegOptions" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Justify</SgTypography>
                                        <SgSegmented TValue="SgJustifyContent"
                                                     Value="@_ctorJustify"
                                                     ValueChanged="v => { _ctorJustify = v; UpdateCtorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_justifySegOptions" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>

                            @* Density + AutoFit *@
                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Density</SgTypography>
                                        <SgSegmented TValue="SgDensity"
                                                     Value="@_ctorDensity"
                                                     ValueChanged="v => { _ctorDensity = v; UpdateCtorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_densitySegOptions" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">AutoFit</SgTypography>
                                        <SgSegmented TValue="bool"
                                                     Value="@_ctorAutoFit"
                                                     ValueChanged="v => { _ctorAutoFit = v; UpdateCtorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_boolSegOptions" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>

                            @* Toggles *@
                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Reverse</SgTypography>
                                        <SgSegmented TValue="bool"
                                                     Value="@_ctorReverse"
                                                     ValueChanged="v => { _ctorReverse = v; UpdateCtorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_boolSegOptions" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Hoverable</SgTypography>
                                        <SgSegmented TValue="bool"
                                                     Value="@_ctorHoverable"
                                                     ValueChanged="v => { _ctorHoverable = v; UpdateCtorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_boolSegOptions" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>

                            @* Summary badges *@
                            <div class="ctrl-summary">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Tag</SgTypography>
                                        <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorTag.ToString()" Standalone="true" />
                                    </SgStack>
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Columns × Gap</SgTypography>
                                        <SgStack Horizontal Space="@SgSize.Sm">
                                            <SgBadge Variant="SgBadgeVariant.Default" Text="@($"{_ctorCols}")" Standalone="true" />
                                            <SgBadge Variant="SgBadgeVariant.Success" Text="@(_ctorSpace?.ToString() ?? "—")" Standalone="true" />
                                        </SgStack>
                                    </SgStack>
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Dir · Wrap · Density</SgTypography>
                                        <SgStack Horizontal Space="@SgSize.Sm">
                                            <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorDir.ToString()" Standalone="true" />
                                            <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorWrap.ToString()" Standalone="true" />
                                            <SgBadge Variant="SgBadgeVariant.Warn" Text="@_ctorDensity.ToString()" Standalone="true" />
                                        </SgStack>
                                    </SgStack>
                                </SgStack>
                            </div>
                        </SgStack>
                    </SgCol>

                    @* ── Preview + Code ── *@
                    <SgCol Xs="12" Md="7" Style="padding:14px;">
                        <SgStack Vertical Space="SgSize.Md">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                                <div class="constructor-preview">
                                    <SgRow Tag="@_ctorTag"
                                           Space="@_ctorSpace"
                                           Justify="@_ctorJustify"
                                           Align="@_ctorAlign"
                                           Wrap="@_ctorWrap"
                                           Direction="@_ctorDir"
                                           Density="@_ctorDensity"
                                           AutoFit="@_ctorAutoFit"
                                           Reverse="@_ctorReverse"
                                           Hoverable="@_ctorHoverable"
                                           MinHeight="100">
                                        @for (int i = 0; i < _ctorCols; i++)
                                        {
                                            var idx = i;
                                            <SgCol Span="@(12 / _ctorCols)">
                                                <div class="rd-cell rd-cell-@((idx % 6) + 1)">
                                                    <SgStack Horizontal Gap="4px" Align="SgAlignItems.Center" Justify="SgJustifyContent.Center">
                                                        <SgTag Size="SgSize.Sm">@((char)('A' + idx))</SgTag>
                                                        <span style="font-size:11px;">Col @(idx + 1)</span>
                                                    </SgStack>
                                                </div>
                                            </SgCol>
                                        }
                                    </SgRow>
                                </div>
                            </SgStack>

                            <SgStack Vertical Space="SgSize.Sm">
                                <div style="display:flex;align-items:center;justify-content:space-between;">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                    <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCtorCode">
                                        <span>@_ctorCopyIcon</span>
                                        <span style="font-size:11px;font-weight:600;">@_ctorCopyLabel</span>
                                    </button>
                                </div>
                                <div class="code-block">
                                    @foreach (var line in _ctorGeneratedCode)
                                    {
                                        <code>@line</code>
                                    }
                                </div>
                            </SgStack>
                        </SgStack>
                    </SgCol>
                </SgRow>
            </SgCard>
        </div>

    </ChildContent>
</SgCard>

<style>
    .rd-demo-page .demo-section { margin-top: 24px; }
    .rd-demo-page .demo-section-header { margin-bottom: 12px; }
    .rd-cell {
        background: var(--sg-color-primary-subtle);
        color: var(--sg-fg);
        padding: 6px 4px;
        border-radius: 4px;
        text-align: center;
        font-size: 11px;
        font-weight: 600;
        line-height: 1.2;
        min-height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .rd-cell-h { min-height: 36px; }
    .rd-cell-xs { padding: 3px 1px; font-size: 9px; min-height: 18px; }
    .rd-cell-sm { padding: 4px; min-height: 22px; font-size: 10px; }
    .rd-cell-accent { background: var(--sg-color-warning-subtle); }
    .rd-cell-1 { background: var(--sg-color-primary-subtle); }
    .rd-cell-2 { background: var(--sg-color-info-subtle); }
    .rd-cell-3 { background: var(--sg-color-success-subtle); }
    .rd-cell-4 { background: var(--sg-color-warning-subtle); }
    .rd-cell-5 { background: var(--sg-color-danger-subtle); }
    .rd-cell-6 { background: var(--sg-bg-emphasized); color: var(--sg-fg-inverse); }
    .constructor-preview {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 12px;
        min-height: 100px;
        transition: all var(--sg-transition-normal);
    }
    .ctrl-summary {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 8px 10px;
    }
    .code-block {
        background: #0f172a;
        color: #7dd3fc;
        padding: 12px 14px;
        border-radius: 8px;
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 12px;
        line-height: 1.8;
        overflow-x: auto;
        position: relative;
    }
    .code-block code {
        background: none;
        padding: 0;
        color: inherit;
        font-size: inherit;
        display: block;
        white-space: pre;
    }
    .demo-copy-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 6px;
        padding: 4px 10px;
        cursor: pointer;
        color: var(--sg-text-muted);
        transition: all var(--sg-transition-fast);
        font-family: inherit;
    }
    .demo-copy-btn:hover {
        color: var(--sg-primary);
        border-color: var(--sg-primary);
        background: color-mix(in srgb, var(--sg-primary) 8%, transparent);
    }
    .demo-copy-btn:active { transform: scale(0.95); }
    .demo-copy-btn.copied {
        color: var(--sg-color-success);
        border-color: var(--sg-color-success);
    }
</style>

@code {
    @* ── Constructor state ── *@
    private int _ctorCols = 3;
    private SgSize? _ctorSpace = SgSize.Md;
    private SgFlexDirection _ctorDir = SgFlexDirection.Row;
    private SgFlexWrap _ctorWrap = SgFlexWrap.Wrap;
    private SgAlignItems _ctorAlign = SgAlignItems.Stretch;
    private SgJustifyContent _ctorJustify = SgJustifyContent.Start;
    private SgRowTag _ctorTag = SgRowTag.Div;
    private SgDensity _ctorDensity = SgDensity.Default;
    private bool _ctorAutoFit;
    private bool _ctorReverse;
    private bool _ctorHoverable;

    private string[] _ctorGeneratedCode = Array.Empty<string>();
    private string _ctorCopyIcon = "📋";
    private string _ctorCopyLabel = "Copy";

    @* ── Segmented options ── *@
    private readonly List<SgSegmentedOption<int>> _colCountOptions = new()
    {
        new() { Value = 1, Label = "1" },
        new() { Value = 2, Label = "2" },
        new() { Value = 3, Label = "3" },
        new() { Value = 4, Label = "4" },
        new() { Value = 6, Label = "6" },
    };

    private readonly List<SgSegmentedOption<SgSize?>> _spaceSegOptions = new()
    {
        new() { Value = null,      Label = "—" },
        new() { Value = SgSize.Sm, Label = "Sm" },
        new() { Value = SgSize.Md, Label = "Md" },
        new() { Value = SgSize.Lg, Label = "Lg" },
        new() { Value = SgSize.Xl, Label = "Xl" },
    };

    private readonly List<SgSegmentedOption<SgFlexDirection>> _dirSegOptions = new()
    {
        new() { Value = SgFlexDirection.Row,    Label = "Row" },
        new() { Value = SgFlexDirection.Column, Label = "Col" },
    };

    private readonly List<SgSegmentedOption<SgFlexWrap>> _wrapSegOptions = new()
    {
        new() { Value = SgFlexWrap.Wrap,   Label = "Wrap" },
        new() { Value = SgFlexWrap.NoWrap, Label = "NoWrap" },
    };

    private readonly List<SgSegmentedOption<SgAlignItems>> _alignSegOptions = new()
    {
        new() { Value = SgAlignItems.Start,    Label = "Start" },
        new() { Value = SgAlignItems.Center,   Label = "Center" },
        new() { Value = SgAlignItems.End,      Label = "End" },
        new() { Value = SgAlignItems.Stretch,  Label = "Stretch" },
    };

    private readonly List<SgSegmentedOption<SgJustifyContent>> _justifySegOptions = new()
    {
        new() { Value = SgJustifyContent.Start,       Label = "Start" },
        new() { Value = SgJustifyContent.Center,      Label = "Center" },
        new() { Value = SgJustifyContent.End,         Label = "End" },
        new() { Value = SgJustifyContent.SpaceBetween, Label = "Between" },
    };

    private readonly List<SgSegmentedOption<SgDensity>> _densitySegOptions = new()
    {
        new() { Value = SgDensity.Compact,     Label = "Compact" },
        new() { Value = SgDensity.Default,     Label = "Default" },
        new() { Value = SgDensity.Comfortable, Label = "Comfortable" },
    };

    private readonly List<SgSegmentedOption<bool>> _boolSegOptions = new()
    {
        new() { Value = false, Label = "Off" },
        new() { Value = true,  Label = "On" },
    };

    private readonly List<SgRowTag> _tagItems = Enum.GetValues<SgRowTag>().ToList();

    protected override void OnInitialized()
    {
        UpdateCtorCode();
    }

    private void UpdateCtorCode()
    {
        var lines = new List<string>();
        lines.Add("<SgRow");
        if (_ctorTag != SgRowTag.Div) lines.Add($"      Tag=\"SgRowTag.{_ctorTag}\"");
        if (_ctorCols != 12) lines.Add($"      Columns=\"{_ctorCols}\"");
        if (_ctorSpace.HasValue) lines.Add($"      Space=\"SgSize.{_ctorSpace}\"");
        if (_ctorDir != SgFlexDirection.Row) lines.Add($"      Direction=\"SgFlexDirection.{_ctorDir}\"");
        if (_ctorReverse) lines.Add($"      Reverse=\"true\"");
        if (_ctorWrap != SgFlexWrap.Wrap) lines.Add($"      Wrap=\"SgFlexWrap.{_ctorWrap}\"");
        if (_ctorAlign != SgAlignItems.Stretch) lines.Add($"      Align=\"SgAlignItems.{_ctorAlign}\"");
        if (_ctorJustify != SgJustifyContent.Start) lines.Add($"      Justify=\"SgJustifyContent.{_ctorJustify}\"");
        if (_ctorDensity != SgDensity.Default) lines.Add($"      Density=\"SgDensity.{_ctorDensity}\"");
        if (_ctorAutoFit) lines.Add($"      AutoFit=\"true\"");
        if (_ctorHoverable) lines.Add($"      Hoverable=\"true\"");
        lines.Add("      MinHeight=\"100\">");
        var span = 12 / _ctorCols;
        for (int i = 0; i < _ctorCols; i++)
        {
            lines.Add($"    <SgCol Span=\"{span}\">Col {i + 1}</SgCol>");
        }
        lines.Add("</SgRow>");
        _ctorGeneratedCode = lines.ToArray();
    }

    private async Task CopyCtorCode()
    {
        var code = string.Join("\n", _ctorGeneratedCode);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _ctorCopyIcon = "✓";
            _ctorCopyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _ctorCopyIcon = "📋";
            _ctorCopyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _ctorCopyIcon = "✗";
            _ctorCopyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _ctorCopyIcon = "📋";
            _ctorCopyLabel = "Copy";
            StateHasChanged();
        }
    }
}
