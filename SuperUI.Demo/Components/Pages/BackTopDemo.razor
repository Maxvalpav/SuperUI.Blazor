@page "/backtop-demo"
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>BackTop — SuperUI</PageTitle>
<SgSeoHead Description="Explore BackTop — SuperUI Blazor component library demo with live examples, code snippets, and API documentation." />

<SgCard Variant="SgCardVariant.Default">
    @* ── Interactive Showcase ─────────────────────────────────────────────── *@
    <div class="sgc-demo-section" style="padding: 32px;">
        <div class="demo-section-header" style="margin-bottom: 32px;">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Bold">Live Constructor</SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sui-text-muted)">
                Navigation helpers that auto-appear on scroll. Configure and preview in real time.
            </SgTypography>
        </div>

        <div style="display: grid; grid-template-columns: 1.618fr 1fr; gap: 48px; align-items: start;">
            @* ── Preview Area ── *@
            <div style="background: var(--sg-surface-alt); padding: 64px; border-radius: 16px; border: 1px solid var(--sg-border); min-height: 480px; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden;">
                <div style="text-align: center; max-width: 440px;">
                    <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Semibold" Style="margin-bottom: 16px;">Visual Preview</SgTypography>
                    <SgTypography Size="SgTypographySize.Base" Color="var(--sui-text-muted)" Style="line-height: 1.7;">
                        Scroll the main page down to see the <strong>real BackTop</strong> button appear
                        in the bottom-right corner. Below is a live mockup of the configured appearance.
                    </SgTypography>

                    <div style="margin-top: 32px; display: flex; gap: 16px; justify-content: center;">
                        <div style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--sg-color-primary); color: #fff; box-shadow: var(--sg-shadow-lg);">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
                        </div>
                        <div style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--sg-color-primary); color: #fff; box-shadow: var(--sg-shadow-lg);">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
                        </div>
                    </div>

                    <div style="margin-top: 24px;">
                        <SgBadge Text="@($"Animation: {_animType}")" Variant="SgBadgeVariant.Info" />
                        <SgBadge Text="@(_showProgress ? "Progress: ON" : "Progress: OFF")" Variant="@(_showProgress ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Style="margin-left: 8px;" />
                    </div>
                </div>
            </div>

            @* ── Control Panel ── *@
            <div style="border-radius: 16px; border: 1px solid var(--sg-border-subtle); box-shadow: var(--sg-shadow-sm); background: var(--sg-bg);">
                <div style="padding: 20px;">
                    <SgTypography Variant="SgTypographyVariant.Heading6" Weight="SgTypographyWeight.Semibold" Style="margin-bottom: 20px;">Configuration</SgTypography>

                    <SgStack Vertical Space="SgSize.Lg">
                        <div>
                            <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Style="display: block; margin-bottom: 8px;">Visibility Threshold (px)</SgTypography>
                            <SgNumberInput TValue="int" @bind-Value="_threshold" Min="0" Max="2000" Step="50" />
                        </div>

                        <SgStack Horizontal Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center">
                            <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold">Show Progress Ring</SgTypography>
                            <SgSwitch @bind-Value="_showProgress" />
                        </SgStack>

                        <div>
                            <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Style="display: block; margin-bottom: 8px;">Animation Style</SgTypography>
                            <SgSegmented TValue="SgBackTopAnimation" @bind-Value="_animType" Options="@_animOptions" />
                        </div>

                        <SgDivider />

                        <div>
                            <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Style="display: block; margin-bottom: 12px;">Component Usage</SgTypography>
                            <pre class="demo-code-block" style="font-size: 11px; margin: 0; padding: 16px; border-radius: 8px;"><span class="demo-code-keyword">&lt;SgBackTop</span> 
  <span class="demo-code-attr">VisibilityHeight</span>=<span class="demo-code-string">"@_threshold"</span>
  <span class="demo-code-attr">Animation</span>=<span class="demo-code-string">"SgBackTopAnimation.@_animType"</span>
  <span class="demo-code-attr">ShowProgress</span>=<span class="demo-code-string">"@_showProgress.ToString().ToLower()"</span> <span class="demo-code-keyword">/&gt;</span></pre>
                        </div>
                    </SgStack>
                </div>
            </div>
        </div>
    </div>

    @* ── Properties Reference ─────────────────────────────────────────────── *@
    <div class="sgc-demo-section" style="padding: 32px; background: var(--sg-surface-alt);">
        <div class="demo-section-header" style="margin-bottom: 24px;">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Bold">Properties Reference</SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sui-text-muted)">Comprehensive list of parameters for SgBackTop and SgBackBottom.</SgTypography>
        </div>

        <SgCard Style="border-radius: 16px; border: 1px solid var(--sg-border-subtle);">
            <PropertyTable Items="_props" />
        </SgCard>
    </div>
</SgCard>

@* ── Live component instances ── *@
<SgBackTop Target=".sui-content" VisibilityHeight="_threshold" Animation="_animType" ShowProgress="_showProgress" CssClass="sg-backtop-demo" />
<SgBackBottom Target=".sui-content" VisibilityHeight="_threshold" Animation="_animType" ShowProgress="_showProgress" Bottom="84" CssClass="sg-backbottom-demo" />

@code {
    private int _threshold = 400;
    private bool _showProgress = true;
    private SgBackTopAnimation _animType = SgBackTopAnimation.Scale;

    private List<SgSegmentedOption<SgBackTopAnimation>> _animOptions = new()
    {
        new() { Value = SgBackTopAnimation.None,   Label = "None" },
        new() { Value = SgBackTopAnimation.Scale,   Label = "Scale" },
        new() { Value = SgBackTopAnimation.Fade,    Label = "Fade" },
        new() { Value = SgBackTopAnimation.SlideUp, Label = "Slide" },
        new() { Value = SgBackTopAnimation.Bounce,  Label = "Bounce" },
    };

    private List<PropertyPanelItem> _props = new()
    {
        new() { Label = "VisibilityHeight", Value = "int (default 200)",      BadgeText = "Appearance trigger", BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "ShowProgress",     Value = "bool (default false)",    BadgeText = "Scroll indicator",   BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Animation",        Value = "SgBackTopAnimation",      BadgeText = "Entry animation",    BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Target",           Value = "string?",                BadgeText = "Scroll container",   BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Smooth",           Value = "bool (default true)",    BadgeText = "Smooth scroll",      BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Persistent",       Value = "bool (default false)",   BadgeText = "Always in DOM",      BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Visible",          Value = "bool",                   BadgeText = "Two-way binding",    BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnClick",          Value = "EventCallback",          BadgeText = "Click event",        BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "ChildContent",     Value = "RenderFragment?",        BadgeText = "Custom icon/text",   BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "CssClass",         Value = "string?",                BadgeText = "Extra CSS class",    BadgeVariant = SgBadgeVariant.Default },
    };
}
