@page "/backtop-demo"

<PageTitle>BackTop - SUI</PageTitle>

<SgCard Title="SgBackTop - Кнопка «Наверх»"
        Subtitle="Плавающая кнопка возврата к началу страницы. Появляется после прокрутки на заданное расстояние.">

    <div style="margin-top: 32px;">
        <h2>Базовое использование</h2>
        <p>Прокрутите страницу вниз — в правом нижнем углу появится круглая кнопка. Нажмите её, чтобы плавно вернуться наверх.</p>

        <div style="height: 1600px; padding: 16px; border: 1px dashed var(--sui-border); border-radius: var(--sui-radius-md); color: var(--sui-muted); display:flex; align-items:flex-end; justify-content:center;">
            Конец длинного контента — кнопка должна быть видна в углу.
        </div>
    </div>

    <SgBackTop Target=".sui-content" VisibilityHeight="200" />

    <div style="margin-top: 32px;">
        <h2>Свойства</h2>
        <SgCard Title="SgBackTop" Style="margin-top: 16px;">
            <PropertyTable Items="_props" />
        </SgCard>
    </div>
</SgCard>

@code {
    private List<PropertyPanelItem> _props = new()
    {
        new() { Label = "VisibilityHeight", Value = "int (default 200)", BadgeText = "Порог появления", BadgeVariant = "info" },
        new() { Label = "Target", Value = "string?", BadgeText = "CSS-селектор контейнера", BadgeVariant = "info" },
        new() { Label = "Smooth", Value = "bool (default true)", BadgeText = "Плавный скролл", BadgeVariant = "info" },
        new() { Label = "Bottom", Value = "int (default 32)", BadgeText = "Отступ снизу (px)", BadgeVariant = "info" },
        new() { Label = "Right", Value = "int (default 32)", BadgeText = "Отступ справа (px)", BadgeVariant = "info" },
        new() { Label = "Title", Value = "string", BadgeText = "Tooltip", BadgeVariant = "info" },
        new() { Label = "OnClick", Value = "EventCallback", BadgeText = "Событие клика", BadgeVariant = "success" },
        new() { Label = "ChildContent", Value = "RenderFragment?", BadgeText = "Кастомный контент", BadgeVariant = "info" }
    };
}
