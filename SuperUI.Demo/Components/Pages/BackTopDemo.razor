@page "/backtop-demo"

<PageTitle>BackTop - SUI</PageTitle>

<SgCard Title="SgBackTop - Кнопка «Наверх»"
        Subtitle="Плавающая кнопка возврата к началу страницы. Появляется после прокрутки на заданное расстояние.">

    <div style="margin-top: 32px;">
        <h2>Базовое использование</h2>
        <p>Прокрутите страницу вниз — в правом нижнем углу появится круглая кнопка. Нажмите её, чтобы плавно вернуться наверх.</p>

        <div style="height: 1600px; padding: 16px; border: 1px dashed var(--sui-border); border-radius: var(--sui-radius-md); color: var(--sui-muted); display:flex; align-items:flex-end; justify-content:center;">
            Конец длинного контента — кнопка должна быть видна в углу.
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Кастомный контент (Навигация Вверх/Вниз)</h2>
        <p>Пример использования пары кнопок для быстрой навигации по длинной странице.</p>
        
        <SgStack Orientation="SgOrientation.Vertical" Gap="4px" Style="position: fixed; bottom: 100px; right: 32px; z-index: 1000;">
            <SgBackTop Target=".sui-content" VisibilityHeight="100" Smooth="true" CssClass="sgc-nav-custom">
                <SgIcon Icon="@SgIcons.ChevronUp" />
            </SgBackTop>
            
            <SgBackBottom Target=".sui-content" VisibilityHeight="100" Smooth="true" CssClass="sgc-nav-custom">
                <SgIcon Icon="@SgIcons.ChevronDown" />
            </SgBackBottom>
        </SgStack>
    </div>

    <style>
        .sgc-nav-custom {
            position: static !important; /* Stack handles position */
            width: 44px !important;
            height: 44px !important;
            border-radius: 4px !important;
            background: var(--sg-bg-subtle) !important;
            color: var(--sg-color-primary) !important;
            border: 1px solid var(--sg-border) !important;
            box-shadow: var(--sg-shadow-sm) !important;
        }
        .sgc-nav-custom:hover {
            background: var(--sg-color-primary) !important;
            color: white !important;
        }
    </style>

    <div style="margin-top: 32px;">
        <h2>Свойства</h2>
        <SgCard Title="SgBackTop" Style="margin-top: 16px;">
            <PropertyTable Items="_props" />
        </SgCard>
    </div>

    <!-- Code example -->
    <div style="margin-top: 32px;">
        <h2>Примеры кода</h2>
    </div>

</SgCard>

@code {
    private List<PropertyPanelItem> _props = new()
    {
        new() { Label = "VisibilityHeight", Value = "int (default 200)", BadgeText = "Порог появления",        BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Target",           Value = "string?",           BadgeText = "CSS-селектор контейнера",BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Smooth",           Value = "bool (default true)",BadgeText = "Плавный скролл",        BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Bottom",           Value = "int (default 32)",  BadgeText = "Отступ снизу (px)",      BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Right",            Value = "int (default 32)",  BadgeText = "Отступ справа (px)",     BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Title",            Value = "string",            BadgeText = "Tooltip",                BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "OnClick",          Value = "EventCallback",     BadgeText = "Событие клика",          BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "ChildContent",     Value = "RenderFragment?",   BadgeText = "Кастомный контент",      BadgeVariant = SgBadgeVariant.Info }
    };
}
