    .sgc-anim-preview-dot {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: var(--sg-primary);
        color: var(--sg-primary-foreground);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        transition: opacity 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
                    transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        opacity: 0;
        transform: scale(0);
    }
    .sgc-anim-preview-dot.sgc-anim-preview-visible {
        opacity: 1;
        transform: scale(1) translateY(0);
    }
    .sgc-anim-preview-dot[data-anim="fade"] {
        transform: scale(1);
    }
    .sgc-anim-preview-dot[data-anim="fade"].sgc-anim-preview-visible {
        opacity: 1;
    }
    .sgc-anim-preview-dot[data-anim="slideup"] {
        transform: translateY(24px);
    }
    .sgc-anim-preview-dot[data-anim="slideup"].sgc-anim-preview-visible {
        transform: translateY(0);
    }
    .sgc-anim-preview-dot[data-anim="bounce"] {
        transform: scale(0) translateY(30px);
    }
    .sgc-anim-preview-dot[data-anim="bounce"].sgc-anim-preview-visible {
        transform: scale(1) translateY(0);
    }
    .sgc-anim-preview-dot[data-anim="none"] {
        transform: none;
    }
</style>
