@page "/backtop-demo"
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>BackTop — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" HeaderContent="@_headerContent">
    @* ── Interactive Showcase ─────────────────────────────────────────────── *@
    <div class="sgc-demo-section" style="padding: 32px;">
        <div class="demo-section-header" style="margin-bottom: 32px;">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Bold">Live Constructor</SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Navigation helpers that auto-appear on scroll. Configure the behavior and appearance in real-time.
            </SgTypography>
        </div>

        <div style="display: grid; grid-template-columns: 1.618fr 1fr; gap: 48px; align-items: start;">
            @* ── Preview Area ── *@
            <div style="background: var(--sg-surface-alt); padding: 64px; border-radius: 16px; border: 1px solid var(--sg-border); min-height: 480px; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden;">
                @* Simulated Page Content for Scroll Demo *@
                <div style="text-align: center; max-width: 440px; z-index: 1;">
                    <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Semibold" Style="margin-bottom: 16px;">Visual Preview</SgTypography>
                    <SgTypography Size="SgTypographySize.Base" Color="var(--sg-text-muted)" Style="line-height: 1.7;">
                        This area simulates how the button will look. 
                        Scroll the main page to see the <strong>real global BackTop</strong> button in the bottom right corner.
                    </SgTypography>
                </div>

                @* The Mock Button *@
                <div style="position: absolute; bottom: 48px; right: 48px; transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);">
                    <div style="position: relative; width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; background: var(--sg-color-primary); color: #fff; border-radius: 50%; box-shadow: var(--sg-shadow-lg); cursor: pointer; border: 2px solid var(--sg-bg);">
                        <SgIcon Icon="@(_basicDirection == "top" ? SgIcons.ArrowUp : SgIcons.ArrowDown)" Size="28px" />
                        
                        @if (_basicShowProgress)
                        {
                            <svg style="position: absolute; inset: -6px; width: 76px; height: 76px; transform: rotate(-90deg);">
                                <circle cx="38" cy="38" r="35" fill="none" stroke="var(--sg-border)" stroke-width="3" opacity="0.2" />
                                <circle cx="38" cy="38" r="35" fill="none" stroke="var(--sg-color-primary)" stroke-width="4"
                                        stroke-dasharray="219.9" stroke-dashoffset="@(219.9 * (1 - _progressValue / 100.0))"
                                        stroke-linecap="round" style="transition: stroke-dashoffset 0.4s ease;" />
                            </svg>
                        }
                    </div>
                </div>

                @* Progress Badge *@
                <div style="position: absolute; top: 32px; right: 32px;">
                    <SgBadge Text="@($"{_progressValue:F0}%")" Variant="SgBadgeVariant.Info" />
                </div>
            </div>

            @* ── Control Panel ── *@
            <SgCard Style="border-radius: 16px; border: 1px solid var(--sg-border-subtle); box-shadow: var(--sg-shadow-sm);">
                <SgStack Vertical Space="SgSize.Lg" Style="padding: 16px;">
                    <div>
                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Style="display: block; margin-bottom: 12px;">Scroll Direction</SgTypography>
                        <SgSegmented TValue="string" @bind-Value="_basicDirection" Options="@_directionOptions" />
                    </div>

                    <SgDivider />

                    <div>
                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Style="display: block; margin-bottom: 12px;">Simulate Scroll Progress</SgTypography>
                        <div style="display: flex; align-items: center; gap: 16px;">
                            <input type="range" min="0" max="100" @bind="_progressValue" style="flex: 1; accent-color: var(--sg-color-primary);" />
                            <SgTypography Size="SgTypographySize.Xs" Font="SgTypographyFont.Mono" Color="var(--sg-color-primary)">@_progressValue.ToString("F0")%</SgTypography>
                        </div>
                    </div>

                    <SgDivider />

                    <SgStack Horizontal Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center">
                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold">Show Progress Ring</SgTypography>
                        <SgSwitch @bind-Value="_basicShowProgress" />
                    </SgStack>

                    <SgDivider />

                    <div>
                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Style="display: block; margin-bottom: 12px;">Visibility Threshold (px)</SgTypography>
                        <SgNumberInput TValue="int" @bind-Value="_basicThreshold" Min="0" Max="2000" Step="50" />
                    </div>

                    <SgDivider />

                    <div>
                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Style="display: block; margin-bottom: 12px;">Component Usage</SgTypography>
                        <pre class="demo-code-block" style="font-size: 11px; margin: 0; padding: 16px; border-radius: 8px;"><span class="demo-code-keyword">&lt;SgBackTop</span> 
  <span class="demo-code-attr">Threshold</span>=<span class="demo-code-string">"@_basicThreshold"</span>
  <span class="demo-code-attr">ShowProgress</span>=<span class="demo-code-string">"@_basicShowProgress.ToString().ToLower()"</span> <span class="demo-code-keyword">/&gt;</span></pre>
                    </div>
                </SgStack>
            </SgCard>
        </div>
    </div>

    @* ── Properties Reference ─────────────────────────────────────────────── *@
    <div class="sgc-demo-section" style="padding: 32px; background: var(--sg-surface-alt);">
        <div class="demo-section-header" style="margin-bottom: 24px;">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Bold">Properties Reference</SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Comprehensive list of parameters for SgBackTop component.</SgTypography>
        </div>

        <SgCard Style="border-radius: 16px; border: 1px solid var(--sg-border-subtle);">
            <PropertyTable Items="_props" />
        </SgCard>
    </div>
</SgCard>

@code {
    private RenderFragment _headerContent => __builder => {
        <SgStack Horizontal Align="SgAlignItems.Center" Space="SgSize.Md">
            <div style="width: 40px; height: 40px; background: var(--sg-color-primary); color: #fff; border-radius: 10px; display: flex; align-items: center; justify-content: center; box-shadow: var(--sg-shadow-md);">
                <SgIcon Icon="@SgIcons.ArrowUp" Size="24px" />
            </div>
            <div>
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="line-height: 1.2;">BackTop & BackBottom</SgTypography>
                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Navigation component for large scrollable pages</SgTypography>
            </div>
        </SgStack>
    };

    private string _basicDirection = "top";
    private bool _basicShowProgress = true;
    private int _basicThreshold = 400;
    private double _progressValue = 45;

    private List<SgSegmentedOption<string>> _directionOptions = new()
    {
        new() { Value = "top", Label = "To Top" },
        new() { Value = "bottom", Label = "To Bottom" }
    };

    private List<PropertyPanelItem> _props = new()
    {
        new() { Label = "Threshold",      Value = "int (default 400)",          BadgeText = "Appearance trigger", BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "ShowProgress",   Value = "bool (default false)",       BadgeText = "Scroll indicator",   BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Target",         Value = "string? (default body)",     BadgeText = "Scroll container",   BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Duration",       Value = "int (default 450)",          BadgeText = "Scroll speed (ms)",  BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Visibility",     Value = "bool",                       BadgeText = "Two-way binding",    BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnClick",        Value = "EventCallback",              BadgeText = "Event",              BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "ChildContent",   Value = "RenderFragment?",            BadgeText = "Custom icon/text",   BadgeVariant = SgBadgeVariant.Default },
    };
}
