            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            var res = await _module.InvokeAsync<JsonElement>("loadDatabaseFromDisk", bytes, file.Name);
            if (res.GetProperty("ok").GetBoolean())
            {
                var tables = res.TryGetProperty("tables", out var t)
                    ? t.EnumerateArray().Select(x => x.GetString() ?? "").Where(x => x.Length > 0).ToList()
                    : new List<string>();
                _ioMessage = $"Загружено из «{file.Name}»: {string.Join(", ", tables.Take(5))}{(tables.Count > 5 ? "..." : "")}";
                _ioError = false;
                await RefreshSchemaAsync();
            }
            else
            {
                _ioMessage = res.TryGetProperty("error", out var err) ? err.GetString() : "Ошибка загрузки";
                _ioError = true;
            }
        }
        catch (Exception ex)
        {
            _ioMessage = ex.Message;
            _ioError = true;
        }
        finally { _loadingDuckDb = false; StateHasChanged(); }
