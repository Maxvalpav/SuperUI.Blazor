    private class CtorColumn
    {
        public string Name { get; set; } = "";
        public string Type { get; set; } = "VARCHAR";
        public bool Nullable { get; set; } = true;
        public bool PrimaryKey { get; set; }
    }

    private List<CtorColumn> _ctorColumns = new();

    private static readonly string[] _sqlTypes = new[]
    {
        "INTEGER", "BIGINT", "SMALLINT", "TINYINT", "HUGEINT",
        "DECIMAL(10,2)", "DECIMAL(18,4)", "FLOAT", "DOUBLE",
        "VARCHAR", "TEXT", "CHAR(10)",
        "BOOLEAN",
        "DATE", "TIMESTAMP", "TIME",
        "UUID",
    };

    private void OpenConstructor()
    {
        _ctorTableName = "my_table";
        _ctorRowCount  = 1000;
        _ctorError     = null;
        _ctorColumns   = new List<CtorColumn>
        {
            new() { Name = "id",   Type = "INTEGER", Nullable = false, PrimaryKey = true },
            new() { Name = "name", Type = "VARCHAR",  Nullable = true },
        };
        _showConstructor = true;
        StateHasChanged();
    }

    private void AddCtorColumn()
    {
        _ctorColumns.Add(new CtorColumn { Name = $"col{_ctorColumns.Count + 1}", Type = "VARCHAR", Nullable = true });
        StateHasChanged();
    }

    private void RemoveCtorColumn(int idx)
    {
        if (_ctorColumns.Count > 1) _ctorColumns.RemoveAt(idx);
        StateHasChanged();
    }

    private async Task BuildTableAsync()
    {
        _ctorError = null;
        var name = _ctorTableName.Trim();
        if (string.IsNullOrEmpty(name)) { _ctorError = "Укажите имя таблицы"; return; }
        if (_ctorColumns.Any(c => string.IsNullOrWhiteSpace(c.Name))) { _ctorError = "Все колонки должны иметь имя"; return; }

        _ctorBuilding = true;
        StateHasChanged();
        try
        {
            // Build column definitions
            var colDefs = _ctorColumns.Select(c =>
            {
                var def = $"\"{c.Name}\" {c.Type}";
                if (!c.Nullable) def += " NOT NULL";
                if (c.PrimaryKey) def += " PRIMARY KEY";
                return def;
            });

            var createSql = $"DROP TABLE IF EXISTS \"{name}\";\nCREATE TABLE \"{name}\" ({string.Join(", ", colDefs)});";

            var execRes = await _module!.InvokeAsync<JsonElement>("execute", createSql);
            if (!execRes.GetProperty("ok").GetBoolean())
            {
                _ctorError = execRes.TryGetProperty("error", out var e) ? e.GetString() : "Ошибка создания";
                return;
            }

            // Generate data if requested
            if (_ctorRowCount > 0)
            {
                var colSpecs = _ctorColumns.Select(c => new { name = c.Name, type = c.Type }).ToList();
                var specsJson = System.Text.Json.JsonSerializer.Serialize(colSpecs);
                var seedRes = await _module.InvokeAsync<JsonElement>("seedCustomTable", name, specsJson, _ctorRowCount);
                if (!seedRes.GetProperty("ok").GetBoolean())
                {
                    _ctorError = seedRes.TryGetProperty("error", out var e) ? e.GetString() : "Ошибка генерации";
                    return;
                }
            }

            _showConstructor = false;
            _sql = $"SELECT * FROM \"{name}\" LIMIT 50;";
            await RefreshSchemaAsync();
            await RunQueryAsync();
        }
        finally
        {
            _ctorBuilding = false;
            StateHasChanged();
        }
    }

    private async Task ToggleOpfsAsync()
    {
        if (_module is null) return;
        var want = !_opfsActive;
        _status = "loading";
        _statusText = want ? "Подключение OPFS..." : "Переключение...";
        StateHasChanged();

        var result = await _module.InvokeAsync<JsonElement>("init", want);
        _opfsActive = result.TryGetProperty("opfs", out var op) && op.GetBoolean();
        _status = "ready";
        _statusText = _opfsActive ? "DuckDB + OPFS" : "DuckDB готов";

        // Save preference
        try { await JS.InvokeVoidAsync("eval", $"localStorage.setItem('ddb-opfs','{(_opfsActive ? 1 : 0)}')"); } catch {}

        _columns.Clear(); _rows.Clear(); _hasRun = false;
        await RefreshSchemaAsync();
    }

