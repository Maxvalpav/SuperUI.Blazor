    // ── Query ─────────────────────────────────────────────────────────────────

    private async Task RunQueryAsync()
    {
        if (_module is null || string.IsNullOrWhiteSpace(_sql)) return;
        _running = true;
        _queryError = null;
        _hasRun = false;
        _planText = null;
        _columns.Clear();
        _rows.Clear();
        StateHasChanged();

        var sw = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            var result = await _module.InvokeAsync<JsonElement>("query", _sql.Trim());
            sw.Stop();
            _elapsed = sw.ElapsedMilliseconds;

            if (result.GetProperty("ok").GetBoolean())
            {
                _columns = result.GetProperty("schema").EnumerateArray()
                    .Select(f => new ColInfo(
                        f.GetProperty("name").GetString()!,
                        f.GetProperty("type").GetString()!))
                    .ToList();

                _rows = result.GetProperty("rows").EnumerateArray()
                    .Select(row =>
                    {
                        var dict = new Dictionary<string, object?>();
                        foreach (var col in _columns)
                        {
                            if (row.TryGetProperty(col.Name, out var val))
                            {
                                dict[col.Name] = val.ValueKind switch
                                {
                                    JsonValueKind.Null    => null,
                                    JsonValueKind.True    => (object)true,
                                    JsonValueKind.False   => false,
                                    JsonValueKind.Number  => ParseNumber(val),
                                    JsonValueKind.String  => ParseString(val.GetString(), col.Type),
                                    _                     => val.GetString(),
                                };
                            }
                            else dict[col.Name] = null;
                        }
                        return dict;
                    })
                    .ToList();

                _hasRun = true;

                // Run EXPLAIN ANALYZE if requested
                if (_showPlan && !_sql.Trim().ToUpper().StartsWith("EXPLAIN"))
                {
                    try
                    {
                        // Set output to show more details including physical plan
                        await _module.InvokeVoidAsync("execute", "PRAGMA explain_output='all'");
                        
                        var explainResult = await _module.InvokeAsync<JsonElement>("query", $"EXPLAIN ANALYZE {_sql.Trim()}");
                        if (explainResult.GetProperty("ok").GetBoolean())
                        {
                            var explainRows = explainResult.GetProperty("rows").EnumerateArray();
                            if (explainRows.Any())
                            {
                                // Join all rows if multiple, DuckDB sometimes splits long plans
                                _planText = string.Join("\n", explainRows.Select(r => r.EnumerateObject().First().Value.GetString()));
                            }
                        }
                    }
                    catch { /* ignore plan errors */ }
                }

                await RefreshSchemaAsync();
            }
            else
            {
                _queryError = result.TryGetProperty("error", out var err) ? err.GetString() : "Unknown error";
            }
        }
        catch (Exception ex)
        {
            sw.Stop();
            _queryError = ex.Message;
        }
        finally
        {
            _running = false;
            StateHasChanged();
        }
    }

    // ── Generators ────────────────────────────────────────────────────────────

    private async Task SeedAsync(Generator gen)
    {
        _seeding = gen.Key;
        _queryError = null;
        StateHasChanged();
        try { await gen.Action(); }
        finally
        {
            _seeding = null;
            await RefreshSchemaAsync();
        }
    }

    private async Task SeedTableAsync(string which)
