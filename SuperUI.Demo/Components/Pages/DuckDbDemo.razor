            _queryError = res.TryGetProperty("error", out var e) ? e.GetString() : "Seed failed";
        else
        {
            _sql = "SELECT dept, COUNT(*) AS cnt, ROUND(AVG(salary),2) AS avg_salary\nFROM employees GROUP BY dept ORDER BY avg_salary DESC;";
            await RunQueryAsync();
        }
    }

    // ── Table constructor ─────────────────────────────────────────────────────

    private bool _showConstructor;
    private bool _ctorBuilding;
    private string _ctorTableName = "my_table";
    private int _ctorRowCount = 1000;
