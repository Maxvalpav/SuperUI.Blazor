    // ── Schema ────────────────────────────────────────────────────────────────

    private async Task RefreshSchemaAsync()
    {
        if (_module is null) return;
        try
        {
            // databases — now returns [{name, path, type}]
            var dbRes = await _module.InvokeAsync<JsonElement>("listDatabases");
            if (dbRes.GetProperty("ok").GetBoolean())
            {
                _databases = dbRes.GetProperty("databases").EnumerateArray()
                    .Select(d => d.ValueKind == JsonValueKind.String
                        ? (d.GetString() ?? "")
                        : (d.TryGetProperty("name", out var n) ? (n.GetString() ?? "") : ""))
                    .Where(d => d.Length > 0).ToList();

                if (_databases.Count > 0 && _openDbs.Count == 0)
                    _openDbs.Add(_databases[0]);

                // Keep activeDatabase valid
                if (!_databases.Contains(_activeDatabase) && _databases.Count > 0)
                    _activeDatabase = _databases[0];
            }

            // tables
            var tblRes = await _module.InvokeAsync<JsonElement>("listTables");
            if (tblRes.GetProperty("ok").GetBoolean())
            {
                _tables = tblRes.GetProperty("tables").EnumerateArray()
                    .Select(t => t.GetString() ?? "").Where(t => t.Length > 0).ToList();
            }
        }
        catch { /* ignore */ }
        StateHasChanged();
    }

    private async Task SwitchDatabaseAsync(string dbName)
    {
        if (_module is null || string.IsNullOrEmpty(dbName)) return;
        try
        {
            var res = await _module.InvokeAsync<JsonElement>("switchDatabase", dbName);
            if (res.GetProperty("ok").GetBoolean())
            {
                _activeDatabase = dbName;
                _openDbs.Clear();
                _openDbs.Add(dbName);
                _tables = res.TryGetProperty("tables", out var t)
                    ? t.EnumerateArray().Select(x => x.GetString() ?? "").Where(x => x.Length > 0).ToList()
                    : new List<string>();
                _selectedTable = null;
                _columns.Clear();
                _rows.Clear();
                _hasRun = false;
            }
        }
        catch { /* ignore */ }
        StateHasChanged();
    }

    private async Task ShowStructureAsync(string table)
    {
        if (_module is null) return;
        _structureTable = table;
        _structureCols.Clear();
        _structureIndexes.Clear();
        try
        {
            var res = await _module.InvokeAsync<JsonElement>("describeTable", table);
            if (res.GetProperty("ok").GetBoolean())
            {
                _structureCols = res.GetProperty("columns").EnumerateArray()
                    .Select(c => new StructCol(
                        c.GetProperty("name").GetString() ?? "",
                        c.GetProperty("type").GetString() ?? "",
                        c.TryGetProperty("null", out var n) ? (n.GetString() ?? "") : ""))
                    .ToList();
            }

            var idxRes = await _module.InvokeAsync<JsonElement>("listIndexes", table);
            if (idxRes.GetProperty("ok").GetBoolean() && idxRes.TryGetProperty("indexes", out var idxArr))
            {
                _structureIndexes = idxArr.EnumerateArray()
                    .Select(i => new IndexInfo(
                        i.TryGetProperty("name", out var nm) ? (nm.GetString() ?? "") : "",
                        i.TryGetProperty("unique", out var u) && u.GetBoolean(),
                        i.TryGetProperty("sql", out var s) ? (s.GetString() ?? "") : ""))
                    .ToList();
            }
        }
        catch { /* ignore */ }
        StateHasChanged();
    }

    private void ToggleDb(string db)
