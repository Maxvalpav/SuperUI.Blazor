    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        _generators = new List<Generator>
        {
            new("hr",    "👥", "HR-данные",      "200 сотрудников, отделы, зарплаты",  () => SeedTableAsync("employees")),
            new("shop",  "🛒", "Магазин",         "80 товаров + 600 заказов",           () => SeedTableAsync("shop")),
            new("all",   "🗄️", "Все таблицы",     "employees + products + orders",      () => SeedAllAsync()),
            new("drop",  "🗑️", "Очистить всё",    "Удалить все таблицы",               () => DropAllAsync()),
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sg-duckdb.js");

            // Check OPFS support before init
            _opfsSupported = await _module.InvokeAsync<bool>("opfsSupported");

            // Restore last OPFS preference from localStorage
            var savedOpfs = false;
            try { savedOpfs = await JS.InvokeAsync<bool>("eval", "localStorage.getItem('ddb-opfs') === '1'"); } catch {}

            var result = await _module.InvokeAsync<JsonElement>("init", savedOpfs && _opfsSupported);

            if (result.GetProperty("ok").GetBoolean())
            {
                _opfsActive = result.TryGetProperty("opfs", out var op) && op.GetBoolean();
                _status = "ready";
                _statusText = _opfsActive ? "DuckDB + OPFS" : "DuckDB готов";
                await RefreshSchemaAsync();
            }
            else
            {
                _status = "error";
                _statusText = "Ошибка";
                _initError = result.TryGetProperty("error", out var e) ? e.GetString() : "Unknown error";
            }
        }
        catch (Exception ex)
        {
            _status = "error";
            _statusText = "Ошибка";
            _initError = ex.Message;
        }
        StateHasChanged();
    }

    // ── Schema ────────────────────────────────────────────────────────────────

    private async Task RefreshSchemaAsync()
    {
        if (_module is null) return;
        try
        {
            // databases
            var dbRes = await _module.InvokeAsync<JsonElement>("listDatabases");
            if (dbRes.GetProperty("ok").GetBoolean())
            {
                _databases = dbRes.GetProperty("databases").EnumerateArray()
                    .Select(d => d.GetString() ?? "").Where(d => d.Length > 0).ToList();
                if (_databases.Count > 0 && _openDbs.Count == 0)
                    _openDbs.Add(_databases[0]);
            }

            // tables
            var tblRes = await _module.InvokeAsync<JsonElement>("listTables");
            if (tblRes.GetProperty("ok").GetBoolean())
            {
                _tables = tblRes.GetProperty("tables").EnumerateArray()
                    .Select(t => t.GetString() ?? "").Where(t => t.Length > 0).ToList();
            }
        }
        catch { /* ignore */ }
        StateHasChanged();
    }

    private async Task ShowStructureAsync(string table)
    {
        if (_module is null) return;
        _structureTable = table;
        _structureCols.Clear();
        try
        {
            var res = await _module.InvokeAsync<JsonElement>("describeTable", table);
            if (res.GetProperty("ok").GetBoolean())
            {
                _structureCols = res.GetProperty("columns").EnumerateArray()
                    .Select(c => new StructCol(
                        c.GetProperty("name").GetString() ?? "",
                        c.GetProperty("type").GetString() ?? "",
                        c.TryGetProperty("null", out var n) ? (n.GetString() ?? "") : ""))
                    .ToList();
            }
        }
        catch { /* ignore */ }
        StateHasChanged();
    }

    private void ToggleDb(string db)
    {
        if (!_openDbs.Remove(db)) _openDbs.Add(db);
        StateHasChanged();
    }

    // ── Query ─────────────────────────────────────────────────────────────────

    private async Task RunQueryAsync()
    {
        if (_module is null || string.IsNullOrWhiteSpace(_sql)) return;
        _running = true;
        _queryError = null;
        _hasRun = false;
        _columns.Clear();
        _rows.Clear();
        StateHasChanged();

        var sw = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            var result = await _module.InvokeAsync<JsonElement>("query", _sql.Trim());
            sw.Stop();
            _elapsed = sw.ElapsedMilliseconds;

            if (result.GetProperty("ok").GetBoolean())
            {
                _columns = result.GetProperty("schema").EnumerateArray()
                    .Select(f => new ColInfo(
                        f.GetProperty("name").GetString()!,
                        f.GetProperty("type").GetString()!))
                    .ToList();

                _rows = result.GetProperty("rows").EnumerateArray()
                    .Select(row =>
                    {
                        var dict = new Dictionary<string, object?>();
                        foreach (var col in _columns)
                        {
                            if (row.TryGetProperty(col.Name, out var val))
                            {
                                dict[col.Name] = val.ValueKind switch
                                {
                                    JsonValueKind.Null    => null,
                                    JsonValueKind.True    => (object)true,
                                    JsonValueKind.False   => false,
                                    JsonValueKind.Number  => ParseNumber(val),
                                    JsonValueKind.String  => ParseString(val.GetString(), col.Type),
                                    _                     => val.GetString(),
                                };
                            }
                            else dict[col.Name] = null;
                        }
                        return dict;
                    })
                    .ToList();

                _hasRun = true;
                await RefreshSchemaAsync();
            }
            else
            {
                _queryError = result.TryGetProperty("error", out var err) ? err.GetString() : "Unknown error";
            }
        }
        catch (Exception ex)
        {
            sw.Stop();
            _queryError = ex.Message;
        }
        finally
        {
            _running = false;
            StateHasChanged();
        }
    }

    // ── Generators ────────────────────────────────────────────────────────────

    private async Task SeedAsync(Generator gen)
    {
        _seeding = gen.Key;
        _queryError = null;
        StateHasChanged();
        try { await gen.Action(); }
        finally
        {
            _seeding = null;
            await RefreshSchemaAsync();
        }
    }

    private async Task SeedTableAsync(string which)
    {
        if (_module is null) return;
        var count = Math.Max(1, _genCount);
        var res = which == "shop"
            ? await _module.InvokeAsync<JsonElement>("seedShopData", count)
            : await _module.InvokeAsync<JsonElement>("seedDemoData", count);

        if (!res.GetProperty("ok").GetBoolean())
            _queryError = res.TryGetProperty("error", out var e) ? e.GetString() : "Seed failed";
        else
        {
            _sql = which == "shop"
                ? "SELECT * FROM products LIMIT 50;"
                : "SELECT * FROM employees LIMIT 50;";
            await RunQueryAsync();
        }
    }

    private async Task SeedAllAsync()
    {
        if (_module is null) return;
        var count = Math.Max(1, _genCount);
        var res = await _module.InvokeAsync<JsonElement>("seedAllData", count);
        if (!res.GetProperty("ok").GetBoolean())
            _queryError = res.TryGetProperty("error", out var e) ? e.GetString() : "Seed failed";
        else
        {
            _sql = "SELECT dept, COUNT(*) AS cnt, ROUND(AVG(salary),2) AS avg_salary\nFROM employees GROUP BY dept ORDER BY avg_salary DESC;";
            await RunQueryAsync();
        }
    }

    // ── Table constructor ─────────────────────────────────────────────────────

    private bool _showConstructor;
    private bool _ctorBuilding;
    private string _ctorTableName = "my_table";
    private int _ctorRowCount = 1000;
    private string? _ctorError;

    private class CtorColumn
    {
        public string Name { get; set; } = "";
        public string Type { get; set; } = "VARCHAR";
        public bool Nullable { get; set; } = true;
        public bool PrimaryKey { get; set; }
    }

    private List<CtorColumn> _ctorColumns = new();

    private static readonly string[] _sqlTypes = new[]
    {
        "INTEGER", "BIGINT", "SMALLINT", "TINYINT", "HUGEINT",
        "DECIMAL(10,2)", "DECIMAL(18,4)", "FLOAT", "DOUBLE",
        "VARCHAR", "TEXT", "CHAR(10)",
        "BOOLEAN",
        "DATE", "TIMESTAMP", "TIME",
        "UUID",
    };

    private void OpenConstructor()
    {
        _ctorTableName = "my_table";
        _ctorRowCount  = 1000;
        _ctorError     = null;
        _ctorColumns   = new List<CtorColumn>
        {
            new() { Name = "id",   Type = "INTEGER", Nullable = false, PrimaryKey = true },
            new() { Name = "name", Type = "VARCHAR",  Nullable = true },
        };
        _showConstructor = true;
        StateHasChanged();
    }

    private void AddCtorColumn()
    {
        _ctorColumns.Add(new CtorColumn { Name = $"col{_ctorColumns.Count + 1}", Type = "VARCHAR", Nullable = true });
        StateHasChanged();
    }

    private void RemoveCtorColumn(int idx)
    {
        if (_ctorColumns.Count > 1) _ctorColumns.RemoveAt(idx);
        StateHasChanged();
    }

    private async Task BuildTableAsync()
    {
        _ctorError = null;
        var name = _ctorTableName.Trim();
        if (string.IsNullOrEmpty(name)) { _ctorError = "Укажите имя таблицы"; return; }
        if (_ctorColumns.Any(c => string.IsNullOrWhiteSpace(c.Name))) { _ctorError = "Все колонки должны иметь имя"; return; }

        _ctorBuilding = true;
        StateHasChanged();
        try
        {
            // Build column definitions
            var colDefs = _ctorColumns.Select(c =>
            {
                var def = $"\"{c.Name}\" {c.Type}";
                if (!c.Nullable) def += " NOT NULL";
                if (c.PrimaryKey) def += " PRIMARY KEY";
                return def;
            });

            var createSql = $"DROP TABLE IF EXISTS \"{name}\";\nCREATE TABLE \"{name}\" ({string.Join(", ", colDefs)});";

            var execRes = await _module!.InvokeAsync<JsonElement>("execute", createSql);
            if (!execRes.GetProperty("ok").GetBoolean())
            {
                _ctorError = execRes.TryGetProperty("error", out var e) ? e.GetString() : "Ошибка создания";
                return;
            }

            // Generate data if requested
            if (_ctorRowCount > 0)
            {
                var colSpecs = _ctorColumns.Select(c => new { name = c.Name, type = c.Type }).ToList();
                var specsJson = System.Text.Json.JsonSerializer.Serialize(colSpecs);
                var seedRes = await _module.InvokeAsync<JsonElement>("seedCustomTable", name, specsJson, _ctorRowCount);
                if (!seedRes.GetProperty("ok").GetBoolean())
                {
                    _ctorError = seedRes.TryGetProperty("error", out var e) ? e.GetString() : "Ошибка генерации";
                    return;
                }
            }

            _showConstructor = false;
            _sql = $"SELECT * FROM \"{name}\" LIMIT 50;";
            await RefreshSchemaAsync();
            await RunQueryAsync();
        }
        finally
        {
            _ctorBuilding = false;
            StateHasChanged();
        }
    }

    private async Task ToggleOpfsAsync()
    {
        if (_module is null) return;
        var want = !_opfsActive;
        _status = "loading";
        _statusText = want ? "Подключение OPFS..." : "Переключение...";
        StateHasChanged();

        var result = await _module.InvokeAsync<JsonElement>("init", want);
        _opfsActive = result.TryGetProperty("opfs", out var op) && op.GetBoolean();
        _status = "ready";
        _statusText = _opfsActive ? "DuckDB + OPFS" : "DuckDB готов";

        // Save preference
        try { await JS.InvokeVoidAsync("eval", $"localStorage.setItem('ddb-opfs','{(_opfsActive ? 1 : 0)}')"); } catch {}

        _columns.Clear(); _rows.Clear(); _hasRun = false;
        await RefreshSchemaAsync();
    }

    private async Task ClearOpfsAsync()
    {
        if (_module is null) return;
        await _module.InvokeAsync<JsonElement>("clearOpfs");
        _ioMessage = "OPFS очищен. Перезагрузите страницу.";
        _ioError = false;
        StateHasChanged();
    }

    // ── Export ────────────────────────────────────────────────────────────────

    private async Task ExportAsync()
    {
        if (_module is null) return;
        _exporting = true;
        _ioMessage = null;
        StateHasChanged();
        try
        {
            var res = await _module.InvokeAsync<JsonElement>("exportDatabase");
            if (res.GetProperty("ok").GetBoolean())
            {
                var cnt = res.TryGetProperty("tableCount", out var tc) ? tc.GetInt32() : 0;
                _ioMessage = $"Экспортировано {cnt} {TableWord(cnt)}";
                _ioError = false;
            }
            else
            {
                _ioMessage = res.TryGetProperty("error", out var e) ? e.GetString() : "Ошибка экспорта";
                _ioError = true;
            }
        }
        finally { _exporting = false; StateHasChanged(); }
    }

    // ── Import ────────────────────────────────────────────────────────────────

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        if (_module is null) return;
        _importing = true;
        _ioMessage = null;
        StateHasChanged();
        try
        {
            var file = e.File;
            using var stream = file.OpenReadStream(maxAllowedSize: 512 * 1024 * 1024); // 512 MB
            using var reader = new System.IO.StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            var res = await _module.InvokeAsync<JsonElement>("importDatabase", json);
            if (res.GetProperty("ok").GetBoolean())
            {
                var cnt = res.TryGetProperty("tableCount", out var tc) ? tc.GetInt32() : 0;
                _ioMessage = $"Импортировано {cnt} {TableWord(cnt)}";
                _ioError = false;
                await RefreshSchemaAsync();
            }
            else
            {
                _ioMessage = res.TryGetProperty("error", out var err) ? err.GetString() : "Ошибка импорта";
                _ioError = true;
            }
        }
        catch (Exception ex)
        {
            _ioMessage = ex.Message;
            _ioError = true;
        }
        finally { _importing = false; StateHasChanged(); }
    }

    private static string TableWord(int n)
    {
        var n1 = n % 10;
        if (n % 100 is > 10 and < 20) return "таблиц";
        if (n1 == 1) return "таблицу";
        if (n1 is >= 2 and <= 4) return "таблицы";
        return "таблиц";
    }

    // ── Drop all ──────────────────────────────────────────────────────────────

    private async Task DropAllAsync()
    {
        if (_module is null) return;
        await _module.InvokeAsync<JsonElement>("execute", "DROP TABLE IF EXISTS employees; DROP TABLE IF EXISTS products; DROP TABLE IF EXISTS orders;");
        _columns.Clear();
        _rows.Clear();
        _hasRun = false;
        _structureTable = null;
        await RefreshSchemaAsync();
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private async Task SelectTableAsync(string table)
    {
        _selectedTable = table;
        _sql = $"SELECT * FROM {table} LIMIT 50;";
        await RunQueryAsync();
    }

    private void ApplyQuickQuery(string sql)
    {
        _sql = sql;
        StateHasChanged();
        _ = RunQueryAsync();
    }

    private void ClearEditor()
    {
        _sql = "";
        _columns.Clear();
        _rows.Clear();
        _queryError = null;
        _hasRun = false;
        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key == "Enter")
            await RunQueryAsync();
    }

    private static string RowWord(int n)
    {
        var abs = Math.Abs(n) % 100;
        var n1 = abs % 10;
        if (abs > 10 && abs < 20) return "строк";
        if (n1 == 1) return "строка";
        if (n1 >= 2 && n1 <= 4) return "строки";
        return "строк";
    }

    // ── Value parsing helpers ─────────────────────────────────────────────────

    private static object? ParseNumber(JsonElement el)
    {
        // Prefer integer if it fits, otherwise double
        if (el.TryGetInt64(out var l)) return l;
        if (el.TryGetDouble(out var d)) return d;
        return el.GetRawText();
    }

    private static object? ParseString(string? s, string arrowType)
    {
        if (s is null) return null;

        // Decimal → parse as decimal for proper numeric sorting/display
        if (arrowType.StartsWith("Decimal", StringComparison.OrdinalIgnoreCase))
        {
            if (decimal.TryParse(s, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var dec))
                return dec;
        }

        // Date "YYYY-MM-DD" → DateTime
        if (arrowType.StartsWith("Date", StringComparison.OrdinalIgnoreCase))
        {
            if (DateTime.TryParseExact(s, "yyyy-MM-dd",
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var dt))
                return dt;
        }

        // Timestamp "YYYY-MM-DD HH:mm:ss" → DateTime
        if (arrowType.StartsWith("Timestamp", StringComparison.OrdinalIgnoreCase))
        {
            if (DateTime.TryParseExact(s, "yyyy-MM-dd HH:mm:ss",
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var ts))
                return ts;
        }

        return s;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
            await _module.DisposeAsync();
    }
