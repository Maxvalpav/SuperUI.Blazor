    private static string RowWord(int n)
    {
        var abs = Math.Abs(n) % 100;
        var n1 = abs % 10;
        if (abs > 10 && abs < 20) return "строк";
        if (n1 == 1) return "строка";
        if (n1 >= 2 && n1 <= 4) return "строки";
        return "строк";
    }

    // ── Value parsing helpers ─────────────────────────────────────────────────

    private static object? ParseNumber(JsonElement el)
    {
        // Prefer integer if it fits, otherwise double
        if (el.TryGetInt64(out var l)) return l;
        if (el.TryGetDouble(out var d)) return d;
        return el.GetRawText();
    }

    private static object? ParseString(string? s, string arrowType)
    {
        if (s is null) return null;

        // Decimal → parse as decimal for proper numeric sorting/display
        if (arrowType.StartsWith("Decimal", StringComparison.OrdinalIgnoreCase))
        {
            if (decimal.TryParse(s, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var dec))
                return dec;
        }

        // Date "YYYY-MM-DD" → DateTime
        if (arrowType.StartsWith("Date", StringComparison.OrdinalIgnoreCase))
        {
            if (DateTime.TryParseExact(s, "yyyy-MM-dd",
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var dt))
                return dt;
        }

        // Timestamp "YYYY-MM-DD HH:mm:ss" → DateTime
        if (arrowType.StartsWith("Timestamp", StringComparison.OrdinalIgnoreCase))
        {
            if (DateTime.TryParseExact(s, "yyyy-MM-dd HH:mm:ss",
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var ts))
                return ts;
        }

        return s;
    }

    // ── Index builder ─────────────────────────────────────────────────────────

    private void OpenIndexBuilder(string table)
    {
        _idxTable   = table;
        _idxName    = $"idx_{table}_{DateTime.Now:mmss}";
        _idxUnique  = false;
        _idxColumns.Clear();
        _idxScript  = "";
        _idxError   = null;
        _idxSuccess = null;
        _showIndexBuilder = true;
        StateHasChanged();
    }

    private void ToggleIdxColumn(string col)
    {
        if (!_idxColumns.Remove(col)) _idxColumns.Add(col);
        GenerateIndexScript();
    }

    private void GenerateIndexScript()
    {
        if (string.IsNullOrWhiteSpace(_idxName) || _idxColumns.Count == 0)
        {
            _idxScript = "";
            StateHasChanged();
            return;
        }
        var u    = _idxUnique ? "UNIQUE " : "";
        var cols = string.Join(", ", _idxColumns.Select(c => $"\"{c}\""));
        _idxScript = $"CREATE {u}INDEX \"{_idxName}\"\n    ON \"{_idxTable}\" ({cols});";
        StateHasChanged();
    }

    private async Task CreateIndexAsync()
    {
        if (_module is null) return;
        _idxError   = null;
        _idxSuccess = null;
        _idxBuilding = true;
        StateHasChanged();
        try
        {
            var cols = _idxColumns.ToArray();
            var res  = await _module.InvokeAsync<JsonElement>("createIndex", _idxTable, _idxName, cols, _idxUnique);
            if (res.GetProperty("ok").GetBoolean())
            {
                _idxSuccess = $"Индекс «{_idxName}» создан";
                _showIndexBuilder = false;
                // Refresh structure to show new index
                await ShowStructureAsync(_idxTable);
            }
            else
            {
                _idxError = res.TryGetProperty("error", out var e) ? e.GetString() : "Ошибка создания индекса";
            }
        }
        finally
        {
            _idxBuilding = false;
            StateHasChanged();
        }
    }

    private async Task DropIndexAsync(string indexName)
    {
        if (_module is null || _structureTable is null) return;
        try
        {
            await _module.InvokeAsync<JsonElement>("dropIndex", indexName);
            await ShowStructureAsync(_structureTable);
        }
        catch { /* ignore */ }
    }

    // ── Load JSON file (flat columns) ─────────────────────────────────────────

    private async Task LoadJsonFileAsync(InputFileChangeEventArgs e)
    {
        if (_module is null) return;
        _loadingJson = true;
        _loadMessage = null;
        StateHasChanged();
        try
        {
            var file = e.File;
            // Derive table name from filename (strip extension, sanitize)
            var tableName = System.IO.Path.GetFileNameWithoutExtension(file.Name)
                .Replace(" ", "_").Replace("-", "_")
                .ToLowerInvariant();
            if (string.IsNullOrEmpty(tableName)) tableName = "json_data";

            using var stream = file.OpenReadStream(maxAllowedSize: 256 * 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            var res = await _module.InvokeAsync<JsonElement>("loadJsonFile", json, tableName);
            if (res.GetProperty("ok").GetBoolean())
            {
                var rows = res.TryGetProperty("rowCount", out var rc) ? rc.GetInt32() : 0;
                var cols = res.TryGetProperty("columns", out var cc) ? cc.GetInt32() : 0;
                _loadMessage = $"Загружено {rows:N0} строк, {cols} колонок → таблица «{tableName}»";
                _loadError = false;
                _sql = $"SELECT * FROM \"{tableName}\" LIMIT 50;";
                await RefreshSchemaAsync();
                await RunQueryAsync();
            }
            else
            {
                _loadMessage = res.TryGetProperty("error", out var err) ? err.GetString() : "Ошибка загрузки JSON";
                _loadError = true;
            }
        }
        catch (Exception ex)
        {
            _loadMessage = ex.Message;
            _loadError = true;
        }
        finally { _loadingJson = false; StateHasChanged(); }
    }

