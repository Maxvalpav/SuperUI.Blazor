        if (!res.GetProperty("ok").GetBoolean())
            _queryError = res.TryGetProperty("error", out var e) ? e.GetString() : "Seed failed";
        else
        {
            _sql = which == "shop"
                ? "SELECT * FROM products LIMIT 50;"
                : "SELECT * FROM employees LIMIT 50;";
            await RunQueryAsync();
        }
    }

    private async Task SeedAllAsync()
    {
        if (_module is null) return;
        var count = Math.Max(1, _genCount);
