@page "/duckdb-demo"
@using SuperUI.Components
@using System.Text.Json
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>DuckDB-Wasm SQL — SUI</PageTitle>

<div class="ddb-page">

    @* ── Header ──────────────────────────────────────────────────────────── *@
    <div class="ddb-header">
        <div class="ddb-header-left">
            <svg viewBox="0 0 40 40" width="28" height="28" fill="none" style="flex-shrink:0">
                <circle cx="20" cy="20" r="19" fill="#FFF200" stroke="#d4bc00" stroke-width="1.5"/>
                <ellipse cx="20" cy="14" rx="10" ry="4" fill="#1a1a1a"/>
                <path d="M10 14 Q10 26 20 26 Q30 26 30 14" fill="#1a1a1a"/>
                <ellipse cx="20" cy="14" rx="10" ry="4" fill="#333"/>
                <ellipse cx="20" cy="14" rx="6" ry="2.2" fill="#FFF200"/>
            </svg>
            <div>
                <h1 class="ddb-title">DuckDB-Wasm SQL Console</h1>
                <p class="ddb-subtitle">Аналитический SQL браузере </p>
            </div>
        </div>
        <div class="ddb-status-wrap">
            <div class="ddb-status ddb-status--@_status">
                <span class="ddb-status-dot"></span>
                <span>@_statusText</span>
            </div>
            @if (_opfsSupported)
            {
                <button class="ddb-persist-btn @(_opfsActive ? "ddb-persist-btn--on" : "")"
                        title="@(_opfsActive ? "OPFS активен — данные сохраняются между сессиями. Нажмите для отключения." : "Включить сохранение данных между сессиями (OPFS)")"
                        disabled="@(_status == "loading")"
                        @onclick="ToggleOpfsAsync">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                    <span>@(_opfsActive ? "OPFS вкл" : "OPFS выкл")</span>
                </button>
            }
        </div>
    </div>

    @if (_initError is not null)
    {
        <div class="ddb-init-error">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <div>
                <strong>Ошибка инициализации DuckDB</strong>
                <div class="ddb-init-error-msg">@_initError</div>
            </div>
        </div>
    }

    <div class="ddb-body">

        @* ── Sidebar ──────────────────────────────────────────────────────── *@
        <div class="ddb-sidebar">

            @* ── Generators ───────────────────────────────────────────────── *@
            <div class="ddb-sidebar-section">
                <div class="ddb-sidebar-label">Генераторы данных</div>
                <div class="ddb-gen-count-row">
                    <label class="ddb-gen-count-label">Записей:</label>
                    <input class="ddb-gen-count-input"
                           type="number"
                           min="1" max="1000000"
                           @bind="_genCount"
                           @bind:event="oninput"
                           disabled="@(_status != "ready" || _seeding != null)" />
                    <div class="ddb-gen-presets">
                        @foreach (var p in new[] { 100, 1000, 10000 })
                        {
                            var pv = p;
                            <button class="ddb-gen-preset @(_genCount == pv ? "ddb-gen-preset--active" : "")"
                                    disabled="@(_status != "ready" || _seeding != null)"
                                    @onclick="() => _genCount = pv">
                                @(pv >= 1000 ? $"{pv/1000}K" : pv.ToString())
                            </button>
                        }
                    </div>
                </div>
                <div class="ddb-gen-list">
                    @foreach (var gen in _generators)
                    {
                        var g = gen;
                        <button class="ddb-gen-btn" disabled="@(_status != "ready" || _seeding != null || (g.Key == "drop" ? false : _genCount < 1))"
                                @onclick="() => SeedAsync(g)">
                            @if (_seeding == g.Key)
                            {
                                <span class="ddb-spinner"></span>
                            }
                            else
                            {
                                <span class="ddb-gen-icon">@g.Icon</span>
                            }
                            <div class="ddb-gen-info">
                                <span class="ddb-gen-name">@g.Name</span>
                                <span class="ddb-gen-desc">@(g.Key == "drop" ? g.Desc : $"{_genCount:N0} записей")</span>
                            </div>
                        </button>
                    }
                </div>
            </div>

            @* ── Export / Import ──────────────────────────────────────────── *@
            <div class="ddb-sidebar-section">
                <div class="ddb-sidebar-label">База данных</div>

                @* ── Имя файла БД ─────────────────────────────────────────── *@
                <div class="ddb-db-name-row">
                    <input class="ddb-ctor-input" style="flex:1;min-width:0;font-size:11px"
                           @bind="_dbFilename"
                           placeholder="my_database.db"
                           spellcheck="false" />
                </div>

                @* ── Сохранить на диск ────────────────────────────────────── *@
                <button class="ddb-db-action-btn @(_savingToDisk ? "ddb-db-action-btn--busy" : "")"
                        title="ATTACH → COPY FROM DATABASE memory → DETACH → скачать файл"
                        disabled="@(_status != "ready" || _tables.Count == 0 || _savingToDisk)"
                        @onclick="SaveToDiskAsync">
                    @if (_savingToDisk)
                    {
                        <span class="ddb-spinner"></span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                            <polyline points="17 21 17 13 7 13 7 21"/>
                            <polyline points="7 3 7 8 15 8"/>
                        </svg>
                    }
                    <div class="ddb-db-action-info">
                        <span class="ddb-db-action-name">Сохранить на диск</span>
                        <span class="ddb-db-action-hint">ATTACH → COPY → DETACH</span>
                    </div>
                </button>

                @* ── Показать SQL скрипт ──────────────────────────────────── *@
                <button class="ddb-db-action-btn"
                        title="Показать SQL скрипт сохранения"
                        @onclick="() => _showSaveScript = !_showSaveScript">
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
                    </svg>
                    <div class="ddb-db-action-info">
                        <span class="ddb-db-action-name">SQL скрипт сохранения</span>
                        <span class="ddb-db-action-hint">вставить в редактор</span>
                    </div>
                </button>
                @if (_showSaveScript)
                {
                    <div class="ddb-save-script-wrap">
                        <pre class="ddb-idx-script" style="font-size:10px;margin:0">@GetSaveScript()</pre>
                        <button class="ddb-toolbar-btn" style="font-size:10px;margin-top:4px;width:100%"
                                @onclick="InsertSaveScript">
                            Вставить в редактор
                        </button>
                    </div>
                }

                @* ── Загрузить .duckdb с диска ────────────────────────────── *@
                <label class="ddb-db-action-btn ddb-db-action-btn--import"
                       title="Загрузить .duckdb файл и скопировать таблицы в память">
                    @if (_loadingDuckDb)
                    {
                        <span class="ddb-spinner"></span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 5 17 10"/>
                            <line x1="12" y1="5" x2="12" y2="17"/>
                        </svg>
                    }
                    <div class="ddb-db-action-info">
                        <span class="ddb-db-action-name">Загрузить .duckdb</span>
                        <span class="ddb-db-action-hint">ATTACH → COPY → DETACH</span>
                    </div>
                    <InputFile OnChange="LoadDuckDbFileAsync" accept=".db,.duckdb" style="display:none"
                               disabled="@(_status != "ready" || _loadingDuckDb)" />
                </label>

                @* ── JSON экспорт/импорт ──────────────────────────────────── *@
                <div class="ddb-io-row" style="margin-top:6px">
                    <button class="ddb-io-btn" title="Скачать базу как JSON-снимок"
                            disabled="@(_status != "ready" || _tables.Count == 0 || _exporting)"
                            @onclick="ExportAsync">
                        @if (_exporting) { <span class="ddb-spinner"></span> }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                <polyline points="7 10 12 15 17 10"/>
                                <line x1="12" y1="15" x2="12" y2="3"/>
                            </svg>
                        }
                        <span>Экспорт .json</span>
                    </button>
                    <label class="ddb-io-btn ddb-io-btn--import" title="Загрузить JSON-снимок базы">
                        @if (_importing) { <span class="ddb-spinner"></span> }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                <polyline points="7 10 12 5 17 10"/>
                                <line x1="12" y1="5" x2="12" y2="17"/>
                            </svg>
                        }
                        <span>Импорт .json</span>
                        <InputFile OnChange="ImportAsync" accept=".json" style="display:none" disabled="@(_status != "ready" || _importing)" />
                    </label>
                </div>

                @if (_ioMessage is not null)
                {
                    <div class="ddb-io-msg @(_ioError ? "ddb-io-msg--error" : "ddb-io-msg--ok")">@_ioMessage</div>
                }
                @if (_opfsActive)
                {
                    <button class="ddb-io-clear-btn" @onclick="ClearOpfsAsync"
                            title="Удалить сохранённую базу из OPFS">
                        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                            <path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                        </svg>
                        Очистить OPFS
                    </button>
                }
            </div>

            @* ── Load JSON / Parquet ───────────────────────────────────────── *@
            <div class="ddb-sidebar-section">
                <div class="ddb-sidebar-label">Загрузить файл</div>
                <div class="ddb-io-row">
                    <label class="ddb-io-btn ddb-io-btn--import" title="Загрузить JSON-массив как новую таблицу (колонки из ключей объектов)">
                        @if (_loadingJson)
                        {
                            <span class="ddb-spinner"></span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                                <line x1="12" y1="18" x2="12" y2="12"/>
                                <line x1="9" y1="15" x2="15" y2="15"/>
                            </svg>
                        }
                        <span>JSON → колонки</span>
                        <InputFile OnChange="LoadJsonFileAsync" accept=".json" style="display:none" disabled="@(_status != "ready" || _loadingJson)" />
                    </label>
                    <label class="ddb-io-btn ddb-io-btn--import" title="Загрузить JSON-файл в таблицу с одной колонкой типа JSON (id + data)">
                        @if (_loadingJsonCol)
                        {
                            <span class="ddb-spinner"></span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                                <polyline points="8 12 4 16 8 20"/><polyline points="16 12 20 16 16 20"/>
                            </svg>
                        }
                        <span>JSON → json-колонка</span>
                        <InputFile OnChange="LoadJsonAsColumnAsync" accept=".json" style="display:none" disabled="@(_status != "ready" || _loadingJsonCol)" />
                    </label>
                    <label class="ddb-io-btn ddb-io-btn--import" title="Загрузить Parquet-файл как новую таблицу">
                        @if (_loadingParquet)
                        {
                            <span class="ddb-spinner"></span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                                <polyline points="8 13 12 17 16 13"/>
                                <line x1="12" y1="17" x2="12" y2="11"/>
                            </svg>
                        }
                        <span>Parquet → таблица</span>
                        <InputFile OnChange="LoadParquetFileAsync" accept=".parquet" style="display:none" disabled="@(_status != "ready" || _loadingParquet)" />
                    </label>
                </div>

                @* ── Parquet from URL ──────────────────────────────────────── *@
                <button class="ddb-snippet-cat-btn" style="margin-top:6px;border-radius:var(--sui-radius-sm)"
                        @onclick="() => _showParquetUrl = !_showParquetUrl">
                    <svg class="ddb-tree-arrow @(_showParquetUrl ? "ddb-tree-arrow--open" : "")"
                         viewBox="0 0 24 24" width="9" height="9" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                    <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                    </svg>
                    Parquet по URL / S3
                </button>

                @if (_showParquetUrl)
                {
                    <div class="ddb-parquet-url-panel">
                        <div class="ddb-parquet-url-row">
                            <label class="ddb-ctor-label">URL</label>
                            <input class="ddb-ctor-input" style="flex:1;min-width:0;font-size:10px"
                                   @bind="_parquetUrl"
                                   placeholder="https://... или s3://..."
                                   spellcheck="false" />
                        </div>
                        <div class="ddb-parquet-url-row">
                            <label class="ddb-ctor-label">Таблица</label>
                            <input class="ddb-ctor-input" style="flex:1;min-width:0"
                                   @bind="_parquetUrlTable"
                                   placeholder="parquet_data"
                                   spellcheck="false" />
                        </div>
                        <div class="ddb-parquet-url-row" style="gap:4px;justify-content:flex-end">
                            @if (!string.IsNullOrEmpty(_parquetUrlError))
                            {
                                <span style="font-size:10px;color:var(--sui-danger);flex:1">@_parquetUrlError</span>
                            }
                            <button class="ddb-run-btn" style="font-size:11px;padding:3px 10px"
                                    disabled="@(_status != "ready" || _loadingParquetUrl || string.IsNullOrWhiteSpace(_parquetUrl))"
                                    @onclick="LoadParquetFromUrlAsync">
                                @if (_loadingParquetUrl)
                                {
                                    <span class="ddb-spinner ddb-spinner--white"></span>
                                    <span>Загрузка...</span>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                    <span>Загрузить</span>
                                }
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(_parquetUrlSuccess))
                        {
                            <div class="ddb-io-msg ddb-io-msg--ok">@_parquetUrlSuccess</div>
                        }
                        <div style="font-size:10px;color:var(--sui-text-muted);padding:4px 0 2px;line-height:1.4">
                            Поддерживаются публичные HTTP/HTTPS URL и S3 presigned URL. CORS должен быть разрешён на сервере.
                        </div>
                    </div>
                }

                @if (_loadMessage is not null)
                {
                    <div class="ddb-io-msg @(_loadError ? "ddb-io-msg--error" : "ddb-io-msg--ok")">@_loadMessage</div>
                }
            </div>

            @* ── Схема: выбор БД + таблицы ────────────────────────────────── *@
            <div class="ddb-sidebar-section ddb-sidebar-section--grow">
                <div class="ddb-sidebar-label-row">
                    <span class="ddb-sidebar-label">Схема</span>
                    <div style="display:flex;gap:4px;align-items:center">
                        <button class="ddb-icon-btn" title="Создать таблицу"
                                disabled="@(_status != "ready")"
                                @onclick="OpenConstructor">
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/>
                            </svg>
                        </button>
                        <button class="ddb-icon-btn" title="Обновить" @onclick="RefreshSchemaAsync">
                            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
                                <path d="M21 3v5h-5"/>
                                <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
                                <path d="M8 16H3v5"/>
                            </svg>
                        </button>
                    </div>
                </div>

                @* ── Выбор активной базы данных ───────────────────────────── *@
                @if (_databases.Count > 1)
                {
                    <div class="ddb-db-select-row">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;color:var(--sui-accent)">
                            <ellipse cx="12" cy="5" rx="9" ry="3"/>
                            <path d="M3 5V19A9 3 0 0 0 21 19V5"/>
                            <path d="M3 12A9 3 0 0 0 21 12"/>
                        </svg>
                        <select class="ddb-db-select"
                                value="@_activeDatabase"
                                @onchange="async e => await SwitchDatabaseAsync(e.Value?.ToString() ?? string.Empty)">
                            @foreach (var db in _databases)
                            {
                                <option value="@db" selected="@(db == _activeDatabase)">@db</option>
                            }
                        </select>
                    </div>
                }

                @if (_databases.Count == 0 && _status == "ready")
                {
                    <div class="ddb-sidebar-empty">Нет баз данных.<br/>Используйте генераторы.</div>
                }

                @foreach (var db in _databases)
                {
                    var dbName = db;
                    var dbOpen = _openDbs.Contains(dbName);
                    var isActiveDb = dbName == _activeDatabase;
                    <div class="ddb-db-node">
                        <button class="ddb-db-header @(isActiveDb ? "ddb-db-header--active" : "")"
                                @onclick="() => ToggleDb(dbName)">
                            <svg class="ddb-tree-arrow @(dbOpen ? "ddb-tree-arrow--open" : "")"
                                 viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="9 18 15 12 9 6"/>
                            </svg>
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--sui-accent)">
                                <ellipse cx="12" cy="5" rx="9" ry="3"/>
                                <path d="M3 5V19A9 3 0 0 0 21 19V5"/>
                                <path d="M3 12A9 3 0 0 0 21 12"/>
                            </svg>
                            <span class="ddb-db-name">@dbName</span>
                            @if (isActiveDb)
                            {
                                <span class="ddb-db-active-badge">active</span>
                            }
                        </button>
                        @if (dbOpen)
                        {
                            @foreach (var tbl in _tables)
                            {
                                var t = tbl;
                                var isActive = _selectedTable == t;
                                <button class="ddb-table-row @(isActive ? "ddb-table-row--active" : "")"
                                        @onclick="() => SelectTableAsync(t)">
                                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect width="18" height="18" x="3" y="3" rx="1"/>
                                        <path d="M3 9h18M3 15h18M9 3v18"/>
                                    </svg>
                                    <span class="ddb-table-name">@t</span>
                                    <button class="ddb-table-desc-btn" title="Структура таблицы"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => ShowStructureAsync(t)">
                                        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
                                        </svg>
                                    </button>
                                </button>
                            }
                        }
                    </div>
                }
            </div>

        </div>@* end ddb-sidebar left *@

        @* ── Main area ────────────────────────────────────────────────────── *@
        <div class="ddb-main">
            @if (_showConstructor)
            {
                <div class="ddb-ctor-panel">
                    <div class="ddb-ctor-head">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/>
                        </svg>
                        <span>Конструктор таблицы</span>
                        <button class="ddb-icon-btn" style="margin-left:auto" @onclick="() => _showConstructor = false">
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                            </svg>
                        </button>
                    </div>

                    <div class="ddb-ctor-body">
                        @* Table name *@
                        <div class="ddb-ctor-row">
                            <label class="ddb-ctor-label">Имя таблицы</label>
                            <input class="ddb-ctor-input ddb-ctor-input--name"
                                   @bind="_ctorTableName"
                                   placeholder="my_table"
                                   spellcheck="false" />
                        </div>

                        @* Columns *@
                        <div class="ddb-ctor-cols-head">
                            <span class="ddb-ctor-label">Колонки</span>
                            <button class="ddb-ctor-add-col" @onclick="AddCtorColumn">
                                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                                </svg>
                                Добавить колонку
                            </button>
                        </div>

                        <div class="ddb-ctor-cols">
                            @* Header *@
                            <div class="ddb-ctor-col-hdr">
                                <span style="flex:2">Имя</span>
                                <span style="flex:2">Тип</span>
                                <span style="flex:1;text-align:center">NULL</span>
                                <span style="flex:1;text-align:center">PK</span>
                                <span style="width:28px"></span>
                            </div>
                            @for (int ci = 0; ci < _ctorColumns.Count; ci++)
                            {
                                var idx = ci;
                                var col = _ctorColumns[idx];
                                <div class="ddb-ctor-col-row">
                                    <input class="ddb-ctor-input" style="flex:2"
                                           value="@col.Name"
                                           @oninput="e => col.Name = e.Value?.ToString() ?? col.Name"
                                           placeholder="column_name"
                                           spellcheck="false" />
                                    <select class="ddb-ctor-select" style="flex:2"
                                            value="@col.Type"
                                            @onchange="e => col.Type = e.Value?.ToString() ?? col.Type">
                                        @foreach (var t in _sqlTypes)
                                        {
                                            <option value="@t" selected="@(col.Type == t)">@t</option>
                                        }
                                    </select>
                                    <div style="flex:1;display:flex;justify-content:center;align-items:center">
                                        <input type="checkbox" checked="@col.Nullable"
                                               @onchange="e => col.Nullable = (bool)(e.Value ?? false)" />
                                    </div>
                                    <div style="flex:1;display:flex;justify-content:center;align-items:center">
                                        <input type="checkbox" checked="@col.PrimaryKey"
                                               @onchange="e => col.PrimaryKey = (bool)(e.Value ?? false)" />
                                    </div>
                                    <button class="ddb-ctor-del-col" @onclick="() => RemoveCtorColumn(idx)"
                                            disabled="@(_ctorColumns.Count <= 1)">
                                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                                        </svg>
                                    </button>
                                </div>
                            }
                        </div>

                        @* Row count + actions *@
                        <div class="ddb-ctor-foot">
                            <div class="ddb-ctor-count-wrap">
                                <label class="ddb-ctor-label">Строк для генерации:</label>
                                <input class="ddb-ctor-input ddb-ctor-input--count"
                                       type="number" min="0" max="1000000"
                                       @bind="_ctorRowCount" />
                                <div class="ddb-gen-presets">
                                    @foreach (var p in new[] { 0, 100, 1000, 10000 })
                                    {
                                        var pv = p;
                                        <button class="ddb-gen-preset @(_ctorRowCount == pv ? "ddb-gen-preset--active" : "")"
                                                @onclick="() => _ctorRowCount = pv">
                                            @(pv == 0 ? "Пусто" : pv >= 1000 ? $"{pv/1000}K" : pv.ToString())
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="ddb-ctor-actions">
                                @if (!string.IsNullOrEmpty(_ctorError))
                                {
                                    <span class="ddb-ctor-error">@_ctorError</span>
                                }
                                <button class="ddb-toolbar-btn" @onclick="() => _showConstructor = false">Отмена</button>
                                <button class="ddb-run-btn" disabled="@(_ctorBuilding || _status != "ready")"
                                        @onclick="BuildTableAsync">
                                    @if (_ctorBuilding)
                                    {
                                        <span class="ddb-spinner ddb-spinner--white"></span>
                                        <span>Создание...</span>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"/>
                                        </svg>
                                        <span>Создать@(_ctorRowCount > 0 ? " и заполнить" : "")</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ── Structure panel ──────────────────────────────────────────── *@
            @if (_structureTable is not null)
            {
                <div class="ddb-structure-panel">
                    <div class="ddb-structure-head">
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="18" x="3" y="3" rx="1"/>
                            <path d="M3 9h18M3 15h18M9 3v18"/>
                        </svg>
                        <span>Структура: <strong>@_structureTable</strong></span>
                        <div style="display:flex;gap:4px;margin-left:auto;align-items:center">
                            <button class="ddb-toolbar-btn" style="font-size:11px;padding:2px 8px"
                                    title="Экспортировать таблицу в Parquet"
                                    @onclick="() => ExportTableToParquetAsync(_structureTable)">
                                <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:3px">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                    <polyline points="8 13 12 17 16 13"/>
                                    <line x1="12" y1="17" x2="12" y2="11"/>
                                </svg>
                                Parquet
                            </button>
                            <button class="ddb-toolbar-btn" style="font-size:11px;padding:2px 8px"
                                    title="Создать индекс для этой таблицы"
                                    @onclick="() => OpenIndexBuilder(_structureTable)">
                                <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:3px">
                                    <path d="M3 3h18M3 9h18M3 15h9M3 21h9M16 17l2 2 4-4"/>
                                </svg>
                                Индекс
                            </button>
                            <button class="ddb-icon-btn" @onclick="() => _structureTable = null">
                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="ddb-structure-cols">
                        @foreach (var col in _structureCols)
                        {
                            <div class="ddb-structure-col">
                                <span class="ddb-col-name">@col.Name</span>
                                <span class="ddb-col-type">@col.Type</span>
                                @if (col.Nullable == "YES")
                                {
                                    <span class="ddb-col-null">NULL</span>
                                }
                            </div>
                        }
                    </div>
                    @* ── Existing indexes ──────────────────────────────────── *@
                    @if (_structureIndexes.Count > 0)
                    {
                        <div class="ddb-structure-head" style="border-top:1px solid var(--sui-border);margin-top:4px;padding-top:6px">
                            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 3h18M3 9h18M3 15h9M3 21h9M16 17l2 2 4-4"/>
                            </svg>
                            <span style="font-size:11px;font-weight:600">Индексы</span>
                        </div>
                        @foreach (var idx in _structureIndexes)
                        {
                            <div class="ddb-structure-col" style="justify-content:space-between">
                                <span class="ddb-col-name">@idx.Name</span>
                                @if (idx.Unique)
                                {
                                    <span class="ddb-col-type" style="color:var(--sui-accent)">UNIQUE</span>
                                }
                                <button class="ddb-icon-btn" style="margin-left:auto" title="Удалить индекс"
                                        @onclick="() => DropIndexAsync(idx.Name)">
                                    <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                    </svg>
                                </button>
                            </div>
                        }
                    }
                </div>
            }

            @* ── Index builder ────────────────────────────────────────────── *@
            @if (_showIndexBuilder)
            {
                <div class="ddb-ctor-panel">
                    <div class="ddb-ctor-head">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 3h18M3 9h18M3 15h9M3 21h9M16 17l2 2 4-4"/>
                        </svg>
                        <span>Создать индекс: <strong>@_idxTable</strong></span>
                        <button class="ddb-icon-btn" style="margin-left:auto" @onclick="() => _showIndexBuilder = false">
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                            </svg>
                        </button>
                    </div>
                    <div class="ddb-ctor-body">
                        <div class="ddb-ctor-row">
                            <label class="ddb-ctor-label">Имя индекса</label>
                            <input class="ddb-ctor-input ddb-ctor-input--name"
                                   @bind="_idxName"
                                   placeholder="idx_table_col"
                                   spellcheck="false" />
                        </div>
                        <div class="ddb-ctor-row" style="align-items:center;gap:8px">
                            <label class="ddb-ctor-label">Уникальный</label>
                            <input type="checkbox" @bind="_idxUnique" />
                        </div>
                        <div class="ddb-ctor-cols-head">
                            <span class="ddb-ctor-label">Колонки (выберите одну или несколько)</span>
                        </div>
                        <div class="ddb-ctor-cols" style="max-height:160px;overflow-y:auto">
                            @foreach (var col in _structureCols)
                            {
                                var c = col;
                                var checked_ = _idxColumns.Contains(c.Name);
                                <div class="ddb-structure-col" style="cursor:pointer;gap:8px"
                                     @onclick="() => ToggleIdxColumn(c.Name)">
                                    <input type="checkbox" checked="@checked_" @onclick:stopPropagation="true"
                                           @onchange="() => ToggleIdxColumn(c.Name)" />
                                    <span class="ddb-col-name">@c.Name</span>
                                    <span class="ddb-col-type">@c.Type</span>
                                </div>
                            }
                        </div>

                        @* Generated script preview *@
                        @if (_idxColumns.Count > 0 && !string.IsNullOrWhiteSpace(_idxName))
                        {
                            <div class="ddb-ctor-row" style="flex-direction:column;gap:4px">
                                <label class="ddb-ctor-label">Скрипт</label>
                                <pre class="ddb-idx-script">@_idxScript</pre>
                            </div>
                        }

                        <div class="ddb-ctor-foot">
                            <div style="flex:1">
                                @if (!string.IsNullOrEmpty(_idxError))
                                {
                                    <span class="ddb-ctor-error">@_idxError</span>
                                }
                                @if (!string.IsNullOrEmpty(_idxSuccess))
                                {
                                    <span style="color:var(--sui-success,#22c55e);font-size:12px">@_idxSuccess</span>
                                }
                            </div>
                            <div class="ddb-ctor-actions">
                                <button class="ddb-toolbar-btn" @onclick="GenerateIndexScript">
                                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
                                    </svg>
                                    Генерировать скрипт
                                </button>
                                <button class="ddb-toolbar-btn" @onclick="() => _showIndexBuilder = false">Отмена</button>
                                <button class="ddb-run-btn" disabled="@(_idxBuilding || _status != "ready" || _idxColumns.Count == 0 || string.IsNullOrWhiteSpace(_idxName))"
                                        @onclick="CreateIndexAsync">
                                    @if (_idxBuilding)
                                    {
                                        <span class="ddb-spinner ddb-spinner--white"></span>
                                        <span>Создание...</span>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"/>
                                        </svg>
                                        <span>Создать индекс</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ── SQL editor ───────────────────────────────────────────────── *@
            <div class="ddb-editor-card">
                <div class="ddb-editor-toolbar">
                    <span class="ddb-editor-label">SQL</span>
                    <div class="ddb-editor-actions">
                        <button class="ddb-run-btn" disabled="@(_status != "ready" || _running)"
                                @onclick="RunQueryAsync">
                            @if (_running)
                            {
                                <span class="ddb-spinner ddb-spinner--white"></span>
                                <span>Выполняется...</span>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                <span>Выполнить</span>
                            }
                        </button>
                        <button class="ddb-toolbar-btn" title="Очистить редактор" @onclick="ClearEditor">
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                            </svg>
                        </button>
                        <div class="ddb-plan-check" style="margin-left:8px; display:flex; align-items:center; gap:6px; font-size:12px; color:var(--sui-fg-muted);">
                            <input type="checkbox" id="chkPlan" @bind="_showPlan" />
                            <label for="chkPlan" style="cursor:pointer">Показать план</label>
                        </div>
                    </div>
                </div>
                <textarea class="ddb-editor"
                          @bind="_sql"
                          @bind:event="oninput"
                          @onkeydown="HandleKeyDown"
                          placeholder="SELECT * FROM employees LIMIT 10;"
                          spellcheck="false"
                          rows="5"></textarea>
                <div class="ddb-editor-foot">Ctrl+Enter — выполнить</div>
            </div>

            @* ── Error ────────────────────────────────────────────────────── *@
            @if (_queryError is not null)
            {
                <div class="ddb-error-bar">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <span>@_queryError</span>
                </div>
            }

            @* ── Results ──────────────────────────────────────────────────── *@
            @if (_columns.Count > 0)
            {
                <div class="ddb-results-bar">
                    <span class="ddb-results-info">
                        Результат: <strong>@_rows.Count</strong> @RowWord(_rows.Count)
                    </span>
                    <span class="ddb-results-time">@_elapsed ms</span>
                </div>
                <div class="ddb-grid-wrap">
                    <SgDataGrid TItem="Dictionary<string, object?>"
                                Items="@_rows"
                                PageSize="50"
                                ShowSearch="true">
                        @foreach (var col in _columns)
                        {
                            var c = col;
                            <SgDataGridColumn TItem="Dictionary<string, object?>"
                                             Title="@c.Name"
                                             ColumnKey="@c.Name"
                                             Value="@(row => row.TryGetValue(c.Name, out var v) ? v : null)"
                                             Sortable="true" />
                        }
                    </SgDataGrid>
                </div>
            }

            @* ── Explain Plan ────────────────────────────────────────────── *@
            @if (_showPlan && !string.IsNullOrEmpty(_planText))
            {
                <div class="ddb-plan-card" style="margin-top:20px; border:1px solid var(--sui-border-color); border-radius:12px; overflow:hidden;">
                    <div class="ddb-plan-head" style="padding:10px 16px; background:var(--sui-bg-secondary); border-bottom:1px solid var(--sui-border-color); display:flex; justify-content:space-between; align-items:center;">
                        <div style="display:flex; align-items:center; gap:8px;">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                            </svg>
                            <span style="font-size:12px; font-weight:600">План выполнения (EXPLAIN ANALYZE)</span>
                        </div>
                        <div style="font-size:11px; color:var(--sui-fg-muted)">Heuristics: Columnar, Parquet, Bulk Insert</div>
                    </div>
                    <div class="ddb-plan-body" style="padding:16px; background:#0f0f0f; color:#4af626; font-family:'Fira Code','Cascadia Code','Consolas',monospace; font-size:12px; overflow-x:auto; white-space:pre; border-bottom: 1px solid #333; line-height: 1.4;">@_planText</div>
                    <div class="ddb-plan-foot" style="padding:12px 16px; background:var(--sui-bg-secondary); border-top:1px solid var(--sui-border-color);">
                        <div style="font-size:11px; font-weight:600; margin-bottom:8px; color:var(--sui-accent); display:flex; align-items:center; gap:6px;">
                            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                            Анализ производительности DuckDB:
                        </div>
                        <ul style="font-size:11px; color:var(--sui-fg-muted); padding-left:16px; margin:0; display:grid; grid-template-columns:1fr 1fr; gap:6px 24px;">
                            <li><strong style="color:var(--sui-fg)">Wasm Memory:</strong> Браузер ограничивает DuckDB до 4ГБ RAM. Следите за размером джойнов.</li>
                            <li><strong style="color:var(--sui-fg)">Threading:</strong> В Wasm по умолчанию используется 1 поток. Для мультипоточности нужны COOP/COEP заголовки.</li>
                            <li><strong style="color:var(--sui-fg)">Vectorized Execution:</strong> Данные обрабатываются пачками (2048 строк). Это минимизирует накладные расходы.</li>
                            <li><strong style="color:var(--sui-fg)">Columnar Scan:</strong> Используйте <code>SELECT a, b</code> вместо <code>*</code> для ускорения чтения.</li>
                            <li><strong style="color:var(--sui-fg)">Filter Pushdown:</strong> DuckDB фильтрует данные прямо при чтении из Parquet/CSV.</li>
                            <li><strong style="color:var(--sui-fg)">Join Order:</strong> Маленькие таблицы должны быть справа для построения Hash Table.</li>
                        </ul>
                    </div>
                </div>
            }
            
            else if (_hasRun && _queryError is null)
            {
                <div class="ddb-empty-result">
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/>
                    </svg>
                    <span>Запрос выполнен, результатов нет</span>
                </div>
            }
        </div>

        @* ── Right sidebar: Quick queries + Snippets ──────────────────────── *@
        <div class="ddb-sidebar ddb-sidebar--right">

            @* ── Quick queries ─────────────────────────────────────────────── *@
            @if (_tables.Count > 0)
            {
                <div class="ddb-sidebar-section">
                    <div class="ddb-sidebar-label">Примеры запросов</div>
                    @foreach (var q in _quickQueries)
                    {
                        var qq = q;
                        <button class="ddb-quick-btn" @onclick="() => ApplyQuickQuery(qq.Sql)">
                            @qq.Label
                        </button>
                    }
                </div>
            }

            @* ── SQL Snippets ──────────────────────────────────────────────── *@
            <div class="ddb-sidebar-section ddb-sidebar-section--grow">
                <div class="ddb-sidebar-label-row">
                    <span class="ddb-sidebar-label">SQL Сниппеты</span>
                </div>
                <div class="ddb-snippet-table-row">
                    <label class="ddb-ctor-label" style="white-space:nowrap;min-width:0">Таблица:</label>
                    <input class="ddb-ctor-input" style="flex:1;min-width:0"
                           @bind="_snippetTable"
                           placeholder="my_table"
                           spellcheck="false" />
                </div>
                @foreach (var cat in _snippetCategories)
                {
                    var c = cat;
                    <div class="ddb-snippet-cat">
                        <button class="ddb-snippet-cat-btn" @onclick="() => ToggleSnippetCat(c.Key)">
                            <svg class="ddb-tree-arrow @(_openSnippetCats.Contains(c.Key) ? "ddb-tree-arrow--open" : "")"
                                 viewBox="0 0 24 24" width="9" height="9" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="9 18 15 12 9 6"/>
                            </svg>
                            @c.Icon @c.Label
                        </button>
                        @if (_openSnippetCats.Contains(c.Key))
                        {
                            @foreach (var s in c.Snippets)
                            {
                                var sn = s;
                                <button class="ddb-snippet-item" title="Вставить в редактор"
                                        @onclick="() => InsertSnippet(sn)">
