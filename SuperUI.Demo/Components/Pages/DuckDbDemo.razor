    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sg-duckdb.js");

            // Check OPFS support before init
            _opfsSupported = await _module.InvokeAsync<bool>("opfsSupported");

            // Restore last OPFS preference from localStorage
            var savedOpfs = false;
            try { savedOpfs = await JS.InvokeAsync<bool>("eval", "localStorage.getItem('ddb-opfs') === '1'"); } catch {}

            var result = await _module.InvokeAsync<JsonElement>("init", savedOpfs && _opfsSupported);

            if (result.GetProperty("ok").GetBoolean())
            {
                _opfsActive = result.TryGetProperty("opfs", out var op) && op.GetBoolean();
                _status = "ready";
                _statusText = _opfsActive ? "DuckDB + OPFS" : "DuckDB готов";
                await RefreshSchemaAsync();
            }
            else
            {
                _status = "error";
                _statusText = "Ошибка";
                _initError = result.TryGetProperty("error", out var e) ? e.GetString() : "Unknown error";
            }
        }
        catch (Exception ex)
        {
            _status = "error";
            _statusText = "Ошибка";
            _initError = ex.Message;
        }
        StateHasChanged();
