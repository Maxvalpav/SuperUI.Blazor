@page "/pin-input-demo"
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>Pin Input — SuperUI</PageTitle>
<SgSeoHead Description="Explore Pin Input — SuperUI Blazor component library demo with live examples, code snippets, and API documentation." />

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <ChildContent>

    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgPinInput — PIN / Security Code Input
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Individual input boxes for one-time codes, PINs, and security tokens with auto-advance, backspace, paste, and accessibility.
            </SgTypography>
        </div>

        <div class="demo-three-col">
            <SgCard Title="6-digit (default)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgPinInput Length="6" />
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                        Digits only · Auto-advance · Paste support
                    </SgTypography>
                </SgStack>
            </SgCard>

            <SgCard Title="4-digit" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgPinInput Length="4" />
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                        Compact 4-box layout
                    </SgTypography>
                </SgStack>
            </SgCard>

            <SgCard Title="Secret (password)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgPinInput Length="6" Secret="true" />
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                        Characters hidden like a password field
                    </SgTypography>
                </SgStack>
            </SgCard>

            <SgCard Title="Alphanumeric" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgPinInput Length="6" DigitsOnly="false" />
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                        Accepts letters and digits
                    </SgTypography>
                </SgStack>
            </SgCard>

            <SgCard Title="Two-way Binding + OnComplete" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgPinInput Length="4" @bind-Value="_pinCode" OnComplete="@OnPinComplete" />
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                        Value: @(_pinCode ?? "—")
                    </SgTypography>
                    @if (!string.IsNullOrEmpty(_pinMessage))
                    {
                        <SgTag Color="@(string.IsNullOrEmpty(_pinMessage) ? "" : "success")">@_pinMessage</SgTag>
                    }
                </SgStack>
            </SgCard>

            <SgCard Title="Disabled" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgPinInput Length="6" Disabled="true" />
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                        Non-interactive state
                    </SgTypography>
                </SgStack>
            </SgCard>
        </div>
    </div>

    </ChildContent>
</SgCard>

<style>
    .demo-section {
        margin-top: 48px;
    }
    .demo-section-header {
        margin-bottom: 20px;
    }
    .demo-three-col {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 24px;
    }
    @@media (max-width: 900px) {
        .demo-three-col { grid-template-columns: 1fr 1fr; }
    }
    @@media (max-width: 600px) {
        .demo-three-col { grid-template-columns: 1fr; }
    }
</style>

@code {
    private string? _pinCode;
    private string? _pinMessage;

    private async Task OnPinComplete(string value)
    {
        _pinMessage = $"Code entered: {value}";
    }
}
