@page "/rich-text-editor-demo"
@using SuperUI.Components

<PageTitle>RichTextEditor - SUI</PageTitle>

<SgCard Title="SgRichTextEditor"
        Subtitle="WYSIWYG-редактор: цвета, изображения, drag&amp;drop, полноэкранный режим, горячие клавиши.">

    <div style="display: grid; grid-template-columns: 1fr; gap: 24px; margin-top: 16px;">

        <SgCard Title="Полнофункциональный редактор">
            <div style="display: flex; flex-direction: column; gap: 16px;">
                <div style="font-size: 12px; color: var(--sui-text-muted);">
                    Все возможности: цвет текста и фона, размер шрифта, цитата, код,
                    выравнивание, drag&amp;drop изображений, полноэкранный режим.
                </div>

                <SgRichTextEditor @ref="_editor"
                                  @bind-value="_content1"
                                  Placeholder="Начните печатать или перетащите сюда изображение..."
                                  ShowToolbar="true"
                                  ShowStatusBar="true"
                                  AllowFullscreen="true"
                                  MinHeight="240px" />

                <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                    <SgButton Text="Получить HTML" Variant="SgButtonVariant.Outlined" Size="SgSize.Sm"
                              OnClick="@(() => _previewHtml = _content1)" />
                    <SgButton Text="Вставить пример" Variant="SgButtonVariant.Outlined" Size="SgSize.Sm"
                              OnClick="@LoadSampleAsync" />
                    <SgButton Text="Полный экран" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm"
                              OnClick="@(() => _editor!.ToggleFullscreenAsync())" />
                    <SgButton Text="Очистить" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm"
                              OnClick="@(() => { _content1 = string.Empty; _previewHtml = string.Empty; })" />
                </div>

                @if (!string.IsNullOrEmpty(_previewHtml))
                {
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div>
                            <div style="font-size: 11px; color: var(--sui-text-muted); margin-bottom: 4px;">Превью:</div>
                            <div style="padding: 12px; background: var(--sui-bg-secondary); border: 1px solid var(--sui-border); border-radius: var(--sui-radius);">
                                @((MarkupString)_previewHtml)
                            </div>
                        </div>
                        <div>
                            <div style="font-size: 11px; color: var(--sui-text-muted); margin-bottom: 4px;">HTML:</div>
                            <pre style="background: var(--sui-bg-secondary); padding: 12px; border-radius: var(--sui-radius); font-size: 11px; overflow-x: auto; max-height: 200px; margin: 0;">@_previewHtml</pre>
                        </div>
                    </div>
                }
            </div>
        </SgCard>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
            <SgCard Title="Без статус-бара">
                <SgRichTextEditor @bind-value="_content2"
                                  Placeholder="Только тулбар..."
                                  ShowToolbar="true"
                                  ShowStatusBar="false"
                                  AllowFullscreen="false" />
            </SgCard>

            <SgCard Title="Только для чтения">
                <SgRichTextEditor Value="@_readonlyContent"
                                  ReadOnly="true"
                                  ShowToolbar="false"
                                  ShowStatusBar="true" />
            </SgCard>
        </div>

        <SgCard Title="С предзаполненным содержимым">
            <SgRichTextEditor @bind-value="_content3"
                              ShowToolbar="true"
                              ShowStatusBar="true"
                              MinHeight="180px" />
        </SgCard>

        <SgCard Title="Минимальный (без тулбара)">
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div style="font-size: 12px; color: var(--sui-text-muted);">
                    Чистое поле — горячие клавиши работают: Ctrl+B, Ctrl+I, Ctrl+U, Ctrl+K
                </div>
                <SgRichTextEditor @bind-value="_content4"
                                  Placeholder="Используйте горячие клавиши..."
                                  ShowToolbar="false"
                                  ShowStatusBar="true" />
            </div>
        </SgCard>
    </div>

    <div style="margin-top: 32px;">
        <h3>Горячие клавиши</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-top: 16px;">
            @foreach (var hk in _hotkeys)
            {
                <div style="display: flex; align-items: center; gap: 10px; padding: 10px 12px; background: var(--sui-bg-secondary); border: 1px solid var(--sui-border); border-radius: var(--sui-radius);">
                    <kbd style="background: var(--sui-bg-primary); padding: 3px 8px; border-radius: 4px; border: 1px solid var(--sui-border); font-size: 11px; font-family: monospace; min-width: 56px; text-align: center;">@hk.Key</kbd>
                    <span style="font-size: 12px; color: var(--sui-text-secondary);">@hk.Description</span>
                </div>
            }
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h3>API</h3>
        <SgCode Language="SgCodeLanguage.CSharp" Title="Программный API" Code="@_apiSnippet" />
    </div>

</SgCard>

@code {
    private SgRichTextEditor? _editor;

    private string _content1 = "";
    private string _content2 = "";
    private string _content3 = """
        <h2>Добро пожаловать в SgRichTextEditor</h2>
        <p>Попробуйте <b>выделить</b> этот <i>текст</i> и применить <span style="background: #fff59d;">подсветку</span>.</p>
        <ul>
            <li>Цветные шрифты</li>
            <li>Перетаскивание изображений</li>
            <li>Полноэкранный режим</li>
        </ul>
        <blockquote>Cовременный редактор, выдержанный в стиле SuperUI.</blockquote>
        """;
    private string _content4 = "";
    private string _readonlyContent = """
        <h3>Документ для просмотра</h3>
        <p>Этот контент <b>нельзя редактировать</b>.</p>
        <p>Используется в режиме только для чтения.</p>
        """;
    private string _previewHtml = "";

    private async Task LoadSampleAsync()
    {
        if (_editor != null)
        {
            await _editor.SetHtmlAsync("""
                <h1>Заголовок</h1>
                <p>Это пример с <b>жирным</b>, <i>курсивом</i>, <u>подчёркнутым</u>
                и <s>зачёркнутым</s> текстом.</p>
                <p style="text-align: center;">Текст по центру.</p>
                <ol><li>Один</li><li>Два</li><li>Три</li></ol>
                <pre><code>const sui = "polished";</code></pre>
                """);
        }
    }

    private record Hotkey(string Key, string Description);

    private readonly Hotkey[] _hotkeys =
    {
        new("Ctrl+B", "Жирный"),
        new("Ctrl+I", "Курсив"),
        new("Ctrl+U", "Подчёркнутый"),
        new("Ctrl+Z", "Отменить"),
        new("Ctrl+Y", "Повторить"),
        new("Ctrl+K", "Вставить ссылку"),
        new("Esc", "Закрыть попап / выйти из FS"),
    };

    private string _apiSnippet = """
        @ref="editor"

        // Получить HTML / текст
        var html = await editor.GetHtmlAsync();
        var text = await editor.GetTextAsync();

        // Установить / вставить
        await editor.SetHtmlAsync("<p>Новый</p>");
        await editor.InsertHtmlAsync("<b>Жирный</b>");

        // Управление
        await editor.FocusAsync();
        await editor.ToggleFullscreenAsync();
        """;
}
