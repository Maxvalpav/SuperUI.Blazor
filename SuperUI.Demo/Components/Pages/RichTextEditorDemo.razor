    private string _previewHtml = "";
    private string _plainText = "";
    private string _exportedMd = "";
    private string _lastAutoSave = "";

    private async Task LoadSampleAsync()
    {
        if (_editor != null)
        {
            await _editor.SetHtmlAsync("""
                <h2 style="margin-bottom: 12px;">Welcome</h2>
                <p>This sample demonstrates <b>bold</b>, <i>italic</i>, <u>underlined</u>
                and <s>strikethrough</s> text.</p>
                <p style="text-align:center;">Centered paragraph</p>
                <ul>
                    <li>Bullet list item</li>
                    <li>Another item</li>
                </ul>
                <ol>
                    <li>Numbered item</li>
                    <li>Second item</li>
                </ol>
                <blockquote>Blockquote citation style</blockquote>
                <pre><code>const msg = "Hello World";</code></pre>
                """);
        }
    }

    private async Task GetTextAsync()
    {
        if (_editor != null)
        {
            _plainText = await _editor.GetTextAsync();
        }
    }

    private async Task ExportMarkdownAsync()
    {
        if (_editor != null)
        {
            _exportedMd = await _editor.ExportMarkdownAsync();
        }
    }

    private async Task CopyAsMarkdownAsync()
    {
        if (_editor != null)
        {
            await _editor.CopyAsMarkdownAsync();
        }
    }

    private async Task OnAutoSaveAsync(string html)
    {
        _lastAutoSave = DateTime.Now.ToString("HH:mm:ss");
        StateHasChanged();
        await Task.CompletedTask;
    }

    // ── Hotkeys ───────────────────────────────────────────────────────
    private record Hotkey(string Key, string Description);

    private readonly Hotkey[] _hotkeys =
    {
        new("Ctrl+B", "Bold"),
        new("Ctrl+I", "Italic"),
        new("Ctrl+U", "Underline"),
        new("Ctrl+Z", "Undo"),
        new("Ctrl+Y", "Redo"),
        new("Ctrl+K", "Insert Link"),
        new("Esc", "Close popup / Exit fullscreen"),
        new("# + Space", "Heading 1"),
        new("## + Space", "Heading 2"),
        new("> + Space", "Blockquote"),
        new("- + Space", "Bullet list"),
        new("1. + Space", "Numbered list"),
        new("--- + Enter", "Horizontal rule"),
        new("/", "Command palette (slash menu)"),
    };

    // ── Constructor state ─────────────────────────────────────────────
    private bool _ctorShowToolbar = true;
    private bool _ctorShowStatus = true;
    private bool _ctorFloatToolbar = true;
    private bool _ctorMdShortcuts = true;
    private bool _ctorSlashMenu = true;
    private bool _ctorFindReplace = true;
    private bool _ctorLineNums;
    private bool _ctorResizable;
    private bool _ctorReadOnly;
    private string _ctorMinHeight = "200px";
    private string _ctorContent = "";

    private string[] _generatedCodeLines = Array.Empty<string>();

    private readonly List<SgSegmentedOption<bool>> _boolOnOff = new()
    {
        new() { Value = true,  Label = "On" },
        new() { Value = false, Label = "Off" },
    };

    private readonly List<SgSegmentedOption<string>> _heightOptions = new()
    {
        new() { Value = "120px", Label = "120px" },
        new() { Value = "200px", Label = "200px" },
        new() { Value = "300px", Label = "300px" },
        new() { Value = "400px", Label = "400px" },
    };

    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add("<SgRichTextEditor");
        if (!_ctorFloatToolbar)
            lines.Add("    EnableFloatingToolbar=\"false\"");
        if (!_ctorMdShortcuts)
            lines.Add("    EnableMarkdownShortcuts=\"false\"");
        if (!_ctorSlashMenu)
            lines.Add("    EnableSlashMenu=\"false\"");
        if (!_ctorFindReplace)
            lines.Add("    EnableFindReplace=\"false\"");
        if (_ctorLineNums)
            lines.Add("    ShowLineNumbers=\"true\"");
        if (_ctorResizable)
            lines.Add("    Resizable=\"true\"");
        if (_ctorReadOnly)
            lines.Add("    ReadOnly=\"true\"");
        if (!_ctorShowToolbar)
            lines.Add("    ShowToolbar=\"false\"");
        if (!_ctorShowStatus)
            lines.Add("    ShowStatusBar=\"false\"");
        if (_ctorMinHeight != "200px")
            lines.Add($"    MinHeight=\"{_ctorMinHeight}\"");
        lines.Add("    Placeholder=\"...\" />");
        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
        }
        catch { }
    }

