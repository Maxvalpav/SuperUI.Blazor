@page "/rich-text-editor-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgRichTextEditor — Rich Text Editor — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Rich Text Editor"
                        Subtitle="SgRichTextEditor — WYSIWYG with floating toolbar, markdown shortcuts, slash menu, emoji picker, find &amp; replace, AI assistant, focus mode, resizable, line numbers, and more."
                        Icon="@SgHeroicons.Outline.PencilSquare" />
    </HeaderContent>
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Full-Featured Editor with New Features                         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgRichTextEditor — Full-Featured
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Try the new features: select text for floating toolbar, type <kbd>/</kbd> for commands, <kbd>#</kbd> <kbd>##</kbd> <kbd>&gt;</kbd> <kbd>-</kbd> for markdown shortcuts, use the emoji picker, find &amp; replace, and more.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Full Toolbar" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                        Floating toolbar, markdown shortcuts, slash menu, emoji picker, find &amp; replace, focus mode, collapsible toolbar — all enabled.
                    </SgTypography>
                    <SgRichTextEditor @ref="_editor"
                                      @bind-value="_content1"
                                      Placeholder="Try / for commands, # for heading, select text for floating toolbar..."
                                      ShowToolbar="true"
                                      ShowStatusBar="true"
                                      AllowFullscreen="true"
                                      ShowSourceButton="true"
                                      ShowTableButton="true"
                                      ShowBlockSelect="true"
                                      EnableFloatingToolbar="true"
                                      EnableMarkdownShortcuts="true"
                                      EnableSlashMenu="true"
                                      ShowEmojiPicker="true"
                                      EnableFindReplace="true"
                                      EnableCollapsibleToolbar="true"
                                      EnableFocusMode="true"
                                      ShowLineNumbers="false"
                                      Resizable="true"
                                      MinHeight="280px" />
                    <SgSpace>
                        <SgButton Text="Get HTML" Variant="SgButtonVariant.Outlined" Size="SgSize.Sm"
                                  OnClick="@(() => _previewHtml = _content1)" />
                        <SgButton Text="Get Text" Variant="SgButtonVariant.Outlined" Size="SgSize.Sm"
                                  OnClick="@GetTextAsync" />
                        <SgButton Text="Export MD" Variant="SgButtonVariant.Outlined" Size="SgSize.Sm"
                                  OnClick="@ExportMarkdownAsync" />
                        <SgButton Text="Copy MD" Variant="SgButtonVariant.Outlined" Size="SgSize.Sm"
                                  OnClick="@CopyAsMarkdownAsync" />
                        <SgButton Text="Load Sample" Variant="SgButtonVariant.Outlined" Size="SgSize.Sm"
                                  OnClick="@LoadSampleAsync" />
                        <SgButton Text="Clear" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm"
                                  OnClick="@(() => { _content1 = string.Empty; _previewHtml = string.Empty; _plainText = string.Empty; _exportedMd = string.Empty; })" />
                    </SgSpace>

                    @if (!string.IsNullOrEmpty(_previewHtml) || !string.IsNullOrEmpty(_plainText) || !string.IsNullOrEmpty(_exportedMd))
                    {
                        <SgRow Space="SgSize.Md">
                            @if (!string.IsNullOrEmpty(_previewHtml))
                            {
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Preview</SgTypography>
                                        <div class="demo-preview-box">
                                            @((MarkupString)_previewHtml)
                                        </div>
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">HTML Source</SgTypography>
                                        <pre class="demo-code-preview">@_previewHtml</pre>
                                    </SgStack>
                                </SgCol>
                            }
                            @if (!string.IsNullOrEmpty(_plainText))
                            {
                                <SgCol Span="12">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Plain Text</SgTypography>
                                        <pre class="demo-text-preview">@_plainText</pre>
                                    </SgStack>
                                </SgCol>
                            }
                            @if (!string.IsNullOrEmpty(_exportedMd))
                            {
                                <SgCol Span="12">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Exported Markdown</SgTypography>
                                        <pre class="demo-code-preview">@_exportedMd</pre>
                                    </SgStack>
                                </SgCol>
                            }
                        </SgRow>
                    }
                </SgStack>
            </SgCard>

            <SgCard Title="Status Bar & MaxLength" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                        Status bar shows word count, character count, and current format. Max length set to 100 characters.
                    </SgTypography>
                    <SgRichTextEditor @bind-value="_contentLn" 
                                      ShowStatusBar="true"
                                      ShowWordCount="true"
                                      ShowCharCount="true"
                                      ShowFormatIndicator="true"
                                      MaxLength="100"
                                      MinHeight="120px" />
                </SgStack>
            </SgCard>
            <SgCard Title="Resizable & MinHeight" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                        Resizable editor with min-height of 150px and max-height of 400px.
                    </SgTypography>
                    <SgRichTextEditor @bind-value="_contentResize"
                                      Resizable="true"
                                      MinHeight="150px"
                                      MaxHeight="400px" />
                </SgStack>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Variations — New Features Showcase                            -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Feature Variations
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Each card highlights a different feature combination.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Xs="12" Sm="6" Lg="4">
                <SgCard Title="Line Numbers" Subtitle="ShowLineNumbers=true" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgRichTextEditor @bind-value="_contentLn"
                                      ShowLineNumbers="true"
                                      MinHeight="180px"
                                      Placeholder="Line numbers visible..." />
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Sm="6" Lg="4">
                <SgCard Title="Resizable" Subtitle="Resizable=true" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgRichTextEditor @bind-value="_contentResize"
                                      Resizable="true"
                                      ResizeMinHeight="120px"
                                      ResizeMaxHeight="500px"
                                      MinHeight="120px"
                                      Placeholder="Drag the bottom handle to resize..." />
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Sm="6" Lg="4">
                <SgCard Title="Collapsible Toolbar" Subtitle="EnableCollapsibleToolbar=true" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgRichTextEditor @bind-value="_contentCollapse"
                                      EnableCollapsibleToolbar="true"
                                      ShowCollapseButton="true"
                                      ShowBlockSelect="false"
                                      MinHeight="140px"
                                      Placeholder="Click collapse button to hide toolbar..." />
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Sm="6" Lg="4">
                <SgCard Title="Focus Mode" Subtitle="EnableFocusMode=true" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgRichTextEditor @bind-value="_contentFocus"
                                      EnableFocusMode="true"
                                      ShowFocusModeButton="true"
                                      ShowBlockSelect="false"
                                      ShowSourceButton="false"
                                      MinHeight="140px"
                                      Placeholder="Click focus icon for distraction-free editing..." />
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Sm="6" Lg="4">
                <SgCard Title="Ripple Effect" Subtitle="EnableRipple=true" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgRichTextEditor @bind-value="_contentRipple"
                                      EnableRipple="true"
                                      ShowBlockSelect="false"
                                      ShowSourceButton="false"
                                      ShowTableButton="false"
                                      MinHeight="140px"
                                      Placeholder="Click toolbar buttons to see ripple..." />
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Sm="6" Lg="4">
                <SgCard Title="Auto-Save" Subtitle="AutoSaveMs=2000" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                            Auto-saves every 2 seconds. Last saved: @_lastAutoSave
                        </SgTypography>
                        <SgRichTextEditor @bind-value="_contentAutoSave"
                                          AutoSaveMs="2000"
                                          OnAutoSave="OnAutoSaveAsync"
                                          ShowBlockSelect="false"
                                          ShowSourceButton="false"
                                          ShowTableButton="false"
                                          MinHeight="120px"
                                          Placeholder="Type something — auto-save fires every 2s..." />
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Public API & Methods                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Public API
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                All public methods available via <code>@@ref</code>. Includes new: <code>ExportMarkdownAsync</code>, <code>CopyAsMarkdownAsync</code>.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Programmatic Control" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;">Get / Set Content</SgTypography>
                            <SgSpace>
                                <SgButton Text="Set HTML" Variant="SgButtonVariant.Outlined" Size="SgSize.Sm"
                                          OnClick="@( async () => { if (_editor != null) await _editor.SetHtmlAsync("<h3 style='margin-bottom: 8px;'>Set from API</h3><p>Hello!</p>"); })" />
                                <SgButton Text="Insert HTML" Variant="SgButtonVariant.Outlined" Size="SgSize.Sm"
                                          OnClick="@( async () => { if (_editor != null) await _editor.InsertHtmlAsync("<b>inserted</b>"); })" />
                                <SgButton Text="Export MD" Variant="SgButtonVariant.Outlined" Size="SgSize.Sm"
                                          OnClick="@ExportMarkdownAsync" />
                            </SgSpace>
                        </div>
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;">Focus & View</SgTypography>
                            <SgSpace>
                                <SgButton Text="Focus" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm"
                                          OnClick="@( async () => { if (_editor != null) await _editor.FocusAsync(); })" />
                                <SgButton Text="Toggle Fullscreen" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm"
                                          OnClick="@( async () => { if (_editor != null) await _editor.ToggleFullscreenAsync(); })" />
                            </SgSpace>
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Code Snippet" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <pre class="demo-code-snippet"><code>@@ref="editor"

// Get content
var html = await editor.GetHtmlAsync();
var text = await editor.GetTextAsync();
var md   = await editor.ExportMarkdownAsync();

// Set content
await editor.SetHtmlAsync("&lt;p&gt;HTML&lt;/p&gt;");
await editor.InsertHtmlAsync("&lt;b&gt;bold&lt;/b&gt;");

// Control
await editor.FocusAsync();
await editor.ToggleFullscreenAsync();

// New features
await editor.CopyAsMarkdownAsync();

// Properties
bool isFS = editor.IsFullscreen;
bool isCodeView = editor.IsCodeView;</code></pre>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Live Constructor                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live SgRichTextEditor Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure parameters and see the result in real time. Click <kbd>Copy</kbd> to copy the code.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Show Toolbar</SgTypography>
                            <SgSegmented TValue="bool" Value="_ctorShowToolbar" ValueChanged="v => { _ctorShowToolbar = v; UpdateConstructorCode(); StateHasChanged(); }" Block="true" Size="sm" Options="_boolOnOff" />
                        </SgStack>

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Show Status Bar</SgTypography>
                            <SgSegmented TValue="bool" Value="_ctorShowStatus" ValueChanged="v => { _ctorShowStatus = v; UpdateConstructorCode(); StateHasChanged(); }" Block="true" Size="sm" Options="_boolOnOff" />
                        </SgStack>

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Floating Toolbar</SgTypography>
                            <SgSegmented TValue="bool" Value="_ctorFloatToolbar" ValueChanged="v => { _ctorFloatToolbar = v; UpdateConstructorCode(); StateHasChanged(); }" Block="true" Size="sm" Options="_boolOnOff" />
                        </SgStack>

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Markdown Shortcuts</SgTypography>
                            <SgSegmented TValue="bool" Value="_ctorMdShortcuts" ValueChanged="v => { _ctorMdShortcuts = v; UpdateConstructorCode(); StateHasChanged(); }" Block="true" Size="sm" Options="_boolOnOff" />
                        </SgStack>

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Slash Menu</SgTypography>
                            <SgSegmented TValue="bool" Value="_ctorSlashMenu" ValueChanged="v => { _ctorSlashMenu = v; UpdateConstructorCode(); StateHasChanged(); }" Block="true" Size="sm" Options="_boolOnOff" />
                        </SgStack>

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Find &amp; Replace</SgTypography>
                            <SgSegmented TValue="bool" Value="_ctorFindReplace" ValueChanged="v => { _ctorFindReplace = v; UpdateConstructorCode(); StateHasChanged(); }" Block="true" Size="sm" Options="_boolOnOff" />
                        </SgStack>

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Line Numbers</SgTypography>
                            <SgSegmented TValue="bool" Value="_ctorLineNums" ValueChanged="v => { _ctorLineNums = v; UpdateConstructorCode(); StateHasChanged(); }" Block="true" Size="sm" Options="_boolOnOff" />
                        </SgStack>

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Resizable</SgTypography>
                            <SgSegmented TValue="bool" Value="_ctorResizable" ValueChanged="v => { _ctorResizable = v; UpdateConstructorCode(); StateHasChanged(); }" Block="true" Size="sm" Options="_boolOnOff" />
                        </SgStack>

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Read Only</SgTypography>
                            <SgSegmented TValue="bool" Value="_ctorReadOnly" ValueChanged="v => { _ctorReadOnly = v; UpdateConstructorCode(); StateHasChanged(); }" Block="true" Size="sm" Options="_boolOnOff" />
                        </SgStack>

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Min Height</SgTypography>
                            <SgSegmented TValue="string" Value="_ctorMinHeight" ValueChanged="v => { _ctorMinHeight = v; UpdateConstructorCode(); StateHasChanged(); }" Block="true" Size="sm" Options="_heightOptions" />
                        </SgStack>

                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Floating Toolbar</SgTypography>
                                    <SgBadge Variant="@(_ctorFloatToolbar ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_ctorFloatToolbar ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Markdown Shortcuts</SgTypography>
                                    <SgBadge Variant="@(_ctorMdShortcuts ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_ctorMdShortcuts ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Slash Menu</SgTypography>
                                    <SgBadge Variant="@(_ctorSlashMenu ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_ctorSlashMenu ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Find &amp; Replace</SgTypography>
                                    <SgBadge Variant="@(_ctorFindReplace ? SgBadgeVariant.Info : SgBadgeVariant.Default)" Text="@(_ctorFindReplace ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Line Numbers</SgTypography>
                                    <SgBadge Variant="@(_ctorLineNums ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_ctorLineNums ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Resizable</SgTypography>
                                    <SgBadge Variant="@(_ctorResizable ? SgBadgeVariant.Info : SgBadgeVariant.Default)" Text="@(_ctorResizable ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <div class="constructor-preview" id="constructor-preview">
                                <SgRichTextEditor @bind-value="_ctorContent"
                                                  ShowToolbar="_ctorShowToolbar"
                                                  ShowStatusBar="_ctorShowStatus"
                                                  EnableFloatingToolbar="_ctorFloatToolbar"
                                                  EnableMarkdownShortcuts="_ctorMdShortcuts"
                                                  EnableSlashMenu="_ctorSlashMenu"
                                                  EnableFindReplace="_ctorFindReplace"
                                                  ShowLineNumbers="_ctorLineNums"
                                                  Resizable="_ctorResizable"
                                                  ReadOnly="_ctorReadOnly"
                                                  MinHeight="_ctorMinHeight"
                                                  ShowEmojiPicker="true"
                                                  ShowEmojiButton="true"
                                                  ShowFindReplaceButton="true"
                                                  ShowCollapseButton="false"
                                                  AllowFullscreen="false"
                                                  ShowSourceButton="false"
                                                  ShowTableButton="false"
                                                  ShowBlockSelect="false"
                                                  Placeholder="Interactive constructor result..." />
                            </div>
                        </SgStack>

                        <!-- Code -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                    <span id="copy-icon">📋</span>
                                    <span id="copy-text" style="font-size:11px;font-weight:600;">Copy</span>
                                </button>
                            </div>
                            <div class="code-block" id="code-block">
                                @foreach (var line in _generatedCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Keyboard Shortcuts & Commands                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Keyboard Shortcuts &amp; Commands
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Standard shortcuts plus new Markdown-style input shortcuts. Type <kbd>/</kbd> for the command palette.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Md">
            @foreach (var hk in _hotkeys)
            {
                <SgCol Xs="6" Md="4" Lg="3">
                    <div class="demo-hotkey-card">
                        <kbd class="demo-hotkey-kbd">@hk.Key</kbd>
                        <span class="demo-hotkey-label">@hk.Description</span>
                    </div>
                </SgCol>
            }
        </SgRow>
    </div>

</ChildContent>
</SgCard>

