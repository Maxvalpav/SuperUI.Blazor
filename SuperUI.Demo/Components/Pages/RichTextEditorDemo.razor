@page "/rich-text-editor-demo"
@using SuperUI.Components

<PageTitle>RichTextEditor - SUI</PageTitle>

<SgCard Title="SgRichTextEditor - WYSIWYG редактор"
        Subtitle="Мощный текстовый редактор с поддержкой форматирования.">

    <div style="margin-top: 32px;">
        <h2>Примеры использования</h2>
        <p>Различные конфигурации редактора.</p>

        <div style="display: grid; grid-template-columns: 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Базовый редактор">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">
                        Полный редактор с тулбаром и статус-баром
                    </div>
                    <SgRichTextEditor @bind-value="@_content1" 
                                      Placeholder="Начните печатать..."
                                      ShowToolbar="true"
                                      ShowStatusBar="true" />
                    <div style="margin-top: 8px;">
                        <SgButton Text="Получить HTML" Variant="outlined" Size="sm" OnClick="@(() => _previewHtml = _content1)" />
                        <SgButton Text="Очистить" Variant="ghost" Size="sm" OnClick="@(() => { _content1 = ""; _previewHtml = ""; })" />
                    </div>
                    @if (!string.IsNullOrEmpty(_previewHtml))
                    {
                        <div style="margin-top: 8px;">
                            <div style="font-size: 11px; color: var(--sui-text-muted); margin-bottom: 4px;">HTML вывод:</div>
                            <pre style="background: var(--sui-bg-secondary); padding: 8px; border-radius: var(--sui-radius); font-size: 11px; overflow-x: auto;">@_previewHtml</pre>
                        </div>
                    }
                </div>
            </SgCard>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                <SgCard Title="Без статус-бара">
                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">
                            Только тулбар без подсчета слов
                        </div>
                        <SgRichTextEditor @bind-value="@_content2" 
                                          Placeholder="Введите текст..."
                                          ShowToolbar="true"
                                          ShowStatusBar="false" />
                    </div>
                </SgCard>

                <SgCard Title="Только для чтения">
                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">
                            Режим просмотра без возможности редактирования
                        </div>
                        <SgRichTextEditor Value="@_readonlyContent" 
                                          ReadOnly="true"
                                          ShowToolbar="false"
                                          ShowStatusBar="true" />
                    </div>
                </SgCard>
            </div>

            <SgCard Title="С начальным содержимым">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">
                        Предзаполненный контент с форматированием
                    </div>
                    <SgRichTextEditor @bind-value="@_content3" 
                                      ShowToolbar="true"
                                      ShowStatusBar="true" />
                </div>
            </SgCard>

            <SgCard Title="Упрощенный (без тулбара)">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">
                        Только текстовое поле без панели инструментов (горячие клавиши работают)
                    </div>
                    <SgRichTextEditor @bind-value="@_content4" 
                                      Placeholder="Ctrl+B - жирный, Ctrl+I - курсив..."
                                      ShowToolbar="false"
                                      ShowStatusBar="true" />
                </div>
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h3>Горячие клавиши</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-top: 16px;">
            <div style="padding: 12px; background: var(--sui-bg-secondary); border-radius: var(--sui-radius);">
                <kbd style="background: var(--sui-bg-primary); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--sui-border); font-size: 12px;">Ctrl+B</kbd>
                <span style="margin-left: 8px; font-size: 12px;">Жирный текст</span>
            </div>
            <div style="padding: 12px; background: var(--sui-bg-secondary); border-radius: var(--sui-radius);">
                <kbd style="background: var(--sui-bg-primary); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--sui-border); font-size: 12px;">Ctrl+I</kbd>
                <span style="margin-left: 8px; font-size: 12px;">Курсив</span>
            </div>
            <div style="padding: 12px; background: var(--sui-bg-secondary); border-radius: var(--sui-radius);">
                <kbd style="background: var(--sui-bg-primary); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--sui-border); font-size: 12px;">Ctrl+U</kbd>
                <span style="margin-left: 8px; font-size: 12px;">Подчеркнутый</span>
            </div>
            <div style="padding: 12px; background: var(--sui-bg-secondary); border-radius: var(--sui-radius);">
                <kbd style="background: var(--sui-bg-primary); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--sui-border); font-size: 12px;">Ctrl+Z</kbd>
                <span style="margin-left: 8px; font-size: 12px;">Отменить</span>
            </div>
            <div style="padding: 12px; background: var(--sui-bg-secondary); border-radius: var(--sui-radius);">
                <kbd style="background: var(--sui-bg-primary); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--sui-border); font-size: 12px;">Ctrl+Y</kbd>
                <span style="margin-left: 8px; font-size: 12px;">Повторить</span>
            </div>
            <div style="padding: 12px; background: var(--sui-bg-secondary); border-radius: var(--sui-radius);">
                <kbd style="background: var(--sui-bg-primary); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--sui-border); font-size: 12px;">Ctrl+K</kbd>
                <span style="margin-left: 8px; font-size: 12px;">Вставить ссылку</span>
            </div>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h3>API методы</h3>
        <pre style="background: var(--sui-bg-secondary); padding: 16px; border-radius: var(--sui-radius); overflow-x: auto;">
<code>@("@ref=\"editor\"\n\n// Получить HTML\nstring html = await editor.GetHtmlAsync();\n\n// Получить текст\nstring text = await editor.GetTextAsync();\n\n// Установить HTML\nawait editor.SetHtmlAsync(\"<p>Новый контент</p>\");\n\n// Вставить HTML\nawait editor.InsertHtmlAsync(\"<b>Жирный текст</b>\");\n\n// Фокус\nawait editor.FocusAsync();")</code>
        </pre>
    </div>

</SgCard>

@code {
    private string _content1 = "";
    private string _content2 = "";
    private string _content3 = @"<h2>Добро пожаловать в редактор!</h2>
<p>Это <b>предзаполненный</b> контент с <i>форматированием</i>.</p>
<ul>
    <li>Первый пункт списка</li>
    <li>Второй пункт списка</li>
</ul>
<p>Вы можете редактировать этот текст.</p>";
    private string _content4 = "";
    private string _readonlyContent = @"<h3>Документ только для чтения</h3>
<p>Этот контент нельзя редактировать. Он отображается в режиме просмотра.</p>
<p><b>Важная информация:</b> Пожалуйста, ознакомьтесь с содержимым.</p>";
    private string _previewHtml = "";
}
