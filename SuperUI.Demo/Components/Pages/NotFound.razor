@page "/not-found"
@layout MainLayout

<PageTitle>Страница не найдена — SuperUI</PageTitle>

<SgEmpty Text="Страница не найдена">
    <Icon>🔍</Icon>
    <ChildContent>
        <SgButton Text="На главную" Variant=SgButtonVariant.Primary" OnClick="@(() => Nav.NavigateTo("/"))" />
    </ChildContent>
</SgEmpty>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
}

