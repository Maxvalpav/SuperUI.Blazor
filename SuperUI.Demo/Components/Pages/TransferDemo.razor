    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add("<SgTransfer");
        lines.Add($"    DataSource=\"...\"");
        lines.Add($"    @bind-TargetKeys=\"_targetKeys\"");
        lines.Add($"    Titles=\"@(new[] {{ \"{_ctorSourceTitle}\", \"{_ctorTargetTitle}\" }})\"");
        if (_ctorSearchable)
            lines.Add($"    Searchable=\"true\"");
        if (_ctorSize != "md")
            lines.Add($"    Size=\"{_ctorSize}\"");
        if (_ctorDoubleClick)
            lines.Add($"    AllowDoubleClick=\"true\"");
        if (!_ctorSelectAll)
            lines.Add($"    ShowSelectAll=\"false\"");
        if (_ctorDisabled)
            lines.Add($"    Disabled=\"true\"");
        lines.Add("    />");
        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

