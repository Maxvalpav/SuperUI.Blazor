@page "/transfer-demo"
@using SuperUI.Components

<PageTitle>Transfer - SUI</PageTitle>

<SgCard Title="SgTransfer - Shuttle List"
        Subtitle="Move items between two lists. Essential for permission and configuration UIs.">

    <div style="margin-top: 32px;">
        <h2>Basic Usage</h2>
        <p>Transfer items between source and target lists.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example" Style="grid-column: 1 / -1;">
                <SgTransfer DataSource="_basicData"
                            @bind-TargetKeys="_basicTargetKeys"
                            Titles="@(new[] { "Available", "Selected" })" />
                <div style="margin-top: 12px; font-size: 12px;">
                    Target keys: @string.Join(", ", _basicTargetKeys)
                </div>
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>With Search</h2>
        <p>Enable search to filter items in each list.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example" Style="grid-column: 1 / -1;">
                <SgTransfer DataSource="_searchData"
                            @bind-TargetKeys="_searchTargetKeys"
                            Titles="@(new[] { "Users", "Admins" })"
                            Searchable="true"
                            SearchPlaceholder="Search users..." />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Disabled Items & Custom Empty Text</h2>
        <p>Some items can be disabled to prevent transfer.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example" Style="grid-column: 1 / -1;">
                <SgTransfer DataSource="_disabledData"
                            @bind-TargetKeys="_disabledTargetKeys"
                            Titles="@(new[] { "Modules", "Active" })"
                            EmptyText="No items" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Properties</h2>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Transfer Properties">
                <PropertyTable Items="_transferProperties" />
            </SgCard>
            <SgCard Title="TransferItem Model">
                <PropertyTable Items="_itemProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Code example -->
    <div style="margin-top: 32px;">
        <h2>Примеры кода</h2>
        <SgCode Language="SgCodeLanguage.Razor" Code="@_transferCode" />
    </div>

</SgCard>

@code {
    private List<string> _basicTargetKeys = new() { "2" };
    private List<string> _searchTargetKeys = new() { "u3" };
    private List<string> _disabledTargetKeys = new() { "m1" };

    private List<SgTransferItem> _basicData = new()
    {
        new() { Key = "1", Title = "Option A" },
        new() { Key = "2", Title = "Option B" },
        new() { Key = "3", Title = "Option C" },
        new() { Key = "4", Title = "Option D" },
        new() { Key = "5", Title = "Option E" }
    };

    private List<SgTransferItem> _searchData = new()
    {
        new() { Key = "u1", Title = "Alice Johnson", Description = "alice@company.com" },
        new() { Key = "u2", Title = "Bob Smith", Description = "bob@company.com" },
        new() { Key = "u3", Title = "Charlie Brown", Description = "charlie@company.com" },
        new() { Key = "u4", Title = "Diana Prince", Description = "diana@company.com" },
        new() { Key = "u5", Title = "Evan Wright", Description = "evan@company.com" },
        new() { Key = "u6", Title = "Fiona Green", Description = "fiona@company.com" }
    };

    private List<SgTransferItem> _disabledData = new()
    {
        new() { Key = "m1", Title = "Core Module", Description = "Required system module", Disabled = true },
        new() { Key = "m2", Title = "Reporting" },
        new() { Key = "m3", Title = "Billing" },
        new() { Key = "m4", Title = "Analytics" },
        new() { Key = "m5", Title = "Integrations", Description = "Third-party connectors" }
    };

    private List<PropertyPanelItem> _transferProperties = new()
    {
        new() { Label = "DataSource", Value = "List<SgTransferItem>", BadgeText = "All items", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "TargetKeys", Value = "List<string>", BadgeText = "Two-way binding", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Titles", Value = "string[]", BadgeText = "List titles", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Searchable", Value = "bool", BadgeText = "Enable search", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "SearchPlaceholder", Value = "string", BadgeText = "Search hint", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "EmptyText", Value = "string", BadgeText = "Empty message", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Disabled", Value = "bool", BadgeText = "Disabled", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "OnChange", Value = "EventCallback", BadgeText = "Items moved", BadgeVariant = SgBadgeVariant.Success }
    };

    private List<PropertyPanelItem> _itemProperties = new()
    {
        new() { Label = "Key",         Value = "string",  BadgeText = "Unique id",    BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Title",       Value = "string",  BadgeText = "Display text", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Description", Value = "string?", BadgeText = "Subtitle",     BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Disabled",    Value = "bool",    BadgeText = "Cannot move",  BadgeVariant = SgBadgeVariant.Warn }
    };

    // ── Code snippet ──────────────────────────────────────────────────────────
    private string _transferCode = """
        <SgTransfer DataSource="_data"
                    @bind-TargetKeys="_selected"
                    Titles="@(new[] { "Доступно", "Выбрано" })"
                    Searchable="true"
                    SearchPlaceholder="Поиск..."
                    OnChange="OnChanged" />

        @code {
            private List<string> _selected = new();

            private List<SgTransferItem> _data = new()
            {
                new() { Key = "1", Title = "Пункт A" },
                new() { Key = "2", Title = "Пункт B" },
                new() { Key = "3", Title = "Пункт C (заблокирован)",
                        Disabled = true },
                new() { Key = "4", Title = "Пункт D",
                        Description = "Дополнительное описание" }
            };

            private void OnChanged() { }
        }
        """;
}
