@page "/transfer-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgTransfer — Shuttle List — SuperUI</PageTitle>
<SgSeoHead Description="60+ parameters: drag &amp; drop, tree mode, skeletons, undo/redo, move all, keyboard nav, direction modes, collapsible groups, search highlight, sticky headers, and more." />

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="SgTransfer — Shuttle List"
                       Subtitle="60+ parameters: drag &amp; drop, tree mode, skeletons, undo/redo, move all, keyboard nav, direction modes, collapsible groups, search highlight, sticky headers, and more." />
    </HeaderContent>
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Basic Usage                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgTransfer — Basic Usage
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Transfer items between source and target lists with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">DataSource</SgTypography> and two-way <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">TargetKeys</SgTypography> binding.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Simple Selection" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgTransfer DataSource="_basicData"
                                @bind-TargetKeys="_basicTargetKeys"
                                Titles="@(new[] { "Available", "Selected" })" />
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                        Target keys: <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Xs">@string.Join(", ", _basicTargetKeys)</SgTypography>
                    </SgTypography>
                </SgStack>
            </SgCard>

            <SgCard Title="Basic Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_basicProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. With Search & Sizes                                             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Search, Sizes & Double-Click
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Enable search filtering, choose a size variant, or allow double-click to move items instantly.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Searchable + Double-Click" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgTransfer DataSource="_searchData"
                                    @bind-TargetKeys="_searchTargetKeys"
                                    Titles="@(new[] { "Users", "Admins" })"
                                    Searchable="true"
                                    SearchPlaceholder="Search users..."
                                    AllowDoubleClick="true"
                                    Size="sm" />
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                            Target: <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Xs">@string.Join(", ", _searchTargetKeys)</SgTypography>
                        </SgTypography>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Large Size" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTransfer DataSource="_largeData"
                                @bind-TargetKeys="_largeTargetKeys"
                                Titles="@(new[] { "Frameworks", "Favorites" })"
                                Size="lg"
                                AllowDoubleClick="true" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Avatars, Badges, Groups, Icons                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Avatars, Badges, Groups & Icons
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Rich item content: avatar initials, status badges, group headers, and SVG icons.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Avatars + Badges" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTransfer DataSource="_teamData"
                                @bind-TargetKeys="_teamTargetKeys"
                                Titles="@(new[] { "Team Pool", "Project Team" })"
                                Height="300px"
                                AllowDoubleClick="true" />
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Groups + Icons" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTransfer DataSource="_moduleData"
                                @bind-TargetKeys="_moduleTargetKeys"
                                Titles="@(new[] { "Modules", "Active" })"
                                Height="300px"
                                AllowDoubleClick="true" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Disabled Items & Footers                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Disabled Items, Footers & Custom Buttons
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Some items can be locked. Add footer content below lists. Customize move button text.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Disabled + Footer" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgTransfer DataSource="_disabledData"
                                @bind-TargetKeys="_disabledTargetKeys"
                                Titles="@(new[] { "Services", "Enabled" })"
                                EmptyText="No services available"
                                AllowDoubleClick="true"
                                SourceFooter="@(_ => FooterContent("Total: 5 modules"))"
                                TargetFooter="@(_ => FooterContent("Active: " + _disabledTargetKeys.Count))" />
                </SgStack>
            </SgCard>

            <SgCard Title="Custom Button Text" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgTransfer DataSource="_basicData"
                            @bind-TargetKeys="_customBtnTargetKeys"
                            Titles="@(new[] { "Items", "Cart" })"
                            RightButtonText="Add →"
                            LeftButtonText="← Remove" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Drag & Drop + Move All + Undo                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Drag & Drop, Move All & Undo
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Drag items between lists with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Draggable="true"</SgTypography>. Use ≫/≪ to move all. Undo with Ctrl+Z or the ↩ button.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Drag & Drop + Move All" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTransfer DataSource="_basicData"
                                @bind-TargetKeys="_dndTargetKeys"
                                Titles="@(new[] { "Available", "Chosen" })"
                                Draggable="true"
                                ShowMoveAllButtons="true"
                                AllowDoubleClick="true" />
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Undo/Redo History" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                            Every move is tracked. Use Shift+Click to multi-select, then undo.
                        </SgTypography>
                        <SgTransfer DataSource="_largeData"
                                    @bind-TargetKeys="_undoTargetKeys"
                                    Titles="@(new[] { "Frameworks", "Selected" })"
                                    ShowMoveAllButtons="true"
                                    ShowUndoRedoButtons="true"
                                    AllowDoubleClick="true"
                                    KeyboardNavigation="true" />
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. Tree Mode + Loading + Search Highlight                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Tree Mode, Loading & Search Highlight
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Hierarchical items with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ShowTreeMode</SgTypography>, loading skeletons, and highlighted search matches.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="4">
                <SgCard Title="Tree Mode" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTransfer DataSource="_treeData"
                                @bind-TargetKeys="_treeTargetKeys"
                                Titles="@(new[] { "Permissions", "Granted" })"
                                ShowTreeMode="true" />
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Loading Skeleton" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgTransfer DataSource="_basicData"
                                    @bind-TargetKeys="_loadingTargetKeys"
                                    Titles="@(new[] { "Source", "Target" })"
                                    Loading="_loading"
                                    Height="260px" />
                        <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Primary" OnClick="@(() => _loading = !_loading)">
                            @(_loading ? "Stop Loading" : "Show Loading")
                        </SgButton>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Search Highlight" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTransfer DataSource="_searchData"
                                @bind-TargetKeys="_highlightTargetKeys"
                                Titles="@(new[] { "Users", "Selected" })"
                                Searchable="true"
                                HighlightSearchMatches="true"
                                Height="260px" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 7. Direction Modes + Collapsible Groups + Sticky Headers            -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Direction Modes, Collapsible Groups & Counts
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Restrict move direction with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Mode</SgTypography>, collapse groups with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">CollapsibleGroups</SgTypography>, show item counts.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="4">
                <SgCard Title="ToTargetOnly Mode" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTransfer DataSource="_moduleData"
                                @bind-TargetKeys="_modeTargetKeys"
                                Titles="@(new[] { "Modules", "Active" })"
                                Mode="SgTransferMode.ToTargetOnly"
                                ShowItemCount="true"
                                Height="280px" />
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Collapsible Groups" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTransfer DataSource="_moduleData"
                                @bind-TargetKeys="_groupTargetKeys"
                                Titles="@(new[] { "Modules", "Active" })"
                                CollapsibleGroups="true"
                                ShowItemCount="true"
                                Height="280px" />
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Sticky + Debounce" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTransfer DataSource="_largeData"
                                @bind-TargetKeys="_stickyTargetKeys"
                                Titles="@(new[] { "Frameworks", "Favorites" })"
                                Searchable="true"
                                StickyHeaders="true"
                                SearchDebounceMs="300"
                                Height="280px" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 8. Live Constructor                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live SgTransfer Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure parameters and see the result in real time. Click "Copy" to grab the generated code.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">
                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Titles -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Source Title</SgTypography>
                            <input type="text" class="ctor-input" @bind="_ctorSourceTitle" @bind:event="oninput" />
                        </SgStack>

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Target Title</SgTypography>
                            <input type="text" class="ctor-input" @bind="_ctorTargetTitle" @bind:event="oninput" />
                        </SgStack>

                        <!-- Size -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                            <SgSegmented TValue="string"
                                         Value="_ctorSize"
                                         ValueChanged="v => { _ctorSize = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_sizeOptions" />
                        </SgStack>

                        <!-- Toggles -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Searchable</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorSearchable"
                                                 ValueChanged="v => { _ctorSearchable = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Double-Click</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorDoubleClick"
                                                 ValueChanged="v => { _ctorDoubleClick = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Show SelectAll</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorSelectAll"
                                                 ValueChanged="v => { _ctorSelectAll = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolOptions2" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Disabled</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorDisabled"
                                                 ValueChanged="v => { _ctorDisabled = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolOptions2" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Items</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorDemoData.Count.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorSize" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Search</SgTypography>
                                    <SgBadge Variant="@(_ctorSearchable ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_ctorSearchable ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">
                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <div class="constructor-preview" id="constructor-preview">
                                <SgTransfer DataSource="_ctorDemoData"
                                            @bind-TargetKeys="_ctorTargetData"
                                            Titles="@(new[] { _ctorSourceTitle, _ctorTargetTitle })"
                                            Searchable="_ctorSearchable"
                                            Size="_ctorSize"
                                            AllowDoubleClick="_ctorDoubleClick"
                                            ShowSelectAll="_ctorSelectAll"
                                            Disabled="_ctorDisabled" />
                            </div>
                        </SgStack>

                        <!-- Code with Copy -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                    <span id="copy-icon">@_copyIcon</span>
                                    <span id="copy-text" style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                </button>
                            </div>
                            <div class="code-block" id="code-block">
                                @foreach (var line in _generatedCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>
            </SgRow>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 9. Properties                                                      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                API Reference
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Full parameter reference for SgTransfer and SgTransferItem.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="SgTransfer Parameters (60+)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_transferProperties" />
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="SgTransferItem Model" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_itemProperties" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

</ChildContent>
</SgCard>

<style>
    /* ── Section layout ─────────────────────────────────────────────────────── */
    .demo-section {
        margin-top: 48px;
    }
    .demo-section-header {
        margin-bottom: 20px;
    }

    .demo-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }
    @@media (max-width: 768px) {
        .demo-two-col { grid-template-columns: 1fr; }
    }

    /* ── Constructor ────────────────────────────────────────────────────────── */
    .constructor-preview {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 16px;
        min-height: 100px;
        transition: all 0.3s ease;
    }
    .ctrl-summary {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 12px 14px;
    }

    /* ── Code block ─────────────────────────────────────────────────────────── */
    .code-block {
        background: #0f172a;
        color: #7dd3fc;
        padding: 14px 16px;
        border-radius: 8px;
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 12px;
        line-height: 1.9;
        overflow-x: auto;
        position: relative;
    }
    .code-block code {
        background: none;
        padding: 0;
        color: inherit;
        font-size: inherit;
        display: block;
        white-space: pre;
    }

    /* ── Copy button ────────────────────────────────────────────────────────── */
