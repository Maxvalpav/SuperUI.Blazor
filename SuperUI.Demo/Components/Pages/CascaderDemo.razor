    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add("<SgCascader");
        lines.Add($"    Options=\"_myOptions\"");
        lines.Add($"    Placeholder=\"{_ctorPlaceholder}\"");
        if (_ctorSize != SgSize.Md)
            lines.Add($"    Size=\"SgSize.{_ctorSize}\"");
        if (_ctorFilterable)
            lines.Add($"    Filterable=\"true\"");
        if (!_ctorShowClear)
            lines.Add($"    ShowClear=\"false\"");
        if (!_ctorBlock)
            lines.Add($"    Block=\"false\"");
        if (_ctorDisabled)
            lines.Add($"    Disabled=\"true\"");
        lines.Add($"    @bind-Value=\"_myValue\" />");
        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

