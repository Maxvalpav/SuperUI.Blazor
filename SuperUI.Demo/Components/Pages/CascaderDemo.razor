    {
        var lines = new List<string> { "<SgCascader", "    Options=\"_myOptions\"", $"    Placeholder=\"{_ctorPlaceholder}\"" };
        if (_ctorSize != SgSize.Md) lines.Add($"    Size=\"SgSize.{_ctorSize}\"");
        if (_ctorVariant != SgCascaderVariant.Outlined) lines.Add($"    Variant=\"SgCascaderVariant.{_ctorVariant}\"");
