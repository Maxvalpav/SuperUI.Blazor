@page "/cascader-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>Cascader — SgCascader — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Basic Usage                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgCascader — Basic Usage
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Multi-level cascaded selection for hierarchical data. Click to expand, click a leaf to select.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Location Picker" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgCascader Options="_locations"
                                @bind-Value="_selectedLocation"
                                Placeholder="Select location" />
                    <div class="demo-selected">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Medium" Color="var(--sg-text-muted)">
                            Selected path:
                        </SgTypography>
                        <SgTag Size="SgSize.Sm" Variant="SgTagVariant.Primary">
                            @if (_selectedLocation.Count > 0)
                            {
                                @string.Join(" → ", _selectedLocation.Select(v => GetLabel(_locations, v)))
                            }
                            else
                            {
                                <em style="opacity:0.6;">none</em>
                            }
                        </SgTag>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_basicProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Disabled Options & Sizes                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Disabled Options, Sizes, and Clear
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Options can be individually disabled. Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Size</SgTypography> to control the overall size. <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ShowClear</SgTypography> adds a clear button.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Disabled Option" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgCascader Options="_categories"
                                    @bind-Value="_selectedCategory"
                                    Placeholder="Select category" />
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                            "Laptops" is disabled and cannot be selected.
                        </SgTypography>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Size Variants" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Small</SgTypography>
                            <SgCascader Options="_simpleSizes" Placeholder="Small cascader" Size="SgSize.Sm" />
                        </SgStack>
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Medium (default)</SgTypography>
                            <SgCascader Options="_simpleSizes" Placeholder="Medium cascader" Size="SgSize.Md" />
                        </SgStack>
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Large</SgTypography>
                            <SgCascader Options="_simpleSizes" Placeholder="Large cascader" Size="SgSize.Lg" />
                        </SgStack>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Clear Button & Block" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">With clear (default)</SgTypography>
                            <SgCascader Options="_clearDemo" Placeholder="Select and clear" ShowClear="true" />
                        </SgStack>
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Without clear</SgTypography>
                            <SgCascader Options="_clearDemo" Placeholder="No clear button" ShowClear="false" />
                        </SgStack>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Disabled State" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgCascader Options="_locations" Placeholder="Disabled cascader" Disabled="true" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Filterable / Search                                             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Filterable — Search Across Hierarchy
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Enable <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Filterable</SgTypography> to search across all levels. Results show the full path to each match.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Filterable Cascader" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgCascader Options="_largeDataset"
                            Placeholder="Type to filter..."
                            Filterable="true"
                            ShowClear="true" />
            </SgCard>

            <SgCard Title="Property" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_filterProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Loading & Icons                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Loading, Icons, and Badges
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Show a loading spinner with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Loading</SgTypography>. Options support icons and badges.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Loading State" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgCascader Options="_locations" Placeholder="Loading..." Loading="@_loading" />
                        <SgButton Variant="SgButtonVariant.Outlined" Size="SgSize.Sm" @onclick="ToggleLoading">
                            @(_loading ? "Stop Loading" : "Simulate Loading")
                        </SgButton>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Options with Icons & Badges" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgCascader Options="_iconOptions"
                                Placeholder="Select with icons"
                                Filterable="true" />
                </SgCard>
            </SgCol>
            <SgCol Md="12">
                <SgCard Title="Option Model" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_optionProperties" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Large Dataset Demo                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Large Dataset — Department Store
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                A real-world example with departments, categories, and subcategories. Filterable for quick access.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="6">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgCascader Options="_departmentStore"
                                    @bind-Value="_selectedDepartment"
                                    Placeholder="Browse departments..."
                                    Filterable="true" />
                        @if (_selectedDepartment.Count > 0)
                        {
                            <div class="demo-selected">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Medium" Color="var(--sg-text-muted)">
                                    Selected:
                                </SgTypography>
                                <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:4px;">
                                    @foreach (var step in _selectedDepartment)
                                    {
                                        <SgTag Size="SgSize.Sm" Variant="SgTagVariant.Primary">@GetLabel(_departmentStore, step)</SgTag>
                                    }
                                </div>
                            </div>
                        }
                    </SgStack>
                </SgCol>
                <SgCol Xs="12" Md="6">
                    <PropertyTable Items="_cascaderAllProperties" />
                </SgCol>
            </SgRow>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. Live Constructor                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live SgCascader Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure parameters and see the result in real time. Click any option in the preview to select it. Click <strong>Copy</strong> to grab the generated code.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Placeholder -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Placeholder</SgTypography>
                            <input type="text"
                                   class="demo-ctor-input"
                                   value="@_ctorPlaceholder"
                                   @onchange="e => { _ctorPlaceholder = (string?)e.Value; UpdateConstructorCode(); }" />
                        </SgStack>

                        <!-- Size -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                            <SgSegmented TValue="SgSize"
                                         Value="@_ctorSize"
                                         ValueChanged="v => { _ctorSize = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_sizeOptions" />
                        </SgStack>

                        <!-- Toggles -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Filterable</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorFilterable"
                                                 ValueChanged="v => { _ctorFilterable = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">ShowClear</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorShowClear"
                                                 ValueChanged="v => { _ctorShowClear = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions2" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Block</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorBlock"
                                                 ValueChanged="v => { _ctorBlock = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Disabled</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorDisabled"
                                                 ValueChanged="v => { _ctorDisabled = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorSize.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Filterable</SgTypography>
                                    <SgBadge Variant="@(_ctorFilterable ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_ctorFilterable ? "Yes" : "No")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">ShowClear</SgTypography>
                                    <SgBadge Variant="@(_ctorShowClear ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_ctorShowClear ? "Yes" : "No")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Block</SgTypography>
                                    <SgBadge Variant="@(_ctorBlock ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_ctorBlock ? "Yes" : "No")" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <div class="constructor-preview">
                                <SgCascader Options="_constructorOptions"
                                            Placeholder="@_ctorPlaceholder"
                                            Size="@_ctorSize"
                                            Filterable="@_ctorFilterable"
                                            ShowClear="@_ctorShowClear"
                                            Block="@_ctorBlock"
                                            Disabled="@_ctorDisabled" />
                            </div>
                        </SgStack>

                        <!-- Code with Copy -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                    <span id="copy-icon">@_copyIcon</span>
                                    <span id="copy-text" style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                </button>
                            </div>
                            <div class="code-block" id="code-block">
                                @foreach (var line in _generatedCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

</ChildContent>
</SgCard>

<style>
    /* ── Section layout ─────────────────────────────────────────────────────── */
    .demo-section {
        margin-top: 48px;
    }
    .demo-section-header {
        margin-bottom: 20px;
    }
    .demo-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }
    @@media (max-width: 768px) {
        .demo-two-col { grid-template-columns: 1fr; }
    }

    /* ── Selected value display ─────────────────────────────────────────────── */
    .demo-selected {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 10px 14px;
    }

    /* ── Constructor input ──────────────────────────────────────────────────── */
    .demo-ctor-input {
        width: 100%;
        padding: 6px 10px;
        border: 1px solid var(--sg-border);
        border-radius: var(--sg-radius-md);
        background: var(--sg-bg);
        color: var(--sg-fg);
        font-size: 13px;
        font-family: inherit;
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
        box-sizing: border-box;
    }
    .demo-ctor-input:focus {
        border-color: var(--sg-color-primary);
        box-shadow: var(--sg-focus-ring);
    }

    /* ── Constructor ────────────────────────────────────────────────────────── */
    .constructor-preview {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 16px;
        min-height: 60px;
        transition: all 0.3s ease;
    }
    .ctrl-summary {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 12px 14px;
    }
    .code-block {
        background: #0f172a;
        color: #7dd3fc;
        padding: 14px 16px;
        border-radius: 8px;
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 12px;
        line-height: 1.9;
        overflow-x: auto;
        position: relative;
    }
    .code-block code {
        background: none;
        padding: 0;
        color: inherit;
        font-size: inherit;
        display: block;
        white-space: pre;
    }

    /* ── Copy button ────────────────────────────────────────────────────────── */
    .demo-copy-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 6px;
        padding: 4px 10px;
        cursor: pointer;
        color: var(--sg-text-muted);
        transition: all 0.2s ease;
        font-family: inherit;
    }
    .demo-copy-btn:hover {
        color: var(--sg-primary);
        border-color: var(--sg-primary);
        background: color-mix(in srgb, var(--sg-primary) 8%, transparent);
    }
    .demo-copy-btn:active {
        transform: scale(0.95);
    }
    .demo-copy-btn.copied {
        color: var(--sg-color-success);
        border-color: var(--sg-color-success);
    }
</style>

@code {
    // ── Main card header ─────────────────────────────────────────────────
    private RenderFragment _mainHeader => __builder =>
    {
        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
            <div style="display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,var(--sg-primary),#8b5cf6);color:#fff;flex-shrink:0;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/>
                </svg>
            </div>
            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">SgCascader</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Cascaded selection component for hierarchical data. Supports filtering, keyboard navigation, disabled options, icons, badges, loading state, and more.
                </SgTypography>
            </SgStack>
        </SgStack>
    };

    // ── Data ─────────────────────────────────────────────────────────────

    private List<string> _selectedLocation = new();
    private List<string> _selectedCategory = new();
    private List<string> _selectedDepartment = new();

    private bool _loading;
    private async Task ToggleLoading()
    {
        _loading = !_loading;
        await InvokeAsync(StateHasChanged);
    }

    private static string GetLabel(List<SgCascaderOption> options, string val)
    {
        var opt = FindOption(options, val);
        return opt?.Label ?? val;
    }

    private static SgCascaderOption? FindOption(List<SgCascaderOption> list, string val)
    {
        foreach (var o in list)
        {
            if (o.Value == val) return o;
            if (o.Children.Count > 0)
            {
                var child = FindOption(o.Children, val);
                if (child != null) return child;
            }
        }
        return null;
    }

