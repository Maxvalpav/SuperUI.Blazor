@page "/cascader-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>Cascader — SgCascader — SuperUI</PageTitle>

<SgSeoHead Description="Multi-level cascaded select with filtering, checkable mode, lazy loading, custom templates, placement control, group headers, and more. 20+ parameters — all optional." />

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="SgCascader" Subtitle="Multi-level cascaded select with filtering, checkable mode, lazy loading, custom templates, placement control, group headers, and more. 20+ parameters — all optional." />
    </HeaderContent>
    <ChildContent>

    <!-- 1. Basic Usage -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgCascader — Basic Usage
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Multi-level cascaded selection. Full path vs leaf display via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ValueDisplay</SgTypography>.
            </SgTypography>
        </div>
        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Full Path (default)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgCascader Options="_locations" @bind-Value="_selected1" Placeholder="Select location" />
                        <div class="demo-selected"><SgTag Size="SgSize.Sm" Variant="SgTagVariant.Primary">@(_selected1.Count > 0 ? string.Join(" → ", _selected1.Select(v => GetLabel(_locations, v))) : "none")</SgTag></div>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Leaf Only" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgCascader Options="_locations" @bind-Value="_selected2" Placeholder="Select location" ValueDisplay="SgCascaderValueDisplay.Leaf" />
                        <div class="demo-selected"><SgTag Size="SgSize.Sm" Variant="SgTagVariant.Success">@(_selected2.Count > 0 ? GetLabel(_locations, _selected2[^1]) : "none")</SgTag></div>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="12"><SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm"><PropertyTable Items="_basicProperties" /></SgCard></SgCol>
        </SgRow>
    </div>

    <!-- 2. Variants, Sizes, Disabled, Clear -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Variants, Sizes, Disabled, Clear
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Three visual variants, three sizes, clear button, and disabled state.
            </SgTypography>
        </div>
        <SgRow Space="SgSize.Lg">
            <SgCol Md="4">
                <SgCard Title="Outlined (default)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgCascader Options="_simple" Placeholder="Outlined" Variant="SgCascaderVariant.Outlined" />
                        <SgCascader Options="_simple" Placeholder="Disabled" Disabled="true" />
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Borderless" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgCascader Options="_simple" Placeholder="Borderless" Variant="SgCascaderVariant.Borderless" />
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Filled" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgCascader Options="_simple" Placeholder="Filled" Variant="SgCascaderVariant.Filled" />
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Sizes" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgCascader Options="_simple" Placeholder="Small" Size="SgSize.Sm" />
                        <SgCascader Options="_simple" Placeholder="Medium (default)" Size="SgSize.Md" />
                        <SgCascader Options="_simple" Placeholder="Large" Size="SgSize.Lg" />
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="ShowClear" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgCascader Options="_simple" Placeholder="With clear" ShowClear="true" />
                        <SgCascader Options="_simple" Placeholder="No clear" ShowClear="false" />
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="MaxHeight" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgCascader Options="_largeFlat" Placeholder="Max 160px" MaxHeight="160px" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- 3. Placement & Expand Trigger -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Placement & ExpandTrigger
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Dropdown placement and sub-level expand behavior.
            </SgTypography>
        </div>
        <SgRow Space="SgSize.Lg">
            <SgCol Md="4">
                <SgCard Title="BottomStart (default)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgCascader Options="_locations" Placeholder="Bottom start" Placement="SgPlacement.BottomStart" />
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="BottomEnd" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgCascader Options="_locations" Placeholder="Bottom end" Placement="SgPlacement.BottomEnd" />
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="TopStart" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgCascader Options="_locations" Placeholder="Top start" Placement="SgPlacement.TopStart" />
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="ExpandTrigger = Hover" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgCascader Options="_locations" Placeholder="Hover to expand" ExpandTrigger="SgCascaderExpandTrigger.Hover" />
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Sub-levels open on mouse hover (150ms debounce).</SgTypography>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="ExpandTrigger = Click (default)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgCascader Options="_locations" Placeholder="Click to expand" ExpandTrigger="SgCascaderExpandTrigger.Click" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- 4. Filterable + Highlight -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Filterable — Search with Highlight
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Set <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Filterable</SgTypography> to search across all levels. Matches are highlighted with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">&lt;mark&gt;</SgTypography>.
            </SgTypography>
        </div>
        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="With Search Path" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgCascader Options="_departmentStore" Placeholder="Type to filter..." Filterable="true" ShowSearchPath="true" />
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Without Search Path" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgCascader Options="_departmentStore" Placeholder="Type to filter..." Filterable="true" ShowSearchPath="false" />
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Empty Content Override" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgCascader Options="_simple" Placeholder="Type 'xyz'..." Filterable="true">
                        <EmptyContent><div style="padding:24px;text-align:center;color:var(--sg-color-warning);font-size:12px;">✨ Nothing found — try something else</div></EmptyContent>
                    </SgCascader>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Filter Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_filterProperties" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- 5. Group Headers, Icons, Badges -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Group Headers, Icons & Badges
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Group headers with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">IsGroup</SgTypography>. Icons and badges on options.
            </SgTypography>
        </div>
        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Grouped Options" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgCascader Options="_groupedOptions" Placeholder="Select..." Filterable="true" />
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Icons & Badges" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgCascader Options="_iconOptions" Placeholder="Select..." Filterable="true" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- 6. Checkable Multi-Select -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Checkable — Multi-Select
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Enable <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Checkable</SgTypography> for checkbox-based multi-selection.
            </SgTypography>
        </div>
        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Checkable Cascader" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgCascader Options="_simple" Checkable="true" Placeholder="Check items" @bind-CheckedValues="_checkedVals" />
                        <div class="demo-selected">
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Checked: </SgTypography>
                            <SgStack Horizontal Space="SgSize.Sm" Wrap="true">
                                @foreach (var v in _checkedVals) { <SgTag Size="SgSize.Sm">@v</SgTag> }
                                @if (_checkedVals.Count == 0) { <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)"><em>none</em></SgTypography> }
                            </SgStack>
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="DisabledOption Callback" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgCascader Options="_simple" Placeholder="Dynamic disabled" DisabledOption="@(o => o.Value == "opt2")" />
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Option Two is disabled via callback.</SgTypography>
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- 7. Lazy Loading & OnChange -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Lazy Loading & OnChange
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">OnLoadChildren</SgTypography> loads children async. <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">OnChange</SgTypography> returns the full option objects.
            </SgTypography>
        </div>
        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Lazy Load Regions" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgCascader Options="_lazyRoots" Placeholder="Select region..." OnLoadChildren="@LoadChildrenAsync" />
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="OnChange Callback" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgCascader Options="_locations" Placeholder="Select..." OnChange="HandleOnChange" />
                        <div class="demo-selected">
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Last selected: @_onChangeLog</SgTypography>
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- 8. OptionTemplate -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                OptionTemplate — Custom Rendering
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">OptionTemplate</SgTypography> to fully customize option rendering.
            </SgTypography>
        </div>
        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgCascader Options="_locations" Placeholder="Custom template..." Filterable="true">
                <OptionTemplate Context="ctx">
                    <span style="display:flex;align-items:center;gap:8px;width:100%;">
                        <span style="width:6px;height:6px;border-radius:50%;background:@(ctx.IsSelected ? "var(--sg-color-primary)" : ctx.HasChildren ? "#8b5cf6" : "#10b981");flex-shrink:0;"></span>
                        <span style="flex:1;">@ctx.Option.Label</span>
                        @if (ctx.HasChildren) { <span style="font-size:10px;color:var(--sg-fg-muted)">▸</span> }
                        @if (ctx.IsSelected) { <span style="font-size:10px;color:var(--sg-color-primary);font-weight:600;">✓</span> }
                    </span>
                </OptionTemplate>
            </SgCascader>
        </SgCard>
    </div>

    <!-- 9. Live Constructor -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live SgCascader Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure all parameters and see the result live. Click <strong>Copy</strong> for generated code.
            </SgTypography>
        </div>
        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Placeholder</SgTypography>
                            <input type="text" class="demo-ctor-input" value="@_ctorPlaceholder" @onchange="HandlePlaceholderChange" />
                        </SgStack>
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgSegmented TValue="SgSize" Value="@_ctorSize" ValueChanged="v => { _ctorSize = v; UpdateConstructorCode(); }" Block="true" Size="sm" Options="_sizeOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Variant</SgTypography>
                                    <SgSegmented TValue="SgCascaderVariant" Value="@_ctorVariant" ValueChanged="v => { _ctorVariant = v; UpdateConstructorCode(); }" Block="true" Size="sm" Options="_variantOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Placement</SgTypography>
                                    <SgSelect TValue="SgPlacement" Value="@_ctorPlacement" ValueChanged="v => { _ctorPlacement = v; UpdateConstructorCode(); }" Items="_placementItems" LabelSelector="x => x.ToString()" Block="true" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Expand</SgTypography>
                                    <SgSegmented TValue="SgCascaderExpandTrigger" Value="@_ctorExpand" ValueChanged="v => { _ctorExpand = v; UpdateConstructorCode(); }" Block="true" Size="sm" Options="_expandOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="4">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Filter</SgTypography>
                                    <SgSegmented TValue="bool" Value="_ctorFilterable" ValueChanged="v => { _ctorFilterable = v; UpdateConstructorCode(); }" Block="true" Size="sm" Options="_boolSeg" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="4">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Clear</SgTypography>
                                    <SgSegmented TValue="bool" Value="_ctorShowClear" ValueChanged="v => { _ctorShowClear = v; UpdateConstructorCode(); }" Block="true" Size="sm" Options="_boolSeg2" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="4">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Block</SgTypography>
                                    <SgSegmented TValue="bool" Value="_ctorBlock" ValueChanged="v => { _ctorBlock = v; UpdateConstructorCode(); }" Block="true" Size="sm" Options="_boolSeg" />
                                </SgStack>
                            </SgCol>
                        </SgRow>
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorSize.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Variant</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorVariant.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Placement</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorPlacement.ToString()" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>
                    </SgStack>
                </SgCol>
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <div class="constructor-preview">
                                <SgCascader Options="_constructorOptions"
                                            Placeholder="@_ctorPlaceholder"
                                            Size="@_ctorSize"
                                            Variant="@_ctorVariant"
                                            Placement="@_ctorPlacement"
                                            ExpandTrigger="@_ctorExpand"
                                            Filterable="@_ctorFilterable"
                                            ShowClear="@_ctorShowClear"
                                            Block="@_ctorBlock" />
                            </div>
                        </SgStack>
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" @onclick="CopyCodeToClipboard">
                                    <span>@_copyIcon</span>
                                    <span style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                </button>
                            </div>
                            <div class="code-block">
                                @foreach (var line in _generatedCodeLines) { <code>@line</code> }
                            </div>
                        </SgStack>
                    </SgStack>
                </SgCol>
            </SgRow>
        </SgCard>
    </div>

</ChildContent>
</SgCard>

<style>
    .demo-section { margin-top: 48px; }
    .demo-section-header { margin-bottom: 20px; }
    .demo-selected { background: var(--sg-surface-alt); border: 1px solid var(--sg-border); border-radius: 8px; padding: 10px 14px; }
    .demo-ctor-input { width:100%; padding:6px 10px; border:1px solid var(--sg-border); border-radius:var(--sg-radius-md); background:var(--sg-bg); color:var(--sg-fg); font-size:13px; font-family:inherit; outline:none; transition:border-color .15s ease; box-sizing:border-box; }
    .demo-ctor-input:focus { border-color:var(--sg-color-primary); box-shadow:var(--sg-focus-ring); }
    .constructor-preview { background:var(--sg-surface-alt); border:1px solid var(--sg-border); border-radius:8px; padding:16px; min-height:60px; transition:all .3s ease; }
    .ctrl-summary { background:var(--sg-surface-alt); border:1px solid var(--sg-border); border-radius:8px; padding:12px 14px; }
