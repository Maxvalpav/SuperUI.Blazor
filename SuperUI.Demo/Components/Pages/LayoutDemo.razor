@page "/layout-demo"
@using SuperUI.Components

<PageTitle>Макет и структура - SUI</PageTitle>

<SgCard Title="Компоненты макета и структуры" 
        Subtitle="Компоненты для создания адаптивных макетов и структурирования интерфейса.">
    <!-- SgRow & SgCol -->
    <div style="margin-top: 32px;">
        <h2>SgRow & SgCol - Сетка</h2>
        <p>Адаптивная Flexbox-сетка. По умолчанию 12 колонок, можно переключить на 24. Поддерживает Offset, Order, Push/Pull, Auto/Fill, Align/Justify и breakpoints xs/sm/md/lg/xl.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">12 колонок (100%)</div>
                        <SgRow Gutter="8px">
                            <SgCol Span="12"><div style="background: #1890ff; color: white; padding: 12px; border-radius: 4px; text-align: center;">12</div></SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">6 + 6 колонок</div>
                        <SgRow Gutter="8px">
                            <SgCol Span="6"><div style="background: #1890ff; color: white; padding: 12px; border-radius: 4px; text-align: center;">6</div></SgCol>
                            <SgCol Span="6"><div style="background: #0050b3; color: white; padding: 12px; border-radius: 4px; text-align: center;">6</div></SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">4 + 4 + 4 колонок</div>
                        <SgRow Gutter="8px">
                            <SgCol Span="4"><div style="background: #1890ff; color: white; padding: 12px; border-radius: 4px; text-align: center;">4</div></SgCol>
                            <SgCol Span="4"><div style="background: #0050b3; color: white; padding: 12px; border-radius: 4px; text-align: center;">4</div></SgCol>
                            <SgCol Span="4"><div style="background: #003a8c; color: white; padding: 12px; border-radius: 4px; text-align: center;">4</div></SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Auto + Fill (контент + остаток)</div>
                        <SgRow Gutter="8px">
                            <SgCol Auto="true"><div style="background: #1890ff; color: white; padding: 12px; border-radius: 4px;">Auto</div></SgCol>
                            <SgCol Fill="true"><div style="background: #0050b3; color: white; padding: 12px; border-radius: 4px; text-align: center;">Fill — занимает всё оставшееся пространство</div></SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Offset = 4 (смещение)</div>
                        <SgRow Gutter="8px">
                            <SgCol Span="4" Offset="4"><div style="background: #1890ff; color: white; padding: 12px; border-radius: 4px; text-align: center;">Span 4, Offset 4</div></SgCol>
                            <SgCol Span="4"><div style="background: #0050b3; color: white; padding: 12px; border-radius: 4px; text-align: center;">Span 4</div></SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Order — порядок отображения (визуально 2 → 1)</div>
                        <SgRow Gutter="8px">
                            <SgCol Span="6" Order="2"><div style="background: #1890ff; color: white; padding: 12px; border-radius: 4px; text-align: center;">Order 2 (в разметке первый)</div></SgCol>
                            <SgCol Span="6" Order="1"><div style="background: #0050b3; color: white; padding: 12px; border-radius: 4px; text-align: center;">Order 1</div></SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">24-колонная сетка (Columns="24")</div>
                        <SgRow Gutter="8px" Columns="24">
                            <SgCol Span="6"><div style="background: #1890ff; color: white; padding: 8px; border-radius: 4px; text-align: center;">6</div></SgCol>
                            <SgCol Span="6"><div style="background: #0050b3; color: white; padding: 8px; border-radius: 4px; text-align: center;">6</div></SgCol>
                            <SgCol Span="6"><div style="background: #003a8c; color: white; padding: 8px; border-radius: 4px; text-align: center;">6</div></SgCol>
                            <SgCol Span="6"><div style="background: #002766; color: white; padding: 8px; border-radius: 4px; text-align: center;">6</div></SgCol>
                        </SgRow>
                    </div>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_gridProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgStack -->
    <div style="margin-top: 32px;">
        <h2>SgStack - Стек</h2>
        <p>Компонент для линейного расположения элементов с управлением выравниванием и промежутками.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Горизонтальный стек</div>
                        <SgStack Orientation="SgOrientation.Horizontal" Gap="8px">
                            <SgButton Text="Кнопка 1" Size="SgSize.Sm" />
                            <SgButton Text="Кнопка 2" Size="SgSize.Sm" />
                            <SgButton Text="Кнопка 3" Size="SgSize.Sm" />
                        </SgStack>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Вертикальный стек</div>
                        <SgStack Orientation="SgOrientation.Vertical" Gap="8px">
                            <SgButton Text="Кнопка 1" Size="SgSize.Sm" Block="true" />
                            <SgButton Text="Кнопка 2" Size="SgSize.Sm" Block="true" />
                            <SgButton Text="Кнопка 3" Size="SgSize.Sm" Block="true" />
                        </SgStack>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Justify=SpaceBetween, Align=Center</div>
                        <SgStack Gap="8px"
                                 Justify="SgJustifyContent.SpaceBetween"
                                 Align="SgAlignItems.Center"
                                 Padding="8px 12px"
                                 Background="var(--sui-bg-secondary, #fafafa)">
                            <span style="font-weight:600;">Заголовок</span>
                            <SgButton Text="Действие" Size="SgSize.Sm" />
                        </SgStack>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Wrap + RowGap/ColumnGap</div>
                        <SgStack Wrap="true" RowGap="6px" ColumnGap="12px">
                            @for (int i = 1; i <= 8; i++)
                            {
                                <SgChip Text="@($"Тег {i}")" />
                            }
                        </SgStack>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Inline + Reverse</div>
                        <SgStack Inline="true" Reverse="true" Gap="6px">
                            <SgBadge Text="Раз" />
                            <SgBadge Text="Два" />
                            <SgBadge Text="Три" />
                        </SgStack>
                    </div>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_stackProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgCard -->
    <div style="margin-top: 32px;">
        <h2>SgCard - Карточка</h2>
        <p>Компонент для группировки и отображения контента в виде карточки.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgCard Title="Стандартная карточка" Subtitle="С заголовком и подзаголовком">
                        <p style="margin: 0; color: var(--sui-text-muted);">Содержимое карточки с описанием.</p>
                    </SgCard>
                    <SgCard Title="Карточка с действиями">
                        <p style="margin: 0; color: var(--sui-text-muted);">Карточка с кнопками действий.</p>
                    </SgCard>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_cardProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgDivider -->
    <div style="margin-top: 32px;">
        <h2>SgDivider - Разделитель</h2>
        <p>Компонент для визуального разделения контента.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Горизонтальный</div>
                        <div>Текст выше</div>
                        <SgDivider />
                        <div>Текст ниже</div>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">С текстом</div>
                        <SgDivider Text="Или" />
                    </div>
                    <div style="display: flex; gap: 12px; align-items: center;">
                        <div style="font-size: 12px; color: var(--sui-text-muted);">Вертикальный</div>
                        <SgDivider Vertical="true" />
                        <div style="font-size: 12px; color: var(--sui-text-muted);">Разделитель</div>
                    </div>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_dividerProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgSplitter -->
    <div style="margin-top: 32px;">
        <h2>SgSplitter - Разделитель с изменением размера</h2>
        <p>Компонент для создания изменяемых по размеру областей.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Горизонтальный сплиттер (лево/право)" Style="grid-column: 1 / -1;">
                <div style="height: 250px; border: 1px solid var(--sui-border); border-radius: 4px; overflow: hidden;">
                    <SgSplitter Orientation="SgOrientation.Horizontal" Size="150">
                        <First>
                            <div style="padding: 12px; background: #fafafa; height: 100%; border-right: 1px solid var(--sui-border);">
                                <div style="font-weight: 600; margin-bottom: 8px;">Левая панель</div>
                                <div style="font-size: 12px; color: var(--sui-text-muted);">Перетащите разделитель вправо/влево</div>
                            </div>
                        </First>
                        <Second>
                            <div style="padding: 12px; background: white; height: 100%;">
                                <div style="font-weight: 600; margin-bottom: 8px;">Правая панель</div>
                                <div style="font-size: 12px; color: var(--sui-text-muted);">Основной контент</div>
                            </div>
                        </Second>
                    </SgSplitter>
                </div>
            </SgCard>

            <!-- Вертикальный сплиттер -->
            <SgCard Title="Вертикальный сплиттер (верх/низ)" Style="grid-column: 1 / -1;">
                <div style="height: 300px; border: 1px solid var(--sui-border); border-radius: 4px; overflow: hidden;">
                    <SgSplitter Orientation="SgOrientation.Vertical" Size="120">
                        <First>
                            <div style="padding: 12px; background: #fafafa; height: 100%; border-bottom: 1px solid var(--sui-border);">
                                <div style="font-weight: 600; margin-bottom: 8px;">Верхняя панель</div>
                                <div style="font-size: 12px; color: var(--sui-text-muted);">Перетащите разделитель вверх/вниз</div>
                            </div>
                        </First>
                        <Second>
                            <div style="padding: 12px; background: white; height: 100%;">
                                <div style="font-weight: 600; margin-bottom: 8px;">Нижняя панель</div>
                                <div style="font-size: 12px; color: var(--sui-text-muted);">Основной контент</div>
                            </div>
                        </Second>
                    </SgSplitter>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента" Style="grid-column: 1 / -1;">
                <PropertyTable Items="_splitterProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgHeader & SgFooter -->
    <div style="margin-top: 32px;">
        <h2>SgHeader & SgFooter - Шапка и подвал</h2>
        <p>Компоненты для создания шапки и подвала приложения.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgHeader Title="SuperUI" Subtitle="v1.0.0" />
                    <SgFooter Copyright="© 2024 SuperUI Team" Version="1.0.0" />
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_headerFooterProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Code examples -->
    <div style="margin-top: 32px;">
        <h2>Примеры кода</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="SgRow & SgCol — сетка">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_gridCode" />
            </SgCard>
            <SgCard Title="SgStack — стек">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_stackCode" />
            </SgCard>
            <SgCard Title="SgCard — карточка">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_cardCode" />
            </SgCard>
            <SgCard Title="SgDivider — разделитель">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_dividerCode" />
            </SgCard>
        </div>
    </div>

</SgCard>

