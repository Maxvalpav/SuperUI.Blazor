        new() { Label = "Vertical", Value = "bool", BadgeText = "Вертикальный", BadgeVariant = "warn" },
        new() { Label = "Dashed", Value = "bool", BadgeText = "Пунктир", BadgeVariant = "warn" },
        new() { Label = "Orientation", Value = "left|center|right", BadgeText = "Позиция", BadgeVariant = "info" }
    };

    private List<PropertyPanelItem> _splitterProperties = new()
    {
        new() { Label = "Orientation", Value = "horizontal|vertical", BadgeText = "Ориентация", BadgeVariant = "info" },
        new() { Label = "Size", Value = "double", BadgeText = "Размер", BadgeVariant = "info" },
        new() { Label = "Min", Value = "double", BadgeText = "Минимум", BadgeVariant = "info" },
        new() { Label = "Max", Value = "double", BadgeText = "Максимум", BadgeVariant = "info" }
