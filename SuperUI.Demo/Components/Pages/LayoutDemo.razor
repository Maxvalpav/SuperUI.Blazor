@page "/layout-demo"
@using SuperUI.Components

<PageTitle>Макет и структура - SUI</PageTitle>

<SgCard Title="Компоненты макета и структуры" 
        Subtitle="Компоненты для создания адаптивных макетов и структурирования интерфейса.">
    <!-- SgRow & SgCol -->
    <div style="margin-top: 32px;">
        <h2>SgRow & SgCol - Сетка</h2>
        <p>Адаптивная сетка на основе Flexbox с поддержкой 24-колонной системы.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">24 колонки (100%)</div>
                        <SgRow Gutter="8px">
                            <SgCol Span="24"><div style="background: #1890ff; color: white; padding: 12px; border-radius: 4px; text-align: center;">24</div></SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">12 + 12 колонок</div>
                        <SgRow Gutter="8px">
                            <SgCol Span="12"><div style="background: #1890ff; color: white; padding: 12px; border-radius: 4px; text-align: center;">12</div></SgCol>
                            <SgCol Span="12"><div style="background: #0050b3; color: white; padding: 12px; border-radius: 4px; text-align: center;">12</div></SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">8 + 8 + 8 колонок</div>
                        <SgRow Gutter="8px">
                            <SgCol Span="8"><div style="background: #1890ff; color: white; padding: 12px; border-radius: 4px; text-align: center;">8</div></SgCol>
                            <SgCol Span="8"><div style="background: #0050b3; color: white; padding: 12px; border-radius: 4px; text-align: center;">8</div></SgCol>
                            <SgCol Span="8"><div style="background: #003a8c; color: white; padding: 12px; border-radius: 4px; text-align: center;">8</div></SgCol>
                        </SgRow>
                    </div>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_gridProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgStack -->
    <div style="margin-top: 32px;">
        <h2>SgStack - Стек</h2>
        <p>Компонент для линейного расположения элементов с управлением выравниванием и промежутками.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Горизонтальный стек</div>
                        <SgStack Orientation="SgOrientation.Horizontal" Gap="8px">
                            <SgButton Text="Кнопка 1" Size="SgSize.Sm" />
                            <SgButton Text="Кнопка 2" Size="SgSize.Sm" />
                            <SgButton Text="Кнопка 3" Size="SgSize.Sm" />
                        </SgStack>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Вертикальный стек</div>
                        <SgStack Orientation="SgOrientation.Vertical" Gap="8px">
                            <SgButton Text="Кнопка 1" Size="SgSize.Sm" Block="true" />
                            <SgButton Text="Кнопка 2" Size="SgSize.Sm" Block="true" />
                            <SgButton Text="Кнопка 3" Size="SgSize.Sm" Block="true" />
                        </SgStack>
                    </div>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_stackProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgCard -->
    <div style="margin-top: 32px;">
        <h2>SgCard - Карточка</h2>
        <p>Компонент для группировки и отображения контента в виде карточки.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgCard Title="Стандартная карточка" Subtitle="С заголовком и подзаголовком">
                        <p style="margin: 0; color: var(--sui-text-muted);">Содержимое карточки с описанием.</p>
                    </SgCard>
                    <SgCard Title="Карточка с действиями">
                        <p style="margin: 0; color: var(--sui-text-muted);">Карточка с кнопками действий.</p>
                    </SgCard>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_cardProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgDivider -->
    <div style="margin-top: 32px;">
        <h2>SgDivider - Разделитель</h2>
        <p>Компонент для визуального разделения контента.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Горизонтальный</div>
                        <div>Текст выше</div>
                        <SgDivider />
                        <div>Текст ниже</div>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">С текстом</div>
                        <SgDivider Text="Или" />
                    </div>
                    <div style="display: flex; gap: 12px; align-items: center;">
                        <div style="font-size: 12px; color: var(--sui-text-muted);">Вертикальный</div>
                        <SgDivider Vertical="true" />
                        <div style="font-size: 12px; color: var(--sui-text-muted);">Разделитель</div>
                    </div>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_dividerProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgSplitter -->
    <div style="margin-top: 32px;">
        <h2>SgSplitter - Разделитель с изменением размера</h2>
        <p>Компонент для создания изменяемых по размеру областей.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Горизонтальный сплиттер (лево/право)" Style="grid-column: 1 / -1;">
                <div style="height: 250px; border: 1px solid var(--sui-border); border-radius: 4px; overflow: hidden;">
                    <SgSplitter Orientation="SgOrientation.Horizontal" Size="150">
                        <First>
                            <div style="padding: 12px; background: #fafafa; height: 100%; border-right: 1px solid var(--sui-border);">
                                <div style="font-weight: 600; margin-bottom: 8px;">Левая панель</div>
                                <div style="font-size: 12px; color: var(--sui-text-muted);">Перетащите разделитель вправо/влево</div>
                            </div>
                        </First>
                        <Second>
                            <div style="padding: 12px; background: white; height: 100%;">
                                <div style="font-weight: 600; margin-bottom: 8px;">Правая панель</div>
                                <div style="font-size: 12px; color: var(--sui-text-muted);">Основной контент</div>
                            </div>
                        </Second>
                    </SgSplitter>
                </div>
            </SgCard>

            <!-- Вертикальный сплиттер -->
            <SgCard Title="Вертикальный сплиттер (верх/низ)" Style="grid-column: 1 / -1;">
                <div style="height: 300px; border: 1px solid var(--sui-border); border-radius: 4px; overflow: hidden;">
                    <SgSplitter Orientation="SgOrientation.Vertical" Size="120">
                        <First>
                            <div style="padding: 12px; background: #fafafa; height: 100%; border-bottom: 1px solid var(--sui-border);">
                                <div style="font-weight: 600; margin-bottom: 8px;">Верхняя панель</div>
                                <div style="font-size: 12px; color: var(--sui-text-muted);">Перетащите разделитель вверх/вниз</div>
                            </div>
                        </First>
                        <Second>
                            <div style="padding: 12px; background: white; height: 100%;">
                                <div style="font-weight: 600; margin-bottom: 8px;">Нижняя панель</div>
                                <div style="font-size: 12px; color: var(--sui-text-muted);">Основной контент</div>
                            </div>
                        </Second>
                    </SgSplitter>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента" Style="grid-column: 1 / -1;">
                <PropertyTable Items="_splitterProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgHeader & SgFooter -->
    <div style="margin-top: 32px;">
        <h2>SgHeader & SgFooter - Шапка и подвал</h2>
        <p>Компоненты для создания шапки и подвала приложения.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgHeader Title="SuperUI" Subtitle="v1.0.0" />
                    <SgFooter Copyright="© 2024 SuperUI Team" Version="1.0.0" />
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_headerFooterProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Code examples -->
    <div style="margin-top: 32px;">
        <h2>Примеры кода</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="SgRow & SgCol — сетка">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_gridCode" />
            </SgCard>
            <SgCard Title="SgStack — стек">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_stackCode" />
            </SgCard>
            <SgCard Title="SgCard — карточка">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_cardCode" />
            </SgCard>
            <SgCard Title="SgDivider — разделитель">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_dividerCode" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private List<PropertyPanelItem> _gridProperties = new()
    {
        new() { Label = "Span", Value = "int (1-24)", BadgeText = "Колонки", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Gutter", Value = "string", BadgeText = "Промежуток", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Offset", Value = "int", BadgeText = "Смещение", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Xs/Sm/Md/Lg/Xl", Value = "int", BadgeText = "Адаптив", BadgeVariant = SgBadgeVariant.Info }
    };

    private List<PropertyPanelItem> _stackProperties = new()
    {
        new() { Label = "Orientation", Value = "horizontal|vertical", BadgeText = "Направление", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Gap", Value = "string", BadgeText = "Промежуток", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Align", Value = "string", BadgeText = "Выравнивание", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Justify", Value = "string", BadgeText = "Распределение", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Wrap", Value = "bool", BadgeText = "Перенос", BadgeVariant = SgBadgeVariant.Warn }
    };

    private List<PropertyPanelItem> _cardProperties = new()
    {
        new() { Label = "Title", Value = "string", BadgeText = "Заголовок", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Subtitle", Value = "string", BadgeText = "Подзаголовок", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Hoverable", Value = "bool", BadgeText = "Эффект", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Bordered", Value = "bool", BadgeText = "Граница", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Содержимое", BadgeVariant = SgBadgeVariant.Info }
    };

    private List<PropertyPanelItem> _dividerProperties = new()
    {
        new() { Label = "Text", Value = "string", BadgeText = "Текст", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Vertical", Value = "bool", BadgeText = "Вертикальный", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Dashed", Value = "bool", BadgeText = "Пунктир", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Orientation", Value = "left|center|right", BadgeText = "Позиция", BadgeVariant = SgBadgeVariant.Info }
    };

    private List<PropertyPanelItem> _splitterProperties = new()
    {
        new() { Label = "Orientation", Value = "horizontal|vertical", BadgeText = "Ориентация", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Size", Value = "double", BadgeText = "Размер", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Min", Value = "double", BadgeText = "Минимум", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Max", Value = "double", BadgeText = "Максимум", BadgeVariant = SgBadgeVariant.Info }
    };

    private List<PropertyPanelItem> _headerFooterProperties = new()
    {
        new() { Label = "Title",     Value = "string", BadgeText = "Заголовок",       BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Subtitle",  Value = "string", BadgeText = "Подзаголовок",    BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Copyright", Value = "string", BadgeText = "Авторские права", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Version",   Value = "string", BadgeText = "Версия",          BadgeVariant = SgBadgeVariant.Info }
    };

    // ── Code snippets ─────────────────────────────────────────────────────────
    private string _gridCode = """
        <!-- 24-колонная сетка -->
        <SgRow Gutter="16px">
            <SgCol Span="24">Полная ширина</SgCol>
        </SgRow>

        <SgRow Gutter="16px">
            <SgCol Span="12">Половина</SgCol>
            <SgCol Span="12">Половина</SgCol>
        </SgRow>

        <SgRow Gutter="16px">
            <SgCol Span="8">Треть</SgCol>
            <SgCol Span="8">Треть</SgCol>
            <SgCol Span="8">Треть</SgCol>
        </SgRow>

        <!-- Адаптивные колонки -->
        <SgRow Gutter="16px">
            <SgCol Xs="24" Sm="12" Md="8" Lg="6">Адаптивная</SgCol>
            <SgCol Xs="24" Sm="12" Md="8" Lg="6">Адаптивная</SgCol>
        </SgRow>
        """;

    private string _stackCode = """
        <!-- Горизонтальный стек -->
        <SgStack Orientation="SgOrientation.Horizontal" Gap="8px">
            <SgButton Text="Кнопка 1" />
            <SgButton Text="Кнопка 2" />
            <SgButton Text="Кнопка 3" />
        </SgStack>

        <!-- Вертикальный стек -->
        <SgStack Orientation="SgOrientation.Vertical" Gap="12px">
            <SgTextBox TValue="string" Label="Поле 1" />
            <SgTextBox TValue="string" Label="Поле 2" />
        </SgStack>

        <!-- С выравниванием -->
        <SgStack Orientation="SgOrientation.Horizontal"
                 Gap="8px"
                 Align="center"
                 Justify="space-between">
            <span>Слева</span>
            <span>Справа</span>
        </SgStack>
        """;

    private string _cardCode = """
        <!-- Базовая карточка -->
        <SgCard Title="Заголовок" Subtitle="Подзаголовок">
            <p>Содержимое карточки.</p>
        </SgCard>

        <!-- С действиями в заголовке -->
        <SgCard Title="Пользователи">
            <ActionContent>
                <SgButton Text="Добавить" Variant=SgButtonVariant.Primary" Size="SgSize.Sm" />
            </ActionContent>
            <ChildContent>
                <p>Список пользователей.</p>
            </ChildContent>
        </SgCard>

        <!-- С футером -->
        <SgCard Title="Карточка">
            <ChildContent>Содержимое</ChildContent>
            <FooterContent>
                <SgButton Text="Подробнее" Variant="SgButtonVariant.Ghost" />
            </FooterContent>
        </SgCard>

        <!-- Hoverable -->
        <SgCard Title="Наведите" Hoverable="true">
            <p>Эффект при наведении.</p>
        </SgCard>
        """;

    private string _dividerCode = """
        <!-- Горизонтальный -->
        <SgDivider />

        <!-- С текстом -->
        <SgDivider Text="Или" />

        <!-- Пунктирный -->
        <SgDivider Dashed="true" />

        <!-- Вертикальный (inline) -->
        <div style="display:flex;align-items:center;gap:8px;">
            <span>Текст</span>
            <SgDivider Vertical="true" />
            <span>Текст</span>
        </div>
        """;
}


