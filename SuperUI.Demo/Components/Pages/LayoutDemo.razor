@page "/layout-demo"
@using SuperUI.Components

<PageTitle>Макет и структура - SUI</PageTitle>

<SgCard Title="Компоненты макета и структуры" 
        Subtitle="Компоненты для создания адаптивных макетов и структурирования интерфейса.">
    <!-- SgRow & SgCol -->
    <div style="margin-top: 32px;">
        <h2>SgRow & SgCol - Сетка</h2>
        <p>Адаптивная сетка на основе Flexbox с поддержкой 24-колонной системы.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">24 колонки (100%)</div>
                        <SgRow Gutter="8px">
                            <SgCol Span="24"><div style="background: #1890ff; color: white; padding: 12px; border-radius: 4px; text-align: center;">24</div></SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">12 + 12 колонок</div>
                        <SgRow Gutter="8px">
                            <SgCol Span="12"><div style="background: #1890ff; color: white; padding: 12px; border-radius: 4px; text-align: center;">12</div></SgCol>
                            <SgCol Span="12"><div style="background: #0050b3; color: white; padding: 12px; border-radius: 4px; text-align: center;">12</div></SgCol>
                        </SgRow>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">8 + 8 + 8 колонок</div>
                        <SgRow Gutter="8px">
                            <SgCol Span="8"><div style="background: #1890ff; color: white; padding: 12px; border-radius: 4px; text-align: center;">8</div></SgCol>
                            <SgCol Span="8"><div style="background: #0050b3; color: white; padding: 12px; border-radius: 4px; text-align: center;">8</div></SgCol>
                            <SgCol Span="8"><div style="background: #003a8c; color: white; padding: 12px; border-radius: 4px; text-align: center;">8</div></SgCol>
                        </SgRow>
                    </div>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_gridProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgStack -->
    <div style="margin-top: 32px;">
        <h2>SgStack - Стек</h2>
        <p>Компонент для линейного расположения элементов с управлением выравниванием и промежутками.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Горизонтальный стек</div>
                        <SgStack Orientation="horizontal" Gap="8px">
                            <SgButton Text="Кнопка 1" Size="sm" />
                            <SgButton Text="Кнопка 2" Size="sm" />
                            <SgButton Text="Кнопка 3" Size="sm" />
                        </SgStack>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Вертикальный стек</div>
                        <SgStack Orientation="vertical" Gap="8px">
                            <SgButton Text="Кнопка 1" Size="sm" Block="true" />
                            <SgButton Text="Кнопка 2" Size="sm" Block="true" />
                            <SgButton Text="Кнопка 3" Size="sm" Block="true" />
                        </SgStack>
                    </div>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_stackProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgCard -->
    <div style="margin-top: 32px;">
        <h2>SgCard - Карточка</h2>
        <p>Компонент для группировки и отображения контента в виде карточки.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgCard Title="Стандартная карточка" Subtitle="С заголовком и подзаголовком">
                        <p style="margin: 0; color: var(--sui-text-muted);">Содержимое карточки с описанием.</p>
                    </SgCard>
                    <SgCard Title="Карточка с действиями">
                        <p style="margin: 0; color: var(--sui-text-muted);">Карточка с кнопками действий.</p>
                    </SgCard>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_cardProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgDivider -->
    <div style="margin-top: 32px;">
        <h2>SgDivider - Разделитель</h2>
        <p>Компонент для визуального разделения контента.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Горизонтальный</div>
                        <div>Текст выше</div>
                        <SgDivider />
                        <div>Текст ниже</div>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">С текстом</div>
                        <SgDivider Text="Или" />
                    </div>
                    <div style="display: flex; gap: 12px; align-items: center;">
                        <div style="font-size: 12px; color: var(--sui-text-muted);">Вертикальный</div>
                        <SgDivider Vertical="true" />
                        <div style="font-size: 12px; color: var(--sui-text-muted);">Разделитель</div>
                    </div>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_dividerProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgSplitter -->
    <div style="margin-top: 32px;">
        <h2>SgSplitter - Разделитель с изменением размера</h2>
        <p>Компонент для создания изменяемых по размеру областей.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Горизонтальный сплиттер (лево/право)" Style="grid-column: 1 / -1;">
                <div style="height: 250px; border: 1px solid var(--sui-border); border-radius: 4px; overflow: hidden;">
                    <SgSplitter Orientation="horizontal" Size="150">
                        <First>
                            <div style="padding: 12px; background: #fafafa; height: 100%; border-right: 1px solid var(--sui-border);">
                                <div style="font-weight: 600; margin-bottom: 8px;">Левая панель</div>
                                <div style="font-size: 12px; color: var(--sui-text-muted);">Перетащите разделитель вправо/влево</div>
                            </div>
                        </First>
                        <Second>
                            <div style="padding: 12px; background: white; height: 100%;">
                                <div style="font-weight: 600; margin-bottom: 8px;">Правая панель</div>
                                <div style="font-size: 12px; color: var(--sui-text-muted);">Основной контент</div>
                            </div>
                        </Second>
                    </SgSplitter>
                </div>
            </SgCard>

            <!-- Вертикальный сплиттер -->
            <SgCard Title="Вертикальный сплиттер (верх/низ)" Style="grid-column: 1 / -1;">
                <div style="height: 300px; border: 1px solid var(--sui-border); border-radius: 4px; overflow: hidden;">
                    <SgSplitter Orientation="vertical" Size="120">
                        <First>
                            <div style="padding: 12px; background: #fafafa; height: 100%; border-bottom: 1px solid var(--sui-border);">
                                <div style="font-weight: 600; margin-bottom: 8px;">Верхняя панель</div>
                                <div style="font-size: 12px; color: var(--sui-text-muted);">Перетащите разделитель вверх/вниз</div>
                            </div>
                        </First>
                        <Second>
                            <div style="padding: 12px; background: white; height: 100%;">
                                <div style="font-weight: 600; margin-bottom: 8px;">Нижняя панель</div>
                                <div style="font-size: 12px; color: var(--sui-text-muted);">Основной контент</div>
                            </div>
                        </Second>
                    </SgSplitter>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента" Style="grid-column: 1 / -1;">
                <PropertyTable Items="_splitterProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgHeader & SgFooter -->
    <div style="margin-top: 32px;">
        <h2>SgHeader & SgFooter - Шапка и подвал</h2>
        <p>Компоненты для создания шапки и подвала приложения.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgHeader Title="SuperUI" Subtitle="v1.0.0" />
                    <SgFooter Copyright="© 2024 SuperUI Team" Version="1.0.0" />
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_headerFooterProperties" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private List<PropertyPanelItem> _gridProperties = new()
    {
        new() { Label = "Span", Value = "int (1-24)", BadgeText = "Колонки", BadgeVariant = "info" },
        new() { Label = "Gutter", Value = "string", BadgeText = "Промежуток", BadgeVariant = "info" },
        new() { Label = "Offset", Value = "int", BadgeText = "Смещение", BadgeVariant = "info" },
        new() { Label = "Xs/Sm/Md/Lg/Xl", Value = "int", BadgeText = "Адаптив", BadgeVariant = "info" }
    };

    private List<PropertyPanelItem> _stackProperties = new()
    {
        new() { Label = "Orientation", Value = "horizontal|vertical", BadgeText = "Направление", BadgeVariant = "info" },
        new() { Label = "Gap", Value = "string", BadgeText = "Промежуток", BadgeVariant = "info" },
        new() { Label = "Align", Value = "string", BadgeText = "Выравнивание", BadgeVariant = "info" },
        new() { Label = "Justify", Value = "string", BadgeText = "Распределение", BadgeVariant = "info" },
        new() { Label = "Wrap", Value = "bool", BadgeText = "Перенос", BadgeVariant = "warn" }
    };

    private List<PropertyPanelItem> _cardProperties = new()
    {
        new() { Label = "Title", Value = "string", BadgeText = "Заголовок", BadgeVariant = "info" },
        new() { Label = "Subtitle", Value = "string", BadgeText = "Подзаголовок", BadgeVariant = "info" },
        new() { Label = "Hoverable", Value = "bool", BadgeText = "Эффект", BadgeVariant = "warn" },
        new() { Label = "Bordered", Value = "bool", BadgeText = "Граница", BadgeVariant = "warn" },
