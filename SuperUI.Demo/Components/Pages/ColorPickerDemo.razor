@page "/color-picker-demo"
@using SuperUI.Components

<PageTitle>Выбор цвета - SUI</PageTitle>

<SgCard Title="SgColorPicker - Выбор цвета" 
        Subtitle="Компонент для выбора цвета. Поддерживает различные форматы (HEX, RGB) и предустановки.">
    <!-- SgColorPicker -->
    <div style="margin-top: 32px;">
        <h2>Примеры использования</h2>
        <p>Интерактивный выбор цвета с предпросмотром.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Выбор цвета">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <label style="display: block; font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px; text-transform: uppercase;">Основной цвет</label>
                        <SgColorPicker @bind-Value="_primaryColor" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px; text-transform: uppercase;">Вторичный цвет</label>
                        <SgColorPicker @bind-Value="_secondaryColor" />
                    </div>
                    <div style="padding: 16px; background: var(--sui-bg-secondary); border-radius: 8px;">
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Выбранные цвета:</div>
                        <div style="display: flex; gap: 12px;">
                            <div style="width: 40px; height: 40px; background: @_primaryColor; border-radius: 4px; border: 1px solid var(--sui-border);"></div>
                            <div style="width: 40px; height: 40px; background: @_secondaryColor; border-radius: 4px; border: 1px solid var(--sui-border);"></div>
                        </div>
                    </div>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_colorPickerProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Code example -->
    <div style="margin-top: 32px;">
        <h2>Примеры кода</h2>
    </div>

</SgCard>

@code {
    private string _primaryColor = "#1568c6";
    private string _secondaryColor = "#52c41a";

    private List<PropertyPanelItem> _colorPickerProperties = new()
    {
        new() { Label = "Value",        Value = "string",                  BadgeText = "Значение HEX",  BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Placeholder",  Value = "string",                  BadgeText = "Подсказка",     BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Disabled",     Value = "bool",                    BadgeText = "Отключен",      BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowAlpha",    Value = "bool",                    BadgeText = "Альфа-канал",   BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Format",       Value = "string",                  BadgeText = "Формат",        BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ValueChanged", Value = "EventCallback<string>",   BadgeText = "Событие",       BadgeVariant = SgBadgeVariant.Success }
    };
}
