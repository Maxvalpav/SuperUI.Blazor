@page "/affix-demo"

<PageTitle>Affix - SUI</PageTitle>

<SgCard Title="SgAffix"
        Subtitle="Закрепляет элемент в области просмотра при прокрутке за заданный порог.">

    <div style="display: flex; flex-direction: column; gap: 32px; margin-top: 24px;">

        <!-- ─── Top affix ─── -->
        <SgCard Title="Закрепление сверху" Subtitle="OffsetTop=&quot;0&quot;">
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div style="display: flex; gap: 8px; align-items: center; font-size: 12px; color: var(--sui-text-muted);">
                    <span>Состояние:</span>
                    <SgBadge Text="@(_topAffixed ? "Pinned" : "Inline")"
                             Variant="@(_topAffixed ? SgBadgeVariant.Success : SgBadgeVariant.Default)" />
                </div>

                <SgAffix OffsetTop="0" Target=".sui-content" AffixedChanged="@(b => _topAffixed = b)">
                    <Template>
                        <div class="affix-bar @(context ? "affix-bar-pinned" : "")">
                            <strong>📌 Sticky toolbar</strong>
                            <span style="color: var(--sui-text-muted); font-size: 12px;">
                                @(context ? "Я закреплён сверху" : "Я остаюсь у верхнего края при скролле")
                            </span>
                            <SgButton Text="Action" Variant="SgButtonVariant.Primary" Size="SgSize.Sm" Style="margin-left:auto;" />
                        </div>
                    </Template>
                </SgAffix>

                <div class="scroll-filler">Длинный контент для демонстрации скролла…</div>
            </div>
        </SgCard>

        <!-- ─── Top with offset ─── -->
        <SgCard Title="С отступом сверху" Subtitle="OffsetTop=&quot;72&quot; — пин ниже header'а">
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <SgAffix OffsetTop="72" Target=".sui-content">
                    <div class="affix-bar">
                        <strong>Закрепляется через 72&nbsp;px</strong>
                        <span style="color: var(--sui-text-muted); font-size: 12px;">
                            Полезно, если есть фиксированный header.
                        </span>
                    </div>
                </SgAffix>

                <div class="scroll-filler" style="height: 600px;">Скроллите дальше…</div>
            </div>
        </SgCard>

        <!-- ─── Bottom affix ─── -->
        <SgCard Title="Закрепление снизу" Subtitle="OffsetBottom=&quot;0&quot;">
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div style="height: 400px;" class="scroll-filler">
                    Доскроллите вниз — панель появится у нижнего края экрана.
                </div>

                <SgAffix OffsetBottom="0" Target=".sui-content" AffixedChanged="@(b => _bottomAffixed = b)">
                    <Template>
                        <div class="affix-bar @(context ? "affix-bar-pinned" : "")"
                             style="display: flex; align-items: center; gap: 12px;">
                            <strong>⬇ Bottom action bar</strong>
                            <span style="color: var(--sui-text-muted); font-size: 12px;">
                                @(context ? "Я прижат к низу" : "Появлюсь у нижнего края при скролле")
                            </span>
                            <div style="margin-left: auto; display: flex; gap: 6px;">
                                <SgButton Text="Save" Variant="SgButtonVariant.Primary" Size="SgSize.Sm" />
                                <SgButton Text="Cancel" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
                            </div>
                        </div>
                    </Template>
                </SgAffix>
            </div>
        </SgCard>

        <!-- ─── Custom container ─── -->
        <SgCard Title="В произвольном контейнере"
                Subtitle="Target=&quot;.affix-container&quot; — собственная область прокрутки">
            <div class="affix-container">
                <SgAffix OffsetTop="0" Target=".affix-container">
                    <div class="affix-bar">
                        <strong>📦 Закреплён внутри контейнера</strong>
                        <span style="color: var(--sui-text-muted); font-size: 12px;">
                            Скролл слежения — у этого блока, не у окна.
                        </span>
                    </div>
                </SgAffix>

                <div style="padding: 16px; color: var(--sui-text-muted);">
                    @for (var i = 1; i <= 30; i++)
                    {
                        <p>Строка контейнера #@i</p>
                    }
                </div>
            </div>
        </SgCard>

        <!-- ─── Properties ─── -->
        <SgCard Title="Свойства SgAffix">
            <PropertyTable Items="_props" />
        </SgCard>

        <!-- Code example -->
    </div>

</SgCard>

<style>
    .affix-bar {
        background: var(--sui-bg-primary);
        border: 1px solid var(--sui-border);
        border-radius: var(--sui-radius-md);
        padding: 12px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: background-color .2s ease, border-color .2s ease;
    }

    .affix-bar-pinned {
        background: color-mix(in srgb, var(--sui-bg-primary) 88%, var(--sui-accent));
        border-color: var(--sui-accent);
    }

    .scroll-filler {
        height: 600px;
        padding: 16px;
        border: 1px dashed var(--sui-border);
        border-radius: var(--sui-radius-md);
        color: var(--sui-text-muted);
        background: linear-gradient(180deg, transparent, var(--sui-bg-secondary));
    }

    .affix-container {
        position: relative;
        height: 320px;
        overflow-y: auto;
        border: 1px solid var(--sui-border);
        border-radius: var(--sui-radius-md);
        background: var(--sui-bg-secondary);
    }
</style>

@code {
    private bool _topAffixed;
    private bool _bottomAffixed;

    private List<PropertyPanelItem> _props = new()
    {
        new() { Label = "OffsetTop",       Value = "int? (default 0)",        BadgeText = "Порог сверху",           BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "OffsetBottom",    Value = "int?",                    BadgeText = "Порог снизу",            BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Target",          Value = "string?",                 BadgeText = "CSS-селектор контейнера",BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "AffixedChanged",  Value = "EventCallback<bool>",     BadgeText = "Событие",               BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnAffix",         Value = "EventCallback",           BadgeText = "При закреплении",        BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnUnaffix",       Value = "EventCallback",           BadgeText = "При откреплении",        BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "ChildContent",    Value = "RenderFragment",          BadgeText = "Содержимое",             BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Template",        Value = "RenderFragment<bool>",    BadgeText = "Зависит от состояния",   BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "RefreshAsync()",  Value = "метод",                   BadgeText = "Принудительный пересчёт",BadgeVariant = SgBadgeVariant.Warn }
    };
}
