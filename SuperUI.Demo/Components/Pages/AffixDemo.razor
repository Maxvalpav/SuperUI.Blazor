@page "/affix-demo"

<PageTitle>Affix - SUI</PageTitle>

<SgCard Title="SgAffix - Закрепление при скролле"
        Subtitle="Фиксирует элемент в области просмотра, когда страница прокручивается мимо заданного порога.">

    <div style="margin-top: 32px;">
        <h2>Закрепление сверху</h2>
        <p>Прокрутите страницу — панель ниже «прилипнет» к верхнему краю при достижении порога 0&nbsp;px.</p>

        <SgAffix OffsetTop="0">
            <div style="background: var(--sui-bg-primary); border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); padding: 12px 16px; display:flex; align-items:center; gap: 12px;">
                <strong>Sticky toolbar</strong>
                <span style="color: var(--sui-muted); font-size: 12px;">Я остаюсь у верхнего края при скролле.</span>
                <SgButton Text="Action" Variant="primary" Size="sm" Style="margin-left:auto;" />
            </div>
        </SgAffix>

        <div style="margin-top: 16px; height: 800px; padding: 16px; border: 1px dashed var(--sui-border); border-radius: var(--sui-radius-md); color: var(--sui-muted);">
            Длинный контент для демонстрации скролла…
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Закрепление снизу</h2>
        <p>Панель «прилипает» к нижнему краю окна, когда находится за пределами видимости.</p>

        <SgAffix OffsetBottom="0">
            <div style="background: var(--sui-bg-primary); border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); padding: 12px 16px;">
                <strong>Sticky bottom bar</strong>
                <span style="color: var(--sui-muted); font-size: 12px; margin-left: 8px;">Я появлюсь у нижнего края экрана.</span>
            </div>
        </SgAffix>

        <div style="height: 600px; margin-top: 16px;"></div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Свойства</h2>
        <SgCard Title="SgAffix" Style="margin-top: 16px;">
            <PropertyTable Items="_props" />
        </SgCard>
    </div>
</SgCard>

@code {
    private List<PropertyPanelItem> _props = new()
    {
        new() { Label = "OffsetTop", Value = "int? (default 0)", BadgeText = "Порог сверху", BadgeVariant = "info" },
        new() { Label = "OffsetBottom", Value = "int?", BadgeText = "Порог снизу", BadgeVariant = "info" },
        new() { Label = "Target", Value = "string?", BadgeText = "CSS-селектор контейнера", BadgeVariant = "info" },
        new() { Label = "AffixedChanged", Value = "EventCallback<bool>", BadgeText = "Событие", BadgeVariant = "success" },
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Содержимое", BadgeVariant = "info" }
    };
}
