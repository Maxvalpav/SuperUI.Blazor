@page "/affix-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>Affix — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>
        <div class="demo-section">
            <SgTypography Color="var(--sg-text-muted)" Leading="SgTypographyLeading.Relaxed">
                Sticky component that fixes an element when it scrolls past a threshold. Supports window scroll and custom scroll containers.
            </SgTypography>
        </div>

        <!-- Section 1: Top Affix -->
        <div class="demo-section">
            <div class="demo-section-header">
                <SgStack Horizontal Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center">
                    <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Sticky Top</SgTypography>
                    <SgBadge Text="Interactive" Variant="SgBadgeVariant.Success" Size="SgSize.Sm" Standalone />
                </SgStack>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Fixes the element at the top edge when scrolling down. Use the sliders to adjust threshold and Z-index.
                </SgTypography>
            </div>

            <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm" Style="background:var(--sg-bg-subtle);">
                <SgStack Horizontal Space="SgSize.Xl" Align="SgAlignItems.End" Wrap="true">
                    <div style="width: 150px;">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)" Style="margin-bottom:4px;display:block;">OffsetTop (px)</SgTypography>
                        <SgSlider @bind-Value="_topOffset" Min="0" Max="200" Step="1" OnChange="() => _topAffix?.RefreshAsync()" />
                    </div>
                    <div style="width: 150px;">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)" Style="margin-bottom:4px;display:block;">Z-Index</SgTypography>
                        <SgSlider @bind-Value="_topZIndex" Min="1" Max="999" Step="1" OnChange="() => _topAffix?.RefreshAsync()" />
                    </div>
                    <SgBadge Text="@(_topAffixed ? "📌 Pinned" : "Inline")" Variant="@(_topAffixed ? SgBadgeVariant.Info : SgBadgeVariant.Default)" Style="margin-bottom: 8px;" />
                </SgStack>
            </SgCard>

            <div class="affix-demo-scroll-area">
                <SgAffix OffsetTop="@_topOffset"
                         Target=".sui-content"
                         ZIndex="@_topZIndex"
                         AffixedChanged="@(b => { _topAffixed = b; StateHasChanged(); })"
                         @ref="_topAffix">
                    <Template>
                        <div class="sticky-toolbar @(context ? "pinned" : "")">
                            <SgStack Horizontal Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center" Style="width:100%;">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                    <SgIcon Icon="@SgIcons.Star" Size="16px" />
                                    <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm">Sticky Toolbar</SgTypography>
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm">
                                    <SgButton Text="Refresh" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" OnClick="() => _topAffix?.RefreshAsync()" />
                                    <SgButton Text="Action" Variant="SgButtonVariant.Primary" Size="SgSize.Sm" />
                                </SgStack>
                            </SgStack>
                        </div>
                    </Template>
                </SgAffix>

                <div class="filler-text">
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Scroll down to see the toolbar pin to the top.
                    </SgTypography>
                    @for (int i = 1; i <= 10; i++) { <p>Placeholder content row #@i</p> }
                </div>
            </div>
        </div>

        <!-- Section 2: Bottom Affix -->
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Sticky Bottom</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Pins to the bottom edge. Useful for action bars or footers.
                </SgTypography>
            </div>

            <div class="affix-demo-scroll-area">
                <div class="filler-text">
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Scroll further to trigger the bottom action bar.
                    </SgTypography>
                    @for (int i = 1; i <= 8; i++) { <p>More content row #@i</p> }
                </div>

                <SgAffix OffsetBottom="@_bottomOffset"
                         Target=".sui-content"
                         AffixedChanged="@(b => { _bottomAffixed = b; StateHasChanged(); })"
                         @ref="_bottomAffix">
                    <Template>
                        <div class="sticky-toolbar bottom @(context ? "pinned-bottom" : "")">
                            <SgStack Horizontal Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center" Style="width:100%;">
                                <SgTypography Weight="SgTypographyWeight.Medium" Size="SgTypographySize.Sm">Bottom Actions</SgTypography>
                                <SgStack Horizontal Space="SgSize.Sm">
                                    <SgButton Text="Cancel" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
                                    <SgButton Text="Save Changes" Variant="SgButtonVariant.Success" Size="SgSize.Sm" />
                                </SgStack>
                            </SgStack>
                        </div>
                    </Template>
                </SgAffix>
            </div>
        </div>

        <!-- Section 3: Custom Container -->
        <div class="sgc-demo-section" style="padding: 32px;">
            <div class="demo-section-header" style="margin-bottom: 24px;">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Custom Scroll Container</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Works within any element with overflow: auto by specifying the target selector.
                </SgTypography>
            </div>

            <div class="custom-container" style="height: 240px; overflow-y: auto; border: 1px solid var(--sg-border); border-radius: 12px; background: var(--sg-surface-alt); position: relative;">
                <SgAffix OffsetTop="0" Target=".custom-container">
                    <div class="container-header" style="padding: 12px 16px; background: var(--sg-color-primary); color: #fff; border-bottom: 1px solid var(--sg-border);">
                        <SgTypography Weight="SgTypographyWeight.Bold" Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase">Pinned Header</SgTypography>
                    </div>
                </SgAffix>
                <div style="padding: 16px;">
                    @for (int i = 1; i <= 20; i++) { 
                        <div style="padding: 8px 0; border-bottom: 1px solid var(--sg-border-subtle);">
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Internal scroll item #@i</SgTypography>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── Properties Reference ─────────────────────────────────────────────── *@
        <div class="sgc-demo-section" style="padding: 32px; background: var(--sg-surface-alt);">
            <div class="demo-section-header" style="margin-bottom: 24px;">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Bold">Properties Reference</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">API parameters for the SgAffix component.</SgTypography>
            </div>

            <SgCard Style="border-radius: 16px; border: 1px solid var(--sg-border-subtle);">
                <PropertyTable Items="_affixProperties" />
            </SgCard>
        </div>
    </ChildContent>
</SgCard>

<style>
    .sgc-demo-section { border-bottom: 1px solid var(--sg-border-subtle); }
    .sgc-demo-section:last-child { border-bottom: none; }

    .affix-demo-scroll-area { 
        margin-top: 24px; 
        border: 1px dashed var(--sg-border); 
        border-radius: 16px;
        padding: 32px;
        background: var(--sg-bg);
    }

    .sticky-toolbar {
        padding: 12px 24px;
        background: var(--sg-bg);
        border: 1px solid var(--sg-border);
        border-radius: 12px;
        box-shadow: var(--sg-shadow-sm);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 10;
    }
    .sticky-toolbar.pinned { 
        border-color: var(--sg-color-primary);
        box-shadow: var(--sg-shadow-lg);
        background: var(--sg-bg);
    }
    .sticky-toolbar.pinned-bottom {
        border-color: var(--sg-color-success);
        box-shadow: var(--sg-shadow-lg);
        background: var(--sg-bg);
    }

    .filler-text { padding: 32px 0; }
</style>

@code {
    private SgAffix? _topAffix;
    private SgAffix? _bottomAffix;
    private bool _topAffixed;
    private bool _bottomAffixed;
    private int _topOffset = 0;
    private int _bottomOffset = 0;
    private int _topZIndex = 100;

    private List<PropertyPanelItem> _affixProperties = new()
    {
        new() { Label = "OffsetTop",    Value = "int? (default 0)",        BadgeText = "Trigger point", BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "OffsetBottom", Value = "int?",                    BadgeText = "Trigger point", BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Target",       Value = "string? (default window)", BadgeText = "Scroll container", BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "ZIndex",       Value = "int (default 100)",       BadgeText = "Visual layer",  BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "AffixedChanged", Value = "EventCallback<bool>",    BadgeText = "Event",         BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "RefreshAsync", Value = "Method",                  BadgeText = "Force update",  BadgeVariant = SgBadgeVariant.Default },
    };

    private RenderFragment _mainHeader => __builder =>
    {
        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
            <div style="width: 40px; height: 40px; background: var(--sg-color-primary); color: #fff; border-radius: 10px; display: flex; align-items: center; justify-content: center; box-shadow: var(--sg-shadow-md);">
                <SgIcon Icon="@SgIcons.Star" Size="24px" />
            </div>
            <div>
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="line-height: 1.2;">Affix</SgTypography>
                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Pin elements to the viewport or container</SgTypography>
            </div>
        </SgStack>
    };
}