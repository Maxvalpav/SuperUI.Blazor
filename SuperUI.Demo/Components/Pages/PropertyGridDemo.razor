@page "/property-grid"
@using SuperUI.Components
@using SuperUI.Demo.Models

<PageTitle>Сетка свойств - SUI</PageTitle>

<SgCard Title="SgPropertyGrid - Сетка свойств" 
        Subtitle="Компонент для редактирования свойств объектов. Поддерживает категоризацию, подсказки и различные типы входных данных.">
    <!-- SgPropertyGrid -->
    <div style="margin-top: 32px;">
        <h2>Редактор свойств</h2>
        <p>Интерактивный редактор для изменения свойств объекта.</p>
        
        <div class="demo-grid-two-col">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Предпросмотр объекта</div>
                        <SgDescriptions Columns="1" Bordered="false" Items="_settingsItems" />
                    </div>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_propertyGridProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Object Editor -->
    <div style="margin-top: 32px;">
        <h2>Редактор объекта</h2>
        <p>Полный редактор свойств с поддержкой категорий.</p>
        
        <SgCard Title="Редактор объекта" Style="margin-top: 16px;">
            <div style="height: 500px; border: 1px solid var(--sui-border); border-radius: 8px; overflow: auto;">
                <SgPropertyGrid SelectedObject="_settings" OnPropertyValueChanged="StateHasChanged" />
            </div>
        </SgCard>
    </div>
</SgCard>

@code {
    private WidgetSettings _settings = new();

    private List<DescriptionItem> _settingsItems = new()
    {
        new() { Label = "Название", Value = "Main Dashboard Widget" },
        new() { Label = "Включено", Value = "Да" },
        new() { Label = "Интервал обновления", Value = "5000 ms" },
        new() { Label = "Тема", Value = "Dark" }
    };

    private List<PropertyPanelItem> _propertyGridProperties = new()
    {
        new() { Label = "SelectedObject", Value = "object", BadgeText = "Объект", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ShowToolbar", Value = "bool", BadgeText = "Панель", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "GroupByLines", Value = "bool", BadgeText = "Группировка", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowValidation", Value = "bool", BadgeText = "Валидация", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowValidationSummary", Value = "bool", BadgeText = "Сводка", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowRequiredIndicator", Value = "bool", BadgeText = "Обязательные", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "SearchPlaceholder", Value = "string", BadgeText = "Подсказка", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "EmptyText", Value = "string", BadgeText = "Пусто", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ValidationSummaryTitle", Value = "string", BadgeText = "Заголовок", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "OnPropertyValueChanged", Value = "EventCallback", BadgeText = "Событие", BadgeVariant = SgBadgeVariant.Success }
    };

    public class WidgetSettings
    {
        [SgProperty(Category = "General", Description = "Name of the widget")]
        public string Name { get; set; } = "Main Dashboard Widget";

        [SgProperty(Category = "General", Description = "Enable or disable widget")]
        public bool IsEnabled { get; set; } = true;

        [SgProperty(Category = "Appearance", Description = "Visual theme")]
        public string Theme { get; set; } = "Dark";

        [SgProperty(Category = "Performance", Description = "Data refresh interval in milliseconds")]
        public int RefreshRate { get; set; } = 5000;

        [SgProperty(Category = "Appearance", Description = "Border thickness")]
        public int BorderWidth { get; set; } = 1;
    }
}

