@page "/http-api-tester"
@using SuperUI.Components

<PageTitle>HTTP API Tester - SuperUI Demo</PageTitle>

<div style="padding:16px 20px 8px 20px;">
    <h1 style="margin:0 0 4px 0;">HTTP API Tester</h1>
    <p style="color:var(--sg-text-muted); margin:0 0 12px 0;">
        A powerful HTTP client for testing REST APIs, similar to Postman.
    </p>

    <SgTabs>
        <SgTabPanel Title="Full Version">
            <div style="height:calc(100vh - 160px); min-height:720px; border:1px solid var(--sg-border); border-radius:6px; overflow:hidden; display:flex; margin-top:8px;">
                <SgHttpApiTesterFull />
            </div>
        </SgTabPanel>

        <SgTabPanel Title="WebSocket Client">
            <div style="max-width:1200px;">
                <SgHttpApiTesterWsPanel />
            </div>
        </SgTabPanel>

        <SgTabPanel Title="Mock Server">
            <div style="max-width:1200px;">
                <SgHttpApiTesterMockServerPanel Endpoints="_mockEndpoints" />
            </div>
        </SgTabPanel>

        <SgTabPanel Title="Statistics">
            <div style="max-width:1200px;">
                <SgHttpApiTesterStatsPanel Stats="_stats" />
            </div>
        </SgTabPanel>
    </SgTabs>
</div>

@code {
    private SgHttpApiTester? _apiTester;
    private List<MockEndpoint> _mockEndpoints = new();
    private List<RequestStat> _stats = new();
    
    private List<DescriptionItem> _headerItems = new()
    {
        new DescriptionItem { Label = "Component", Value = "HTTP API Tester" },
        new DescriptionItem { Label = "Description", Value = "A powerful HTTP client for testing REST APIs, similar to Postman. Send requests, inspect responses, write tests, and more." }
    };

    protected override void OnInitialized()
    {
        // Initialize with sample mock endpoints
        _mockEndpoints.Add(new MockEndpoint
        {
            Enabled = true,
            Method = "GET",
            Path = "/api/users",
            StatusCode = 200,
            ContentType = "application/json",
            Body = "[{\"id\":1,\"name\":\"John\"},{\"id\":2,\"name\":\"Jane\"}]",
            DelayMs = 100
        });

        _mockEndpoints.Add(new MockEndpoint
        {
            Enabled = false,
            Method = "POST",
            Path = "/api/login",
            StatusCode = 200,
            ContentType = "application/json",
            Body = "{\"token\":\"abc123\",\"expires\":3600}",
            DelayMs = 200
        });

        // Initialize with sample stats
        var random = new Random();
        for (int i = 1; i <= 20; i++)
        {
            _stats.Add(new RequestStat
            {
                Label = $"Request #{i}",
                Ms = random.Next(50, 500),
                Status = random.Next(0, 10) > 1 ? 200 : 500,
                Bytes = random.Next(500, 5000),
                Success = random.Next(0, 10) > 1
            });
        }
    }

    private void LoadJsonPlaceholderExample()
    {
        // Implementation for loading example
    }

    private void LoadReqresExample()
    {
        // Implementation for loading example
    }

    private void LoadPostExample()
    {
        // Implementation for loading example
    }

    private void LoadAuthExample()
    {
        // Implementation for loading example
    }
}
