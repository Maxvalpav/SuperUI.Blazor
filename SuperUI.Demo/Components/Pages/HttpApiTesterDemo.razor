@page "/http-api-tester"
@using SuperUI.Components

<PageTitle>HTTP API Tester - SuperUI Demo</PageTitle>

<div style="padding:20px;">
    <SgStack Direction="SgDirection.Vertical" Gap="16">
        
        <div>
            <h1 style="margin:0 0 8px 0;">HTTP API Tester</h1>
            <p style="color:var(--sg-text-muted); margin:0;">
                A powerful HTTP client for testing REST APIs, similar to Postman. 
                Send requests, inspect responses, write tests, and more.
            </p>
        </div>

        <SgDivider />

        <SgTabs>
            <SgTabPanel Title="Simple Version">
                <SgCard>
                    <h3 style="margin:0 0 12px 0;">Simple API Tester</h3>
                    <p style="color:var(--sg-text-muted); margin:0 0 16px 0;">
                        Basic version with single request/response panel.
                    </p>
                    <SgHttpApiTester />
                </SgCard>
            </SgTabPanel>

            <SgTabPanel Title="Full Version">
                <div style="margin-bottom:16px;">
                    <SgDescriptions Items="_headerItems" Column="1" />
                </div>
                <div style="height:calc(100vh - 280px); min-height:700px; border:1px solid var(--sg-border); border-radius:4px;">
                    <SgHttpApiTesterFull Style="height:100%;" />
                </div>
            </SgTabPanel>

            <SgTabPanel Title="Quick Examples">
                <SgCard>
                    <h3 style="margin:0 0 12px 0;">Quick Start Examples</h3>
                    <SgStack Direction="SgDirection.Horizontal" Gap="8" Style="flex-wrap:wrap;">
                        <SgButton Variant="SgButtonVariant.Default" OnClick="LoadJsonPlaceholderExample">
                            📝 JSONPlaceholder API
                        </SgButton>
                        <SgButton Variant="SgButtonVariant.Default" OnClick="LoadReqresExample">
                            👤 Reqres API
                        </SgButton>
                        <SgButton Variant="SgButtonVariant.Default" OnClick="LoadPostExample">
                            📮 POST Example
                        </SgButton>
                        <SgButton Variant="SgButtonVariant.Default" OnClick="LoadAuthExample">
                            🔐 Auth Example
                        </SgButton>
                    </SgStack>
                </SgCard>
            </SgTabPanel>

            <SgTabPanel Title="WebSocket Client">
                <div style="max-width:1200px;">
                    <SgHttpApiTesterWsPanel />
                </div>
            </SgTabPanel>

            <SgTabPanel Title="Mock Server">
                <div style="max-width:1200px;">
                    <SgHttpApiTesterMockServerPanel Endpoints="_mockEndpoints" />
                </div>
            </SgTabPanel>

            <SgTabPanel Title="Statistics">
                <div style="max-width:1200px;">
                    <SgHttpApiTesterStatsPanel Stats="_stats" />
                </div>
            </SgTabPanel>

            <SgTabPanel Title="Features & Documentation">
                <SgCard>
                    <h3 style="margin:0 0 12px 0;">Features</h3>
                    <SgStack Direction="SgDirection.Vertical" Gap="8">
                        <div>
                            <strong>✅ Multiple HTTP Methods:</strong> GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS
                        </div>
                        <div>
                            <strong>✅ Request Configuration:</strong> Headers, Query Parameters, Body (JSON, XML, Form, Text)
                        </div>
                        <div>
                            <strong>✅ Authentication:</strong> Bearer Token, Basic Auth, API Key, OAuth 2.0
                        </div>
                        <div>
                            <strong>✅ Response Viewer:</strong> Pretty-printed JSON, Grid view for arrays, Headers, Timeline
                        </div>
                        <div>
                            <strong>✅ Test Scripts:</strong> Write assertions to validate responses
                        </div>
                        <div>
                            <strong>✅ Collections:</strong> Save and organize requests (Full version)
                        </div>
                        <div>
                            <strong>✅ History:</strong> Track all sent requests (Full version)
                        </div>
                        <div>
                            <strong>✅ WebSocket Client:</strong> Connect and test WebSocket endpoints
                        </div>
                        <div>
                            <strong>✅ Mock Server:</strong> Create mock endpoints for testing
                        </div>
                        <div>
                            <strong>✅ Statistics:</strong> Track request performance and success rates
                        </div>
                        <div>
                            <strong>✅ Bulk Operations:</strong> Bulk paste headers and parameters
                        </div>
                    </SgStack>
                </SgCard>

                <SgCard Style="margin-top:16px;">
                    <h3 style="margin:0 0 12px 0;">Usage Example - Simple Version</h3>
                    <pre style="background:var(--sg-bg-alt); padding:12px; border-radius:4px; overflow:auto; font-size:12px; font-family:monospace;">@@page "/api-testing"
@@using SuperUI.Components

&lt;SgHttpApiTester /&gt;</pre>
                </SgCard>

                <SgCard Style="margin-top:16px;">
                    <h3 style="margin:0 0 12px 0;">Usage Example - Full Version</h3>
                    <pre style="background:var(--sg-bg-alt); padding:12px; border-radius:4px; overflow:auto; font-size:12px; font-family:monospace;">@@page "/api-testing"
@@using SuperUI.Components

&lt;div style="height:100vh;"&gt;
    &lt;SgHttpApiTesterFull /&gt;
&lt;/div&gt;</pre>
                </SgCard>

                <SgCard Style="margin-top:16px;">
                    <h3 style="margin:0 0 12px 0;">Test Script Examples</h3>
                    <pre style="background:var(--sg-bg-alt); padding:12px; border-radius:4px; overflow:auto; font-size:12px; font-family:monospace;">// Check status code
pm.test('Status is 200', () => pm.ResponseStatus == 200);

// Check response time
pm.test('Response time is less than 500ms', () => pm.ResponseTime &lt; 500);

// Check response body contains text
pm.expect(pm.ResponseBody).toContain('success');

// Save value to environment
pm.environment.set('userId', pm.ResponseJson['id']);

// Add custom header for next request
pm.request.setHeader('X-Custom-Header', 'value');</pre>
                </SgCard>
            </SgTabPanel>
        </SgTabs>

    </SgStack>
</div>

@code {
    private SgHttpApiTester? _apiTester;
    private List<MockEndpoint> _mockEndpoints = new();
    private List<RequestStat> _stats = new();
    
    private List<DescriptionItem> _headerItems = new()
    {
        new DescriptionItem { Label = "Component", Value = "HTTP API Tester" },
        new DescriptionItem { Label = "Description", Value = "A powerful HTTP client for testing REST APIs, similar to Postman. Send requests, inspect responses, write tests, and more." }
    };

    protected override void OnInitialized()
    {
        // Initialize with sample mock endpoints
        _mockEndpoints.Add(new MockEndpoint
        {
            Enabled = true,
            Method = "GET",
            Path = "/api/users",
            StatusCode = 200,
            ContentType = "application/json",
            Body = "[{\"id\":1,\"name\":\"John\"},{\"id\":2,\"name\":\"Jane\"}]",
            DelayMs = 100
        });

        _mockEndpoints.Add(new MockEndpoint
        {
            Enabled = false,
            Method = "POST",
            Path = "/api/login",
            StatusCode = 200,
            ContentType = "application/json",
            Body = "{\"token\":\"abc123\",\"expires\":3600}",
            DelayMs = 200
        });

        // Initialize with sample stats
        var random = new Random();
        for (int i = 1; i <= 20; i++)
        {
            _stats.Add(new RequestStat
            {
                Label = $"Request #{i}",
                Ms = random.Next(50, 500),
                Status = random.Next(0, 10) > 1 ? 200 : 500,
                Bytes = random.Next(500, 5000),
                Success = random.Next(0, 10) > 1
            });
        }
    }

    private void LoadJsonPlaceholderExample()
    {
        // Implementation for loading example
    }

    private void LoadReqresExample()
    {
        // Implementation for loading example
    }

    private void LoadPostExample()
    {
        // Implementation for loading example
    }

    private void LoadAuthExample()
    {
        // Implementation for loading example
    }
}
