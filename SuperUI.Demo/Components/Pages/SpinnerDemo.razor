@page "/spinner-demo"
@using SuperUI.Components

<PageTitle>Spinner — SUI</PageTitle>

<div style="max-width: 1400px; margin: 0 auto; padding: 40px 20px;">
    <SgCard Title="Компоненты индикаторов загрузки"
            Subtitle="SgSpinner: аккуратный, доступный, с остановкой анимации, размерами, Overlay и цветом через Variant.">

        <!-- SgSpinner -->
        <div style="margin-top: 32px;">
            <h2>SgSpinner — Индикатор загрузки</h2>
            <p>Удобный спиннер для страниц и кнопок. Поддерживает размеры <code>SgSize</code>, контроль анимации через <code>IsSpinning</code>, loader overlay через <code>Overlay</code> и цвет через <code>Variant</code>.</p>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
                <SgCard Title="Примеры использования">
                    <div style="display: flex; flex-direction: column; gap: 16px;">

                        <div>
                            <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Размеры</div>
                            <div style="display: flex; gap: 16px; flex-wrap: wrap; align-items: center;">
                                <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                                    <SgSpinner Size="SgSize.Sm" />
                                    <span style="font-size:11px;color:var(--sui-text-secondary);">Sm</span>
                                </div>
                                <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                                    <SgSpinner Size="SgSize.Md" />
                                    <span style="font-size:11px;color:var(--sui-text-secondary);">Md</span>
                                </div>
                                <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                                    <SgSpinner Size="SgSize.Lg" />
                                    <span style="font-size:11px;color:var(--sui-text-secondary);">Lg</span>
                                </div>
                                <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                                    <SgSpinner Size="SgSize.Xl" />
                                    <span style="font-size:11px;color:var(--sui-text-secondary);">Xl</span>
                                </div>
                            </div>
                        </div>

                        <SgDivider />

                        <div>
                            <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Анимация (IsSpinning)</div>
                            <div style="display:flex; gap: 24px; flex-wrap: wrap; align-items: center;">
                                <div style="display:flex; flex-direction:column; gap: 8px; align-items:flex-start;">
                                    <SgSpinner Size="SgSize.Md" Label="Загрузка активна" IsSpinning="true" />
                                    <span style="font-size:11px;color:var(--sui-text-secondary);">IsSpinning=true</span>
                                </div>

                                <div style="display:flex; flex-direction:column; gap: 8px; align-items:flex-start;">
                                    <SgSpinner Size="SgSize.Md" Label="Загрузка приостановлена" IsSpinning="false" />
                                    <span style="font-size:11px;color:var(--sui-text-secondary);">IsSpinning=false</span>
                                </div>
                            </div>
                            <div style="margin-top: 10px; font-size: 12px; color: var(--sui-text-secondary);">
                                При паузе сохраняется место в верстке, а вращение останавливается.
                            </div>
                        </div>

                        <SgDivider />

                        <div>
                            <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Variant (цвет)</div>
                            <div style="display:flex; gap: 18px; flex-wrap: wrap; align-items: center;">
                                <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                                    <SgSpinner Size="SgSize.Md" Variant="SgSpinnerVariant.Default" Label="Default" />
                                    <span style="font-size:11px;color:var(--sui-text-secondary);">Default</span>
                                </div>
                                <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                                    <SgSpinner Size="SgSize.Md" Variant="SgSpinnerVariant.Info" Label="Info" />
                                    <span style="font-size:11px;color:var(--sui-text-secondary);">Info</span>
                                </div>
                                <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                                    <SgSpinner Size="SgSize.Md" Variant="SgSpinnerVariant.Success" Label="Success" />
                                    <span style="font-size:11px;color:var(--sui-text-secondary);">Success</span>
                                </div>
                                <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                                    <SgSpinner Size="SgSize.Md" Variant="SgSpinnerVariant.Warn" Label="Warn" />
                                    <span style="font-size:11px;color:var(--sui-text-secondary);">Warn</span>
                                </div>
                                <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                                    <SgSpinner Size="SgSize.Md" Variant="SgSpinnerVariant.Danger" Label="Danger" />
                                    <span style="font-size:11px;color:var(--sui-text-secondary);">Danger</span>
                                </div>
                            </div>
                        </div>

                        <SgDivider />

                        <div>
                            <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Встроенный в текст</div>
                            <div style="display:flex; align-items:center; gap: 12px; flex-wrap: wrap;">
                                <SgSpinner Size="SgSize.Sm" IsSpinning="true" />
                                <div style="display:flex; flex-direction:column; gap: 2px;">
                                    <div style="font-size: 13px; font-weight: 700; color: var(--sui-fg);">Обработка запроса…</div>
                                    <div style="font-size: 12px; color: var(--sui-text-secondary);">Пожалуйста, подождите</div>
                                </div>
                            </div>
                        </div>

                        <SgDivider />

                        <div>
                            <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Overlay (loader поверх контента)</div>
                            <div style="position: relative;">
                                <div style="padding: 14px 16px; border: 1px solid var(--sui-border); border-radius: 8px; background: var(--sui-bg-secondary);">
                                    <div style="font-weight: 700; color: var(--sui-fg); font-size: 13px;">Контент</div>
                                    <div style="margin-top: 6px; font-size: 12px; color: var(--sui-text-secondary);">
                                        Пока идёт загрузка — поверх контента показывается overlay.
                                    </div>
                                </div>

                                <SgSpinner Overlay="true"
                                           Size="SgSize.Md"
                                           Variant="SgSpinnerVariant.Info"
                                           Label="Загрузка данных"
                                           IsSpinning="true" />
                            </div>
                            <div style="margin-top: 10px; font-size: 12px; color: var(--sui-text-secondary);">
                                Важно: overlay позиционируется относительно <code>position: relative</code> родителя.
                            </div>
                        </div>

                        <SgDivider />

                        <div>
                            <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Проверка доступности (aria-label)</div>
                            <div style="display:flex; align-items:center; gap: 12px; flex-wrap: wrap;">
                                <SgSpinner Size="SgSize.Sm" Label="Загрузка данных завершена" />
                                <span style="font-size:12px;color:var(--sui-text-secondary);">
                                    aria-label задаётся через <code>Label</code>
                                </span>
                            </div>
                        </div>

                    </div>
                </SgCard>

                <SgCard Title="Свойства компонента">
                    <PropertyTable Items="_spinnerProperties" />
                </SgCard>
            </div>
        </div>

    </SgCard>
</div>

@code {
    private List<PropertyPanelItem> _spinnerProperties = new()
    {
        new() { Label = "Size",        Value = "SgSize",      BadgeText = "Размер",      BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "IsSpinning",  Value = "bool (true)", BadgeText = "Анимация",   BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Overlay",     Value = "bool",         BadgeText = "Overlay",     BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Variant",     Value = "SgSpinnerVariant", BadgeText = "Цвет",    BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Label",       Value = "string?",     BadgeText = "Aria-label",  BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "CssClass",    Value = "string?",     BadgeText = "CSS класс",   BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Style",       Value = "string?",     BadgeText = "Inline style", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "AdditionalAttributes", Value = "Dictionary<string, object>", BadgeText = "Attributes", BadgeVariant = SgBadgeVariant.Default },
    };
}
