            <SgCard Title="SgLoader Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_loaderProperties" />
            </SgCard>
        </div>
    </div>

    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgLoadingContainer — State Manager
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Handles loading / empty / error / content states in one wrapper.
            </SgTypography>
        </div>
        <div class="demo-two-col">
            <SgCard Title="Interactive States" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <div style="display:flex;gap:8px;flex-wrap:wrap;">
                        <SgButton Text="Loading" OnClick="() => { _lcIsLoading = true; _lcIsEmpty = false; _lcHasError = false; }"
                                  Variant="SgButtonVariant.Primary" Size="SgSize.Sm" IsLoading="@_lcIsLoading" />
                        <SgButton Text="Empty" OnClick="() => { _lcIsLoading = false; _lcIsEmpty = true; _lcHasError = false; }"
                                  Variant="SgButtonVariant.Outlined" Size="SgSize.Sm" />
                        <SgButton Text="Error" OnClick="ToggleLcError"
                                  Variant="SgButtonVariant.Danger" Size="SgSize.Sm" />
                        <SgButton Text="Content" OnClick="() => { _lcIsLoading = false; _lcIsEmpty = false; _lcHasError = false; }"
                                  Variant="SgButtonVariant.Success" Size="SgSize.Sm" />
                    </div>

                    <SgLoadingContainer IsLoading="@_lcIsLoading"
                                        IsEmpty="@_lcIsEmpty"
                                        HasError="@_lcHasError"
                                        LoadingMessage="Fetching data..."
                                        EmptyMessage="No items found."
                                        ErrorMessage="@_lcErrorMsg"
                                        SpinnerType="SgSpinnerType.Bounce"
                                        SpinnerSize="SgSize.Lg">
                                        @*RetryContent*@
                                        @*EmptyContent*@
                                        @*ErrorContent*@
                        <ChildContent>
                            <div style="padding:20px;text-align:center;background:var(--sg-bg-subtle);border-radius:var(--sg-radius-lg);border:1px solid var(--sg-border);">
                                <SgTypography Variant="SgTypographyVariant.Heading6" Weight="SgTypographyWeight.Semibold">
                                    Content Loaded
                                </SgTypography>
                                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                                    This content appears when loading/empty/error are all false.
                                </SgTypography>
                            </div>
                        </ChildContent>
                    </SgLoadingContainer>
                </SgStack>
            </SgCard>
            <SgCard Title="SgLoadingContainer Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_containerProperties" />
            </SgCard>
        </div>
    </div>

    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgTypingIndicator — AI Chat
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Ready-to-use typing indicator for chat and AI apps.
            </SgTypography>
        </div>
        <div style="display:flex;gap:24px;flex-wrap:wrap;padding:16px 0;">
            <SgCard Title="Default" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgTypingIndicator UserName="Alice" DotColor="var(--sg-color-primary, #006fee)" />
            </SgCard>
            <SgCard Title="Custom Avatar" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgTypingIndicator UserName="Bot" ShowAvatar="true" AvatarColor="#22c55e"
                                   DotColor="#22c55e" />
            </SgCard>
            <SgCard Title="With Avatar URL" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgTypingIndicator UserName="Max" AvatarUrl="https://i.pravatar.cc/32?img=11" DotColor="#a855f7" />
            </SgCard>
            <SgCard Title="No Avatar" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgTypingIndicator UserName="System" ShowAvatar="false" DotColor="#f59e0b" />
            </SgCard>
        </div>
        <SgCard Title="SgTypingIndicator Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm" Style="margin-top:8px;">
            <PropertyTable Items="_typingIndicatorProperties" />
        </SgCard>
    </div>

    </ChildContent>
</SgCard>

@if (_showFullscreen)
{
