                    </div>
                </SgStack>
            </SgCard>
            <SgCard Title="Hide When Stopped" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
