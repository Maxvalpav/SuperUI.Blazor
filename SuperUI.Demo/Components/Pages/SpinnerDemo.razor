@code {
    private SgSpinnerType _selType = SgSpinnerType.Dots;
    private SgSize _selSize = SgSize.Md;
    private SgSpinnerVariant _selVariant = SgSpinnerVariant.Default;
    private SgSpinnerSpeed _selSpeed = SgSpinnerSpeed.Normal;
    private SgSpinnerLabelPosition _selLabelPos = SgSpinnerLabelPosition.Bottom;
    private bool _selSpinning = true;
    private bool _selHideWhenStopped;
    private bool _selIndeterminate;
    private bool _showToggleSpinner = true;
    private bool _isToggled = true;
    private int _progressValue = 42;
    private bool _isProgressRunning;
    private bool _delayedIsLoading;
    private bool _completionIsRunning;
    private bool _lcIsLoading;
    private bool _lcIsEmpty;
    private bool _lcHasError;
    private string _lcErrorMsg = "Connection lost";

    private readonly List<SgSpinnerType> _typeItems = Enum.GetValues<SgSpinnerType>().ToList();
    private readonly List<SgSize> _sizeItems = Enum.GetValues<SgSize>().ToList();
    private readonly List<SgSpinnerVariant> _variantItems = Enum.GetValues<SgSpinnerVariant>().ToList();
    private readonly List<SgSpinnerSpeed> _speedItems = Enum.GetValues<SgSpinnerSpeed>().ToList();
    private readonly List<SgSpinnerLabelPosition> _labelPosItems = Enum.GetValues<SgSpinnerLabelPosition>().ToList();

    private List<string> _codeLines => new()
    {
        "<SgSpinner",
        $"    Type=\"SgSpinnerType.{_selType}\"",
        $"    Size=\"SgSize.{_selSize}\"",
        $"    Variant=\"SgSpinnerVariant.{_selVariant}\"",
        $"    Speed=\"SgSpinnerSpeed.{_selSpeed}\"",
        $"    LabelPosition=\"SgSpinnerLabelPosition.{_selLabelPos}\"",
        $"    IsSpinning=\"{_selSpinning.ToString().ToLower()}\"",
        @"    DisplayLabel=""Loading..."" />"
    };

    private int _loaderProgress;
    private string _loaderStatus = "Ready";
    private bool _isDemoRunning;

    private bool _showFullscreen;
    private int _fullscreenProgress;
    private string _fullscreenStatus = "";

    private void OnTypeChanged(ChangeEventArgs e) { if (Enum.TryParse<SgSpinnerType>(e.Value?.ToString(), out var v)) _selType = v; }
    private void OnSizeChanged(ChangeEventArgs e) { if (Enum.TryParse<SgSize>(e.Value?.ToString(), out var v)) _selSize = v; }
    private void OnVariantChanged(ChangeEventArgs e) { if (Enum.TryParse<SgSpinnerVariant>(e.Value?.ToString(), out var v)) _selVariant = v; }
    private void OnSpeedChanged(ChangeEventArgs e) { if (Enum.TryParse<SgSpinnerSpeed>(e.Value?.ToString(), out var v)) _selSpeed = v; }
    private void OnLabelPosChanged(ChangeEventArgs e) { if (Enum.TryParse<SgSpinnerLabelPosition>(e.Value?.ToString(), out var v)) _selLabelPos = v; }

    private void ToggleLcError()
    {
        _lcIsLoading = false;
        _lcIsEmpty = false;
        _lcHasError = true;
        _lcErrorMsg = _lcErrorMsg == "Network error" ? "Timeout" : "Network error";
    }

    private async Task RunDelayedDemo(int ms)
    {
        _delayedIsLoading = true;
        StateHasChanged();
        await Task.Delay(ms);
        _delayedIsLoading = false;
        StateHasChanged();
    }

    private async Task RunCompletionDemo()
    {
        _completionIsRunning = true;
        StateHasChanged();
        await Task.Delay(2000);
        _completionIsRunning = false;
        StateHasChanged();
    }

    private async Task RunProgressDemo()
    {
        _isProgressRunning = true;
        for (int i = 0; i <= 100; i++)
        {
            _progressValue = i;
            StateHasChanged();
            await Task.Delay(20);
        }
        _isProgressRunning = false;
        StateHasChanged();
    }

    private async Task RunLoaderDemo()
    {
        _isDemoRunning = true;
        _loaderProgress = 0;
        _loaderStatus = "Connecting...";
        for (int i = 0; i <= 100; i += 4)
        {
            _loaderProgress = i;
            if (i == 20) _loaderStatus = "Loading resources...";
            if (i == 50) _loaderStatus = "Processing...";
            if (i == 80) _loaderStatus = "Finalizing...";
            StateHasChanged();
            await Task.Delay(60);
        }
        _loaderStatus = "Complete!";
        _isDemoRunning = false;
        StateHasChanged();
    }

    private async Task StartFullscreenDemo()
    {
        _showFullscreen = true;
        _fullscreenProgress = 0;
        _fullscreenStatus = "Initializing...";
        StateHasChanged();
        await RunFullscreenDemo();
    }

    private async Task RunFullscreenDemo()
    {
        for (int i = 0; i <= 100; i += 2)
        {
            if (!_showFullscreen) break;
            _fullscreenProgress = i;
            if (i == 20) _fullscreenStatus = "Loading workspace...";
            if (i == 50) _fullscreenStatus = "Syncing data...";
            if (i == 80) _fullscreenStatus = "Almost ready...";
            StateHasChanged();
            await Task.Delay(80);
        }
        if (_showFullscreen)
        {
            _fullscreenStatus = "Done!";
            StateHasChanged();
            await Task.Delay(600);
            _showFullscreen = false;
            _fullscreenProgress = 0;
            StateHasChanged();
        }
    }

