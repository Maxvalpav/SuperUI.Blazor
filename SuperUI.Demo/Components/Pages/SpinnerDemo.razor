@page "/spinner-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models

<PageTitle>Spinner & Loader - SUI</PageTitle>

<SgCard Title="Spinner & Loader"
        Subtitle="Компоненты для индикации процесса загрузки: от простых спиннеров до продвинутых загрузочных экранов.">

    <!-- Базовые спиннеры -->
    <div style="margin-top: 32px;">
        <h2>Базовые спиннеры</h2>
        <p>Различные типы и размеры стандартных индикаторов загрузки.</p>
        
        <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Варианты отображения">
                <div style="display: flex; flex-direction: column; gap: 32px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 12px;">Типы (Dots, Bars, Ring, SpinCircle)</div>
                        <div style="display: flex; gap: 24px; align-items: center;">
                            <SgSpinner Type="SgSpinnerType.Dots" />
                            <SgSpinner Type="SgSpinnerType.Bars" />
                            <SgSpinner Type="SgSpinnerType.Ring" />
                            <SgSpinner Type="SgSpinnerType.SpinCircle" />
                        </div>
                    </div>

                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 12px;">Размеры (Sm, Default, Lg, Xl)</div>
                        <div style="display: flex; gap: 24px; align-items: center;">
                            <SgSpinner Size="SgSize.Sm" />
                            <SgSpinner Size="SgSize.Md" />
                            <SgSpinner Size="SgSize.Lg" />
                            <SgSpinner Size="SgSize.Xl" />
                        </div>
                    </div>

                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 12px;">С текстом и цветами</div>
                        <div style="display: flex; gap: 24px; align-items: center;">
                            <SgSpinner Label="Загрузка..." />
                            <SgSpinner Variant="SgSpinnerVariant.Success" Label="Успешно..." />
                            <SgSpinner Variant="SgSpinnerVariant.Danger" Label="Ошибка..." />
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства SgSpinner">
                <PropertyTable Items="_spinnerProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Продвинутый загрузчик (SgLoader) -->
    <div style="margin-top: 32px;">
        <h2>SgLoader — Продвинутый загрузчик</h2>
        <p>Компонент для создания эффектных загрузочных экранов с прогрессом, заголовками и иконками.</p>
        
        <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Интерактивный пример">
                <div style="display: flex; flex-direction: column; gap: 24px;">
                    <div style="display: flex; gap: 16px; align-items: center;">
                        <SgButton Text="Запустить демо (3 сек)" OnClick="RunLoaderDemo" IsLoading="_isDemoRunning" />
                        <SgButton Text="Показать во весь экран" OnClick="StartFullscreenDemo" Variant="SgButtonVariant.Outlined" />
                    </div>

                    <div style="border: 1px solid var(--sui-border); border-radius: 12px; overflow: hidden; background: var(--sui-bg-muted);">
                        <SgLoader Title="SuperUI"
                                 Subtitle="Simple Blazor Components"
                                 StatusText="@_loaderStatus"
                                 Progress="_loaderProgress"
                                 Icon="@SgIcons.Flame" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства SgLoader">
                <PropertyTable Items="_loaderProperties" />
            </SgCard>
        </div>
    </div>

</SgCard>

@if (_showFullscreen)
{
    <SgLoader Fullscreen="true"
             Title="Инициализация системы"
             Subtitle="Пожалуйста, подождите, мы настраиваем ваше рабочее пространство"
             StatusText="Загрузка модулей..."
             Progress="_fullscreenProgress"
             Icon="@SgIcons.Settings">
        <ChildContent>
            <div style="text-align: center; margin-top: 16px;">
                <SgButton Text="Отмена" Variant="SgButtonVariant.Ghost" OnClick="() => _showFullscreen = false" />
            </div>
        </ChildContent>
    </SgLoader>
}

@code {
    private int _loaderProgress = 45;
    private string _loaderStatus = "Загрузка компонентов...";
    private bool _isDemoRunning;
    
    private bool _showFullscreen;
    private int _fullscreenProgress = 0;

    private async Task RunLoaderDemo()
    {
        _isDemoRunning = true;
        _loaderProgress = 0;
        _loaderStatus = "Подключение к серверу...";
        
        for (int i = 0; i <= 100; i += 5)
        {
            _loaderProgress = i;
            if (i == 30) _loaderStatus = "Загрузка ресурсов...";
            if (i == 70) _loaderStatus = "Финальная настройка...";
            StateHasChanged();
            await Task.Delay(150);
        }
        
        _loaderStatus = "Готово!";
        _isDemoRunning = false;
    }

    private async Task StartFullscreenDemo()
    {
        _showFullscreen = true;
        await RunFullscreenDemo();
    }

    private async Task RunFullscreenDemo()
    {
        for (int i = 0; i <= 100; i += 2)
        {
            if (!_showFullscreen) break; // Прерывание если нажали "Отмена"
            _fullscreenProgress = i;
            StateHasChanged();
            await Task.Delay(50);
        }
        
        if (_showFullscreen)
        {
            await Task.Delay(500);
            _showFullscreen = false;
            _fullscreenProgress = 0;
            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        // Удаляем OnAfterRenderAsync так как логика перенесена в StartFullscreenDemo
    }

    private List<PropertyPanelItem> _spinnerProperties = new()
    {
        new() { Label = "Type", Value = "SgSpinnerType", BadgeText = "Dots, Bars, Ring, SpinCircle", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Size", Value = "SgSize", BadgeText = "Sm, Md, Lg, Xl", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Variant", Value = "SgSpinnerVariant", BadgeText = "Primary, Success, etc.", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Label", Value = "string", BadgeText = "Текст под спиннером", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Overlay", Value = "bool", BadgeText = "Поверх контента", BadgeVariant = SgBadgeVariant.Warn }
    };

    private List<PropertyPanelItem> _loaderProperties = new()
    {
        new() { Label = "Title", Value = "string", BadgeText = "Основной заголовок", BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "Subtitle", Value = "string", BadgeText = "Подзаголовок", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Progress", Value = "int", BadgeText = "0-100", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "StatusText", Value = "string", BadgeText = "Текст статуса", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Fullscreen", Value = "bool", BadgeText = "Во весь экран", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Icon", Value = "string", BadgeText = "SVG иконка", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "LogoContent", Value = "RenderFragment", BadgeText = "Свой логотип", BadgeVariant = SgBadgeVariant.Info }
    };
}
