            </SgTypography>
        </div>
        <div class="demo-composition-grid">
            @foreach (var type in new[] {
                (SgSpinnerType.Border, "Border"),
                (SgSpinnerType.Dots, "Dots"),
                (SgSpinnerType.Bars, "Bars"),
                (SgSpinnerType.Ring, "Ring"),
                (SgSpinnerType.SpinCircle, "SpinCircle"),
                (SgSpinnerType.Pulse, "Pulse"),
                (SgSpinnerType.Bounce, "Bounce"),
                (SgSpinnerType.Typing, "Typing"),
                (SgSpinnerType.Morph, "Morph") })
            {
                <div class="demo-comp-card">
                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold"
                                  Color="var(--sg-text-muted)" Style="margin-bottom:8px;display:block;">@type.Item2</SgTypography>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:12px;">
                        <SgSpinner Type="@type.Item1" Size="SgSize.Sm" />
                        <SgSpinner Type="@type.Item1" Size="SgSize.Md" />
                        <SgSpinner Type="@type.Item1" Size="SgSize.Lg" />
                        <SgSpinner Type="@type.Item1" Size="SgSize.Xl" />
