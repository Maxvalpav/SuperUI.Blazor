            </SgTypography>
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;">
            @foreach (var v in new[] { (SgSpinnerVariant.Default, "Default"),
                                      (SgSpinnerVariant.Primary, "Primary"),
                                      (SgSpinnerVariant.Info, "Info"),
                                      (SgSpinnerVariant.Success, "Success"),
                                      (SgSpinnerVariant.Warn, "Warn"),
                                      (SgSpinnerVariant.Danger, "Danger") })
            {
                <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm" Style="text-align:center;">
