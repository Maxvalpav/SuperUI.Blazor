@page "/spinner-demo"
@using SuperUI.Components

<PageTitle>Spinner — SUI</PageTitle>

<SgCard Title="Компонент SgSpinner"
        Subtitle="Индикаторы загрузки с разными типами анимации, размерами, цветами, скоростями и управлением состоянием.">

    <!-- Примеры использования -->
    <div style="margin-top: 32px;">
        <h2>SgSpinner — Индикатор загрузки</h2>
        <p>Универсальный компонент с 6 типами анимации, поддержкой размеров <code>SgSize</code>, цветовых <code>Variant</code>, управления скоростью <code>Speed</code>, режимом overlay и текстовой меткой.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Типы анимации (Type)">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div style="display: flex; gap: 20px; flex-wrap: wrap; align-items: center;">
                        <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                            <SgSpinner Size="SgSize.Md" Type="SgSpinnerType.Border" />
                            <span style="font-size:11px;color:var(--sui-text-secondary);">Border</span>
                        </div>
                        <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                            <SgSpinner Size="SgSize.Md" Type="SgSpinnerType.Ring" Thickness="3" />
                            <span style="font-size:11px;color:var(--sui-text-secondary);">Ring</span>
                        </div>
                        <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                            <SgSpinner Size="SgSize.Md" Type="SgSpinnerType.Dots" />
                            <span style="font-size:11px;color:var(--sui-text-secondary);">Dots</span>
                        </div>
                        <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                            <SgSpinner Size="SgSize.Md" Type="SgSpinnerType.Bars" />
                            <span style="font-size:11px;color:var(--sui-text-secondary);">Bars</span>
                        </div>
                        <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                            <SgSpinner Size="SgSize.Md" Type="SgSpinnerType.Pulse" />
                            <span style="font-size:11px;color:var(--sui-text-secondary);">Pulse</span>
                        </div>
                        <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                            <SgSpinner Size="SgSize.Md" Type="SgSpinnerType.SpinCircle" Thickness="3" />
                            <span style="font-size:11px;color:var(--sui-text-secondary);">SpinCircle</span>
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Размеры (Size)">
                <div style="display: flex; gap: 20px; flex-wrap: wrap; align-items: center;">
                    <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                        <SgSpinner Size="SgSize.Sm" />
                        <span style="font-size:11px;color:var(--sui-text-secondary);">Sm</span>
                    </div>
                    <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                        <SgSpinner Size="SgSize.Md" />
                        <span style="font-size:11px;color:var(--sui-text-secondary);">Md</span>
                    </div>
                    <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                        <SgSpinner Size="SgSize.Lg" />
                        <span style="font-size:11px;color:var(--sui-text-secondary);">Lg</span>
                    </div>
                    <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                        <SgSpinner Size="SgSize.Xl" />
                        <span style="font-size:11px;color:var(--sui-text-secondary);">Xl</span>
                    </div>
                    <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                        <SgSpinner Size="SgSize.Sm" Type="SgSpinnerType.Ring" Thickness="2" />
                        <span style="font-size:11px;color:var(--sui-text-secondary);">Ring Sm</span>
                    </div>
                    <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                        <SgSpinner Size="SgSize.Xl" Type="SgSpinnerType.Ring" Thickness="4" />
                        <span style="font-size:11px;color:var(--sui-text-secondary);">Ring Xl</span>
                    </div>
                </div>
            </SgCard>
        </div>
    </div>

    <SgDivider />

    <!-- Цвета и скорость -->
    <div style="margin-top: 32px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
            <SgCard Title="Цветовые варианты (Variant)">
                <div style="display: flex; gap: 18px; flex-wrap: wrap; align-items: center;">
                    <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                        <SgSpinner Size="SgSize.Md" Variant="SgSpinnerVariant.Default" />
                        <span style="font-size:11px;color:var(--sui-text-secondary);">Default</span>
                    </div>
                    <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                        <SgSpinner Size="SgSize.Md" Variant="SgSpinnerVariant.Info" />
                        <span style="font-size:11px;color:var(--sui-text-secondary);">Info</span>
                    </div>
                    <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                        <SgSpinner Size="SgSize.Md" Variant="SgSpinnerVariant.Success" />
                        <span style="font-size:11px;color:var(--sui-text-secondary);">Success</span>
                    </div>
                    <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                        <SgSpinner Size="SgSize.Md" Variant="SgSpinnerVariant.Warn" />
                        <span style="font-size:11px;color:var(--sui-text-secondary);">Warn</span>
                    </div>
                    <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                        <SgSpinner Size="SgSize.Md" Variant="SgSpinnerVariant.Danger" />
                        <span style="font-size:11px;color:var(--sui-text-secondary);">Danger</span>
                    </div>
                </div>
                <div style="margin-top: 12px;">
                    <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Цвета для Ring и SpinCircle (SVG)</div>
                    <div style="display: flex; gap: 14px; flex-wrap: wrap; align-items: center;">
                        <SgSpinner Size="SgSize.Sm" Type="SgSpinnerType.Ring" Variant="SgSpinnerVariant.Default" />
                        <SgSpinner Size="SgSize.Sm" Type="SgSpinnerType.Ring" Variant="SgSpinnerVariant.Success" />
                        <SgSpinner Size="SgSize.Sm" Type="SgSpinnerType.Ring" Variant="SgSpinnerVariant.Danger" />
                        <SgSpinner Size="SgSize.Sm" Type="SgSpinnerType.SpinCircle" Variant="SgSpinnerVariant.Warn" />
                        <SgSpinner Size="SgSize.Sm" Type="SgSpinnerType.SpinCircle" Variant="SgSpinnerVariant.Info" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Скорость анимации (Speed)">
                <div style="display: flex; gap: 20px; flex-wrap: wrap; align-items: center;">
                    <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                        <SgSpinner Size="SgSize.Md" Speed="SgSpinnerSpeed.Slow" />
                        <span style="font-size:11px;color:var(--sui-text-secondary);">Slow</span>
                    </div>
                    <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                        <SgSpinner Size="SgSize.Md" Speed="SgSpinnerSpeed.Normal" />
                        <span style="font-size:11px;color:var(--sui-text-secondary);">Normal</span>
                    </div>
                    <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                        <SgSpinner Size="SgSize.Md" Speed="SgSpinnerSpeed.Fast" />
                        <span style="font-size:11px;color:var(--sui-text-secondary);">Fast</span>
                    </div>
                    <div style="margin-top: 8px; width:100%;">
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Speed + Type комбинации</div>
                        <div style="display: flex; gap: 14px; flex-wrap: wrap; align-items: center;">
                            <SgSpinner Size="SgSize.Sm" Type="SgSpinnerType.Dots" Speed="SgSpinnerSpeed.Fast" />
                            <SgSpinner Size="SgSize.Sm" Type="SgSpinnerType.Bars" Speed="SgSpinnerSpeed.Slow" />
                            <SgSpinner Size="SgSize.Sm" Type="SgSpinnerType.Pulse" Speed="SgSpinnerSpeed.Fast" />
                            <SgSpinner Size="SgSize.Sm" Type="SgSpinnerType.Ring" Speed="SgSpinnerSpeed.Slow" />
                        </div>
                    </div>
                </div>
            </SgCard>
        </div>
    </div>

    <SgDivider />

    <!-- Управление анимацией, метка, текст -->
    <div style="margin-top: 32px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
            <SgCard Title="Управление анимацией (IsSpinning)">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div style="display:flex; gap: 24px; flex-wrap: wrap; align-items: center;">
                        <div style="display:flex; flex-direction:column; gap: 8px; align-items:flex-start;">
                            <SgSpinner Size="SgSize.Md" IsSpinning="true" />
                            <span style="font-size:11px;color:var(--sui-text-secondary);">IsSpinning=true</span>
                        </div>
                        <div style="display:flex; flex-direction:column; gap: 8px; align-items:flex-start;">
                            <SgSpinner Size="SgSize.Md" IsSpinning="false" />
                            <span style="font-size:11px;color:var(--sui-text-secondary);">IsSpinning=false</span>
                        </div>
                    </div>

                    <div style="display:flex; align-items:center; gap: 12px;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <SgSpinner Size="SgSize.Sm" IsSpinning="@_isLoading" />
                            <SgButton Text="@(_isLoading ? "Остановить" : "Запустить")" Variant="SgButtonVariant.Primary" OnClick="ToggleLoading" Size="SgSize.Sm" />
                        </div>
                    </div>

                    <SgDivider />

                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Встроенный в текст</div>
                        <div style="display:flex; align-items:center; gap: 12px; flex-wrap: wrap;">
                            <SgSpinner Size="SgSize.Sm" IsSpinning="true" />
                            <div style="display:flex; flex-direction:column; gap: 2px;">
                                <div style="font-size: 13px; font-weight: 700; color: var(--sui-fg);">Обработка запроса…</div>
                                <div style="font-size: 12px; color: var(--sui-text-secondary);">Пожалуйста, подождите</div>
                            </div>
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Текстовая метка (DisplayLabel)">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div style="display:flex; gap: 18px; flex-wrap: wrap; align-items: center;">
                        <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                            <SgSpinner Size="SgSize.Md" DisplayLabel="Загрузка..." />
                            <span style="font-size:11px;color:var(--sui-text-secondary);">Border + метка</span>
                        </div>
                        <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                            <SgSpinner Size="SgSize.Sm" Type="SgSpinnerType.Dots" DisplayLabel="Подождите" />
                            <span style="font-size:11px;color:var(--sui-text-secondary);">Dots + метка</span>
                        </div>
                        <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                            <SgSpinner Size="SgSize.Sm" Type="SgSpinnerType.Bars" DisplayLabel="Загрузка" />
                            <span style="font-size:11px;color:var(--sui-text-secondary);">Bars + метка</span>
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Ring с меткой</div>
                        <div style="display:flex; gap: 20px; align-items: center;">
                            <SgSpinner Size="SgSize.Md" Type="SgSpinnerType.Ring" DisplayLabel="Загрузка данных..." />
                            <SgSpinner Size="SgSize.Md" Type="SgSpinnerType.SpinCircle" DisplayLabel="Обработка..." Variant="SgSpinnerVariant.Success" />
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Overlay (поверх контента)">
                <div style="position: relative; min-height: 120px; display: flex; align-items: center; justify-content: center;">
                    <div style="padding: 14px 16px; border: 1px solid var(--sui-border); border-radius: 8px; background: var(--sui-bg-secondary); width: 100%;">
                        <div style="font-weight: 700; color: var(--sui-fg); font-size: 13px;">Контент</div>
                        <div style="margin-top: 6px; font-size: 12px; color: var(--sui-text-secondary);">
                            Пока идёт загрузка — поверх контента показывается overlay с затемнением.
                        </div>
                    </div>
                    <SgSpinner Overlay="true"
                               Size="SgSize.Md"
                               Type="SgSpinnerType.Border"
                               Variant="SgSpinnerVariant.Info"
                               Label="Загрузка данных"
                               IsSpinning="true" />
                </div>
                <div style="margin-top: 10px; font-size: 12px; color: var(--sui-text-secondary);">
                    Overlay с backdrop-ом (затемнение + размытие). Важно: <code>position: relative</code> на родителе.
                </div>
            </SgCard>

            <SgCard Title="Overlay с Ring + DisplayLabel">
                <div style="position: relative; min-height: 120px; display: flex; align-items: center; justify-content: center;">
                    <div style="padding: 14px 16px; border: 1px solid var(--sui-border); border-radius: 8px; background: var(--sui-bg-secondary); width: 100%;">
                        <div style="font-weight: 700; color: var(--sui-fg); font-size: 13px;">Сохранение данных</div>
                        <div style="margin-top: 6px; font-size: 12px; color: var(--sui-text-secondary);">
                            Ring спиннер с текстовой меткой поверх затемнённого фона.
                        </div>
                    </div>
                    <SgSpinner Overlay="true"
                               Size="SgSize.Md"
                               Type="SgSpinnerType.Ring"
                               Variant="SgSpinnerVariant.Success"
                               DisplayLabel="Сохранение..."
                               Thickness="3"
                               IsSpinning="true" />
                </div>
            </SgCard>
        </div>
    </div>

    <SgDivider />

    <!-- Thickness для Ring / SpinCircle -->
    <div style="margin-top: 32px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
            <SgCard Title="Толщина Ring (Thickness)">
                <div style="display: flex; gap: 20px; flex-wrap: wrap; align-items: center;">
                    <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                        <SgSpinner Size="SgSize.Md" Type="SgSpinnerType.Ring" Thickness="2" />
                        <span style="font-size:11px;color:var(--sui-text-secondary);">Thickness=2</span>
                    </div>
                    <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                        <SgSpinner Size="SgSize.Md" Type="SgSpinnerType.Ring" Thickness="4" />
                        <span style="font-size:11px;color:var(--sui-text-secondary);">Thickness=4</span>
                    </div>
                    <div style="display:flex; flex-direction:column; align-items:center; gap: 8px;">
                        <SgSpinner Size="SgSize.Md" Type="SgSpinnerType.Ring" Thickness="6" />
                        <span style="font-size:11px;color:var(--sui-text-secondary);">Thickness=6</span>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Проверка доступности (aria-label)">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div style="display:flex; align-items:center; gap: 12px; flex-wrap: wrap;">
                        <SgSpinner Size="SgSize.Sm" Label="Загрузка данных завершена" />
                        <span style="font-size:12px;color:var(--sui-text-secondary);">
                            aria-label через <code>Label</code>
                        </span>
                    </div>
                    <div style="display:flex; align-items:center; gap: 12px; flex-wrap: wrap;">
                        <SgSpinner Size="SgSize.Sm" Type="SgSpinnerType.Dots" Label="Идёт поиск..." />
                        <span style="font-size:12px;color:var(--sui-text-secondary);">
                            Dots + aria-label
                        </span>
                    </div>
                    <div style="display:flex; align-items:center; gap: 12px; flex-wrap: wrap;">
                        <SgSpinner Size="SgSize.Sm" Type="SgSpinnerType.Ring" Label="Синхронизация..." />
                        <span style="font-size:12px;color:var(--sui-text-secondary);">
                            Ring + aria-label
                        </span>
                    </div>
                </div>
            </SgCard>
        </div>
    </div>

    <SgDivider />

    <!-- Свойства компонента -->
    <div style="margin-top: 32px;">
        <SgCard Title="Свойства SgSpinner">
            <PropertyTable Items="_spinnerProperties" />
        </SgCard>
    </div>

    <SgDivider />


</SgCard>

@code {
    private bool _isLoading = true;

    private void ToggleLoading()
    {
        _isLoading = !_isLoading;
    }

    private List<PropertyPanelItem> _spinnerProperties = new()
    {
        new() { Label = "Type",         Value = "SgSpinnerType",     BadgeText = "Тип",         BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Size",         Value = "SgSize",            BadgeText = "Размер",       BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Variant",      Value = "SgSpinnerVariant",  BadgeText = "Цвет",         BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Speed",        Value = "SgSpinnerSpeed",    BadgeText = "Скорость",     BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "IsSpinning",   Value = "bool (true)",       BadgeText = "Анимация",     BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Overlay",      Value = "bool",              BadgeText = "Overlay",      BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Thickness",    Value = "int (3)",           BadgeText = "Толщина",      BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Label",        Value = "string?",           BadgeText = "Aria-label",   BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "DisplayLabel", Value = "string?",           BadgeText = "Текст метки",  BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "CssClass",     Value = "string?",           BadgeText = "CSS класс",    BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Style",        Value = "string?",           BadgeText = "Inline style", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "AdditionalAttributes", Value = "Dictionary<string, object>", BadgeText = "Attributes", BadgeVariant = SgBadgeVariant.Default },
    };
}