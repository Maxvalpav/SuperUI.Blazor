@page "/spinner-demo"
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>Spinner & Loader — SuperUI</PageTitle>
<SgSeoHead Description="Loading indicators." />

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Spinner &amp; Loader" Subtitle="Loading indicators." />
    </HeaderContent>
    <ChildContent>

    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Interactive Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Pick any combination.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Live Preview" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div class="spinner-constructor-grid">
                        <label class="spinner-ctor-label">
                            <span class="spinner-ctor-label-text">Type</span>
                            <select class="spinner-ctor-select" value="@_selType" @onchange="OnTypeChanged">
                                @foreach (var t in _typeItems) { <option value="@t">@t</option> }
                            </select>
                        </label>
                        <label class="spinner-ctor-label">
                            <span class="spinner-ctor-label-text">Size</span>
                            <select class="spinner-ctor-select" value="@_selSize" @onchange="OnSizeChanged">
                                @foreach (var t in _sizeItems) { <option value="@t">@t</option> }
                            </select>
                        </label>
                        <label class="spinner-ctor-label">
                            <span class="spinner-ctor-label-text">Variant</span>
                            <select class="spinner-ctor-select" value="@_selVariant" @onchange="OnVariantChanged">
                                @foreach (var t in _variantItems) { <option value="@t">@t</option> }
                            </select>
                        </label>
                        <label class="spinner-ctor-label">
                            <span class="spinner-ctor-label-text">Speed</span>
                            <select class="spinner-ctor-select" value="@_selSpeed" @onchange="OnSpeedChanged">
                                @foreach (var t in _speedItems) { <option value="@t">@t</option> }
                            </select>
                        </label>
                        <label class="spinner-ctor-label">
                            <span class="spinner-ctor-label-text">Label Pos</span>
                            <select class="spinner-ctor-select" value="@_selLabelPos" @onchange="OnLabelPosChanged">
                                @foreach (var t in _labelPosItems) { <option value="@t">@t</option> }
                            </select>
                        </label>
                    </div>

                    <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
                        <SgSwitch @bind-Value="_selSpinning" Label="Spinning" Size="SgSize.Sm" />
                        <SgSwitch @bind-Value="_selHideWhenStopped" Label="Hide When Stopped" Size="SgSize.Sm" />
                        <SgSwitch @bind-Value="_selIndeterminate" Label="Indeterminate" Size="SgSize.Sm" />
                    </div>

                    <div class="spinner-preview-box">
                        <SgSpinner Type="@_selType"
                                   Size="@_selSize"
                                   Variant="@_selVariant"
                                   Speed="@_selSpeed"
                                   LabelPosition="@_selLabelPos"
                                   IsSpinning="@_selSpinning"
                                   HideWhenStopped="@_selHideWhenStopped"
                                   Indeterminate="@_selIndeterminate"
                                   DisplayLabel="Loading..." />
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Constructor Output" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Sm">
                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold"
                                  Transform="SgTypographyTransform.Uppercase"
                                  Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                        Generated Code
                    </SgTypography>
                    <div class="code-block">
                        @foreach (var line in _codeLines)
                        {
                            <code>@line</code><br />
                        }
                    </div>
                </SgStack>
            </SgCard>
        </div>
    </div>

    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                All Spinner Types
            </SgTypography>
        </div>
        <div class="demo-two-col">
            <SgCard Title="Types Overview" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold"
                                      Transform="SgTypographyTransform.Uppercase"
                                      Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)"
                                      Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Default (Md, Normal speed)
                        </SgTypography>
                        <div class="spinner-types-grid">
                            <SgSpinner Type="SgSpinnerType.Border" DisplayLabel="Border" />
                            <SgSpinner Type="SgSpinnerType.Dots" DisplayLabel="Dots" />
                            <SgSpinner Type="SgSpinnerType.Bars" DisplayLabel="Bars" />
                            <SgSpinner Type="SgSpinnerType.Ring" DisplayLabel="Ring" />
                            <SgSpinner Type="SgSpinnerType.SpinCircle" DisplayLabel="SpinCircle" />
                            <SgSpinner Type="SgSpinnerType.Pulse" DisplayLabel="Pulse" />
                            <SgSpinner Type="SgSpinnerType.Bounce" DisplayLabel="Bounce" />
                            <SgSpinner Type="SgSpinnerType.Typing" DisplayLabel="Typing" />
                            <SgSpinner Type="SgSpinnerType.Morph" DisplayLabel="Morph" />
                        </div>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold"
                                      Transform="SgTypographyTransform.Uppercase"
                                      Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)"
                                      Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Fast speed, Sm size
                        </SgTypography>
                        <div class="spinner-types-grid">
                            <SgSpinner Type="SgSpinnerType.Border" Size="SgSize.Sm" Speed="SgSpinnerSpeed.Fast" />
                            <SgSpinner Type="SgSpinnerType.Dots" Size="SgSize.Sm" Speed="SgSpinnerSpeed.Fast" />
                            <SgSpinner Type="SgSpinnerType.Bars" Size="SgSize.Sm" Speed="SgSpinnerSpeed.Fast" />
                            <SgSpinner Type="SgSpinnerType.Ring" Size="SgSize.Sm" Speed="SgSpinnerSpeed.Fast" />
                            <SgSpinner Type="SgSpinnerType.SpinCircle" Size="SgSize.Sm" Speed="SgSpinnerSpeed.Fast" />
                            <SgSpinner Type="SgSpinnerType.Pulse" Size="SgSize.Sm" Speed="SgSpinnerSpeed.Fast" />
                            <SgSpinner Type="SgSpinnerType.Bounce" Size="SgSize.Sm" Speed="SgSpinnerSpeed.Fast" />
                            <SgSpinner Type="SgSpinnerType.Typing" Size="SgSize.Sm" Speed="SgSpinnerSpeed.Fast" />
                            <SgSpinner Type="SgSpinnerType.Morph" Size="SgSize.Sm" Speed="SgSpinnerSpeed.Fast" />
                        </div>
                    </div>
                </SgStack>
            </SgCard>
            <SgCard Title="SgSpinner Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_spinnerProperties" />
            </SgCard>
        </div>
    </div>

    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Determinate Progress (Ring)
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Set <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Xs">Progress</SgTypography> (0–100) to turn Ring into a circular progress indicator.
            </SgTypography>
        </div>
        <div class="demo-two-col">
            <SgCard Title="Progress Values" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <div style="display:flex;gap:20px;align-items:center;justify-content:center;flex-wrap:wrap;">
                    <div style="text-align:center;">
                        <SgSpinner Type="SgSpinnerType.Ring" Progress="0" Variant="SgSpinnerVariant.Danger" DisplayLabel="0%" Size="SgSize.Lg" />
                    </div>
                    <div style="text-align:center;">
                        <SgSpinner Type="SgSpinnerType.Ring" Progress="25" Variant="SgSpinnerVariant.Warn" DisplayLabel="25%" Size="SgSize.Lg" />
                    </div>
                    <div style="text-align:center;">
                        <SgSpinner Type="SgSpinnerType.Ring" Progress="50" DisplayLabel="50%" Size="SgSize.Lg" />
                    </div>
                    <div style="text-align:center;">
                        <SgSpinner Type="SgSpinnerType.Ring" Progress="75" Variant="SgSpinnerVariant.Info" DisplayLabel="75%" Size="SgSize.Lg" />
                    </div>
                    <div style="text-align:center;">
                        <SgSpinner Type="SgSpinnerType.Ring" Progress="100" Variant="SgSpinnerVariant.Success" DisplayLabel="100%" Size="SgSize.Lg" />
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Interactive Progress" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
                    <div style="display:flex;gap:32px;align-items:center;flex-wrap:wrap;justify-content:center;">
                        <div style="text-align:center;">
                            <SgSpinner Type="SgSpinnerType.Ring" Progress="@_progressValue"
                                       Size="SgSize.Xl" Thickness="6"
                                       Gradient="#006fee, #a855f7"
                                       DisplayLabel="@($"Progress: {_progressValue}%")" />
                        </div>
                        <div style="text-align:center;">
                            <SgSpinner Type="SgSpinnerType.SpinCircle" Progress="@_progressValue"
                                       Size="SgSize.Lg" Thickness="5"
                                       Gradient="#f59e0b, #ef4444"
                                       DisplayLabel="@($"Value: {_progressValue}%")" />
                        </div>
                    </div>
                    <input type="range" min="0" max="100" step="1"
                           @bind-value="@_progressValue"
                           @bind-value:event="oninput"
                           style="width:100%;max-width:360px;" />
                    <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center;">
                        <SgButton Text="Run 0→100" OnClick="RunProgressDemo" IsLoading="@_isProgressRunning"
                                  Variant="SgButtonVariant.Primary" Size="SgSize.Sm" />
                        <SgButton Text="Reset" OnClick="() => _progressValue = 0"
                                  Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
                    </div>
                </SgStack>
            </SgCard>
        </div>
    </div>

    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Gradient Ring
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Xs">Gradient</SgTypography> with two comma-separated colors for a gradient stroke.
            </SgTypography>
        </div>
        <div style="display:flex;gap:28px;align-items:center;flex-wrap:wrap;justify-content:center;padding:16px 0;">
            <div style="text-align:center;">
                <SgSpinner Type="SgSpinnerType.Ring" Gradient="#006fee, #22c55e" Size="SgSize.Lg" DisplayLabel="Blue → Green" />
            </div>
            <div style="text-align:center;">
                <SgSpinner Type="SgSpinnerType.Ring" Gradient="#f59e0b, #ef4444" Size="SgSize.Lg" DisplayLabel="Amber → Red" />
            </div>
            <div style="text-align:center;">
                <SgSpinner Type="SgSpinnerType.Ring" Gradient="#a855f7, #ec4899" Size="SgSize.Lg" DisplayLabel="Purple → Pink" />
            </div>
            <div style="text-align:center;">
                <SgSpinner Type="SgSpinnerType.SpinCircle" Gradient="#06b6d4, #8b5cf6" Size="SgSize.Lg" DisplayLabel="Cyan → Violet" />
            </div>
            <div style="text-align:center;">
                <SgSpinner Type="SgSpinnerType.Ring" Gradient="#ff7e5f, #feb47b" Size="SgSize.Lg" Progress="65" DisplayLabel="Progress 65%" />
            </div>
        </div>
    </div>

    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Custom Content in Ring
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Xs">ChildContent</SgTypography> to render icons or text inside the ring.
            </SgTypography>
        </div>
        <div style="display:flex;gap:40px;align-items:center;flex-wrap:wrap;justify-content:center;padding:16px 0;">
            <div style="text-align:center;">
                <SgSpinner Type="SgSpinnerType.Ring" Size="SgSize.Xl" Progress="75" Variant="SgSpinnerVariant.Success">
                    <ChildContent>
                        <span style="font-size:18px;font-weight:700;color:var(--sg-color-success,#22c55e);">✓</span>
                    </ChildContent>
                </SgSpinner>
                <div style="margin-top:8px;">
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                        Progress 75% + checkmark
                    </SgTypography>
                </div>
            </div>
            <div style="text-align:center;">
                <SgSpinner Type="SgSpinnerType.Ring" Size="SgSize.Xl" Progress="42" Gradient="#a855f7, #ec4899">
                    <ChildContent>
                        <span style="font-size:14px;font-weight:600;color:#a855f7;">42%</span>
                    </ChildContent>
                </SgSpinner>
                <div style="margin-top:8px;">
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                        Gradient + percentage text
                    </SgTypography>
                </div>
            </div>
            <div style="text-align:center;">
                <SgSpinner Type="SgSpinnerType.SpinCircle" Size="SgSize.Xl">
                    <ChildContent>
                        <span style="font-size:16px;font-weight:600;color:var(--sg-color-primary,#006fee);">⚡</span>
                    </ChildContent>
                </SgSpinner>
                <div style="margin-top:8px;">
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                        SpinCircle with icon
                    </SgTypography>
                </div>
            </div>
            <div style="text-align:center;">
                <SgSpinner Type="SgSpinnerType.Ring" Size="SgSize.Lg" Indeterminate="true">
                    <ChildContent>
                        <span style="font-size:12px;color:var(--sg-text-muted);">● ● ●</span>
                    </ChildContent>
                </SgSpinner>
                <div style="margin-top:8px;">
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                        Indeterminate + dots
                    </SgTypography>
                </div>
            </div>
        </div>
    </div>

    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Delay, Easing & Completion
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Xs">DelayMs</SgTypography> prevents flash on fast loads.
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Xs">Easing</SgTypography> customizes animation curve.
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Xs">CompletionAnimation</SgTypography> shows a checkmark when done.
            </SgTypography>
        </div>
        <div class="demo-three-col">
            <SgCard Title="DelayMs" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                        300ms delay — spinner appears only if loading lasts &gt;300ms
                    </SgTypography>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center;">
                        <SgButton Text="Load (200ms)" OnClick="() => RunDelayedDemo(200)"
                                  Variant="SgButtonVariant.Outlined" Size="SgSize.Sm" />
                        <SgButton Text="Load (600ms)" OnClick="() => RunDelayedDemo(600)"
                                  Variant="SgButtonVariant.Primary" Size="SgSize.Sm" />
                        <SgButton Text="Load (1.5s)" OnClick="() => RunDelayedDemo(1500)"
                                  Variant="SgButtonVariant.Danger" Size="SgSize.Sm" />
                    </div>
                    <SgSpinner Type="SgSpinnerType.Dots" IsSpinning="@_delayedIsLoading"
                               DelayMs="300" DisplayLabel="@(_delayedIsLoading ? "Loading..." : "Idle")" />
                </SgStack>
            </SgCard>
            <SgCard Title="Easing" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
                    <div style="display:flex;gap:20px;flex-wrap:wrap;justify-content:center;">
                        <div style="text-align:center;">
                            <SgSpinner Type="SgSpinnerType.Ring" DisplayLabel="ease-in-out" Easing="ease-in-out" />
                        </div>
                        <div style="text-align:center;">
                            <SgSpinner Type="SgSpinnerType.Ring" DisplayLabel="cubic-bezier(0.68, -0.55, 0.27, 1.55)" Easing="cubic-bezier(0.68, -0.55, 0.27, 1.55)" />
                        </div>
                        <div style="text-align:center;">
                            <SgSpinner Type="SgSpinnerType.Ring" DisplayLabel="steps(4)" Easing="steps(4)" />
                        </div>
                    </div>
                </SgStack>
            </SgCard>
            <SgCard Title="CompletionAnimation" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                        Spinner → checkmark when done
                    </SgTypography>
                    <SgButton Text="Run (2s)" OnClick="RunCompletionDemo"
                              IsLoading="@_completionIsRunning"
                              Variant="SgButtonVariant.Primary" Size="SgSize.Sm" />
                    <SgSpinner Type="SgSpinnerType.Ring" IsSpinning="@_completionIsRunning"
                               CompletionAnimation="true" DisplayLabel="@(_completionIsRunning ? "Loading..." : "Done!")" />
                </SgStack>
            </SgCard>
        </div>
    </div>

    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Typing Spinner
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Chat-style typing indicator with 3 sequentially bouncing dots.
            </SgTypography>
        </div>
        <div style="display:flex;gap:28px;align-items:center;flex-wrap:wrap;padding:16px 0;">
            <div style="display:flex;gap:24px;align-items:center;flex-wrap:wrap;">
                <div style="background:var(--sg-surface);padding:12px 24px;border-radius:18px 18px 18px 4px;border:1px solid var(--sg-border);display:flex;align-items:center;gap:10px;">
                    <SgSpinner Type="SgSpinnerType.Typing" Size="SgSize.Md" />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">John is typing...</SgTypography>
                </div>
                <div style="background:var(--sg-surface);padding:12px 24px;border-radius:18px 18px 18px 4px;border:1px solid var(--sg-border);display:flex;align-items:center;gap:10px;">
                    <SgSpinner Type="SgSpinnerType.Typing" Size="SgSize.Sm" Color="#22c55e" />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Bot is thinking...</SgTypography>
                </div>
                <div style="text-align:center;">
                    <SgSpinner Type="SgSpinnerType.Typing" Size="SgSize.Lg" Variant="SgSpinnerVariant.Info" DisplayLabel="Typing..." />
                </div>
            </div>
        </div>
    </div>

    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Morph Spinner
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Morphs between circle → rounded rect → organic shape. 3D-like transform animation.
            </SgTypography>
        </div>
        <div style="display:flex;gap:28px;align-items:center;flex-wrap:wrap;padding:16px 0;">
            <div style="display:flex;gap:24px;align-items:center;flex-wrap:wrap;">
                <SgSpinner Type="SgSpinnerType.Morph" Size="SgSize.Sm" DisplayLabel="Sm" />
                <SgSpinner Type="SgSpinnerType.Morph" Size="SgSize.Md" DisplayLabel="Md" />
                <SgSpinner Type="SgSpinnerType.Morph" Size="SgSize.Lg" DisplayLabel="Lg" />
                <SgSpinner Type="SgSpinnerType.Morph" Size="SgSize.Xl" DisplayLabel="Xl" />
            </div>
        </div>
        <div style="display:flex;gap:28px;align-items:center;flex-wrap:wrap;padding-bottom:16px;">
            <SgSpinner Type="SgSpinnerType.Morph" Variant="SgSpinnerVariant.Primary" DisplayLabel="Primary" />
            <SgSpinner Type="SgSpinnerType.Morph" Variant="SgSpinnerVariant.Success" DisplayLabel="Success" />
            <SgSpinner Type="SgSpinnerType.Morph" Variant="SgSpinnerVariant.Warn" DisplayLabel="Warn" />
            <SgSpinner Type="SgSpinnerType.Morph" Variant="SgSpinnerVariant.Danger" DisplayLabel="Danger" />
            <SgSpinner Type="SgSpinnerType.Morph" Color="#a855f7" DisplayLabel="Custom" />
        </div>
    </div>

    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Size Comparison
            </SgTypography>
        </div>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;">
            <SgCard Title="Sm" Shadow="SgShadow.Sm" Size="SgSize.Sm" Style="text-align:center;">
                <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
                    <SgSpinner Type="SgSpinnerType.Dots" Size="SgSize.Sm" />
                    <SgSpinner Type="SgSpinnerType.Ring" Size="SgSize.Sm" />
                    <SgSpinner Type="SgSpinnerType.Bounce" Size="SgSize.Sm" />
                </div>
            </SgCard>
            <SgCard Title="Md" Shadow="SgShadow.Sm" Size="SgSize.Sm" Style="text-align:center;">
                <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
                    <SgSpinner Type="SgSpinnerType.Dots" Size="SgSize.Md" />
                    <SgSpinner Type="SgSpinnerType.Ring" Size="SgSize.Md" />
                    <SgSpinner Type="SgSpinnerType.Bounce" Size="SgSize.Md" />
                </div>
            </SgCard>
            <SgCard Title="Lg" Shadow="SgShadow.Sm" Size="SgSize.Sm" Style="text-align:center;">
                <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
                    <SgSpinner Type="SgSpinnerType.Dots" Size="SgSize.Lg" />
                    <SgSpinner Type="SgSpinnerType.Ring" Size="SgSize.Lg" />
                    <SgSpinner Type="SgSpinnerType.Bounce" Size="SgSize.Lg" />
                </div>
            </SgCard>
            <SgCard Title="Xl" Shadow="SgShadow.Sm" Size="SgSize.Sm" Style="text-align:center;">
                <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
                    <SgSpinner Type="SgSpinnerType.Dots" Size="SgSize.Xl" />
                    <SgSpinner Type="SgSpinnerType.Ring" Size="SgSize.Xl" />
                    <SgSpinner Type="SgSpinnerType.Bounce" Size="SgSize.Xl" />
