            <SgCard Title="Normal" Shadow="SgShadow.Sm" Size="SgSize.Sm" Style="text-align:center;">
                <div style="display:flex;gap:24px;justify-content:center;">
                    <SgSpinner Type="SgSpinnerType.Border" Speed="SgSpinnerSpeed.Normal" DisplayLabel="Border" />
                    <SgSpinner Type="SgSpinnerType.Ring" Speed="SgSpinnerSpeed.Normal" DisplayLabel="Ring" />
