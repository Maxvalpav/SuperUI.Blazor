@page "/drawer-demo"
@using SuperUI.Components

<PageTitle>Боковая панель - SUI</PageTitle>

<SgCard Title="SgDrawer - Боковая панель"
        Subtitle="Компонент для отображения боковой панели. Поддерживает различные позиции, размеры и анимации.">

    <div style="margin-top: 32px;">
        <h2>Примеры использования</h2>
        <p>Интерактивные боковые панели с различными конфигурациями.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgButton Text="Открыть справа"   Variant="SgButtonVariant.Primary"   OnClick="@(() => Open(SgPlacement.Right))" />
                    <SgButton Text="Открыть слева"                         OnClick="@(() => Open(SgPlacement.Left))" />
                    <SgButton Text="Открыть сверху"                        OnClick="@(() => Open(SgPlacement.Top))" />
                    <SgButton Text="Открыть снизу"                         OnClick="@(() => Open(SgPlacement.Bottom))" />
                    <SgButton Text="Широкая панель"   Variant="SgButtonVariant.Outlined"   OnClick="OpenWide" />
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_drawerProperties" />
            </SgCard>
        </div>
    </div>
    <div style="margin-top: 32px;">
        <h2>Позиция и перечисление SgPlacement</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="SgPlacement (для Drawer)">
                <PropertyTable Items="_placementEnum" />
            </SgCard>
        </div>
    </div>

</SgCard>

<!-- Боковая панель справа -->
<SgDrawer @bind-Visible="@_showRight" Title="Панель справа" Placement="SgPlacement.Right" Size="360px">
    <ChildContent>
        <p>Содержимое боковой панели справа.</p>
        <div style="margin-top: 16px;">
            <SgButton Text="Закрыть" OnClick="@(() => _showRight = false)" Block="true" />
        </div>
    </ChildContent>
</SgDrawer>

<!-- Боковая панель слева -->
<SgDrawer @bind-Visible="@_showLeft" Title="Панель слева" Placement="SgPlacement.Left" Size="300px">
    <ChildContent>
        <p>Содержимое боковой панели слева.</p>
        <div style="margin-top: 16px;">
            <SgButton Text="Закрыть" OnClick="@(() => _showLeft = false)" Block="true" />
        </div>
    </ChildContent>
</SgDrawer>

<!-- Боковая панель сверху -->
<SgDrawer @bind-Visible="@_showTop" Title="Панель сверху" Placement="SgPlacement.Top" Size="200px">
    <ChildContent>
        <p>Содержимое боковой панели сверху.</p>
        <div style="margin-top: 16px;">
            <SgButton Text="Закрыть" OnClick="@(() => _showTop = false)" />
        </div>
    </ChildContent>
</SgDrawer>

<!-- Боковая панель снизу -->
<SgDrawer @bind-Visible="@_showBottom" Title="Панель снизу" Placement="SgPlacement.Bottom" Size="200px">
    <ChildContent>
        <p>Содержимое боковой панели снизу.</p>
        <div style="margin-top: 16px;">
            <SgButton Text="Закрыть" OnClick="@(() => _showBottom = false)" />
        </div>
    </ChildContent>
</SgDrawer>

<!-- Широкая панель -->
<SgDrawer @bind-Visible="@_showWide" Title="Широкая панель" Placement="SgPlacement.Right" Size="600px">
    <ChildContent>
        <p>Широкая боковая панель для отображения большого объёма информации.</p>
        <div style="margin-top: 16px; display: flex; flex-direction: column; gap: 12px;">
            <SgAlert Variant="SgAlertVariant.Info" Text="Это пример содержимого широкой панели." />
            <SgButton Text="Закрыть" OnClick="@(() => _showWide = false)" Block="true" />
        </div>
    </ChildContent>
</SgDrawer>

@code {
    private bool _showRight;
    private bool _showLeft;
    private bool _showTop;
    private bool _showBottom;
    private bool _showWide;

    private void Open(SgPlacement placement)
    {
        switch (placement)
        {
            case SgPlacement.Right:  _showRight  = true; break;
            case SgPlacement.Left:   _showLeft   = true; break;
            case SgPlacement.Top:    _showTop    = true; break;
            case SgPlacement.Bottom: _showBottom = true; break;
        }
    }

    private void OpenWide() => _showWide = true;

    private List<PropertyPanelItem> _drawerProperties = new()
    {
        new() { Label = "Visible",         Value = "bool",                    BadgeText = "Видимо",                BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Title",           Value = "string",                  BadgeText = "Заголовок",              BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Placement",       Value = "right|left|top|bottom",   BadgeText = "Позиция (SgPlacement)", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Size",            Value = "string",                  BadgeText = "Размер (ширина/высота)", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ShowClose",       Value = "bool",                    BadgeText = "Кнопка закрытия",       BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "CloseOnBackdrop", Value = "bool",                    BadgeText = "Закрыть по фону",       BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Resizable",       Value = "bool",                    BadgeText = "Изменяемый размер",     BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "VisibleChanged",  Value = "EventCallback<bool>",     BadgeText = "Событие",               BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnClose",         Value = "EventCallback",           BadgeText = "Закрытие",               BadgeVariant = SgBadgeVariant.Success }
    };

    // ── Enum tables ──────────────────────────────────────────────────────────
    private List<PropertyPanelItem> _placementEnum = new()
    {
        new() { Label = "SgPlacement.Right",  Value = "\"right\"",  BadgeText = "Справа (по умолч.)", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "SgPlacement.Left",   Value = "\"left\"",   BadgeText = "Слева",               BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgPlacement.Top",    Value = "\"top\"",    BadgeText = "Сверху",              BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgPlacement.Bottom", Value = "\"bottom\"", BadgeText = "Снизу",               BadgeVariant = SgBadgeVariant.Info },
    };
}
