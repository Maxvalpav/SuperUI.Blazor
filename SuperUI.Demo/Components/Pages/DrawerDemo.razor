    {
        new() { Value = SgDrawerAnimation.Slide, Label = "Slide" }, new() { Value = SgDrawerAnimation.Fade, Label = "Fade" },
        new() { Value = SgDrawerAnimation.Scale, Label = "Scale" },
    };
    private readonly List<SgSegmentedOption<string>> _blurSegOptions = new()
    {
        new() { Value = "", Label = "Off" }, new() { Value = "4px", Label = "4px" },
        new() { Value = "8px", Label = "8px" }, new() { Value = "12px", Label = "12px" },
    };
    private readonly List<SgSegmentedOption<bool>> _boolSegOpts = new()
    {
        new() { Value = false, Label = "Off" }, new() { Value = true, Label = "On" },
    };

    protected override void OnInitialized() { UpdateConstructorCode(); }

    private void UpdateConstructorCode()
    {
        var l = new List<string>();
        l.Add("<SgDrawer @bind-Visible=\"_visible\"");
        if (_cPlacement != SgPlacement.Right) l.Add($"         Placement=\"SgPlacement.{_cPlacement}\"");
        if (_cSize != "360px") l.Add($"         Size=\"{_cSize}\"");
        if (_cAnim != SgDrawerAnimation.Slide) l.Add($"         Animation=\"SgDrawerAnimation.{_cAnim}\"");
        if (!string.IsNullOrEmpty(_cBlur)) l.Add($"         BackdropBlur=\"{_cBlur}\"");
        if (!_cShowClose) l.Add("         ShowClose=\"false\"");
        if (!_cShowHeader) l.Add("         ShowHeader=\"false\"");
        if (_cResizable) l.Add("         Resizable=\"true\"");
        if (_cNoPadding) l.Add("         NoPadding=\"true\"");
        if (_cFullScreen) l.Add("         FullScreen=\"true\"");
        if (_cLoading) l.Add("         Loading=\"true\"");
        if (!_cBackdropClose) l.Add("         CloseOnBackdrop=\"false\"");
        if (!_cEscClose) l.Add("         CloseOnEscape=\"false\"");
        l.Add($"         Title=\"{_cTitle}\">");
        l.Add("    <ChildContent>");
        l.Add("        <p>Drawer content here</p>");
        l.Add("    </ChildContent>");
        l.Add("</SgDrawer>");
        _generatedCodeLines = l.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓"; _copyLabel = "Copied!"; StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋"; _copyLabel = "Copy"; StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗"; _copyLabel = "Failed"; StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋"; _copyLabel = "Copy"; StateHasChanged();
        }
    }

