@code {
    // ── Main card header ─────────────────────────────────────────────────
    private RenderFragment _mainHeader => __builder =>
    {
        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
            <div style="display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,var(--sg-primary),#8b5cf6);color:#fff;flex-shrink:0;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="3" x2="9" y2="21"/>
                </svg>
            </div>
            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">SgDrawer</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Slide-in panel with focus trap, backdrop, resize, and full event lifecycle. 4 placements, resizable, configurable header/footer.
                </SgTypography>
            </SgStack>
        </SgStack>
    };

    // ── Drawer visibility ────────────────────────────────────────────────
    private bool _showRight, _showLeft, _showTop, _showBottom, _showWide, _showResizable, _showConstructor;

    private void OpenDrawer(SgPlacement placement)
    {
        switch (placement)
        {
            case SgPlacement.Right:  _showRight  = true; break;
            case SgPlacement.Left:   _showLeft   = true; break;
            case SgPlacement.Top:    _showTop    = true; break;
            case SgPlacement.Bottom: _showBottom = true; break;
        }
    }

    private void OpenWide() => _showWide = true;
    private void OpenResizable() => _showResizable = true;
    private void OpenConstructorDrawer() => _showConstructor = true;

    // ── Events ───────────────────────────────────────────────────────────
    private List<(string Label, string Message, SgBadgeVariant Variant)> _events = new();

    private void AddEvent(string label, string message)
    {
        var variant = label switch
        {
            "opened" => SgBadgeVariant.Success,
            "closed" => SgBadgeVariant.Default,
            _ => SgBadgeVariant.Info
        };
        _events.Add((label, message, variant));
        StateHasChanged();
    }

    private void ClearEvents() { _events.Clear(); StateHasChanged(); }

    // ── Constructor state ─────────────────────────────────────────────────
    private SgPlacement _cPlacement = SgPlacement.Right;
    private string _cSize = "360px";
    private bool _cShowClose = true;
    private bool _cShowHeader = true;
    private bool _cResizable;
    private bool _cNoPadding;
    private bool _cBackdropClose = true;
    private bool _cEscClose = true;
    private string _cTitle => $"Constructor Drawer ({_cPlacement})";

    // ── Code generation ───────────────────────────────────────────────────
    private string[] _generatedCodeLines = Array.Empty<string>();
    private string _copyIcon = "📋";
    private string _copyLabel = "Copy";

    private readonly List<SgSegmentedOption<SgPlacement>> _placementSegOptions = new()
    {
        new() { Value = SgPlacement.Right,  Label = "Right" },
        new() { Value = SgPlacement.Left,   Label = "Left" },
        new() { Value = SgPlacement.Top,    Label = "Top" },
        new() { Value = SgPlacement.Bottom, Label = "Bottom" },
    };

    private readonly List<SgSegmentedOption<string>> _sizeSegOptions = new()
    {
        new() { Value = "300px", Label = "300" },
        new() { Value = "360px", Label = "360" },
        new() { Value = "480px", Label = "480" },
        new() { Value = "600px", Label = "600" },
    };

    private readonly List<SgSegmentedOption<bool>> _boolSegOpts = new()
    {
        new() { Value = false, Label = "Off" },
        new() { Value = true,  Label = "On" },
    };

    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add($"<SgDrawer @bind-Visible=\"_visible\"");
        if (_cPlacement != SgPlacement.Right)
            lines.Add($"         Placement=\"SgPlacement.{_cPlacement}\"");
        if (_cSize != "360px")
            lines.Add($"         Size=\"{_cSize}\"");
        if (!_cShowClose)
            lines.Add($"         ShowClose=\"false\"");
        if (!_cShowHeader)
            lines.Add($"         ShowHeader=\"false\"");
        if (_cResizable)
            lines.Add($"         Resizable=\"true\"");
        if (_cNoPadding)
            lines.Add($"         NoPadding=\"true\"");
        if (!_cBackdropClose)
            lines.Add($"         CloseOnBackdrop=\"false\"");
        if (!_cEscClose)
            lines.Add($"         CloseOnEscape=\"false\"");
        lines.Add($"         Title=\"{_cTitle}\">");
        lines.Add($"    <ChildContent>");
        lines.Add($"        <p>Drawer content here</p>");
        lines.Add($"    </ChildContent>");
        lines.Add("</SgDrawer>");
        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

