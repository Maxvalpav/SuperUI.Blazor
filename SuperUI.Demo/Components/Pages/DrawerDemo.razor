@page "/drawer-demo"
@using SuperUI.Components

<PageTitle>Боковая панель - SUI</PageTitle>

<SgCard Title="SgDrawer - Боковая панель"
        Subtitle="Компонент для отображения боковой панели. Поддерживает различные позиции, размеры и анимации.">

    <div style="margin-top: 32px;">
        <h2>Примеры использования</h2>
        <p>Интерактивные боковые панели с различными конфигурациями.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgButton Text="Открыть справа" Variant="primary" OnClick="@(() => _showRight = true)" />
                    <SgButton Text="Открыть слева" OnClick="@(() => _showLeft = true)" />
                    <SgButton Text="Открыть сверху" OnClick="@(() => _showTop = true)" />
                    <SgButton Text="Открыть снизу" OnClick="@(() => _showBottom = true)" />
                    <SgButton Text="Широкая панель" Variant="outlined" OnClick="@(() => _showWide = true)" />
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_drawerProperties" />
            </SgCard>
        </div>
    </div>

</SgCard>

<!-- Боковая панель справа -->
<SgDrawer @bind-Visible="@_showRight" Title="Панель справа" Placement="right" Size="360px">
    <ChildContent>
        <p>Содержимое боковой панели справа.</p>
        <div style="margin-top: 16px;">
            <SgButton Text="Закрыть" OnClick="@(() => _showRight = false)" Block="true" />
        </div>
    </ChildContent>
</SgDrawer>

<!-- Боковая панель слева -->
<SgDrawer @bind-Visible="@_showLeft" Title="Панель слева" Placement="left" Size="300px">
    <ChildContent>
        <p>Содержимое боковой панели слева.</p>
        <div style="margin-top: 16px;">
            <SgButton Text="Закрыть" OnClick="@(() => _showLeft = false)" Block="true" />
        </div>
    </ChildContent>
</SgDrawer>

<!-- Боковая панель сверху -->
<SgDrawer @bind-Visible="@_showTop" Title="Панель сверху" Placement="top" Size="200px">
    <ChildContent>
        <p>Содержимое боковой панели сверху.</p>
        <div style="margin-top: 16px;">
            <SgButton Text="Закрыть" OnClick="@(() => _showTop = false)" />
        </div>
    </ChildContent>
</SgDrawer>

<!-- Боковая панель снизу -->
<SgDrawer @bind-Visible="@_showBottom" Title="Панель снизу" Placement="bottom" Size="200px">
    <ChildContent>
        <p>Содержимое боковой панели снизу.</p>
        <div style="margin-top: 16px;">
            <SgButton Text="Закрыть" OnClick="@(() => _showBottom = false)" />
        </div>
    </ChildContent>
</SgDrawer>

<!-- Широкая панель -->
<SgDrawer @bind-Visible="@_showWide" Title="Широкая панель" Placement="right" Size="600px">
    <ChildContent>
        <p>Широкая боковая панель для отображения большого объёма информации.</p>
        <div style="margin-top: 16px; display: flex; flex-direction: column; gap: 12px;">
            <SgAlert Variant="info" Text="Это пример содержимого широкой панели." />
            <SgButton Text="Закрыть" OnClick="@(() => _showWide = false)" Block="true" />
        </div>
    </ChildContent>
</SgDrawer>

@code {
    private bool _showRight;
    private bool _showLeft;
    private bool _showTop;
    private bool _showBottom;
    private bool _showWide;

    private List<PropertyPanelItem> _drawerProperties = new()
    {
        new() { Label = "Visible", Value = "bool", BadgeText = "Видимо", BadgeVariant = "warn" },
        new() { Label = "Title", Value = "string", BadgeText = "Заголовок", BadgeVariant = "info" },
        new() { Label = "Placement", Value = "right|left|top|bottom", BadgeText = "Позиция", BadgeVariant = "info" },
        new() { Label = "Size", Value = "string", BadgeText = "Размер (ширина/высота)", BadgeVariant = "info" },
        new() { Label = "ShowClose", Value = "bool", BadgeText = "Кнопка закрытия", BadgeVariant = "warn" },
        new() { Label = "CloseOnBackdrop", Value = "bool", BadgeText = "Закрыть по фону", BadgeVariant = "warn" },
        new() { Label = "Resizable", Value = "bool", BadgeText = "Изменяемый размер", BadgeVariant = "warn" },
        new() { Label = "VisibleChanged", Value = "EventCallback<bool>", BadgeText = "Событие", BadgeVariant = "success" },
        new() { Label = "OnClose", Value = "EventCallback", BadgeText = "Закрытие", BadgeVariant = "success" }
    };
}
