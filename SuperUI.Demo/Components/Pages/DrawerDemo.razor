    private string[] _generatedCodeLines = Array.Empty<string>();
    private string _copyIcon = "📋", _copyLabel = "Copy";

    private readonly List<SgSegmentedOption<SgPlacement>> _placementSegOptions = new()
    {
        new() { Value = SgPlacement.Right, Label = "Right" }, new() { Value = SgPlacement.Left, Label = "Left" },
        new() { Value = SgPlacement.Top, Label = "Top" }, new() { Value = SgPlacement.Bottom, Label = "Bottom" },
    };
    private readonly List<SgSegmentedOption<string>> _sizeSegOptions = new()
    {
        new() { Value = "300px", Label = "300" }, new() { Value = "360px", Label = "360" },
        new() { Value = "480px", Label = "480" }, new() { Value = "600px", Label = "600" },
    };
