    private void OpenDrawer(SgPlacement p)
    {
        switch (p) { case SgPlacement.Right: _showRight = true; break; case SgPlacement.Left: _showLeft = true; break; case SgPlacement.Top: _showTop = true; break; case SgPlacement.Bottom: _showBottom = true; break; }
    }
    private void OpenWide() => _showWide = true;
    private void OpenResizable() => _showResizable = true;
    private void OpenFullScreen() => _showFullScreen = true;
    private void OpenFadeDemo() => _showFade = true;
    private void OpenScaleDemo() => _showScale = true;
    private void OpenLoadingDemo() => _showLoading = true;
    private void OpenBlurDemo() => _showBlur = true;
    private void OpenConstructorDrawer() => _showConstructor = true;
    private void OpenCascadeDemo() { _showCascade1 = true; }

    private void OpenProgrammatic()
    {
        RenderFragment body = __builder =>
        {
            <SgStack Vertical Space="SgSize.Md">
                <SgTypography>This drawer was opened via <code>SgDrawerService</code>.</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Add <code>SgDrawerProvider</code> to MainLayout and inject <code>SgDrawerService</code> anywhere.
                </SgTypography>
                <SgButton Text="Close" Variant="SgButtonVariant.Primary" OnClick="@(() => DrawerService.CloseAll())" Block="true" />
            </SgStack>
        };
        DrawerService.Show("Programmatic Drawer", body, cfg =>
        {
            cfg.Size = "400px";
            cfg.BackdropBlur = "4px";
        });
        AddEvent("opened", "Programmatic drawer opened via service");
    }

    private List<(string Label, string Message, SgBadgeVariant Variant)> _events = new();

    private void AddEvent(string label, string message)
    {
        var variant = label switch { "opened" => SgBadgeVariant.Success, "closed" => SgBadgeVariant.Default, _ => SgBadgeVariant.Info };
        _events.Add((label, message, variant));
        StateHasChanged();
    }
    private void ClearEvents() { _events.Clear(); StateHasChanged(); }

    // ── Constructor state ─────────────────────────────────────────────────
    private SgPlacement _cPlacement = SgPlacement.Right;
    private string _cSize = "360px";
    private SgDrawerAnimation _cAnim = SgDrawerAnimation.Slide;
    private string _cBlur = "";
    private bool _cShowClose = true, _cShowHeader = true, _cNoPadding, _cResizable, _cFullScreen, _cLoading, _cBackdropClose = true, _cEscClose = true;
