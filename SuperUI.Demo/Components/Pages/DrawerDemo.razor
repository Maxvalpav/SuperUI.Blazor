@page "/drawer-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Services
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject SgDrawerService DrawerService

<PageTitle>SgDrawer — Drawer Panel — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- 1. Placement & Feature Examples                                    -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    SgDrawer — Examples
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    A slide-in panel with focus trap, backdrop, resize, swipe-to-close, cascade stacking, and full event lifecycle.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Lg">
                <SgCol Md="6">
                    <SgCard Title="Placements & Sizes" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                        <SgStack Vertical Space="SgSize.Md">
                            <SgButton Text="Open Right (default)" Variant="SgButtonVariant.Primary"
                                      PrefixIcon="@SgHeroicons.Outline.ArrowLeftOnRectangle"
                                      OnClick="@(() => OpenDrawer(SgPlacement.Right))" Block="true" />
                            <SgButton Text="Open Left" Variant="SgButtonVariant.Default"
                                      PrefixIcon="@SgHeroicons.Outline.ArrowRightOnRectangle"
                                      OnClick="@(() => OpenDrawer(SgPlacement.Left))" Block="true" />
                            <SgButton Text="Open Top" Variant="SgButtonVariant.Outlined"
                                      PrefixIcon="@SgHeroicons.Outline.ArrowUpOnSquare"
                                      OnClick="@(() => OpenDrawer(SgPlacement.Top))" Block="true" />
                            <SgButton Text="Open Bottom" Variant="SgButtonVariant.Outlined"
                                      PrefixIcon="@SgHeroicons.Outline.ArrowDownOnSquare"
                                      OnClick="@(() => OpenDrawer(SgPlacement.Bottom))" Block="true" />
                            <SgGrid Columns="2" Space="SgSize.Sm">
                                <SgButton Text="Wide (600px)" Variant="SgButtonVariant.Ghost"
                                          PrefixIcon="@SgHeroicons.Outline.ArrowsPointingOut"
                                          OnClick="OpenWide" Block="true" />
                                <SgButton Text="Resizable" Variant="SgButtonVariant.Ghost"
                                          PrefixIcon="@SgHeroicons.Outline.ArrowsRightLeft"
                                          OnClick="OpenResizable" Block="true" />
                            </SgGrid>
                        </SgStack>
                    </SgCard>
                </SgCol>
                <SgCol Md="6">
                    <SgCard Title="Advanced Features" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                        <SgStack Vertical Space="SgSize.Md">
                            <SgButton Text="FullScreen" Variant="SgButtonVariant.Outlined"
                                      PrefixIcon="@SgHeroicons.Outline.ArrowsPointingOut"
                                      OnClick="OpenFullScreen" Block="true" />
                            <SgButton Text="Fade Animation" Variant="SgButtonVariant.Outlined"
                                      PrefixIcon="@SgHeroicons.Outline.Sparkles"
                                      OnClick="OpenFadeDemo" Block="true" />
                            <SgButton Text="Scale Animation" Variant="SgButtonVariant.Outlined"
                                      PrefixIcon="@SgHeroicons.Outline.Squares2x2"
                                      OnClick="OpenScaleDemo" Block="true" />
                            <SgButton Text="Loading State" Variant="SgButtonVariant.Ghost"
                                      PrefixIcon="@SgHeroicons.Outline.Clock"
                                      OnClick="OpenLoadingDemo" Block="true" />
                            <SgButton Text="Backdrop Blur" Variant="SgButtonVariant.Ghost"
                                      PrefixIcon="@SgHeroicons.Outline.Eye"
                                      OnClick="OpenBlurDemo" Block="true" />
                            <SgButton Text="Programmatic (Service)" Variant="SgButtonVariant.Ghost"
                                      PrefixIcon="@SgHeroicons.Outline.CodeBracket"
                                      OnClick="OpenProgrammatic" Block="true" />
                        </SgStack>
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- 2. Event Log                                                       -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Event Log
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Events fired by drawers. Open any drawer to see events.
                </SgTypography>
            </div>
            <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Sm">
                    <div class="demo-event-log">
                        @if (_events.Count == 0)
                        {
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" Align="SgTypographyAlign.Center" Style="padding:12px 0;">
                                No events yet. Open a drawer to see events.
                            </SgTypography>
                        }
                        @foreach (var evt in _events)
                        {
                            <div class="demo-event-item">
                                <SgBadge Text="@evt.Label" Variant="@evt.Variant" Size="SgSize.Sm" Standalone="true" />
                                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">@evt.Message</SgTypography>
                            </div>
                        }
                    </div>
                    @if (_events.Count > 0)
                    {
                        <div style="display:flex;gap:8px;">
                            <SgButton Text="Clear" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" OnClick="ClearEvents" />
                            <SgButton Text="Demo Cascade" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" OnClick="OpenCascadeDemo" />
                        </div>
                    }
                    else
                    {
                        <SgButton Text="Demo Cascade (Stack 2 Drawers)" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" OnClick="OpenCascadeDemo" />
                    }
                </SgStack>
            </SgCard>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- 3. Live Constructor                                                -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Live SgDrawer Constructor
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Configure every parameter and preview. Click <strong>Open Drawer</strong> to see the result.
                </SgTypography>
            </div>

            <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
                <SgRow Space="SgSize.Md">

                    <!-- ── Control Panel ── -->
                    <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                        <SgStack Vertical Space="SgSize.Lg">

                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Placement</SgTypography>
                                        <SgSegmented TValue="SgPlacement"
                                                     Value="@_cPlacement"
                                                     ValueChanged="v => { _cPlacement = v; UpdateConstructorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_placementSegOptions" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                                        <SgSegmented TValue="string"
                                                     Value="@_cSize"
                                                     ValueChanged="v => { _cSize = v; UpdateConstructorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_sizeSegOptions" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>

                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Animation</SgTypography>
                                        <SgSegmented TValue="SgDrawerAnimation"
                                                     Value="@_cAnim"
                                                     ValueChanged="v => { _cAnim = v; UpdateConstructorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_animSegOptions" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">BackdropBlur</SgTypography>
                                        <SgSegmented TValue="string"
                                                     Value="@_cBlur"
                                                     ValueChanged="v => { _cBlur = v; UpdateConstructorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_blurSegOptions" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>

                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="4">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">ShowClose</SgTypography>
                                        <SgSegmented TValue="bool" Value="_cShowClose" ValueChanged="v => { _cShowClose = v; UpdateConstructorCode(); }" Block="true" Size="sm" Options="_boolSegOpts" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="4">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">ShowHeader</SgTypography>
                                        <SgSegmented TValue="bool" Value="_cShowHeader" ValueChanged="v => { _cShowHeader = v; UpdateConstructorCode(); }" Block="true" Size="sm" Options="_boolSegOpts" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="4">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">NoPadding</SgTypography>
                                        <SgSegmented TValue="bool" Value="_cNoPadding" ValueChanged="v => { _cNoPadding = v; UpdateConstructorCode(); }" Block="true" Size="sm" Options="_boolSegOpts" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>

                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="4">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Resizable</SgTypography>
                                        <SgSegmented TValue="bool" Value="_cResizable" ValueChanged="v => { _cResizable = v; UpdateConstructorCode(); }" Block="true" Size="sm" Options="_boolSegOpts" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="4">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">FullScreen</SgTypography>
                                        <SgSegmented TValue="bool" Value="_cFullScreen" ValueChanged="v => { _cFullScreen = v; UpdateConstructorCode(); }" Block="true" Size="sm" Options="_boolSegOpts" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="4">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Loading</SgTypography>
                                        <SgSegmented TValue="bool" Value="_cLoading" ValueChanged="v => { _cLoading = v; UpdateConstructorCode(); }" Block="true" Size="sm" Options="_boolSegOpts" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>

                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">CloseOnBackdrop</SgTypography>
                                        <SgSegmented TValue="bool" Value="_cBackdropClose" ValueChanged="v => { _cBackdropClose = v; UpdateConstructorCode(); }" Block="true" Size="sm" Options="_boolSegOpts" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">CloseOnEscape</SgTypography>
                                        <SgSegmented TValue="bool" Value="_cEscClose" ValueChanged="v => { _cEscClose = v; UpdateConstructorCode(); }" Block="true" Size="sm" Options="_boolSegOpts" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>

                            <div class="ctrl-summary">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Placement</SgTypography>
                                        <SgBadge Variant="SgBadgeVariant.Info" Text="@_cPlacement.ToString()" Standalone="true" />
                                    </SgStack>
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size</SgTypography>
                                        <SgBadge Variant="SgBadgeVariant.Success" Text="@_cSize" Standalone="true" />
                                    </SgStack>
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Animation</SgTypography>
                                        <SgBadge Variant="SgBadgeVariant.Default" Text="@_cAnim.ToString()" Standalone="true" />
                                    </SgStack>
                                </SgStack>
                            </div>

                            <SgButton Text="Open Drawer" Variant="SgButtonVariant.Primary"
                                      OnClick="OpenConstructorDrawer"
                                      PrefixIcon="@SgHeroicons.Outline.ArrowLeftOnRectangle"
                                      Block="true" Size="SgSize.Lg" />

                        </SgStack>
                    </SgCol>

                    <!-- ── Preview + Code ── -->
                    <SgCol Xs="12" Md="7" Style="padding:24px;">
                        <SgStack Vertical Space="SgSize.Lg">

                            <SgStack Vertical Space="SgSize.Sm">
                                <div style="display:flex;align-items:center;justify-content:space-between;">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                                </div>
                                <div class="constructor-preview">
                                    <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center" Justify="SgJustifyContent.Center" Style="min-height:120px;">
                                        <SgIcon Icon="@SgHeroicons.Outline.Squares2x2" Size="32px" Color="var(--sg-text-muted)" />
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" Align="SgTypographyAlign.Center">
                                            Configure above and click <strong>Open Drawer</strong>.
                                        </SgTypography>
                                    </SgStack>
                                </div>
                            </SgStack>

                            <SgStack Vertical Space="SgSize.Sm">
                                <div style="display:flex;align-items:center;justify-content:space-between;">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                    <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                        <span id="copy-icon">@_copyIcon</span>
                                        <span id="copy-text" style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                    </button>
                                </div>
                                <div class="code-block">
                                    @foreach (var line in _generatedCodeLines)
                                    {
                                        <code>@line</code>
                                    }
                                </div>
                            </SgStack>

                        </SgStack>
                    </SgCol>

                </SgRow>
            </SgCard>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- 4. Property Reference                                              -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Full Parameter Reference
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    All configurable parameters of <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgDrawer</SgTypography>.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Lg">
                <SgCol Md="6">
                    <SgCard Title="SgDrawer Parameters" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                        <PropertyTable Items="_drawerProperties" />
                    </SgCard>
                </SgCol>
                <SgCol Md="6">
                    <SgCard Title="Enums" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                        <PropertyTable Items="_placementEnum" />
                        <SgSpace Size="SgSize.Sm" />
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-top:16px;margin-bottom:8px;">
                            SgDrawerAnimation
                        </SgTypography>
                        <PropertyTable Items="_animEnum" />
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-top:16px;margin-bottom:8px;">
                            SgDrawerSize Presets
                        </SgTypography>
                        <PropertyTable Items="_sizeEnum" />
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

    </ChildContent>
</SgCard>

<!-- ── Drawers ────────────────────────────────────────────────────────────── -->

<!-- Right -->
<SgDrawer @bind-Visible="@_showRight" Title="Right Panel" Placement="SgPlacement.Right" Size="360px"
           OnClosed="@(() => AddEvent("closed", "Right drawer closed"))"
           OnOpened="@(() => AddEvent("opened", "Right drawer opened"))">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md">
            <SgTypography>Right drawer panel.</SgTypography>
            <SgAlert Text="Slides in from the right side." Variant="SgAlertVariant.Info" />
            <SgButton Text="Close" OnClick="@(() => _showRight = false)" Block="true" />
        </SgStack>
    </ChildContent>
</SgDrawer>

<!-- Left -->
<SgDrawer @bind-Visible="@_showLeft" Title="Left Panel" Placement="SgPlacement.Left" Size="320px"
           OnClosed="@(() => AddEvent("closed", "Left drawer closed"))"
           OnOpened="@(() => AddEvent("opened", "Left drawer opened"))">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md">
            <SgTypography>Left drawer panel.</SgTypography>
            <SgButton Text="Close" OnClick="@(() => _showLeft = false)" Block="true" />
        </SgStack>
    </ChildContent>
</SgDrawer>

<!-- Top -->
<SgDrawer @bind-Visible="@_showTop" Title="Top Panel" Placement="SgPlacement.Top" Size="200px"
           OnClosed="@(() => AddEvent("closed", "Top drawer closed"))"
           OnOpened="@(() => AddEvent("opened", "Top drawer opened"))">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
            <SgTypography>Top drawer.</SgTypography>
            <SgButton Text="Close" OnClick="@(() => _showTop = false)" />
        </SgStack>
    </ChildContent>
</SgDrawer>

<!-- Bottom -->
<SgDrawer @bind-Visible="@_showBottom" Title="Bottom Panel" Placement="SgPlacement.Bottom" Size="200px"
           OnClosed="@(() => AddEvent("closed", "Bottom drawer closed"))"
           OnOpened="@(() => AddEvent("opened", "Bottom drawer opened"))">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
            <SgTypography>Bottom drawer.</SgTypography>
            <SgButton Text="Close" OnClick="@(() => _showBottom = false)" />
        </SgStack>
    </ChildContent>
</SgDrawer>

<!-- Wide -->
<SgDrawer @bind-Visible="@_showWide" Title="Wide Panel (600px)" Placement="SgPlacement.Right" Size="600px"
           OnClosed="@(() => AddEvent("closed", "Wide drawer closed"))"
           OnOpened="@(() => AddEvent("opened", "Wide drawer opened"))">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Lg">
            <SgAlert Text="Wide drawer for more content." Variant="SgAlertVariant.Info" />
            <SgStack Horizontal Space="SgSize.Sm">
                <SgButton Text="Close" OnClick="@(() => _showWide = false)" Variant="SgButtonVariant.Primary" />
            </SgStack>
        </SgStack>
    </ChildContent>
</SgDrawer>

<!-- Resizable -->
<SgDrawer @bind-Visible="@_showResizable" Title="Resizable" Placement="SgPlacement.Right" Size="360px"
           Resizable="true"
           OnClosed="@(() => AddEvent("closed", "Resizable drawer closed"))"
           OnOpened="@(() => AddEvent("opened", "Resizable drawer opened"))">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md">
            <SgTypography>Drag the left edge to resize. Min: 200px.</SgTypography>
            <SgButton Text="Close" OnClick="@(() => _showResizable = false)" Block="true" />
        </SgStack>
    </ChildContent>
</SgDrawer>

<!-- FullScreen -->
<SgDrawer @bind-Visible="@_showFullScreen" Title="FullScreen Drawer" Placement="SgPlacement.Right" Size="400px"
           FullScreen="true" ShowClose="true"
           OnClosed="@(() => AddEvent("closed", "FullScreen drawer closed"))"
           OnOpened="@(() => AddEvent("opened", "FullScreen drawer opened"))">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Lg" Align="SgAlignItems.Center" Justify="SgJustifyContent.Center" Style="min-height:300px;">
            <SgIcon Icon="@SgHeroicons.Outline.ArrowsPointingOut" Size="48px" Color="var(--sg-primary)" />
            <SgTypography Variant="SgTypographyVariant.Heading5">FullScreen Drawer</SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" Align="SgTypographyAlign.Center">
                Takes up the entire viewport regardless of Size and Placement.
            </SgTypography>
            <SgButton Text="Close" OnClick="@(() => _showFullScreen = false)" Variant="SgButtonVariant.Primary" />
        </SgStack>
    </ChildContent>
</SgDrawer>

<!-- Fade Animation -->
<SgDrawer @bind-Visible="@_showFade" Title="Fade Animation" Placement="SgPlacement.Right" Size="360px"
           Animation="SgDrawerAnimation.Fade"
           OnClosed="@(() => AddEvent("closed", "Fade drawer closed"))"
           OnOpened="@(() => AddEvent("opened", "Fade drawer opened"))">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md">
            <SgTypography>Fades in/out instead of sliding.</SgTypography>
            <SgButton Text="Close" OnClick="@(() => _showFade = false)" Block="true" />
        </SgStack>
    </ChildContent>
</SgDrawer>

<!-- Scale Animation -->
<SgDrawer @bind-Visible="@_showScale" Title="Scale Animation" Placement="SgPlacement.Right" Size="360px"
           Animation="SgDrawerAnimation.Scale"
           OnClosed="@(() => AddEvent("closed", "Scale drawer closed"))"
           OnOpened="@(() => AddEvent("opened", "Scale drawer opened"))">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md">
            <SgTypography>Scales in/out from center.</SgTypography>
            <SgButton Text="Close" OnClick="@(() => _showScale = false)" Block="true" />
        </SgStack>
    </ChildContent>
</SgDrawer>

<!-- Loading -->
<SgDrawer @bind-Visible="@_showLoading" Title="Loading State" Placement="SgPlacement.Right" Size="360px"
           Loading="true"
           OnClosed="@(() => AddEvent("closed", "Loading drawer closed"))"
           OnOpened="@(() => AddEvent("opened", "Loading drawer opened"))">
    <ChildContent>
        <SgTypography>This content is hidden while loading=true.</SgTypography>
    </ChildContent>
</SgDrawer>

<!-- Backdrop Blur -->
<SgDrawer @bind-Visible="@_showBlur" Title="Backdrop Blur" Placement="SgPlacement.Right" Size="360px"
           BackdropBlur="6px"
           OnClosed="@(() => AddEvent("closed", "Blur drawer closed"))"
           OnOpened="@(() => AddEvent("opened", "Blur drawer opened"))">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md">
            <SgTypography>Notice the blurred backdrop behind this drawer.</SgTypography>
            <SgButton Text="Close" OnClick="@(() => _showBlur = false)" Block="true" />
        </SgStack>
    </ChildContent>
</SgDrawer>

<!-- Cascade Drawers -->
<SgDrawer @bind-Visible="@_showCascade1" Title="Cascade 1 — Layer 1" Placement="SgPlacement.Right" Size="400px"
           OnClosed="@(() => AddEvent("closed", "Cascade 1 closed"))"
           OnOpened="@(() => AddEvent("opened", "Cascade 1 opened"))">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md">
            <SgTypography>This is layer 1 of the cascade.</SgTypography>
            <SgBadge Text="Notice the offset — drawer 2 pushes this one left" Variant="SgBadgeVariant.Warn" Standalone="true" />
            <SgButton Text="Open Layer 2" Variant="SgButtonVariant.Primary"
                      OnClick="@(() => _showCascade2 = true)" Block="true" />
            <SgButton Text="Close All" Variant="SgButtonVariant.Ghost"
                      OnClick="@(() => { _showCascade1 = false; _showCascade2 = false; })" Block="true" />
        </SgStack>
    </ChildContent>
</SgDrawer>

<SgDrawer @bind-Visible="@_showCascade2" Title="Cascade 2 — Layer 2" Placement="SgPlacement.Right" Size="360px"
           OnClosed="@(() => { AddEvent("closed", "Cascade 2 closed"); })"
           OnOpened="@(() => { AddEvent("opened", "Cascade 2 opened"); })">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md">
            <SgTypography>Layer 2 — stacked on top of Layer 1.</SgTypography>
            <SgButton Text="Close" OnClick="@(() => { _showCascade2 = false; _showCascade1 = false; })" Block="true" />
        </SgStack>
    </ChildContent>
</SgDrawer>

<!-- Constructor Drawer -->
<SgDrawer @bind-Visible="@_showConstructor" Title="@_cTitle" Placement="@_cPlacement"
           Size="@_cSize" ShowClose="@_cShowClose" ShowHeader="@_cShowHeader"
           Resizable="@_cResizable" NoPadding="@_cNoPadding" FullScreen="@_cFullScreen"
           Loading="@_cLoading" Animation="@_cAnim" BackdropBlur="@_cBlur"
           CloseOnBackdrop="@_cBackdropClose" CloseOnEscape="@_cEscClose"
           OnClosed="@(() => AddEvent("closed", "Constructor drawer closed"))"
           OnOpened="@(() => AddEvent("opened", "Constructor drawer opened"))">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center" Justify="SgJustifyContent.Center" Style="min-height:200px;">
            <SgIcon Icon="@SgHeroicons.Outline.Beaker" Size="48px" Color="var(--sg-primary)" />
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold" Align="SgTypographyAlign.Center">
