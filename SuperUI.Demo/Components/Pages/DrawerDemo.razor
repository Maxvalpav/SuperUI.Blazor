@page "/drawer-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgDrawer — Drawer Panel — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- 1. Placement Examples                                              -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    SgDrawer — Placement Examples
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    A slide-in panel with focus trap, backdrop, and configurable placement.
                    Click a button to open a drawer from that side.
                </SgTypography>
            </div>

            <div class="demo-two-col">
                <SgCard Title="Placements" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgButton Text="Open Right (default)" Variant="SgButtonVariant.Primary"
                                  PrefixIcon="@SgHeroicons.Outline.ArrowLeftOnRectangle"
                                  OnClick="@(() => OpenDrawer(SgPlacement.Right))" Block="true" />
                        <SgButton Text="Open Left" Variant="SgButtonVariant.Default"
                                  PrefixIcon="@SgHeroicons.Outline.ArrowRightOnRectangle"
                                  OnClick="@(() => OpenDrawer(SgPlacement.Left))" Block="true" />
                        <SgButton Text="Open Top" Variant="SgButtonVariant.Outlined"
                                  PrefixIcon="@SgHeroicons.Outline.ArrowUpOnSquare"
                                  OnClick="@(() => OpenDrawer(SgPlacement.Top))" Block="true" />
                        <SgButton Text="Open Bottom" Variant="SgButtonVariant.Outlined"
                                  PrefixIcon="@SgHeroicons.Outline.ArrowDownOnSquare"
                                  OnClick="@(() => OpenDrawer(SgPlacement.Bottom))" Block="true" />
                        <SgButton Text="Wide (600px)" Variant="SgButtonVariant.Ghost"
                                  PrefixIcon="@SgHeroicons.Outline.ArrowsPointingOut"
                                  OnClick="OpenWide" Block="true" />
                        <SgButton Text="Resizable" Variant="SgButtonVariant.Ghost"
                                  PrefixIcon="@SgHeroicons.Outline.ArrowsRightLeft"
                                  OnClick="OpenResizable" Block="true" />
                    </SgStack>
                </SgCard>

                <SgCard Title="SgDrawer Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_drawerProperties" />
                </SgCard>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- 2. Event Log                                                       -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Event Log
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Events fired by drawers. Open any drawer above to see events appear.
                </SgTypography>
            </div>
            <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Sm">
                    <div class="demo-event-log" id="demo-event-log">
                        @if (_events.Count == 0)
                        {
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" Align="SgTypographyAlign.Center" Style="padding:12px 0;">
                                No events yet. Open a drawer to see events.
                            </SgTypography>
                        }
                        @foreach (var evt in _events)
                        {
                            <div class="demo-event-item">
                                <SgBadge Text="@evt.Label" Variant="@evt.Variant" Size="SgSize.Sm" Standalone="true" />
                                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">@evt.Message</SgTypography>
                            </div>
                        }
                    </div>
                    @if (_events.Count > 0)
                    {
                        <SgButton Text="Clear Events" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" OnClick="ClearEvents" />
                    }
                </SgStack>
            </SgCard>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- 3. Live Constructor                                                -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Live SgDrawer Constructor
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Configure parameters and see the result in real time. Click <strong>Open Drawer</strong> to preview.
                </SgTypography>
            </div>

            <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
                <SgRow Space="SgSize.Md">

                    <!-- ── Control Panel ── -->
                    <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                        <SgStack Vertical Space="SgSize.Lg">

                            <!-- Placement -->
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Placement</SgTypography>
                                <SgSegmented TValue="SgPlacement"
                                             Value="@_cPlacement"
                                             ValueChanged="v => { _cPlacement = v; UpdateConstructorCode(); }"
                                             Block="true" Size="sm"
                                             Options="_placementSegOptions" />
                            </SgStack>

                            <!-- Size -->
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                                <SgSegmented TValue="string"
                                             Value="@_cSize"
                                             ValueChanged="v => { _cSize = v; UpdateConstructorCode(); }"
                                             Block="true" Size="sm"
                                             Options="_sizeSegOptions" />
                            </SgStack>

                            <!-- Toggles -->
                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">ShowClose</SgTypography>
                                        <SgSegmented TValue="bool"
                                                     Value="_cShowClose"
                                                     ValueChanged="v => { _cShowClose = v; UpdateConstructorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_boolSegOpts" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">ShowHeader</SgTypography>
                                        <SgSegmented TValue="bool"
                                                     Value="_cShowHeader"
                                                     ValueChanged="v => { _cShowHeader = v; UpdateConstructorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_boolSegOpts" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>
                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Resizable</SgTypography>
                                        <SgSegmented TValue="bool"
                                                     Value="_cResizable"
                                                     ValueChanged="v => { _cResizable = v; UpdateConstructorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_boolSegOpts" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">NoPadding</SgTypography>
                                        <SgSegmented TValue="bool"
                                                     Value="_cNoPadding"
                                                     ValueChanged="v => { _cNoPadding = v; UpdateConstructorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_boolSegOpts" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>

                            <!-- Close behavior -->
                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">CloseOnBackdrop</SgTypography>
                                        <SgSegmented TValue="bool"
                                                     Value="_cBackdropClose"
                                                     ValueChanged="v => { _cBackdropClose = v; UpdateConstructorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_boolSegOpts" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">CloseOnEscape</SgTypography>
                                        <SgSegmented TValue="bool"
                                                     Value="_cEscClose"
                                                     ValueChanged="v => { _cEscClose = v; UpdateConstructorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_boolSegOpts" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>

                            <!-- Summary -->
                            <div class="ctrl-summary">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Placement</SgTypography>
                                        <SgBadge Variant="SgBadgeVariant.Info" Text="@_cPlacement.ToString()" Standalone="true" />
                                    </SgStack>
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size</SgTypography>
                                        <SgBadge Variant="SgBadgeVariant.Success" Text="@_cSize" Standalone="true" />
                                    </SgStack>
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Resizable</SgTypography>
                                        <SgBadge Variant="@(_cResizable ? SgBadgeVariant.Warn : SgBadgeVariant.Default)" Text="@(_cResizable ? "Yes" : "No")" Standalone="true" />
                                    </SgStack>
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">NoPadding</SgTypography>
                                        <SgBadge Variant="@(_cNoPadding ? SgBadgeVariant.Warn : SgBadgeVariant.Default)" Text="@(_cNoPadding ? "Yes" : "No")" Standalone="true" />
                                    </SgStack>
                                </SgStack>
                            </div>

                            <!-- Open Button -->
                            <SgButton Text="Open Drawer" Variant="SgButtonVariant.Primary"
                                      OnClick="OpenConstructorDrawer"
                                      PrefixIcon="@SgHeroicons.Outline.ArrowLeftOnRectangle"
                                      Block="true" Size="SgSize.Lg" />

                        </SgStack>
                    </SgCol>

                    <!-- ── Preview + Code ── -->
                    <SgCol Xs="12" Md="7" Style="padding:24px;">
                        <SgStack Vertical Space="SgSize.Lg">

                            <!-- Preview -->
                            <SgStack Vertical Space="SgSize.Sm">
                                <div style="display:flex;align-items:center;justify-content:space-between;">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                                </div>
                                <div class="constructor-preview" id="constructor-preview">
                                    <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center" Justify="SgJustifyContent.Center" Style="min-height:120px;">
                                        <SgIcon Icon="@SgHeroicons.Outline.Squares2x2" Size="32px" Color="var(--sg-text-muted)" />
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" Align="SgTypographyAlign.Center">
                                            Configure the drawer above and click <strong>Open Drawer</strong> to preview.
                                        </SgTypography>
                                    </SgStack>
                                </div>
                            </SgStack>

                            <!-- Code with Copy -->
                            <SgStack Vertical Space="SgSize.Sm">
                                <div style="display:flex;align-items:center;justify-content:space-between;">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                    <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                        <span id="copy-icon">@_copyIcon</span>
                                        <span id="copy-text" style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                    </button>
                                </div>
                                <div class="code-block" id="code-block">
                                    @foreach (var line in _generatedCodeLines)
                                    {
                                        <code>@line</code>
                                    }
                                </div>
                            </SgStack>

                        </SgStack>
                    </SgCol>

                </SgRow>
            </SgCard>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- 4. SgPlacement Enum                                               -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    SgPlacement — Position Options
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    The <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Placement</SgTypography> parameter determines which side the drawer slides in from.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Lg">
                <SgCol Md="6">
                    <SgCard Title="SgPlacement (for Drawer)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                        <PropertyTable Items="_placementEnum" />
                    </SgCard>
                </SgCol>
                <SgCol Md="6">
                    <SgCard Title="Tips" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                        <SgStack Vertical Space="SgSize.Md">
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Right</SgTypography> is the default placement. Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Size</SgTypography> to control width (left/right) or height (top/bottom).
                            </SgTypography>
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                                Enable <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Resizable</SgTypography> to let users drag the edge to resize.
                            </SgTypography>
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                                Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">HeaderContent</SgTypography> for a custom header or <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ShowHeader=false</SgTypography> to hide it entirely.
                            </SgTypography>
                        </SgStack>
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

    </ChildContent>
</SgCard>

<!-- ── Drawers ────────────────────────────────────────────────────────────── -->

<!-- Right -->
<SgDrawer @bind-Visible="@_showRight" Title="Right Panel" Placement="SgPlacement.Right" Size="360px"
           OnClose="@(() => AddEvent("closed", "Right drawer closed"))"
           OnOpened="@(() => AddEvent("opened", "Right drawer opened"))">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md">
            <SgTypography>This is the right drawer panel.</SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Content goes in the <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ChildContent</SgTypography>.
            </SgTypography>
            <SgAlert Text="You can put any content here." Variant="SgAlertVariant.Info" />
            <SgButton Text="Close" OnClick="@(() => _showRight = false)" Block="true" />
        </SgStack>
    </ChildContent>
</SgDrawer>

<!-- Left -->
<SgDrawer @bind-Visible="@_showLeft" Title="Left Panel" Placement="SgPlacement.Left" Size="320px"
           OnClose="@(() => AddEvent("closed", "Left drawer closed"))"
           OnOpened="@(() => AddEvent("opened", "Left drawer opened"))">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md">
            <SgTypography>This is the left drawer panel.</SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Slides in from the left side.
            </SgTypography>
            <SgButton Text="Close" OnClick="@(() => _showLeft = false)" Block="true" />
        </SgStack>
    </ChildContent>
</SgDrawer>

<!-- Top -->
<SgDrawer @bind-Visible="@_showTop" Title="Top Panel" Placement="SgPlacement.Top" Size="200px"
           OnClose="@(() => AddEvent("closed", "Top drawer closed"))"
           OnOpened="@(() => AddEvent("opened", "Top drawer opened"))">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
            <SgTypography>Top drawer — slides down from the top.</SgTypography>
            <SgButton Text="Close" OnClick="@(() => _showTop = false)" />
        </SgStack>
    </ChildContent>
</SgDrawer>

<!-- Bottom -->
<SgDrawer @bind-Visible="@_showBottom" Title="Bottom Panel" Placement="SgPlacement.Bottom" Size="200px"
           OnClose="@(() => AddEvent("closed", "Bottom drawer closed"))"
           OnOpened="@(() => AddEvent("opened", "Bottom drawer opened"))">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
            <SgTypography>Bottom drawer — slides up from the bottom.</SgTypography>
            <SgButton Text="Close" OnClick="@(() => _showBottom = false)" />
        </SgStack>
    </ChildContent>
</SgDrawer>

<!-- Wide -->
<SgDrawer @bind-Visible="@_showWide" Title="Wide Panel (600px)" Placement="SgPlacement.Right" Size="600px"
           OnClose="@(() => AddEvent("closed", "Wide drawer closed"))"
           OnOpened="@(() => AddEvent("opened", "Wide drawer opened"))">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Lg">
            <SgAlert Text="This wide drawer can hold more content." Variant="SgAlertVariant.Info" />
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Size="600px"</SgTypography> for wider panels.
            </SgTypography>
            <SgStack Horizontal Space="SgSize.Sm">
                <SgButton Text="Close" OnClick="@(() => _showWide = false)" Variant="SgButtonVariant.Primary" />
                <SgButton Text="Action" Variant="SgButtonVariant.Outlined" />
            </SgStack>
        </SgStack>
    </ChildContent>
</SgDrawer>

<!-- Resizable -->
<SgDrawer @bind-Visible="@_showResizable" Title="Resizable Drawer" Placement="SgPlacement.Right" Size="360px"
           Resizable="true"
           OnClose="@(() => AddEvent("closed", "Resizable drawer closed"))"
           OnOpened="@(() => AddEvent("opened", "Resizable drawer opened"))">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md">
            <SgTypography>Resizable drawer — drag the left edge to resize.</SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" Align="SgTypographyAlign.Center">
                Min: 200px · Default: 360px
            </SgTypography>
            <SgButton Text="Close" OnClick="@(() => _showResizable = false)" Block="true" />
        </SgStack>
    </ChildContent>
</SgDrawer>

<!-- Constructor Drawer -->
<SgDrawer @bind-Visible="@_showConstructor" Title="@_cTitle" Placement="@_cPlacement"
           Size="@_cSize" ShowClose="@_cShowClose" ShowHeader="@_cShowHeader"
           Resizable="@_cResizable" NoPadding="@_cNoPadding"
           CloseOnBackdrop="@_cBackdropClose" CloseOnEscape="@_cEscClose"
           OnClose="@(() => AddEvent("closed", "Constructor drawer closed"))"
           OnOpened="@(() => AddEvent("opened", "Constructor drawer opened"))">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center" Justify="SgJustifyContent.Center" Style="min-height:200px;">
            <SgIcon Icon="@SgHeroicons.Outline.Beaker" Size="48px" Color="var(--sg-primary)" />
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold" Align="SgTypographyAlign.Center">
                Constructor Drawer
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" Align="SgTypographyAlign.Center">
                This drawer was generated from the constructor settings.
            </SgTypography>
            <SgButton Text="Close" OnClick="@(() => _showConstructor = false)" Variant="SgButtonVariant.Primary" />
        </SgStack>
    </ChildContent>
</SgDrawer>

<style>
    /* ── Section layout ─────────────────────────────────────────────────────── */
    .demo-section {
        margin-top: 48px;
    }
    .demo-section-header {
        margin-bottom: 20px;
    }

    .demo-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }
    @@media (max-width: 768px) {
        .demo-two-col { grid-template-columns: 1fr; }
    }

    /* ── Constructor ────────────────────────────────────────────────────────── */
    .constructor-preview {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 16px;
        min-height: 120px;
        transition: all 0.3s ease;
    }
    .ctrl-summary {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 12px 14px;
    }
    .code-block {
        background: #0f172a;
        color: #7dd3fc;
        padding: 14px 16px;
        border-radius: 8px;
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 12px;
        line-height: 1.9;
        overflow-x: auto;
        position: relative;
    }
    .code-block code {
        background: none;
        padding: 0;
        color: inherit;
        font-size: inherit;
        display: block;
        white-space: pre;
    }

    /* ── Copy button ────────────────────────────────────────────────────────── */
    .demo-copy-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 6px;
        padding: 4px 10px;
        cursor: pointer;
        color: var(--sg-text-muted);
        transition: all 0.2s ease;
        font-family: inherit;
    }
    .demo-copy-btn:hover {
        color: var(--sg-primary);
        border-color: var(--sg-primary);
