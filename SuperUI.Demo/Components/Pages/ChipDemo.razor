                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Ripple</SgTypography>
                                    <SgSwitch Value="@_ctorRipple"
                                              ValueChanged="v => { _ctorRipple = v; UpdateCtorCode(); }" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Copyable</SgTypography>
                                    <SgSwitch Value="@_ctorCopyable"
                                              ValueChanged="v => { _ctorCopyable = v; UpdateCtorCode(); }" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Entrance animation -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Entrance Animation</SgTypography>
                            <SgSegmented TValue="string"
