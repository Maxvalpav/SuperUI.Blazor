@page "/chip-demo"
@using SuperUI.Components

<PageTitle>Chip — SUI</PageTitle>

<SgCard Title="SgChip — Чип"
        Subtitle="Компактный интерактивный элемент для меток, фильтров, тегов и статусов. Поддерживает выбор, закрытие, иконки, аватары и счётчики.">

    <!-- Варианты -->
    <div style="margin-top: 32px;">
        <h2>Варианты (SgChipVariant)</h2>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Обычные">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Стандартные</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgChip Text="Default" />
                            <SgChip Text="Primary" Variant="SgChipVariant.Primary" />
                            <SgChip Text="Success" Variant="SgChipVariant.Success" />
                            <SgChip Text="Danger"  Variant="SgChipVariant.Danger" />
                            <SgChip Text="Warn"    Variant="SgChipVariant.Warn" />
                            <SgChip Text="Info"    Variant="SgChipVariant.Info" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Outlined</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgChip Text="Default" Outlined="true" />
                            <SgChip Text="Primary" Variant="SgChipVariant.Primary" Outlined="true" />
                            <SgChip Text="Success" Variant="SgChipVariant.Success" Outlined="true" />
                            <SgChip Text="Danger"  Variant="SgChipVariant.Danger"  Outlined="true" />
                            <SgChip Text="Warn"    Variant="SgChipVariant.Warn"    Outlined="true" />
                            <SgChip Text="Info"    Variant="SgChipVariant.Info"    Outlined="true" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Размеры</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgChip Text="Small"  Size="SgSize.Sm" Variant="SgChipVariant.Primary" />
                            <SgChip Text="Medium" Size="SgSize.Md" Variant="SgChipVariant.Primary" />
                            <SgChip Text="Large"  Size="SgSize.Lg" Variant="SgChipVariant.Primary" />
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_basicProps" />
            </SgCard>
        </div>
    </div>

    <!-- Иконки, аватары, точки -->
    <div style="margin-top: 32px;">
        <h2>Иконки, аватары, точки</h2>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">С иконкой</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgChip Text="Настройки" Variant="SgChipVariant.Primary">
                                <Icon><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg></Icon>
                            </SgChip>
                            <SgChip Text="Активен" Variant="SgChipVariant.Success">
                                <Icon><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></Icon>
                            </SgChip>
                            <SgChip Text="Ошибка" Variant="SgChipVariant.Danger">
                                <Icon><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></Icon>
                            </SgChip>
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">С аватаром</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgChip Text="Иван П.">
                                <Avatar><img src="https://i.pravatar.cc/32?img=1" alt="avatar" style="width:100%;height:100%;object-fit:cover;" /></Avatar>
                            </SgChip>
                            <SgChip Text="Мария С." Variant="SgChipVariant.Primary">
                                <Avatar><img src="https://i.pravatar.cc/32?img=5" alt="avatar" style="width:100%;height:100%;object-fit:cover;" /></Avatar>
                            </SgChip>
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Со статусной точкой</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgChip Text="Онлайн"    Dot="true" Variant="SgChipVariant.Success" />
                            <SgChip Text="Занят"     Dot="true" Variant="SgChipVariant.Warn" />
                            <SgChip Text="Оффлайн"   Dot="true" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Со счётчиком</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgChip Text="Входящие"  Count="5"   Variant="SgChipVariant.Primary" />
                            <SgChip Text="Задачи"    Count="12"  Variant="SgChipVariant.Warn" />
                            <SgChip Text="Ошибки"    Count="150" MaxCount="99" Variant="SgChipVariant.Danger" />
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_iconProps" />
            </SgCard>
        </div>
    </div>

    <!-- Фильтры (toggle) -->
    <div style="margin-top: 32px;">
        <h2>Фильтры — выбор</h2>
        <p>Чипы с двусторонней привязкой <code>@@bind-Selected</code> работают как переключатели.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Одиночный выбор</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            @foreach (var f in _filters)
                            {
                                <SgChip Text="@f.Label"
                                        Variant="SgChipVariant.Primary"
                                        @bind-Selected="f.Selected"
                                        Clickable="true" />
                            }
                        </div>
                        <div style="margin-top: 8px; font-size: 12px; color: var(--sui-text-muted);">
                            Выбрано: <strong>@(string.Join(", ", _filters.Where(f => f.Selected).Select(f => f.Label)) is { Length: > 0 } s ? s : "—")</strong>
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">С галочкой при выборе</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            @foreach (var f in _checkFilters)
                            {
                                <SgChip Text="@f.Label"
                                        Variant="SgChipVariant.Info"
                                        @bind-Selected="f.Selected"
                                        ShowCheck="true"
                                        Clickable="true" />
                            }
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_selectProps" />
            </SgCard>
        </div>
    </div>

    <!-- Закрываемые -->
    <div style="margin-top: 32px;">
        <h2>Закрываемые теги</h2>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Теги с кнопкой удаления</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            @foreach (var tag in _tags)
                            {
                                <SgChip Text="@tag.Label"
                                        Variant="@tag.Variant"
                                        Closable="true"
                                        OnClose="@(() => _tags.Remove(tag))" />
                            }
                            @if (_tags.Count == 0)
                            {
                                <span style="font-size: 12px; color: var(--sui-text-muted);">Все теги удалены</span>
                            }
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Состояния</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgChip Text="Обычный"    Closable="true" />
                            <SgChip Text="Disabled"   Closable="true" Disabled="true" />
                            <SgChip Text="Loading"    Closable="true" Loading="true" />
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_closeProps" />
            </SgCard>
        </div>
    </div>

    <!-- Кликабельные и ссылки -->
    <div style="margin-top: 32px;">
        <h2>Кликабельные и ссылки</h2>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Кликабельные</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgChip Text="Нажми меня" Clickable="true" Variant="SgChipVariant.Primary"
                                    OnClick="@(_ => _clickCount++)" />
                            <SgChip Text="@($"Нажато: {_clickCount}")" Variant="SgChipVariant.Info" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Ссылка</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgChip Text="GitHub" Href="https://github.com" Target="_blank" Variant="SgChipVariant.Primary">
                                <Icon><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg></Icon>
                            </SgChip>
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Пользовательский цвет</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgChip Text="Фиолетовый" Color="#7c3aed" TextColor="#fff" />
                            <SgChip Text="Оранжевый"  Color="#ea580c" TextColor="#fff" />
                            <SgChip Text="Бирюзовый"  Color="#0891b2" TextColor="#fff" />
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_clickProps" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private int _clickCount;

    private class FilterItem { public string Label = ""; public bool Selected; }

    private List<FilterItem> _filters = new()
    {
        new() { Label = "Все" },
        new() { Label = "Активные", Selected = true },
        new() { Label = "Завершённые" },
        new() { Label = "Архив" },
    };

    private List<FilterItem> _checkFilters = new()
    {
        new() { Label = "React" },
        new() { Label = "Blazor", Selected = true },
        new() { Label = "Vue" },
        new() { Label = "Angular" },
    };

    private class TagItem { public string Label = ""; public SgChipVariant Variant; }

    private List<TagItem> _tags = new()
    {
        new() { Label = "C#",         Variant = SgChipVariant.Primary },
        new() { Label = "Blazor",     Variant = SgChipVariant.Info },
        new() { Label = "TypeScript", Variant = SgChipVariant.Warn },
        new() { Label = "Docker",     Variant = SgChipVariant.Success },
        new() { Label = "Redis",      Variant = SgChipVariant.Danger },
    };

    private List<PropertyPanelItem> _basicProps = new()
    {
        new() { Label = "Text",     Value = "string",         BadgeText = "Текст",          BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Variant",  Value = "SgChipVariant",  BadgeText = "Вариант",         BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Size",     Value = "SgSize",         BadgeText = "Размер",          BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Outlined", Value = "bool",           BadgeText = "Без заливки",     BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Disabled", Value = "bool",           BadgeText = "Отключён",        BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Loading",  Value = "bool",           BadgeText = "Загрузка",        BadgeVariant = SgBadgeVariant.Warn },
    };

    private List<PropertyPanelItem> _iconProps = new()
    {
        new() { Label = "Icon",           Value = "RenderFragment",  BadgeText = "Иконка слева",    BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Avatar",         Value = "RenderFragment",  BadgeText = "Аватар",          BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "LeadingContent", Value = "RenderFragment",  BadgeText = "Произвольно",     BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "TrailingContent",Value = "RenderFragment",  BadgeText = "Справа от текста",BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Dot",            Value = "bool",            BadgeText = "Статусная точка", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Count",          Value = "int?",            BadgeText = "Счётчик",         BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "MaxCount",       Value = "int (99)",        BadgeText = "Макс. счётчик",   BadgeVariant = SgBadgeVariant.Info },
    };

    private List<PropertyPanelItem> _selectProps = new()
    {
        new() { Label = "Selected",        Value = "bool",              BadgeText = "Выбран",          BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "SelectedChanged", Value = "EventCallback<bool>",BadgeText = "Two-way binding", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Selectable",      Value = "bool",              BadgeText = "Переключатель",   BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowCheck",       Value = "bool (true)",       BadgeText = "Галочка",         BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Clickable",       Value = "bool",              BadgeText = "Кликабельный",    BadgeVariant = SgBadgeVariant.Warn },
    };

    private List<PropertyPanelItem> _closeProps = new()
    {
        new() { Label = "Closable", Value = "bool",          BadgeText = "Кнопка ×",       BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "OnClose",  Value = "EventCallback", BadgeText = "Событие закрытия",BadgeVariant = SgBadgeVariant.Success },
    };

    private List<PropertyPanelItem> _clickProps = new()
    {
        new() { Label = "Clickable",  Value = "bool",                    BadgeText = "Кнопка",       BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "OnClick",    Value = "EventCallback<MouseEventArgs>", BadgeText = "Клик",   BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Href",       Value = "string",                  BadgeText = "Ссылка",       BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Target",     Value = "string",                  BadgeText = "target",       BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Color",      Value = "string",                  BadgeText = "Цвет фона",    BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "TextColor",  Value = "string",                  BadgeText = "Цвет текста",  BadgeVariant = SgBadgeVariant.Info },
    };
}