@page "/chip-demo"
@using SuperUI.Components
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgChip — Tags, Filters, Toggles — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Variants                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Variants — SgChipVariant
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Six semantic variants plus outlined style and three sizes. Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Variant</SgTypography> to convey meaning, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Outlined</SgTypography> for lighter emphasis.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="All Variants" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Filled
                        </SgTypography>
                        <SgSpace Wrap="true" Size="small">
                            <SgChip Text="Default" />
                            <SgChip Text="Primary" Variant="SgChipVariant.Primary" />
                            <SgChip Text="Success" Variant="SgChipVariant.Success" />
                            <SgChip Text="Danger" Variant="SgChipVariant.Danger" />
                            <SgChip Text="Warn" Variant="SgChipVariant.Warn" />
                            <SgChip Text="Info" Variant="SgChipVariant.Info" />
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Outlined
                        </SgTypography>
                        <SgSpace Wrap="true" Size="small">
                            <SgChip Text="Default" Outlined="true" />
                            <SgChip Text="Primary" Variant="SgChipVariant.Primary" Outlined="true" />
                            <SgChip Text="Success" Variant="SgChipVariant.Success" Outlined="true" />
                            <SgChip Text="Danger" Variant="SgChipVariant.Danger" Outlined="true" />
                            <SgChip Text="Warn" Variant="SgChipVariant.Warn" Outlined="true" />
                            <SgChip Text="Info" Variant="SgChipVariant.Info" Outlined="true" />
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Sizes — Sm / Md / Lg
                        </SgTypography>
                        <SgSpace Wrap="true" Size="small" Align="SgAlignItems.Center">
                            <SgChip Text="Small" Size="SgSize.Sm" Variant="SgChipVariant.Primary" />
                            <SgChip Text="Medium" Size="SgSize.Md" Variant="SgChipVariant.Primary" />
                            <SgChip Text="Large" Size="SgSize.Lg" Variant="SgChipVariant.Primary" />
                        </SgSpace>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Variant Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_variantProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Icons & Avatars & Dots                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Icons, Avatars, Dots & Count
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Add visual context with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Icon</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Avatar</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Dot</SgTypography>, or a numeric <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Count</SgTypography> badge.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Leading Elements" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With Icon
                        </SgTypography>
                        <SgSpace Wrap="true" Size="small">
                            <SgChip Text="Settings" Variant="SgChipVariant.Primary">
                                <Icon>@((MarkupString)SgHeroicons.Outline.Cog6Tooth)</Icon>
                            </SgChip>
                            <SgChip Text="Active" Variant="SgChipVariant.Success">
                                <Icon>@((MarkupString)SgHeroicons.Outline.CheckCircle)</Icon>
                            </SgChip>
                            <SgChip Text="Error" Variant="SgChipVariant.Danger">
                                <Icon>@((MarkupString)SgHeroicons.Outline.XCircle)</Icon>
                            </SgChip>
                            <SgChip Text="Pending" Variant="SgChipVariant.Warn">
                                <Icon>@((MarkupString)SgHeroicons.Outline.Clock)</Icon>
                            </SgChip>
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With Avatar
                        </SgTypography>
                        <SgSpace Wrap="true" Size="small">
                            <SgChip Text="Alice C.">
                                <Avatar><img src="https://i.pravatar.cc/32?img=1" alt="avatar" style="width:100%;height:100%;object-fit:cover;" /></Avatar>
                            </SgChip>
                            <SgChip Text="Bob M." Variant="SgChipVariant.Primary">
                                <Avatar><img src="https://i.pravatar.cc/32?img=3" alt="avatar" style="width:100%;height:100%;object-fit:cover;" /></Avatar>
                            </SgChip>
                            <SgChip Text="Carol S." Variant="SgChipVariant.Success">
                                <Avatar><img src="https://i.pravatar.cc/32?img=5" alt="avatar" style="width:100%;height:100%;object-fit:cover;" /></Avatar>
                            </SgChip>
                            <SgChip Text="Dave K." Variant="SgChipVariant.Warn">
                                <Avatar><img src="https://i.pravatar.cc/32?img=7" alt="avatar" style="width:100%;height:100%;object-fit:cover;" /></Avatar>
                            </SgChip>
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Status Dot
                        </SgTypography>
                        <SgSpace Wrap="true" Size="small">
                            <SgChip Text="Online" Dot="true" Variant="SgChipVariant.Success" />
                            <SgChip Text="Away" Dot="true" Variant="SgChipVariant.Warn" />
                            <SgChip Text="Offline" Dot="true" />
                            <SgChip Text="Busy" Dot="true" Variant="SgChipVariant.Danger" />
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Count Badge
                        </SgTypography>
                        <SgSpace Wrap="true" Size="small">
                            <SgChip Text="Inbox" Count="5" Variant="SgChipVariant.Primary" />
                            <SgChip Text="Tasks" Count="12" Variant="SgChipVariant.Warn" />
                            <SgChip Text="Errors" Count="150" MaxCount="99" Variant="SgChipVariant.Danger" />
                            <SgChip Text="Updates" Count="3" Variant="SgChipVariant.Info" />
                        </SgSpace>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Display Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_displayProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Filter / Select                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Filter / Select — Toggle Chips
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">@@bind-Selected</SgTypography> for two-way toggle behavior. <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ShowCheck</SgTypography> renders a checkmark when selected.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Selection Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Multi-Select Filters
                        </SgTypography>
                        <SgSpace Wrap="true" Size="small">
                            @foreach (var f in _filters)
                            {
                                <SgChip Text="@f.Label"
                                        Variant="SgChipVariant.Primary"
                                        @bind-Selected="f.Selected"
                                        Clickable="true" />
                            }
                        </SgSpace>
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Style="margin-top:8px;display:block;">
                            Selected: <strong>@(string.Join(", ", _filters.Where(f => f.Selected).Select(f => f.Label)) is { Length: > 0 } s ? s : "—")</strong>
                        </SgTypography>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With Checkmark (ShowCheck)
                        </SgTypography>
                        <SgSpace Wrap="true" Size="small">
                            @foreach (var f in _checkFilters)
                            {
                                <SgChip Text="@f.Label"
                                        Variant="SgChipVariant.Info"
                                        @bind-Selected="f.Selected"
                                        ShowCheck="true"
                                        Clickable="true" />
                            }
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Active Category
                        </SgTypography>
                        <SgSpace Wrap="true" Size="small">
                            @foreach (var c in _categories)
                            {
                                <SgChip Text="@c.Label"
                                        Variant="SgChipVariant.Default"
                                        @bind-Selected="c.Selected"
                                        Clickable="true" />
                            }
                        </SgSpace>
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Style="margin-top:8px;display:block;">
                            Active: <SgBadge Text="@(_categories.FirstOrDefault(c => c.Selected)?.Label ?? "None")" Variant="SgBadgeVariant.Info" Standalone="true" />
                        </SgTypography>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Selection Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_selectProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Closable Tags                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Closable Tags
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Set <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Closable="true"</SgTypography> and handle <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">OnClose</SgTypography> for removable tags. Supports disabled and loading states.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Tag Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Removable Tags
                        </SgTypography>
                        <SgSpace Wrap="true" Size="small">
                            @foreach (var tag in _tags)
                            {
                                <SgChip Text="@tag.Label"
                                        Variant="@tag.Variant"
                                        Closable="true"
                                        OnClose="@(() => _tags.Remove(tag))" />
                            }
                            @if (_tags.Count == 0)
                            {
                                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">All tags removed</SgTypography>
                            }
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            States
                        </SgTypography>
                        <SgSpace Wrap="true" Size="small" Align="SgAlignItems.Center">
                            <SgChip Text="Normal" Closable="true" />
                            <SgChip Text="Disabled" Closable="true" Disabled="true" />
                            <SgChip Text="Loading" Closable="true" Loading="true" />
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Dynamic Add / Remove
                        </SgTypography>
                        <SgSpace Wrap="true" Size="small">
                            @foreach (var it in _dynamicTags)
                            {
                                <SgChip Text="@it"
                                        Variant="SgChipVariant.Info"
                                        Closable="true"
                                        OnClose="@(() => _dynamicTags.Remove(it))" />
                            }
                        </SgSpace>
                        <SgSpace Size="small" Style="margin-top:8px;">
                            <SgButton Variant="SgButtonVariant.Outlined" Size="SgSize.Sm" OnClick="@AddTag">
                                @((MarkupString)SgHeroicons.Outline.Plus)
                                Add Tag
                            </SgButton>
                            @if (_dynamicTags.Count > 0)
                            {
                                <SgButton Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" OnClick="@ClearTags">
                                    Clear All
                                </SgButton>
                            }
                        </SgSpace>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Closable Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_closeProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Clickable & Links                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Clickable & Links
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Interactive chips via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">OnClick</SgTypography>, navigational chips via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Href</SgTypography>, or custom <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Color</SgTypography> / <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">TextColor</SgTypography>.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Interaction Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Click Counter
                        </SgTypography>
                        <SgSpace Wrap="true" Size="small" Align="SgAlignItems.Center">
                            <SgChip Text="Click Me" Clickable="true" Variant="SgChipVariant.Primary"
                                    OnClick="@(() => _clickCount++)">
                                <Icon>@((MarkupString)SgHeroicons.Outline.HandRaised)</Icon>
                            </SgChip>
                            <SgChip Text="@($"Clicked: {_clickCount}")" Variant="SgChipVariant.Info" Count="@_clickCount" />
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Link Chips (Href + Target=_blank)
                        </SgTypography>
                        <SgSpace Wrap="true" Size="small">
                            <SgChip Text="GitHub" Href="https://github.com" Target="_blank" Variant="SgChipVariant.Primary">
                                <Icon>@((MarkupString)SgHeroicons.Outline.ArrowTopRightOnSquare)</Icon>
                            </SgChip>
                            <SgChip Text="NuGet" Href="https://nuget.org" Target="_blank" Variant="SgChipVariant.Success">
                                <Icon>@((MarkupString)SgHeroicons.Outline.Cube)</Icon>
                            </SgChip>
                            <SgChip Text="Documentation" Href="https://learn.microsoft.com" Target="_blank" Variant="SgChipVariant.Info">
                                <Icon>@((MarkupString)SgHeroicons.Outline.DocumentText)</Icon>
                            </SgChip>
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Custom Color / TextColor
                        </SgTypography>
                        <SgSpace Wrap="true" Size="small">
                            <SgChip Text="Purple" Color="#7c3aed" TextColor="#fff" />
                            <SgChip Text="Orange" Color="#ea580c" TextColor="#fff" />
                            <SgChip Text="Cyan" Color="#0891b2" TextColor="#fff" />
                            <SgChip Text="Rose" Color="#e11d48" TextColor="#fff" />
                            <SgChip Text="Lime" Color="#65a30d" TextColor="#fff" />
                        </SgSpace>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Interaction Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_clickProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. Properties                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                All SgChip Parameters
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Complete reference of public parameters available on the <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgChip</SgTypography> component.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <PropertyTable Items="_allProps" />
        </SgCard>
    </div>

    </ChildContent>
</SgCard>

<style>
    .demo-section {
        margin-top: 48px;
    }
    .demo-section-header {
        margin-bottom: 20px;
    }
    .demo-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }
    @@media (max-width: 768px) {
        .demo-two-col { grid-template-columns: 1fr; }
    }
</style>

@code {
    // ── Main card header ─────────────────────────────────────────────────
    private RenderFragment _mainHeader => __builder =>
    {
        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
            <div style="display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,var(--sg-primary),#8b5cf6);color:#fff;flex-shrink:0;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2a10 10 0 1 0 10 10M12 2v10l5 5"/>
                </svg>
            </div>
            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">SgChip — Tags, Filters & Toggles</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Compact interactive elements for labels, filters, tags, and status indicators. Supports selection, closable tags, icons, avatars, counters, and links.
                </SgTypography>
            </SgStack>
        </SgStack>
    };

    // ── Click counter ────────────────────────────────────────────────────
    private int _clickCount;

    // ── Filter models ─────────────────────────────────────────────────────
