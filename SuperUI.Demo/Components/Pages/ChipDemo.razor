    private void OnCtorTextChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _ctorText = e.Value?.ToString() ?? "";
        UpdateCtorCode();
    }

    private void UpdateCtorCode()
    {
        var lines = new List<string>();
        var attrs = new List<string>
        {
            $"Text=\"{_ctorText}\"",
            $"Variant=\"SgChipVariant.{_ctorVariant}\"",
            $"Size=\"SgSize.{_ctorSize}\""
        };
        if (_ctorOutlined)   attrs.Add("Outlined=\"true\"");
        if (!_ctorPill)      attrs.Add("Pill=\"false\"");
        if (_ctorDisabled)   attrs.Add("Disabled=\"true\"");
        if (_ctorLoading)    attrs.Add("Loading=\"true\"");
        if (_ctorClosable)   attrs.Add("Closable=\"true\"");
        if (_ctorShowCount)  attrs.Add("Count=\"5\"");
        if (_ctorPulse)      attrs.Add("Pulse=\"true\"");
        if (_ctorGlow)       attrs.Add("Glow=\"true\"");
        if (_ctorNeon)       attrs.Add("Neon=\"true\"");
        if (_ctorGlass)      attrs.Add("Glass=\"true\"");
        if (_ctorRipple)     attrs.Add("Ripple=\"true\"");
        if (_ctorCopyable)   attrs.Add("Copyable=\"true\"");
        if (_ctorEntranceValue is not null)
            attrs.Add($"Entrance=\"SgEntranceAnimation.{_ctorEntrance}\"");
        lines.Add("<SgChip " + string.Join("\n         ", attrs) + " />");
        _ctorCodeLines = lines.ToArray();
    }

    private async Task CopyCtorCode()
    {
        var code = string.Join("\n", _ctorCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _ctorCopyIcon = "✓";
            _ctorCopyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _ctorCopyIcon = "📋";
            _ctorCopyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _ctorCopyIcon = "✗";
            _ctorCopyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _ctorCopyIcon = "📋";
            _ctorCopyLabel = "Copy";
            StateHasChanged();
        }
    }

