@page "/typography-demo"
@using SuperUI.Components

<PageTitle>SgTypography - Типографика</PageTitle>

<SgCard Title="SgTypography - Типографика"
        Subtitle="Мощный и гибкий компонент для управления текстом: заголовки, абзацы, код, цитаты, градиенты, обрезка и многое другое.">

    <!-- 1. Заголовки -->
    <div style="margin-top: 32px;">
        <h2>1. Заголовки (Heading Variants)</h2>
        <p>Встроенные варианты заголовков H1-H6 с предустановленными размерами и жирностью.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <SgTypography Variant="SgTypographyVariant.Heading1" Color="var(--sg-primary)">H1. Заголовок первого уровня</SgTypography>
                    <SgTypography Variant="SgTypographyVariant.Heading2">H2. Заголовок второго уровня</SgTypography>
                    <SgTypography Variant="SgTypographyVariant.Heading3">H3. Заголовок третьего уровня</SgTypography>
                    <SgTypography Variant="SgTypographyVariant.Heading4">H4. Заголовок четвертого уровня</SgTypography>
                    <SgTypography Variant="SgTypographyVariant.Heading5">H5. Заголовок пятого уровня</SgTypography>
                    <SgTypography Variant="SgTypographyVariant.Heading6">H6. Заголовок шестого уровня</SgTypography>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_headingProps" />
            </SgCard>
        </div>
    </div>

    <!-- 2. Текстовые варианты -->
    <div style="margin-top: 32px;">
        <h2>2. Текстовые варианты (Body Variants)</h2>
        <p>Различные стили текста: основной, вводный, мелкий, подписи, описания.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgTypography Variant="SgTypographyVariant.Body">Body — основной текст компонента. Используется для параграфов и длинных текстов.</SgTypography>
                    <SgTypography Variant="SgTypographyVariant.Lead">Lead — вводный текст. Обычно используется для краткого описания или подзаголовков.</SgTypography>
                    <SgTypography Variant="SgTypographyVariant.Small">Small — мелкий текст для вспомогательной информации.</SgTypography>
                    <SgTypography Variant="SgTypographyVariant.Muted">Muted — приглушенный текст второго плана.</SgTypography>
                    <SgTypography Variant="SgTypographyVariant.Label">Label — стиль для подписей полей ввода.</SgTypography>
                    <SgTypography Variant="SgTypographyVariant.Description">Description — описание, подсказка под полем.</SgTypography>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_bodyProps" />
            </SgCard>
        </div>
    </div>

    <!-- 3. Размеры -->
    <div style="margin-top: 32px;">
        <h2>3. Размеры текста (Size)</h2>
        <p>Семь предустановленных размеров от XS до 3XL.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <SgTypography Size="SgTypographySize.Xs">XS — Extra Small (0.75rem / 12px)</SgTypography>
                    <SgTypography Size="SgTypographySize.Sm">SM — Small (0.875rem / 14px)</SgTypography>
                    <SgTypography Size="SgTypographySize.Base">Base — Base (1rem / 16px)</SgTypography>
                    <SgTypography Size="SgTypographySize.Lg">LG — Large (1.125rem / 18px)</SgTypography>
                    <SgTypography Size="SgTypographySize.Xl">XL — Extra Large (1.25rem / 20px)</SgTypography>
                    <SgTypography Size="SgTypographySize.Xxl">2XL — 2x Large (1.5rem / 24px)</SgTypography>
                    <SgTypography Size="SgTypographySize.Xxxl">3XL — 3x Large (1.875rem / 30px)</SgTypography>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_sizeProps" />
            </SgCard>
        </div>
    </div>

    <!-- 4. Насыщенность -->
    <div style="margin-top: 32px;">
        <h2>4. Насыщенность (Weight)</h2>
        <p>Четыре значения жирности текста: Normal, Medium, Semibold, Bold.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <SgTypography Weight="SgTypographyWeight.Normal">Normal — обычный (400)</SgTypography>
                    <SgTypography Weight="SgTypographyWeight.Medium">Medium — средний (500)</SgTypography>
                    <SgTypography Weight="SgTypographyWeight.Semibold">Semibold — полужирный (600)</SgTypography>
                    <SgTypography Weight="SgTypographyWeight.Bold">Bold — жирный (700)</SgTypography>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_weightProps" />
            </SgCard>
        </div>
    </div>

    <!-- 5. Цвет -->
    <div style="margin-top: 32px;">
        <h2>5. Цвет текста (Color)</h2>
        <p>Любой CSS-цвет через параметр Color.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <SgTypography Color="var(--sg-primary)" Weight="SgTypographyWeight.Semibold">Primary — основной цвет темы</SgTypography>
                    <SgTypography Color="var(--sg-success)" Weight="SgTypographyWeight.Semibold">Success — зеленый</SgTypography>
                    <SgTypography Color="var(--sg-error)" Weight="SgTypographyWeight.Semibold">Error — красный</SgTypography>
                    <SgTypography Color="var(--sg-warning)" Weight="SgTypographyWeight.Semibold">Warning — желтый</SgTypography>
                    <SgTypography Color="var(--sg-text-muted)">Muted — приглушенный</SgTypography>
                    <SgTypography Color="#7c3aed" Weight="SgTypographyWeight.Semibold">#7c3aed — фиолетовый</SgTypography>
                    <SgTypography Color="#0891b2" Weight="SgTypographyWeight.Semibold">#0891b2 — бирюзовый</SgTypography>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_colorProps" />
            </SgCard>
        </div>
    </div>

    <!-- 6. Выравнивание -->
    <div style="margin-top: 32px;">
        <h2>6. Выравнивание (Align)</h2>
        <p>Управление выравниванием текста: влево, по центру, вправо, по ширине.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgTypography Align="SgTypographyAlign.Left">
                        Left — выравнивание влево. Используется по умолчанию для большинства текстов.
                    </SgTypography>
                    <SgTypography Align="SgTypographyAlign.Center">
                        Center — выравнивание по центру. Подходит для заголовков и коротких сообщений.
                    </SgTypography>
                    <SgTypography Align="SgTypographyAlign.Right">
                        Right — выравнивание вправо. Часто используется в таблицах для чисел.
                    </SgTypography>
                    <SgTypography Align="SgTypographyAlign.Justify">
                        Justify — выравнивание по ширине. Создает ровные края с обеих сторон.
                    </SgTypography>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_alignProps" />
            </SgCard>
        </div>
    </div>

    <!-- 7. Трансформация -->
    <div style="margin-top: 32px;">
        <h2>7. Трансформация (Transform)</h2>
        <p>Изменение регистра текста: верхний, нижний, капитализация.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <SgTypography Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide">Uppercase — верхний регистр</SgTypography>
                    <SgTypography Transform="SgTypographyTransform.Lowercase">LOWERCASE — НИЖНИЙ РЕГИСТР</SgTypography>
                    <SgTypography Transform="SgTypographyTransform.Capitalize">capitalize — каждое слово с заглавной</SgTypography>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_transformProps" />
            </SgCard>
        </div>
    </div>

    <!-- 8. Специальные элементы -->
    <div style="margin-top: 32px;">
        <h2>8. Специальные элементы</h2>
        <p>Code, Pre, Blockquote — для технического контента, кода и цитат.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Inline Code</div>
                        <SgTypography>
                            Для установки выполните команду
                            <SgTypography As="SgTypographyElement.Code">dotnet add package SuperUI</SgTypography>
                            в терминале.
                        </SgTypography>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Code Block (Pre)</div>
                        <SgTypography As="SgTypographyElement.Pre">
&lt;SgButton Text="Нажми меня"
          Variant="SgButtonVariant.Primary" /&gt;
                        </SgTypography>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Blockquote</div>
                        <SgTypography As="SgTypographyElement.Blockquote">
                            Дизайн — это не просто то, как он выглядит и ощущается. Дизайн — это то, как он работает.
                            <br /><span style="color: var(--sg-text-muted); font-size: var(--sg-text-sm);">— Стив Джобс</span>
                        </SgTypography>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_elementProps" />
            </SgCard>
        </div>
    </div>

    <!-- 9. Моноширинный шрифт -->
    <div style="margin-top: 32px;">
        <h2>9. Моноширинный шрифт (Font)</h2>
        <p>Переключение между sans-serif и monospace семействами шрифтов.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <SgTypography Font="SgTypographyFont.Sans">Sans — Inter / системный шрифт (по умолчанию)</SgTypography>
                    <SgTypography Font="SgTypographyFont.Mono">Mono — JetBrains Mono / моноширинный шрифт</SgTypography>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_fontProps" />
            </SgCard>
        </div>
    </div>

    <!-- 10. Tracking (межбуквенное расстояние) -->
    <div style="margin-top: 32px;">
        <h2>10. Tracking (Letter Spacing)</h2>
        <p>Управление межбуквенным расстоянием от Tighter до Widest.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <SgTypography Tracking="SgTypographyTracking.Tighter">Tighter — очень плотно (-0.05em)</SgTypography>
                    <SgTypography Tracking="SgTypographyTracking.Tight">Tight — плотно (-0.025em)</SgTypography>
                    <SgTypography Tracking="SgTypographyTracking.Normal">Normal — нормально (0em)</SgTypography>
                    <SgTypography Tracking="SgTypographyTracking.Wide">Wide — широко (0.025em)</SgTypography>
                    <SgTypography Tracking="SgTypographyTracking.Wider">Wider — еще шире (0.05em)</SgTypography>
                    <SgTypography Tracking="SgTypographyTracking.Widest">Widest — максимально (0.1em)</SgTypography>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_trackingProps" />
            </SgCard>
        </div>
    </div>

    <!-- 11. Leading (межстрочное расстояние) -->
    <div style="margin-top: 32px;">
        <h2>11. Leading (Line Height)</h2>
        <p>Управление межстрочным интервалом от Tight до Loose.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgTypography Leading="SgTypographyLeading.Tight" Style="width: 300px; background: var(--sg-surface-alt); padding: 8px; border-radius: 4px;">
                        Tight (1.25) — компактный межстрочный интервал для заголовков и плотных макетов.
                    </SgTypography>
                    <SgTypography Leading="SgTypographyLeading.Normal" Style="width: 300px; background: var(--sg-surface-alt); padding: 8px; border-radius: 4px;">
                        Normal (1.5) — стандартный межстрочный интервал для обычного текста. Используется по умолчанию.
                    </SgTypography>
                    <SgTypography Leading="SgTypographyLeading.Relaxed" Style="width: 300px; background: var(--sg-surface-alt); padding: 8px; border-radius: 4px;">
                        Relaxed (1.625) — увеличенный интервал для улучшения читаемости длинных текстов.
                    </SgTypography>
                    <SgTypography Leading="SgTypographyLeading.Loose" Style="width: 300px; background: var(--sg-surface-alt); padding: 8px; border-radius: 4px;">
                        Loose (2) — большой интервал для заметок и комментариев.
                    </SgTypography>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_leadingProps" />
            </SgCard>
        </div>
    </div>

    <!-- 12. Украшения (Decoration) -->
    <div style="margin-top: 32px;">
        <h2>12. Украшения (Decoration)</h2>
        <p>Подчеркивание и зачеркивание текста.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <SgTypography Decoration="SgTypographyDecoration.Underline">Подчеркнутый текст</SgTypography>
                    <SgTypography Decoration="SgTypographyDecoration.LineThrough">Зачеркнутый текст</SgTypography>
                    <SgTypography Underline="true">Underline через boolean</SgTypography>
                    <SgTypography Strike="true">Strike через boolean</SgTypography>
                    <SgTypography Italic="true">Курсив (Italic)</SgTypography>
                    <SgTypography Mark="true">Выделенный текст (Mark)</SgTypography>
                    <SgTypography IsCode="true">Inline code стиль</SgTypography>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_decoProps" />
            </SgCard>
        </div>
    </div>

    <!-- 13. Truncate и Clamp -->
    <div style="margin-top: 32px;">
        <h2>13. Обрезка текста (Truncate & Clamp)</h2>
        <p>Однострочная обрезка с многоточием (Truncate) и многострочная обрезка (Clamp 2-5 строк).</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Truncate (одна строка)</div>
                        <SgTypography Truncate="true" Style="max-width: 400px; border: 1px solid var(--sg-border); padding: 8px; border-radius: 4px;">
                            Это очень длинный текст, который должен быть обрезан с многоточием в конце строки, чтобы не выходить за пределы контейнера.
                        </SgTypography>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Clamp 2 (две строки)</div>
                        <SgTypography Clamp="2" Style="max-width: 400px; border: 1px solid var(--sg-border); padding: 8px; border-radius: 4px;">
                            Это длинный текст, который будет обрезан после двух строк. Очень полезно для карточек, списков статей и других компонентов, где нужно показать превью текста с многоточием в конце.
                        </SgTypography>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Clamp 3 (три строки)</div>
                        <SgTypography Clamp="3" Style="max-width: 400px; border: 1px solid var(--sg-border); padding: 8px; border-radius: 4px;">
                            Этот текст будет обрезан после трех строк. Многоточие появится в конце третьей строки, если текст превышает лимит. Идеально подходит для описаний товаров, превью новостей и анонсов.
                        </SgTypography>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_truncateProps" />
            </SgCard>
        </div>
    </div>

    <!-- 14. Градиент -->
    <div style="margin-top: 32px;">
        <h2>14. Градиентный текст (Gradient)</h2>
        <p>Эффектный градиентный текст. Передайте CSS-цвета через запятую.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgTypography Variant="SgTypographyVariant.Heading3"
                                  Gradient="var(--sg-primary), #7c3aed"
                                  Weight="SgTypographyWeight.Bold">
                        Градиент: синий → фиолетовый
                    </SgTypography>
                    <SgTypography Variant="SgTypographyVariant.Heading3"
                                  Gradient="#f59e0b, #ef4444"
                                  Weight="SgTypographyWeight.Bold">
                        Градиент: оранжевый → красный
                    </SgTypography>
                    <SgTypography Variant="SgTypographyVariant.Heading3"
                                  Gradient="#06b6d4, #22c55e"
                                  Weight="SgTypographyWeight.Bold">
                        Градиент: голубой → зеленый
                    </SgTypography>
                    <SgTypography Variant="SgTypographyVariant.Heading4"
                                  Gradient="#ec4899, #8b5cf6, #06b6d4"
                                  Weight="SgTypographyWeight.Semibold">
                        Многоцветный градиент: розовый → фиолетовый → голубой
                    </SgTypography>
                    <SgTypography Variant="SgTypographyVariant.Lead"
                                  Gradient="var(--sg-primary), #a855f7"
                                  Style="margin-top: 8px;">
                        Lead текст с градиентом для привлечения внимания к важным объявлениям.
                    </SgTypography>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_gradientProps" />
            </SgCard>
        </div>
    </div>

    <!-- 15. Комбинированные примеры -->
    <div style="margin-top: 32px;">
        <h2>15. Комбинированные примеры</h2>
        <p>Использование нескольких параметров одновременно для создания уникальных стилей.</p>
        <SgCard Title="Примеры" Style="margin-top: 16px;">
            <div style="display: flex; flex-direction: column; gap: 24px;">
                <SgTypography Variant="SgTypographyVariant.Heading2"
                              Gradient="#667eea, #764ba2"
                              Tracking="SgTypographyTracking.Tight"
                              Weight="SgTypographyWeight.Bold">
                    Brand Header с градиентом и tracking
                </SgTypography>
                <SgTypography Variant="SgTypographyVariant.Body"
                              Color="var(--sg-text-muted)"
                              Leading="SgTypographyLeading.Relaxed"
                              Align="SgTypographyAlign.Justify"
                              Style="max-width: 600px;">
                    Многострочный текст с выравниванием по ширине, увеличенным межстрочным интервалом и приглушенным цветом. Идеально подходит для чтения длинных статей и документации.
                </SgTypography>
                <SgTypography As="SgTypographyElement.Span"
                              Variant="SgTypographyVariant.Heading4"
                              Color="var(--sg-primary)"
                              Weight="SgTypographyWeight.Bold"
                              Transform="SgTypographyTransform.Uppercase"
                              Tracking="SgTypographyTracking.Wider">
                    Заголовок секции: uppercase + wide tracking + цвет
                </SgTypography>
                <div style="background: var(--sg-surface-alt); border-radius: 8px; padding: 16px;">
                    <SgTypography As="SgTypographyElement.Div"
                                  Font="SgTypographyFont.Mono"
                                  Size="SgTypographySize.Sm"
                                  Color="var(--sg-text-muted)"
                                  Style="border-left: 3px solid var(--sg-primary); padding-left: 12px;">
                        System.out.println("Hello, SuperUI!");<br />
                        // Mono шрифт + цвет + размер + левая рамка
                    </SgTypography>
                </div>
            </div>
        </SgCard>
    </div>

    <!-- 16. Все параметры -->
    <div style="margin-top: 32px;">
        <h2>16. Все параметры SgTypography</h2>
        <p>Полный список параметров компонента.</p>
        <SgCard Style="margin-top: 16px;">
            <PropertyTable Items="_allProps" />
        </SgCard>
    </div>

</SgCard>

@code {
    private List<PropertyPanelItem> _headingProps = new()
