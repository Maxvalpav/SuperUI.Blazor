@page "/typography-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgTypography — Typography System — SuperUI</PageTitle>
<SgSeoHead Description="SgTypography — a comprehensive text component with 20+ optional parameters covering variants, sizes, weights, colors, alignment, transforms, tracking, leading, decorations, truncation, gradients, and advanced text controls." />

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Typography System"
                       Subtitle="SgTypography — a comprehensive text component with 20+ optional parameters covering variants, sizes, weights, colors, alignment, transforms, tracking, leading, decorations, truncation, gradients, and advanced text controls." />
    </HeaderContent>
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. SgTypography — Heading Variants                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgTypography — Heading Variants
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Six heading levels (H1–H6) with semantic HTML and consistent sizing. Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Variant</SgTypography> for visual style or <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">As</SgTypography> for semantic element.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Preview" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgTypography Variant="SgTypographyVariant.Heading1" Color="var(--sg-color-primary)">H1. SuperUI Design System</SgTypography>
                    <SgTypography Variant="SgTypographyVariant.Heading2">H2. Typography Component</SgTypography>
                    <SgTypography Variant="SgTypographyVariant.Heading3">H3. Heading Variants</SgTypography>
                    <SgTypography Variant="SgTypographyVariant.Heading4">H4. Section Title</SgTypography>
                    <SgTypography Variant="SgTypographyVariant.Heading5">H5. Subsection Title</SgTypography>
                    <SgTypography Variant="SgTypographyVariant.Heading6">H6. Minor Heading</SgTypography>
                    <SgDivider />
                    <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                        <SgSegmented TValue="SgTypographyVariant" Options="_semanticOptions" Value="_selectedSemantic" ValueChanged="@(v => _selectedSemantic = v)" SizeEnum="SgSize.Sm" />
                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Renders as <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">&lt;@_currentTag&gt;</SgTypography></SgTypography>
                    </SgStack>
                    <SgTypography As="@_currentElement" Variant="@_currentVariant" Color="var(--sg-color-primary)" Weight="SgTypographyWeight.Bold">
                        This is a @_currentTagName element with @_currentVariantName styling
                    </SgTypography>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_headingProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Body Variants                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Body Variants
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Body, Lead, Small, Muted, Label, and Description — purpose-built styles for content hierarchy.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Preview" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Body
                        </SgTypography>
                        <SgTypography Variant="SgTypographyVariant.Body">
                            The quick brown fox jumps over the lazy dog. Body text is the workhorse of your UI — comfortable to read at length.
                        </SgTypography>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Lead
                        </SgTypography>
                        <SgTypography Variant="SgTypographyVariant.Lead">
                            Lead text provides an engaging introduction. Slightly larger and more spacious than body text.
                        </SgTypography>
                    </div>
                    <SgDivider />
                    <SgSpace Wrap="true" Align="SgAlignItems.Center">
                        <SgTypography Variant="SgTypographyVariant.Small">Small — supporting info</SgTypography>
                        <SgTypography Variant="SgTypographyVariant.Muted">Muted — secondary content</SgTypography>
                        <SgTypography Variant="SgTypographyVariant.Label">Label — form field labels</SgTypography>
                        <SgTypography Variant="SgTypographyVariant.Description">Description — helper text</SgTypography>
                    </SgSpace>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_bodyProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Size Scale                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Size Scale
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Seven sizes from XS to 3XL, mapped to the SuperUI type scale. Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Size</SgTypography> param to override the default.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Preview" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgTypography Size="SgTypographySize.Xs">XS — 0.75rem / 12px — Extra small</SgTypography>
                    <SgTypography Size="SgTypographySize.Sm">SM — 0.875rem / 14px — Small</SgTypography>
                    <SgTypography Size="SgTypographySize.Base">Base — 1rem / 16px — Default body</SgTypography>
                    <SgTypography Size="SgTypographySize.Lg">LG — 1.125rem / 18px — Large</SgTypography>
                    <SgTypography Size="SgTypographySize.Xl">XL — 1.25rem / 20px — Extra large</SgTypography>
                    <SgTypography Size="SgTypographySize.Xxl">2XL — 1.5rem / 24px — Double extra</SgTypography>
                    <SgTypography Size="SgTypographySize.Xxxl">3XL — 1.875rem / 30px — Triple extra</SgTypography>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_sizeProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Font Weight                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Font Weight
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Four weight presets using <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgTypographyWeight</SgTypography>: Normal (400), Medium (500), Semibold (600), Bold (700).
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Preview" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgTypography Weight="SgTypographyWeight.Normal">Normal — Regular weight (400)</SgTypography>
                    <SgTypography Weight="SgTypographyWeight.Medium">Medium — Slightly bolder (500)</SgTypography>
                    <SgTypography Weight="SgTypographyWeight.Semibold">Semibold — Semi-bold (600)</SgTypography>
                    <SgTypography Weight="SgTypographyWeight.Bold">Bold — Bold weight (700)</SgTypography>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_weightProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Color + Alignment                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Color & Alignment
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Any CSS color via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Color</SgTypography>, any alignment via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Align</SgTypography>. Click a color swatch to toggle alignment live.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Preview" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgSpace Wrap="true">
                        <button class="demo-swatch" style="background:var(--sg-color-primary);color:#fff" @onclick='() => SetDemo("var(--sg-color-primary)", SgTypographyAlign.Left)'>Primary</button>
                        <button class="demo-swatch" style="background:var(--sg-color-success);color:#fff" @onclick='() => SetDemo("var(--sg-color-success)", SgTypographyAlign.Center)'>Success</button>
                        <button class="demo-swatch" style="background:var(--sg-color-danger);color:#fff" @onclick='() => SetDemo("var(--sg-color-danger)", SgTypographyAlign.Right)'>Danger</button>
                        <button class="demo-swatch" style="background:var(--sg-color-warning);color:#000" @onclick='() => SetDemo("var(--sg-color-warning)", SgTypographyAlign.Justify)'>Warning</button>
                        <button class="demo-swatch" style="background:var(--sg-color-primary-subtle);color:var(--sg-color-primary)" @onclick='() => SetDemo("var(--sg-color-primary-subtle)", SgTypographyAlign.Left)'>Primary Subtle</button>
                        <button class="demo-swatch" style="background:var(--sg-bg-emphasized);color:var(--sg-fg)" @onclick='() => SetDemo("var(--sg-bg-emphasized)", SgTypographyAlign.Center)'>Emphasized</button>
                    </SgSpace>
                    <SgTypography Color="@_demoColor" Align="@_demoAlign" Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Lg">
                        Click a swatch to change color and alignment instantly.
                    </SgTypography>
                    <SgSpace>
                        <SgBadge Variant="SgBadgeVariant.Info" Size="SgSize.Sm">Color: @_demoColor</SgBadge>
                        <SgBadge Variant="SgBadgeVariant.Warn" Size="SgSize.Sm">Align: @_demoAlign?.ToString()</SgBadge>
                    </SgSpace>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_colorProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. Transform + Tracking                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Text Transform & Tracking
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Transform (uppercase / lowercase / capitalize) and letter-spacing tracking from Tighter to Widest.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Preview" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Transform
                        </SgTypography>
                        <SgTypography Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide">Uppercase — section titles</SgTypography>
                        <SgTypography Transform="SgTypographyTransform.Lowercase">LOWERCASE APPLIED TO UPPER</SgTypography>
                        <SgTypography Transform="SgTypographyTransform.Capitalize">capitalize each word automatically</SgTypography>
                    </SgStack>
                    <SgDivider />
                    <SgStack Vertical Space="SgSize.Md">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Tracking (Letter Spacing)
                        </SgTypography>
                        <SgTypography Tracking="SgTypographyTracking.Tighter">Tighter — very tight (-0.05em)</SgTypography>
                        <SgTypography Tracking="SgTypographyTracking.Tight">Tight — tight (-0.025em)</SgTypography>
                        <SgTypography Tracking="SgTypographyTracking.Normal">Normal — default (0em)</SgTypography>
                        <SgTypography Tracking="SgTypographyTracking.Wide">Wide — spaced (0.025em)</SgTypography>
                        <SgTypography Tracking="SgTypographyTracking.Wider">Wider — more space (0.05em)</SgTypography>
                        <SgTypography Tracking="SgTypographyTracking.Widest">Widest — maximum (0.1em)</SgTypography>
                    </SgStack>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_transformProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 7. Leading (Line Height)                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Leading (Line Height)
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Four line-height presets: Tight (1.25), Normal (1.5), Relaxed (1.625), Loose (2).
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Preview" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgTypography Leading="SgTypographyLeading.Tight" Style="max-width:350px;background:var(--sg-surface-alt);padding:10px;border-radius:var(--sg-radius-md);border-left:3px solid var(--sg-color-primary);">
                        <SgTypography Weight="SgTypographyWeight.Semibold">Tight (1.25)</SgTypography><br />
                        Compact line height ideal for headings and dense layouts where every pixel counts.
                    </SgTypography>
                    <SgTypography Leading="SgTypographyLeading.Normal" Style="max-width:350px;background:var(--sg-surface-alt);padding:10px;border-radius:var(--sg-radius-md);border-left:3px solid var(--sg-color-success);">
                        <SgTypography Weight="SgTypographyWeight.Semibold">Normal (1.5)</SgTypography><br />
                        The default line height for body text. Comfortable and readable at any length.
                    </SgTypography>
                    <SgTypography Leading="SgTypographyLeading.Relaxed" Style="max-width:350px;background:var(--sg-surface-alt);padding:10px;border-radius:var(--sg-radius-md);border-left:3px solid var(--sg-color-warning);">
                        <SgTypography Weight="SgTypographyWeight.Semibold">Relaxed (1.625)</SgTypography><br />
                        Slightly increased spacing improves readability for long-form content like articles.
                    </SgTypography>
                    <SgTypography Leading="SgTypographyLeading.Loose" Style="max-width:350px;background:var(--sg-surface-alt);padding:10px;border-radius:var(--sg-radius-md);border-left:3px solid var(--sg-color-danger);">
                        <SgTypography Weight="SgTypographyWeight.Semibold">Loose (2)</SgTypography><br />
                        Maximum spacing for notes, comments, and content that needs breathing room.
                    </SgTypography>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_leadingProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 8. Decoration + Style Modifiers                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Decoration & Style Modifiers
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Underline, strikethrough, italic, highlight (mark), inline code, and more.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Preview" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgStack Horizontal Space="SgSize.Lg" Wrap="true">
                        <SgTypography Decoration="SgTypographyDecoration.Underline">Underline</SgTypography>
                        <SgTypography Decoration="SgTypographyDecoration.LineThrough">Line Through</SgTypography>
                        <SgTypography Italic="true">Italic text</SgTypography>
                        <SgTypography Mark="true">Highlighted text</SgTypography>
                        <SgTypography IsCode="true">Inline code</SgTypography>
                        <SgTypography Strike="true">Strikethrough</SgTypography>
                        <SgTypography Underline="true">Underline (bool)</SgTypography>
                    </SgStack>
                    <SgDivider />
                    <SgTypography>
                        Mix them inline — <SgTypography As="SgTypographyElement.Span" Italic="true" Color="var(--sg-color-primary)">italic primary</SgTypography>, <SgTypography As="SgTypographyElement.Span" Mark="true">highlighted</SgTypography>, <SgTypography As="SgTypographyElement.Span" IsCode="true">dotnet add package SuperUI</SgTypography>, and <SgTypography As="SgTypographyElement.Span" Strike="true" Color="var(--sg-text-muted)">deprecated</SgTypography>.
                    </SgTypography>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Mono Font Family
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Font="SgTypographyFont.Mono">System.out.println("Hello, SuperUI!");</SgTypography>
                            <SgTypography Font="SgTypographyFont.Sans">Sans-serif for UI text (default)</SgTypography>
                        </SgStack>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_decoProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 9. Truncate & Clamp                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Truncate & Clamp
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Single-line truncation with ellipsis (<SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Truncate</SgTypography>) and multi-line clamp (<SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Clamp</SgTypography>) for card previews and descriptions.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Preview" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Truncate (single line with ellipsis)
                        </SgTypography>
                        <SgTypography Truncate="true" Style="max-width:400px;border:1px solid var(--sg-border);padding:10px;border-radius:var(--sg-radius-md);">
                            This is a very long text that will be truncated with an ellipsis at the end of a single line to prevent overflow.
                        </SgTypography>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Clamp 2 — two lines
                        </SgTypography>
                        <SgTypography Clamp="2" Style="max-width:400px;border:1px solid var(--sg-border);padding:10px;border-radius:var(--sg-radius-md);">
                            This long text will be clamped after two lines. Very useful for card components, article previews, and anywhere you need to show a text snippet with ellipsis at the end of the last visible line.
                        </SgTypography>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Clamp 3 — three lines
                        </SgTypography>
                        <SgTypography Clamp="3" Style="max-width:400px;border:1px solid var(--sg-border);padding:10px;border-radius:var(--sg-radius-md);">
                            This text is clamped to three lines. Perfect for longer descriptions and previews where two lines is not enough but full text would be too much. The ellipsis appears at the end of the third line automatically.
                        </SgTypography>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_truncateProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 10. Gradient Text                                                      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Gradient Text
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
