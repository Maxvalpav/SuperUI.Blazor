    private void OnCtorTextChanged(ChangeEventArgs e)
    {
        _ctorText = e.Value?.ToString() ?? "";
        UpdateConstructorCode();
    }
    private void OnVariantSelectChanged(ChangeEventArgs e) { _ctorVariantStr = e.Value?.ToString() ?? ""; UpdateConstructorCode(); }


    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add("<SgTypography");

        if (_ctorVariant != SgTypographyVariant.None)
            lines.Add($"    Variant=\"SgTypographyVariant.{_ctorVariant}\"");

        if (_ctorSize != SgTypographySize.Base)
            lines.Add($"    Size=\"SgTypographySize.{_ctorSize}\"");

        if (_ctorWeight != SgTypographyWeight.Normal)
            lines.Add($"    Weight=\"SgTypographyWeight.{_ctorWeight}\"");

        if (_ctorItalic) lines.Add("    Italic=\"true\"");
        if (_ctorMark) lines.Add("    Mark=\"true\"");
        if (_ctorCode) lines.Add("    IsCode=\"true\"");
        if (_ctorFluid) lines.Add("    Fluid=\"true\"");
        if (_ctorHyphens) lines.Add("    Hyphens=\"true\"");

        if (lines.Count == 1)
            _ctorGeneratedCode = "<SgTypography>\n    " + System.Security.SecurityElement.Escape(_ctorText) + "\n</SgTypography>";
        else
            _ctorGeneratedCode = string.Join("\n", lines) + "\n    " + System.Security.SecurityElement.Escape(_ctorText) + "\n</SgTypography>";
    }

    private async Task CopyConstructorCode()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _ctorGeneratedCode);
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyLabel = "Error";
            StateHasChanged();
            await Task.Delay(2000);
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

