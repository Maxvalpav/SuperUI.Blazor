        "heading2" => "h2",
        "heading3" => "h3",
        "heading4" => "h4",
        "heading5" => "h5",
        "heading6" => "h6",
        _ => "p"
    };
    private string _currentTagName => _selectedSemantic.ToString() switch
    {
        "Heading1" => "H1",
        "Heading2" => "H2",
        "Heading3" => "H3",
        "Heading4" => "H4",
        "Heading5" => "H5",
        "Heading6" => "H6",
        _ => "p"
    };
    private string _currentVariantName => _selectedSemantic == SgTypographyVariant.None ? "body" : _selectedSemantic.ToString();
