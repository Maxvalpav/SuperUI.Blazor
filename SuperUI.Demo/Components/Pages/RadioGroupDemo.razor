@page "/demo/radiogroup"
@using SuperUI.Demo.Components
@using SuperUI.Components

<div class="demo-page">
    <div class="demo-hero">
        <section class="demo-hero-main">
            <div class="demo-header">
                <div class="demo-kicker">Input Components</div>
                <h1 class="demo-title">SgRadioGroup</h1>
                <p class="demo-subtitle">
                    Radio group for mutually exclusive choices with keyboard navigation, segmented mode
                    and validation-friendly integration.
                </p>
            </div>
        </section>

        <aside class="demo-hero-side">
            <div class="demo-side-title">Highlights</div>
            <div class="demo-pill-list">
                <span class="demo-pill demo-pill-accent">Keyboard</span>
                <span class="demo-pill">Segmented</span>
                <span class="demo-pill">Vertical / Horizontal</span>
                <span class="demo-pill">Form Ready</span>
            </div>

            <div class="demo-meta-grid">
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Navigation</span>
                    <span class="demo-meta-value">Arrow keys, Home, End</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Use Cases</span>
                    <span class="demo-meta-value">Modes, plans, quick choices, preference sets</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Render</span>
                    <span class="demo-meta-value">SSR-safe static markup and interactive behavior</span>
                </div>
            </div>
        </aside>
    </div>

    <SgDemoSection Eyebrow="Usage" Title="Examples" Description="Radio selection patterns for settings, pricing and workflow decisions.">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Horizontal Group</h3>
                    <p class="demo-showcase-desc">Best for a small set of equally important choices.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgRadioGroup TValue="string"
                                      @bind-Value="_environment"
                                      Label="Environment"
                                      Options="_environmentOptions" />
                        <div class="demo-inline-value">Selected: @_environment</div>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Vertical Group</h3>
                    <p class="demo-showcase-desc">Useful when labels are longer or need more breathing room.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgRadioGroup TValue="string"
                                      @bind-Value="_severity"
                                      Label="Severity"
                                      Orientation="SgRadioOrientation.Vertical"
                                      Options="_severityOptions" />
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Segmented Mode</h3>
                    <p class="demo-showcase-desc">Turns radios into a compact connected option bar.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgRadioGroup TValue="string"
                                      @bind-Value="_viewMode"
                                      Label="View Mode"
                                      ButtonGroup="true"
                                      Options="_viewModeOptions" />
                        <div class="demo-inline-value">Current mode: @_viewMode</div>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Disabled Options</h3>
                    <p class="demo-showcase-desc">Keep unavailable choices visible without allowing selection.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgRadioGroup TValue="string"
                                      @bind-Value="_plan"
                                      Label="Plan"
                                      Options="_planOptions"
                                      Hint="Enterprise is not enabled in this demo tenant." />
                    </div>
                    <div class="demo-note">Disabled options help explain roadmap or permission boundaries.</div>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoParams Title="RadioGroup Parameters" Description="Parameters for customizing the appearance and behavior of the SgRadioGroup component.">
        <SgDemoParam Name="Options" Type="IEnumerable&lt;RadioOption&lt;TValue&gt;&gt;" Description="Collection of radio options." DefaultValue="Empty collection" />
        <SgDemoParam Name="Label" Type="string" Description="Group label shown above the options." DefaultValue="null" />
        <SgDemoParam Name="Hint" Type="string" Description="Helper text shown below the group." DefaultValue="null" />
        <SgDemoParam Name="Orientation" Type="SgRadioOrientation" Description="Controls horizontal or vertical layout." Values="Horizontal, Vertical" DefaultValue="Horizontal" />
        <SgDemoParam Name="ButtonGroup" Type="bool" Description="Renders the radios as a segmented button group." Values="true, false" DefaultValue="false" />
        <SgDemoParam Name="Block" Type="bool" Description="Expands the group to the full available width." Values="true, false" DefaultValue="true" />
        <SgDemoParam Name="Required" Type="bool" Description="Marks the group as required for forms." Values="true, false" DefaultValue="false" />
        <SgDemoParam Name="Disabled" Type="bool" Description="Disables all options in the group." Values="true, false" DefaultValue="false" />
        <SgDemoParam Name="ErrorText" Type="string" Description="Explicit validation error text." DefaultValue="null" />
        <SgDemoParam Name="Value" Type="TValue" Description="Currently selected option value." DefaultValue="default" />
    </SgDemoParams>
</div>

@code {
    private readonly List<RadioOption<string>> _environmentOptions =
    [
        new() { Label = "Dev", Value = "Dev" },
        new() { Label = "Stage", Value = "Stage" },
        new() { Label = "Prod", Value = "Prod" }
    ];

    private readonly List<RadioOption<string>> _severityOptions =
    [
        new() { Label = "Low", Value = "Low" },
        new() { Label = "Medium", Value = "Medium" },
        new() { Label = "High", Value = "High" }
    ];

    private readonly List<RadioOption<string>> _viewModeOptions =
    [
        new() { Label = "Board", Value = "Board" },
        new() { Label = "List", Value = "List" },
        new() { Label = "Timeline", Value = "Timeline" }
    ];

    private readonly List<RadioOption<string>> _planOptions =
    [
        new() { Label = "Starter", Value = "Starter" },
        new() { Label = "Business", Value = "Business" },
        new() { Label = "Enterprise", Value = "Enterprise", Disabled = true }
    ];

    private string _environment = "Stage";
    private string _severity = "Medium";
    private string _viewMode = "Board";
    private string _plan = "Business";
}
