@page "/demo/switch"
@using SuperUI.Demo.Components

<div class="demo-page">
    <div class="demo-hero">
        <section class="demo-hero-main">
            <div class="demo-header">
                <div class="demo-kicker">Input Components</div>
                <h1 class="demo-title">SgSwitch</h1>
                <p class="demo-subtitle">
                    Toggle input for preferences, feature flags and binary settings with form validation,
                    semantic accessibility and compact on/off labeling.
                </p>
            </div>
        </section>

        <aside class="demo-hero-side">
            <div class="demo-side-title">Highlights</div>
            <div class="demo-pill-list">
                <span class="demo-pill demo-pill-accent">Form Ready</span>
                <span class="demo-pill">ARIA Switch</span>
                <span class="demo-pill">Sizes</span>
                <span class="demo-pill">SSR Safe</span>
            </div>

            <div class="demo-meta-grid">
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Modes</span>
                    <span class="demo-meta-value">Label, on/off labels, custom content</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Accessibility</span>
                    <span class="demo-meta-value">`role="switch"`, `aria-checked`, validation-aware</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Render</span>
                    <span class="demo-meta-value">Server, WASM, InteractiveAuto friendly</span>
                </div>
            </div>
        </aside>
    </div>

    <SgDemoSection Eyebrow="Usage" Title="Examples" Description="Switch patterns for settings screens, consent flows and operational toggles.">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Basic Usage</h3>
                    <p class="demo-showcase-desc">Use a plain label for a straightforward boolean preference.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgSwitch @bind-Value="_emailEnabled" Label="Email notifications" />
                        <div class="demo-inline-value">Current value: @_emailEnabled</div>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">On / Off Labels</h3>
                    <p class="demo-showcase-desc">Show explicit state wording when the meaning must stay visible.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgSwitch @bind-Value="_maintenanceMode" OnLabel="Enabled" OffLabel="Disabled" />
                        <SgSwitch Value="true" OnLabel="Live" OffLabel="Paused" Size="SgSize.Lg" />
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Sizes And Disabled</h3>
                    <p class="demo-showcase-desc">Scale the control for compact lists or larger settings panels.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgSwitch Label="Compact" Size="SgSize.Sm" Value="true" />
                        <SgSwitch Label="Default" Size="SgSize.Md" Value="true" />
                        <SgSwitch Label="Large" Size="SgSize.Lg" Value="true" />
                        <SgSwitch Label="Disabled" Disabled="true" Value="false" />
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Custom Content</h3>
                    <p class="demo-showcase-desc">Pair the switch with richer descriptive content.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgSwitch @bind-Value="_auditLog">
                            <div style="display:flex; flex-direction:column; gap:4px;">
                                <span style="font-weight:600;">Audit Logging</span>
                                <span style="font-size:12px; color:#64748b;">Store every admin action for compliance review.</span>
                            </div>
                        </SgSwitch>
                    </div>
                    <div class="demo-note">Custom content works well in security, billing and compliance settings.</div>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoParams Title="Switch Parameters" Description="Parameters for customizing the appearance and behavior of the SgSwitch component.">
        <SgDemoParam Name="Value" Type="bool" Description="The current switch state." Values="true, false" DefaultValue="false" />
        <SgDemoParam Name="Label" Type="string" Description="Text label rendered next to the switch." DefaultValue="null" />
        <SgDemoParam Name="OnLabel" Type="string" Description="Text shown for the enabled state." DefaultValue="null" />
        <SgDemoParam Name="OffLabel" Type="string" Description="Text shown for the disabled state." DefaultValue="null" />
        <SgDemoParam Name="Size" Type="SgSize" Description="Controls the visual size of the switch." Values="Sm, Md, Lg" DefaultValue="Md" />
        <SgDemoParam Name="Disabled" Type="bool" Description="Disables the switch interaction." Values="true, false" DefaultValue="false" />
        <SgDemoParam Name="Required" Type="bool" Description="Marks the field as required for forms." Values="true, false" DefaultValue="false" />
        <SgDemoParam Name="Hint" Type="string" Description="Helper text shown below the control." DefaultValue="null" />
        <SgDemoParam Name="ErrorText" Type="string" Description="Explicit validation error text." DefaultValue="null" />
        <SgDemoParam Name="ChildContent" Type="RenderFragment" Description="Custom label content rendered beside the switch." DefaultValue="null" />
    </SgDemoParams>
</div>

@code {
    private bool _emailEnabled = true;
    private bool _maintenanceMode;
    private bool _auditLog = true;
}
