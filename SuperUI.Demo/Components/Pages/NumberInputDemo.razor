    private static string Fmt(int? v) => v?.ToString() ?? "—";

    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add($"<SgNumberInput TValue=\"int?\"");
        lines.Add($"             @bind-Value=\"@_myValue\"");
        if (_ctorMin.HasValue)
            lines.Add($"             Min=\"{_ctorMin}\"");
        if (_ctorMax.HasValue)
            lines.Add($"             Max=\"{_ctorMax}\"");
        if (_ctorStep != 1)
            lines.Add($"             Step=\"{_ctorStep}\"");
        if (_ctorSize != SgSize.Md)
            lines.Add($"             Size=\"SgSize.{_ctorSize}\"");
        if (!string.IsNullOrEmpty(_ctorSuffix))
            lines.Add($"             Suffix=\"{_ctorSuffix}\"");
        if (!_ctorShowButtons)
            lines.Add($"             ShowButtons=\"false\"");
        if (_ctorClearBtn)
            lines.Add($"             ShowClearButton=\"true\"");
        lines.Add($"             Label=\"My label\" />");
        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

