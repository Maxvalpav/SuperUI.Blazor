@page "/number-input-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgNumberInput & SgNumberEdit — Number Input — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. SgNumberEdit                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgNumberEdit — Value-Type Number Editor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Constrained to <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">struct, IComparable&lt;TValue&gt;</SgTypography> value types. Uses <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">inputmode="decimal"</SgTypography> with custom parsing for precise formatting. Supports step, min/max, suffix, prefix, and EditContext integration.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Basic
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <div class="demo-value-row">
                                <SgNumberEdit TValue="int" @bind-Value="@_editInt" Label="Integer" Placeholder="0" />
                                <span class="demo-value-chip">@(_editInt?.ToString() ?? "—")</span>
                            </div>
                            <div class="demo-value-row">
                                <SgNumberEdit TValue="double" @bind-Value="@_editDouble" Label="Double (step 0.01)" Placeholder="0.00" Step="0.01" />
                                <span class="demo-value-chip">@(_editDouble?.ToString("F2") ?? "—")</span>
                            </div>
                            <div class="demo-value-row">
                                <SgNumberEdit TValue="int" @bind-Value="@_editClamped" Label="Clamped 0–100" Min="0" Max="100" />
                                <span class="demo-value-chip">@(_editClamped?.ToString() ?? "—")</span>
                            </div>
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Affixes &amp; Formatting
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgNumberEdit TValue="int" @bind-Value="@_editSuffix" Label="With suffix" Suffix="kg" />
                            <SgNumberEdit TValue="int" @bind-Value="@_editPrefix" Label="With prefix" Prefix="$" Step="10" />
                            <SgNumberEdit TValue="double" @bind-Value="@_editDecimals" Label="Decimals=2" Decimals="2" Step="0.01" />
                            <SgNumberEdit TValue="double" @bind-Value="@_editFormat" Label="Format N2" Format="N2" Step="0.01" />
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Icons &amp; Status
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgNumberEdit TValue="double" @bind-Value="@_editIconDollar" Label="Leading icon" LeadingIcon="@SgIcons.DollarSign" Step="0.5" Decimals="2" />
                            <SgNumberEdit TValue="int" @bind-Value="@_editIconPerc" Label="Trailing icon" Suffix="%" TrailingIcon="@SgIcons.Zap" />
                            <SgNumberEdit TValue="int" @bind-Value="@_editStatusOk" Label="Status Success" Status="SgColor.Success" />
                            <SgNumberEdit TValue="int" @bind-Value="@_editStatusBad" Label="Status Danger" Status="SgColor.Danger" />
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Range &amp; Animation
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgNumberEdit TValue="int" @bind-Value="@_editRange" Label="Range indicator 0–100" Min="0" Max="100" ShowRangeIndicator="true" />
                            <SgNumberEdit TValue="double" @bind-Value="@_editFlash" Label="Animate changes (step 10)" Step="10" AnimateChanges="true" />
                            <SgNumberEdit TValue="int" @bind-Value="@_editFastStep" Label="Shift ×10, Ctrl ÷10" Step="1" />
                            <SgNumberEdit TValue="double" @bind-Value="@_editGroupSep" Label="Group separator" UseGroupSeparator="true" Decimals="0" />
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Validation &amp; Blur
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgNumberEdit TValue="int" @bind-Value="@_editPopover" Label="Validation popover" ErrorText="Must be positive" ValidationPopover="true" />
                            <SgNumberEdit TValue="double" @bind-Value="@_editAutoFix" Label="Auto-fix on blur (step 5)" Step="5" Min="0" Max="100" AutoFixOnBlur="true" Decimals="0" />
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            States
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgNumberEdit TValue="int" Value="42" Label="Disabled" Disabled="true" />
                            <SgNumberEdit TValue="int" Value="42" Label="Read-only" ReadOnly="true" />
                            <SgNumberEdit TValue="int" @bind-Value="@_editClear" Label="With clear button" ShowClearButton="true" ShowButtons="true" />
                            <SgNumberEdit TValue="double" @bind-Value="@_editCopy" Label="With copy button" AllowCopy="true" Decimals="2" Step="0.01" />
                            <SgNumberEdit TValue="int" @bind-Value="@_editEnter" Label="Enter callback" Size="SgSize.Sm" OnEnterPressed="OnEditEnter" />
                            <div class="demo-value-row">
                                <span class="demo-value-chip">Enter pressed: <strong>@_editEnterCount</strong></span>
                            </div>
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Sizes
                        </SgTypography>
                        <div class="demo-size-row">
                            <SgNumberEdit TValue="int" Value="10" Label="Sm" Size="SgSize.Sm" />
                            <SgNumberEdit TValue="int" Value="20" Label="Md" Size="SgSize.Md" />
                            <SgNumberEdit TValue="int" Value="30" Label="Lg" Size="SgSize.Lg" />
                        </div>
                    </div>
                </SgStack>
            </SgCard>
            <SgCard Title="SgNumberEdit Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_editProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. SgNumberInput                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgNumberInput — Universal Numeric Input
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Generic numeric input with inline +/- buttons, long-press repeat, optional clear/copy actions, and full validation via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgInputBase&lt;TValue&gt;</SgTypography>. Supports any nullable numeric type, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">type="number"</SgTypography> with native browser behavior.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Basic Binding
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <div class="demo-value-row">
                                <SgNumberInput TValue="int?" @bind-Value="@_numInt"
                                               Label="Integer" Placeholder="0" Step="1" />
                                <span class="demo-value-chip">@(_numInt?.ToString() ?? "—")</span>
                            </div>
                            <div class="demo-value-row">
                                <SgNumberInput TValue="double?" @bind-Value="@_numDouble"
                                               Label="Double (step 0.1)" Placeholder="0.00" Step="0.1" Decimals="2" />
                                <span class="demo-value-chip">@(_numDouble?.ToString("F2") ?? "—")</span>
                            </div>
                            <div class="demo-value-row">
                                <SgNumberInput TValue="int?" @bind-Value="@_numClamped"
                                               Label="Clamped 0–100 (step 5)" Min="0" Max="100" Step="5" />
                                <span class="demo-value-chip">@(_numClamped?.ToString() ?? "—")</span>
                            </div>
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Affixes &amp; Formatting
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgNumberInput TValue="double?" @bind-Value="@_numSuffix" Label="Suffix" Suffix="kg" Step="0.5" Decimals="1" />
                            <SgNumberInput TValue="int?" @bind-Value="@_numPrefix" Label="Prefix" Prefix="$" Step="10" />
                            <SgNumberInput TValue="double?" @bind-Value="@_numFormat" Label="Format N2" Format="N2" Step="0.01" />
                            <SgNumberInput TValue="int?" Value="7" Label="No buttons" ShowButtons="false" />
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Icons &amp; Status
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgNumberInput TValue="double?" @bind-Value="@_numIconEuro" Label="Leading icon" LeadingIcon="@SgIcons.Tag" Step="0.5" Decimals="2" />
                            <SgNumberInput TValue="int?" @bind-Value="@_numIconStar" Label="Trailing icon" Suffix="pts" TrailingIcon="@SgIcons.Star" />
                            <SgNumberInput TValue="int?" @bind-Value="@_numStatusOk" Label="Status Success" Status="SgColor.Success" />
                            <SgNumberInput TValue="int?" @bind-Value="@_numStatusWarn" Label="Status Warning" Status="SgColor.Warning" />
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Range &amp; Animation
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgNumberInput TValue="int?" @bind-Value="@_numRange" Label="Range indicator 0–100" Min="0" Max="100" ShowRangeIndicator="true" />
                            <SgNumberInput TValue="double?" @bind-Value="@_numFlash" Label="Animate changes (step 10)" Step="10" AnimateChanges="true" />
                            <SgNumberInput TValue="int?" @bind-Value="@_numFastStep" Label="Shift ×10, Ctrl ÷10" Step="1" />
                            <SgNumberInput TValue="double?" @bind-Value="@_numGroupSep" Label="Group separator" UseGroupSeparator="true" Decimals="0" />
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Validation &amp; Blur
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgNumberInput TValue="int?" @bind-Value="@_numPopover" Label="Validation popover" ErrorText="Value required" ValidationPopover="true" />
                            <SgNumberInput TValue="double?" @bind-Value="@_numAutoFix" Label="Auto-fix on blur (step 5)" Step="5" Min="0" Max="100" AutoFixOnBlur="true" Decimals="0" />
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            States &amp; Actions
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgNumberInput TValue="int?" Value="42" Label="Disabled" Disabled="true" />
                            <SgNumberInput TValue="int?" Value="42" Label="Read-only" ReadOnly="true" />
                            <SgNumberInput TValue="int?" @bind-Value="@_numError" Label="With error" ErrorText="Invalid value" />
                            <SgNumberInput TValue="int?" @bind-Value="@_numClear" Label="Clear button" ShowClearButton="true" />
                            <SgNumberInput TValue="double?" @bind-Value="@_numCopy" Label="Copy button + clear" ShowClearButton="true" AllowCopy="true" Decimals="2" Step="0.01" />
                            <SgNumberInput TValue="int?" @bind-Value="@_numWheelOff" Label="Wheel disabled" DisableWheel="true" />
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Sizes
                        </SgTypography>
                        <div class="demo-size-row">
                            <SgNumberInput TValue="int?" Value="10" Label="Sm" Size="SgSize.Sm" />
                            <SgNumberInput TValue="int?" Value="20" Label="Md" Size="SgSize.Md" />
                            <SgNumberInput TValue="int?" Value="30" Label="Lg" Size="SgSize.Lg" />
                        </div>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Label Positions
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgNumberInput TValue="int?" Value="10" Label="Top (default)" LabelPosition="SgLabelPosition.Top" />
                            <SgNumberInput TValue="int?" Value="20" Label="Left" LabelPosition="SgLabelPosition.Left" />
                            <SgNumberInput TValue="int?" Value="30" Label="Right" LabelPosition="SgLabelPosition.Right" />
                        </SgStack>
                    </div>
                </SgStack>
            </SgCard>
            <SgCard Title="SgNumberInput Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_inputProperties" />
            </SgCard>
        </div>

        <!-- Live values -->
        <div style="margin-top:16px;display:flex;flex-wrap:wrap;gap:8px;align-items:center;">
            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="margin-right:4px;">Live Values:</SgTypography>
            @foreach (var val in _liveValues)
            {
                <span class="demo-live-chip">@val.Label: <strong>@val.Value</strong></span>
            }
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. SgCoordinateInput                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgCoordinateInput — Geographic Coordinates
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Specialized dual-field input for latitude/longitude with adjustable step precision, DMS format display, copy-to-clipboard, and clear actions. Bounds-checked to ±90°/±180°.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Basic
                        </SgTypography>
                        <SgCoordinateInput @bind-Latitude="@_coordLat"
                                           @bind-Longitude="@_coordLon"
                                           OnCoordinateChanged="OnCoordChanged"
                                           Label="Moscow coordinates" />
                        @if (_coordLat.HasValue && _coordLon.HasValue)
                        {
                            <div class="demo-value-row">
                                <span class="demo-value-chip"><SgTypography Font="SgTypographyFont.Mono" Size="SgTypographySize.Sm">@_coordLat.Value.ToString("F6"), @_coordLon.Value.ToString("F6")</SgTypography></span>
                            </div>
                        }
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            DMS Format
                        </SgTypography>
                        <SgCoordinateInput Label="Paris (DMS)" ShowDms="true"
                                           @bind-Latitude="@_coordDmsLat"
                                           @bind-Longitude="@_coordDmsLon" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            States
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgCoordinateInput Label="Disabled" Latitude="55.7558" Longitude="37.6173" Disabled="true" />
                            <SgCoordinateInput Label="Required" @bind-Latitude="@_coordReqLat" @bind-Longitude="@_coordReqLon" Required="true" />
                            <SgCoordinateInput Label="Read-only" Latitude="48.8566" Longitude="2.3522" ReadOnly="true" />
                            <SgCoordinateInput Label="With hint" @bind-Latitude="@_coordHintLat" @bind-Longitude="@_coordHintLon" Hint="Decimal format (e.g. 55.7558)" />
                        </SgStack>
                    </div>
                </SgStack>
            </SgCard>
            <SgCard Title="SgCoordinateInput Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_coordProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Live SgNumberInput Constructor                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live SgNumberInput Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure parameters and see the result in real time. Long-press the +/- buttons to auto-repeat. Click "Copy" to grab the generated code.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">
                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Value -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                Value: @(_ctorValue?.ToString() ?? "—")
                            </SgTypography>
                            <SgNumberInput TValue="int?" @bind-Value="@_ctorValue"
                                           Label="Adjust value"
                                           ShowClearButton="true" />
                        </SgStack>

                        <!-- Min / Max -->
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Min</SgTypography>
                                    <SgNumberInput TValue="int?" @bind-Value="@_ctorMin" Label="Minimum" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Max</SgTypography>
                                    <SgNumberInput TValue="int?" @bind-Value="@_ctorMax" Label="Maximum" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Step -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Step</SgTypography>
                            <SgSegmented TValue="int"
                                         Value="@_ctorStep"
                                         ValueChanged="v => { _ctorStep = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_stepSegOptions" />
                        </SgStack>

                        <!-- Size -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                            <SgSegmented TValue="SgSize"
                                         Value="@_ctorSize"
                                         ValueChanged="v => { _ctorSize = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_sizeSegOptions" />
                        </SgStack>

                        <!-- Suffix -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Suffix</SgTypography>
                            <SgSegmented TValue="string"
                                         Value="@_ctorSuffix"
                                         ValueChanged="v => { _ctorSuffix = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_suffixSegOptions" />
                        </SgStack>

                        <!-- Toggles -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                @* show buttons *@
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">ShowButtons</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorShowButtons"
                                                 ValueChanged="v => { _ctorShowButtons = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                @* clear button *@
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">ClearBtn</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorClearBtn"
                                                 ValueChanged="v => { _ctorClearBtn = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Value</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@Fmt(_ctorValue)" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Min</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@Fmt(_ctorMin)" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Max</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@Fmt(_ctorMax)" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Step</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Success" Text="@_ctorStep.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorSize.ToString()" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">
                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <div class="constructor-preview">
                                <SgNumberInput TValue="int?"
                                               Value="@_ctorValue"
                                               ValueChanged="v => { _ctorValue = v; UpdateConstructorCode(); StateHasChanged(); }"
                                               Min="@_ctorMin"
                                               Max="@_ctorMax"
                                               Step="@_ctorStep"
                                               Size="@_ctorSize"
                                               Suffix="@_ctorSuffix"
                                               ShowButtons="@_ctorShowButtons"
                                               ShowClearButton="@_ctorClearBtn"
                                               Label="Constructor preview" />
                            </div>
                        </SgStack>

                        <!-- Code with Copy -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                    <span id="copy-icon">@_copyIcon</span>
                                    <span id="copy-text" style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                </button>
                            </div>
                            <div class="code-block">
                                @foreach (var line in _generatedCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>
                    </SgStack>
                </SgCol>
            </SgRow>
        </SgCard>
    </div>

    </ChildContent>
</SgCard>

<style>
