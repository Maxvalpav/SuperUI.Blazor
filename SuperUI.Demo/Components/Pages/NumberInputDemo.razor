@page "/number-input-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models

<PageTitle>Числовой ввод - SUI</PageTitle>

<SgCard Title="Компоненты числового ввода"
        Subtitle="Компоненты для ввода чисел, координат и работы с числовыми значениями."
        CssClass="sgc-card-flush">

    @* ── SgNumberEdit ─────────────────────────────────────────────── *@
    <div class="sgc-demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading2">SgNumberEdit</SgTypography>
            <span class="demo-live-badge">Интерактивный</span>
        </div>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" CssClass="demo-section-desc">Компонент для ввода чисел с поддержкой шага, минимума и максимума.</SgTypography>

        <div class="demo-grid-adaptive">
            <SgCard Title="Примеры использования" CssClass="demo-interactive-card">
                <div class="demo-flex-col">
                    <SgNumberEdit TValue="int" @bind-Value="@_intValue" Label="Целое число" Placeholder="0" />
                    <div class="demo-value-display">
                        <span class="demo-value-display-label">Значение</span>
                        <span class="demo-value-display-value">@(_intValue?.ToString() ?? "—")</span>
                    </div>
                    <SgNumberEdit TValue="double" @bind-Value="@_doubleValue" Label="Дробное число" Placeholder="0.00" Step="0.01" />
                    <SgNumberEdit TValue="int" @bind-Value="@_clampedValue" Label="С ограничениями (0–100)" Min="0" Max="100" />
                    <SgNumberEdit TValue="int" @bind-Value="@_suffixValue" Label="С суффиксом" Suffix="кг" ShowButtons="true" />
                    <SgDivider />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Новые параметры</SgTypography>
                    <SgNumberEdit TValue="int" @bind-Value="@_editPrefix" Label="С префиксом" Prefix="$" Step="10" />
                    <SgNumberEdit TValue="double" @bind-Value="@_editDecimals" Label="С дробной частью" Decimals="2" Step="0.01" />
                    <SgNumberEdit TValue="int" @bind-Value="@_editSize" Label="Размер Large" Size="SgSize.Lg" Step="5" />
                    <SgNumberEdit TValue="int" @bind-Value="@_editEnter" Label="Enter callback" Size="SgSize.Sm" OnEnterPressed="OnEditEnter" />
                    <div class="demo-value-display">
                        <span class="demo-value-display-label">Enter нажат</span>
                        <span class="demo-value-display-value">@_editEnterCount</span>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_numberEditProperties" />
            </SgCard>
        </div>
    </div>

    @* ── SgNumberInput ────────────────────────────────────────────── *@
    <div class="sgc-demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading2">SgNumberInput</SgTypography>
            <span class="demo-live-badge">Интерактивный</span>
        </div>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" CssClass="demo-section-desc">Универсальный компонент числового ввода с встроенными кнопками инкремента/декремента, поддержкой шага, ограничений и суффикса единиц измерения.</SgTypography>

        <div class="demo-grid-adaptive">
            <SgCard Title="Примеры использования" CssClass="demo-interactive-card">
                <div class="demo-flex-col">
                    <SgNumberInput TValue="int?" @bind-Value="@_numInt"
                                   Label="Целое число"
                                   Placeholder="0"
                                   Step="1" />
                    <SgNumberInput TValue="double?" @bind-Value="@_numDouble"
                                   Label="Дробное число (шаг 0.1)"
                                   Placeholder="0.00"
                                   Step="0.1"
                                   Decimals="2" />
                    <SgNumberInput TValue="int?" @bind-Value="@_numClamped"
                                   Label="С ограничениями (0–100)"
                                   Min="0" Max="100"
                                   Step="5" />
                    <SgNumberInput TValue="double?" @bind-Value="@_numSuffix"
                                   Label="С суффиксом единиц"
                                   Suffix="кг"
                                   Step="0.5"
                                   Decimals="1" />
                    <SgNumberInput TValue="int?" @bind-Value="@_numDisabled"
                                   Label="Отключённый"
                                   Disabled="true" />
                    <SgNumberInput TValue="int?" @bind-Value="@_numError"
                                   Label="С ошибкой валидации"
                                   ErrorText="Значение вне допустимого диапазона" />
                    <SgDivider />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Размеры <SgTypography As="SgTypographyElement.Code">Size</SgTypography></SgTypography>
                    <div class="demo-flex-row" style="flex-wrap:wrap;gap:8px;align-items:start;">
                        <SgNumberInput TValue="int?" Label="Small" Size="SgSize.Sm" Step="1" />
                        <SgNumberInput TValue="int?" Label="Medium" Size="SgSize.Md" Step="1" />
                        <SgNumberInput TValue="int?" Label="Large" Size="SgSize.Lg" Step="1" />
                    </div>
                    <SgDivider />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Новые параметры</SgTypography>
                    <SgNumberInput TValue="double?" @bind-Value="@_numFormat"
                                   Label="С форматом (N2)"
                                   Format="N2" Step="0.01" />
                    <SgNumberInput TValue="int?" @bind-Value="@_numPrefix"
                                   Label="С префиксом"
                                   Prefix="$" Step="10" />
                    <SgNumberInput TValue="int?" @bind-Value="@_numNoButtons"
                                   Label="Без кнопок"
                                   ShowButtons="false" />
                    <SgNumberInput TValue="int?" @bind-Value="@_numWheelOff"
                                   Label="Колёсико отключено"
                                   DisableWheel="true" Step="1" />
                    <div class="demo-flex-row" style="flex-wrap:wrap;gap:8px;align-items:start;">
                        <div style="flex:1;min-width:160px;">
                            <SgNumberInput TValue="int?" Label="Label Left" LabelPosition="SgLabelPosition.Left" Step="1" />
                        </div>
                        <div style="flex:1;min-width:160px;">
                            <SgNumberInput TValue="int?" Label="Label Right" LabelPosition="SgLabelPosition.Right" Step="1" />
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_numberInputProperties" />
            </SgCard>
        </div>

        <div class="demo-flex-row" style="margin-top:16px;">
            <SgAlert Variant="SgAlertVariant.Info" Title="Отличие от SgNumberEdit">
                <ChildContent>
                    <b>SgNumberInput</b> — самостоятельный компонент с кнопками +/− встроенными в поле ввода.
                    Поддерживает любой числовой тип (<code>int?</code>, <code>double?</code>, <code>decimal?</code> и т.д.) через generic параметр <code>TValue</code>.
                    Кнопки автоматически блокируются при достижении Min/Max.
                </ChildContent>
            </SgAlert>
        </div>
    </div>

    @* ── SgCoordinateInput ───────────────────────────────────────── *@
    <div class="sgc-demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading2">SgCoordinateInput</SgTypography>
            <span class="demo-live-badge">Интерактивный</span>
        </div>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" CssClass="demo-section-desc">Специализированный компонент для ввода географических координат (широта/долгота) с кнопками +/−, выбором шага и форматом DMS.</SgTypography>

        <div class="demo-grid-adaptive">
            <SgCard Title="Примеры использования" CssClass="demo-interactive-card">
                <div class="demo-flex-col">
                    <SgCoordinateInput Label="Координаты (Москва)"
                                       @bind-Latitude="_coordLat"
                                       @bind-Longitude="_coordLon"
                                       OnCoordinateChanged="OnCoordChanged" />
                    @if (_coordLat.HasValue && _coordLon.HasValue)
                    {
                        <div class="demo-value-display">
                            <span class="demo-value-display-label">📍 Координаты</span>
                            <span class="demo-value-display-value"><SgTypography Font="SgTypographyFont.Mono" Size="SgTypographySize.Sm">@_coordLat.Value.ToString("F6"), @_coordLon.Value.ToString("F6")</SgTypography></span>
                        </div>
                    }
                    <SgDivider />
                    <SgCoordinateInput Label="С DMS форматом"
                                       @bind-Latitude="_coordLat2"
                                       @bind-Longitude="_coordLon2"
                                       ShowDms="true" />
                    <SgCoordinateInput Label="Отключённый"
                                       Latitude="55.7558"
                                       Longitude="37.6173"
                                       Disabled="true" />
                    <SgDivider />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Новые параметры</SgTypography>
                    <SgCoordinateInput Label="Обязательное поле"
                                       @bind-Latitude="_coordReqLat"
                                       @bind-Longitude="_coordReqLon"
                                       Required="true" />
                    <SgCoordinateInput Label="Только чтение"
                                       Latitude="48.8566"
                                       Longitude="2.3522"
                                       ReadOnly="true" />
                    <SgCoordinateInput Label="С подсказкой"
                                       @bind-Latitude="_coordHintLat"
                                       @bind-Longitude="_coordHintLon"
                                       Hint="Введите координаты в десятичном формате" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_coordInputProperties" />
            </SgCard>
        </div>
    </div>

</SgCard>

<style>
    .sgc-card-flush > .sgc-card-body {
        padding: 0 24px 24px;
    }
    @@media (max-width: 640px) {
        .sgc-card-flush > .sgc-card-body {
            padding: 0 12px 12px;
        }
    }
</style>

@code {
    // NumberEdit
    private int? _intValue;
    private double? _doubleValue;
    private int? _clampedValue = 50;
    private int? _suffixValue;
    private int? _editPrefix;
    private double? _editDecimals = 3.14;
    private int? _editSize = 75;
    private int? _editEnter;
    private int _editEnterCount;

    // NumberInput
    private int? _numInt = 42;
    private double? _numDouble = 3.14;
    private int? _numClamped = 50;
    private double? _numSuffix = 12.5;
    private int? _numDisabled = 100;
    private int? _numError;
    private double? _numFormat = 1234.56;
    private int? _numPrefix = 500;
    private int? _numNoButtons = 7;
    private int? _numWheelOff = 10;

    // CoordinateInput
    private double? _coordLat = 55.7558;
    private double? _coordLon = 37.6173;
    private double? _coordLat2;
    private double? _coordLon2;
    private double? _coordReqLat;
    private double? _coordReqLon;
    private double? _coordHintLat;
    private double? _coordHintLon;

    private void OnCoordChanged((double? Lat, double? Lon) coord)
    {
        _coordLat = coord.Lat;
        _coordLon = coord.Lon;
    }

    private void OnEditEnter()
    {
        _editEnterCount++;
    }

    private List<PropertyPanelItem> _numberEditProperties = new()
    {
        new() { Label = "Value", Value = "TValue?", BadgeText = "Значение", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Label", Value = "string", BadgeText = "Метка", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Min", Value = "TValue?", BadgeText = "Минимум", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Max", Value = "TValue?", BadgeText = "Максимум", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Step", Value = "TValue", BadgeText = "Шаг", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Format", Value = "string?", BadgeText = "Формат", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Decimals", Value = "int?", BadgeText = "Знаки", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Suffix", Value = "string", BadgeText = "Суффикс", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Prefix", Value = "string?", BadgeText = "Префикс", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ShowButtons", Value = "bool", BadgeText = "Кнопки", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Size", Value = "Sm | Md | Lg", BadgeText = "Размер", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "OnEnterPressed", Value = "EventCallback", BadgeText = "Событие", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Required", Value = "bool", BadgeText = "Обязательное", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Disabled", Value = "bool", BadgeText = "Отключить", BadgeVariant = SgBadgeVariant.Warn }
    };

    private List<PropertyPanelItem> _numberInputProperties = new()
    {
        new() { Label = "TValue",       Value = "int?, double?, decimal?…", BadgeText = "Generic",   BadgeVariant = SgBadgeVariant.Info  },
        new() { Label = "Value",        Value = "TValue?",                  BadgeText = "Bind",      BadgeVariant = SgBadgeVariant.Info  },
        new() { Label = "Step",         Value = "TValue?",                  BadgeText = "Шаг",       BadgeVariant = SgBadgeVariant.Warn  },
        new() { Label = "Min",          Value = "TValue?",                  BadgeText = "Минимум",   BadgeVariant = SgBadgeVariant.Warn  },
        new() { Label = "Max",          Value = "TValue?",                  BadgeText = "Максимум",  BadgeVariant = SgBadgeVariant.Warn  },
        new() { Label = "Suffix",       Value = "string?",                  BadgeText = "Суффикс",   BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Prefix",       Value = "string?",                  BadgeText = "Префикс",   BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Decimals",     Value = "int?",                     BadgeText = "Знаки",     BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Format",       Value = "string?",                  BadgeText = "Формат",    BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Label",        Value = "string?",                  BadgeText = "Метка",     BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "LabelPosition",Value = "Top | Left | Right",       BadgeText = "Позиция",   BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Placeholder",  Value = "string?",                  BadgeText = "Подсказка", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "ShowButtons",  Value = "bool (true)",              BadgeText = "Кнопки",    BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "DisableWheel", Value = "bool",                     BadgeText = "Колёсико",  BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Disabled",     Value = "bool",                     BadgeText = "Состояние", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "ReadOnly",     Value = "bool",                     BadgeText = "Состояние", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "ErrorText",    Value = "string?",                  BadgeText = "Ошибка",    BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "Hint",         Value = "string?",                  BadgeText = "Подсказка", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Immediate",    Value = "bool (true)",              BadgeText = "Режим",     BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Size",         Value = "Sm | Md | Lg",             BadgeText = "Размер",    BadgeVariant = SgBadgeVariant.Info     },
        new() { Label = "Culture",      Value = "CultureInfo?",             BadgeText = "Культура",  BadgeVariant = SgBadgeVariant.Info     },
    };

    private List<PropertyPanelItem> _coordInputProperties = new()
    {
        new() { Label = "Latitude",             Value = "double?",  BadgeText = "Широта",    BadgeVariant = SgBadgeVariant.Info  },
        new() { Label = "Longitude",            Value = "double?",  BadgeText = "Долгота",   BadgeVariant = SgBadgeVariant.Info  },
        new() { Label = "LatitudeChanged",      Value = "EventCallback&lt;double?&gt;", BadgeText = "Событие", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "LongitudeChanged",     Value = "EventCallback&lt;double?&gt;", BadgeText = "Событие", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "OnCoordinateChanged",  Value = "EventCallback&lt;(Lat, Lon)&gt;", BadgeText = "Событие", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Label",                Value = "string?",  BadgeText = "Метка",     BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "ShowDms",              Value = "bool",     BadgeText = "DMS формат",BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "ShowCopyButton",       Value = "bool (true)", BadgeText = "Копия",  BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "ShowClearButton",      Value = "bool (true)", BadgeText = "Очистка", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Required",             Value = "bool",     BadgeText = "Обязательное", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "ReadOnly",             Value = "bool",     BadgeText = "Чтение",   BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Hint",                 Value = "string?",  BadgeText = "Подсказка", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Disabled",             Value = "bool",     BadgeText = "Состояние", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "ErrorMessage",         Value = "string?",  BadgeText = "Ошибка",    BadgeVariant = SgBadgeVariant.Danger },
    };
}
