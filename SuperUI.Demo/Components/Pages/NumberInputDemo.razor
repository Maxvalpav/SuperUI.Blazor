@page "/demo/numberinput"
@using SuperUI.Demo.Components

<div class="demo-page">
    <div class="demo-hero">
        <section class="demo-hero-main">
            <div class="demo-header">
                <div class="demo-kicker">Input Components</div>
                <h1 class="demo-title">SgNumberInput</h1>
                <p class="demo-subtitle">
                    Numeric input with step controls, clamped ranges, keyboard support and optional suffixes
                    for analytics, pricing and configuration forms.
                </p>
            </div>
        </section>

        <aside class="demo-hero-side">
            <div class="demo-side-title">Highlights</div>
            <div class="demo-pill-list">
                <span class="demo-pill demo-pill-accent">Step Buttons</span>
                <span class="demo-pill">Range Clamp</span>
                <span class="demo-pill">Keyboard</span>
                <span class="demo-pill">Form Ready</span>
            </div>

            <div class="demo-meta-grid">
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Scenarios</span>
                    <span class="demo-meta-value">Prices, limits, counters, percentages</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Interaction</span>
                    <span class="demo-meta-value">Buttons, arrows, direct typing, enter callback</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Render</span>
                    <span class="demo-meta-value">Stable in SSR and interactive modes</span>
                </div>
            </div>
        </aside>
    </div>

    <SgDemoSection Eyebrow="Usage" Title="Examples" Description="Numeric entry patterns for dashboards, settings and transactional forms.">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Basic Counter</h3>
                    <p class="demo-showcase-desc">Use plus/minus controls for fast quantity changes.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgNumberInput TValue="int" @bind-Value="_licenses" Label="Licenses" Min="1" Max="50" Step="1" />
                        <div class="demo-inline-value">Selected: @_licenses licenses</div>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Decimals And Suffix</h3>
                    <p class="demo-showcase-desc">Useful for percentages, weights and metric-style values.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgNumberInput TValue="double" @bind-Value="_discount" Label="Discount" Min="0" Max="100" Step="0.5" Decimals="1" Suffix="%" />
                        <SgNumberInput TValue="double" @bind-Value="_weight" Label="Weight" Min="0" Max="500" Step="0.25" Decimals="2" Suffix="kg" />
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Range Clamp</h3>
                    <p class="demo-showcase-desc">Out-of-range values are normalized to configured bounds.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgNumberInput TValue="int"
                                       @bind-Value="_cpuLimit"
                                       Label="CPU Limit"
                                       Hint="Allowed range: 1 to 32"
                                       Min="1"
                                       Max="32"
                                       Step="1" />
                    </div>
                    <div class="demo-note">Typing `0` or `100` snaps the value back into the valid range.</div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Readonly And Disabled</h3>
                    <p class="demo-showcase-desc">Lock the value when it is controlled elsewhere.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgNumberInput TValue="int" Value="24" Label="Readonly" ReadOnly="true" />
                        <SgNumberInput TValue="int" Value="8" Label="Disabled" Disabled="true" />
                    </div>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoParams Title="NumberInput Parameters" Description="Parameters for customizing the appearance and behavior of the SgNumberInput component.">
        <SgDemoParam Name="Value" Type="TValue" Description="The current numeric value." DefaultValue="default" />
        <SgDemoParam Name="Step" Type="TValue" Description="Increment and decrement step amount." DefaultValue="1" />
        <SgDemoParam Name="Min" Type="TValue" Description="Minimum allowed value." DefaultValue="null" />
        <SgDemoParam Name="Max" Type="TValue" Description="Maximum allowed value." DefaultValue="null" />
        <SgDemoParam Name="Decimals" Type="int?" Description="Number of decimal places used for display formatting." DefaultValue="null" />
        <SgDemoParam Name="Suffix" Type="string" Description="Unit text displayed inside the control." DefaultValue="null" />
        <SgDemoParam Name="Immediate" Type="bool" Description="Updates the bound value on input instead of change." Values="true, false" DefaultValue="true" />
        <SgDemoParam Name="ReadOnly" Type="bool" Description="Prevents editing while keeping the value visible." Values="true, false" DefaultValue="false" />
        <SgDemoParam Name="Disabled" Type="bool" Description="Disables the whole control." Values="true, false" DefaultValue="false" />
        <SgDemoParam Name="OnEnterPressed" Type="EventCallback" Description="Callback fired when Enter is pressed." DefaultValue="null" />
    </SgDemoParams>
</div>

@code {
    private int _licenses = 5;
    private double _discount = 12.5;
    private double _weight = 24.75;
    private int _cpuLimit = 16;
}
