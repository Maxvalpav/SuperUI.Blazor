    private async Task ToggleThemeAsync(bool isDark)
    {
        try
        {
            await JS.InvokeVoidAsync("eval", $"document.documentElement.setAttribute('data-theme', '{ (isDark ? "dark" : "light") }')");
        }
        catch { }
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCode);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

