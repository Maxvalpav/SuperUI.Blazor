@page "/toggle-input-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models
@using SuperUI.Enums
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Toggle Input — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 0. Theme Toggle                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section" style="margin-top:0;">
        <div class="demo-flex-between" style="padding: 8px 0;">
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Toggle dark/light mode for the demo
            </SgTypography>
            <div style="display:flex;align-items:center;gap:8px;">
                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">☀️</SgTypography>
                <SgSwitch @bind-Value="@_darkMode" OnChange="ToggleThemeAsync" />
                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">🌙</SgTypography>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. SgCheckBox                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgCheckBox
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Checkbox with label, sizes, colors, animation, indeterminate state, and readonly. Supports <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">@@bind-Value</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">@@bind-Indeterminate</SgTypography>, and <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">OnChange</SgTypography>.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Interactive" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        @* Base *@
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:4px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Basic
                            </SgTypography>
                            <SgCheckBox @bind-Value="@_check1" Label="I agree to the terms" />
                            <SgCheckBox @bind-Value="@_check2" Label="Disabled" Disabled="true" />
                            <SgCheckBox @bind-Value="@_check3" Label="Preselected (default true)" HelpText="This item was pre-selected" />
                        </SgStack>
                    </div>
                    <div>
                        @* Sizes & Colors *@
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:4px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Sizes & Colors
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgCheckBox @bind-Value="@_check4" Label="Small (Sm)" Size="SgSize.Sm" />
                            <SgCheckBox @bind-Value="@_check5" Label="Medium (Md, default)" Size="SgSize.Md" />
                            <SgCheckBox @bind-Value="@_check6" Label="Large (Lg)" Size="SgSize.Lg" />
                            <SgDivider />
                            <SgCheckBox @bind-Value="@_check7" Label="Success color" CheckColor="SgColor.Success" />
                            <SgCheckBox @bind-Value="@_check8" Label="Danger color" CheckColor="SgColor.Danger" />
                            <SgCheckBox @bind-Value="@_check9" Label="Custom color (#8b5cf6)" Color="#8b5cf6" />
                        </SgStack>
                    </div>
                    <div>
                        @* States *@
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:4px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            States
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgCheckBox @bind-Value="@_check10" Label="ReadOnly" ReadOnly="true" />
                            <SgCheckBox @bind-Value="@_check11" Label="Without animation" Animation="false" />
                            <SgCheckBox @bind-Value="@_check12" Label="Indeterminate (tri-state)" @bind-Indeterminate="@_check12Indeterminate" />
                            <SgCheckBox @bind-Value="@_check13" Label="With ChildContent">
                                <span style="color:var(--sg-color-primary);font-weight:600;">Custom label via ChildContent</span>
                            </SgCheckBox>
                            <SgCheckBox @bind-Value="@_check14" Label="Tile variant" Tile="true" />
                            <SgCheckBox @bind-Value="@_check15" Label="Tile + Danger" Tile="true" CheckColor="SgColor.Danger" />
                            <SgCheckBox @bind-Value="@_check16" Label="Ripple disabled" Ripple="false" />
                        </SgStack>
                    </div>

                    @* Live state *@
                    <SgDivider />
                    <div class="demo-flex-row">
                        <SgBadge Text="@(_check1 ? "Agreed" : "Not agreed")"
                                 Variant="@(_check1 ? SgBadgeVariant.Success : SgBadgeVariant.Muted)" />
                        <SgBadge Text="@($"Indeterminate: {_check12Indeterminate}")"
                                 Variant="@(_check12Indeterminate ? SgBadgeVariant.Warn : SgBadgeVariant.Muted)" />
                        <SgBadge Text="@($"Sm: {_check4}")" Variant="@(_check4 ? SgBadgeVariant.Info : SgBadgeVariant.Muted)" />
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_checkBoxProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. SgSwitch                                                      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgSwitch
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Toggle switch with sizes, colors, loading, labels, and optional On/Off labels. Supports <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">@@bind-Value</SgTypography> and <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">OnChange</SgTypography>.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Interactive" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        @* Basic *@
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:4px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Basic
                        </SgTypography>
                        <div class="demo-flex-between">
                            <SgTypography>Notifications</SgTypography>
                            <SgSwitch @bind-Value="@_switch1" />
                        </div>
                        <div class="demo-flex-between">
                            <SgTypography>Dark mode</SgTypography>
                            <SgSwitch @bind-Value="@_switch2" />
                        </div>
                        <div class="demo-flex-between">
                            <SgTypography>Disabled</SgTypography>
                            <SgSwitch @bind-Value="@_switch3" Disabled="true" />
                        </div>
                    </div>

                    <div>
                        @* Sizes & Colors *@
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:4px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Sizes & Colors
                        </SgTypography>
                        <div class="demo-flex-between">
                            <SgTypography>Small (Sm)</SgTypography>
                            <SgSwitch @bind-Value="@_switch4" Size="SgSize.Sm" />
                        </div>
                        <div class="demo-flex-between">
                            <SgTypography>Large (Lg)</SgTypography>
                            <SgSwitch @bind-Value="@_switch5" Size="SgSize.Lg" />
                        </div>
                        <div class="demo-flex-between">
                            <SgTypography>XL</SgTypography>
                            <SgSwitch @bind-Value="@_switch6" Size="SgSize.Xl" />
                        </div>
                        <SgDivider />
                        <div class="demo-flex-between">
                            <SgTypography>Success (green)</SgTypography>
                            <SgSwitch @bind-Value="@_switch7" SwitchColor="SgColor.Success" />
                        </div>
                        <div class="demo-flex-between">
                            <SgTypography>Danger (red)</SgTypography>
                            <SgSwitch @bind-Value="@_switch8" SwitchColor="SgColor.Danger" />
                        </div>
                        <div class="demo-flex-between">
                            <SgTypography>Custom colors</SgTypography>
                            <SgSwitch @bind-Value="@_switch9" OnColor="#8b5cf6" OffColor="#e5e7eb" />
                        </div>
                    </div>

                    <div>
                        @* States & Labels *@
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:4px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            States & Labels
                        </SgTypography>
                        <div class="demo-flex-between">
                            <SgTypography>ReadOnly</SgTypography>
                            <SgSwitch @bind-Value="@_switch10" ReadOnly="true" />
                        </div>
                        <div class="demo-flex-between">
                            <SgTypography>Loading</SgTypography>
                            <SgSwitch @bind-Value="@_switch11" Loading="true" />
                        </div>
                        <div class="demo-flex-between">
                            <SgTypography>With On/Off labels</SgTypography>
                            <SgSwitch @bind-Value="@_switch12" OnLabel="ON" OffLabel="OFF" />
                        </div>
                        <div class="demo-flex-between">
                            <SgTypography>Hidden label</SgTypography>
                            <SgSwitch @bind-Value="@_switch13" ShowLabel="false" Label="Hidden" />
                        </div>
                        <div class="demo-flex-between">
                            <SgTypography>With ChildContent</SgTypography>
                            <SgSwitch @bind-Value="@_switch14">
                                <span style="color:var(--sg-color-success);font-weight:600;">Airplane mode</span>
                            </SgSwitch>
                        </div>
                        <SgDivider />
                        <div class="demo-flex-between">
                            <SgTypography>Thumb icons (🔆/🌙)</SgTypography>
                            <SgSwitch @bind-Value="@_switch15"
                                      ThumbIconOn="@_sunIcon"
                                      ThumbIconOff="@_moonIcon" />
                        </div>
                        <div class="demo-flex-between">
                            <SgTypography>Thumb icons (✓/✗)</SgTypography>
                            <SgSwitch @bind-Value="@_switch16"
                                      ThumbIconOn="@_checkIcon"
                                      ThumbIconOff="@_xIcon" />
                        </div>
                        <div class="demo-flex-between">
                            <SgTypography>RTL mode</SgTypography>
                            <SgSwitch @bind-Value="@_switch17" Rtl="true" />
                        </div>
                    </div>

                    @* Live state *@
                    <SgDivider />
                    <div class="demo-flex-row">
                        <SgBadge Text="@(_switch1 ? "Notifications ON" : "Notifications OFF")"
                                 Variant="@(_switch1 ? SgBadgeVariant.Info : SgBadgeVariant.Muted)" />
                        <SgBadge Text="@(_switch2 ? "Dark mode" : "Light mode")"
                                 Variant="@(_switch2 ? SgBadgeVariant.Info : SgBadgeVariant.Muted)" />
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_switchProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. SgRadioGroup                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgRadioGroup
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Radio selection with horizontal/vertical orientation, button group mode, sizes, colors, and ItemsSource binding.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Interactive" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:4px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Horizontal (default)
                        </SgTypography>
                        <SgRadioGroup TValue="string" @bind-Value="@_radio1" Options="@_radioOptions" Label="Choose one" />
                        <div class="demo-value-display">
                            <span class="demo-value-display-label">Selected:</span>
                            <span class="demo-value-display-value">@(_radio1 ?? "—")</span>
                        </div>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:4px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Vertical
                        </SgTypography>
                        <SgRadioGroup TValue="string" @bind-Value="@_radio2" Options="@_radioOptions" Label="Vertical layout" Orientation="SgRadioOrientation.Vertical" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:4px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Button Group
                        </SgTypography>
                        <SgRadioGroup TValue="string" @bind-Value="@_radio3" Options="@_radioOptions" Label="Segmented buttons" ButtonGroup="true" />
                        <div class="demo-value-display">
                            <span class="demo-value-display-label">Selected:</span>
                            <span class="demo-value-display-value">@(_radio3 ?? "—")</span>
                        </div>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:4px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Variants
                        </SgTypography>
                        <SgRadioGroup TValue="string" @bind-Value="@_radio4" Options="@_radioOptionsDisabled" Label="With disabled options" />
                        <SgRadioGroup TValue="string" @bind-Value="@_radio5" Options="@_radioOptions" Label="Small size" Size="SgSize.Sm" />
                        <SgRadioGroup TValue="string" @bind-Value="@_radio6" Options="@_radioOptions" Label="Success color" RadioColor="SgColor.Success" />
                        <SgRadioGroup TValue="string" @bind-Value="@_radio7" Options="@_radioOptions" Label="ReadOnly" ReadOnly="true" />
                        <SgRadioGroup TValue="string" @bind-Value="@_radio8" Options="@_radioOptions" Label="With error" ErrorText="Please make a selection" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:4px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            ItemsSource binding
                        </SgTypography>
                        <SgRadioGroup TValue="string" @bind-Value="@_radio9" ItemsSource="@_radioItems" OptionLabelSelector="@(x => x)" Label="Raw string items" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:4px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Card mode with description
                        </SgTypography>
                        <SgRadioGroup TValue="string" @bind-Value="@_radio10" Options="@_radioCardOptions" Card="true" Label="Choose a plan" />
                        <div class="demo-value-display">
                            <span class="demo-value-display-label">Selected:</span>
                            <span class="demo-value-display-value">@(_radio10 ?? "—")</span>
                        </div>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:4px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Card mode with columns + clearable
                        </SgTypography>
                        <SgRadioGroup TValue="string" @bind-Value="@_radio11" Options="@_radioCardOptions2" Card="true" Columns="3" Label="Pick framework" Clearable="true" />
                        <div class="demo-value-display">
                            <span class="demo-value-display-label">Selected:</span>
                            <span class="demo-value-display-value">@(_radio11 ?? "—")</span>
                            <span class="demo-value-display-label" style="margin-left:8px;">(click again to clear)</span>
                        </div>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_radioGroupProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. SgFileUpload                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgFileUpload
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Drag & drop file upload with file type accept, multiple files, size limits, and remove support.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Interactive" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:4px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Single file
                        </SgTypography>
                        <SgFileUpload Label="Upload any file" Hint="Supports all formats" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:4px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Images only, multiple
                        </SgTypography>
                        <SgFileUpload Label="Upload images" Accept="image/*" Multiple="true" AcceptDescription="Images: PNG, JPG, GIF, WEBP" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:4px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With max file size
                        </SgTypography>
                        <SgFileUpload Label="PDF documents" Accept=".pdf" MaxFileSizeBytes="5_242_880" Multiple="true"
                                       AcceptDescription="PDF files up to 5 MB"
                                       Text="Drop PDFs here or click to browse" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:4px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Custom drag zone
                        </SgTypography>
                        <SgFileUpload Label="Custom drop zone" Accept="image/*" Multiple="true" AcceptDescription="Drop images anywhere">
                            <div style="display:flex;flex-direction:column;align-items:center;gap:6px;padding:20px;">
                                <span style="font-size:28px;">🖼️</span>
                                <span style="font-weight:600;">Drop images here</span>
                                <span style="font-size:11px;color:var(--sg-fg-muted);">or click to browse</span>
                            </div>
                        </SgFileUpload>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:4px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With progress bar
                        </SgTypography>
                        <SgFileUpload Label="File upload with progress" Progress="@_uploadProgress" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:4px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Disabled & Required
                        </SgTypography>
                        <SgFileUpload Label="Required upload" Required="true" Hint="This field is required" />
                        <div style="margin-top:8px;">
                            <SgFileUpload Label="Disabled" Disabled="true" />
                        </div>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_fileUploadProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Live Constructor                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live SgCheckBox Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure parameters and see the rendered result in real time.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                Label
                            </SgTypography>
                            <input type="text" class="sgc-input sgc-block" @bind="_constructorLabel"
                                   @bind:after="UpdateConstructorCode"
                                   placeholder="Checkbox label" />
                        </SgStack>

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                Help Text
                            </SgTypography>
                            <input type="text" class="sgc-input sgc-block" @bind="_constructorHelp"
                                   @bind:after="UpdateConstructorCode"
                                   placeholder="Optional help text" />
                        </SgStack>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                        Checked
                                    </SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_constructorChecked"
                                                 ValueChanged="v => { _constructorChecked = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                        Disabled
                                    </SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_constructorDisabled"
                                                 ValueChanged="v => { _constructorDisabled = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                Size
                            </SgTypography>
                            <SgSegmented TValue="string"
                                         Value="@_constructorSize"
                                         ValueChanged="v => { _constructorSize = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="@_sizeSegOptions" />
                        </SgStack>

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                Animation
                            </SgTypography>
                            <SgSegmented TValue="bool"
                                         Value="@_constructorAnimated"
                                         ValueChanged="v => { _constructorAnimated = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="@_boolSegOptions" />
                        </SgStack>

                        @* Summary *@
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Label</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@(_constructorLabel ?? "(empty)")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_constructorSize" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>
                    </SgStack>
                </SgCol>

                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                    Result
                                </SgTypography>
                            </div>
                            <div class="constructor-preview">
                                <SgCheckBox @bind-Value="@_constructorChecked"
                                            Label="@_constructorLabel"
                                            HelpText="@_constructorHelp"
                                            Disabled="@_constructorDisabled"
                                            Size="@(_constructorSize == "Sm" ? SgSize.Sm : _constructorSize == "Lg" ? SgSize.Lg : SgSize.Md)"
                                            Animation="@_constructorAnimated" />
                            </div>
                        </SgStack>

                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                    Generated Code
                                </SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                    <span id="copy-icon">@_copyIcon</span>
                                    <span id="copy-text" style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                </button>
                            </div>
                            <div class="code-block" id="code-block">
                                @foreach (var line in _generatedCode)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>
                    </SgStack>
                </SgCol>
            </SgRow>
        </SgCard>
    </div>

    </ChildContent>
</SgCard>

