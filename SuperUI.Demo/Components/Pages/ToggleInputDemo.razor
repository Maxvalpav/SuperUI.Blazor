@page "/toggle-input-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models
@using SuperUI.Enums

<PageTitle>Toggle Input — SUI</PageTitle>

<SgCard Title="Переключатели и выбор"
        Subtitle="SgCheckBox, SgSwitch, SgRadioGroup, SgFileUpload."
        CssClass="sgc-card-flush">

    @* ── SgCheckBox ───────────────────────────────────────────────── *@
    <div class="sgc-demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading2">SgCheckBox</SgTypography>
            <span class="demo-live-badge">Интерактивный</span>
        </div>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" CssClass="demo-section-desc">Компонент для выбора одного или нескольких вариантов из списка.</SgTypography>

        <div class="demo-grid-adaptive">
            <SgCard Title="Примеры использования" CssClass="demo-interactive-card">
                <div class="demo-flex-col">
                    <SgCheckBox @bind-Value="@_check1" Label="Согласен с условиями" />
                    <SgCheckBox @bind-Value="@_check2" Label="Отключенный флажок" Disabled="true" />
                    <SgCheckBox @bind-Value="@_check3" Label="Выбранный флажок" />
                    <SgCheckBox @bind-Value="@_check4" Label="Маленький размер" Size="SgSize.Sm" />
                    <SgCheckBox @bind-Value="@_check5" Label="Большой размер" Size="SgSize.Lg" />
                    <SgCheckBox @bind-Value="@_check6" Label="Зелёный цвет" CheckColor="SgColor.Success" />
                    <SgCheckBox @bind-Value="@_check7" Label="Только чтение" ReadOnly="true" />
                    <SgCheckBox @bind-Value="@_check8" Label="Без анимации" Animation="false" />
                    <div class="demo-value-display">
                        <span class="demo-value-display-label">Состояние</span>
                        <span class="demo-value-display-value">@(_check1 ? "✓ Согласен" : "✗ Не согласен")</span>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_checkBoxProperties" />
            </SgCard>
        </div>
    </div>

    @* ── SgSwitch ─────────────────────────────────────────────────── *@
    <div class="sgc-demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading2">SgSwitch</SgTypography>
            <span class="demo-live-badge">Интерактивный</span>
        </div>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" CssClass="demo-section-desc">Компонент для включения/отключения функций с визуальной обратной связью.</SgTypography>

        <div class="demo-grid-adaptive">
            <SgCard Title="Примеры использования" CssClass="demo-interactive-card">
                <div class="demo-flex-col">
                    <div class="demo-flex-between">
                        <SgTypography>Включить уведомления</SgTypography>
                        <SgSwitch @bind-Value="@_switch1" />
                    </div>
                    <div class="demo-flex-between">
                        <SgTypography>Тёмная тема</SgTypography>
                        <SgSwitch @bind-Value="@_switch2" />
                    </div>
                    <div class="demo-flex-between">
                        <SgTypography>Отключённый переключатель</SgTypography>
                        <SgSwitch @bind-Value="@_switch3" Disabled="true" />
                    </div>
                    <div class="demo-flex-between">
                        <SgTypography>Цветной (зелёный)</SgTypography>
                        <SgSwitch @bind-Value="@_switch4" SwitchColor="SgColor.Success" />
                    </div>
                    <div class="demo-flex-between">
                        <SgTypography>Цветной (красный)</SgTypography>
                        <SgSwitch @bind-Value="@_switch5" SwitchColor="SgColor.Danger" />
                    </div>
                    <div class="demo-flex-between">
                        <SgTypography>Размер XL</SgTypography>
                        <SgSwitch @bind-Value="@_switch6" Size="SgSize.Xl" />
                    </div>
                    <div class="demo-flex-between">
                        <SgTypography>Только чтение</SgTypography>
                        <SgSwitch @bind-Value="@_switch7" ReadOnly="true" />
                    </div>
                    <div class="demo-flex-between">
                        <SgTypography>Загрузка</SgTypography>
                        <SgSwitch @bind-Value="@_switch8" Loading="true" />
                    </div>
                    <SgDivider />
                    <div class="demo-flex-row">
                        <SgBadge Text="@(_switch1 ? "Уведомления включены" : "Уведомления отключены")"
                                 Variant="@(_switch1 ? SgBadgeVariant.Info : SgBadgeVariant.Muted)" />
                        <SgBadge Text="@(_switch2 ? "Тёмная тема" : "Светлая тема")"
                                 Variant="@(_switch2 ? SgBadgeVariant.Info : SgBadgeVariant.Muted)" />
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_switchProperties" />
            </SgCard>
        </div>
    </div>

    @* ── SgRadioGroup ─────────────────────────────────────────────── *@
    <div class="sgc-demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading2">SgRadioGroup</SgTypography>
            <span class="demo-live-badge">Интерактивный</span>
        </div>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" CssClass="demo-section-desc">Компонент для выбора одного значения из группы переключателей.</SgTypography>

        <div class="demo-grid-adaptive">
            <SgCard Title="Примеры использования" CssClass="demo-interactive-card">
                <div class="demo-flex-col">
                    <SgRadioGroup TValue="string" @bind-Value="@_radioValue" Options="@_radioOptions" Label="Выберите вариант" />
                    <div class="demo-value-display">
                        <span class="demo-value-display-label">Выбрано</span>
                        <span class="demo-value-display-value">@(_radioValue ?? "—")</span>
                    </div>
                    <SgRadioGroup TValue="string" @bind-Value="@_radioValue2" Options="@_radioOptionsDisabled" Label="С отключёнными вариантами" />
                    <SgRadioGroup TValue="string" @bind-Value="@_radioValue3" Options="@_radioOptions" Label="Маленький размер" Size="SgSize.Sm" />
                    <SgRadioGroup TValue="string" @bind-Value="@_radioValue4" Options="@_radioOptions" Label="Зелёный цвет" RadioColor="SgColor.Success" />
                    <SgRadioGroup TValue="string" @bind-Value="@_radioValue5" Options="@_radioOptions" Label="Только чтение" ReadOnly="true" />
                    <SgRadioGroup TValue="string" @bind-Value="@_radioValue6" Options="@_radioOptions" Label="С ошибкой" ErrorText="Пожалуйста, выберите вариант" />
                    <SgRadioGroup TValue="string" @bind-Value="@_radioValue7" ItemsSource="@_radioItems" OptionLabelSelector="@(x => x)" Label="Привязка через ItemsSource" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_radioGroupProperties" />
            </SgCard>
        </div>
    </div>

    @* ── SgFileUpload ─────────────────────────────────────────────── *@
    <div class="sgc-demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading2">SgFileUpload</SgTypography>
            <span class="demo-live-badge">Drag & Drop</span>
        </div>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" CssClass="demo-section-desc">Компонент для выбора и загрузки файлов.</SgTypography>

        <div class="demo-grid-adaptive">
            <SgCard Title="Примеры использования" CssClass="demo-interactive-card">
                <div class="demo-flex-col">
                    <SgFileUpload Label="Загрузить файл" Hint="Поддерживаются любые форматы" />
                    <SgFileUpload Label="Только изображения" Accept="image/*" Multiple="true" Hint="PNG, JPG, GIF" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_fileUploadProperties" />
            </SgCard>
        </div>
    </div>

</SgCard>

<style>
    .sgc-card-flush > .sgc-card-body {
        padding: 0 24px 24px;
    }
    @@media (max-width: 640px) {
        .sgc-card-flush > .sgc-card-body {
            padding: 0 12px 12px;
        }
    }
</style>

