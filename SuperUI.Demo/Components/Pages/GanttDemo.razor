@page "/gantt"
@using SuperUI.Components

<PageTitle>Диаграмма Ганта - SUI</PageTitle>
<SgSeoHead Description="Компонент для визуализации и управления проектами с помощью диаграммы Ганта. Поддерживает зависимости между задачами, вехи, различные режимы отображения и управление сроками." />

<SgCard Title="SgGantt - Диаграмма Ганта" 
        Subtitle="Компонент для визуализации и управления проектами с помощью диаграммы Ганта. Поддерживает зависимости между задачами, вехи, различные режимы отображения и управление сроками.">
    
    <!-- 1. Основная диаграмма Ганта -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">1. Интерактивная диаграмма Ганта</SgTypography>
        <p>Диаграмма Ганта для управления сроками и зависимостями задач проекта.</p>
        
        <SgCard Title="Диаграмма проекта" Style="margin-top: 16px;">
            <div style="height: 500px; border: 1px solid var(--sui-border); border-radius: 4px; overflow: auto;">
                <SgGantt @bind-Tasks="_tasks" DayWidth="40" />
            </div>
        </SgCard>
    </div>

    <!-- 2. Диаграмма с разными масштабами -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">2. Диаграмма с разными масштабами</SgTypography>
        <p>Диаграмма Ганта с возможностью изменения масштаба отображения (ширина дня).</p>
        
        <SgCard Title="Диаграмма с масштабом 60px" Style="margin-top: 16px;">
            <div style="height: 500px; border: 1px solid var(--sui-border); border-radius: 4px; overflow: auto;">
                <SgGantt @bind-Tasks="_tasks" DayWidth="60" />
            </div>
        </SgCard>
    </div>

    <!-- 3. Статистика проекта -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">3. Статистика проекта</SgTypography>
        <p>Обзор текущего состояния задач и прогресса проекта.</p>
        
        <SgCard Title="Статистика проекта" Style="margin-top: 16px;">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px;">
                <div style="padding: 16px; background: var(--sui-bg-secondary); border-radius: 8px;">
                    <div style="font-size: 12px; color: var(--sui-text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Всего задач</div>
                    <div style="font-size: 24px; font-weight: 700; margin-top: 4px;">@_tasks.Count</div>
                </div>
                <div style="padding: 16px; background: var(--sui-bg-secondary); border-radius: 8px;">
                    <div style="font-size: 12px; color: var(--sui-text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Завершено</div>
                    <div style="font-size: 24px; font-weight: 700; margin-top: 4px; color: #52c41a;">@_tasks.Count(t => t.Progress == 1.0)</div>
                </div>
                <div style="padding: 16px; background: var(--sui-bg-secondary); border-radius: 8px;">
                    <div style="font-size: 12px; color: var(--sui-text-muted); text-transform: uppercase; letter-spacing: 0.5px;">В работе</div>
                    <div style="font-size: 24px; font-weight: 700; margin-top: 4px; color: #faad14;">@_tasks.Count(t => t.Progress > 0 && t.Progress < 1.0)</div>
                </div>
                <div style="padding: 16px; background: var(--sui-bg-secondary); border-radius: 8px;">
                    <div style="font-size: 12px; color: var(--sui-text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Не начато</div>
                    <div style="font-size: 24px; font-weight: 700; margin-top: 4px; color: #f5222d;">@_tasks.Count(t => t.Progress == 0)</div>
                </div>
                <div style="padding: 16px; background: var(--sui-bg-secondary); border-radius: 8px;">
                    <div style="font-size: 12px; color: var(--sui-text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Средний прогресс</div>
                    <div style="font-size: 24px; font-weight: 700; margin-top: 4px;">@(_tasks.Count > 0 ? (_tasks.Average(t => t.Progress) * 100).ToString("F0") : "0")%</div>
                </div>
            </div>
        </SgCard>
    </div>

    <!-- 4. Параметры компонента -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">4. Параметры компонента</SgTypography>
        <p>Полный список параметров SgGantt для настройки поведения и внешнего вида.</p>
        
        <SgCard Title="Основные параметры" Style="margin-top: 16px;">
            <PropertyTable Items="_mainProperties" />
        </SgCard>

        <SgCard Title="События и обработчики" Style="margin-top: 16px;">
            <PropertyTable Items="_eventProperties" />
        </SgCard>
    </div>

    <!-- 5. Структура данных -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">5. Структура данных</SgTypography>
        <p>Описание структуры объекта SgGanttTask.</p>
        
        <SgCard Title="SgGanttTask" Style="margin-top: 16px;">
            <PropertyTable Items="_taskProperties" />
        </SgCard>
    </div>
</SgCard>

@code {
    private List<SgGanttTask> _tasks = new()
    {
        new SgGanttTask { Id = "1", Name = "Планирование",  Start = DateTime.Today.AddDays(-10), End = DateTime.Today.AddDays(-5),  Progress = 1.0,  Dependencies = new() },
        new SgGanttTask { Id = "2", Name = "Дизайн",        Start = DateTime.Today.AddDays(-5),  End = DateTime.Today,              Progress = 1.0,  Dependencies = new() { "1" } },
        new SgGanttTask { Id = "3", Name = "Разработка",    Start = DateTime.Today,              End = DateTime.Today.AddDays(10),  Progress = 0.75, Dependencies = new() { "2" } },
        new SgGanttTask { Id = "4", Name = "Тестирование",  Start = DateTime.Today.AddDays(8),   End = DateTime.Today.AddDays(15),  Progress = 0.25, Dependencies = new() { "3" } },
        new SgGanttTask { Id = "5", Name = "Развертывание", Start = DateTime.Today.AddDays(15),  End = DateTime.Today.AddDays(18),  Progress = 0.0,  Dependencies = new() { "4" } }
    };

    private List<PropertyPanelItem> _mainProperties = new()
    {
        new() { Label = "Tasks", Value = "List<SgGanttTask>", BadgeText = "Задачи", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "DayWidth", Value = "int", BadgeText = "Ширина дня", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "CssClass", Value = "string", BadgeText = "CSS класс", BadgeVariant = SgBadgeVariant.Info }
    };

    private List<PropertyPanelItem> _eventProperties = new()
    {
        new() { Label = "TasksChanged", Value = "EventCallback<List<SgGanttTask>>", BadgeText = "Изменение", BadgeVariant = SgBadgeVariant.Success }
    };

    private List<PropertyPanelItem> _taskProperties = new()
    {
        new() { Label = "Id", Value = "string", BadgeText = "Уникальный ID", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Name", Value = "string", BadgeText = "Название", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Start", Value = "DateTime", BadgeText = "Дата начала", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "End", Value = "DateTime", BadgeText = "Дата окончания", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Progress", Value = "double", BadgeText = "Прогресс (0-1)", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Dependencies", Value = "List<string>", BadgeText = "Зависимости", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "IsMilestone", Value = "bool", BadgeText = "Веха", BadgeVariant = SgBadgeVariant.Warn }
    };
}

