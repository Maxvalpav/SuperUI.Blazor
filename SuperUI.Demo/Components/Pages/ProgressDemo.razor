                    <SgProgress Value="45" Title="Downloading..." SubLabel="3.2 MB / 15 MB" Size="SgSize.Lg" Variant="SgSpinnerVariant.Info" />
                    <SgProgress Value="72" Title="Processing video" SubLabel="Step 4 of 7 — Encoding" Size="SgSize.Lg" Variant="SgSpinnerVariant.Success" Striped="true" Animated="true" />
                    <SgProgress Value="88" Title="Installing updates" SubLabel="12 of 15 packages" Size="SgSize.Lg" Variant="SgSpinnerVariant.Warn" Marker="true" />
                </SgStack>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 14. Error, Complete Icons & Bar Caps                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgProgress — Error, Complete Icons & Bar Caps
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Error state with shake animation, custom complete/error icons, and square or rounded bar caps.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Error & Complete" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgProgress Value="63" Variant="SgSpinnerVariant.Danger" Title="Upload failed" Error="true" Size="SgSize.Lg"
                                ErrorIcon="@RenderIcon(SgHeroicons.Outline.XMark)" />
