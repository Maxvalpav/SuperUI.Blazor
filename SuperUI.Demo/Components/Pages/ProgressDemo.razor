@page "/progress-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>SgProgress — Progress Indicators — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Progress Indicators"
                        Subtitle="SgProgress — Linear, circular, segmented, vertical, and indeterminate progress bars with gradients, glow, animated stripes, and custom colors."
                        Icon="@SgHeroicons.Outline.ChartBar" />
    </HeaderContent>
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Linear Progress                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgProgress — Linear Progress
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Universal progress indicator with support for multiple sizes, color variants, and special effects like gradients, glow, and animated stripes.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Layout Variants" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Sizes
                        </SgTypography>
                        <div style="display:flex;flex-direction:column;gap:12px;">
                            <SgProgress Value="40" Size="SgSize.Sm" Title="Small (Sm)" />
                            <SgProgress Value="55" Size="SgSize.Md" Title="Medium (Md)" />
                            <SgProgress Value="70" Size="SgSize.Lg" Title="Large (Lg)" />
                            <SgProgress Value="85" Size="SgSize.Xl" Title="Extra Large (Xl)" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Color Variants
                        </SgTypography>
                        <div style="display:flex;flex-direction:column;gap:12px;">
                            <SgProgress Value="50" Variant="SgSpinnerVariant.Default" Title="Default" />
                            <SgProgress Value="60" Variant="SgSpinnerVariant.Info" Title="Info" />
                            <SgProgress Value="70" Variant="SgSpinnerVariant.Success" Title="Success" />
                            <SgProgress Value="80" Variant="SgSpinnerVariant.Warn" Title="Warning" />
                            <SgProgress Value="90" Variant="SgSpinnerVariant.Danger" Title="Danger" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Special Effects
                        </SgTypography>
                        <div style="display:flex;flex-direction:column;gap:12px;">
                            <SgProgress Value="75" Gradient="true" Variant="SgSpinnerVariant.Info" Title="Gradient" Size="SgSize.Lg" />
                            <SgProgress Value="65" Glow="true" Variant="SgSpinnerVariant.Success" Title="Glow" Size="SgSize.Lg" />
                            <SgProgress Value="70" Striped="true" Animated="true" Variant="SgSpinnerVariant.Warn" Title="Striped + Animated" Size="SgSize.Lg" />
                        </div>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Linear Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_progressProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Circular Progress                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgProgress — Circular Progress
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Compact circular progress ideal for dashboards, cards, and widget panels.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Variants & Sizes" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Sizes
                        </SgTypography>
                        <div style="display:flex;gap:24px;align-items:center;justify-content:center;padding:20px;">
                            <div style="text-align:center;">
                                <SgProgress Value="37" Circular="true" Size="SgSize.Sm" />
                                <div style="font-size:11px;color:var(--sg-text-muted);margin-top:8px;">Sm</div>
                            </div>
                            <div style="text-align:center;">
                                <SgProgress Value="52" Circular="true" Size="SgSize.Md" />
                                <div style="font-size:11px;color:var(--sg-text-muted);margin-top:8px;">Md</div>
                            </div>
                            <div style="text-align:center;">
                                <SgProgress Value="68" Circular="true" Size="SgSize.Lg" />
                                <div style="font-size:11px;color:var(--sg-text-muted);margin-top:8px;">Lg</div>
                            </div>
                            <div style="text-align:center;">
                                <SgProgress Value="83" Circular="true" Size="SgSize.Xl" />
                                <div style="font-size:11px;color:var(--sg-text-muted);margin-top:8px;">Xl</div>
                            </div>
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Colors
                        </SgTypography>
                        <div style="display:flex;gap:20px;align-items:center;justify-content:center;padding:20px;flex-wrap:wrap;">
                            <SgProgress Value="30" Circular="true" Variant="SgSpinnerVariant.Default" />
                            <SgProgress Value="45" Circular="true" Variant="SgSpinnerVariant.Info" />
                            <SgProgress Value="60" Circular="true" Variant="SgSpinnerVariant.Success" />
                            <SgProgress Value="75" Circular="true" Variant="SgSpinnerVariant.Warn" />
                            <SgProgress Value="90" Circular="true" Variant="SgSpinnerVariant.Danger" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With Effects
                        </SgTypography>
                        <div style="display:flex;gap:32px;align-items:center;justify-content:center;padding:20px;">
                            <SgProgress Value="65" Circular="true" Size="SgSize.Lg" Gradient="true" Variant="SgSpinnerVariant.Info" />
                            <SgProgress Value="82" Circular="true" Size="SgSize.Lg" Glow="true" Variant="SgSpinnerVariant.Success" />
                            <SgProgress Value="45" Circular="true" Size="SgSize.Lg" Gradient="true" Glow="true" Variant="SgSpinnerVariant.Danger" />
                        </div>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Circular Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_circularProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Segmented Progress                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgProgress — Segmented Progress
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Split a progress bar into discrete segments to visualize milestones, steps, or phases.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgProgress Value="60" Segmented="true" Segments="5" Variant="SgSpinnerVariant.Success" Title="5 Segments" />
                    <SgProgress Value="75" Segmented="true" Segments="10" Variant="SgSpinnerVariant.Info" Title="10 Segments" />
                    <SgProgress Value="85" Segmented="true" Segments="20" Variant="SgSpinnerVariant.Warn" Title="20 Segments" />
                </SgStack>
            </SgCard>

            <SgCard Title="Segmented Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_segmentedProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Buffer / Streaming                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgProgress — Buffer & Streaming
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Display buffer progress for video, audio, and streaming data with animated transitions.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgProgress Value="@_videoProgress" BufferValue="@_videoBuffer" Title="Video Playback" Size="SgSize.Lg" Variant="SgSpinnerVariant.Info" />
                    <SgProgress Value="@_audioProgress" BufferValue="@_audioBuffer" Title="Audio Track" Size="SgSize.Md" Variant="SgSpinnerVariant.Success" Gradient="true" />
                    <SgDivider />
                    <SgProgress Value="@_downloadProgress" BufferValue="@_downloadBuffer" Title="File Download (125 MB)" Size="SgSize.Lg" Variant="SgSpinnerVariant.Warn" Glow="true" />
                    <div style="display:flex;gap:12px;">
                        <SgButton OnClick="StartDownload" Size="SgSize.Sm" Variant="SgButtonVariant.Primary" Text="Start Download" />
                        <SgButton OnClick="StopDownload" Size="SgSize.Sm" Variant="SgButtonVariant.Default" Text="Stop" />
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Buffer Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_bufferProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Indeterminate                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgProgress — Indeterminate Loading
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Use when progress cannot be measured or the duration is unknown — linear and circular variants.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Linear
                        </SgTypography>
                        <div style="display:flex;flex-direction:column;gap:12px;">
                            <SgProgress Indeterminate="true" Title="Loading data..." Size="SgSize.Md" Variant="SgSpinnerVariant.Info" />
                            <SgProgress Indeterminate="true" Title="Processing request..." Size="SgSize.Lg" Variant="SgSpinnerVariant.Success" Gradient="true" />
                            <SgProgress Indeterminate="true" Title="Syncing..." Size="SgSize.Md" Variant="SgSpinnerVariant.Warn" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Circular
                        </SgTypography>
                        <div style="display:flex;gap:32px;align-items:center;justify-content:center;padding:20px;">
                            <div style="text-align:center;">
                                <SgProgress Indeterminate="true" Circular="true" Size="SgSize.Md" Variant="SgSpinnerVariant.Info" />
                                <div style="font-size:12px;color:var(--sg-text-muted);margin-top:8px;">Loading...</div>
                            </div>
                            <div style="text-align:center;">
                                <SgProgress Indeterminate="true" Circular="true" Size="SgSize.Lg" Variant="SgSpinnerVariant.Success" Gradient="true" />
                                <div style="font-size:12px;color:var(--sg-text-muted);margin-top:8px;">Processing...</div>
                            </div>
                            <div style="text-align:center;">
                                <SgProgress Indeterminate="true" Circular="true" Size="SgSize.Xl" Variant="SgSpinnerVariant.Danger" Glow="true" />
                                <div style="font-size:12px;color:var(--sg-text-muted);margin-top:8px;">Waiting...</div>
                            </div>
                        </div>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Indeterminate Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_indeterminateProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. Vertical Progress                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgProgress — Vertical Orientation
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Vertical progress bars for sidebars, dashboards, and tall layouts — supports all effects.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <div style="display:flex;gap:32px;align-items:flex-end;justify-content:center;padding:40px 20px;">
                    <div style="text-align:center;">
                        <SgProgress Value="30" Vertical="true" Size="SgSize.Sm" Variant="SgSpinnerVariant.Default" />
                        <div style="font-size:11px;color:var(--sg-text-muted);margin-top:8px;">30%</div>
                    </div>
                    <div style="text-align:center;">
                        <SgProgress Value="50" Vertical="true" Size="SgSize.Md" Variant="SgSpinnerVariant.Info" Gradient="true" />
                        <div style="font-size:11px;color:var(--sg-text-muted);margin-top:8px;">50%</div>
                    </div>
                    <div style="text-align:center;">
                        <SgProgress Value="70" Vertical="true" Size="SgSize.Lg" Variant="SgSpinnerVariant.Success" Glow="true" />
                        <div style="font-size:11px;color:var(--sg-text-muted);margin-top:8px;">70%</div>
                    </div>
                    <div style="text-align:center;">
                        <SgProgress Value="90" Vertical="true" Size="SgSize.Xl" Variant="SgSpinnerVariant.Warn" Gradient="true" Glow="true" />
                        <div style="font-size:11px;color:var(--sg-text-muted);margin-top:8px;">90%</div>
                    </div>
                    <div style="text-align:center;">
                        <SgProgress Value="100" Vertical="true" Size="SgSize.Lg" Variant="SgSpinnerVariant.Danger" Striped="true" Animated="true" />
                        <div style="font-size:11px;color:var(--sg-text-muted);margin-top:8px;">100%</div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Vertical Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_verticalProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 7. Marker                                                            -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgProgress — Marker
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                A polished diamond marker at the bar's leading edge adds a modern, interactive look.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Marker Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgProgress Value="45" Marker="true" Variant="SgSpinnerVariant.Info" Title="Downloading..." Size="SgSize.Lg" Gradient="true" />
                    <SgProgress Value="72" Marker="true" Variant="SgSpinnerVariant.Success" Title="Processing..." Size="SgSize.Lg" />
                    <SgProgress Value="88" Marker="true" Variant="SgSpinnerVariant.Warn" Title="Almost done..." Size="SgSize.Lg" Striped="true" Animated="true" />
                </SgStack>
            </SgCard>

            <SgCard Title="New Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_markerProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 8. Multi-Bar Progress                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgProgress — Multi-Bar & Steps
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Stack multiple progress bars or use step indicators for wizard-style flows.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Multi-Bar Progress" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgProgress Values="@_multiBarValues"
                                Labels='new[] { "CPU", "RAM", "Disk", "Network" }'
                                Colors='new[] { "#3b82f6", "#10b981", "#f59e0b", "#ef4444" }'
                                Title="System Resources"
                                Size="SgSize.Md" />
                </SgStack>
            </SgCard>
            <SgCard Title="Step Progress (Wizard)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgProgress Steps="@_wizardSteps" Size="SgSize.Md" Variant="SgSpinnerVariant.Info" />
                    <SgSpace>
                        <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Primary" OnClick="PrevStep" Disabled="_currentStep == 0">
                            @((MarkupString)SgHeroicons.Outline.ChevronLeft)
                            <span>Prev</span>
                        </SgButton>
                        <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Primary" OnClick="NextStep" Disabled="_currentStep >= _wizardSteps.Count - 1">
                            <span>Next</span>
                            @((MarkupString)SgHeroicons.Outline.ChevronRight)
                        </SgButton>
                    </SgSpace>
                </SgStack>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 9. Confetti Animation                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgProgress — Confetti Celebration
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Celebrate completion with a confetti burst. Click the button to simulate reaching 100%.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Confetti on Complete" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgProgress Value="@_confettiValue"
                                Variant="SgSpinnerVariant.Info"
                                Gradient="true"
                                Glow="true"
                                Confetti="true"
                                Title="Processing..."
                                Size="SgSize.Lg"
                                Marker="true" />
                    <SgSpace>
                        <SgButton Variant="SgButtonVariant.Primary" OnClick="StartConfetti">
                            @((MarkupString)SgHeroicons.Outline.Sparkles)
                            <span>Complete!</span>
                        </SgButton>
                        <SgButton Variant="SgButtonVariant.Ghost" OnClick="ResetConfetti">
                            @((MarkupString)SgHeroicons.Outline.ArrowPath)
                            <span>Reset</span>
                        </SgButton>
                    </SgSpace>
                </SgStack>
            </SgCard>
            <SgCard Title="Confetti Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_confettiProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 10. Custom Colors                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgProgress — Custom Colors
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Override the default color palette with any custom color using HEX, RGB, or CSS color values.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Linear Custom Colors
                        </SgTypography>
                        <div style="display:flex;flex-direction:column;gap:12px;">
                            <SgProgress Value="65" Color="#9333ea" Title="Purple (#9333ea)" Size="SgSize.Lg" />
                            <SgProgress Value="75" Color="#ec4899" Title="Pink (#ec4899)" Size="SgSize.Lg" Glow="true" />
                            <SgProgress Value="85" Color="#14b8a6" Title="Teal (#14b8a6)" Size="SgSize.Lg" Striped="true" Animated="true" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Circular Custom Colors
                        </SgTypography>
                        <div style="display:flex;gap:24px;align-items:center;justify-content:center;padding:20px;">
                            <SgProgress Value="60" Circular="true" Color="#9333ea" Size="SgSize.Lg" />
                            <SgProgress Value="75" Circular="true" Color="#ec4899" Size="SgSize.Lg" Glow="true" />
                            <SgProgress Value="90" Circular="true" Color="#14b8a6" Size="SgSize.Lg" Glow="true" />
                        </div>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Custom Color Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_colorProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 11. Sticky Top (Page Load Indicator)                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgProgress — Sticky Top (Page Load Indicator)
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                A thin progress bar fixed to the top of the viewport — ideal for simulating page-level loading (like YouTube, GitHub).
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Example" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div style="padding:20px;text-align:center;">
                        <SgButton OnClick="SimulatePageLoad"
                                 Variant="SgButtonVariant.Primary"
                                 Size="SgSize.Lg">
                            <SgSpace>
                                @((MarkupString)SgHeroicons.Outline.ArrowPathRoundedSquare)
                                <span>Simulate Page Load</span>
                            </SgSpace>
                        </SgButton>
                    </div>
                    <SgDivider />
                    <div style="padding:12px;background:var(--sg-surface-alt);border-radius:6px;">
                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                            @((MarkupString)SgHeroicons.Outline.LightBulb)
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                                Clicking the button displays a thin progress strip fixed at the very top of the page, mimicking the behavior of YouTube or GitHub page load indicators.
                            </SgTypography>
                        </SgStack>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Current State</SgTypography>
                        <div style="padding:12px;background:var(--sg-surface-alt);border-radius:6px;font-family:monospace;font-size:12px;">
                            <div>Shown: <strong>@(_showStickyProgress ? "Yes" : "No")</strong></div>
                            @if (_showStickyProgress)
                            {
                                <div style="margin-top:4px;">Progress: <strong>@($"{_stickyProgress:F0}%")</strong></div>
                            }
                        </div>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Sticky Top Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_stickyProperties" />
                <div style="margin-top:16px;">
                    <div style="padding:12px;background:var(--sg-surface-alt);border-radius:6px;">
                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Start">
                            @((MarkupString)SgHeroicons.Outline.InformationCircle)
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                                StickyTop uses <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">position: fixed</SgTypography>. Typically used with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Size="SgSize.Sm"</SgTypography> and <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ShowLabel="false"</SgTypography> for a minimal, elegant indicator.
                            </SgTypography>
                        </SgStack>
                    </div>
                </div>
            </SgCard>
        </div>
    </div>

    @if (_showStickyProgress)
    {
        <SgProgress Value="@_stickyProgress"
                   StickyTop="true"
                   Size="SgSize.Sm"
                   Variant="SgSpinnerVariant.Info"
                   Gradient="true"
                   ShowLabel="false" />
    }

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 12. Indeterminate Styles & Direction                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgProgress — Indeterminate Styles & Direction
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Choose from four indeterminate animation styles and control circular progress direction.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Indeterminate Styles" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgProgress Indeterminate="true" IndeterminateStyle="SgIndeterminateStyle.Shimmer" Title="Shimmer (default)" Size="SgSize.Md" Variant="SgSpinnerVariant.Info" />
                    <SgProgress Indeterminate="true" IndeterminateStyle="SgIndeterminateStyle.Dots" Title="Dots" Size="SgSize.Md" Variant="SgSpinnerVariant.Success" />
                    <SgProgress Indeterminate="true" IndeterminateStyle="SgIndeterminateStyle.Pulsing" Title="Pulsing" Size="SgSize.Md" Variant="SgSpinnerVariant.Warn" />
                    <SgProgress Indeterminate="true" IndeterminateStyle="SgIndeterminateStyle.Sweeping" Title="Sweeping" Size="SgSize.Md" Variant="SgSpinnerVariant.Danger" />
                </SgStack>
            </SgCard>
            <SgCard Title="Circular Direction" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div style="display:flex;gap:32px;align-items:center;justify-content:center;padding:20px;">
                        <div style="text-align:center;">
                            <SgProgress Value="65" Circular="true" Size="SgSize.Lg" Variant="SgSpinnerVariant.Info" />
                            <div style="font-size:12px;color:var(--sg-text-muted);margin-top:8px;">Clockwise</div>
                        </div>
                        <div style="text-align:center;">
                            <SgProgress Value="65" Circular="true" Size="SgSize.Lg" Variant="SgSpinnerVariant.Success" CounterClockwise="true" />
                            <div style="font-size:12px;color:var(--sg-text-muted);margin-top:8px;">Counter-Clockwise</div>
                        </div>
                    </div>
                </SgStack>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 13. Auto Progress & SubLabel                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgProgress — Auto Progress & Detail
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Built-in timer-driven auto-advance and additional detail text below the bar.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Auto Progress" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgProgress AutoStart="true" AutoSpeed="0.3" Title="Auto-advancing (0.3/tick)" Size="SgSize.Lg" Variant="SgSpinnerVariant.Info" Marker="true" />
                    <SgProgress AutoStart="true" AutoSpeed="1.2" Title="Faster (1.2/tick)" Size="SgSize.Lg" Variant="SgSpinnerVariant.Success" Glow="true" />
                    <SgProgress AutoStart="true" AutoSpeed="0.5" Title="Circular auto" Circular="true" Size="SgSize.Lg" Variant="SgSpinnerVariant.Warn" />
                </SgStack>
