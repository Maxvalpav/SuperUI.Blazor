@code {
    // ═══════════════════════════════════════════════════════════════════════════
    //                              MAIN CARD HEADER
    // ═══════════════════════════════════════════════════════════════════════════



    // ═══════════════════════════════════════════════════════════════════════════
    //                              BUFFER / STREAMING STATE
    // ═══════════════════════════════════════════════════════════════════════════

    private double _videoProgress = 45;
    private double _videoBuffer = 75;
    private double _audioProgress = 62;
    private double _audioBuffer = 88;
    private double _downloadProgress = 0;
    private double _downloadBuffer = 0;
    private Timer? _bufferTimer;
    private Timer? _downloadTimer;

    // ═══════════════════════════════════════════════════════════════════════════
    //                              STICKY TOP STATE
    // ═══════════════════════════════════════════════════════════════════════════

    private bool _showStickyProgress = false;
    private double _stickyProgress = 0;
    private Timer? _stickyTimer;

    // ═══════════════════════════════════════════════════════════════════════════
    //                              MARKER STATE
    // ═══════════════════════════════════════════════════════════════════════════

    // (Marker is a pure parameter — no run-time state needed)

    // ═══════════════════════════════════════════════════════════════════════════
    //                              MULTI-BAR & STEPS STATE
    // ═══════════════════════════════════════════════════════════════════════════

    private readonly double[] _multiBarValues = { 78, 45, 92, 33 };
    private int _currentStep = 2;
    private List<SgProgressStep> _wizardSteps = new();

    // ═══════════════════════════════════════════════════════════════════════════
    //                              CONFETTI STATE
    // ═══════════════════════════════════════════════════════════════════════════

    private double _confettiValue = 0;

    // ═══════════════════════════════════════════════════════════════════════════
    //                              OVERLAP & THUMB STATE
    // ═══════════════════════════════════════════════════════════════════════════

    private readonly double[] _overlapValues = { 70, 50, 35 };
    private double _thumbValue = 55;

    // ═══════════════════════════════════════════════════════════════════════════
    //                           CONSTRUCTOR STATE
    // ═══════════════════════════════════════════════════════════════════════════

    private SgSize _ctorSize = SgSize.Lg;
    private SgSpinnerVariant _ctorVariant = SgSpinnerVariant.Info;
    private double _ctorValue = 65;
    private bool _ctorGradient;
    private bool _ctorGlow;
    private bool _ctorStriped;
    private bool _ctorAnimated;
    private bool _ctorCircular;
    private bool _ctorVertical;
    private bool _ctorShowLabel = true;
    private bool _ctorShowAnimation;
    private bool _ctorMarker;
    private bool _ctorConfetti;
    private bool _ctorGlass;
    private bool _ctorNeon;
    private bool _ctorError;
    private bool _ctorThumb;

    private string[] _ctorCodeLines = Array.Empty<string>();
    private string _copyIcon = "📋";
    private string _copyLabel = "Copy";

    // ═══════════════════════════════════════════════════════════════════════════
    //                              LIFECYCLE
    // ═══════════════════════════════════════════════════════════════════════════

    protected override void OnInitialized()
    {
        _bufferTimer = new Timer(_ =>
        {
            _ = InvokeAsync(() =>
            {
                _videoProgress = Math.Min(100, _videoProgress + Random.Shared.Next(1, 3));
                _videoBuffer = Math.Min(100, _videoProgress + Random.Shared.Next(10, 25));
                _audioProgress = Math.Min(100, _audioProgress + Random.Shared.Next(1, 4));
                _audioBuffer = Math.Min(100, _audioProgress + Random.Shared.Next(15, 30));
                if (_videoProgress >= 100) _videoProgress = 0;
                if (_audioProgress >= 100) _audioProgress = 0;
                StateHasChanged();
            });
        }, null, TimeSpan.FromMilliseconds(500), TimeSpan.FromMilliseconds(500));

        _wizardSteps = new List<SgProgressStep>
        {
            new() { Label = "Plan", Description = "Requirements", Completed = true },
            new() { Label = "Design", Description = "Architecture", Completed = true },
            new() { Label = "Develop", Description = "Implementation", Active = true },
            new() { Label = "Test", Description = "QA", Completed = false },
            new() { Label = "Deploy", Description = "Production", Completed = false },
        };

        UpdateCtorCode();
    }

    public void Dispose()
    {
        _bufferTimer?.Dispose();
        _downloadTimer?.Dispose();
        _stickyTimer?.Dispose();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //                              METHODS
    // ═══════════════════════════════════════════════════════════════════════════

    private void OnCtorValueChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var val))
        {
            _ctorValue = val;
            UpdateCtorCode();
        }
    }

    private void StartDownload()
    {
        _downloadProgress = 0;
        _downloadBuffer = 0;
        _downloadTimer?.Dispose();
        _downloadTimer = new Timer(_ =>
        {
            InvokeAsync(() =>
            {
                if (_downloadProgress < 100)
                {
                    _downloadProgress = Math.Min(100, _downloadProgress + Random.Shared.Next(2, 8));
                    _downloadBuffer = Math.Min(100, _downloadProgress + Random.Shared.Next(5, 15));
                    StateHasChanged();
                }
                else
                {
                    _downloadTimer?.Dispose();
                }
            });
        }, null, TimeSpan.FromMilliseconds(200), TimeSpan.FromMilliseconds(200));
    }

    private void StopDownload()
    {
        _downloadTimer?.Dispose();
    }

    private async void SimulatePageLoad()
    {
        _showStickyProgress = true;
        _stickyProgress = 0;
        _stickyTimer?.Dispose();
        _stickyTimer = new Timer(_ =>
        {
            _ = InvokeAsync(() =>
            {
                try
                {
                    if (_stickyProgress < 100)
                    {
                        if (_stickyProgress < 30)
                            _stickyProgress += Random.Shared.Next(5, 15);
                        else if (_stickyProgress < 70)
                            _stickyProgress += Random.Shared.Next(2, 8);
                        else if (_stickyProgress < 90)
                            _stickyProgress += Random.Shared.Next(1, 4);
                        else
                            _stickyProgress += Random.Shared.Next(1, 3);
                        _stickyProgress = Math.Min(100, _stickyProgress);
                        StateHasChanged();
                    }
                    else
                    {
                        _stickyTimer?.Dispose();
                        _ = Task.Delay(500).ContinueWith(_ =>
                        {
                            _ = InvokeAsync(() =>
                            {
                                _showStickyProgress = false;
                                StateHasChanged();
                            });
                        });
                    }
                }
                catch (ObjectDisposedException) { }
            });
        }, null, TimeSpan.FromMilliseconds(150), TimeSpan.FromMilliseconds(150));
    }

    private void NextStep()
    {
        if (_currentStep >= _wizardSteps.Count - 1) return;
        _wizardSteps[_currentStep].Completed = true;
        _wizardSteps[_currentStep].Active = false;
        _currentStep++;
        _wizardSteps[_currentStep].Active = true;
    }

    private void PrevStep()
    {
        if (_currentStep <= 0) return;
        _wizardSteps[_currentStep].Active = false;
        _wizardSteps[_currentStep].Completed = false;
        _currentStep--;
        _wizardSteps[_currentStep].Active = true;
        _wizardSteps[_currentStep].Completed = true;
    }

    private async void StartConfetti()
    {
        _confettiValue = 0;
        StateHasChanged();
        await Task.Delay(50);
        for (int i = 0; i <= 100; i++)
        {
            _confettiValue = i;
            StateHasChanged();
            await Task.Delay(20);
        }
    }

    private void ResetConfetti()
    {
        _confettiValue = 0;
        StateHasChanged();
    }

    private void HandleThumbValue(double value)
    {
        _thumbValue = value;
        StateHasChanged();
    }

    private static RenderFragment RenderIcon(string svg) => b => b.AddMarkupContent(0, svg);

    private string GetCtorValueLabel() => $"{_ctorValue:F0}%";

    private string GetCtorModeLabel()
    {
        if (_ctorCircular) return "Circular";
        if (_ctorVertical) return "Vertical";
        return "Linear";
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //                         CONSTRUCTOR CODE GENERATION
    // ═══════════════════════════════════════════════════════════════════════════

    private void UpdateCtorCode()
    {
        var lines = new List<string>();
        lines.Add("<SgProgress");

        if (_ctorValue != 0)
            lines.Add($"           Value=\"{_ctorValue}\"");

        if (_ctorSize != SgSize.Lg)
            lines.Add($"           Size=\"SgSize.{_ctorSize}\"");

        if (_ctorVariant != SgSpinnerVariant.Default)
            lines.Add($"           Variant=\"SgSpinnerVariant.{_ctorVariant}\"");

        if (_ctorGradient) lines.Add("           Gradient=\"true\"");
        if (_ctorGlow) lines.Add("           Glow=\"true\"");
        if (_ctorStriped) lines.Add("           Striped=\"true\"");
        if (_ctorAnimated) lines.Add("           Animated=\"true\"");
        if (_ctorCircular) lines.Add("           Circular=\"true\"");
        if (_ctorVertical) lines.Add("           Vertical=\"true\"");
        if (!_ctorShowLabel) lines.Add("           ShowLabel=\"false\"");
        if (_ctorShowAnimation) lines.Add("           ShowAnimation=\"true\"");
        if (_ctorMarker) lines.Add("           Marker=\"true\"");
        if (_ctorConfetti) lines.Add("           Confetti=\"true\"");
        if (_ctorGlass) lines.Add("           Glassmorphism=\"true\"");
        if (_ctorNeon) lines.Add("           Neon=\"true\"");
        if (_ctorError) lines.Add("           Error=\"true\"");
        if (_ctorThumb) { lines.Add("           ShowThumb=\"true\""); lines.Add("           Clickable=\"true\""); }

        lines.Add("           />");
        _ctorCodeLines = lines.ToArray();
    }

    private async Task CopyCtorCode()
    {
        var code = string.Join("\n", _ctorCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    //                         SEGMENTED OPTIONS
    // ═══════════════════════════════════════════════════════════════════════════

    private readonly List<SgSegmentedOption<SgSize>> _sizeSegOptions = new()
    {
        new() { Value = SgSize.Sm, Label = "Sm" },
        new() { Value = SgSize.Md, Label = "Md" },
        new() { Value = SgSize.Lg, Label = "Lg" },
        new() { Value = SgSize.Xl, Label = "Xl" },
    };

    private readonly List<SgSegmentedOption<SgSpinnerVariant>> _variantSegOptions = new()
    {
        new() { Value = SgSpinnerVariant.Default, Label = "Default" },
        new() { Value = SgSpinnerVariant.Info,    Label = "Info" },
        new() { Value = SgSpinnerVariant.Success, Label = "Success" },
        new() { Value = SgSpinnerVariant.Warn,    Label = "Warn" },
        new() { Value = SgSpinnerVariant.Danger,  Label = "Danger" },
    };

    private readonly List<SgSegmentedOption<bool>> _boolSegOptions = new()
    {
        new() { Value = false, Label = "Off" },
        new() { Value = true,  Label = "On" },
    };

    private readonly List<SgSegmentedOption<bool>> _boolSegOptionsOn = new()
    {
        new() { Value = true,  Label = "On" },
        new() { Value = false, Label = "Off" },
    };

    // ═══════════════════════════════════════════════════════════════════════════
    //                              PROPERTY TABLES
    // ═══════════════════════════════════════════════════════════════════════════

    private List<PropertyPanelItem> _progressProperties = new()
    {
        new() { Label = "Value", Value = "double", BadgeText = "Current progress (0 to Max)", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Max", Value = "double", BadgeText = "Maximum value (default 100)", BadgeVariant = SgBadgeVariant.Info },
