@page "/progress-demo"
@using SuperUI.Components
@implements IDisposable

<PageTitle>SgProgress — SUI</PageTitle>

<SgCard Title="Компонент SgProgress"
        Subtitle="Индикатор прогресса с поддержкой размеров SgSize, цветовых Variant, Title, Gradient, Segmented, PulseOnComplete, Buffer, Vertical и Circular.">

    <!-- ✅ Типы / Размеры / Цвета -->
    <div style="margin-top: 32px;">
        <h2>Основные варианты</h2>
        <p>Линейный и круговой прогресс с размерами <code>SgSize</code>, цветовыми вариантами <code>Variant</code>, Title, полосами, буфером и анимацией.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">

            <SgCard Title="Линейный прогресс (Size + Variant)">
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Размеры (SgSize)</div>
                        <div style="display: flex; flex-direction: column; gap: 10px;">
                            <SgProgress Value="40" Size="SgSize.Sm" Title="Sm" />
                            <SgProgress Value="55" Size="SgSize.Md" Title="Md (default)" />
                            <SgProgress Value="70" Size="SgSize.Lg" Title="Lg" />
                            <SgProgress Value="85" Size="SgSize.Xl" Title="Xl" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Цветовые варианты (Variant)</div>
                        <div style="display: flex; flex-direction: column; gap: 10px;">
                            <SgProgress Value="30" Title="Default" />
                            <SgProgress Value="45" Variant="SgSpinnerVariant.Info" Title="Info" />
                            <SgProgress Value="60" Variant="SgSpinnerVariant.Success" Title="Success" />
                            <SgProgress Value="75" Variant="SgSpinnerVariant.Warn" Title="Warn" />
                            <SgProgress Value="90" Variant="SgSpinnerVariant.Danger" Title="Danger" />
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Linear — Striped / Buffer / Gradient / Segmented / PulseOnComplete">
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Striped</div>
                        <SgProgress Value="55" Striped="true" Title="Striped" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Striped + Animated</div>
                        <SgProgress Value="80" Striped="true" Animated="true" Title="Animated" Variant="SgSpinnerVariant.Success" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Buffer</div>
                        <SgProgress Value="50" BufferValue="80" Title="Buffer (50/80)" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Gradient</div>
                        <SgProgress Value="65" Gradient="true" Title="Gradient" Variant="SgSpinnerVariant.Success" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Segmented</div>
                        <SgProgress Value="70" Segmented="true" Title="Segmented" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">PulseOnComplete (100%)</div>
                        <SgProgress Value="100" PulseOnComplete="true" Title="Complete!" Variant="SgSpinnerVariant.Success" />
                    </div>
                </div>
            </SgCard>
        </div>
    </div>

    <SgDivider />

    <!-- ✅ Circular / Vertical / LabelPosition / Color -->
    <div style="margin-top: 32px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">

            <SgCard Title="Circular — Size + Variant">
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Размеры</div>
                        <div style="display: flex; gap: 14px; flex-wrap: wrap; align-items: center;">
                            <div style="display:flex; flex-direction:column; align-items:center; gap: 6px;">
                                <SgProgress Circular="true" Value="37" Size="SgSize.Sm" />
                                <span style="font-size:11px;color:var(--sui-text-secondary);">Sm</span>
                            </div>
                            <div style="display:flex; flex-direction:column; align-items:center; gap: 6px;">
                                <SgProgress Circular="true" Value="52" Size="SgSize.Md" />
                                <span style="font-size:11px;color:var(--sui-text-secondary);">Md</span>
                            </div>
                            <div style="display:flex; flex-direction:column; align-items:center; gap: 6px;">
                                <SgProgress Circular="true" Value="68" Size="SgSize.Lg" />
                                <span style="font-size:11px;color:var(--sui-text-secondary);">Lg</span>
                            </div>
                            <div style="display:flex; flex-direction:column; align-items:center; gap: 6px;">
                                <SgProgress Circular="true" Value="83" Size="SgSize.Xl" />
                                <span style="font-size:11px;color:var(--sui-text-secondary);">Xl</span>
                            </div>
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Цвета (Variant)</div>
                        <div style="display: flex; gap: 14px; flex-wrap: wrap; align-items: center;">
                            <SgProgress Circular="true" Value="30" Variant="SgSpinnerVariant.Default" />
                            <SgProgress Circular="true" Value="45" Variant="SgSpinnerVariant.Info" />
                            <SgProgress Circular="true" Value="60" Variant="SgSpinnerVariant.Success" />
                            <SgProgress Circular="true" Value="75" Variant="SgSpinnerVariant.Warn" />
                            <SgProgress Circular="true" Value="90" Variant="SgSpinnerVariant.Danger" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Indeterminate</div>
                        <div style="display: flex; gap: 14px; flex-wrap: wrap; align-items: center;">
                            <SgProgress Circular="true" Indeterminate="true" Size="SgSize.Sm" />
                            <SgProgress Circular="true" Indeterminate="true" Size="SgSize.Md" />
                            <SgProgress Circular="true" Indeterminate="true" Size="SgSize.Lg" />
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Vertical + Custom Color + LabelPosition">
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Vertical</div>
                        <div style="display: flex; gap: 18px; flex-wrap: wrap; align-items: flex-end;">
                            <div style="display:flex; flex-direction:column; align-items:center; gap: 6px;">
                                <SgProgress Vertical="true" Value="20" Title="20%" Size="SgSize.Sm" />
                            </div>
                            <div style="display:flex; flex-direction:column; align-items:center; gap: 6px;">
                                <SgProgress Vertical="true" Value="50" Title="50%" Size="SgSize.Md" Variant="SgSpinnerVariant.Info" />
                            </div>
                            <div style="display:flex; flex-direction:column; align-items:center; gap: 6px;">
                                <SgProgress Vertical="true" Value="80" Title="80%" Size="SgSize.Lg" Variant="SgSpinnerVariant.Success" />
                            </div>
                            <div style="display:flex; flex-direction:column; align-items:center; gap: 6px;">
                                <SgProgress Vertical="true" Indeterminate="true" Title="..." Size="SgSize.Md" />
                            </div>
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Custom Color</div>
                        <div style="display: flex; flex-direction: column; gap: 10px;">
                            <SgProgress Value="50" Color="#8b5cf6" Title="Violet" />
                            <SgProgress Value="45" Color="#ec4899" Title="Pink" />
                            <SgProgress Value="35" Color="#14b8a6" Title="Teal" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">LabelPosition</div>
                        <SgProgress Value="70" Title="Сверху (Top)" LabelPosition="SgLabelPosition.Top" />
                        <SgProgress Value="60" Title="Справа (Right)" LabelPosition="SgLabelPosition.Right" />
                        <SgProgress Value="50" LabelPosition="SgLabelPosition.Top" Title="Top" />
                    </div>
                </div>
            </SgCard>
        </div>
    </div>

    <SgDivider />

    <!-- ✅ Интерактивное управление -->
    <div style="margin-top: 32px;">
        <h2>Интерактивное управление</h2>
        <p>Живая демонстрация с настройками, анимацией прогресса и buffer.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Параметры">
                <div style="display:flex; flex-direction: column; gap: 14px;">
                    <div style="display:flex; gap: 12px; flex-wrap: wrap; align-items: center;">
                        <SgCheckBox @bind-Value="_indeterminate" Label="Indeterminate" />
                        <SgCheckBox @bind-Value="_striped" Label="Striped" />
                        <SgCheckBox @bind-Value="_animated" Label="Animated" />
                    </div>
                    <div style="display:flex; gap: 12px; flex-wrap: wrap; align-items: center;">
                        <SgCheckBox @bind-Value="_vertical" Label="Vertical" />
                        <SgCheckBox @bind-Value="_circular" Label="Circular" />
                        <SgCheckBox @bind-Value="_showLabel" Label="ShowLabel" />
                        <SgCheckBox @bind-Value="_showBuffer" Label="ShowBuffer" />
                    </div>
                    <SgDivider />
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        <SgSlider TValue="double" Label="Value" @bind-Value="_value" Min="0" Max="100" Step="1" ShowValue="true" Suffix="%" />
                        <SgSlider TValue="double" Label="BufferValue" @bind-Value="_bufferValue" Min="0" Max="100" Step="1" ShowValue="true" Suffix="%"
                                  Disabled="@(!_showBuffer)" />
                    </div>
                    <SgDivider />
                    <div style="display:flex; gap: 10px; flex-wrap: wrap;">
                        <SgButton Text="▶ Play" Variant="SgButtonVariant.Primary" OnClick="Start" Disabled="@_isPlaying" />
                        <SgButton Text="■ Stop" OnClick="Stop" Disabled="@(!_isPlaying)" />
                        <SgButton Text="↺ Reset" OnClick="Reset" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Рендер">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    @if (_circular)
                    {
                        <div style="display:flex; justify-content:center; padding: 20px;">
                            <SgProgress Circular="true"
                                        Value="@_value"
                                        Indeterminate="@_indeterminate"
                                        ShowLabel="@_showLabel"
                                        Size="SgSize.Lg" />
                        </div>
                    }
                    else
                    {
                        <SgProgress Value="@_value"
                                    Max="100"
                                    BufferValue="@(_showBuffer && !_indeterminate ? _bufferValue : null)"
                                    Indeterminate="@_indeterminate"
                                    Striped="@_striped"
                                    Animated="@_animated"
                                    Vertical="@_vertical"
                                    ShowLabel="@_showLabel"
                                    Title="@($"Значение: {_value:0}%")"
                                    Variant="@_currentVariant" />
                    }
                    <SgDivider />
                    <div style="display:flex; gap: 8px; flex-wrap: wrap;">
                        <SgButton Text="Default" Size="SgSize.Sm" OnClick="() => _currentVariant = SgSpinnerVariant.Default" />
                        <SgButton Text="Info" Size="SgSize.Sm" Variant="SgButtonVariant.Primary" OnClick="() => _currentVariant = SgSpinnerVariant.Info" />
                        <SgButton Text="Success" Size="SgSize.Sm" Variant="SgButtonVariant.Success" OnClick="() => _currentVariant = SgSpinnerVariant.Success" />
                        <SgButton Text="Warn" Size="SgSize.Sm" Variant="SgButtonVariant.Outlined" OnClick="() => _currentVariant = SgSpinnerVariant.Warn" />
                        <SgButton Text="Danger" Size="SgSize.Sm" Variant="SgButtonVariant.Danger" OnClick="() => _currentVariant = SgSpinnerVariant.Danger" />
                    </div>
                </div>
            </SgCard>
        </div>
    </div>

    <SgDivider />

    <!-- ✅ Свойства компонента -->
    <div style="margin-top: 32px;">
        <h2>Свойства компонента</h2>
        <p>Основные параметры SgProgress с новыми возможностями.</p>
        <div style="margin-top: 16px;">
            <PropertyTable Items="_progressProperties" />
        </div>
    </div>

</SgCard>

@code {
    private double _value = 45;
    private double _bufferValue = 75;
    private bool _showBuffer = true;
    private bool _indeterminate;
    private bool _striped;
    private bool _animated;
    private bool _vertical;
    private bool _circular;
    private bool _showLabel = true;
    private bool _isPlaying;
    private System.Timers.Timer? _timer;
    private SgSpinnerVariant _currentVariant = SgSpinnerVariant.Default;

    private readonly List<PropertyPanelItem> _progressProperties = new()
    {
        new() { Label = "Value",         Value = "double",                       BadgeText = "Значение",      BadgeVariant = SgBadgeVariant.Info  },
        new() { Label = "Max",           Value = "double (100)",                 BadgeText = "Максимум",      BadgeVariant = SgBadgeVariant.Info  },
        new() { Label = "ShowLabel",     Value = "bool (true)",                  BadgeText = "Метка",         BadgeVariant = SgBadgeVariant.Warn  },
        new() { Label = "Indeterminate", Value = "bool",                         BadgeText = "Loading",       BadgeVariant = SgBadgeVariant.Warn  },
        new() { Label = "Striped",       Value = "bool",                         BadgeText = "Полосы",        BadgeVariant = SgBadgeVariant.Warn  },
        new() { Label = "Animated",      Value = "bool",                         BadgeText = "Анимация",      BadgeVariant = SgBadgeVariant.Warn  },
        new() { Label = "BufferValue",   Value = "double?",                      BadgeText = "Buffer",        BadgeVariant = SgBadgeVariant.Info  },
        new() { Label = "Vertical",      Value = "bool",                         BadgeText = "Вертикаль",     BadgeVariant = SgBadgeVariant.Info  },
        new() { Label = "Circular",      Value = "bool",                         BadgeText = "Круговой",      BadgeVariant = SgBadgeVariant.Info  },
        new() { Label = "Size",          Value = "SgSize (Md)",                  BadgeText = "Размер",        BadgeVariant = SgBadgeVariant.Info  },
        new() { Label = "Variant",       Value = "SgSpinnerVariant",             BadgeText = "Цвет",          BadgeVariant = SgBadgeVariant.Info  },
        new() { Label = "Title",         Value = "string?",                      BadgeText = "Заголовок",     BadgeVariant = SgBadgeVariant.Warn  },
        new() { Label = "LabelPosition", Value = "SgLabelPosition",              BadgeText = "Метка",         BadgeVariant = SgBadgeVariant.Warn  },
        new() { Label = "Color",         Value = "string? (CSS color)",          BadgeText = "Цвет",          BadgeVariant = SgBadgeVariant.Warn  },
        new() { Label = "Gradient",      Value = "bool",                         BadgeText = "Градиент",      BadgeVariant = SgBadgeVariant.Warn  },
        new() { Label = "Segmented",     Value = "bool",                         BadgeText = "Сегменты",      BadgeVariant = SgBadgeVariant.Warn  },
        new() { Label = "PulseOnComplete", Value = "bool (true)",                BadgeText = "Пульс 100%",    BadgeVariant = SgBadgeVariant.Warn  },
        new() { Label = "BarHeight",     Value = "int? (auto)",                  BadgeText = "Высота",        BadgeVariant = SgBadgeVariant.Info  },
        new() { Label = "CircularSize",  Value = "int? (auto)",                  BadgeText = "Диаметр",       BadgeVariant = SgBadgeVariant.Info  },
        new() { Label = "CssClass",      Value = "string?",                      BadgeText = "CSS",           BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Style",         Value = "string?",                      BadgeText = "Inline",        BadgeVariant = SgBadgeVariant.Default },
    };

    private void Start()
    {
        if (_isPlaying) return;
        _isPlaying = true;
        _timer?.Dispose();
        _timer = new System.Timers.Timer(100);
        _timer.AutoReset = true;
        _timer.Elapsed += (_, _) =>
        {
            if (!_isPlaying) return;
            _value += 1.5;
            if (_value >= 100) _value = 0;
            if (_showBuffer && !_indeterminate)
                _bufferValue = Math.Min(100, _value + 25);
            InvokeAsync(StateHasChanged);
        };
        _timer.Start();
    }

    private void Stop()
    {
        _isPlaying = false;
        _timer?.Stop();
        _timer?.Dispose();
        _timer = null;
    }

    private void Reset()
    {
        Stop();
        _value = 45;
        _bufferValue = 75;
        _indeterminate = false;
        _striped = false;
        _animated = false;
        _vertical = false;
        _circular = false;
        _showLabel = true;
        _showBuffer = true;
        _currentVariant = SgSpinnerVariant.Default;
    }

    public void Dispose() => Stop();
}