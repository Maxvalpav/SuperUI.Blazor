@page "/demo/progress"
@using SuperUI.Demo.Components

<div class="demo-page">
    <div class="demo-hero">
        <section class="demo-hero-main">
            <div class="demo-header">
                <div class="demo-kicker">Display Components</div>
                <h1 class="demo-title">SgProgress</h1>
                <p class="demo-subtitle">
                    Visualize task progress, loading states and metrics with linear and circular indicators. 
                    Supports labels, buffering, and various color themes.
                </p>
            </div>
        </section>

        <aside class="demo-hero-side">
            <div class="demo-side-title">Highlights</div>
            <div class="demo-pill-list">
                <span class="demo-pill demo-pill-accent">Linear & Circular</span>
                <span class="demo-pill">Indeterminate</span>
                <span class="demo-pill">Buffered</span>
                <span class="demo-pill">Animated</span>
            </div>
        </aside>
    </div>

    <SgDemoSection Eyebrow="Usage" Title="Linear Examples">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Basic Progress</h3>
                    <p class="demo-showcase-desc">Standard linear bar with value and title.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgProgress Value="65" Title="Upload Progress" />
                        <SgProgress Value="100" Variant="SgSpinnerVariant.Success" Title="Task Completed" />
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Indeterminate & Animated</h3>
                    <p class="demo-showcase-desc">Loading states and attention-grabbing stripes.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgProgress Indeterminate="true" Title="Loading assets..." />
                        <SgProgress Value="40" Striped="true" Animated="true" Title="Processing..." />
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Buffered & Segmented</h3>
                    <p class="demo-showcase-desc">Advanced display for streaming or step-based progress.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgProgress Value="30" BufferValue="70" Title="Video Buffer" />
                        <SgProgress Value="50" Segmented="true" Segments="10" Title="Step 5 of 10" />
                    </div>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoSection Eyebrow="Usage" Title="Circular Examples">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Circular Progress</h3>
                    <p class="demo-showcase-desc">Compact indicators for dashboard widgets.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <div style="display:flex; gap:20px; align-items:center; justify-content:center;">
                            <SgProgress Circular="true" Value="75" Size="SgSize.Lg" />
                            <SgProgress Circular="true" Value="45" Variant="SgSpinnerVariant.Warn" />
                            <SgProgress Circular="true" Indeterminate="true" Size="SgSize.Sm" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoParams Title="Progress Parameters">
        <SgDemoParam Name="Value" Type="double" Description="Current value (0 to Max)." DefaultValue="0" />
        <SgDemoParam Name="Max" Type="double" Description="Maximum value." DefaultValue="100" />
        <SgDemoParam Name="Indeterminate" Type="bool" Description="Enable loading state animation." DefaultValue="false" />
        <SgDemoParam Name="Circular" Type="bool" Description="Render as a circle instead of a bar." DefaultValue="false" />
        <SgDemoParam Name="ShowLabel" Type="bool" Description="Show percentage text." DefaultValue="true" />
        <SgDemoParam Name="Striped" Type="bool" Description="Add striped background pattern." DefaultValue="false" />
        <SgDemoParam Name="Variant" Type="SgSpinnerVariant" Description="Color theme." Values="Default, Primary, Success, Warning, Danger" DefaultValue="Default" />
    </SgDemoParams>
</div>
