@page "/progress-demo"
@using SuperUI.Components
@implements IDisposable

<PageTitle>Индикаторы прогресса - SUI</PageTitle>

<SgCard Title="Индикаторы прогресса"
        Subtitle="Современные компоненты для отображения прогресса выполнения операций с поддержкой линейного и кругового отображения, градиентов, сегментов и анимаций.">

    <!-- SgProgress - Linear -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">SgProgress — Линейный прогресс</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Универсальный индикатор прогресса с поддержкой различных размеров, цветов и эффектов.</SgTypography>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Размеры</SgTypography>
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <SgProgress Value="40" Size="SgSize.Sm" Title="Small (Sm)" />
                            <SgProgress Value="55" Size="SgSize.Md" Title="Medium (Md)" />
                            <SgProgress Value="70" Size="SgSize.Lg" Title="Large (Lg)" />
                            <SgProgress Value="85" Size="SgSize.Xl" Title="Extra Large (Xl)" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Цветовые варианты</SgTypography>
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <SgProgress Value="50" Variant="SgSpinnerVariant.Default" Title="Default" />
                            <SgProgress Value="60" Variant="SgSpinnerVariant.Info" Title="Info" />
                            <SgProgress Value="70" Variant="SgSpinnerVariant.Success" Title="Success" />
                            <SgProgress Value="80" Variant="SgSpinnerVariant.Warn" Title="Warning" />
                            <SgProgress Value="90" Variant="SgSpinnerVariant.Danger" Title="Danger" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Специальные эффекты</SgTypography>
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <SgProgress Value="75" Gradient="true" Variant="SgSpinnerVariant.Info" Title="Градиент" Size="SgSize.Lg" />
                            <SgProgress Value="65" Glow="true" Variant="SgSpinnerVariant.Success" Title="Свечение" Size="SgSize.Lg" />
                            <SgProgress Value="70" Striped="true" Animated="true" Variant="SgSpinnerVariant.Warn" Title="Полосы + Анимация" Size="SgSize.Lg" />
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_progressProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgProgress - Circular -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">SgProgress — Круговой прогресс</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Компактное отображение прогресса в виде круга. Идеально для дашбордов и карточек.</SgTypography>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Варианты и размеры">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Размеры</SgTypography>
                        <div style="display: flex; gap: 24px; align-items: center; justify-content: center; padding: 20px;">
                            <div style="text-align: center;">
                                <SgProgress Value="37" Circular="true" Size="SgSize.Sm" />
                                <div style="font-size: 11px; color: var(--sg-text-muted); margin-top: 8px;">Sm</div>
                            </div>
                            <div style="text-align: center;">
                                <SgProgress Value="52" Circular="true" Size="SgSize.Md" />
                                <div style="font-size: 11px; color: var(--sg-text-muted); margin-top: 8px;">Md</div>
                            </div>
                            <div style="text-align: center;">
                                <SgProgress Value="68" Circular="true" Size="SgSize.Lg" />
                                <div style="font-size: 11px; color: var(--sg-text-muted); margin-top: 8px;">Lg</div>
                            </div>
                            <div style="text-align: center;">
                                <SgProgress Value="83" Circular="true" Size="SgSize.Xl" />
                                <div style="font-size: 11px; color: var(--sg-text-muted); margin-top: 8px;">Xl</div>
                            </div>
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Цвета</SgTypography>
                        <div style="display: flex; gap: 20px; align-items: center; justify-content: center; padding: 20px; flex-wrap: wrap;">
                            <SgProgress Value="30" Circular="true" Variant="SgSpinnerVariant.Default" />
                            <SgProgress Value="45" Circular="true" Variant="SgSpinnerVariant.Info" />
                            <SgProgress Value="60" Circular="true" Variant="SgSpinnerVariant.Success" />
                            <SgProgress Value="75" Circular="true" Variant="SgSpinnerVariant.Warn" />
                            <SgProgress Value="90" Circular="true" Variant="SgSpinnerVariant.Danger" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">С эффектами</SgTypography>
                        <div style="display: flex; gap: 32px; align-items: center; justify-content: center; padding: 20px;">
                            <SgProgress Value="65" Circular="true" Size="SgSize.Lg" Gradient="true" Variant="SgSpinnerVariant.Info" />
                            <SgProgress Value="82" Circular="true" Size="SgSize.Lg" Glow="true" Variant="SgSpinnerVariant.Success" />
                            <SgProgress Value="45" Circular="true" Size="SgSize.Lg" Gradient="true" Glow="true" Variant="SgSpinnerVariant.Danger" />
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства Circular">
                <PropertyTable Items="_circularProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Segmented Progress -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">Сегментированный прогресс</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Разделение прогресса на отдельные сегменты для визуализации этапов.</SgTypography>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgProgress Value="60" Segmented="true" Segments="5" Variant="SgSpinnerVariant.Success" Title="5 сегментов" />
                    <SgProgress Value="75" Segmented="true" Segments="10" Variant="SgSpinnerVariant.Info" Title="10 сегментов" />
                    <SgProgress Value="85" Segmented="true" Segments="20" Variant="SgSpinnerVariant.Warn" Title="20 сегментов" />
                </div>
            </SgCard>
            <SgCard Title="Свойства Segmented">
                <PropertyTable Items="_segmentedProperties" />
            </SgCard>
        </div>
    </div>


    <!-- Buffer / Streaming -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">Буферизация и потоковая загрузка</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Отображение буфера для видео, аудио и потоковых данных.</SgTypography>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgProgress Value="@videoProgress" BufferValue="@videoBuffer" Title="Воспроизведение видео" Size="SgSize.Lg" Variant="SgSpinnerVariant.Info" />
                    <SgProgress Value="@audioProgress" BufferValue="@audioBuffer" Title="Аудио трек" Size="SgSize.Md" Variant="SgSpinnerVariant.Success" Gradient="true" />
                    <SgDivider />
                    <SgProgress Value="@downloadProgress" BufferValue="@downloadBuffer" Title="Загрузка файла (125 MB)" Size="SgSize.Lg" Variant="SgSpinnerVariant.Warn" Glow="true" />
                    <div style="display: flex; gap: 12px; margin-top: 8px;">
                        <SgButton OnClick="StartDownload" Size="SgSize.Sm" Variant="SgButtonVariant.Primary" Text="Начать загрузку" />
                        <SgButton OnClick="StopDownload" Size="SgSize.Sm" Variant="SgButtonVariant.Default" Text="Остановить" />
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства Buffer">
                <PropertyTable Items="_bufferProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Indeterminate Loading -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">Неопределенная загрузка</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Когда прогресс неизвестен или невозможно измерить.</SgTypography>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Линейная загрузка</SgTypography>
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <SgProgress Indeterminate="true" Title="Загрузка данных..." Size="SgSize.Md" Variant="SgSpinnerVariant.Info" />
                            <SgProgress Indeterminate="true" Title="Обработка запроса..." Size="SgSize.Lg" Variant="SgSpinnerVariant.Success" Gradient="true" />
                            <SgProgress Indeterminate="true" Title="Синхронизация..." Size="SgSize.Md" Variant="SgSpinnerVariant.Warn" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Круговая загрузка</SgTypography>
                        <div style="display: flex; gap: 32px; align-items: center; justify-content: center; padding: 20px;">
                            <div style="text-align: center;">
                                <SgProgress Indeterminate="true" Circular="true" Size="SgSize.Md" Variant="SgSpinnerVariant.Info" />
                                <div style="font-size: 12px; color: var(--sg-text-muted); margin-top: 8px;">Загрузка...</div>
                            </div>
                            <div style="text-align: center;">
                                <SgProgress Indeterminate="true" Circular="true" Size="SgSize.Lg" Variant="SgSpinnerVariant.Success" Gradient="true" />
                                <div style="font-size: 12px; color: var(--sg-text-muted); margin-top: 8px;">Обработка...</div>
                            </div>
                            <div style="text-align: center;">
                                <SgProgress Indeterminate="true" Circular="true" Size="SgSize.Xl" Variant="SgSpinnerVariant.Danger" Glow="true" />
                                <div style="font-size: 12px; color: var(--sg-text-muted); margin-top: 8px;">Ожидание...</div>
                            </div>
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства Indeterminate">
                <PropertyTable Items="_indeterminateProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Vertical Progress -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">Вертикальный прогресс</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Для боковых панелей и вертикальных макетов.</SgTypography>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; gap: 32px; align-items: flex-end; justify-content: center; padding: 40px 20px;">
                    <div style="text-align: center;">
                        <SgProgress Value="30" Vertical="true" Size="SgSize.Sm" Variant="SgSpinnerVariant.Default" />
                        <div style="font-size: 11px; color: var(--sg-text-muted); margin-top: 8px;">30%</div>
                    </div>
                    <div style="text-align: center;">
                        <SgProgress Value="50" Vertical="true" Size="SgSize.Md" Variant="SgSpinnerVariant.Info" Gradient="true" />
                        <div style="font-size: 11px; color: var(--sg-text-muted); margin-top: 8px;">50%</div>
                    </div>
                    <div style="text-align: center;">
                        <SgProgress Value="70" Vertical="true" Size="SgSize.Lg" Variant="SgSpinnerVariant.Success" Glow="true" />
                        <div style="font-size: 11px; color: var(--sg-text-muted); margin-top: 8px;">70%</div>
                    </div>
                    <div style="text-align: center;">
                        <SgProgress Value="90" Vertical="true" Size="SgSize.Xl" Variant="SgSpinnerVariant.Warn" Gradient="true" Glow="true" />
                        <div style="font-size: 11px; color: var(--sg-text-muted); margin-top: 8px;">90%</div>
                    </div>
                    <div style="text-align: center;">
                        <SgProgress Value="100" Vertical="true" Size="SgSize.Lg" Variant="SgSpinnerVariant.Danger" Striped="true" Animated="true" />
                        <div style="font-size: 11px; color: var(--sg-text-muted); margin-top: 8px;">100%</div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства Vertical">
                <PropertyTable Items="_verticalProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Custom Colors -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">Пользовательские цвета</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Любой цвет для вашего бренда.</SgTypography>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Линейные с кастомными цветами</SgTypography>
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <SgProgress Value="65" Color="#9333ea" Title="Фиолетовый (#9333ea)" Size="SgSize.Lg" />
                            <SgProgress Value="75" Color="#ec4899" Title="Розовый (#ec4899)" Size="SgSize.Lg" Glow="true" />
                            <SgProgress Value="85" Color="#14b8a6" Title="Бирюзовый (#14b8a6)" Size="SgSize.Lg" Striped="true" Animated="true" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Круговые с кастомными цветами</SgTypography>
                        <div style="display: flex; gap: 24px; align-items: center; justify-content: center; padding: 20px;">
                            <SgProgress Value="60" Circular="true" Color="#9333ea" Size="SgSize.Lg" />
                            <SgProgress Value="75" Circular="true" Color="#ec4899" Size="SgSize.Lg" Glow="true" />
                            <SgProgress Value="90" Circular="true" Color="#14b8a6" Size="SgSize.Lg" Glow="true" />
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства Color">
                <PropertyTable Items="_colorProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Sticky Top -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">Sticky Top индикатор</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Для индикации загрузки страницы в верхней части экрана (как на YouTube, GitHub).</SgTypography>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div style="padding: 20px; text-align: center;">
                        <SgButton OnClick="SimulatePageLoad" 
                                 Variant="SgButtonVariant.Primary" 
                                 Size="SgSize.Lg">
                            <span style="font-size: 16px;">🚀 Симулировать загрузку страницы</span>
                        </SgButton>
                    </div>
                    <SgDivider />
                    <div style="padding: 12px; background: var(--sui-bg-secondary); border-radius: 6px;">
                        <p style="margin: 0; font-size: 13px; color: var(--sg-text-muted); line-height: 1.5;">
                            💡 При нажатии появится тонкая полоса прогресса в самом верху страницы. 
                            Это имитирует поведение индикатора загрузки как на YouTube или GitHub.
                        </p>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Текущее состояние</SgTypography>
                        <div style="padding: 12px; background: var(--sui-bg-tertiary); border-radius: 6px; font-family: monospace; font-size: 12px;">
                            <div>Показан: <strong>@(showStickyProgress ? "Да" : "Нет")</strong></div>
                            @if (showStickyProgress)
                            {
                                <div style="margin-top: 4px;">Прогресс: <strong>@($"{stickyProgress:F0}%")</strong></div>
                            }
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства StickyTop">
                <PropertyTable Items="_stickyProperties" />
                <div style="margin-top: 16px;">
                    <SgAlert Variant="SgAlertVariant.Info" Title="Использование">
                        <ChildContent>
                            Sticky Top прогресс автоматически позиционируется в самом верху страницы с помощью <code>position: fixed</code>. 
                            Обычно используется с <code>Size="SgSize.Sm"</code> и <code>ShowLabel="false"</code> для минималистичного вида.
                        </ChildContent>
                    </SgAlert>
                </div>
            </SgCard>
        </div>
    </div>
    
    @if (showStickyProgress)
    {
        <SgProgress Value="@stickyProgress" 
                   StickyTop="true" 
                   Size="SgSize.Sm" 
                   Variant="SgSpinnerVariant.Info" 
                   Gradient="true" 
                   ShowLabel="false" />
    }

</SgCard>


@code {
    // ═══════════════════════════════════════════════════════════════════════════
    //                              STATE VARIABLES
    // ═══════════════════════════════════════════════════════════════════════════
    
    // Buffer / Streaming Demo
    private double videoProgress = 45;
    private double videoBuffer = 75;
    private double audioProgress = 62;
    private double audioBuffer = 88;
    private double downloadProgress = 0;
    private double downloadBuffer = 0;
    private Timer? downloadTimer;
    
    // Sticky Top Demo
    private bool showStickyProgress = false;
    private double stickyProgress = 0;
    private Timer? stickyTimer;
    
    // ═══════════════════════════════════════════════════════════════════════════
    //                              LIFECYCLE
    // ═══════════════════════════════════════════════════════════════════════════
    
    protected override void OnInitialized()
    {
        // Simulate video/audio buffer changes
        var bufferTimer = new Timer(_ =>
        {
            InvokeAsync(() =>
            {
                // Video simulation
                videoProgress = Math.Min(100, videoProgress + Random.Shared.Next(1, 3));
                videoBuffer = Math.Min(100, videoProgress + Random.Shared.Next(10, 25));
                
                // Audio simulation
                audioProgress = Math.Min(100, audioProgress + Random.Shared.Next(1, 4));
                audioBuffer = Math.Min(100, audioProgress + Random.Shared.Next(15, 30));
                
                if (videoProgress >= 100) videoProgress = 0;
                if (audioProgress >= 100) audioProgress = 0;
                
                StateHasChanged();
            });
        }, null, TimeSpan.FromMilliseconds(500), TimeSpan.FromMilliseconds(500));
    }
    
    public void Dispose()
    {
        downloadTimer?.Dispose();
        stickyTimer?.Dispose();
    }
    
    // ═══════════════════════════════════════════════════════════════════════════
    //                              METHODS
    // ═══════════════════════════════════════════════════════════════════════════
    
    private void StartDownload()
    {
        downloadProgress = 0;
        downloadBuffer = 0;
        
        downloadTimer?.Dispose();
        downloadTimer = new Timer(_ =>
        {
            InvokeAsync(() =>
            {
                if (downloadProgress < 100)
                {
                    downloadProgress = Math.Min(100, downloadProgress + Random.Shared.Next(2, 8));
                    downloadBuffer = Math.Min(100, downloadProgress + Random.Shared.Next(5, 15));
                    StateHasChanged();
                }
                else
                {
                    downloadTimer?.Dispose();
                }
            });
        }, null, TimeSpan.FromMilliseconds(200), TimeSpan.FromMilliseconds(200));
    }
    
    private void StopDownload()
    {
        downloadTimer?.Dispose();
    }
    
    private void SimulatePageLoad()
    {
        showStickyProgress = true;
        stickyProgress = 0;
        
        stickyTimer?.Dispose();
        stickyTimer = new Timer(_ =>
        {
            InvokeAsync(() =>
            {
                if (stickyProgress < 100)
                {
                    // Simulate realistic page load progress
                    if (stickyProgress < 30)
                        stickyProgress += Random.Shared.Next(5, 15); // Fast start
                    else if (stickyProgress < 70)
                        stickyProgress += Random.Shared.Next(2, 8);  // Medium
                    else if (stickyProgress < 90)
                        stickyProgress += Random.Shared.Next(1, 4);  // Slow down
                    else
                        stickyProgress += Random.Shared.Next(1, 3);  // Very slow near end
                    
                    stickyProgress = Math.Min(100, stickyProgress);
                    StateHasChanged();
                }
                else
                {
                    // Hide after completion
                    Task.Delay(500).ContinueWith(_ =>
                    {
                        InvokeAsync(() =>
                        {
                            showStickyProgress = false;
                            StateHasChanged();
                        });
                    });
                    stickyTimer?.Dispose();
                }
            });
        }, null, TimeSpan.FromMilliseconds(150), TimeSpan.FromMilliseconds(150));
    }
    
