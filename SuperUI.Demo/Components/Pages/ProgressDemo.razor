    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 15. Glassmorphism, Neon & Overlap                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgProgress — Glassmorphism, Neon & Overlap
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Modern visual effects: frosted glass, vibrant neon glow, and overlapping multi-bar.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Glassmorphism & Neon" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgProgress Value="55" Glassmorphism="true" Title="Glassmorphism Effect" Size="SgSize.Lg" Variant="SgSpinnerVariant.Info" />
                    <SgProgress Value="70" Neon="true" Title="Neon Glow" Size="SgSize.Lg" Variant="SgSpinnerVariant.Success" />
                    <SgProgress Value="85" Glassmorphism="true" Neon="true" Title="Glass + Neon" Size="SgSize.Lg" Variant="SgSpinnerVariant.Warn" />
