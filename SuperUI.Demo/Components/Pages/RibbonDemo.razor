@page "/ribbon-demo"
@using SuperUI.Components

<PageTitle>Ribbon - SUI</PageTitle>

<SgCard Title="SgRibbon — Лента инструментов"
        Subtitle="Office-style ribbon с вкладками, группами, большими и малыми кнопками, split-кнопками и поддержкой тёмной темы.">

    <div style="margin-top: 24px;">
        <h2>Полный пример</h2>
        <p>Вкладки, группы, большие и малые кнопки, split-кнопки, разделители, toggle-кнопки.</p>

        <div style="margin-top: 16px;">
            <SgRibbon @bind-Collapsed="_collapsed" AllowCollapse="true">
                <ChildContent>

                @* ── Главная ── *@
                <SgRibbonTab Title="Главная">
                    <SgRibbonGroup Title="Буфер обмена">
                        <SgRibbonSplit Icon="@SgIcons.Copy" Text="Вставить" Tooltip="Вставить (Ctrl+V)"
                                       OnClick="@(() => Log("Вставить"))">
                            <DropdownContent>
                                <button class="sgc-ribbon-menu-item" @onclick="@(() => Log("Вставить как текст"))">
                                    @((MarkupString)SgIcons.FileText) Вставить как текст
                                </button>
                                <button class="sgc-ribbon-menu-item" @onclick="@(() => Log("Специальная вставка"))">
                                    @((MarkupString)SgIcons.Settings) Специальная вставка…
                                </button>
                            </DropdownContent>
                        </SgRibbonSplit>
                        <div style="display:flex;flex-direction:column;gap:1px;">
                            <SgRibbonButton Icon="@SgIcons.Copy"   Text="Копировать"  Size="SgRibbonButtonSize.Small" Tooltip="Копировать (Ctrl+C)" OnClick="@(() => Log("Копировать"))" />
                            <SgRibbonButton Icon="@SgIcons.Edit"   Text="Вырезать"    Size="SgRibbonButtonSize.Small" Tooltip="Вырезать (Ctrl+X)"  OnClick="@(() => Log("Вырезать"))" />
                            <SgRibbonButton Icon="@SgIcons.Refresh" Text="Формат"     Size="SgRibbonButtonSize.Small" Tooltip="Копировать формат"   OnClick="@(() => Log("Формат"))" />
                        </div>
                    </SgRibbonGroup>

                    <SgRibbonGroup Title="Шрифт">
                        <SgRibbonButton Icon="@_boldIcon"   Text="Жирный"    Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_bold"   Tooltip="Жирный (Ctrl+B)" />
                        <SgRibbonButton Icon="@_italicIcon" Text="Курсив"    Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_italic" Tooltip="Курсив (Ctrl+I)" />
                        <SgRibbonButton Icon="@_underIcon"  Text="Подчёркнутый" Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_under" Tooltip="Подчёркнутый (Ctrl+U)" />
                        <SgRibbonSeparator />
                        <SgRibbonButton Icon="@SgIcons.ArrowUp"   Text="Увеличить" Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Увеличить шрифт"))" />
                        <SgRibbonButton Icon="@SgIcons.ArrowDown" Text="Уменьшить" Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Уменьшить шрифт"))" />
                    </SgRibbonGroup>

                    <SgRibbonGroup Title="Абзац">
                        <SgRibbonButton Icon="@SgIcons.BarChart" Text="Список"    Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Список"))" />
                        <SgRibbonButton Icon="@SgIcons.BarChart" Text="Нумерация" Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Нумерация"))" />
                        <SgRibbonSeparator />
                        <SgRibbonButton Icon="@SgIcons.ArrowsUpDown" Text="Интервал" Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Интервал"))" />
                    </SgRibbonGroup>

                    <SgRibbonGroup Title="Стили">
                        <SgRibbonButton Icon="@SgIcons.FileText" Text="Обычный"    Tooltip="Обычный стиль"    OnClick="@(() => Log("Обычный"))" />
                        <SgRibbonButton Icon="@SgIcons.FileText" Text="Заголовок 1" Tooltip="Заголовок 1"     OnClick="@(() => Log("Заголовок 1"))" />
                        <SgRibbonButton Icon="@SgIcons.FileText" Text="Заголовок 2" Tooltip="Заголовок 2"     OnClick="@(() => Log("Заголовок 2"))" />
                    </SgRibbonGroup>

                    <SgRibbonGroup Title="Редактирование">
                        <SgRibbonButton Icon="@SgIcons.Search"  Text="Найти"    Tooltip="Найти (Ctrl+F)"    OnClick="@(() => Log("Найти"))" />
                        <SgRibbonButton Icon="@SgIcons.Edit"    Text="Заменить" Tooltip="Заменить (Ctrl+H)" OnClick="@(() => Log("Заменить"))" />
                        <SgRibbonButton Icon="@SgIcons.Check"   Text="Выбрать"  Tooltip="Выбрать всё"       OnClick="@(() => Log("Выбрать всё"))" />
                    </SgRibbonGroup>
                </SgRibbonTab>

                @* ── Вставка ── *@
                <SgRibbonTab Title="Вставка">
                    <SgRibbonGroup Title="Таблицы">
                        <SgRibbonSplit Icon="@SgIcons.Database" Text="Таблица" OnClick="@(() => Log("Вставить таблицу"))">
                            <DropdownContent>
                                <button class="sgc-ribbon-menu-item" @onclick="@(() => Log("Вставить таблицу"))">
                                    @((MarkupString)SgIcons.Database) Вставить таблицу…
                                </button>
                                <button class="sgc-ribbon-menu-item" @onclick="@(() => Log("Нарисовать таблицу"))">
                                    @((MarkupString)SgIcons.Edit) Нарисовать таблицу
                                </button>
                                <div class="sgc-ribbon-menu-sep"></div>
                                <button class="sgc-ribbon-menu-item" @onclick="@(() => Log("Таблица Excel"))">
                                    @((MarkupString)SgIcons.BarChart) Таблица Excel
                                </button>
                            </DropdownContent>
                        </SgRibbonSplit>
                    </SgRibbonGroup>

                    <SgRibbonGroup Title="Иллюстрации">
                        <SgRibbonButton Icon="@SgIcons.Download" Text="Рисунок"   Tooltip="Вставить рисунок"  OnClick="@(() => Log("Рисунок"))" />
                        <SgRibbonButton Icon="@SgIcons.BarChart" Text="Диаграмма" Tooltip="Вставить диаграмму" OnClick="@(() => Log("Диаграмма"))" />
                        <SgRibbonButton Icon="@SgIcons.TrendingUp" Text="График"  Tooltip="Вставить график"   OnClick="@(() => Log("График"))" />
                    </SgRibbonGroup>

                    <SgRibbonGroup Title="Ссылки">
                        <SgRibbonButton Icon="@SgIcons.ChevronRight" Text="Гиперссылка" OnClick="@(() => Log("Гиперссылка"))" />
                        <SgRibbonButton Icon="@SgIcons.FileText"     Text="Закладка"    OnClick="@(() => Log("Закладка"))" />
                    </SgRibbonGroup>

                    <SgRibbonGroup Title="Колонтитулы">
                        <SgRibbonButton Icon="@SgIcons.FileText" Text="Верхний"  Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Верхний колонтитул"))" />
                        <SgRibbonButton Icon="@SgIcons.FileText" Text="Нижний"   Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Нижний колонтитул"))" />
                        <SgRibbonButton Icon="@SgIcons.Plus"     Text="Номер"    Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Номер страницы"))" />
                    </SgRibbonGroup>
                </SgRibbonTab>

                @* ── Данные (контекстная вкладка) ── *@
                <SgRibbonTab Title="Данные" Highlight="true">
                    <SgRibbonGroup Title="Источник">
                        <SgRibbonButton Icon="@SgIcons.Database" Text="Подключить"  Tooltip="Подключить источник данных" OnClick="@(() => Log("Подключить"))" />
                        <SgRibbonButton Icon="@SgIcons.Refresh"  Text="Обновить"    Tooltip="Обновить данные"            OnClick="@(() => Log("Обновить"))" />
                    </SgRibbonGroup>

                    <SgRibbonGroup Title="Сортировка и фильтр">
                        <SgRibbonButton Icon="@SgIcons.ArrowUp"      Text="По возр."  Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Сортировка по возрастанию"))" />
                        <SgRibbonButton Icon="@SgIcons.ArrowDown"    Text="По убыв."  Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Сортировка по убыванию"))" />
                        <SgRibbonButton Icon="@SgIcons.ArrowsUpDown" Text="Настройка" Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Настройка сортировки"))" />
                    </SgRibbonGroup>

                    <SgRibbonGroup Title="Инструменты">
                        <SgRibbonButton Icon="@SgIcons.Check"   Text="Проверка"  Tooltip="Проверка данных"  OnClick="@(() => Log("Проверка"))" />
                        <SgRibbonButton Icon="@SgIcons.Sigma"   Text="Итоги"     Tooltip="Промежуточные итоги" OnClick="@(() => Log("Итоги"))" />
                        <SgRibbonButton Icon="@SgIcons.BarChart" Text="Анализ"   Tooltip="Анализ данных"    OnClick="@(() => Log("Анализ"))" Danger="true" />
                    </SgRibbonGroup>
                </SgRibbonTab>

                @* ── Вид ── *@
                <SgRibbonTab Title="Вид">
                    <SgRibbonGroup Title="Режимы">
                        <SgRibbonButton Icon="@SgIcons.FileText" Text="Обычный"    IsToggle="true" @bind-Pressed="_viewNormal"   OnClick="@(() => Log("Обычный режим"))" />
                        <SgRibbonButton Icon="@SgIcons.Copy"     Text="Разметка"   IsToggle="true" @bind-Pressed="_viewLayout"   OnClick="@(() => Log("Разметка страницы"))" />
                        <SgRibbonButton Icon="@SgIcons.BarChart" Text="Структура"  IsToggle="true" @bind-Pressed="_viewOutline"  OnClick="@(() => Log("Структура"))" />
                    </SgRibbonGroup>

                    <SgRibbonGroup Title="Показать">
                        <SgRibbonButton Icon="@SgIcons.Check" Text="Линейка"    Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_showRuler"  />
                        <SgRibbonButton Icon="@SgIcons.Check" Text="Сетка"      Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_showGrid"   />
                        <SgRibbonButton Icon="@SgIcons.Check" Text="Навигация"  Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_showNav"    />
                    </SgRibbonGroup>

                    <SgRibbonGroup Title="Масштаб">
                        <SgRibbonButton Icon="@SgIcons.Plus"     Text="Увеличить" Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Увеличить"))" />
                        <SgRibbonButton Icon="@SgIcons.ArrowDown" Text="100%"     Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("100%"))" />
                        <SgRibbonButton Icon="@SgIcons.X"        Text="Уменьшить" Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Уменьшить"))" />
                    </SgRibbonGroup>
                </SgRibbonTab>

                </ChildContent>
                <TabBarFarContent>
                    <SgButton Text="Справка" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
                </TabBarFarContent>
            </SgRibbon>
        </div>

        @if (_log.Count > 0)
        {
            <div style="margin-top: 12px; padding: 10px 14px; background: var(--sui-bg-secondary); border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); font-size: 12px; font-family: monospace; color: var(--sui-muted);">
                @foreach (var entry in _log)
                {
                    <div>▶ @entry</div>
                }
            </div>
        }
    </div>

    <div style="margin-top: 32px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
        <SgCard Title="Параметры SgRibbon">
            <PropertyTable Items="_ribbonProps" />
        </SgCard>
        <SgCard Title="Параметры SgRibbonButton">
            <PropertyTable Items="_buttonProps" />
        </SgCard>
    </div>

    <div style="margin-top: 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
        <SgCard Title="SgRibbonTab">
            <PropertyTable Items="_tabProps" />
        </SgCard>
        <SgCard Title="SgRibbonGroup / SgRibbonSplit">
            <PropertyTable Items="_groupProps" />
        </SgCard>
    </div>

</SgCard>

@code {
    private bool _collapsed;
    private bool _bold, _italic, _under;
    private bool _viewNormal = true, _viewLayout, _viewOutline;
    private bool _showRuler = true, _showGrid, _showNav;
    private readonly List<string> _log = new();

    private void Log(string msg)
    {
        _log.Insert(0, msg);
        if (_log.Count > 6) _log.RemoveAt(_log.Count - 1);
    }

    // ── Icon SVGs ─────────────────────────────────────────────────────────────
    private const string _boldIcon   = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z'/><path d='M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z'/></svg>";
    private const string _italicIcon = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><line x1='19' y1='4' x2='10' y2='4'/><line x1='14' y1='20' x2='5' y2='20'/><line x1='15' y1='4' x2='9' y2='20'/></svg>";
    private const string _underIcon  = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M6 3v7a6 6 0 0 0 6 6 6 6 0 0 0 6-6V3'/><line x1='4' y1='21' x2='20' y2='21'/></svg>";

    // ── Property tables ───────────────────────────────────────────────────────
    private List<PropertyPanelItem> _ribbonProps = new()
    {
        new() { Label = "Collapsed",        Value = "bool",             BadgeText = "Свёрнута",          BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "CollapsedChanged", Value = "EventCallback<bool>", BadgeText = "Изменение",      BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "AllowCollapse",    Value = "bool (default: true)", BadgeText = "Кнопка свернуть", BadgeVariant = SgBadgeVariant.Warn  },
        new() { Label = "AriaLabel",        Value = "string?",          BadgeText = "ARIA метка",        BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "TabBarFarContent", Value = "RenderFragment?",  BadgeText = "Правый слот",       BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "CssClass",         Value = "string?",          BadgeText = "CSS класс",         BadgeVariant = SgBadgeVariant.Info    },
    };

    private List<PropertyPanelItem> _buttonProps = new()
    {
        new() { Label = "Text",           Value = "string?",                    BadgeText = "Подпись",          BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Icon",           Value = "string? (SVG)",              BadgeText = "Иконка",           BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Size",           Value = "Large | Small",              BadgeText = "Размер",           BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Tooltip",        Value = "string?",                    BadgeText = "Подсказка",        BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Shortcut",       Value = "string?",                    BadgeText = "Горячая клавиша",  BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "IsToggle",       Value = "bool",                       BadgeText = "Переключатель",    BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Pressed",        Value = "bool",                       BadgeText = "Нажат",            BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Disabled",       Value = "bool",                       BadgeText = "Отключён",         BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Danger",         Value = "bool",                       BadgeText = "Опасное действие", BadgeVariant = SgBadgeVariant.Danger  },
        new() { Label = "OnClick",        Value = "EventCallback<MouseEventArgs>", BadgeText = "Клик",          BadgeVariant = SgBadgeVariant.Success },
    };

    private List<PropertyPanelItem> _tabProps = new()
    {
        new() { Label = "Title",    Value = "string (обязательно)", BadgeText = "Заголовок вкладки", BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "Icon",     Value = "string? (SVG)",        BadgeText = "Иконка",            BadgeVariant = SgBadgeVariant.Info   },
        new() { Label = "Highlight",Value = "bool",                 BadgeText = "Контекстная вкладка", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Disabled", Value = "bool",                 BadgeText = "Отключена",         BadgeVariant = SgBadgeVariant.Warn   },
    };

    private List<PropertyPanelItem> _groupProps = new()
    {
        new() { Label = "SgRibbonGroup.Title",          Value = "string?",          BadgeText = "Подпись группы",    BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "SgRibbonSplit.Text",           Value = "string?",          BadgeText = "Подпись кнопки",    BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "SgRibbonSplit.Icon",           Value = "string? (SVG)",    BadgeText = "Иконка",            BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "SgRibbonSplit.OnClick",        Value = "EventCallback",    BadgeText = "Основное действие", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "SgRibbonSplit.DropdownContent",Value = "RenderFragment?",  BadgeText = "Меню стрелки",      BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "SgRibbonSeparator",            Value = "—",                BadgeText = "Разделитель",       BadgeVariant = SgBadgeVariant.Info    },
    };
}
