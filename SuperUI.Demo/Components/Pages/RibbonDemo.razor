@page "/ribbon-demo"
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>Ribbon UI — SuperUI</PageTitle>

<SgCard Title="Ribbon — Лента инструментов"
        Subtitle="Интерфейс в стиле Office для приложений с большим количеством функций. Поддерживает вкладки, группы и адаптивные кнопки.">

    <div style="margin-top: 24px;">
        <h2 class="demo-section-title">Демонстрация Ribbon</h2>
        <p>Компактная панель с группировкой инструментов. Поддерживает сворачивание, контекстные вкладки и различные размеры кнопок.</p>

        <div style="margin-top: 16px; border: 1px solid var(--sg-border); border-radius: 8px; padding: 1px; background: var(--sg-surface-alt);">
            <SgRibbon @bind-Collapsed="_collapsed" AllowCollapse="true">
                <ChildContent>

                @* ── Главная ── *@
                <SgRibbonTab Title="Главная">
                    <SgRibbonGroup Title="Буфер обмена">
                        <SgRibbonSplit Icon="@SgIcons.Copy" Text="Вставить" Tooltip="Вставить (Ctrl+V)"
                                       OnClick="@(() => Log("Вставить"))">
                            <DropdownContent>
                                <button class="sgc-ribbon-menu-item" @onclick="@(() => Log("Вставить как текст"))">
                                    <span class="sgc-ribbon-btn-icon" style="font-size:16px; margin-right:8px;">@((MarkupString)SgIcons.FileText)</span> Вставить как текст
                                </button>
                                <button class="sgc-ribbon-menu-item" @onclick="@(() => Log("Специальная вставка"))">
                                    <span class="sgc-ribbon-btn-icon" style="font-size:16px; margin-right:8px;">@((MarkupString)SgIcons.Settings)</span> Специальная вставка…
                                </button>
                            </DropdownContent>
                        </SgRibbonSplit>
                        <div style="display:flex;flex-direction:column;gap:1px; min-width: 100px;">
                            <SgRibbonButton Icon="@SgIcons.Copy"   Text="Копировать"  Size="SgRibbonButtonSize.Small" Tooltip="Копировать (Ctrl+C)" OnClick="@(() => Log("Копировать"))" />
                            <SgRibbonButton Icon="@SgIcons.Edit"   Text="Вырезать"    Size="SgRibbonButtonSize.Small" Tooltip="Вырезать (Ctrl+X)"  OnClick="@(() => Log("Вырезать"))" />
                            <SgRibbonButton Icon="@SgIcons.Refresh" Text="Формат"     Size="SgRibbonButtonSize.Small" Tooltip="Копировать формат"   OnClick="@(() => Log("Формат"))" />
                        </div>
                    </SgRibbonGroup>

                    <SgRibbonGroup Title="Шрифт">
                        <SgRibbonButton Icon="@_boldIcon"   Text="Жирный"    Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_bold"   Tooltip="Жирный (Ctrl+B)" />
                        <SgRibbonButton Icon="@_italicIcon" Text="Курсив"    Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_italic" Tooltip="Курсив (Ctrl+I)" />
                        <SgRibbonButton Icon="@_underIcon"  Text="Подчеркнутый" Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_under" Tooltip="Подчёркнутый (Ctrl+U)" />
                        <SgRibbonSeparator />
                        <SgRibbonButton Icon="@SgIcons.ArrowUp"   Text="Увеличить" Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Увеличить шрифт"))" />
                        <SgRibbonButton Icon="@SgIcons.ArrowDown" Text="Уменьшить" Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Уменьшить шрифт"))" />
                    </SgRibbonGroup>

                    <SgRibbonGroup Title="Стили">
                        <SgRibbonButton Icon="@SgIcons.FileText" Text="Обычный"    Tooltip="Обычный стиль"    OnClick="@(() => Log("Обычный"))" />
                        <SgRibbonButton Icon="@SgIcons.FileText" Text="Заголовок 1" Tooltip="Заголовок 1"     OnClick="@(() => Log("Заголовок 1"))" />
                    </SgRibbonGroup>

                    <SgRibbonGroup Title="Редактирование">
                        <SgRibbonButton Icon="@SgIcons.Search"  Text="Найти"    Tooltip="Найти (Ctrl+F)"    OnClick="@(() => Log("Найти"))" />
                        <SgRibbonButton Icon="@SgIcons.Check"   Text="Выбрать"  Tooltip="Выбрать всё"       OnClick="@(() => Log("Выбрать всё"))" />
                    </SgRibbonGroup>
                </SgRibbonTab>

                @* ── Вставка ── *@
                <SgRibbonTab Title="Вставка">
                    <SgRibbonGroup Title="Объекты">
                        <SgRibbonSplit Icon="@SgIcons.Database" Text="Таблица" OnClick="@(() => Log("Вставить таблицу"))">
                            <DropdownContent>
                                <button class="sgc-ribbon-menu-item" @onclick="@(() => Log("Вставить таблицу"))">
                                    @((MarkupString)SgIcons.Database) Вставить таблицу…
                                </button>
                            </DropdownContent>
                        </SgRibbonSplit>
                        <SgRibbonButton Icon="@SgIcons.Download" Text="Рисунок"   Tooltip="Вставить рисунок"  OnClick="@(() => Log("Рисунок"))" />
                    </SgRibbonGroup>

                    <SgRibbonGroup Title="Ссылки">
                        <SgRibbonButton Icon="@SgIcons.ChevronRight" Text="Ссылка" OnClick="@(() => Log("Гиперссылка"))" />
                        <SgRibbonButton Icon="@SgIcons.FileText"     Text="Закладка"    OnClick="@(() => Log("Закладка"))" />
                    </SgRibbonGroup>
                </SgRibbonTab>

                @* ── Данные (контекстная вкладка) ── *@
                <SgRibbonTab Title="Данные" Highlight="true">
                    <SgRibbonGroup Title="Источник">
                        <SgRibbonButton Icon="@SgIcons.Database" Text="БД"  Tooltip="Подключить источник данных" OnClick="@(() => Log("Подключить"))" />
                        <SgRibbonButton Icon="@SgIcons.Refresh"  Text="Обновить"    Tooltip="Обновить данные"            OnClick="@(() => Log("Обновить"))" />
                    </SgRibbonGroup>

                    <SgRibbonGroup Title="Инструменты">
                        <SgRibbonButton Icon="@SgIcons.Check"   Text="Проверка"  Tooltip="Проверка данных"  OnClick="@(() => Log("Проверка"))" />
                        <SgRibbonButton Icon="@SgIcons.BarChart" Text="Анализ"   Tooltip="Анализ данных"    OnClick="@(() => Log("Анализ"))" Danger="true" />
                    </SgRibbonGroup>
                </SgRibbonTab>

                </ChildContent>
                <TabBarFarContent>
                    <SgButton Text="Справка" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
                </TabBarFarContent>
            </SgRibbon>
        </div>

        @if (_log.Count > 0)
        {
            <div class="ribbon-log-container">
                @foreach (var entry in _log)
                {
                    <div class="log-entry"><span class="log-bullet">▶</span> @entry</div>
                }
            </div>
        }
    </div>

    <div style="margin-top: 32px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
        <SgCard Title="Параметры SgRibbon" Shadow="SgShadow.Sm">
            <PropertyTable Items="_ribbonProps" />
        </SgCard>
        <SgCard Title="Параметры SgRibbonButton" Shadow="SgShadow.Sm">
            <PropertyTable Items="_buttonProps" />
        </SgCard>
    </div>

    <div style="margin-top: 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
        <SgCard Title="SgRibbonTab" Shadow="SgShadow.Sm">
            <PropertyTable Items="_tabProps" />
        </SgCard>
        <SgCard Title="SgRibbonGroup" Shadow="SgShadow.Sm">
            <PropertyTable Items="_groupProps" />
        </SgCard>
    </div>

</SgCard>

<style>
    .demo-section-title {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 12px;
        color: var(--sg-text);
    }

    .ribbon-log-container {
        margin-top: 12px;
        padding: 12px 16px;
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        font-size: 12px;
        font-family: 'Cascadia Code', 'Consolas', monospace;
        color: var(--sg-text-muted);
    }

    .log-entry {
        display: flex;
        gap: 8px;
        line-height: 1.6;
    }

    .log-bullet {
        color: var(--sg-primary);
        font-weight: bold;
    }

    .demo-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--sg-text-muted);
        margin-bottom: 8px;
        display: block;
        border-bottom: 1px solid var(--sg-border);
        padding-bottom: 4px;
    }
</style>

@code {
    private bool _collapsed;
    private bool _bold, _italic, _under;
    private readonly List<string> _log = new();

    private void Log(string msg)
    {
        _log.Insert(0, $"[{DateTime.Now:HH:mm:ss}] {msg}");
        if (_log.Count > 5) _log.RemoveAt(_log.Count - 1);
    }

    private const string _boldIcon   = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z'/><path d='M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z'/></svg>";
    private const string _italicIcon = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><line x1='19' y1='4' x2='10' y2='4'/><line x1='14' y1='20' x2='5' y2='20'/><line x1='15' y1='4' x2='9' y2='20'/></svg>";
    private const string _underIcon  = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M6 3v7a6 6 0 0 0 6 6 6 6 0 0 0 6-6V3'/><line x1='4' y1='21' x2='20' y2='21'/></svg>";

    private List<PropertyPanelItem> _ribbonProps = new()
    {
        new() { Label = "Collapsed",        Value = "bool",             BadgeText = "Свернута",          BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "AllowCollapse",    Value = "bool",             BadgeText = "Кнопка Toggle",     BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "TabBarFarContent", Value = "RenderFragment",   BadgeText = "Правый слот",       BadgeVariant = SgBadgeVariant.Info    },
    };

    private List<PropertyPanelItem> _buttonProps = new()
    {
        new() { Label = "Text",           Value = "string",         BadgeText = "Подпись",          BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Icon",           Value = "string (SVG)",   BadgeText = "Иконка",           BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Size",           Value = "Large | Small",  BadgeText = "Размер",           BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "IsToggle",       Value = "bool",           BadgeText = "Переключатель",    BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Danger",         Value = "bool",           BadgeText = "Danger Style",     BadgeVariant = SgBadgeVariant.Danger  },
    };

    private List<PropertyPanelItem> _tabProps = new()
    {
        new() { Label = "Title",    Value = "string", BadgeText = "Заголовок", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Highlight",Value = "bool",   BadgeText = "Контекстная", BadgeVariant = SgBadgeVariant.Warn },
    };

    private List<PropertyPanelItem> _groupProps = new()
    {
        new() { Label = "Title",    Value = "string", BadgeText = "Подпись группы", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "OnClick",  Value = "Event",  BadgeText = "Действие Split", BadgeVariant = SgBadgeVariant.Success },
    };
}
