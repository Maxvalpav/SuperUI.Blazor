@page "/ribbon-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>Ribbon — SuperUI</PageTitle>

<SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" Animated="true">
    <HeaderContent>
        <DemoPageHeader Title="Ribbon"
                        Subtitle="Office-style toolbar with tabs, groups, buttons, split buttons, file menu, contextual tab groups, and ribbon-styled inputs (color picker, combobox, checkbox)."
                        Icon="@SgHeroicons.Outline.RectangleStack"
                        GradientFrom="#006FEE"
                        GradientTo="#8b5cf6" />
    </HeaderContent>
    <ChildContent>

        @* ═══════════════════════════════════════════════════════════════════════
           SECTION 1: USAGE EXAMPLES (HERO)
           ═══════════════════════════════════════════════════════════════════════ *@
        <div class="rb-demo-page demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Usage Examples
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Full Office-style ribbon — 4 tabs, 4 groups (Clipboard, Font, Styles, Editing), contextual tab badge, and a far-right Help slot.
                </SgTypography>
            </div>

            <SgCard NoPadding="true" Shadow="SgShadow.Md" CssClass="rb-hero-card">
                <ChildContent>
                    <div class="rb-hero-b">B</div>
                    <div class="rb-hero-content">
                        <SgRibbon>
                            <ChildContent>
                                <SgRibbonFileMenu Text="File" Icon="@SgIcons.Folder" Tooltip="Application menu"
                                                  OnSelect="@(item => Log("File → " + (item.Text ?? "")))">
                                    <SgRibbonMenuSection Title="Recent">
                                        <SgRibbonMenuItem Text="Document.docx"   Icon="@SgIcons.FileText" Badge="2h"        BadgeVariant="SgBadgeVariant.Muted" />
                                        <SgRibbonMenuItem Text="Spreadsheet.xlsx" Icon="@SgIcons.Table"    Badge="yesterday" BadgeVariant="SgBadgeVariant.Muted" />
                                    </SgRibbonMenuSection>
                                    <SgRibbonMenuSeparator />
                                    <SgRibbonMenuSection Title="Commands">
                                        <SgRibbonMenuItem Text="New"        Icon="@SgIcons.FileText" Shortcut="Ctrl+N" />
                                        <SgRibbonMenuItem Text="Open…"      Icon="@SgIcons.Folder"   Shortcut="Ctrl+O" />
                                        <SgRibbonMenuItem Text="Save"       Icon="@SgIcons.Download" Shortcut="Ctrl+S" />
                                        <SgRibbonMenuItem Text="Save as…"   Icon="@SgIcons.Download" Shortcut="Ctrl+Shift+S" />
                                    </SgRibbonMenuSection>
                                    <SgRibbonMenuSeparator />
                                    <SgRibbonMenuItem Text="Exit" Icon="@SgIcons.X" Shortcut="Alt+F4" Danger="true" />
                                </SgRibbonFileMenu>
                                <SgRibbonTab Title="Home">
                                    <SgRibbonGroup Title="Clipboard" Icon="@SgIcons.Copy">
                                        <SgRibbonSplit Icon="@SgIcons.Copy" Text="Paste" Size="SgRibbonButtonSize.Medium"
                                                       OnClick="@(() => Log("Paste"))"
                                                       OnSelect="@(item => Log("Paste → " + (item.Text ?? "")))">
                                            <DropdownContent>
                                                <SgRibbonMenuItem Text="Paste"           Icon="@SgIcons.Copy"     Shortcut="Ctrl+V" />
                                                <SgRibbonMenuItem Text="Paste as plain"   Icon="@SgIcons.FileText" Shortcut="Ctrl+Shift+V" />
                                                <SgRibbonMenuSeparator />
                                                <SgRibbonMenuItem Text="Paste special…"   Icon="@SgIcons.Settings" />
                                            </DropdownContent>
                                        </SgRibbonSplit>
                                        <SgRibbonButton Icon="@SgIcons.Copy" Text="Copy"   Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Copy"))" />
                                        <SgRibbonButton Icon="@SgIcons.Edit" Text="Cut"    Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Cut"))" />
                                        <SgRibbonButton Icon="@SgIcons.Type" Text="Format" Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Format"))" />
                                    </SgRibbonGroup>
                                    <SgRibbonGroup Title="Font" Icon="@_boldIcon" Orientation="SgOrientation.Vertical">
                                        <SgRibbonButton Icon="@_boldIcon"   Text="B"          Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_bold"   KeyTip="B" Tooltip="Bold" />
                                        <SgRibbonButton Icon="@_italicIcon" Text="I"          Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_italic" KeyTip="I" Tooltip="Italic" />
                                        <SgRibbonButton Icon="@_underIcon"  Text="U"          Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_under"  KeyTip="U" Tooltip="Underline" />
                                        <SgRibbonButton Icon="@_fontUpIcon" Text="Increase"   Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Increase font"))" Tooltip="Increase font size" />
                                        <SgRibbonButton Icon="@_fontDnIcon" Text="Decrease"   Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Decrease font"))" Tooltip="Decrease font size" />
                                    </SgRibbonGroup>
                                    <SgRibbonGroup Title="Styles">
                                        <SgRibbonButton Icon="@SgIcons.Type"     Text="Normal"   Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Normal"))" />
                                        <SgRibbonButton Icon="@_headingIcon"   Text="Heading 1" Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Heading 1"))" />
                                    </SgRibbonGroup>
                                    <SgRibbonGroup Title="Editing">
                                        <SgRibbonButton Icon="@SgIcons.Search" Text="Find"   Size="SgRibbonButtonSize.Large" Shortcut="Ctrl+F" OnClick="@(() => Log("Find"))" />
                                        <SgRibbonButton Icon="@SgIcons.Check"  Text="Select" Size="SgRibbonButtonSize.Large" Shortcut="Ctrl+A" OnClick="@(() => Log("Select"))" />
                                    </SgRibbonGroup>
                                </SgRibbonTab>
                                <SgRibbonTab Title="Insert" Badge="New" BadgeVariant="SgBadgeVariant.Success">
                                    <SgRibbonGroup Title="Illustrations">
                                        <SgRibbonButton Icon="@SgIcons.Plus"      Text="Shape"  Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Shape"))" />
                                        <SgRibbonButton Icon="@SgIcons.Camera"   Text="Picture" Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Picture"))" />
                                        <SgRibbonButton Icon="@SgIcons.Star"     Text="Icon"   Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Icon"))" />
                                    </SgRibbonGroup>
                                    <SgRibbonGroup Title="Charts">
                                        <SgRibbonButton Icon="@SgIcons.BarChart"   Text="Column" Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Column chart"))" />
                                        <SgRibbonButton Icon="@SgIcons.TrendingUp" Text="Line"   Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Line chart"))" />
                                    </SgRibbonGroup>
                                </SgRibbonTab>
                                <SgRibbonTab Title="Data" Badge="5" BadgeVariant="SgBadgeVariant.Danger">
                                    <SgRibbonGroup Title="Get &amp; Transform">
                                        <SgRibbonButton Icon="@SgIcons.Database" Text="From Table" Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("From Table"))" />
                                        <SgRibbonButton Icon="@SgIcons.Refresh"  Text="Refresh"   Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Refresh"))" />
                                    </SgRibbonGroup>
                                    <SgRibbonGroup Title="Queries">
                                        <SgRibbonButton Icon="@SgIcons.Search"   Text="Query" Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Query"))" />
                                    </SgRibbonGroup>
                                </SgRibbonTab>
                                <SgRibbonTab Title="View">
                                    <SgRibbonGroup Title="Show">
                                        <SgRibbonButton Icon="@SgIcons.Monitor" Text="Layout" Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Layout"))" />
                                        <SgRibbonButton Icon="@SgIcons.Eye"     Text="Ruler"  Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Ruler"))" />
                                    </SgRibbonGroup>
                                </SgRibbonTab>
                            </ChildContent>
                            <TabBarFarContent>
                                <SgButton Text="Help" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" OnClick="@(() => Log("Help"))" />
                            </TabBarFarContent>
                        </SgRibbon>
                    </div>
                    <div class="rb-hero-log">
                        @if (_log.Count == 0)
                        {
                            <span class="rb-hero-log-empty">▸ Action log: click any ribbon control to see events here…</span>
                        }
                        else
                        {
                            @foreach (var line in _log)
                            {
                                <span class="rb-hero-log-line">@line</span>
                            }
                        }
                    </div>
                </ChildContent>
            </SgCard>
        </div>

        @* ═══════════════════════════════════════════════════════════════════════
           SECTION 2: BUTTONS & SIZES
           ═══════════════════════════════════════════════════════════════════════ *@
        <div class="rb-demo-page demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Buttons &amp; Sizes
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Three sizes (Large / Medium / Small), toggle mode, danger state, and disabled state.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="4">
                    <SgCard Title="Large Size" Subtitle="Icon + label stacked" Shadow="SgShadow.Sm" Compact="true">
                        <SgRibbon>
                            <ChildContent>
                                <SgRibbonTab Title="Home">
                                    <SgRibbonGroup Title="Editing">
                                        <SgRibbonButton Icon="@_boldIcon" Text="Bold" Size="SgRibbonButtonSize.Large" IsToggle="true" @bind-Pressed="_bold" KeyTip="B" />
                                        <SgRibbonButton Icon="@_italicIcon" Text="Italic" Size="SgRibbonButtonSize.Large" IsToggle="true" @bind-Pressed="_italic" KeyTip="I" />
                                        <SgRibbonButton Icon="@_underIcon" Text="Underline" Size="SgRibbonButtonSize.Large" IsToggle="true" @bind-Pressed="_under" KeyTip="U" />
                                    </SgRibbonGroup>
                                </SgRibbonTab>
                            </ChildContent>
                        </SgRibbon>
                        <div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap;">
                            <SgBadge Text="@("Bold: " + _boldState)" Variant="@_boldVariant" Standalone="true" />
                            <SgBadge Text="@("Italic: " + _italicState)" Variant="@_italicVariant" Standalone="true" />
                            <SgBadge Text="@("Underline: " + _underState)" Variant="@_underVariant" Standalone="true" />
                        </div>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Md="4">
                    <SgCard Title="Toggle &amp; States" Subtitle="Disabled, danger, pressed" Shadow="SgShadow.Sm" Compact="true">
                        <SgRibbon>
                            <ChildContent>
                                <SgRibbonTab Title="Home">
                                    <SgRibbonGroup Title="Tools">
                                        <SgRibbonButton Icon="@SgIcons.Download" Text="Save" Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Save"))" />
                                        <SgRibbonButton Icon="@SgIcons.Trash" Text="Delete" Size="SgRibbonButtonSize.Medium" Danger="true" OnClick="@(() => Log("Delete"))" />
                                        <SgRibbonButton Icon="@SgIcons.X" Text="Disabled" Size="SgRibbonButtonSize.Medium" Disabled="true" />
                                    </SgRibbonGroup>
                                    <SgRibbonGroup Title="Toggles">
                                        <SgRibbonButton Icon="@SgIcons.Check" Text="Bold" Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_bold" />
                                        <SgRibbonButton Icon="@SgIcons.Check" Text="Italic" Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_italic" />
                                    </SgRibbonGroup>
                                </SgRibbonTab>
                            </ChildContent>
                        </SgRibbon>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Md="4">
                    <SgCard Title="Medium &amp; Small" Subtitle="Compact button sizes" Shadow="SgShadow.Sm" Compact="true">
                        <SgRibbon>
                            <ChildContent>
                                <SgRibbonTab Title="Home">
                                    <SgRibbonGroup Title="Medium">
                                        <SgRibbonButton Icon="@SgIcons.Database" Text="Tables" Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Tables"))" />
                                        <SgRibbonButton Icon="@SgIcons.BarChart" Text="Charts" Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Charts"))" />
                                    </SgRibbonGroup>
                                    <SgRibbonGroup Title="Small">
                                        <SgRibbonButton Icon="@SgIcons.ArrowUp" Text="Up" Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Up"))" />
                                        <SgRibbonButton Icon="@SgIcons.ArrowDown" Text="Down" Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Down"))" />
                                    </SgRibbonGroup>
                                </SgRibbonTab>
                            </ChildContent>
                        </SgRibbon>
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

        @* ═══════════════════════════════════════════════════════════════════════
           SECTION 3: SPLIT BUTTONS & GROUPS
           ═══════════════════════════════════════════════════════════════════════ *@
        <div class="rb-demo-page demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Split Buttons &amp; Groups
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Split button (main + dropdown arrow), 5 placement variants, group launcher (↗), collapsible group.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="4">
                    <SgCard Title="Split Button Sizes" Subtitle="Large/Medium/Small + placement" Shadow="SgShadow.Sm" Compact="true">
                        <SgRibbon>
                            <ChildContent>
                                <SgRibbonTab Title="Home">
                                    <SgRibbonGroup Title="Clipboard">
                                        <SgRibbonSplit Icon="@SgIcons.Copy" Text="Paste" Size="SgRibbonButtonSize.Large"
                                                       OnClick="@(() => Log("Paste"))"
                                                       OnSelect="@(item => Log("Split → " + (item.Text ?? "")))">
                                            <DropdownContent>
                                                <SgRibbonMenuItem Text="Paste" Icon="@SgIcons.Copy" Shortcut="Ctrl+V" />
                                                <SgRibbonMenuItem Text="Paste as text" Icon="@SgIcons.FileText" Shortcut="Ctrl+Shift+V" />
                                                <SgRibbonMenuSeparator />
                                                <SgRibbonMenuItem Text="Paste special…" Icon="@SgIcons.Settings" />
                                            </DropdownContent>
                                        </SgRibbonSplit>
                                        <SgRibbonSplit Icon="@SgIcons.Download" Text="Save" Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Save"))">
                                            <DropdownContent>
                                                <SgRibbonMenuItem Text="Save" Icon="@SgIcons.Download" Shortcut="Ctrl+S" />
                                                <SgRibbonMenuItem Text="Save as…" Icon="@SgIcons.FileText" Shortcut="Ctrl+Shift+S" />
                                            </DropdownContent>
                                        </SgRibbonSplit>
                                        <SgRibbonSplit Icon="@SgIcons.Star" Text="Fav" Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Fav"))" Placement="SgRibbonSplitPlacement.BottomStart">
                                            <DropdownContent>
                                                <SgRibbonMenuItem Text="Add to favourites" Icon="@SgIcons.Star" />
                                                <SgRibbonMenuItem Text="Manage…" Icon="@SgIcons.Settings" />
                                            </DropdownContent>
                                        </SgRibbonSplit>
                                    </SgRibbonGroup>
                                </SgRibbonTab>
                            </ChildContent>
                        </SgRibbon>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Md="8">
                    <SgCard Title="Multi-Group Ribbon" Subtitle="Home tab with 4 groups + launcher + collapsible" Shadow="SgShadow.Sm" Compact="true">
                        <SgRibbon @bind-Collapsed="_s3Collapsed" AllowCollapse="true">
                            <ChildContent>
                                <SgRibbonTab Title="Home">
                                    <SgRibbonGroup Title="Clipboard" Icon="@SgIcons.Copy" Collapsible="true" @bind-Collapsed="_s3GrpClip"
                                                   OnLauncherClick="@(() => Log("Clipboard launcher"))">
                                        <SgRibbonSplit Icon="@SgIcons.Copy" Text="Paste" Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Paste"))">
                                            <DropdownContent>
                                                <SgRibbonMenuItem Text="Paste" Shortcut="Ctrl+V" />
                                                <SgRibbonMenuItem Text="Paste special…" />
                                            </DropdownContent>
                                        </SgRibbonSplit>
                                        <SgRibbonButton Icon="@SgIcons.Copy" Text="Copy" Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Copy"))" />
                                        <SgRibbonButton Icon="@SgIcons.Edit" Text="Cut" Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Cut"))" />
                                    </SgRibbonGroup>
                                    <SgRibbonGroup Title="Font" Icon="@_boldIcon" Orientation="SgOrientation.Vertical">
                                        <SgRibbonButton Icon="@_boldIcon"   Text="Bold"      Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_bold" />
                                        <SgRibbonButton Icon="@_italicIcon" Text="Italic"    Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_italic" />
                                        <SgRibbonButton Icon="@_underIcon"  Text="Underline" Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_under" />
                                    </SgRibbonGroup>
                                    <SgRibbonGroup Title="Styles" OnLauncherClick="@(() => Log("Styles launcher"))">
                                        <SgRibbonButton Icon="@SgIcons.Type" Text="Normal" Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Normal"))" />
                                        <SgRibbonButton Icon="@SgIcons.FileText" Text="Heading" Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Heading"))" />
                                    </SgRibbonGroup>
                                    <SgRibbonGroup Title="Editing">
                                        <SgRibbonButton Icon="@SgIcons.Search" Text="Find" Size="SgRibbonButtonSize.Large" Shortcut="Ctrl+F" OnClick="@(() => Log("Find"))" />
                                        <SgRibbonButton Icon="@SgIcons.Check" Text="Select" Size="SgRibbonButtonSize.Large" Shortcut="Ctrl+A" OnClick="@(() => Log("Select"))" />
                                    </SgRibbonGroup>
                                </SgRibbonTab>
                            </ChildContent>
                        </SgRibbon>
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

        @* ═══════════════════════════════════════════════════════════════════════
           SECTION 4: FILE MENU & APPLICATION MENU
           ═══════════════════════════════════════════════════════════════════════ *@
        <div class="rb-demo-page demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    File Menu &amp; Application Menu
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Office-style application button at the start of the tab bar. Opens a dropdown with sections, separators, shortcuts, and badges. Try Escape / click-outside.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Md">
                <SgCol Xs="12">
                    <SgCard Title="SgRibbonFileMenu" Subtitle="Click 'File' to open · Esc or click-outside to close" Shadow="SgShadow.Sm" Compact="true">
                        <SgRibbon>
                            <ChildContent>
                                <SgRibbonFileMenu Text="File" Icon="@SgIcons.Folder" Tooltip="Application menu" OnSelect="@(item => Log("Menu → " + (item.Text ?? "")))">
                                    <SgRibbonMenuSection Title="Recent">
                                        <SgRibbonMenuItem Text="Document.docx" Icon="@SgIcons.FileText" Badge="2h" BadgeVariant="SgBadgeVariant.Muted" />
                                        <SgRibbonMenuItem Text="Spreadsheet.xlsx" Icon="@SgIcons.Table" Badge="yesterday" BadgeVariant="SgBadgeVariant.Muted" />
                                        <SgRibbonMenuItem Text="Presentation.pptx" Icon="@SgIcons.Monitor" Badge="3 days" BadgeVariant="SgBadgeVariant.Muted" />
                                    </SgRibbonMenuSection>
                                    <SgRibbonMenuSeparator />
                                    <SgRibbonMenuSection Title="Commands">
                                        <SgRibbonMenuItem Text="New" Icon="@SgIcons.FileText" Shortcut="Ctrl+N" />
                                        <SgRibbonMenuItem Text="Open…" Icon="@SgIcons.Folder" Shortcut="Ctrl+O" />
                                        <SgRibbonMenuItem Text="Save" Icon="@SgIcons.Download" Shortcut="Ctrl+S" />
                                        <SgRibbonMenuItem Text="Save as…" Icon="@SgIcons.Download" Shortcut="Ctrl+Shift+S" Badge="Beta" BadgeVariant="SgBadgeVariant.Warn" />
                                    </SgRibbonMenuSection>
                                    <SgRibbonMenuSeparator />
                                    <SgRibbonMenuSection Title="Danger zone">
                                        <SgRibbonMenuItem Text="Close" Icon="@SgIcons.X" Shortcut="Ctrl+W" />
                                        <SgRibbonMenuItem Text="Delete account" Icon="@SgIcons.Trash" Disabled="true" />
                                    </SgRibbonMenuSection>
                                </SgRibbonFileMenu>
                                <SgRibbonTab Title="Home">
                                    <SgRibbonGroup Title="Editing">
                                        <SgRibbonButton Icon="@SgIcons.Download" Text="Save" Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Save"))" />
                                        <SgRibbonButton Icon="@SgIcons.Download" Text="Export" Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Export"))" />
                                    </SgRibbonGroup>
                                </SgRibbonTab>
                            </ChildContent>
                        </SgRibbon>
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

        @* ═══════════════════════════════════════════════════════════════════════
           SECTION 5: CONTEXTUAL TABS & EXTENDED ITEMS
           ═══════════════════════════════════════════════════════════════════════ *@
        <div class="rb-demo-page demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Contextual Tabs &amp; Extended Items
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Contextual tab groups (appear conditionally with accent colour), plus ribbon-styled ColorPicker, ComboBox, and CheckBox.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="6">
                    <SgCard Title="Contextual Tabs" Subtitle="3 colour variants, conditionally visible" Shadow="SgShadow.Sm" Compact="true">
                        <SgRibbon>
                            <ChildContent>
                                <SgRibbonTab Title="Home">
                                    <SgRibbonGroup Title="Editing">
                                        <SgRibbonButton Icon="@SgIcons.Download" Text="Save" Size="SgRibbonButtonSize.Medium" />
                                    </SgRibbonGroup>
                                </SgRibbonTab>
                                <SgRibbonContextualTabs Color="SgContextualColor.Magenta">
                                    <SgRibbonTab Title="Image Format" Highlight="true">
                                        <SgRibbonGroup Title="Adjust">
                                            <SgRibbonButton Icon="@SgIcons.Camera" Text="Crop" Size="SgRibbonButtonSize.Medium" />
                                            <SgRibbonButton Icon="@SgIcons.Palette" Text="Color" Size="SgRibbonButtonSize.Medium" />
                                        </SgRibbonGroup>
                                    </SgRibbonTab>
                                </SgRibbonContextualTabs>
                                <SgRibbonContextualTabs Color="SgContextualColor.Blue">
                                    <SgRibbonTab Title="Chart Design" Highlight="true">
                                        <SgRibbonGroup Title="Type">
                                            <SgRibbonButton Icon="@SgIcons.BarChart" Text="Column" Size="SgRibbonButtonSize.Medium" />
                                            <SgRibbonButton Icon="@SgIcons.TrendingUp" Text="Line" Size="SgRibbonButtonSize.Medium" />
                                        </SgRibbonGroup>
                                    </SgRibbonTab>
                                </SgRibbonContextualTabs>
                                <SgRibbonContextualTabs Color="SgContextualColor.Green">
                                    <SgRibbonTab Title="Table Tools" Highlight="true">
                                        <SgRibbonGroup Title="Style">
                                            <SgRibbonButton Icon="@SgIcons.Table" Text="Format" Size="SgRibbonButtonSize.Medium" />
                                            <SgRibbonButton Icon="@SgIcons.Check" Text="Validate" Size="SgRibbonButtonSize.Medium" />
                                        </SgRibbonGroup>
                                    </SgRibbonTab>
                                </SgRibbonContextualTabs>
                            </ChildContent>
                        </SgRibbon>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Md="6">
                    <SgCard Title="Extended Items" Subtitle="ColorPicker + ComboBox + CheckBox" Shadow="SgShadow.Sm" Compact="true">
                        <SgRibbon>
                            <ChildContent>
                                <SgRibbonTab Title="Format">
                                    <SgRibbonGroup Title="Color">
                                        <SgRibbonColorPicker @bind-Value="_s5Color1" Preset="SgColorPreset.Standard" Tooltip="Standard palette" />
                                        <SgRibbonColorPicker @bind-Value="_s5Color2" Preset="SgColorPreset.Theme" Tooltip="Theme palette" />
                                        <SgRibbonColorPicker @bind-Value="_s5Color3" Preset="SgColorPreset.Grayscale" Tooltip="Grayscale" />
                                    </SgRibbonGroup>
                                    <SgRibbonGroup Title="Style">
                                        <SgRibbonComboBox @bind-Value="_s5Style" Items="@_s5Styles" Placeholder="Choose style" KeyTip="S" />
                                        <SgRibbonComboBox @bind-Value="_s5Font" Items="@_s5Fonts" Placeholder="Font" Width="120px" />
                                    </SgRibbonGroup>
                                    <SgRibbonGroup Title="Options">
                                        <SgRibbonCheckBox @bind-Value="_s5Bold" Label="Bold" />
                                        <SgRibbonCheckBox @bind-Value="_s5Italic" Label="Italic" />
                                        <SgRibbonCheckBox @bind-Value="_s5Underline" Label="Underline" Disabled="true" />
                                    </SgRibbonGroup>
                                </SgRibbonTab>
                            </ChildContent>
                        </SgRibbon>
                        <div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap;align-items:center;">
                            <SgBadge Text="@("Color1: " + _s5Color1)" Variant="SgBadgeVariant.Info" Standalone="true" />
                            <SgBadge Text="@("Color2: " + _s5Color2)" Variant="SgBadgeVariant.Info" Standalone="true" />
                            <SgBadge Text="@("Style: " + (_s5Style ?? "—"))" Variant="SgBadgeVariant.Muted" Standalone="true" />
                            <SgBadge Text="@("Font: " + (_s5Font ?? "—"))" Variant="SgBadgeVariant.Muted" Standalone="true" />
                        </div>
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

        @* ═══════════════════════════════════════════════════════════════════════
           SECTION 6: ADVANCED USE CASES
           ═══════════════════════════════════════════════════════════════════════ *@
        <div class="rb-demo-page demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Advanced Use Cases
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Mini toolbar (toolwindow), form mode (vertical group with launcher), and programmatic API via <code>&#64;ref</code>.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="4">
                    <SgCard Title="Mini Toolbar" Subtitle="Compact ribbon for toolwindows" Shadow="SgShadow.Sm" Compact="true">
                        <div class="rb-mini-toolbar">
                            <SgRibbon ShowScrollArrows="false" AllowCollapse="false">
                                <ChildContent>
                                    <SgRibbonTab Title="Format">
                                        <SgRibbonGroup Title="Style">
                                            <SgRibbonButton Icon="@_boldIcon"   Text="B" Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_bold"   Tooltip="Bold" />
                                            <SgRibbonButton Icon="@_italicIcon" Text="I" Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_italic" Tooltip="Italic" />
                                            <SgRibbonButton Icon="@_underIcon"  Text="U" Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_under"  Tooltip="Underline" />
                                        </SgRibbonGroup>
                                    </SgRibbonTab>
                                    <SgRibbonTab Title="Insert">
                                        <SgRibbonGroup Title="Add">
                                            <SgRibbonButton Icon="@SgIcons.Plus"    Text="Add" Size="SgRibbonButtonSize.Small" />
                                            <SgRibbonButton Icon="@SgIcons.Database" Text="Row" Size="SgRibbonButtonSize.Small" />
                                        </SgRibbonGroup>
                                    </SgRibbonTab>
                                </ChildContent>
                            </SgRibbon>
                        </div>
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Style="margin-top:8px;display:block;">
                            Use <code>ShowScrollArrows="false"</code> + <code>AllowCollapse="false"</code> to keep it tight.
                        </SgTypography>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Md="4">
                    <SgCard Title="Form Mode" Subtitle="Vertical group + launcher + overflow" Shadow="SgShadow.Sm" Compact="true">
                        <SgRibbon @ref="_formRibbon" AllowCollapse="true">
                            <ChildContent>
                                <SgRibbonTab Title="Properties">
                                    <SgRibbonGroup Title="Layout" Orientation="SgOrientation.Vertical" Collapsible="true"
                                                   @bind-Collapsed="_s6FormCollapsed" OverflowText="Layout (collapsed)"
                                                   OnLauncherClick="@(() => Log("Layout launcher"))">
                                        <SgRibbonButton Icon="@SgIcons.ArrowUp"   Text="Top"    Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Align top"))" />
                                        <SgRibbonButton Icon="@SgIcons.Layout"   Text="Center" Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Center"))" />
                                        <SgRibbonButton Icon="@SgIcons.ArrowDown" Text="Bottom" Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Align bottom"))" />
                                    </SgRibbonGroup>
                                </SgRibbonTab>
                            </ChildContent>
                        </SgRibbon>
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Style="margin-top:8px;display:block;">
                            Click the layout group label to collapse/expand. The collapsed state shows the <code>OverflowText</code> tooltip.
                        </SgTypography>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Md="4">
                    <SgCard Title="Programmatic API" Subtitle="Drive the ribbon from code" Shadow="SgShadow.Sm" Compact="true">
                        <SgRibbon @ref="_progRibbon">
                            <ChildContent>
                                <SgRibbonTab Title="Home">
                                    <SgRibbonGroup Title="Actions">
                                        <SgRibbonButton Icon="@SgIcons.Home"   Text="Home"  Size="SgRibbonButtonSize.Medium" />
                                    </SgRibbonGroup>
                                </SgRibbonTab>
                                <SgRibbonTab Title="Insert">
                                    <SgRibbonGroup Title="Actions">
                                        <SgRibbonButton Icon="@SgIcons.Plus"   Text="Add"   Size="SgRibbonButtonSize.Medium" />
                                    </SgRibbonGroup>
                                </SgRibbonTab>
                                <SgRibbonTab Title="View">
                                    <SgRibbonGroup Title="Actions">
                                        <SgRibbonButton Icon="@SgIcons.Monitor" Text="View" Size="SgRibbonButtonSize.Medium" />
                                    </SgRibbonGroup>
                                </SgRibbonTab>
                            </ChildContent>
                        </SgRibbon>
                        <div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap;">
                            <SgButton Text="Activate 'Insert'" Size="SgSize.Sm" Variant="SgButtonVariant.Outlined" OnClick="@(() => _progRibbon?.ActivateTabByTitle("Insert"))" />
                            <SgButton Text="Collapse"           Size="SgSize.Sm" Variant="SgButtonVariant.Outlined" OnClick="@(() => _progRibbon?.SetCollapsed(true))" />
                            <SgButton Text="Expand"             Size="SgSize.Sm" Variant="SgButtonVariant.Outlined" OnClick="@(() => _progRibbon?.SetCollapsed(false))" />
                        </div>
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Style="margin-top:8px;display:block;">
                            Use <code>ribbonRef.ActivateTabByTitle("…")</code> and <code>ribbonRef.SetCollapsed(bool)</code>.
                        </SgTypography>
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

        @* ═══════════════════════════════════════════════════════════════════════
           SECTION 7: LIVE RIBBON CONSTRUCTOR
           ═══════════════════════════════════════════════════════════════════════ *@
        <div class="rb-demo-page demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Live Ribbon Constructor
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Configure the active tab, contextual color, badge, and behaviour on the left. The preview and generated code on the right update live.
                </SgTypography>
            </div>

            <SgCard NoPadding="true" Shadow="SgShadow.Md" Radius="SgSize.Lg">
                <ChildContent>
                    <SgRow Space="SgSize.Md">
                        <SgCol Xs="12" Md="5" Style="padding:14px;border-right:1px solid var(--sg-border);">
                            <SgStack Vertical="true" Space="SgSize.Md">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                    Active tab
                                </SgTypography>
                                <SgSegmented TValue="int" Value="_ctorActiveTab" ValueChanged="v => { _ctorActiveTab = v; UpdateCtorCode(); }" Block="true" Size="sm" Options="_ctorTabOpts" />

                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                    Contextual
                                </SgTypography>
                                <SgSegmented TValue="bool" Value="_ctorContextual" ValueChanged="v => { _ctorContextual = v; UpdateCtorCode(); }" Block="true" Size="sm" Options="_ctorBoolOpts" />

                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                    Tab badge
                                </SgTypography>
                                <SgSegmented TValue="string" Value="_ctorBadgeKind" ValueChanged="v => { _ctorBadgeKind = v; UpdateCtorCode(); }" Block="true" Size="sm" Options="_ctorBadgeOpts" />

                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                    Behaviour
                                </SgTypography>
                                <SgStack Vertical="true" Space="SgSize.Sm">
                                    <SgStack Horizontal="true" Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">AllowCollapse</SgTypography>
                                        <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorAllowCollapse.ToString()" Standalone="true" />
                                    </SgStack>
                                    <SgSegmented TValue="bool" Value="_ctorAllowCollapse" ValueChanged="v => { _ctorAllowCollapse = v; UpdateCtorCode(); }" Block="true" Size="sm" Options="_ctorBoolOpts" />
                                </SgStack>
                                <SgStack Vertical="true" Space="SgSize.Sm">
                                    <SgStack Horizontal="true" Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">ShowScrollArrows</SgTypography>
                                        <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorScrollArrows.ToString()" Standalone="true" />
                                    </SgStack>
                                    <SgSegmented TValue="bool" Value="_ctorScrollArrows" ValueChanged="v => { _ctorScrollArrows = v; UpdateCtorCode(); }" Block="true" Size="sm" Options="_ctorBoolOpts" />
                                </SgStack>
                                <SgStack Vertical="true" Space="SgSize.Sm">
                                    <SgStack Horizontal="true" Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Animate</SgTypography>
                                        <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorAnimate.ToString()" Standalone="true" />
                                    </SgStack>
                                    <SgSegmented TValue="bool" Value="_ctorAnimate" ValueChanged="v => { _ctorAnimate = v; UpdateCtorCode(); }" Block="true" Size="sm" Options="_ctorBoolOpts" />
                                </SgStack>
                            </SgStack>
                        </SgCol>

                        <SgCol Xs="12" Md="7" Style="padding:14px;">
                            <SgStack Vertical="true" Space="SgSize.Lg">
                                <SgStack Vertical="true" Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                        Result
                                    </SgTypography>
                                    <div class="constructor-preview">
                                        <SgRibbon ActiveTabIndex="@_ctorActiveTab"
                                                  AllowCollapse="@_ctorAllowCollapse"
                                                  ShowScrollArrows="@_ctorScrollArrows"
                                                  Animate="@_ctorAnimate">
                                            <ChildContent>
                                                <SgRibbonFileMenu Text="File" Icon="@SgIcons.Folder">
                                                    <SgRibbonMenuItem Text="New" Icon="@SgIcons.FileText" Shortcut="Ctrl+N" OnClick="@(() => Log("New"))" />
                                                    <SgRibbonMenuItem Text="Open…" Icon="@SgIcons.Folder" Shortcut="Ctrl+O" OnClick="@(() => Log("Open"))" />
                                                </SgRibbonFileMenu>
                                                <SgRibbonTab Title="Home">
                                                    <SgRibbonGroup Title="Clipboard">
                                                        <SgRibbonButton Icon="@SgIcons.Copy" Text="Copy" Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Copy"))" />
                                                    </SgRibbonGroup>
                                                </SgRibbonTab>
                                                <SgRibbonTab Title="Insert" Badge="@_ctorBadge" BadgeVariant="SgBadgeVariant.Success">
                                                    <SgRibbonGroup Title="Objects">
                                                        <SgRibbonButton Icon="@SgIcons.Plus" Text="Add" Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Add"))" />
                                                    </SgRibbonGroup>
                                                </SgRibbonTab>
                                                @if (_ctorContextual)
                                                {
                                                    <SgRibbonContextualTabs Color="SgContextualColor.Blue">
                                                        <SgRibbonTab Title="Chart Design" Highlight="true">
                                                            <SgRibbonGroup Title="Type">
                                                                <SgRibbonButton Icon="@SgIcons.BarChart" Text="Column" Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Column"))" />
                                                            </SgRibbonGroup>
                                                        </SgRibbonTab>
                                                    </SgRibbonContextualTabs>
                                                }
                                            </ChildContent>
                                        </SgRibbon>
                                    </div>
                                </SgStack>

                                <SgStack Vertical="true" Space="SgSize.Sm">
                                    <div style="display:flex;align-items:center;justify-content:space-between;">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                            Generated Code
                                        </SgTypography>
                                        <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCtorCode">
                                            <span>@_copyIcon</span>
                                            <span style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                        </button>
                                    </div>
                                    <div class="code-block">
                                        @foreach (var line in _ctorCodeLines)
                                        {
                                            <code>@line</code>
                                        }
                                    </div>
                                </SgStack>
                            </SgStack>
                        </SgCol>
                    </SgRow>
                </ChildContent>
            </SgCard>
        </div>

        @* ═══════════════════════════════════════════════════════════════════════
           SECTION 8: API QUICK REFERENCE
           ═══════════════════════════════════════════════════════════════════════ *@
        <div class="rb-demo-page demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    API Quick Reference
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="6">
                    <SgCard Title="SgRibbon" Shadow="SgShadow.Sm" Compact="true"><PropertyTable Items="_ribbonProps" /></SgCard>
                </SgCol>
                <SgCol Xs="12" Md="6">
                    <SgCard Title="SgRibbonTab" Shadow="SgShadow.Sm" Compact="true"><PropertyTable Items="_tabProps" /></SgCard>
                </SgCol>
            </SgRow>
            <SgRow Space="SgSize.Md" Style="margin-top:12px;">
                <SgCol Xs="12" Md="6">
                    <SgCard Title="SgRibbonGroup" Shadow="SgShadow.Sm" Compact="true"><PropertyTable Items="_groupProps" /></SgCard>
                </SgCol>
                <SgCol Xs="12" Md="6">
                    <SgCard Title="SgRibbonButton" Shadow="SgShadow.Sm" Compact="true"><PropertyTable Items="_buttonProps" /></SgCard>
                </SgCol>
            </SgRow>
            <SgRow Space="SgSize.Md" Style="margin-top:12px;">
                <SgCol Xs="12" Md="6">
                    <SgCard Title="SgRibbonSplit" Shadow="SgShadow.Sm" Compact="true"><PropertyTable Items="_splitProps" /></SgCard>
                </SgCol>
                <SgCol Xs="12" Md="6">
                    <SgCard Title="SgRibbonFileMenu" Shadow="SgShadow.Sm" Compact="true"><PropertyTable Items="_fileMenuProps" /></SgCard>
                </SgCol>
            </SgRow>
            <SgRow Space="SgSize.Md" Style="margin-top:12px;">
                <SgCol Xs="12" Md="6">
                    <SgCard Title="SgRibbonContextualTabs" Shadow="SgShadow.Sm" Compact="true"><PropertyTable Items="_ctxTabsProps" /></SgCard>
                </SgCol>
                <SgCol Xs="12" Md="6">
                    <SgCard Title="SgRibbonColorPicker / ComboBox / CheckBox" Shadow="SgShadow.Sm" Compact="true"><PropertyTable Items="_extrasProps" /></SgCard>
                </SgCol>
            </SgRow>
        </div>

    </ChildContent>
</SgCard>

@code {
    // ═══════════════════════════════════════════════════════════════════════════
    // REFS
    // ═══════════════════════════════════════════════════════════════════════════
    private SgRibbon? _progRibbon;
    private SgRibbon? _formRibbon;

    // ═══════════════════════════════════════════════════════════════════════════
    // SECTION STATE
    // ═══════════════════════════════════════════════════════════════════════════
    private bool _s1Collapsed;
    private bool _s3Collapsed;
    private bool _s3GrpClip;
    private bool _s6FormCollapsed;

    private string _s5Color1 = "#006FEE";
    private string _s5Color2 = "#8b5cf6";
    private string _s5Color3 = "#404040";
    private string? _s5Style;
    private string? _s5Font;
    private bool _s5Bold = true;
    private bool _s5Italic;
    private bool _s5Underline;

    private readonly List<string> _s5Styles = new() { "Normal", "Heading 1", "Heading 2", "Quote", "Code" };
    private readonly List<string> _s5Fonts  = new() { "Arial", "Calibri", "Segoe UI", "Verdana" };

    private bool _bold, _italic, _under;
    private readonly List<string> _log = new();

    private void Log(string msg)
    {
        _log.Insert(0, $"[{DateTime.Now:HH:mm:ss}] {msg}");
        if (_log.Count > 5) _log.RemoveAt(_log.Count - 1);
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // SVG ICONS (Bold/Italic/Underline not in SgIcons)
    // ═══════════════════════════════════════════════════════════════════════════
    private const string _boldIcon   = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z'/><path d='M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z'/></svg>";
    private const string _italicIcon = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><line x1='19' y1='4' x2='10' y2='4'/><line x1='14' y1='20' x2='5' y2='20'/><line x1='15' y1='4' x2='9' y2='20'/></svg>";
    private const string _underIcon  = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M6 3v7a6 6 0 0 0 6 6 6 6 0 0 0 6-6V3'/><line x1='4' y1='21' x2='20' y2='21'/></svg>";
    private const string _fontUpIcon = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 15 12 9 18 15'/></svg>";
    private const string _fontDnIcon = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>";
    private const string _headingIcon = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M6 4v16M18 4v16M6 12h12'/></svg>";

    private string _boldState => _bold ? "ON" : "OFF";
    private string _italicState => _italic ? "ON" : "OFF";
    private string _underState => _under ? "ON" : "OFF";
    private SgBadgeVariant _boldVariant => _bold ? SgBadgeVariant.Info : SgBadgeVariant.Muted;
    private SgBadgeVariant _italicVariant => _italic ? SgBadgeVariant.Info : SgBadgeVariant.Muted;
    private SgBadgeVariant _underVariant => _under ? SgBadgeVariant.Info : SgBadgeVariant.Muted;

    // ═══════════════════════════════════════════════════════════════════════════
    // LIVE CONSTRUCTOR STATE
    // ═══════════════════════════════════════════════════════════════════════════
    private int _ctorActiveTab;
    private bool _ctorContextual = true;
    private string _ctorBadgeKind = "New";
    private bool _ctorAllowCollapse = true;
    private bool _ctorScrollArrows = true;
    private bool _ctorAnimate = true;
    private string[] _ctorCodeLines = Array.Empty<string>();
    private string _copyIcon = "📋";
    private string _copyLabel = "Copy";

    private string? _ctorBadge => _ctorBadgeKind == "None" ? null : _ctorBadgeKind;

    private readonly List<SgSegmentedOption<int>> _ctorTabOpts = new()
    {
        new() { Value = 0, Label = "File" },
        new() { Value = 1, Label = "Home" },
        new() { Value = 2, Label = "Insert" },
        new() { Value = 3, Label = "Chart" },
    };
    private readonly List<SgSegmentedOption<bool>> _ctorBoolOpts = new()
    {
        new() { Value = true,  Label = "On"  },
        new() { Value = false, Label = "Off" },
    };
    private readonly List<SgSegmentedOption<string>> _ctorBadgeOpts = new()
    {
        new() { Value = "None", Label = "None" },
        new() { Value = "New",  Label = "New"  },
        new() { Value = "Beta", Label = "Beta" },
        new() { Value = "5",    Label = "5"    },
    };

    protected override void OnInitialized()
    {
        UpdateCtorCode();
    }

    private void UpdateCtorCode()
    {
        var lines = new List<string>
        {
            "<SgRibbon"
        };
        lines.Add($"         ActiveTabIndex=\"{_ctorActiveTab}\"");
        if (!_ctorAllowCollapse) lines.Add("         AllowCollapse=\"false\"");
        if (!_ctorScrollArrows) lines.Add("         ShowScrollArrows=\"false\"");
        if (!_ctorAnimate)       lines.Add("         Animate=\"false\"");
        lines.Add("         OnTabSelecting=\"@(args => Console.WriteLine(args.Tab.Title))\">");
        lines.Add("    <ChildContent>");
        lines.Add("        <SgRibbonFileMenu Text=\"File\" Icon=\"@SgIcons.Folder\">");
        lines.Add("            <SgRibbonMenuItem Text=\"New\" Shortcut=\"Ctrl+N\" />");
        lines.Add("        </SgRibbonFileMenu>");
        lines.Add("        <SgRibbonTab Title=\"Home\">");
        lines.Add("            <SgRibbonGroup Title=\"Clipboard\">");
        lines.Add("                <SgRibbonButton Icon=\"@SgIcons.Copy\" Text=\"Copy\" Size=\"SgRibbonButtonSize.Medium\" OnClick=\"@(() => ...)\" />");
        lines.Add("            </SgRibbonGroup>");
        lines.Add("        </SgRibbonTab>");
        if (_ctorBadge is null)
        {
            lines.Add("        <SgRibbonTab Title=\"Insert\">");
        }
        else
        {
            lines.Add($"        <SgRibbonTab Title=\"Insert\" Badge=\"{_ctorBadge}\" BadgeVariant=\"SgBadgeVariant.Success\">");
        }
        lines.Add("            <SgRibbonGroup Title=\"Objects\">");
        lines.Add("                <SgRibbonButton Icon=\"@SgIcons.Plus\" Text=\"Add\" Size=\"SgRibbonButtonSize.Medium\" />");
        lines.Add("            </SgRibbonGroup>");
        lines.Add("        </SgRibbonTab>");
        if (_ctorContextual)
        {
            lines.Add("        <SgRibbonContextualTabs Color=\"SgContextualColor.Blue\">");
            lines.Add("            <SgRibbonTab Title=\"Chart Design\" Highlight=\"true\">");
            lines.Add("                <SgRibbonGroup Title=\"Type\">");
            lines.Add("                    <SgRibbonButton Icon=\"@SgIcons.BarChart\" Text=\"Column\" Size=\"SgRibbonButtonSize.Medium\" />");
            lines.Add("                </SgRibbonGroup>");
            lines.Add("            </SgRibbonTab>");
            lines.Add("        </SgRibbonContextualTabs>");
        }
        lines.Add("    </ChildContent>");
        lines.Add("</SgRibbon>");
        _ctorCodeLines = lines.ToArray();
    }

    private async Task CopyCtorCode()
    {
        try
        {
            var code = string.Join("\n", _ctorCodeLines);
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

