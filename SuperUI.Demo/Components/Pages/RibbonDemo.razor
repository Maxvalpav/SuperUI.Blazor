@page "/ribbon-demo"
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>Ribbon UI — SuperUI</PageTitle>

<SgCard Title="Ribbon — Лента инструментов"
        Subtitle="Интерфейс в стиле Office для приложений с большим количеством функций. Поддерживает вкладки, группы и адаптивные кнопки."
        CssClass="sgc-card-flush">

    @* ── Interactive Demo ─────────────────────────────────────────────────── *@
    <div class="sgc-demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading2">Interactive Demo</SgTypography>
            <span class="demo-live-badge">Interactive</span>
        </div>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" CssClass="demo-section-desc">
            Компактная панель с группировкой инструментов. Переключайте вкладки, сворачивайте ленту, нажимайте кнопки — все действия логируются.
        </SgTypography>

        <div class="demo-grid-adaptive">
            <SgCard Title="Usage Examples" CssClass="demo-interactive-card">
                <div class="demo-ribbon-wrap">
                    <SgRibbon @bind-Collapsed="_collapsed" AllowCollapse="true" Animate="true">
                        <ChildContent>

                        @* ── Home tab ── *@
                        <SgRibbonTab Title="Home">
                            <SgRibbonGroup Title="Clipboard" Icon="@SgIcons.Copy">
                                <SgRibbonSplit Icon="@SgIcons.Copy" Text="Paste" Tooltip="Paste (Ctrl+V)"
                                               OnClick="@(() => Log("Paste"))">
                                    <DropdownContent>
                                        <button class="sgc-ribbon-menu-item" @onclick="@(() => Log("Paste as text"))">
                                            <span class="sgc-ribbon-btn-icon" style="font-size:16px;margin-right:8px;">@((MarkupString)SgIcons.FileText)</span> Paste as text
                                        </button>
                                        <button class="sgc-ribbon-menu-item" @onclick="@(() => Log("Special paste"))">
                                            <span class="sgc-ribbon-btn-icon" style="font-size:16px;margin-right:8px;">@((MarkupString)SgIcons.Settings)</span> Special paste…
                                        </button>
                                    </DropdownContent>
                                </SgRibbonSplit>
                                <div style="display:flex;flex-direction:column;gap:1px;min-width:100px;">
                                    <SgRibbonButton Icon="@SgIcons.Copy"    Text="Copy"   Size="SgRibbonButtonSize.Small" Tooltip="Copy (Ctrl+C)" OnClick="@(() => Log("Copy"))" />
                                    <SgRibbonButton Icon="@SgIcons.Edit"    Text="Cut"    Size="SgRibbonButtonSize.Small" Tooltip="Cut (Ctrl+X)"  OnClick="@(() => Log("Cut"))" />
                                    <SgRibbonButton Icon="@SgIcons.Refresh" Text="Format" Size="SgRibbonButtonSize.Small" Tooltip="Format painter" OnClick="@(() => Log("Format"))" />
                                </div>
                            </SgRibbonGroup>

                            <SgRibbonGroup Title="Font" Icon="@_boldIcon">
                                <SgRibbonButton Icon="@_boldIcon"   Text="Bold"      Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_bold"   Tooltip="Bold (Ctrl+B)" />
                                <SgRibbonButton Icon="@_italicIcon" Text="Italic"    Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_italic" Tooltip="Italic (Ctrl+I)" />
                                <SgRibbonButton Icon="@_underIcon"  Text="Underline" Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_under" Tooltip="Underline (Ctrl+U)" />
                                <SgRibbonSeparator />
                                <SgRibbonButton Icon="@SgIcons.ArrowUp"   Text="Increase" Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Increase font"))" />
                                <SgRibbonButton Icon="@SgIcons.ArrowDown" Text="Decrease" Size="SgRibbonButtonSize.Small" OnClick="@(() => Log("Decrease font"))" />
                            </SgRibbonGroup>

                            <SgRibbonGroup Title="Styles">
                                <SgRibbonButton Icon="@SgIcons.FileText" Text="Normal"    Size="SgRibbonButtonSize.Medium" Tooltip="Normal style" OnClick="@(() => Log("Normal"))" />
                                <SgRibbonButton Icon="@SgIcons.FileText" Text="Heading 1" Size="SgRibbonButtonSize.Medium" Tooltip="Heading 1"    OnClick="@(() => Log("Heading 1"))" />
                            </SgRibbonGroup>

                            <SgRibbonGroup Title="Editing">
                                <SgRibbonButton Icon="@SgIcons.Search" Text="Find"    Size="SgRibbonButtonSize.Large" Shortcut="Ctrl+F" Tooltip="Find (Ctrl+F)"  OnClick="@(() => Log("Find"))" />
                                <SgRibbonButton Icon="@SgIcons.Check"  Text="Select"  Size="SgRibbonButtonSize.Large" Shortcut="Ctrl+A" Tooltip="Select all"      OnClick="@(() => Log("Select all"))" />
                            </SgRibbonGroup>
                        </SgRibbonTab>

                        @* ── Insert tab ── *@
                        <SgRibbonTab Title="Insert" Badge="New" BadgeVariant="SgBadgeVariant.Success">
                            <SgRibbonGroup Title="Objects">
                                <SgRibbonSplit Icon="@SgIcons.Database" Text="Table" Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Insert table"))">
                                    <DropdownContent>
                                        <button class="sgc-ribbon-menu-item" @onclick="@(() => Log("Insert table"))">
                                            @((MarkupString)SgIcons.Database) Insert table…
                                        </button>
                                        <button class="sgc-ribbon-menu-item" @onclick="@(() => Log("Pivot table"))">
                                            @((MarkupString)SgIcons.Settings) Pivot table…
                                        </button>
                                    </DropdownContent>
                                </SgRibbonSplit>
                                <SgRibbonButton Icon="@SgIcons.Download"  Text="Picture"   Size="SgRibbonButtonSize.Medium" Tooltip="Insert picture" OnClick="@(() => Log("Picture"))" />
                                <SgRibbonButton Icon="@SgIcons.BarChart"  Text="Chart"     Size="SgRibbonButtonSize.Medium" Tooltip="Insert chart"   OnClick="@(() => Log("Chart"))" />
                            </SgRibbonGroup>

                            <SgRibbonGroup Title="Links">
                                <SgRibbonButton Icon="@SgIcons.ChevronRight" Text="Link"      Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Hyperlink"))" />
                                <SgRibbonButton Icon="@SgIcons.FileText"     Text="Bookmark"  Size="SgRibbonButtonSize.Medium" OnClick="@(() => Log("Bookmark"))" />
                            </SgRibbonGroup>
                        </SgRibbonTab>

                        @* ── Data tab (contextual) ── *@
                        <SgRibbonTab Title="Data" Highlight="true" Badge="5" BadgeVariant="SgBadgeVariant.Danger">
                            <SgRibbonGroup Title="Source">
                                <SgRibbonButton Icon="@SgIcons.Database" Text="Connect"  Size="SgRibbonButtonSize.Large" Tooltip="Connect data source" OnClick="@(() => Log("Connect"))" />
                                <SgRibbonButton Icon="@SgIcons.Refresh"  Text="Refresh"  Size="SgRibbonButtonSize.Large" Tooltip="Refresh data"         OnClick="@(() => Log("Refresh"))" />
                            </SgRibbonGroup>

                            <SgRibbonGroup Title="Tools">
                                <SgRibbonButton Icon="@SgIcons.Check"    Text="Validate" Size="SgRibbonButtonSize.Medium" Tooltip="Validate data"  OnClick="@(() => Log("Validate"))" />
                                <SgRibbonButton Icon="@SgIcons.BarChart" Text="Analyze"  Size="SgRibbonButtonSize.Medium" Tooltip="Analyze data"    OnClick="@(() => Log("Analyze"))" Danger="true" />
                            </SgRibbonGroup>
                        </SgRibbonTab>

                        @* ── View tab ── *@
                        <SgRibbonTab Title="View">
                            <SgRibbonGroup Title="Layout">
                                <SgRibbonButton Icon="@SgIcons.FileText"  Text="Normal"    Size="SgRibbonButtonSize.Large" Tooltip="Normal view"     OnClick="@(() => Log("Normal view"))" />
                                <SgRibbonButton Icon="@SgIcons.Search"   Text="Page Layout" Size="SgRibbonButtonSize.Large" Tooltip="Page layout view" OnClick="@(() => Log("Page layout"))" />
                            </SgRibbonGroup>

                            <SgRibbonGroup Title="Show">
                                <SgRibbonButton Icon="@SgIcons.Check" Text="Ruler"     Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_ruler" />
                                <SgRibbonButton Icon="@SgIcons.Check" Text="Gridlines" Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_gridlines" />
                                <SgRibbonButton Icon="@SgIcons.Check" Text="Nav Pane"  Size="SgRibbonButtonSize.Small" IsToggle="true" @bind-Pressed="_navPane" />
                            </SgRibbonGroup>
                        </SgRibbonTab>

                        </ChildContent>
                        <TabBarFarContent>
                            <SgButton Text="Help" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" OnClick="@(() => Log("Help opened"))" />
                        </TabBarFarContent>
                    </SgRibbon>
                </div>

                @* Action log *@
                @if (_log.Count > 0)
                {
                    <div class="ribbon-log-container">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Color="var(--sg-text-muted)" CssClass="ribbon-log-title">
                            Action log
                        </SgTypography>
                        @foreach (var entry in _log)
                        {
                            <div class="ribbon-log-entry">
                                <span class="ribbon-log-dot"></span>
                                <span class="ribbon-log-text">@entry</span>
                            </div>
                        }
                    </div>
                }
            </SgCard>

            <SgCard Title="Controls" CssClass="demo-interactive-card">
                <div class="demo-flex-col">
                    <div>
                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Color="var(--sg-text-muted)" CssClass="demo-label">Collapse state</SgTypography>
                        <div class="demo-flex-row">
                            <SgButton Text="@_collapseBtnText"
                                      Variant="@(_collapsed ? SgButtonVariant.Primary : SgButtonVariant.Ghost)"
                                      OnClick="@(() => _collapsed = !_collapsed)" />
                            <SgBadge Text="@_collapseBadgeText" Variant="@_collapseBadgeVariant" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Color="var(--sg-text-muted)" CssClass="demo-label">Toggle states</SgTypography>
                        <div class="demo-flex-row">
                            <SgBadge Text="@("Bold: " + _boldState)" Variant="@_boldVariant" />
                            <SgBadge Text="@("Italic: " + _italicState)" Variant="@_italicVariant" />
                            <SgBadge Text="@("Underline: " + _underState)" Variant="@_underVariant" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Color="var(--sg-text-muted)" CssClass="demo-label">View toggles</SgTypography>
                        <div class="demo-flex-row">
                            <SgBadge Text="@("Ruler: " + _rulerState)" Variant="@_rulerVariant" />
                            <SgBadge Text="@("Grid: " + _gridState)" Variant="@_gridVariant" />
                            <SgBadge Text="@("Nav: " + _navState)" Variant="@_navVariant" />
                        </div>
                    </div>
                </div>
            </SgCard>
        </div>

        @* Code constructor *@
        <div style="margin-top:16px;">
            <SgTypography Variant="SgTypographyVariant.Heading3">Code constructor</SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Basic ribbon markup with tabs, groups, buttons and a split button.
            </SgTypography>
            <pre class="demo-code-block"><span class="demo-code-comment">&lt;!-- SgRibbon with tabs, groups, and buttons --&gt;</span>
<span class="demo-code-keyword">&lt;SgRibbon</span> <span class="demo-code-attr">@@bind-Collapsed</span>=<span class="demo-code-string">"_collapsed"</span> <span class="demo-code-attr">AllowCollapse</span>=<span class="demo-code-string">"true"</span><span class="demo-code-keyword">&gt;</span>
    <span class="demo-code-keyword">&lt;ChildContent&gt;</span>
        <span class="demo-code-keyword">&lt;SgRibbonTab</span> <span class="demo-code-attr">Title</span>=<span class="demo-code-string">"Home"</span><span class="demo-code-keyword">&gt;</span>
            <span class="demo-code-keyword">&lt;SgRibbonGroup</span> <span class="demo-code-attr">Title</span>=<span class="demo-code-string">"Clipboard"</span><span class="demo-code-keyword">&gt;</span>
                <span class="demo-code-keyword">&lt;SgRibbonSplit</span> <span class="demo-code-attr">Icon</span>=<span class="demo-code-string">"@@SgIcons.Copy"</span>
                              <span class="demo-code-attr">Text</span>=<span class="demo-code-string">"Paste"</span> <span class="demo-code-attr">OnClick</span>=<span class="demo-code-string">"@@() =&gt; Log("Paste")"</span><span class="demo-code-keyword">&gt;</span>
                    <span class="demo-code-keyword">&lt;DropdownContent&gt;</span>
                        <span class="demo-code-keyword">&lt;button</span> <span class="demo-code-attr">class</span>=<span class="demo-code-string">"sgc-ribbon-menu-item"</span>
                                <span class="demo-code-attr">@@onclick</span>=<span class="demo-code-string">"@@() =&gt; Log("Paste as text")"</span><span class="demo-code-keyword">&gt;</span>
                            Paste as text
                        <span class="demo-code-keyword">&lt;/button&gt;</span>
                    <span class="demo-code-keyword">&lt;/DropdownContent&gt;</span>
                <span class="demo-code-keyword">&lt;/SgRibbonSplit&gt;</span>
                <span class="demo-code-keyword">&lt;SgRibbonButton</span> <span class="demo-code-attr">Icon</span>=<span class="demo-code-string">"@@SgIcons.Copy"</span>
                              <span class="demo-code-attr">Text</span>=<span class="demo-code-string">"Copy"</span>
                              <span class="demo-code-attr">Size</span>=<span class="demo-code-string">"SgRibbonButtonSize.Small"</span> <span class="demo-code-keyword">/&gt;</span>
            <span class="demo-code-keyword">&lt;/SgRibbonGroup&gt;</span>
        <span class="demo-code-keyword">&lt;/SgRibbonTab&gt;</span>
        <span class="demo-code-keyword">&lt;SgRibbonTab</span> <span class="demo-code-attr">Title</span>=<span class="demo-code-string">"Insert"</span> <span class="demo-code-attr">Badge</span>=<span class="demo-code-string">"New"</span>
                      <span class="demo-code-attr">BadgeVariant</span>=<span class="demo-code-string">"SgBadgeVariant.Success"</span><span class="demo-code-keyword">&gt;</span>
            <span class="demo-code-comment">&lt;!-- groups and buttons --&gt;</span>
        <span class="demo-code-keyword">&lt;/SgRibbonTab&gt;</span>
    <span class="demo-code-keyword">&lt;/ChildContent&gt;</span>
    <span class="demo-code-keyword">&lt;TabBarFarContent&gt;</span>
        <span class="demo-code-keyword">&lt;SgButton</span> <span class="demo-code-attr">Text</span>=<span class="demo-code-string">"Help"</span>
                  <span class="demo-code-attr">Variant</span>=<span class="demo-code-string">"SgButtonVariant.Ghost"</span> <span class="demo-code-keyword">/&gt;</span>
    <span class="demo-code-keyword">&lt;/TabBarFarContent&gt;</span>
<span class="demo-code-keyword">&lt;/SgRibbon&gt;</span></pre>
        </div>
    </div>

    @* ── Component Properties ─────────────────────────────────────────────── *@
    <div class="sgc-demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading2">Component Properties</SgTypography>
        </div>

        <div class="demo-grid-adaptive" style="margin-top:12px;">
            <SgCard Title="SgRibbon" Shadow="SgShadow.Sm">
                <PropertyTable Items="_ribbonProps" />
            </SgCard>
            <SgCard Title="SgRibbonButton" Shadow="SgShadow.Sm">
                <PropertyTable Items="_buttonProps" />
            </SgCard>
        </div>
        <div class="demo-grid-adaptive" style="margin-top:12px;">
            <SgCard Title="SgRibbonTab" Shadow="SgShadow.Sm">
                <PropertyTable Items="_tabProps" />
            </SgCard>
            <SgCard Title="SgRibbonGroup" Shadow="SgShadow.Sm">
                <PropertyTable Items="_groupProps" />
            </SgCard>
        </div>
        <div class="demo-grid-adaptive" style="margin-top:12px;">
            <SgCard Title="SgRibbonSplit" Shadow="SgShadow.Sm">
                <PropertyTable Items="_splitProps" />
            </SgCard>
        </div>
    </div>

</SgCard>

<style>
    .ribbon-log-container {
        margin-top: 12px;
        padding: 10px 12px;
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
    }
    .ribbon-log-title {
        display: block;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 10px;
    }
    .ribbon-log-entry {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 2px 0;
        font-size: 12px;
        font-family: 'Cascadia Code', 'Consolas', monospace;
        color: var(--sg-text-muted);
    }
    .ribbon-log-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--sg-color-primary);
        flex-shrink: 0;
    }
    .ribbon-log-text {
        flex: 1;
    }
    .demo-ribbon-wrap {
        margin-bottom: 4px;
    }
</style>

@code {
    // ── Dynamic state ─────────────────────────────────────────────────────────
    private bool _collapsed;
    private bool _bold, _italic, _under;
    private bool _ruler, _gridlines, _navPane;
    private readonly List<string> _log = new();

    private void Log(string msg)
    {
        _log.Insert(0, $"[{DateTime.Now:HH:mm:ss}] {msg}");
        if (_log.Count > 5) _log.RemoveAt(_log.Count - 1);
    }

    // ── Icons ─────────────────────────────────────────────────────────────────
    private const string _boldIcon   = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z'/><path d='M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z'/></svg>";
    private const string _italicIcon = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><line x1='19' y1='4' x2='10' y2='4'/><line x1='14' y1='20' x2='5' y2='20'/><line x1='15' y1='4' x2='9' y2='20'/></svg>";
    private const string _underIcon  = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M6 3v7a6 6 0 0 0 6 6 6 6 0 0 0 6-6V3'/><line x1='4' y1='21' x2='20' y2='21'/></svg>";

    // ── Computed display properties ──────────────────────────────────────────────
    private string _collapseBtnText => _collapsed ? "Expand ribbon" : "Collapse ribbon";
    private string _collapseBadgeText => _collapsed ? "Collapsed" : "Expanded";
    private SgBadgeVariant _collapseBadgeVariant => _collapsed ? SgBadgeVariant.Warn : SgBadgeVariant.Success;
    private string _boldState => _bold ? "ON" : "OFF";
    private string _italicState => _italic ? "ON" : "OFF";
    private string _underState => _under ? "ON" : "OFF";
    private SgBadgeVariant _boldVariant => _bold ? SgBadgeVariant.Info : SgBadgeVariant.Muted;
    private SgBadgeVariant _italicVariant => _italic ? SgBadgeVariant.Info : SgBadgeVariant.Muted;
    private SgBadgeVariant _underVariant => _under ? SgBadgeVariant.Info : SgBadgeVariant.Muted;
    private string _rulerState => _ruler ? "ON" : "OFF";
    private string _gridState => _gridlines ? "ON" : "OFF";
    private string _navState => _navPane ? "ON" : "OFF";
    private SgBadgeVariant _rulerVariant => _ruler ? SgBadgeVariant.Info : SgBadgeVariant.Muted;
    private SgBadgeVariant _gridVariant => _gridlines ? SgBadgeVariant.Info : SgBadgeVariant.Muted;
    private SgBadgeVariant _navVariant => _navPane ? SgBadgeVariant.Info : SgBadgeVariant.Muted;

    // ── Property tables ───────────────────────────────────────────────────────
    private List<PropertyPanelItem> _ribbonProps = new()
    {
        new() { Label = "ChildContent",     Value = "RenderFragment",   BadgeText = "Tabs content",        BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Collapsed",        Value = "bool",             BadgeText = "Collapsed state",     BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "CollapsedChanged", Value = "EventCallback",    BadgeText = "Collapse event",      BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "AllowCollapse",    Value = "bool",             BadgeText = "Toggle button",       BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "ActiveTabIndex",   Value = "int",              BadgeText = "Tab index (two-way)", BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Animate",          Value = "bool",             BadgeText = "Animations",          BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "TabBarFarContent", Value = "RenderFragment",   BadgeText = "Far-right slot",      BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "CssClass",         Value = "string?",          BadgeText = "Additional class",    BadgeVariant = SgBadgeVariant.Default },
    };

    private List<PropertyPanelItem> _buttonProps = new()
    {
        new() { Label = "Text",           Value = "string?",          BadgeText = "Label",               BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Icon",           Value = "string? (SVG)",    BadgeText = "Icon markup",         BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Size",           Value = "Large|Medium|Small", BadgeText = "Display size",       BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "IsToggle",       Value = "bool",             BadgeText = "Toggle mode",         BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Pressed",        Value = "bool",             BadgeText = "Pressed state",       BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Danger",         Value = "bool",             BadgeText = "Danger style",        BadgeVariant = SgBadgeVariant.Danger  },
        new() { Label = "Disabled",       Value = "bool",             BadgeText = "Disabled",            BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Tooltip",        Value = "string?",          BadgeText = "Tooltip text",        BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Shortcut",       Value = "string?",          BadgeText = "Keyboard shortcut",   BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "OnClick",        Value = "EventCallback",    BadgeText = "Click event",         BadgeVariant = SgBadgeVariant.Success },
    };

    private List<PropertyPanelItem> _tabProps = new()
    {
        new() { Label = "Title",        Value = "string",             BadgeText = "Tab label",           BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Icon",         Value = "string? (SVG)",      BadgeText = "Tab icon",            BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Highlight",    Value = "bool",               BadgeText = "Contextual tab",      BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Badge",        Value = "string?",            BadgeText = "Notification badge",  BadgeVariant = SgBadgeVariant.Danger  },
        new() { Label = "BadgeVariant", Value = "SgBadgeVariant",     BadgeText = "Badge colour",        BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Disabled",     Value = "bool",               BadgeText = "Disabled",            BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "ChildContent", Value = "RenderFragment",     BadgeText = "Panel content",       BadgeVariant = SgBadgeVariant.Info    },
    };

    private List<PropertyPanelItem> _groupProps = new()
    {
        new() { Label = "Title",        Value = "string?",           BadgeText = "Group label",          BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Icon",         Value = "string? (SVG)",     BadgeText = "Label icon",           BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "ChildContent", Value = "RenderFragment",    BadgeText = "Buttons/seps",         BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "CssClass",     Value = "string?",           BadgeText = "Additional class",     BadgeVariant = SgBadgeVariant.Default },
    };

