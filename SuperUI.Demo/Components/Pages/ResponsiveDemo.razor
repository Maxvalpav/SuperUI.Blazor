@code {
    // ── Hero stats ──
    private double _vw;
    private double _dpr = 1.0;

    [Inject] private SgViewportService Viewport { get; set; } = default!;

    // ── Section 1: Container Queries ──
    private int _narrowThreshold = 350;
    private int _wideThreshold = 650;
    private bool _transitionEnabled = true;
    private int _debounceMs = 50;
    private bool _showIndicator = true;
    private double _currentWidth;
    private string _currentBreakpoint = "wide";
    private readonly List<string> _log = new();

    private SgBadgeVariant _breakpointBadgeVariant => _currentBreakpoint switch
    {
        "narrow" => SgBadgeVariant.Danger,
        "medium" => SgBadgeVariant.Info,
        "wide" => SgBadgeVariant.Success,
        _ => SgBadgeVariant.Default
    };

    // ── Section 5: Visibility Sensor ──
    private readonly bool[] _revealed = new bool[3];
    private readonly string[] _visLabels = { "1 of 3", "2 of 3", "3 of 3" };
    private readonly string[] _visColors = { "var(--sg-color-primary)", "var(--sg-color-info)", "var(--sg-color-success)" };

    private void OnBreakpointChanged(string bp)
    {
        _currentBreakpoint = bp;
        Log($"Breakpoint: {bp} · {_currentWidth:F0}px");
        StateHasChanged();
    }

    private void Log(string msg)
    {
        _log.Insert(0, $"[{DateTime.Now:HH:mm:ss}] {msg}");
        if (_log.Count > 10) _log.RemoveAt(_log.Count - 1);
    }

    private void OnCardRevealed(int idx)
    {
        _revealed[idx] = true;
        StateHasChanged();
    }

    // ── Section 6: Live Constructor ──
    private int _ctorNarrow = 350;
    private int _ctorWide = 700;
    private int _ctorDebounce = 50;
    private string _ctorDefault = "wide";
    private bool _ctorTransitions = true;
    private bool _ctorIndicator;
    private string _ctorTag = "div";

    private string[] _ctorGeneratedCode = Array.Empty<string>();
    private string _ctorCopyIcon = "📋";
    private string _ctorCopyLabel = "Copy";

    // ── Constructor options ──
    private readonly List<SgSegmentedOption<int>> _ctorNarrowOptions = new()
    {
        new() { Value = 250, Label = "250" },
        new() { Value = 350, Label = "350" },
        new() { Value = 450, Label = "450" },
    };
    private readonly List<SgSegmentedOption<int>> _ctorWideOptions = new()
    {
        new() { Value = 600, Label = "600" },
        new() { Value = 700, Label = "700" },
        new() { Value = 900, Label = "900" },
    };
    private readonly List<SgSegmentedOption<int>> _debounceOptions = new()
    {
        new() { Value = 0,   Label = "0" },
        new() { Value = 50,  Label = "50" },
        new() { Value = 100, Label = "100" },
        new() { Value = 200, Label = "200" },
    };
    private readonly List<SgSegmentedOption<string>> _defaultOptions = new()
    {
        new() { Value = "narrow", Label = "narrow" },
        new() { Value = "medium", Label = "medium" },
        new() { Value = "wide",   Label = "wide" },
    };
    private readonly List<SgSegmentedOption<bool>> _boolOptions = new()
    {
        new() { Value = false, Label = "Off" },
        new() { Value = true,  Label = "On" },
    };
    private readonly List<SgSegmentedOption<string>> _tagOptions = new()
    {
        new() { Value = "div",     Label = "div" },
        new() { Value = "section", Label = "section" },
        new() { Value = "article", Label = "article" },
        new() { Value = "aside",   Label = "aside" },
        new() { Value = "main",    Label = "main" },
    };

    // ── Section 3: Breakpoint cards ──
    private record BpCard(SgBreakpoint Key, string Color, string Range, SgBadgeVariant BadgeVariant);

    private readonly List<BpCard> _allBreakpoints = new()
    {
        new(SgBreakpoint.Xs,  "var(--sg-color-danger)",  "0 – 575",       SgBadgeVariant.Danger),
        new(SgBreakpoint.Sm,  "var(--sg-color-warning)", "576 – 767",     SgBadgeVariant.Warn),
        new(SgBreakpoint.Md,  "var(--sg-color-info)",    "768 – 991",     SgBadgeVariant.Info),
        new(SgBreakpoint.Lg,  "var(--sg-color-primary)", "992 – 1199",    SgBadgeVariant.Default),
        new(SgBreakpoint.Xl,  "var(--sg-color-success)", "1200 – 1399",   SgBadgeVariant.Success),
        new(SgBreakpoint.Xxl, "var(--sg-color-primary)","≥ 1400",        SgBadgeVariant.Default),
    };

    // ── Properties table ──
    private List<PropertyPanelItem> _props = new()
    {
        new() { Label = "OnNarrow",          Value = "RenderFragment?",   BadgeText = "< NarrowThreshold",    BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "OnMedium",          Value = "RenderFragment?",   BadgeText = "Narrow–Wide",          BadgeVariant = SgBadgeVariant.Info   },
        new() { Label = "OnWide",            Value = "RenderFragment?",   BadgeText = "≥ WideThreshold",      BadgeVariant = SgBadgeVariant.Success},
        new() { Label = "NarrowThreshold",   Value = "int (default 400)", BadgeText = "Narrow upper (px)",    BadgeVariant = SgBadgeVariant.Warn   },
        new() { Label = "WideThreshold",     Value = "int (default 800)", BadgeText = "Wide lower (px)",      BadgeVariant = SgBadgeVariant.Warn   },
        new() { Label = "ObserveDebounceMs", Value = "int (default 50)",  BadgeText = "Resize debounce (ms)", BadgeVariant = SgBadgeVariant.Info   },
        new() { Label = "TransitionEnabled", Value = "bool",              BadgeText = "Animate BP change",    BadgeVariant = SgBadgeVariant.Success},
        new() { Label = "Tag",               Value = "string (default \"div\")", BadgeText = "Semantic HTML", BadgeVariant = SgBadgeVariant.Default},
        new() { Label = "DefaultBreakpoint", Value = "string (default \"wide\")", BadgeText = "SSR fallback", BadgeVariant = SgBadgeVariant.Info   },
        new() { Label = "ShowBreakpointIndicator", Value = "bool",       BadgeText = "Debug overlay",        BadgeVariant = SgBadgeVariant.Warn   },
        new() { Label = "BreakpointChanged", Value = "EventCallback<string>",  BadgeText = "BP callback",    BadgeVariant = SgBadgeVariant.Success},
        new() { Label = "WidthChanged",      Value = "EventCallback<double>",  BadgeText = "Width callback", BadgeVariant = SgBadgeVariant.Success},
    };

    // ── Lifecycle ──
    protected override async Task OnInitializedAsync()
    {
        UpdateCtorCode();
        Viewport.Changed += OnViewportChanged;
        await SafeStartViewport();
    }

    private async Task SafeStartViewport()
    {
        try
        {
            await Viewport.StartAsync();
            _vw = Viewport.Width;
            _dpr = Viewport.DevicePixelRatio;
            StateHasChanged();
        }
        catch
        {
            // SSR or JS not available yet — leave at 0
        }
    }

    private void OnViewportChanged()
    {
        _vw = Viewport.Width;
        _dpr = Viewport.DevicePixelRatio;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Viewport.Changed -= OnViewportChanged;
    }

    // ── Code generation ──
    private void UpdateCtorCode()
    {
        var lines = new List<string>();
        var tag = string.IsNullOrEmpty(_ctorTag) || _ctorTag == "div" ? "SgResponsiveContainer" : $"SgResponsiveContainer Tag=\"{_ctorTag}\"";
        lines.Add($"<{tag}");
        if (_ctorNarrow != 400) lines.Add($"              NarrowThreshold=\"{_ctorNarrow}\"");
        if (_ctorWide != 800) lines.Add($"              WideThreshold=\"{_ctorWide}\"");
        if (_ctorDebounce != 50) lines.Add($"              ObserveDebounceMs=\"{_ctorDebounce}\"");
        if (_ctorTransitions) lines.Add($"              TransitionEnabled=\"true\"");
        if (_ctorIndicator) lines.Add($"              ShowBreakpointIndicator=\"true\"");
        if (_ctorDefault != "wide") lines.Add($"              DefaultBreakpoint=\"{_ctorDefault}\"");
        lines.Add($"              MinHeight=\"120\"");
        lines.Add($"              Padding=\"12px\">");
        lines.Add($"    <OnNarrow>...</OnNarrow>");
        lines.Add($"    <OnMedium>...</OnMedium>");
        lines.Add($"    <OnWide>...</OnWide>");
        lines.Add($"</SgResponsiveContainer>");
        _ctorGeneratedCode = lines.ToArray();
    }

    private async Task CopyCtorCode()
    {
        var code = string.Join("\n", _ctorGeneratedCode);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _ctorCopyIcon = "✓";
            _ctorCopyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _ctorCopyIcon = "📋";
            _ctorCopyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _ctorCopyIcon = "✗";
            _ctorCopyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _ctorCopyIcon = "📋";
            _ctorCopyLabel = "Copy";
            StateHasChanged();
        }
    }
