@page "/responsive-demo"
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>Responsive Container — SuperUI</PageTitle>

<SgCard Title="SgResponsiveContainer — Container Queries"
        Subtitle="Automatically switches layouts based on its own dimensions using ResizeObserver. Perfect for dashboard widgets and reusable components."
        CssClass="sgc-card-flush">

    @* ── Interactive Demo ─────────────────────────────────────────────────── *@
    <div class="sgc-demo-section" style="padding: 32px;">
        <div class="demo-section-header" style="margin-bottom: 24px;">
            <SgTypography Variant="SgTypographyVariant.Heading2">Adaptive Showcase</SgTypography>
            <span class="demo-live-badge">Live</span>
        </div>
        
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" Style="margin-bottom: 40px; max-width: 800px; line-height: 1.6;">
            Unlike standard media queries, <code>SgResponsiveContainer</code> reacts to its own width. 
            Drag the splitter handle below to see how the content adapts to the available space.
        </SgTypography>

        <div class="demo-grid-adaptive" style="display: grid; grid-template-columns: 1fr 320px; gap: 32px; align-items: start;">
            @* ── Main Preview ── *@
            <div style="background: var(--sg-surface-alt); padding: 24px; border-radius: 16px; border: 1px solid var(--sg-border);">
                <div style="height: 480px; background: var(--sg-bg); border-radius: 12px; border: 1px solid var(--sg-border); overflow: hidden; box-shadow: var(--sg-shadow-sm);">
                    <SgSplitter Size="240" MinSize="150" MaxSize="500">
                        <First>
                            <div style="padding: 20px; height: 100%; background: var(--sg-surface-alt); border-right: 1px solid var(--sg-border); display: flex; flex-direction: column; gap: 16px;">
                                <SgTypography Size="SgTypographySize.Base" Weight="SgTypographyWeight.Semibold">Navigation</SgTypography>
                                <div style="display: flex; flex-direction: column; gap: 8px;">
                                    <div style="height: 32px; background: var(--sg-border-subtle); border-radius: 6px; width: 80%;"></div>
                                    <div style="height: 32px; background: var(--sg-border-subtle); border-radius: 6px; width: 90%;"></div>
                                    <div style="height: 32px; background: var(--sg-border-subtle); border-radius: 6px; width: 70%;"></div>
                                </div>
                                
                                <div style="margin-top: auto; padding: 12px; background: var(--sg-bg); border-radius: 8px; border: 1px solid var(--sg-border);">
                                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Style="display: block; margin-bottom: 8px;">Info</SgTypography>
                                    <div style="display: flex; flex-direction: column; gap: 4px;">
                                        <div style="display: flex; justify-content: space-between; font-size: 11px;">
                                            <span>Width:</span>
                                            <span style="font-family: monospace; font-weight: 600; color: var(--sg-color-primary);">@($"{_currentWidth:F0}px")</span>
                                        </div>
                                        <div style="display: flex; justify-content: space-between; font-size: 11px;">
                                            <span>State:</span>
                                            <SgBadge Text="@_currentBreakpoint.ToUpper()" Variant="@_breakpointBadgeVariant" Size="SgSize.Sm" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </First>
                        <Second>
                            <SgResponsiveContainer NarrowThreshold="@_narrowThreshold"
                                                     WideThreshold="@_wideThreshold"
                                                     TransitionEnabled="@_transitionEnabled"
                                                     ObserveDebounceMs="@_debounceMs"
                                                     BreakpointChanged="@OnBreakpointChanged"
                                                     WidthChanged="@(w => { _currentWidth = w; StateHasChanged(); })"
                                                     MinHeight="100%"
                                                     Padding="32px">
                                <OnNarrow>
                                    <div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px;">
                                        <div style="width: 64px; height: 64px; border-radius: 50%; background: color-mix(in srgb, var(--sg-color-danger) 10%, transparent); display: flex; align-items: center; justify-content: center;">
                                            <SgIcon Icon="@SgIcons.Monitor" Size="32px" Color="var(--sg-color-danger)" />
                                        </div>
                                        <div>
                                            <SgTypography Variant="SgTypographyVariant.Heading4">Compact View</SgTypography>
                                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" Style="display: block; margin-top: 8px;">
                                                Single column layout optimized for narrow spaces.
                                            </SgTypography>
                                        </div>
                                        <div style="width: 100%; height: 120px; background: var(--sg-surface-alt); border-radius: 8px; border: 1px dashed var(--sg-border);"></div>
                                    </div>
                                </OnNarrow>
                                <OnMedium>
                                    <div style="display: flex; flex-direction: column; gap: 24px;">
                                        <div style="display: flex; align-items: center; gap: 16px;">
                                            <SgIcon Icon="@SgIcons.Monitor" Size="40px" Color="var(--sg-color-info)" />
                                            <div>
                                                <SgTypography Variant="SgTypographyVariant.Heading4">Standard View</SgTypography>
                                                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Balanced distribution of elements.</SgTypography>
                                            </div>
                                        </div>
                                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                                            <div style="height: 100px; background: var(--sg-surface-alt); border-radius: 8px; border: 1px solid var(--sg-border);"></div>
                                            <div style="height: 100px; background: var(--sg-surface-alt); border-radius: 8px; border: 1px solid var(--sg-border);"></div>
                                        </div>
                                    </div>
                                </OnMedium>
                                <OnWide>
                                    <div style="display: flex; flex-direction: column; gap: 32px;">
                                        <div style="display: flex; justify-content: space-between; align-items: center;">
                                            <div style="display: flex; align-items: center; gap: 20px;">
                                                <SgIcon Icon="@SgIcons.Monitor" Size="48px" Color="var(--sg-color-success)" />
                                                <div>
                                                    <SgTypography Variant="SgTypographyVariant.Heading3">Expanded View</SgTypography>
                                                    <SgTypography Size="SgTypographySize.Base" Color="var(--sg-text-muted)">Full-featured desktop-grade layout.</SgTypography>
                                                </div>
                                            </div>
                                            <SgButton Text="Action" Variant="SgButtonVariant.Primary" />
                                        </div>
                                        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
                                            <div style="height: 200px; background: var(--sg-surface-alt); border-radius: 12px; border: 1px solid var(--sg-border); display: flex; align-items: center; justify-content: center;">
                                                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Main Content Area</SgTypography>
                                            </div>
                                            <div style="display: flex; flex-direction: column; gap: 12px;">
                                                <div style="height: 94px; background: var(--sg-surface-alt); border-radius: 12px; border: 1px solid var(--sg-border);"></div>
                                                <div style="height: 94px; background: var(--sg-surface-alt); border-radius: 12px; border: 1px solid var(--sg-border);"></div>
                                            </div>
                                        </div>
                                    </div>
                                </OnWide>
                            </SgResponsiveContainer>
                        </Second>
                    </SgSplitter>
                </div>
            </div>

            @* ── Configuration ── *@
            <SgCard Title="Configuration" Style="border-radius: 16px; height: 100%;">
                <div class="demo-flex-col" style="gap: 24px; padding: 8px;">
                    <div>
                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Color="var(--sg-text-muted)" Style="display: block; margin-bottom: 12px;">Narrow Threshold</SgTypography>
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <input type="range" min="200" max="500" step="10" @bind="_narrowThreshold" style="flex: 1; accent-color: var(--sg-color-primary);" />
                            <SgBadge Text="@($"{_narrowThreshold}px")" Variant="SgBadgeVariant.Info" />
                        </div>
                    </div>
                    
                    <SgDivider />
                    
                    <div>
                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Color="var(--sg-text-muted)" Style="display: block; margin-bottom: 12px;">Wide Threshold</SgTypography>
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <input type="range" min="510" max="1000" step="10" @bind="_wideThreshold" style="flex: 1; accent-color: var(--sg-color-primary);" />
                            <SgBadge Text="@($"{_wideThreshold}px")" Variant="SgBadgeVariant.Warn" />
                        </div>
                    </div>

                    <SgDivider />

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Color="var(--sg-text-muted)">Transitions</SgTypography>
                        <SgSwitch @bind-Value="_transitionEnabled" />
                    </div>

                    <SgDivider />

                    <div>
                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Color="var(--sg-text-muted)" Style="display: block; margin-bottom: 8px;">Live Code</SgTypography>
                        <pre class="demo-code-block" style="font-size: 10px; margin: 0; padding: 12px;"><span class="demo-code-keyword">&lt;SgResponsiveContainer</span>
  <span class="demo-code-attr">Narrow</span>=<span class="demo-code-string">"@_narrowThreshold"</span>
  <span class="demo-code-attr">Wide</span>=<span class="demo-code-string">"@_wideThreshold"</span> <span class="demo-code-keyword">/&gt;</span></pre>
                    </div>
                </div>
            </SgCard>
        </div>

        @* ── History Log ── *@
        @if (_log.Count > 0)
        {
            <div style="margin-top: 32px;">
                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)" Style="text-transform: uppercase; letter-spacing: 0.05em;">Breakpoint Transitions</SgTypography>
                <div style="margin-top: 12px; display: flex; gap: 8px; flex-wrap: wrap;">
                    @foreach (var entry in _log.Take(6))
                    {
                        <div style="padding: 4px 10px; background: var(--sg-surface-alt); border: 1px solid var(--sg-border); border-radius: 20px; font-size: 11px; color: var(--sg-text-muted); display: flex; align-items: center; gap: 6px;">
                            <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--sg-color-primary);"></span>
                            @entry
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @* ── Component Properties ─────────────────────────────────────────────── *@
    <div class="sgc-demo-section" style="padding: 32px; background: var(--sg-surface-alt);">
        <div class="demo-section-header" style="margin-bottom: 24px;">
            <SgTypography Variant="SgTypographyVariant.Heading2">Properties Reference</SgTypography>
        </div>

        <SgCard Style="border-radius: 16px;">
            <PropertyTable Items="_props" />
        </SgCard>
    </div>

</SgCard>

@code {
    private int _narrowThreshold = 350;
    private int _wideThreshold = 650;
    private bool _transitionEnabled = true;
    private int _debounceMs = 50;
    private double _currentWidth;
    private string _currentBreakpoint = "medium";
    private readonly List<string> _log = new();

    private SgBadgeVariant _breakpointBadgeVariant => _currentBreakpoint switch
    {
        "narrow" => SgBadgeVariant.Danger,
        "medium" => SgBadgeVariant.Info,
        "wide" => SgBadgeVariant.Success,
        _ => SgBadgeVariant.Default
    };

    private void OnBreakpointChanged(string bp)
    {
        _currentBreakpoint = bp;
        Log($"Breakpoint: {bp}");
        StateHasChanged();
    }

    private void Log(string msg)
    {
        _log.Insert(0, $"[{DateTime.Now:HH:mm:ss}] {msg}");
        if (_log.Count > 10) _log.RemoveAt(_log.Count - 1);
    }

    private List<PropertyPanelItem> _props = new()
    {
        new() { Label = "OnNarrow",              Value = "RenderFragment?",           BadgeText = "Width < NarrowThreshold",    BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "OnMedium",              Value = "RenderFragment?",           BadgeText = "Narrow–Wide threshold",       BadgeVariant = SgBadgeVariant.Info   },
        new() { Label = "OnWide",                Value = "RenderFragment?",           BadgeText = "Width ≥ WideThreshold",      BadgeVariant = SgBadgeVariant.Success},
        new() { Label = "NarrowThreshold",       Value = "int (default 400)",          BadgeText = "Narrow upper bound (px)",    BadgeVariant = SgBadgeVariant.Warn   },
        new() { Label = "WideThreshold",         Value = "int (default 800)",          BadgeText = "Wide lower bound (px)",      BadgeVariant = SgBadgeVariant.Warn   },
        new() { Label = "TransitionEnabled",     Value = "bool",                      BadgeText = "Animate breakpoint changes", BadgeVariant = SgBadgeVariant.Success},
        new() { Label = "ObserveDebounceMs",     Value = "int (default 50)",           BadgeText = "Resize debounce (ms)",        BadgeVariant = SgBadgeVariant.Info   },
        new() { Label = "ClassName",             Value = "string?",                   BadgeText = "CSS class",                  BadgeVariant = SgBadgeVariant.Default},
        new() { Label = "MinHeight",             Value = "string? (default \"100%\")", BadgeText = "Min height",                 BadgeVariant = SgBadgeVariant.Info   },
        new() { Label = "Padding",               Value = "string? (default \"0\")",    BadgeText = "Padding",                    BadgeVariant = SgBadgeVariant.Info   },
        new() { Label = "BreakpointChanged",     Value = "EventCallback<string>",     BadgeText = "Breakpoint callback",        BadgeVariant = SgBadgeVariant.Success},
    };
}
