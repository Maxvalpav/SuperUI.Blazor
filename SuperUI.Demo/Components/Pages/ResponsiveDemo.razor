@page "/responsive-demo"
@using SuperUI.Components

<PageTitle>Responsive Container - SUI</PageTitle>

<SgCard Title="SgResponsiveContainer - Адаптивный контейнер"
        Subtitle="Компонент, меняющий содержимое в зависимости от своего размера (Container Queries), а не размера экрана.">

    <div style="margin-top: 32px;">
        <h2>Демонстрация Container Queries</h2>
        <p>Меняйте размер внешнего контейнера с помощью разделителя (Splitter), чтобы увидеть адаптивность внутреннего компонента.</p>
        
        <div style="height: 400px; border: 1px solid var(--sui-border-color); border-radius: 8px; overflow: hidden;">
            <SgSplitter Size="300">
                <First>
                    <div style="padding: 16px; height: 100%; background: #fafafa;">
                        <p>Перетащите разделитель вправо, чтобы увеличить область справа.</p>
                    </div>
                </First>
                <Second>
                    <div style="padding: 24px; height: 100%;">
                        <SgResponsiveContainer NarrowThreshold="350" WideThreshold="600">
                            <OnNarrow>
                                <div style="background: #fff1f0; border: 1px solid #ffa39e; padding: 24px; border-radius: 8px; text-align: center;">
                                    <SgIcon Icon="@SgIcons.Monitor" Size="32px" />
                                    <h3>Узкий вид (Narrow)</h3>
                                    <p>Ширина менее 350px. Используется компактная разметка.</p>
                                </div>
                            </OnNarrow>
                            <OnMedium>
                                <div style="background: #e6f7ff; border: 1px solid #91d5ff; padding: 24px; border-radius: 8px; text-align: center;">
                                    <div style="display: flex; align-items: center; justify-content: center; gap: 16px;">
                                        <SgIcon Icon="@SgIcons.Monitor" Size="48px" />
                                        <div style="text-align: left;">
                                            <h3>Средний вид (Medium)</h3>
                                            <p>Ширина от 350px до 600px.</p>
                                        </div>
                                    </div>
                                </div>
                            </OnMedium>
                            <OnWide>
                                <div style="background: #f6ffed; border: 1px solid #b7eb8f; padding: 48px; border-radius: 8px;">
                                    <div style="display: grid; grid-template-columns: auto 1fr; gap: 32px; align-items: center;">
                                        <SgIcon Icon="@SgIcons.Monitor" Size="64px" />
                                        <div>
                                            <h3>Широкий вид (Wide)</h3>
                                            <p>Ширина более 600px. Доступно максимум пространства для деталей.</p>
                                            <div style="display: flex; gap: 8px; margin-top: 16px;">
                                                <SgButton Text="Действие 1" Variant="SgButtonVariant.Primary" />
                                                <SgButton Text="Действие 2" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </OnWide>
                        </SgResponsiveContainer>
                    </div>
                </Second>
            </SgSplitter>
        </div>
    </div>

</SgCard>
