@page "/responsive-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Services
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject SgBreakpointService Breakpoints

<PageTitle>Responsive Primitives — SuperUI</PageTitle>
<SgSeoHead Description="Container queries, media queries, breakpoint service, visibility sensor, show-at / hide-at. SSR-safe and works in both WebAssembly and Server-Side Blazor." />

<SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" Status="SgCardStatus.Info" Animated="true" CssClass="rsp-demo-page">
    <HeaderContent>
        <DemoPageHeader Title="Responsive Primitives"
                        Subtitle="Container queries, media queries, breakpoint service, visibility sensor, show-at / hide-at. SSR-safe and works in both WebAssembly and Server-Side Blazor."
                        Icon="@SgHeroicons.Outline.AdjustmentsHorizontal" />
    </HeaderContent>
    <ChildContent>

        @* ═══════════════════════════════════════════════════════════════════
           Hero strip — current viewport info
           ═══════════════════════════════════════════════════════════════════ *@
        <div class="rsp-hero">
            <div class="rsp-hero-stat">
                <span class="rsp-hero-stat-label">Width</span>
                <span class="rsp-hero-stat-value">@($"{_vw:F0}px")</span>
            </div>
            <div class="rsp-hero-stat">
                <span class="rsp-hero-stat-label">Breakpoint</span>
                <span class="rsp-hero-stat-value">@Breakpoints.Breakpoint</span>
            </div>
            <div class="rsp-hero-stat">
                <span class="rsp-hero-stat-label">Device Pixel Ratio</span>
                <span class="rsp-hero-stat-value">@($"{_dpr:F2}×")</span>
            </div>
            <div class="rsp-hero-stat">
                <span class="rsp-hero-stat-label">Containers</span>
                <span class="rsp-hero-stat-value">3</span>
            </div>
        </div>

        @* ═══════════════════════════════════════════════════════════════════
           1. Container Queries — SgResponsiveContainer
           ═══════════════════════════════════════════════════════════════════ *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Container Queries
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgResponsiveContainer</SgTypography> reacts to its own width via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ResizeObserver</SgTypography>. Resize the splitter to see live layout shifts.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Md">
                @* ── Main preview ── *@
                <SgCol Xs="12" Md="8">
                    <SgCard Title="Adaptive Showcase" Subtitle="Drag the splitter — content swaps at narrow / medium / wide thresholds" Shadow="SgShadow.Sm" Hoverable="true" Animated="true" NoPadding="true">
                        <SgSplitter Size="380" Min="200" Max="640" CssClass="rsp-splitter">
                            <First>
                                <div class="rsp-pane-left">
                                    <SgTypography Size="SgTypographySize.Base" Weight="SgTypographyWeight.Semibold" Style="margin-bottom:12px;">Navigation</SgTypography>
                                    <div class="rsp-mock-list">
                                        <div class="rsp-mock-item" style="width:80%"></div>
                                        <div class="rsp-mock-item" style="width:90%"></div>
                                        <div class="rsp-mock-item" style="width:70%"></div>
                                        <div class="rsp-mock-item" style="width:85%"></div>
                                    </div>
                                    <div class="rsp-mock-stats">
                                        <SgStack Vertical Space="SgSize.Sm">
                                            <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Width</SgTypography>
                                                <SgTypography Font="SgTypographyFont.Mono" Size="SgTypographySize.Xs" Color="var(--sg-color-primary)">@($"{_currentWidth:F0}px")</SgTypography>
                                            </SgStack>
                                            <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">State</SgTypography>
                                                <SgBadge Variant="@_breakpointBadgeVariant" Text="@_currentBreakpoint.ToUpper()" Standalone="true" />
                                            </SgStack>
                                        </SgStack>
                                    </div>
                                </div>
                            </First>
                            <Second>
                                <SgResponsiveContainer NarrowThreshold="@_narrowThreshold"
                                                     WideThreshold="@_wideThreshold"
                                                     TransitionEnabled="@_transitionEnabled"
                                                     ObserveDebounceMs="@_debounceMs"
                                                     ShowBreakpointIndicator="@_showIndicator"
                                                     DefaultBreakpoint="wide"
                                                     BreakpointChanged="@OnBreakpointChanged"
                                                     WidthChanged="@(w => { _currentWidth = w; StateHasChanged(); })"
                                                     MinHeight="100%"
                                                     Padding="24px">
                                    <OnNarrow>
                                        <div class="rsp-adaptive rsp-adaptive-narrow">
                                            <div class="rsp-adaptive-icon rsp-adaptive-icon-danger">
                                                <SgIcon Icon="@SgIcons.Monitor" Size="32px" Color="var(--sg-color-danger)" />
                                            </div>
                                            <div>
                                                <SgTypography Variant="SgTypographyVariant.Heading5">Compact View</SgTypography>
                                                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                                                    Single column, optimized for narrow spaces.
                                                </SgTypography>
                                            </div>
                                            <div class="rsp-adaptive-placeholder rsp-adaptive-placeholder-narrow"></div>
                                        </div>
                                    </OnNarrow>
                                    <OnMedium>
                                        <div class="rsp-adaptive rsp-adaptive-medium">
                                            <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                                                <SgIcon Icon="@SgIcons.Monitor" Size="36px" Color="var(--sg-color-info)" />
                                                <SgStack Vertical Space="SgSize.Sm">
                                                    <SgTypography Variant="SgTypographyVariant.Heading5">Standard View</SgTypography>
                                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Balanced distribution of elements.</SgTypography>
                                                </SgStack>
                                            </SgStack>
                                            <div class="rsp-adaptive-grid-2">
                                                <div class="rsp-adaptive-placeholder"></div>
                                                <div class="rsp-adaptive-placeholder"></div>
                                            </div>
                                        </div>
                                    </OnMedium>
                                    <OnWide>
                                        <div class="rsp-adaptive rsp-adaptive-wide">
                                            <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                                <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                                                    <SgIcon Icon="@SgIcons.Monitor" Size="44px" Color="var(--sg-color-success)" />
                                                    <SgStack Vertical Space="SgSize.Sm">
                                                        <SgTypography Variant="SgTypographyVariant.Heading4">Expanded View</SgTypography>
                                                        <SgTypography Size="SgTypographySize.Base" Color="var(--sg-text-muted)">Full-featured desktop layout.</SgTypography>
                                                    </SgStack>
                                                </SgStack>
                                                <SgButton Text="Action" Variant="SgButtonVariant.Primary" Size="SgSize.Sm" />
                                            </SgStack>
                                            <div class="rsp-adaptive-grid-21">
                                                <div class="rsp-adaptive-placeholder rsp-adaptive-placeholder-tall">Main content</div>
                                                <SgStack Vertical Space="SgSize.Sm">
                                                    <div class="rsp-adaptive-placeholder" style="height:80px"></div>
                                                    <div class="rsp-adaptive-placeholder" style="height:80px"></div>
                                                </SgStack>
                                            </div>
                                        </div>
                                    </OnWide>
                                </SgResponsiveContainer>
                            </Second>
                        </SgSplitter>
                    </SgCard>
                </SgCol>

                @* ── Configuration ── *@
                <SgCol Xs="12" Md="4">
                    <SgCard Title="Configuration" Shadow="SgShadow.Sm" Hoverable="true" Animated="true">
                        <SgStack Vertical Space="SgSize.Md">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Color="var(--sg-text-muted)">Narrow Threshold</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Danger" Text="@($"{_narrowThreshold}px")" Standalone="true" />
                                </SgStack>
                                <input type="range" min="200" max="500" step="10" @bind="_narrowThreshold" @bind:after="UpdateCtorCode" class="rsp-range" />
                            </SgStack>

                            <SgDivider />

                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Color="var(--sg-text-muted)">Wide Threshold</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Success" Text="@($"{_wideThreshold}px")" Standalone="true" />
                                </SgStack>
                                <input type="range" min="510" max="1000" step="10" @bind="_wideThreshold" @bind:after="UpdateCtorCode" class="rsp-range" />
                            </SgStack>

                            <SgDivider />

                            <SgStack Vertical Space="SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Color="var(--sg-text-muted)">Debounce (ms)</SgTypography>
                                <SgSegmented TValue="int"
                                             Value="@_debounceMs"
                                             ValueChanged="v => { _debounceMs = v; UpdateCtorCode(); }"
                                             Block="true" Size="sm"
                                             Options="_debounceOptions" />
                            </SgStack>

                            <SgDivider />

                            <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Color="var(--sg-text-muted)">Transitions</SgTypography>
                                <SgSwitch @bind-Value="_transitionEnabled" />
                            </SgStack>

                            <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Color="var(--sg-text-muted)">Debug Indicator</SgTypography>
                                <SgSwitch @bind-Value="_showIndicator" />
                            </SgStack>
                        </SgStack>
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

        @* ═══════════════════════════════════════════════════════════════════
           2. Media Query — SgMediaQuery
           ═══════════════════════════════════════════════════════════════════ *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Media Query
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgMediaQuery</SgTypography> uses <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">window.matchMedia</SgTypography>. Use raw <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Query</SgTypography> or shorthand <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Above</SgTypography>/<SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Below</SgTypography>/<SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">BetweenStart</SgTypography>.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="6">
                    <SgCard Title="Enum shorthand" Subtitle="Above · Below · Between" Shadow="SgShadow.Sm" Hoverable="true" Animated="true">
                        <SgStack Vertical Space="SgSize.Md">
                            <SgMediaQuery Above="SgBreakpoint.Md">
                                <div class="rsp-mq-card rsp-mq-success">
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                        <SgIcon Icon="@SgIcons.Check" Color="var(--sg-color-success)" />
                                        <SgTypography Size="SgTypographySize.Sm"><SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Above="Md"</SgTypography> — visible at MD and above (≥ 768px)</SgTypography>
                                    </SgStack>
                                </div>
                            </SgMediaQuery>
                            <SgMediaQuery Below="SgBreakpoint.Md">
                                <div class="rsp-mq-card rsp-mq-warn">
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                        <SgIcon Icon="@SgIcons.Info" Color="var(--sg-color-warning)" />
                                        <SgTypography Size="SgTypographySize.Sm"><SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Below="Md"</SgTypography> — visible below MD (&lt; 768px)</SgTypography>
                                    </SgStack>
                                </div>
                            </SgMediaQuery>
                            <SgMediaQuery BetweenStart="SgBreakpoint.Sm" BetweenEnd="SgBreakpoint.Lg">
                                <div class="rsp-mq-card rsp-mq-info">
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                        <SgIcon Icon="@SgIcons.Activity" Color="var(--sg-color-info)" />
                                        <SgTypography Size="SgTypographySize.Sm"><SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">BetweenStart="Sm" BetweenEnd="Lg"</SgTypography> — 576 – 991px</SgTypography>
                                    </SgStack>
                                </div>
                            </SgMediaQuery>
                        </SgStack>
                    </SgCard>
                </SgCol>

                <SgCol Xs="12" Md="6">
                    <SgCard Title="Raw query" Subtitle="Query='(min-width: 1200px)'" Shadow="SgShadow.Sm" Hoverable="true" Animated="true">
                        <SgStack Vertical Space="SgSize.Md">
                            <SgMediaQuery Query="(min-width: 1200px)">
                                <Matching>
                                    <div class="rsp-mq-card rsp-mq-primary">
                                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                            <SgIcon Icon="@SgIcons.Monitor" Color="var(--sg-color-primary)" />
                                            <SgTypography Size="SgTypographySize.Sm">Desktop layout active (≥ 1200px)</SgTypography>
                                        </SgStack>
                                    </div>
                                </Matching>
                                <NotMatching>
                                    <div class="rsp-mq-card rsp-mq-muted">
                                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                            <SgIcon Icon="@SgIcons.Monitor" Color="var(--sg-text-muted)" />
                                            <SgTypography Size="SgTypographySize.Sm">Not a desktop viewport (&lt; 1200px)</SgTypography>
                                        </SgStack>
                                    </div>
                                </NotMatching>
                            </SgMediaQuery>
                            <SgMediaQuery Query="(orientation: portrait)">
                                <Matching>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="Portrait" Standalone="true" />
                                </Matching>
                                <NotMatching>
                                    <SgBadge Variant="SgBadgeVariant.Success" Text="Landscape" Standalone="true" />
                                </NotMatching>
                            </SgMediaQuery>
                        </SgStack>
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

        @* ═══════════════════════════════════════════════════════════════════
           3. Breakpoint Service — SgBreakpointService (inject)
           ═══════════════════════════════════════════════════════════════════ *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Breakpoint Service
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Inject <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgBreakpointService</SgTypography> and react to the current viewport breakpoint — Bootstrap 5 thresholds, reuses <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgViewportService</SgTypography>.
                </SgTypography>
            </div>

            <SgCard Title="Live viewport state" Subtitle="Updates when window is resized" Shadow="SgShadow.Sm" Hoverable="true" Animated="true">
                <SgRow Space="SgSize.Md">
                    @foreach (var bp in _allBreakpoints)
                    {
                        var isActive = Breakpoints.Breakpoint == bp.Key;
                        var color = bp.Color;
                        <SgCol Xs="6" Sm="4" Md="2">
                            <div class="rsp-bp-card @(isActive ? "rsp-bp-active" : "")" style="--bp-color:@color">
                                <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                    <SgTypography Size="SgTypographySize.Lg" Weight="SgTypographyWeight.Bold" Color="@(isActive ? color : "var(--sg-text-muted)")">@bp.Key</SgTypography>
                                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">@bp.Range</SgTypography>
                                    @if (isActive)
                                    {
                                        <SgBadge Variant="@bp.BadgeVariant" Text="Active" Standalone="true" Size="SgSize.Sm" />
                                    }
                                </SgStack>
                            </div>
                        </SgCol>
                    }
                </SgRow>
            </SgCard>
        </div>

        @* ═══════════════════════════════════════════════════════════════════
           4. ShowAt / HideAt — convenient named shortcuts
           ═══════════════════════════════════════════════════════════════════ *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    ShowAt &amp; HideAt
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Render content only at specified breakpoints — common in dashboards and responsive navigation.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Md">
                <SgCol Xs="12" Md="6">
                    <SgCard Title="SgShowAt" Subtitle="Show at breakpoint and above" Shadow="SgShadow.Sm" Hoverable="true" Animated="true">
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgShowAt Below="SgBreakpoint.Sm">
                                <div class="rsp-mq-card rsp-mq-warn">
                                    <SgTypography Size="SgTypographySize.Sm"><SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Below="Sm"</SgTypography> — only on tiny screens</SgTypography>
                                </div>
                            </SgShowAt>
                            <SgShowAt AtOrAbove="SgBreakpoint.Md">
                                <div class="rsp-mq-card rsp-mq-info">
                                    <SgTypography Size="SgTypographySize.Sm"><SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">AtOrAbove="Md"</SgTypography> — tablets, laptops, desktops</SgTypography>
                                </div>
                            </SgShowAt>
                            <SgShowAt AtOrAbove="SgBreakpoint.Xl">
                                <div class="rsp-mq-card rsp-mq-success">
                                    <SgTypography Size="SgTypographySize.Sm"><SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">AtOrAbove="Xl"</SgTypography> — large desktops only</SgTypography>
                                </div>
                            </SgShowAt>
                        </SgStack>
                    </SgCard>
                </SgCol>
                <SgCol Xs="12" Md="6">
                    <SgCard Title="SgHideAt" Subtitle="Hide at breakpoint and above" Shadow="SgShadow.Sm" Hoverable="true" Animated="true">
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgHideAt AtOrAbove="SgBreakpoint.Lg">
                                <div class="rsp-mq-card rsp-mq-danger">
                                    <SgTypography Size="SgTypographySize.Sm"><SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">AtOrAbove="Lg"</SgTypography> — hidden on laptops and above (compact hint)</SgTypography>
                                </div>
                            </SgHideAt>
                            <SgHideAt Below="SgBreakpoint.Md">
                                <div class="rsp-mq-card rsp-mq-primary">
                                    <SgTypography Size="SgTypographySize.Sm"><SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Below="Md"</SgTypography> — hidden on phones, shown on tablets and up</SgTypography>
                                </div>
                            </SgHideAt>
                        </SgStack>
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

        @* ═══════════════════════════════════════════════════════════════════
           5. Visibility Sensor — SgVisibilitySensor
           ═══════════════════════════════════════════════════════════════════ *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Visibility Sensor
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgVisibilitySensor</SgTypography> uses <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">IntersectionObserver</SgTypography> — scroll down to trigger lazy loading and reveal animations.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Md">
                @for (int i = 0; i < 3; i++)
                {
                    var idx = i;
                    var revealed = _revealed[idx];
                    <SgCol Xs="12" Md="4">
                        <SgVisibilitySensor Threshold="0.3" OnVisible="@(() => OnCardRevealed(idx))" Once="true">
                            <div class="rsp-vis-card @(revealed ? "rsp-vis-revealed" : "rsp-vis-hidden")">
                                <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                    <div class="rsp-vis-icon" style="background:color-mix(in srgb,@_visColors[idx] 18%,transparent);color:@_visColors[idx]">
                                        <SgIcon Icon="@(idx == 0 ? SgIcons.Eye : idx == 1 ? SgIcons.Sparkles : SgIcons.Zap)" Size="28px" Color="@_visColors[idx]" />
                                    </div>
                                    <SgTypography Weight="SgTypographyWeight.Semibold">Card @(_visLabels[idx])</SgTypography>
                                                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" Align="SgTypographyAlign.Center">@((revealed ? "Visible — observer fired" : "Hidden — scroll to reveal"))</SgTypography>
                                    <SgBadge Variant="@(revealed ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(revealed ? "Revealed" : "Waiting")" Standalone="true" />
                                </SgStack>
                            </div>
                        </SgVisibilitySensor>
                    </SgCol>
                }
            </SgRow>
        </div>

        @* ═══════════════════════════════════════════════════════════════════
           6. Live SgResponsiveContainer Constructor
           ═══════════════════════════════════════════════════════════════════ *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Live SgResponsiveContainer Constructor
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Configure every SgResponsiveContainer parameter in real time · copy the code.
                </SgTypography>
            </div>

            <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
                <SgRow Space="SgSize.Md">
                    @* ── Control Panel ── *@
                    <SgCol Xs="12" Md="5" Style="padding:14px;border-right:1px solid var(--sg-border);">
                        <SgStack Vertical Space="SgSize.Md">
                            @* Narrow / Wide threshold *@
                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Narrow Threshold</SgTypography>
                                        <SgSegmented TValue="int"
                                                     Value="@_ctorNarrow"
                                                     ValueChanged="v => { _ctorNarrow = v; UpdateCtorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_ctorNarrowOptions" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Wide Threshold</SgTypography>
                                        <SgSegmented TValue="int"
                                                     Value="@_ctorWide"
                                                     ValueChanged="v => { _ctorWide = v; UpdateCtorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_ctorWideOptions" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>

                            @* Debounce / Default BP *@
                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Debounce (ms)</SgTypography>
                                        <SgSegmented TValue="int"
                                                     Value="@_ctorDebounce"
                                                     ValueChanged="v => { _ctorDebounce = v; UpdateCtorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_debounceOptions" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Default BP (SSR)</SgTypography>
                                        <SgSegmented TValue="string"
                                                     Value="@_ctorDefault"
                                                     ValueChanged="v => { _ctorDefault = v; UpdateCtorCode(); }"
                                                     Block="true" Size="sm"
                                                     Options="_defaultOptions" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>

                            @* Toggles *@
                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Transitions</SgTypography>
                                        <SgSegmented TValue="bool" Value="@_ctorTransitions" ValueChanged="v => { _ctorTransitions = v; UpdateCtorCode(); }" Block="true" Size="sm" Options="_boolOptions" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Debug Indicator</SgTypography>
                                        <SgSegmented TValue="bool" Value="@_ctorIndicator" ValueChanged="v => { _ctorIndicator = v; UpdateCtorCode(); }" Block="true" Size="sm" Options="_boolOptions" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>

                            @* Tag (semantic HTML) *@
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Semantic Tag</SgTypography>
                                <SgSegmented TValue="string"
                                             Value="@_ctorTag"
                                             ValueChanged="v => { _ctorTag = v; UpdateCtorCode(); }"
                                             Block="true" Size="sm"
                                             Options="_tagOptions" />
                            </SgStack>
                        </SgStack>
                    </SgCol>

                    @* ── Preview + Code ── *@
                    <SgCol Xs="12" Md="7" Style="padding:14px;">
                        <SgStack Vertical Space="SgSize.Md">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                                <div class="constructor-preview">
                                    <SgResponsiveContainer NarrowThreshold="@_ctorNarrow"
                                                         WideThreshold="@_ctorWide"
                                                         ObserveDebounceMs="@_ctorDebounce"
                                                         TransitionEnabled="@_ctorTransitions"
                                                         ShowBreakpointIndicator="@_ctorIndicator"
                                                         DefaultBreakpoint="@_ctorDefault"
                                                         Tag="@_ctorTag"
                                                         MinHeight="120"
                                                         Padding="12px"
                                                         ClassName="rsp-ctor">
                                        <OnNarrow>
                                            <div class="rsp-ctor-pill" style="background:var(--sg-color-danger-subtle);color:var(--sg-color-danger);">Narrow · &lt; @_ctorNarrow px</div>
                                        </OnNarrow>
                                        <OnMedium>
                                            <div class="rsp-ctor-pill" style="background:var(--sg-color-info-subtle);color:var(--sg-color-info);">Medium · @_ctorNarrow – @_ctorWide px</div>
                                        </OnMedium>
                                        <OnWide>
                                            <div class="rsp-ctor-pill" style="background:var(--sg-color-success-subtle);color:var(--sg-color-success);">Wide · ≥ @_ctorWide px</div>
                                        </OnWide>
                                    </SgResponsiveContainer>
                                </div>
                            </SgStack>

                            <SgStack Vertical Space="SgSize.Sm">
                                <div class="rsp-code-header">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                    <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCtorCode">
                                        <span>@_ctorCopyIcon</span>
                                        <span style="font-size:11px;font-weight:600;">@_ctorCopyLabel</span>
                                    </button>
                                </div>
                                <div class="code-block">
                                    @foreach (var line in _ctorGeneratedCode)
                                    {
                                        <code>@line</code>
                                    }
                                </div>
                            </SgStack>
                        </SgStack>
                    </SgCol>
                </SgRow>
            </SgCard>
        </div>

        @* ═══════════════════════════════════════════════════════════════════
           7. Properties Reference
           ═══════════════════════════════════════════════════════════════════ *@
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    SgResponsiveContainer — Properties Reference
                </SgTypography>
            </div>
            <SgCard Shadow="SgShadow.Sm" Hoverable="true" Animated="true">
                <PropertyTable Items="_props" />
            </SgCard>
        </div>

    </ChildContent>
</SgCard>

