@page "/popover-demo"
@using SuperUI.Components

<PageTitle>Всплывающее окно - SUI</PageTitle>

<SgCard Title="SgPopover - Всплывающее окно"
        Subtitle="Компонент для отображения дополнительной информации при клике. Поддерживает различные позиции и пользовательское содержимое.">

    <div style="margin-top: 32px;">
        <h2>Примеры использования</h2>
        <p>Интерактивные примеры всплывающих окон с различными конфигурациями.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Базовые примеры">
                <div style="display: flex; flex-direction: column; gap: 16px; align-items: flex-start;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Информационный поповер</div>
                        <SgPopover Title="Информация" @bind-Open="_pop1">
                            <TriggerContent>
                                <SgButton Text="Нажмите для информации" Variant="primary" />
                            </TriggerContent>
                            <ChildContent>
                                <p style="margin: 0;">Это всплывающее окно с дополнительной информацией о компоненте.</p>
                            </ChildContent>
                        </SgPopover>
                    </div>

                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Поповер подтверждения</div>
                        <SgPopover Title="Подтверждение" @bind-Open="_pop2">
                            <TriggerContent>
                                <SgButton Text="Удалить запись" Variant="danger" />
                            </TriggerContent>
                            <ChildContent>
                                <p style="margin: 0 0 12px;">Вы уверены, что хотите удалить эту запись?</p>
                                <div style="display: flex; gap: 8px;">
                                    <SgButton Text="Удалить" Variant="danger" Size="sm" OnClick="DeleteRecord" />
                                    <SgButton Text="Отмена" Size="sm" OnClick="@(() => _pop2 = false)" />
                                </div>
                            </ChildContent>
                        </SgPopover>
                    </div>

                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Поповер со стрелкой</div>
                        <SgPopover Title="Подсказка" ShowArrow="true" @bind-Open="_pop3">
                            <TriggerContent>
                                <SgButton Text="Со стрелкой" />
                            </TriggerContent>
                            <ChildContent>
                                <p style="margin: 0;">Поповер со стрелкой, указывающей на триггер.</p>
                            </ChildContent>
                        </SgPopover>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_popoverProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Позиционирование</h2>
        <p>Поповер поддерживает 12 позиций относительно триггера.</p>

        <SgCard Title="Варианты позиций" Style="margin-top: 16px;">
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                @foreach (var placement in _placements)
                {
                    var p = placement;
                    var open = _placementOpen.ContainsKey(p) && _placementOpen[p];
                    <SgPopover Title="@p" Placement="@p" @bind-Open="_placementOpen[p]">
                        <TriggerContent>
                            <SgButton Text="@p" Size="sm" />
                        </TriggerContent>
                        <ChildContent>
                            <p style="margin: 0;">Позиция: <strong>@p</strong></p>
                        </ChildContent>
                    </SgPopover>
                }
            </div>
        </SgCard>
    </div>

</SgCard>

@code {
    private bool _pop1;
    private bool _pop2;
    private bool _pop3;

    private void DeleteRecord()
    {
        _pop2 = false;
    }

    private List<string> _placements = new()
    {
        "top-start", "top", "top-end",
        "bottom-start", "bottom", "bottom-end",
        "left-start", "left", "left-end",
        "right-start", "right", "right-end"
    };

    private Dictionary<string, bool> _placementOpen = new()
    {
        ["top-start"] = false, ["top"] = false, ["top-end"] = false,
        ["bottom-start"] = false, ["bottom"] = false, ["bottom-end"] = false,
        ["left-start"] = false, ["left"] = false, ["left-end"] = false,
        ["right-start"] = false, ["right"] = false, ["right-end"] = false
    };

    private List<PropertyPanelItem> _popoverProperties = new()
    {
        new() { Label = "Open", Value = "bool", BadgeText = "Открыт", BadgeVariant = "warn" },
        new() { Label = "OpenChanged", Value = "EventCallback<bool>", BadgeText = "Событие", BadgeVariant = "success" },
        new() { Label = "Title", Value = "string", BadgeText = "Заголовок", BadgeVariant = "info" },
        new() { Label = "Placement", Value = "top|bottom|left|right + start/end", BadgeText = "Позиция", BadgeVariant = "info" },
        new() { Label = "ShowArrow", Value = "bool", BadgeText = "Стрелка", BadgeVariant = "warn" },
        new() { Label = "CloseOnOutsideClick", Value = "bool", BadgeText = "Закрыть снаружи", BadgeVariant = "warn" },
        new() { Label = "CloseOnEscape", Value = "bool", BadgeText = "Закрыть по Esc", BadgeVariant = "warn" },
        new() { Label = "TriggerContent", Value = "RenderFragment", BadgeText = "Триггер", BadgeVariant = "info" },
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Содержимое", BadgeVariant = "info" }
    };
}
