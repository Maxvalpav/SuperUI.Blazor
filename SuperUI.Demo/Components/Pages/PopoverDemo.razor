@page "/popover-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgPopover -- Popover -- SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ================================================================ -->
    <!-- 1. Basic Examples                                                -->
    <!-- ================================================================ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Basic Usage
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Click trigger elements to reveal popovers with additional content.
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Title</SgTypography> sets the header,
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ChildContent</SgTypography> is the body content,
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Placement</SgTypography> controls position.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Popover Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;">
                            Action Buttons
                        </SgTypography>
                        <SgSpace>
                            <SgPopover Title="Information" @bind-Open="_basicPop1">
                                <TriggerContent>
                                    <SgButton Variant="SgButtonVariant.Primary" Size="SgSize.Sm">
                                        <ChildContent>
                                            <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                                <SgHeroicon Name="SgHeroicons.Names.Info" Size="14px" />
                                                <span>Info</span>
                                            </SgStack>
                                        </ChildContent>
                                    </SgButton>
                                </TriggerContent>
                                <ChildContent>
                                    <p style="margin:0;">This popover provides additional information about the component.</p>
                                </ChildContent>
                            </SgPopover>
                            <SgPopover Title="Confirm Action" @bind-Open="_basicPop2">
                                <TriggerContent>
                                    <SgButton Variant="SgButtonVariant.Danger" Size="SgSize.Sm">Delete</SgButton>
                                </TriggerContent>
                                <ChildContent>
                                    <p style="margin:0 0 12px;">Are you sure you want to delete this record?</p>
                                    <SgSpace>
                                        <SgButton Text="Delete" Variant="SgButtonVariant.Danger" Size="SgSize.Sm" OnClick="@(() => _basicPop2 = false)" />
                                        <SgButton Text="Cancel" Size="SgSize.Sm" OnClick="@(() => _basicPop2 = false)" />
                                    </SgSpace>
                                </ChildContent>
                            </SgPopover>
                            <SgPopover Title="Tip" ShowArrow="true" @bind-Open="_basicPop3">
                                <TriggerContent>
                                    <SgButton Variant="SgButtonVariant.Outlined" Size="SgSize.Sm">With Arrow</SgButton>
                                </TriggerContent>
                                <ChildContent>
                                    <p style="margin:0;">Popover with an arrow pointing to the trigger element.</p>
                                </ChildContent>
                            </SgPopover>
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;">
                            Custom Trigger via SgButton
                        </SgTypography>
                        <SgButton @onclick="() => _basicPop4 = !_basicPop4"
                                  Variant="SgButtonVariant.Ghost" Size="SgSize.Sm">
                            <ChildContent>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                    <SgHeroicon Name="SgHeroicons.Names.Cog6Tooth" Size="16px" />
                                    <span>Settings</span>
                                </SgStack>
                            </ChildContent>
                        </SgButton>
                        <SgPopover Title="Settings" @bind-Open="_basicPop4" Placement="SgPlacement.Bottom">
                            <TriggerContent>
                                <span></span>
                            </TriggerContent>
                            <ChildContent>
                                <SgStack Vertical Space="SgSize.Sm">
                                    <label><input type="checkbox" /> Enable notifications</label>
                                    <label><input type="checkbox" /> Dark mode</label>
                                    <label><input type="checkbox" /> Auto-save</label>
                                </SgStack>
                            </ChildContent>
                        </SgPopover>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="SgPopover Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_popoverProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ================================================================ -->
    <!-- 2. Placement Examples                                             -->
    <!-- ================================================================ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Placement -- All 12 Positions
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Placement</SgTypography> controls where the popover appears relative to the trigger.
                Extended variants (<SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">TopStart</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">BottomEnd</SgTypography>, etc.) align the popover edge with the trigger.
            </SgTypography>
        </div>

        <SgCard Title="All Placement Variants" Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgStack Vertical Space="SgSize.Lg">
                @foreach (var group in _placementGroups)
                {
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            @group.Label
                        </SgTypography>
                        <SgSpace Wrap="true">
                            @foreach (var p in group.Items)
                            {
                                <SgPopover Title="@($"Placement: {p.Value}")" Placement="@p.Value" ShowArrow="true" @bind-Open="_placementOpen[p.Value]">
                                    <TriggerContent>
                                        <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined">@p.Label</SgButton>
                                    </TriggerContent>
                                    <ChildContent>
                                        <p style="margin:0;">Popover positioned at <strong>@p.Value</strong></p>
                                    </ChildContent>
                                </SgPopover>
                            }
                        </SgSpace>
                    </div>
                }
            </SgStack>
        </SgCard>
    </div>

    <!-- ================================================================ -->
    <!-- 3. Trigger Modes                                                  -->
    <!-- ================================================================ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Trigger Modes
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Trigger</SgTypography> controls the interaction that shows/hides the popover:
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Click</SgTypography> (default), <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Hover</SgTypography>, or <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Manual</SgTypography>.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Trigger Behaviors" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgRow Space="SgSize.Lg">
                        <SgCol Span="6">
                            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Click (default)</SgTypography>
                                <SgPopover Title="Click Popover" Trigger="SgTrigger.Click">
                                    <TriggerContent>
                                        <SgButton Size="SgSize.Sm">Click me</SgButton>
                                    </TriggerContent>
                                    <ChildContent>
                                        <p style="margin:0;">I appear on click!</p>
                                    </ChildContent>
                                </SgPopover>
                            </SgStack>
                        </SgCol>
                        <SgCol Span="6">
                            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Hover</SgTypography>
                                <SgPopover Title="Hover Popover" Trigger="SgTrigger.Hover">
                                    <TriggerContent>
                                        <SgButton Size="SgSize.Sm">Hover me</SgButton>
                                    </TriggerContent>
                                    <ChildContent>
                                        <p style="margin:0;">I appear on hover!</p>
                                    </ChildContent>
                                </SgPopover>
                            </SgStack>
                        </SgCol>
                        <SgCol Span="6">
                            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Hover + Interactive</SgTypography>
                                <SgPopover Title="Interactive Popover" Trigger="SgTrigger.Hover" Interactive="true" ShowArrow="true">
                                    <TriggerContent>
                                        <SgButton Size="SgSize.Sm">Hover + stay</SgButton>
                                    </TriggerContent>
                                    <ChildContent>
                                        <p style="margin:0 0 8px;">I stay open when you hover over me!</p>
                                        <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Primary">Click me</SgButton>
                                    </ChildContent>
                                </SgPopover>
                            </SgStack>
                        </SgCol>
                        <SgCol Span="6">
                            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Manual</SgTypography>
                                <SgSpace>
                                    <SgPopover @ref="_manualPopover" Title="Manual Popover" Trigger="SgTrigger.Manual">
                                        <TriggerContent>
                                            <SgButton Size="SgSize.Sm">Target</SgButton>
                                        </TriggerContent>
                                        <ChildContent>
                                            <p style="margin:0;">I appear programmatically!</p>
                                        </ChildContent>
                                    </SgPopover>
                                    <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Primary" @onclick="ToggleManualPopoverAsync">@_manualButtonLabel</SgButton>
                                </SgSpace>
                            </SgStack>
                        </SgCol>
                    </SgRow>
                </SgStack>
            </SgCard>

            <SgCard Title="Configuration" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;">
                            CloseOnOutsideClick = false
                        </SgTypography>
                        <SgPopover Title="Persistent" CloseOnOutsideClick="false" ShowArrow="true">
                            <TriggerContent>
                                <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined">Click (persistent)</SgButton>
                            </TriggerContent>
                            <ChildContent>
                                <p style="margin:0;">I don't close when you click outside. Press ESC or click the button again.</p>
                            </ChildContent>
                        </SgPopover>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;">
                            CloseOnEscape = false
                        </SgTypography>
                        <SgPopover Title="No ESC" CloseOnEscape="false" ShowArrow="true">
                            <TriggerContent>
                                <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined">Click (no ESC)</SgButton>
                            </TriggerContent>
                            <ChildContent>
                                <p style="margin:0;">ESC key won't close me. Click outside or the trigger to close.</p>
                            </ChildContent>
                        </SgPopover>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;">
                            Disabled
                        </SgTypography>
                        <SgPopover Title="Disabled Popover" Disabled="true" ShowArrow="true">
                            <TriggerContent>
                                <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined">Disabled</SgButton>
                            </TriggerContent>
                            <ChildContent>
                                <p style="margin:0;">I should not appear.</p>
                            </ChildContent>
                        </SgPopover>
                    </div>
                </SgStack>
            </SgCard>
        </div>
    </div>

    <!-- ================================================================ -->
    <!-- 4. Color Variants                                                 -->
    <!-- ================================================================ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Color Variants
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Use the <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Color</SgTypography> parameter to set any background color.
                Combine with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ShowArrow</SgTypography> for a polished look.
            </SgTypography>
        </div>

        <SgCard Title="Color Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgSpace Wrap="true">
                @foreach (var c in _colorExamples)
                {
                    <SgPopover Title="@c.Title" Color="@c.Color" ShowArrow="true">
                        <TriggerContent>
                            <SgButton Size="SgSize.Sm">@c.Label</SgButton>
                        </TriggerContent>
                        <ChildContent>
                            <p style="margin:0;">Color: @c.Label</p>
                        </ChildContent>
                    </SgPopover>
                }
            </SgSpace>
        </SgCard>
    </div>

    <!-- ================================================================ -->
    <!-- 5. Rich Content                                                   -->
    <!-- ================================================================ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Rich Content
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Popovers can contain any Blazor content -- buttons, forms, lists, icons, and more.
            </SgTypography>
        </div>

        <SgCard Title="Rich Content Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgRow Space="SgSize.Lg">
                <SgCol Md="4">
                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Form</SgTypography>
                        <SgPopover Title="Quick Login" Placement="SgPlacement.Bottom" ShowArrow="true">
                            <TriggerContent>
                                <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined">Login</SgButton>
                            </TriggerContent>
                            <ChildContent>
                                <SgStack Vertical Space="SgSize.Sm">
                                    <input type="email" class="demo-input" placeholder="Email" />
                                    <input type="password" class="demo-input" placeholder="Password" />
                                    <SgButton Text="Sign In" Variant="SgButtonVariant.Primary" Block="true" />
                                </SgStack>
                            </ChildContent>
                        </SgPopover>
                    </SgStack>
                </SgCol>
                <SgCol Md="4">
                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">List with Icons</SgTypography>
                        <SgPopover Title="Notifications" Placement="SgPlacement.Bottom" ShowArrow="true">
                            <TriggerContent>
                                <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined">
                                    <SgHeroicon Name="SgHeroicons.Names.Bell" Size="16px" />
                                </SgButton>
                            </TriggerContent>
                            <ChildContent>
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                        <SgHeroicon Name="SgHeroicons.Names.CheckCircle" Size="14px" Color="var(--sg-color-success)" />
                                        <span style="font-size:12px;">Deployment successful</span>
                                    </SgStack>
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                        <SgHeroicon Name="SgHeroicons.Names.ExclamationCircle" Size="14px" Color="var(--sg-color-warning)" />
                                        <span style="font-size:12px;">Disk usage at 85%</span>
                                    </SgStack>
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                        <SgHeroicon Name="SgHeroicons.Names.XCircle" Size="14px" Color="var(--sg-color-danger)" />
                                        <span style="font-size:12px;">3 failed jobs</span>
                                    </SgStack>
                                </SgStack>
                            </ChildContent>
                        </SgPopover>
                    </SgStack>
                </SgCol>
                <SgCol Md="4">
                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">User Profile</SgTypography>
                        <SgPopover Title="User Profile" Placement="SgPlacement.Bottom" ShowArrow="true" MaxWidth="240px">
                            <TriggerContent>
                                <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined">Profile</SgButton>
                            </TriggerContent>
                            <ChildContent>
                                <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                    <div style="width:48px;height:48px;border-radius:50%;background:var(--sg-primary);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:600;font-size:18px;">JD</div>
                                    <div style="text-align:center;">
                                        <div style="font-weight:600;font-size:13px;">John Doe</div>
                                        <div style="font-size:11px;opacity:0.8;">john.doe@example.com</div>
                                    </div>
                                    <SgButton Text="View Profile" Size="SgSize.Sm" Variant="SgButtonVariant.Outlined" Block="true" />
                                    <SgButton Text="Sign Out" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" Block="true" />
                                </SgStack>
                            </ChildContent>
                        </SgPopover>
                    </SgStack>
                </SgCol>
            </SgRow>
        </SgCard>
    </div>

    <!-- ================================================================ -->
    <!-- 6. Size Variants                                                 -->
    <!-- ================================================================ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Size Variants
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Use the <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Size</SgTypography> parameter to control popover density.
            </SgTypography>
        </div>

        <SgCard Title="Size Variants" Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgSpace Wrap="true">
                @foreach (var sz in _sizeVariants)
                {
                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                        <SgPopover Title="@($"Size: {sz.Label}")" Size="@sz.Value" ShowArrow="true">
                            <TriggerContent>
                                <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined">@sz.Label</SgButton>
                            </TriggerContent>
                            <ChildContent>
                                <p style="margin:0;">Popover with @sz.Label size.</p>
                            </ChildContent>
                        </SgPopover>
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Weight="SgTypographyWeight.Medium">@sz.Label</SgTypography>
                    </SgStack>
                }
            </SgSpace>
        </SgCard>
    </div>

    <!-- ================================================================ -->
    <!-- 7. Offset Customization                                           -->
    <!-- ================================================================ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Offset Customization
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                The <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Offset</SgTypography> parameter controls the gap (px) between popover and trigger. Default: 6.
            </SgTypography>
        </div>

        <SgCard Title="Offset Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgSpace Wrap="true">
                @foreach (var o in _offsetExamples)
                {
                    <SgPopover Title="@($"Offset: {o}px")" Offset="@o" ShowArrow="true">
                        <TriggerContent>
                            <SgButton Size="SgSize.Sm">Offset @o</SgButton>
                        </TriggerContent>
                        <ChildContent>
                            <p style="margin:0;">Offset @o pixels from trigger.</p>
                        </ChildContent>
                    </SgPopover>
                }
            </SgSpace>
        </SgCard>
    </div>

    <!-- ================================================================ -->
    <!-- 8. Live SgPopover Constructor                                    -->
    <!-- ================================================================ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live SgPopover Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure all parameters and see the result live. Click the code to copy.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- Control Panel -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Title -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Title</SgTypography>
                            <input type="text" class="demo-input"
                                   value="@_ctorTitle"
                                   @oninput="e => { _ctorTitle = (string?)e.Value ?? _ctorTitle; UpdateConstructorCode(); }"
                                   placeholder="Popover title..." />
                        </SgStack>

                        <!-- Placement -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Placement</SgTypography>
                            <SgSelect TValue="SgPlacement"
                                      @bind-Value="_ctorPlacement"
                                      Items="_allPlacements"
                                      LabelSelector="x => x.ToString()"
                                      Block="true" />
                        </SgStack>

                        <!-- Trigger -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Trigger</SgTypography>
                            <SgSelect TValue="SgTrigger"
                                      @bind-Value="_ctorTrigger"
                                      Items="_allTriggers"
                                      LabelSelector="x => x.ToString()"
                                      Block="true" />
                        </SgStack>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="4">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Arrow</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorShowArrow"
                                                 ValueChanged="v => { _ctorShowArrow = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="4">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Disabled</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorDisabled"
                                                 ValueChanged="v => { _ctorDisabled = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="_boolSegOptions2" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="4">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Outside</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorCloseOnOutsideClick"
                                                 ValueChanged="v => { _ctorCloseOnOutsideClick = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Color</SgTypography>
                            <SgSegmented TValue="string"
                                         Value="_ctorColor"
                                         ValueChanged="v => { _ctorColor = v; UpdateConstructorCode(); }"
                                         Block="true" Size="sm"
                                         Options="_colorSegOptions" />
                        </SgStack>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgSelect TValue="SgSize?"
                                              @bind-Value="_ctorSize"
                                              Items="_allSizeOptions"
                                              LabelSelector="@(_sizeLabelSelector)"
                                              Block="true" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Offset</SgTypography>
                                    <input type="number" class="demo-input"
                                           value="@_ctorOffset"
                                           @oninput="e => { _ctorOffset = int.TryParse((string?)e.Value, out var v) ? v : 8; UpdateConstructorCode(); }"
                                           min="0" max="64" step="1" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">MaxWidth</SgTypography>
                            <input type="text" class="demo-input"
                                   value="@_ctorMaxWidth"
                                   @oninput="e => { _ctorMaxWidth = (string?)e.Value ?? string.Empty; UpdateConstructorCode(); }"
                                   placeholder="e.g. 400px" />
                        </SgStack>

                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Placement</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorPlacement.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Trigger</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorTrigger.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size / Offset</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@($"{_ctorSize?.ToString() ?? "Default"} / {_ctorOffset}px")" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- Preview + Code -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <div class="constructor-preview">
                                <SgPopover Title="@_ctorTitle"
                                           Placement="@_ctorPlacement"
                                           Trigger="@_ctorTrigger"
                                           ShowArrow="@_ctorShowArrow"
                                           Disabled="@_ctorDisabled"
                                           CloseOnOutsideClick="@_ctorCloseOnOutsideClick"
                                           Color="@(string.IsNullOrEmpty(_ctorColor) ? null : _ctorColor)"
                                           MaxWidth="@(string.IsNullOrEmpty(_ctorMaxWidth) ? null : _ctorMaxWidth)"
                                           Size="@_ctorSize"
                                           Offset="@_ctorOffset">
                                    <TriggerContent>
                                        <SgButton Variant="SgButtonVariant.Primary">Click me</SgButton>
                                    </TriggerContent>
                                    <ChildContent>
                                        <p style="margin:0;">Configurable popover content.</p>
                                    </ChildContent>
                                </SgPopover>
                            </div>
                        </SgStack>

                        <!-- Code -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                    <span id="copy-icon">@_copyIcon</span>
                                    <span id="copy-text" style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                </button>
                            </div>
                            <div class="code-block" id="code-block">
                                @foreach (var line in _generatedCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

    <!-- ================================================================ -->
    <!-- 9. Enum Reference                                                -->
    <!-- ================================================================ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Enum Reference
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Complete reference for <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgPlacement</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgTrigger</SgTypography>, and <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgSize</SgTypography>.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="4">
                <SgCard Title="SgPlacement" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_placementEnum" />
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="SgTrigger" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_triggerEnum" />
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="SgSize" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_sizeEnum" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

</ChildContent>
</SgCard>

<style>
