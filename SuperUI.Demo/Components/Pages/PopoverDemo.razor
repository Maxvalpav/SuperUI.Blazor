@code {
    // ── Main card header ─────────────────────────────────────────────────
    private RenderFragment _mainHeader => __builder =>
    {
        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
            <div style="display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,var(--sg-primary),#8b5cf6);color:#fff;flex-shrink:0;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/>
                </svg>
            </div>
            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">SgPopover</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Overlay content component with 12 placements, 4 trigger modes, size/color variants,
                    rich content support, arrows, and configurable offset/close behavior.
                </SgTypography>
            </SgStack>
        </SgStack>
    };

    // ── Placement groups ────────────────────────────────────────────────
    private List<PlacementGroup> _placementGroups => new()
    {
        new("Top", new[] { (SgPlacement.Top, "Top"), (SgPlacement.TopStart, "TopStart"), (SgPlacement.TopEnd, "TopEnd") }),
        new("Bottom", new[] { (SgPlacement.Bottom, "Bottom"), (SgPlacement.BottomStart, "BottomStart"), (SgPlacement.BottomEnd, "BottomEnd") }),
        new("Left", new[] { (SgPlacement.Left, "Left"), (SgPlacement.LeftStart, "LeftStart"), (SgPlacement.LeftEnd, "LeftEnd") }),
        new("Right", new[] { (SgPlacement.Right, "Right"), (SgPlacement.RightStart, "RightStart"), (SgPlacement.RightEnd, "RightEnd") }),
    };

    // ── Color examples ──────────────────────────────────────────────────
    private record ColorExample(string Title, string Label, string Color);
    private List<ColorExample> _colorExamples => new()
    {
        new("Default", "Default", ""),
        new("Info", "Info", "var(--sg-color-info)"),
        new("Success", "Success", "var(--sg-color-success)"),
        new("Warning", "Warning", "var(--sg-color-warning)"),
        new("Error", "Error", "var(--sg-color-danger)"),
        new("Custom Dark", "Custom Dark", "#1e293b"),
    };

    // ── Size variants ─────────────────────────────────────────────────
    private record SizeItem(string Label, SgSize? Value);
    private List<SizeItem> _sizeVariants => new()
    {
        new("Sm", SgSize.Sm), new("Md", SgSize.Md), new("Lg", SgSize.Lg), new("Xl", SgSize.Xl),
    };

    // ── Offset examples ─────────────────────────────────────────────────
    private int[] _offsetExamples = new[] { 0, 4, 6, 12, 24 };

    // ── Constructor state ─────────────────────────────────────────────────
    private string _ctorTitle = "Hello, Popover!";
    private SgPlacement _ctorPlacement = SgPlacement.BottomStart;
    private SgTrigger _ctorTrigger = SgTrigger.Click;
    private bool _ctorShowArrow = true;
    private bool _ctorDisabled;
    private bool _ctorCloseOnOutsideClick = true;
    private string _ctorColor = "";
    private string _ctorMaxWidth = "";
    private SgSize? _ctorSize;
    private int _ctorOffset = 6;

    private string[] _generatedCodeLines = Array.Empty<string>();
    private string _copyIcon = "";
    private string _copyLabel = "Copy";

    // ── Manual popover state ─────────────────────────────────────────────
    private SgPopover? _manualPopover;
    private string _manualButtonLabel = "Show popover";

    // ── Basic popover state ──────────────────────────────────────────────
    private bool _basicPop1;
    private bool _basicPop2;
    private bool _basicPop3;
    private bool _basicPop4;

    private Dictionary<SgPlacement, bool> _placementOpen = new()
    {
        [SgPlacement.TopStart] = false, [SgPlacement.Top] = false, [SgPlacement.TopEnd] = false,
        [SgPlacement.BottomStart] = false, [SgPlacement.Bottom] = false, [SgPlacement.BottomEnd] = false,
        [SgPlacement.LeftStart] = false, [SgPlacement.Left] = false, [SgPlacement.LeftEnd] = false,
        [SgPlacement.RightStart] = false, [SgPlacement.Right] = false, [SgPlacement.RightEnd] = false,
    };

    private async Task ToggleManualPopoverAsync()
    {
        if (_manualPopover is null) return;
        if (_manualPopover.Open)
        {
            await _manualPopover.CloseAsync();
            _manualButtonLabel = "Show popover";
        }
        else
        {
            await _manualPopover.OpenAsync();
            _manualButtonLabel = "Hide popover";
        }
    }

    // ── All enum values ───────────────────────────────────────────────────
    private readonly List<SgPlacement> _allPlacements = Enum.GetValues<SgPlacement>().ToList();
    private readonly List<SgTrigger> _allTriggers = Enum.GetValues<SgTrigger>().ToList();
    private readonly List<SgSize?> _allSizeOptions = new() { null, SgSize.Sm, SgSize.Md, SgSize.Lg, SgSize.Xl };
    private static readonly Func<SgSize?, string> _sizeLabelSelector = x => x?.ToString() ?? "Default";

    // ── Segmented options ─────────────────────────────────────────────────
    private readonly List<SgSegmentedOption<bool>> _boolSegOptions = new()
    {
        new() { Value = false, Label = "Off" },
        new() { Value = true, Label = "On" },
    };

    private readonly List<SgSegmentedOption<bool>> _boolSegOptions2 = new()
    {
        new() { Value = true, Label = "On" },
        new() { Value = false, Label = "Off" },
    };

    private readonly List<SgSegmentedOption<string>> _colorSegOptions = new()
    {
        new() { Value = "", Label = "Default" },
        new() { Value = "var(--sg-color-info)", Label = "Info" },
        new() { Value = "var(--sg-color-success)", Label = "Success" },
        new() { Value = "var(--sg-color-warning)", Label = "Warning" },
        new() { Value = "var(--sg-color-danger)", Label = "Error" },
        new() { Value = "#1e293b", Label = "Dark" },
    };

    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add($"<SgPopover Title=\"{_ctorTitle}\"");

        if (_ctorPlacement != SgPlacement.BottomStart)
            lines.Add($"           Placement=\"SgPlacement.{_ctorPlacement}\"");
        if (_ctorTrigger != SgTrigger.Click)
            lines.Add($"           Trigger=\"SgTrigger.{_ctorTrigger}\"");
        if (_ctorShowArrow)
            lines.Add($"           ShowArrow=\"true\"");
        if (_ctorDisabled)
            lines.Add($"           Disabled=\"true\"");
        if (!_ctorCloseOnOutsideClick)
            lines.Add($"           CloseOnOutsideClick=\"false\"");
        if (!string.IsNullOrEmpty(_ctorColor))
            lines.Add($"           Color=\"{_ctorColor}\"");
        if (!string.IsNullOrEmpty(_ctorMaxWidth))
            lines.Add($"           MaxWidth=\"{_ctorMaxWidth}\"");
        if (_ctorSize.HasValue)
            lines.Add($"           Size=\"SgSize.{_ctorSize.Value}\"");
        if (_ctorOffset != 6)
            lines.Add($"           Offset=\"{_ctorOffset}\"");

        lines.Add($"           >");
        lines.Add($"    <TriggerContent>");
        lines.Add($"        <SgButton Variant=\"SgButtonVariant.Primary\">Click me</SgButton>");
        lines.Add($"    </TriggerContent>");
        lines.Add($"    <ChildContent>");
        lines.Add($"        <p style=\"margin:0;\">Configurable popover content.</p>");
        lines.Add($"    </ChildContent>");
        lines.Add($"</SgPopover>");

        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "Copied!";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "Failed";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

