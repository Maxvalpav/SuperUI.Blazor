@page "/"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>AurumType — Natural Law Font — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Philosophy                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Philosophy — Mathematics as Design
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Every letter is a mathematical necessity, not an arbitrary shape.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Golden Ratio" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgTypography Variant="SgTypographyVariant.Body">
                        The golden ratio <strong>φ = (1 + √5) / 2 ≈ 1.618</strong> governs all proportions:
                    </SgTypography>
                    <div class="phi-value">
                        <span class="phi-symbol">φ</span>
                        <span class="phi-number">= 1.6180339887...</span>
                    </div>
                    <SgDivider />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Cap-height / x-height = φ &bull; Stem / counter = φ &bull; Serif / gap = φ
                    </SgTypography>
                </SgStack>
            </SgCard>

            <SgCard Title="Fibonacci Sequence" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgTypography Variant="SgTypographyVariant.Body">
                        Every metric is a Fibonacci number:
                    </SgTypography>
                    <div class="fib-row">
                        <span class="fib-chip">UPM=987</span>
                        <span class="fib-chip">Cap=610</span>
                        <span class="fib-chip">x=377</span>
                        <span class="fib-chip">Desc=233</span>
                    </div>
                    <div class="fib-row">
                        <span class="fib-chip">Stem=34</span>
                        <span class="fib-chip">Serif=13</span>
                        <span class="fib-chip">Overshoot=13</span>
                    </div>
                </SgStack>
            </SgCard>
        </div>

        <div class="demo-two-col" style="margin-top: 16px;">
            <SgCard Title="Logarithmic Spiral" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgTypography Variant="SgTypographyVariant.Body">
                        Every curve is a fragment of the golden spiral <strong>r(θ) = a·e^(b·θ)</strong>
                        where <strong>b = ln(φ)/(π/2)</strong>.
                    </SgTypography>
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Applied in terminals (O, C, G, S), apexes (A, M, N, V, W), and arcs (b, d, p, q, u).
                    </SgTypography>
                </SgStack>
            </SgCard>

            <SgCard Title="Variable Axes" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Sm">
                    <div class="axis-row"><span class="axis-tag">wght</span><span>Weight: 100–900 (Fibonacci-stems)</span></div>
                    <div class="axis-row"><span class="axis-tag">wdth</span><span>Width: 75–125 (φ-scale)</span></div>
                    <div class="axis-row"><span class="axis-tag">opsz</span><span>Optical Size: 6–144pt (log)</span></div>
                    <div class="axis-row"><span class="axis-tag">CONT</span><span>Contrast: 0–100 (harmonic)</span></div>
                </SgStack>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Phi Typographic Scale                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                &phi; Typographic Scale
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Font sizes follow the golden ratio progression &phi;ⁿ where base = 16px. Use CSS classes <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">.sgc-typo-phi-*</SgTypography> or CSS variables <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">--sg-text-phi-*</SgTypography>.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <div class="phi-scale-showcase">
                <div class="phi-scale-item phi-poster">
                    <span class="phi-scale-label">Poster &phi;⁶ 287px</span>
                    <span>Aa</span>
                </div>
                <div class="phi-scale-item phi-display">
                    <span class="phi-scale-label">Display &phi;⁵ 177px</span>
                    <span>Aa</span>
                </div>
                <div class="phi-scale-item phi-h1">
                    <span class="phi-scale-label">H1 &phi;⁴ 110px</span>
                    <span>Aa</span>
                </div>
                <div class="phi-scale-item phi-h2">
                    <span class="phi-scale-label">H2 &phi;³ 68px</span>
                    <span>Aa</span>
                </div>
                <div class="phi-scale-item phi-h3">
                    <span class="phi-scale-label">H3 &phi;² 42px</span>
                    <span>Aa</span>
                </div>
                <div class="phi-scale-item phi-lead">
                    <span class="phi-scale-label">Lead &phi;¹ 26px</span>
                    <span>Aa</span>
                </div>
                <div class="phi-scale-item phi-body">
                    <span class="phi-scale-label">Body &phi;⁰ 16px</span>
                    <span>The quick brown fox jumps over the lazy dog. AurumType — mathematics of nature.</span>
                </div>
                <div class="phi-scale-item phi-caption">
                    <span class="phi-scale-label">Caption &phi;⁻¹ 10px</span>
                    <span>The quick brown fox jumps over the lazy dog. Caption text at phi-inverse size.</span>
                </div>
                <div class="phi-scale-item phi-micro">
                    <span class="phi-scale-label">Micro &phi;⁻³ 4px</span>
                    <span>Micro</span>
                </div>
            </div>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Glyph Width Table                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Glyph Width Proportions
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Each character width is <strong>round(stem &times; &phi;ⁿ)</strong> where n depends on the character class.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgTable TItem="GlyphWidthInfo" Items="_glyphWidths" Hoverable="true">
                <ChildContent>
                    <SgTableColumn TItem="GlyphWidthInfo" Title="Glyph" Value="@(c => c.Glyph)" Width="60px" />
                    <SgTableColumn TItem="GlyphWidthInfo" Title="Class" Value="@(c => c.Class)" Width="80px" />
                    <SgTableColumn TItem="GlyphWidthInfo" Title="Width" Value="@(c => c.Width)" Width="70px" />
                    <SgTableColumn TItem="GlyphWidthInfo" Title="Law" Value="@(c => c.Law)" />
                </ChildContent>
            </SgTable>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. CSS Variables Integration                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                CSS Variable Integration
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Use the &phi;-scale via CSS custom properties already integrated into SuperUI's theme system.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Available Variables" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <pre class="token-preview"><code>--sg-text-phi-micro:   0.24rem;
--sg-text-phi-caption: 0.618rem;
--sg-text-phi-body:    1rem;
--sg-text-phi-lead:    1.618rem;
--sg-text-phi-h3:      2.618rem;
--sg-text-phi-h2:      4.236rem;
--sg-text-phi-h1:      6.854rem;
--sg-text-phi-display: 11.09rem;
--sg-text-phi-poster:  17.95rem;

--sg-lh-phi-display: 1.272;  /* sqrt(phi) */
--sg-lh-phi-body:    1.618;  /* phi */
--sg-lh-phi-caption: 2.058;  /* phi^1.5 */</code></pre>
            </SgCard>

            <SgCard Title="CSS Classes" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Apply directly via utility classes:
                    </SgTypography>
                    <SgStack Vertical Space="SgSize.Sm">
                        <div class="css-class-row"><code>.sgc-typo-phi-body</code> <span style="font-size: var(--sg-text-phi-body); line-height: var(--sg-lh-phi-body);">Body text</span></div>
                        <div class="css-class-row"><code>.sgc-typo-phi-lead</code> <span style="font-size: var(--sg-text-phi-lead); line-height: var(--sg-lh-phi-body);">Lead text</span></div>
                        <div class="css-class-row"><code>.sgc-typo-phi-h3</code> <span style="font-size: var(--sg-text-phi-h3); line-height: var(--sg-lh-phi-display);">Heading 3</span></div>
                        <div class="css-class-row"><code>.sgc-typo-phi-h2</code> <span style="font-size: var(--sg-text-phi-h2); line-height: var(--sg-lh-phi-display);">Heading 2</span></div>
                        <div class="css-class-row"><code>.sgc-typo-phi-h1</code> <span style="font-size: var(--sg-text-phi-h1); line-height: 1.1;">Heading 1</span></div>
                        <div class="css-class-row"><code>.sgc-typo-font-aurum</code> <span>AurumType font-family</span></div>
                    </SgStack>
                    <SgDivider />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Fibonacci spacing tokens:
                    </SgTypography>
                    <SgStack Horizontal Space="SgSize.Sm" Wrap="true">
                        <span class="fib-space-chip" style="width: var(--sg-space-fib-1); height: var(--sg-space-fib-1);"></span><code>F6 = 8px</code>
                        <span class="fib-space-chip" style="width: var(--sg-space-fib-2); height: var(--sg-space-fib-2);"></span><code>F7 = 13px</code>
                        <span class="fib-space-chip" style="width: var(--sg-space-fib-3); height: var(--sg-space-fib-3);"></span><code>F8 = 21px</code>
                        <span class="fib-space-chip" style="width: var(--sg-space-fib-4); height: var(--sg-space-fib-4);"></span><code>F9 = 34px</code>
                    </SgStack>
                </SgStack>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Proof Sheet                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Generated Font Preview
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                The UFO font file (73 glyphs: A–Z, a–z, 0–9, punctuation) and proof sheet generated by the AurumType Python pipeline.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Proof Sheet" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <div style="text-align:center;">
                    <img src="fonts/aurumtype-proof.png" alt="AurumType Proof Sheet"
                         style="max-width:100%;border:1px solid var(--sg-border);border-radius:8px;" />
                </div>
            </SgCard>

            <SgCard Title="CLI Commands" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <pre class="token-preview"><code># Install
pip install -r aurum-type/requirements.txt

# Generate Regular weight
python aurum-type/cli.py generate --weight 400

# Generate all 9 weights
python aurum-type/cli.py generate-all

# Variable Font (wght, wdth, opsz, CONT)
python aurum-type/cli.py variable

# Proof sheet
python aurum-type/cli.py proof --text "AURUMTYPE"

# Run tests
python aurum-type/tests/test_math.py
python aurum-type/tests/test_glyphs.py</code></pre>
                <SgDivider />
                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                    <span class="fib-chip">73 glyphs</span>
                    <span class="fib-chip">26 uppercase</span>
                    <span class="fib-chip">26 lowercase</span>
                    <span class="fib-chip">10 digits</span>
                    <span class="fib-chip">11 punctuation</span>
                </div>
            </SgCard>
        </div>
    </div>

    </ChildContent>
</SgCard>

<style>
    .phi-value {
        text-align: center;
        padding: 16px;
        background: var(--sg-surface-alt, #f3f4f6);
        border-radius: 8px;
    }
    .phi-symbol {
        font-size: 3em;
        font-weight: 700;
        color: var(--sg-primary, #2563eb);
        display: block;
    }
    .phi-number {
        font-family: var(--sg-font-mono);
        font-size: 0.875rem;
        color: var(--sg-text-muted);
    }
    .fib-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    .fib-chip {
        background: var(--sg-primary-subtle, #eff6ff);
        color: var(--sg-primary, #2563eb);
        padding: 4px 10px;
        border-radius: 9999px;
        font-family: var(--sg-font-mono);
        font-size: 0.75rem;
        font-weight: 600;
        border: 1px solid var(--sg-primary-muted, #dbeafe);
    }
    .fib-space-chip {
        display: inline-block;
        background: var(--sg-primary, #2563eb);
        border-radius: 4px;
        opacity: 0.6;
        vertical-align: middle;
    }
    .axis-row {
        display: flex;
        gap: 8px;
        align-items: center;
        padding: 4px 0;
    }
    .axis-tag {
        background: var(--sg-bg-muted, #f3f4f6);
        padding: 2px 8px;
        border-radius: 4px;
        font-family: var(--sg-font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--sg-primary, #2563eb);
        min-width: 50px;
        text-align: center;
    }
    .phi-scale-showcase {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .phi-scale-item {
        position: relative;
        padding: 8px 16px;
        border-radius: 4px;
        transition: background 0.2s;
    }
    .phi-scale-item:hover {
        background: var(--sg-surface-alt, #f3f4f6);
    }
    .phi-scale-label {
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 0.625rem;
        color: var(--sg-text-muted);
        font-family: var(--sg-font-mono);
        background: var(--sg-bg, #fff);
        padding: 2px 6px;
        border-radius: 4px;
        border: 1px solid var(--sg-border, #e5e7eb);
    }
    .phi-poster { font-size: var(--sg-text-phi-poster); line-height: 1; font-weight: 700; }
    .phi-display { font-size: var(--sg-text-phi-display); line-height: 1; font-weight: 700; }
    .phi-h1 { font-size: var(--sg-text-phi-h1); line-height: 1.1; font-weight: 700; }
    .phi-h2 { font-size: var(--sg-text-phi-h2); line-height: var(--sg-lh-phi-display); font-weight: 700; }
    .phi-h3 { font-size: var(--sg-text-phi-h3); line-height: var(--sg-lh-phi-display); font-weight: 600; }
    .phi-lead { font-size: var(--sg-text-phi-lead); line-height: var(--sg-lh-phi-body); }
    .phi-body { font-size: var(--sg-text-phi-body); line-height: var(--sg-lh-phi-body); }
    .phi-caption { font-size: var(--sg-text-phi-caption); line-height: var(--sg-lh-phi-caption); }
    .phi-micro { font-size: var(--sg-text-phi-micro); line-height: var(--sg-lh-phi-caption); }

    .token-preview {
        background: var(--sg-bg-muted, #1e1e2e) !important;
        color: #cdd6f4;
        padding: 16px;
        border-radius: 8px;
        font-size: 0.75rem;
        line-height: 1.6;
        overflow-x: auto;
        margin: 0;
    }
    .token-preview code {
        background: none !important;
        padding: 0 !important;
        color: inherit !important;
        font-family: var(--sg-font-mono);
    }
    .css-class-row {
        display: flex;
        gap: 12px;
        align-items: center;
        padding: 4px 0;
    }
    .css-class-row code {
        min-width: 180px;
        font-size: 0.75rem;
    }
    .demo-section {
        margin-bottom: 32px;
    }
    .demo-section-header {
        margin-bottom: 16px;
    }
    .demo-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
    .sgc-table th { font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
</style>

@code {
    private RenderFragment _mainHeader => builder =>
    {
        builder.OpenComponent<SgStack>(0);
        builder.AddAttribute(1, "Vertical", true);
        builder.AddAttribute(2, "Space", SgSize.Sm);
        builder.AddAttribute(3, "ChildContent", (RenderFragment)(b =>
        {
            b.OpenComponent<SgTypography>(0);
            b.AddAttribute(1, "Variant", SgTypographyVariant.Heading4);
            b.AddAttribute(2, "Weight", SgTypographyWeight.Bold);
            b.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, "AurumType — Natural Law Font")));
            b.CloseComponent();

            b.OpenComponent<SgTypography>(0);
            b.AddAttribute(1, "Size", SgTypographySize.Sm);
            b.AddAttribute(2, "Color", "var(--sg-text-muted)");
            b.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, "Corporate typeface built on the Golden Ratio, Fibonacci sequence, and logarithmic spiral.")));
            b.CloseComponent();
        }));
        builder.CloseComponent();
    };

    private class GlyphWidthInfo
    {
        public string Glyph { get; set; } = string.Empty;
        public string Class { get; set; } = string.Empty;
        public int Width { get; set; }
        public string Law { get; set; } = string.Empty;
    }

    private List<GlyphWidthInfo> _glyphWidths = new()
    {
        new() { Glyph = "M, W",  Class = "Wide",   Width = 110, Law = "phi^2.5 = 3.236" },
        new() { Glyph = "O, G, Q, D", Class = "Full", Width = 89, Law = "phi^2 = 2.618" },
        new() { Glyph = "H, N, U, A, V, X, Y", Class = "Normal", Width = 70, Law = "phi^1.5 = 2.058" },
        new() { Glyph = "B, E, F, P, R, S, T", Class = "Medium", Width = 55, Law = "phi^1 = 1.618" },
        new() { Glyph = "C",  Class = "Full",   Width = 89, Law = "Golden spiral" },
        new() { Glyph = "K",  Class = "Normal", Width = 70, Law = "72-degree diagonal" },
        new() { Glyph = "L, J", Class = "Narrow", Width = 43, Law = "phi^0.5 = 1.272" },
        new() { Glyph = "I, 1", Class = "Thin",  Width = 34, Law = "1.0 (stem width)" },
        new() { Glyph = "Z, 2, 5, 8", Class = "Medium", Width = 55, Law = "phi^1 = 1.618" },
        new() { Glyph = "0, 6, 9", Class = "Full", Width = 89, Law = "phi^2 = 2.618" },
        new() { Glyph = "3, 4, 7", Class = "Medium", Width = 55, Law = "phi^1 = 1.618" },
    };


}
