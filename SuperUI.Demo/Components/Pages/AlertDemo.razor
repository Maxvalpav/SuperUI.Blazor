    private string _interactiveCode => @"// Programmatic show/hide
<SgAlert @ref=""_alert""
         Variant=""SgAlertVariant.Info""
         Title=""Toggle Demo""
         Dismissible=""true"" />

alert.Show();
alert.Hide();

// Auto-dismiss with Timeout
