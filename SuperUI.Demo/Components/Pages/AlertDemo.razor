@page "/alert-demo"
@using SuperUI.Components

<PageTitle>Уведомление — SUI</PageTitle>

<SgCard Title="SgAlert — Уведомление"
        Subtitle="Компонент для отображения уведомлений и сообщений. Поддерживает 4 варианта через SgAlertVariant, иконки, закрытие и кнопки действий.">

    <!-- Варианты -->
    <div style="margin-top: 32px;">
        <h2>Варианты (SgAlertVariant)</h2>
        <p>Четыре типа уведомлений для разных ситуаций.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования" Style="grid-column: 1 / -1;">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgAlert Variant="SgAlertVariant.Success" Title="Успешно"       Text="Данные сохранены успешно." Dismissible="true" />
                    <SgAlert Variant="SgAlertVariant.Info"    Title="Информация"    Text="Доступна новая версия компонентов." Dismissible="true" />
                    <SgAlert Variant="SgAlertVariant.Warn"    Title="Предупреждение" Text="Это действие нельзя отменить." Dismissible="true" />
                    <SgAlert Variant="SgAlertVariant.Danger"  Title="Ошибка"        Text="Не удалось подключиться к серверу." Dismissible="true" />
                </div>
            </SgCard>
        </div>
    </div>

    <!-- Стили отображения -->
    <div style="margin-top: 32px;">
        <h2>Стили отображения</h2>
        <p>Управление иконкой и компактным режимом.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Стандартный</div>
                        <SgAlert Variant="SgAlertVariant.Info" Title="Стандартный" Text="С иконкой и отступами." />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Компактный (Dense)</div>
                        <SgAlert Variant="SgAlertVariant.Info" Title="Компактный" Text="Меньше отступов." Dense="true" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Без иконки</div>
                        <SgAlert Variant="SgAlertVariant.Warn" Title="Без иконки" Text="ShowIcon=false" ShowIcon="false" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Пользовательская иконка</div>
                        <SgAlert Variant="SgAlertVariant.Success" Title="Кастомная иконка" Text="Используется эмодзи." Icon="🎉" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_alertProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Пользовательское содержимое -->
    <div style="margin-top: 32px;">
        <h2>Пользовательское содержимое</h2>
        <p>Уведомления с произвольным HTML и кнопками действий.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgAlert Variant="SgAlertVariant.Warn" Title="Требуется действие">
                        <ChildContent>
                            <p style="margin: 0 0 8px;">Ваша сессия истекает через 5 минут.</p>
                        </ChildContent>
                        <ActionsContent>
                            <div style="display: flex; gap: 8px;">
                                <SgButton Text="Продлить" Variant="SgButtonVariant.Primary" Size="SgSize.Sm" />
                                <SgButton Text="Выйти" />
                            </div>
                        </ActionsContent>
                    </SgAlert>

                    <SgAlert Variant="SgAlertVariant.Danger" Title="Ошибки валидации">
                        <ChildContent>
                            <ul style="margin: 0; padding-left: 20px;">
                                <li>Поле «Email» обязательно</li>
                                <li>Пароль слишком короткий</li>
                                <li>Имя не может быть пустым</li>
                            </ul>
                        </ChildContent>
                    </SgAlert>

                    <SgAlert Variant="SgAlertVariant.Success" Title="Профиль обновлён">
                        <ChildContent>
                            <div style="display: flex; flex-direction: column; gap: 4px;">
                                <div>✓ Имя обновлено</div>
                                <div>✓ Email подтверждён</div>
                                <div>✓ Фото загружено</div>
                            </div>
                        </ChildContent>
                    </SgAlert>
                </div>
            </SgCard>

            <SgCard Title="Дополнительные параметры">
                <PropertyTable Items="_alertExtraProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Минимальные варианты -->
    <div style="margin-top: 32px;">
        <h2>Минимальные варианты</h2>
        <p>Уведомления только с заголовком или только с текстом.</p>

        <SgCard Title="Примеры использования" Style="margin-top: 16px;">
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <SgAlert Variant="SgAlertVariant.Info"    Title="Только заголовок" />
                <SgAlert Variant="SgAlertVariant.Success" Text="Только текст без заголовка." />
                <SgAlert Variant="SgAlertVariant.Warn"    Text="Минимальное уведомление без иконки." ShowIcon="false" />
            </div>
        </SgCard>
    </div>

    <!-- Примеры кода -->
    <div style="margin-top: 32px;">
        <h2>Примеры кода</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Базовое использование">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_basicCode" />
            </SgCard>

            <SgCard Title="С кнопками действий">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_actionsCode" />
            </SgCard>

            <SgCard Title="Перечисление SgAlertVariant">
                <PropertyTable Items="_variantEnumValues" />
            </SgCard>

            <SgCard Title="Управляемая видимость">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_visibleCode" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private List<PropertyPanelItem> _alertProperties = new()
    {
        new() { Label = "Variant",    Value = "info|success|warn|danger", BadgeText = "Тип (enum)",        BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Title",      Value = "string",                   BadgeText = "Заголовок",         BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Text",       Value = "string",                   BadgeText = "Текст",             BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Dismissible",Value = "bool",                     BadgeText = "Закрываемый",       BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowIcon",   Value = "bool (true)",              BadgeText = "Иконка",            BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Icon",       Value = "string",                   BadgeText = "Кастомная иконка",  BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Dense",      Value = "bool",                     BadgeText = "Компактный",        BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "OnClose",    Value = "EventCallback",            BadgeText = "Закрытие",          BadgeVariant = SgBadgeVariant.Success },
    };

    private List<PropertyPanelItem> _alertExtraProperties = new()
    {
        new() { Label = "ChildContent",  Value = "RenderFragment", BadgeText = "Тело",             BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ActionsContent",Value = "RenderFragment", BadgeText = "Кнопки действий",  BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Visible",       Value = "bool?",          BadgeText = "Видимость",         BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "VisibleChanged",Value = "EventCallback<bool>", BadgeText = "Изменение видимости", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Style",         Value = "string",         BadgeText = "Inline стиль",      BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "CssClass",      Value = "string",         BadgeText = "CSS класс",         BadgeVariant = SgBadgeVariant.Info },
    };

    private List<PropertyPanelItem> _variantEnumValues = new()
    {
        new() { Label = "SgAlertVariant.Info",    Value = "\"info\"",    BadgeText = "Информация",      BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgAlertVariant.Success", Value = "\"success\"", BadgeText = "Успех",           BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "SgAlertVariant.Warn",    Value = "\"warn\"",    BadgeText = "Предупреждение",  BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "SgAlertVariant.Danger",  Value = "\"danger\"",  BadgeText = "Ошибка",          BadgeVariant = SgBadgeVariant.Danger },
    };

    private string _basicCode = """
        <SgAlert Variant=SgAlertVariant.Success" Title="Успешно"
                 Text="Данные сохранены." Dismissible="true" />

        <SgAlert Variant="SgAlertVariant.Info"   Title="Информация"
                 Text="Доступна новая версия." />

        <SgAlert Variant="SgAlertVariant.Warn"   Title="Предупреждение"
                 Text="Действие нельзя отменить." />

        <SgAlert Variant="SgAlertVariant.Danger" Title="Ошибка"
                 Text="Нет подключения к серверу." />
        """;

    private string _actionsCode = """
        <SgAlert Variant="SgAlertVariant.Warn" Title="Требуется действие">
            <ChildContent>
                <p>Сессия истекает через 5 минут.</p>
            </ChildContent>
            <ActionsContent>
                <SgButton Text="Продлить" Variant=SgButtonVariant.Primary" Size="SgSize.Sm" />
                <SgButton Text="Выйти" Size="SgSize.Sm" />
            </ActionsContent>
        </SgAlert>
        """;

    private string _visibleCode = """
        @* Управляемая видимость *@
        <SgAlert Variant="SgAlertVariant.Info"
                 Title="Управляемое"
                 Text="Можно скрыть программно."
                 @bind-Visible="_alertVisible"
                 Dismissible="true" />

        <SgButton Text="Показать" Variant=SgButtonVariant.Primary"
                  OnClick="@(_ => _alertVisible = true)" />

        @code {
            private bool _alertVisible = true;
        }
        """;
}
