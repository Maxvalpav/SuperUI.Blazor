    private string _displayCode => @"<!-- Size variants -->
<SgAlert Variant=""SgAlertVariant.Info"" Title=""Small"" Size=""SgSize.Sm"" />
<SgAlert Variant=""SgAlertVariant.Info"" Title=""Large"" Size=""SgSize.Lg"" />

<!-- Dense mode -->
