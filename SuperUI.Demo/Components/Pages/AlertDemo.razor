@page "/alert-demo"
@using SuperUI.Components

<PageTitle>Уведомление - SUI</PageTitle>

<SgCard Title="SgAlert - Уведомление"
        Subtitle="Компонент для отображения уведомлений и сообщений. Поддерживает 4 варианта, иконки, закрытие, пользовательское содержимое и кнопки действий.">

    <!-- Варианты -->
    <div style="margin-top: 32px;">
        <h2>Варианты</h2>
        <p>Четыре типа уведомлений для разных ситуаций.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования" Style="grid-column: 1 / -1;">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgAlert Variant="success" Title="Успешно" Text="Данные сохранены успешно." Dismissible="true" />
                    <SgAlert Variant="info" Title="Информация" Text="Доступна новая версия компонентов." Dismissible="true" />
                    <SgAlert Variant="warn" Title="Предупреждение" Text="Это действие нельзя отменить." Dismissible="true" />
                    <SgAlert Variant="danger" Title="Ошибка" Text="Не удалось подключиться к серверу." Dismissible="true" />
                </div>
            </SgCard>
        </div>
    </div>

    <!-- Без иконки / компактный -->
    <div style="margin-top: 32px;">
        <h2>Стили отображения</h2>
        <p>Управление иконкой и компактным режимом.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Стандартный</div>
                        <SgAlert Variant="info" Title="Стандартный" Text="С иконкой и отступами." />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Компактный (Dense)</div>
                        <SgAlert Variant="info" Title="Компактный" Text="Меньше отступов." Dense="true" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Без иконки</div>
                        <SgAlert Variant="warn" Title="Без иконки" Text="ShowIcon=false" ShowIcon="false" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Пользовательская иконка</div>
                        <SgAlert Variant="success" Title="Кастомная иконка" Text="Используется эмодзи." Icon="🎉" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_alertProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Пользовательское содержимое -->
    <div style="margin-top: 32px;">
        <h2>Пользовательское содержимое</h2>
        <p>Уведомления с произвольным HTML и кнопками действий.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgAlert Variant="warn" Title="Требуется действие">
                        <ChildContent>
                            <p style="margin: 0 0 8px;">Ваша сессия истекает через 5 минут.</p>
                        </ChildContent>
                        <ActionsContent>
                            <div style="display: flex; gap: 8px;">
                                <SgButton Text="Продлить" Variant="primary" Size="sm" />
                                <SgButton Text="Выйти" Size="sm" />
                            </div>
                        </ActionsContent>
                    </SgAlert>

                    <SgAlert Variant="danger" Title="Ошибки валидации">
                        <ChildContent>
                            <ul style="margin: 0; padding-left: 20px;">
                                <li>Поле «Email» обязательно</li>
                                <li>Пароль слишком короткий</li>
                                <li>Имя не может быть пустым</li>
                            </ul>
                        </ChildContent>
                    </SgAlert>

                    <SgAlert Variant="success" Title="Профиль обновлён">
                        <ChildContent>
                            <div style="display: flex; flex-direction: column; gap: 4px;">
                                <div>✓ Имя обновлено</div>
                                <div>✓ Email подтверждён</div>
                                <div>✓ Фото загружено</div>
                            </div>
                        </ChildContent>
                    </SgAlert>
                </div>
            </SgCard>

            <SgCard Title="Дополнительные параметры">
                <PropertyTable Items="_alertExtraProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Только текст / только заголовок -->
    <div style="margin-top: 32px;">
        <h2>Минимальные варианты</h2>
        <p>Уведомления только с заголовком или только с текстом.</p>

        <SgCard Title="Примеры использования" Style="margin-top: 16px;">
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <SgAlert Variant="info" Title="Только заголовок" />
                <SgAlert Variant="success" Text="Только текст без заголовка." />
                <SgAlert Variant="warn" Text="Минимальное уведомление без иконки." ShowIcon="false" />
            </div>
        </SgCard>
    </div>

</SgCard>

@code {
    private List<PropertyPanelItem> _alertProperties = new()
    {
        new() { Label = "Variant", Value = "info|success|warn|danger", BadgeText = "Тип", BadgeVariant = "info" },
        new() { Label = "Title", Value = "string", BadgeText = "Заголовок", BadgeVariant = "info" },
        new() { Label = "Text", Value = "string", BadgeText = "Текст", BadgeVariant = "info" },
        new() { Label = "Dismissible", Value = "bool", BadgeText = "Закрываемый", BadgeVariant = "warn" },
        new() { Label = "ShowIcon", Value = "bool (default: true)", BadgeText = "Иконка", BadgeVariant = "warn" },
        new() { Label = "Icon", Value = "string", BadgeText = "Кастомная иконка", BadgeVariant = "info" },
        new() { Label = "Dense", Value = "bool", BadgeText = "Компактный", BadgeVariant = "warn" },
        new() { Label = "OnClose", Value = "EventCallback", BadgeText = "Закрытие", BadgeVariant = "success" }
    };

    private List<PropertyPanelItem> _alertExtraProperties = new()
    {
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Тело", BadgeVariant = "info" },
        new() { Label = "ActionsContent", Value = "RenderFragment", BadgeText = "Кнопки действий", BadgeVariant = "info" },
        new() { Label = "Style", Value = "string", BadgeText = "Inline стиль", BadgeVariant = "info" },
        new() { Label = "CssClass", Value = "string", BadgeText = "CSS класс", BadgeVariant = "info" }
    };
}
