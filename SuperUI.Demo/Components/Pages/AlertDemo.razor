@page "/alert-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Demo.Components
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>Alert — SuperUI</PageTitle>

<SgSeoHead Description="Contextual alert banners with 4 variants, icons, actions, dismiss, timeout, elevation, and live constructor." />

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="SgAlert — Notifications" Subtitle="Contextual alert banners with 4 variants, icons, actions, dismiss, timeout, elevation, and live constructor." />
    </HeaderContent>
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Variants                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Variants
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Four contextual variants via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgAlertVariant</SgTypography>: Info, Success, Warn, Danger.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgAlert Variant="SgAlertVariant.Info" Title="Information" Text="A new version is available. Update to get the latest features." Dismissible="true" />
                    <SgAlert Variant="SgAlertVariant.Success" Title="Success" Text="Your changes have been saved successfully." Dismissible="true" />
                    <SgAlert Variant="SgAlertVariant.Warn" Title="Warning" Text="Your session will expire in 5 minutes." Dismissible="true" />
                    <SgAlert Variant="SgAlertVariant.Danger" Title="Error" Text="Unable to connect to the server. Check your connection." Dismissible="true" />
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="@_variantProperties" />
            </SgCard>
        </div>

        <DemoCodeBlock Code="@_variantCode" Title="Variant examples" />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Display Options                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Display Options
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Size presets (Sm–Xl), icon visibility, compact mode, border accent, elevation shadow, loading shimmer, and full-width mode.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Styles" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Size — Sm
                            <SgTag Color="processing" Style="margin-left:6px;">Size="Sm"</SgTag>
                        </SgTypography>
                        <SgAlert Variant="SgAlertVariant.Info" Title="Small alert" Text="Compact size for tight spaces." Size="SgSize.Sm" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Size — Md (default)
                        </SgTypography>
                        <SgAlert Variant="SgAlertVariant.Info" Title="Standard" Text="Full padding, icon, and border accent." />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Size — Lg
                            <SgTag Color="processing" Style="margin-left:6px;">Size="Lg"</SgTag>
                        </SgTypography>
                        <SgAlert Variant="SgAlertVariant.Info" Title="Large alert" Text="Prominent size for important messages." Size="SgSize.Lg" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Size — Xl
                            <SgTag Color="processing" Style="margin-left:6px;">Size="Xl"</SgTag>
                        </SgTypography>
                        <SgAlert Variant="SgAlertVariant.Info" Title="Extra large alert" Text="Maximum prominence for critical notifications." Size="SgSize.Xl" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Dense
                            <SgTag Color="info" Style="margin-left:6px;">Dense=true</SgTag>
                        </SgTypography>
                        <SgAlert Variant="SgAlertVariant.Success" Title="Compact" Text="Reduced padding for tight spaces." Dense="true" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            No Icon
                            <SgTag Color="info" Style="margin-left:6px;">ShowIcon=false</SgTag>
                        </SgTypography>
                        <SgAlert Variant="SgAlertVariant.Warn" Title="Without icon" Text="Custom message without icon." ShowIcon="false" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Custom Icon
                            <SgTag Color="info" Style="margin-left:6px;">Icon="🎉"</SgTag>
                        </SgTypography>
                        <SgAlert Variant="SgAlertVariant.Success" Title="Custom icon" Text="Any text or emoji as icon." Icon="🎉" />
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="More Styles" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Elevated Shadow
                            <SgTag Color="processing" Style="margin-left:6px;">Elevated=true</SgTag>
                        </SgTypography>
                        <SgAlert Variant="SgAlertVariant.Info" Title="Elevated" Text="With shadow elevation for more prominence." Elevated="true" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            No Border Accent
                            <SgTag Color="info" Style="margin-left:6px;">ShowBorder=false</SgTag>
                        </SgTypography>
                        <SgAlert Variant="SgAlertVariant.Success" Title="No accent" Text="Without the left colored border." ShowBorder="false" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Elevated + Dense + No Border
                        </SgTypography>
                        <SgAlert Variant="SgAlertVariant.Danger" Title="Combined" Text="All style options combined." Elevated="true" Dense="true" ShowBorder="false" Dismissible="true" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Loading
                            <SgTag Color="processing" Style="margin-left:6px;">Loading=true</SgTag>
                        </SgTypography>
                        <SgAlert Variant="SgAlertVariant.Info" Title="Loading..." Text="Content is loading." Loading="true" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Full Width
                            <SgTag Color="processing" Style="margin-left:6px;">FullWidth=true</SgTag>
                        </SgTypography>
                        <SgAlert Variant="SgAlertVariant.Success" Title="Full width" Text="Stretches across the entire container." FullWidth="true" />
                    </div>
                </SgStack>
            </SgCard>
        </div>

        <DemoCodeBlock Code="@_displayCode" Title="Display options examples" />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Interactive                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Interactive
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Show/hide alerts, auto-dismiss with timeout, dismiss event tracking.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Md">
            <SgCol Md="6">
                <SgCard Title="Show / Hide Toggle" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Start">
                        <SgStack Horizontal Space="SgSize.Sm">
                            <SgButton Text="Show Alert" Variant="SgButtonVariant.Primary" OnClick="@ShowAlert" />
                            <SgButton Text="Hide Alert" Variant="SgButtonVariant.Ghost" OnClick="@HideAlert" />
                        </SgStack>

                        @if (_showDemoVisible)
                        {
                            <SgAlert @ref="_showAlertRef"
                                     Variant="SgAlertVariant.Info"
                                     Title="Toggle Demo"
                                     Text="This alert was shown by clicking the button. Dismiss it or hide it programmatically."
                                     Dismissible="true"
                                     Elevated="true"
                                     OnClose="@OnShowAlertClosed" />
                        }

                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">State:</SgTypography>
                            <SgBadge Text="@(_showDemoVisible ? "Visible" : "Hidden")"
                                     Variant="@(_showDemoVisible ? SgBadgeVariant.Success : SgBadgeVariant.Muted)" />
                            @if (_showDismissCount > 0)
                            {
                                <SgBadge Text="@_dismissLabel" Variant="SgBadgeVariant.Info" />
                            }
                        </SgStack>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Auto-Timeout Demo" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Start">
                        <SgButton Text="Show Timed Alert (3s)" Variant="SgButtonVariant.Primary" OnClick="@ShowTimedAlert" />

                        @if (_timedVisible)
                        {
                            <SgAlert Variant="SgAlertVariant.Success"
                                     Title="Auto-dismissed"
                                     Text="This alert will disappear after 3 seconds."
                                     Dismissible="true"
                                     Timeout="3000"
                                     Elevated="true"
                                     OnClose="@OnTimedClosed" />
                        }
                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Timeout:</SgTypography>
                            <SgBadge Text="3000ms" Variant="SgBadgeVariant.Warn" />
                            <SgBadge Text="@(_timedVisible ? "Active" : "Closed")"
                                     Variant="@(_timedVisible ? SgBadgeVariant.Success : SgBadgeVariant.Muted)" />
                        </SgStack>
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>

        <DemoCodeBlock Code="@_interactiveCode" Title="Interactive alert examples" />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Custom Content & Actions                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Custom Content & Actions
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ChildContent</SgTypography> for rich HTML or <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ActionsContent</SgTypography> for buttons.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Md">
            <SgCol Md="6">
                <SgCard Title="Child Content Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgAlert Variant="SgAlertVariant.Warn" Title="Session Expiring">
                            <ChildContent>
                                <p style="margin:0 0 6px;">Your session will expire in <strong>5 minutes</strong>.</p>
                                <SgButton Text="Extend Session" Variant="SgButtonVariant.Primary" Size="SgSize.Sm" />
                            </ChildContent>
                        </SgAlert>

                        <SgAlert Variant="SgAlertVariant.Danger" Title="Validation Errors">
                            <ChildContent>
                                <ul style="margin:0;">
                                    <li>Email is required</li>
                                    <li>Password is too short</li>
                                    <li>Name cannot be empty</li>
                                </ul>
                            </ChildContent>
                        </SgAlert>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Actions Content" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgAlert Variant="SgAlertVariant.Success" Title="Profile Updated">
                            <ChildContent>
                                <div style="display:flex;flex-direction:column;gap:2px;margin-bottom:6px;">
                                    <span>✓ Name updated</span>
                                    <span>✓ Email confirmed</span>
                                    <span>✓ Photo uploaded</span>
                                </div>
                            </ChildContent>
                            <ActionsContent>
                                <SgButton Text="View Profile" Variant="SgButtonVariant.Primary" Size="SgSize.Sm" />
                                <SgButton Text="Undo" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
                            </ActionsContent>
                        </SgAlert>

                        <SgAlert Variant="SgAlertVariant.Info" Title="New Update">
                            <ChildContent>
                                <span>Version 2.5.0 is available.</span>
                            </ChildContent>
                            <ActionsContent>
                                <SgButton Text="Update" Variant="SgButtonVariant.Primary" Size="SgSize.Sm" />
                                <SgButton Text="Later" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
                            </ActionsContent>
                        </SgAlert>
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>

        <DemoCodeBlock Code="@_customCode" Title="Custom content and actions" />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Live Constructor                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live Alert Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure parameters and see the result in real time. Copy the generated code.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Variant -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Variant</SgTypography>
                            <SgSegmented TValue="SgAlertVariant"
                                         Value="@_ctorVariant"
                                         ValueChanged="v => { _ctorVariant = v; UpdateConstructorCode(); }"
                                         Block="true" Size="sm"
                                         Options="@_variantSegOptions" />
                        </SgStack>

                        <!-- Title -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Title</SgTypography>
                            <SgTextBox @bind-Value="_ctorTitle" Placeholder="Alert title" />
                        </SgStack>

                        <!-- Text -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Text</SgTypography>
                            <SgTextBox @bind-Value="_ctorText" Placeholder="Alert message text" />
                        </SgStack>

                        <!-- Size -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                            <SgSegmented TValue="SgSize"
                                         Value="@_ctorSize"
                                         ValueChanged="v => { _ctorSize = v; UpdateConstructorCode(); }"
                                         Block="true" Size="sm"
                                         Options="@_sizeSegOptions" />
                        </SgStack>

                        <!-- Toggles Row 1 -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Dismissible</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorDismissible"
                                                 ValueChanged="v => { _ctorDismissible = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">ShowIcon</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorShowIcon"
                                                 ValueChanged="v => { _ctorShowIcon = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Toggles Row 2 -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Dense</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorDense"
                                                 ValueChanged="v => { _ctorDense = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Elevated</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorElevated"
                                                 ValueChanged="v => { _ctorElevated = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">ShowBorder</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorShowBorder"
                                                 ValueChanged="v => { _ctorShowBorder = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Timeout</SgTypography>
                                    <SgTextBox @bind-Value="_ctorTimeout" Placeholder="ms" Type="number" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Toggles Row 4 -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">FullWidth</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorFullWidth"
                                                 ValueChanged="v => { _ctorFullWidth = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Loading</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorLoading"
                                                 ValueChanged="v => { _ctorLoading = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Variant</SgTypography>
                                        <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorVariant.ToString()" Standalone="true" />
                                    </SgStack>
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size</SgTypography>
                                        <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorSize.ToString()" Standalone="true" />
                                    </SgStack>
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Flags</SgTypography>
                                        <SgStack Horizontal Gap="4px">
                                            @if (_ctorDismissible) { <SgBadge Variant="SgBadgeVariant.Warn" Text="Dismiss" Size="SgSize.Sm" Standalone="true" /> }
                                            @if (_ctorDense) { <SgBadge Variant="SgBadgeVariant.Default" Text="Dense" Size="SgSize.Sm" Standalone="true" /> }
                                            @if (_ctorElevated) { <SgBadge Variant="SgBadgeVariant.Info" Text="Elevated" Size="SgSize.Sm" Standalone="true" /> }
                                            @if (_ctorFullWidth) { <SgBadge Variant="SgBadgeVariant.Default" Text="FullWidth" Size="SgSize.Sm" Standalone="true" /> }
                                            @if (_ctorLoading) { <SgBadge Variant="SgBadgeVariant.Warn" Text="Loading" Size="SgSize.Sm" Standalone="true" /> }
                                        </SgStack>
                                    </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            <div class="constructor-preview" style="padding:16px;">
                                <SgAlert Variant="@_ctorVariant"
                                         Title="@_ctorTitle"
                                         Text="@_ctorText"
                                         Dismissible="@_ctorDismissible"
                                         ShowIcon="@_ctorShowIcon"
                                         Dense="@_ctorDense"
                                         Elevated="@_ctorElevated"
                                         ShowBorder="@_ctorShowBorder"
                                         FullWidth="@_ctorFullWidth"
                                         Loading="@_ctorLoading"
                                         Size="@_ctorSize"
                                         Timeout="@_ctorTimeout" />
                            </div>
                        </SgStack>

                        <!-- Code with Copy -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                    <span id="copy-icon">@_copyIcon</span>
                                    <span id="copy-text" style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                </button>
                            </div>
                            <div class="code-block" id="code-block">
                                @foreach (var line in _generatedCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. Properties                                                      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Full Properties
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Complete list of configurable parameters for <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgAlert</SgTypography>.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Sm" Radius="SgSize.Lg">
            <PropertyTable Items="@_allProperties" />
        </SgCard>
    </div>

    </ChildContent>
</SgCard>

<style>
    .demo-section { margin-top: 48px; }
    .demo-section-header { margin-bottom: 20px; }

    .demo-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }
    @@media (max-width: 768px) {
        .demo-two-col { grid-template-columns: 1fr; }
    }

    .constructor-preview {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        transition: all 0.3s ease;
    }
    .ctrl-summary {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 12px 14px;
    }
    .code-block {
        background: #0f172a;
        color: #7dd3fc;
        padding: 14px 16px;
        border-radius: 8px;
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 12px;
        line-height: 1.9;
        overflow-x: auto;
        position: relative;
    }
    .code-block code {
        background: none;
        padding: 0;
        color: inherit;
        font-size: inherit;
        display: block;
        white-space: pre;
    }
    .demo-copy-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 6px;
        padding: 4px 10px;
        cursor: pointer;
        color: var(--sg-text-muted);
        transition: all 0.2s ease;
        font-family: inherit;
    }
    .demo-copy-btn:hover {
        color: var(--sg-primary);
        border-color: var(--sg-primary);
        background: color-mix(in srgb, var(--sg-primary) 8%, transparent);
    }
    .demo-copy-btn:active { transform: scale(0.95); }
    .demo-copy-btn.copied {
        color: var(--sg-color-success);
        border-color: var(--sg-color-success);
    }
</style>

@code {
    // ── Main header ─────────────────────────────────────────────────
    // ── Interactive state ───────────────────────────────────────────
    private SgAlert? _showAlertRef;
    private bool _showDemoVisible;
    private int _showDismissCount;
    private bool _timedVisible;

    private void ShowAlert()
    {
        _showDemoVisible = true;
    }

    private void HideAlert()
    {
        _showAlertRef?.Hide();
        _showDemoVisible = false;
    }

    private string _dismissLabel => $"Dismissed {_showDismissCount} times";

    private void OnShowAlertClosed()
    {
        _showDismissCount++;
    }

    private void ShowTimedAlert()
    {
        _timedVisible = true;
        StateHasChanged();
    }

    private void OnTimedClosed()
    {
        _timedVisible = false;
        StateHasChanged();
    }

    // ── Constructor state ───────────────────────────────────────────
    private SgAlertVariant _ctorVariant = SgAlertVariant.Info;
    private string _ctorTitle = "Information";
    private string _ctorText = "This is an informational message.";
    private bool _ctorDismissible = true;
    private bool _ctorShowIcon = true;
    private bool _ctorDense;
    private bool _ctorElevated;
    private bool _ctorShowBorder = true;
    private bool _ctorFullWidth;
    private bool _ctorLoading;
    private SgSize _ctorSize = SgSize.Md;
    private int _ctorTimeout;

    private string[] _generatedCodeLines = Array.Empty<string>();
    private string _copyIcon = "📋";
    private string _copyLabel = "Copy";

    // ── Segmented options ───────────────────────────────────────────
    private readonly List<SgSegmentedOption<SgAlertVariant>> _variantSegOptions = new()
    {
        new() { Value = SgAlertVariant.Info,    Label = "Info" },
        new() { Value = SgAlertVariant.Success, Label = "Success" },
        new() { Value = SgAlertVariant.Warn,    Label = "Warn" },
        new() { Value = SgAlertVariant.Danger,  Label = "Danger" },
    };

    private readonly List<SgSegmentedOption<bool>> _boolSegOptions = new()
    {
        new() { Value = false, Label = "Off" },
        new() { Value = true,  Label = "On" },
    };

    private readonly List<SgSegmentedOption<SgSize>> _sizeSegOptions = new()
    {
        new() { Value = SgSize.Sm, Label = "Sm" },
        new() { Value = SgSize.Md, Label = "Md" },
        new() { Value = SgSize.Lg, Label = "Lg" },
        new() { Value = SgSize.Xl, Label = "Xl" },
    };

    // ── Lifecycle ───────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add($"<SgAlert Variant=\"SgAlertVariant.{_ctorVariant}\"");

        if (!string.IsNullOrEmpty(_ctorTitle))
            lines.Add($"         Title=\"{_ctorTitle}\"");
        if (!string.IsNullOrEmpty(_ctorText))
            lines.Add($"         Text=\"{_ctorText}\"");

        if (_ctorDismissible) lines.Add("         Dismissible=\"true\"");
        if (!_ctorShowIcon) lines.Add("         ShowIcon=\"false\"");
        if (_ctorDense) lines.Add("         Dense=\"true\"");
        if (_ctorElevated) lines.Add("         Elevated=\"true\"");
        if (!_ctorShowBorder) lines.Add("         ShowBorder=\"false\"");
        if (_ctorFullWidth) lines.Add("         FullWidth=\"true\"");
        if (_ctorLoading) lines.Add("         Loading=\"true\"");
        if (_ctorSize != SgSize.Md) lines.Add($"         Size=\"SgSize.{_ctorSize}\"");
        if (_ctorTimeout > 0) lines.Add($"         Timeout=\"{_ctorTimeout}\"");

        lines.Add("         OnClose=\"() => {{ /* handle close */ }}\" />");

        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

    // ── Demo code snippets ──────────────────────────────────────────
    private string _variantCode => @"<!-- Info -->
<SgAlert Variant=""SgAlertVariant.Info"" Title=""Information"" Text=""A new version is available."" Dismissible=""true"" />

<!-- Success -->
<SgAlert Variant=""SgAlertVariant.Success"" Title=""Success"" Text=""Changes saved."" Dismissible=""true"" />

<!-- Warning -->
