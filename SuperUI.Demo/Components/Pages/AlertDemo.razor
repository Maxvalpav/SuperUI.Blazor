@page "/demo/alert"
@using SuperUI.Demo.Components

<div class="demo-page">
    <div class="demo-hero">
        <section class="demo-hero-main">
            <div class="demo-header">
                <div class="demo-kicker">Feedback Components</div>
                <h1 class="demo-title">SgAlert</h1>
                <p class="demo-subtitle">
                    Contextual feedback surface for information, success, warning and error messaging with optional dismiss controls
                    and action buttons.
                </p>
            </div>
        </section>

        <aside class="demo-hero-side">
            <div class="demo-side-title">Highlights</div>
            <div class="demo-pill-list">
                <span class="demo-pill demo-pill-accent">ARIA Live</span>
                <span class="demo-pill">Dismissible</span>
                <span class="demo-pill">Action Slot</span>
                <span class="demo-pill">Dense Mode</span>
            </div>

            <div class="demo-meta-grid">
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Variants</span>
                    <span class="demo-meta-value">Info, Success, Warn, Danger</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Best For</span>
                    <span class="demo-meta-value">Form notices, banners, inline validation</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Accessibility</span>
                    <span class="demo-meta-value">Status or alert role with polite/assertive live region</span>
                </div>
            </div>
        </aside>
    </div>

    <SgDemoSection Eyebrow="Usage" Title="Examples" Description="Alert patterns for inline form feedback, account banners and critical notices.">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card demo-showcase-wide">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Semantic Variants</h3>
                    <p class="demo-showcase-desc">Map visual tone to message severity.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgAlert Variant="SgAlertVariant.Info" Title="Information" Text="This is a neutral informative message for the user." />
                        <SgAlert Variant="SgAlertVariant.Success" Title="Success" Text="Your changes have been saved successfully." />
                        <SgAlert Variant="SgAlertVariant.Warn" Title="Warning" Text="Please review your settings before proceeding." />
                        <SgAlert Variant="SgAlertVariant.Danger" Title="Error" Text="Something went wrong. Please try again later." />
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Compact And Dismissible</h3>
                    <p class="demo-showcase-desc">Space-efficient usage inside dense layouts.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgAlert Variant="SgAlertVariant.Info" Dense="true" Text="Dense alert for tight spaces." />
                        <SgAlert Variant="SgAlertVariant.Success"
                                 Dismissible="true"
                                 Title="Dismissible"
                                 Text="You can close this alert using the action icon." />
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Alert With Actions</h3>
                    <p class="demo-showcase-desc">Attach recovery or next-step commands directly to the message.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgAlert Variant="SgAlertVariant.Danger" Title="Subscription Required">
                            <ChildContent>
                                Your subscription has expired. Update billing details to restore premium features.
                            </ChildContent>
                            <ActionsContent>
                                <SgButton Text="Update" Variant="SgButtonVariant.Danger" Size="SgSize.Sm" />
                                <SgButton Text="Later" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
                            </ActionsContent>
                        </SgAlert>
                    </div>
                    <div class="demo-note">Action area is useful for retry, resolve, pay now or navigate workflows.</div>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoParams Title="Alert Parameters" Description="Parameters for customizing the appearance and behavior of the SgAlert component.">
        <SgDemoParam Name="Variant" Type="SgAlertVariant" Description="The semantic style and behavior of the alert." Values="Info, Success, Warn, Danger" DefaultValue="Info" />
        <SgDemoParam Name="Title" Type="string" Description="An optional title for the alert." DefaultValue="null" />
        <SgDemoParam Name="Text" Type="string" Description="The main message content." DefaultValue="null" />
        <SgDemoParam Name="Icon" Type="string" Description="Custom icon string to display." DefaultValue="null" />
        <SgDemoParam Name="ShowIcon" Type="bool" Description="Whether to display the state icon." DefaultValue="true" />
        <SgDemoParam Name="Dismissible" Type="bool" Description="Whether the user can close the alert." DefaultValue="false" />
        <SgDemoParam Name="Dense" Type="bool" Description="Whether to use a compact layout." DefaultValue="false" />
        <SgDemoParam Name="Role" Type="string" Description="ARIA role for the alert." Values="alert, status" DefaultValue="Auto based on variant" />
        <SgDemoParam Name="ActionsContent" Type="RenderFragment" Description="Custom content for actions area." DefaultValue="null" />
        <SgDemoParam Name="ChildContent" Type="RenderFragment" Description="Custom content for the alert body." DefaultValue="null" />
        <SgDemoParam Name="OnClose" Type="EventCallback" Description="Callback when the alert is dismissed." DefaultValue="null" />
    </SgDemoParams>
</div>
