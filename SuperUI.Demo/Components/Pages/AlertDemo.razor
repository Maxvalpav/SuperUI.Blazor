    private string _customCode => @"<!-- Rich content -->
<SgAlert Variant=""SgAlertVariant.Warn"" Title=""Session"">
    <ChildContent>
        <p>Your session will expire in <strong>5 minutes</strong>.</p>
    </ChildContent>
    <ActionsContent>
        <SgButton Text=""Extend"" Variant=""SgButtonVariant.Primary"" Size=""SgSize.Sm"" />
    </ActionsContent>
</SgAlert>";

    // ── Property tables ────────────────────────────────────────────
    private List<PropertyPanelItem> _variantProperties = new()
    {
