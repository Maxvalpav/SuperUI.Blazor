@page "/owning-demo"
@using Microsoft.AspNetCore.Components
@using SuperUI.Services
@inherits OwningComponentBase<SgRagService>

<PageTitle>OwningComponentBase - Scoped isolate</PageTitle>
<SgCard Title="OwningComponentBase — Scoped isolation per MS guidance" Subtitle="learn.microsoft.com/aspnet/core/blazor/fundamentals/dependency-injection#owningcomponentbase">
    <p>Этот компонент наследует <code>OwningComponentBase&lt;SgRagService&gt;</code> — каждый экземпляр получает свой <code>Scoped</code> сервис, изолированный от circuit. MS рекомендует для Singleton → Scoped.</p>
    <p>Service hash: <code>@Service.GetHashCode()</code></p>
</SgCard>

@code {
    // MS: OwningComponentBase<T> создает отдельный scope, Dispose вызывает Dispose scope
    // Используй когда Singleton (ThemeRegistry) нужен Scoped (SgRagService) — иначе Captive Dependency
}
