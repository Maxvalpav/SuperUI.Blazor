@page "/scheduler-demo"
@using SuperUI.Components

<PageTitle>Планировщик - SUI</PageTitle>

<SgCard Title="SgScheduler - Планировщик" 
        Subtitle="Полнофункциональный компонент планировщика с поддержкой Day, Week, Month и Agenda видов, создания, редактирования и удаления событий.">
    
    <div style="margin-top: 24px;">
        <SgScheduler View="_currentView"
                     @bind-Value="_selectedDate"
                     Events="_events"
                     Height="700px"
                     OnAddEvent="HandleAddEvent"
                     OnUpdateEvent="HandleUpdateEvent"
                     OnDeleteEvent="HandleDeleteEvent" />
    </div>

    <div style="margin-top: 32px;">
        <h3>📋 Параметры SgScheduler</h3>
        <div style="margin-top: 16px; padding: 16px; background: var(--sui-bg-secondary); border-radius: 8px; font-size: 12px; line-height: 2;">
            <div><strong>View:</strong> SgSchedulerView (Day, Week, Month, Agenda) - вид планировщика</div>
            <div><strong>Value:</strong> DateTime - выбранная дата</div>
            <div><strong>Events:</strong> IEnumerable&lt;SgSchedulerEvent&gt; - список событий</div>
            <div><strong>Height:</strong> string - высота компонента</div>
            <div><strong>EnableCreation:</strong> bool - разрешить создание событий</div>
            <div><strong>EnableEditing:</strong> bool - разрешить редактирование событий</div>
            <div><strong>OnAddEvent:</strong> EventCallback&lt;SgSchedulerEvent&gt; - при добавлении события</div>
            <div><strong>OnUpdateEvent:</strong> EventCallback&lt;SgSchedulerEvent&gt; - при обновлении события</div>
            <div><strong>OnDeleteEvent:</strong> EventCallback&lt;SgSchedulerEvent&gt; - при удалении события</div>
            <div><strong>OnEventClick:</strong> EventCallback&lt;SgSchedulerEvent&gt; - при клике на событие</div>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h3>📊 SgSchedulerEvent Properties</h3>
        <div style="margin-top: 16px; padding: 16px; background: var(--sui-bg-secondary); border-radius: 8px; font-size: 12px; line-height: 2;">
            <div><strong>Id:</strong> string - уникальный идентификатор</div>
            <div><strong>Title:</strong> string - название события</div>
            <div><strong>Description:</strong> string? - описание</div>
            <div><strong>Start:</strong> DateTime - время начала</div>
            <div><strong>End:</strong> DateTime - время окончания</div>
            <div><strong>IsAllDay:</strong> bool - событие на весь день</div>
            <div><strong>Color:</strong> string? - цвет события</div>
            <div><strong>Icon:</strong> string? - иконка</div>
            <div><strong>RecurrenceRule:</strong> string? - правило повторения</div>
            <div><strong>Data:</strong> object? - пользовательские данные</div>
        </div>
    </div>

</SgCard>

@code {
    private SgSchedulerView _currentView = SgSchedulerView.Week;
    private DateTime _selectedDate = DateTime.Today;
    private List<SgSchedulerEvent> _events = new();

    protected override void OnInitialized()
    {
        var today = DateTime.Today;
        _events = new List<SgSchedulerEvent>
        {
            new()
            {
                Title = "Встреча с командой",
                Description = "Ежедневная стендап",
                Start = today.AddHours(10),
                End = today.AddHours(11),
                Color = "#006fee"
            },
            new()
            {
                Title = "Обед",
                Start = today.AddHours(13),
                End = today.AddHours(14),
                Color = "#10b981"
            },
            new()
            {
                Title = "Ревью кода",
                Description = "Проверить PR #123",
                Start = today.AddHours(15),
                End = today.AddHours(16),
                Color = "#f59e0b"
            },
            new()
            {
                Title = "Конференция",
                Description = "Tech Conf 2024",
                Start = today.AddDays(2),
                End = today.AddDays(2).AddHours(3),
                IsAllDay = true,
                Color = "#8b5cf6"
            },
            new()
            {
                Title = "День рождения",
                Start = today.AddDays(5),
                End = today.AddDays(5),
                IsAllDay = true,
                Color = "#ec4899"
            }
        };
    }

    private void HandleAddEvent(SgSchedulerEvent ev)
    {
        _events.Add(ev);
        StateHasChanged();
    }

    private void HandleUpdateEvent(SgSchedulerEvent ev)
    {
        var index = _events.FindIndex(e => e.Id == ev.Id);
        if (index >= 0)
        {
            _events[index] = ev;
            StateHasChanged();
        }
    }

    private void HandleDeleteEvent(SgSchedulerEvent ev)
    {
        _events.RemoveAll(e => e.Id == ev.Id);
        StateHasChanged();
    }
}
