@page "/scheduler-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models

<PageTitle>Планировщик - SUI</PageTitle>
<SgSeoHead Description="Комплексный компонент для управления расписанием, событиями и временем." />

<SgCard Title="SgScheduler - Планировщик" 
        Subtitle="Комплексный компонент для управления расписанием, событиями и временем.">

    <!-- Базовый планировщик -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Базовое использование</SgTypography>
        <p>Планировщик с поддержкой перетаскивания, создания событий и различными режимами отображения.</p>
        
        <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Интерактивный пример">
                <div style="margin-bottom: 16px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="font-size: 12px; color: var(--sui-text-muted);">Часы:</span>
                        <div style="width: 80px;">
                            <SgNumberInput TValue="int" @bind-Value="_startHour" Min="0" Max="23" Size="SgSize.Sm" />
                        </div>
                        <div style="width: 80px;">
                            <SgNumberInput TValue="int" @bind-Value="_endHour" Min="1" Max="24" Size="SgSize.Sm" />
                        </div>
                    </div>
                    <SgCheckBox @bind-Value="_enableDnd" Label="D&D" />
                    
                    <div style="margin-left: auto; display: flex; gap: 4px;">
                        <SgButton Text="День" Variant="@(_currentView == SgSchedulerView.Day ? SgButtonVariant.Primary : SgButtonVariant.Default)" Size="SgSize.Sm" OnClick="() => _currentView = SgSchedulerView.Day" />
                        <SgButton Text="Неделя" Variant="@(_currentView == SgSchedulerView.Week ? SgButtonVariant.Primary : SgButtonVariant.Default)" Size="SgSize.Sm" OnClick="() => _currentView = SgSchedulerView.Week" />
                        <SgButton Text="Месяц" Variant="@(_currentView == SgSchedulerView.Month ? SgButtonVariant.Primary : SgButtonVariant.Default)" Size="SgSize.Sm" OnClick="() => _currentView = SgSchedulerView.Month" />
                        <SgButton Text="Таймлайн" Variant="@(_currentView == SgSchedulerView.Timeline ? SgButtonVariant.Primary : SgButtonVariant.Default)" Size="SgSize.Sm" OnClick="() => _currentView = SgSchedulerView.Timeline" />
                        <SgButton Text="Повестка" Variant="@(_currentView == SgSchedulerView.Agenda ? SgButtonVariant.Primary : SgButtonVariant.Default)" Size="SgSize.Sm" OnClick="() => _currentView = SgSchedulerView.Agenda" />
                    </div>
                </div>

                <SgScheduler @bind-View="_currentView"
                             @bind-Value="_selectedDate"
                             Events="_events"
                             Height="500px"
                             EnableDragAndDrop="_enableDnd"
                             StartHour="_startHour"
                             EndHour="_endHour"
                             OnAddEvent="HandleAddEvent"
                             OnUpdateEvent="HandleUpdateEvent"
                             OnDeleteEvent="HandleDeleteEvent" />
            </SgCard>

            <SgCard Title="Свойства SgScheduler">
                <PropertyTable Items="_schedulerProperties" />
            </SgCard>
        </div>
    </div>

    <!-- События и данные -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">События и данные</SgTypography>
        <p>Настройка внешнего вида и метаданных отдельных событий в календаре.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Информация о событии">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgAlert Variant="SgAlertVariant.Info" Title="Подсказка">
                        Двойной клик по дню в режиме месяца создает новое событие. 
                        События можно перетаскивать между слотами времени.
                    </SgAlert>
                    
                    <div style="font-size: 13px; line-height: 1.6;">
                        <strong>SgSchedulerEvent</strong> поддерживает:
                        <ul style="margin-top: 8px;">
                            <li>Произвольные цвета через CSS переменные или HEX</li>
                            <li>Вставку SVG иконок из <code>SgIcons</code></li>
                            <li>Привязку любых пользовательских данных через <code>Data</code></li>
                            <li>Флаг <code>IsAllDay</code> для событий на весь день</li>
                        </ul>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства SgSchedulerEvent">
                <PropertyTable Items="_eventProperties" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private SgSchedulerView _currentView = SgSchedulerView.Week;
    private DateTime _selectedDate = DateTime.Today;
    private List<SgSchedulerEvent> _events = new();
    private bool _enableDnd = true;
    private int _startHour = 8;
    private int _endHour = 19;

    protected override void OnInitialized()
    {
        var today = DateTime.Today;
        _events = new List<SgSchedulerEvent>
        {
            new()
            {
                Id = Guid.NewGuid().ToString(),
                Title = "Встреча с командой",
                Description = "Обсуждение планов на неделю",
                Start = today.AddHours(10),
                End = today.AddHours(11),
                Color = "var(--sui-primary)",
                Icon = SgIcons.Database
            },
            new()
            {
                Id = Guid.NewGuid().ToString(),
                Title = "Обед с клиентом",
                Start = today.AddHours(13),
                End = today.AddHours(14),
                Color = "var(--sui-success)",
                Icon = SgIcons.Check
            },
            new()
            {
                Id = Guid.NewGuid().ToString(),
                Title = "Ревью кода",
                Description = "Проверить PR в репозитории SuperUI",
                Start = today.AddHours(15),
                End = today.AddHours(17),
                Color = "var(--sui-warn)",
                Icon = SgIcons.FileText
            },
            new()
            {
                Id = Guid.NewGuid().ToString(),
                Title = "Конференция SUI 2026",
                Description = "Главное событие года",
                Start = today.AddDays(2).AddHours(9),
                End = today.AddDays(2).AddHours(18),
                IsAllDay = true,
                Color = "var(--sui-danger)",
                Icon = SgIcons.TrendingUp
            }
        };
    }

    private void HandleAddEvent(SgSchedulerEvent ev)
    {
        if (string.IsNullOrEmpty(ev.Id)) ev.Id = Guid.NewGuid().ToString();
        _events.Add(ev);
        StateHasChanged();
    }

    private void HandleUpdateEvent(SgSchedulerEvent ev)
    {
        var index = _events.FindIndex(e => e.Id == ev.Id);
        if (index >= 0) _events[index] = ev;
        StateHasChanged();
    }

    private void HandleDeleteEvent(SgSchedulerEvent ev)
    {
        _events.RemoveAll(e => e.Id == ev.Id);
        StateHasChanged();
    }

    private List<PropertyPanelItem> _schedulerProperties = new()
    {
        new() { Label = "View", Value = "SgSchedulerView", BadgeText = "Режим отображения", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Value", Value = "DateTime", BadgeText = "Выбранная дата", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Events", Value = "IEnumerable<SgSchedulerEvent>", BadgeText = "Список событий", BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "Height", Value = "string", BadgeText = "Высота компонента", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "StartHour", Value = "int", BadgeText = "Час начала дня", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "EndHour", Value = "int", BadgeText = "Час конца дня", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "EnableDragAndDrop", Value = "bool", BadgeText = "Перетаскивание", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "OnAddEvent", Value = "EventCallback", BadgeText = "Добавление", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnUpdateEvent", Value = "EventCallback", BadgeText = "Обновление", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnDeleteEvent", Value = "EventCallback", BadgeText = "Удаление", BadgeVariant = SgBadgeVariant.Success }
    };

    private List<PropertyPanelItem> _eventProperties = new()
    {
        new() { Label = "Id", Value = "string", BadgeText = "Уникальный ID", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Title", Value = "string", BadgeText = "Заголовок", BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "Start / End", Value = "DateTime", BadgeText = "Временные рамки", BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "IsAllDay", Value = "bool", BadgeText = "Весь день", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Color", Value = "string?", BadgeText = "Цвет карточки", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Icon", Value = "string?", BadgeText = "SVG иконка", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Data", Value = "object?", BadgeText = "Польз. данные", BadgeVariant = SgBadgeVariant.Default }
    };
}
