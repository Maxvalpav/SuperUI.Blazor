@page "/bpmn-demo"
@using SuperUI.Components
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>BPMN Диаграммы - SUI</PageTitle>

<div class="bpmn-demo-page">

    <!-- ══════════════════════════════════════════════════════════════
         ШАПКА
    ══════════════════════════════════════════════════════════════ -->
    <div class="bpmn-demo-header">
        <div>
            <h1 class="bpmn-demo-title">SgBpmn</h1>
            <p class="bpmn-demo-subtitle">Редактор и просмотрщик BPMN 2.0 на базе bpmn-js</p>
        </div>
    </div>

    <SgTabs>

        <!-- ══════════════════════════════════════════════════════════
             ВКЛАДКА: ГАЛЕРЕЯ
        ══════════════════════════════════════════════════════════ -->
        <SgTabPanel Title="📚 Галерея">
            <div class="bpmn-gallery">
                <!-- Список диаграмм -->
                <div class="bpmn-gallery-sidebar">
                    <div class="bpmn-gallery-sidebar-title">Примеры диаграмм</div>
                    <div class="bpmn-gallery-sidebar-hint">👆 Нажмите для просмотра</div>
                    @foreach (var d in _diagrams)
                    {
                        var dLocal = d;
                        <div class="bpmn-gallery-item @(_activeDiagram == dLocal ? "bpmn-gallery-item-active" : "")"
                             role="button"
                             tabindex="0"
                             title="@dLocal.Title"
                             @onclick="@(async () => await SelectDiagram(dLocal))"
                             @onkeydown="@(async e => { if (e.Key == "Enter" || e.Key == " ") await SelectDiagram(dLocal); })">
                            <span class="bpmn-gallery-item-icon">@dLocal.Icon</span>
                            <div class="bpmn-gallery-item-info">
                                <div class="bpmn-gallery-item-title">@dLocal.Title</div>
                                <div class="bpmn-gallery-item-tags">
                                    @foreach (var tag in dLocal.Tags)
                                    {
                                        <span class="bpmn-tag">@tag</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Просмотр -->
                <div class="bpmn-gallery-viewer">
                    @if (_activeDiagram is not null)
                    {
                        <div class="bpmn-gallery-viewer-header">
                            <div>
                                <div class="bpmn-gallery-viewer-title">@_activeDiagram.Icon @_activeDiagram.Title</div>
                                <div class="bpmn-gallery-viewer-desc">@_activeDiagram.Description</div>
                            </div>
                            <SgButton Variant="SgButtonVariant.Primary"
                                      OnClick="OpenInEditor">
                                ✏️ Открыть в редакторе
                            </SgButton>
                        </div>

                        @if (_galleryLoading)
                        {
                            <div class="bpmn-center-msg">
                                <SgSpinner />
                                <span>Загрузка диаграммы…</span>
                            </div>
                        }
                        else if (_galleryError is not null)
                        {
                            <SgAlert Variant="SgAlertVariant.Danger" Title="Ошибка загрузки" Text="@_galleryError" />
                        }
                        else
                        {
                            <SgBpmn @ref="_bpmnGallery"
                                     Mode="SgBpmnMode.NavigatedViewer"
                                     Height="calc(100vh - 320px)"
                                     Xml="@_galleryXml"
                                     ShowToolbar="true" />
                        }
                    }
                </div>
            </div>
        </SgTabPanel>

        <!-- ══════════════════════════════════════════════════════════
             ВКЛАДКА: РЕДАКТОР
        ══════════════════════════════════════════════════════════ -->
        <SgTabPanel Title="✏️ Редактор">
            <div class="bpmn-editor-layout">

                <!-- Тулбар редактора -->
                <div class="bpmn-editor-toolbar">
                    <div class="bpmn-editor-toolbar-group">
                        <SgButton Size="SgSize.Sm" OnClick="EditorUndo"        title="Отменить (Ctrl+Z)">↩ Undo</SgButton>
                        <SgButton Size="SgSize.Sm" OnClick="EditorRedo"        title="Повторить (Ctrl+Y)">↪ Redo</SgButton>
                    </div>
                    <div class="bpmn-editor-toolbar-sep"></div>
                    <div class="bpmn-editor-toolbar-group">
                        <SgButton Size="SgSize.Sm" OnClick="EditorZoomIn">🔍+</SgButton>
                        <SgButton Size="SgSize.Sm" OnClick="EditorZoomOut">🔍−</SgButton>
                        <SgButton Size="SgSize.Sm" OnClick="EditorZoomReset">1:1</SgButton>
                        <SgButton Size="SgSize.Sm" OnClick="EditorFit">⛶ Вписать</SgButton>
                    </div>
                    <div class="bpmn-editor-toolbar-sep"></div>
                    <div class="bpmn-editor-toolbar-group">
                        <label class="bpmn-upload-btn" title="Загрузить .bpmn файл">
                            📂 Открыть файл
                            <InputFile OnChange="LoadFromFile" accept=".bpmn,.xml" style="display:none" />
                        </label>
                        <SgButton Size="SgSize.Sm" OnClick="EditorDownloadBpmn">⬇ BPMN</SgButton>
                        <SgButton Size="SgSize.Sm" OnClick="EditorDownloadSvg">⬇ SVG</SgButton>
                    </div>
                    <div class="bpmn-editor-toolbar-sep"></div>
                    <div class="bpmn-editor-toolbar-group">
                        <SgButton Size="SgSize.Sm" OnClick="EditorClear" Variant="SgButtonVariant.Danger">🗑 Очистить</SgButton>
                    </div>
                    <div class="bpmn-editor-toolbar-group" style="margin-left: auto;">
                        <SgButton Size="SgSize.Sm" OnClick="TogglePropsPanel"
                                  Variant="@(_propsPanelOpen ? SgButtonVariant.Primary : SgButtonVariant.Default)">
                            ☰ Свойства
                        </SgButton>
                    </div>
                    @if (_editorFileName is not null)
                    {
                        <div class="bpmn-editor-filename">📄 @_editorFileName</div>
                    }
                </div>

                <!-- Основная область: редактор + боковая панель -->
                <div class="bpmn-editor-body">
                    <div class="bpmn-editor-canvas">
                        <SgBpmn @ref="_bpmnModeler"
                                 Mode="SgBpmnMode.Modeler"
                                 Height="100%"
                                 Width="100%"
                                 Xml="@_editorXml"
                                 OnXmlChanged="OnEditorXmlChanged"
                                 OnElementClick="OnEditorElementClick"
                                 OnSelectionChanged="OnEditorSelectionChanged"
                                 ShowToolbar="false" />
                    </div>

                    @if (_propsPanelOpen)
                    {
                        <div class="bpmn-props-panel">
                            <div class="bpmn-props-header">
                                <span class="bpmn-props-title">Свойства</span>
                                <button class="bpmn-props-close" @onclick="TogglePropsPanel" title="Закрыть">✕</button>
                            </div>

                            @if (_editorSelected is not null)
                            {
                                <div class="bpmn-props-section">
                                    <div class="bpmn-props-row">
                                        <span class="bpmn-props-label">ID</span>
                                        <span class="bpmn-props-value bpmn-props-mono">@_editorSelected.Id</span>
                                    </div>
                                    <div class="bpmn-props-row">
                                        <span class="bpmn-props-label">Тип</span>
                                        <span class="bpmn-props-value">
                                            <span class="bpmn-tag">@_editorSelected.Type?.Split(':').LastOrDefault()</span>
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(_editorSelected.Name))
                                    {
                                        <div class="bpmn-props-row">
                                            <span class="bpmn-props-label">Название</span>
                                            <span class="bpmn-props-value">@_editorSelected.Name</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(_editorSelected.SourceId))
                                    {
                                        <div class="bpmn-props-row">
                                            <span class="bpmn-props-label">Источник</span>
                                            <span class="bpmn-props-value bpmn-props-mono">@_editorSelected.SourceId</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(_editorSelected.TargetId))
                                    {
                                        <div class="bpmn-props-row">
                                            <span class="bpmn-props-label">Цель</span>
                                            <span class="bpmn-props-value bpmn-props-mono">@_editorSelected.TargetId</span>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="bpmn-props-empty">Выберите элемент на диаграмме</div>
                            }

                            <div class="bpmn-props-section-title" style="margin-top: 16px;">Статистика</div>
                            <div class="bpmn-props-section">
                                <div class="bpmn-props-row">
                                    <span class="bpmn-props-label">XML</span>
                                    <span class="bpmn-props-value">@(_editorCurrentXml?.Length ?? 0) симв.</span>
                                </div>
                                @if (_editorFileName is not null)
                                {
                                    <div class="bpmn-props-row">
                                        <span class="bpmn-props-label">Файл</span>
                                        <span class="bpmn-props-value" style="word-break:break-all;">@_editorFileName</span>
                                    </div>
                                }
                            </div>

                            @if (_editorCurrentXml is not null)
                            {
                                <div class="bpmn-props-section-title" style="margin-top: 16px;">XML</div>
                                <div class="bpmn-xml-preview">@_editorCurrentXml</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </SgTabPanel>

        <!-- ══════════════════════════════════════════════════════════
             ВКЛАДКА: РЕЖИМЫ
        ══════════════════════════════════════════════════════════ -->
        <SgTabPanel Title="👁️ Режимы">
            <div class="bpmn-modes-grid">
                <SgCard Title="Modeler — полный редактор">
                    <p class="bpmn-mode-desc">Палитра элементов, контекстное меню, drag-and-drop, undo/redo.</p>
                    <SgBpmn Mode="SgBpmnMode.Modeler" Height="380px" ShowToolbar="true" />
                </SgCard>
                <SgCard Title="Viewer — только просмотр">
                    <p class="bpmn-mode-desc">Статичный просмотр без возможности редактирования.</p>
                    <SgBpmn Mode="SgBpmnMode.Viewer" Height="380px" ShowToolbar="true" />
                </SgCard>
                <SgCard Title="NavigatedViewer — зум и пан">
                    <p class="bpmn-mode-desc">Просмотр с поддержкой колёсика мыши и перетаскивания.</p>
                    <SgBpmn Mode="SgBpmnMode.NavigatedViewer" Height="380px" ShowToolbar="true" />
                </SgCard>
            </div>
        </SgTabPanel>

        <!-- ══════════════════════════════════════════════════════════
             ВКЛАДКА: СПРАВОЧНИК
        ══════════════════════════════════════════════════════════ -->
        <SgTabPanel Title="📋 API">
            <div class="bpmn-api-page">

                <SgCard Title="Параметры компонента" style="margin-bottom: 24px;">
                    <table class="bpmn-api-table">
                        <thead>
                            <tr><th>Параметр</th><th>Тип</th><th>По умолчанию</th><th>Описание</th></tr>
                        </thead>
                        <tbody>
                            <tr><td><code>Mode</code></td><td>SgBpmnMode</td><td>Modeler</td><td>Режим работы: Modeler | Viewer | NavigatedViewer</td></tr>
                            <tr><td><code>Xml</code></td><td>string?</td><td>null</td><td>BPMN 2.0 XML; если null — пустая диаграмма</td></tr>
                            <tr><td><code>Height</code></td><td>string</td><td>600px</td><td>Высота контейнера</td></tr>
                            <tr><td><code>Width</code></td><td>string</td><td>100%</td><td>Ширина контейнера</td></tr>
                            <tr><td><code>ShowToolbar</code></td><td>bool</td><td>true</td><td>Встроенная панель инструментов</td></tr>
                            <tr><td><code>Sources</code></td><td>SgBpmnSources?</td><td>CDN</td><td>Переопределение URL скриптов bpmn-js</td></tr>
                            <tr><td><code>OnXmlChanged</code></td><td>EventCallback&lt;string&gt;</td><td>—</td><td>Изменение XML в редакторе</td></tr>
                            <tr><td><code>OnElementClick</code></td><td>EventCallback&lt;SgBpmnElementInfo&gt;</td><td>—</td><td>Клик по элементу</td></tr>
                            <tr><td><code>OnElementDblClick</code></td><td>EventCallback&lt;SgBpmnElementInfo&gt;</td><td>—</td><td>Двойной клик по элементу</td></tr>
                            <tr><td><code>OnSelectionChanged</code></td><td>EventCallback&lt;SgBpmnElementInfo&gt;</td><td>—</td><td>Изменение выделения</td></tr>
                        </tbody>
                    </table>
                </SgCard>

                <SgCard Title="Методы компонента" style="margin-bottom: 24px;">
                    <table class="bpmn-api-table">
                        <thead>
                            <tr><th>Метод</th><th>Возвращает</th><th>Описание</th></tr>
                        </thead>
                        <tbody>
                            <tr><td><code>UndoAsync()</code></td><td>Task</td><td>Отменить последнее действие (только Modeler)</td></tr>
                            <tr><td><code>RedoAsync()</code></td><td>Task</td><td>Повторить отменённое действие (только Modeler)</td></tr>
                            <tr><td><code>ZoomInAsync()</code></td><td>Task</td><td>Увеличить масштаб</td></tr>
                            <tr><td><code>ZoomOutAsync()</code></td><td>Task</td><td>Уменьшить масштаб</td></tr>
                            <tr><td><code>ZoomResetAsync()</code></td><td>Task</td><td>Сбросить масштаб до 100%</td></tr>
                            <tr><td><code>FitViewportAsync()</code></td><td>Task</td><td>Вписать диаграмму в область</td></tr>
                            <tr><td><code>GetXmlAsync()</code></td><td>Task&lt;string?&gt;</td><td>Получить текущий XML</td></tr>
                            <tr><td><code>GetSvgAsync()</code></td><td>Task&lt;string?&gt;</td><td>Получить SVG-снимок</td></tr>
                            <tr><td><code>DownloadAsync(format)</code></td><td>Task</td><td>Скачать файл: "svg" или "bpmn"</td></tr>
                            <tr><td><code>RefreshAsync()</code></td><td>Task</td><td>Принудительно перерисовать</td></tr>
                        </tbody>
                    </table>
                </SgCard>

                <SgCard Title="SgBpmnElementInfo">
                    <table class="bpmn-api-table">
                        <thead>
                            <tr><th>Свойство</th><th>Тип</th><th>Описание</th></tr>
                        </thead>
                        <tbody>
                            <tr><td><code>Id</code></td><td>string</td><td>Идентификатор элемента</td></tr>
                            <tr><td><code>Type</code></td><td>string</td><td>BPMN-тип (bpmn:Task, bpmn:Gateway и т.д.)</td></tr>
                            <tr><td><code>Name</code></td><td>string?</td><td>Название элемента</td></tr>
                            <tr><td><code>SourceId</code></td><td>string?</td><td>ID источника (для потоков)</td></tr>
                            <tr><td><code>TargetId</code></td><td>string?</td><td>ID цели (для потоков)</td></tr>
                        </tbody>
                    </table>
                </SgCard>

            </div>
        </SgTabPanel>

    </SgTabs>
</div>

@code {
    // ── Галерея ──────────────────────────────────────────────────────────────
    private record DiagramInfo(
        string Title, string Icon, string Description,
        string File, string[] Tags);

    private readonly DiagramInfo[] _diagrams =
    [
        new("Обработка заказа", "🛒",
            "Полный цикл e-commerce: валидация, оплата, параллельная сборка и уведомление, отправка курьером.",
            "bpmn/order-fulfillment.bpmn",
            ["Параллельный шлюз", "Сервисные задачи", "Два пути отказа"]),

        new("Онбординг сотрудника", "👤",
            "Межпроцессное взаимодействие HR, IT и нового сотрудника через пулы и потоки сообщений.",
            "bpmn/employee-onboarding.bpmn",
            ["Пулы", "Потоки сообщений", "3 участника"]),

        new("Управление инцидентами", "🚨",
            "ITIL-процесс: классификация, эскалация с таймером SLA, параллельные пути, post-mortem анализ.",
            "bpmn/incident-management.bpmn",
            ["Таймер SLA", "Граничные события", "Цикл повтора"]),

        new("Одобрение кредита", "🏦",
            "Банковский процесс: скоринг, параллельная проверка документов и рисков, маршрутизация по сумме.",
            "bpmn/loan-approval.bpmn",
            ["Параллельная проверка", "Маршрутизация", "Кредитный комитет"]),
    ];

    private DiagramInfo? _activeDiagram;
    private SgBpmn?      _bpmnGallery;
    private string?      _galleryXml;
    private bool         _galleryLoading;
    private string?      _galleryError;

    protected override async Task OnInitializedAsync()
    {
        await SelectDiagram(_diagrams[0]);
    }

    private async Task SelectDiagram(DiagramInfo diagram)
    {
        if (_activeDiagram == diagram) return;
        _activeDiagram  = diagram;
        _galleryXml     = null;
        _galleryLoading = true;
        _galleryError   = null;
        StateHasChanged();
        try
        {
            _galleryXml = await Http.GetStringAsync(diagram.File);
        }
        catch (Exception ex)
        {
            _galleryError = ex.Message;
        }
        finally
        {
            _galleryLoading = false;
            StateHasChanged();
        }
    }

    private void OpenInEditor()
    {
        if (_galleryXml is null) return;
        _editorXml      = _galleryXml;
        _editorFileName = _activeDiagram?.Title;
        // переключение на вкладку редактора через JS не нужно —
        // пользователь сам кликнет, XML уже будет загружен
        StateHasChanged();
    }

    // ── Редактор ─────────────────────────────────────────────────────────────
    private SgBpmn?            _bpmnModeler;
    private SgBpmnElementInfo? _editorSelected;
    private string?            _editorXml;
    private string?            _editorCurrentXml;
    private string?            _editorFileName;
    private bool               _propsPanelOpen = true;

    private void TogglePropsPanel()
    {
        _propsPanelOpen = !_propsPanelOpen;
    }

    private void OnEditorXmlChanged(string xml)
    {
        _editorCurrentXml = xml;
        StateHasChanged();
    }

    private void OnEditorElementClick(SgBpmnElementInfo el)
    {
        _editorSelected = el;
        StateHasChanged();
    }

    private void OnEditorSelectionChanged(SgBpmnElementInfo? el)
    {
        _editorSelected = el;
        StateHasChanged();
    }

    private async Task LoadFromFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream);
            var xml = await reader.ReadToEndAsync();
            _editorXml      = xml;
            _editorFileName = file.Name;
            _editorSelected = null;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[BPMN] Load error: {ex.Message}");
        }
    }

    private void EditorClear()
    {
        _editorXml      = null;
        _editorFileName = null;
        _editorSelected = null;
        _editorCurrentXml = null;
        StateHasChanged();
    }

    private async Task EditorUndo()        { if (_bpmnModeler is not null) await _bpmnModeler.UndoAsync(); }
    private async Task EditorRedo()        { if (_bpmnModeler is not null) await _bpmnModeler.RedoAsync(); }
    private async Task EditorZoomIn()      { if (_bpmnModeler is not null) await _bpmnModeler.ZoomInAsync(); }
    private async Task EditorZoomOut()     { if (_bpmnModeler is not null) await _bpmnModeler.ZoomOutAsync(); }
    private async Task EditorZoomReset()   { if (_bpmnModeler is not null) await _bpmnModeler.ZoomResetAsync(); }
    private async Task EditorFit()         { if (_bpmnModeler is not null) await _bpmnModeler.FitViewportAsync(); }
    private async Task EditorDownloadSvg() { if (_bpmnModeler is not null) await _bpmnModeler.DownloadAsync("svg"); }
    private async Task EditorDownloadBpmn(){ if (_bpmnModeler is not null) await _bpmnModeler.DownloadAsync("bpmn"); }
}
