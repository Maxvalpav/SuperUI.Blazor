@page "/data-form-edit"
@inject SgToastService Toasts

<PageTitle>Редактирование записи — SUI</PageTitle>

<div style="display:flex; flex-direction:column; gap:18px; max-width:800px;">
    <SgCard Title="Редактирование данных сотрудника">
        <div style="margin-bottom:16px;">
            <SgAlert Dense="true" Text="Режим редактирования: предзаполненная модель с возможностью изменения." />
        </div>
        
        <SgDataForm TModel="Employee"
                    Model="_employee"
                    Columns="2"
                    SubmitText="Сохранить изменения"
                    OnValidSubmit="HandleUpdate" />
    </SgCard>
</div>

@code {
    private Employee _employee = new()
    {
        Id = 1,
        FirstName = "Алексей",
        LastName = "Иванов",
        Email = "alex.ivanov@example.com",
        Department = DepartmentType.Engineering,
        Salary = 150000,
        HireDate = new DateTime(2023, 5, 15),
        IsActive = true,
        Notes = "Ведущий разработчик."
    };

    private void HandleUpdate(Employee model)
    {
        Toasts.Success("Данные успешно обновлены");
    }
}

