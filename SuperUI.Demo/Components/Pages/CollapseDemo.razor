@page "/collapse-demo"
@using SuperUI.Components

<PageTitle>Collapse - SUI</PageTitle>

<SgCard Title="SgCollapse - Collapsible Panel"
        Subtitle="Standalone collapsible panel with header, content, and optional actions.">

    <div style="margin-top: 32px;">
        <h2>Basic Usage</h2>
        <p>Simple collapsible panel with title and content.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgCollapse Title="Click to expand">
                        <p style="margin: 0;">This is the collapsible content. You can put any markup here.</p>
                    </SgCollapse>
                    <SgCollapse Title="Initially expanded" Expanded="true">
                        <p style="margin: 0;">This panel starts in the expanded state.</p>
                    </SgCollapse>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_basicProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Two-way Binding & Events</h2>
        <p>Control the panel state programmatically.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div style="display: flex; gap: 8px; margin-bottom: 8px;">
                        <SgButton Text="Expand" Size="sm" OnClick="@(() => _isExpanded = true)" />
                        <SgButton Text="Collapse" Size="sm" OnClick="@(() => _isExpanded = false)" />
                        <SgButton Text="Toggle" Size="sm" OnClick="@(() => _isExpanded = !_isExpanded)" />
                    </div>
                    <SgCollapse @ref="_collapseRef" Title="Controlled panel" @bind-Expanded="_isExpanded">
                        <p style="margin: 0;">Panel is @(_isExpanded ? "expanded" : "collapsed")</p>
                    </SgCollapse>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_bindingProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Custom Header & Extra Content</h2>
        <p>Fully customize the header and add action buttons.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgCollapse Title="Disabled panel" Disabled="true">
                        <p style="margin: 0;">This content is not accessible because the panel is disabled.</p>
                    </SgCollapse>
                    <SgCollapse Title="No arrow" ShowArrow="false">
                        <p style="margin: 0;">This panel hides the expand/collapse arrow.</p>
                    </SgCollapse>
                    <SgCollapse Title="Panel with actions">
                        <ExtraContent>
                            <SgButton Text="Edit" Size="sm" Variant="ghost" />
                        </ExtraContent>
                        <ChildContent>
                            <p style="margin: 0;">The Edit button in the header does not trigger collapse.</p>
                        </ChildContent>
                    </SgCollapse>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_advancedProperties" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private SgCollapse? _collapseRef;
    private bool _isExpanded;

    private List<PropertyPanelItem> _basicProperties = new()
    {
        new() { Label = "Title", Value = "string", BadgeText = "Header text", BadgeVariant = "info" },
        new() { Label = "Expanded", Value = "bool", BadgeText = "Two-way binding", BadgeVariant = "warn" },
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Panel body", BadgeVariant = "info" },
        new() { Label = "CssClass", Value = "string", BadgeText = "Custom CSS", BadgeVariant = "info" }
    };

    private List<PropertyPanelItem> _bindingProperties = new()
    {
        new() { Label = "Expanded", Value = "bool", BadgeText = "Two-way", BadgeVariant = "warn" },
        new() { Label = "ExpandedChanged", Value = "EventCallback<bool>", BadgeText = "State changed", BadgeVariant = "success" },
        new() { Label = "OnExpand", Value = "EventCallback", BadgeText = "Expanded", BadgeVariant = "success" },
        new() { Label = "OnCollapse", Value = "EventCallback", BadgeText = "Collapsed", BadgeVariant = "success" }
    };

    private List<PropertyPanelItem> _advancedProperties = new()
    {
        new() { Label = "Disabled", Value = "bool", BadgeText = "Disabled", BadgeVariant = "warn" },
        new() { Label = "ShowArrow", Value = "bool (default: true)", BadgeText = "Toggle arrow", BadgeVariant = "warn" },
        new() { Label = "HeaderContent", Value = "RenderFragment", BadgeText = "Custom header", BadgeVariant = "info" },
        new() { Label = "ExtraContent", Value = "RenderFragment", BadgeText = "Header actions", BadgeVariant = "info" }
    };
}
