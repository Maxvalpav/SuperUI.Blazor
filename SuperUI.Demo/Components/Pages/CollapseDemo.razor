@page "/collapse-demo"
@using SuperUI.Components

<PageTitle>Collapse - SUI</PageTitle>

<SgCard Title="SgCollapse - Collapsible Panel"
        Subtitle="Standalone collapsible panel with header, content, and optional actions.">

    <div style="margin-top: 32px;">
        <h2>Basic Usage</h2>
        <p>Simple collapsible panel with title and content.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgCollapse Title="Click to expand">
                        <p style="margin: 0;">This is the collapsible content. You can put any markup here.</p>
                    </SgCollapse>
                    <SgCollapse Title="Initially expanded" Expanded="true">
                        <p style="margin: 0;">This panel starts in the expanded state.</p>
                    </SgCollapse>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_basicProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Two-way Binding & Events</h2>
        <p>Control the panel state programmatically.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div style="display: flex; gap: 8px; margin-bottom: 8px;">
                        <SgButton Text="Expand" Size="SgSize.Sm" OnClick="@(() => _isExpanded = true)" />
                        <SgButton Text="Collapse" Size="SgSize.Sm" OnClick="@(() => _isExpanded = false)" />
                        <SgButton Text="Toggle" Size="SgSize.Sm" OnClick="@(() => _isExpanded = !_isExpanded)" />
                    </div>
                    <SgCollapse @ref="_collapseRef" Title="Controlled panel" @bind-Expanded="_isExpanded">
                        <p style="margin: 0;">Panel is @(_isExpanded ? "expanded" : "collapsed")</p>
                    </SgCollapse>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_bindingProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Custom Header & Extra Content</h2>
        <p>Fully customize the header and add action buttons.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgCollapse Title="Disabled panel" Disabled="true">
                        <p style="margin: 0;">This content is not accessible because the panel is disabled.</p>
                    </SgCollapse>
                    <SgCollapse Title="No arrow" ShowArrow="false">
                        <p style="margin: 0;">This panel hides the expand/collapse arrow.</p>
                    </SgCollapse>
                    <SgCollapse Title="Panel with actions">
                        <ExtraContent>
                            <SgButton Text="Edit" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" />
                        </ExtraContent>
                        <ChildContent>
                            <p style="margin: 0;">The Edit button in the header does not trigger collapse.</p>
                        </ChildContent>
                    </SgCollapse>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_advancedProperties" />
            </SgCard>
        </div>
    </div>
    <div style="margin-top: 32px;">
        <h2>Варианты стиля и стрелки</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="SgCollapseVariant">
                <PropertyTable Items="_variantEnum" />
            </SgCard>
            <SgCard Title="SgArrowPlacement">
                <PropertyTable Items="_arrowEnum" />
            </SgCard>
        </div>
    </div>

    <!-- Примеры кода -->
    <div style="margin-top: 32px;">
        <h2>Примеры кода</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Базовое использование">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_basicCode" />
            </SgCard>
            <SgCard Title="Управление и события">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_bindingCode" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private SgCollapse? _collapseRef;
    private bool _isExpanded;

    private List<PropertyPanelItem> _basicProperties = new()
    {
        new() { Label = "Title", Value = "string", BadgeText = "Header text", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Expanded", Value = "bool", BadgeText = "Two-way binding", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Panel body", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "CssClass", Value = "string", BadgeText = "Custom CSS", BadgeVariant = SgBadgeVariant.Info }
    };

    private List<PropertyPanelItem> _bindingProperties = new()
    {
        new() { Label = "Expanded", Value = "bool", BadgeText = "Two-way", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ExpandedChanged", Value = "EventCallback<bool>", BadgeText = "State changed", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnExpand", Value = "EventCallback", BadgeText = "Expanded", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnCollapse", Value = "EventCallback", BadgeText = "Collapsed", BadgeVariant = SgBadgeVariant.Success }
    };

    private List<PropertyPanelItem> _advancedProperties = new()
    {
        new() { Label = "Disabled",       Value = "bool",                    BadgeText = "Disabled",         BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowArrow",      Value = "bool (default: true)",    BadgeText = "Toggle arrow",     BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ArrowPlacement", Value = "start|end",               BadgeText = "Позиция стрелки",  BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Variant",        Value = "default|bordered|ghost|filled", BadgeText = "Стиль",     BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "HeaderContent",  Value = "RenderFragment",          BadgeText = "Custom header",    BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ExtraContent",   Value = "RenderFragment",          BadgeText = "Header actions",   BadgeVariant = SgBadgeVariant.Info }
    };

    // ── Enum tables ──────────────────────────────────────────────────────────
    private List<PropertyPanelItem> _variantEnum = new()
    {
        new() { Label = "SgCollapseVariant.Default",  Value = "\"default\"",  BadgeText = "Тонкая граница (по умолч.)", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "SgCollapseVariant.Bordered", Value = "\"bordered\"", BadgeText = "Чёткая граница",             BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgCollapseVariant.Ghost",    Value = "\"ghost\"",    BadgeText = "Без границы",                BadgeVariant = SgBadgeVariant.Muted },
        new() { Label = "SgCollapseVariant.Filled",   Value = "\"filled\"",   BadgeText = "Заливка заголовка",          BadgeVariant = SgBadgeVariant.Info },
    };

    private List<PropertyPanelItem> _arrowEnum = new()
    {
        new() { Label = "SgArrowPlacement.End",   Value = "\"end\"",   BadgeText = "Справа (по умолч.)", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "SgArrowPlacement.Start", Value = "\"start\"", BadgeText = "Слева",              BadgeVariant = SgBadgeVariant.Info },
    };

    private string _basicCode = """
        <!-- Базовый -->
        <SgCollapse Title="Нажмите для раскрытия">
            <p>Содержимое панели.</p>
        </SgCollapse>

        <!-- Стиль и стрелка слева -->
        <SgCollapse Title="Bordered + стрелка слева"
                    Variant="SgCollapseVariant.Bordered"
                    ArrowPlacement="SgArrowPlacement.Start">
            <p>Содержимое.</p>
        </SgCollapse>

        <!-- С кнопкой в заголовке -->
        <SgCollapse Title="С действием">
            <ExtraContent>
                <SgButton Text="Edit" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" />
            </ExtraContent>
            <ChildContent>
                <p>Кнопка не закрывает панель.</p>
            </ChildContent>
        </SgCollapse>
        """;

    private string _bindingCode = """
        <SgCollapse @bind-Expanded="_open"
                    Title="Управляемая панель"
                    OnExpand="@(() => Console.WriteLine("Opened"))"
                    OnCollapse="@(() => Console.WriteLine("Closed"))">
            <p>Состояние: @(_open ? "открыта" : "закрыта")</p>
        </SgCollapse>

        <SgButton Text="Toggle" OnClick="@(() => _open = !_open)" />

        @code {
            private bool _open;
        }
        """;
}
