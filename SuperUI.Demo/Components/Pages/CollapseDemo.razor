@page "/collapse-demo"
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>SgCollapse — Collapse — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="SgCollapse" Subtitle="A standalone collapsible panel with customizable header, icon, arrow placement, variants, sizes, and two-way binding." />
    </HeaderContent>
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. SgCollapse — Basic Usage                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgCollapse — Basic Usage
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                A standalone collapsible panel with header, content, and optional icon. Supports two-way binding and events.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Basic
                        </SgTypography>
                        <SgCollapse Title="Click to expand">
                            <div class="demo-collapse-content">
                                This is the collapsible content. Click the header to toggle.
                            </div>
                        </SgCollapse>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Initially Expanded
                        </SgTypography>
                        <SgCollapse Title="Initially expanded" Expanded="true">
                            <div class="demo-collapse-content">
                                This panel starts in the expanded state.
                            </div>
                        </SgCollapse>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With Icon
                        </SgTypography>
                        <SgCollapse Title="Notifications" Icon="@SgIcons.Bell" Expanded="true">
                            <div class="demo-collapse-content">
                                You have 3 unread notifications.
                            </div>
                        </SgCollapse>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Disabled
                        </SgTypography>
                        <SgCollapse Title="Disabled panel" Disabled="true">
                            <div class="demo-collapse-content">
                                This content cannot be toggled.
                            </div>
                        </SgCollapse>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_basicProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Two-way Binding & Events                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgCollapse — Two-way Binding & Events
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Control the panel state programmatically with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">@@bind-Expanded</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">OnExpand</SgTypography>, and <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">OnCollapse</SgTypography> callbacks.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Programmatic Control" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Sm">
                    <SgSpace>
                        <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Primary" OnClick="@(() => _isExpanded = true)">Expand</SgButton>
                        <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined" OnClick="@(() => _isExpanded = false)">Collapse</SgButton>
                        <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="@(() => _isExpanded = !_isExpanded)">Toggle</SgButton>
                    </SgSpace>
                    <SgCollapse Title="Controlled panel" @bind-Expanded="_isExpanded">
                        <div class="demo-collapse-content">
                            Panel is <strong>@(_isExpanded ? "expanded" : "collapsed")</strong>
                        </div>
                    </SgCollapse>
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Last event: @_lastEvent
                    </SgTypography>
                </SgStack>
            </SgCard>

            <SgCard Title="Event Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_bindingProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Custom Header & Extra Content                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgCollapse — Custom Header & Extra Content
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Fully customize the header with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">HeaderContent</SgTypography>, hide the arrow with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ShowArrow</SgTypography>, or add actions with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ExtraContent</SgTypography>.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Custom Header Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgCollapse Title="No arrow" ShowArrow="false" Expanded="true">
                            <div class="demo-collapse-content">
                                This panel hides the expand/collapse arrow.
                            </div>
                        </SgCollapse>
                        <SgCollapse ArrowPlacement="SgArrowPlacement.Start" Title="Arrow on left" Expanded="true">
                            <div class="demo-collapse-content">
                                The chevron is placed on the left side.
                            </div>
                        </SgCollapse>
                        <SgCollapse Title="Panel with actions">
                            <ExtraContent>
                                <SgButton Text="Edit" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="() => {}" />
                                <SgButton Text="Delete" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" Color="danger" OnClick="() => {}" />
                            </ExtraContent>
                            <ChildContent>
                                <div class="demo-collapse-content">
                                    The buttons in the header do not trigger collapse.
                                </div>
                            </ChildContent>
                        </SgCollapse>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Advanced Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_advancedProperties" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Variants & Sizes                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgCollapse — Variants & Sizes
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Four visual variants: <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Default</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Bordered</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Ghost</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Filled</SgTypography>. Three sizes: Sm, Md, Lg.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Md">
            <SgCol Md="3">
                <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm" NoPadding="true">
                    <div class="demo-inner-card-title">Default</div>
                    <div style="padding:0 12px 12px;">
                        <SgCollapse Variant="SgCollapseVariant.Default" Title="Default" Expanded="true">
                            <div class="demo-collapse-content">Thin border style.</div>
                        </SgCollapse>
                    </div>
                </SgCard>
            </SgCol>
            <SgCol Md="3">
                <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm" NoPadding="true">
                    <div class="demo-inner-card-title">Bordered</div>
                    <div style="padding:0 12px 12px;">
                        <SgCollapse Variant="SgCollapseVariant.Bordered" Title="Bordered" Expanded="true">
                            <div class="demo-collapse-content">Clear border style.</div>
                        </SgCollapse>
                    </div>
                </SgCard>
            </SgCol>
            <SgCol Md="3">
                <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm" NoPadding="true">
                    <div class="demo-inner-card-title">Ghost</div>
                    <div style="padding:0 12px 12px;">
                        <SgCollapse Variant="SgCollapseVariant.Ghost" Title="Ghost" Expanded="true">
                            <div class="demo-collapse-content">No border style.</div>
                        </SgCollapse>
                    </div>
                </SgCard>
            </SgCol>
            <SgCol Md="3">
                <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm" NoPadding="true">
                    <div class="demo-inner-card-title">Filled</div>
                    <div style="padding:0 12px 12px;">
                        <SgCollapse Variant="SgCollapseVariant.Filled" Title="Filled" Expanded="true">
                            <div class="demo-collapse-content">Filled header style.</div>
                        </SgCollapse>
                    </div>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <div class="demo-inner-card-title">Size = Sm</div>
                    <SgCollapse Size="SgSize.Sm" Title="Small collapse" Expanded="true">
                        <div class="demo-collapse-content">Compact size.</div>
                    </SgCollapse>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <div class="demo-inner-card-title">Size = Md (Default)</div>
                    <SgCollapse Size="SgSize.Md" Title="Medium collapse" Expanded="true">
                        <div class="demo-collapse-content">Standard size.</div>
                    </SgCollapse>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <div class="demo-inner-card-title">Size = Lg</div>
                    <SgCollapse Size="SgSize.Lg" Title="Large collapse" Expanded="true">
                        <div class="demo-collapse-content">Spacious size.</div>
                    </SgCollapse>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Enums                                                            -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgCollapse — Enumerations
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="SgCollapseVariant" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_variantEnum" />
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="SgArrowPlacement" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_arrowEnum" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

</ChildContent>
</SgCard>

<style>
    .demo-section { margin-top: 48px; }
    .demo-section-header { margin-bottom: 20px; }
    .demo-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    @@media (max-width: 768px) { .demo-two-col { grid-template-columns: 1fr; } }
    .demo-collapse-content { padding: 4px 0; font-size: 13px; line-height: 1.6; color: var(--sg-text-secondary); }
    .demo-inner-card-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--sg-text-muted); padding: 12px 12px 8px; border-bottom: 1px solid var(--sg-border); margin-bottom: 12px; }
</style>

@code {
    // ── Main card header ─────────────────────────────────────────────────
    private bool _isExpanded;
    private string _lastEvent = "—";

    // ── Property tables ───────────────────────────────────────────────────
    private List<PropertyPanelItem> _basicProperties = new()
    {
        new() { Label = "Title",         Value = "string",                          BadgeText = "Header text",  BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Expanded",      Value = "bool",                            BadgeText = "Two-way",      BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Icon",          Value = "string? (SVG)",                   BadgeText = "Icon",         BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "ChildContent",  Value = "RenderFragment",                   BadgeText = "Panel body",   BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "CssClass",      Value = "string?",                          BadgeText = "Custom CSS",   BadgeVariant = SgBadgeVariant.Info    },
    };

    private List<PropertyPanelItem> _bindingProperties = new()
    {
        new() { Label = "Expanded",        Value = "bool",                           BadgeText = "Two-way",      BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "ExpandedChanged", Value = "EventCallback<bool>",            BadgeText = "State change", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnExpand",        Value = "EventCallback",                  BadgeText = "Expanded",     BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnCollapse",      Value = "EventCallback",                  BadgeText = "Collapsed",    BadgeVariant = SgBadgeVariant.Success },
    };

    private List<PropertyPanelItem> _advancedProperties = new()
    {
        new() { Label = "Disabled",         Value = "bool",                          BadgeText = "Disabled",     BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "ShowArrow",        Value = "bool (default true)",           BadgeText = "Toggle arrow", BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "ArrowPlacement",   Value = "Start | End",                   BadgeText = "Arrow pos",    BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Variant",          Value = "SgCollapseVariant",             BadgeText = "Style",        BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Size",             Value = "SgSize (Sm|Md|Lg)",             BadgeText = "Size",         BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Animated",         Value = "bool (default true)",           BadgeText = "Animation",    BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "AnimationDuration",Value = "int (ms, default 200)",         BadgeText = "Duration",     BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "HeaderContent",    Value = "RenderFragment?",               BadgeText = "Custom head",  BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "ExtraContent",     Value = "RenderFragment?",               BadgeText = "Header acts",  BadgeVariant = SgBadgeVariant.Info    },
    };

    private List<PropertyPanelItem> _variantEnum = new()
    {
        new() { Label = "Default",  Value = "SgCollapseVariant.Default",  BadgeText = "Thin border",      BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Bordered", Value = "SgCollapseVariant.Bordered", BadgeText = "Clear border",     BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Ghost",    Value = "SgCollapseVariant.Ghost",    BadgeText = "No border",        BadgeVariant = SgBadgeVariant.Muted   },
        new() { Label = "Filled",   Value = "SgCollapseVariant.Filled",   BadgeText = "Filled header",    BadgeVariant = SgBadgeVariant.Info    },
    };

    private List<PropertyPanelItem> _arrowEnum = new()
    {
        new() { Label = "End",   Value = "SgArrowPlacement.End",   BadgeText = "Right (default)", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Start", Value = "SgArrowPlacement.Start", BadgeText = "Left",            BadgeVariant = SgBadgeVariant.Info    },
    };
}
