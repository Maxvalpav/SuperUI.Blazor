@page "/vision-demo"
@using SuperUI.Components

<PageTitle>Vision — SuperUI</PageTitle>

<div class="sg-demo-header">
    <SgStack Align="SgAlignItems.Center" Gap="12px">
        <SgIcon Icon="@SgIcons.Camera" Size="28" Color="var(--sg-primary)" />
        <div>
            <h1 class="sg-demo-title">Компьютерное зрение</h1>
            <p class="sg-demo-subtitle">Инструменты для обработки документов и изображений в реальном времени.</p>
        </div>
    </SgStack>
</div>

<SgStack Orientation="SgOrientation.Vertical" Gap="24px">
    
    <SgRow Gutter="16">
        <SgCol Span="16">
            <SgCard Title="Умный сканер документов" Subtitle="Автоматический поиск контуров и коррекция перспективы (OpenCV.js)">
                <ChildContent>
                    <SgDocumentScanner OnScan="HandleScan" />
                </ChildContent>
            </SgCard>
        </SgCol>
        
        <SgCol Span="8">
            <SgCard Title="Результат сканирования" Variant="SgCardVariant.Glass">
                <ChildContent>
                    <SgStack Orientation="SgOrientation.Vertical" Align="SgAlignItems.Center" Gap="16px">
                        @if (string.IsNullOrEmpty(_lastScan))
                        {
                            <div style="height: 300px; display: flex; align-items: center; justify-content: center; color: var(--sg-text-secondary); border: 2px dashed var(--sg-border); border-radius: 12px; width: 100%;">
                                <SgStack Orientation="SgOrientation.Vertical" Align="SgAlignItems.Center" Gap="8px">
                                    <SgIcon Icon="@SgIcons.FileText" Style="width: 48px; height: 48px; opacity: 0.3;" />
                                    <span>Ожидание скана...</span>
                                </SgStack>
                            </div>
                        }
                        else
                        {
                            <img src="@_lastScan" style="width: 100%; border-radius: 8px; box-shadow: var(--sg-shadow-md);" />
                            <SgButton Variant="SgButtonVariant.Success" OnClick="() => _lastScan = null" Text="Очистить">
                                <Icon><SgIcon Icon="@SgIcons.RefreshCw" /></Icon>
                            </SgButton>
                        }
                    </SgStack>
                </ChildContent>
            </SgCard>
        </SgCol>
    </SgRow>

</SgStack>

@code {
    private string? _lastScan;

    private void HandleScan(string dataUrl)
    {
        _lastScan = dataUrl;
        StateHasChanged();
    }
}
