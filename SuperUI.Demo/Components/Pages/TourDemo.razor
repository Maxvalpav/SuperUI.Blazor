@page "/tour-demo"
@using SuperUI.Components
@using SuperUI.Components.Navigation.Tour

<PageTitle>Tour — SuperUI</PageTitle>

<div class="sg-demo-header">
    <h1>Tour</h1>
    <p class="sg-text-muted">A guide component for touring your application features.</p>
</div>

<SgStack Orientation="SgOrientation.Vertical" Gap="24px">

    <SgCard Title="Basic Usage" Compact="true">
        <SgSpace>
            <SgButton id="tour-target-1" Variant="SgButtonVariant.Primary" OnClick="() => _isOpen = true">
                Start Tour
            </SgButton>
            <SgButton id="tour-target-2" Variant="SgButtonVariant.Outlined">
                Upload Files
            </SgButton>
            <SgButton id="tour-target-3" Variant="SgButtonVariant.Ghost">
                Settings
            </SgButton>
        </SgSpace>
    </SgCard>

    <SgRow>
        <SgCol Span="12">
            <SgCard id="tour-target-card" Title="Feature Spotlight" Subtitle="Example card for the tour">
                <p>This card will be highlighted during the tour to explain specific dashboard features.</p>
            </SgCard>
        </SgCol>
    </SgRow>

    <SgTour @bind-IsOpen="_isOpen" @bind-CurrentStepIndex="_currentStep">
        <SgTourStep Target="#tour-target-1" 
                    Title="Welcome!" 
                    Content="This is the start button. Click here to begin your journey." 
                    Placement="SgTourPlacement.Bottom" />
        
        <SgTourStep Target="#tour-target-2" 
                    Title="File Management" 
                    Content="You can upload industrial data logs and manuals here." 
                    Placement="SgTourPlacement.Bottom" />

        <SgTourStep Target="#tour-target-card" 
                    Title="Dashboard Analytics" 
                    Content="Observe real-time telemetry and RAG-based insights in this section." 
                    Placement="SgTourPlacement.Right" />

        <SgTourStep Target="#tour-target-3" 
                    Title="Configuration" 
                    Content="Setup your LLM providers and IoT sensors in the settings menu." 
                    Placement="SgTourPlacement.Left" />
    </SgTour>

</SgStack>

@code {
    private bool _isOpen;
    private int _currentStep;
}
