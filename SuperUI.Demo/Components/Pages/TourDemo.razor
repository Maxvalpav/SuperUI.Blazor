@page "/tour-demo"
@using SuperUI.Components
@using SuperUI.Components.Navigation.Tour
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgTour — Interactive Guide — SuperUI</PageTitle>
<SgSeoHead Description="Interactive guided tour component that highlights elements with contextual tooltips. Supports masks, keyboard navigation, and responsive positioning." />

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        >
    <HeaderContent>
        <DemoPageHeader Title="SgTour"
                       Subtitle="Interactive guided tour component that highlights elements with contextual tooltips. Supports masks, keyboard navigation, and responsive positioning." />
    </HeaderContent>
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Basic Usage                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Basic Usage
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                A step-by-step guide that highlights UI elements and provides contextual instructions.
                Supports keyboard navigation: <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Esc</SgTypography> to close,
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">→</SgTypography> / <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">←</SgTypography> to navigate.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Live Demo" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgSpace>
                        <SgButton id="tour-target-1" Variant="SgButtonVariant.Primary" OnClick="() => _isOpen = true">
                            Start Tour
                        </SgButton>
                        <SgButton id="tour-target-2" Variant="SgButtonVariant.Outlined">
                            Upload Files
                        </SgButton>
                        <SgButton id="tour-target-3" Variant="SgButtonVariant.Ghost">
                            Settings
                        </SgButton>
                    </SgSpace>

                    <SgCard id="tour-target-card" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                        <HeaderContent>
                            <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <div style="width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,var(--sg-primary),#8b5cf6);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:14px;">S</div>
                                <SgStack Vertical Space="0" Align="SgAlignItems.Start">
                                    <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm">Feature Spotlight</SgTypography>
                                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Example card for the tour</SgTypography>
                                </SgStack>
                            </SgStack>
                        </HeaderContent>
                        <ChildContent>
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                                This card will be highlighted during the tour to explain specific dashboard features.
                                Interactive elements respond to your clicks as you navigate through the guide.
                            </SgTypography>
                        </ChildContent>
                    </SgCard>

                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                        Active step: <SgTypography Font="SgTypographyFont.Mono" Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold">@(_isOpen ? $"{_currentStep + 1} / 4" : "—")</SgTypography>
                    </SgTypography>
                </SgStack>
            </SgCard>

            <SgCard Title="Features" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Start">
                        <div class="feature-icon">🎯</div>
                        <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                            <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm">Element Highlighting</SgTypography>
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Targets any DOM element with CSS selectors, auto-scrolls into view</SgTypography>
                        </SgStack>
                    </SgStack>
                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Start">
                        <div class="feature-icon">⌨️</div>
                        <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                            <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm">Keyboard Navigation</SgTypography>
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Arrow keys, Escape, Enter — fully accessible</SgTypography>
                        </SgStack>
                    </SgStack>
                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Start">
                        <div class="feature-icon">🎨</div>
                        <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                            <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm">Mask & Positioning</SgTypography>
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Dark overlay mask, 4 placement directions (top/bottom/left/right)</SgTypography>
                        </SgStack>
                    </SgStack>
                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Start">
                        <div class="feature-icon">📱</div>
                        <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                            <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm">Responsive</SgTypography>
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Auto-repositions on window resize, mobile-friendly</SgTypography>
                        </SgStack>
                    </SgStack>
                </SgStack>
            </SgCard>
        </div>
    </div>

    <DemoCodeBlock Code="@_basicCode" Title="Basic tour with 4 steps" />

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Placement Variants                                             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Placement Variants
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Tour steps can be positioned in four directions relative to the target element.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Md">
            <SgCol Md="6" Lg="3">
                <SgCard Title="Bottom (Default)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                        <SgButton id="tour-placement-bottom" Variant="SgButtonVariant.Outlined" Size="SgSize.Sm">Target Element</SgButton>
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Popover appears below</SgTypography>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6" Lg="3">
                <SgCard Title="Top" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                        <SgButton id="tour-placement-top" Variant="SgButtonVariant.Outlined" Size="SgSize.Sm">Target Element</SgButton>
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Popover appears above</SgTypography>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6" Lg="3">
                <SgCard Title="Left" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                        <SgButton id="tour-placement-left" Variant="SgButtonVariant.Outlined" Size="SgSize.Sm">Target Element</SgButton>
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Popover appears on left</SgTypography>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6" Lg="3">
                <SgCard Title="Right" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                        <SgButton id="tour-placement-right" Variant="SgButtonVariant.Outlined" Size="SgSize.Sm">Target Element</SgButton>
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Popover appears on right</SgTypography>
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <DemoCodeBlock Code="@_placementCode" Title="Placement variants" />

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Live Constructor                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live SgTour Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure tour step parameters and see the result in real time. Click the generated code to copy.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Step Title -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Step Title</SgTypography>
                            <SgTextBox TValue="string" @bind-Value="_constructorTitle" Size="SgSize.Sm" Placeholder="Enter step title" />
                        </SgStack>

                        <!-- Step Content -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Step Content</SgTypography>
                            <SgTextArea @bind-Value="_constructorContent" Size="SgSize.Sm" Rows="3" Placeholder="Describe this step..." />
                        </SgStack>

                        <!-- Placement -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Placement</SgTypography>
                            <SgSegmented TValue="SgTourPlacement"
                                         Value="@_constructorPlacement"
                                         ValueChanged="v => { _constructorPlacement = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Options="@_placementSegOptions" />
                        </SgStack>

                        <!-- Mask On/Off -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Show Mask</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_constructorMask"
                                                 ValueChanged="v => { _constructorMask = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="@_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Total Steps</SgTypography>
                                    <SgSegmented TValue="int"
                                                 Value="@_constructorStepCount"
                                                 ValueChanged="v => { _constructorStepCount = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="@_stepCountOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Placement</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_constructorPlacement.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Mask</SgTypography>
                                    <SgBadge Variant="@(_constructorMask ? SgBadgeVariant.Success : SgBadgeVariant.Muted)" Text="@(_constructorMask ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Steps</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_constructorStepCount.ToString()" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                                <div class="demo-viewport-indicator">
                                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                                        <span>@SgTourPlacementStrings[(int)_constructorPlacement]</span>
                                    </SgTypography>
                                </div>
                            </div>
                            <div class="constructor-preview" style="display:flex;align-items:center;justify-content:center;min-height:140px;">
                                <div id="constructor-placement-target" style="padding:20px;background:var(--sg-surface-alt);border:2px dashed var(--sg-border);border-radius:8px;text-align:center;">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" Weight="SgTypographyWeight.Medium">🎯 Target Element</SgTypography>
                                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">(#constructor-placement-target)</SgTypography>
                                </div>
                            </div>
                        </SgStack>

                        <!-- Code -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                    <span id="tour-copy-icon" style="font-size:12px;">@_copyIcon</span>
                                    <span id="tour-copy-text" style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                </button>
                            </div>
                            <div class="code-block">
                                @foreach (var line in _generatedCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Component Properties                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Component Properties
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="SgTour" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_tourProperties" />
            </SgCard>
            <SgCard Title="SgTourStep" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_stepProperties" />
            </SgCard>
        </div>
    </div>

    </ChildContent>
</SgCard>

<SgTour @bind-IsOpen="_isOpen" @bind-CurrentStepIndex="_currentStep">
    <SgTourStep Target="#tour-target-1"
                Title="Welcome!"
                Content="This is the start button. Click here to begin your journey through the application."
                Placement="SgTourPlacement.Bottom" />
    <SgTourStep Target="#tour-target-2"
                Title="File Management"
                Content="Upload industrial data logs and manuals here. Supports batch uploads and drag-and-drop."
                Placement="SgTourPlacement.Bottom" />
    <SgTourStep Target="#tour-target-card"
                Title="Dashboard Analytics"
                Content="Observe real-time telemetry and RAG-based insights in this section. All metrics update automatically."
                Placement="SgTourPlacement.Right" />
    <SgTourStep Target="#tour-target-3"
                Title="Configuration"
                Content="Configure LLM providers, IoT sensors, and notification preferences in the settings menu."
                Placement="SgTourPlacement.Left" />
</SgTour>

<style>
    .demo-section { margin-top: 48px; }
    .demo-section-header { margin-bottom: 20px; }

    .demo-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }
    @@media (max-width: 768px) {
        .demo-two-col { grid-template-columns: 1fr; }
    }

    .feature-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .constructor-preview {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 16px;
        min-height: 100px;
        transition: all 0.3s ease;
    }
    .ctrl-summary {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 12px 14px;
    }
    .code-block {
        background: #0f172a;
        color: #7dd3fc;
        padding: 14px 16px;
        border-radius: 8px;
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 12px;
        line-height: 1.9;
        overflow-x: auto;
        position: relative;
    }
    .code-block code {
        background: none;
        padding: 0;
        color: inherit;
        font-size: inherit;
        display: block;
        white-space: pre;
    }

    .demo-copy-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 6px;
        padding: 4px 10px;
        cursor: pointer;
        color: var(--sg-text-muted);
        transition: all 0.2s ease;
        font-family: inherit;
    }
    .demo-copy-btn:hover {
        color: var(--sg-primary);
        border-color: var(--sg-primary);
        background: color-mix(in srgb, var(--sg-primary) 8%, transparent);
    }
    .demo-copy-btn:active { transform: scale(0.95); }

    .demo-viewport-indicator {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 6px;
        padding: 2px 10px;
        font-size: 11px;
    }
</style>

@code {
    private static readonly string[] SgTourPlacementStrings = { "Bottom", "Top", "Left", "Right" };


    // ── Tour state ──
    private bool _isOpen;
    private int _currentStep;

    // ── Constructor state ──
    private string _constructorTitle = "Welcome";
    private string _constructorContent = "This step highlights the target element.";
    private SgTourPlacement _constructorPlacement = SgTourPlacement.Bottom;
    private bool _constructorMask = true;
    private int _constructorStepCount = 3;

    // ── Code generation ──
    private string[] _generatedCodeLines = Array.Empty<string>();
    private string _copyIcon = "📋";
    private string _copyLabel = "Copy";

    // ── Segmented options ──
    private readonly List<SgSegmentedOption<SgTourPlacement>> _placementSegOptions = new()
    {
        new() { Value = SgTourPlacement.Bottom, Label = "Bottom" },
        new() { Value = SgTourPlacement.Top,    Label = "Top" },
        new() { Value = SgTourPlacement.Left,   Label = "Left" },
        new() { Value = SgTourPlacement.Right,  Label = "Right" },
    };

    private readonly List<SgSegmentedOption<bool>> _boolSegOptions = new()
    {
        new() { Value = false, Label = "Off" },
        new() { Value = true,  Label = "On" },
    };

    private readonly List<SgSegmentedOption<int>> _stepCountOptions = new()
    {
        new() { Value = 2, Label = "2" },
        new() { Value = 3, Label = "3" },
        new() { Value = 4, Label = "4" },
        new() { Value = 5, Label = "5" },
    };

    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add("<SgTour @bind-IsOpen=\"_isOpen\"");
        lines.Add("        @bind-CurrentStepIndex=\"_currentStep\">");
        lines.Add("");

        for (int i = 0; i < _constructorStepCount; i++)
        {
            var title = i == 0 ? _constructorTitle : $"Step {i + 1}";
            var content = i == 0 ? _constructorContent : $"Description for step {i + 1}";
            var placement = i == 0 ? _constructorPlacement : SgTourPlacement.Bottom;
            var mask = i == 0 ? _constructorMask : true;
            var target = i == 0 ? "#target-element" : $"#target-{i + 1}";

            lines.Add($"    <SgTourStep Target=\"{target}\"");
            lines.Add($"                Title=\"{title}\"");
            lines.Add($"                Content=\"{content}\"");
            lines.Add($"                Placement=\"SgTourPlacement.{placement}\"");
            if (!mask)
                lines.Add($"                Mask=\"false\"");
            lines.Add($"                @ref=\"_step{i + 1}\" />");
            lines.Add("");
        }
        lines.Add("</SgTour>");
        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

    // ── Property tables ──
    private List<PropertyPanelItem> _tourProperties = new()
    {
        new() { Label = "IsOpen", Value = "bool", BadgeText = "Show/hide", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "IsOpenChanged", Value = "EventCallback", BadgeText = "Two-way bind", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "CurrentStepIndex", Value = "int", BadgeText = "Active step", BadgeVariant = SgBadgeVariant.Info },
