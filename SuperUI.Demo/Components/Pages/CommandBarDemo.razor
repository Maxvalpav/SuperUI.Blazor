@page "/command-bar-demo"
@using SuperUI.Components

<PageTitle>CommandBar - SUI</PageTitle>

<SgCard Title="SgCommandBar - Панель команд"
        Subtitle="Панель команд в стиле Office с адаптивным overflow меню.">

    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Примеры использования</SgTypography>
        <p>Различные конфигурации панели команд.</p>

        <div style="display: grid; grid-template-columns: 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Базовая панель команд">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Основные команды с иконками</div>
                    <SgCommandBar Items="_basicCommands" />
                </div>
            </SgCard>

            <SgCard Title="С кнопками и toggle-командами">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Команды с различными состояниями</div>
                    <SgCommandBar Items="_advancedCommands">
                        <FarContent>
                            <SgButton Text="Настройки" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm"><Icon>@(new MarkupString(SettingsIcon))</Icon></SgButton>
                        </FarContent>
                    </SgCommandBar>
                </div>
            </SgCard>

            <SgCard Title="Адаптивная панель (сжмите окно)">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">
                        При уменьшении ширины элементы автоматически перемещаются в overflow меню
                    </div>
                    <div style="resize: horizontal; overflow: auto; min-width: 200px; border: 1px dashed var(--sui-border); padding: 8px;">
                        <SgCommandBar Items="_longCommandList" />
                    </div>
                </div>
            </SgCard>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 24px;">
            <SgCard Title="Только иконки">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Компактный режим</div>
                    <SgCommandBar Items="_iconOnlyCommands" />
                </div>
            </SgCard>

            <SgCard Title="С разделителями">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Группировка команд</div>
                    <SgCommandBar Items="_groupedCommands" />
                </div>
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Создание команд</SgTypography>
    </div>

</SgCard>

@code {
    private List<CommandBarItem> _basicCommands = new();
    private List<CommandBarItem> _advancedCommands = new();
    private List<CommandBarItem> _longCommandList = new();
    private List<CommandBarItem> _iconOnlyCommands = new();
    private List<CommandBarItem> _groupedCommands = new();

    private string CheckIcon => "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><polyline points='20 6 9 17 4 12'/></svg>";
    private string TrashIcon => "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><polyline points='3 6 5 6 21 6'/><path d='M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2'/></svg>";
    private string EditIcon => "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7'/><path d='M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z'/></svg>";
    private string CopyIcon => "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><rect x='9' y='9' width='13' height='13' rx='2' ry='2'/><path d='M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1'/></svg>";
    private string DownloadIcon => "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4'/><polyline points='7 10 12 15 17 10'/><line x1='12' y1='15' x2='12' y2='3'/></svg>";
    private string PrintIcon => "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><polyline points='6 9 6 2 18 2 18 9'/><path d='M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2'/><rect x='6' y='14' width='12' height='8'/></svg>";
    private string ShareIcon => "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='18' cy='5' r='3'/><circle cx='6' cy='12' r='3'/><circle cx='18' cy='19' r='3'/><line x1='8.59' y1='13.51' x2='15.42' y2='17.49'/><line x1='15.41' y1='6.51' x2='8.59' y2='10.49'/></svg>";
    private string SettingsIcon => "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='12' cy='12' r='3'/><path d='M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z'/></svg>";
    private string BoldIcon => "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6V4z'/><path d='M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6v-8z'/></svg>";
    private string ItalicIcon => "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><line x1='19' y1='4' x2='10' y2='4'/><line x1='14' y1='20' x2='5' y2='20'/><line x1='15' y1='4' x2='9' y2='20'/></svg>";
    private string UndoIcon => "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M3 7v6h6'/><path d='M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13'/></svg>";
    private string RedoIcon => "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M21 7v6h-6'/><path d='M3 17a9 9 0 0 1 9-9 9 9 0 0 1 6 2.3L21 13'/></svg>";

    protected override void OnInitialized()
    {
        _basicCommands = new List<CommandBarItem>
        {
            new() { Text = "Сохранить", Icon = CheckIcon, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Сохранить")) },
            new() { Text = "Редактировать", Icon = EditIcon, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Редактировать")) },
            new() { Text = "Удалить", Icon = TrashIcon, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Удалить")) },
        };

        _advancedCommands = new List<CommandBarItem>
        {
            new() { Text = "Сохранить", Icon = CheckIcon, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Сохранить")) },
            new() { Text = "Создать копию", Icon = CopyIcon, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Копировать")) },
            new() { Text = "Жирный", Icon = BoldIcon, IsToggle = true, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Bold")) },
            new() { Text = "Курсив", Icon = ItalicIcon, IsToggle = true, IsPressed = true, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Italic")) },
        };

        _longCommandList = new List<CommandBarItem>
        {
            new() { Text = "Новый", Icon = CheckIcon, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Новый")) },
            new() { Text = "Открыть", Icon = EditIcon, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Открыть")) },
            new() { Text = "Сохранить", Icon = CheckIcon, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Сохранить")) },
            new() { Text = "Сохранить как", Icon = CopyIcon, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Сохранить как")) },
            new() { Text = "Печать", Icon = PrintIcon, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Печать")) },
            new() { Text = "Экспорт", Icon = DownloadIcon, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Экспорт")) },
            new() { Text = "Поделиться", Icon = ShareIcon, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Поделиться")) },
            new() { Text = "Удалить", Icon = TrashIcon, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Удалить")) },
            new() { Text = "Отменить", Icon = UndoIcon, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Отменить")) },
            new() { Text = "Повторить", Icon = RedoIcon, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Повторить")) },
        };

        _iconOnlyCommands = new List<CommandBarItem>
        {
            new() { Icon = CheckIcon, Title = "Сохранить", OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Сохранить")) },
            new() { Icon = EditIcon, Title = "Редактировать", OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Редактировать")) },
            new() { Icon = CopyIcon, Title = "Копировать", OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Копировать")) },
            new() { Icon = TrashIcon, Title = "Удалить", OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Удалить")) },
        };

        _groupedCommands = new List<CommandBarItem>
        {
            new() { Text = "Новый", Icon = CheckIcon, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Новый")) },
            new() { Text = "Открыть", Icon = EditIcon, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Открыть")) },
            CommandBarItem.Separator(),
            new() { Text = "Вырезать", Icon = EditIcon, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Вырезать")) },
            new() { Text = "Копировать", Icon = CopyIcon, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Копировать")) },
            CommandBarItem.Separator(),
            new() { Text = "Удалить", Icon = TrashIcon, OnClick = EventCallback.Factory.Create<CommandBarItem>(this, _ => OnCommand("Удалить")) },
        };
    }

    private void OnCommand(string command)
    {
        // Демо - в реальном приложении здесь была бы логика
    }
}
