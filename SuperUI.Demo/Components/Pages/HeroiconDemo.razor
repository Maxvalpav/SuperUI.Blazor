@page "/heroicon-demo"
@using SuperUI.Components
@using SuperUI.Enums
@inject SgThemeService ThemeService

<PageTitle>Heroicons — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Heroicons Library" Subtitle="Over 300 beautiful hand-crafted SVG icons in 4 distinct styles." Icon="@SgHeroicons.Outline.RectangleStack" />
    </HeaderContent>
    <ChildContent>
        <div class="demo-section">
            <div class="demo-controls-bar">
                <SgCard Size="SgSize.Sm" Shadow="SgShadow.Sm">
                    <SgStack Horizontal Space="SgSize.Lg" Align="SgAlignItems.End" Wrap="true">
                        <div style="flex: 1; min-width: 250px;">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Color="var(--sg-text-muted)" Style="margin-bottom:4px;display:block;">Search Icons</SgTypography>
                            <SgTextBox @bind-Value="SearchText" @bind-Value:event="oninput" Placeholder="Type to filter..." PrefixIcon="@SgIcons.Search" Block />
                        </div>
                        <div style="width: 160px;">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Color="var(--sg-text-muted)" Style="margin-bottom:4px;display:block;">Variant</SgTypography>
                            <SgSelect TValue="string" @bind-Value="_selectedVariant" Items="@_variantOptions" Block />
                        </div>
                        <div class="status-pill">
                            <span class="pill-value">@(_filteredIcons.Count)</span>
                            <span class="pill-label">Icons</span>
                        </div>
                    </SgStack>
                </SgCard>
            </div>

            <div class="icon-grid">
                @foreach (var icon in _filteredIcons)
                {
                    <div class="icon-card" @onclick="() => CopyIconName(icon.Name)" title="Click to copy name">
                        <div class="icon-preview">
                            <SgHeroicon Name="@icon.Name" Variant="@_selectedVariant" Size="24px" />
                        </div>
                        <div class="icon-info">
                            <span class="icon-name">@icon.Name</span>
                            <span class="icon-pascal">@icon.PascalName</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (_copiedIcon is not null)
        {
            <div class="copy-toast">
                <SgIcon Icon="@SgIcons.Check" Size="14px" />
                <span>Copied: @_copiedIcon</span>
            </div>
        }
    </ChildContent>
</SgCard>

<style>
    .demo-controls-bar { margin-bottom: 24px; }
    
    .status-pill {
        display: flex; align-items: center; gap: 6px; padding: 6px 16px;
        background: var(--sg-bg-subtle); border: 1px solid var(--sg-border);
        border-radius: var(--sg-radius-full); height: 32px; margin-bottom: 4px;
    }
    .pill-label { font-size: 11px; font-weight: 600; color: var(--sg-fg-muted); text-transform: uppercase; }
    .pill-value { font-size: 14px; font-weight: 700; color: var(--sg-color-primary); }

    .icon-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
        gap: 12px;
    }

    .icon-card {
        display: flex; flex-direction: column; align-items: center; gap: 10px;
        padding: 16px 8px; background: var(--sg-bg); border: 1px solid var(--sg-border);
        border-radius: var(--sg-radius-md); cursor: pointer; transition: all 0.2s;
    }
    .icon-card:hover {
        border-color: var(--sg-color-primary);
        background: var(--sg-color-primary-subtle);
        transform: translateY(-2px);
        box-shadow: var(--sg-shadow-sm);
    }
    .icon-card:active { transform: translateY(0); }

    .icon-preview { color: var(--sg-fg); transition: transform 0.2s; }
    .icon-card:hover .icon-preview { transform: scale(1.2); color: var(--sg-color-primary); }

    .icon-info { display: flex; flex-direction: column; align-items: center; gap: 2px; width: 100%; overflow: hidden; }
    .icon-name { font-size: 11px; font-weight: 500; color: var(--sg-fg-subtle); text-align: center; width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .icon-pascal { font-size: 9px; color: var(--sg-fg-muted); opacity: 0.7; }

    .copy-toast {
        position: fixed; bottom: 32px; left: 50%; transform: translateX(-50%);
        background: var(--sg-fg); color: var(--sg-bg); padding: 10px 24px;
        border-radius: var(--sg-radius-full); font-size: 13px; font-weight: 500;
        display: flex; align-items: center; gap: 8px; z-index: 1000;
        box-shadow: var(--sg-shadow-lg); animation: slideUp 0.3s ease-out;
    }
    @@keyframes slideUp { from { transform: translate(-50%, 20px); opacity: 0; } to { transform: translate(-50%, 0); opacity: 1; } }
</style>

@code {
    private string _searchText = "";
    private string SearchText { get => _searchText; set { _searchText = value; UpdateFilteredIcons(); } }

    private string _selectedVariant = "Outline";
    private string? _copiedIcon;

    private readonly List<string> _variantOptions = new() { "Outline", "Solid", "Mini", "Micro" };
    private List<IconInfo> _allIcons = new();
    private List<IconInfo> _filteredIcons = new();

    protected override void OnInitialized()
    {
        var namesType = AppDomain.CurrentDomain.GetAssemblies()
            .Select(a => a.GetType("SuperUI.SgHeroicons+Names"))
            .FirstOrDefault(t => t is not null);

        if (namesType is null) return;

        _allIcons = namesType
            .GetFields(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Static)
            .Where(f => f.FieldType == typeof(string))
            .Select(f => new IconInfo { Name = (string)f.GetValue(null)!, PascalName = f.Name })
            .OrderBy(i => i.Name)
            .ToList();

        _filteredIcons = _allIcons;
    }

    private void UpdateFilteredIcons()
    {
        if (string.IsNullOrWhiteSpace(_searchText)) { _filteredIcons = _allIcons; }
        else {
            var st = _searchText.ToLowerInvariant();
            _filteredIcons = _allIcons.Where(i => i.Name.Contains(st) || i.PascalName.Contains(st, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private async Task CopyIconName(string name)
    {
        _copiedIcon = name;
        StateHasChanged();
        await Task.Delay(2000);
        _copiedIcon = null;
        StateHasChanged();
    }

    private class IconInfo { public string Name { get; set; } = ""; public string PascalName { get; set; } = ""; }
}