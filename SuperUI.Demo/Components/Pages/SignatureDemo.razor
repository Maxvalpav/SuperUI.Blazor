@page "/signature-demo"
@using SuperUI.Components

<PageTitle>Signature Pad - SUI</PageTitle>

<SgCard Title="SgSignaturePad - Панель подписи"
        Subtitle="Компонент для рисования и захвата рукописной подписи.">

    <div style="margin-top: 32px;">
        <h2>Базовое использование</h2>
        <p>Панель для подписи с кнопками копирования в буфер и сохранения в файл.</p>
        
        <div style="margin-top: 16px; display: flex; gap: 24px; align-items: flex-start;">
            <SgSignaturePad @ref="_pad1" Width="500px" Height="250px" PenColor="#1890ff" />
            
            <SgCard Title="Предварительный просмотр" Style="width: 300px;">
                <div style="border: 1px solid #eee; height: 150px; display: flex; align-items: center; justify-content: center; background: #fafafa;">
                    @if (!string.IsNullOrEmpty(_previewData))
                    {
                        <img src="@_previewData" style="max-width: 100%; max-height: 100%;" />
                    }
                    else
                    {
                        <span style="color: #999;">Нажмите "Обновить превью"</span>
                    }
                </div>
                <div style="margin-top: 12px;">
                    <SgButton Text="Обновить превью" OnClick="UpdatePreview" Size="SgSize.Sm" FullWidth="true" />
                </div>
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 48px;">
        <h2>В составе формы</h2>
        <div style="max-width: 500px; padding: 24px; border: 1px solid var(--sui-border-color); border-radius: 8px;">
            <div style="margin-bottom: 16px;">
                <label style="display: block; margin-bottom: 8px;">Ваше имя</label>
                <SgTextBox TValue="string" Placeholder="Введите имя" />
            </div>
            <div style="margin-bottom: 24px;">
                <label style="display: block; margin-bottom: 8px;">Ваша подпись</label>
                <SgSignaturePad Width="100%" Height="150px" />
            </div>
            <SgButton Text="Подписать документ" Variant="SgButtonVariant.Primary" FullWidth="true" />
        </div>
    </div>

</SgCard>

@code {
    private SgSignaturePad? _pad1;
    private string? _previewData;

    private async Task UpdatePreview()
    {
        if (_pad1 != null)
        {
            _previewData = await _pad1.GetImageAsync();
        }
    }
}
