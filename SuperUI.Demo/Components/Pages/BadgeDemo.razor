                            Ribbon & Block
                        </SgTypography>
                        <SgSpace>
                            <div style="position:relative;width:120px;height:80px;background:var(--sg-surface-alt);border:1px solid var(--sg-border);border-radius:6px;display:flex;align-items:center;justify-content:center;overflow:hidden;">
                                Ribbon
                                <SgBadge Text="Sale" Ribbon="true" Variant="SgBadgeVariant.Danger" />
                            </div>
                            <div style="position:relative;width:120px;height:80px;background:var(--sg-surface-alt);border:1px solid var(--sg-border);border-radius:6px;display:flex;align-items:center;justify-content:center;overflow:hidden;">
                                Ribbon
                                <SgBadge Text="New" Ribbon="true" Variant="SgBadgeVariant.Success" />
                            </div>
                        </SgSpace>
                        <SgSpace Style="margin-top:12px;">
                            <SgBadge Text="Block Badge" Block="true" Variant="SgBadgeVariant.Info">
