@page "/badge-demo"
@using SuperUI.Components

<PageTitle>SgBadge - Значки и метки</PageTitle>

<SgCard Title="SgBadge - Значки и метки"
        Subtitle="Компактные метки для отображения статусов, счетчиков, категорий и уведомлений.">

    <!-- 1. Базовые варианты -->
    <div style="margin-top: 32px;">
        <h2>1. Базовые варианты</h2>
        <p>Стандартные цветовые варианты бейджей для различных сценариев использования.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Стандартные варианты</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Default" />
                            <SgBadge Text="Success" Variant="SgBadgeVariant.Success" />
                            <SgBadge Text="Danger" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Text="Warn" Variant="SgBadgeVariant.Warn" />
                            <SgBadge Text="Muted" Variant="SgBadgeVariant.Muted" />
                            <SgBadge Text="Info" Variant="SgBadgeVariant.Info" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">С иконками</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Активен" Variant="SgBadgeVariant.Success"
                                     Icon="<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'></polyline></svg>" />
                            <SgBadge Text="Ошибка" Variant="SgBadgeVariant.Danger"
                                     Icon="<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><line x1='18' y1='6' x2='6' y2='18'></line><line x1='6' y1='6' x2='18' y2='18'></line></svg>" />
                            <SgBadge Text="Внимание" Variant="SgBadgeVariant.Warn"
                                     Icon="<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><path d='M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z'></path><line x1='12' y1='9' x2='12' y2='13'></line><line x1='12' y1='17' x2='12.01' y2='17'></line></svg>" />
                            <SgBadge Text="Информация" Variant="SgBadgeVariant.Info"
                                     Icon="<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'></circle><line x1='12' y1='16' x2='12' y2='12'></line><line x1='12' y1='8' x2='12.01' y2='8'></line></svg>" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Outlined стиль</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Default" Outlined="true" />
                            <SgBadge Text="Success" Variant="SgBadgeVariant.Success" Outlined="true" />
                            <SgBadge Text="Danger" Variant="SgBadgeVariant.Danger" Outlined="true" />
                            <SgBadge Text="Warn" Variant="SgBadgeVariant.Warn" Outlined="true" />
                            <SgBadge Text="Info" Variant="SgBadgeVariant.Info" Outlined="true" />
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_variantProps" />
            </SgCard>
        </div>
    </div>

    <!-- 2. Размеры -->
    <div style="margin-top: 32px;">
        <h2>2. Размеры</h2>
        <p>Четыре размера бейджей для различных контекстов использования.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Все размеры</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Small" Size="SgSize.Sm" Variant="SgBadgeVariant.Info" />
                            <SgBadge Text="Medium" Size="SgSize.Md" Variant="SgBadgeVariant.Info" />
                            <SgBadge Text="Large" Size="SgSize.Lg" Variant="SgBadgeVariant.Info" />
                            <SgBadge Text="Extra Large" Size="SgSize.Xl" Variant="SgBadgeVariant.Info" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Счетчики разных размеров</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Count="5" Size="SgSize.Sm" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Count="12" Size="SgSize.Md" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Count="99" Size="SgSize.Lg" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Count="150" Max="99" Size="SgSize.Xl" Variant="SgBadgeVariant.Danger" />
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_sizeProps" />
            </SgCard>
        </div>
    </div>

    <!-- 3. Счетчики -->
    <div style="margin-top: 32px;">
        <h2>3. Счетчики и числа</h2>
        <p>Отображение числовых значений с автоматическим форматированием.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Числовые значения</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Count="1" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Count="12" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Count="99" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Count="100" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Count="999" Max="99" Variant="SgBadgeVariant.Danger" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Интерактивный счетчик</div>
                        <div style="display: flex; gap: 12px; align-items: center;">
                            <SgButton Text="−" Size="SgSize.Sm" OnClick="@(() => _count = Math.Max(0, _count - 1))" />
                            <SgBadge Count="@_count" ShowZero="true" Variant="SgBadgeVariant.Info" />
                            <SgButton Text="+" Size="SgSize.Sm" OnClick="@(() => _count++)" />
                            <span style="font-size: 12px; color: var(--sui-text-muted);">Текущее значение: @_count</span>
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">ShowZero - отображение нуля</div>
                        <div style="display: flex; gap: 12px; align-items: center;">
                            <SgBadge Count="0" Variant="SgBadgeVariant.Danger" />
                            <span style="font-size: 12px; color: var(--sui-text-muted);">скрыт (по умолчанию)</span>
                            <SgBadge Count="0" ShowZero="true" Variant="SgBadgeVariant.Danger" />
                            <span style="font-size: 12px; color: var(--sui-text-muted);">ShowZero=true</span>
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_countProps" />
            </SgCard>
        </div>
    </div>

    <!-- 4. Dot и анимации -->
    <div style="margin-top: 32px;">
        <h2>4. Точки и анимации</h2>
        <p>Индикаторы состояния с анимацией для привлечения внимания.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Dot - точка без текста</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Dot="true" />
                            <SgBadge Dot="true" Variant="SgBadgeVariant.Success" />
                            <SgBadge Dot="true" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Dot="true" Variant="SgBadgeVariant.Warn" />
                            <SgBadge Dot="true" Variant="SgBadgeVariant.Info" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Pulse - пульсирующая анимация</div>
                        <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Новое" Pulse="true" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Dot="true" Pulse="true" Variant="SgBadgeVariant.Success" />
                            <SgBadge Count="3" Pulse="true" Variant="SgBadgeVariant.Info" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Processing - анимация загрузки</div>
                        <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Processing="true" />
                            <SgBadge Processing="true" Variant="SgBadgeVariant.Info" />
                            <SgBadge Processing="true" Variant="SgBadgeVariant.Success" />
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_animationProps" />
            </SgCard>
        </div>
    </div>

    <!-- 5. Overlay режим -->
    <div style="margin-top: 32px;">
        <h2>5. Overlay режим (обертка)</h2>
        <p>Бейдж как оверлей над другим контентом - для уведомлений на кнопках, аватарах и т.д.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">На кнопках</div>
                        <div style="display: flex; gap: 16px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Count="5" Variant="SgBadgeVariant.Danger">
                                <SgButton Text="Уведомления" />
                            </SgBadge>
                            <SgBadge Dot="true" Variant="SgBadgeVariant.Success">
                                <SgButton Text="Сообщения" Variant="SgButtonVariant.Primary" />
                            </SgBadge>
                            <SgBadge Count="99" Max="99" Variant="SgBadgeVariant.Info">
                                <SgIconButton Icon="@SgIcons.Settings" />
                            </SgBadge>
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Позиционирование</div>
                        <div style="display: flex; gap: 16px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Count="1" Placement="SgBadgePlacement.TopRight">
                                <div style="width: 48px; height: 48px; background: var(--sui-bg-secondary); border-radius: var(--sui-radius); display: flex; align-items: center; justify-content: center;">TR</div>
                            </SgBadge>
                            <SgBadge Count="2" Placement="SgBadgePlacement.TopLeft">
                                <div style="width: 48px; height: 48px; background: var(--sui-bg-secondary); border-radius: var(--sui-radius); display: flex; align-items: center; justify-content: center;">TL</div>
                            </SgBadge>
                            <SgBadge Count="3" Placement="SgBadgePlacement.BottomRight">
                                <div style="width: 48px; height: 48px; background: var(--sui-bg-secondary); border-radius: var(--sui-radius); display: flex; align-items: center; justify-content: center;">BR</div>
                            </SgBadge>
                            <SgBadge Count="4" Placement="SgBadgePlacement.BottomLeft">
                                <div style="width: 48px; height: 48px; background: var(--sui-bg-secondary); border-radius: var(--sui-radius); display: flex; align-items: center; justify-content: center;">BL</div>
                            </SgBadge>
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Смещение (Offset)</div>
                        <div style="display: flex; gap: 16px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Count="5" OffsetX="10" OffsetY="-10">
                                <SgButton Text="Offset X=10 Y=-10" />
                            </SgBadge>
                            <SgBadge Dot="true" OffsetX="-5" OffsetY="5" Variant="SgBadgeVariant.Success">
                                <SgButton Text="Offset X=-5 Y=5" />
                            </SgBadge>
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_overlayProps" />
            </SgCard>
        </div>
    </div>

    <!-- 6. Дополнительные возможности -->
    <div style="margin-top: 32px;">
        <h2>6. Дополнительные возможности</h2>
        <p>Кастомные цвета, квадратная форма и кликабельные бейджи.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Кастомные цвета</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Фиолетовый" Color="#7c3aed" />
                            <SgBadge Text="Оранжевый" Color="#ea580c" />
                            <SgBadge Text="Бирюзовый" Color="#0891b2" />
                            <SgBadge Text="Розовый" Color="#ec4899" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Square - квадратная форма</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Default" Square="true" />
                            <SgBadge Text="Success" Variant="SgBadgeVariant.Success" Square="true" />
                            <SgBadge Text="Danger" Variant="SgBadgeVariant.Danger" Square="true" />
                            <SgBadge Text="Info" Variant="SgBadgeVariant.Info" Square="true" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Кликабельные бейджи</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Кликни меня" Variant="SgBadgeVariant.Info" OnClick="@(() => _clickCount++)" />
                            <span style="font-size: 12px; color: var(--sui-text-muted);">Кликов: @_clickCount</span>
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_additionalProps" />
            </SgCard>
        </div>
    </div>

    <!-- 7. Практические примеры -->
    <div style="margin-top: 32px;">
        <h2>7. Практические примеры</h2>
        <p>Реальные сценарии использования бейджей в интерфейсе.</p>
        <SgCard Title="Примеры" Style="margin-top: 16px;">
            <div style="display: flex; flex-direction: column; gap: 24px;">
                <div>
                    <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Статусы задач</div>
                    <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                        <SgBadge Text="Новая" Variant="SgBadgeVariant.Info" />
                        <SgBadge Text="В работе" Variant="SgBadgeVariant.Warn" />
                        <SgBadge Text="Завершена" Variant="SgBadgeVariant.Success" />
                        <SgBadge Text="Отменена" Variant="SgBadgeVariant.Muted" />
                        <SgBadge Text="Просрочена" Variant="SgBadgeVariant.Danger" />
                    </div>
                </div>
                <SgDivider />
                <div>
                    <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Категории и теги</div>
                    <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                        <SgBadge Text="JavaScript" Color="#f7df1e" />
                        <SgBadge Text="C#" Color="#239120" />
                        <SgBadge Text="Python" Color="#3776ab" />
                        <SgBadge Text="React" Color="#61dafb" />
                        <SgBadge Text="Blazor" Color="#512bd4" />
                    </div>
                </div>
                <SgDivider />
                <div>
                    <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Навигация с счетчиками</div>
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        <div style="display: flex; align-items: center; gap: 8px; padding: 8px; border-radius: var(--sui-radius); background: var(--sui-bg-secondary);">
                            <span style="flex: 1;">Входящие</span>
                            <SgBadge Count="12" Variant="SgBadgeVariant.Danger" Size="SgSize.Sm" />
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px; padding: 8px; border-radius: var(--sui-radius); background: var(--sui-bg-secondary);">
                            <span style="flex: 1;">Черновики</span>
                            <SgBadge Count="3" Variant="SgBadgeVariant.Muted" Size="SgSize.Sm" />
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px; padding: 8px; border-radius: var(--sui-radius); background: var(--sui-bg-secondary);">
                            <span style="flex: 1;">Отправленные</span>
                            <SgBadge Count="45" Variant="SgBadgeVariant.Info" Size="SgSize.Sm" />
                        </div>
                    </div>
                </div>
            </div>
        </SgCard>
    </div>

</SgCard>

@code {
    private int _count = 5;
    private int _clickCount = 0;

    private List<PropertyPanelItem> _variantProps = new()
    {
        new() { Label = "Text", Value = "string", BadgeText = "Текст бейджа" },
        new() { Label = "Variant", Value = "SgBadgeVariant", BadgeText = "Цветовой вариант (Default, Success, Danger, Warn, Muted, Info)" },
        new() { Label = "Icon", Value = "string", BadgeText = "SVG иконка перед текстом" },
        new() { Label = "Outlined", Value = "bool", BadgeText = "Outlined стиль с белым фоном" },
    };

    private List<PropertyPanelItem> _sizeProps = new()
    {
        new() { Label = "Size", Value = "SgSize", BadgeText = "Размер бейджа (Sm, Md, Lg, Xl)" },
    };

    private List<PropertyPanelItem> _countProps = new()
    {
        new() { Label = "Count", Value = "int?", BadgeText = "Числовое значение для отображения" },
        new() { Label = "Max", Value = "int", BadgeText = "Максимальное значение перед показом 'Max+' (по умолчанию 99)" },
        new() { Label = "ShowZero", Value = "bool", BadgeText = "Показывать бейдж когда Count=0 (по умолчанию false)" },
    };

    private List<PropertyPanelItem> _animationProps = new()
    {
        new() { Label = "Dot", Value = "bool", BadgeText = "Отображать только точку без текста" },
        new() { Label = "Pulse", Value = "bool", BadgeText = "Пульсирующая анимация" },
        new() { Label = "Processing", Value = "bool", BadgeText = "Анимация загрузки (точка)" },
    };

    private List<PropertyPanelItem> _overlayProps = new()
    {
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Контент для обертки (бейдж будет оверлеем)" },
        new() { Label = "Placement", Value = "SgBadgePlacement", BadgeText = "Позиция (TopRight, TopLeft, BottomRight, BottomLeft)" },
        new() { Label = "OffsetX", Value = "int?", BadgeText = "Горизонтальное смещение в пикселях" },
        new() { Label = "OffsetY", Value = "int?", BadgeText = "Вертикальное смещение в пикселях" },
    };

    private List<PropertyPanelItem> _additionalProps = new()
    {
        new() { Label = "Color", Value = "string", BadgeText = "Кастомный цвет фона (любое CSS значение)" },
        new() { Label = "Square", Value = "bool", BadgeText = "Квадратная форма без скруглений" },
        new() { Label = "OnClick", Value = "EventCallback", BadgeText = "Обработчик клика (делает бейдж кликабельным)" },
        new() { Label = "Hidden", Value = "bool", BadgeText = "Скрыть бейдж" },
    };
}
