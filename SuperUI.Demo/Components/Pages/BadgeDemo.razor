                                    This card has a badge overlay with Block mode
                                </div>
                            </SgBadge>
                        </SgSpace>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Feature Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_additionalProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 8. Real-world Examples                                             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
