@page "/badge-demo"
@using SuperUI.Components

<PageTitle>Badge — SUI</PageTitle>

<SgCard Title="SgBadge — Значок"
        Subtitle="Универсальный компонент для меток, счётчиков, статусов и оверлеев. Три режима: standalone, wrapper (оверлей над контентом) и ribbon (угловая лента).">

    <!-- Варианты и размеры -->
    <div style="margin-top: 32px;">
        <h2>Варианты и размеры</h2>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Варианты</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Default" />
                            <SgBadge Text="Success" Variant="SgBadgeVariant.Success" />
                            <SgBadge Text="Danger"  Variant="SgBadgeVariant.Danger" />
                            <SgBadge Text="Warn"    Variant="SgBadgeVariant.Warn" />
                            <SgBadge Text="Muted"   Variant="SgBadgeVariant.Muted" />
                            <SgBadge Text="Info"    Variant="SgBadgeVariant.Info" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Outlined</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Default" Outlined="true" />
                            <SgBadge Text="Success" Variant="SgBadgeVariant.Success" Outlined="true" />
                            <SgBadge Text="Danger"  Variant="SgBadgeVariant.Danger"  Outlined="true" />
                            <SgBadge Text="Warn"    Variant="SgBadgeVariant.Warn"    Outlined="true" />
                            <SgBadge Text="Info"    Variant="SgBadgeVariant.Info"    Outlined="true" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Square (без скруглений)</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Default" Square="true" />
                            <SgBadge Text="Success" Variant="SgBadgeVariant.Success" Square="true" />
                            <SgBadge Text="Danger"  Variant="SgBadgeVariant.Danger"  Square="true" />
                            <SgBadge Text="Info"    Variant="SgBadgeVariant.Info"    Square="true" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Размеры</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Sm" Size="SgSize.Sm" Variant="SgBadgeVariant.Info" />
                            <SgBadge Text="Md" Size="SgSize.Md" Variant="SgBadgeVariant.Info" />
                            <SgBadge Text="Lg" Size="SgSize.Lg" Variant="SgBadgeVariant.Info" />
                            <SgBadge Text="Xl" Size="SgSize.Xl" Variant="SgBadgeVariant.Info" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Пользовательский цвет</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Фиолетовый" Color="#7c3aed" />
                            <SgBadge Text="Оранжевый"  Color="#ea580c" />
                            <SgBadge Text="Бирюзовый"  Color="#0891b2" />
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_variantProps" />
            </SgCard>
        </div>
    </div>

    <!-- Счётчик и числа -->
    <div style="margin-top: 32px;">
        <h2>Счётчик (Count)</h2>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Числовые значения</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Count="1"   Variant="SgBadgeVariant.Danger" />
                            <SgBadge Count="12"  Variant="SgBadgeVariant.Danger" />
                            <SgBadge Count="99"  Variant="SgBadgeVariant.Danger" />
                            <SgBadge Count="100" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Count="999" Max="99" Variant="SgBadgeVariant.Danger" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">ShowZero — показывать ноль</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Count="0" Variant="SgBadgeVariant.Danger" />
                            <span style="font-size: 12px; color: var(--sui-text-muted);">скрыт (по умолчанию)</span>
                            <SgBadge Count="0" ShowZero="true" Variant="SgBadgeVariant.Danger" />
                            <span style="font-size: 12px; color: var(--sui-text-muted);">ShowZero=true</span>
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Динамическое изменение</div>
                        <div style="display: flex; gap: 8px; align-items: center;">
                            <SgButton Text="−" Size="SgSize.Sm" OnClick="@(() => _count = Math.Max(0, _count - 1))" />
                            <SgBadge Count="@_count" ShowZero="true" Variant="SgBadgeVariant.Danger" />
                            <SgButton Text="+" Size="SgSize.Sm" OnClick="@(() => _count++)" />
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_countProps" />
            </SgCard>
        </div>
    </div>

    <!-- Dot, Pulse, Processing -->
    <div style="margin-top: 32px;">
        <h2>Dot, Pulse, Processing</h2>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Dot — точка без текста</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Dot="true" />
                            <SgBadge Dot="true" Variant="SgBadgeVariant.Success" />
                            <SgBadge Dot="true" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Dot="true" Variant="SgBadgeVariant.Warn" />
                            <SgBadge Dot="true" Variant="SgBadgeVariant.Info" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Pulse — пульсирующая анимация</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Новое" Pulse="true" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Dot="true"   Pulse="true" Variant="SgBadgeVariant.Success" />
                            <SgBadge Count="3"    Pulse="true" Variant="SgBadgeVariant.Info" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Processing — анимированная точка загрузки</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Processing="true" />
                            <SgBadge Processing="true" Variant="SgBadgeVariant.Info" />
                            <SgBadge Processing="true" Variant="SgBadgeVariant.Success" />
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_dotProps" />
            </SgCard>
        </div>
    </div>

    <!-- Иконка и кликабельный -->
    <div style="margin-top: 32px;">
        <h2>Иконка и кликабельный</h2>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">С иконкой (SVG строка)</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Активен"  Variant="SgBadgeVariant.Success"
                                     Icon="<svg width='10' height='10' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='3'><polyline points='20 6 9 17 4 12'/></svg>" />
                            <SgBadge Text="Ошибка"   Variant="SgBadgeVariant.Danger"
                                     Icon="<svg width='10' height='10' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='3'><line x1='18' y1='6' x2='6' y2='18'/><line x1='6' y1='6' x2='18' y2='18'/></svg>" />
                            <SgBadge Text="Внимание" Variant="SgBadgeVariant.Warn"
                                     Icon="<svg width='10' height='10' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5'><circle cx='12' cy='12' r='10'/><line x1='12' y1='8' x2='12' y2='12'/><line x1='12' y1='16' x2='12.01' y2='16'/></svg>" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Кликабельный (рендерится как button)</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Нажми" Variant="SgBadgeVariant.Info" OnClick="@(() => _clickCount++)" />
                            <SgBadge Text="@($"Нажато: {_clickCount}")" Variant="SgBadgeVariant.Success" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">InnerContent — произвольное содержимое</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Variant="SgBadgeVariant.Success"><InnerContent>✓ Активен</InnerContent></SgBadge>
                            <SgBadge Variant="SgBadgeVariant.Danger"><InnerContent>✗ Ошибка</InnerContent></SgBadge>
                            <SgBadge Variant="SgBadgeVariant.Warn"><InnerContent>⚠ Внимание</InnerContent></SgBadge>
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_iconProps" />
            </SgCard>
        </div>
    </div>

    <!-- Wrapper — оверлей над контентом -->
    <div style="margin-top: 32px;">
        <h2>Wrapper — оверлей над контентом</h2>
        <p>Когда передан <code>ChildContent</code>, бейдж позиционируется поверх дочернего элемента.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 20px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 12px;">Позиции (Placement)</div>
                        <div style="display: flex; gap: 32px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Count="5" Variant="SgBadgeVariant.Danger" Placement="SgBadgePlacement.TopRight">
                                <SgButton Text="TopRight" />
                            </SgBadge>
                            <SgBadge Count="5" Variant="SgBadgeVariant.Danger" Placement="SgBadgePlacement.TopLeft">
                                <SgButton Text="TopLeft" />
                            </SgBadge>
                            <SgBadge Count="5" Variant="SgBadgeVariant.Danger" Placement="SgBadgePlacement.BottomRight">
                                <SgButton Text="BottomRight" />
                            </SgBadge>
                            <SgBadge Count="5" Variant="SgBadgeVariant.Danger" Placement="SgBadgePlacement.BottomLeft">
                                <SgButton Text="BottomLeft" />
                            </SgBadge>
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 12px;">Dot-оверлей</div>
                        <div style="display: flex; gap: 32px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Dot="true" Variant="SgBadgeVariant.Danger">
                                <SgButton Text="Уведомления" />
                            </SgBadge>
                            <SgBadge Dot="true" Pulse="true" Variant="SgBadgeVariant.Success">
                                <SgButton Text="Онлайн" />
                            </SgBadge>
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 12px;">Hidden — скрыть бейдж</div>
                        <div style="display: flex; gap: 16px; align-items: center;">
                            <SgBadge Count="@_count" Variant="SgBadgeVariant.Danger" Hidden="@_hidden">
                                <SgButton Text="Сообщения" />
                            </SgBadge>
                            <SgButton Text="@(_hidden ? "Показать" : "Скрыть")" Size="SgSize.Sm"
                                      OnClick="@(() => _hidden = !_hidden)" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 12px;">OffsetX / OffsetY — смещение</div>
                        <div style="display: flex; gap: 32px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Count="9" Variant="SgBadgeVariant.Danger" OffsetX="-4" OffsetY="4">
                                <SgButton Text="Смещение" />
                            </SgBadge>
                            <SgBadge Count="9" Variant="SgBadgeVariant.Info" Color="#7c3aed">
                                <SgButton Text="Цвет" />
                            </SgBadge>
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_wrapperProps" />
            </SgCard>
        </div>
    </div>

    <!-- Ribbon -->
    <div style="margin-top: 32px;">
        <h2>Ribbon — угловая лента</h2>
        <p>Режим <code>Ribbon="true"</code> — баннер в углу позиционированного контейнера.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; gap: 16px; flex-wrap: wrap;">
                    <div style="position: relative; width: 140px; height: 90px; background: var(--sui-bg-secondary); border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); overflow: hidden; display: flex; align-items: center; justify-content: center; font-size: 12px; color: var(--sui-text-muted);">
                        Карточка
                        <SgBadge Text="Новое" Ribbon="true" Variant="SgBadgeVariant.Success" Placement="SgBadgePlacement.TopRight" />
                    </div>
                    <div style="position: relative; width: 140px; height: 90px; background: var(--sui-bg-secondary); border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); overflow: hidden; display: flex; align-items: center; justify-content: center; font-size: 12px; color: var(--sui-text-muted);">
                        Карточка
                        <SgBadge Text="Скидка" Ribbon="true" Variant="SgBadgeVariant.Danger" Placement="SgBadgePlacement.TopLeft" />
                    </div>
                    <div style="position: relative; width: 140px; height: 90px; background: var(--sui-bg-secondary); border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); overflow: hidden; display: flex; align-items: center; justify-content: center; font-size: 12px; color: var(--sui-text-muted);">
                        Карточка
                        <SgBadge Text="Beta" Ribbon="true" Variant="SgBadgeVariant.Info" Placement="SgBadgePlacement.TopRight" />
                    </div>
                    <div style="position: relative; width: 140px; height: 90px; background: var(--sui-bg-secondary); border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); overflow: hidden; display: flex; align-items: center; justify-content: center; font-size: 12px; color: var(--sui-text-muted);">
                        Карточка
                        <SgBadge Text="Sale" Ribbon="true" Color="#7c3aed" Placement="SgBadgePlacement.TopRight" />
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства">
                <PropertyTable Items="_ribbonProps" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private int _count = 5;
    private int _clickCount;
    private bool _hidden;

    private List<PropertyPanelItem> _variantProps = new()
    {
        new() { Label = "Text",      Value = "string",         BadgeText = "Текст",           BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Variant",   Value = "SgBadgeVariant", BadgeText = "Вариант",          BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Size",      Value = "SgSize",         BadgeText = "Размер",           BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Outlined",  Value = "bool",           BadgeText = "Без заливки",      BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Square",    Value = "bool",           BadgeText = "Без скруглений",   BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Color",     Value = "string",         BadgeText = "Цвет фона (CSS)",  BadgeVariant = SgBadgeVariant.Info },
    };

    private List<PropertyPanelItem> _countProps = new()
    {
        new() { Label = "Count",    Value = "int?",    BadgeText = "Число",           BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Max",      Value = "int (99)",BadgeText = "Макс. значение",  BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ShowZero", Value = "bool",    BadgeText = "Показывать 0",    BadgeVariant = SgBadgeVariant.Warn },
    };

    private List<PropertyPanelItem> _dotProps = new()
    {
        new() { Label = "Dot",        Value = "bool", BadgeText = "Точка",            BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Pulse",      Value = "bool", BadgeText = "Пульсация",        BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Processing", Value = "bool", BadgeText = "Анимация загрузки",BadgeVariant = SgBadgeVariant.Warn },
    };

    private List<PropertyPanelItem> _iconProps = new()
    {
        new() { Label = "Icon",         Value = "string (SVG)",   BadgeText = "Иконка",          BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "InnerContent", Value = "RenderFragment", BadgeText = "Произвольный HTML",BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "OnClick",      Value = "EventCallback",  BadgeText = "Кнопка",          BadgeVariant = SgBadgeVariant.Success },
    };

    private List<PropertyPanelItem> _wrapperProps = new()
    {
        new() { Label = "ChildContent", Value = "RenderFragment",    BadgeText = "Оборачиваемый контент", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Placement",    Value = "SgBadgePlacement",  BadgeText = "Позиция",               BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Hidden",       Value = "bool",              BadgeText = "Скрыть",                BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "OffsetX",      Value = "int?",              BadgeText = "Смещение X (px)",       BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "OffsetY",      Value = "int?",              BadgeText = "Смещение Y (px)",       BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Block",        Value = "bool",              BadgeText = "display:block обёртка", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Standalone",   Value = "bool",              BadgeText = "Принудит. standalone",  BadgeVariant = SgBadgeVariant.Warn },
    };

    private List<PropertyPanelItem> _ribbonProps = new()
    {
        new() { Label = "Ribbon",    Value = "bool",              BadgeText = "Угловая лента",  BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Placement", Value = "SgBadgePlacement",  BadgeText = "Угол",           BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Color",     Value = "string",            BadgeText = "Цвет ленты",     BadgeVariant = SgBadgeVariant.Info },
    };
}
