            </SgTypography>
        </div>

        <SgCard Title="Use Cases" Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgStack Vertical Space="SgSize.Lg">
                <div>
                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                        Task Statuses
                    </SgTypography>
                    <SgSpace>
                        <SgBadge Text="New" Variant="SgBadgeVariant.Info" />
                        <SgBadge Text="In Progress" Variant="SgBadgeVariant.Warn" />
                        <SgBadge Text="Completed" Variant="SgBadgeVariant.Success" />
                        <SgBadge Text="Cancelled" Variant="SgBadgeVariant.Muted" />
                        <SgBadge Text="Overdue" Variant="SgBadgeVariant.Danger" />
                    </SgSpace>
                </div>
                <div>
                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                        Technology Categories
                    </SgTypography>
                    <SgSpace>
                        <SgBadge Text="JavaScript" Color="#f7df1e" />
                        <SgBadge Text="C#" Color="#239120" />
                        <SgBadge Text="Python" Color="#3776ab" />
                        <SgBadge Text="React" Color="#61dafb" />
                        <SgBadge Text="Blazor" Color="#512bd4" />
                        <SgBadge Text="TypeScript" Color="#3178c6" />
                    </SgSpace>
                </div>
                <div>
                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                        Navigation with Counters
                    </SgTypography>
