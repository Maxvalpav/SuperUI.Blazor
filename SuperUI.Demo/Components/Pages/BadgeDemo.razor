@page "/badge-demo"
@using SuperUI.Components

<PageTitle>Значок - SUI</PageTitle>

<SgCard Title="SgBadge - Значок"
        Subtitle="Компонент для отображения значков и меток. Поддерживает различные цвета и стили.">

    <div style="margin-top: 32px;">
        <h2>Примеры использования</h2>
        <p>Интерактивные примеры значков с различными конфигурациями.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Варианты">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Все варианты</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Default" Variant="default" />
                            <SgBadge Text="Success" Variant="success" />
                            <SgBadge Text="Danger" Variant="danger" />
                            <SgBadge Text="Warn" Variant="warn" />
                            <SgBadge Text="Muted" Variant="muted" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Примеры использования</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Новое" Variant="success" />
                            <SgBadge Text="В разработке" Variant="warn" />
                            <SgBadge Text="Архив" Variant="muted" />
                            <SgBadge Text="Критично" Variant="danger" />
                            <SgBadge Text="Статус" Variant="default" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">С пользовательским содержимым</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Variant="success">
                                <span>✓ Активен</span>
                            </SgBadge>
                            <SgBadge Variant="danger">
                                <span>✗ Ошибка</span>
                            </SgBadge>
                            <SgBadge Variant="warn">
                                <span>⚠ Внимание</span>
                            </SgBadge>
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_badgeProperties" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private List<PropertyPanelItem> _badgeProperties = new()
    {
        new() { Label = "Text", Value = "string", BadgeText = "Текст", BadgeVariant = "info" },
        new() { Label = "Variant", Value = "default|success|danger|warn|muted", BadgeText = "Вариант", BadgeVariant = "info" },
        new() { Label = "AriaLabel", Value = "string", BadgeText = "Aria-метка", BadgeVariant = "info" },
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Содержимое", BadgeVariant = "info" }
    };
}
