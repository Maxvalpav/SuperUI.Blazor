        border: 1px solid var(--sg-border);
        border-radius: 6px;
        transition: background 0.15s;
    }
    .demo-nav-row:hover {
        background: color-mix(in srgb, var(--sg-primary) 6%, var(--sg-surface-alt));
    }

    .demo-inbox-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 6px;
        transition: background 0.15s;
    }
    .demo-inbox-row:hover {
        background: color-mix(in srgb, var(--sg-primary) 4%, var(--sg-surface-alt));
    }
</style>

