@page "/demo/badge"
@using SuperUI.Demo.Components

<div class="demo-page">
    <div class="demo-hero">
        <section class="demo-hero-main">
            <div class="demo-header">
                <div class="demo-kicker">Feedback Components</div>
                <h1 class="demo-title">SgBadge</h1>
                <p class="demo-subtitle">
                    Compact counter and status indicator for notifications, tags, states and decorated actions.
                    Supports overlay, standalone and ribbon presentations.
                </p>
            </div>
        </section>

        <aside class="demo-hero-side">
            <div class="demo-side-title">Highlights</div>
            <div class="demo-pill-list">
                <span class="demo-pill demo-pill-accent">Overlay</span>
                <span class="demo-pill">Standalone Tags</span>
                <span class="demo-pill">Pulse</span>
                <span class="demo-pill">Ribbon</span>
            </div>

            <div class="demo-meta-grid">
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Modes</span>
                    <span class="demo-meta-value">Wrapped, standalone, ribbon</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Signals</span>
                    <span class="demo-meta-value">Counters, statuses, unread markers</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Placement</span>
                    <span class="demo-meta-value">Top-right, top-left, bottom-right, bottom-left</span>
                </div>
            </div>
        </aside>
    </div>

    <SgDemoSection Eyebrow="Usage" Title="Examples" Description="Typical badge usage for notifications, labels and decorated surfaces.">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Wrapped Badges</h3>
                    <p class="demo-showcase-desc">Attach badge counters to buttons, icons and compact controls.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <div class="demo-row">
                            <SgBadge Count="5">
                                <SgButton Text="Messages" />
                            </SgBadge>

                            <SgBadge Count="100" Max="99">
                                <SgButton Text="Notifications" />
                            </SgBadge>

                            <SgBadge Dot="true" Variant="SgBadgeVariant.Danger">
                                <SgButton Variant="SgButtonVariant.Default">
                                    <Icon>
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                                    </Icon>
                                </SgButton>
                            </SgBadge>
                        </div>
                    </div>
                    <div class="demo-note">Use wrapped mode when the badge should decorate another control without changing that control’s content.</div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Standalone Tags</h3>
                    <p class="demo-showcase-desc">Inline labels for statuses, categories or short states.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <div class="demo-row">
                            <SgBadge Text="New" Variant="SgBadgeVariant.Success" Standalone="true" />
                            <SgBadge Text="Beta" Variant="SgBadgeVariant.Info" Standalone="true" />
                            <SgBadge Text="Critical" Variant="SgBadgeVariant.Danger" Standalone="true" />
                            <SgBadge Text="Archived" Variant="SgBadgeVariant.Muted" Standalone="true" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Special States</h3>
                    <p class="demo-showcase-desc">Animated badges attract attention without requiring extra layout.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <div class="demo-row">
                            <SgBadge Processing="true" Variant="SgBadgeVariant.Info" Standalone="true" Text="Processing..." />
                            <SgBadge Pulse="true" Count="1" Standalone="true" />
                            <SgBadge Dot="true" Variant="SgBadgeVariant.Success" Standalone="true" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Ribbon</h3>
                    <p class="demo-showcase-desc">Corner labels for featured or highlighted surfaces.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-preview-plain">
                        <div style="width:220px; height:120px; background:#f8fafc; position:relative; border:1px solid #dbe3ee; border-radius:14px; display:flex; align-items:center; justify-content:center; margin: 6px;">
                            <span class="demo-inline-value">Container</span>
                            <SgBadge Ribbon="true" Text="Featured" Variant="SgBadgeVariant.Danger" Placement="SgBadgePlacement.TopRight" />
                        </div>
                    </div>
                    <div class="demo-note">Ribbon mode works best on relatively positioned cards, media blocks and promo tiles.</div>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoParams Title="Badge Parameters" Description="Parameters for customizing the appearance and behavior of the SgBadge component.">
        <SgDemoParam Name="Count" Type="int?" Description="The numeric value to display." DefaultValue="null" />
        <SgDemoParam Name="Max" Type="int" Description="Maximum count value to show. Beyond this, a '+' is appended." DefaultValue="99" />
        <SgDemoParam Name="Text" Type="string" Description="Text to display instead of a numeric count." DefaultValue="null" />
        <SgDemoParam Name="Dot" Type="bool" Description="Whether to display as a small dot without text." DefaultValue="false" />
        <SgDemoParam Name="Pulse" Type="bool" Description="Whether to show a pulse animation." DefaultValue="false" />
        <SgDemoParam Name="Processing" Type="bool" Description="Whether to show a processing animation." DefaultValue="false" />
        <SgDemoParam Name="Standalone" Type="bool" Description="Whether the badge is used standalone (not wrapping content)." DefaultValue="false" />
        <SgDemoParam Name="Ribbon" Type="bool" Description="Whether the badge is displayed as a corner ribbon." DefaultValue="false" />
        <SgDemoParam Name="Variant" Type="SgBadgeVariant" Description="The semantic color of the badge." Values="Default, Success, Danger, Warn, Muted, Info" DefaultValue="Default" />
        <SgDemoParam Name="Size" Type="SgSize" Description="The size of the badge." Values="Sm, Md, Lg" DefaultValue="Md" />
        <SgDemoParam Name="Placement" Type="SgBadgePlacement" Description="The placement of the badge relative to the content." Values="TopRight, TopLeft, BottomRight, BottomLeft" DefaultValue="TopRight" />
        <SgDemoParam Name="Color" Type="string" Description="Custom background color for the badge." DefaultValue="null" />
        <SgDemoParam Name="Icon" Type="string" Description="Optional icon string to display." DefaultValue="null" />
        <SgDemoParam Name="ChildContent" Type="RenderFragment" Description="The content to be decorated by the badge." DefaultValue="null" />
    </SgDemoParams>
</div>
