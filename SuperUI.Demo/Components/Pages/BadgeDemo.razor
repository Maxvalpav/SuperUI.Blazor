@page "/badge-demo"
@using SuperUI.Components

<PageTitle>Значок — SUI</PageTitle>

<SgCard Title="SgBadge — Значок"
        Subtitle="Компонент для отображения значков и меток. Поддерживает различные цвета и стили через перечисление SgBadgeVariant.">

    <!-- Варианты -->
    <div style="margin-top: 32px;">
        <h2>Варианты (SgBadgeVariant)</h2>
        <p>Параметр <code>Variant</code> принимает строку или значение перечисления <code>SgBadgeVariant</code>.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Все варианты</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Default" Variant="SgBadgeVariant.Default" />
                            <SgBadge Text="Success" Variant="SgBadgeVariant.Success" />
                            <SgBadge Text="Danger"  Variant="SgBadgeVariant.Danger" />
                            <SgBadge Text="Warn"    Variant="SgBadgeVariant.Warn" />
                            <SgBadge Text="Muted"   Variant="SgBadgeVariant.Muted" />
                            <SgBadge Text="Info"    Variant="SgBadgeVariant.Info" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Реальные примеры</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Новое"       Variant="SgBadgeVariant.Success" />
                            <SgBadge Text="В разработке" Variant="SgBadgeVariant.Warn" />
                            <SgBadge Text="Архив"       Variant="SgBadgeVariant.Muted" />
                            <SgBadge Text="Критично"    Variant="SgBadgeVariant.Danger" />
                            <SgBadge Text="Статус"      Variant="SgBadgeVariant.Default" />
                            <SgBadge Text="Инфо"        Variant="SgBadgeVariant.Info" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">С пользовательским содержимым</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Variant="SgBadgeVariant.Success"><span>✓ Активен</span></SgBadge>
                            <SgBadge Variant="SgBadgeVariant.Danger"><span>✗ Ошибка</span></SgBadge>
                            <SgBadge Variant="SgBadgeVariant.Warn"><span>⚠ Внимание</span></SgBadge>
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_badgeProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Перечисление SgBadgeVariant -->
    <div style="margin-top: 32px;">
        <h2>Перечисление SgBadgeVariant</h2>
        <p>Используйте строковые значения или типизированный enum для параметра <code>Variant</code>.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Значения enum">
                <PropertyTable Items="_variantEnumValues" />
            </SgCard>

        </div>
    </div>

    <!-- Примеры кода -->
    <div style="margin-top: 32px;">
        <h2>Примеры кода</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">

        </div>
    </div>

</SgCard>

@code {
    private List<PropertyPanelItem> _badgeProperties = new()
    {
        new() { Label = "Text",         Value = "string",                              BadgeText = "Текст значка",    BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Variant",      Value = "default|success|danger|warn|muted|info", BadgeText = "Вариант (enum)", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "AriaLabel",    Value = "string",                              BadgeText = "Aria-метка",      BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ChildContent", Value = "RenderFragment",                      BadgeText = "Содержимое",      BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "CssClass",     Value = "string",                              BadgeText = "CSS класс",       BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Style",        Value = "string",                              BadgeText = "Inline стиль",    BadgeVariant = SgBadgeVariant.Info },
    };

    private List<PropertyPanelItem> _variantEnumValues = new()
    {
        new() { Label = "SgBadgeVariant.Default", Value = "\"default\"", BadgeText = "Нейтральный",  BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "SgBadgeVariant.Success", Value = "\"success\"", BadgeText = "Успех",        BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "SgBadgeVariant.Danger",  Value = "\"danger\"",  BadgeText = "Ошибка",       BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "SgBadgeVariant.Warn",    Value = "\"warn\"",    BadgeText = "Предупреждение", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "SgBadgeVariant.Muted",   Value = "\"muted\"",   BadgeText = "Приглушённый", BadgeVariant = SgBadgeVariant.Muted },
        new() { Label = "SgBadgeVariant.Info",    Value = "\"info\"",    BadgeText = "Информация",   BadgeVariant = SgBadgeVariant.Info },
    };
}
