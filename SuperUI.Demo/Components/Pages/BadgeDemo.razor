@page "/badge-demo"
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgBadge — Badges & Labels — SuperUI</PageTitle>

<SgSeoHead Description="Compact labels for statuses, counters, categories, notifications, and more. Supports dot mode, animations, overlay wrapping, and custom colors." />

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="SgBadge" Subtitle="Compact labels for statuses, counters, categories, notifications, and more. Supports dot mode, animations, overlay wrapping, and custom colors." Icon="SgHeroicons.Outline.Bell" GradientFrom="var(--sg-color-primary)" GradientTo="#a855f7" />
    </HeaderContent>
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Variants                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Variants
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                All available color variants for different contexts: default, success, danger, warning, muted, and info.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Solid Variants
                        </SgTypography>
                        <SgSpace>
                            <SgBadge Text="Default" />
                            <SgBadge Text="Success" Variant="SgBadgeVariant.Success" />
                            <SgBadge Text="Danger" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Text="Warn" Variant="SgBadgeVariant.Warn" />
                            <SgBadge Text="Muted" Variant="SgBadgeVariant.Muted" />
                            <SgBadge Text="Info" Variant="SgBadgeVariant.Info" />
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Outlined Variants
                        </SgTypography>
                        <SgSpace>
                            <SgBadge Text="Default" Outlined="true" />
                            <SgBadge Text="Success" Variant="SgBadgeVariant.Success" Outlined="true" />
                            <SgBadge Text="Danger" Variant="SgBadgeVariant.Danger" Outlined="true" />
                            <SgBadge Text="Warn" Variant="SgBadgeVariant.Warn" Outlined="true" />
                            <SgBadge Text="Muted" Variant="SgBadgeVariant.Muted" Outlined="true" />
                            <SgBadge Text="Info" Variant="SgBadgeVariant.Info" Outlined="true" />
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With Icons
                        </SgTypography>
                        <SgSpace>
                            <SgBadge Text="Success" Variant="SgBadgeVariant.Success" Icon="@SgHeroicons.Outline.Check" />
                            <SgBadge Text="Danger" Variant="SgBadgeVariant.Danger" Icon="@SgHeroicons.Outline.XMark" />
                            <SgBadge Text="Warn" Variant="SgBadgeVariant.Warn" Icon="@SgHeroicons.Outline.ExclamationTriangle" />
                            <SgBadge Text="Info" Variant="SgBadgeVariant.Info" Icon="@SgHeroicons.Outline.InformationCircle" />
                            <SgBadge Text="Default" Variant="SgBadgeVariant.Default" Icon="@SgHeroicons.Outline.Bell" />
                            <SgBadge Text="Muted" Variant="SgBadgeVariant.Muted" Icon="@SgHeroicons.Outline.Clock" />
                        </SgSpace>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Variant Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_variantProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Sizes                                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Sizes
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Four sizes — Sm, Md, Lg, Xl — for both text badges and numeric counters.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Text Badges
                        </SgTypography>
                        <SgSpace>
                            <SgBadge Text="Small" Size="SgSize.Sm" Variant="SgBadgeVariant.Info" />
                            <SgBadge Text="Medium" Size="SgSize.Md" Variant="SgBadgeVariant.Info" />
                            <SgBadge Text="Large" Size="SgSize.Lg" Variant="SgBadgeVariant.Info" />
                            <SgBadge Text="Extra Large" Size="SgSize.Xl" Variant="SgBadgeVariant.Info" />
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Count Badges
                        </SgTypography>
                        <SgSpace>
                            <SgBadge Count="5" Size="SgSize.Sm" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Count="12" Size="SgSize.Md" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Count="99" Size="SgSize.Lg" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Count="150" Max="99" Size="SgSize.Xl" Variant="SgBadgeVariant.Danger" />
                        </SgSpace>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Size Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_sizeProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Count & Numbers                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Count & Numbers
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Numeric counters with overflow handling, zero visibility control, and interactive example.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Count Values & Max Overflow
                        </SgTypography>
                        <SgSpace>
                            <SgBadge Count="1" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Count="12" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Count="99" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Count="100" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Count="999" Max="99" Variant="SgBadgeVariant.Danger" />
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            ShowZero — Display Zero
                        </SgTypography>
                        <SgSpace>
                            <SgBadge Count="0" Variant="SgBadgeVariant.Danger" />
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">hidden (default)</SgTypography>
                            <SgBadge Count="0" ShowZero="true" Variant="SgBadgeVariant.Danger" />
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">ShowZero=true</SgTypography>
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Interactive Counter
                        </SgTypography>
                        <SgSpace>
                            <SgButton Text="-" Size="SgSize.Sm" OnClick="@(() => _counter = Math.Max(0, _counter - 1))" />
                            <SgBadge Count="@_counter" ShowZero="true" Variant="SgBadgeVariant.Info" />
                            <SgButton Text="+" Size="SgSize.Sm" OnClick="@(() => _counter++)" />
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Value: @_counter</SgTypography>
                        </SgSpace>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Count Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_countProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Dot & Animations                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Dot & Animations
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Minimal dot indicators, pulsing attention grabbers, and processing spinners.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Dot Mode (All Variants)
                        </SgTypography>
                        <SgSpace>
                            <SgBadge Dot="true" />
                            <SgBadge Dot="true" Variant="SgBadgeVariant.Success" />
                            <SgBadge Dot="true" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Dot="true" Variant="SgBadgeVariant.Warn" />
                            <SgBadge Dot="true" Variant="SgBadgeVariant.Muted" />
                            <SgBadge Dot="true" Variant="SgBadgeVariant.Info" />
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Pulse Animation
                        </SgTypography>
                        <SgSpace>
                            <SgBadge Text="New" Pulse="true" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Dot="true" Pulse="true" Variant="SgBadgeVariant.Success" />
                            <SgBadge Count="3" Pulse="true" Variant="SgBadgeVariant.Info" />
                            <SgBadge Text="Alert" Pulse="true" Variant="SgBadgeVariant.Warn" />
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Processing Animation
                        </SgTypography>
                        <SgSpace>
                            <SgBadge Processing="true" />
                            <SgBadge Processing="true" Variant="SgBadgeVariant.Info" />
                            <SgBadge Processing="true" Variant="SgBadgeVariant.Success" />
                            <SgBadge Processing="true" Variant="SgBadgeVariant.Warn" />
                            <SgBadge Processing="true" Variant="SgBadgeVariant.Danger" />
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Ripple & Shine Effects
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgSpace>
                                <SgBadge Text="Ripple" BadgeAnimation="Enums.SgBadgeAnimation.Ripple" Variant="SgBadgeVariant.Danger" />
                                <SgBadge Text="Ripple" BadgeAnimation="Enums.SgBadgeAnimation.Ripple" Variant="SgBadgeVariant.Success" />
                                <SgBadge Text="Ripple" BadgeAnimation="Enums.SgBadgeAnimation.Ripple" Variant="SgBadgeVariant.Info" />
                                <SgBadge Dot="true" BadgeAnimation="Enums.SgBadgeAnimation.Ripple" Variant="SgBadgeVariant.Danger" />
                            </SgSpace>
                            <SgSpace>
                                <SgBadge Text="Shine" BadgeAnimation="Enums.SgBadgeAnimation.Shine" Variant="SgBadgeVariant.Warn" />
                                <SgBadge Text="Shine" BadgeAnimation="Enums.SgBadgeAnimation.Shine" Variant="SgBadgeVariant.Success" />
                                <SgBadge Text="Shine" BadgeAnimation="Enums.SgBadgeAnimation.Shine" Variant="SgBadgeVariant.Default" />
                                <SgBadge Text="Blink" BadgeAnimation="Enums.SgBadgeAnimation.Blink" Variant="SgBadgeVariant.Danger" />
                            </SgSpace>
                        </SgStack>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Animation Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_animationProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Overlay (Wrapper)                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Overlay (Wrapper)
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Badge as an overlay over buttons, icons, or any content. Supports all four corner placements and custom offset.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Over Badges on Buttons
                        </SgTypography>
                        <SgSpace>
                            <SgBadge Count="5" Variant="SgBadgeVariant.Danger">
                                <SgButton Text="Notifications" />
                            </SgBadge>
                            <SgBadge Dot="true" Variant="SgBadgeVariant.Success">
                                <SgButton Text="Messages" Variant="SgButtonVariant.Primary" />
                            </SgBadge>
                            <SgBadge Count="99" Max="99" Variant="SgBadgeVariant.Info">
                                <SgButton Text="Updates" Variant="SgButtonVariant.Outlined" />
                            </SgBadge>
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            All Four Placements
                        </SgTypography>
                        <SgSpace>
                            <SgBadge Count="1" Placement="SgBadgePlacement.TopRight">
                                <div class="demo-badge-box">TR</div>
                            </SgBadge>
                            <SgBadge Count="2" Placement="SgBadgePlacement.TopLeft">
                                <div class="demo-badge-box">TL</div>
                            </SgBadge>
                            <SgBadge Count="3" Placement="SgBadgePlacement.BottomRight">
                                <div class="demo-badge-box">BR</div>
                            </SgBadge>
                            <SgBadge Count="4" Placement="SgBadgePlacement.BottomLeft">
                                <div class="demo-badge-box">BL</div>
                            </SgBadge>
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            OffsetX / OffsetY
                        </SgTypography>
                        <SgSpace>
                            <SgBadge Count="5" OffsetX="10" OffsetY="-10">
                                <SgButton Text="Offset X=10 Y=-10" />
                            </SgBadge>
                            <SgBadge Dot="true" OffsetX="-5" OffsetY="5" Variant="SgBadgeVariant.Success">
                                <SgButton Text="Offset X=-5 Y=5" />
                            </SgBadge>
                        </SgSpace>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Overlay Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_overlayProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. Closable Badges                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Closable Badges
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Dismissible badges with close (×) button. Clicking hides the badge and fires the <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">OnClose</SgTypography> event.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            All Variants
                        </SgTypography>
                        <SgSpace>
                            <SgBadge Text="Default" Closable="true" />
                            <SgBadge Text="Success" Variant="SgBadgeVariant.Success" Closable="true" />
                            <SgBadge Text="Danger" Variant="SgBadgeVariant.Danger" Closable="true" />
                            <SgBadge Text="Warn" Variant="SgBadgeVariant.Warn" Closable="true" />
                            <SgBadge Text="Info" Variant="SgBadgeVariant.Info" Closable="true" />
                            <SgBadge Text="Muted" Variant="SgBadgeVariant.Muted" Closable="true" />
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With Count & Custom Colors
                        </SgTypography>
                        <SgSpace>
                            <SgBadge Count="7" Closable="true" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Text="Tag A" Closable="true" Color="#7c3aed" />
                            <SgBadge Text="Tag B" Closable="true" Color="#ea580c" TextColor="#fff" />
                            <SgBadge Text="Label" Closable="true" Color="#0891b2" Outlined="true" />
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With Click Handler
                        </SgTypography>
                        <SgSpace>
                            <SgBadge Text="Click Body" OnClick="@(() => _clickableDismissCount++)" Closable="true" Variant="SgBadgeVariant.Info" />
                            <SgBadge Text="Or Click ×" OnClick="@(() => _clickableDismissCount++)" Closable="true" Variant="SgBadgeVariant.Success" />
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Clicks: @_clickableDismissCount</SgTypography>
                        </SgSpace>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Closable Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_closableProps" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 7. Additional Features                                             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Additional Features
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Custom colors, text color, square shape, clickable badges, ribbon mode, and block display.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
