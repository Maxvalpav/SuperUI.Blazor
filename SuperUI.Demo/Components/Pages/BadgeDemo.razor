                            <SgBadge Text="Orange" Color="#ea580c" />
                            <SgBadge Text="Teal" Color="#0891b2" />
                            <SgBadge Text="Pink" Color="#ec4899" />
                            <SgBadge Text="Lime" Color="#65a30d" />
                            <SgBadge Text="Cyan" Color="#06b6d4" />
