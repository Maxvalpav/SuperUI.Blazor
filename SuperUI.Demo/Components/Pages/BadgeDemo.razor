    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 9. Live Constructor                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure parameters and see the badge render in real time. Copy the generated code.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Text -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Text</SgTypography>
                            <input type="text"
                                   class="demo-input"
                                   value="@_ctorText"
                                   @onchange="OnCtorTextChanged"
                                   placeholder="Badge text" />
                        </SgStack>

                        <!-- Variant -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Variant</SgTypography>
                            <SgSegmented TValue="SgBadgeVariant"
                                         Value="@_ctorVariant"
                                         ValueChanged="v => { _ctorVariant = v; UpdateCtorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_variantSegOptions" />
                        </SgStack>

                        <!-- Size -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                            <SgSegmented TValue="SgSize"
                                         Value="@_ctorSize"
                                         ValueChanged="v => { _ctorSize = v; UpdateCtorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_sizeSegOptions" />
                        </SgStack>

                        <!-- Toggles -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Outlined</SgTypography>
                                    <SgSwitch Value="@_ctorOutlined"
                                              ValueChanged="v => { _ctorOutlined = v; UpdateCtorCode(); }" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Square</SgTypography>
                                    <SgSwitch Value="@_ctorSquare"
                                              ValueChanged="v => { _ctorSquare = v; UpdateCtorCode(); }" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Dot</SgTypography>
                                    <SgSwitch Value="@_ctorDot"
                                              ValueChanged="v => { _ctorDot = v; UpdateCtorCode(); }" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Pulse</SgTypography>
                                    <SgSwitch Value="@_ctorPulse"
                                              ValueChanged="v => { _ctorPulse = v; UpdateCtorCode(); }" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Glow</SgTypography>
                                    <SgSwitch Value="@_ctorGlow"
                                              ValueChanged="v => { _ctorGlow = v; UpdateCtorCode(); }" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Closable</SgTypography>
                                    <SgSwitch Value="@_ctorClosable"
                                              ValueChanged="v => { _ctorClosable = v; UpdateCtorCode(); }" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Variant</SgTypography>
                                    <SgBadge Variant="@_ctorVariant" Text="@_ctorVariant.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorSize.ToString()" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <div class="constructor-preview">
                                <SgBadge Text="@_ctorText"
                                         Variant="@_ctorVariant"
                                         Size="@_ctorSize"
                                         Outlined="@_ctorOutlined"
                                         Square="@_ctorSquare"
                                         Dot="@_ctorDot"
                                         Pulse="@_ctorPulse"
                                         Glow="@_ctorGlow"
                                         Closable="@_ctorClosable" />
                            </div>
                        </SgStack>

                        <!-- Code with Copy -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyBadgeCode">
                                    <span id="copy-icon">@_ctorCopyIcon</span>
                                    <span id="copy-text" style="font-size:11px;font-weight:600;">@_ctorCopyLabel</span>
                                </button>
                            </div>
                            <div class="code-block" id="code-block">
                                @foreach (var line in _ctorCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 10. Properties                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                All SgBadge Properties
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Complete list of parameters available on the SgBadge component.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <PropertyTable Items="_allProps" />
        </SgCard>
    </div>

    </ChildContent>
</SgCard>

<style>
