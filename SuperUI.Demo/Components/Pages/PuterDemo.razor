@page "/puter-demo"
@using SuperUI.Components.Llm
@using SuperUI.Services.Llm
@inject SgPuterService PuterService
@inject IJSRuntime JS

<PageTitle>Puter.js Integration — SUI</PageTitle>

<div class="puter-demo-container">
    <div class="puter-demo-header">
        <SgTypography Variant="SgTypographyVariant.Heading3" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 12px; display: block;">☁️ Puter.js Cloud Wrapper</SgTypography>
        <p class="puter-demo-lead">Blazor-обертка для Puter.js с AI-чатом, KV-хранилищем и облачными возможностями.</p>
    </div>

    <div class="puter-demo-layout">
        <div class="puter-demo-main">
            <div class="puter-demo-chat-shell">
                <SgPuterChat />
            </div>
        </div>
        
        <aside class="puter-demo-info">
            <div class="puter-demo-card stats">
                <h4>Cloud Status</h4>
                <div class="status-item">
                    <span>Puter.js:</span>
                    <span class="badge @(_isAvailable ? "success" : "error")">@(_isAvailable ? "Available" : "Missing")</span>
                </div>
            </div>

            <div class="puter-demo-card">
                <h4>Available Features</h4>
                <div class="feature-list">
                <div class="feature-item">
                    <strong>🤖 AI & LLM</strong>
                    <p>Free access to GPT-4o-mini, text-to-image, and multimodal models.</p>
                </div>
                <div class="feature-item">
                    <strong>🔑 KV Store</strong>
                    <p>Persistent cloud-based key-value storage for user data.</p>
                </div>
                <div class="feature-item">
                    <strong>📂 File System</strong>
                    <p>Read/write files to the Puter.js cloud drive.</p>
                </div>
                <div class="feature-item">
                    <strong>👤 Auth</strong>
                    <p>Built-in authentication with Puter.js accounts.</p>
                </div>
                </div>
            </div>

            <div class="puter-demo-card">
                <h4>Quick Commands</h4>
                <code class="cmd">/img [prompt]</code>
                <code class="cmd">/kv_set [key] [val]</code>
                <code class="cmd">/kv_get [key]</code>
            </div>
        </aside>
    </div>
</div>

@code {
    private bool _isAvailable;

    protected override async Task OnInitializedAsync()
    {
        _isAvailable = await PuterService.IsAvailableAsync();
    }
}

<style>
    .puter-demo-container {
        padding: 24px 32px 40px;
        max-width: 1680px;
        margin: 0 auto;
    }

    .puter-demo-header {
        margin-bottom: 24px;
    }

    .puter-demo-header h1 {
        margin: 0 0 10px;
        font-size: clamp(28px, 3vw, 38px);
    }

    .puter-demo-lead {
        margin: 0;
        max-width: 760px;
        color: var(--sui-text-secondary, #6b7280);
        font-size: 15px;
        line-height: 1.6;
    }

    .puter-demo-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 340px;
        gap: 24px;
        align-items: stretch;
        min-height: calc(100vh - 210px);
    }

    .puter-demo-main {
        min-width: 0;
    }

    .puter-demo-chat-shell {
        height: 800px;
        background: linear-gradient(180deg, rgba(255,255,255,0.92), rgba(248,250,252,0.96));
        border-radius: 18px;
        padding: 0;
        overflow: hidden;
    }

    .puter-demo-info {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .feature-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .feature-item {
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(229, 231, 235, 0.9);
    }

    .feature-item:last-child {
        padding-bottom: 0;
        border-bottom: none;
    }

    .feature-item strong {
        display: block;
        font-size: 14px;
        margin-bottom: 4px;
    }

    .feature-item p {
        font-size: 13px;
        color: var(--sui-text-secondary, #6b7280);
        line-height: 1.55;
        margin: 0;
    }

    .puter-demo-card {
        padding: 20px;
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(229, 231, 235, 0.95);
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
    }

    .puter-demo-card h4 {
        margin: 0 0 14px;
        font-size: 16px;
    }

    .status-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 13px;
    }

    .badge {
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 600;
    }

    .badge.success { background: #dcfce7; color: #166534; }
    .badge.error { background: #fee2e2; color: #991b1b; }

    .cmd {
        display: block;
        background: #fff;
        padding: 8px 10px;
        border-radius: 8px;
        font-family: monospace;
        font-size: 12px;
        margin-bottom: 8px;
        border: 1px solid #e5e7eb;
    }

    .cmd:last-child {
        margin-bottom: 0;
    }

    @@media (max-width: 1100px) {
        .puter-demo-layout {
            grid-template-columns: 1fr;
            min-height: auto;
        }

        .puter-demo-chat-shell {
            min-height: 680px;
        }
    }

    @@media (max-width: 768px) {
        .puter-demo-container {
            padding: 16px;
        }

        .puter-demo-chat-shell {
            min-height: 620px;
        }
    }
</style>
