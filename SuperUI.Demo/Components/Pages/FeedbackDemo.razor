@page "/feedback-demo"
@using SuperUI.Components
@inject SgToastService Toasts

<PageTitle>Обратная связь и оверлеи - SUI</PageTitle>

<SgCard Title="Компоненты обратной связи"
        Subtitle="Компоненты для отображения сообщений, уведомлений и диалогов взаимодействия с пользователем.">

    <!-- SgToast -->
    <div style="margin-top: 32px;">
        <h2>SgToast - Всплывающие уведомления</h2>
        <p>Нажмите кнопку — появится тост-уведомление в углу экрана.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Варианты тостов">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">По типу</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <SgButton Text="✓ Успех" Variant="SgButtonVariant.Success" OnClick="@(() => Toasts.Success("Операция выполнена успешно", "Успех"))" />
                            <SgButton Text="✗ Ошибка" Variant="SgButtonVariant.Danger" OnClick="@(() => Toasts.Error("Не удалось выполнить операцию", "Ошибка"))" />
                            <SgButton Text="⚠ Предупреждение" Variant="SgButtonVariant.Default" OnClick="@(() => Toasts.Warn("Обратите внимание", "Предупреждение"))" />
                            <SgButton Text="ℹ Информация" Variant="SgButtonVariant.Outlined" OnClick="@(() => Toasts.Info("Доступна новая версия", "Информация"))" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Только сообщение (без заголовка)</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <SgButton Text="Сохранено" Size="SgSize.Sm" Variant="SgButtonVariant.Success" OnClick="@(() => Toasts.Success("Данные сохранены"))" />
                            <SgButton Text="Удалено" Size="SgSize.Sm" Variant="SgButtonVariant.Danger" OnClick="@(() => Toasts.Error("Запись удалена"))" />
                            <SgButton Text="Загрузка…" Size="SgSize.Sm" OnClick="@(() => Toasts.Info("Файл загружается"))" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Несколько подряд</div>
                        <SgButton Text="Показать 3 тоста" Variant="SgButtonVariant.Primary" OnClick="ShowMultiple" />
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства SgToastService">
                <PropertyTable Items="_toastProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgResult -->
    <div style="margin-top: 32px;">
        <h2>SgResult - Результат операции</h2>
        <p>Компонент для отображения итогового состояния операции.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 24px;">
                    <SgResult Status="SgResultStatus.Success" Title="Успешно!" SubTitle="Операция выполнена без ошибок." />
                    <SgResult Status="SgResultStatus.Error" Title="Ошибка" SubTitle="Что-то пошло не так. Попробуйте ещё раз." />
                    <SgResult Status="SgResultStatus.Info" Title="Информация" SubTitle="Дополнительные сведения об операции." />
                    <SgResult Status="SgResultStatus.Warning" Title="Предупреждение" SubTitle="Обратите внимание на это сообщение." />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_resultProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Примеры кода -->
    <div style="margin-top: 32px;">
        <h2>Примеры кода</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">

            <SgCard Title="SgToastPlacement — позиция контейнера">
                <PropertyTable Items="_toastPlacementEnum" />
            </SgCard>



            <SgCard Title="SgResult — перечисление SgResultStatus">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <PropertyTable Items="_resultStatusEnum" />
                </div>
            </SgCard>
        </div>
    </div>

</SgCard>





@code {
    private bool _showModal;
    private bool _showConfirm;
    private bool _showDrawerRight;
    private bool _showDrawerLeft;

    private void ConfirmAction()
    {
        _showConfirm = false;
        Toasts.Success("Действие подтверждено");
    }

    private void ShowMultiple()
    {
        Toasts.Info("Первое уведомление");
        Toasts.Success("Второе уведомление");
        Toasts.Warn("Третье уведомление");
    }

    private List<PropertyPanelItem> _toastProperties = new()
    {
        new() { Label = "Show(msg, title, variant)", Value = "void", BadgeText = "Показать тост",    BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Success(msg, title)",        Value = "void", BadgeText = "Успех",            BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Error(msg, title)",          Value = "void", BadgeText = "Ошибка",           BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "Warn(msg, title)",           Value = "void", BadgeText = "Предупреждение",   BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Info(msg, title)",           Value = "void", BadgeText = "Информация",       BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Dismiss(id)",                Value = "void", BadgeText = "Закрыть по ID",    BadgeVariant = SgBadgeVariant.Muted },
    };



    private List<PropertyPanelItem> _resultProperties = new()
    {
        new() { Label = "Status",       Value = "Success|Error|Info|Warning", BadgeText = "Статус",       BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Title",        Value = "string",                     BadgeText = "Заголовок",     BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SubTitle",     Value = "string",                     BadgeText = "Подзаголовок",  BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ExtraContent", Value = "RenderFragment",             BadgeText = "Доп. контент", BadgeVariant = SgBadgeVariant.Info },
    };

    // ── Enum tables ──────────────────────────────────────────────────────────
    private List<PropertyPanelItem> _resultStatusEnum = new()
    {
        new() { Label = "SgResultStatus.Success",  Value = "Status", BadgeText = "Успех",          BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "SgResultStatus.Error",    Value = "Status", BadgeText = "Ошибка",          BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "SgResultStatus.Info",     Value = "Status", BadgeText = "Информация",      BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgResultStatus.Warning",  Value = "Status", BadgeText = "Предупреждение",  BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "SgResultStatus.Status404",Value = "Status", BadgeText = "Страница 404",    BadgeVariant = SgBadgeVariant.Muted },
    };

    private List<PropertyPanelItem> _toastPlacementEnum = new()
    {
        new() { Label = "SgToastPlacement.TopRight",     Value = "Placement", BadgeText = "Верхний правый (по умолч.)", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "SgToastPlacement.TopLeft",      Value = "Placement", BadgeText = "Верхний левый",              BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgToastPlacement.TopCenter",    Value = "Placement", BadgeText = "Верхний центр",              BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgToastPlacement.BottomRight",  Value = "Placement", BadgeText = "Нижний правый",              BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgToastPlacement.BottomLeft",   Value = "Placement", BadgeText = "Нижний левый",               BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgToastPlacement.BottomCenter", Value = "Placement", BadgeText = "Нижний центр",               BadgeVariant = SgBadgeVariant.Info },
    };
}
