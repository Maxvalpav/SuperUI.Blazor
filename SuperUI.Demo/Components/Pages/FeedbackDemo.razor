@page "/feedback-demo"
@using SuperUI.Components
@inject SgToastService Toasts

<PageTitle>Обратная связь и оверлеи - SUI</PageTitle>

<SgCard Title="Компоненты обратной связи"
        Subtitle="Компоненты для отображения сообщений, уведомлений и диалогов взаимодействия с пользователем.">

    <!-- SgToast -->
    <div style="margin-top: 32px;">
        <h2>SgToast - Всплывающие уведомления</h2>
        <p>Нажмите кнопку — появится тост-уведомление в углу экрана.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Варианты тостов">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">По типу</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <SgButton Text="✓ Успех"        Variant="success"  OnClick="@(() => Toasts.Success("Операция выполнена успешно", "Успех"))" />
                            <SgButton Text="✗ Ошибка"       Variant="danger"   OnClick="@(() => Toasts.Error("Не удалось выполнить операцию", "Ошибка"))" />
                            <SgButton Text="⚠ Предупреждение" Variant="default" OnClick="@(() => Toasts.Warn("Обратите внимание", "Предупреждение"))" />
                            <SgButton Text="ℹ Информация"   Variant="outlined" OnClick="@(() => Toasts.Info("Доступна новая версия", "Информация"))" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Только сообщение (без заголовка)</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <SgButton Text="Сохранено"  Size="sm" Variant="success"  OnClick="@(() => Toasts.Success("Данные сохранены"))" />
                            <SgButton Text="Удалено"    Size="sm" Variant="danger"   OnClick="@(() => Toasts.Error("Запись удалена"))" />
                            <SgButton Text="Загрузка…"  Size="sm"                   OnClick="@(() => Toasts.Info("Файл загружается"))" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Несколько подряд</div>
                        <SgButton Text="Показать 3 тоста" Variant="primary" OnClick="ShowMultiple" />
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства SgToastService">
                <PropertyTable Items="_toastProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgAlert -->
    <div style="margin-top: 32px;">
        <h2>SgAlert - Встроенные уведомления</h2>
        <p>Статичные уведомления внутри страницы. Поддерживают закрытие, иконки и кнопки действий.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Варианты">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgAlert Variant="success" Title="Успешно"       Text="Данные сохранены успешно."                    Dismissible="true" />
                    <SgAlert Variant="info"    Title="Информация"    Text="Доступна новая версия компонентов."            Dismissible="true" />
                    <SgAlert Variant="warn"    Title="Предупреждение" Text="Это действие нельзя отменить."               Dismissible="true" />
                    <SgAlert Variant="danger"  Title="Ошибка"        Text="Не удалось подключиться к серверу."           Dismissible="true" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_alertProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgAlert — стили -->
    <div style="margin-top: 32px;">
        <h2>Стили отображения</h2>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgAlert Variant="info"    Title="Стандартный"      Text="С иконкой и отступами." />
                    <SgAlert Variant="info"    Title="Компактный"       Text="Меньше отступов."        Dense="true" />
                    <SgAlert Variant="warn"    Title="Без иконки"       Text="ShowIcon=false"          ShowIcon="false" />
                    <SgAlert Variant="success" Title="Кастомная иконка" Text="Используется эмодзи."    Icon="🎉" />
                </div>
            </SgCard>
            <SgCard Title="С кнопками действий">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgAlert Variant="warn" Title="Сессия истекает">
                        <ChildContent>
                            <p style="margin: 0 0 8px;">Ваша сессия истекает через 5 минут.</p>
                        </ChildContent>
                        <ActionsContent>
                            <div style="display: flex; gap: 8px;">
                                <SgButton Text="Продлить" Variant="primary" Size="sm"
                                          OnClick="@(() => Toasts.Success("Сессия продлена на 30 минут"))" />
                                <SgButton Text="Выйти" Size="sm"
                                          OnClick="@(() => Toasts.Info("Выход из системы"))" />
                            </div>
                        </ActionsContent>
                    </SgAlert>
                    <SgAlert Variant="danger" Title="Ошибки валидации">
                        <ChildContent>
                            <ul style="margin: 0; padding-left: 20px;">
                                <li>Поле «Email» обязательно</li>
                                <li>Пароль слишком короткий</li>
                            </ul>
                        </ChildContent>
                    </SgAlert>
                </div>
            </SgCard>
        </div>
    </div>

    <!-- SgModal -->
    <div style="margin-top: 32px;">
        <h2>SgModal - Модальное окно</h2>
        <p>Компонент для отображения модальных диалогов.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgButton Text="Открыть базовое окно"      Variant="primary" OnClick="@(() => _showModal = true)" />
                    <SgButton Text="Открыть окно подтверждения" Variant="danger"  OnClick="@(() => _showConfirm = true)" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_modalProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgDrawer -->
    <div style="margin-top: 32px;">
        <h2>SgDrawer - Боковая панель</h2>
        <p>Компонент для отображения боковой панели.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgButton Text="Открыть справа" Variant="primary" OnClick="@(() => _showDrawerRight = true)" />
                    <SgButton Text="Открыть слева"               OnClick="@(() => _showDrawerLeft = true)" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_drawerProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgProgress -->
    <div style="margin-top: 32px;">
        <h2>SgProgress - Прогресс</h2>
        <p>Компонент для отображения прогресса выполнения задачи.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgProgress Value="25"  ShowLabel="true" />
                    <SgProgress Value="50"  ShowLabel="true" />
                    <SgProgress Value="75"  ShowLabel="true" />
                    <SgProgress Value="100" ShowLabel="true" />
                    <SgProgress Indeterminate="true" />
                    <SgProgress Value="60" Striped="true"  ShowLabel="true" />
                    <SgProgress Value="60" Striped="true" Animated="true" ShowLabel="true" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_progressProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgSpinner -->
    <div style="margin-top: 32px;">
        <h2>SgSpinner - Индикатор загрузки</h2>
        <p>Компонент для отображения состояния загрузки.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; gap: 24px; align-items: center;">
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 8px;">
                        <SgSpinner Size="md" />
                        <span style="font-size: 12px; color: var(--sui-text-muted);">md</span>
                    </div>
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 8px;">
                        <SgSpinner Size="lg" />
                        <span style="font-size: 12px; color: var(--sui-text-muted);">lg</span>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_spinnerProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgResult -->
    <div style="margin-top: 32px;">
        <h2>SgResult - Результат операции</h2>
        <p>Компонент для отображения итогового состояния операции.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 24px;">
                    <SgResult Status="SgResult.SgResultStatus.Success" Title="Успешно!"        SubTitle="Операция выполнена без ошибок." />
                    <SgResult Status="SgResult.SgResultStatus.Error"   Title="Ошибка"          SubTitle="Что-то пошло не так. Попробуйте ещё раз." />
                    <SgResult Status="SgResult.SgResultStatus.Info"    Title="Информация"      SubTitle="Дополнительные сведения об операции." />
                    <SgResult Status="SgResult.SgResultStatus.Warning" Title="Предупреждение"  SubTitle="Обратите внимание на это сообщение." />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_resultProperties" />
            </SgCard>
        </div>
    </div>

</SgCard>

<!-- Модальные окна -->
<SgModal @bind-Visible="@_showModal" Title="Базовое окно">
    <ChildContent>
        <p>Это содержимое модального окна. Вы можете добавить любой контент здесь.</p>
        <SgAlert Variant="info" Text="Модальное окно поддерживает любой HTML-контент." />
    </ChildContent>
    <FooterContent>
        <SgButton Text="Закрыть" OnClick="@(() => _showModal = false)" />
    </FooterContent>
</SgModal>

<SgModal @bind-Visible="@_showConfirm" Title="Подтверждение">
    <ChildContent>
        <SgAlert Variant="danger" Text="Вы уверены, что хотите выполнить это действие? Его нельзя отменить." />
    </ChildContent>
    <FooterContent>
        <SgButton Text="Подтвердить" Variant="danger"  OnClick="ConfirmAction" />
        <SgButton Text="Отмена"                        OnClick="@(() => _showConfirm = false)" />
    </FooterContent>
</SgModal>

<!-- Боковые панели -->
<SgDrawer @bind-Visible="@_showDrawerRight" Title="Панель справа" Placement="right">
    <ChildContent>
        <p>Содержимое боковой панели справа.</p>
        <div style="margin-top: 16px;">
            <SgButton Text="Закрыть" OnClick="@(() => _showDrawerRight = false)" Block="true" />
        </div>
    </ChildContent>
</SgDrawer>

<SgDrawer @bind-Visible="@_showDrawerLeft" Title="Панель слева" Placement="left">
    <ChildContent>
        <p>Содержимое боковой панели слева.</p>
        <div style="margin-top: 16px;">
            <SgButton Text="Закрыть" OnClick="@(() => _showDrawerLeft = false)" Block="true" />
        </div>
    </ChildContent>
</SgDrawer>

@code {
    private bool _showModal;
    private bool _showConfirm;
    private bool _showDrawerRight;
    private bool _showDrawerLeft;

    private void ConfirmAction()
    {
        _showConfirm = false;
        Toasts.Success("Действие подтверждено");
    }

    private void ShowMultiple()
    {
        Toasts.Info("Первое уведомление");
        Toasts.Success("Второе уведомление");
        Toasts.Warn("Третье уведомление");
    }

    private List<PropertyPanelItem> _toastProperties = new()
    {
        new() { Label = "Show(msg, title, variant)", Value = "void", BadgeText = "Показать тост",    BadgeVariant = "info" },
        new() { Label = "Success(msg, title)",        Value = "void", BadgeText = "Успех",            BadgeVariant = "success" },
        new() { Label = "Error(msg, title)",          Value = "void", BadgeText = "Ошибка",           BadgeVariant = "danger" },
        new() { Label = "Warn(msg, title)",           Value = "void", BadgeText = "Предупреждение",   BadgeVariant = "warn" },
        new() { Label = "Info(msg, title)",           Value = "void", BadgeText = "Информация",       BadgeVariant = "info" },
        new() { Label = "Dismiss(id)",                Value = "void", BadgeText = "Закрыть по ID",    BadgeVariant = "muted" },
    };

    private List<PropertyPanelItem> _alertProperties = new()
    {
        new() { Label = "Variant",    Value = "info|success|warn|danger", BadgeText = "Тип",              BadgeVariant = "info" },
        new() { Label = "Title",      Value = "string",                   BadgeText = "Заголовок",         BadgeVariant = "info" },
        new() { Label = "Text",       Value = "string",                   BadgeText = "Сообщение",         BadgeVariant = "info" },
        new() { Label = "Dismissible",Value = "bool",                     BadgeText = "Закрываемый",       BadgeVariant = "warn" },
        new() { Label = "ShowIcon",   Value = "bool",                     BadgeText = "Показать иконку",   BadgeVariant = "warn" },
        new() { Label = "Icon",       Value = "string",                   BadgeText = "Кастомная иконка",  BadgeVariant = "info" },
        new() { Label = "Dense",      Value = "bool",                     BadgeText = "Компактный",        BadgeVariant = "warn" },
        new() { Label = "ActionsContent", Value = "RenderFragment",       BadgeText = "Кнопки действий",  BadgeVariant = "info" },
        new() { Label = "OnClose",    Value = "EventCallback",            BadgeText = "Событие закрытия", BadgeVariant = "success" },
    };

    private List<PropertyPanelItem> _modalProperties = new()
    {
        new() { Label = "Visible",         Value = "bool",               BadgeText = "Видимо",           BadgeVariant = "warn" },
        new() { Label = "Title",           Value = "string",             BadgeText = "Заголовок",         BadgeVariant = "info" },
        new() { Label = "Width",           Value = "string",             BadgeText = "Ширина",            BadgeVariant = "info" },
        new() { Label = "ShowClose",       Value = "bool",               BadgeText = "Кнопка закрытия",  BadgeVariant = "warn" },
        new() { Label = "CloseOnBackdrop", Value = "bool",               BadgeText = "Закрыть по фону",  BadgeVariant = "warn" },
        new() { Label = "Animation",       Value = "scale|fade|slide",   BadgeText = "Анимация",          BadgeVariant = "info" },
        new() { Label = "VisibleChanged",  Value = "EventCallback<bool>",BadgeText = "Событие",          BadgeVariant = "success" },
    };

    private List<PropertyPanelItem> _drawerProperties = new()
    {
        new() { Label = "Visible",    Value = "bool",                    BadgeText = "Видимо",           BadgeVariant = "warn" },
        new() { Label = "Title",      Value = "string",                  BadgeText = "Заголовок",         BadgeVariant = "info" },
        new() { Label = "Placement",  Value = "right|left|top|bottom",   BadgeText = "Позиция",           BadgeVariant = "info" },
        new() { Label = "Size",       Value = "string",                  BadgeText = "Размер",            BadgeVariant = "info" },
        new() { Label = "Resizable",  Value = "bool",                    BadgeText = "Изменяемый размер", BadgeVariant = "warn" },
        new() { Label = "VisibleChanged", Value = "EventCallback<bool>", BadgeText = "Событие",          BadgeVariant = "success" },
    };

    private List<PropertyPanelItem> _progressProperties = new()
    {
        new() { Label = "Value",         Value = "double", BadgeText = "Значение (0–100)",  BadgeVariant = "info" },
        new() { Label = "Max",           Value = "double", BadgeText = "Максимум",           BadgeVariant = "info" },
        new() { Label = "ShowLabel",     Value = "bool",   BadgeText = "Показать %",         BadgeVariant = "warn" },
        new() { Label = "Indeterminate", Value = "bool",   BadgeText = "Неопределённый",     BadgeVariant = "warn" },
        new() { Label = "Striped",       Value = "bool",   BadgeText = "Полосатый",          BadgeVariant = "warn" },
        new() { Label = "Animated",      Value = "bool",   BadgeText = "Анимированный",      BadgeVariant = "warn" },
    };

    private List<PropertyPanelItem> _spinnerProperties = new()
    {
        new() { Label = "Size",  Value = "md|lg",  BadgeText = "Размер",    BadgeVariant = "info" },
        new() { Label = "Label", Value = "string", BadgeText = "Aria-метка", BadgeVariant = "info" },
    };

    private List<PropertyPanelItem> _resultProperties = new()
    {
        new() { Label = "Status",       Value = "Success|Error|Info|Warning", BadgeText = "Статус",       BadgeVariant = "info" },
        new() { Label = "Title",        Value = "string",                     BadgeText = "Заголовок",     BadgeVariant = "info" },
        new() { Label = "SubTitle",     Value = "string",                     BadgeText = "Подзаголовок",  BadgeVariant = "info" },
        new() { Label = "ExtraContent", Value = "RenderFragment",             BadgeText = "Доп. контент", BadgeVariant = "info" },
    };
}
