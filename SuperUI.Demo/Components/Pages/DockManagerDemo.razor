@page "/dock-manager-demo"
@using SuperUI.Components

<PageTitle>DockManager - SUI</PageTitle>

<SgCard Title="SgDockManager — IDE-style Dock Layout"
        Subtitle="Панели с вкладками, разделители с перетаскиванием, боковые и нижняя панели. Стиль Visual Studio / VS Code.">

    <div style="margin-top: 24px;">
        <h2>Декларативный конструктор</h2>
        <p>Вы можете определять панели прямо в Razor-разметке с помощью компонента <code>SgDockPane</code>.</p>
        
        <div style="height: 300px; border: 1px solid var(--sui-border); border-radius: 8px; overflow: hidden;">
            <SgDockManager EnableConstructor="true">
                <SgDockPane Title="Проект" Position="SgDockPosition.Left" Icon="@SgIcons.FileText">
                    <div style="padding: 16px;">Дерево файлов (из разметки)</div>
                </SgDockPane>
                <SgDockPane Title="Редактор" Position="SgDockPosition.Center">
                    <div style="padding: 16px;">
                        <h3>Добро пожаловать!</h3>
                        <p>Эта панель создана декларативно.</p>
                    </div>
                </SgDockPane>
                <SgDockPane Title="Логи" Position="SgDockPosition.Bottom">
                    <div style="padding: 8px; font-family: monospace; font-size: 12px;">
                        [10:00:01] System started...<br/>
                        [10:00:05] SgDockPane registered.
                    </div>
                </SgDockPane>
            </SgDockManager>
        </div>
    </div>

    <div style="margin-top: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <h2 style="margin: 0;">Интерактивный бизнес-сценарий</h2>
            <div style="display: flex; gap: 8px;">
                <SgButton Text="IDE Workspace" Variant="@(_currentScenario == "IDE" ? SgButtonVariant.Primary : SgButtonVariant.Outlined)" 
                          Size="SgSize.Sm" OnClick="@(() => SetScenario("IDE"))" />
                <SgButton Text="ERP/CRM Workspace" Variant="@(_currentScenario == "CRM" ? SgButtonVariant.Primary : SgButtonVariant.Outlined)" 
                          Size="SgSize.Sm" OnClick="@(() => SetScenario("CRM"))" />
            </div>
        </div>

        <p>
            @( _currentScenario == "IDE" 
                ? "Сценарий среды разработки: проводник файлов, редакторы кода и терминал." 
                : "Сценарий управления клиентами: карточки контрагентов, история заказов и аналитика продаж." )
        </p>
        
        <div style="margin-bottom: 12px; display: flex; align-items: center; gap: 12px;">
            <SgCheckBox @bind-Value="_designerMode" Label="Режим дизайна" />
            <SgButton Text="Сбросить макет" Size="SgSize.Sm" OnClick="ResetLayout" />
        </div>

        <div style="height: 580px; border: 1px solid var(--sui-border); border-radius: 8px; overflow: hidden;">
            <SgDockManager @bind-Panels="_panels" EnableConstructor="true" DesignerMode="_designerMode">
                <PanelTemplate>
                    @if (_currentScenario == "IDE")
                    {
                        @RenderIDEPane(context)
                    }
                    else
                    {
                        @RenderCRMPane(context)
                    }
                </PanelTemplate>
            </SgDockManager>
        </div>
    </div>

    <div style="margin-top: 32px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
        <SgCard Title="Параметры SgDockManager">
            <PropertyTable Items="_props" />
        </SgCard>
        <SgCard Title="SgDockPanel">
            <PropertyTable Items="_panelProps" />
        </SgCard>
    </div>

</SgCard>

@code {
    private string _currentScenario = "IDE";
    private SgDockPanel? _activePanel;
    private bool _designerMode = false;

    private List<SgDockPanel> _panels = new();

    protected override void OnInitialized()
    {
        SetScenario("IDE");
    }

    private void SetScenario(string scenario)
    {
        _currentScenario = scenario;
        ResetLayout();
    }

    private void ResetLayout()
    {
        if (_currentScenario == "IDE")
        {
            _panels = new()
            {
                SgDockPanel.Create("Explorer").WithId("explorer").WithIcon(SgIcons.FileText).At(SgDockPosition.Left).Closable(false).Build(),
                SgDockPanel.Create("Search").WithId("search").WithIcon(SgIcons.Search).At(SgDockPosition.Left).Build(),
                SgDockPanel.Create("Program.cs").WithId("editor1").WithIcon(SgIcons.FileText).At(SgDockPosition.Center).Build(),
                SgDockPanel.Create("SgButton.cs").WithId("editor2").WithIcon(SgIcons.FileText).At(SgDockPosition.Center).Build(),
                SgDockPanel.Create("Output").WithId("output").WithIcon(SgIcons.BarChart).At(SgDockPosition.Bottom).Closable(false).Build(),
                SgDockPanel.Create("Terminal").WithId("terminal").WithIcon(SgIcons.Database).At(SgDockPosition.Bottom).Build(),
                SgDockPanel.Create("Properties").WithId("properties").WithIcon(SgIcons.Settings).At(SgDockPosition.Right).Build(),
            };
        }
        else
        {
            _panels = new()
            {
                SgDockPanel.Create("Клиенты").WithId("crm-clients").WithIcon(SgIcons.MessageSquare).At(SgDockPosition.Left).Closable(false).Build(),
                SgDockPanel.Create("Профиль: ООО 'Вектор'").WithId("crm-profile").WithIcon(SgIcons.Edit).At(SgDockPosition.Center).Build(),
                SgDockPanel.Create("Заказы").WithId("crm-orders").WithIcon(SgIcons.BarChart).At(SgDockPosition.Center).Build(),
                SgDockPanel.Create("Статистика продаж").WithId("crm-stats").WithIcon(SgIcons.TrendingUp).At(SgDockPosition.Right).Build(),
                SgDockPanel.Create("Задачи").WithId("crm-tasks").WithIcon(SgIcons.Clock).At(SgDockPosition.Bottom).Build(),
            };
        }
    }

    // ── IDE Rendering ──

    private RenderFragment RenderIDEPane(SgDockPanel context) => __builder =>
    {
        if (context.Id == "explorer")
        {
            <div style="height: 100%; display: flex; flex-direction: column;">
                <div style="padding: 8px; border-bottom: 1px solid var(--sui-border); display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--sui-muted);">Files</span>
                    <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="AddRandomFile">
                        <Icon>@((MarkupString)SgIcons.Plus)</Icon>
                    </SgButton>
                </div>
                <div style="flex: 1; overflow-y: auto; padding: 4px;">
                    @foreach (var file in _files)
                    {
                        <div style="padding: 4px 8px; cursor: pointer; border-radius: 4px; font-size: 13px; display: flex; align-items: center; gap: 8px;" 
                             class="sui-hover-bg" @onclick="() => OpenFile(file)">
                            <span style="color: var(--sui-muted)">@((MarkupString)file.Icon)</span>
                            @file.Name
                        </div>
                    }
                </div>
            </div>
        }
        else if (context.Id == "search")
        {
            <div style="padding: 16px;">
                <input type="text" placeholder="Search..." style="width:100%; padding:4px 8px; border:1px solid var(--sui-border); border-radius:var(--sui-radius); font-size:12px; background:var(--sui-bg-primary); color:var(--sui-fg); outline:none; box-sizing:border-box;" />
                <div style="margin-top: 12px; font-size: 12px; color: var(--sui-muted);">No results found.</div>
            </div>
        }
        else if (context.Id.StartsWith("editor"))
        {
            <div style="padding: 24px; height: 100%; background: var(--sui-bg-secondary);">
                <div style="font-family: monospace; white-space: pre; font-size: 14px; line-height: 1.6;">
<span style="color: #569cd6">using</span> System;
<span style="color: #569cd6">using</span> SuperUI.Components;

<span style="color: #569cd6">namespace</span> App;

<span style="color: #569cd6">public class</span> <span style="color: #4ec9b0">@context.Title.Replace(".", "_")</span> 
{
    <span style="color: #6a9955">// Content for @context.Title</span>
    <span style="color: #569cd6">public void</span> <span style="color: #dcdcaa">Init</span>() 
    {
        Console.WriteLine(<span style="color: #ce9178">"Hello from @context.Title"</span>);
    }
}
                </div>
            </div>
        }
        else
        {
            @RenderDefaultPane(context)
        }
    };

    // ── CRM Rendering ──

    private RenderFragment RenderCRMPane(SgDockPanel context) => __builder =>
    {
        if (context.Id == "crm-clients")
        {
            <div style="height: 100%; display: flex; flex-direction: column;">
                <div style="padding: 12px; border-bottom: 1px solid var(--sui-border);">
                    <input type="text" placeholder="Поиск клиента..." style="width:100%; padding:6px 10px; border:1px solid var(--sui-border); border-radius:12px; font-size:13px; background:var(--sui-bg-secondary); color:var(--sui-fg); outline:none; box-sizing:border-box;" />
                </div>
                <div style="flex: 1; overflow-y: auto; padding: 4px;">
                    @foreach (var client in _clients)
                    {
                        <div style="padding: 10px 12px; cursor: pointer; border-radius: 8px; margin-bottom: 2px; transition: 0.2s;" 
                             class="sui-hover-bg" @onclick="@(() => SelectClient(client))">
                            <div style="font-weight: 600; font-size: 14px; color: @(client.IsActive ? "var(--sui-fg)" : "var(--sui-muted)")">@client.Name</div>
                            <div style="font-size: 12px; color: var(--sui-muted); display: flex; justify-content: space-between;">
                                <span>@client.Industry</span>
                                <span>@client.Revenue.ToString("N0") ₽</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (context.Id == "crm-profile")
        {
            <div style="padding: 24px; max-width: 600px;">
                <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px;">
                    <div style="width: 64px; height: 64px; background: var(--sui-accent); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 24px; color: white; font-weight: bold;">
                        @_selectedClient.Name[0]
                    </div>
                    <div>
                        <h3 style="margin: 0; font-size: 20px;">@_selectedClient.Name</h3>
                        <div style="color: var(--sui-muted); font-size: 14px;">ИНН: @_selectedClient.Inn | КПП: @_selectedClient.Kpp</div>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px;">
                    <div style="padding: 12px; background: var(--sui-bg-secondary); border-radius: 12px;">
                        <div style="font-size: 11px; color: var(--sui-muted); text-transform: uppercase;">Статус</div>
                        <div style="font-weight: 600; color: var(--sui-success);">Активен</div>
                    </div>
                    <div style="padding: 12px; background: var(--sui-bg-secondary); border-radius: 12px;">
                        <div style="font-size: 11px; color: var(--sui-muted); text-transform: uppercase;">Ответственный</div>
                        <div style="font-weight: 600;">Иван Иванов</div>
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgTextBox Label="Контактное лицо" @bind-Value="_selectedClient.Contact" TValue="string" />
                    <SgTextBox Label="Email" @bind-Value="_selectedClient.Email" TValue="string" />
                    <SgTextBox Label="Телефон" @bind-Value="_selectedClient.Phone" TValue="string" />
                </div>
            </div>
        }
        else if (context.Id == "crm-orders")
        {
            <div style="padding: 16px;">
                <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                    <thead>
                        <tr style="border-bottom: 2px solid var(--sui-border); color: var(--sui-muted);">
                            <th style="padding: 10px; text-align: left;">№ Заказа</th>
                            <th style="padding: 10px; text-align: left;">Дата</th>
                            <th style="padding: 10px; text-align: right;">Сумма</th>
                            <th style="padding: 10px; text-align: center;">Статус</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in _orders)
                        {
                            <tr style="border-bottom: 1px solid var(--sui-border);">
                                <td style="padding: 10px; font-weight: 600;">@order.Number</td>
                                <td style="padding: 10px; color: var(--sui-muted);">@order.Date.ToShortDateString()</td>
                                <td style="padding: 10px; text-align: right;">@order.Amount.ToString("N2") ₽</td>
                                <td style="padding: 10px; text-align: center;">
                                    <SgBadge Text="@order.Status" Variant="@(order.Status == "Оплачен" ? SgBadgeVariant.Success : SgBadgeVariant.Warn)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (context.Id == "crm-stats")
        {
            <div style="padding: 16px;">
                <div style="margin-bottom: 20px;">
                    <div style="font-size: 12px; color: var(--sui-muted); margin-bottom: 8px;">Воронка продаж</div>
                    <div style="height: 12px; background: var(--sui-bg-secondary); border-radius: 6px; overflow: hidden; display: flex;">
                        <div style="width: 45%; background: var(--sui-accent);"></div>
                        <div style="width: 25%; background: var(--sui-success);"></div>
                        <div style="width: 20%; background: var(--sui-warn);"></div>
                    </div>
                </div>
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgStatistic Title="Всего сделок" Value="142" TrendValue="0.15" />
                    <SgStatistic Title="Средний чек" Value="45 200 ₽" TrendValue="-0.05" />
                    <SgStatistic Title="Конверсия" Value="12.4%" TrendValue="0.02" />
                </div>
            </div>
        }
        else if (context.Id == "crm-tasks")
        {
            <div style="padding: 12px;">
                @foreach (var task in _crmTasks)
                {
                    <div style="display: flex; align-items: flex-start; gap: 12px; padding: 8px; border-bottom: 1px solid var(--sui-border);">
                        <SgCheckBox @bind-Value="task.IsDone" />
                        <div style="flex: 1;">
                            <div style="font-size: 13px; font-weight: 600; @(task.IsDone ? "text-decoration: line-through; color: var(--sui-muted);" : "")">@task.Title</div>
                            <div style="font-size: 11px; color: var(--sui-muted);">Срок: @task.DueDate.ToShortDateString()</div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            @RenderDefaultPane(context)
        }
    };

    private RenderFragment RenderDefaultPane(SgDockPanel context) => __builder =>
    {
        <div style="padding: 24px; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: var(--sui-muted);">
            <div style="font-size: 32px; margin-bottom: 12px;">@((MarkupString)(context.Icon ?? SgIcons.FileText))</div>
            <div>@context.Title</div>
            <div style="font-size: 12px; margin-top: 8px; opacity: 0.7;">ID: @context.Id</div>
        </div>
    };

    // ── CRM Data & Logic ──

    private record Client(string Name, string Industry, decimal Revenue, string Inn, string Kpp, bool IsActive = true)
    {
        public string Contact { get; set; } = "Александр Петров";
        public string Email { get; set; } = "contact@vector.ru";
        public string Phone { get; set; } = "+7 (999) 123-45-67";
    }

    private record Order(string Number, DateTime Date, decimal Amount, string Status);
    private class CRMTask { public string Title { get; set; } = ""; public DateTime DueDate { get; set; } = DateTime.Now.AddDays(1); public bool IsDone { get; set; } }

    private List<Client> _clients = new()
    {
        new("ООО 'Вектор'", "Производство", 12500000, "7701234567", "770101001"),
        new("ИП Сидоров", "Ритейл", 450000, "5001987654", "500101001"),
        new("АО 'ТехноПром'", "IT-услуги", 89000000, "7810112233", "781001001"),
        new("ООО 'Альфа'", "Логистика", 3200000, "7704556677", "770401001", false),
    };

    private List<Order> _orders = new()
    {
        new("INV-2024-001", DateTime.Now.AddDays(-5), 15400.50m, "Оплачен"),
        new("INV-2024-002", DateTime.Now.AddDays(-2), 8900.00m, "Ожидание"),
        new("INV-2024-003", DateTime.Now.AddDays(-1), 42300.00m, "Оплачен"),
    };

    private List<CRMTask> _crmTasks = new()
    {
        new() { Title = "Позвонить по новому заказу", DueDate = DateTime.Now },
        new() { Title = "Подготовить договор", DueDate = DateTime.Now.AddDays(2) },
        new() { Title = "Отправить счет на оплату", DueDate = DateTime.Now.AddDays(1) },
    };

    private Client _selectedClient = new("ООО 'Вектор'", "Производство", 12500000, "7701234567", "770101001");

    private void SelectClient(Client client)
    {
        _selectedClient = client;
        var profile = _panels.FirstOrDefault(p => p.Id == "crm-profile");
        if (profile != null) profile.Title = $"Профиль: {client.Name}";
        StateHasChanged();
    }

    // ── IDE Data & Logic ──

    private record FileEntry(string Name, string Icon, int Indent);
    private List<FileEntry> _files = new()
    {
        new("SuperUI",          "📁", 0),
        new("Components",       "📁", 1),
        new("SgButton.cs",      "📄", 2),
        new("SgCard.razor",     "📄", 2),
        new("SgDockManager.razor","📄",2),
        new("wwwroot",          "📁", 1),
        new("superui-theme.css","📄", 2),
        new("README.md",        "📄", 0),
    };

    private void AddRandomFile()
    {
        var names = new[] { "App.razor", "Layout.razor", "Main.razor", "Theme.razor" };
        var name = names[Random.Shared.Next(names.Length)];
        _files.Add(new FileEntry(name, "📄", 1));
    }

    private void OpenFile(FileEntry f)
    {
        if (f.Name.EndsWith(".cs") || f.Name.EndsWith(".razor") || f.Name.EndsWith(".md"))
        {
            var existing = _panels.FirstOrDefault(p => p.Title == f.Name && p.Position == SgDockPosition.Center);
            if (existing != null)
            {
                existing.Visible = true;
            }
            else
            {
                _panels.Add(SgDockPanel.Create(f.Name)
                    .WithIcon(SgIcons.FileText)
                    .At(SgDockPosition.Center)
                    .Build());
            }
            StateHasChanged();
        }
    }

    private List<PropertyPanelItem> _props = new()
    {
        new() { Label = "Panels",             Value = "List<SgDockPanel>",          BadgeText = "Панели",          BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "PanelsChanged",      Value = "EventCallback<List>",        BadgeText = "Изменение",       BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "PanelTemplate",      Value = "RenderFragment<SgDockPanel>",BadgeText = "Контент",         BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "ToolbarContent",     Value = "RenderFragment",             BadgeText = "Тулбар",          BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "StatusBarContent",   Value = "RenderFragment",             BadgeText = "Статус-бар",      BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "LeftSize",           Value = "double (default 220)",       BadgeText = "Ширина левой",    BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "RightSize",          Value = "double (default 240)",       BadgeText = "Ширина правой",   BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "BottomSize",         Value = "double (default 180)",       BadgeText = "Высота нижней",   BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "MinSideSize",        Value = "double (default 80)",        BadgeText = "Минимум",         BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "ActivePanelChanged", Value = "EventCallback<SgDockPanel>", BadgeText = "Активная панель", BadgeVariant = SgBadgeVariant.Success },
    };

    private List<PropertyPanelItem> _panelProps = new()
    {
        new() { Label = "Id",       Value = "string",          BadgeText = "Уникальный ID",  BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Title",    Value = "string",          BadgeText = "Заголовок вкладки", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Icon",     Value = "string? (SVG)",   BadgeText = "Иконка",         BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Position", Value = "SgDockPosition",  BadgeText = "Left/Right/Bottom/Center", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Closable", Value = "bool (default true)", BadgeText = "Кнопка ×",   BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Visible",  Value = "bool (default true)", BadgeText = "Видимость",  BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Tag",      Value = "object?",         BadgeText = "Данные",         BadgeVariant = SgBadgeVariant.Info },
    };
}
