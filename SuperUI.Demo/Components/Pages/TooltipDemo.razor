@code {
    // ── Main card header ─────────────────────────────────────────────────
    private RenderFragment _mainHeader => __builder =>
    {
        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
            
            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">SgTooltip</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Contextual tooltip with rich content, arrows, color variants, 12 placements, size variants, cursor following, interactive content, and configurable delays/offset.
                </SgTypography>
            </SgStack>
        </SgStack>
    };

    // ── Placement groups ────────────────────────────────────────────────
    private List<PlacementGroup> _placementGroups => new()
    {
        new("Top", new[] { (SgPlacement.Top, "Top"), (SgPlacement.TopStart, "TopStart"), (SgPlacement.TopEnd, "TopEnd") }),
        new("Bottom", new[] { (SgPlacement.Bottom, "Bottom"), (SgPlacement.BottomStart, "BottomStart"), (SgPlacement.BottomEnd, "BottomEnd") }),
        new("Left", new[] { (SgPlacement.Left, "Left"), (SgPlacement.LeftStart, "LeftStart"), (SgPlacement.LeftEnd, "LeftEnd") }),
        new("Right", new[] { (SgPlacement.Right, "Right"), (SgPlacement.RightStart, "RightStart"), (SgPlacement.RightEnd, "RightEnd") }),
    };

    // ── Size variants ─────────────────────────────────────────────────
    private record SizeItem(string Label, SgSize? Value);
    private List<SizeItem> _sizeVariants => new()
    {
        new("Sm", SgSize.Sm), new("Md", SgSize.Md), new("Lg", SgSize.Lg), new("Xl", SgSize.Xl),
    };

    // ── Constructor state ─────────────────────────────────────────────────
    private string _ctorText = "Hello, I'm a tooltip!";
    private SgPlacement _ctorPlacement = SgPlacement.Top;
    private SgTrigger _ctorTrigger = SgTrigger.Hover;
    private int _ctorOpenDelay;
    private int _ctorCloseDelay;
    private bool _ctorShowArrow = true;
    private bool _ctorDisabled;
    private string _ctorColor = "";
    private string _ctorMaxWidth = "";
    private SgSize? _ctorSize;
    private int _ctorOffset = 8;
    private bool _ctorFollowCursor;
    private bool _ctorInteractive;

    private string[] _generatedCodeLines = Array.Empty<string>();
    private string _copyIcon = "📋";
    private string _copyLabel = "Copy";

    // ── Manual tooltip state ──────────────────────────────────────────────
    private SgTooltip? _manualTooltip;
    private string _manualButtonLabel = "Show tooltip";

    private async Task ToggleManualTooltipAsync()
    {
        if (_manualTooltip is null) return;
        if (_manualTooltip.Visible)
        {
            await _manualTooltip.HideAsync();
            _manualButtonLabel = "Show tooltip";
        }
        else
        {
            await _manualTooltip.ShowAsync();
            _manualButtonLabel = "Hide tooltip";
        }
    }

    // ── All enum values ───────────────────────────────────────────────────
    private readonly List<SgPlacement> _allPlacements = Enum.GetValues<SgPlacement>().ToList();
    private readonly List<SgTrigger> _allTriggers = Enum.GetValues<SgTrigger>().ToList();
    private readonly List<SgSize?> _allSizeOptions = new() { null, SgSize.Sm, SgSize.Md, SgSize.Lg, SgSize.Xl };
    private static readonly Func<SgSize?, string> _sizeLabelSelector = x => x?.ToString() ?? "Default";

    // ── Segmented options ─────────────────────────────────────────────────
    private readonly List<SgSegmentedOption<bool>> _boolSegOptions = new()
    {
        new() { Value = false, Label = "Off" },
        new() { Value = true,  Label = "On" },
    };

    private readonly List<SgSegmentedOption<bool>> _boolSegOptions2 = new()
    {
        new() { Value = true,  Label = "On" },
        new() { Value = false, Label = "Off" },
    };

    private readonly List<SgSegmentedOption<string>> _colorSegOptions = new()
    {
        new() { Value = "", Label = "Default" },
        new() { Value = "var(--sg-color-info)", Label = "Info" },
        new() { Value = "var(--sg-color-success)", Label = "Success" },
        new() { Value = "var(--sg-color-warning)", Label = "Warning" },
        new() { Value = "var(--sg-color-danger)", Label = "Error" },
        new() { Value = "#1e293b", Label = "Dark" },
    };

    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add($"<SgTooltip Text=\"{_ctorText}\"");

        if (_ctorPlacement != SgPlacement.Top)
            lines.Add($"          Placement=\"SgPlacement.{_ctorPlacement}\"");
        if (_ctorTrigger != SgTrigger.Hover)
            lines.Add($"          Trigger=\"SgTrigger.{_ctorTrigger}\"");
        if (_ctorOpenDelay > 0)
            lines.Add($"          OpenDelay=\"{_ctorOpenDelay}\"");
        if (_ctorCloseDelay > 0)
            lines.Add($"          CloseDelay=\"{_ctorCloseDelay}\"");
        if (_ctorShowArrow)
            lines.Add($"          ShowArrow=\"true\"");
        if (_ctorDisabled)
            lines.Add($"          Disabled=\"true\"");
        if (!string.IsNullOrEmpty(_ctorColor))
            lines.Add($"          Color=\"{_ctorColor}\"");
        if (!string.IsNullOrEmpty(_ctorMaxWidth))
            lines.Add($"          MaxWidth=\"{_ctorMaxWidth}\"");
        if (_ctorSize.HasValue)
            lines.Add($"          Size=\"SgSize.{_ctorSize.Value}\"");
        if (_ctorOffset != 8)
            lines.Add($"          Offset=\"{_ctorOffset}\"");
        if (_ctorFollowCursor)
            lines.Add($"          FollowCursor=\"true\"");
        if (_ctorInteractive)
            lines.Add($"          Interactive=\"true\"");

        lines.Add($"          >");
        lines.Add($"    <SgButton Variant=\"SgButtonVariant.Primary\">Hover me</SgButton>");
        lines.Add($"</SgTooltip>");

        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

    // ── Property tables ───────────────────────────────────────────────────
    private List<PropertyPanelItem> _tooltipProperties = new()
    {
        new() { Label = "Text", Value = "string", BadgeText = "Required", BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "Placement", Value = "SgPlacement (12)", BadgeText = "", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Trigger", Value = "SgTrigger (4)", BadgeText = "", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "OpenDelay", Value = "int (ms)", BadgeText = "", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "CloseDelay", Value = "int (ms)", BadgeText = "", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Disabled", Value = "bool", BadgeText = "", BadgeVariant = SgBadgeVariant.Default },
