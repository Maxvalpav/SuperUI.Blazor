@page "/tooltip-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgTooltip — Tooltip — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Basic Examples                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Basic Usage
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Hover, focus, or click trigger elements to reveal tooltips.
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Text</SgTypography> sets the label,
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Placement</SgTypography> controls position.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Buttons &amp; Icons" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;">
                            Action Buttons
                        </SgTypography>
                        <SgSpace>
                            <SgTooltip Text="Save changes">
                                <SgButton Variant="SgButtonVariant.Primary" Size="SgSize.Sm">
                                    <ChildContent>
                                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                            <SgHeroicon Name="SgHeroicons.Names.Check" Size="14px" />
                                            <span>Save</span>
                                        </SgStack>
                                    </ChildContent>
                                </SgButton>
                            </SgTooltip>
                            <SgTooltip Text="Discard unsaved changes">
                                <SgButton Variant="SgButtonVariant.Outlined" Size="SgSize.Sm">Cancel</SgButton>
                            </SgTooltip>
                            <SgTooltip Text="Permanently delete this item">
                                <SgButton Variant="SgButtonVariant.Danger" Size="SgSize.Sm">Delete</SgButton>
                            </SgTooltip>
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;">
                            Icon Buttons
                        </SgTypography>
                        <SgSpace>
                            <SgTooltip Text="Settings">
                                <SgButton Variant="SgButtonVariant.Ghost" Size="SgSize.Sm">
                                    <SgHeroicon Name="SgHeroicons.Names.Cog6Tooth" Size="16px" />
                                </SgButton>
                            </SgTooltip>
                            <SgTooltip Text="Notifications (3 new)">
                                <SgButton Variant="SgButtonVariant.Ghost" Size="SgSize.Sm">
                                    <SgHeroicon Name="SgHeroicons.Names.Bell" Size="16px" />
                                </SgButton>
                            </SgTooltip>
                            <SgTooltip Text="User profile and account settings">
                                <SgButton Variant="SgButtonVariant.Ghost" Size="SgSize.Sm">
                                    <SgHeroicon Name="SgHeroicons.Names.UserCircle" Size="16px" />
                                </SgButton>
                            </SgTooltip>
                            <SgTooltip Text="Help &amp; documentation">
                                <SgButton Variant="SgButtonVariant.Ghost" Size="SgSize.Sm">
                                    <SgHeroicon Name="SgHeroicons.Names.QuestionMarkCircle" Size="16px" />
                                </SgButton>
                            </SgTooltip>
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;">
                            Inline Text
                        </SgTypography>
                        <span>
                            Learn more about our
                            <SgTooltip Text="SuperUI is a Blazor component library with 90+ components for data grids, charts, forms, and more." MaxWidth="260px" Placement="SgPlacement.Top">
                                <span style="border-bottom:1px dashed var(--sg-text-muted);cursor:help;color:var(--sg-primary);">
                                    component library
                                </span>
                            </SgTooltip>
                            and explore the live demos.
                        </span>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="SgTooltip Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_tooltipProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Placement Examples                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Placement — All 12 Positions
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Placement</SgTypography> controls where the tooltip appears relative to the trigger.
                Extended variants (<SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">TopStart</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">BottomEnd</SgTypography>, etc.) align the tooltip edge with the trigger.
            </SgTypography>
        </div>

        <SgCard Title="Placement Variants" Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgStack Vertical Space="SgSize.Lg">
                @foreach (var group in _placementGroups)
                {
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            @group.Label
                        </SgTypography>
                        <SgSpace Wrap="true">
                            @foreach (var p in group.Items)
                            {
                                <SgTooltip Text="@($"Placement: {p.Value}")" Placement="@p.Value" ShowArrow="true">
                                    <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined">@p.Label</SgButton>
                                </SgTooltip>
                            }
                        </SgSpace>
                    </div>
                }
            </SgStack>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Triggers                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Trigger Modes
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Trigger</SgTypography> controls the interaction that shows/hides the tooltip:
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Hover</SgTypography> (default), <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Focus</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Click</SgTypography>, or <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Manual</SgTypography>.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Trigger Behaviors" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgRow Space="SgSize.Lg">
                        <SgCol Span="6">
                            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Hover</SgTypography>
                                <SgTooltip Text="I appear on hover" Trigger="SgTrigger.Hover">
                                    <SgButton Size="SgSize.Sm">Hover me</SgButton>
                                </SgTooltip>
                            </SgStack>
                        </SgCol>
                        <SgCol Span="6">
                            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Focus</SgTypography>
                                <SgTooltip Text="I appear on focus" Trigger="SgTrigger.Focus">
                                    <SgButton Size="SgSize.Sm">Focus me</SgButton>
                                </SgTooltip>
                            </SgStack>
                        </SgCol>
                        <SgCol Span="6">
                            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Click</SgTypography>
                                <SgTooltip Text="I appear on click" Trigger="SgTrigger.Click">
                                    <SgButton Size="SgSize.Sm">Click me</SgButton>
                                </SgTooltip>
                            </SgStack>
                        </SgCol>
                        <SgCol Span="6">
                            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Manual</SgTypography>
                                <SgSpace>
                                    <SgTooltip @ref="_manualTooltip" Text="I appear programmatically" Trigger="SgTrigger.Manual">
                                        <SgButton Size="SgSize.Sm">Target</SgButton>
                                    </SgTooltip>
                                    <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Primary" @onclick="ToggleManualTooltipAsync">@_manualButtonLabel</SgButton>
                                </SgSpace>
                            </SgStack>
                        </SgCol>
                    </SgRow>
                </SgStack>
            </SgCard>

            <SgCard Title="Delay Configuration" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;">
                            OpenDelay = 500ms
                        </SgTypography>
                        <SgTooltip Text="Waited 500ms before showing" OpenDelay="500">
                            <SgButton Size="SgSize.Sm">Hover (500ms delay)</SgButton>
                        </SgTooltip>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;">
                            CloseDelay = 500ms
                        </SgTypography>
                        <SgTooltip Text="Waits 500ms before hiding" CloseDelay="500">
                            <SgButton Size="SgSize.Sm">Hover (500ms delay out)</SgButton>
                        </SgTooltip>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;">
                            Disabled
                        </SgTypography>
                        <SgTooltip Text="I should not appear" Disabled="true">
                            <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined">Disabled tooltip</SgButton>
                        </SgTooltip>
                    </div>
                </SgStack>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Color Variants                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Color Variants
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Use the <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Color</SgTypography> parameter to set any background color. Combine with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ShowArrow</SgTypography> for a polished look.
            </SgTypography>
        </div>

        <SgCard Title="Color Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgSpace Wrap="true">
                <SgTooltip Text="Default tooltip" ShowArrow="true">
                    <SgButton Size="SgSize.Sm">Default</SgButton>
                </SgTooltip>
                <SgTooltip Text="Info message" Color="var(--sg-color-info)" ShowArrow="true">
                    <SgButton Size="SgSize.Sm">Info</SgButton>
                </SgTooltip>
                <SgTooltip Text="Success!" Color="var(--sg-color-success)" ShowArrow="true">
                    <SgButton Size="SgSize.Sm">Success</SgButton>
                </SgTooltip>
                <SgTooltip Text="Warning" Color="var(--sg-color-warning)" ShowArrow="true">
                    <SgButton Size="SgSize.Sm">Warning</SgButton>
                </SgTooltip>
                <SgTooltip Text="Error occurred" Color="var(--sg-color-danger)" ShowArrow="true">
                    <SgButton Size="SgSize.Sm">Error</SgButton>
                </SgTooltip>
                <SgTooltip Text="Dark background" Color="#1e293b" ShowArrow="true">
                    <SgButton Size="SgSize.Sm">Custom Dark</SgButton>
                </SgTooltip>
            </SgSpace>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Rich Content                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Rich Content
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">RichContent</SgTypography> to render any Blazor content inside the tooltip.
            </SgTypography>
        </div>

        <SgCard Title="Rich Content Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgRow Space="SgSize.Lg">
                <SgCol Md="4">
                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Formatted Content</SgTypography>
                        <SgTooltip Placement="SgPlacement.Bottom" ShowArrow="true" MaxWidth="280px">
                            <RichContent>
                                <div style="padding:4px 0;">
                                    <div style="font-weight:600;font-size:12px;margin-bottom:4px;">Keyboard Shortcuts</div>
                                    <div style="font-size:11px;line-height:1.8;">
                                        <div><kbd style="background:rgba(255,255,255,0.15);padding:1px 5px;border-radius:3px;">Ctrl+S</kbd> Save</div>
                                        <div><kbd style="background:rgba(255,255,255,0.15);padding:1px 5px;border-radius:3px;">Ctrl+Z</kbd> Undo</div>
                                        <div><kbd style="background:rgba(255,255,255,0.15);padding:1px 5px;border-radius:3px;">Ctrl+Shift+Z</kbd> Redo</div>
                                    </div>
                                </div>
                            </RichContent>
                            <ChildContent>
                                <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined">Shortcuts</SgButton>
                            </ChildContent>
                        </SgTooltip>
                    </SgStack>
                </SgCol>
                <SgCol Md="4">
                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">With Icons</SgTypography>
                        <SgTooltip Placement="SgPlacement.Bottom" ShowArrow="true" MaxWidth="240px">
                            <RichContent>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                    <SgHeroicon Name="SgHeroicons.Names.InformationCircle" Size="18px" />
                                    <span>Your session will expire in <strong>5 minutes</strong>.</span>
                                </SgStack>
                            </RichContent>
                            <ChildContent>
                                <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined">Session info</SgButton>
                            </ChildContent>
                        </SgTooltip>
                    </SgStack>
                </SgCol>
                <SgCol Md="4">
                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Status Badge</SgTypography>
                        <SgTooltip Placement="SgPlacement.Bottom" ShowArrow="true" MaxWidth="200px" Color="var(--sg-color-success)">
                            <RichContent>
                                <div style="text-align:center;">
                                    <div style="font-weight:600;font-size:13px;">All Systems</div>
                                    <div style="font-size:11px;opacity:0.9;">Operational</div>
                                </div>
                            </RichContent>
                            <ChildContent>
                                <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined">Status</SgButton>
                            </ChildContent>
                        </SgTooltip>
                    </SgStack>
                </SgCol>
            </SgRow>
        </SgCard>
    </div>

    <!-- ================================================================ -->
    <!-- 6. Size Variants                                                  -->
    <!-- ================================================================ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Size Variants
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Use the <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Size</SgTypography> parameter to control tooltip density.
            </SgTypography>
        </div>

        <SgCard Title="Size Variants" Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgSpace Wrap="true">
                @foreach (var sz in _sizeVariants)
                {
                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                        <SgTooltip Text="@($"Size: {sz.Label}")" Size="@sz.Value" ShowArrow="true">
                            <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined">@sz.Label</SgButton>
                        </SgTooltip>
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Weight="SgTypographyWeight.Medium">@sz.Label</SgTypography>
                    </SgStack>
                }
            </SgSpace>
        </SgCard>
    </div>

    <!-- ================================================================ -->
    <!-- 7. Live Constructor                                                -->
    <!-- ================================================================ -->
    <!-- ================================================================ -->
    <!-- 7. Advanced Features (FollowCursor + Interactive)                 -->
    <!-- ================================================================ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Advanced Features
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">FollowCursor</SgTypography> tracks the mouse. <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Interactive</SgTypography> allows clicking tooltip content.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="FollowCursor" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        The tooltip follows the cursor in real time.
                    </SgTypography>
                    <SgSpace>
                        <SgTooltip Text="I follow your cursor!" FollowCursor="true" ShowArrow="true">
                            <SgButton Variant="SgButtonVariant.Primary">Move cursor here</SgButton>
                        </SgTooltip>
                        <SgTooltip Text="Offset 20px" FollowCursor="true" ShowArrow="true" Offset="20" Color="var(--sg-color-info)">
                            <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined">Offset 20px</SgButton>
                        </SgTooltip>
                    </SgSpace>
                </SgStack>
            </SgCard>

            <SgCard Title="Interactive" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Tooltip stays open when you hover over it.
                    </SgTypography>
                    <SgSpace>
                        <SgTooltip Placement="SgPlacement.Bottom" ShowArrow="true" MaxWidth="260px" Interactive="true">
                            <RichContent>
                                <div style="padding:4px 0;">
                                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
                                        <SgHeroicon Name="SgHeroicons.Names.User" Size="16px" />
                                        <span style="font-weight:600;font-size:12px;">John Doe</span>
                                    </div>
                                    <div style="font-size:11px;opacity:0.9;">john.doe@@example.com</div>
                                </div>
                            </RichContent>
                            <ChildContent>
                                <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined">Hover for profile</SgButton>
                            </ChildContent>
                        </SgTooltip>
                        <SgTooltip Text="Non-interactive (default)" ShowArrow="true" Placement="SgPlacement.Bottom">
                            <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Ghost">Non-interactive</SgButton>
                        </SgTooltip>
                    </SgSpace>
                </SgStack>
            </SgCard>
        </div>
    </div>

    <!-- ================================================================ -->
    <!-- 8. Offset Customization                                           -->
    <!-- ================================================================ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Offset Customization
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                The <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Offset</SgTypography> parameter controls the gap (px) between tooltip and trigger. Default: 8.
            </SgTypography>
        </div>

        <SgCard Title="Offset Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgSpace Wrap="true">
                <SgTooltip Text="Offset 4 (tight)" Offset="4" ShowArrow="true">
                    <SgButton Size="SgSize.Sm">Offset 4</SgButton>
                </SgTooltip>
                <SgTooltip Text="Offset 8 (default)" ShowArrow="true">
                    <SgButton Size="SgSize.Sm">Offset 8</SgButton>
                </SgTooltip>
                <SgTooltip Text="Offset 16" Offset="16" ShowArrow="true">
                    <SgButton Size="SgSize.Sm">Offset 16</SgButton>
                </SgTooltip>
                <SgTooltip Text="Offset 32" Offset="32" ShowArrow="true">
                    <SgButton Size="SgSize.Sm">Offset 32</SgButton>
                </SgTooltip>
            </SgSpace>
        </SgCard>
    </div>

    <!-- ================================================================ -->
    <!-- 9. Live SgTooltip Constructor                                                -->
    <!-- ================================================================ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live SgTooltip Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure all parameters and see the result live. Click the code to copy.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Text -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Text</SgTypography>
                            <input type="text" class="demo-input"
                                   value="@_ctorText"
                                   @oninput="e => { _ctorText = (string?)e.Value ?? _ctorText; UpdateConstructorCode(); }"
                                   placeholder="Tooltip text..." />
                        </SgStack>

                        <!-- Placement -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Placement</SgTypography>
                            <SgSelect TValue="SgPlacement"
                                      @bind-Value="_ctorPlacement"
                                      Items="_allPlacements"
                                      LabelSelector="x => x.ToString()"
                                      Block="true" />
                        </SgStack>

                        <!-- Trigger -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Trigger</SgTypography>
                            <SgSelect TValue="SgTrigger"
                                      @bind-Value="_ctorTrigger"
                                      Items="_allTriggers"
                                      LabelSelector="x => x.ToString()"
                                      Block="true" />
                        </SgStack>

                        <!-- Delay -->
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">OpenDelay</SgTypography>
                                    <input type="number" class="demo-input"
                                           value="@_ctorOpenDelay"
                                           @oninput="e => { _ctorOpenDelay = int.TryParse((string?)e.Value, out var v) ? v : 0; UpdateConstructorCode(); }"
                                           min="0" max="5000" step="100" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">CloseDelay</SgTypography>
                                    <input type="number" class="demo-input"
                                           value="@_ctorCloseDelay"
                                           @oninput="e => { _ctorCloseDelay = int.TryParse((string?)e.Value, out var v) ? v : 0; UpdateConstructorCode(); }"
                                           min="0" max="5000" step="100" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="4">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Arrow</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorShowArrow"
                                                 ValueChanged="v => { _ctorShowArrow = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="4">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Disabled</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorDisabled"
                                                 ValueChanged="v => { _ctorDisabled = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="_boolSegOptions2" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="4">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Cursor</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorFollowCursor"
                                                 ValueChanged="v => { _ctorFollowCursor = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Color</SgTypography>
                            <SgSegmented TValue="string"
                                         Value="_ctorColor"
                                         ValueChanged="v => { _ctorColor = v; UpdateConstructorCode(); }"
                                         Block="true" Size="sm"
                                         Options="_colorSegOptions" />
                        </SgStack>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgSelect TValue="SgSize?"
                                              @bind-Value="_ctorSize"
                                              Items="_allSizeOptions"
                                              LabelSelector="@(_sizeLabelSelector)"
                                              Block="true" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Offset</SgTypography>
                                    <input type="number" class="demo-input"
                                           value="@_ctorOffset"
                                           @oninput="e => { _ctorOffset = int.TryParse((string?)e.Value, out var v) ? v : 8; UpdateConstructorCode(); }"
                                           min="0" max="64" step="1" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">MaxWidth</SgTypography>
                            <input type="text" class="demo-input"
                                   value="@_ctorMaxWidth"
                                   @oninput="e => { _ctorMaxWidth = (string?)e.Value ?? string.Empty; UpdateConstructorCode(); }"
                                   placeholder="e.g. 280px" />
                        </SgStack>

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Interactive</SgTypography>
                            <SgSegmented TValue="bool"
                                         Value="_ctorInteractive"
                                         ValueChanged="v => { _ctorInteractive = v; UpdateConstructorCode(); }"
                                         Block="true" Size="sm"
                                         Options="_boolSegOptions" />
                        </SgStack>

                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Placement</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorPlacement.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Trigger</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorTrigger.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size / Offset</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@($"{_ctorSize?.ToString() ?? "Default"} / {_ctorOffset}px")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Arrow / Delays</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@($"{(_ctorShowArrow ? "Arrow" : "No arrow")} / {_ctorOpenDelay}ms {_ctorCloseDelay}ms")" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <div class="constructor-preview">
                                <SgTooltip Text="@_ctorText"
                                           Placement="@_ctorPlacement"
                                           Trigger="@_ctorTrigger"
                                           OpenDelay="@_ctorOpenDelay"
                                           CloseDelay="@_ctorCloseDelay"
                                           ShowArrow="@_ctorShowArrow"
                                           Disabled="@_ctorDisabled"
                                           Color="@(string.IsNullOrEmpty(_ctorColor) ? null : _ctorColor)"
                                           MaxWidth="@(string.IsNullOrEmpty(_ctorMaxWidth) ? null : _ctorMaxWidth)"
                                           Size="@_ctorSize"
                                           Offset="@_ctorOffset"
                                           FollowCursor="@_ctorFollowCursor"
                                           Interactive="@_ctorInteractive">
                                    <SgButton Variant="SgButtonVariant.Primary">Hover me</SgButton>
                                </SgTooltip>
                            </div>
                        </SgStack>

                        <!-- Code -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                    <span id="copy-icon">@_copyIcon</span>
                                    <span id="copy-text" style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                </button>
                            </div>
                            <div class="code-block" id="code-block">
                                @foreach (var line in _generatedCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

    <!-- ================================================================ -->
    <!-- 10. Enum Reference                                                -->
    <!-- ================================================================ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Enum Reference
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Complete reference for <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgPlacement</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgTrigger</SgTypography>, and <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgSize</SgTypography>.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="4">
                <SgCard Title="SgPlacement" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_placementEnum" />
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="SgTrigger" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_triggerEnum" />
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="SgSize" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_sizeEnum" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

</ChildContent>
</SgCard>

<style>
    /* ── Section layout ─────────────────────────────────────────────────────── */
