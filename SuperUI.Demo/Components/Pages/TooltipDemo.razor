@page "/tooltip-demo"
@using SuperUI.Components

<PageTitle>Подсказка - SUI</PageTitle>

<SgCard Title="SgTooltip - Подсказка"
        Subtitle="Компонент для отображения подсказок при наведении. Поддерживает различные позиции и пользовательское содержимое.">

    <div style="margin-top: 32px;">
        <h2>Примеры использования</h2>
        <p>Наведите мышь на элементы для отображения подсказок.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Базовые примеры">
                <div style="display: flex; flex-direction: column; gap: 16px; align-items: flex-start;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Кнопки с подсказками</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <SgTooltip Text="Сохранить изменения">
                                <SgButton Text="Сохранить" Variant=SgButtonVariant.Primary" />
                            </SgTooltip>
                            <SgTooltip Text="Отменить все изменения">
                                <SgButton Text="Отмена" />
                            </SgTooltip>
                            <SgTooltip Text="Удалить запись без возможности восстановления">
                                <SgButton Text="Удалить" Variant="SgButtonVariant.Danger" />
                            </SgTooltip>
                        </div>
                    </div>

                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Иконки с подсказками</div>
                        <div style="display: flex; gap: 16px; align-items: center;">
                            <SgTooltip Text="Настройки приложения">
                                <span style="font-size: 20px; cursor: pointer;">⚙️</span>
                            </SgTooltip>
                            <SgTooltip Text="Уведомления (3 новых)">
                                <span style="font-size: 20px; cursor: pointer;">🔔</span>
                            </SgTooltip>
                            <SgTooltip Text="Профиль пользователя">
                                <span style="font-size: 20px; cursor: pointer;">👤</span>
                            </SgTooltip>
                            <SgTooltip Text="Справка и документация">
                                <span style="font-size: 20px; cursor: pointer;">❓</span>
                            </SgTooltip>
                        </div>
                    </div>

                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Текст с подсказкой</div>
                        <SgTooltip Text="Это поле содержит важную информацию">
                            <span style="border-bottom: 1px dashed var(--sui-text-muted); cursor: help;">
                                Наведите для подсказки
                            </span>
                        </SgTooltip>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_tooltipProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Позиционирование</h2>
        <p>Подсказка поддерживает 4 позиции: top, bottom, left, right.</p>

        <SgCard Title="Варианты позиций" Style="margin-top: 16px;">
            <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
                <SgTooltip Text="Подсказка сверху" Placement="SgPlacement.Top">
                    <SgButton Text="Top" Size="SgSize.Sm" />
                </SgTooltip>
                <SgTooltip Text="Подсказка снизу" Placement="SgPlacement.Bottom">
                    <SgButton Text="Bottom" Size="SgSize.Sm" />
                </SgTooltip>
                <SgTooltip Text="Подсказка слева" Placement="SgPlacement.Left">
                    <SgButton Text="Left" Size="SgSize.Sm" />
                </SgTooltip>
                <SgTooltip Text="Подсказка справа" Placement="SgPlacement.Right">
                    <SgButton Text="Right" Size="SgSize.Sm" />
                </SgTooltip>
            </div>
        </SgCard>
    </div>

    <div style="margin-top: 32px;">
        <h2>Использование в формах</h2>
        <p>Подсказки помогают пользователям понять назначение полей.</p>

        <SgCard Title="Форма с подсказками" Style="margin-top: 16px;">
            <div style="display: flex; flex-direction: column; gap: 16px; max-width: 400px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <div style="flex: 1;">
                        <SgTextBox TValue="string" @bind-Value="@_username" Label="Имя пользователя" Placeholder="Введите имя..." />
                    </div>
                    <SgTooltip Text="Имя должно содержать от 3 до 20 символов. Допустимы буквы, цифры и подчёркивание." Placement="SgPlacement.Right">
                        <span style="font-size: 16px; cursor: help; color: var(--sui-text-muted);">ℹ️</span>
                    </SgTooltip>
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <div style="flex: 1;">
                        <SgTextBox TValue="string" @bind-Value="@_password" Label="Пароль" Type="password" Placeholder="Введите пароль..." />
                    </div>
                    <SgTooltip Text="Пароль должен содержать минимум 8 символов, включая заглавные буквы и цифры." Placement="SgPlacement.Right">
                        <span style="font-size: 16px; cursor: help; color: var(--sui-text-muted);">ℹ️</span>
                    </SgTooltip>
                </div>
            </div>
        </SgCard>
    </div>

    <!-- Enum + code -->
    <div style="margin-top: 32px;">
        <h2>Перечисления и примеры кода</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="SgPlacement (Placement)">
                <PropertyTable Items="_placementEnum" />
            </SgCard>
            <SgCard Title="SgTrigger (Trigger)">
                <PropertyTable Items="_triggerEnum" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private string? _username;
    private string? _password;

    private List<PropertyPanelItem> _tooltipProperties = new()
    {
        new() { Label = "Text",      Value = "string",                  BadgeText = "Текст (обязательно)",  BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "Placement", Value = "top|bottom|left|right",   BadgeText = "Позиция (SgPlacement)", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Trigger",   Value = "hover|focus|click|manual",BadgeText = "Триггер (SgTrigger)",  BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "OpenDelay", Value = "int (ms)",                BadgeText = "Задержка открытия",    BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "CloseDelay",Value = "int (ms)",                BadgeText = "Задержка закрытия",    BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Disabled",  Value = "bool",                    BadgeText = "Отключить",             BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ChildContent",Value = "RenderFragment",        BadgeText = "Триггер-элемент",       BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "CssClass",  Value = "string",                  BadgeText = "CSS класс",             BadgeVariant = SgBadgeVariant.Info }
    };

    // ── Enum tables ──────────────────────────────────────────────────────────
    private List<PropertyPanelItem> _placementEnum = new()
    {
        new() { Label = "SgPlacement.Top",    Value = "\"top\"",    BadgeText = "Сверху (по умолч.)", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "SgPlacement.Bottom", Value = "\"bottom\"", BadgeText = "Снизу",               BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgPlacement.Left",   Value = "\"left\"",   BadgeText = "Слева",               BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgPlacement.Right",  Value = "\"right\"",  BadgeText = "Справа",              BadgeVariant = SgBadgeVariant.Info },
    };

    private List<PropertyPanelItem> _triggerEnum = new()
    {
        new() { Label = "SgTrigger.Hover",  Value = "\"hover\"",  BadgeText = "При наведении (по умолч.)", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "SgTrigger.Focus",  Value = "\"focus\"",  BadgeText = "При фокусе",                BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgTrigger.Click",  Value = "\"click\"",  BadgeText = "По клику",                  BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgTrigger.Manual", Value = "\"manual\"", BadgeText = "Программно",                BadgeVariant = SgBadgeVariant.Muted },
    };
}
