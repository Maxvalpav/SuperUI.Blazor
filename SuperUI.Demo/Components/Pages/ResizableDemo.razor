@page "/resizable-demo"

<PageTitle>Resizable - SUI</PageTitle>

<SgCard Title="SgResizable - Изменяемая панель"
        Subtitle="Контейнер, размеры которого пользователь может изменять мышью за рамку или угол.">

    <div style="margin-top: 32px;">
        <h2>Угол + правый и нижний край</h2>
        <p>Текущие размеры: @($"{_w1:F0} × {_h1:F0}") px. Тяните за угол или края.</p>

        <SgResizable Width="@_w1" Height="@_h1"
                     MinWidth="160" MinHeight="100"
                     MaxWidth="900" MaxHeight="500"
                     Handles="se,e,s"
                     SizeChanged="@OnSize1Changed">
            <div style="padding: 16px;">
                <div style="font-weight: 600; margin-bottom: 8px;">Изменяемый блок</div>
                <div style="font-size: 12px; color: var(--sui-muted);">
                    Тяните за правый-нижний угол для свободного изменения, либо за правый/нижний край.
                </div>
            </div>
        </SgResizable>
    </div>

    <div style="margin-top: 32px;">
        <h2>Все 8 направлений</h2>
        <p>Все стороны и углы — резинабельны.</p>

        <SgResizable Width="360" Height="220"
                     MinWidth="160" MinHeight="100"
                     Handles="n,s,e,w,ne,nw,se,sw">
            <div style="padding: 16px; height: 100%; display:flex; align-items:center; justify-content:center; color: var(--sui-muted); font-size: 13px;">
                Тяните за любую сторону или угол
            </div>
        </SgResizable>
    </div>

    <div style="margin-top: 32px;">
        <h2>Карточка с изменяемым размером</h2>
        <SgResizable Width="420" Height="260" Handles="se,e,s">
            <SgCard Title="Resizable card" Style="height:100%;border:none;border-radius:0;">
                <div style="font-size: 12px; color: var(--sui-muted);">
                    SgCard внутри SgResizable. Удобно для дашборд-плиток или превью.
                </div>
            </SgCard>
        </SgResizable>
    </div>

    <div style="margin-top: 32px;">
        <h2>Свойства</h2>
        <SgCard Title="SgResizable" Style="margin-top: 16px;">
            <PropertyTable Items="_props" />
        </SgCard>
    </div>
</SgCard>

@code {
    private double _w1 = 320;
    private double _h1 = 180;

    private void OnSize1Changed((double Width, double Height) s)
    {
        _w1 = s.Width;
        _h1 = s.Height;
    }

    private List<PropertyPanelItem> _props = new()
    {
        new() { Label = "Width", Value = "double (default 320)", BadgeText = "Начальная ширина (px)", BadgeVariant = "info" },
        new() { Label = "Height", Value = "double (default 200)", BadgeText = "Начальная высота (px)", BadgeVariant = "info" },
        new() { Label = "MinWidth / MinHeight", Value = "double", BadgeText = "Минимум", BadgeVariant = "info" },
        new() { Label = "MaxWidth / MaxHeight", Value = "double", BadgeText = "Максимум", BadgeVariant = "info" },
        new() { Label = "Handles", Value = "string (csv: n,s,e,w,ne,nw,se,sw)", BadgeText = "Активные ручки", BadgeVariant = "warn" },
        new() { Label = "SizeChanged", Value = "EventCallback<(double,double)>", BadgeText = "Событие", BadgeVariant = "success" },
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Содержимое", BadgeVariant = "info" }
    };
}
