@page "/resizable-demo"
@using SuperUI.Components

<PageTitle>Resizable — SuperUI</PageTitle>
<SgSeoHead Description="Container whose dimensions the user can resize via handles. Supports aspect-ratio lock, grid snap, live feedback, and three handle styles." />

<SgCard Title="SgResizable — Resizable panel"
        Subtitle="Container whose dimensions the user can resize via handles. Supports aspect-ratio lock, grid snap, live feedback, and three handle styles."
        CssClass="sgc-card-flush">

    @* ── Interactive Demo ─────────────────────────────────────────────────── *@
    <div class="sgc-demo-section" style="padding: 32px;">
        <div class="demo-section-header" style="margin-bottom: 24px;">
            <SgTypography Variant="SgTypographyVariant.Heading2">Interactive Showcase</SgTypography>
            <span class="demo-live-badge">Interactive</span>
        </div>
        
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" Style="margin-bottom: 40px; max-width: 800px; line-height: 1.6;">
            The <code>SgResizable</code> component allows you to create adaptive interfaces with manual size control. 
            Below are examples of usage following natural proportions and the golden ratio.
        </SgTypography>

        <div class="demo-grid-adaptive" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 48px; align-items: start;">
            
            @* ── Golden Ratio & Natural Proportions ── *@
            <div class="demo-example-group">
                <SgTypography Size="SgTypographySize.Base" Weight="SgTypographyWeight.Semibold" Style="margin-bottom: 16px; display: block;">
                    Golden Ratio & Natural Proportions
                </SgTypography>
                
                <div style="background: var(--sg-surface-alt); padding: 32px; border-radius: 16px; border: 1px solid var(--sg-border); display: flex; align-items: center; justify-content: center; min-height: 400px;">
                    <SgResizable Width="@_goldenW" Height="@_goldenH"
                                 MinWidth="160" MinHeight="100"
                                 AspectRatio="1.618"
                                 Handles="se,e,s"
                                 ShowSizeTooltip="true"
                                 SizeChanged="@(s => { _goldenW = s.Width; _goldenH = s.Height; })">
                        <div style="padding: 24px; display: flex; flex-direction: column; gap: 12px; height: 100%; background: var(--sg-bg); border-radius: 8px; border: 1px solid var(--sg-border); box-shadow: var(--sg-shadow-sm);">
                            <div style="font-weight: 600; font-size: 15px; color: var(--sg-color-primary);">Golden Ratio (1.618)</div>
                            <div style="font-size: 13px; color: var(--sg-text-muted); flex: 1; line-height: 1.5;">
                                This block maintains perfect proportions when resized. Use <code>AspectRatio="1.618"</code> for the most natural perception.
                            </div>
                            <div style="font-size: 11px; font-family: monospace; color: var(--sg-text-muted); border-top: 1px solid var(--sg-border-subtle); padding-top: 12px;">
                                @($"{_goldenW:F0} × {_goldenH:F0} px")
                            </div>
                        </div>
                    </SgResizable>
                </div>
            </div>

            @* ── Photo Proportions (3:2) ── *@
            <div class="demo-example-group">
                <SgTypography Size="SgTypographySize.Base" Weight="SgTypographyWeight.Semibold" Style="margin-bottom: 16px; display: block;">
                    Natural Photography (3:2)
                </SgTypography>
                
                <div style="background: var(--sg-surface-alt); padding: 32px; border-radius: 16px; border: 1px solid var(--sg-border); display: flex; align-items: center; justify-content: center; min-height: 400px;">
                    <SgResizable Width="300" Height="200"
                                 MinWidth="150" MinHeight="100"
                                 AspectRatio="1.5"
                                 Handles="se"
                                 ShowSizeTooltip="true">
                        <div style="position: relative; height: 100%; border-radius: 8px; overflow: hidden; background: #000;">
                            <img src="https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?auto=format&fit=crop&w=800&q=80" 
                                 style="width: 100%; height: 100%; object-fit: cover; opacity: 0.8;" alt="Nature" />
                            <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 16px; background: linear-gradient(transparent, rgba(0,0,0,0.7)); color: #fff;">
                                <div style="font-weight: 600; font-size: 14px;">3:2 Ratio</div>
                                <div style="font-size: 11px; opacity: 0.8;">Standard for 35mm film</div>
                            </div>
                        </div>
                    </SgResizable>
                </div>
            </div>

            @* ── Grid Snapping (8px Rule) ── *@
            <div class="demo-example-group">
                <SgTypography Size="SgTypographySize.Base" Weight="SgTypographyWeight.Semibold" Style="margin-bottom: 16px; display: block;">
                    Grid Snapping (8px System)
                </SgTypography>
                
                <div style="background: var(--sg-surface-alt); padding: 32px; border-radius: 16px; border: 1px solid var(--sg-border); position: relative; min-height: 400px; display: flex; align-items: center; justify-content: center;">
                    @* Grid Background Overlay *@
                    <div style="position: absolute; inset: 0; background-image: radial-gradient(var(--sg-border) 1px, transparent 1px); background-size: 8px 8px; opacity: 0.3;"></div>
                    
                    <SgResizable Width="320" Height="160"
                                 MinWidth="80" MinHeight="80"
                                 SnapStep="8"
                                 Handles="se,e,s"
                                 ShowSizeTooltip="true">
                        <div style="padding: 20px; height: 100%; background: var(--sg-bg); border: 2px solid var(--sg-color-primary); border-radius: 4px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; z-index: 1;">
                            <div style="font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--sg-color-primary);">8px Grid Snap</div>
                            <div style="font-size: 11px; color: var(--sg-text-muted); text-align: center;">Snapping to the grid ensures perfect alignment.</div>
                        </div>
                    </SgResizable>
                </div>
            </div>

            @* ── All Handles & Handles Styles ── *@
            <div class="demo-example-group">
                <SgTypography Size="SgTypographySize.Base" Weight="SgTypographyWeight.Semibold" Style="margin-bottom: 16px; display: block;">
                    Advanced Controls
                </SgTypography>
                
                <SgCard CssClass="demo-interactive-card" Style="height: 100%; border-radius: 16px;">
                    <div class="demo-flex-col" style="gap: 20px; padding: 12px;">
                        <div>
                            <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Color="var(--sg-text-muted)" Style="margin-bottom: 10px; display: block;">Handle Style</SgTypography>
                            <div style="display: flex; gap: 8px;">
                                <SgButton Text="Default" Size="SgSize.Sm" Variant="@(_handleStyle == SgResizableHandleStyle.Default ? SgButtonVariant.Primary : SgButtonVariant.Ghost)" OnClick="@(() => _handleStyle = SgResizableHandleStyle.Default)" />
                                <SgButton Text="Minimal" Size="SgSize.Sm" Variant="@(_handleStyle == SgResizableHandleStyle.Minimal ? SgButtonVariant.Primary : SgButtonVariant.Ghost)" OnClick="@(() => _handleStyle = SgResizableHandleStyle.Minimal)" />
                                <SgButton Text="Prominent" Size="SgSize.Sm" Variant="@(_handleStyle == SgResizableHandleStyle.Prominent ? SgButtonVariant.Primary : SgButtonVariant.Ghost)" OnClick="@(() => _handleStyle = SgResizableHandleStyle.Prominent)" />
                            </div>
                        </div>
                        
                        <SgDivider />
                        
                        <div style="display: flex; align-items: center; justify-content: space-between;">
                            <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Color="var(--sg-text-muted)">Show Tooltip</SgTypography>
                            <SgSwitch @bind-Value="_showTooltip" />
                        </div>

                        <div style="margin-top: 12px; display: flex; justify-content: center; background: var(--sg-surface-alt); padding: 40px; border-radius: 12px;">
                            <SgResizable Width="240" Height="140"
                                         Handles="n,s,e,w,ne,nw,se,sw"
                                         HandleStyle="@_handleStyle"
                                         ShowSizeTooltip="@_showTooltip">
                                <div style="padding: 16px; height: 100%; background: var(--sg-bg); border: 1px solid var(--sg-border); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 11px; color: var(--sg-text-muted); text-align: center;">
                                    8-way resize with custom handles
                                </div>
                            </SgResizable>
                        </div>
                    </div>
                </SgCard>
            </div>
        </div>

        @* ── Code constructor ── *@
        <div style="margin-top: 64px; padding-top: 40px; border-top: 1px solid var(--sg-border);">
            <SgTypography Variant="SgTypographyVariant.Heading3" Style="margin-bottom: 24px;">Implementation Constructor</SgTypography>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                <div class="demo-flex-col" style="gap: 12px;">
                    <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold">Advanced Config (Live)</SgTypography>
                    <pre class="demo-code-block" style="margin: 0;"><span class="demo-code-keyword">&lt;SgResizable</span> <span class="demo-code-attr">Width</span>=<span class="demo-code-string">"240"</span> <span class="demo-code-attr">Height</span>=<span class="demo-code-string">"140"</span>
             <span class="demo-code-attr">Handles</span>=<span class="demo-code-string">"n,s,e,w,ne,nw,se,sw"</span>
             <span class="demo-code-attr">HandleStyle</span>=<span class="demo-code-string">"SgResizableHandleStyle.@_handleStyle"</span>
             <span class="demo-code-attr">ShowSizeTooltip</span>=<span class="demo-code-string">"@_showTooltip.ToString().ToLower()"</span><span class="demo-code-keyword">&gt;</span>
    <span class="demo-code-keyword">&lt;div&gt;</span>Resizable content<span class="demo-code-keyword">&lt;/div&gt;</span>
<span class="demo-code-keyword">&lt;/SgResizable&gt;</span></pre>
                </div>

                <div class="demo-flex-col" style="gap: 12px;">
                    <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold">Golden Ratio & Grid</SgTypography>
                    <pre class="demo-code-block" style="margin: 0;"><span class="demo-code-comment">&lt;!-- Golden Ratio Lock --&gt;</span>
<span class="demo-code-keyword">&lt;SgResizable</span> <span class="demo-code-attr">AspectRatio</span>=<span class="demo-code-string">"1.618"</span> <span class="demo-code-keyword">/&gt;</span>

<span class="demo-code-comment">&lt;!-- 8px Grid Snap --&gt;</span>
<span class="demo-code-keyword">&lt;SgResizable</span> <span class="demo-code-attr">SnapStep</span>=<span class="demo-code-string">"8"</span> <span class="demo-code-keyword">/&gt;</span></pre>
                </div>
            </div>
        </div>
    </div>

    @* ── Component Properties ─────────────────────────────────────────────── *@
    <div class="sgc-demo-section" style="padding: 32px; background: var(--sg-surface-alt);">
        <div class="demo-section-header" style="margin-bottom: 24px;">
            <SgTypography Variant="SgTypographyVariant.Heading2">Properties Reference</SgTypography>
        </div>

        <SgCard Style="border-radius: 16px;">
            <PropertyTable Items="_props" />
        </SgCard>
    </div>

</SgCard>

@code {
    private double _goldenW = 324;
    private double _goldenH = 200;
    private bool _showTooltip = true;
    private SgResizableHandleStyle _handleStyle = SgResizableHandleStyle.Default;

    private List<PropertyPanelItem> _props = new()
    {
        new() { Label = "Width / Height",       Value = "double",                          BadgeText = "Initial size",        BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "MinWidth / MinHeight", Value = "double",                          BadgeText = "Constraints",         BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Handles",              Value = "string (n,s,e,w,ne,nw,se,sw)",    BadgeText = "Directions",          BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "AspectRatio",          Value = "double? (e.g. 1.618)",            BadgeText = "Proportion lock",     BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "SnapStep",             Value = "double? (e.g. 8)",                BadgeText = "Grid snap",           BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "HandleStyle",          Value = "Default, Minimal, Prominent",     BadgeText = "Appearance",          BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "SizeChanged",          Value = "EventCallback<(double,double)>",  BadgeText = "Event",               BadgeVariant = SgBadgeVariant.Success },
    };
}
