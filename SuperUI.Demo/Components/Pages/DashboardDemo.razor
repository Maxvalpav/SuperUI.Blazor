@page "/dashboard-demo"
@using SuperUI.Components

<PageTitle>Dashboard - SUI</PageTitle>

<SgCard Title="SgDashboard - Drag &amp; Drop Widget Grid"
        Subtitle="Arrange widgets in a responsive grid. Drag the header to reorder, drag the corner to resize.">

    <div style="margin-top: 32px;">
        <h2>Basic Usage</h2>
        <p>Drag the widget header to reorder. Drag the bottom-right corner to resize. Use +/- buttons to adjust column and row span.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgDashboard Items="_widgets"
                                 ItemsChanged="_ => StateHasChanged()"
                                 Columns="3"
                                 AllowDrag="true"
                                 AllowResize="true"
                                 AllowDelete="true"
                                 MaxColumnSpan="3"
                                 MaxRowSpan="3"
                                 OnReorder="OnReorder"
                                 OnWidgetResized="OnWidgetResized"
                                 OnWidgetDeleted="OnWidgetDeleted"
                                 CssClass="sg-stagger">
                        <WidgetTemplate>
                            @switch (context.Id)
                            {
                                case "revenue":
                                    <div>
                                        <div style="font-size: 24px; font-weight: 700; color: var(--sg-color-primary);">$42,500</div>
                                        <div style="font-size: 11px; color: var(--sg-fg-muted); margin-top: 4px;">Monthly revenue</div>
                                        <div style="margin-top: 8px; display: flex; align-items: center; gap: 4px; color: var(--sg-color-success); font-size: 11px;">
                                            <span>+12.5%</span>
                                            <span>vs last month</span>
                                        </div>
                                    </div>
                                    break;
                                case "users":
                                    <div>
                                        <div style="font-size: 24px; font-weight: 700; color: var(--sg-fg);">1,248</div>
                                        <div style="font-size: 11px; color: var(--sg-fg-muted); margin-top: 4px;">Active users</div>
                                        <div style="margin-top: 8px; display: flex; align-items: center; gap: 4px; color: var(--sg-color-success); font-size: 11px;">
                                            <span>+5.2%</span>
                                            <span>vs last month</span>
                                        </div>
                                    </div>
                                    break;
                                case "tasks":
                                    <div style="display: flex; flex-direction: column; gap: 8px;">
                                        <SgProgress Value="78" Title="Completed" Size="SgSize.Sm" ShowDescription="false" />
                                        <SgProgress Value="15" Title="In Review" Size="SgSize.Sm" ShowDescription="false" Color="var(--sg-color-warning)" />
                                    </div>
                                    break;
                                case "servers":
                                    <div style="display: flex; flex-direction: column; gap: 6px;">
                                        <div style="display: flex; align-items: center; gap: 8px; font-size: 11px;">
                                            <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--sg-color-success);"></span>
                                            <span>Web-01 — Online</span>
                                        </div>
                                        <div style="display: flex; align-items: center; gap: 8px; font-size: 11px;">
                                            <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--sg-color-success);"></span>
                                            <span>Web-02 — Online</span>
                                        </div>
                                        <div style="display: flex; align-items: center; gap: 8px; font-size: 11px;">
                                            <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--sg-color-danger);"></span>
                                            <span>DB-01 — Offline</span>
                                        </div>
                                    </div>
                                    break;
                            }
                        </WidgetTemplate>
                    </SgDashboard>
                    @if (!string.IsNullOrEmpty(_lastEvent))
                    {
                        <div style="font-size: 11px; color: var(--sg-fg-muted); padding: 6px 8px; background: var(--sg-bg-subtle); border-radius: var(--sg-radius-md); border: 1px solid var(--sg-border);">
                            Last event: @_lastEvent
                        </div>
                    }
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_properties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Read-only (AllowDrag=false)</h2>
        <p>Drag is disabled. Resize and delete are still available.</p>

        <SgCard Title="Example">
            <SgDashboard Items="_spanWidgets"
                         Columns="3"
                         AllowDrag="false"
                         AllowResize="true"
                         MaxColumnSpan="3"
                         MaxRowSpan="2">
                <WidgetTemplate>
                    <div style="text-align: center; padding: 16px; color: var(--sg-fg-muted);">
                        @context.Title
                    </div>
                </WidgetTemplate>
            </SgDashboard>
        </SgCard>
    </div>

</SgCard>

@code {
    private string? _lastEvent;

    private void OnReorder((string SourceId, string TargetId) args)
        => _lastEvent = $"Reordered: {args.SourceId} → {args.TargetId}";

    private void OnWidgetResized(SgDashboardWidgetItem w)
        => _lastEvent = $"Resized: {w.Title} ({w.ColumnSpan}×{w.RowSpan})";

    private void OnWidgetDeleted(SgDashboardWidgetItem w)
        => _lastEvent = $"Deleted: {w.Title}";

    private List<SgDashboardWidgetItem> _widgets = new()
    {
        new() { Id = "revenue", Title = "Revenue", Icon = SgIcons.TrendingUp, ColumnSpan = 1 },
        new() { Id = "users", Title = "Users", Icon = SgIcons.BarChart, ColumnSpan = 1 },
        new() { Id = "tasks", Title = "Task Progress", Icon = SgIcons.Check, ColumnSpan = 2 },
        new() { Id = "servers", Title = "Servers", Icon = SgIcons.Settings, ColumnSpan = 2 }
    };

    private List<SgDashboardWidgetItem> _spanWidgets = new()
    {
        new() { Id = "a", Title = "1 column", ColumnSpan = 1 },
        new() { Id = "b", Title = "2 columns", ColumnSpan = 2 },
        new() { Id = "c", Title = "1 column", ColumnSpan = 1 },
        new() { Id = "d", Title = "3 columns", ColumnSpan = 3 }
    };

    private List<PropertyPanelItem> _properties = new()
    {
        new() { Label = "Items", Value = "List<SgDashboardWidgetItem>", BadgeText = "Widget list", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ItemsChanged", Value = "EventCallback<List>", BadgeText = "Reorder/resize/delete", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Columns", Value = "int (default: 3)", BadgeText = "Grid columns", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "AllowDrag", Value = "bool (default: true)", BadgeText = "Drag & Drop", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "AllowResize", Value = "bool", BadgeText = "Resize buttons + handle", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "AllowDelete", Value = "bool", BadgeText = "Delete buttons", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "MinColumnSpan", Value = "int (default: 1)", BadgeText = "Min width", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "MaxColumnSpan", Value = "int (default: 6)", BadgeText = "Max width", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "MinRowSpan", Value = "int (default: 1)", BadgeText = "Min height", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "MaxRowSpan", Value = "int (default: 6)", BadgeText = "Max height", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "OnReorder", Value = "EventCallback<(string, string)>", BadgeText = "Drag reorder", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnWidgetResized", Value = "EventCallback<SgDashboardWidgetItem>", BadgeText = "Resize event", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnWidgetDeleted", Value = "EventCallback<SgDashboardWidgetItem>", BadgeText = "Delete event", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "WidgetTemplate", Value = "RenderFragment", BadgeText = "Content", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "CssClass", Value = "string", BadgeText = "Custom CSS", BadgeVariant = SgBadgeVariant.Info }
    };
}
