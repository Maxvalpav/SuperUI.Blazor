@page "/dashboard-demo"
@using SuperUI.Components

<PageTitle>Dashboard - SUI</PageTitle>

<SgCard Title="SgDashboard - Drag &amp; Drop Widget Grid"
        Subtitle="Arrange widgets in a responsive grid. Drag the header to reorder, drag the corner to resize.">

    <div style="margin-top: 32px;">
        <h2>Basic Usage</h2>
        <p>Drag the widget header to reorder. Drag the bottom-right corner to resize.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgDashboard Items="_widgets" ItemsChanged="_ => StateHasChanged()" Columns="3" AllowResize="true" AllowDelete="true" MaxColumnSpan="3">
                        <WidgetTemplate>
                            @switch (context.Id)
                            {
                                case "revenue":
                                    <div>
                                        <div style="font-size: 24px; font-weight: 700; color: var(--sui-accent);">$42,500</div>
                                        <div style="font-size: 11px; color: var(--sui-muted); margin-top: 4px;">Monthly revenue</div>
                                        <div style="margin-top: 8px; display: flex; align-items: center; gap: 4px; color: #10b981; font-size: 11px;">
                                            <span>+12.5%</span>
                                            <span>vs last month</span>
                                        </div>
                                    </div>
                                    break;
                                case "users":
                                    <div>
                                        <div style="font-size: 24px; font-weight: 700; color: var(--sui-fg);">1,248</div>
                                        <div style="font-size: 11px; color: var(--sui-muted); margin-top: 4px;">Active users</div>
                                        <div style="margin-top: 8px; display: flex; align-items: center; gap: 4px; color: #10b981; font-size: 11px;">
                                            <span>+5.2%</span>
                                            <span>vs last month</span>
                                        </div>
                                    </div>
                                    break;
                                case "tasks":
                                    <div style="display: flex; flex-direction: column; gap: 6px;">
                                        <div style="display: flex; justify-content: space-between; font-size: 11px;">
                                            <span>Completed</span>
                                            <span style="color: var(--sui-muted);">78%</span>
                                        </div>
                                        <div style="height: 6px; background: var(--sui-bg-secondary); border-radius: 3px; overflow: hidden;">
                                            <div style="width: 78%; height: 100%; background: var(--sui-accent); border-radius: 3px;"></div>
                                        </div>
                                        <div style="display: flex; justify-content: space-between; font-size: 11px; margin-top: 4px;">
                                            <span>In Review</span>
                                            <span style="color: var(--sui-muted);">15%</span>
                                        </div>
                                        <div style="height: 6px; background: var(--sui-bg-secondary); border-radius: 3px; overflow: hidden;">
                                            <div style="width: 15%; height: 100%; background: #f59e0b; border-radius: 3px;"></div>
                                        </div>
                                    </div>
                                    break;
                                case "servers":
                                    <div style="display: flex; flex-direction: column; gap: 6px;">
                                        <div style="display: flex; align-items: center; gap: 8px; font-size: 11px;">
                                            <span style="width: 8px; height: 8px; border-radius: 50%; background: #10b981;"></span>
                                            <span>Web-01 — Online</span>
                                        </div>
                                        <div style="display: flex; align-items: center; gap: 8px; font-size: 11px;">
                                            <span style="width: 8px; height: 8px; border-radius: 50%; background: #10b981;"></span>
                                            <span>Web-02 — Online</span>
                                        </div>
                                        <div style="display: flex; align-items: center; gap: 8px; font-size: 11px;">
                                            <span style="width: 8px; height: 8px; border-radius: 50%; background: #ef4444;"></span>
                                            <span>DB-01 — Offline</span>
                                        </div>
                                    </div>
                                    break;
                            }
                        </WidgetTemplate>
                    </SgDashboard>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_properties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Column Spanning</h2>
        <p>Widgets can span multiple columns and rows.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgDashboard Items="_spanWidgets" Columns="3">
                        <WidgetTemplate>
                            <div style="text-align: center; padding: 16px; color: var(--sui-muted);">
                                @context.Title
                            </div>
                        </WidgetTemplate>
                    </SgDashboard>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_spanProperties" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private List<SgDashboardWidgetItem> _widgets = new()
    {
        new() { Id = "revenue", Title = "Revenue", Icon = SgIcons.TrendingUp, ColumnSpan = 1 },
        new() { Id = "users", Title = "Users", Icon = SgIcons.BarChart, ColumnSpan = 1 },
        new() { Id = "tasks", Title = "Task Progress", Icon = SgIcons.Check, ColumnSpan = 2 },
        new() { Id = "servers", Title = "Servers", Icon = SgIcons.Settings, ColumnSpan = 2 }
    };

    private List<SgDashboardWidgetItem> _spanWidgets = new()
    {
        new() { Id = "a", Title = "1 column", ColumnSpan = 1 },
        new() { Id = "b", Title = "2 columns", ColumnSpan = 2 },
        new() { Id = "c", Title = "1 column", ColumnSpan = 1 },
        new() { Id = "d", Title = "3 columns", ColumnSpan = 3 }
    };

    private List<PropertyPanelItem> _properties = new()
    {
        new() { Label = "Items", Value = "List<SgDashboardWidgetItem>", BadgeText = "Widget list", BadgeVariant = "warn" },
        new() { Label = "ItemsChanged", Value = "EventCallback<List>", BadgeText = "Reorder/resize/delete", BadgeVariant = "success" },
        new() { Label = "Columns", Value = "int (default: 3)", BadgeText = "Grid columns", BadgeVariant = "info" },
        new() { Label = "AllowResize", Value = "bool", BadgeText = "Resize buttons", BadgeVariant = "warn" },
        new() { Label = "AllowDelete", Value = "bool", BadgeText = "Delete buttons", BadgeVariant = "warn" },
        new() { Label = "MaxColumnSpan", Value = "int (default: 6)", BadgeText = "Width limit", BadgeVariant = "info" },
        new() { Label = "WidgetTemplate", Value = "RenderFragment", BadgeText = "Content", BadgeVariant = "info" },
        new() { Label = "CssClass", Value = "string", BadgeText = "Custom CSS", BadgeVariant = "info" }
    };

    private List<PropertyPanelItem> _spanProperties = new()
    {
        new() { Label = "ColumnSpan", Value = "int (default: 1)", BadgeText = "Grid span", BadgeVariant = "info" },
        new() { Label = "RowSpan", Value = "int (default: 1)", BadgeText = "Row span", BadgeVariant = "info" },
        new() { Label = "Icon", Value = "string?", BadgeText = "SVG markup", BadgeVariant = "info" },
        new() { Label = "Tag", Value = "object?", BadgeText = "Custom data", BadgeVariant = "info" }
    };
}
