@page "/three-demo"
@using SuperUI.Components

<PageTitle>3D Склад — SUI</PageTitle>

<div class="wh-page">

    <!-- ── Шапка ──────────────────────────────────────────────────────── -->
    <div class="wh-header">
        <div class="wh-header-left">
            <h1 class="wh-title">🏭 3D Схема склада</h1>
            <p class="wh-subtitle">Интерактивная визуализация на Three.js — кликайте на ячейки, меняйте статусы, управляйте камерой</p>
        </div>
        <div class="wh-header-right">
            <div class="wh-legend">
                <div class="wh-legend-item"><span class="wh-dot wh-dot-empty"></span>Свободно</div>
                <div class="wh-legend-item"><span class="wh-dot wh-dot-occupied"></span>Занято</div>
                <div class="wh-legend-item"><span class="wh-dot wh-dot-reserved"></span>Зарезервировано</div>
                <div class="wh-legend-item"><span class="wh-dot wh-dot-blocked"></span>Заблокировано</div>
                <div class="wh-legend-item"><span class="wh-dot wh-dot-hover"></span>Hover</div>
            </div>
        </div>
    </div>

    <!-- ── Тулбар ─────────────────────────────────────────────────────── -->
    <div class="wh-toolbar">
        <div class="wh-toolbar-group">
            <span class="wh-toolbar-label">Ряды</span>
            @foreach (var n in new[]{ 3, 5, 8 })
            {
                var nn = n;
                <button class="wh-btn @(_warehouseRows == nn ? "active" : "")"
                        @onclick="@(() => { _warehouseRows = nn; RebuildWarehouse(); })">@nn</button>
            }
        </div>
        <div class="wh-toolbar-sep"></div>
        <div class="wh-toolbar-group">
            <span class="wh-toolbar-label">Колонки</span>
            @foreach (var n in new[]{ 6, 10, 15 })
            {
                var nn = n;
                <button class="wh-btn @(_warehouseCols == nn ? "active" : "")"
                        @onclick="@(() => { _warehouseCols = nn; RebuildWarehouse(); })">@nn</button>
            }
        </div>
        <div class="wh-toolbar-sep"></div>
        <div class="wh-toolbar-group">
            <span class="wh-toolbar-label">Уровни</span>
            @foreach (var n in new[]{ 2, 3, 5 })
            {
                var nn = n;
                <button class="wh-btn @(_warehouseLevels == nn ? "active" : "")"
                        @onclick="@(() => { _warehouseLevels = nn; RebuildWarehouse(); })">@nn</button>
            }
        </div>
        <div class="wh-toolbar-sep"></div>
        <div class="wh-toolbar-group">
            <button class="wh-btn wh-btn-accent" @onclick="RandomizeWarehouse">↻ Случайно</button>
        </div>
        <div class="wh-toolbar-sep"></div>
        <div class="wh-toolbar-group">
            <span class="wh-toolbar-label">Камера</span>
            <button class="wh-btn" @onclick="@(() => _warehouseThree?.SetCameraPositionAsync(0, 12, 18))">⊙ Перспектива</button>
            <button class="wh-btn" @onclick="@(() => _warehouseThree?.SetCameraPositionAsync(0, 30, 0.1))">↑ Сверху</button>
            <button class="wh-btn" @onclick="@(() => _warehouseThree?.SetCameraPositionAsync(25, 4, 0))">→ Сбоку</button>
            <button class="wh-btn" @onclick="@(() => _warehouseThree?.ResetCameraAsync())">↺ Сброс</button>
        </div>

        <!-- Статистика в тулбаре -->
        <div class="wh-toolbar-stats">
            <span class="wh-stat-chip wh-stat-total">Всего: <b>@_whStats.Total</b></span>
            <span class="wh-stat-chip wh-stat-empty">Своб: <b>@_whStats.Empty</b></span>
            <span class="wh-stat-chip wh-stat-occupied">Занято: <b>@_whStats.Occupied</b></span>
            <span class="wh-stat-chip wh-stat-reserved">Резерв: <b>@_whStats.Reserved</b></span>
            <span class="wh-stat-chip wh-stat-blocked">Блок: <b>@_whStats.Blocked</b></span>
            @if (_whStats.Total > 0)
            {
                <span class="wh-stat-chip wh-stat-fill">
                    <b>@((_whStats.Occupied * 100 / _whStats.Total))%</b> заполнено
                </span>
            }
        </div>
    </div>

    <!-- ── Основная область ────────────────────────────────────────────── -->
    <div class="wh-main">

        <!-- 3D сцена -->
        <div class="wh-scene-wrap">
            <SgThree @ref="_warehouseThree"
                     Scene="SgThreeScene.Warehouse"
                     WarehouseLayout="@_warehouseLayout"
                     Options="@_warehouseOpts"
                     Height="100%"
                     ShowToolbar="true"
                     OnObjectClick="OnWarehouseClick" />
        </div>

        <!-- Панель ячейки -->
        <div class="wh-panel @(_selectedCell is not null ? "wh-panel-open" : "")">
            @if (_selectedCell is not null)
            {
                <div class="wh-panel-header">
                    <span class="wh-panel-id">@_selectedCell.Id</span>
                    <button class="wh-panel-close" @onclick="() => { _selectedCell = null; StateHasChanged(); }">✕</button>
                </div>

                <div class="wh-panel-body">
                    <!-- Статус -->
                    <div class="wh-panel-section">
                        <div class="wh-panel-section-title">Статус</div>
                        <div class="wh-status-grid">
                            @foreach (var s in Enum.GetValues<SgWarehouseCellStatus>())
                            {
                                var ss = s;
                                <button class="wh-status-btn wh-status-@ss.ToString().ToLower() @(_selectedCell.Status == ss ? "active" : "")"
                                        @onclick="@(() => SetCellStatus(ss))">
                                    <span class="wh-status-dot"></span>
                                    @ss
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Координаты -->
                    <div class="wh-panel-section">
                        <div class="wh-panel-section-title">Расположение</div>
                        <div class="wh-info-grid">
                            <div class="wh-info-item">
                                <span class="wh-info-label">Ряд</span>
                                <span class="wh-info-value">@_selectedCell.Row</span>
                            </div>
                            <div class="wh-info-item">
                                <span class="wh-info-label">Колонка</span>
                                <span class="wh-info-value">@_selectedCell.Column</span>
                            </div>
                            <div class="wh-info-item">
                                <span class="wh-info-label">Уровень</span>
                                <span class="wh-info-value">@_selectedCell.Level</span>
                            </div>
                        </div>
                    </div>

                    <!-- Содержимое -->
                    @if (_selectedCell.Status == SgWarehouseCellStatus.Occupied)
                    {
                        <div class="wh-panel-section">
                            <div class="wh-panel-section-title">Содержимое</div>
                            <div class="wh-info-grid">
                                @if (!string.IsNullOrEmpty(_selectedCell.Label))
                                {
                                    <div class="wh-info-item wh-info-wide">
                                        <span class="wh-info-label">SKU</span>
                                        <code class="wh-info-code">@_selectedCell.Label</code>
                                    </div>
                                }
                                @if (_selectedCell.Quantity.HasValue)
                                {
                                    <div class="wh-info-item">
                                        <span class="wh-info-label">Кол-во</span>
                                        <span class="wh-info-value wh-info-qty">@_selectedCell.Quantity шт.</span>
                                    </div>
                                }
                                @if (_selectedCell.WeightKg.HasValue)
                                {
                                    <div class="wh-info-item">
                                        <span class="wh-info-label">Вес</span>
                                        <span class="wh-info-value">@_selectedCell.WeightKg?.ToString("F1") кг</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(_selectedCell.UpdatedAt))
                                {
                                    <div class="wh-info-item wh-info-wide">
                                        <span class="wh-info-label">Обновлено</span>
                                        <span class="wh-info-value wh-info-date">@_selectedCell.UpdatedAt</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="wh-panel-empty">
                    <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.3">
                        <rect x="2" y="3" width="20" height="14" rx="2"/>
                        <path d="M8 21h8M12 17v4"/>
                        <circle cx="12" cy="10" r="3"/>
                    </svg>
                    <p>Кликните на ячейку</p>
                </div>
            }
        </div>

    </div>
</div>

@code {
    private static readonly Random _rnd = new(Environment.TickCount);

    private SgThree?          _warehouseThree;
    private int               _warehouseRows   = 5;
    private int               _warehouseCols   = 10;
    private int               _warehouseLevels = 3;
    private SgWarehouseLayout _warehouseLayout = new();
    private SgWarehouseCell?  _selectedCell;

    private readonly SgThreeOptions _warehouseOpts = new()
    {
        BackgroundColor      = "#060d1a",
        OrbitControls        = true,
        AmbientIntensity     = 0.55,
        DirectionalIntensity = 0.75,
        Fov                  = 52,
    };

    private record WhStats(int Total, int Empty, int Occupied, int Reserved, int Blocked);
    private WhStats _whStats = new(0, 0, 0, 0, 0);

    private static readonly string[] _skuPrefixes = ["SKU","ART","REF","BOX","PLT","PKG"];
    private static readonly string[] _categories  = ["Электроника","Одежда","Продукты","Химия","Металл","Пластик","Бумага","Стекло"];

    private void RebuildWarehouse()
    {
        var rowLabels = "ABCDEFGHIJKLMNOP".Take(_warehouseRows).Select(c => c.ToString()).ToList();
        var cells     = new List<SgWarehouseCell>();

        foreach (var row in rowLabels)
            for (int col = 1; col <= _warehouseCols; col++)
                for (int lv = 1; lv <= _warehouseLevels; lv++)
                {
                    var status = _rnd.NextDouble() switch
                    {
                        < 0.45 => SgWarehouseCellStatus.Occupied,
                        < 0.55 => SgWarehouseCellStatus.Reserved,
                        < 0.60 => SgWarehouseCellStatus.Blocked,
                        _      => SgWarehouseCellStatus.Empty,
                    };

                    var cell = new SgWarehouseCell
                    {
                        Id     = $"{row}-{col:D2}-{lv}",
                        Row    = row,
                        Column = col,
                        Level  = lv,
                        Status = status,
                    };

                    if (status == SgWarehouseCellStatus.Occupied)
                    {
                        var prefix = _skuPrefixes[_rnd.Next(_skuPrefixes.Length)];
                        cell.Label     = $"{prefix}-{_rnd.Next(10000, 99999)}";
                        cell.Quantity  = _rnd.Next(1, 200);
                        cell.WeightKg  = Math.Round(0.5 + _rnd.NextDouble() * 499.5, 1);
                        cell.UpdatedAt = DateTime.Now.AddDays(-_rnd.Next(0, 30))
                                                     .ToString("dd.MM.yyyy HH:mm");
                    }
                    else if (status == SgWarehouseCellStatus.Reserved)
                    {
                        cell.Label = $"РЕЗЕРВ-{_rnd.Next(100, 999)}";
                    }

                    cells.Add(cell);
                }

        _warehouseLayout = new()
        {
            Rows    = rowLabels,
            Columns = _warehouseCols,
            Levels  = _warehouseLevels,
            Cells   = cells,
        };
        RecalcStats();
        _selectedCell = null;
        StateHasChanged();
    }

    private void RandomizeWarehouse()
    {
        _warehouseRows   = new[] { 3, 4, 5, 6, 8 }[_rnd.Next(5)];
        _warehouseCols   = new[] { 6, 8, 10, 12 }[_rnd.Next(4)];
        _warehouseLevels = new[] { 2, 3, 4, 5 }[_rnd.Next(4)];
        RebuildWarehouse();
    }

    private void RecalcStats()
    {
        var c = _warehouseLayout.Cells;
        _whStats = new(
            c.Count,
            c.Count(x => x.Status == SgWarehouseCellStatus.Empty),
            c.Count(x => x.Status == SgWarehouseCellStatus.Occupied),
            c.Count(x => x.Status == SgWarehouseCellStatus.Reserved),
            c.Count(x => x.Status == SgWarehouseCellStatus.Blocked));
    }

    private void OnWarehouseClick(SgThreeClickEventArgs e)
    {
        if (string.IsNullOrEmpty(e.Data)) return;
        try
        {
            _selectedCell = System.Text.Json.JsonSerializer.Deserialize<SgWarehouseCell>(
                e.Data,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        catch { _selectedCell = new() { Id = e.ObjectName }; }
        StateHasChanged();
    }

    private async Task SetCellStatus(SgWarehouseCellStatus status)
    {
        if (_selectedCell is null || _warehouseThree is null) return;

        // Update model
        _selectedCell.Status = status;
        if (status != SgWarehouseCellStatus.Occupied)
        {
            _selectedCell.Label    = status == SgWarehouseCellStatus.Reserved
                                        ? $"РЕЗЕРВ-{_rnd.Next(100,999)}" : null;
            _selectedCell.Quantity  = null;
            _selectedCell.WeightKg  = null;
            _selectedCell.UpdatedAt = null;
        }
        else if (_selectedCell.Quantity is null)
        {
            var prefix = _skuPrefixes[_rnd.Next(_skuPrefixes.Length)];
            _selectedCell.Label     = $"{prefix}-{_rnd.Next(10000,99999)}";
            _selectedCell.Quantity  = _rnd.Next(1, 200);
            _selectedCell.WeightKg  = Math.Round(0.5 + _rnd.NextDouble() * 499.5, 1);
            _selectedCell.UpdatedAt = DateTime.Now.ToString("dd.MM.yyyy HH:mm");
        }

        // Sync layout
        var existing = _warehouseLayout.Cells.FirstOrDefault(c => c.Id == _selectedCell.Id);
        if (existing is not null)
        {
            existing.Status    = _selectedCell.Status;
            existing.Label     = _selectedCell.Label;
            existing.Quantity  = _selectedCell.Quantity;
            existing.WeightKg  = _selectedCell.WeightKg;
            existing.UpdatedAt = _selectedCell.UpdatedAt;
        }

        RecalcStats();
        await _warehouseThree.UpdateWarehouseCellsAsync([_selectedCell]);
        StateHasChanged();
    }

    protected override void OnInitialized() => RebuildWarehouse();
}
