@page "/tabs-with-badge-demo"
@using SuperUI.Components

<PageTitle>TabsWithBadge — SUI</PageTitle>

<SgCard Title="SgTabsWithBadge — Табы с счётчиком"
        Subtitle="Горизонтальные и вертикальные вкладки с бейджами количества, lazy-загрузкой контента и возможностью закрытия. Полная доступность и клавиатурная навигация.">

    <div style="margin-top: 32px;">
        <h2>Базовый пример</h2>
        <p>Простой набор вкладок с бейджами. Бейджи могут содержать число или текст. Контент загружается только для активной вкладки (lazy-load).</p>

        <div style="margin-top: 16px; max-width: 800px;">
            <SgTabsWithBadge Items="_basicTabs" @bind-ActiveItemId="_basicActiveId" />
        </div>
        <div style="margin-top: 8px; color: var(--sui-text-muted); font-size: 12px;">
            Активная вкладка: <strong>@_basicActiveId</strong>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Закрываемые вкладки</h2>
        <p>Каждая вкладка может иметь кнопку закрытия. При закрытии активной вкладки автоматически активируется следующая.</p>

        <div style="margin-top: 16px; display: flex; gap: 12px; align-items: flex-start; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 300px;">
                <SgTabsWithBadge Items="_closableTabs" OnClose="HandleClosableClose" />
            </div>
            <div style="max-width: 240px;">
                <SgCard Title="Действия" Subtitle="Управление вкладками">
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        <SgButton Text="Добавить вкладку" OnClick="AddClosableTab" />
                        <SgButton Text="Удалить первую" Variant="SgButtonVariant.Outlined" OnClick="RemoveFirstClosableTab" />
                        <SgButton Text="Сбросить" Variant="SgButtonVariant.Ghost" OnClick="ResetClosableTabs" />
                    </div>
                </SgCard>
            </div>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Вертикальная ориентация</h2>
        <p>Вкладки можно располгать вертикально. Подходит для боковых панелей.</p>

        <div style="margin-top: 16px; display: flex; gap: 24px;">
            <div style="width: 200px; flex-shrink: 0;">
                <SgTabsWithBadge Items="_verticalTabs" Orientation="SgTabsOrientation.Vertical" />
            </div>
            <div style="flex: 1; padding: 12px; border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); background: var(--sui-bg-secondary);">
                <SgAlert Variant="SgAlertVariant.Info" Text="Контент активной вертикальной вкладки отображается справа. Обратите внимание на адаптивную навигацию с помощью стрелок вверх/вниз." />
            </div>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Вкладки с иконками</h2>
        <p>Использование иконок для визуального различия вкладок. Поддерживаются любые SVG-иконки или эмодзи.</p>

        <div style="margin-top: 16px; max-width: 700px;">
            <SgTabsWithBadge Items="_iconTabs" />
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Состояния и варианты</h2>
        <p>Вкладки могут быть отключены. Бейджи поддерживают несколько цветовых вариантов.</p>

        <div style="margin-top: 16px; max-width: 800px;">
            <SgTabsWithBadge Items="_mixedTabs" />
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Свойства компонента</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="SgTabsWithBadge">
                <PropertyTable Items="_componentProperties" />
            </SgCard>
            <SgCard Title="SgTabItem">
                <PropertyTable Items="_tabItemProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Примеры кода</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Базовое использование">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_basicCodeExample" />
            </SgCard>
            <SgCard Title="Динамические закрываемые вкладки">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_dynamicCodeExample" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private string? _basicActiveId;
    private int _closableCounter = 1;
    private List<SgTabItem> _closableTabs = new();
    private int _verticalCounter = 1;
    private List<SgTabItem> _verticalTabs = new();
    private List<SgTabItem> _iconTabs = new();
    private List<SgTabItem> _mixedTabs = new();

    // Switch states for vertical tabs demo
    private bool _profileNotify;
    private bool _twoFactor;
    private bool _notificationsEmail = true;
    private bool _notificationsPush;

    protected override void OnInitialized()
    {
        // Initialize basic tabs
        _basicTabs = new()
        {
            new()
            {
                Title = "Заказы",
                Badge = 12,
                IsClosable = false,
                Content = (RenderFragment)(@<div style="padding: 8px 0;">
                    <p>У вас <strong>12</strong> новых заказов. Обработайте их как можно скорее.</p>
                    <SgStatistic Title="Ожидающие" Value="12" />
                </div>)
            },
            new()
            {
                Title = "Счета",
                Badge = 3,
                IsClosable = false,
                Content = (RenderFragment)(@<div style="padding: 8px 0;">
                    <p>Требуется оплатить <strong>3</strong> счёта.</p>
                    <ul>
                        <li>Счёт #1023 — 15 000 ₽</li>
                        <li>Счёт #1024 — 7 500 ₽</li>
                        <li>Счёт #1025 — 2 000 ₽</li>
                    </ul>
                </div>)
            },
            new()
            {
                Title = "Документы",
                Badge = 7,
                IsClosable = false,
                Content = (RenderFragment)(@<div style="padding: 8px 0;">
                    <p>Новые документы для подписания: <strong>7</strong>.</p>
                    <SgButton Text="Показать все" Variant="SgButtonVariant.Ghost" />
                </div>)
            },
            new()
            {
                Title = "История",
                IsClosable = false,
                Content = (RenderFragment)(@<div style="padding: 8px 0;">
                    <SgTimeline Items="_basicTimeline" />
                </div>)
            }
        };

        // Initialize closable tabs with some initial items
        AddClosableTab();
        AddClosableTab();
        AddClosableTab();

        // Initialize vertical tabs
        _verticalTabs = new()
        {
            new()
            {
                Title = "Профиль",
                Icon = (RenderFragment)(@<span>👤</span>),
                IsClosable = false,
                Content = (RenderFragment)(@<div style="padding: 8px;">
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
                        <SgAvatar Initials="ИП" Color="#1890ff" Size="SgSize.Md" />
                        <div>
                            <div style="font-weight: 500;">Иван Петров</div>
                            <div style="font-size: 12px; color: var(--sui-text-muted);">ivan@example.com</div>
                        </div>
                    </div>
                    <SgStatistic Title="Роль" Value="Администратор" />
                    <SgStatistic Title="Отдел" Value="IT" />
                </div>)
            },
            new()
            {
                Title = "Безопасность",
                Icon = (RenderFragment)(@<span>🔒</span>),
                IsClosable = false,
                Content = (RenderFragment)(@<div style="padding: 8px;">
                    <SgAlert Variant="SgAlertVariant.Success" Text="Двухфакторная аутентификация включена." />
                    <div style="margin-top: 12px;">
                        <SgButton Text="Сменить пароль" Variant="SgButtonVariant.Outlined" />
                    </div>
                </div>)
            },
            new()
            {
                Title = "Уведомления",
                Icon = (RenderFragment)(@<span>🔔</span>),
                Badge = 5,
                IsClosable = false,
                Content = (RenderFragment)(@<div style="padding: 8px;">
                    <p>У вас <strong>5</strong> непрочитанных уведомлений.</p>
                    <SgButton Text="Показать все" Variant="SgButtonVariant.Ghost" />
                </div>)
            },
            new()
            {
                Title = "Настройки",
                Icon = (RenderFragment)(@<span>⚙️</span>),
                IsClosable = false,
                Content = (RenderFragment)(@<div style="padding: 8px;">
                    <SgStatistic Title="Тема" Value="Тёмная" />
                    <SgStatistic Title="Язык" Value="Русский" />
                    <div style="margin-top: 12px;">
                        <SgButton Text="Применить" Variant="SgButtonVariant.Primary" />
                    </div>
                </div>)
            }
        };

        // Initialize icon tabs
        _iconTabs = new()
        {
            new()
            {
                Title = "Дашборд",
                Icon = (RenderFragment)(@<span>📊</span>),
                IsClosable = false,
                Content = (RenderFragment)(@<div>
                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
                        <SgStatistic Title="Посетители" Value="12 345" TrendValue="0.12" />
                        <SgStatistic Title="Конверсия" Value="3.2%" TrendValue="-0.02" />
                        <SgStatistic Title="Доход" Value="98 765 ₽" TrendValue="0.25" />
                    </div>
                </div>)
            },
            new()
            {
                Title = "Пользователи",
                Icon = (RenderFragment)(@<span>👥</span>),
                Badge = 8,
                IsClosable = false,
                Content = (RenderFragment)(@<div>
                    <p>Управление пользователями системы.</p>
                    <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 12px;">
                        @foreach (var user in _sampleUsers)
                        {
                            <div style="display: flex; align-items: center; gap: 12px; padding: 8px; border: 1px solid var(--sui-border); border-radius: 6px;">
                                <SgAvatar Initials="@user.Initials" Color="@user.Color" Size="SgSize.Sm" />
                                <div>
                                    <div style="font-weight: 500;">@user.Name</div>
                                    <div style="font-size: 12px; color: var(--sui-text-muted);">@user.Role</div>
                                </div>
                                <SgBadge Text="@user.Status" Variant="@user.StatusVariant" />
                            </div>
                        }
                    </div>
                </div>)
            },
            new()
            {
                Title = "Настройки",
                Icon = (RenderFragment)(@<span>⚙️</span>),
                IsClosable = false,
                Content = (RenderFragment)(@<div>
                    <SgSwitch Value="_siteNotifications" Label="Уведомления сайта" />
                    <SgSwitch Value="_maintenanceMode" Label="Режим обслуживания" />
                </div>)
            }
        };

        // Mixed state tabs
        _mixedTabs = new()
        {
            new()
            {
                Title = "Активная",
                IsClosable = true,
                Content = (RenderFragment)(@<div>Эта вкладка активна и может быть закрыта.</div>)
            },
            new()
            {
                Title = "Отключена",
                IsDisabled = true,
                IsClosable = false,
                Content = (RenderFragment)(@<div>Эта вкладка отключена.</div>)
            },
            new()
            {
                Title = "С бейджем ( Danger )",
                Badge = 5,
                BadgeVariant = SgBadgeVariant.Danger,
                IsClosable = true,
                Content = (RenderFragment)(@<div>Критическое количество ошибок: 5</div>)
            },
            new()
            {
                Title = "С бейджем ( Success )",
                Badge = 99,
                BadgeVariant = SgBadgeVariant.Success,
                IsClosable = true,
                Content = (RenderFragment)(@<div>Система работает стабильно.</div>)
            }
        };
    }

    private List<SgTabItem> _basicTabs = new();

    private void AddClosableTab()
    {
        _closableTabs.Add(new()
        {
            Title = $"Вкладка {_closableCounter}",
            Badge = new Random().Next(0, 20),
            IsClosable = true,
            Content = (RenderFragment)(@<div style="padding: 12px 0;">
                <p>Это содержимое <strong>Вкладка @_closableCounter</strong>.</p>
                <SgStatistic Title="Время создания" Value="@DateTime.Now.ToString("HH:mm:ss")" />
            </div>)
        });
        _closableCounter++;
    }

    private void RemoveFirstClosableTab()
    {
        if (_closableTabs.Count > 0)
            _closableTabs.RemoveAt(0);
    }

    private void ResetClosableTabs()
    {
        _closableTabs.Clear();
        _closableCounter = 1;
    }

    private Task HandleClosableClose(SgTabItem tab)
    {
        _closableTabs.Remove(tab);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private readonly List<TimelineItem> _basicTimeline = new()
    {
        new() { Title = "Компонент создан", Time = "2026-01-10", Color = "#52c41a" },
        new() { Title = "Добавлены иконки", Time = "2026-02-15", Color = "#52c41a" },
        new() { Title = "Улучшена доступность", Time = "2026-03-20", Color = "#faad14" }
    };

    private record UserItem(string Name, string Initials, string Color, string Role, string Status, SgBadgeVariant StatusVariant);

    private readonly List<UserItem> _sampleUsers = new()
    {
        new("Иван Петров", "ИП", "#1890ff", "Администратор", "Активен", SgBadgeVariant.Success),
        new("Мария Сидорова", "МС", "#52c41a", "Менеджер", "Активен", SgBadgeVariant.Success),
        new("Алексей Козлов", "АК", "#722ed1", "Разработчик", "Отпуск", SgBadgeVariant.Warn),
        new("Елена Новикова", "ЕН", "#fa8c16", "Дизайнер", "Неактивен", SgBadgeVariant.Muted)
    };

    private bool _siteNotifications = true;
    private bool _maintenanceMode = false;
    private string _theme = "dark";
    private string _lang = "ru";
    private List<string> _themes = new() { "light", "dark", "system" };
    private List<string> _languages = new() { "Русский", "English", "Deutsch", "Français", "Español" };

    private UserModel? _userModel = new()
    {
        FirstName = "Иван",
        LastName = "Петров",
        Email = "ivan@example.com"
    };

    private NotificationSettings? _notifications = new()
    {
        Email = true,
        Push = false
    };

    private class UserModel
    {
        public string? FirstName { get; set; }
        public string? LastName { get; set; }
        public string? Email { get; set; }
        public bool TwoFactorEnabled { get; set; }
    }

    private class NotificationSettings
    {
        public bool Email { get; set; }
        public bool Push { get; set; }
    }

    // Property tables
    private List<PropertyPanelItem> _componentProperties = new()
    {
        new() { Label = "Items", Value = "IEnumerable<SgTabItem>", BadgeText = "Вкладки", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ActiveItemId", Value = "string?", BadgeText = "Активная вкладка", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ActiveItemIdChanged", Value = "EventCallback<string?>", BadgeText = "Изменение", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Orientation", Value = "SgTabsOrientation", BadgeText = "Ориентация", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "LazyLoad", Value = "bool", BadgeText = "Lazy загрузка", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "OnClose", Value = "EventCallback<SgTabItem>", BadgeText = "Закрытие", BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "CssClass", Value = "string?", BadgeText = "CSS класс", BadgeVariant = SgBadgeVariant.Muted },
        new() { Label = "Style", Value = "string?", BadgeText = "Инлайн стили", BadgeVariant = SgBadgeVariant.Muted },
        new() { Label = "AriaLabel", Value = "string?", BadgeText = "ARIA-label", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "AriaCloseLabel", Value = "string?", BadgeText = "ARIA-label кнопки", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "CloseTooltip", Value = "string?", BadgeText = "Tooltip закрытия", BadgeVariant = SgBadgeVariant.Info }
    };

    private List<PropertyPanelItem> _tabItemProperties = new()
    {
        new() { Label = "Title", Value = "string", BadgeText = "Заголовок", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Icon", Value = "RenderFragment?", BadgeText = "Иконка", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Badge", Value = "object?", BadgeText = "Счётчик", BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "BadgeVariant", Value = "SgBadgeVariant", BadgeText = "Стиль бейджа", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Content", Value = "RenderFragment?", BadgeText = "Контент", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "IsClosable", Value = "bool", BadgeText = "Закрываемая", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "IsDisabled", Value = "bool", BadgeText = "Отключена", BadgeVariant = SgBadgeVariant.Muted },
        new() { Label = "CssClass", Value = "string?", BadgeText = "CSS класс", BadgeVariant = SgBadgeVariant.Muted },
        new() { Label = "Tag", Value = "object?", BadgeText = "Пользовательские данные", BadgeVariant = SgBadgeVariant.Muted }
    };

    private string _basicCodeExample = """
        <SgTabsWithBadge Items="_tabs" @bind-ActiveItemId="_activeId" />

        @code {
            private string? _activeId;
            private List<SgTabItem> _tabs = new()
            {
                new() { Title = "Заказы", Badge = 12 },
                new() { Title = "Счета", Badge = 3 },
                new() { Title = "Документы", Badge = 7 },
                new() { Title = "История" }
            };
        }
        """;

    private string _dynamicCodeExample = """
        <SgTabsWithBadge Items="_tabs" OnClose="RemoveTab" />

        @code {
            private List<SgTabItem> _tabs = new();
            private int _counter = 1;

            private void AddTab()
            {
                _tabs.Add(new SgTabItem
                {
                    Title = $"Tab {_counter}",
                    Badge = new Random().Next(0, 20),
                    IsClosable = true,
                    Content = (RenderFragment)(@<div>Content of tab @_counter</div>)
                });
                _counter++;
            }

            private void RemoveTab(SgTabItem tab)
            {
                _tabs.Remove(tab);
            }
        }
        """;
}
