@page "/charts-demo"
@using SuperUI.Components

<PageTitle>Графики и визуализация - SUI</PageTitle>

<SgCard Title="SgChart - Графики"
        Subtitle="Полнофункциональная библиотека графиков для визуализации данных. Поддерживает мульти-серии, стэкинг, кастомные тултипы, встроенный тулбар, экспорт и оптимизацию больших наборов.">

    <!-- Линейные и площадные -->
    <div style="margin-top: 32px;">
        <h2>📈 Линейные и площадные графики</h2>
        <p>Сглаживание (<code>LineTension</code>), точки на линии, мульти-серии, общий тултип по индексу.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Мульти-серии (сглаженные)">
                <SgChart TItem="MonthlyKpi"
                         ChartType="SgChartType.Line"
                         Data="_kpiData"
                         Series="_kpiSeries"
                         Options="_smoothLineOptions"
                         Height="350px"
                         Width="100%"
                         Title="Продажи vs Цель vs Прогноз" />
            </SgCard>

            <SgCard Title="Площадной с заливкой">
                <SgChart TItem="MonthlyKpi"
                         ChartType="SgChartType.Area"
                         Data="_kpiData"
                         Series="_revenueSeriesOnly"
                         Options="_areaOptions"
                         Height="350px"
                         Width="100%"
                         Title="Выручка, тыс. ₽" />
            </SgCard>
        </div>
    </div>

    <!-- Столбчатые: обычный и стэк -->
    <div style="margin-top: 32px;">
        <h2>📊 Столбчатые графики</h2>
        <p>Вертикальные/горизонтальные столбцы, стэкинг (<code>Stacked = true</code>) для сравнения долей.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Стэк по каналам продаж">
                <SgChart TItem="ChannelSales"
                         ChartType="SgChartType.Bar"
                         Data="_channelData"
                         Series="_channelSeries"
                         Options="_stackedBarOptions"
                         Height="350px"
                         Width="100%"
                         Title="Продажи по каналам (стэк)" />
            </SgCard>

            <SgCard Title="Горизонтальный рейтинг">
                <SgChart TItem="ChartDataPoint"
                         ChartType="SgChartType.BarHorizontal"
                         Data="_rankingData"
                         Options="_rankingBarOptions"
                         Height="350px"
                         Width="100%"
                         Title="Топ продуктов" />
            </SgCard>
        </div>
    </div>

    <!-- Круговые -->
    <div style="margin-top: 32px;">
        <h2>🥧 Круговые графики</h2>
        <p>Pie / Doughnut с кастомной палитрой и hover-эффектом.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Pie">
                <SgChart TItem="ChartDataPoint"
                         ChartType="SgChartType.Pie"
                         Data="_pieChartData"
                         Options="_pieChartOptions"
                         Height="380px"
                         Width="100%"
                         Title="Распределение по категориям" />
            </SgCard>

            <SgCard Title="Doughnut с тёплой палитрой">
                <SgChart TItem="ChartDataPoint"
                         ChartType="SgChartType.Doughnut"
                         Data="_pieChartData"
                         Options="_customPieColorOptions"
                         Height="380px"
                         Width="100%"
                         Title="Доля рынка" />
            </SgCard>
        </div>
    </div>

    <!-- Точечные -->
    <div style="margin-top: 32px;">
        <h2>⚫ Точечные графики</h2>
        <p>Анализ корреляции и распределения с встроенным тулбаром.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Scatter с тулбаром">
                <SgChart TItem="ChartDataPoint"
                         ChartType="SgChartType.Scatter"
                         Data="_scatterChartData"
                         Options="_scatterChartOptions"
                         Height="400px"
                         Width="100%"
                         Title="Корреляция данных" />
            </SgCard>

            <SgCard Title="Возможности Scatter">
                <div style="font-size: 12px; line-height: 1.8;">
                    <div>✓ Точки с кастомным размером</div>
                    <div>✓ Поддержка X и Y координат</div>
                    <div>✓ Анализ корреляции</div>
                    <div>✓ Интерактивные подсказки</div>
                    <div>✓ Масштабирование колесом мыши</div>
                    <div>✓ Тулбар: <code>ShowToolbar = true</code></div>
                </div>
            </SgCard>
        </div>
    </div>

    <!-- Форматирование значений -->
    <div style="margin-top: 32px;">
        <h2>🎯 Форматирование значений</h2>
        <p>Параметры <code>ValueSuffix</code> и <code>ValueDecimals</code> добавляют единицы измерения и знаки после запятой в тултипах.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Проценты (%)">
                <SgChart TItem="ChartDataPoint"
                         ChartType="SgChartType.Line"
                         Data="_percentData"
                         Options="_percentOptions"
                         Height="320px"
                         Width="100%"
                         Title="Конверсия по неделям" />
            </SgCard>

            <SgCard Title="Время отклика (мс)">
                <SgChart TItem="ChartDataPoint"
                         ChartType="SgChartType.Bar"
                         Data="_latencyData"
                         Options="_latencyOptions"
                         Height="320px"
                         Width="100%"
                         Title="P95 латентность API" />
            </SgCard>
        </div>
    </div>

    <!-- Большие наборы данных -->
    <div style="margin-top: 32px;">
        <h2>⚡ Оптимизация больших наборов (LTTB)</h2>
        <p>Графики автоматически сжимают данные с сохранением формы. Ниже — синтетический ряд из 5000 точек.</p>

        <SgCard Title="5000 точек, decimation включена">
            <SgChart TItem="ChartDataPoint"
                     ChartType="SgChartType.Line"
                     Data="_largeData"
                     Options="_largeDataOptions"
                     Height="360px"
                     Width="100%"
                     Title="Метрика, агрегированная LTTB" />
        </SgCard>
    </div>

    <!-- Документация SgChartOptions -->
    <div style="margin-top: 32px;">
        <h2>📋 Параметры SgChartOptions</h2>
        <div style="margin-top: 16px; padding: 16px; background: #f5f5f5; border-radius: 8px; font-size: 12px; line-height: 1.8;">
            <div><strong>ShowGrid / ShowLabels / ShowLegend:</strong> bool — отображение сетки, меток, легенды</div>
            <div><strong>Responsive:</strong> bool — адаптивный размер</div>
            <div><strong>MinValue / MaxValue:</strong> double? — границы оси значений</div>
            <div><strong>EnableZoom:</strong> bool — масштабирование колесом мыши</div>
            <div><strong>EnableDecimation:</strong> bool — LTTB-оптимизация (порог <code>DecimationThreshold</code>, цель <code>DecimationTargetPoints</code>)</div>
            <div><strong>LineTension:</strong> double (0..1) — сглаживание линий</div>
            <div><strong>ShowPoints:</strong> bool — точки на линиях/областях</div>
            <div><strong>Stacked:</strong> bool — стэк столбцов/областей</div>
            <div><strong>ShowToolbar:</strong> bool — встроенная панель (сброс зума, экспорт PNG)</div>
            <div><strong>AnimationDuration:</strong> int мс — длительность анимации (0 — выключить)</div>
            <div><strong>ValueSuffix / ValueDecimals:</strong> единицы измерения и формат тултипов</div>
            <div><strong>SharedTooltip:</strong> bool — единый тултип по индексу для мульти-серий</div>
            <div><strong>Colors:</strong> List&lt;string&gt;? — палитра серий</div>
        </div>
    </div>

    <!-- Series API -->
    <div style="margin-top: 32px;">
        <h2>🧩 Мульти-серии (Series API)</h2>
        <p>Для отображения нескольких рядов из одного источника передайте параметр <code>Series</code>:</p>
        <div style="margin-top: 12px; padding: 16px; background: #1e1e1e; color: #e8e8e8; border-radius: 8px; font-family: monospace; font-size: 12px; line-height: 1.6; overflow-x: auto;">
<pre style="margin: 0;">private List&lt;SgChartSeries&lt;MonthlyKpi&gt;&gt; _series = new()
{
    new("Продажи", x =&gt; x.Sales),
    new("Цель",     x =&gt; x.Target),
    new("Прогноз",  x =&gt; x.Forecast)
};</pre>
        </div>
    </div>

    <!-- Типы графиков -->
    <div style="margin-top: 32px;">
        <h2>📊 Типы графиков (SgChartType)</h2>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px;">
            <div style="padding: 12px; background: #f5f5f5; border-radius: 8px;">
                <div><strong>Line</strong> — Линейный график для трендов</div>
                <div style="font-size: 11px; color: #666; margin-top: 4px;">Временные ряды, мульти-серии</div>
            </div>
            <div style="padding: 12px; background: #f5f5f5; border-radius: 8px;">
                <div><strong>Bar / BarHorizontal</strong> — Столбцы</div>
                <div style="font-size: 11px; color: #666; margin-top: 4px;">Сравнение категорий, поддержка стэка</div>
            </div>
            <div style="padding: 12px; background: #f5f5f5; border-radius: 8px;">
                <div><strong>Area</strong> — Площадной</div>
                <div style="font-size: 11px; color: #666; margin-top: 4px;">Объёмы, кумулятивные значения</div>
            </div>
            <div style="padding: 12px; background: #f5f5f5; border-radius: 8px;">
                <div><strong>Pie / Doughnut</strong> — Круговые</div>
                <div style="font-size: 11px; color: #666; margin-top: 4px;">Пропорции и доли</div>
            </div>
            <div style="padding: 12px; background: #f5f5f5; border-radius: 8px;">
                <div><strong>Scatter</strong> — Точечный</div>
                <div style="font-size: 11px; color: #666; margin-top: 4px;">Корреляция переменных</div>
            </div>
            <div style="padding: 12px; background: #f5f5f5; border-radius: 8px;">
                <div><strong>Heatmap</strong> — Тепловая карта</div>
                <div style="font-size: 11px; color: #666; margin-top: 4px;">2D-визуализация плотности</div>
            </div>
        </div>
    </div>

    <!-- Методы -->
    <div style="margin-top: 32px;">
        <h2>🔧 Методы компонента</h2>
        <div style="margin-top: 16px; padding: 16px; background: #f5f5f5; border-radius: 8px; font-size: 12px; line-height: 2;">
            <div><strong>RefreshAsync():</strong> Перерисовать график</div>
            <div><strong>UpdateDataAsync(data):</strong> Обновить данные</div>
            <div><strong>ZoomYAsync(min, max) / ResetZoomAsync():</strong> Управление масштабом</div>
            <div><strong>ExportImageAsync(format):</strong> Экспорт (png, jpg, svg)</div>
            <div><strong>GetImageDataUrlAsync(format):</strong> Получить data URL изображения</div>
            <div><strong>ResizeAsync():</strong> Принудительный пересчёт размеров</div>
        </div>
    </div>

    <!-- События -->
    <div style="margin-top: 32px;">
        <h2>📡 События</h2>
        <div style="margin-top: 16px; padding: 16px; background: #f5f5f5; border-radius: 8px; font-size: 12px; line-height: 2;">
            <div><strong>OnDataPointClick:</strong> SgChartClickEventArgs (DatasetIndex, DataPointIndex, Value, Label)</div>
        </div>
    </div>

</SgCard>

@code {
    public class ChartDataPoint
    {
        public string? Label { get; set; }
        public double Value { get; set; }
    }

    public class MonthlyKpi
    {
        public string? Label { get; set; }
        public double Sales { get; set; }
        public double Target { get; set; }
        public double Forecast { get; set; }
    }

    public class ChannelSales
    {
        public string? Label { get; set; }
        public double Online { get; set; }
        public double Retail { get; set; }
        public double Wholesale { get; set; }
    }

    // === Multi-series KPI ===
    private List<MonthlyKpi> _kpiData = new()
    {
        new() { Label = "Янв", Sales = 65, Target = 70, Forecast = 68 },
        new() { Label = "Фев", Sales = 59, Target = 70, Forecast = 64 },
        new() { Label = "Мар", Sales = 80, Target = 75, Forecast = 78 },
        new() { Label = "Апр", Sales = 81, Target = 80, Forecast = 83 },
        new() { Label = "Май", Sales = 76, Target = 82, Forecast = 79 },
        new() { Label = "Июн", Sales = 85, Target = 84, Forecast = 88 },
        new() { Label = "Июл", Sales = 92, Target = 86, Forecast = 91 },
        new() { Label = "Авг", Sales = 95, Target = 90, Forecast = 96 }
    };

    private List<SgChartSeries<MonthlyKpi>> _kpiSeries = new()
    {
        new("Продажи",  x => x.Sales),
        new("Цель",     x => x.Target),
        new("Прогноз",  x => x.Forecast)
    };

    private List<SgChartSeries<MonthlyKpi>> _revenueSeriesOnly = new()
    {
        new("Выручка", x => x.Sales * 12.5)
    };

    private SgChartOptions _smoothLineOptions = new()
    {
        ShowLegend = true,
        Responsive = true,
        EnableZoom = true,
        SharedTooltip = true,
        LineTension = 0.4,
        ShowPoints = true,
        ShowToolbar = true
    };

    private SgChartOptions _areaOptions = new()
    {
        ShowLegend = true,
        Responsive = true,
        BorderColor = "#10b981",
        BackgroundColor = "rgba(16, 185, 129, 0.5)",
        ValueSuffix = " тыс. ₽",
        ValueDecimals = 0,
        LineTension = 0.35
    };

    // === Stacked bar ===
    private List<ChannelSales> _channelData = new()
    {
        new() { Label = "Q1", Online = 120, Retail = 80, Wholesale = 60 },
        new() { Label = "Q2", Online = 150, Retail = 95, Wholesale = 70 },
        new() { Label = "Q3", Online = 180, Retail = 110, Wholesale = 85 },
        new() { Label = "Q4", Online = 220, Retail = 130, Wholesale = 100 }
    };

    private List<SgChartSeries<ChannelSales>> _channelSeries = new()
    {
        new("Онлайн",   x => x.Online),
        new("Розница",  x => x.Retail),
        new("Опт",      x => x.Wholesale)
    };

    private SgChartOptions _stackedBarOptions = new()
    {
        ShowLegend = true,
        Responsive = true,
        Stacked = true,
        SharedTooltip = true,
        ValueSuffix = " шт.",
        ShowToolbar = true
    };

    // === Ranking horizontal bar ===
    private List<ChartDataPoint> _rankingData = new()
    {
        new() { Label = "Продукт A", Value = 245 },
        new() { Label = "Продукт B", Value = 198 },
        new() { Label = "Продукт C", Value = 167 },
        new() { Label = "Продукт D", Value = 134 },
        new() { Label = "Продукт E", Value = 89 }
    };

    private SgChartOptions _rankingBarOptions = new()
    {
        ShowLegend = false,
        Responsive = true,
        BorderColor = "#8b5cf6",
        BackgroundColor = "rgba(139, 92, 246, 0.6)"
    };

    // === Pie ===
    private List<ChartDataPoint> _pieChartData = new()
    {
        new() { Label = "Категория A", Value = 30 },
        new() { Label = "Категория B", Value = 25 },
        new() { Label = "Категория C", Value = 20 },
        new() { Label = "Категория D", Value = 15 },
        new() { Label = "Категория E", Value = 10 }
    };

    private SgChartOptions _pieChartOptions = new()
    {
        ShowLegend = true,
        Responsive = true
    };

    private SgChartOptions _customPieColorOptions = new()
    {
        ShowLegend = true,
        Responsive = true,
        Colors = new List<string> { "#ff7e5f", "#feb47b", "#ff6b6b", "#feca57", "#48dbfb" }
    };

    // === Scatter ===
    private List<ChartDataPoint> _scatterChartData = new()
    {
        new() { Label = "Точка 1", Value = 10 },
        new() { Label = "Точка 2", Value = 20 },
        new() { Label = "Точка 3", Value = 15 },
        new() { Label = "Точка 4", Value = 25 },
        new() { Label = "Точка 5", Value = 30 },
        new() { Label = "Точка 6", Value = 22 },
        new() { Label = "Точка 7", Value = 28 },
        new() { Label = "Точка 8", Value = 35 }
    };

    private SgChartOptions _scatterChartOptions = new()
    {
        ShowLegend = true,
        Responsive = true,
        EnableZoom = true,
        ShowToolbar = true
    };

    // === Percentage formatting ===
    private List<ChartDataPoint> _percentData = new()
    {
        new() { Label = "Нед. 1", Value = 2.4 },
        new() { Label = "Нед. 2", Value = 3.1 },
        new() { Label = "Нед. 3", Value = 2.9 },
        new() { Label = "Нед. 4", Value = 3.8 },
        new() { Label = "Нед. 5", Value = 4.2 },
        new() { Label = "Нед. 6", Value = 4.0 },
        new() { Label = "Нед. 7", Value = 4.7 }
    };

    private SgChartOptions _percentOptions = new()
    {
        ShowLegend = false,
        Responsive = true,
        ValueSuffix = "%",
        ValueDecimals = 1,
        BorderColor = "#06b6d4",
        BackgroundColor = "rgba(6, 182, 212, 0.5)"
    };

    // === Latency ===
    private List<ChartDataPoint> _latencyData = new()
    {
        new() { Label = "/api/users",    Value = 42 },
        new() { Label = "/api/orders",   Value = 87 },
        new() { Label = "/api/products", Value = 31 },
        new() { Label = "/api/search",   Value = 156 },
        new() { Label = "/api/auth",     Value = 24 }
    };

    private SgChartOptions _latencyOptions = new()
    {
        ShowLegend = false,
        Responsive = true,
        ValueSuffix = " мс",
        ValueDecimals = 0,
        BorderColor = "#ef4444",
        BackgroundColor = "rgba(239, 68, 68, 0.6)"
    };

    // === Large dataset ===
    private List<ChartDataPoint> _largeData = GenerateLargeDataset(5000);

    private SgChartOptions _largeDataOptions = new()
    {
        ShowLegend = false,
        Responsive = true,
        EnableZoom = true,
        EnableDecimation = true,
        DecimationThreshold = 1000,
        DecimationTargetPoints = 800,
        BorderColor = "#2563eb",
        BackgroundColor = "rgba(37, 99, 235, 0.4)",
        ShowPoints = false,
        LineTension = 0.2,
        ShowToolbar = true
    };

    private static List<ChartDataPoint> GenerateLargeDataset(int count)
    {
        var rnd = new Random(42);
        var list = new List<ChartDataPoint>(count);
        double v = 50;
        for (int i = 0; i < count; i++)
        {
            v += (rnd.NextDouble() - 0.5) * 6 + Math.Sin(i / 120.0) * 0.8;
            list.Add(new ChartDataPoint { Label = i.ToString(), Value = Math.Round(v, 2) });
        }
        return list;
    }
}
