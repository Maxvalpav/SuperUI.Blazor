    // ── Clusters ──────────────────────────────────────────────────────────────
    private int _clusterCount = 3;
    private int _clusterPoints = 150;
    private List<ChartDataPoint> _clusterData = new();
    private SgChartOptions _clusterOpts = new()
    {
        ShowLegend = false, Responsive = true, ShowToolbar = true, EnableZoom = true,
    };

    private void RegenerateClusters()
    {
        var centers = Enumerable.Range(0, _clusterCount)
            .Select(_ => (x: _rnd.NextDouble() * 80 + 10, y: _rnd.NextDouble() * 80 + 10))
            .ToList();
        _clusterData = Enumerable.Range(0, _clusterPoints).Select(i =>
        {
            var c = centers[i % _clusterCount];
            return new ChartDataPoint(
                $"P{i}",
                Math.Round(c.y + (_rnd.NextDouble() - 0.5) * 20, 1));
        }).ToList();
    }

    // ── Big data ──────────────────────────────────────────────────────────────
    private int _bigDataPoints = 5000;
    private string _bigDataShape = "Шум";
    private List<ChartDataPoint> _bigData = new();
    private SgChartOptions _bigDataOpts = new()
    {
        ShowLegend = false, Responsive = true, ShowToolbar = true,
        EnableZoom = true, EnableDecimation = true,
        DecimationThreshold = 500, DecimationTargetPoints = 400,
        ShowPoints = false, LineTension = 0.1,
        Colors = ["#2563eb"], ValueDecimals = 1,
    };

    private void RegenerateBigData()
    {
        var list = new List<ChartDataPoint>(_bigDataPoints);
        double v = 50;
        for (int i = 0; i < _bigDataPoints; i++)
        {
            v += _bigDataShape switch
            {
                "Синус" => Math.Sin(i / 50.0) * 3 + (_rnd.NextDouble() - 0.5) * 2,
                "Пила"  => (i % 200 < 100 ? 1 : -1) * 0.5 + (_rnd.NextDouble() - 0.5) * 2,
                _       => (_rnd.NextDouble() - 0.5) * 8 + Math.Sin(i / 200.0) * 2,
            };
            list.Add(new(i.ToString(), Math.Round(v, 1)));
        }
        _bigData = list;
    }
