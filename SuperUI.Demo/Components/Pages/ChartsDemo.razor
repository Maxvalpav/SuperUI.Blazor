@page "/charts-demo"
@using SuperUI.Components

<PageTitle>Графики и визуализация - SUI</PageTitle>

<div class="charts-demo-page">

<div class="charts-demo-header">
    <div>
        <h1 class="charts-demo-title">SgChart</h1>
        <p class="charts-demo-subtitle">Chart.js интеграция — линейные, столбчатые, круговые, scatter, heatmap, мульти-серии, LTTB-decimation</p>
    </div>
</div>

<SgTabs>

<!-- ══════════════════════════════════════════════════════════
     Линейные / Площадные
══════════════════════════════════════════════════════════ -->
<SgTabPanel Title="📈 Линейные">
    <div class="charts-grid-2">

        <SgCard Title="Биржевые котировки — мульти-серии">
            <div class="charts-gen-bar">
                <span class="charts-gen-label">Период:</span>
                @foreach (var p in new[]{ ("1М",30), ("3М",90), ("6М",180), ("1Г",365) })
                {
                    var pp = p;
                    <button class="charts-gen-btn @(_stockPeriod == pp.Item2 ? "active" : "")"
                            @onclick="@(() => { _stockPeriod = pp.Item2; RegenerateStock(); })">@pp.Item1</button>
                }
                <button class="charts-gen-btn charts-gen-btn-refresh" @onclick="RegenerateStock">↻ Обновить</button>
            </div>
            <SgChart TItem="StockPoint"
                     ChartType="SgChartType.Line"
                     Data="@_stockData"
                     Series="@_stockSeries"
                     Options="@_stockOpts"
                     Height="320px" Width="100%" />
        </SgCard>

        <SgCard Title="Смешанный график — План vs Факт">
            <div class="charts-gen-bar">
                <button class="charts-gen-btn charts-gen-btn-refresh" @onclick="RegenerateMixed">↻ Обновить</button>
            </div>
            <SgChart TItem="MixedPoint"
                     Data="@_mixedData"
                     Series="@_mixedSeries"
                     Options="@_mixedOpts"
                     Height="320px" Width="100%" />
        </SgCard>

        <SgCard Title="Мониторинг CPU / RAM (Real-time)">
            <div class="charts-gen-bar">
                <span class="charts-gen-label">Интервал: 1 сек</span>
                <button class="charts-gen-btn @(_rtEnabled ? "active" : "")" @onclick="ToggleRT">@(_rtEnabled ? "Stop" : "Start")</button>
            </div>
            <SgChart TItem="ServerMetric"
                     ChartType="SgChartType.Line"
                     Data="@_monitorData"
                     Series="@_monitorSeries"
                     Options="@_monitorOpts"
                     Height="320px" Width="100%" />
        </SgCard>

        <SgCard Title="Прогноз продаж — с доверительным интервалом">
            <div class="charts-gen-bar">
                <button class="charts-gen-btn charts-gen-btn-refresh" @onclick="RegenerateForecast">↻ Новый прогноз</button>
            </div>
            <SgChart TItem="ForecastPoint"
                     ChartType="SgChartType.Line"
                     Data="@_forecastData"
                     Series="@_forecastSeries"
                     Options="@_forecastOpts"
                     Height="320px" Width="100%" />
        </SgCard>

    </div>
</SgTabPanel>

<!-- ══════════════════════════════════════════════════════════
     Столбчатые / Тепловые
══════════════════════════════════════════════════════════ -->
<SgTabPanel Title="📊 Столбчатые & Heatmap">
    <div class="charts-grid-2">

        <SgCard Title="Продажи по регионам — grouped">
            <div class="charts-gen-bar">
                <span class="charts-gen-label">Регионов:</span>
                @foreach (var n in new[]{ 4, 6, 8 })
                {
                    var nn = n;
                    <button class="charts-gen-btn @(_regionCount == nn ? "active" : "")"
                            @onclick="@(() => { _regionCount = nn; RegenerateRegions(); })">@nn</button>
                }
                <button class="charts-gen-btn charts-gen-btn-refresh" @onclick="RegenerateRegions">↻</button>
            </div>
            <SgChart TItem="RegionSales"
                     ChartType="SgChartType.Bar"
                     Data="@_regionData"
                     Series="@_regionSeries"
                     Options="@_regionOpts"
                     Height="320px" Width="100%" />
        </SgCard>

        <SgCard Title="Heatmap — Активность по часам">
            <div class="charts-gen-bar">
                <button class="charts-gen-btn charts-gen-btn-refresh" @onclick="RegenerateHeatmap">↻ Обновить</button>
            </div>
            <SgChart TItem="HeatmapData"
                     ChartType="SgChartType.Heatmap"
                     Data="@_heatmapData"
                     Options="@_heatmapOpts"
                     Height="320px" Width="100%" />
        </SgCard>

        <SgCard Title="Бюджет по отделам — stacked">
            <div class="charts-gen-bar">
                <button class="charts-gen-btn charts-gen-btn-refresh" @onclick="RegenerateBudget">↻ Новый бюджет</button>
                <label class="charts-gen-toggle">
                    <input type="checkbox" @bind="_budgetStacked" @bind:after="RegenerateBudget" />
                    Stacked
                </label>
            </div>
            <SgChart TItem="BudgetItem"
                     ChartType="SgChartType.Bar"
                     Data="@_budgetData"
                     Series="@_budgetSeries"
                     Options="@_budgetOpts"
                     Height="320px" Width="100%" />
        </SgCard>

        <SgCard Title="Горизонтальный — рейтинг продуктов">
            <div class="charts-gen-bar">
                <span class="charts-gen-label">Топ:</span>
                @foreach (var n in new[]{ 5, 8, 12 })
                {
                    var nn = n;
                    <button class="charts-gen-btn @(_topN == nn ? "active" : "")"
                            @onclick="@(() => { _topN = nn; RegenerateRanking(); })">@nn</button>
                }
                <button class="charts-gen-btn charts-gen-btn-refresh" @onclick="RegenerateRanking">↻</button>
            </div>
            <SgChart TItem="ChartDataPoint"
                     ChartType="SgChartType.BarHorizontal"
                     Data="@_rankingData"
                     Options="@_rankingOpts"
                     Height="320px" Width="100%" />
        </SgCard>

    </div>
</SgTabPanel>

<!-- ══════════════════════════════════════════════════════════
     Круговые
══════════════════════════════════════════════════════════ -->
<SgTabPanel Title="🥧 Круговые">
    <div class="charts-grid-2">

        <SgCard Title="Распределение трафика">
            <div class="charts-gen-bar">
                <span class="charts-gen-label">Сегментов:</span>
                @foreach (var n in new[]{ 4, 6, 8 })
                {
                    var nn = n;
                    <button class="charts-gen-btn @(_pieSegments == nn ? "active" : "")"
                            @onclick="@(() => { _pieSegments = nn; RegeneratePie(); })">@nn</button>
                }
                <button class="charts-gen-btn charts-gen-btn-refresh" @onclick="RegeneratePie">↻</button>
            </div>
            <SgChart TItem="ChartDataPoint"
                     ChartType="SgChartType.Pie"
                     Data="@_pieData"
                     Options="@_pieOpts"
                     Height="340px" Width="100%" />
        </SgCard>

        <SgCard Title="Доля рынка — Doughnut">
            <div class="charts-gen-bar">
                <span class="charts-gen-label">Палитра:</span>
                @foreach (var p in new[]{ "Стандарт","Тёплая","Холодная","Пастель" })
                {
                    var pp = p;
                    <button class="charts-gen-btn @(_donutPalette == pp ? "active" : "")"
                            @onclick="@(() => { _donutPalette = pp; ApplyDonutPalette(); })">@pp</button>
                }
            </div>
            <SgChart TItem="ChartDataPoint"
                     ChartType="SgChartType.Doughnut"
                     Data="@_donutData"
                     Options="@_donutOpts"
                     Height="340px" Width="100%" />
        </SgCard>

    </div>
</SgTabPanel>

<!-- ══════════════════════════════════════════════════════════
     Scatter / Большие данные
══════════════════════════════════════════════════════════ -->
<SgTabPanel Title="⚡ Scatter / Big Data">
    <div class="charts-grid-2">

        <SgCard Title="Scatter — кластеры данных">
            <div class="charts-gen-bar">
                <span class="charts-gen-label">Кластеров:</span>
                @foreach (var n in new[]{ 2, 3, 5 })
                {
                    var nn = n;
                    <button class="charts-gen-btn @(_clusterCount == nn ? "active" : "")"
                            @onclick="@(() => { _clusterCount = nn; RegenerateClusters(); })">@nn</button>
                }
                <span class="charts-gen-label" style="margin-left:8px">Точек:</span>
                @foreach (var n in new[]{ 50, 150, 300 })
                {
                    var nn = n;
                    <button class="charts-gen-btn @(_clusterPoints == nn ? "active" : "")"
                            @onclick="@(() => { _clusterPoints = nn; RegenerateClusters(); })">@nn</button>
                }
                <button class="charts-gen-btn charts-gen-btn-refresh" @onclick="RegenerateClusters">↻</button>
            </div>
            <SgChart TItem="ChartDataPoint"
                     ChartType="SgChartType.Scatter"
                     Data="@_clusterData"
                     Options="@_clusterOpts"
                     Height="340px" Width="100%" />
        </SgCard>

        <SgCard Title="LTTB Decimation — большой ряд">
            <div class="charts-gen-bar">
                <span class="charts-gen-label">Точек:</span>
                @foreach (var n in new[]{ 1000, 5000, 20000 })
                {
                    var nn = n;
                    <button class="charts-gen-btn @(_bigDataPoints == nn ? "active" : "")"
                            @onclick="@(() => { _bigDataPoints = nn; RegenerateBigData(); })">@(nn >= 1000 ? nn/1000 + "К" : nn.ToString())</button>
                }
                <span class="charts-gen-label" style="margin-left:8px">Форма:</span>
                @foreach (var s in new[]{ "Шум","Синус","Пила" })
                {
                    var ss = s;
                    <button class="charts-gen-btn @(_bigDataShape == ss ? "active" : "")"
                            @onclick="@(() => { _bigDataShape = ss; RegenerateBigData(); })">@ss</button>
                }
            </div>
            <SgChart TItem="ChartDataPoint"
                     ChartType="SgChartType.Line"
                     Data="@_bigData"
                     Options="@_bigDataOpts"
                     Height="340px" Width="100%" />
        </SgCard>

    </div>
</SgTabPanel>

<!-- ══════════════════════════════════════════════════════════
     API
══════════════════════════════════════════════════════════ -->
<SgTabPanel Title="📋 API">
    <div class="charts-api-page">
        <SgCard Title="Параметры SgChart&lt;TItem&gt;" style="margin-bottom:24px">
            <table class="charts-api-table">
                <thead><tr><th>Параметр</th><th>Тип</th><th>По умолчанию</th><th>Описание</th></tr></thead>
                <tbody>
                    <tr><td><code>ChartType</code></td><td>SgChartType</td><td>Line</td><td>Тип графика</td></tr>
                    <tr><td><code>Data</code></td><td>IEnumerable&lt;TItem&gt;?</td><td>null</td><td>Источник данных</td></tr>
                    <tr><td><code>Series</code></td><td>IReadOnlyList&lt;SgChartSeries&lt;TItem&gt;&gt;?</td><td>null</td><td>Явные серии с селекторами</td></tr>
                    <tr><td><code>Options</code></td><td>SgChartOptions?</td><td>defaults</td><td>Настройки отображения</td></tr>
                    <tr><td><code>Title</code></td><td>string?</td><td>null</td><td>Заголовок (рендерится Chart.js)</td></tr>
                    <tr><td><code>Height / Width</code></td><td>string</td><td>400px / 100%</td><td>Размеры контейнера</td></tr>
                    <tr><td><code>Sources</code></td><td>SgChartSources?</td><td>CDN</td><td>URL для Chart.js и плагинов</td></tr>
                    <tr><td><code>OnDataPointClick</code></td><td>EventCallback&lt;SgChartClickEventArgs&gt;</td><td>—</td><td>Клик по точке данных</td></tr>
                </tbody>
            </table>
        </SgCard>
        <SgCard Title="SgChartOptions" style="margin-bottom:24px">
            <table class="charts-api-table">
                <thead><tr><th>Свойство</th><th>Тип</th><th>По умолчанию</th><th>Описание</th></tr></thead>
                <tbody>
                    <tr><td><code>ShowGrid / ShowLabels / ShowLegend</code></td><td>bool</td><td>true</td><td>Сетка, метки, легенда</td></tr>
                    <tr><td><code>Responsive</code></td><td>bool</td><td>true</td><td>Адаптивный размер</td></tr>
                    <tr><td><code>MinValue / MaxValue</code></td><td>double?</td><td>null</td><td>Границы оси Y</td></tr>
                    <tr><td><code>EnableZoom</code></td><td>bool</td><td>false</td><td>Зум колесом (Ctrl)</td></tr>
                    <tr><td><code>EnableDecimation</code></td><td>bool</td><td>false</td><td>LTTB-прореживание</td></tr>
                    <tr><td><code>LineTension</code></td><td>double</td><td>0.35</td><td>Сглаживание линий (0–1)</td></tr>
                    <tr><td><code>ShowPoints</code></td><td>bool</td><td>true</td><td>Точки на линии</td></tr>
                    <tr><td><code>Stacked</code></td><td>bool</td><td>false</td><td>Стэкинг серий</td></tr>
                    <tr><td><code>ShowToolbar</code></td><td>bool</td><td>false</td><td>Тулбар (сброс зума, PNG)</td></tr>
                    <tr><td><code>AnimationDuration</code></td><td>int</td><td>400</td><td>Анимация, мс (0 = выкл)</td></tr>
                    <tr><td><code>ValueSuffix / ValueDecimals</code></td><td>string? / int?</td><td>null</td><td>Формат тултипов</td></tr>
                    <tr><td><code>SharedTooltip</code></td><td>bool</td><td>false</td><td>Общий тултип по индексу</td></tr>
                    <tr><td><code>Colors</code></td><td>List&lt;string&gt;?</td><td>null</td><td>Кастомная палитра</td></tr>
                </tbody>
            </table>
        </SgCard>
        <SgCard Title="Методы компонента">
            <table class="charts-api-table">
                <thead><tr><th>Метод</th><th>Возвращает</th><th>Описание</th></tr></thead>
                <tbody>
                    <tr><td><code>RefreshAsync()</code></td><td>Task</td><td>Перерисовать с текущими параметрами</td></tr>
                    <tr><td><code>UpdateDataAsync(data)</code></td><td>Task</td><td>Обновить данные и перерисовать</td></tr>
                    <tr><td><code>ZoomYAsync(min, max)</code></td><td>Task</td><td>Установить диапазон оси Y</td></tr>
                    <tr><td><code>ResetZoomAsync()</code></td><td>Task</td><td>Сбросить зум</td></tr>
                    <tr><td><code>ExportImageAsync(format)</code></td><td>Task</td><td>Скачать PNG/JPG</td></tr>
                    <tr><td><code>GetImageDataUrlAsync(format)</code></td><td>Task&lt;string?&gt;</td><td>Получить data URL</td></tr>
                    <tr><td><code>ResizeAsync()</code></td><td>Task</td><td>Пересчитать размеры</td></tr>
                </tbody>
            </table>
        </SgCard>
    </div>
</SgTabPanel>

</SgTabs>
</div>

@implements IDisposable
@code {
    // ── Model types ───────────────────────────────────────────────────────────
    public record ChartDataPoint(string? Label = null, double Value = 0);
    public record StockPoint(string? Label, double Price, double Sma, double Volume);
    public record ServerMetric(string? Label, double Cpu, double Ram, double Disk);
    public record ForecastPoint(string? Label, double Actual, double Forecast, double Upper, double Lower);
    public record RegionSales(string? Label, double North, double South, double East, double West, double Central);
    public record BudgetItem(string? Label, double Plan, double Fact, double Delta);
    public record MixedPoint(string Label, double Plan, double Fact);
    public record HeatmapData(List<SgChartMatrixPoint> MatrixData);

    private static readonly Random _rnd = new(Environment.TickCount);
    private System.Timers.Timer? _rtTimer;
    private bool _rtEnabled;

    protected override void OnInitialized()
    {
        RegenerateStock();
        RegenerateMixed();
        RegenerateMonitor();
        RegenerateForecast();
        RegenerateRegions();
        RegenerateHeatmap();
        RegenerateBudget();
        RegenerateRanking();
        RegeneratePie();
        RegenerateClusters();
        RegenerateBigData();

        _rtTimer = new System.Timers.Timer(1000);
        _rtTimer.Elapsed += async (s, e) => await TickRT();
    }

    public void Dispose()
    {
        _rtTimer?.Stop();
        _rtTimer?.Dispose();
    }

    private void ToggleRT()
    {
        _rtEnabled = !_rtEnabled;
        if (_rtEnabled) _rtTimer?.Start();
        else _rtTimer?.Stop();
    }

    private async Task TickRT()
    {
        if (!_rtEnabled) return;
        
        var last = _monitorData.LastOrDefault();
        double cpu = last?.Cpu ?? 30;
        double ram = last?.Ram ?? 55;
        double disk = last?.Disk ?? 40;

        cpu = Math.Clamp(cpu + (_rnd.NextDouble() - 0.5) * 15, 5, 95);
        ram = Math.Clamp(ram + (_rnd.NextDouble() - 0.5) * 5, 20, 90);
        
        // Ensure we don't grow the list indefinitely
        var newData = _monitorData.ToList();
        while (newData.Count >= _monitorPoints) newData.RemoveAt(0);
        
        newData.Add(new(DateTime.Now.ToString("HH:mm:ss"), Math.Round(cpu), Math.Round(ram), Math.Round(disk)));
        _monitorData = newData;
        
        await InvokeAsync(StateHasChanged);
    }

    // ── Stock chart ───────────────────────────────────────────────────────────
    private int _stockPeriod = 90;
    private List<StockPoint> _stockData = new();
    private List<SgChartSeries<StockPoint>> _stockSeries = new()
    {
        new("Цена",  x => x.Price),
        new("SMA20", x => x.Sma),
    };
    private SgChartOptions _stockOpts = new()
    {
        ShowLegend = true, Responsive = true, SharedTooltip = true,
        LineTension = 0.3, ShowPoints = false, ShowToolbar = true,
        EnableZoom = true, ValueSuffix = " ₽", ValueDecimals = 0,
        Colors = ["#2563eb", "#f59e0b"],
    };

    private void RegenerateStock()
    {
        var list = new List<StockPoint>(_stockPeriod);
        double price = 1200 + _rnd.NextDouble() * 400;
        var prices = new List<double>(_stockPeriod);
        for (int i = 0; i < _stockPeriod; i++)
        {
            price += (_rnd.NextDouble() - 0.48) * 30 + Math.Sin(i / 15.0) * 8;
            price = Math.Max(500, price);
            prices.Add(price);
        }
        for (int i = 0; i < _stockPeriod; i++)
        {
            var date = DateTime.Today.AddDays(i - _stockPeriod + 1);
            var sma = i >= 19 ? prices.Skip(i - 19).Take(20).Average() : prices.Take(i + 1).Average();
            list.Add(new(date.ToString("dd.MM"), Math.Round(prices[i]), Math.Round(sma), 0));
        }
        _stockData = list;
    }

    // ── Mixed Chart ───────────────────────────────────────────────────────────
    private List<MixedPoint> _mixedData = new();
    private List<SgChartSeries<MixedPoint>> _mixedSeries = new()
    {
        new("План (линия)", x => x.Plan, SgChartType.Line),
        new("Факт (столбцы)", x => x.Fact, SgChartType.Bar),
    };
    private SgChartOptions _mixedOpts = new()
    {
        ShowLegend = true, Responsive = true,
        Colors = ["#ef4444", "#3b82f6"],
        ValueSuffix = " шт.",
    };

    private void RegenerateMixed()
    {
        _mixedData = Enumerable.Range(1, 12).Select(i => new MixedPoint(
            $"{i} мес.",
            Math.Round(100 + i * 10 + _rnd.NextDouble() * 20),
            Math.Round(90 + i * 10 + _rnd.NextDouble() * 40)
        )).ToList();
    }

    // ── Heatmap ───────────────────────────────────────────────────────────────
    private List<HeatmapData> _heatmapData = new();
    private SgChartOptions _heatmapOpts = new() { ShowLegend = false, Responsive = true };
    private void RegenerateHeatmap()
    {
        var points = new List<SgChartMatrixPoint>();
        var days = new[] { "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс" };
        for (int d = 0; d < 7; d++)
        {
            for (int h = 0; h < 24; h += 2)
            {
                double val = _rnd.NextDouble() * 100;
                if (d >= 5) val *= 0.3; // Weekends lower
                if (h >= 9 && h <= 18) val *= 1.5; // Business hours higher
                points.Add(new SgChartMatrixPoint { X = $"{h}:00", Y = days[d], V = Math.Round(val) });
            }
        }
        _heatmapData = new List<HeatmapData> { new(points) };
    }

    // ── Monitor ───────────────────────────────────────────────────────────────
    private int _monitorPoints = 30;
    private List<ServerMetric> _monitorData = new();
    private List<SgChartSeries<ServerMetric>> _monitorSeries = new()
    {
        new("CPU %",  x => x.Cpu),
        new("RAM %",  x => x.Ram),
    };
    private SgChartOptions _monitorOpts = new()
    {
        ShowLegend = true, Responsive = true, SharedTooltip = true,
        LineTension = 0.4, ShowPoints = true,
        MinValue = 0, MaxValue = 100,
        Colors = ["#ef4444", "#3b82f6"],
    };

    private void RegenerateMonitor()
    {
        var list = new List<ServerMetric>(_monitorPoints);
        double cpu = 30, ram = 55, disk = 40;
        for (int i = 0; i < _monitorPoints; i++)
        {
            cpu  = Math.Clamp(cpu  + (_rnd.NextDouble() - 0.5) * 12, 5,  95);
            ram  = Math.Clamp(ram  + (_rnd.NextDouble() - 0.5) * 6,  20, 90);
            disk = Math.Clamp(disk + (_rnd.NextDouble() - 0.5) * 3,  30, 85);
            list.Add(new($"T-{_monitorPoints - i}", Math.Round(cpu), Math.Round(ram), Math.Round(disk)));
        }
        _monitorData = list;
    }

    // ── Forecast ──────────────────────────────────────────────────────────────
    private List<ForecastPoint> _forecastData = new();
    private List<SgChartSeries<ForecastPoint>> _forecastSeries = new()
    {
        new("Факт",     x => x.Actual),
        new("Прогноз",  x => x.Forecast),
        new("Верхняя",  x => x.Upper),
        new("Нижняя",   x => x.Lower),
    };
    private SgChartOptions _forecastOpts = new()
    {
        ShowLegend = true, Responsive = true, SharedTooltip = true,
        LineTension = 0.35, ShowPoints = false, ShowToolbar = true,
        ValueSuffix = " тыс.", ValueDecimals = 0,
        Colors = ["#2563eb", "#10b981", "#d1fae5", "#d1fae5"],
    };

    private void RegenerateForecast()
    {
        var list = new List<ForecastPoint>();
        double v = 200 + _rnd.NextDouble() * 100;
        var months = new[] { "Янв","Фев","Мар","Апр","Май","Июн","Июл","Авг","Сен","Окт","Ноя","Дек" };
        for (int i = 0; i < 12; i++)
        {
            v += (_rnd.NextDouble() - 0.4) * 30 + 5;
            double actual   = i < 8  ? Math.Round(v) : 0;
            double forecast = i >= 6 ? Math.Round(v * (1 + (_rnd.NextDouble() - 0.5) * 0.1)) : 0;
            double spread   = 20 + i * 3;
            list.Add(new(months[i], actual, forecast,
                forecast > 0 ? forecast + spread : 0,
                forecast > 0 ? forecast - spread : 0));
        }
        _forecastData = list;
    }

    // ── Regions ───────────────────────────────────────────────────────────────
    private int _regionCount = 6;
    private List<RegionSales> _regionData = new();
    private List<SgChartSeries<RegionSales>> _regionSeries = new()
    {
        new("Север",  x => x.North),
