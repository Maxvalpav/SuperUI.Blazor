@page "/charts-demo"
@using SuperUI.Components

<PageTitle>Графики и визуализация - SUI</PageTitle>

<SgCard Title="SgChart - Графики" 
        Subtitle="Полнофункциональная библиотека графиков для визуализации данных. Поддерживает 7 типов графиков, масштабирование, экспорт и оптимизацию больших наборов данных.">
    
    <!-- SgChart Line & Area -->
    <div style="margin-top: 32px;">
        <h2>📈 Линейные и площадные графики</h2>
        <p>Графики для отображения трендов и изменений во времени. Поддерживают множественные наборы данных и кастомизацию.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Линейный график">
                <SgChart TItem="ChartDataPoint" 
                         ChartType="SgChartType.Line" 
                         Data="_lineChartData" 
                         Options="_lineChartOptions" 
                         Height="350px" 
                         Width="100%"
                         Title="Продажи по месяцам" />
            </SgCard>

            <SgCard Title="Площадной график">
                <SgChart TItem="ChartDataPoint" 
                         ChartType="SgChartType.Area" 
                         Data="_lineChartData" 
                         Options="_areaChartOptions" 
                         Height="350px" 
                         Width="100%"
                         Title="Объем продаж" />
            </SgCard>
        </div>
    </div>

    <!-- SgChart Bar & Horizontal Bar -->
    <div style="margin-top: 32px;">
        <h2>📊 Столбчатые графики</h2>
        <p>Графики для сравнения категорий и дискретных значений. Поддерживают вертикальные и горизонтальные столбцы.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Вертикальные столбцы">
                <SgChart TItem="ChartDataPoint" 
                         ChartType="SgChartType.Bar" 
                         Data="_barChartData" 
                         Options="_barChartOptions" 
                         Height="350px" 
                         Width="100%"
                         Title="Заказы по месяцам" />
            </SgCard>

            <SgCard Title="Горизонтальные столбцы">
                <SgChart TItem="ChartDataPoint" 
                         ChartType="SgChartType.BarHorizontal" 
                         Data="_barChartData" 
                         Options="_barChartOptions" 
                         Height="350px" 
                         Width="100%"
                         Title="Заказы по месяцам" />
            </SgCard>
        </div>
    </div>

    <!-- SgChart Pie -->
    <div style="margin-top: 32px;">
        <h2>🥧 Круговые графики</h2>
        <p>Графики для отображения пропорций и процентов. Поддерживают Pie и Doughnut типы.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Пример использования">
                <SgChart TItem="ChartDataPoint" 
                         ChartType="SgChartType.Pie" 
                         Data="_pieChartData" 
                         Options="_pieChartOptions" 
                         Height="400px" 
                         Width="100%"
                         Title="Распределение по категориям" />
            </SgCard>

            <SgCard Title="Типы круговых графиков">
                <div style="font-size: 12px; line-height: 1.8;">
                    <div><strong>Pie:</strong> Классический круговой график</div>
                    <div><strong>Doughnut:</strong> Круговой график с отверстием в центре</div>
                    <div>✓ Автоматическое распределение цветов</div>
                    <div>✓ Легенда с процентами</div>
                    <div>✓ Интерактивные сегменты</div>
                </div>
            </SgCard>
        </div>
    </div>

    <!-- SgChart Scatter -->
    <div style="margin-top: 32px;">
        <h2>⚫ Точечные графики</h2>
        <p>Графики для анализа корреляции и распределения данных. Показывают отношения между переменными.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Пример использования">
                <SgChart TItem="ChartDataPoint" 
                         ChartType="SgChartType.Scatter" 
                         Data="_scatterChartData" 
                         Options="_scatterChartOptions" 
                         Height="400px" 
                         Width="100%"
                         Title="Корреляция данных" />
            </SgCard>

            <SgCard Title="Параметры Scatter">
                <div style="font-size: 12px; line-height: 1.8;">
                    <div>✓ Точки с кастомным размером</div>
                    <div>✓ Поддержка X и Y координат</div>
                    <div>✓ Анализ корреляции</div>
                    <div>✓ Интерактивные подсказки</div>
                    <div>✓ Масштабирование по осям</div>
                </div>
            </SgCard>
        </div>
    </div>

    <!-- Custom Colors Example -->
    <div style="margin-top: 32px;">
        <h2>🎨 Кастомные цвета</h2>
        <p>Настройте внешний вид графиков с помощью кастомных цветов и цветовых палитр.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Кастомные цвета для столбцов">
                <SgChart TItem="ChartDataPoint" 
                         ChartType="SgChartType.Bar" 
                         Data="_barChartData" 
                         Options="_customColorOptions" 
                         Height="350px" 
                         Width="100%"
                         Title="Продажи (зеленая тема)" />
            </SgCard>

            <SgCard Title="Кастомная палитра для Pie">
                <SgChart TItem="ChartDataPoint" 
                         ChartType="SgChartType.Pie" 
                         Data="_pieChartData" 
                         Options="_customPieColorOptions" 
                         Height="350px" 
                         Width="100%"
                         Title="Распределение (теплая палитра)" />
            </SgCard>
        </div>
    </div>

    <!-- Advanced Features -->
    <div style="margin-top: 32px;">
        <h2>⚙️ Продвинутые функции</h2>
        <p>SgChart поддерживает множество продвинутых функций для работы с большими наборами данных и интерактивности.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-top: 16px;">
            <SgCard Title="Оптимизация данных">
                <div style="font-size: 12px; line-height: 1.8;">
                    <div><strong>LTTB Decimation:</strong></div>
                    <div>• Автоматическое сжатие больших наборов</div>
                    <div>• Сохранение формы данных</div>
                    <div>• Порог: 10,000 точек</div>
                    <div>• Целевой размер: 1,000 точек</div>
                </div>
            </SgCard>

            <SgCard Title="Масштабирование">
                <div style="font-size: 12px; line-height: 1.8;">
                    <div><strong>Y-Axis Zoom:</strong></div>
                    <div>• Колесо мыши для масштабирования</div>
                    <div>• Pinch-zoom на сенсорных устройствах</div>
                    <div>• Методы ZoomYAsync() и ResetZoomAsync()</div>
                    <div>• Плавные переходы</div>
                </div>
            </SgCard>

            <SgCard Title="Экспорт">
                <div style="font-size: 12px; line-height: 1.8;">
                    <div><strong>Форматы экспорта:</strong></div>
                    <div>• PNG - растровое изображение</div>
                    <div>• JPG - сжатое изображение</div>
                    <div>• SVG - векторное изображение</div>
                    <div>• Высокое разрешение (2x)</div>
                </div>
            </SgCard>
        </div>
    </div>

    <!-- SgChartOptions Documentation -->
    <div style="margin-top: 32px;">
        <h2>📋 Параметры SgChartOptions</h2>
        <p>Полный список доступных параметров для настройки поведения графиков.</p>
        
        <div style="margin-top: 16px; padding: 16px; background: #f5f5f5; border-radius: 8px; font-size: 12px; line-height: 1.8;">
            <div><strong>ShowGrid:</strong> bool (default: true) - показывать сетку</div>
            <div><strong>ShowLabels:</strong> bool (default: true) - показывать метки осей</div>
            <div><strong>ShowLegend:</strong> bool (default: true) - показывать легенду</div>
            <div><strong>Responsive:</strong> bool (default: true) - адаптивный размер</div>
            <div><strong>Height:</strong> string (default: "300px") - высота графика</div>
            <div><strong>MinValue:</strong> double? - минимальное значение оси Y</div>
            <div><strong>MaxValue:</strong> double? - максимальное значение оси Y</div>
            <div><strong>EnableZoom:</strong> bool (default: true) - включить масштабирование</div>
            <div><strong>EnableDecimation:</strong> bool (default: true) - включить оптимизацию данных</div>
            <div><strong>DecimationThreshold:</strong> int (default: 10000) - порог для оптимизации</div>
            <div><strong>DecimationTargetPoints:</strong> int? (default: 1000) - целевое количество точек</div>
        </div>
    </div>

    <!-- SgChartType Documentation -->
    <div style="margin-top: 32px;">
        <h2>📊 Типы графиков (SgChartType)</h2>
        <p>Доступные типы графиков для визуализации различных типов данных.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px;">
            <div style="padding: 12px; background: #f5f5f5; border-radius: 8px;">
                <div><strong>Line</strong> - Линейный график для трендов</div>
                <div style="font-size: 11px; color: #666; margin-top: 4px;">Идеален для временных рядов</div>
            </div>
            <div style="padding: 12px; background: #f5f5f5; border-radius: 8px;">
                <div><strong>Bar</strong> - Столбчатый график для сравнения</div>
                <div style="font-size: 11px; color: #666; margin-top: 4px;">Сравнение категорий</div>
            </div>
            <div style="padding: 12px; background: #f5f5f5; border-radius: 8px;">
                <div><strong>Area</strong> - Площадной график</div>
                <div style="font-size: 11px; color: #666; margin-top: 4px;">Визуализация объемов</div>
            </div>
            <div style="padding: 12px; background: #f5f5f5; border-radius: 8px;">
                <div><strong>Pie</strong> - Круговой график</div>
                <div style="font-size: 11px; color: #666; margin-top: 4px;">Пропорции и проценты</div>
            </div>
            <div style="padding: 12px; background: #f5f5f5; border-radius: 8px;">
                <div><strong>Doughnut</strong> - Круговой с отверстием</div>
                <div style="font-size: 11px; color: #666; margin-top: 4px;">Альтернатива Pie</div>
            </div>
            <div style="padding: 12px; background: #f5f5f5; border-radius: 8px;">
                <div><strong>Scatter</strong> - Точечный график</div>
                <div style="font-size: 11px; color: #666; margin-top: 4px;">Анализ корреляции</div>
            </div>
            <div style="padding: 12px; background: #f5f5f5; border-radius: 8px;">
                <div><strong>Heatmap</strong> - Тепловая карта</div>
                <div style="font-size: 11px; color: #666; margin-top: 4px;">2D визуализация данных</div>
            </div>
        </div>
    </div>

    <!-- Methods Documentation -->
    <div style="margin-top: 32px;">
        <h2>🔧 Методы компонента</h2>
        <p>Доступные методы для управления графиком программно.</p>
        
        <div style="margin-top: 16px; padding: 16px; background: #f5f5f5; border-radius: 8px; font-size: 12px; line-height: 2;">
            <div><strong>RefreshAsync():</strong> Перерисовать график с текущими данными</div>
            <div><strong>UpdateDataAsync(data):</strong> Обновить данные графика</div>
            <div><strong>ZoomYAsync(min, max):</strong> Масштабировать ось Y</div>
            <div><strong>ResetZoomAsync():</strong> Сбросить масштабирование</div>
            <div><strong>ExportImageAsync(format):</strong> Экспортировать график (png, jpg, svg)</div>
        </div>
    </div>

    <!-- Events Documentation -->
    <div style="margin-top: 32px;">
        <h2>📡 События компонента</h2>
        <p>События, которые можно обработать при взаимодействии с графиком.</p>
        
        <div style="margin-top: 16px; padding: 16px; background: #f5f5f5; border-radius: 8px; font-size: 12px; line-height: 2;">
            <div><strong>OnDataPointClick:</strong> Событие при клике на точку данных</div>
            <div style="font-size: 11px; color: #666; margin-left: 16px;">
                • DatasetIndex - индекс набора данных<br/>
                • DataPointIndex - индекс точки<br/>
                • Value - значение точки<br/>
                • Label - метка точки
            </div>
        </div>
    </div>

</SgCard>

@code {
    public class ChartDataPoint
    {
        public string? Label { get; set; }
        public double Value { get; set; }
    }

    // Line Chart Data
    private List<ChartDataPoint> _lineChartData = new()
    {
        new() { Label = "Янв", Value = 65 },
        new() { Label = "Фев", Value = 59 },
        new() { Label = "Мар", Value = 80 },
        new() { Label = "Апр", Value = 81 },
        new() { Label = "Май", Value = 56 },
        new() { Label = "Июн", Value = 55 },
        new() { Label = "Июл", Value = 70 },
        new() { Label = "Авг", Value = 75 }
    };

    private SgChartOptions _lineChartOptions = new()
    {
        ShowLegend = true,
        Responsive = true,
        EnableZoom = true,
        EnableDecimation = true
    };

    private SgChartOptions _areaChartOptions = new()
    {
        ShowLegend = true,
        Responsive = true,
        BorderColor = "#10b981",
        BackgroundColor = "rgba(16, 185, 129, 0.5)"
    };

    // Bar Chart Data
    private List<ChartDataPoint> _barChartData = new()
    {
        new() { Label = "Янв", Value = 12 },
        new() { Label = "Фев", Value = 19 },
        new() { Label = "Мар", Value = 13 },
        new() { Label = "Апр", Value = 15 },
        new() { Label = "Май", Value = 12 },
        new() { Label = "Июн", Value = 13 },
        new() { Label = "Июл", Value = 18 },
        new() { Label = "Авг", Value = 21 }
    };

    private SgChartOptions _barChartOptions = new()
    {
        ShowLegend = true,
        Responsive = true,
        EnableDecimation = true
    };

    // Pie Chart Data
    private List<ChartDataPoint> _pieChartData = new()
    {
        new() { Label = "Категория A", Value = 30 },
        new() { Label = "Категория B", Value = 25 },
        new() { Label = "Категория C", Value = 20 },
        new() { Label = "Категория D", Value = 15 },
        new() { Label = "Категория E", Value = 10 }
    };

    private SgChartOptions _pieChartOptions = new()
    {
        ShowLegend = true,
        Responsive = true
    };

    // Scatter Chart Data
    private List<ChartDataPoint> _scatterChartData = new()
    {
        new() { Label = "Точка 1", Value = 10 },
        new() { Label = "Точка 2", Value = 20 },
        new() { Label = "Точка 3", Value = 15 },
        new() { Label = "Точка 4", Value = 25 },
        new() { Label = "Точка 5", Value = 30 },
        new() { Label = "Точка 6", Value = 22 },
        new() { Label = "Точка 7", Value = 28 },
        new() { Label = "Точка 8", Value = 35 }
    };

    private SgChartOptions _scatterChartOptions = new()
    {
        ShowLegend = true,
        Responsive = true,
        EnableZoom = true
    };

    // Custom Color Options
    private SgChartOptions _customColorOptions = new()
    {
        ShowLegend = true,
        Responsive = true,
        BorderColor = "#10b981",
        BackgroundColor = "rgba(16, 185, 129, 0.6)"
    };

    private SgChartOptions _customPieColorOptions = new()
    {
        ShowLegend = true,
        Responsive = true,
        Colors = new List<string> { "#ff7e5f", "#feb47b", "#ff6b6b", "#feca57", "#48dbfb" }
    };
}