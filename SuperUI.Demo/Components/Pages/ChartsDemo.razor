    private int _anomalyCount = 3;
    private List<ChartDataPoint> _anomalyData = new();
    private SgChartOptions _anomalyOpts = new()
    {
        ShowLegend = false, Responsive = true, ShowToolbar = true,
        ValueSuffix = " мс", ValueDecimals = 0,
        Colors = ["#3b82f6"],
    };

    private void RegenerateAnomalies()
    {
        var list = new List<ChartDataPoint>(30);
        var anomalyIdx = Enumerable.Range(0, 30).OrderBy(_ => _rnd.Next()).Take(_anomalyCount).ToHashSet();
        for (int i = 0; i < 30; i++)
        {
            double v = anomalyIdx.Contains(i)
                ? 300 + _rnd.NextDouble() * 400
                : 20 + _rnd.NextDouble() * 60;
            list.Add(new($"T{i + 1}", Math.Round(v)));
        }
        _anomalyData = list;
    }

