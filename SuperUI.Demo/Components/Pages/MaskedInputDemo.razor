@page "/masked-input-demo"
@using SuperUI.Components

<PageTitle>Masked Input - SUI</PageTitle>

<SgCard Title="SgMaskedInput - Formatting &amp; Masks"
        Subtitle="Input fields with built-in masks for phone, tax IDs, bank accounts, currency, and percentages.">

    <div style="margin-top: 32px;">
        <h2>Corporate IDs</h2>
        <p>Common Russian tax and banking identifiers with automatic formatting.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Phone</div>
                        <SgMaskedInput Label="Phone" MaskType="SgMaskType.Phone" @bind-Value="_phone" />
                        <div style="font-size: 11px; color: var(--sui-muted); margin-top: 4px;">Raw: @_phone</div>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">INN (10 digits)</div>
                        <SgMaskedInput Label="INN" MaskType="SgMaskType.Inn" @bind-Value="_inn" />
                        <div style="font-size: 11px; color: var(--sui-muted); margin-top: 4px;">Raw: @_inn</div>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">KPP (9 digits)</div>
                        <SgMaskedInput Label="KPP" MaskType="SgMaskType.Kpp" @bind-Value="_kpp" />
                        <div style="font-size: 11px; color: var(--sui-muted); margin-top: 4px;">Raw: @_kpp</div>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Bank Account (20 digits)</div>
                        <SgMaskedInput Label="Account" MaskType="SgMaskType.Account" @bind-Value="_account" />
                        <div style="font-size: 11px; color: var(--sui-muted); margin-top: 4px;">Raw: @_account</div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_idProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Currency &amp; Percent</h2>
        <p>Numeric values with cultural formatting.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Currency (₽)</div>
                        <SgMaskedInput Label="Amount" MaskType="SgMaskType.Currency" @bind-Value="_currency" CurrencySymbol="₽" />
                        <div style="font-size: 11px; color: var(--sui-muted); margin-top: 4px;">Raw: @_currency</div>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Currency ($)</div>
                        <SgMaskedInput Label="Amount" MaskType="SgMaskType.Currency" @bind-Value="_currency2" CurrencySymbol="$" />
                        <div style="font-size: 11px; color: var(--sui-muted); margin-top: 4px;">Raw: @_currency2</div>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Percentage</div>
                        <SgMaskedInput Label="Rate" MaskType="SgMaskType.Percent" @bind-Value="_percent" />
                        <div style="font-size: 11px; color: var(--sui-muted); margin-top: 4px;">Raw: @_percent</div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_numericProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Cards, Dates &amp; Time</h2>
        <p>Card details, dates, and time with built-in masks and validation.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Credit card</div>
                        <SgMaskedInput Label="Card number" MaskType="SgMaskType.CreditCard" @bind-Value="_card" ShowMaskWhileTyping="true" />
                        <div style="font-size: 11px; color: var(--sui-muted); margin-top: 4px;">Raw: @_card</div>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div>
                            <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Expiry</div>
                            <SgMaskedInput Label="MM/YY" MaskType="SgMaskType.CardExpiry" @bind-Value="_expiry" />
                        </div>
                        <div>
                            <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">CVV</div>
                            <SgMaskedInput Label="CVV" MaskType="SgMaskType.Cvv" @bind-Value="_cvv" />
                        </div>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Date / Time</div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                            <SgMaskedInput Label="Date" MaskType="SgMaskType.Date" @bind-Value="_date" />
                            <SgMaskedInput Label="Time" MaskType="SgMaskType.Time" @bind-Value="_time" />
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_cardProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Custom Mask</h2>
        <p>Define your own pattern with 9 (digit), a (letter), and literals.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Passport: 9999 999999</div>
                        <SgMaskedInput Label="Passport" MaskType="SgMaskType.Custom" Mask="9999 999999" @bind-Value="_passport" />
                        <div style="font-size: 11px; color: var(--sui-muted); margin-top: 4px;">Raw: @_passport</div>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">SNILS: 999-999-999 99</div>
                        <SgMaskedInput Label="SNILS" MaskType="SgMaskType.Custom" Mask="999-999-999 99" @bind-Value="_snils" />
                        <div style="font-size: 11px; color: var(--sui-muted); margin-top: 4px;">Raw: @_snils</div>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">License plate: a 999 aa 999</div>
                        <SgMaskedInput Label="License" MaskType="SgMaskType.Custom" Mask="a 999 aa 999" @bind-Value="_plate" />
                        <div style="font-size: 11px; color: var(--sui-muted); margin-top: 4px;">Raw: @_plate</div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_customProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Enum + code -->
    <div style="margin-top: 32px;">
        <h2>Перечисление SgMaskType и примеры кода</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="SgMaskType">
                <PropertyTable Items="_maskTypeEnum" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private string? _phone;
    private string? _inn;
    private string? _kpp;
    private string? _account;
    private string? _currency;
    private string? _currency2;
    private string? _percent;
    private string? _passport;
    private string? _snils;
    private string? _plate;
    private string? _card;
    private string? _expiry;
    private string? _cvv;
    private string? _date;
    private string? _time;

