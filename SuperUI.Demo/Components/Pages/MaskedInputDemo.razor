@page "/demo/maskedinput"
@using SuperUI.Demo.Components

<div class="demo-page">
    <div class="demo-hero">
        <section class="demo-hero-main">
            <div class="demo-header">
                <div class="demo-kicker">Input Components</div>
                <h1 class="demo-title">SgMaskedInput</h1>
                <p class="demo-subtitle">
                    Advanced input field with support for predefined masks (Phone, Date, Credit Card, etc.), 
                    numeric formatting (Currency, Percent) and custom patterns.
                </p>
            </div>
        </section>

        <aside class="demo-hero-side">
            <div class="demo-side-title">Highlights</div>
            <div class="demo-pill-list">
                <span class="demo-pill demo-pill-accent">Predefined Masks</span>
                <span class="demo-pill">Currency Support</span>
                <span class="demo-pill">Real-time Validation</span>
                <span class="demo-pill">SSR Safe</span>
            </div>

            <div class="demo-meta-grid">
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Mask Types</span>
                    <span class="demo-meta-value">Phone, Date, Currency, INN, etc.</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Numeric</span>
                    <span class="demo-meta-value">Thousands separator, decimal places</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Accessibility</span>
                    <span class="demo-meta-value">Full ARIA support</span>
                </div>
            </div>
        </aside>
    </div>

    <SgDemoSection Eyebrow="Usage" Title="Predefined Masks" Description="Commonly used mask patterns for identity and contact information.">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Contact & Identity</h3>
                    <p class="demo-showcase-desc">Standard patterns for phones, documents and cards.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgMaskedInput Label="Phone Number" MaskType="SgMaskType.Phone" @bind-Value="_phone" Hint="Auto-formatted +7 (999) 999-99-99" />
                        <SgMaskedInput Label="Credit Card" MaskType="SgMaskType.CreditCard" @bind-Value="_card" />
                        <SgMaskedInput Label="SNILS" MaskType="SgMaskType.Snils" @bind-Value="_snils" />
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Date & Time</h3>
                    <p class="demo-showcase-desc">Inputs for specific temporal formats.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgMaskedInput Label="Birth Date" MaskType="SgMaskType.Date" @bind-Value="_date" />
                        <SgMaskedInput Label="Meeting Time" MaskType="SgMaskType.Time" @bind-Value="_time" />
                        <SgMaskedInput Label="Expiry Date" MaskType="SgMaskType.CardExpiry" @bind-Value="_expiry" />
                    </div>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoSection Eyebrow="Finance" Title="Numeric Formatting" Description="Handling currencies and percentages with proper formatting and constraints.">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Currency & Percent</h3>
                    <p class="demo-showcase-desc">Automatic thousand separators and suffixes.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgMaskedInput Label="Amount (RUB)" MaskType="SgMaskType.Currency" CurrencySymbol="₽" @bind-Value="_amount" />
                        <SgMaskedInput Label="Tax Rate" MaskType="SgMaskType.Percent" @bind-Value="_tax" />
                        <SgMaskedInput Label="Limited Amount" MaskType="SgMaskType.Currency" MinValue="100" MaxValue="10000" @bind-Value="_limitedAmount" Hint="Range: 100 - 10,000" />
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Custom Masks</h3>
                    <p class="demo-showcase-desc">Define your own patterns using special tokens.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgMaskedInput Label="Serial Key" Mask="AAAA-9999-AAAA" @bind-Value="_serial" Hint="Pattern: AAAA-9999-AAAA" />
                        <SgMaskedInput Label="License Plate" Mask="a 999 aa 99" @bind-Value="_plate" />
                    </div>
                    <div class="demo-note">Tokens: 9 (digit), a (letter), A (uppercase letter), * (any).</div>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoParams Title="MaskedInput Parameters" Description="Comprehensive list of parameters for SgMaskedInput.">
        <SgDemoParam Name="Value" Type="string" Description="The raw value of the input." />
        <SgDemoParam Name="MaskType" Type="SgMaskType" Description="Predefined mask pattern type." Values="Phone, Date, Currency, etc." DefaultValue="Custom" />
        <SgDemoParam Name="Mask" Type="string" Description="Custom mask pattern (if MaskType is Custom)." />
        <SgDemoParam Name="MaskPlaceholder" Type="char" Description="Character used to represent empty slots in the mask." DefaultValue="'_'" />
        <SgDemoParam Name="ShowMaskAsPlaceholder" Type="bool" Description="Whether to show the mask pattern as the input placeholder." DefaultValue="true" />
        <SgDemoParam Name="DecimalPlaces" Type="int" Description="Number of decimal places for numeric masks." DefaultValue="2" />
        <SgDemoParam Name="CurrencySymbol" Type="string" Description="Symbol used for Currency mask type." DefaultValue="RUB" />
        <SgDemoParam Name="MinValue" Type="decimal?" Description="Minimum allowed value for numeric masks." />
        <SgDemoParam Name="MaxValue" Type="decimal?" Description="Maximum allowed value for numeric masks." />
        <SgDemoParam Name="ShowClearButton" Type="bool" Description="Show a button to clear the input value." DefaultValue="false" />
    </SgDemoParams>
</div>

@code {
    private string? _phone;
    private string? _card;
    private string? _snils;
    private string? _date;
    private string? _time;
    private string? _expiry;
    private string? _amount = "1250.50";
    private string? _tax = "13";
    private string? _limitedAmount;
    private string? _serial;
    private string? _plate;
}
