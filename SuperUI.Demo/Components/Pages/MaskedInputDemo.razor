    // ── Code generation ───────────────────────────────────────────────
    private string[] _generatedCodeLines = Array.Empty<string>();
    private string _copyIcon = "📋";
    private string _copyLabel = "Copy";

    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add($"<SgMaskedInput");
        lines.Add($"             @bind-Value=\"@_myValue\"");
        lines.Add($"             MaskType=\"SgMaskType.{_ctorMaskType}\"");
        if (_ctorMaskType == "Custom")
            lines.Add($"             Mask=\"{_ctorCustomMask}\"");
        if (_ctorSize != SgSize.Md)
            lines.Add($"             Size=\"SgSize.{_ctorSize}\"");
        if (_ctorShowMask)
            lines.Add($"             ShowMaskWhileTyping=\"true\"");
        if (!_ctorClear)
            lines.Add($"             ShowClearButton=\"false\"");
        if (_ctorSecret)
            lines.Add($"             SecretMode=\"true\"");
        if (_ctorCopy)
            lines.Add($"             AllowCopy=\"true\"");
        if (_ctorStatus != "None")
            lines.Add($"             Status=\"SgColor.{_ctorStatus}\"");
        lines.Add($"             Label=\"My label\" />");
        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }
}
