                                               ShowMaskWhileTyping="@_ctorShowMask"
                                               ShowClearButton="@_ctorClear"
                                               SecretMode="@_ctorSecret"
                                               AllowCopy="@_ctorCopy"
                                               Status="@CtorResolvedStatus"
                                               Label="Preview" />
                            </div>
                        </SgStack>

                        <!-- Code with Copy -->
