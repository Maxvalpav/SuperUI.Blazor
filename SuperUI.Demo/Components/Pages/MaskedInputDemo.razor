    private string? _cardBrandClass;

    private void OnCardChanged()
    {
        if (string.IsNullOrEmpty(_card))
        {
            _cardBrand = null;
            _cardBrandClass = null;
            return;
        }
        var digits = new string(_card.Where(char.IsDigit).ToArray());
        if (digits.Length < 2) { _cardBrand = null; _cardBrandClass = null; return; }

        var (brand, css) = DetectCardBrand(digits);
        _cardBrand = brand;
        _cardBrandClass = css;
    }

    private static (string? brand, string? cssClass) DetectCardBrand(string digits)
    {
        if (digits.Length < 1) return (null, null);
        return digits[0] switch
        {
            '4' => ("Visa", "visa"),
            '5' when digits.Length > 1 && "12345".Contains(digits[1]) => ("Mastercard", "mastercard"),
            '3' when digits.Length > 1 => digits[1] switch
            {
                '4' or '7' => ("Amex", "amex"),
                '0' or '6' or '8' => ("Diners", "diners"),
                _ => (null, null)
            },
            '6' => ("Discover", "discover"),
            '2' when digits.Length > 1 => ("Mir", "mir"),
            _ => (null, null)
        };
    }

