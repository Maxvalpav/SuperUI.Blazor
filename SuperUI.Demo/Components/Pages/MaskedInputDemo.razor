                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">ClearBtn</SgTypography>
                                    <SgBadge Variant="@(_ctorClear ? SgBadgeVariant.Success : SgBadgeVariant.Muted)" Text="@(_ctorClear ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">SecretMode</SgTypography>
                                    <SgBadge Variant="@(_ctorSecret ? SgBadgeVariant.Success : SgBadgeVariant.Muted)" Text="@(_ctorSecret ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
