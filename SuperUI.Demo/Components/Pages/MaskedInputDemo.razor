@page "/masked-input-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgMaskedInput — Masked Input — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Masked Input" Subtitle="SgMaskedInput — format-constrained text input with preset and custom masks. Supports phone, tax IDs, bank accounts, credit cards, currency, percentage, dates, time, secret mode, and user-defined patterns." Icon="<svg viewBox=&quot;0 0 24 24&quot; width=&quot;20&quot; height=&quot;20&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;><rect x=&quot;2&quot; y=&quot;4&quot; width=&quot;20&quot; height=&quot;16&quot; rx=&quot;2&quot;/><path d=&quot;M8 12h8&quot;/><path d=&quot;M10 9l2 3-2 3&quot;/><path d=&quot;M14 9l-2 3 2 3&quot;/></svg>" />
    </HeaderContent>
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Corporate IDs                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Corporate IDs
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Russian tax and banking identifiers with built-in formatting:
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Phone</SgTypography>,
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">INN</SgTypography>,
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">KPP</SgTypography>,
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Account</SgTypography>,
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">BIC</SgTypography>.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" CssCssClass="demo-sub-header">
                            Basic IDs
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <div class="demo-value-row">
                                <SgMaskedInput @bind-Value="@_phone" MaskType="SgMaskType.Phone" Label="Phone" LeadingIcon="@SgIcons.Phone" />
                                <span class="demo-value-chip" title="@(_phone ?? "empty")">@(_phone ?? "—")</span>
                            </div>
                            <div class="demo-value-row">
                                <SgMaskedInput @bind-Value="@_inn" MaskType="SgMaskType.Inn" Label="INN" />
                                <span class="demo-value-chip" title="@(_inn ?? "empty")">@(_inn ?? "—")</span>
                            </div>
                            <div class="demo-value-row">
                                <SgMaskedInput @bind-Value="@_kpp" MaskType="SgMaskType.Kpp" Label="KPP" />
                                <span class="demo-value-chip" title="@(_kpp ?? "empty")">@(_kpp ?? "—")</span>
                            </div>
                            <div class="demo-value-row">
                                <SgMaskedInput @bind-Value="@_account" MaskType="SgMaskType.Account" Label="Bank Account" />
                                <span class="demo-value-chip" title="@(_account ?? "empty")">@(_account ?? "—")</span>
                            </div>
                            <div class="demo-value-row">
                                <SgMaskedInput @bind-Value="@_bic" MaskType="SgMaskType.Bic" Label="BIC" AllowCopy="true" />
                                <span class="demo-value-chip" title="@(_bic ?? "empty")">@(_bic ?? "—")</span>
                            </div>
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" CssClass="demo-sub-header">
                            Enhanced
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgMaskedInput @bind-Value="@_ogrn" MaskType="SgMaskType.Ogrn" Label="OGRN (Status success)" Status="SgColor.Success" TrailingIcon="@SgIcons.CheckCircle" AnimateChanges="true" />
                            <SgMaskedInput @bind-Value="@_snilsDemo" MaskType="SgMaskType.Snils" Label="SNILS (Status info)" Status="SgColor.Info" AnimateChanges="true" />
                            <SgMaskedInput @bind-Value="@_iban" MaskType="SgMaskType.Iban" Label="IBAN" Size="SgSize.Lg" />
                        </SgStack>
                    </div>
                </SgStack>
            </SgCard>
            <SgCard Title="SgMaskedInput Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_idProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Currency & Percent                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Currency &amp; Percent
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Numeric values with cultural formatting, thousands separators, custom currency symbols, and min/max validation.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" CssClass="demo-sub-header">
                            Currencies
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <div class="demo-value-row">
                                <SgMaskedInput @bind-Value="@_currencyRub" MaskType="SgMaskType.Currency" Label="Amount (₽)" CurrencySymbol="₽" LeadingIcon="@SgIcons.DollarSign" />
                                <span class="demo-value-chip" title="@(_currencyRub ?? "empty")">@(_currencyRub ?? "—")</span>
                            </div>
                            <div class="demo-value-row">
                                <SgMaskedInput @bind-Value="@_currencyUsd" MaskType="SgMaskType.Currency" Label="Amount ($)" CurrencySymbol="$" />
                                <span class="demo-value-chip" title="@(_currencyUsd ?? "empty")">@(_currencyUsd ?? "—")</span>
                            </div>
                            <div class="demo-value-row">
                                <SgMaskedInput @bind-Value="@_currencyEur" MaskType="SgMaskType.Currency" Label="Amount (€)" CurrencySymbol="€" Status="SgColor.Warning" />
                                <span class="demo-value-chip" title="@(_currencyEur ?? "empty")">@(_currencyEur ?? "—")</span>
                            </div>
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" CssClass="demo-sub-header">
                            Percent &amp; Constraints
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <div class="demo-value-row">
                                <SgMaskedInput @bind-Value="@_percent" MaskType="SgMaskType.Percent" Label="Rate" TrailingIcon="@SgIcons.Percent" />
                                <span class="demo-value-chip" title="@(_percent ?? "empty")">@(_percent ?? "—")</span>
                            </div>
                            <SgMaskedInput @bind-Value="@_percentConstrained" MaskType="SgMaskType.Percent" Label="Rate (0–100, Status danger)" MinValue="0" MaxValue="100" Status="SgColor.Danger" />
                        </SgStack>
                    </div>
                </SgStack>
            </SgCard>
            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_numericProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Cards, Dates & Time                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Cards, Dates &amp; Time
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Credit-card number, expiry, CVV, date, and time inputs with built-in masks and validation popover.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" CssClass="demo-sub-header">
                            Card Details
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <div class="demo-value-row">
                                <SgMaskedInput @bind-Value="@_card" @bind-Value:after="OnCardChanged" MaskType="SgMaskType.CreditCard" Label="Card number" ShowMaskWhileTyping="true" LeadingIcon="@SgIcons.CreditCard" />
                                <div class="demo-card-brand">
                                    @if (_cardBrand != null)
                                    {
                                        <span class="demo-brand-badge @_cardBrandClass">@_cardBrand</span>
                                    }
                                    else
                                    {
                                        <span class="demo-value-chip">@(_card ?? "—")</span>
                                    }
                                </div>
                            </div>
                            <div class="demo-row-two">
                                <SgMaskedInput @bind-Value="@_expiry" MaskType="SgMaskType.CardExpiry" Label="Expiry (MM/YY)" ShowMaskWhileTyping="true" />
                                <SgMaskedInput @bind-Value="@_cvv" MaskType="SgMaskType.Cvv" Label="CVV" ShowMaskWhileTyping="true" LeadingIcon="@SgIcons.Shield" />
                            </div>
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" CssClass="demo-sub-header">
                            Date &amp; Time
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <div class="demo-value-row">
                                <SgMaskedInput @bind-Value="@_date" MaskType="SgMaskType.Date" Label="Date" ShowMaskWhileTyping="true" LeadingIcon="@SgIcons.Calendar" />
                                <span class="demo-value-chip" title="@(_date ?? "empty")">@(_date ?? "—")</span>
                            </div>
                            <div class="demo-value-row">
                                <SgMaskedInput @bind-Value="@_time" MaskType="SgMaskType.Time" Label="Time" ShowMaskWhileTyping="true" LeadingIcon="@SgIcons.Clock" />
                                <span class="demo-value-chip" title="@(_time ?? "empty")">@(_time ?? "—")</span>
                            </div>
                            <div class="demo-value-row">
                                <SgMaskedInput @bind-Value="@_postal" MaskType="SgMaskType.Postal" Label="Postal code (Status info)" Status="SgColor.Info" />
                                <span class="demo-value-chip" title="@(_postal ?? "empty")">@(_postal ?? "—")</span>
                            </div>
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" CssClass="demo-sub-header">
                            Enhanced
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgMaskedInput @bind-Value="@_cardPopover" MaskType="SgMaskType.CreditCard" Label="Card (validation popover)" ShowMaskWhileTyping="true" ValidationPopover="true" ErrorText="Incomplete card" />
                            <SgMaskedInput @bind-Value="@_dateCopy" MaskType="SgMaskType.Date" Label="Date with copy" AllowCopy="true" ShowMaskWhileTyping="true" />
                        </SgStack>
                    </div>
                </SgStack>
            </SgCard>
            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_cardProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Custom Masks                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Custom Masks
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Define your own pattern with
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">9</SgTypography> (digit),
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">a</SgTypography> (letter),
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">A</SgTypography> (uppercase),
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">n</SgTypography> (alphanumeric),
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">*</SgTypography> (any char). Literals are preserved.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" CssClass="demo-sub-header">
                            Common Patterns
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <div class="demo-value-row">
                                <SgMaskedInput @bind-Value="@_passport" MaskType="SgMaskType.Custom" Mask="9999 999999" Label="Passport" ShowMaskWhileTyping="true" />
                                <span class="demo-value-chip" title="@(_passport ?? "empty")">@(_passport ?? "—")</span>
                            </div>
                            <div class="demo-value-row">
                                <SgMaskedInput @bind-Value="@_snilsCustom" MaskType="SgMaskType.Custom" Mask="999-999-999 99" Label="SNILS" ShowMaskWhileTyping="true" />
                                <span class="demo-value-chip" title="@(_snilsCustom ?? "empty")">@(_snilsCustom ?? "—")</span>
                            </div>
                            <div class="demo-value-row">
                                <SgMaskedInput @bind-Value="@_plate" MaskType="SgMaskType.Custom" Mask="a 999 aa 999" Label="License plate" ShowMaskWhileTyping="true" />
                                <span class="demo-value-chip" title="@(_plate ?? "empty")">@(_plate ?? "—")</span>
                            </div>
                            <div class="demo-value-row">
                                <SgMaskedInput @bind-Value="@_sku" MaskType="SgMaskType.Custom" Mask="AA-9999-aa" Label="SKU code" Status="SgColor.Success" ShowMaskWhileTyping="true" />
                                <span class="demo-value-chip" title="@(_sku ?? "empty")">@(_sku ?? "—")</span>
                            </div>
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" CssClass="demo-sub-header">
                            Sizes &amp; ShowMaskWhileTyping
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgMaskedInput @bind-Value="@_maskSm" MaskType="SgMaskType.Custom" Mask="9999 999999" Label="Small size" Size="SgSize.Sm" ShowMaskWhileTyping="true" />
                            <SgMaskedInput @bind-Value="@_maskMd" MaskType="SgMaskType.Custom" Mask="9999 999999" Label="Medium size (default)" Size="SgSize.Md" ShowMaskWhileTyping="true" />
                            <SgMaskedInput @bind-Value="@_maskLg" MaskType="SgMaskType.Custom" Mask="9999 999999" Label="Large size" Size="SgSize.Lg" ShowMaskWhileTyping="true" />
                        </SgStack>
                    </div>
                </SgStack>
            </SgCard>
            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_customProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Secret Mode                                                      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Secret Mode
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Mask sensitive data with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SecretMode</SgTypography>,
                toggle visibility with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">RevealToggle</SgTypography>,
                or auto-reveal on focus via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">RevealOnFocus</SgTypography>.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" CssClass="demo-sub-header">
                            With Reveal Toggle
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgMaskedInput @bind-Value="@_secretCard" MaskType="SgMaskType.CreditCard" Label="Card (secret)" SecretMode="true" ShowMaskWhileTyping="true" LeadingIcon="@SgIcons.CreditCard" />
                            <SgMaskedInput @bind-Value="@_secretPhone" MaskType="SgMaskType.Phone" Label="Phone (secret)" SecretMode="true" LeadingIcon="@SgIcons.Phone" />
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" CssClass="demo-sub-header">
                            Variants
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgMaskedInput @bind-Value="@_secretNoReveal" MaskType="SgMaskType.CreditCard" Label="Hidden (no reveal btn)" SecretMode="true" RevealToggle="false" ShowMaskWhileTyping="true" />
                            <SgMaskedInput @bind-Value="@_secretNoFocusReveal" MaskType="SgMaskType.Phone" Label="Hidden (no reveal on focus)" SecretMode="true" RevealOnFocus="false" LeadingIcon="@SgIcons.Phone" />
                            <SgMaskedInput @bind-Value="@_secretCustomChar" MaskType="SgMaskType.Custom" Mask="9999 999999" Label="Custom mask char" SecretMode="true" ShowMaskWhileTyping="true" />
                        </SgStack>
                    </div>
                </SgStack>
            </SgCard>
            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_secretProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. SgMaskType Enum                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgMaskType Enum
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                All built-in mask presets available via the <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">MaskType</SgTypography> parameter.
            </SgTypography>
        </div>
        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <PropertyTable Items="_maskTypeEnum" />
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 7. Live SgMaskedInput Constructor                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live SgMaskedInput Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure parameters interactively and see the result in real time. Click <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Copy</SgTypography> to grab the generated code.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">
                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- MaskType -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Mask Type</SgTypography>
                            <SgSegmented TValue="string"
                                         Value="@_ctorMaskType"
                                         ValueChanged="v => { _ctorMaskType = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="@_maskSegOptions" />
                        </SgStack>

                        <!-- Optional: Mask pattern (shown for Custom) -->
                        @if (_ctorMaskType == "Custom")
                        {
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Custom Mask</SgTypography>
                                <SgSegmented TValue="string"
                                             Value="@_ctorCustomMask"
                                             ValueChanged="v => { _ctorCustomMask = v; UpdateConstructorCode(); }"
                                             Block="true"
                                             Size="sm"
                                             Options="@_customMaskSegOptions" />
                            </SgStack>
                        }

                        <!-- Size -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                            <SgSegmented TValue="SgSize"
                                         Value="@_ctorSize"
                                         ValueChanged="v => { _ctorSize = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_sizeSegOptions" />
                        </SgStack>

                        <!-- Toggles Row 1 -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">ShowMask</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="@_ctorShowMask"
                                                 ValueChanged="v => { _ctorShowMask = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions" />
