                        </div>
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Loading with Primary variant</SgTypography>
                            <div style="margin-top:8px;">
                                <SgSegmented TValue="string" Loading="true" Variant="primary" Options="@_dayOptions" />
