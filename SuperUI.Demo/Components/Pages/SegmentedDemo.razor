@page "/segmented-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgSegmented — Segmented Control — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Segmented Control"
                        Subtitle="SgSegmented — iOS-style segmented control for switching between views or options. Supports sizes (xs-lg), 4 visual variants, multi-select, animated slider, keyboard nav, icons, badges, custom templates, loading skeleton, and more."
                        Icon="@SgHeroicons.Outline.AdjustmentsHorizontal" />
    </HeaderContent>
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Basic Usage                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Basic Usage
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Select a single value from a set of options. Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">@@bind-Value</SgTypography> for two-way binding. Try clicking different segments.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <div class="demo-label-row">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Days of the Week</SgTypography>
                            <span class="demo-value-chip">@_selectedDay</span>
                        </div>
                        <SgSegmented TValue="string"
                                     Options="@_dayOptions"
                                     Animated="true"
                                     @bind-Value="_selectedDay" />
                    </div>
                    <div>
                        <div class="demo-label-row">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">With Disabled Option</SgTypography>
                            <span class="demo-value-chip">@_selectedMonth</span>
                        </div>
                        <SgSegmented TValue="string"
                                     Options="@_monthOptions"
                                     Animated="true"
                                     @bind-Value="_selectedMonth" />
                        <div style="margin-top:6px;">
                            <SgTag Variant="SgTagVariant.Muted" Size="SgSize.Sm">"Mar" is disabled — try to click it</SgTag>
                        </div>
                    </div>
                    <div>
                        <div class="demo-label-row">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Allow Deselect</SgTypography>
                            <span class="demo-value-chip">@(_selectedAllowDeselect ?? "null")</span>
                        </div>
                        <SgSegmented TValue="string"
                                     Options="@_deselectOptions"
                                     AllowDeselect="true"
                                     Animated="true"
                                     @bind-Value="_selectedAllowDeselect" />
                        <div style="margin-top:6px;">
                            <SgTag Variant="SgTagVariant.Info" Size="SgSize.Sm">Click active item to deselect</SgTag>
                        </div>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_basicProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Sizes                                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Sizes
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Four predefined sizes: <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">xs</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">sm</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">md</SgTypography> (default), <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">lg</SgTypography>. Set via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Size</SgTypography> string or <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SizeEnum</SgTypography>.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Size Variants" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <div class="demo-label-row">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Extra Small (xs)</SgTypography>
                        </div>
                        <SgSegmented TValue="string" Size="xs" Options="@_sizeOptions" @bind-Value="_sizeValue" />
                    </div>
                    <div>
                        <div class="demo-label-row">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Small (sm)</SgTypography>
                        </div>
                        <SgSegmented TValue="string" Size="sm" Options="@_sizeOptions" @bind-Value="_sizeValue" />
                    </div>
                    <div>
                        <div class="demo-label-row">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Medium (md — Default)</SgTypography>
                        </div>
                        <SgSegmented TValue="string" Options="@_sizeOptions" @bind-Value="_sizeValue" />
                    </div>
                    <div>
                        <div class="demo-label-row">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Large (lg)</SgTypography>
                        </div>
                        <SgSegmented TValue="string" Size="lg" Options="@_sizeOptions" @bind-Value="_sizeValue" />
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_sizeProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Variants                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Variants
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Choose between <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">default</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">primary</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">glass</SgTypography>, or <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">gradient</SgTypography> variant for different visual styles.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Default Variant" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgSegmented TValue="string" Options="@_alignOptions" @bind-Value="_selectedAlign" Animated="true" />
                    <div style="margin-top:12px;">
                        <SgSegmented TValue="string" Variant="default" Options="@_alignOptions" @bind-Value="_selectedAlign" Block="true" Animated="true" />
                    </div>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Primary Variant" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgSegmented TValue="string" Variant="primary" Options="@_alignOptions" @bind-Value="_selectedAlign2" Animated="true" />
                    <div style="margin-top:12px;">
                        <SgSegmented TValue="string" Variant="primary" Options="@_alignOptions" @bind-Value="_selectedAlign2" Block="true" Animated="true" />
                    </div>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Glass Variant" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgSegmented TValue="string" Variant="glass" Options="@_alignOptions" @bind-Value="_selectedAlign3" Animated="true" />
                    <div style="margin-top:12px;">
                        <SgSegmented TValue="string" Variant="glass" Options="@_alignOptions" @bind-Value="_selectedAlign3" Block="true" Animated="true" />
                    </div>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Gradient Variant" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgSegmented TValue="string" Variant="gradient" Options="@_alignOptions" @bind-Value="_selectedAlign4" Animated="true" />
                    <div style="margin-top:12px;">
                        <SgSegmented TValue="string" Variant="gradient" Options="@_alignOptions" @bind-Value="_selectedAlign4" Block="true" Animated="true" />
                    </div>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Pill & Vertical                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Pill & Vertical Orientation
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Pill</SgTypography> gives fully rounded segments (iOS-style). <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Vertical</SgTypography> stacks options vertically.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Pill (Rounded)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgSegmented TValue="string" Pill="true" Options="@_dayOptions" @bind-Value="_selectedDay" Animated="true" />
                        <SgSegmented TValue="string" Pill="true" Options="@_sizeOptions" @bind-Value="_sizeValue" Block="true" Animated="true" />
                        <SgSegmented TValue="string" Pill="true" Variant="primary" Options="@_alignOptions" @bind-Value="_selectedAlign" Block="true" Animated="true" />
                        <SgSegmented TValue="string" Pill="true" Variant="gradient" Options="@_filterOptions" @bind-Value="_selectedFilter" Block="true" Animated="true" />
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Vertical Orientation" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgSegmented TValue="string" Vertical="true" Options="@_dayOptions" @bind-Value="_selectedDay" />
                        <div style="margin-top:4px;">
                            <SgSegmented TValue="string" Vertical="true" Options="@_alignOptions" @bind-Value="_selectedAlign" Block="true" Animated="true" />
                        </div>
                        <SgSegmented TValue="string" Vertical="true" Pill="true" Options="@_filterOptions" @bind-Value="_selectedFilter" Block="true" />
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Block & Justify                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Block & Justify
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Block</SgTypography> fills container width. <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Justify</SgTypography> controls how items are distributed.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Block Mode" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Inline (natural width)</SgTypography>
                        <SgSegmented TValue="string" Options="@_dayOptions" @bind-Value="_selectedDay" Animated="true" />
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Block (full width)</SgTypography>
                        <SgSegmented TValue="string" Block="true" Options="@_dayOptions" @bind-Value="_selectedDay" Animated="true" />
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Justify Options" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Justify = center</SgTypography>
                            <SgTag Size="SgSize.Sm" Variant="SgTagVariant.Info">Try it</SgTag>
                        </SgStack>
                        <SgSegmented TValue="string" Block="true" Justify="center" Options="@_dayOptions" @bind-Value="_selectedDay" Animated="true" />
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Justify = space-between</SgTypography>
                        <SgSegmented TValue="string" Block="true" Justify="space-between" Options="@_dayOptions" @bind-Value="_selectedDay" />
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Justify = space-around</SgTypography>
                        <SgSegmented TValue="string" Block="true" Justify="space-around" Options="@_dayOptions" @bind-Value="_selectedDay" />
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. Icons & Badges                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Icons & Badges
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Enhance segments with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgHeroicons</SgTypography> icons and notification badges.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="With Icons" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Lg">
                        <div>
                            <div class="demo-label-row">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Icon + Label</SgTypography>
                                <span class="demo-value-chip">@_selectedIcon</span>
                            </div>
                            <SgSegmented TValue="string" Options="@_iconOptions" @bind-Value="_selectedIcon" Animated="true" />
                        </div>
                        <div>
                            <div class="demo-label-row">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Icons Only (Small)</SgTypography>
                                <span class="demo-value-chip">@_selectedIconOnly</span>
                            </div>
                            <SgSegmented TValue="string" Size="sm" Options="@_iconOnlyOptions" @bind-Value="_selectedIconOnly" Animated="true" />
                        </div>
                        <div>
                            <div class="demo-label-row">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Icons + Tooltips</SgTypography>
                            </div>
                            <SgSegmented TValue="string" Options="@_iconTooltipOptions" @bind-Value="_selectedIconTooltip" Animated="true" />
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="With Badges" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Lg">
                        <div>
                            <div class="demo-label-row">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Status Badges</SgTypography>
                                <span class="demo-value-chip">@_selectedBadge</span>
                            </div>
                            <SgSegmented TValue="string" Options="@_badgeOptions" @bind-Value="_selectedBadge" Block="true" Animated="true" />
                        </div>
                        <div>
                            <div class="demo-label-row">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Icons + Badges</SgTypography>
                                <span class="demo-value-chip">@_selectedIconBadge</span>
                            </div>
                            <SgSegmented TValue="string" Options="@_iconBadgeOptions" @bind-Value="_selectedIconBadge" Block="true" Animated="true" />
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 7. Multi-Select                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Multi-Select
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">AllowMultiple</SgTypography> enables selecting several options at once. Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">@@bind-SelectedValues</SgTypography> for binding.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Multi-Select Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Lg">
                        <div>
                            <div class="demo-label-row">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Tags (multi-select)</SgTypography>
                            </div>
                            <SgSegmented TValue="string"
                                         AllowMultiple="true"
                                         Options="@_multiOptions"
                                         SelectedValues="@_selectedTags"
                                         SelectedValuesChanged="OnTagsChanged" />
                            @if (_selectedTags?.Any() == true)
                            {
                                <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:8px;">
                                    @foreach (var t in _selectedTags)
                                    {
                                        <SgTag Size="SgSize.Sm" Variant="SgTagVariant.Info">@t</SgTag>
                                    }
                                </div>
                            }
                            else
                            {
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Style="margin-top:8px;display:block;">No tags selected</SgTypography>
                            }
                        </div>
                        <div>
                            <div class="demo-label-row">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Toppings (with AllowDeselect)</SgTypography>
                            </div>
                            <SgSegmented TValue="string"
                                         AllowMultiple="true"
                                         AllowDeselect="true"
                                         Options="@_toppingOptions"
                                         SelectedValues="@_selectedToppings"
                                         SelectedValuesChanged="OnToppingsChanged" />
                            @if (_selectedToppings?.Any() == true)
                            {
                                <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:8px;">
                                    @foreach (var t in _selectedToppings)
                                    {
                                        <SgTag Size="SgSize.Sm" Variant="SgTagVariant.Success">@t</SgTag>
                                    }
                                </div>
                            }
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Multi-Select Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_multiProperties" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 8. Disabled & Loading States                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Disabled & Loading States
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Disable the entire control, individual options, or show a skeleton while content loads.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Disabled State" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Lg">
                        <div>
                            <div class="demo-label-row">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Fully Disabled</SgTypography>
                            </div>
                            <SgSegmented TValue="string" Disabled="true" Options="@_dayOptions" Value="@("Mon")" />
                        </div>
                        <div>
                            <div class="demo-label-row">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Individual Options Disabled</SgTypography>
                                <span class="demo-value-chip">@_selectedPartDisabled</span>
                            </div>
                            <SgSegmented TValue="string" Options="@_partiallyDisabledOptions" @bind-Value="_selectedPartDisabled" Animated="true" />
                            <div style="margin-top:6px;">
                                <SgTag Size="SgSize.Sm" Variant="SgTagVariant.Warn">"Option C" is disabled</SgTag>
                            </div>
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Loading State" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Lg">
                        <div>
                            <div class="demo-label-row">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Skeleton Loading</SgTypography>
