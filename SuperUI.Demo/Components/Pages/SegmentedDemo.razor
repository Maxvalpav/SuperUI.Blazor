@page "/segmented-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgSegmented — Segmented Control — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Basic Usage                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Basic Usage
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Select a single value from a set of options. Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">@@bind-Value</SgTypography> for two-way binding.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Days of the Week
                        </SgTypography>
                        <SgSegmented TValue="string"
                                     Options="_dayOptions"
                                     @bind-Value="_selectedDay" />
                        <div style="margin-top:8px;">
                            <SgTag Variant="SgTagVariant.Info" Size="SgSize.Sm">Selected: @_selectedDay</SgTag>
                        </div>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With Disabled Option
                        </SgTypography>
                        <SgSegmented TValue="string"
                                     Options="_monthOptions"
                                     @bind-Value="_selectedMonth" />
                        <div style="margin-top:8px;">
                            <SgTag Variant="SgTagVariant.Success" Size="SgSize.Sm">Selected: @_selectedMonth</SgTag>
                        </div>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_basicProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Sizes                                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Sizes
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Three predefined sizes: <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Sm</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Md</SgTypography> (default), <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Lg</SgTypography>. Pass as string "sm", "md", or "lg".
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Small (sm)
                        </SgTypography>
                        <SgSegmented TValue="string" Size="sm" Options="_sizeOptions" @bind-Value="_sizeValue" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Medium (md — Default)
                        </SgTypography>
                        <SgSegmented TValue="string" Options="_sizeOptions" @bind-Value="_sizeValue" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Large (lg)
                        </SgTypography>
                        <SgSegmented TValue="string" Size="lg" Options="_sizeOptions" @bind-Value="_sizeValue" />
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_sizeProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Variants & Block                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Variants & Block Mode
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Choose between <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">default</SgTypography> and <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">primary</SgTypography> variant. <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Block</SgTypography> makes it fill the full container width.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Default Variant" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Inline
                            </SgTypography>
                            <SgSegmented TValue="string" Options="_alignOptions" @bind-Value="_selectedAlign" />
                        </div>
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Block (Full Width)
                            </SgTypography>
                            <SgSegmented TValue="string" Block="true" Options="_alignOptions" @bind-Value="_selectedAlign" />
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Primary Variant" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Inline
                            </SgTypography>
                            <SgSegmented TValue="string" Variant="primary" Options="_alignOptions" @bind-Value="_selectedAlign2" />
                        </div>
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Block (Full Width)
                            </SgTypography>
                            <SgSegmented TValue="string" Variant="primary" Block="true" Options="_alignOptions" @bind-Value="_selectedAlign2" />
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Pill & Vertical                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Pill & Vertical Orientation
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Pill</SgTypography> gives fully rounded segments (good for iOS-style). <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Vertical</SgTypography> stacks options vertically.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Pill (Rounded)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgSegmented TValue="string" Pill="true" Options="_dayOptions" @bind-Value="_selectedDay" />
                        <SgSegmented TValue="string" Pill="true" Block="true" Options="_sizeOptions" @bind-Value="_sizeValue" />
                        <SgSegmented TValue="string" Pill="true" Variant="primary" Block="true" Options="_alignOptions" @bind-Value="_selectedAlign" />
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Vertical Orientation" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgSegmented TValue="string" Vertical="true" Options="_dayOptions" @bind-Value="_selectedDay" />
                        <div style="margin-top:4px;">
                            <SgSegmented TValue="string" Vertical="true" Block="true" Options="_alignOptions" @bind-Value="_selectedAlign" />
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Icons & Badges                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Icons & Badges
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Add icons and badges to individual options. Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgHeroicons</SgTypography> for built-in vector icons.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="With Icons" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Lg">
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Icon + Label
                            </SgTypography>
                            <SgSegmented TValue="string" Options="_iconOptions" @bind-Value="_selectedIcon" />
                        </div>
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Icons Only (Small)
                            </SgTypography>
                            <SgSegmented TValue="string" Size="sm" Options="_iconOnlyOptions" @bind-Value="_selectedIconOnly" />
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="With Badges" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Lg">
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Status Badges
                            </SgTypography>
                            <SgSegmented TValue="string" Options="_badgeOptions" @bind-Value="_selectedBadge" Block="true" />
                        </div>
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Icons + Badges
                            </SgTypography>
                            <SgSegmented TValue="string" Options="_iconBadgeOptions" @bind-Value="_selectedIconBadge" Block="true" />
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. Disabled State                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Disabled State
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Disable the entire control or individual options. Disabled items are non-interactive and visually dimmed.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Fully Disabled
                        </SgTypography>
                        <SgSegmented TValue="string" Disabled="true" Options="_dayOptions" Value="@("Mon")" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Individual Options Disabled
                        </SgTypography>
                        <SgSegmented TValue="string" Options="_partiallyDisabledOptions" @bind-Value="_selectedPartDisabled" />
                        <div style="margin-top:8px;">
                            <SgTag Variant="SgTagVariant.Warn" Size="SgSize.Sm">Selected: @_selectedPartDisabled</SgTag>
                        </div>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Option Model" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_optionProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 7. Live Constructor                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live SgSegmented Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Tweak parameters below and see the result in real time. Click the copy button to grab the code.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Options Count -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Options Count</SgTypography>
                            <SgSegmented TValue="int"
                                         Value="_ctorOptionsCount"
                                         ValueChanged="v => { _ctorOptionsCount = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_ctorCountOptions" />
                        </SgStack>

                        <!-- Size -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                            <SgSegmented TValue="string"
                                         Value="@_ctorSize"
                                         ValueChanged="v => { _ctorSize = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_ctorSizeOptions" />
                        </SgStack>

                        <!-- Variant -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Variant</SgTypography>
                            <SgSegmented TValue="string"
                                         Value="@_ctorVariant"
                                         ValueChanged="v => { _ctorVariant = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_ctorVariantOptions" />
                        </SgStack>

                        <!-- Toggles -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Block</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorBlock"
                                                 ValueChanged="v => { _ctorBlock = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Pill</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorPill"
                                                 ValueChanged="v => { _ctorPill = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Vertical</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorVertical"
                                                 ValueChanged="v => { _ctorVertical = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Disabled</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorDisabled"
                                                 ValueChanged="v => { _ctorDisabled = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions2" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Options</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorOptionsCount.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Success" Text="@_ctorSize" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Variant</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorVariant" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <div class="constructor-preview" id="constructor-preview">
                                <SgSegmented TValue="string"
                                             Size="@_ctorSize"
                                             Variant="@_ctorVariant"
                                             Block="@_ctorBlock"
                                             Pill="@_ctorPill"
                                             Vertical="@_ctorVertical"
                                             Disabled="@_ctorDisabled"
                                             Options="_ctorPreviewOptions"
                                             @bind-Value="_ctorPreviewValue" />
                            </div>
                        </SgStack>

                        <!-- Code with Copy -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                    <span id="copy-icon">@_copyIcon</span>
                                    <span id="copy-text" style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                </button>
                            </div>
                            <div class="code-block" id="code-block">
                                @foreach (var line in _generatedCodeLines)
                                {
                                    <code>@line</code>
                                }
