            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Custom Item Template" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgSegmented TValue="string"
                                     Options="@_iconOptions"
                                     @bind-Value="_selectedIcon"
                                     Animated="true">
                            <ItemTemplate>
                                <span style="display:inline-flex;align-items:center;gap:6px;">
                                    <span style="display:inline-flex;width:18px;height:18px;border-radius:4px;background:color-mix(in srgb, var(--sg-color-primary) 12%, transparent);align-items:center;justify-content:center;">
                                        @context.Icon
                                    </span>
                                    <span>@context.Label</span>
                                    @if (context.Value == "list")
                                    {
                                        <span style="font-size:9px;color:var(--sg-color-success);">✓</span>
                                    }
                                </span>
                            </ItemTemplate>
                        </SgSegmented>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Prefix & Suffix" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">With prefix icon and suffix text</SgTypography>
                        <SgSegmented TValue="string"
                                     Options="@_sizeOptions"
                                     @bind-Value="_sizeValue"
                                     Block="true">
                            <Prefix>
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
                            </Prefix>
                            <Suffix>
                                <span style="font-size:10px;color:var(--sg-text-muted);">▼</span>
                            </Suffix>
                        </SgSegmented>
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Vertical with prefix</SgTypography>
                        <SgSegmented TValue="string"
                                     Options="@_alignOptions"
                                     @bind-Value="_selectedAlign"
                                     Vertical="true"
                                     Block="true">
                            <Prefix>
                                <span style="font-size:10px;font-weight:600;color:var(--sg-text-muted);">Align:</span>
                            </Prefix>
                        </SgSegmented>
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 10. Keyboard Navigation                                            -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
