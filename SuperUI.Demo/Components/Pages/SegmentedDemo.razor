    // ── Lifecycle ────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add($"<SgSegmented TValue=\"string\"");
        if (_ctorSize != "md")
            lines.Add($"             Size=\"{_ctorSize}\"");
        if (_ctorVariant != "default")
            lines.Add($"             Variant=\"{_ctorVariant}\"");
        if (_ctorBlock)
            lines.Add($"             Block=\"true\"");
        if (_ctorPill)
            lines.Add($"             Pill=\"true\"");
        if (_ctorVertical)
            lines.Add($"             Vertical=\"true\"");
        if (_ctorDisabled)
            lines.Add($"             Disabled=\"true\"");
        lines.Add($"             Options=\"_myOptions\"");
        lines.Add($"             @@bind-Value=\"_myValue\" />");
        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

