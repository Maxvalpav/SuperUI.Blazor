@page "/segmented-demo"
@using SuperUI.Components

<PageTitle>Segmented - SUI</PageTitle>

<SgCard Title="SgSegmented - Segmented Control"
        Subtitle="iOS-style segmented control for switching between views or options.">

    <div style="margin-top: 32px;">
        <h2>Basic Usage</h2>
        <p>Select a single value from a set of options.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Default</div>
                        <SgSegmented TValue="string"
                                     Options="_dayOptions"
                                     @bind-Value="_selectedDay" />
                        <div style="margin-top: 8px; font-size: 12px;">Selected: <strong>@_selectedDay</strong></div>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">With disabled option</div>
                        <SgSegmented TValue="string"
                                     Options="_monthOptions"
                                     @bind-Value="_selectedMonth" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_basicProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Sizes & Layout</h2>
        <p>Different sizes and full-width mode.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Small</div>
                        <SgSegmented TValue="string" Size="sm" Options="_sizeOptions" @bind-Value="_sizeValue" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Large</div>
                        <SgSegmented TValue="string" Size="lg" Options="_sizeOptions" @bind-Value="_sizeValue" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Block (full width)</div>
                        <SgSegmented TValue="string" Block="true" Options="_sizeOptions" @bind-Value="_sizeValue" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_layoutProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Disabled State</h2>
        <p>Disable the entire control or individual options.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Fully disabled</div>
                        <SgSegmented TValue="string" Disabled="true" Options="_dayOptions" Value="@("Mon")" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Option Model">
                <PropertyTable Items="_optionProperties" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private string _selectedDay = "Tue";
    private string _selectedMonth = "Jan";
    private string _sizeValue = "M";

    private List<SgSegmentedOption<string>> _dayOptions = new()
    {
        new() { Value = "Mon", Label = "Mon" },
        new() { Value = "Tue", Label = "Tue" },
        new() { Value = "Wed", Label = "Wed" },
        new() { Value = "Thu", Label = "Thu" },
        new() { Value = "Fri", Label = "Fri" }
    };

    private List<SgSegmentedOption<string>> _monthOptions = new()
    {
        new() { Value = "Jan", Label = "Jan" },
        new() { Value = "Feb", Label = "Feb" },
        new() { Value = "Mar", Label = "Mar", Disabled = true },
        new() { Value = "Apr", Label = "Apr" }
    };

    private List<SgSegmentedOption<string>> _sizeOptions = new()
    {
        new() { Value = "S", Label = "Small" },
        new() { Value = "M", Label = "Medium" },
        new() { Value = "L", Label = "Large" }
    };

    private List<PropertyPanelItem> _basicProperties = new()
    {
        new() { Label = "Options", Value = "IEnumerable<SgSegmentedOption<TValue>>", BadgeText = "Options", BadgeVariant = "info" },
        new() { Label = "Value", Value = "TValue", BadgeText = "Selected value", BadgeVariant = "warn" },
        new() { Label = "ValueChanged", Value = "EventCallback<TValue>", BadgeText = "Change event", BadgeVariant = "success" },
        new() { Label = "Disabled", Value = "bool", BadgeText = "Disabled", BadgeVariant = "warn" }
    };

    private List<PropertyPanelItem> _layoutProperties = new()
    {
        new() { Label = "Size", Value = "sm | md | lg", BadgeText = "Size", BadgeVariant = "info" },
        new() { Label = "Block", Value = "bool", BadgeText = "Full width", BadgeVariant = "warn" },
        new() { Label = "CssClass", Value = "string", BadgeText = "Custom CSS", BadgeVariant = "info" },
        new() { Label = "AriaLabel", Value = "string", BadgeText = "Accessibility", BadgeVariant = "info" }
    };

    private List<PropertyPanelItem> _optionProperties = new()
    {
        new() { Label = "Value", Value = "TValue", BadgeText = "Option value", BadgeVariant = "info" },
        new() { Label = "Label", Value = "string", BadgeText = "Display text", BadgeVariant = "info" },
        new() { Label = "Disabled", Value = "bool", BadgeText = "Disabled option", BadgeVariant = "warn" },
        new() { Label = "Icon", Value = "RenderFragment", BadgeText = "Option icon", BadgeVariant = "info" }
    };
}
