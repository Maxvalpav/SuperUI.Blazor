@page "/d3-demo"
@using SuperUI.Components

<PageTitle>D3.js Визуализация - SUI</PageTitle>

<div class="d3-demo-page">
<div class="d3-demo-header">
    <div>
        <h1 class="d3-demo-title">SgD3Chart</h1>
        <p class="d3-demo-subtitle">D3.js — 10 типов визуализации, физические симуляции, иерархии, анимации, экспорт SVG/PNG</p>
    </div>
</div>

<SgTabs>

<!-- ══════════════════════════════════════════════════════════
     Временные ряды
══════════════════════════════════════════════════════════ -->
<SgTabPanel Title="� Временные ряды">
    <div class="d3-grid-2">

        <SgCard Title="Биржевые котировки — мульти-серии">
            <div class="d3-gen-bar">
                <span class="d3-gen-label">Период:</span>
                @foreach (var p in new[]{ ("1М",30), ("3М",90), ("6М",180) })
                {
                    var pp = p;
                    <button class="d3-gen-btn @(_d3StockPeriod == pp.Item2 ? "active" : "")"
                            @onclick="@(() => { _d3StockPeriod = pp.Item2; RegenD3Stock(); })">@pp.Item1</button>
                }
                <button class="d3-gen-btn d3-gen-refresh" @onclick="RegenD3Stock">↻</button>
            </div>
            <SgD3Chart ChartType="SgD3ChartType.Line"
                       Data="@_d3StockData"
                       Options="@_d3StockOpts"
                       Height="300px" ShowToolbar="true" />
        </SgCard>

        <SgCard Title="Площадной — CPU / RAM мониторинг">
            <div class="d3-gen-bar">
                <span class="d3-gen-label">Точек:</span>
                @foreach (var n in new[]{ 24, 48, 96 })
                {
                    var nn = n;
                    <button class="d3-gen-btn @(_d3MonPoints == nn ? "active" : "")"
                            @onclick="@(() => { _d3MonPoints = nn; RegenD3Monitor(); })">@nn</button>
                }
                <button class="d3-gen-btn d3-gen-refresh" @onclick="RegenD3Monitor">↻</button>
            </div>
            <SgD3Chart ChartType="SgD3ChartType.Area"
                       Data="@_d3MonData"
                       Options="@_d3MonOpts"
                       Height="300px" ShowToolbar="true" />
        </SgCard>

        <SgCard Title="Radar — сравнение технологий">
            <div class="d3-gen-bar">
                <button class="d3-gen-btn d3-gen-refresh" @onclick="RegenD3Radar">↻ Новые данные</button>
            </div>
            <SgD3Chart ChartType="SgD3ChartType.Radar"
                       Data="@_d3RadarData"
                       Options="@_d3RadarOpts"
                       Height="300px" ShowToolbar="true" />
        </SgCard>

        <SgCard Title="Scatter — корреляция цена/качество">
            <div class="d3-gen-bar">
                <span class="d3-gen-label">Точек:</span>
                @foreach (var n in new[]{ 40, 100, 200 })
                {
                    var nn = n;
                    <button class="d3-gen-btn @(_d3ScatterN == nn ? "active" : "")"
                            @onclick="@(() => { _d3ScatterN = nn; RegenD3Scatter(); })">@nn</button>
                }
                <button class="d3-gen-btn d3-gen-refresh" @onclick="RegenD3Scatter">↻</button>
            </div>
            <SgD3Chart ChartType="SgD3ChartType.Scatter"
                       Data="@_d3ScatterData"
                       Options="@_d3ScatterOpts"
                       Height="300px" ShowToolbar="true" />
        </SgCard>

    </div>
</SgTabPanel>

<!-- ══════════════════════════════════════════════════════════
     Столбчатые / Круговые
══════════════════════════════════════════════════════════ -->
<SgTabPanel Title="� Столбчатые / Круговые">
    <div class="d3-grid-2">

        <SgCard Title="Grouped bar — демография по возрасту">
            <div class="d3-gen-bar">
                <button class="d3-gen-btn d3-gen-refresh" @onclick="RegenD3Demo">↻ Новые данные</button>
            </div>
            <SgD3Chart ChartType="SgD3ChartType.Bar"
                       Data="@_d3DemoData"
                       Options="@_d3DemoOpts"
                       Height="300px" ShowToolbar="true" />
        </SgCard>

        <SgCard Title="Stacked bar — источники энергии по годам">
            <div class="d3-gen-bar">
                <span class="d3-gen-label">Лет:</span>
                @foreach (var n in new[]{ 5, 8, 12 })
                {
                    var nn = n;
                    <button class="d3-gen-btn @(_d3EnergyYears == nn ? "active" : "")"
                            @onclick="@(() => { _d3EnergyYears = nn; RegenD3Energy(); })">@nn</button>
                }
            </div>
            <SgD3Chart ChartType="SgD3ChartType.Bar"
                       Data="@_d3EnergyData"
                       Options="@_d3EnergyOpts"
                       Height="300px" ShowToolbar="true" />
        </SgCard>

        <SgCard Title="Donut — распределение языков программирования">
            <div class="d3-gen-bar">
                <span class="d3-gen-label">Топ:</span>
                @foreach (var n in new[]{ 5, 7, 10 })
                {
                    var nn = n;
                    <button class="d3-gen-btn @(_d3LangTop == nn ? "active" : "")"
                            @onclick="@(() => { _d3LangTop = nn; RegenD3Lang(); })">@nn</button>
                }
            </div>
            <SgD3Chart ChartType="SgD3ChartType.Donut"
                       Data="@_d3LangData"
                       Options="@_d3LangOpts"
                       Height="300px" ShowToolbar="true" />
        </SgCard>

        <SgCard Title="Горизонтальный — рейтинг стран по ВВП">
            <div class="d3-gen-bar">
                <button class="d3-gen-btn d3-gen-refresh" @onclick="RegenD3Gdp">↻ Перемешать</button>
            </div>
            <SgD3Chart ChartType="SgD3ChartType.BarHorizontal"
                       Data="@_d3GdpData"
                       Options="@_d3GdpOpts"
                       Height="300px" ShowToolbar="true" />
        </SgCard>

    </div>
</SgTabPanel>

<!-- ══════════════════════════════════════════════════════════
     Сети / Иерархии
══════════════════════════════════════════════════════════ -->
<SgTabPanel Title="🕸️ Сети / Иерархии">
    <div class="d3-grid-2">

        <SgCard Title="Force Graph — социальная сеть">
            <p class="d3-card-desc">Перетаскивайте узлы. Толщина связи = сила взаимодействия.</p>
            <div class="d3-gen-bar">
                <span class="d3-gen-label">Узлов:</span>
                @foreach (var n in new[]{ 12, 20, 35 })
                {
                    var nn = n;
                    <button class="d3-gen-btn @(_d3SocialN == nn ? "active" : "")"
                            @onclick="@(() => { _d3SocialN = nn; RegenD3Social(); })">@nn</button>
                }
                <button class="d3-gen-btn d3-gen-refresh" @onclick="RegenD3Social">↻</button>
            </div>
            <SgD3Chart ChartType="SgD3ChartType.ForceGraph"
                       GraphData="@_d3SocialGraph"
                       Options="@_d3SocialOpts"
                       Height="380px" ShowToolbar="true" />
        </SgCard>

        <SgCard Title="Force Graph — зависимости npm-пакетов">
            <p class="d3-card-desc">Цвет = тип зависимости. Размер = количество зависимых.</p>
            <SgD3Chart ChartType="SgD3ChartType.ForceGraph"
                       GraphData="@_d3NpmGraph"
                       Options="@_d3NpmOpts"
                       Height="380px" ShowToolbar="true" />
        </SgCard>

        <SgCard Title="Treemap — бюджет компании">
            <div class="d3-gen-bar">
                <button class="d3-gen-btn d3-gen-refresh" @onclick="RegenD3Budget">↻ Новый бюджет</button>
            </div>
            <SgD3Chart ChartType="SgD3ChartType.Treemap"
                       Data="@_d3BudgetData"
                       Options="@_d3BudgetOpts"
                       Height="380px" ShowToolbar="true" />
        </SgCard>

        <SgCard Title="Treemap — мировые языки по числу носителей">
            <SgD3Chart ChartType="SgD3ChartType.Treemap"
                       Data="@_d3LangTreeData"
                       Options="@_d3LangTreeOpts"
                       Height="380px" ShowToolbar="true" />
        </SgCard>

    </div>
</SgTabPanel>

<!-- ══════════════════════════════════════════════════════════
     Интерактивность
══════════════════════════════════════════════════════════ -->
<SgTabPanel Title="🖱️ Интерактивность">
    <div class="d3-grid-2">

        <SgCard Title="Клик → детали элемента">
            <p class="d3-card-desc">Кликните по любому столбцу.</p>
            <div class="d3-gen-bar">
                <button class="d3-gen-btn d3-gen-refresh" @onclick="RegenD3Click">↻ Новые данные</button>
            </div>
            <SgD3Chart ChartType="SgD3ChartType.Bar"
                       Data="@_d3ClickData"
                       Options="@_d3ClickOpts"
                       Height="240px"
                       OnDataPointClick="OnD3Click" />
            @if (_d3LastClick is not null)
            {
                <div class="d3-event-box">
                    <div class="d3-event-row"><span>Label</span><code>@_d3LastClick.Label</code></div>
                    <div class="d3-event-row"><span>Value</span><code>@_d3LastClick.Value.ToString("N0")</code></div>
                    <div class="d3-event-row"><span>Group</span><code>@(_d3LastClick.Group ?? "—")</code></div>
                    <div class="d3-event-row"><span>Index</span><code>@_d3LastClick.Index</code></div>
                </div>
            }
        </SgCard>

        <SgCard Title="Зум и пан — Ctrl+колесо">
            <p class="d3-card-desc">Удерживайте Ctrl и прокручивайте колесо. Shift+drag для панорамирования.</p>
            <SgD3Chart ChartType="SgD3ChartType.Line"
                       Data="@_d3ZoomData"
                       Options="@_d3ZoomOpts"
                       Height="300px" ShowToolbar="true" />
        </SgCard>

        <SgCard Title="Radar — клик по точке">
            <p class="d3-card-desc">Кликните по точке на радарной диаграмме.</p>
            <SgD3Chart ChartType="SgD3ChartType.Radar"
                       Data="@_d3RadarData"
                       Options="@_d3RadarClickOpts"
                       Height="300px"
                       OnDataPointClick="OnD3Click" />
        </SgCard>

        <SgCard Title="Treemap — клик по блоку">
            <p class="d3-card-desc">Кликните по блоку для просмотра деталей.</p>
            <SgD3Chart ChartType="SgD3ChartType.Treemap"
                       Data="@_d3BudgetData"
                       Options="@_d3BudgetOpts"
                       Height="300px"
                       OnDataPointClick="OnD3Click" />
        </SgCard>

    </div>
</SgTabPanel>

<!-- ══════════════════════════════════════════════════════════
     API
══════════════════════════════════════════════════════════ -->
<SgTabPanel Title="📋 API">
    <div class="d3-api-page">
        <SgCard Title="Параметры SgD3Chart" style="margin-bottom:24px">
            <table class="d3-api-table">
                <thead><tr><th>Параметр</th><th>Тип</th><th>По умолчанию</th><th>Описание</th></tr></thead>
                <tbody>
                    <tr><td><code>ChartType</code></td><td>SgD3ChartType</td><td>Bar</td><td>Тип визуализации</td></tr>
                    <tr><td><code>Data</code></td><td>IEnumerable&lt;SgD3DataPoint&gt;?</td><td>null</td><td>Данные (все типы кроме ForceGraph)</td></tr>
                    <tr><td><code>GraphData</code></td><td>SgD3GraphData?</td><td>null</td><td>Узлы и рёбра для ForceGraph</td></tr>
                    <tr><td><code>Options</code></td><td>SgD3Options?</td><td>defaults</td><td>Настройки отображения</td></tr>
                    <tr><td><code>Height / Width</code></td><td>string</td><td>400px / 100%</td><td>Размеры контейнера</td></tr>
                    <tr><td><code>ShowToolbar</code></td><td>bool</td><td>false</td><td>Тулбар (сброс зума, SVG/PNG)</td></tr>
                    <tr><td><code>Sources</code></td><td>SgD3Sources?</td><td>CDN</td><td>URL для D3.js</td></tr>
                    <tr><td><code>OnDataPointClick</code></td><td>EventCallback&lt;SgD3ClickEventArgs&gt;</td><td>—</td><td>Клик по элементу</td></tr>
                </tbody>
            </table>
        </SgCard>
        <SgCard Title="SgD3Options" style="margin-bottom:24px">
            <table class="d3-api-table">
                <thead><tr><th>Свойство</th><th>Тип</th><th>По умолчанию</th><th>Описание</th></tr></thead>
                <tbody>
                    <tr><td><code>ShowGrid / ShowLabels / ShowLegend</code></td><td>bool</td><td>true</td><td>Сетка, метки, легенда</td></tr>
                    <tr><td><code>EnableZoom</code></td><td>bool</td><td>false</td><td>Зум/пан (Ctrl+колесо)</td></tr>
                    <tr><td><code>Animate / AnimationDuration</code></td><td>bool / int</td><td>true / 600</td><td>Анимация при рендере</td></tr>
                    <tr><td><code>Colors</code></td><td>List&lt;string&gt;?</td><td>null</td><td>Кастомная палитра</td></tr>
                    <tr><td><code>ValueSuffix / ValueDecimals</code></td><td>string? / int?</td><td>null</td><td>Формат тултипов</td></tr>
                    <tr><td><code>Curve</code></td><td>string</td><td>"monotone"</td><td>linear, monotone, step, basis</td></tr>
                    <tr><td><code>ShowPoints</code></td><td>bool</td><td>true</td><td>Точки на линии/площади</td></tr>
                    <tr><td><code>Stacked</code></td><td>bool</td><td>false</td><td>Стэкинг столбцов</td></tr>
                    <tr><td><code>DonutInnerRadius</code></td><td>double</td><td>0.55</td><td>Радиус отверстия Donut (0–1)</td></tr>
                    <tr><td><code>ForceDistance / ForceCharge</code></td><td>double</td><td>80 / -200</td><td>Параметры физики графа</td></tr>
                </tbody>
            </table>
        </SgCard>
        <SgCard Title="Типы визуализации">
            <div class="d3-types-grid">
                @foreach (var t in _chartTypes)
                {
                    <div class="d3-type-card">
                        <span class="d3-type-icon">@t.Icon</span>
                        <div><div class="d3-type-name">@t.Name</div><div class="d3-type-desc">@t.Desc</div></div>
                    </div>
                }
            </div>
        </SgCard>
    </div>
</SgTabPanel>

</SgTabs>
</div>

@code {
    private static readonly Random _rnd = new(Environment.TickCount);

    // ── Events ────────────────────────────────────────────────────────────────
    private SgD3ClickEventArgs? _d3LastClick;
    private void OnD3Click(SgD3ClickEventArgs e) { _d3LastClick = e; StateHasChanged(); }

    // ── Chart types ref ───────────────────────────────────────────────────────
    private record ChartTypeInfo(string Icon, string Name, string Desc);
    private readonly ChartTypeInfo[] _chartTypes =
    [
        new("📊","Bar",          "Вертикальные столбцы, grouped, stacked"),
        new("📉","BarHorizontal","Горизонтальные столбцы, рейтинги"),
        new("📈","Line",         "Линейный тренд, мульти-серии"),
        new("🏔️","Area",         "Площадной с заливкой"),
        new("⚫","Scatter",      "Точечный, корреляция, кластеры"),
        new("🥧","Pie",          "Круговая диаграмма"),
        new("🍩","Donut",        "Кольцевая с суммой в центре"),
        new("🕸️","ForceGraph",   "Граф с физической симуляцией D3"),
        new("🗺️","Treemap",      "Иерархия площадями"),
        new("🕷️","Radar",        "Радарная / паутина"),
    ];

    // ── Stock ─────────────────────────────────────────────────────────────────
    private int _d3StockPeriod = 90;
    private List<SgD3DataPoint> _d3StockData = new();
    private readonly SgD3Options _d3StockOpts = new()
    {
        ShowLegend = true, ShowPoints = false, Curve = "monotone",
        ValueSuffix = " ₽", ValueDecimals = 0,
        Colors = ["#2563eb","#f59e0b","#10b981"],
    };

    private void RegenD3Stock()
    {
        var list = new List<SgD3DataPoint>();
        double p1 = 1200, p2 = 900, p3 = 1500;
        for (int i = 0; i < _d3StockPeriod; i++)
        {
            var d = DateTime.Today.AddDays(i - _d3StockPeriod + 1).ToString("dd.MM");
            p1 += (_rnd.NextDouble() - 0.48) * 28 + Math.Sin(i / 12.0) * 6;
            p2 += (_rnd.NextDouble() - 0.50) * 22 + Math.Cos(i / 15.0) * 5;
            p3 += (_rnd.NextDouble() - 0.46) * 35 + Math.Sin(i / 20.0) * 8;
            list.Add(new() { Label = d, Value = Math.Round(Math.Max(300, p1)), Group = "AAPL" });
            list.Add(new() { Label = d, Value = Math.Round(Math.Max(200, p2)), Group = "MSFT" });
            list.Add(new() { Label = d, Value = Math.Round(Math.Max(400, p3)), Group = "GOOG" });
        }
        _d3StockData = list;
    }

    // ── Monitor area ──────────────────────────────────────────────────────────
    private int _d3MonPoints = 48;
    private List<SgD3DataPoint> _d3MonData = new();
    private readonly SgD3Options _d3MonOpts = new()
    {
        ShowLegend = true, ShowPoints = false, Curve = "monotone",
        ValueSuffix = "%", ValueDecimals = 0,
        Colors = ["#ef4444","#3b82f6"],
    };

    private void RegenD3Monitor()
    {
        var list = new List<SgD3DataPoint>();
        double cpu = 35, ram = 60;
        for (int i = 0; i < _d3MonPoints; i++)
        {
            cpu = Math.Clamp(cpu + (_rnd.NextDouble() - 0.5) * 14, 5, 95);
            ram = Math.Clamp(ram + (_rnd.NextDouble() - 0.5) * 6,  20, 90);
            var lbl = $"T-{_d3MonPoints - i}";
            list.Add(new() { Label = lbl, Value = Math.Round(cpu), Group = "CPU" });
            list.Add(new() { Label = lbl, Value = Math.Round(ram), Group = "RAM" });
        }
        _d3MonData = list;
    }

    // ── Radar ─────────────────────────────────────────────────────────────────
    private List<SgD3DataPoint> _d3RadarData = new();
    private readonly SgD3Options _d3RadarOpts    = new() { ShowLegend = true };
    private readonly SgD3Options _d3RadarClickOpts = new() { ShowLegend = true };

    private void RegenD3Radar()
    {
        var axes = new[] { "Производительность","Надёжность","Безопасность","Масштабируемость","Удобство","Цена" };
        var techs = new[] { "Blazor","React","Angular","Vue" };
        var list = new List<SgD3DataPoint>();
        foreach (var tech in techs.Take(3))
            foreach (var ax in axes)
                list.Add(new() { Label = ax, Value = 50 + _rnd.NextDouble() * 50, Group = tech });
        _d3RadarData = list;
    }

    // ── Scatter ───────────────────────────────────────────────────────────────
    private int _d3ScatterN = 100;
    private List<SgD3DataPoint> _d3ScatterData = new();
    private readonly SgD3Options _d3ScatterOpts = new()
    {
        ShowLegend = true, ValueDecimals = 1,
        Colors = ["#2563eb","#10b981","#f59e0b"],
    };

    private void RegenD3Scatter()
    {
        var groups = new[] { "Бюджет","Средний","Премиум" };
        var centers = new[] { (20.0, 30.0), (50.0, 60.0), (80.0, 85.0) };
        var list = new List<SgD3DataPoint>();
        for (int i = 0; i < _d3ScatterN; i++)
        {
            int g = i % 3;
            var (cx, cy) = centers[g];
            list.Add(new()
            {
                Label = $"Товар {i + 1}",
                Value = Math.Round(cy + (_rnd.NextDouble() - 0.5) * 25, 1),
                Group = groups[g],
            });
        }
        _d3ScatterData = list;
    }

    // ── Demographics ──────────────────────────────────────────────────────────
    private List<SgD3DataPoint> _d3DemoData = new();
    private readonly SgD3Options _d3DemoOpts = new()
    {
        ShowLegend = true, ValueSuffix = " млн.", ValueDecimals = 1,
        Colors = ["#3b82f6","#ec4899"],
    };

    private void RegenD3Demo()
    {
        var ages = new[] { "0–14","15–24","25–34","35–44","45–54","55–64","65+" };
        var list = new List<SgD3DataPoint>();
        foreach (var age in ages)
        {
            list.Add(new() { Label = age, Value = Math.Round(5 + _rnd.NextDouble() * 20, 1), Group = "Мужчины" });
            list.Add(new() { Label = age, Value = Math.Round(5 + _rnd.NextDouble() * 20, 1), Group = "Женщины" });
        }
        _d3DemoData = list;
    }

    // ── Energy stacked ────────────────────────────────────────────────────────
    private int _d3EnergyYears = 8;
    private List<SgD3DataPoint> _d3EnergyData = new();
    private readonly SgD3Options _d3EnergyOpts = new()
    {
        ShowLegend = true, Stacked = true, ValueSuffix = " ТВт·ч", ValueDecimals = 0,
        Colors = ["#f59e0b","#3b82f6","#10b981","#8b5cf6"],
    };

    private void RegenD3Energy()
    {
        var sources = new[] { "Уголь","Газ","Возобновляемые","Атом" };
        var list = new List<SgD3DataPoint>();
        int startYear = 2024 - _d3EnergyYears + 1;
        for (int y = 0; y < _d3EnergyYears; y++)
        {
            double coal = 400 - y * 15 + _rnd.NextDouble() * 30;
            double gas  = 300 - y * 5  + _rnd.NextDouble() * 25;
            double ren  = 100 + y * 25 + _rnd.NextDouble() * 20;
            double nuc  = 150 + y * 3  + _rnd.NextDouble() * 15;
            var yr = (startYear + y).ToString();
            list.Add(new() { Label = yr, Value = Math.Round(coal), Group = "Уголь" });
            list.Add(new() { Label = yr, Value = Math.Round(gas),  Group = "Газ" });
            list.Add(new() { Label = yr, Value = Math.Round(ren),  Group = "Возобновляемые" });
            list.Add(new() { Label = yr, Value = Math.Round(nuc),  Group = "Атом" });
        }
        _d3EnergyData = list;
    }

    // ── Languages donut ───────────────────────────────────────────────────────
    private int _d3LangTop = 7;
    private List<SgD3DataPoint> _d3LangData = new();
    private readonly SgD3Options _d3LangOpts = new()
    {
        ShowLegend = true, DonutInnerRadius = 0.55, ValueSuffix = "%", ValueDecimals = 1,
    };

    private static readonly (string Name, double Share)[] _langShares =
    [
