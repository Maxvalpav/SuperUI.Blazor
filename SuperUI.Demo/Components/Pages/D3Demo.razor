    // ── Constructor ───────────────────────────────────────────────────────────
    public D3Demo()
    {
        // Pre-generate zoom data in constructor (static-ish)
        var zoomList = new List<SgD3DataPoint>(120);
        double v1 = 50, v2 = 70;
        for (int i = 0; i < 60; i++)
        {
            v1 += (new Random(i * 7).NextDouble() - 0.5) * 8 + Math.Sin(i / 8.0) * 3;
            v2 += (new Random(i * 13).NextDouble() - 0.5) * 6 + Math.Cos(i / 10.0) * 2;
            zoomList.Add(new() { Label = $"T{i}", Value = Math.Round(v1, 1), Group = "Серия A" });
            zoomList.Add(new() { Label = $"T{i}", Value = Math.Round(v2, 1), Group = "Серия B" });
        }
        _d3ZoomData = zoomList;
    }

