    // ── Social force graph ────────────────────────────────────────────────────
    private int _d3SocialN = 20;
    private SgD3GraphData _d3SocialGraph = new();
    private readonly SgD3Options _d3SocialOpts = new()
    {
        ForceDistance = 90, ForceCharge = -300,
        Colors = ["#2563eb","#10b981","#f59e0b","#ef4444"],
    };

    private void RegenD3Social()
    {
        var groups = new[] { "Разработка","Маркетинг","Продажи","Менеджмент" };
        var names = new[] {
            "Алекс","Мария","Иван","Анна","Пётр","Елена","Дмитрий","Ольга",
            "Сергей","Наталья","Андрей","Татьяна","Михаил","Юлия","Николай",
            "Ирина","Владимир","Светлана","Алексей","Екатерина","Роман","Виктория",
            "Артём","Ксения","Павел","Людмила","Денис","Марина","Кирилл","Вера",
            "Максим","Галина","Тимур","Надежда","Руслан","Зоя",
        };
        var nodes = Enumerable.Range(0, _d3SocialN).Select(i => new SgD3Node
        {
            Id    = $"u{i}",
            Label = names[i % names.Length],
            Value = 2 + _rnd.Next(8),
            Group = groups[i % groups.Length],
        }).ToList();

        var links = new List<SgD3Link>();
        for (int i = 1; i < nodes.Count; i++)
        {
            links.Add(new() { Source = $"u{_rnd.Next(i)}", Target = $"u{i}", Value = 1 + _rnd.Next(3) });
        }
        for (int i = 0; i < _d3SocialN / 3; i++)
        {
            int a = _rnd.Next(nodes.Count), b = _rnd.Next(nodes.Count);
            if (a != b) links.Add(new() { Source = $"u{a}", Target = $"u{b}", Value = 1 });
        }
        _d3SocialGraph = new() { Nodes = nodes, Links = links };
    }

