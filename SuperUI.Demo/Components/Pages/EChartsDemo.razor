@page "/echarts-demo"
@using SuperUI.Components
@implements IDisposable

<PageTitle>ECharts — SUI</PageTitle>
<SgSeoHead Description="Explore ECharts — SuperUI Blazor component library demo with live examples, code snippets, and API documentation." />

<div class="ec-demo-page">
<div class="ec-demo-header">
    <h1 class="ec-demo-title">SgECharts</h1>
    <p class="ec-demo-subtitle">Apache ECharts — 15 типов графиков, генераторы данных, интерактивность</p>
</div>

<SgTabs>

<!-- ══════════════════════════════════════════════════════════ Линейные -->
<SgTabPanel Title="📈 Линейные">
    <div class="ec-grid-2">

        <SgCard Title="Линейный — мульти-серии">
            <div class="ec-gen-bar">
                <button class="ec-btn" @onclick="RegenLine">↻ Обновить</button>
                <label class="ec-toggle"><input type="checkbox" @bind="_lineSmooth" @bind:after="RegenLine"/>Сглаживание</label>
                <label class="ec-toggle"><input type="checkbox" @bind="_lineZoom"   @bind:after="RegenLine"/>Зум</label>
            </div>
            <SgECharts ChartType="SgEChartsType.Line"
                       Data="@_lineData"
                       Options="@_lineOpts"
                       Height="300px" />
        </SgCard>

        <SgCard Title="Площадной — трафик">
            <div class="ec-gen-bar">
                <button class="ec-btn" @onclick="RegenArea">↻ Обновить</button>
                <label class="ec-toggle"><input type="checkbox" @bind="_areaStacked" @bind:after="RegenArea"/>Stacked</label>
            </div>
            <SgECharts ChartType="SgEChartsType.Area"
                       Data="@_areaData"
                       Options="@_areaOpts"
                       Height="300px" />
        </SgCard>

        <SgCard Title="Scatter — корреляция">
            <div class="ec-gen-bar">
                <span class="ec-label">Точек:</span>
                @foreach (var n in new[]{ 50, 150, 300 })
                {
                    var nn = n;
                    <button class="ec-btn @(_scatterN == nn ? "active" : "")"
                            @onclick="@(() => { _scatterN = nn; RegenScatter(); })">@nn</button>
                }
            </div>
            <SgECharts ChartType="SgEChartsType.Scatter"
                       Data="@_scatterData"
                       Options="@_scatterOpts"
                       Height="300px" />
        </SgCard>

        <SgCard Title="Radar — сравнение">
            <div class="ec-gen-bar">
                <button class="ec-btn" @onclick="RegenRadar">↻ Обновить</button>
            </div>
            <SgECharts ChartType="SgEChartsType.Radar"
                       Data="@_radarData"
                       Options="@_radarOpts"
                       Height="300px" />
        </SgCard>

    </div>
</SgTabPanel>

<!-- ══════════════════════════════════════════════════════════ Столбчатые -->
<SgTabPanel Title="📊 Столбчатые">
    <div class="ec-grid-2">

                <SgCard Title="Real-time Candlestick — биржа  + “Прибор” (синус + шум) — real-time стрим">
            <div class="ec-gen-bar">
                <button class="ec-btn" @onclick="StartRealTime" disabled="@_rtRunning">▶ Start</button>
                <button class="ec-btn" @onclick="StopRealTime"  disabled="@(!_rtRunning)">⏸ Stop</button>
                <label class="ec-toggle" title="Сколько свечей хранить в окне">
                    <input type="checkbox" disabled checked />
                    Окно: @(_rtDays) дней
                </label>
            </div>

            <div class="ec-grid-2" style="gap:16px;align-items:start">
                <div>
                    <SgECharts @ref="_rtChartRef"
                               ChartType="SgEChartsType.Candlestick"
                               CandleData="@_rtCandleData"
                               Options="@_rtCandleOpts"
                               Height="300px" />
                </div>

                <div>                 
                    <SgECharts @ref="_rtSensorChartRef"
                               ChartType="SgEChartsType.Line"
                               Data="@_rtSensorData"
                               Options="@_rtSensorOpts"
                               Height="300px" />
                </div>
            </div>
        </SgCard>

        <SgCard Title="Вертикальный — продажи">
            <div class="ec-gen-bar">
                <button class="ec-btn" @onclick="RegenBar">↻ Обновить</button>
                <label class="ec-toggle"><input type="checkbox" @bind="_barStacked" @bind:after="RegenBar"/>Stacked</label>
            </div>
            <SgECharts ChartType="SgEChartsType.Bar"
                       Data="@_barData"
                       Options="@_barOpts"
                       Height="300px" />
        </SgCard>

        <SgCard Title="Горизонтальный — рейтинг">
            <div class="ec-gen-bar">
                <span class="ec-label">Топ:</span>
                @foreach (var n in new[]{ 5, 8, 12 })
                {
                    var nn = n;
                    <button class="ec-btn @(_hbarN == nn ? "active" : "")"
                            @onclick="@(() => { _hbarN = nn; RegenHBar(); })">@nn</button>
                }
            </div>
            <SgECharts ChartType="SgEChartsType.BarHorizontal"
                       Data="@_hbarData"
                       Options="@_hbarOpts"
                       Height="300px" />
        </SgCard>

        <SgCard Title="Heatmap — активность">
            <div class="ec-gen-bar">
                <button class="ec-btn" @onclick="RegenHeatmap">↻ Обновить</button>
            </div>
            <SgECharts ChartType="SgEChartsType.Heatmap"
                       Data="@_heatmapData"
                       Options="@_heatmapOpts"
                       Height="300px" />
        </SgCard>

        <SgCard Title="Candlestick — котировки">
            <div class="ec-gen-bar">
                <span class="ec-label">Дней:</span>
                @foreach (var n in new[]{ 30, 60, 90 })
                {
                    var nn = n;
                    <button class="ec-btn @(_candleDays == nn ? "active" : "")"
                            @onclick="@(() => { _candleDays = nn; RegenCandle(); })">@nn</button>
                }
            </div>
            <SgECharts ChartType="SgEChartsType.Candlestick"
                       CandleData="@_candleData"
                       Options="@_candleOpts"
                       Height="300px" />
        </SgCard>

    </div>
</SgTabPanel>

<!-- ══════════════════════════════════════════════════════════ Круговые -->
<SgTabPanel Title="🥧 Круговые / Спец">
    <div class="ec-grid-2">

        <SgCard Title="Pie — доли">
            <div class="ec-gen-bar">
                <span class="ec-label">Сегментов:</span>
                @foreach (var n in new[]{ 4, 6, 8 })
                {
                    var nn = n;
                    <button class="ec-btn @(_pieN == nn ? "active" : "")"
                            @onclick="@(() => { _pieN = nn; RegenPie(); })">@nn</button>
                }
            </div>
            <SgECharts ChartType="SgEChartsType.Pie"
                       Data="@_pieData"
                       Options="@_pieOpts"
                       Height="320px" />
        </SgCard>

        <SgCard Title="Donut — с суммой">
            <SgECharts ChartType="SgEChartsType.Donut"
                       Data="@_pieData"
                       Options="@_donutOpts"
                       Height="320px" />
        </SgCard>

        <SgCard Title="Gauge — метрика">
            <div class="ec-gen-bar">
                <button class="ec-btn" @onclick="RegenGauge">↻ Обновить</button>
            </div>
            <SgECharts ChartType="SgEChartsType.Gauge"
                       Data="@_gaugeData"
                       Options="@_gaugeOpts"
                       Height="320px" />
        </SgCard>

        <SgCard Title="Funnel — воронка">
            <div class="ec-gen-bar">
                <button class="ec-btn" @onclick="RegenFunnel">↻ Обновить</button>
            </div>
            <SgECharts ChartType="SgEChartsType.Funnel"
                       Data="@_funnelData"
                       Options="@_funnelOpts"
                       Height="320px" />
        </SgCard>

    </div>
</SgTabPanel>

<!-- ══════════════════════════════════════════════════════════ Иерархии -->
<SgTabPanel Title="🕸️ Иерархии">
    <div class="ec-grid-2">

        <SgCard Title="Sankey — потоки">
            <SgECharts ChartType="SgEChartsType.Sankey"
                       GraphData="@_sankeyData"
                       Options="@_sankeyOpts"
                       Height="380px" />
        </SgCard>

        <SgCard Title="Tree — иерархия">
            <SgECharts ChartType="SgEChartsType.Tree"
                       GraphData="@_treeData"
                       Options="@_treeOpts"
                       Height="380px" />
        </SgCard>

        <SgCard Title="Sunburst — вложенные доли">
            <SgECharts ChartType="SgEChartsType.Sunburst"
                       GraphData="@_sunburstData"
                       Options="@_sunburstOpts"
                       Height="380px" />
        </SgCard>

        <SgCard Title="Клик по элементу">
            <p style="font-size:13px;color:var(--sg-text-secondary);margin:0 0 10px">Кликните по любому элементу.</p>
            <SgECharts ChartType="SgEChartsType.Bar"
                       Data="@_barData"
                       Options="@_barOpts"
                       Height="280px"
                       OnDataPointClick="OnClick" />
            @if (_lastClick is not null)
            {
                <div class="ec-event-box">
                    <div class="ec-event-row"><span>Серия</span><code>@_lastClick.SeriesName</code></div>
                    <div class="ec-event-row"><span>Метка</span><code>@_lastClick.Name</code></div>
                    <div class="ec-event-row"><span>Значение</span><code>@_lastClick.Value</code></div>
                    <div class="ec-event-row"><span>Индекс</span><code>@_lastClick.DataIndex</code></div>
                </div>
            }
        </SgCard>

    </div>
</SgTabPanel>

</SgTabs>
</div>

@code {
    private static readonly Random _rnd = new(Environment.TickCount);

    // ── Real-time Candlestick (async) + Sensor stream ─────────────────────
    private bool _rtRunning;
    private int _rtDays = 60;

    // sensor window (points)
    private int _rtSensorPoints = 120;

    private CancellationTokenSource? _rtCts;
    private Task? _rtLoop;

    private SgECharts? _rtChartRef;
    private SgECharts? _rtSensorChartRef;

    private List<SgEChartsCandlePoint> _rtCandleData = new();
    private SgEChartsOptions _rtCandleOpts = new() { ShowLegend = false, EnableZoom = true };

    private List<SgEChartsDataPoint> _rtSensorData = new();
    private SgEChartsOptions _rtSensorOpts = new() { ShowLegend = false, Smooth = true, ValueDecimals = 2 };

    private async Task StartRealTime()
    {
        if (_rtRunning) return;
        _rtRunning = true;

        // Init / reset windows
        _rtCandleData = GenerateInitialCandleWindow(_rtDays);
        _rtSensorData = GenerateInitialSensorWindow(_rtSensorPoints);

        _rtCts?.Cancel();
        _rtCts?.Dispose();
        _rtCts = new CancellationTokenSource();

        var token = _rtCts.Token;

        // Small delay so UI has time to render
        await Task.Yield();
        try
        {
            if (_rtChartRef is not null)
                await _rtChartRef.RefreshAsync();
        }
        catch { }

        _rtLoop = Task.Run(async () =>
        {
            // "tick" simulation
            // Candle updates
            const int ticksPerCandle = 6;

            // Sensor updates
            double sensorT = 0;

            int tickInCandle = 0;
            double lastClose = _rtCandleData.Count > 0 ? _rtCandleData[^1].Close : 1000;

            while (!token.IsCancellationRequested)
            {
                tickInCandle++;

                // ── Candle ────────────────────────────────────────────────
                double delta = (_rnd.NextDouble() - 0.5) * 8;
                double nextClose = Math.Max(1, lastClose + delta);

                var last = _rtCandleData[^1];
                lastClose = nextClose;

                last.Close = Math.Round(nextClose, 1);
                last.High = Math.Round(Math.Max(last.High, last.Close), 1);
                last.Low  = Math.Round(Math.Min(last.Low,  last.Close), 1);

                _rtCandleData[^1] = last;

                if (tickInCandle >= ticksPerCandle)
                {
                    tickInCandle = 0;
                    var prevDate = _rtCandleData.Count > 0 ? _rtCandleData[^1].Date : DateTime.Today.ToString("dd.MM");
                    var nextDate = NextTradingDate(prevDate);

                    var open = lastClose;
                    var close = Math.Max(1, open + (_rnd.NextDouble() - 0.5) * 8);

                    double high = Math.Max(open, close) + _rnd.NextDouble() * 6;
                    double low  = Math.Min(open, close) - _rnd.NextDouble() * 6;

                    _rtCandleData.Add(new()
                    {
                        Date  = nextDate,
                        Open  = Math.Round(open, 1),
                        Close = Math.Round(close, 1),
                        High  = Math.Round(high, 1),
                        Low   = Math.Round(low,  1),
                    });

                    if (_rtCandleData.Count > _rtDays)
                        _rtCandleData = _rtCandleData.Skip(_rtCandleData.Count - _rtDays).ToList();
                }

                // ── Sensor ────────────────────────────────────────────────
                // sin wave + noise, with slow drift
                sensorT += 0.12;
                double amp = 1.2 + Math.Sin(sensorT / 5.5) * 0.35;
                double noise = (_rnd.NextDouble() - 0.5) * 0.25;
                double value = amp * Math.Sin(sensorT) + noise;

                var sensorNext = new SgEChartsDataPoint
                {
                    Label = (sensorT % (2 * Math.PI)) < 0 ? "t" : sensorT.ToString("0.00"),
                    Value = Math.Round(value, 2),
                    Group = "Sensor",
                };

                _rtSensorData.Add(sensorNext);
                if (_rtSensorData.Count > _rtSensorPoints)
                    _rtSensorData = _rtSensorData.Skip(_rtSensorData.Count - _rtSensorPoints).ToList();

                try
                {
                    await InvokeAsync(async () =>
                    {
                        if (_rtChartRef is not null)
                            await _rtChartRef.RefreshAsync();
                        if (_rtSensorChartRef is not null)
                            await _rtSensorChartRef.RefreshAsync();
                        StateHasChanged();
                    });
                }
                catch { }

                try
                {
                    await Task.Delay(200, token);
                }
                catch (TaskCanceledException) { }
            }
        }, token);
    }

    private void StopRealTime()
    {
        if (!_rtRunning) return;
        _rtRunning = false;

        try { _rtCts?.Cancel(); } catch { }
    }

    private List<SgEChartsDataPoint> GenerateInitialSensorWindow(int points)
    {
        var list = new List<SgEChartsDataPoint>(points);
        double t = 0;

        // Match the streaming look: sin wave + noise
        for (int i = 0; i < points; i++)
        {
            t += 0.12;
            double amp = 1.2 + Math.Sin(t / 5.5) * 0.35;
            double noise = (_rnd.NextDouble() - 0.5) * 0.25;
            double value = amp * Math.Sin(t) + noise;

            list.Add(new SgEChartsDataPoint
            {
                Label = t.ToString("0.00"),
                Value = Math.Round(value, 2),
                Group = "Sensor",
            });
        }

        return list;
    }

    private List<SgEChartsCandlePoint> GenerateInitialCandleWindow(int days)
    {
        var list = new List<SgEChartsCandlePoint>(days);
        double price = 1000 + _rnd.NextDouble() * 500;

        for (int i = 0; i < days; i++)
        {
            var date = DateTime.Today.AddDays(i - days + 1).ToString("dd.MM");

            var open = price;
            var close = price + (_rnd.NextDouble() - 0.48) * 40;
            var low = Math.Min(open, close) - _rnd.NextDouble() * 15;
            var high = Math.Max(open, close) + _rnd.NextDouble() * 15;

            list.Add(new()
            {
                Date = date,
                Open = Math.Round(open, 1),
                Close = Math.Round(close, 1),
                Low = Math.Round(low, 1),
                High = Math.Round(high, 1),
            });

            price = close;
        }

        return list;
    }

    private string NextTradingDate(string currentDdMm)
    {
        // Simple next date based on dd.MM; falls back to today if parse fails.
        if (DateTime.TryParseExact(currentDdMm, "dd.MM", null, System.Globalization.DateTimeStyles.None, out var d))
        {
            return d.AddDays(1).ToString("dd.MM");
        }
        return DateTime.Today.AddDays(1).ToString("dd.MM");
    }

    private SgEChartsClickEventArgs? _lastClick;
    private void OnClick(SgEChartsClickEventArgs e) { _lastClick = e; StateHasChanged(); }

    // ── Line ──────────────────────────────────────────────────────────────────
    private bool _lineSmooth, _lineZoom;
    private List<SgEChartsDataPoint> _lineData = new();
    private SgEChartsOptions _lineOpts = new() { ShowLegend = true, ValueSuffix = " тыс." };

    private void RegenLine()
    {
        _lineOpts = new() { ShowLegend = true, ValueSuffix = " тыс.", Smooth = _lineSmooth, EnableZoom = _lineZoom };
        var months = new[] { "Янв","Фев","Мар","Апр","Май","Июн","Июл","Авг" };
        var list = new List<SgEChartsDataPoint>();
        double v1 = 50, v2 = 40, v3 = 60;
        foreach (var m in months)
        {
            v1 += (_rnd.NextDouble() - 0.45) * 15;
            v2 += (_rnd.NextDouble() - 0.48) * 12;
            v3 += (_rnd.NextDouble() - 0.46) * 18;
            list.Add(new() { Label = m, Value = Math.Round(Math.Max(5, v1), 1), Group = "Продажи" });
            list.Add(new() { Label = m, Value = Math.Round(Math.Max(5, v2), 1), Group = "Расходы" });
            list.Add(new() { Label = m, Value = Math.Round(Math.Max(5, v3), 1), Group = "Прибыль" });
        }
        _lineData = list;
    }

    // ── Area ──────────────────────────────────────────────────────────────────
    private bool _areaStacked;
    private List<SgEChartsDataPoint> _areaData = new();
    private SgEChartsOptions _areaOpts = new() { ShowLegend = true, Smooth = true };

    private void RegenArea()
    {
        _areaOpts = new() { ShowLegend = true, Smooth = true, Stacked = _areaStacked, ValueSuffix = " тыс." };
        var hours = Enumerable.Range(0, 24).Select(h => $"{h:D2}:00").ToArray();
        var list  = new List<SgEChartsDataPoint>();
        double web = 10, api = 5, db = 3;
        foreach (var h in hours)
        {
            double peak = int.Parse(h.Split(':')[0]) is >= 9 and <= 18 ? 2.5 : 1.0;
            web = Math.Max(1, web + (_rnd.NextDouble() - 0.4) * 8 * peak);
            api = Math.Max(1, api + (_rnd.NextDouble() - 0.4) * 5 * peak);
            db  = Math.Max(1, db  + (_rnd.NextDouble() - 0.4) * 3 * peak);
            list.Add(new() { Label = h, Value = Math.Round(web, 1), Group = "Web" });
            list.Add(new() { Label = h, Value = Math.Round(api, 1), Group = "API" });
            list.Add(new() { Label = h, Value = Math.Round(db,  1), Group = "DB"  });
        }
        _areaData = list;
    }

    // ── Scatter ───────────────────────────────────────────────────────────────
    private int _scatterN = 150;
    private List<SgEChartsDataPoint> _scatterData = new();
    private readonly SgEChartsOptions _scatterOpts = new() { ShowLegend = true, ValueDecimals = 1 };

    private void RegenScatter()
    {
        var groups = new[] { "Группа A","Группа B","Группа C" };
        _scatterData = Enumerable.Range(0, _scatterN).Select(i =>
            new SgEChartsDataPoint { Label = $"P{i}", Value = Math.Round(10 + _rnd.NextDouble() * 90, 1), Group = groups[i % 3] }
        ).ToList();
    }

    // ── Radar ─────────────────────────────────────────────────────────────────
    private List<SgEChartsDataPoint> _radarData = new();
    private readonly SgEChartsOptions _radarOpts = new() { ShowLegend = true };

    private void RegenRadar()
    {
        var axes = new[] { "Скорость","Надёжность","Безопасность","Масштаб","Удобство","Цена" };
        var list = new List<SgEChartsDataPoint>();
        foreach (var prod in new[] { "Продукт A","Продукт B" })
            foreach (var ax in axes)
                list.Add(new() { Label = ax, Value = Math.Round(40 + _rnd.NextDouble() * 60), Group = prod });
        _radarData = list;
    }

    // ── Bar ───────────────────────────────────────────────────────────────────
    private bool _barStacked;
    private List<SgEChartsDataPoint> _barData = new();
    private SgEChartsOptions _barOpts = new() { ShowLegend = true };

    private void RegenBar()
    {
        _barOpts = new() { ShowLegend = true, Stacked = _barStacked, ValueSuffix = " шт." };
        var quarters = new[] { "Q1","Q2","Q3","Q4" };
        var list = new List<SgEChartsDataPoint>();
        foreach (var q in quarters)
            foreach (var ch in new[] { "Онлайн","Розница","Опт" })
                list.Add(new() { Label = q, Value = Math.Round(50 + _rnd.NextDouble() * 200), Group = ch });
        _barData = list;
    }

    // ── HBar ──────────────────────────────────────────────────────────────────
    private int _hbarN = 8;
    private List<SgEChartsDataPoint> _hbarData = new();
    private readonly SgEChartsOptions _hbarOpts = new() { ShowLegend = false, ValueSuffix = " шт." };

    private void RegenHBar()
    {
        var products = new[] { "Продукт A","Продукт B","Продукт C","Продукт D","Продукт E","Продукт F","Продукт G","Продукт H","Продукт I","Продукт J","Продукт K","Продукт L" };
        _hbarData = products.Take(_hbarN)
            .Select(p => new SgEChartsDataPoint { Label = p, Value = Math.Round(50 + _rnd.NextDouble() * 450) })
            .OrderByDescending(x => x.Value).ToList();
    }

    // ── Heatmap ───────────────────────────────────────────────────────────────
    private List<SgEChartsDataPoint> _heatmapData = new();
    private readonly SgEChartsOptions _heatmapOpts = new() { ShowLegend = false };

    private void RegenHeatmap()
    {
        var days  = new[] { "Пн","Вт","Ср","Чт","Пт","Сб","Вс" };
        var hours = Enumerable.Range(0, 24).Select(h => $"{h:D2}h").ToArray();
        _heatmapData = days.SelectMany(d => hours.Select(h =>
            new SgEChartsDataPoint { Label = h, Group = d, Value = Math.Round(_rnd.NextDouble() * 100) }
        )).ToList();
    }

    // ── Candlestick ───────────────────────────────────────────────────────────
    private int _candleDays = 60;
    private List<SgEChartsCandlePoint> _candleData = new();
    private readonly SgEChartsOptions _candleOpts = new() { ShowLegend = false, EnableZoom = true };

    private void RegenCandle()
    {
        var list = new List<SgEChartsCandlePoint>();
        double price = 1000 + _rnd.NextDouble() * 500;
        for (int i = 0; i < _candleDays; i++)
        {
            var date  = DateTime.Today.AddDays(i - _candleDays + 1).ToString("dd.MM");
            var open  = price;
            var close = price + (_rnd.NextDouble() - 0.48) * 40;
            var low   = Math.Min(open, close) - _rnd.NextDouble() * 15;
            var high  = Math.Max(open, close) + _rnd.NextDouble() * 15;
            list.Add(new() { Date = date, Open = Math.Round(open,1), Close = Math.Round(close,1), Low = Math.Round(low,1), High = Math.Round(high,1) });
            price = close;
        }
        _candleData = list;
    }

    // ── Pie / Donut ───────────────────────────────────────────────────────────
    private int _pieN = 6;
    private List<SgEChartsDataPoint> _pieData = new();
    private readonly SgEChartsOptions _pieOpts   = new() { ShowLegend = true };
    private readonly SgEChartsOptions _donutOpts = new() { ShowLegend = true, DonutInnerRadius = 0.55 };

    private void RegenPie()
    {
        var names = new[] { "Прямой","Органика","Соцсети","Email","Реклама","Реферал","Другое","Партнёры" };
        _pieData = names.Take(_pieN)
            .Select(n => new SgEChartsDataPoint { Label = n, Value = Math.Round(5 + _rnd.NextDouble() * 35, 1) })
            .ToList();
    }

