    // ── Funnel ────────────────────────────────────────────────────────────────
    private List<SgEChartsDataPoint> _funnelData = new();
    private readonly SgEChartsOptions _funnelOpts = new() { ShowLegend = false };

    private void RegenFunnel()
    {
        var stages = new[] { "Посетители","Лиды","Квалифицированные","Предложения","Сделки" };
        double v = 10000;
        _funnelData = stages.Select(s => {
            var item = new SgEChartsDataPoint { Label = s, Value = Math.Round(v) };
            v *= 0.35 + _rnd.NextDouble() * 0.3;
            return item;
        }).ToList();
    }

