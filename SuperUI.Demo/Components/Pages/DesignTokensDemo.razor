@page "/design-tokens-demo"
@using SuperUI.Components
@using SuperUI.Services
@using SuperUI.Themes
@using SuperUI.Enums
@using System.Globalization
@implements IDisposable
@inject SgThemeService ThemeService

<PageTitle>Design Tokens — SuperUI</PageTitle>
<SgSeoHead Description="SuperUI uses a three-tier token architecture for maximum flexibility, scalability, and easy theme support." />

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Sm" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Design Tokens System" Subtitle="SuperUI uses a three-tier token architecture for maximum flexibility, scalability, and easy theme support." />
    </HeaderContent>
    <ChildContent>
        <div class="demo-section">
            <div class="stats-strip">
                <div class="stat">
                    <span class="stat-num">@ThemeService.GetAvailableThemes().Count()</span>
                    <span class="stat-label">Themes</span>
                </div>
                <div class="stat-sep"></div>
                <div class="stat">
                    <span class="stat-num">3</span>
                    <span class="stat-label">Color Modes</span>
                </div>
                <div class="stat-sep"></div>
                <div class="stat">
                    <span class="stat-num">@(ThemeService.GetAvailableThemes().Count() * 3)</span>
                    <span class="stat-label">Combinations</span>
                </div>
                <div class="stat-sep"></div>
                <div class="stat-info">
                    <span class="stat-info-text">OKLCH palette · state · elevation · motion · density · measure · per-theme Google Fonts</span>
                </div>
            </div>

            <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm" Style="margin-bottom: 8px;">
                <SgStack Vertical Space="SgSize.Md">
                    <div class="toolbar-top">
                        <div class="toolbar-cluster">
                            <label class="toolbar-label">Active Theme</label>
                            <SgBadge Count="@ThemeService.GetAvailableThemes().Count()" ShowZero="false" BorderColor="primary" />
                        </div>
                        <div class="toolbar-cluster">
                            <label class="toolbar-label">Color Mode</label>
                            <SgSegmented TValue="string"
                                         Value="@ThemeService.CurrentMode"
                                         ValueChanged="@((string? v) => OnModeChanged(v))"
                                         Options="_modeOptions"
                                         Size="sm" />
                        </div>
                        <SgSpace Style="margin-left: auto;">
                            <SgTag Color="success">
                                <span class="pill-label">ID:</span>
                                <span class="pill-value">@ThemeService.CurrentTheme.Id</span>
                            </SgTag>
                            <SgTag Color="@(ThemeService.IsDark ? "processing" : "warning")">
                                <span class="pill-label">Mode:</span>
                                <span class="pill-value">@(ThemeService.IsDark ? "Dark" : "Light")</span>
                            </SgTag>
                        </SgSpace>
                    </div>
                    @{
                        var grouped = ThemeService.GetAvailableThemes()
                            .GroupBy(t => GetHueGroup(t))
                            .OrderBy(g => GroupOrder(g.Key))
                            .Select(g => new { Group = g.Key, Themes = g.OrderBy(t => t.Name) });
                    }
                    <SgAccordion Compact="true" Size="SgSize.Sm">
                        @foreach (var g in grouped)
                        {
                            <SgAccordionItem Title="@g.Group">
                                <div class="theme-chip-grid">
                                    @foreach (var theme in g.Themes)
                                    {
                                        <SgChip Value="@theme.Id"
                                                Text="@theme.Name"
                                                Clickable="true"
                                                Selected="@(ThemeService.CurrentTheme.Id == theme.Id)"
                                                OnClick="@(() => OnThemeChipClick(theme.Id))"
                                                Variant="@(ThemeService.CurrentTheme.Id == theme.Id ? SgChipVariant.Primary : SgChipVariant.Default)"
                                                Size="SgSize.Sm" />
                                    }
                                </div>
                            </SgAccordionItem>
                        }
                    </SgAccordion>
                </SgStack>
            </SgCard>
        </div>

        <div class="demo-section">
            <SgTabs>
                <SgTabPanel Title="Semantic (L1)" Icon="@SvgLayout">
                    <div class="tab-content">
                        <div class="demo-section-header">
                            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Semantic Tokens</SgTypography>
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                                Abstractions over primitives. They describe the <strong>role</strong> of a color in the interface, not its physical hue.
                            </SgTypography>
                        </div>

                        <div class="token-grid">
                            @TokenGroup("Backgrounds", "Page, container, and layer backgrounds.", @<text>
                                @TokenRow("--sg-bg", "Main page background")
                                @TokenRow("--sg-bg-subtle", "Secondary background (cards, sidebars)")
                                @TokenRow("--sg-bg-muted", "Muted background (inputs, tags)")
                                @TokenRow("--sg-bg-emphasized", "Emphasized background")
                            </text>)

                            @TokenGroup("Typography", "Text and icon colors.", @<text>
                                @TokenRow("--sg-fg", "Primary text")
                                @TokenRow("--sg-fg-subtle", "Secondary text")
                                @TokenRow("--sg-fg-muted", "Disabled or explanatory text")
                                @TokenRow("--sg-fg-link", "Links and interactive elements")
                            </text>)

                            @TokenGroup("Borders", "Dividers and element borders.", @<text>
                                @TokenRow("--sg-border", "Standard border")
                                @TokenRow("--sg-border-subtle", "Thin/light border")
                                @TokenRow("--sg-border-strong", "High-contrast border")
                                @TokenRow("--sg-border-focus", "Focus ring/border")
                            </text>)

                            @TokenGroup("Brand & Status", "Core brand colors and state indicators.", @<text>
                                @TokenRow("--sg-color-primary", "Brand primary")
                                @TokenRow("--sg-color-success", "Success / Positive result")
                                @TokenRow("--sg-color-danger", "Error / Dangerous action")
                                @TokenRow("--sg-color-warning", "Warning / Attention")
                            </text>)
                        </div>
                    </div>
                </SgTabPanel>

                <SgTabPanel Title="Primitives (L0)" Icon="@SvgPalette">
                    <div class="tab-content">
                        <div class="demo-section-header">
                            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Primitive Tokens</SgTypography>
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                                Basic building blocks (color scales, fonts, radii). Should not be used in components directly.
                            </SgTypography>
                        </div>

                        <SgStack Vertical Space="SgSize.Md">
                            <SgCard Title="Color Scales" Shadow="SgShadow.Sm">
                                <div class="palette-container">
                                    @PaletteRow("Neutral (Gray)", "--sg-p-neutral-", new[] { 0, 50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 1000 })
                                    @PaletteRow("Blue (Primary)", "--sg-p-blue-", new[] { 50, 100, 200, 300, 400, 500, 600, 700, 800, 900 })
                                    @PaletteRow("Emerald (Success)", "--sg-p-emerald-", new[] { 50, 100, 200, 300, 400, 500, 600, 700, 800, 900 })
                                    @PaletteRow("Rose (Danger)", "--sg-p-rose-", new[] { 50, 100, 200, 300, 400, 500, 600, 700, 800, 900 })
                                    @PaletteRow("Amber (Warning)", "--sg-p-amber-", new[] { 50, 100, 200, 300, 400, 500, 600, 700, 800, 900 })
                                </div>
                            </SgCard>

                            <SgCard Title="Border Radii" Shadow="SgShadow.Sm">
                                <SgChipGroup Space="SgSize.Lg" Wrap="true">
                                    @foreach (var r in new[] { "none", "xs", "sm", "md", "lg", "xl", "2xl", "full" })
                                    {
                                        var token = $"--sg-radius-{r}";
                                        <SgChip Variant="SgChipVariant.Default" Outlined="true">
                                            <div class="radius-item">
                                                <div class="radius-box" style="border-radius: var(@token);"></div>
                                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Medium">@r</SgTypography>
                                            </div>
                                        </SgChip>
                                    }
                                </SgChipGroup>
                            </SgCard>
                        </SgStack>
                    </div>
                </SgTabPanel>

                <SgTabPanel Title="Components (L2)" Icon="@SvgZap">
                    <div class="tab-content">
                        <div class="demo-section-header">
                            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Component Overrides</SgTypography>
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                                Component-specific tokens for granular UI tuning without changing the global theme.
                            </SgTypography>
                        </div>

                        <div class="demo-two-col">
                            <SgCard Title="Buttons & Inputs" Shadow="SgShadow.Sm">
                                <SgStack Vertical Space="SgSize.Lg">
                                    <div class="demo-box">
                                        <SgStack Vertical Space="SgSize.Md" Style="width: 100%;">
                                            <SgTextBox TValue="string" Label="Input Field" Placeholder="Placeholder..." />
                                            <SgButtonGroup>
                                                <SgButton Text="Primary" Variant="SgButtonVariant.Primary" />
                                                <SgButton Text="Default" Variant="SgButtonVariant.Default" />
                                                <SgButton Text="Ghost" Variant="SgButtonVariant.Ghost" />
                                            </SgButtonGroup>
                                        </SgStack>
                                    </div>
                                    <div class="token-list">
                                        @TokenRow("--sgc-btn-radius", "Button radius")
                                        @TokenRow("--sgc-input-radius", "Input radius")
                                    </div>
                                </SgStack>
                            </SgCard>

                            <SgCard Title="Cards & Containers" Shadow="SgShadow.Sm">
                                <SgStack Vertical Space="SgSize.Lg">
                                    <div class="demo-box">
                                        <SgCard Title="Sample Card" Subtitle="Testing tokens">
                                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-fg-subtle)">
                                                Card uses --sgc-card-radius and --sgc-card-padding.
                                            </SgTypography>
                                        </SgCard>
                                    </div>
                                    <div class="token-list">
                                        @TokenRow("--sgc-card-radius", "Card radius")
                                        @TokenRow("--sgc-card-padding", "Inner padding")
                                    </div>
                                </SgStack>
                            </SgCard>
                        </div>
                    </div>
                </SgTabPanel>

                <SgTabPanel Title="Typography" Icon="@SvgType">
                    <div class="tab-content">
                        <div class="demo-section-header">
                            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Typography Scale</SgTypography>
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                                Each theme loads its own font family. <code style="font-family: var(--sg-font-mono); font-size: 11px; color: var(--sg-color-primary);">@_fontNote</code>
                            </SgTypography>
                        </div>

                        <SgStack Vertical Space="SgSize.Md">
                            <SgCard Title="Heading Scale" Shadow="SgShadow.Sm">
                                <div class="heading-grid">
                                    <div class="typo-heading">
                                        <SgTag Color="primary"><span style="font-family:var(--sg-font-mono);font-size:10px;">h1</span></SgTag>
                                        <SgTypography Variant="SgTypographyVariant.Heading1">The quick brown fox</SgTypography>
                                    </div>
                                    <div class="typo-heading">
                                        <SgTag Color="primary"><span style="font-family:var(--sg-font-mono);font-size:10px;">h2</span></SgTag>
                                        <SgTypography Variant="SgTypographyVariant.Heading2">The quick brown fox</SgTypography>
                                    </div>
                                    <div class="typo-heading">
                                        <SgTag Color="primary"><span style="font-family:var(--sg-font-mono);font-size:10px;">h3</span></SgTag>
                                        <SgTypography Variant="SgTypographyVariant.Heading3">The quick brown fox jumps</SgTypography>
                                    </div>
                                    <div class="typo-heading">
                                        <SgTag Color="primary"><span style="font-family:var(--sg-font-mono);font-size:10px;">h4</span></SgTag>
                                        <SgTypography Variant="SgTypographyVariant.Heading4">The quick brown fox jumps over</SgTypography>
                                    </div>
                                    <div class="typo-heading">
                                        <SgTag Color="primary"><span style="font-family:var(--sg-font-mono);font-size:10px;">h5</span></SgTag>
                                        <SgTypography Variant="SgTypographyVariant.Heading5">The quick brown fox jumps over the lazy</SgTypography>
                                    </div>
                                    <div class="typo-heading">
                                        <SgTag Color="primary"><span style="font-family:var(--sg-font-mono);font-size:10px;">h6</span></SgTag>
                                        <SgTypography Variant="SgTypographyVariant.Heading6">The quick brown fox jumps over the lazy dog</SgTypography>
                                    </div>
                                </div>
                            </SgCard>

                            <div class="demo-two-col">
                                <SgCard Title="Body Text Scale" Shadow="SgShadow.Sm">
                                    <div class="token-list">
                                        @foreach (var s in _textSizes)
                                        {
                                            <div class="typo-compact-row">
                                                <SgTypography Size="s.Size" Clamp="1" Style="flex:1;min-width:0;">Aa Bb Cc 123</SgTypography>
                                                <div class="typo-compact-meta">
                                                    <SgTypography Variant="SgTypographyVariant.Code" Size="SgTypographySize.Xs">--sg-text-@s.Key</SgTypography>
                                                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-fg-muted)">@s.Label</SgTypography>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </SgCard>

                                <SgCard Title="Font Weights" Shadow="SgShadow.Sm">
                                    <div class="token-list">
                                        @foreach (var w in _fontWeights)
                                        {
                                            <div class="typo-compact-row">
                                                <SgTypography Weight="w.Weight" Style="flex:1;min-width:0;">The quick brown fox</SgTypography>
                                                <div class="typo-compact-meta">
                                                    <SgTypography Variant="SgTypographyVariant.Code" Size="SgTypographySize.Xs">--sg-font-weight-@w.Key</SgTypography>
                                                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-fg-muted)">@w.Label</SgTypography>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </SgCard>
                            </div>

                            <SgCard Title="Line Heights" Shadow="SgShadow.Sm">
                                <div class="line-height-grid">
                                    @foreach (var lh in _lineHeights)
                                    {
                                        <div class="lh-cell">
                                            <div class="lh-meta">
                                                <SgTag Color="primary"><span style="font-family:var(--sg-font-mono);font-size:10px;">--sg-line-height-@lh.Key</span></SgTag>
                                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-fg-muted)">@lh.Label</SgTypography>
                                            </div>
                                            <SgTypography Style="@($"line-height: var(--sg-line-height-{lh.Key}); background: var(--sg-bg-subtle); border: 1px solid var(--sg-border-subtle); border-radius: var(--sg-radius-sm); padding: 8px 12px; max-width: 100%;")">
                                                The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs.
                                            </SgTypography>
                                        </div>
                                    }
                                </div>
                            </SgCard>

                            <SgCard Title="Font Stacks" Shadow="SgShadow.Sm">
                                <div class="font-stack-list">
                                    <div class="font-stack-item">
                                        <div class="font-stack-name">
                                            <SgTag Color="primary"><span style="font-family:var(--sg-font-mono);font-size:10px;">--sg-font</span></SgTag>
                                            <SgTypography Size="SgTypographySize.Sm" Font="SgTypographyFont.Sans">Body text in current theme font</SgTypography>
                                        </div>
                                        <SgTypography Variant="SgTypographyVariant.Code" Size="SgTypographySize.Xs" Font="SgTypographyFont.Mono" Style="word-break:break-all;line-height:1.4;">@_bodyFont</SgTypography>
                                    </div>
                                    <div class="font-stack-item">
                                        <div class="font-stack-name">
                                            <SgTag Color="primary"><span style="font-family:var(--sg-font-mono);font-size:10px;">--sg-font-mono</span></SgTag>
                                            <SgTypography Size="SgTypographySize.Sm" Font="SgTypographyFont.Mono">Console.WriteLine("Hello");</SgTypography>
                                        </div>
                                        <SgTypography Variant="SgTypographyVariant.Code" Size="SgTypographySize.Xs" Font="SgTypographyFont.Mono" Style="word-break:break-all;line-height:1.4;">@_monoFont</SgTypography>
                                    </div>
                                    <div class="font-stack-item">
                                        <div class="font-stack-name">
                                            <SgTag Color="primary"><span style="font-family:var(--sg-font-mono);font-size:10px;">--sg-font-heading</span></SgTag>
                                            <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Bold">Display heading in theme font</SgTypography>
                                        </div>
                                        <SgTypography Variant="SgTypographyVariant.Code" Size="SgTypographySize.Xs" Font="SgTypographyFont.Mono" Style="word-break:break-all;line-height:1.4;">@_headingFont</SgTypography>
                                    </div>
                                    @if (!string.IsNullOrEmpty(_googleFontsUrl))
                                    {
                                        <div class="font-stack-item">
                                            <div class="font-stack-name">
                                                <SgTag Color="primary"><span style="font-family:var(--sg-font-mono);font-size:10px;">Google Fonts Import</span></SgTag>
                                            </div>
                                            <SgTypography Variant="SgTypographyVariant.Code" Size="SgTypographySize.Xs" Font="SgTypographyFont.Mono" Style="word-break:break-all;line-height:1.4;">@_googleFontsUrl</SgTypography>
                                        </div>
                                    }
                                </div>
                            </SgCard>
                        </SgStack>
                    </div>
                </SgTabPanel>
            </SgTabs>
        </div>
    </ChildContent>
</SgCard>

<style>
    .stats-strip {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 10px 16px;
        margin-bottom: 12px;
        background: linear-gradient(135deg,
            color-mix(in srgb, var(--sg-color-primary) 6%, var(--sg-bg)),
            color-mix(in srgb, var(--sg-color-primary) 2%, var(--sg-bg-subtle)));
        border: 1px solid color-mix(in srgb, var(--sg-color-primary) 18%, var(--sg-border));
        border-radius: var(--sg-radius-md);
    }

    .stat {
        display: flex;
        flex-direction: column;
        line-height: 1.1;
    }

    .stat-num {
        font-size: 22px;
        font-weight: 800;
        color: var(--sg-color-primary);
        letter-spacing: -0.02em;
        font-family: var(--sg-font);
    }

    .stat-label {
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
        color: var(--sg-fg-muted);
        letter-spacing: 0.06em;
        margin-top: 2px;
    }

    .stat-sep {
        width: 1px;
        height: 26px;
        background: var(--sg-border);
    }

    .stat-info {
        flex: 1;
        text-align: right;
    }

    .stat-info-text {
        font-size: 11px;
        color: var(--sg-fg-subtle);
        line-height: 1.4;
    }

    .demo-section {
        margin-bottom: 18px;
    }

    .demo-section:last-child {
        margin-bottom: 0;
    }

    .demo-section-header {
        margin-bottom: 10px;
    }

    .demo-two-col {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
        gap: 14px;
    }

    .toolbar-top {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .toolbar-cluster {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .toolbar-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--sg-fg-muted);
        letter-spacing: 0.05em;
    }

    .theme-chip-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 3px;
        padding: 6px 8px;
        background: var(--sg-bg-subtle);
        border: 1px solid var(--sg-border-subtle);
        border-radius: var(--sg-radius-md);
        align-content: flex-start;
    }

    .pill-label {
        color: var(--sg-fg-muted);
        font-weight: 600;
        margin-right: 4px;
    }

    .pill-value {
        color: inherit;
        font-weight: 700;
    }

    .tab-content {
        padding: 12px 0 0;
    }

    .token-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 12px;
    }

    .token-group {
        background: var(--sg-bg-subtle);
        border: 1px solid var(--sg-border);
        border-radius: var(--sg-radius-md);
        padding: 12px 14px;
    }

    .token-group-title {
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 2px;
        display: block;
    }

    .token-group-desc {
        font-size: 11px;
        color: var(--sg-fg-muted);
        margin-bottom: 8px;
        display: block;
    }

    .token-list {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .token-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 3px 0;
    }

    .token-preview {
        width: 36px;
        height: 20px;
        border-radius: 4px;
        border: 1px solid var(--sg-border-strong);
        flex-shrink: 0;
    }

    .token-info {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .token-name {
        font-family: var(--sg-font-mono);
        font-size: 11px;
        font-weight: 600;
        color: var(--sg-fg);
        line-height: 1.3;
    }

    .token-desc {
        font-size: 11px;
        color: var(--sg-fg-muted);
        line-height: 1.3;
    }

    .palette-container {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .palette-row {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .palette-title {
        font-size: 12px;
        font-weight: 600;
        color: var(--sg-fg-subtle);
    }

    .palette-colors {
        display: flex;
        flex-wrap: wrap;
        gap: 3px;
    }

    .color-swatch {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: 1px solid rgba(0,0,0,0.1);
        cursor: help;
        transition: transform 0.1s;
    }

    .color-swatch:hover {
        transform: scale(1.15);
        z-index: 1;
    }

    .radius-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        padding: 2px;
    }

    .radius-box {
        width: 36px;
        height: 36px;
        background: var(--sg-color-primary-subtle);
        border: 1px solid var(--sg-color-primary);
    }

    .demo-box {
        padding: 14px;
        background: var(--sg-bg);
        border: 1px solid var(--sg-border-subtle);
        border-radius: var(--sg-radius-md);
        display: flex;
        justify-content: center;
    }

    .heading-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 2px 16px;
    }

    .typo-heading {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 5px 0;
        border-bottom: 1px solid var(--sg-border-subtle);
        min-width: 0;
    }

    .heading-grid .typo-heading {
        overflow: hidden;
    }

    .heading-grid .typo-heading:last-child,
    .heading-grid .typo-heading:nth-last-child(2):nth-child(odd) {
        border-bottom: none;
    }

    .heading-grid .typo-heading > :last-child {
        flex: 1 1 auto;
