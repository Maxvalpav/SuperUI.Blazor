@page "/design-tokens-demo"
@using SuperUI.Components
@using SuperUI.Services
@using SuperUI.Themes
@using SuperUI.Enums
@implements IDisposable
@inject SgThemeService ThemeService

<PageTitle>Design Tokens — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                    Theme Configuration
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Switch between themes and color modes to see tokens in action. The system uses CSS variables (L0/L1/L2) for deep customization.
                </SgTypography>
            </div>

            <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Horizontal Space="SgSize.Xl" Align="SgAlignItems.Center" Wrap="true">
                    <div class="toolbar-section">
                        <label class="toolbar-label">Active Theme</label>
                        <SgStack Horizontal Space="SgSize.Sm">
                            @foreach (var theme in ThemeService.GetAvailableThemes())
                            {
                                <SgButton Text="@theme.Name"
                                          Variant="@(ThemeService.CurrentTheme.Id == theme.Id ? SgButtonVariant.Primary : SgButtonVariant.Ghost)"
                                          OnClick="() => ThemeService.SetThemeAsync(theme.Id)"
                                          Size="SgSize.Sm" />
                            }
                        </SgStack>
                    </div>

                    <SgDivider Vertical="true" Height="32px" />

                    <div class="toolbar-section">
                        <label class="toolbar-label">Color Mode</label>
                        <SgStack Horizontal Space="SgSize.Sm">
                            <SgButton Variant="@(ThemeService.CurrentMode == "light" ? SgButtonVariant.Primary : SgButtonVariant.Ghost)"
                                      OnClick='() => ThemeService.SetModeAsync("light")'
                                      Size="SgSize.Sm">
                                ☀️ Light
                            </SgButton>
                            <SgButton Variant="@(ThemeService.CurrentMode == "dark" ? SgButtonVariant.Primary : SgButtonVariant.Ghost)"
                                      OnClick='() => ThemeService.SetModeAsync("dark")'
                                      Size="SgSize.Sm">
                                🌙 Dark
                            </SgButton>
                            <SgButton Variant="@(ThemeService.CurrentMode == "auto" ? SgButtonVariant.Primary : SgButtonVariant.Ghost)"
                                      OnClick='() => ThemeService.SetModeAsync("auto")'
                                      Size="SgSize.Sm">
                                🌓 Auto
                            </SgButton>
                        </SgStack>
                    </div>

                    <SgSpace Style="margin-left: auto;">
                        <div class="status-pill">
                            <span class="pill-label">ID:</span>
                            <span class="pill-value">@ThemeService.CurrentTheme.Id</span>
                        </div>
                        <div class="status-pill">
                            <span class="pill-label">Mode:</span>
                            <span class="pill-value">@(ThemeService.IsDark ? "Dark" : "Light")</span>
                        </div>
                    </SgSpace>
                </SgStack>
            </SgCard>
        </div>

        <div class="demo-section">
            <SgTabs>
                <SgTabPanel Title="Semantic (L1)" Icon="@IconLayout">
                    <div class="tab-content">
                        <div class="demo-section-header">
                            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Semantic Tokens</SgTypography>
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                                Abstractions over primitives. They describe the <strong>role</strong> of a color in the interface, not its physical hue.
                            </SgTypography>
                        </div>

                        <div class="token-grid">
                            @TokenGroup("Backgrounds", "Page, container, and layer backgrounds.", @<text>
                                @TokenRow("--sg-bg", "Main page background")
                                @TokenRow("--sg-bg-subtle", "Secondary background (cards, sidebars)")
                                @TokenRow("--sg-bg-muted", "Muted background (inputs, tags)")
                                @TokenRow("--sg-bg-emphasized", "Emphasized background")
                            </text>)

                            @TokenGroup("Typography", "Text and icon colors.", @<text>
                                @TokenRow("--sg-fg", "Primary text")
                                @TokenRow("--sg-fg-subtle", "Secondary text")
                                @TokenRow("--sg-fg-muted", "Disabled or explanatory text")
                                @TokenRow("--sg-fg-link", "Links and interactive elements")
                            </text>)

                            @TokenGroup("Borders", "Dividers and element borders.", @<text>
                                @TokenRow("--sg-border", "Standard border")
                                @TokenRow("--sg-border-subtle", "Thin/light border")
                                @TokenRow("--sg-border-strong", "High-contrast border")
                                @TokenRow("--sg-border-focus", "Focus ring/border")
                            </text>)

                            @TokenGroup("Brand & Status", "Core brand colors and state indicators.", @<text>
                                @TokenRow("--sg-color-primary", "Brand primary")
                                @TokenRow("--sg-color-success", "Success / Positive result")
                                @TokenRow("--sg-color-danger", "Error / Dangerous action")
                                @TokenRow("--sg-color-warning", "Warning / Attention")
                            </text>)
                        </div>
                    </div>
                </SgTabPanel>

                <SgTabPanel Title="Primitives (L0)" Icon="@IconPalette">
                    <div class="tab-content">
                        <div class="demo-section-header">
                            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Primitive Tokens</SgTypography>
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                                Basic building blocks (color scales, fonts, radii). Should not be used in components directly.
                            </SgTypography>
                        </div>

                        <SgStack Vertical Space="SgSize.Xl">
                            <SgCard Title="Color Scales" Shadow="SgShadow.Sm">
                                <div class="palette-container">
                                    @PaletteRow("Neutral (Gray)", "--sg-p-neutral-", new[] { 0, 50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 1000 })
                                    @PaletteRow("Blue (Primary)", "--sg-p-blue-", new[] { 50, 100, 200, 300, 400, 500, 600, 700, 800, 900 })
                                    @PaletteRow("Emerald (Success)", "--sg-p-emerald-", new[] { 50, 100, 200, 300, 400, 500, 600, 700, 800, 900 })
                                    @PaletteRow("Rose (Danger)", "--sg-p-rose-", new[] { 50, 100, 200, 300, 400, 500, 600, 700, 800, 900 })
                                    @PaletteRow("Amber (Warning)", "--sg-p-amber-", new[] { 50, 100, 200, 300, 400, 500, 600, 700, 800, 900 })
                                </div>
                            </SgCard>

                            <SgCard Title="Border Radii" Shadow="SgShadow.Sm">
                                <div class="radius-list">
                                    @foreach (var r in new[] { "none", "xs", "sm", "md", "lg", "xl", "2xl", "full" })
                                    {
                                        var token = $"--sg-radius-{r}";
                                        <div class="radius-item">
                                            <div class="radius-box" style="border-radius: var(@token);"></div>
                                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Medium">@r</SgTypography>
                                        </div>
                                    }
                                </div>
                            </SgCard>
                        </SgStack>
                    </div>
                </SgTabPanel>

                <SgTabPanel Title="Components (L2)" Icon="@IconZap">
                    <div class="tab-content">
                        <div class="demo-section-header">
                            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Component Overrides</SgTypography>
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                                Component-specific tokens for granular UI tuning without changing the global theme.
                            </SgTypography>
                        </div>

                        <div class="demo-two-col">
                            <SgCard Title="Buttons & Inputs" Shadow="SgShadow.Sm">
                                <SgStack Vertical Space="SgSize.Lg">
                                    <div class="demo-box">
                                        <SgStack Vertical Space="SgSize.Md" Style="width: 100%;">
                                            <SgTextBox TValue="string" Label="Input Field" Placeholder="Placeholder..." />
                                            <SgStack Horizontal Space="SgSize.Sm">
                                                <SgButton Text="Primary" Variant="SgButtonVariant.Primary" />
                                                <SgButton Text="Default" Variant="SgButtonVariant.Default" />
                                                <SgButton Text="Ghost" Variant="SgButtonVariant.Ghost" />
                                            </SgStack>
                                        </SgStack>
                                    </div>
                                    <div class="token-list">
                                        @TokenRow("--sgc-btn-radius", "Button radius")
                                        @TokenRow("--sgc-input-radius", "Input radius")
                                    </div>
                                </SgStack>
                            </SgCard>

                            <SgCard Title="Cards & Containers" Shadow="SgShadow.Sm">
                                <SgStack Vertical Space="SgSize.Lg">
                                    <div class="demo-box">
                                        <SgCard Title="Sample Card" Subtitle="Testing tokens">
                                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-fg-subtle)">
                                                Card uses --sgc-card-radius and --sgc-card-padding.
                                            </SgTypography>
                                        </SgCard>
                                    </div>
                                    <div class="token-list">
                                        @TokenRow("--sgc-card-radius", "Card radius")
                                        @TokenRow("--sgc-card-padding", "Inner padding")
                                    </div>
                                </SgStack>
                            </SgCard>
                        </div>
                    </div>
                </SgTabPanel>

                <SgTabPanel Title="Typography" Icon="@IconType">
                    <div class="tab-content">
                        <div class="demo-section-header">
                            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Typography Scale</SgTypography>
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                                Each theme loads its own font family. <span style="font-family: var(--sg-font-mono); font-size: 11px; color: var(--sg-color-primary);">@_fontNote</span>
                            </SgTypography>
                        </div>

                        <SgStack Vertical Space="SgSize.Xl">
                            <SgCard Title="Heading Scale" Shadow="SgShadow.Sm">
                                <SgStack Vertical Space="SgSize.Md">
                                    <div class="typo-heading" style="--typo-level: h1;">
                                        <span class="typo-label">h1</span>
                                        <span class="typo-value" style="font-size: var(--sg-h1-font-size, 2rem); font-family: var(--sg-h1-font-family, var(--sg-font)); font-weight: var(--sg-h1-font-weight, 700); line-height: var(--sg-h1-line-height, 1.1); letter-spacing: var(--sg-h1-letter-spacing, -0.02em);">The quick brown fox</span>
                                    </div>
                                    <div class="typo-heading" style="--typo-level: h2;">
                                        <span class="typo-label">h2</span>
                                        <span class="typo-value" style="font-size: var(--sg-h2-font-size, 1.75rem); font-family: var(--sg-h2-font-family, var(--sg-font)); font-weight: var(--sg-h2-font-weight, 600); line-height: var(--sg-h2-line-height, 1.15); letter-spacing: var(--sg-h2-letter-spacing, -0.015em);">The quick brown fox</span>
                                    </div>
                                    <div class="typo-heading" style="--typo-level: h3;">
                                        <span class="typo-label">h3</span>
                                        <span class="typo-value" style="font-size: var(--sg-h3-font-size, 1.5rem); font-family: var(--sg-h3-font-family, var(--sg-font)); font-weight: var(--sg-h3-font-weight, 600); line-height: var(--sg-h3-line-height, 1.2); letter-spacing: var(--sg-h3-letter-spacing, -0.01em);">The quick brown fox jumps</span>
                                    </div>
                                    <div class="typo-heading" style="--typo-level: h4;">
                                        <span class="typo-label">h4</span>
                                        <span class="typo-value" style="font-size: var(--sg-h4-font-size, 1.25rem); font-family: var(--sg-h4-font-family, var(--sg-font)); font-weight: var(--sg-h4-font-weight, 600); line-height: var(--sg-h4-line-height, 1.25);">The quick brown fox jumps over</span>
                                    </div>
                                    <div class="typo-heading" style="--typo-level: h5;">
                                        <span class="typo-label">h5</span>
                                        <span class="typo-value" style="font-size: var(--sg-h5-font-size, 1rem); font-family: var(--sg-h5-font-family, var(--sg-font)); font-weight: var(--sg-h5-font-weight, 600); line-height: var(--sg-h5-line-height, 1.3);">The quick brown fox jumps over the lazy</span>
                                    </div>
                                    <div class="typo-heading" style="--typo-level: h6;">
                                        <span class="typo-label">h6</span>
                                        <span class="typo-value" style="font-size: var(--sg-h6-font-size, 0.875rem); font-family: var(--sg-h6-font-family, var(--sg-font)); font-weight: var(--sg-h6-font-weight, 500); line-height: var(--sg-h6-line-height, 1.35);">The quick brown fox jumps over the lazy dog</span>
                                    </div>
                                </SgStack>
                            </SgCard>

                            <SgCard Title="Body Text Scale" Shadow="SgShadow.Sm">
                                <div class="token-list">
                                    @foreach (var s in _textSizes)
                                    {
                                        var token = $"--sg-text-{s.Key}";
                                        <div class="token-row">
                                            <div class="typo-sample" style="font-size: var(@token); font-family: var(--sg-font);">
                                                The quick brown fox jumps over the lazy dog
                                            </div>
                                            <div class="token-info">
                                                <span class="token-name">@token</span>
                                                <span class="token-desc">@s.Label</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </SgCard>

                            <div class="demo-two-col">
                                <SgCard Title="Font Weights" Shadow="SgShadow.Sm">
                                    <div class="token-list">
                                        @foreach (var w in _fontWeights)
                                        {
                                            var token = $"--sg-font-weight-{w.Key}";
                                            <div class="token-row">
                                                <div class="token-info">
                                                    <span class="token-name">@token</span>
                                                    <span class="typo-sample" style="font-weight: var(@token); font-family: var(--sg-font);">
                                                        The quick brown fox
                                                    </span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </SgCard>

                                <SgCard Title="Line Heights" Shadow="SgShadow.Sm">
                                    <div class="token-list">
                                        @foreach (var lh in _lineHeights)
                                        {
                                            var token = $"--sg-line-height-{lh.Key}";
                                            <div class="token-row">
                                                <div class="token-info">
                                                    <span class="token-name">@token</span>
                                                    <div class="typo-sample" style="line-height: var(@token); font-family: var(--sg-font); background: var(--sg-bg-subtle); padding: 4px 8px; border-radius: 4px; max-width: 320px;">
                                                        The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs.
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </SgCard>
                            </div>

                            <SgCard Title="Font Stacks" Shadow="SgShadow.Sm">
                                <div class="token-list">
                                    <div class="token-row">
                                        <div class="token-info">
                                            <span class="token-name">--sg-font</span>
                                            <div class="typo-sample" style="font-family: var(--sg-font);">Body text in current theme font</div>
                                            <span class="token-desc" style="max-width: 400px; word-break: break-all;">@_bodyFont</span>
                                        </div>
                                    </div>
                                    <div class="token-row">
                                        <div class="token-info">
                                            <span class="token-name">--sg-font-mono</span>
                                            <div class="typo-sample" style="font-family: var(--sg-font-mono);">Console.WriteLine("Hello");</div>
                                            <span class="token-desc" style="max-width: 400px; word-break: break-all;">@_monoFont</span>
                                        </div>
                                    </div>
                                    <div class="token-row">
                                        <div class="token-info">
                                            <span class="token-name">--sg-font-heading</span>
                                            <div class="typo-sample" style="font-family: var(--sg-font-heading, var(--sg-font)); font-weight: 700;">The quick brown fox</div>
                                            <span class="token-desc" style="max-width: 400px; word-break: break-all;">@_headingFont</span>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(_googleFontsUrl))
                                    {
                                        <div class="token-row">
                                            <div class="token-info">
                                                <span class="token-name">Google Fonts @@import</span>
                                                <span class="token-desc" style="max-width: 600px; word-break: break-all; font-family: var(--sg-font-mono); font-size: 10px;">@_googleFontsUrl</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </SgCard>
                        </SgStack>
                    </div>
                </SgTabPanel>
            </SgTabs>
        </div>
    </ChildContent>
</SgCard>

<style>
    .demo-section {
        margin-bottom: 32px;
    }
    
    .demo-section:last-child {
        margin-bottom: 0;
    }

    .demo-section-header {
        margin-bottom: 16px;
    }

    .demo-two-col {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 20px;
    }

    .toolbar-section {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .toolbar-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--sg-fg-muted);
        letter-spacing: 0.05em;
    }

    .status-pill {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        background: var(--sg-bg-subtle);
        border: 1px solid var(--sg-border);
        border-radius: var(--sg-radius-full);
        font-size: 12px;
    }

    .pill-label {
        color: var(--sg-fg-muted);
        font-weight: 600;
    }

    .pill-value {
        color: var(--sg-color-primary);
        font-weight: 700;
    }

    .tab-content {
        padding: 24px 0;
    }

    .token-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 20px;
    }

    .token-group {
        background: var(--sg-bg-subtle);
        border: 1px solid var(--sg-border);
        border-radius: var(--sg-radius-md);
        padding: 20px;
    }

    .token-group-title {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 4px;
        display: block;
    }

    .token-group-desc {
        font-size: 12px;
        color: var(--sg-fg-muted);
        margin-bottom: 16px;
        display: block;
    }

    .token-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .token-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 6px 0;
    }

    .token-preview {
        width: 32px;
        height: 18px;
        border-radius: 4px;
        border: 1px solid var(--sg-border-strong);
        flex-shrink: 0;
    }

    .token-info {
        display: flex;
        flex-direction: column;
    }

    .token-name {
        font-family: var(--sg-font-mono);
        font-size: 11px;
        font-weight: 600;
    }

    .token-desc {
        font-size: 11px;
        color: var(--sg-fg-muted);
    }

    .palette-container {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .palette-row {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .palette-title {
        font-size: 12px;
        font-weight: 600;
        color: var(--sg-fg-subtle);
    }

    .palette-colors {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }

    .color-swatch {
        width: 32px;
        height: 32px;
        border-radius: 4px;
        border: 1px solid rgba(0,0,0,0.1);
        cursor: help;
    }

    .radius-list {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }

    .radius-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }

    .radius-box {
        width: 48px;
        height: 48px;
        background: var(--sg-color-primary-subtle);
        border: 1px solid var(--sg-color-primary);
    }

    .demo-box {
        padding: 24px;
        background: var(--sg-bg);
        border: 1px solid var(--sg-border-subtle);
        border-radius: var(--sg-radius-md);
        display: flex;
        justify-content: center;
    }

    .typo-heading {
        display: flex;
        align-items: baseline;
        gap: 16px;
        padding: 8px 0;
        border-bottom: 1px solid var(--sg-border-subtle);
    }
    .typo-heading:last-child {
        border-bottom: none;
    }
    .typo-label {
        font-family: var(--sg-font-mono);
        font-size: 11px;
        font-weight: 700;
        color: var(--sg-color-primary);
        min-width: 28px;
        text-transform: uppercase;
    }
    .typo-sample {
        display: block;
        margin-bottom: 4px;
    }
    .token-row .typo-sample {
        margin-bottom: 2px;
    }
</style>

@code {
    private string _googleFontsUrl = "";
    private string _bodyFont = "";
    private string _monoFont = "";
    private string _headingFont = "";
    private string _fontNote = "";

    private static readonly (string Key, string Label)[] _textSizes = [
        ("xs", "Extra small (11px)"),
        ("sm", "Small (12px)"),
        ("base", "Base (13px)"),
        ("lg", "Large (15px)"),
        ("xl", "Extra large (18px)"),
        ("2xl", "2x large (22px)"),
        ("3xl", "3x large (28px)"),
    ];

    private static readonly (string Key, string Label)[] _fontWeights = [
        ("normal", "Normal (400)"),
        ("medium", "Medium (500)"),
        ("semibold", "Semibold (600)"),
        ("bold", "Bold (700)"),
    ];

    private static readonly (string Key, string Label)[] _lineHeights = [
        ("tight", "Tight (1.25)"),
        ("normal", "Normal (1.5)"),
        ("relaxed", "Relaxed (1.75)"),
    ];

    protected override void OnInitialized()
    {
        ThemeService.ThemeChanged += HandleThemeChanged;
        RefreshFontInfo();
    }

    private void RefreshFontInfo()
    {
        var t = ThemeService.CurrentTheme;
        _bodyFont = t.Light.Font;
        _monoFont = t.Light.FontMono;
        _headingFont = t.Typography?.HeadingFont ?? "(same as body)";
        _googleFontsUrl = t.Typography?.GoogleFontsImportUrl ?? "";
        _fontNote = t.Typography != null
            ? $"Google Fonts @import — {t.Typography.HeadingFont ?? "all body"}"
            : "No custom typography — using system fonts";
    }

    private void HandleThemeChanged(IThemeDefinition theme, string mode)
    {
        InvokeAsync(() =>
        {
            RefreshFontInfo();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ThemeService.ThemeChanged -= HandleThemeChanged;
    }

    private RenderFragment _mainHeader => __builder =>
    {
        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">Design Tokens System</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    SuperUI uses a three-tier token architecture for maximum flexibility, scalability, and easy theme support.
                </SgTypography>
            </SgStack>
        </SgStack>
    };

    private RenderFragment TokenGroup(string title, string desc, RenderFragment content) => __builder =>
    {
        <div class="token-group">
            <span class="token-group-title">@title</span>
            <span class="token-group-desc">@desc</span>
            <div class="token-list">
                @content
            </div>
        </div>
    };

    private RenderFragment TokenRow(string name, string desc) => __builder =>
    {
        <div class="token-row">
            <div class="token-preview" style="background: var(@name);"></div>
            <div class="token-info">
                <span class="token-name">@name</span>
                <span class="token-desc">@desc</span>
            </div>
        </div>
    };

    private RenderFragment PaletteRow(string title, string prefix, int[] steps) => __builder =>
    {
        <div class="palette-row">
            <span class="palette-title">@title</span>
            <div class="palette-colors">
                @foreach (var step in steps)
                {
                    var token = $"{prefix}{step}";
                    <div class="color-swatch" style="background: var(@token);" title="@token"></div>
                }
            </div>
        </div>
    };

    private RenderFragment IconLayout = __builder =>
    {
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
    };

