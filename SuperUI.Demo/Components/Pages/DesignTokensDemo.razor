    protected override void OnInitialized()
    {
        ThemeService.ThemeChanged += HandleThemeChanged;
        RefreshFontInfo();
    }

    private void RefreshFontInfo()
    {
        var t = ThemeService.CurrentTheme;
        _bodyFont = t.Light.Font;
        _monoFont = t.Light.FontMono;
        _headingFont = t.Typography?.HeadingFont ?? "(same as body)";
        _googleFontsUrl = t.Typography?.GoogleFontsImportUrl ?? "";
        _fontNote = t.Typography != null
            ? $"Google Fonts @import — {t.Typography.HeadingFont ?? "all body"}"
            : "No custom typography — using system fonts";
    }

    private void HandleThemeChanged(IThemeDefinition theme, string mode)
    {
        InvokeAsync(() =>
        {
            RefreshFontInfo();
            StateHasChanged();
        });
    }

    static string GetHueGroup(IThemeDefinition theme)
    {
        var raw = theme.Primitives.Primary500;
        var parts = raw.Split(' ');
        var hueStr = parts.Length >= 3 ? parts[2].TrimEnd(')', '/') : "0";
        var hue = double.TryParse(hueStr, NumberStyles.Any, CultureInfo.InvariantCulture, out var h) ? h : 0;

        return hue switch
        {
            >= 340 or < 20  => "Rose / Red",
            >= 20  and < 40 => "Red / Orange",
            >= 40  and < 60 => "Orange / Gold",
            >= 60  and < 90 => "Yellow / Amber",
            >= 90  and < 150 => "Green",
            >= 150 and < 200 => "Teal / Cyan",
            >= 200 and < 280 => "Blue",
            >= 280 and < 340 => "Purple / Violet",
            _ => "Neutral"
        };
    }

    static int GroupOrder(string group) => group switch
    {
        "Blue"            => 0,
        "Green"           => 1,
        "Purple / Violet" => 2,
        "Teal / Cyan"     => 3,
        "Yellow / Amber"  => 4,
        "Orange / Gold"   => 5,
        "Red / Orange"    => 6,
        "Rose / Red"      => 7,
        "Neutral"         => 8,
        _ => 9
    };

    public void Dispose()
    {
        ThemeService.ThemeChanged -= HandleThemeChanged;
    }

    private async Task OnThemeChipClick(string id)
    {
        await ThemeService.SetThemeAsync(id);
    }

    private async Task OnModeChanged(string? mode)
    {
        if (!string.IsNullOrEmpty(mode))
            await ThemeService.SetModeAsync(mode);
    }

