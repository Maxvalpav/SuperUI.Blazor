@page "/splitter-demo"
@using SuperUI.Components

<PageTitle>Разделитель - SUI</PageTitle>

<SgCard Title="SgSplitter - Разделитель"
        Subtitle="Компонент для разделения контента на изменяемые по размеру области. Поддерживает горизонтальное и вертикальное разделение.">

    <div style="margin-top: 32px;">
        <h2>Горизонтальное разделение</h2>
        <p>Перетащите разделитель влево или вправо для изменения размера панелей.</p>

        <SgCard Title="Лево / Право" Style="margin-top: 16px;">
            <div style="height: 250px; border: 1px solid var(--sui-border); border-radius: 4px; overflow: hidden;">
                <SgSplitter Orientation="SgOrientation.Horizontal" Size="@_hSize" SizeChanged="v => _hSize = v" Min="100" Max="600">
                    <First>
                        <div style="padding: 16px; background: #fafafa; height: 100%; border-right: 1px solid var(--sui-border); overflow: auto;">
                            <div style="font-weight: 600; margin-bottom: 8px;">Левая панель</div>
                            <div style="font-size: 12px; color: var(--sui-text-muted);">Ширина: @_hSize.ToString("F0")px</div>
                            <div style="margin-top: 12px; font-size: 12px;">
                                Перетащите разделитель для изменения размера.
                            </div>
                        </div>
                    </First>
                    <Second>
                        <div style="padding: 16px; background: white; height: 100%; overflow: auto;">
                            <div style="font-weight: 600; margin-bottom: 8px;">Правая панель</div>
                            <div style="font-size: 12px; color: var(--sui-text-muted);">Основной контент</div>
                            <div style="margin-top: 12px; font-size: 12px;">
                                Здесь может быть любое содержимое — таблицы, формы, графики.
                            </div>
                        </div>
                    </Second>
                </SgSplitter>
            </div>
        </SgCard>
    </div>

    <div style="margin-top: 32px;">
        <h2>Вертикальное разделение</h2>
        <p>Перетащите разделитель вверх или вниз для изменения размера панелей.</p>

        <SgCard Title="Верх / Низ" Style="margin-top: 16px;">
            <div style="height: 300px; border: 1px solid var(--sui-border); border-radius: 4px; overflow: hidden;">
                <SgSplitter Orientation="SgOrientation.Vertical" Size="@_vSize" SizeChanged="v => _vSize = v" Min="60" Max="220">
                    <First>
                        <div style="padding: 16px; background: #fafafa; height: 100%; border-bottom: 1px solid var(--sui-border); overflow: auto;">
                            <div style="font-weight: 600; margin-bottom: 8px;">Верхняя панель</div>
                            <div style="font-size: 12px; color: var(--sui-text-muted);">Высота: @_vSize.ToString("F0")px</div>
                        </div>
                    </First>
                    <Second>
                        <div style="padding: 16px; background: white; height: 100%; overflow: auto;">
                            <div style="font-weight: 600; margin-bottom: 8px;">Нижняя панель</div>
                            <div style="font-size: 12px; color: var(--sui-text-muted);">Основной контент</div>
                        </div>
                    </Second>
                </SgSplitter>
            </div>
        </SgCard>
    </div>

    <div style="margin-top: 32px;">
        <h2>Трёхпанельный макет</h2>
        <p>Вложенные сплиттеры для создания сложных макетов.</p>

        <SgCard Title="Проводник файлов" Style="margin-top: 16px;">
            <div style="height: 350px; border: 1px solid var(--sui-border); border-radius: 4px; overflow: hidden;">
                <SgSplitter Orientation="SgOrientation.Horizontal" Size="200" Min="120" Max="350">
                    <First>
                        <div style="padding: 12px; background: #f5f5f5; height: 100%; border-right: 1px solid var(--sui-border); overflow: auto;">
                            <div style="font-weight: 600; font-size: 12px; text-transform: uppercase; color: var(--sui-text-muted); margin-bottom: 8px;">Дерево файлов</div>
                            <div style="font-size: 13px; display: flex; flex-direction: column; gap: 4px;">
                                <div style="cursor: pointer; padding: 4px 8px; border-radius: 4px; background: #e6f4ff;">📁 src</div>
                                <div style="cursor: pointer; padding: 4px 8px; border-radius: 4px; padding-left: 24px;">📁 Components</div>
                                <div style="cursor: pointer; padding: 4px 8px; border-radius: 4px; padding-left: 40px;">📄 SgButton.razor</div>
                                <div style="cursor: pointer; padding: 4px 8px; border-radius: 4px; padding-left: 40px;">📄 SgCard.razor</div>
                                <div style="cursor: pointer; padding: 4px 8px; border-radius: 4px; padding-left: 24px;">📁 Pages</div>
                                <div style="cursor: pointer; padding: 4px 8px; border-radius: 4px;">📄 README.md</div>
                            </div>
                        </div>
                    </First>
                    <Second>
                        <SgSplitter Orientation="SgOrientation.Vertical" Size="200" Min="80" Max="280">
                            <First>
                                <div style="padding: 12px; background: white; height: 100%; overflow: auto; border-bottom: 1px solid var(--sui-border);">
                                    <div style="font-weight: 600; font-size: 12px; text-transform: uppercase; color: var(--sui-text-muted); margin-bottom: 8px;">Редактор</div>
                                    <div style="font-family: monospace; font-size: 12px; color: #333;">
                                        <div><span style="color: #0000ff;">&#64;</span><span style="color: #800000;">namespace</span> SuperUI.Components</div>
                                        <div>&nbsp;</div>
                                        <div><span style="color: #0000ff;">&lt;</span><span style="color: #800000;">button</span> <span style="color: #ff0000;">class</span>=<span style="color: #008000;">"sgc-btn"</span><span style="color: #0000ff;">&gt;</span></div>
                                        <div>&nbsp;&nbsp;&#64;ChildContent&#64;Text</div>
                                        <div><span style="color: #0000ff;">&lt;/</span><span style="color: #800000;">button</span><span style="color: #0000ff;">&gt;</span></div>
                                    </div>
                                </div>
                            </First>
                            <Second>
                                <div style="padding: 12px; background: #1e1e1e; height: 100%; overflow: auto;">
                                    <div style="font-weight: 600; font-size: 12px; text-transform: uppercase; color: #888; margin-bottom: 8px;">Консоль</div>
                                    <div style="font-family: monospace; font-size: 12px; color: #4ec9b0;">
                                        <div>✓ Build succeeded</div>
                                        <div style="color: #888;">0 errors, 0 warnings</div>
                                    </div>
                                </div>
                            </Second>
                        </SgSplitter>
                    </Second>
                </SgSplitter>
            </div>
        </SgCard>
    </div>

    <div style="margin-top: 32px;">
        <h2>Свойства компонента</h2>

        <SgCard Title="SgSplitter" Style="margin-top: 16px;">
            <PropertyTable Items="_splitterProperties" />
        </SgCard>
    </div>

    <!-- Enum + code -->
    <div style="margin-top: 32px;">
        <h2>Перечисление SgOrientation и примеры кода</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="SgOrientation">
                <PropertyTable Items="_orientationEnum" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private double _hSize = 250;
    private double _vSize = 120;

    private List<PropertyPanelItem> _splitterProperties = new()
    {
        new() { Label = "First",        Value = "RenderFragment",          BadgeText = "Первая панель",         BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Second",       Value = "RenderFragment",          BadgeText = "Вторая панель",         BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Orientation",  Value = "horizontal|vertical",     BadgeText = "Ориентация (SgOrientation)", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Size",         Value = "double",                  BadgeText = "Начальный размер (px)", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Min",          Value = "double",                  BadgeText = "Минимальный размер",    BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Max",          Value = "double",                  BadgeText = "Максимальный размер",   BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SizeChanged",  Value = "EventCallback<double>",   BadgeText = "Событие изменения",    BadgeVariant = SgBadgeVariant.Success }
    };

    // ── Enum tables ──────────────────────────────────────────────────────────
    private List<PropertyPanelItem> _orientationEnum = new()
    {
        new() { Label = "SgOrientation.Horizontal", Value = "\"horizontal\"", BadgeText = "Лево / Право (по умолч.)", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "SgOrientation.Vertical",   Value = "\"vertical\"",   BadgeText = "Верх / Низ",               BadgeVariant = SgBadgeVariant.Info },
    };
}
