@page "/splitter-demo"
@using SuperUI.Components
@using SuperUI.Enums

<SgCard>
    <HeaderContent>
        <div style="display:flex;align-items:center;gap:12px;">
            <div style="padding:8px;border-radius:8px;background:var(--sg-color-primary-subtle);display:flex;">
                <SgIcon Icon="@SgIcons.Layout" Size="20px" style="color:var(--sg-color-primary);" />
            </div>
            <div>
                <SgTypography As="SgTypographyElement.H2" Weight="SgTypographyWeight.Bold" Size="SgTypographySize.Xxl" Tracking="SgTypographyTracking.Tight">
                    Splitter
                </SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Resizable panel layouts for Blazor
                </SgTypography>
            </div>
        </div>
    </HeaderContent>

    <ChildContent>
    <div style="margin-bottom:16px;">
        <SgTypography Color="var(--sg-text-muted)" Leading="SgTypographyLeading.Relaxed">
            Drag splitter bars to resize panels. Supports any number of panes, keyboard navigation, collapse, snap-to-grid, and in-memory session persistence.
        </SgTypography>
    </div>

    @* ── Section 1: Simple 2-pane modes ── *@
    <div class="sgc-demo-section">
        <SgTypography As="SgTypographyElement.H3" Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Xl" Tracking="SgTypographyTracking.Tight">
            Two-pane mode
        </SgTypography>
        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" Leading="SgTypographyLeading.Relaxed">
            Horizontal and vertical layouts. Drag the bar, use collapse buttons, or double-click to reset. Keyboard: <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Xs">Arrow keys</SgTypography> when focused on the bar.
        </SgTypography>

        <SgRow Space="SgSize.Lg" Style="margin-top:12px;">
            <SgCol Xs="24" Lg="12">
                <SgCard NoPadding="true" Shadow="SgShadow.Sm">
                    <div style="display:flex;flex-direction:column;height:380px;border-radius:inherit;overflow:hidden;">
                        <div style="flex:1;overflow:hidden;">
                            <SgSplitter Orientation="SgOrientation.Vertical" Size="@_vSize" Collapsible="@_vCollapsible" ShowHandle="@_vHandle"
                                        Min="60" Max="500" PersistKey="demo-vertical" OnResizeEnd="@(v => { if(v.Length>0) _vSize=v[0]; })">
                                <First>
                                    <div class="pane-content pane-content--toolbar">
                                        <div class="pane-label">
                                            <SgIcon Icon="@SgIcons.Layers" Size="14px" />
                                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Toolbar</SgTypography>
                                        </div>
                                        <SgStack Horizontal Space="SgSize.Sm" Wrap="true">
                                            <div class="nav-chip active">
                                                <SgIcon Icon="@SgIcons.LayoutDashboard" Size="14px" />
                                                <span>Dashboard</span>
                                            </div>
                                            <div class="nav-chip">
                                                <SgIcon Icon="@SgIcons.Settings" Size="14px" />
                                                <span>Settings</span>
                                            </div>
                                            <div class="nav-chip">
                                                <SgIcon Icon="@SgIcons.Users" Size="14px" />
                                                <span>Users</span>
                                            </div>
                                            <div class="nav-chip">
                                                <SgIcon Icon="@SgIcons.FileText" Size="14px" />
                                                <span>Reports</span>
                                            </div>
                                        </SgStack>
                                    </div>
                                </First>
                                <Second>
                                    <div class="pane-content pane-content--main">
                                        <div class="pane-label">
                                            <SgIcon Icon="@SgIcons.Terminal" Size="14px" />
                                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Content Area</SgTypography>
                                        </div>
                                        <div class="status-card">
                                            <div class="status-card-header">
                                                <SgIcon Icon="@SgIcons.Cpu" Size="16px" />
                                                <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm">System Status</SgTypography>
                                            </div>
                                            <SgStack Vertical Space="SgSize.Sm">
                                                <div>
                                                    <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px;">
                                                        <span style="color:var(--sg-text-muted);">CPU Load</span>
                                                        <span style="font-weight:600;">65%</span>
                                                    </div>
                                                    <SgProgress Value="65" Size="SgSize.Sm" />
                                                </div>
                                                <div>
                                                    <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px;">
                                                        <span style="color:var(--sg-text-muted);">Memory</span>
                                                        <span style="font-weight:600;">42%</span>
                                                    </div>
                                                    <SgProgress Value="42" Size="SgSize.Sm" Color="--sg-color-success" />
                                                </div>
                                                <div>
                                                    <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px;">
                                                        <span style="color:var(--sg-text-muted);">Disk I/O</span>
                                                        <span style="font-weight:600;">88%</span>
                                                    </div>
                                                    <SgProgress Value="88" Size="SgSize.Sm" Color="--sg-color-warning" />
                                                </div>
                                            </SgStack>
                                        </div>
                                    </div>
                                </Second>
                            </SgSplitter>
                        </div>
                        <div class="demo-controls">
                            <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                                <SgSwitch @bind-Value="_vCollapsible" Label="Collapsible" Size="SgSize.Sm" />
                                <SgSwitch @bind-Value="_vHandle" Label="Handle" Size="SgSize.Sm" />
                                <div style="display:flex;align-items:center;gap:8px;flex:1;max-width:180px;">
                                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Weight="SgTypographyWeight.Medium">Size</SgTypography>
                                    <SgSlider @bind-Value="_vSize" Min="60" Max="500" Step="10" Suffix="px" ShowValue="true" />
                                </div>
                            </SgStack>
                        </div>
                    </div>
                </SgCard>
            </SgCol>
            <SgCol Xs="24" Lg="12">
                <SgCard NoPadding="true" Shadow="SgShadow.Sm">
                    <div style="display:flex;flex-direction:column;height:380px;border-radius:inherit;overflow:hidden;">
                        <div style="flex:1;overflow:hidden;">
                            <SgSplitter Orientation="SgOrientation.Horizontal" Size="@_hSize" Collapsible="@_hCollapsible" ShowHandle="@_hHandle"
                                        Min="120" Max="700" KeyboardResize="true" Step="20" PersistKey="demo-horizontal">
                                <First>
                                    <div class="pane-content pane-content--sidebar">
                                        <div class="pane-label">
                                            <SgIcon Icon="@SgIcons.Box" Size="14px" />
                                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Sidebar</SgTypography>
                                        </div>
                                        <div class="sidebar-icons">
                                            <SgIcon Icon="@SgIcons.LayoutDashboard" Size="22px" />
                                            <SgIcon Icon="@SgIcons.Users" Size="22px" />
                                            <SgIcon Icon="@SgIcons.Settings" Size="22px" />
                                            <SgIcon Icon="@SgIcons.FileText" Size="22px" />
                                            <SgIcon Icon="@SgIcons.BarChart" Size="22px" />
                                            <SgIcon Icon="@SgIcons.Bell" Size="22px" />
                                        </div>
                                    </div>
                                </First>
                                <Second>
                                    <div class="pane-content pane-content--main">
                                        <div class="pane-label">
                                            <SgIcon Icon="@SgIcons.Code" Size="14px" />
                                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Editor</SgTypography>
                                        </div>
                                        <div class="code-editor-sim">
                                            <span style="color:#569cd6;">public class</span> <span style="color:#4ec9b0;">SuperComponent</span>
                                            <span style="color:#dcdcaa;">&lt;T&gt;</span>
                                            <br/>
                                            <span style="color:#c586c0;">where</span> T : <span style="color:#4ec9b0;">class</span>
                                            <br/>
                                            <span style="color:#d4d4d4;">{</span>
                                            <br/>
                                            <span style="padding-left:20px;color:#569cd6;">private</span> <span style="color:#4ec9b0;">T</span> <span style="color:#dcdcaa;">_value</span> <span style="color:#d4d4d4;">=</span> <span style="color:#569cd6;">default</span><span style="color:#d4d4d4;">!</span><span style="color:#d4d4d4;">;</span>
                                            <br/>
                                            <br/>
                                            <span style="padding-left:20px;color:#569cd6;">public</span> <span style="color:#4ec9b0;">T</span> <span style="color:#dcdcaa;">Value</span>
                                            <br/>
                                            <span style="padding-left:20px;">{</span>
                                            <br/>
                                            <span style="padding-left:40px;color:#569cd6;">get</span> <span style="color:#d4d4d4;">=></span> <span style="color:#dcdcaa;">_value</span><span style="color:#d4d4d4;">;</span>
                                            <br/>
                                            <span style="padding-left:40px;color:#569cd6;">set</span> <span style="color:#d4d4d4;">=></span> <span style="color:#dcdcaa;">_value</span> <span style="color:#d4d4d4;">=</span> <span style="color:#dcdcaa;">value</span><span style="color:#d4d4d4;">;</span>
                                            <br/>
                                            <span style="padding-left:20px;">}</span>
                                            <br/>
                                            <span style="color:#d4d4d4;">}</span>
                                        </div>
                                    </div>
                                </Second>
                            </SgSplitter>
                        </div>
                        <div class="demo-controls">
                            <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                                <SgSwitch @bind-Value="_hCollapsible" Label="Collapsible" Size="SgSize.Sm" />
                                <SgSwitch @bind-Value="_hHandle" Label="Handle" Size="SgSize.Sm" />
                                <div style="display:flex;align-items:center;gap:8px;flex:1;max-width:180px;">
                                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Weight="SgTypographyWeight.Medium">Size</SgTypography>
                                    <SgSlider @bind-Value="_hSize" Min="120" Max="700" Step="10" Suffix="px" ShowValue="true" />
                                </div>
                            </SgStack>
                        </div>
                    </div>
                </SgCard>
            </SgCol>
        </SgRow>

        <div class="demo-code-block">
            <SgStack Horizontal Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center">
                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                    <SgIcon Icon="@SgIcons.Code" Size="14px" /> Example
                </SgTypography>
                <button type="button" class="demo-copy-btn" @onclick="() => CopyCode(_simpleCode)">
                    <SgIcon Icon="@SgIcons.Copy" Size="14px" /> Copy
                </button>
            </SgStack>
            <pre class="code-block">@_simpleCode</pre>
        </div>
    </div>

    @* ── Section 2: Multi-pane with SgSplitterPane ── *@
    <div class="sgc-demo-section">
        <SgTypography As="SgTypographyElement.H3" Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Xl" Tracking="SgTypographyTracking.Tight">
            Multi-pane mode
        </SgTypography>
        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" Leading="SgTypographyLeading.Relaxed">
            Create layouts with 3+ panes using <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Xs">SgSplitterPane</SgTypography> children. Each pane gets its own <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Xs">Size</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Xs">Min</SgTypography>, and <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Xs">Max</SgTypography>. The last pane always fills remaining space.
        </SgTypography>

        <SgCard NoPadding="true" Shadow="SgShadow.Sm" Style="margin-top:12px;">
            <div style="height:400px;border-radius:inherit;overflow:hidden;">
                <SgSplitter Orientation="SgOrientation.Horizontal" Collapsible="true" ShowHandle="true" PersistKey="demo-multipane">
                    <SgSplitterPane Size="200" Min="120" Max="400">
                        <div class="pane-content pane-content--sidebar">
                            <div class="pane-label">
                                <SgIcon Icon="@SgIcons.Menu" Size="14px" />
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Navigation</SgTypography>
                            </div>
                            <SgStack Vertical Space="SgSize.Sm">
                                <div class="nav-chip active" @onclick="() => _selectedNav = _navItems[0]">
                                    <SgIcon Icon="@SgIcons.LayoutDashboard" Size="14px" />
                                    <span>@_navItems[0]</span>
                                </div>
                                <div class="nav-chip" @onclick="() => _selectedNav = _navItems[1]">
                                    <SgIcon Icon="@SgIcons.TrendingUp" Size="14px" />
                                    <span>@_navItems[1]</span>
                                </div>
                                <div class="nav-chip" @onclick="() => _selectedNav = _navItems[2]">
                                    <SgIcon Icon="@SgIcons.Settings" Size="14px" />
                                    <span>@_navItems[2]</span>
                                </div>
                                <div class="nav-chip" @onclick="() => _selectedNav = _navItems[3]">
                                    <SgIcon Icon="@SgIcons.Users" Size="14px" />
                                    <span>@_navItems[3]</span>
                                </div>
                                <div class="nav-chip" @onclick="() => _selectedNav = _navItems[4]">
                                    <SgIcon Icon="@SgIcons.FileText" Size="14px" />
                                    <span>@_navItems[4]</span>
                                </div>
                            </SgStack>
                        </div>
                    </SgSplitterPane>
                    <SgSplitterPane Size="400" Min="200" Max="800">
                        <div class="pane-content pane-content--main">
                            <div class="pane-label">
                                <SgIcon Icon="@SgIcons.Monitor" Size="14px" />
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Main Content: @_selectedNav</SgTypography>
                            </div>
                            <div class="content-grid">
                                <div class="content-card" style="grid-column:1/-1;">
                                    <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Base">Welcome to @_selectedNav</SgTypography>
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">This panel demonstrates multi-pane splitter with three independent sections. Resize any bar to see the layout adapt.</SgTypography>
                                </div>
                                <div class="content-card">
                                    <SgTypography Weight="SgTypographyWeight.Medium" Size="SgTypographySize.Sm">Active Users</SgTypography>
                                    <SgTypography As="SgTypographyElement.H2" Weight="SgTypographyWeight.Bold" Color="var(--sg-color-success)" Size="SgTypographySize.Xxxl" Style="margin-top:4px;">1,284</SgTypography>
                                </div>
                                <div class="content-card">
                                    <SgTypography Weight="SgTypographyWeight.Medium" Size="SgTypographySize.Sm">Revenue</SgTypography>
                                    <SgTypography As="SgTypographyElement.H2" Weight="SgTypographyWeight.Bold" Color="var(--sg-color-primary)" Size="SgTypographySize.Xxxl" Style="margin-top:4px;">$48.2K</SgTypography>
                                </div>
                                <div class="content-card">
                                    <SgTypography Weight="SgTypographyWeight.Medium" Size="SgTypographySize.Sm">Tasks</SgTypography>
                                    <SgTypography As="SgTypographyElement.H2" Weight="SgTypographyWeight.Bold" Color="var(--sg-color-warning)" Size="SgTypographySize.Xxxl" Style="margin-top:4px;">87%</SgTypography>
                                </div>
                            </div>
                        </div>
                    </SgSplitterPane>
                    <SgSplitterPane Size="200" Min="100" Max="400">
                        <div class="pane-content pane-content--alt">
                            <div class="pane-label">
                                <SgIcon Icon="@SgIcons.MessageSquare" Size="14px" />
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Activity</SgTypography>
                            </div>
                            <SgStack Vertical Space="SgSize.Sm">
                                @foreach (var activity in _activities)
                                {
                                    <div class="activity-item">
                                        <div class="activity-dot"></div>
                                        <div>
                                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Medium">@activity.Text</SgTypography>
                                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">@activity.Time</SgTypography>
                                        </div>
                                    </div>
                                }
                            </SgStack>
                        </div>
                    </SgSplitterPane>
                </SgSplitter>
            </div>
        </SgCard>

        <div class="demo-code-block">
            <SgStack Horizontal Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center">
                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                    <SgIcon Icon="@SgIcons.Code" Size="14px" /> Example
                </SgTypography>
                <button type="button" class="demo-copy-btn" @onclick="() => CopyCode(_multiCode)">
                    <SgIcon Icon="@SgIcons.Copy" Size="14px" /> Copy
                </button>
            </SgStack>
            <pre class="code-block">@_multiCode</pre>
        </div>
    </div>

    @* ── Section 3: Nested / IDE layout ── *@
    <div class="sgc-demo-section">
        <SgTypography As="SgTypographyElement.H3" Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Xl" Tracking="SgTypographyTracking.Tight">
            Nested layout
        </SgTypography>
        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" Leading="SgTypographyLeading.Relaxed">
            Combine horizontal and vertical splitters for IDE-like workspaces. Each splitter manages its own state independently.
        </SgTypography>

        <SgCard NoPadding="true" Shadow="SgShadow.Md" Radius="SgSize.Lg" Style="margin-top:12px;">
            <div style="height:550px;overflow:hidden;border-radius:inherit;">
                <SgSplitter Orientation="SgOrientation.Vertical" Size="48" Min="36" Max="120" Collapsible="true" ShowHandle="true">
                    <First>
                        <div class="pane-content pane-content--toolbar" style="padding:6px 16px;display:flex;align-items:center;">
                            <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center" FullWidth="true" Justify="SgJustifyContent.SpaceBetween">
                                <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                                    <SgIcon Icon="@SgIcons.Sparkles" Size="18px" style="color:var(--sg-color-primary);" />
                                    <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm">SuperStudio</SgTypography>
                                    <SgStack Horizontal Space="SgSize.Sm">
                                        <div class="nav-chip active">File</div>
                                        <div class="nav-chip">Edit</div>
                                        <div class="nav-chip">View</div>
                                        <div class="nav-chip">Help</div>
                                    </SgStack>
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm">
                                    <SgIcon Icon="@SgIcons.Search" Size="16px" style="opacity:0.4;" />
                                    <SgIcon Icon="@SgIcons.Bell" Size="16px" style="opacity:0.4;" />
                                    <SgIcon Icon="@SgIcons.Settings" Size="16px" style="opacity:0.4;" />
                                </SgStack>
                            </SgStack>
                        </div>
                    </First>
                    <Second>
                        <SgSplitter Orientation="SgOrientation.Horizontal" Size="240" Min="160" Max="400" PersistKey="demo-nested-h">
                            <First>
                                <SgSplitter Orientation="SgOrientation.Vertical" Size="200" Min="100" Max="500" Collapsible="true" PersistKey="demo-nested-v1">
                                    <First>
                                        <div class="pane-content pane-content--sidebar">
                                            <div class="pane-label">
                                                <SgIcon Icon="@SgIcons.FileText" Size="13px" />
                                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Explorer</SgTypography>
                                            </div>
                                            <div class="file-tree">
                                                <div class="tree-item depth-0 active">
                                                    <SgIcon Icon="@SgIcons.ChevronDown" Size="12px" /> src/
                                                </div>
                                                <div class="tree-item depth-1">
                                                    <SgIcon Icon="@SgIcons.FileText" Size="12px" /> Program.cs
                                                </div>
                                                <div class="tree-item depth-1">
                                                    <SgIcon Icon="@SgIcons.FileText" Size="12px" /> Startup.cs
                                                </div>
                                                <div class="tree-item depth-0">
                                                    <SgIcon Icon="@SgIcons.ChevronRight" Size="12px" /> Components/
                                                </div>
                                                <div class="tree-item depth-0">
                                                    <SgIcon Icon="@SgIcons.ChevronRight" Size="12px" /> Pages/
                                                </div>
                                            </div>
                                        </div>
                                    </First>
                                    <Second>
                                        <div class="pane-content pane-content--alt">
                                            <div class="pane-label">
                                                <SgIcon Icon="@SgIcons.Code" Size="13px" />
                                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Git</SgTypography>
                                            </div>
                                            <SgStack Vertical Space="SgSize.Sm">
                                                <div class="git-item" style="color:var(--sg-color-success);">+ 3 files changed</div>
                                                <div class="git-item">M src/Program.cs</div>
                                                <div class="git-item">M src/Startup.cs</div>
                                                <div class="git-item" style="color:var(--sg-color-warning);">?? new-file.cs</div>
                                            </SgStack>
                                        </div>
                                    </Second>
                                </SgSplitter>
                            </First>
                            <Second>
                                <SgSplitter Orientation="SgOrientation.Vertical" Size="350" Min="150" Max="1000" Collapsible="true" PersistKey="demo-nested-v2">
                                    <First>
                                        <div class="pane-content pane-content--main">
                                            <div class="code-editor-sim" style="height:100%;">
                                                <span style="color:#608b4e;">// Program.cs</span>
                                                <br/>
                                                <span style="color:#569cd6;">using</span> Microsoft.AspNetCore.Components<span style="color:#d4d4d4;">;</span>
                                                <br/>
                                                <br/>
                                                <span style="color:#569cd6;">var</span> builder <span style="color:#d4d4d4;">=</span> WebApplication.CreateBuilder(args);
                                                <br/>
                                                <br/>
                                                builder.Services.AddRazorComponents();
                                                <br/>
                                                <br/>
                                                <span style="color:#569cd6;">var</span> app <span style="color:#d4d4d4;">=</span> builder.Build();
