@page "/splitter-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>Splitter — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>
        <div class="demo-section">
            <SgTypography Color="var(--sg-text-muted)" Leading="SgTypographyLeading.Relaxed">
                Drag splitter bars to resize panels. Supports any number of panes, keyboard navigation, collapse, snap-to-grid, and in-memory session persistence.
            </SgTypography>
        </div>

        <!-- Section 1: Simple 2-pane modes -->
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Two-pane mode</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Horizontal and vertical layouts. Drag the bar, use collapse buttons, or double-click to reset.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Lg">
                <SgCol Xs="12" Lg="6">
                    <SgCard NoPadding="true" Shadow="SgShadow.Sm" Style="overflow:hidden;">
                        <div class="splitter-demo-box">
                            <div class="splitter-wrapper">
                                <SgSplitter Orientation="SgOrientation.Vertical" Size="_vSize" Collapsible="@_vCollapsible" ShowHandle="@_vHandle"
                                            Min="60" Max="500" PersistKey="demo-vertical" OnResizeEnd="HandleVResize">
                                    <First>
                                        <div class="pane-content pane-content--toolbar">
                                            <div class="pane-label">
                                                <SgIcon Icon="@SgIcons.Layers" Size="14px" />
                                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Transform="SgTypographyTransform.Uppercase" Color="var(--sg-text-muted)">Toolbar</SgTypography>
                                            </div>
                                            <SgStack Horizontal Space="SgSize.Sm" Wrap="true">
                                                <div class="nav-chip active"><SgIcon Icon="@SgIcons.LayoutDashboard" Size="14px" /><span>Dash</span></div>
                                                <div class="nav-chip"><SgIcon Icon="@SgIcons.Settings" Size="14px" /><span>Set</span></div>
                                            </SgStack>
                                        </div>
                                    </First>
                                    <Second>
                                        <div class="pane-content pane-content--main">
                                            <div class="pane-label">
                                                <SgIcon Icon="@SgIcons.Terminal" Size="14px" />
                                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Transform="SgTypographyTransform.Uppercase" Color="var(--sg-text-muted)">Content Area</SgTypography>
                                            </div>
                                            <SgStack Vertical Space="SgSize.Sm">
                                                <SgProgress Value="65" Size="SgSize.Sm" Label="CPU" ShowValue="true" />
                                                <SgProgress Value="42" Size="SgSize.Sm" Color="var(--sg-color-success)" Label="RAM" ShowValue="true" />
                                            </SgStack>
                                        </div>
                                    </Second>
                                </SgSplitter>
                            </div>
                            <div class="demo-controls">
                                <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                                    <SgSwitch @bind-Value="_vCollapsible" Label="Collapse" Size="SgSize.Sm" />
                                    <SgSwitch @bind-Value="_vHandle" Label="Handle" Size="SgSize.Sm" />
                                    <div style="flex:1;"></div>
                                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">@(_vSize)px</SgTypography>
                                </SgStack>
                            </div>
                        </div>
                    </SgCard>
                </SgCol>

                <SgCol Xs="12" Lg="6">
                    <SgCard NoPadding="true" Shadow="SgShadow.Sm" Style="overflow:hidden;">
                        <div class="splitter-demo-box">
                            <div class="splitter-wrapper">
                                <SgSplitter Orientation="SgOrientation.Horizontal" Size="_hSize" Collapsible="@_hCollapsible" ShowHandle="@_hHandle"
                                            Min="120" Max="700" KeyboardResize="true" Step="20" PersistKey="demo-horizontal" OnResizeEnd="HandleHResize">
                                    <First>
                                        <div class="pane-content pane-content--sidebar">
                                            <div class="pane-label">
                                                <SgIcon Icon="@SgIcons.Box" Size="14px" />
                                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Transform="SgTypographyTransform.Uppercase" Color="var(--sg-text-muted)">Sidebar</SgTypography>
                                            </div>
                                            <div class="sidebar-icons">
                                                <SgIcon Icon="@SgIcons.LayoutDashboard" Size="20px" />
                                                <SgIcon Icon="@SgIcons.Users" Size="20px" />
                                                <SgIcon Icon="@SgIcons.Settings" Size="20px" />
                                            </div>
                                        </div>
                                    </First>
                                    <Second>
                                        <div class="pane-content pane-content--main">
                                            <div class="pane-label">
                                                <SgIcon Icon="@SgIcons.Code" Size="14px" />
                                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Transform="SgTypographyTransform.Uppercase" Color="var(--sg-text-muted)">Editor</SgTypography>
                                            </div>
                                            <div class="code-sim">
                                                <span style="color:var(--sg-color-primary);">public class</span> <span style="color:var(--sg-color-success);">SuperUI</span> { ... }
                                            </div>
                                        </div>
                                    </Second>
                                </SgSplitter>
                            </div>
                            <div class="demo-controls">
                                <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                                    <SgSwitch @bind-Value="_hCollapsible" Label="Collapse" Size="SgSize.Sm" />
                                    <SgSwitch @bind-Value="_hHandle" Label="Handle" Size="SgSize.Sm" />
                                    <div style="flex:1;"></div>
                                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">@(_hSize)px</SgTypography>
                                </SgStack>
                            </div>
                        </div>
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

        <!-- Section 2: Multi-pane -->
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Multi-pane mode</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Create layouts with 3+ panes using SgSplitterPane. The last pane fills remaining space.
                </SgTypography>
            </div>

            <SgCard NoPadding="true" Shadow="SgShadow.Sm" Style="overflow:hidden;">
                <div style="height:400px;">
                    <SgSplitter Orientation="SgOrientation.Horizontal" Collapsible="true" ShowHandle="true" PersistKey="demo-multipane">
                        <SgSplitterPane Size="180" Min="100" Max="300">
                            <div class="pane-content pane-content--sidebar">
                                <div class="pane-label">
                                    <SgIcon Icon="@SgIcons.Menu" Size="14px" />
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Transform="SgTypographyTransform.Uppercase" Color="var(--sg-text-muted)">Nav</SgTypography>
                                </div>
                                <SgStack Vertical Space="SgSize.Sm">
                                    @foreach (var item in _navItems)
                                    {
                                        <div class="nav-chip @(_selectedNav == item ? "active" : "")" @onclick="() => _selectedNav = item">
                                            <span>@item</span>
                                        </div>
                                    }
                                </SgStack>
                            </div>
                        </SgSplitterPane>
                        <SgSplitterPane Size="400" Min="200" Max="800">
                            <div class="pane-content pane-content--main">
                                <div class="pane-label">
                                    <SgIcon Icon="@SgIcons.Monitor" Size="14px" />
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Transform="SgTypographyTransform.Uppercase" Color="var(--sg-text-muted)">@_selectedNav</SgTypography>
                                </div>
                                <div class="demo-grid">
                                    @for (int i = 1; i <= 3; i++)
                                    {
                                        <SgCard Size="SgSize.Sm" Shadow="SgShadow.None" Bordered="true">
                                            <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Medium">Metric #@i</SgTypography>
                                            <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Color="var(--sg-color-primary)">@(i * 124)</SgTypography>
                                        </SgCard>
                                    }
                                </div>
                            </div>
                        </SgSplitterPane>
                        <SgSplitterPane Size="200" Min="100" Max="400">
                            <div class="pane-content pane-content--alt">
                                <div class="pane-label">
                                    <SgIcon Icon="@SgIcons.MessageSquare" Size="14px" />
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold" Transform="SgTypographyTransform.Uppercase" Color="var(--sg-text-muted)">Activity</SgTypography>
                                </div>
                                <SgStack Vertical Space="SgSize.Sm">
                                    @foreach (var activity in _activities)
                                    {
                                        <div class="activity-row">
                                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Medium">@activity.Text</SgTypography>
                                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">@activity.Time</SgTypography>
                                        </div>
                                    }
                                </SgStack>
                            </div>
                        </SgSplitterPane>
                    </SgSplitter>
                </div>
            </SgCard>
        </div>
    </ChildContent>
</SgCard>

<style>
    .demo-section { margin-bottom: 32px; }
    .demo-section:last-child { margin-bottom: 0; }
    .demo-section-header { margin-bottom: 16px; }

    .splitter-demo-box { display: flex; flex-direction: column; height: 350px; }
    .splitter-wrapper { flex: 1; overflow: hidden; }
    .demo-controls { padding: 12px; background: var(--sg-bg-subtle); border-top: 1px solid var(--sg-border); }

    .pane-content { height: 100%; padding: 16px; background: var(--sg-bg); }
    .pane-content--toolbar { background: var(--sg-bg-subtle); }
    .pane-content--sidebar { background: var(--sg-bg-subtle); border-right: 1px solid var(--sg-border-subtle); }
    .pane-content--alt { background: var(--sg-bg-subtle); border-left: 1px solid var(--sg-border-subtle); }

    .pane-label { display: flex; align-items: center; gap: 8px; margin-bottom: 16px; opacity: 0.8; }
    
    .nav-chip { 
        display: flex; align-items: center; gap: 8px; padding: 6px 12px; 
        border-radius: 6px; cursor: pointer; font-size: 13px; color: var(--sg-fg-subtle);
        transition: all 0.2s;
    }
    .nav-chip:hover { background: var(--sg-bg-hover); }
    .nav-chip.active { background: var(--sg-color-primary-subtle); color: var(--sg-color-primary); font-weight: 500; }

    .sidebar-icons { display: flex; flex-direction: column; gap: 16px; align-items: center; padding-top: 12px; color: var(--sg-fg-muted); }
    .code-sim { font-family: var(--sg-font-mono); font-size: 12px; padding: 12px; background: var(--sg-bg-subtle); border-radius: 6px; }

    .demo-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; }
    .activity-row { padding-bottom: 8px; border-bottom: 1px solid var(--sg-border-subtle); }
</style>

@code {
    private double _vSize = 120;
    private bool _vCollapsible = true;
    private bool _vHandle = true;

    private double _hSize = 160;
    private bool _hCollapsible = true;
    private bool _hHandle = true;

    private string _selectedNav = "Dashboard";
    private readonly List<string> _navItems = new() { "Dashboard", "Analytics", "Users", "Settings" };

    private readonly List<Activity> _activities = new()
    {
        new("System updated", "2m ago"),
        new("User login: admin", "15m ago"),
        new("Backup completed", "1h ago")
    };

    private void HandleHResize(double[] v)
    {
        if (v.Length > 0) _hSize = v[0];
    }

    private void HandleVResize(double[] v)
    {
        if (v.Length > 0) _vSize = v[0];
    }

    private RenderFragment _mainHeader => __builder =>
    {
        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
            <div style="padding:10px;border-radius:10px;background:var(--sg-color-primary-subtle);color:var(--sg-color-primary);display:flex;">
                <SgIcon Icon="@SgIcons.Layout" Size="24px" />
            </div>
            <div>
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">Splitter Layouts</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Flexible resizable panels with collapse support and state persistence.</SgTypography>
            </div>
        </SgStack>
    };

    private record Activity(string Text, string Time);
}