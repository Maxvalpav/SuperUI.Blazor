@page "/splitter-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Services

<PageTitle>Splitter — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg" Status="SgCardStatus.Info" Animated="true">
    <HeaderContent>
        <DemoPageHeader Title="Splitter Layouts"
                        Subtitle="Resizable panels with drag, keyboard, double-click reset, collapse and position persistence — for both Server and WebAssembly."
                        Icon="@SgHeroicons.Outline.Squares2x2" />
    </HeaderContent>
    <ChildContent>

        <!-- ── Two-pane ── -->
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Two-pane</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Drag the bar, focus it and use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">←/→/↑/↓</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Home/End</SgTypography>, or double-click to reset. Toggle options live.
                </SgTypography>
            </div>

            <SgRow Space="SgSize.Lg">
                <SgCol Xs="12" Lg="6">
                    <SgCard Title="Horizontal" Subtitle="Side-by-side panes" Shadow="SgShadow.Sm" Radius="SgSize.Md" NoPadding="true" OverflowHidden="true">
                        <ActionContent>
                            <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                                <SgSwitch @bind-Value="_hCollapsible" Label="Collapse" Size="SgSize.Sm" />
                                <SgSwitch @bind-Value="_hHandle" Label="Handle" Size="SgSize.Sm" />
                            </SgStack>
                        </ActionContent>
                        <ChildContent>
                            <div style="height:260px;">
                                <SgSplitter Size="200" Min="120" Max="420"
                                            Collapsible="_hCollapsible" ShowHandle="_hHandle"
                                            PersistKey="demo-h" HandleTooltip="Resize panels">
                                    <First>
                                        <div class="pane pane--sidebar">
                                            <div class="pane-label"><SgIcon Icon="@SgIcons.Folder" Size="14px" /><span>Sidebar</span></div>
                                            <SgStack Vertical Space="SgSize.Sm">
                                                <div class="nav-chip active"><SgIcon Icon="@SgIcons.LayoutDashboard" Size="14px" /><span>Dashboard</span></div>
                                                <div class="nav-chip"><SgIcon Icon="@SgIcons.Layers" Size="14px" /><span>Projects</span></div>
                                                <div class="nav-chip"><SgIcon Icon="@SgIcons.Settings" Size="14px" /><span>Settings</span></div>
                                            </SgStack>
                                        </div>
                                    </First>
                                    <Second>
                                        <div class="pane">
                                            <div class="pane-label"><SgIcon Icon="@SgIcons.Code" Size="14px" /><span>Editor</span></div>
                                            <div class="code-sim"><span class="kw">public class</span> <span class="ty">SuperUI</span> { … }</div>
                                            <SgStack Vertical Space="SgSize.Sm" Style="margin-top:12px;">
                                                <SgProgress Value="72" Size="SgSize.Sm" Label="Build" ShowValue="true" />
                                                <SgProgress Value="48" Size="SgSize.Sm" Color="var(--sg-color-success)" Label="Tests" ShowValue="true" />
                                            </SgStack>
                                        </div>
                                    </Second>
                                </SgSplitter>
                            </div>
                        </ChildContent>
                    </SgCard>
                </SgCol>

                <SgCol Xs="12" Lg="6">
                    <SgCard Title="Vertical" Subtitle="Stacked panes" Shadow="SgShadow.Sm" Radius="SgSize.Md" NoPadding="true" OverflowHidden="true">
                        <ActionContent>
                            <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                                <SgSwitch @bind-Value="_vCollapsible" Label="Collapse" Size="SgSize.Sm" />
                                <SgSwitch @bind-Value="_vHandle" Label="Handle" Size="SgSize.Sm" />
                            </SgStack>
                        </ActionContent>
                        <ChildContent>
                            <div style="height:260px;">
                                <SgSplitter Vertical="true" Size="110" Min="60" Max="200"
                                            Collapsible="_vCollapsible" ShowHandle="_vHandle"
                                            PersistKey="demo-v" HandleTooltip="Resize panels">
                                    <First>
                                        <div class="pane pane--sidebar">
                                            <div class="pane-label"><SgIcon Icon="@SgIcons.Terminal" Size="14px" /><span>Toolbar</span></div>
                                            <SgStack Horizontal Space="SgSize.Sm" Wrap="true">
                                                <SgBadge Variant="SgBadgeVariant.Info" Text="Run" Standalone="true" />
                                                <SgBadge Variant="SgBadgeVariant.Success" Text="Deploy" Standalone="true" />
                                                <SgBadge Variant="SgBadgeVariant.Warn" Text="Stop" Standalone="true" />
                                            </SgStack>
                                        </div>
                                    </First>
                                    <Second>
                                        <div class="pane">
                                            <div class="pane-label"><SgIcon Icon="@SgIcons.Monitor" Size="14px" /><span>Output</span></div>
                                            <div class="code-sim"><span class="ok">✓</span> Compiled in 1.2s · 0 errors</div>
                                        </div>
                                    </Second>
                                </SgSplitter>
                            </div>
                        </ChildContent>
                    </SgCard>
                </SgCol>
            </SgRow>
        </div>

        <!-- ── Multi-pane ── -->
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Multi-pane</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Any number of <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgSplitterPane</SgTypography> children, each with its own min/max. The last pane always fills the remaining space.
                </SgTypography>
            </div>

            <SgCard Shadow="SgShadow.Sm" Radius="SgSize.Md" NoPadding="true" OverflowHidden="true">
                <div style="height:240px;">
                    <SgSplitter Collapsible="true" ShowHandle="true" PersistKey="demo-multi">
                        <SgSplitterPane Size="180" Min="100" Max="280">
                            <div class="pane pane--sidebar">
                                <div class="pane-label"><SgIcon Icon="@SgIcons.Menu" Size="14px" /><span>Navigation</span></div>
                                <SgStack Vertical Space="SgSize.Sm">
                                    @foreach (var item in _navItems)
                                    {
                                        var it = item;
                                        <div class="nav-chip @(_selectedNav == it ? "active" : "")" @onclick="() => _selectedNav = it"><span>@it</span></div>
                                    }
                                </SgStack>
                            </div>
                        </SgSplitterPane>
                        <SgSplitterPane Size="380" Min="200">
                            <div class="pane">
                                <div class="pane-label"><SgIcon Icon="@SgIcons.LayoutDashboard" Size="14px" /><span>@_selectedNav</span></div>
                                <div class="metric-grid">
                                    @for (var i = 1; i <= 3; i++)
                                    {
                                        var n = i;
                                        <SgCard Size="SgSize.Sm" Shadow="SgShadow.None" Bordered="true" Compact="true">
                                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Metric #@n</SgTypography>
                                            <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Color="var(--sg-color-primary)">@(n * 124)</SgTypography>
                                        </SgCard>
                                    }
                                </div>
                            </div>
                        </SgSplitterPane>
                        <SgSplitterPane Size="200" Min="120" Max="320">
                            <div class="pane pane--alt">
                                <div class="pane-label"><SgIcon Icon="@SgIcons.Settings" Size="14px" /><span>Inspector</span></div>
                                <SgStack Vertical Space="SgSize.Sm">
                                    @foreach (var a in _activities)
                                    {
                                        <div class="activity-row">
                                            <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Medium">@a.Text</SgTypography>
                                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">@a.Time</SgTypography>
                                        </div>
                                    }
                                </SgStack>
                            </div>
                        </SgSplitterPane>
                    </SgSplitter>
                </div>
            </SgCard>
        </div>

        <!-- ── Live constructor ── -->
        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Live Constructor</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Configure the splitter in real time and copy the generated markup.
                </SgTypography>
            </div>

            <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
                <SgRow Space="SgSize.Md">
                    <SgCol Xs="12" Md="4" Style="padding:20px;border-right:1px solid var(--sg-border);">
                        <SgStack Vertical Space="SgSize.Lg">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Orientation</SgTypography>
                                <SgSegmented TValue="SgOrientation" Value="_orientation"
                                             ValueChanged="v => { _orientation = v; UpdateCode(); }"
                                             Block="true" Size="sm" Options="_orientationOptions" />
                            </SgStack>

                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Collapsible</SgTypography>
                                        <SgSegmented TValue="bool" Value="_collapsible"
                                                     ValueChanged="v => { _collapsible = v; UpdateCode(); }"
                                                     Block="true" Size="sm" Options="_boolOptions" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Handle</SgTypography>
                                        <SgSegmented TValue="bool" Value="_handle"
                                                     ValueChanged="v => { _handle = v; UpdateCode(); }"
                                                     Block="true" Size="sm" Options="_boolOptions" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>

                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Keyboard</SgTypography>
                                        <SgSegmented TValue="bool" Value="_keyboard"
                                                     ValueChanged="v => { _keyboard = v; UpdateCode(); }"
                                                     Block="true" Size="sm" Options="_boolOptions" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Disabled</SgTypography>
                                        <SgSegmented TValue="bool" Value="_disabled"
                                                     ValueChanged="v => { _disabled = v; UpdateCode(); }"
                                                     Block="true" Size="sm" Options="_boolOptions" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>

                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@($"{_size}px")" Standalone="true" />
                                </SgStack>
                                <SgSegmented TValue="int" Value="_size"
                                             ValueChanged="v => { _size = v; UpdateCode(); }"
                                             Block="true" Size="sm" Options="_sizeOptions" />
                            </SgStack>
                        </SgStack>
                    </SgCol>

                    <SgCol Xs="12" Md="8" Style="padding:20px;">
                        <SgStack Vertical Space="SgSize.Lg">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Preview</SgTypography>
                                <SgCard Shadow="SgShadow.None" Bordered="true" Radius="SgSize.Md" NoPadding="true" OverflowHidden="true">
                                    <div style="height:240px;">
                                        <SgSplitter Orientation="_orientation" Size="_size" Min="60"
                                                    Collapsible="_collapsible" ShowHandle="_handle"
                                                    KeyboardResize="_keyboard" Disabled="_disabled"
                                                    HandleTooltip="Resize">
                                            <First>
                                                <div class="pane pane--sidebar">
                                                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.Center" Style="height:100%;">
                                                        <SgIcon Icon="@SgIcons.Layout" Size="22px" Color="var(--sg-color-primary)" />
                                                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold">Pane A</SgTypography>
                                                    </SgStack>
                                                </div>
                                            </First>
                                            <Second>
                                                <div class="pane">
                                                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.Center" Style="height:100%;">
                                                        <SgIcon Icon="@SgIcons.Square" Size="22px" Color="var(--sg-color-success)" />
                                                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold">Pane B</SgTypography>
                                                    </SgStack>
                                                </div>
                                            </Second>
                                        </SgSplitter>
                                    </div>
                                </SgCard>
                            </SgStack>

                            <SgStack Vertical Space="SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <DemoCodeBlock Code="@_generatedCode" Language="razor" />
                            </SgStack>
                        </SgStack>
                    </SgCol>
                </SgRow>
            </SgCard>
        </div>

    </ChildContent>
</SgCard>

<style>
    .demo-section { margin-top: 40px; }
    .demo-section:first-child { margin-top: 0; }
    .demo-section-header { margin-bottom: 16px; }

    .pane { height: 100%; padding: 14px 16px; background: var(--sg-bg); overflow: auto; }
    .pane--sidebar { background: var(--sg-bg-subtle); }
    .pane--alt { background: var(--sg-bg-subtle); }

    .pane-label { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; font-size: 11px;
        font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--sg-text-muted); }

    .nav-chip { display: flex; align-items: center; gap: 8px; padding: 6px 10px; border-radius: 6px;
        cursor: pointer; font-size: 13px; color: var(--sg-fg-subtle); transition: background 0.15s, color 0.15s; position: relative; }
    .nav-chip:hover { background: var(--sg-bg-hover); }
    .nav-chip.active { background: var(--sg-color-primary-subtle); color: var(--sg-color-primary); font-weight: 600; }
    .nav-chip.active::before { content: ""; position: absolute; left: 0; top: 7px; bottom: 7px; width: 3px;
        background: var(--sg-color-primary); border-radius: 0 2px 2px 0; }

    .code-sim { font-family: var(--sg-font-mono); font-size: 12px; padding: 10px 12px;
        background: var(--sg-bg-subtle); border-radius: 6px; }
    .code-sim .kw { color: var(--sg-color-primary); }
    .code-sim .ty { color: var(--sg-color-success); }
    .code-sim .ok { color: var(--sg-color-success); font-weight: 700; }

    .metric-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 10px; }
    .activity-row { padding-bottom: 8px; border-bottom: 1px solid var(--sg-border-subtle); }
</style>

@code {
    private bool _hCollapsible = true, _hHandle = true;
    private bool _vCollapsible = true, _vHandle = true;

    private string _selectedNav = "Dashboard";
    private readonly List<string> _navItems = new() { "Dashboard", "Projects", "Reports", "Settings" };

    private readonly List<Activity> _activities = new()
    {
        new("Build passed", "2m ago"),
        new("Deploy queued", "8m ago"),
        new("PR merged", "1h ago"),
    };

    // ── Live constructor state ──
    private SgOrientation _orientation = SgOrientation.Horizontal;
    private bool _collapsible = true;
    private bool _handle = true;
    private bool _keyboard = true;
    private bool _disabled;
    private int _size = 200;
    private string _generatedCode = string.Empty;

    private readonly List<SgSegmentedOption<SgOrientation>> _orientationOptions = new()
    {
        new() { Value = SgOrientation.Horizontal, Label = "Horizontal" },
        new() { Value = SgOrientation.Vertical, Label = "Vertical" },
    };

    private readonly List<SgSegmentedOption<bool>> _boolOptions = new()
    {
        new() { Value = false, Label = "Off" },
        new() { Value = true, Label = "On" },
    };

    private readonly List<SgSegmentedOption<int>> _sizeOptions = new()
    {
        new() { Value = 120, Label = "120" },
        new() { Value = 200, Label = "200" },
        new() { Value = 280, Label = "280" },
    };

    protected override void OnInitialized() => UpdateCode();

    private void UpdateCode()
    {
        var lines = new List<string> { "<SgSplitter" };
        var attrs = new List<string>();
        if (_orientation != SgOrientation.Horizontal) attrs.Add($"Orientation=\"SgOrientation.{_orientation}\"");
        attrs.Add($"Size=\"{_size}\"");
        attrs.Add("Min=\"60\"");
        if (_collapsible) attrs.Add("Collapsible=\"true\"");
        if (!_handle) attrs.Add("ShowHandle=\"false\"");
        if (!_keyboard) attrs.Add("KeyboardResize=\"false\"");
        if (_disabled) attrs.Add("Disabled=\"true\"");

        for (var i = 0; i < attrs.Count; i++)
            lines.Add($"            {attrs[i]}" + (i == attrs.Count - 1 ? ">" : ""));

        lines.Add("    <First>Pane A</First>");
        lines.Add("    <Second>Pane B</Second>");
        lines.Add("</SgSplitter>");
        _generatedCode = string.Join("\n", lines);
    }

    private record Activity(string Text, string Time);
}
