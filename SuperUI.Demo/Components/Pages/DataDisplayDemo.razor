    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 12. SgCarousel                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgCarousel — Carousel
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Rotating slideshow with auto-play, arrows, dot indicators, and slide/fade transitions.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Basic Slideshow" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgCarousel TItem="CarouselDemoItem" Items="_carouselItems" AutoPlay="true" Interval="3000" Loop="true">
                    <ItemTemplate>
                        <div style="height:200px;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(135deg, @context.Color1, @context.Color2);color:#fff;text-align:center;padding:24px;">
                            <span style="font-size:32px;font-weight:700;display:block;">@context.Title</span>
                            <span style="font-size:14px;opacity:.85;margin-top:8px;display:block;">@context.Description</span>
                        </div>
                    </ItemTemplate>
                </SgCarousel>
            </SgCard>

            <SgCard Title="Fade Transition" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgCarousel TItem="CarouselDemoItem" Items="_carouselItems" Transition="SgCarouselTransition.Fade" AutoPlay="true" Interval="3000" Loop="true">
                    <ItemTemplate>
                        <div style="height:200px;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(135deg, @context.Color2, @context.Color1);color:#fff;text-align:center;padding:24px;">
                            <span style="font-size:28px;font-weight:700;display:block;">@context.Title</span>
                            <span style="font-size:13px;opacity:.85;margin-top:6px;display:block;">@context.Subtitle</span>
                        </div>
                    </ItemTemplate>
                </SgCarousel>
            </SgCard>
        </div>

        <div class="demo-two-col" style="margin-top:24px;">
            <SgCard Title="No Auto-Play + No Loop" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgCarousel TItem="CarouselDemoItem" Items="_carouselItems.Take(3)" AutoPlay="false" Loop="false">
                    <ItemTemplate>
                        <div style="height:180px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg, @context.Color1, @context.Color2);color:#fff;font-size:22px;font-weight:600;">
                            @context.Title
                        </div>
                    </ItemTemplate>
                </SgCarousel>
            </SgCard>

            <SgCard Title="SgCarousel Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_carouselProperties" />
            </SgCard>
        </div>
    </div>

</ChildContent>
</SgCard>

<style>
    .demo-section {
        margin-top: 48px;
    }
    .demo-section-header {
        margin-bottom: 20px;
    }
    .demo-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }
    @@media (max-width: 768px) {
        .demo-two-col { grid-template-columns: 1fr; }
    }
</style>

