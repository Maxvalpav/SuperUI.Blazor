@page "/data-display-demo"
@using SuperUI.Components

<PageTitle>Отображение данных - SUI</PageTitle>

<SgCard Title="Компоненты отображения данных"
        Subtitle="Компоненты для визуализации и представления информации.">

    <!-- SgTag -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">SgTag - Теги</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Компактные элементы для отображения категорий, статусов или меток с поддержкой цветов и закрытия.</SgTypography>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Цвета пресетов</SgTypography>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <SgTag Color="success">Success</SgTag>
                            <SgTag Color="processing">Processing</SgTag>
                            <SgTag Color="warning">Warning</SgTag>
                            <SgTag Color="error">Error</SgTag>
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">HEX цвета</SgTypography>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <SgTag Color="#f50">#f50</SgTag>
                            <SgTag Color="#2db7f5">#2db7f5</SgTag>
                            <SgTag Color="#87d068">#87d068</SgTag>
                            <SgTag Color="#108ee9">#108ee9</SgTag>
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Закрываемые</SgTypography>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <SgTag Closable="true">Tag 1</SgTag>
                            <SgTag Closable="true" Color="processing">Tag 2</SgTag>
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_tagProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgImage -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">SgImage - Изображения</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Компонент для отображения изображений с поддержкой ленивой загрузки, состояний ошибки и плейсхолдеров.</SgTypography>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div style="display: flex; gap: 16px;">
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Обычное</SgTypography>
                            <SgImage Src="https://picsum.photos/200/200?random=1" Width="100px" Height="100px" Alt="Random" />
                        </div>
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Круглое (через CSS)</SgTypography>
                            <SgImage Src="https://picsum.photos/200/200?random=2" Width="100px" Height="100px" Style="border-radius: 50%" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Ошибка загрузки с фоллбеком</SgTypography>
                        <SgImage Src="invalid-path.jpg" FallbackSrc="https://via.placeholder.com/100?text=Error" Width="100px" Height="100px" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_imageProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgBadge -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">SgBadge - Значки и метки</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Компонент для отображения статусов, счётчиков и категорий.</SgTypography>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Варианты</SgTypography>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Default" Variant="SgBadgeVariant.Default" />
                            <SgBadge Text="Success" Variant="SgBadgeVariant.Success" />
                            <SgBadge Text="Danger" Variant="SgBadgeVariant.Danger" />
                            <SgBadge Text="Warn" Variant="SgBadgeVariant.Warn" />
                            <SgBadge Text="Muted" Variant="SgBadgeVariant.Muted" />
                        </div>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Примеры статусов</SgTypography>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Активен" Variant="SgBadgeVariant.Success" />
                            <SgBadge Text="В разработке" Variant="SgBadgeVariant.Warn" />
                            <SgBadge Text="Архив" Variant="SgBadgeVariant.Muted" />
                            <SgBadge Text="Критично" Variant="SgBadgeVariant.Danger" />
                        </div>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">С пользовательским содержимым</SgTypography>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Variant="SgBadgeVariant.Success">✓ Активен</SgBadge>
                            <SgBadge Variant="SgBadgeVariant.Danger">✗ Ошибка</SgBadge>
                            <SgBadge Variant="SgBadgeVariant.Warn">⚠ Внимание</SgBadge>
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_badgeProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgChip -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">SgChip - Чипы и теги</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Интерактивные элементы для фильтров, тегов и выбора.</SgTypography>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Закрываемые теги</SgTypography>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <SgChip Text="React" Closable="true" OnClose="@(() => {})" />
                            <SgChip Text="Vue" Closable="true" OnClose="@(() => {})" />
                            <SgChip Text="Angular" Closable="true" OnClose="@(() => {})" />
                            <SgChip Text="Blazor" Closable="true" OnClose="@(() => {})" />
                        </div>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Варианты</SgTypography>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <SgChip Text="Default" />
                            <SgChip Text="Primary" Variant="SgChipVariant.Primary" />
                            <SgChip Text="Success" Variant="SgChipVariant.Success" />
                            <SgChip Text="Danger" Variant="SgChipVariant.Danger" />
                            <SgChip Text="Warn" Variant="SgChipVariant.Warn" />
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_chipProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgAvatar -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">SgAvatar - Аватары</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Компонент для отображения изображений профилей и инициалов.</SgTypography>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Размеры (sm / md / lg)</SgTypography>
                        <div style="display: flex; gap: 12px; align-items: center;">
                            <SgAvatar Initials="SM" Size="SgSize.Sm" Title="Small" />
                            <SgAvatar Initials="MD" Size="SgSize.Md" Title="Medium" />
                            <SgAvatar Initials="LG" Size="SgSize.Lg" Title="Large" />
                        </div>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Из заголовка (автоинициалы)</SgTypography>
                        <div style="display: flex; gap: 8px;">
                            <SgAvatar Title="Иван Петров" Color="#1890ff" />
                            <SgAvatar Title="Мария Сидорова" Color="#52c41a" />
                            <SgAvatar Title="Алексей Козлов" Color="#722ed1" />
                        </div>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">С цветом фона</SgTypography>
                        <div style="display: flex; gap: 8px;">
                            <SgAvatar Initials="АБ" Color="#f5222d" />
                            <SgAvatar Initials="ВГ" Color="#fa8c16" />
                            <SgAvatar Initials="ДЕ" Color="#13c2c2" />
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_avatarProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgAvatarGroup -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">SgAvatarGroup - Группы аватаров</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Компонент для отображения набора аватаров с поддержкой перекрытия и индикатора переполнения.</SgTypography>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 24px;">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Базовая группа</SgTypography>
                        <SgAvatarGroup Max="4" TotalCount="10">
                            <SgAvatar Title="Иван Петров" Color="#1890ff" Bordered="true" />
                            <SgAvatar Title="Мария Сидорова" Color="#52c41a" Bordered="true" />
                            <SgAvatar Title="Алексей Козлов" Color="#722ed1" Bordered="true" />
                            <SgAvatar Title="Елена Соколова" Color="#fa8c16" Bordered="true" />
                        </SgAvatarGroup>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Разные размеры</SgTypography>
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <SgAvatarGroup Size="SgSize.Sm" Max="3" TotalCount="5">
                                <SgAvatar Initials="AB" Bordered="true" />
                                <SgAvatar Initials="CD" Bordered="true" />
                                <SgAvatar Initials="EF" Bordered="true" />
                            </SgAvatarGroup>
                            <SgAvatarGroup Size="SgSize.Lg" Max="3" TotalCount="5">
                                <SgAvatar Initials="AB" Bordered="true" />
                                <SgAvatar Initials="CD" Bordered="true" />
                                <SgAvatar Initials="EF" Bordered="true" />
                            </SgAvatarGroup>
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_avatarGroupProperties" />
            </SgCard>
        </div>
    </div>

   

    <!-- SgStatistic -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">SgStatistic - Статистика</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Компонент для отображения числовых показателей и метрик.</SgTypography>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 16px;">
                    <SgStatistic Title="Пользователи" Value="1 234" />
                    <SgStatistic Title="Доходы" Value="98 765 ₽" />
                    <SgStatistic Title="Рост" Value="+12.5%" />
                    <SgStatistic Title="Конверсия" Value="3.2%" />
                </div>
                <div style="margin-top: 16px; display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 16px;">
                    <SgStatistic Title="Заказы" Value="342" TrendValue="0.15" />
                    <SgStatistic Title="Возвраты" Value="12" TrendValue="-0.05" />
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_statisticProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgEmpty -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">SgEmpty - Пустое состояние</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Компонент для отображения пустого состояния списков и таблиц.</SgTypography>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 24px;">
                    <SgEmpty Text="Нет данных для отображения" />
                    <SgEmpty Text="Список пуст. Добавьте первый элемент." />
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_emptyProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgSkeleton -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">SgSkeleton - Скелет загрузки</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Компонент для отображения заполнителей во время загрузки контента.</SgTypography>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 24px;">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Текстовый скелет</SgTypography>
                        <SgSkeleton Active="true" Paragraph="true" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">С аватаром</SgTypography>
                        <SgSkeleton Active="true" Avatar="true" Paragraph="true" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Только заголовок</SgTypography>
                        <SgSkeleton Active="true" Paragraph="false" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_skeletonProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgTimeline -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">SgTimeline - Временная шкала</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Компонент для отображения последовательности событий.</SgTypography>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <SgTimeline Items="_timelineItems" />
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_timelineProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgActivityFeed -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">SgActivityFeed - Лента активности</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Компонент для отображения ленты событий и действий пользователей.</SgTypography>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <SgActivityFeed Items="_activityItems" />
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_activityFeedProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Примеры кода -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">Примеры кода</SgTypography>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">

            <SgCard Title="SgChip — перечисление SgChipVariant">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <PropertyTable Items="_chipVariantEnum" />
                </div>
            </SgCard>

            <SgCard Title="SgAvatar — Shape и Status">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <PropertyTable Items="_avatarEnumValues" />
                </div>
            </SgCard>

        </div>
    </div>

</SgCard>

@code {
    private List<PropertyPanelItem> _tagProperties = new()
    {
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Содержимое тега" },
        new() { Label = "Color", Value = "string", BadgeText = "Цвет пресета или hex" },
        new() { Label = "Closable", Value = "bool", BadgeText = "Можно ли закрыть тег", Description = "false" }
    };

    private List<PropertyPanelItem> _imageProperties = new()
    {
        new() { Label = "Src", Value = "string", BadgeText = "Путь к изображению" },
        new() { Label = "FallbackSrc", Value = "string", BadgeText = "Резервный путь при ошибке" },
        new() { Label = "Alt", Value = "string", BadgeText = "Альтернативный текст" },
        new() { Label = "Width", Value = "string", BadgeText = "Ширина" },
        new() { Label = "Height", Value = "string", BadgeText = "Высота" },
        new() { Label = "Lazy", Value = "bool", BadgeText = "Ленивая загрузка", Description = "false" }
    };

    private List<PropertyPanelItem> _badgeProperties = new()
    {
        new() { Label = "Text", Value = "string", BadgeText = "Текст", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Variant", Value = "default|success|danger|warn|muted", BadgeText = "Вариант", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "AriaLabel", Value = "string", BadgeText = "Aria-метка", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Содержимое", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "CssClass", Value = "string", BadgeText = "CSS класс", BadgeVariant = SgBadgeVariant.Info }
    };

    private List<PropertyPanelItem> _chipProperties = new()
    {
        new() { Label = "Text", Value = "string", BadgeText = "Текст", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Variant", Value = "default|primary|success|danger|warn", BadgeText = "Вариант", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Closable", Value = "bool", BadgeText = "Закрываемый", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "OnClose", Value = "EventCallback", BadgeText = "Закрытие", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Icon", Value = "RenderFragment", BadgeText = "Иконка", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Содержимое", BadgeVariant = SgBadgeVariant.Info }
    };

    private List<PropertyPanelItem> _avatarProperties = new()
    {
        new() { Label = "Initials", Value = "string", BadgeText = "Инициалы", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Title", Value = "string", BadgeText = "Заголовок (автоинициалы)", BadgeVariant = SgBadgeVariant.Info },
