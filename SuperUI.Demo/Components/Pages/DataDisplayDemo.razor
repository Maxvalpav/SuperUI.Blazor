@page "/data-display-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>Data Display — SuperUI</PageTitle>

<SgSeoHead Description="SgTag, SgAvatar, SgAvatarGroup, SgStatistic, SgEmpty, SgTimeline, SgActivityFeed, SgImage, SgCarousel — components for visualizing information." />

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Data Display" Subtitle="SgTag, SgAvatar, SgAvatarGroup, SgStatistic, SgEmpty, SgTimeline, SgActivityFeed, SgImage, SgCarousel — components for visualizing information." />
    </HeaderContent>
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. SgTag                                                          -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgTag — Tags
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Compact elements for displaying categories, statuses or labels with color support and optional close button.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Preset Colors
                        </SgTypography>
                        <SgSpace Wrap="true">
                            <SgTag Color="success">Success</SgTag>
                            <SgTag Color="processing">Processing</SgTag>
                            <SgTag Color="warning">Warning</SgTag>
                            <SgTag Color="error">Error</SgTag>
                        </SgSpace>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            HEX Colors
                        </SgTypography>
                        <SgSpace Wrap="true">
                            <SgTag Color="#f50">#f50</SgTag>
                            <SgTag Color="#2db7f5">#2db7f5</SgTag>
                            <SgTag Color="#87d068">#87d068</SgTag>
                            <SgTag Color="#108ee9">#108ee9</SgTag>
                        </SgSpace>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Closable
                        </SgTypography>
                        <SgSpace Wrap="true">
                            <SgTag Closable="true">Tag 1</SgTag>
                            <SgTag Closable="true" Color="processing">Tag 2</SgTag>
                            <SgTag Closable="true" Color="success">Tag 3</SgTag>
                            <SgTag Closable="true" Color="error">Tag 4</SgTag>
                        </SgSpace>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With Icons
                        </SgTypography>
                        <SgSpace Wrap="true">
                            <SgTag Color="success">@((MarkupString)SgHeroicons.Outline.CheckCircle) Approved</SgTag>
                            <SgTag Color="processing">@((MarkupString)SgHeroicons.Outline.Clock) Pending</SgTag>
                            <SgTag Color="error">@((MarkupString)SgHeroicons.Outline.XCircle) Rejected</SgTag>
                            <SgTag Color="warning">@((MarkupString)SgHeroicons.Outline.ExclamationTriangle) Review</SgTag>
                            <SgTag Color="#722ed1">@((MarkupString)SgHeroicons.Outline.Star) Featured</SgTag>
                        </SgSpace>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="SgTag Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_tagProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. SgAvatar                                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgAvatar — Avatars
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Displays profile images, initials, or a fallback icon. Supports sizes, shapes, status dots, and custom colors.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Sizes (Sm / Md / Lg)
                        </SgTypography>
                        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                            <SgAvatar Initials="SM" Size="SgSize.Sm" Title="Small" Color="#3b82f6" />
                            <SgAvatar Initials="MD" Size="SgSize.Md" Title="Medium" Color="#6366f1" />
                            <SgAvatar Initials="LG" Size="SgSize.Lg" Title="Large" Color="#8b5cf6" />
                        </SgStack>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Initials from Title
                        </SgTypography>
                        <SgSpace Wrap="true">
                            <SgAvatar Title="John Smith" Color="#1890ff" />
                            <SgAvatar Title="Jane Doe" Color="#52c41a" />
                            <SgAvatar Title="Alice Johnson" Color="#722ed1" />
                            <SgAvatar Title="Bob Williams" Color="#fa8c16" />
                        </SgSpace>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Custom Colors
                        </SgTypography>
                        <SgSpace Wrap="true">
                            <SgAvatar Initials="AB" Color="#f5222d" />
                            <SgAvatar Initials="CD" Color="#fa8c16" />
                            <SgAvatar Initials="EF" Color="#13c2c2" />
                            <SgAvatar Initials="GH" Color="#52c41a" />
                            <SgAvatar Initials="IJ" Color="#2f54eb" />
                        </SgSpace>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Shapes (Circle / Square / Rounded)
                        </SgTypography>
                        <SgSpace Wrap="true" Align="SgAlignItems.Center">
                            <SgAvatar Initials="CR" Shape="SgAvatarShape.Circle" Color="#3b82f6" Title="Circle" />
                            <SgAvatar Initials="SQ" Shape="SgAvatarShape.Square" Color="#6366f1" Title="Square" />
                            <SgAvatar Initials="RD" Shape="SgAvatarShape.Rounded" Color="#8b5cf6" Title="Rounded" />
                        </SgSpace>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Status Dot Variants
                        </SgTypography>
                        <SgSpace Wrap="true" Align="SgAlignItems.Center">
                            <SgAvatar Initials="ON" Title="Online" Color="#52c41a" StatusDot="SgAvatarStatus.Online" />
                            <SgAvatar Initials="OF" Title="Offline" Color="#8c8c8c" StatusDot="SgAvatarStatus.Offline" />
                            <SgAvatar Initials="BS" Title="Busy" Color="#f5222d" StatusDot="SgAvatarStatus.Busy" />
                            <SgAvatar Initials="AW" Title="Away" Color="#faad14" StatusDot="SgAvatarStatus.Away" />
                        </SgSpace>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="SgAvatar Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_avatarProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. SgAvatarGroup                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgAvatarGroup — Avatar Groups
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Grouped avatars with overlap, max display limit, and overflow indicator.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Basic Group with Max
                        </SgTypography>
                        <SgAvatarGroup Max="4" TotalCount="8">
                            <SgAvatar Title="John Smith" Color="#1890ff" Bordered="true" />
                            <SgAvatar Title="Jane Doe" Color="#52c41a" Bordered="true" />
                            <SgAvatar Title="Alice Johnson" Color="#722ed1" Bordered="true" />
                            <SgAvatar Title="Bob Williams" Color="#fa8c16" Bordered="true" />
                        </SgAvatarGroup>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Different Sizes (Sm / Md / Lg)
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgAvatarGroup Size="SgSize.Sm" Max="3" TotalCount="5">
                                <SgAvatar Initials="AB" Bordered="true" Color="#3b82f6" />
                                <SgAvatar Initials="CD" Bordered="true" Color="#6366f1" />
                                <SgAvatar Initials="EF" Bordered="true" Color="#8b5cf6" />
                            </SgAvatarGroup>
                            <SgAvatarGroup Size="SgSize.Md" Max="3" TotalCount="5">
                                <SgAvatar Initials="GH" Bordered="true" Color="#52c41a" />
                                <SgAvatar Initials="IJ" Bordered="true" Color="#fa8c16" />
                                <SgAvatar Initials="KL" Bordered="true" Color="#f5222d" />
                            </SgAvatarGroup>
                            <SgAvatarGroup Size="SgSize.Lg" Max="3" TotalCount="5">
                                <SgAvatar Initials="MN" Bordered="true" Color="#722ed1" />
                                <SgAvatar Initials="OP" Bordered="true" Color="#13c2c2" />
                                <SgAvatar Initials="QR" Bordered="true" Color="#2f54eb" />
                            </SgAvatarGroup>
                        </SgStack>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="SgAvatarGroup Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_avatarGroupProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. SgStatistic                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgStatistic — Statistics
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Displays numerical metrics with title, value, prefix/suffix, and trend indicators.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Basic Statistics
                        </SgTypography>
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="6">
                                <SgStatistic Title="Users" Value="1,234" Bordered="true" />
                            </SgCol>
                            <SgCol Span="6">
                                <SgStatistic Title="Revenue" Prefix="$" Value="98,765" Bordered="true" />
                            </SgCol>
                            <SgCol Span="6">
                                <SgStatistic Title="Growth" Suffix="%" Value="12.5" Bordered="true" />
                            </SgCol>
                            <SgCol Span="6">
                                <SgStatistic Title="Conversion" Value="3.2%" Bordered="true" />
                            </SgCol>
                        </SgRow>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With Trends (Up / Down)
                        </SgTypography>
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="6">
                                <SgStatistic Title="Orders" Value="342" TrendValue="0.15" Bordered="true" />
                            </SgCol>
                            <SgCol Span="6">
                                <SgStatistic Title="Refunds" Value="12" TrendValue="-0.05" Bordered="true" />
                            </SgCol>
                        </SgRow>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Prefix / Suffix
                        </SgTypography>
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="6">
                                <SgStatistic Title="Revenue" NumericValue="98765" Prefix="$" Bordered="true" Color="var(--sg-color-success)" />
                            </SgCol>
                            <SgCol Span="6">
                                <SgStatistic Title="Latency" NumericValue="42" Suffix=" ms" Bordered="true" Color="var(--sg-primary)" />
                            </SgCol>
                        </SgRow>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="SgStatistic Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_statisticProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. SgEmpty                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgEmpty — Empty State
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Placeholder for empty lists, search results, and error states with optional action buttons.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgRow Space="SgSize.Md">
                    <SgCol Span="6">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Default Empty
                        </SgTypography>
                        <SgEmpty Text="No data to display" Bordered="true" />
                    </SgCol>
                    <SgCol Span="6">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Custom Description
                        </SgTypography>
                        <SgEmpty Text="No notifications" Description="You are all caught up! Check back later for updates." Bordered="true" />
                    </SgCol>
                    <SgCol Span="12">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With Action Button
                        </SgTypography>
                        <SgEmpty Text="No items found" Description="Try adjusting your search or filter criteria." ActionText="Add New Item" Bordered="true" />
                    </SgCol>
                </SgRow>
            </SgCard>

            <SgCard Title="SgEmpty Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_emptyProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. SgTimeline                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgTimeline — Timeline
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Chronological sequence of events with colored dots, titles, descriptions, and time labels.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Project Milestones" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgTimeline Items="_timelineItems" />
            </SgCard>

            <SgCard Title="SgTimeline Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_timelineProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 7. SgActivityFeed                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgActivityFeed — Activity Feed
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Real-time activity feed with user avatars, descriptions, badges, and time stamps.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Recent Activity" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgActivityFeed Items="_activityItems" />
            </SgCard>

            <SgCard Title="SgActivityFeed Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_activityFeedProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 8. SgImage                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgImage — Images
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Displays images with lazy loading, multiple <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ObjectFit</SgTypography> modes, error fallback, and custom placeholders. Uses inline SVG data URIs — no external dependencies.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            ObjectFit: Cover (default)
                        </SgTypography>
                        <SgSpace Wrap="true" Align="SgAlignItems.Center">
                            <SgImage Src="@_svgMountain" Width="100px" Height="80px" Alt="Mountain" Lazy="false" />
                            <SgImage Src="@_svgCity" Width="100px" Height="80px" Alt="City" Lazy="false" />
                            <SgImage Src="@_svgSunset" Width="100px" Height="80px" Alt="Sunset" Lazy="false" />
                            <SgImage Src="@_svgAbstract" Width="100px" Height="80px" Alt="Abstract" Lazy="false" />
                        </SgSpace>
                    </div>
                    <SgDivider />
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            ObjectFit: Contain
                        </SgTypography>
                        <SgSpace Wrap="true" Align="SgAlignItems.Center">
                            <SgImage Src="@_svgMountain" Width="100px" Height="80px" ObjectFit="contain" Alt="Mountain contain" Style="background:var(--sg-bg-muted);border-radius:var(--sg-radius-sm);" />
