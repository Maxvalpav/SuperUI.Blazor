@page "/data-display-demo"
@using SuperUI.Components

<PageTitle>Отображение данных - SUI</PageTitle>

<SgCard Title="Компоненты отображения данных"
        Subtitle="Компоненты для визуализации и представления информации.">

    <!-- SgBadge -->
    <div style="margin-top: 32px;">
        <h2>SgBadge - Значки и метки</h2>
        <p>Компонент для отображения статусов, счётчиков и категорий.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Варианты</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Default" Variant="default" />
                            <SgBadge Text="Success" Variant="success" />
                            <SgBadge Text="Danger" Variant="danger" />
                            <SgBadge Text="Warn" Variant="warn" />
                            <SgBadge Text="Muted" Variant="muted" />
                        </div>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Примеры статусов</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Text="Активен" Variant="success" />
                            <SgBadge Text="В разработке" Variant="warn" />
                            <SgBadge Text="Архив" Variant="muted" />
                            <SgBadge Text="Критично" Variant="danger" />
                        </div>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">С пользовательским содержимым</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                            <SgBadge Variant="success">✓ Активен</SgBadge>
                            <SgBadge Variant="danger">✗ Ошибка</SgBadge>
                            <SgBadge Variant="warn">⚠ Внимание</SgBadge>
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_badgeProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgChip -->
    <div style="margin-top: 32px;">
        <h2>SgChip - Чипы и теги</h2>
        <p>Интерактивные элементы для фильтров, тегов и выбора.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Закрываемые теги</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <SgChip Text="React" Closable="true" OnClose="@(() => {})" />
                            <SgChip Text="Vue" Closable="true" OnClose="@(() => {})" />
                            <SgChip Text="Angular" Closable="true" OnClose="@(() => {})" />
                            <SgChip Text="Blazor" Closable="true" OnClose="@(() => {})" />
                        </div>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Варианты</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <SgChip Text="Default" />
                            <SgChip Text="Primary" Variant="primary" />
                            <SgChip Text="Success" Variant="success" />
                            <SgChip Text="Danger" Variant="danger" />
                            <SgChip Text="Warn" Variant="warn" />
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_chipProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgAvatar -->
    <div style="margin-top: 32px;">
        <h2>SgAvatar - Аватары</h2>
        <p>Компонент для отображения изображений профилей и инициалов.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Размеры (sm / md / lg)</div>
                        <div style="display: flex; gap: 12px; align-items: center;">
                            <SgAvatar Initials="SM" Size="sm" Title="Small" />
                            <SgAvatar Initials="MD" Size="md" Title="Medium" />
                            <SgAvatar Initials="LG" Size="lg" Title="Large" />
                        </div>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Из заголовка (автоинициалы)</div>
                        <div style="display: flex; gap: 8px;">
                            <SgAvatar Title="Иван Петров" Color="#1890ff" />
                            <SgAvatar Title="Мария Сидорова" Color="#52c41a" />
                            <SgAvatar Title="Алексей Козлов" Color="#722ed1" />
                        </div>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">С цветом фона</div>
                        <div style="display: flex; gap: 8px;">
                            <SgAvatar Initials="АБ" Color="#f5222d" />
                            <SgAvatar Initials="ВГ" Color="#fa8c16" />
                            <SgAvatar Initials="ДЕ" Color="#13c2c2" />
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_avatarProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgProgress -->
    <div style="margin-top: 32px;">
        <h2>SgProgress - Индикаторы прогресса</h2>
        <p>Компонент для отображения прогресса выполнения операций.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Базовый прогресс</div>
                        <SgProgress Value="30" ShowLabel="true" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Полосатый</div>
                        <SgProgress Value="60" Striped="true" ShowLabel="true" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Анимированный</div>
                        <SgProgress Value="75" Striped="true" Animated="true" ShowLabel="true" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Неопределённый</div>
                        <SgProgress Indeterminate="true" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">100% завершено</div>
                        <SgProgress Value="100" ShowLabel="true" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_progressProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgStatistic -->
    <div style="margin-top: 32px;">
        <h2>SgStatistic - Статистика</h2>
        <p>Компонент для отображения числовых показателей и метрик.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 16px;">
                    <SgStatistic Title="Пользователи" Value="1 234" />
                    <SgStatistic Title="Доходы" Value="98 765 ₽" />
                    <SgStatistic Title="Рост" Value="+12.5%" />
                    <SgStatistic Title="Конверсия" Value="3.2%" />
                </div>
                <div style="margin-top: 16px; display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 16px;">
                    <SgStatistic Title="Заказы" Value="342" TrendValue="0.15" />
                    <SgStatistic Title="Возвраты" Value="12" TrendValue="-0.05" />
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_statisticProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgEmpty -->
    <div style="margin-top: 32px;">
        <h2>SgEmpty - Пустое состояние</h2>
        <p>Компонент для отображения пустого состояния списков и таблиц.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 24px;">
                    <SgEmpty Text="Нет данных для отображения" />
                    <SgEmpty Text="Список пуст. Добавьте первый элемент." />
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_emptyProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgSkeleton -->
    <div style="margin-top: 32px;">
        <h2>SgSkeleton - Скелет загрузки</h2>
        <p>Компонент для отображения заполнителей во время загрузки контента.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 24px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Текстовый скелет</div>
                        <SgSkeleton Active="true" Paragraph="true" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">С аватаром</div>
                        <SgSkeleton Active="true" Avatar="true" Paragraph="true" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Только заголовок</div>
                        <SgSkeleton Active="true" Paragraph="false" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_skeletonProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgTimeline -->
    <div style="margin-top: 32px;">
        <h2>SgTimeline - Временная шкала</h2>
        <p>Компонент для отображения последовательности событий.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <SgTimeline Items="_timelineItems" />
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_timelineProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgActivityFeed -->
    <div style="margin-top: 32px;">
        <h2>SgActivityFeed - Лента активности</h2>
        <p>Компонент для отображения ленты событий и действий пользователей.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <SgActivityFeed Items="_activityItems" />
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_activityFeedProperties" />
            </SgCard>
        </div>
    </div>

</SgCard>

