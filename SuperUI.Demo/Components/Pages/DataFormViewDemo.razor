@page "/data-form-view"

<PageTitle>Просмотр записи — SUI</PageTitle>

<div style="display:flex; flex-direction:column; gap:18px; max-width:800px;">
    <SgCard Title="Карточка сотрудника (Только чтение)">
        <div style="margin-bottom:16px;">
            <SgAlert Dense="true" Text="Режим просмотра: параметр ReadOnly='true' отключает редактирование и скрывает кнопки действий." />
        </div>
        
        <SgDataForm TModel="Employee"
                    Model="_employee"
                    Columns="2"
                    ReadOnly="true" />
    </SgCard>
    
    <div style="display:flex; gap:12px;">
        <a href="/data-form-edit">
            <SgButton Text="Перейти к редактированию" Variant="primary" />
        </a>
    </div>
</div>

@code {
    private Employee _employee = new()
    {
        Id = 2,
        FirstName = "Мария",
        LastName = "Сидорова",
        Email = "maria.s@example.com",
        Department = DepartmentType.Design,
        Salary = 120000,
        HireDate = new DateTime(2024, 1, 10),
        IsActive = true,
        Notes = "Старший дизайнер интерфейсов."
    };
}

