                                     ColumnNames="@(new[] { "Имя", "Фамилия", "Отдел" })"
                                     Label="Множественный выбор"
                                     Placeholder="Выберите сотрудников..." />

                    <SgComboBoxEx TItem="Employee" TKey="int?"
                                   Items="@_employees"
                                   @bind-Value="@_selectedEmployeeId"
                                   KeySelector="e => (int?)e.Id"
                                   LabelSelector="e => e.FirstName"
                                   ColumnsSelector="@(e => (IEnumerable<string>)new[] { e.FirstName, e.LastName, e.Department.ToString() })"
                                   ColumnNames="@(new[] { "Имя", "Фамилия", "Отдел" })"
                                   Label="Одиночный выбор (Ex)"
                                   Placeholder="Выберите одного сотрудника..."
                                   AllowClear="true" />
                </div>
            </SgCard>
            
            <SgCard Title="Расположение меток (LabelPosition)">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                    <div style="display: flex; flex-direction: column; gap: 16px;">
