@page "/inputs-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models

<PageTitle>Поля ввода и формы - SUI</PageTitle>

<SgCard Title="Компоненты ввода данных"
        Subtitle="Полный набор компонентов для ввода и редактирования данных с валидацией и различными типами.">

    <!-- SgButton -->
    <div style="margin-top: 32px;">
        <h2>SgButton - Кнопка</h2>
        <p>Универсальный компонент кнопки с поддержкой различных вариантов, размеров и состояний.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Варианты</div>
                        <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
                            <SgButton Text="Default" />
                            <SgButton Text="Primary"  Variant="SgButtonVariant.Primary" />
                            <SgButton Text="Success"  Variant="SgButtonVariant.Success" />
                            <SgButton Text="Danger"   Variant="SgButtonVariant.Danger" />
                            <SgButton Text="Ghost"    Variant="SgButtonVariant.Ghost" />
                            <SgButton Text="Outlined" Variant="SgButtonVariant.Outlined" />
                            <SgButton Text="Dashed"   Variant="SgButtonVariant.Dashed" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Размеры</div>
                        <div style="display: flex; gap: 8px; align-items: center;">
                            <SgButton Text="Small"  Size="SgSize.Sm" Variant="SgButtonVariant.Primary" />
                            <SgButton Text="Medium" Size="SgSize.Md" Variant="SgButtonVariant.Primary" />
                            <SgButton Text="Large"  Size="SgSize.Lg" Variant="SgButtonVariant.Primary" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Состояния</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <SgButton Text="Disabled" Disabled="true" />
                            <SgButton Text="Loading" Loading="true" />
                            <SgButton Text="Block" Block="true" Variant="SgButtonVariant.Primary" />
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_buttonProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgIconButton -->
    <div style="margin-top: 32px;">
        <h2>SgIconButton — Круглая кнопка с иконкой</h2>
        <p>Компактная кнопка только с иконкой. Поддерживает круглую и квадратную форму, бейджи, toggle-режим и все варианты цветов.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Варианты и размеры">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Варианты (круглые)</div>
                        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                            <SgIconButton Icon="@SgIcons.Settings" Title="Default" />
                            <SgIconButton Icon="@SgIcons.Plus"     Title="Primary"  Variant="SgButtonVariant.Primary" />
                            <SgIconButton Icon="@SgIcons.Check"    Title="Success"  Variant="SgButtonVariant.Success" />
                            <SgIconButton Icon="@SgIcons.X"        Title="Danger"   Variant="SgButtonVariant.Danger" />
                            <SgIconButton Icon="@SgIcons.Search"   Title="Ghost"    Variant="SgButtonVariant.Ghost" />
                            <SgIconButton Icon="@SgIcons.Edit"     Title="Outlined" Variant="SgButtonVariant.Outlined" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Квадратные (Round=false)</div>
                        <div style="display: flex; gap: 8px; align-items: center;">
                            <SgIconButton Icon="@SgIcons.Settings" Title="Default"  Round="false" />
                            <SgIconButton Icon="@SgIcons.Plus"     Title="Primary"  Round="false" Variant="SgButtonVariant.Primary" />
                            <SgIconButton Icon="@SgIcons.Edit"     Title="Outlined" Round="false" Variant="SgButtonVariant.Outlined" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Размеры</div>
                        <div style="display: flex; gap: 8px; align-items: center;">
                            <SgIconButton Icon="@SgIcons.Settings" Title="Sm" Size="SgSize.Sm" Variant="SgButtonVariant.Primary" />
                            <SgIconButton Icon="@SgIcons.Settings" Title="Md" Size="SgSize.Md" Variant="SgButtonVariant.Primary" />
                            <SgIconButton Icon="@SgIcons.Settings" Title="Lg" Size="SgSize.Lg" Variant="SgButtonVariant.Primary" />
                            <SgIconButton Icon="@SgIcons.Settings" Title="Xl" Size="SgSize.Xl" Variant="SgButtonVariant.Primary" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Бейджи и индикаторы</div>
                        <div style="display: flex; gap: 12px; align-items: center;">
                            <SgIconButton Icon="@SgIcons.Settings" Title="3 уведомления" BadgeCount="3" />
                            <SgIconButton Icon="@SgIcons.Settings" Title="99+ уведомлений" BadgeCount="120" />
                            <SgIconButton Icon="@SgIcons.Settings" Title="Новое" BadgeDot="true" />
                            <SgIconButton Icon="@SgIcons.Settings" Title="Disabled" Disabled="true" />
                            <SgIconButton Icon="@SgIcons.Settings" Title="Loading" Loading="true" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Toggle и группа</div>
                        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
                            <SgIconButton Icon="@SgIcons.Check" Title="Toggle" IsToggle="true"
                                          @bind-Pressed="_togglePressed"
                                          Variant="@(_togglePressed ? SgButtonVariant.Primary : SgButtonVariant.Default)" />
                            <span style="font-size:11px;color:var(--sui-muted);">@(_togglePressed ? "Нажата" : "Не нажата")</span>
                            <div class="sgc-icon-btn-group">
                                <SgIconButton Icon="@SgIcons.ArrowUp"   Title="Вверх"   Size="SgSize.Sm" />
                                <SgIconButton Icon="@SgIcons.ArrowDown" Title="Вниз"    Size="SgSize.Sm" />
                                <SgIconButton Icon="@SgIcons.Refresh"   Title="Обновить" Size="SgSize.Sm" />
                            </div>
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства SgIconButton">
                <PropertyTable Items="_iconBtnProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgFab -->
    <div style="margin-top: 32px;">
        <h2>SgFab — Floating Action Button</h2>
        <p>Плавающая кнопка действия. Поддерживает расширенный режим с текстом, разные размеры и варианты.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Варианты и режимы">
                <div style="display: flex; flex-direction: column; gap: 20px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 12px;">Варианты</div>
                        <div style="display: flex; gap: 16px; align-items: flex-end; flex-wrap: wrap;">
                            <div style="display:flex;flex-direction:column;align-items:center;gap:6px;">
                                <SgFab Icon="@SgIcons.Plus" Title="Primary" />
                                <span style="font-size:10px;color:var(--sui-muted);">Primary</span>
                            </div>
                            <div style="display:flex;flex-direction:column;align-items:center;gap:6px;">
                                <SgFab Icon="@SgIcons.Edit" Title="Ghost" Variant="SgButtonVariant.Ghost" />
                                <span style="font-size:10px;color:var(--sui-muted);">Ghost</span>
                            </div>
                            <div style="display:flex;flex-direction:column;align-items:center;gap:6px;">
                                <SgFab Icon="@SgIcons.Check" Title="Success" Variant="SgButtonVariant.Success" />
                                <span style="font-size:10px;color:var(--sui-muted);">Success</span>
                            </div>
                            <div style="display:flex;flex-direction:column;align-items:center;gap:6px;">
                                <SgFab Icon="@SgIcons.X" Title="Danger" Variant="SgButtonVariant.Danger" />
                                <span style="font-size:10px;color:var(--sui-muted);">Danger</span>
                            </div>
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 12px;">Размеры</div>
                        <div style="display: flex; gap: 16px; align-items: flex-end; flex-wrap: wrap;">
                            <div style="display:flex;flex-direction:column;align-items:center;gap:6px;">
                                <SgFab Icon="@SgIcons.Plus" Title="Small" Size="SgSize.Sm" />
                                <span style="font-size:10px;color:var(--sui-muted);">Sm (40px)</span>
                            </div>
                            <div style="display:flex;flex-direction:column;align-items:center;gap:6px;">
                                <SgFab Icon="@SgIcons.Plus" Title="Medium" />
                                <span style="font-size:10px;color:var(--sui-muted);">Md (56px)</span>
                            </div>
                            <div style="display:flex;flex-direction:column;align-items:center;gap:6px;">
                                <SgFab Icon="@SgIcons.Plus" Title="Large" Size="SgSize.Lg" />
                                <span style="font-size:10px;color:var(--sui-muted);">Lg (72px)</span>
                            </div>
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 12px;">Extended (с текстом)</div>
                        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
                            <SgFab Icon="@SgIcons.Plus"     Label="Добавить"   Extended="true" />
                            <SgFab Icon="@SgIcons.Edit"     Label="Изменить"   Extended="true" Variant="SgButtonVariant.Ghost" />
                            <SgFab Icon="@SgIcons.Download" Label="Скачать"    Extended="true" Size="SgSize.Sm" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 12px;">Состояния</div>
                        <div style="display: flex; gap: 12px; align-items: center;">
                            <SgFab Icon="@SgIcons.Plus" Title="Disabled" Disabled="true" />
                            <SgFab Icon="@SgIcons.Plus" Title="Loading"  Loading="true" />
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства SgFab">
                <PropertyTable Items="_fabProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgTextBox -->
    <div style="margin-top: 32px;">
        <h2>SgTextBox - Текстовое поле</h2>
        <p>Компонент для ввода текста с поддержкой валидации и различных типов.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgTextBox TValue="string" @bind-Value="@_textValue" Label="Обычное поле" Placeholder="Введите текст..." />
                    <SgTextBox TValue="string" @bind-Value="@_errorValue" Label="Поле с ошибкой" ErrorText="Это поле обязательно" />
                    <SgTextBox TValue="string" @bind-Value="@_multilineValue" Label="Многострочное" Multiline="true" Rows="3" Placeholder="Введите текст..." />
                    <SgTextBox TValue="string" @bind-Value="@_disabledValue" Label="Отключенное" Disabled="true" />
                    <SgTextBox TValue="string" @bind-Value="@_passwordValue" Label="Пароль" Type="password" Placeholder="Введите пароль..." />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_textBoxProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgCheckBox -->
    <div style="margin-top: 32px;">
        <h2>SgCheckBox - Флажок</h2>
        <p>Компонент для выбора одного или нескольких вариантов из списка.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgCheckBox @bind-Value="@_check1" Label="Согласен с условиями" />
                    <SgCheckBox @bind-Value="@_check2" Label="Отключенный флажок" Disabled="true" />
                    <SgCheckBox @bind-Value="@_check3" Label="Выбранный флажок" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_checkBoxProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgSwitch -->
    <div style="margin-top: 32px;">
        <h2>SgSwitch - Переключатель</h2>
        <p>Компонент для включения/отключения функций с визуальной обратной связью.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span>Включить уведомления</span>
                        <SgSwitch @bind-Value="@_switch1" />
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span>Тёмная тема</span>
                        <SgSwitch @bind-Value="@_switch2" />
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span>Отключённый переключатель</span>
                        <SgSwitch @bind-Value="@_switch3" Disabled="true" />
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_switchProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgSelect -->
    <div style="margin-top: 32px;">
        <h2>SgSelect - Выпадающий список</h2>
        <p>Компонент для выбора одного значения из списка.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgSelect TValue="string" @bind-Value="@_selectValue"  Items="@_selectItems" Label="Выберите опцию"    Placeholder="Выберите..." AllowClear="true" />
                    <SgSelect TValue="string" @bind-Value="@_selectValue2" Items="@_selectItems" Label="Обязательное поле" Placeholder="Выберите..." Required="true" />
                    <SgSelect TValue="string" @bind-Value="@_selectValue3" Items="@_selectItems" Label="Отключённый"       Disabled="true" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_selectProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgNumberEdit -->
    <div style="margin-top: 32px;">
        <h2>SgNumberEdit - Числовое поле</h2>
        <p>Компонент для ввода чисел с поддержкой шага, минимума и максимума.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgNumberEdit TValue="int" @bind-Value="@_intValue" Label="Целое число" Placeholder="0" />
                    <SgNumberEdit TValue="double" @bind-Value="@_doubleValue" Label="Дробное число" Placeholder="0.00" Step="0.01" />
                    <SgNumberEdit TValue="int" @bind-Value="@_clampedValue" Label="С ограничениями (0–100)" Min="0" Max="100" />
                    <SgNumberEdit TValue="int" @bind-Value="@_suffixValue" Label="С суффиксом" Suffix="кг" ShowButtons="true" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_numberEditProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgNumberInput -->
    <div style="margin-top: 32px;">
        <h2>SgNumberInput — Числовой ввод с кнопками +/−</h2>
        <p>Универсальный компонент числового ввода с встроенными кнопками инкремента/декремента, поддержкой шага, ограничений и суффикса единиц измерения.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgNumberInput TValue="int?" @bind-Value="@_numInt"
                                   Label="Целое число"
                                   Placeholder="0"
                                   Step="1" />
                    <SgNumberInput TValue="double?" @bind-Value="@_numDouble"
                                   Label="Дробное число (шаг 0.1)"
                                   Placeholder="0.00"
                                   Step="0.1"
                                   Decimals="2" />
                    <SgNumberInput TValue="int?" @bind-Value="@_numClamped"
                                   Label="С ограничениями (0–100)"
                                   Min="0" Max="100"
                                   Step="5" />
                    <SgNumberInput TValue="double?" @bind-Value="@_numSuffix"
                                   Label="С суффиксом единиц"
                                   Suffix="кг"
                                   Step="0.5"
                                   Decimals="1" />
                    <SgNumberInput TValue="int?" @bind-Value="@_numDisabled"
                                   Label="Отключённый"
                                   Disabled="true" />
                    <SgNumberInput TValue="int?" @bind-Value="@_numError"
                                   Label="С ошибкой валидации"
                                   ErrorText="Значение вне допустимого диапазона" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_numberInputProperties" />
            </SgCard>
        </div>
        <div style="margin-top: 16px;">
            <SgAlert Variant="SgAlertVariant.Info" Title="Отличие от SgNumberEdit">
                <ChildContent>
                    <b>SgNumberInput</b> — самостоятельный компонент с кнопками +/− встроенными в поле ввода.
                    Поддерживает любой числовой тип (<code>int?</code>, <code>double?</code>, <code>decimal?</code> и т.д.) через generic параметр <code>TValue</code>.
                    Кнопки автоматически блокируются при достижении Min/Max.
                </ChildContent>
            </SgAlert>
        </div>
    </div>

    <!-- SgCoordinateInput -->
    <div style="margin-top: 32px;">
        <h2>SgCoordinateInput — Ввод координат</h2>
        <p>Специализированный компонент для ввода географических координат (широта/долгота) с кнопками +/−, выбором шага и форматом DMS.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 20px;">
                    <SgCoordinateInput Label="Координаты (Москва)"
                                       @bind-Latitude="_coordLat"
                                       @bind-Longitude="_coordLon"
                                       OnCoordinateChanged="OnCoordChanged" />
                    @if (_coordLat.HasValue && _coordLon.HasValue)
                    {
                        <div style="font-size: 12px; color: var(--sui-text-secondary); padding: 8px 12px; background: var(--sui-bg-secondary); border-radius: 6px;">
                            📍 @_coordLat.Value.ToString("F6") , @_coordLon.Value.ToString("F6")
                        </div>
                    }
                    <SgDivider />
                    <SgCoordinateInput Label="С DMS форматом"
                                       @bind-Latitude="_coordLat2"
                                       @bind-Longitude="_coordLon2"
                                       ShowDms="true" />
                    <SgCoordinateInput Label="Отключённый"
                                       Latitude="55.7558"
                                       Longitude="37.6173"
                                       Disabled="true" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_coordInputProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgDatePicker -->
    <div style="margin-top: 32px;">
        <h2>SgDatePicker - Выбор даты</h2>
        <p>Компонент для выбора одной даты с календарём.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgDatePicker @bind-Value="@_date1" Label="Выберите дату" Placeholder="ДД.ММ.ГГГГ" />
                    <SgDatePicker @bind-Value="@_date2" Label="С предустановкой" />
                    <SgDatePicker @bind-Value="@_date3" Label="С ограничениями" Min="@_minDate" Max="@_maxDate" />
                    <SgDatePicker @bind-Value="@_date4" Label="Отключённый" Disabled="true" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_datePickerProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgTimePicker -->
    <div style="margin-top: 32px;">
        <h2>SgTimePicker - Выбор времени</h2>
        <p>Компонент для выбора времени (часы, минуты, секунды).</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgTimePicker @bind-Value="@_time1" Label="Простой выбор" Placeholder="--:--" />
                    <SgTimePicker @bind-Value="@_time2" Label="С секундами" ShowSeconds="true" />
                    <SgTimePicker @bind-Value="@_time3" Label="Метка слева" LabelPosition="SgLabelPosition.Left" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_timePickerProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgDateRangePicker -->
    <div style="margin-top: 32px;">
        <h2>SgDateRangePicker - Выбор диапазона дат</h2>
        <p>Компонент для выбора диапазона дат (начальная и конечная дата).</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgDateRangePicker @bind-StartValue="@_rangeStart1" @bind-EndValue="@_rangeEnd1"
                                       Label="Выберите период"
                                       StartPlaceholder="Начало"
                                       EndPlaceholder="Конец" />
                    <SgDateRangePicker @bind-StartValue="@_rangeStart2" @bind-EndValue="@_rangeEnd2"
                                       Label="С предустановкой" />
                    <SgDateRangePicker @bind-StartValue="@_rangeStart3" @bind-EndValue="@_rangeEnd3"
                                       Label="Отключённый"
                                       Disabled="true" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_dateRangePickerProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgSlider -->
    <div style="margin-top: 32px;">
        <h2>SgSlider - Ползунок</h2>
        <p>Компонент для выбора значения в диапазоне с визуальным ползунком.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 20px;">
                    <SgSlider TValue="double" @bind-Value="@_slider1" Label="Простой ползунок" Min="0" Max="100" ShowValue="true" />
                    <SgSlider TValue="double" @bind-Value="@_slider2" Label="С шагом 10" Min="0" Max="100" Step="10" ShowValue="true" />
                    <SgSlider TValue="double" @bind-Value="@_slider3" Label="С суффиксом %" Min="0" Max="100" Suffix="%" ShowValue="true" />
                    <SgSlider TValue="double" @bind-Value="@_slider4" Label="Отключённый" Min="0" Max="100" Disabled="true" ShowValue="true" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_sliderProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgColorPicker -->
    <div style="margin-top: 32px;">
        <h2>SgColorPicker - Выбор цвета</h2>
        <p>Компонент для выбора цвета в формате HEX.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgColorPicker @bind-Value="@_color1" Label="Основной цвет" />
                    <SgColorPicker @bind-Value="@_color2" Label="Вторичный цвет" />
                    <div style="display: flex; gap: 12px; margin-top: 8px;">
                        <div style="width: 40px; height: 40px; background: @_color1; border-radius: 4px; border: 1px solid var(--sui-border);"></div>
                        <div style="width: 40px; height: 40px; background: @_color2; border-radius: 4px; border: 1px solid var(--sui-border);"></div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_colorPickerProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgAutoComplete -->
    <div style="margin-top: 32px;">
        <h2>SgAutoComplete - Автодополнение</h2>
        <p>Компонент для ввода текста с автоматическим предложением вариантов.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgAutoComplete TItem="string" @bind-Value="@_acValue1" Items="@_languages" Label="Язык программирования" Placeholder="Начните вводить..." />
                    <SgAutoComplete TItem="string" @bind-Value="@_acValue2" Items="@_countries" Label="Страна"                Placeholder="Начните вводить..." MinCharacters="2" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_autoCompleteProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgMultiSelect -->
    <div style="margin-top: 32px;">
        <h2>SgMultiSelect - Множественный выбор</h2>
        <p>Компонент для выбора нескольких значений из списка.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgMultiSelect TItem="string" TKey="string" 
                                   @bind-Values="@_multiValues" 
                                   Items="@_selectItems" 
                                   KeySelector="s => s"
                                   Label="Выберите несколько" 
                                   Placeholder="Выберите..." />
                    
                    <SgMultiSelect TItem="string" TKey="string" 
                                   @bind-Values="@_multiValues2" 
                                   Items="@_selectItems" 
                                   KeySelector="s => s"
                                   Label="Отключённый" 
                                   Disabled="true" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_multiSelectProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Enum support -->
    <div style="margin-top: 32px;">
        <h2>Enum-поддержка в Select / ComboBox / MultiSelect</h2>
        <p>
            Параметр <code>EnumType</code> автоматически заполняет список из любого enum.
            Атрибуты <code>[Display(Name=...)]</code> и <code>[Description(...)]</code> используются как метки.
            <code>EnumKeyMode</code> определяет, что хранится как ключ — имя члена (<code>Name</code>) или целочисленное значение (<code>IntValue</code>).
        </p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">

            <SgCard Title="SgSelect — из enum">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgSelect TValue="string"
                              @bind-Value="_enumSelectName"
                              EnumType="typeof(OrderStatus)"
                              Label="Статус заказа (ключ = Name)"
                              Placeholder="Выберите статус..."
                              AllowClear="true" />
                    <div style="font-size: 11px; color: var(--sui-muted);">Выбрано: @(_enumSelectName ?? "—")</div>

                    <SgSelect TValue="string"
                              @bind-Value="_enumSelectInt"
                              EnumType="typeof(OrderStatus)"
                              EnumKeyMode="SgEnumKeyMode.IntValue"
                              Label="Статус заказа (ключ = IntValue)"
                              Placeholder="Выберите статус..."
                              AllowClear="true" />
                    <div style="font-size: 11px; color: var(--sui-muted);">Выбрано: @(_enumSelectInt ?? "—")</div>

                    <SgSelect TValue="OrderStatus"
                              @bind-Value="_enumSelectTyped"
                              EnumType="typeof(OrderStatus)"
                              Label="Привязка к типу enum (OrderStatus)"
                              Placeholder="Выберите статус..."
                              AllowClear="true" />
                    <div style="font-size: 11px; color: var(--sui-muted);">Выбрано: @_enumSelectTyped</div>
                </div>
            </SgCard>

            <SgCard Title="SgComboBox — из enum (с поиском)">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgComboBox TValue="string"
                                @bind-Value="_enumComboName"
                                EnumType="typeof(Priority)"
                                Label="Приоритет (ключ = Name)"
                                Placeholder="Выберите приоритет..."
                                Editable="true" />
                    <div style="font-size: 11px; color: var(--sui-muted);">Выбрано: @(_enumComboName ?? "—")</div>

                    <SgComboBox TValue="string"
                                @bind-Value="_enumComboInt"
                                EnumType="typeof(Priority)"
                                EnumKeyMode="SgEnumKeyMode.IntValue"
                                Label="Приоритет (ключ = IntValue)"
                                Placeholder="Выберите приоритет..."
                                Editable="true" />
                    <div style="font-size: 11px; color: var(--sui-muted);">Выбрано: @(_enumComboInt ?? "—")</div>

                    <SgComboBox TValue="Priority"
                                @bind-Value="_enumComboTyped"
                                EnumType="typeof(Priority)"
                                Label="Привязка к типу enum (Priority)"
                                Placeholder="Выберите приоритет..."
                                AllowClear="true" />
                    <div style="font-size: 11px; color: var(--sui-muted);">Выбрано: @_enumComboTyped</div>
                </div>
            </SgCard>

            <SgCard Title="SgMultiSelect — из enum">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgMultiSelect TItem="string" TKey="string"
                                   @bind-Values="_enumMultiName"
                                   EnumType="typeof(Permission)"
                                   Label="Права доступа (ключ = Name)"
                                   Placeholder="Выберите права..." />
                    <div style="font-size: 11px; color: var(--sui-muted);">
                        Выбрано: @(string.Join(", ", _enumMultiName.Any() ? _enumMultiName : new[] { "—" }))
                    </div>

                    <SgMultiSelect TItem="string" TKey="string"
                                   @bind-Values="_enumMultiInt"
                                   EnumType="typeof(Permission)"
                                   EnumKeyMode="SgEnumKeyMode.IntValue"
                                   Label="Права доступа (ключ = IntValue)"
                                   Placeholder="Выберите права..." />
                    <div style="font-size: 11px; color: var(--sui-muted);">
                        Выбрано: @(string.Join(", ", _enumMultiInt.Any() ? _enumMultiInt : new[] { "—" }))
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Параметры EnumType">
                <PropertyTable Items="_enumProperties" />
            </SgCard>

        </div>

        <div style="margin-top: 16px;">
        </div>
        <div style="margin-top: 12px;">
        </div>
    </div>

