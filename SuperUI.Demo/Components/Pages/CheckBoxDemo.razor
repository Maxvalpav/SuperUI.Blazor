@page "/demo/checkbox"
@using SuperUI.Demo.Components

<div class="demo-page">
    <div class="demo-hero">
        <section class="demo-hero-main">
            <div class="demo-header">
                <div class="demo-kicker">Input Components</div>
                <h1 class="demo-title">SgCheckBox</h1>
                <p class="demo-subtitle">
                    Standard checkbox component for boolean input, multi-selection lists and agreement forms.
                    Supports indeterminate state, validation and custom labeling.
                </p>
            </div>
        </section>

        <aside class="demo-hero-side">
            <div class="demo-side-title">Highlights</div>
            <div class="demo-pill-list">
                <span class="demo-pill demo-pill-accent">Reactive</span>
                <span class="demo-pill">Indeterminate</span>
                <span class="demo-pill">Validation</span>
                <span class="demo-pill">SSR Safe</span>
            </div>

            <div class="demo-meta-grid">
                <div class="demo-meta-card">
                    <span class="demo-meta-label">States</span>
                    <span class="demo-meta-value">Checked, unchecked, mixed</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Validation</span>
                    <span class="demo-meta-value">Required, custom errors, EditContext</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Accessibility</span>
                    <span class="demo-meta-value">`aria-checked`, `aria-invalid`, `aria-describedby`</span>
                </div>
            </div>
        </aside>
    </div>

    <SgDemoSection Eyebrow="Usage" Title="Examples" Description="Checkbox patterns for forms, settings and complex selection logic.">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Basic Usage</h3>
                    <p class="demo-showcase-desc">Simple boolean toggle with label.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <div class="demo-stack">
                            <SgCheckBox @bind-Value="_basicValue" Label="Subscribe to newsletter" />
                            <div class="demo-note">Current value: @_basicValue</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">States</h3>
                    <p class="demo-showcase-desc">Disabled and Indeterminate (mixed) states.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <div class="demo-stack">
                            <SgCheckBox Value="true" Disabled="true" Label="Disabled Checked" />
                            <SgCheckBox Value="false" Disabled="true" Label="Disabled Unchecked" />
                            <SgCheckBox @bind-Indeterminate="_isIndeterminate" Label="Indeterminate State" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Validation</h3>
                    <p class="demo-showcase-desc">Integrated validation feedback.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <div class="demo-stack">
                            <SgCheckBox @bind-Value="_agreed" Label="I agree to the terms and conditions" Required="true" ErrorText="@(_agreed ? null : "You must agree to proceed")" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Custom Content</h3>
                    <p class="demo-showcase-desc">Use ChildContent for complex labels.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgCheckBox @bind-Value="_customValue">
                            <div style="display: flex; flex-direction: column; gap: 4px;">
                                <span style="font-weight: 600;">Enable Notifications</span>
                                <span style="font-size: 0.85em; opacity: 0.7;">Receive real-time alerts about account activity.</span>
                            </div>
                        </SgCheckBox>
                    </div>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoParams Title="CheckBox Parameters" Description="Parameters for customizing the appearance and behavior of the SgCheckBox component.">
        <SgDemoParam Name="Value" Type="bool" Description="The checked state of the checkbox." DefaultValue="false" />
        <SgDemoParam Name="Label" Type="string" Description="Text to display next to the checkbox." DefaultValue="null" />
        <SgDemoParam Name="Hint" Type="string" Description="Help text displayed below the checkbox." DefaultValue="null" />
        <SgDemoParam Name="ErrorText" Type="string" Description="Error message to display." DefaultValue="null" />
        <SgDemoParam Name="Indeterminate" Type="bool" Description="Whether the checkbox is in an indeterminate state." DefaultValue="false" />
        <SgDemoParam Name="Disabled" Type="bool" Description="Whether the checkbox is disabled." DefaultValue="false" />
        <SgDemoParam Name="Block" Type="bool" Description="Whether the checkbox field takes full width." DefaultValue="false" />
        <SgDemoParam Name="Required" Type="bool" Description="Whether the field is required." DefaultValue="false" />
        <SgDemoParam Name="ChildContent" Type="RenderFragment" Description="Custom content for the label area." DefaultValue="null" />
        <SgDemoParam Name="ValueChanged" Type="EventCallback<bool>" Description="Callback when the value changes." DefaultValue="null" />
        <SgDemoParam Name="IndeterminateChanged" Type="EventCallback<bool>" Description="Callback when indeterminate state changes." DefaultValue="null" />
    </SgDemoParams>
</div>

@code {
    private bool _basicValue = true;
    private bool _isIndeterminate = true;
    private bool _agreed;
    private bool _customValue;
}
