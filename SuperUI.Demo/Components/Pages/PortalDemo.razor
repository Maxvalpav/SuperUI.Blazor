@page "/portal-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Demo.Models
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgPortal — Teleport — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Portal"
                        Subtitle="SgPortal — teleports content to document.body to escape CSS stacking contexts, overflow clipping, and transform restrictions."
                        Icon="@SgHeroicons.Outline.ArrowUpRight" />
    </HeaderContent>
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Basic Usage                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgPortal — Basic Usage
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sui-text-muted)">
                Teleports content to <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">document.body</SgTypography>, escaping <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">overflow: hidden</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">transform</SgTypography>, and <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">z-index</SgTypography> stacking contexts.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Interactive Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <!-- Banner -->
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sui-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Notification Banner
                        </SgTypography>
                        <SgSpace>
                            <SgButton Text="@(_showBanner ? "Hide Banner" : "Show Banner")"
                                      Variant="SgButtonVariant.Primary"
                                      OnClick="ToggleBanner" />
                        </SgSpace>
                        @if (_showBanner)
                        {
                            <SgPortal Visible="true">
                                <div class="portal-banner">
                                    <SgHeroicon Name="@SgHeroicons.Names.Megaphone" Variant="Solid" Size="18px" />
                                    <span style="flex:1;">Teleported to <code style="background:rgba(255,255,255,0.15);padding:1px 6px;border-radius:4px;">document.body</code> via SgPortal!</span>
                                    <button type="button" class="portal-close-btn" @onclick="() => _showBanner = false">
                                        <SgHeroicon Name="@SgHeroicons.Names.XMark" Size="16px" />
                                    </button>
                                </div>
                            </SgPortal>
                        }
                    </div>
                    <!-- Toast -->
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sui-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Toast Notification
                        </SgTypography>
                        <SgButton Text="@(_showToast ? "Hide Toast" : "Show Toast")"
                                  Variant="SgButtonVariant.Outlined"
                                  OnClick="() => _showToast = !_showToast" />
                        @if (_showToast)
                        {
                            <SgPortal Visible="true">
                                <div class="portal-toast">
                                    <div style="display:flex;align-items:flex-start;gap:10px;">
                                        <div class="portal-icon-circle" style="background:var(--sg-color-success);">
                                            <SgHeroicon Name="@SgHeroicons.Names.Check" Variant="Solid" Size="16px" />
                                        </div>
                                        <div style="flex:1;min-width:0;">
                                            <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm">Operation Successful</SgTypography>
                                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sui-text-muted)" Style="margin-top:2px;">
                                                Rendered outside any parent container.
                                            </SgTypography>
                                        </div>
                                        <button type="button" class="portal-close-btn" style="color:rgba(255,255,255,0.6);" @onclick="() => _showToast = false">
                                            <SgHeroicon Name="@SgHeroicons.Names.XMark" Size="14px" />
                                        </button>
                                    </div>
                                </div>
                            </SgPortal>
                        }
                    </div>
                    <!-- Simple Modal -->
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sui-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Modal Dialog
                        </SgTypography>
                        <SgButton Text="@(_showModal ? "Close Modal" : "Open Modal")"
                                  Variant="SgButtonVariant.Default"
                                  OnClick="() => _showModal = !_showModal" />
                        @if (_showModal)
                        {
                            <SgPortal PreventScroll="true" AutoFocus="true" Visible="true">
                                <div class="portal-backdrop" @onclick="() => _showModal = false"></div>
                                <div class="portal-modal">
                                    <SgStack Vertical Space="SgSize.Md">
                                        <div style="display:flex;align-items:center;justify-content:space-between;">
                                            <SgTypography Variant="SgTypographyVariant.Heading6" Weight="SgTypographyWeight.Bold">Dialog Title</SgTypography>
                                            <button type="button" class="portal-close-btn" @onclick="() => _showModal = false">
                                                <SgHeroicon Name="@SgHeroicons.Names.XMark" Size="16px" />
                                            </button>
                                        </div>
                                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sui-text-muted)">
                                            Scroll is locked — try scrolling the page. Focus is trapped inside this dialog. Click backdrop or press Escape to close.
                                        </SgTypography>
                                        <SgSpace Justify="SgJustifyContent.End">
                                            <SgButton Text="Cancel" Variant="SgButtonVariant.Outlined" Size="SgSize.Sm" OnClick="() => _showModal = false" />
                                            <SgButton Text="Confirm" Variant="SgButtonVariant.Primary" Size="SgSize.Sm" OnClick="() => _showModal = false" />
                                        </SgSpace>
                                    </SgStack>
                                </div>
                            </SgPortal>
                        }
                    </div>
                </SgStack>
            </SgCard>
            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_portalProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Overflow + Transform Escape                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Escape Overflow & Transform
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sui-text-muted)">
                Without <code>SgPortal</code>, content gets clipped by <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">overflow: hidden</SgTypography> or distorted by <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">transform</SgTypography>. SgPortal teleports to body to avoid this.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Overflow: Hidden Container" Shadow="SgShadow.Sm" Size="SgSize.Sm"
                        Style="overflow:hidden;max-height:220px;position:relative;">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sui-text-muted)">
                            This card has <code>overflow:hidden</code>. Without portal, content is clipped.
                        </SgTypography>
                        <SgSpace>
                            <SgButton Text="@(_showOverflow ? "Hide" : "Show clipped")" Variant="SgButtonVariant.Danger" Size="SgSize.Sm"
                                      OnClick="() => _showOverflow = !_showOverflow" />
                            <SgButton Text="@(_showOverflowPortal ? "Hide portal" : "Show portal (escapes)")" Variant="SgButtonVariant.Primary" Size="SgSize.Sm"
                                      OnClick="() => _showOverflowPortal = !_showOverflowPortal" />
                        </SgSpace>
                        @if (_showOverflow)
                        {
                            <div style="padding:12px;background:var(--sg-color-danger);color:var(--sg-color-danger-fg);border-radius:8px;text-align:center;font-weight:600;font-size:13px;">
                                CLIPPED by overflow:hidden!
                            </div>
                        }
                        @if (_showOverflowPortal)
                        {
                            <SgPortal Visible="true">
                                <div class="portal-escape-demo" style="background:var(--sg-color-primary);color:var(--sg-color-primary-fg);">
                                    <SgHeroicon Name="@SgHeroicons.Names.ArrowUpRight" Size="20px" />
                                    <span>I escaped <code>overflow:hidden</code> via SgPortal!</span>
                                </div>
                            </SgPortal>
                        }
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Transform Container" Shadow="SgShadow.Sm" Size="SgSize.Sm"
                        Style="transform:scale(0.85);transform-origin:top left;min-height:220px;">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sui-text-muted)">
                            This card has <code>transform:scale(0.85)</code>. Content rendered here is distorted.
                        </SgTypography>
                        <SgSpace>
                            <SgButton Text="@(_showTransform ? "Hide" : "Show distorted")" Variant="SgButtonVariant.Danger" Size="SgSize.Sm"
                                      OnClick="() => _showTransform = !_showTransform" />
                            <SgButton Text="@(_showTransformPortal ? "Hide portal" : "Show portal (escapes)")" Variant="SgButtonVariant.Primary" Size="SgSize.Sm"
                                      OnClick="() => _showTransformPortal = !_showTransformPortal" />
                        </SgSpace>
                        @if (_showTransform)
                        {
                            <div style="padding:12px;background:var(--sg-color-danger);color:var(--sg-color-danger-fg);border-radius:8px;text-align:center;font-weight:600;font-size:13px;">
                                DISTORTED by transform:scale(0.85)!
                            </div>
                        }
                        @if (_showTransformPortal)
                        {
                            <SgPortal Visible="true">
                                <div class="portal-escape-demo" style="background:var(--sg-color-info);color:var(--sg-color-info-fg);">
                                    <SgHeroicon Name="@SgHeroicons.Names.ArrowUpRight" Size="20px" />
                                    <span>I escaped <code>transform</code> via SgPortal!</span>
                                </div>
                            </SgPortal>
                        }
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Position Presets                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Position Presets
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sui-text-muted)">
                Common positions for portal content. SgPortal teleports the wrapper — you style the content with <code>position: fixed</code> + <code>top/right/bottom/left</code>.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgStack Vertical Space="SgSize.Md">
                <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px;">
                    @foreach (var preset in _presets)
                    {
                        <SgButton Text="@preset.Label"
                                  Variant="@(preset.Active ? SgButtonVariant.Primary : SgButtonVariant.Outlined)"
                                  Size="SgSize.Sm"
                                  OnClick="() => TogglePreset(preset.Id)" />
                    }
                </div>

                @foreach (var preset in _presets.Where(p => p.Active))
                {
                    <SgPortal Visible="true">
                        <div class="portal-preset" style="@preset.Style">
                            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <SgHeroicon Name="@SgHeroicons.Names.MapPin" Variant="Solid" Size="24px" Color="var(--sg-color-primary)" />
                                <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm">@preset.Label</SgTypography>
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sui-text-muted)" Style="text-align:center;">
                                    @preset.Description
                                </SgTypography>
                                <SgButton Text="Close" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="() => { preset.Active = false; StateHasChanged(); }" />
                            </SgStack>
                        </div>
                    </SgPortal>
                }
            </SgStack>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Nested Portals + Stacking                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Nested Portals & Auto-Stacking
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sui-text-muted)">
                Portals inside portals get auto-incremented z-index. Open child, then grandchild — each stacks higher.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Start">
                <SgButton Text="@(_showNest1 ? "Close Parent" : "Open Parent Portal")"
                          Variant="@(_showNest1 ? SgButtonVariant.Danger : SgButtonVariant.Primary)"
                          OnClick="() => _showNest1 = !_showNest1" />
                @if (_showNest1)
                {
                    <SgPortal PreventScroll="true" Visible="true">
                        <div class="portal-nest-1">
                            <SgStack Vertical Space="SgSize.Md">
                                <div style="display:flex;align-items:center;justify-content:space-between;">
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                        <SgHeroicon Name="@SgHeroicons.Names.Cube" Variant="Solid" Size="20px" Color="#fff" />
                                        <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm" Color="#fff">Parent Portal (z-index: auto)</SgTypography>
                                    </SgStack>
                                    <button type="button" class="portal-close-btn" @onclick="() => { _showNest1 = false; _showNest2 = false; _showNest3 = false; }">
                                        <SgHeroicon Name="@SgHeroicons.Names.XMark" Size="16px" />
                                    </button>
                                </div>
                                <SgTypography Size="SgTypographySize.Xs" Color="rgba(255,255,255,0.7)">
                                    This portal locks body scroll. Open a child portal inside — it stacks with a higher z-index.
                                </SgTypography>
                                <SgButton Text="@(_showNest2 ? "Close Child" : "Open Child Portal")"
                                          Size="SgSize.Sm"
                                          OnClick="() => _showNest2 = !_showNest2" />
                                @if (_showNest2)
                                {
                                    <SgPortal Visible="true">
                                        <div class="portal-nest-2">
                                            <SgStack Vertical Space="SgSize.Md">
                                                <div style="display:flex;align-items:center;justify-content:space-between;">
                                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                                        <SgHeroicon Name="@SgHeroicons.Names.CubeTransparent" Variant="Solid" Size="20px" Color="#fff" />
                                                        <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm" Color="#fff">Child Portal (higher z-index)</SgTypography>
                                                    </SgStack>
                                                    <button type="button" class="portal-close-btn" @onclick="() => { _showNest2 = false; _showNest3 = false; }">
                                                        <SgHeroicon Name="@SgHeroicons.Names.XMark" Size="16px" />
                                                    </button>
                                                </div>
                                                <SgButton Text="@(_showNest3 ? "Close Grandchild" : "Open Grandchild Portal")"
                                                          Size="SgSize.Sm"
                                                          OnClick="() => _showNest3 = !_showNest3" />
                                                @if (_showNest3)
                                                {
                                                    <SgPortal Visible="true">
                                                        <div class="portal-nest-3">
                                                            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                                                <SgHeroicon Name="@SgHeroicons.Names.Sparkles" Variant="Solid" Size="24px" Color="#fbbf24" />
                                                                <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm" Color="#fff">Grandchild (top of stack)</SgTypography>
                                                                <SgTypography Size="SgTypographySize.Xs" Color="rgba(255,255,255,0.7)">
                                                                    Highest z-index — on top of everything
                                                                </SgTypography>
                                                                <SgButton Text="Close" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="() => _showNest3 = false" />
                                                            </SgStack>
                                                        </div>
                                                    </SgPortal>
                                                }
                                            </SgStack>
                                        </div>
                                    </SgPortal>
                                }
                            </SgStack>
                        </div>
                    </SgPortal>
                }
            </SgStack>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. PreventScroll Toggle                                            -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                PreventScroll — Body Scroll Lock
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sui-text-muted)">
                Toggle body scroll locking. When <code>PreventScroll="true"</code>, the body cannot scroll while the portal is open and padding adjusts for scrollbar width.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgRow Space="SgSize.Lg" Align="SgAlignItems.Center">
                <SgCol Md="6">
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sui-text-muted)">With Scroll Lock</SgTypography>
                        <SgSpace>
                            <SgButton Text="@(_showScrollLock ? "Close" : "Open Scroll-Locked Portal")"
                                      Variant="@(_showScrollLock ? SgButtonVariant.Default : SgButtonVariant.Primary)"
                                      OnClick="() => _showScrollLock = !_showScrollLock" />
                        </SgSpace>
                        @if (_showScrollLock)
                        {
                            <SgPortal PreventScroll="true" Visible="true">
                                <div class="portal-scroll-lock-demo">
                                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                        <SgHeroicon Name="@SgHeroicons.Names.LockClosed" Variant="Solid" Size="28px" Color="var(--sg-color-primary)" />
                                        <SgTypography Weight="SgTypographyWeight.Semibold">Body Scroll is Locked</SgTypography>
                                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sui-text-muted)" Style="text-align:center;">
                                            Try scrolling with mouse/trackpad — the page behind is frozen.
                                            Scrollbar width is compensated with padding-right.
                                        </SgTypography>
                                        <SgButton Text="Unlock & Close" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="() => _showScrollLock = false" />
                                    </SgStack>
                                </div>
                            </SgPortal>
                        }
                    </SgStack>
                </SgCol>
                <SgCol Md="6">
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sui-text-muted)">Without Scroll Lock</SgTypography>
                        <SgSpace>
                            <SgButton Text="@(_showNoScrollLock ? "Close" : "Open Unlocked Portal")"
                                      Variant="@(_showNoScrollLock ? SgButtonVariant.Default : SgButtonVariant.Outlined)"
                                      OnClick="() => _showNoScrollLock = !_showNoScrollLock" />
                        </SgSpace>
                        @if (_showNoScrollLock)
                        {
                            <SgPortal Visible="true">
                                <div class="portal-scroll-lock-demo" style="border-color:#f59e0b;">
                                    <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                        <SgHeroicon Name="@SgHeroicons.Names.LockOpen" Variant="Solid" Size="28px" Color="var(--sg-color-warning)" />
                                        <SgTypography Weight="SgTypographyWeight.Semibold">Body Scroll is NOT Locked</SgTypography>
                                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sui-text-muted)" Style="text-align:center;">
                                            The page behind can still scroll.
                                        </SgTypography>
                                        <SgButton Text="Close" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="() => _showNoScrollLock = false" />
                                    </SgStack>
                                </div>
                            </SgPortal>
                        }
                    </SgStack>
                </SgCol>
            </SgRow>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. Live Constructor                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live SgPortal Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sui-text-muted)">
                Configure all parameters and see the result in real time. Click Copy to use the code.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Controls ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Open state -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sui-text-muted)">Portal State</SgTypography>
                            <SgSegmented TValue="bool"
                                         Value="_ctorOpen"
                                         ValueChanged="v => { _ctorOpen = v; UpdateConstructorCode(); }"
                                         Block="true" Size="sm"
                                         Options="_boolSegOptions" />
                        </SgStack>

                        <!-- Style -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sui-text-muted)">Style Variant</SgTypography>
                            <SgSegmented TValue="int"
                                         Value="_ctorVariant"
                                         ValueChanged="v => { _ctorVariant = v; UpdateConstructorCode(); }"
                                         Block="true" Size="sm"
                                         Options="_variantOptions" />
                        </SgStack>

                        <!-- Z-Index slider -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sui-text-muted)">
                                Z-Index: <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorZIndex.ToString()" Standalone="true" />
                            </SgTypography>
                            <input type="range" min="100" max="99999" step="100"
                                   value="@_ctorZIndex"
                                   @oninput="OnZIndexChange"
                                   style="width:100%;accent-color:var(--sg-primary);" />
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sui-text-muted)">
                                Min: 100 &mdash; Max: 99999
                            </SgTypography>
                        </SgStack>

                        <!-- Toggles -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sui-text-muted)">PreventScroll</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorPreventScroll"
                                                 ValueChanged="v => { _ctorPreventScroll = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="_boolSegOptions2" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sui-text-muted)">AutoFocus</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorAutoFocus"
                                                 ValueChanged="v => { _ctorAutoFocus = v; UpdateConstructorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="_boolSegOptions2" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Transition Duration -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sui-text-muted)">
                                Transition: <SgBadge Variant="SgBadgeVariant.Default" Text="@(_ctorTransition + "ms")" Standalone="true" />
                            </SgTypography>
                            <SgSelect TValue="int"
                                      @bind-Value="_ctorTransition"
                                      Items="_transitionItems"
                                      Block="true" />
                        </SgStack>

                        <!-- Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sui-text-muted)">Open</SgTypography>
                                    <SgBadge Variant="@(_ctorOpen ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_ctorOpen ? "Visible" : "Hidden")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sui-text-muted)">Style</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorVariantLabel" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sui-text-muted)">Z-Index</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Warn" Text="@_ctorZIndex.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sui-text-muted)">PreventScroll</SgTypography>
                                    <SgBadge Variant="@(_ctorPreventScroll ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_ctorPreventScroll ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sui-text-muted)">AutoFocus</SgTypography>
                                    <SgBadge Variant="@(_ctorAutoFocus ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_ctorAutoFocus ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sui-text-muted)">Transition</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@(_ctorTransition + "ms")" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sui-text-muted)">Result</SgTypography>
                            <div class="constructor-preview" style="min-height:140px;display:flex;align-items:center;justify-content:center;text-align:center;">
                                @if (_ctorOpen)
                                {
                                    <SgPortal ZIndex="@_ctorZIndex"
                                              PreventScroll="@_ctorPreventScroll"
                                              AutoFocus="@_ctorAutoFocus"
                                              TransitionDuration="@_ctorTransition"
                                              Visible="true">
                                        <div class="portal-ctor-card @GetVariantClass()">
                                            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                                                <SgHeroicon Name="@SgHeroicons.Names.Sparkles" Variant="Solid" Size="28px" Color="@GetVariantIconColor()" />
                                                <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm">SgPortal Live Preview</SgTypography>
                                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sui-text-muted)">
                                                    Z-Index: @_ctorZIndex | ScrollLock: @(_ctorPreventScroll ? "On" : "Off")
                                                </SgTypography>
                                                <SgButton Text="Dismiss" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="() => { _ctorOpen = false; UpdateConstructorCode(); }" />
                                            </SgStack>
                                        </div>
                                    </SgPortal>
                                }
                                else
                                {
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sui-text-muted)">
                                        Toggle Portal State to see the result
                                    </SgTypography>
                                }
                            </div>
                        </SgStack>

                        <!-- Code -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sui-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                    <span style="font-size:11px;font-weight:600;">@_copyIcon</span>
                                </button>
                            </div>
                            <div class="code-block">
                                @foreach (var line in _generatedCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

    </ChildContent>
</SgCard>

<style>
    /* ── Section layout ─────────────────────────────────────────────────── */
    .demo-section { margin-top: 48px; }
    .demo-section-header { margin-bottom: 20px; }
    .demo-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }
    @@media (max-width: 768px) {
        .demo-two-col { grid-template-columns: 1fr; }
    }

    /* ── Portal banner ──────────────────────────────────────────────────── */
    .portal-banner {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 11000;
        padding: 10px 20px;
        background: linear-gradient(135deg, var(--sg-color-primary), color-mix(in srgb, var(--sg-color-primary) 60%, white));
        color: var(--sg-color-primary-fg);
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        box-shadow: 0 2px 12px color-mix(in srgb, var(--sg-color-primary) 30%, transparent);
        animation: portal-anim 0.3s ease;
    }
    .portal-toast {
        position: fixed;
        top: 20px; right: 20px;
        width: 340px;
        background: var(--sg-bg);
        border: 1px solid var(--sg-border);
        border-radius: 12px;
        padding: 14px 16px;
        box-shadow: var(--sg-shadow-lg);
        animation: portal-slide-right 0.3s ease;
    }
    .portal-modal {
        position: fixed;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 420px;
        max-width: calc(100vw - 32px);
        background: var(--sg-bg);
        border: 1px solid var(--sg-border);
        border-radius: 16px;
        padding: 24px;
        box-shadow: var(--sg-shadow-xl);
        animation: portal-fade-in 0.2s ease;
    }
    .portal-backdrop {
        position: fixed;
        inset: 0;
        background: color-mix(in srgb, var(--sg-fg) 35%, transparent);
        animation: portal-fade-in 0.15s ease;
    }

    /* ── Escape demos ───────────────────────────────────────────────────── */
    .portal-escape-demo {
        position: fixed;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        padding: 16px 20px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: var(--sg-shadow-lg);
        animation: portal-fade-in 0.2s ease;
        white-space: nowrap;
    }

    /* ── Position presets ───────────────────────────────────────────────── */
    .portal-preset {
        position: fixed;
        padding: 16px 20px;
        background: var(--sg-bg);
        border: 1px solid var(--sg-border);
        border-radius: 12px;
        box-shadow: var(--sg-shadow-md);
        min-width: 200px;
        animation: portal-fade-in 0.2s ease;
    }

    /* ── Nested portal cards ────────────────────────────────────────────── */
    .portal-nest-1 {
        position: fixed;
        top: 10%; left: 10%;
        width: 480px;
        max-width: calc(100vw - 40px);
        background: linear-gradient(135deg, var(--sg-color-primary), var(--sg-color-primary-hover));
        border-radius: 16px;
        padding: 24px;
        color: var(--sg-color-primary-fg);
        box-shadow: 0 12px 40px color-mix(in srgb, var(--sg-color-primary) 30%, transparent);
        animation: portal-fade-in 0.2s ease;
    }
    .portal-nest-2 {
        background: linear-gradient(135deg, var(--sg-color-info), var(--sg-color-info-hover));
        border-radius: 14px;
        padding: 20px;
        color: var(--sg-color-info-fg);
        box-shadow: 0 8px 24px color-mix(in srgb, var(--sg-color-info) 30%, transparent);
        animation: portal-fade-in 0.2s ease;
    }
    .portal-nest-3 {
        background: var(--sg-bg-muted);
        border: 1px solid var(--sg-border);
        border-radius: 12px;
        padding: 20px;
        box-shadow: var(--sg-shadow-lg);
        animation: portal-fade-in 0.2s ease;
    }

    /* ── Scroll lock demo ───────────────────────────────────────────────── */
    .portal-scroll-lock-demo {
        position: fixed;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        padding: 24px;
        background: var(--sg-bg);
        border: 1px solid var(--sg-border);
        border-radius: 16px;
        box-shadow: var(--sg-shadow-xl);
        min-width: 280px;
        animation: portal-fade-in 0.2s ease;
    }

    /* ── Constructor ────────────────────────────────────────────────────── */
    .portal-ctor-card {
        padding: 20px 24px;
        border-radius: 14px;
        box-shadow: var(--sg-shadow-md);
        min-width: 260px;
        animation: portal-fade-in 0.2s ease;
    }
    .portal-ctor-card.variant-info {
        background: var(--sg-color-info-subtle);
        border: 1px solid var(--sg-color-info-border);
        color: var(--sg-color-info-hover);
    }
    .portal-ctor-card.variant-success {
        background: var(--sg-color-success-subtle);
        border: 1px solid var(--sg-color-success-border);
        color: var(--sg-color-success-hover);
    }
    .portal-ctor-card.variant-warning {
        background: var(--sg-color-warning-subtle);
        border: 1px solid var(--sg-color-warning-border);
        color: var(--sg-color-warning-hover);
    }
    .portal-ctor-card.variant-dark {
        background: var(--sg-bg-muted);
        border: 1px solid var(--sg-border);
        color: var(--sg-fg);
    }
    .portal-icon-circle {
        width: 32px; height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        flex-shrink: 0;
    }
    .portal-close-btn {
        background: none; border: none;
        padding: 4px; cursor: pointer;
        opacity: 0.6; border-radius: 4px;
        display: flex; align-items: center; justify-content: center;
        color: inherit;
        transition: opacity 0.15s, background 0.15s;
    }
    .portal-close-btn:hover { opacity: 1; background: var(--sg-bg-muted); }

    /* ── Animations ─────────────────────────────────────────────────────── */
    @@keyframes portal-anim {
        from { transform: translateY(-100%); opacity: 0; }
        to   { transform: translateY(0); opacity: 1; }
    }
    @@keyframes portal-slide-right {
        from { transform: translateX(20px); opacity: 0; }
        to   { transform: translateX(0); opacity: 1; }
    }
    @@keyframes portal-fade-in {
        from { opacity: 0; }
        to   { opacity: 1; }
    }
</style>

@code {


    // ── Demo state ───────────────────────────────────────────────────────
    private bool _showBanner;
    private bool _showToast;
    private bool _showModal;
    private bool _showOverflow;
    private bool _showOverflowPortal;
    private bool _showTransform;
    private bool _showTransformPortal;
    private bool _showNest1;
    private bool _showNest2;
    private bool _showNest3;
    private bool _showScrollLock;
    private bool _showNoScrollLock;

    private void ToggleBanner()
    {
        _showBanner = !_showBanner;
        if (!_showBanner) { _showToast = false; }
    }

    // ── Position Presets ─────────────────────────────────────────────────
    private class PortalPreset
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Style { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Active { get; set; }
    }

    private List<PortalPreset> _presets = new()
    {
        new() { Id = "tl", Label = "Top Left",     Style = "top:20px;left:20px;",                 Description = "Fixed to top-left corner" },
        new() { Id = "tc", Label = "Top Center",   Style = "top:20px;left:50%;transform:translateX(-50%);", Description = "Centered at top" },
        new() { Id = "tr", Label = "Top Right",    Style = "top:20px;right:20px;",                Description = "Fixed to top-right corner" },
        new() { Id = "bl", Label = "Bottom Left",  Style = "bottom:20px;left:20px;",              Description = "Fixed to bottom-left corner" },
        new() { Id = "bc", Label = "Bottom Center",Style = "bottom:20px;left:50%;transform:translateX(-50%);", Description = "Centered at bottom" },
        new() { Id = "br", Label = "Bottom Right", Style = "bottom:20px;right:20px;",             Description = "Fixed to bottom-right corner" },
        new() { Id = "cc", Label = "Center",       Style = "top:50%;left:50%;transform:translate(-50%,-50%);", Description = "Dead center of viewport" },
    };

    private void TogglePreset(string id)
    {
        var p = _presets.Find(x => x.Id == id);
        if (p is not null) p.Active = !p.Active;
    }

    // ── Constructor state ────────────────────────────────────────────────
    private bool _ctorOpen;
    private int _ctorVariant;
    private int _ctorZIndex = 9999;
    private bool _ctorPreventScroll = true;
    private bool _ctorAutoFocus = true;
    private int _ctorTransition = 250;

    private string _ctorVariantLabel => _ctorVariant switch { 0 => "Info", 1 => "Success", 2 => "Warning", 3 => "Dark", _ => "Info" };
    private string GetVariantClass() => _ctorVariant switch { 0 => "variant-info", 1 => "variant-success", 2 => "variant-warning", 3 => "variant-dark", _ => "variant-info" };
    private string GetVariantIconColor() => _ctorVariant switch { 0 => "#3b82f6", 1 => "#10b981", 2 => "#f59e0b", 3 => "#6366f1", _ => "#3b82f6" };

    private void OnZIndexChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
        {
            _ctorZIndex = v;
            UpdateConstructorCode();
        }
    }

    // ── Code generation ──────────────────────────────────────────────────
    private string[] _generatedCodeLines = Array.Empty<string>();
    private string _copyIcon = "[Copy]";
    private string _copyLabel = "";

    private readonly List<SgSegmentedOption<bool>> _boolSegOptions = new()
    {
        new() { Value = false, Label = "Hidden" },
        new() { Value = true,  Label = "Visible" },
    };
    private readonly List<SgSegmentedOption<bool>> _boolSegOptions2 = new()
    {
        new() { Value = false, Label = "Off" },
        new() { Value = true,  Label = "On" },
    };
    private readonly List<SgSegmentedOption<int>> _variantOptions = new()
    {
        new() { Value = 0, Label = "Info" },
        new() { Value = 1, Label = "Success" },
        new() { Value = 2, Label = "Warning" },
        new() { Value = 3, Label = "Dark" },
    };
    private readonly List<int> _transitionItems = new() { 0, 100, 200, 250, 300, 500, 1000 };

    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        var attrs = new List<string> { "Visible=\"@_isOpen\"" };
        if (_ctorZIndex != 9999) attrs.Add($"ZIndex=\"{_ctorZIndex}\"");
        if (_ctorPreventScroll) attrs.Add("PreventScroll=\"true\"");
        if (_ctorAutoFocus) attrs.Add("AutoFocus=\"true\"");
        if (_ctorTransition != 250) attrs.Add($"TransitionDuration=\"{_ctorTransition}\"");
        var attrStr = attrs.Count > 0 ? " " + string.Join("\n    ", attrs) : "";
        lines.Add($"<SgPortal{attrStr}>");
        lines.Add("    <div>");
        lines.Add("        <!-- Your portal content -->");
        lines.Add("    </div>");
        lines.Add("</SgPortal>");
        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "Copied";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "[Copy]";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "[Copy]";
            StateHasChanged();
        }
    }

    // ── Property table ───────────────────────────────────────────────────
    private List<PropertyPanelItem> _portalProperties = new()
    {
        new() { Label = "ChildContent",      Value = "RenderFragment?",  BadgeText = "Content",      BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Visible",           Value = "bool",             BadgeText = "Two-way",      BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "ZIndex",            Value = "int?",             BadgeText = "Stack order",  BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "PreventScroll",     Value = "bool",             BadgeText = "Lock scroll",  BadgeVariant = SgBadgeVariant.Danger  },
        new() { Label = "AutoFocus",         Value = "bool",             BadgeText = "Auto-focus",   BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "TransitionDuration",Value = "int (ms)",         BadgeText = "Anim duration",BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Class",             Value = "string?",          BadgeText = "CSS class",    BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Style",             Value = "string?",          BadgeText = "Inline style", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Id",                Value = "string?",          BadgeText = "HTML ID",      BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "RenderAt",          Value = "string? (selector)", BadgeText = "Target",      BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "OnTeleported",      Value = "EventCallback",    BadgeText = "Callback",    BadgeVariant = SgBadgeVariant.Info    },
    };
}
