@page "/demo/tabs"
@using SuperUI.Demo.Components

<div class="demo-page">
    <div class="demo-hero">
        <section class="demo-hero-main">
            <div class="demo-header">
                <div class="demo-kicker">Navigation Components</div>
                <h1 class="demo-title">SgTabs</h1>
                <p class="demo-subtitle">
                    Switch between different views or functional sections. Features animated transitions, 
                    badge support, and accessible keyboard navigation.
                </p>
            </div>
        </section>

        <aside class="demo-hero-side">
            <div class="demo-side-title">Highlights</div>
            <div class="demo-pill-list">
                <span class="demo-pill demo-pill-accent">Tabbed UI</span>
                <span class="demo-pill">Badges</span>
                <span class="demo-pill">Keyboard Nav</span>
                <span class="demo-pill">Icons</span>
            </div>
        </aside>
    </div>

    <SgDemoSection Eyebrow="Usage" Title="Examples" Description="Organize dashboard modules, settings pages and detail views.">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Basic Tabs</h3>
                    <p class="demo-showcase-desc">Standard tabs with titles and text content.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgTabs>
                            <SgTabPanel Title="Overview">
                                <div style="padding:10px;">
                                    <h4>Project Overview</h4>
                                    <p>This is the main dashboard for the current project.</p>
                                </div>
                            </SgTabPanel>
                            <SgTabPanel Title="Team">
                                <div style="padding:10px;">
                                    <h4>Team Members</h4>
                                    <ul>
                                        <li>Alice (Owner)</li>
                                        <li>Bob (Developer)</li>
                                    </ul>
                                </div>
                            </SgTabPanel>
                            <SgTabPanel Title="Settings" Disabled="true">
                                You cannot access settings yet.
                            </SgTabPanel>
                        </SgTabs>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Icons & Badges</h3>
                    <p class="demo-showcase-desc">Enhance navigation with visual cues and status counters.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgTabs>
                            <SgTabPanel Title="Inbox" Icon="@(builder => builder.AddMarkupContent(0, SgIcons.Info))" Badge="5" BadgeVariant="SgBadgeVariant.Danger">
                                <div style="padding:10px;">You have 5 unread messages.</div>
                            </SgTabPanel>
                            <SgTabPanel Title="Analytics" Icon="@(builder => builder.AddMarkupContent(0, SgIcons.TrendingUp))">
                                <div style="padding:10px;">Traffic is up 12% this week.</div>
                            </SgTabPanel>
                            <SgTabPanel Title="Tasks" Badge="@("Done")" BadgeVariant="SgBadgeVariant.Success">
                                <div style="padding:10px;">All tasks completed.</div>
                            </SgTabPanel>
                        </SgTabs>
                    </div>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoParams Title="Tabs Parameters">
        <SgDemoParam Name="ActiveTitle" Type="string" Description="The title of the currently active tab (two-way bindable)." />
        <SgDemoParam Name="CssClass" Type="string" Description="Additional CSS classes." />
        <SgDemoParam Name="Style" Type="string" Description="Inline styles." />
    </SgDemoParams>

    <SgDemoParams Title="TabPanel Parameters">
        <SgDemoParam Name="Title" Type="string" Description="Text displayed in the tab trigger." />
        <SgDemoParam Name="Icon" Type="RenderFragment" Description="Icon displayed next to the title." />
        <SgDemoParam Name="Badge" Type="object" Description="Optional badge content (number or text)." />
        <SgDemoParam Name="BadgeVariant" Type="SgBadgeVariant" Description="Color variant for the badge." DefaultValue="Default" />
        <SgDemoParam Name="Disabled" Type="bool" Description="Disables the tab." DefaultValue="false" />
    </SgDemoParams>
</div>
