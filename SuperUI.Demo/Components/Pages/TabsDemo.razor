@page "/tabs-demo"
@using SuperUI.Components

<PageTitle>Вкладки - SUI</PageTitle>

<SgCard Title="SgTabs - Вкладки"
        Subtitle="Компонент для организации контента в несколько вкладок. Поддерживает различные стили и позиции.">

    <div style="margin-top: 32px;">
        <h2>Базовые вкладки</h2>
        <p>Стандартные вкладки для организации контента.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования" Style="grid-column: 1 / -1;">
                <SgTabs>
                    <SgTabPanel Title="Описание">
                        <div style="padding: 16px 0;">
                            <p>Это содержимое первой вкладки. Здесь может быть любой контент — текст, компоненты, формы.</p>
                            <SgAlert Variant="SgAlertVariant.Info" Text="Вкладки помогают организовать большой объём информации." />
                        </div>
                    </SgTabPanel>
                    <SgTabPanel Title="Детали">
                        <div style="padding: 16px 0;">
                            <p>Это содержимое второй вкладки с дополнительной информацией.</p>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 12px;">
                                <SgStatistic Title="Версия" Value="1.0.0" />
                                <SgStatistic Title="Компонентов" Value="50+" />
                            </div>
                        </div>
                    </SgTabPanel>
                    <SgTabPanel Title="Настройки">
                        <div style="padding: 16px 0; display: flex; flex-direction: column; gap: 12px;">
                            <SgSwitch @bind-Value="@_setting1" Label="Включить уведомления" />
                            <SgSwitch @bind-Value="@_setting2" Label="Тёмная тема" />
                            <SgSwitch @bind-Value="@_setting3" Label="Автосохранение" />
                        </div>
                    </SgTabPanel>
                    <SgTabPanel Title="История">
                        <div style="padding: 16px 0;">
                            <SgTimeline Items="_tabTimelineItems" />
                        </div>
                    </SgTabPanel>
                </SgTabs>
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Вкладки с иконками</h2>
        <p>Вкладки с эмодзи-иконками для лучшей навигации.</p>

        <SgCard Title="Примеры использования" Style="margin-top: 16px;">
            <SgTabs>
                <SgTabPanel Title="📊 Аналитика">
                    <div style="padding: 16px 0;">
                        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;">
                            <SgStatistic Title="Посетители" Value="12 345" TrendValue="0.12" />
                            <SgStatistic Title="Конверсия" Value="3.2%" TrendValue="-0.02" />
                            <SgStatistic Title="Доход" Value="98 765 ₽" TrendValue="0.25" />
                            <SgStatistic Title="Заказы" Value="342" TrendValue="0.08" />
                        </div>
                    </div>
                </SgTabPanel>
                <SgTabPanel Title="👥 Пользователи">
                    <div style="padding: 16px 0;">
                        <p>Список пользователей системы.</p>
                        <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 12px;">
                            @foreach (var user in _users)
                            {
                                <div style="display: flex; align-items: center; gap: 12px; padding: 8px; border: 1px solid var(--sui-border); border-radius: 6px;">
                                    <SgAvatar Initials="@user.Initials" Color="@user.Color" Size="SgSize.Sm" />
                                    <div>
                                        <div style="font-weight: 500;">@user.Name</div>
                                        <div style="font-size: 12px; color: var(--sui-text-muted);">@user.Role</div>
                                    </div>
                                    <SgBadge Text="@user.Status" Variant="@user.StatusVariant" />
                                </div>
                            }
                        </div>
                    </div>
                </SgTabPanel>
                <SgTabPanel Title="⚙️ Настройки">
                    <div style="padding: 16px 0; display: flex; flex-direction: column; gap: 12px; max-width: 400px;">
                        <SgTextBox TValue="string" @bind-Value="@_siteName" Label="Название сайта" />
                        <SgSelect TValue="string" @bind-Value="@_language" Items="@_languages" Label="Язык" />
                        <SgSwitch @bind-Value="@_maintenance" Label="Режим обслуживания" />
                    </div>
                </SgTabPanel>
            </SgTabs>
        </SgCard>
    </div>

    <div style="margin-top: 32px;">
        <h2>Свойства компонента</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="SgTabs">
                <PropertyTable Items="_tabsProperties" />
            </SgCard>
            <SgCard Title="SgTabPanel">
                <PropertyTable Items="_tabPanelProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Code examples -->
    <div style="margin-top: 32px;">
        <h2>Примеры кода</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
        </div>
    </div>

</SgCard>

@code {
    private bool _setting1 = true;
    private bool _setting2;
    private bool _setting3 = true;
    private string? _siteName = "SuperUI Demo";
    private string? _language = "Русский";
    private bool _maintenance;
    private List<string> _languages = new() { "Русский", "English", "Deutsch", "Français" };

    private List<TimelineItem> _tabTimelineItems = new()
    {
        new() { Title = "Компонент создан", Time = "2026-01-10", Color = "#52c41a" },
        new() { Title = "Добавлены иконки", Time = "2026-02-15", Color = "#52c41a" },
        new() { Title = "Улучшена доступность", Time = "2026-03-20", Color = "#faad14" }
    };

    private record UserItem(string Name, string Initials, string Color, string Role, string Status, SgBadgeVariant StatusVariant);

    private List<UserItem> _users = new()
    {
        new("Иван Петров", "ИП", "#1890ff", "Администратор", "Активен", SgBadgeVariant.Success),
        new("Мария Сидорова", "МС", "#52c41a", "Менеджер", "Активен", SgBadgeVariant.Success),
        new("Алексей Козлов", "АК", "#722ed1", "Разработчик", "Отпуск", SgBadgeVariant.Warn),
        new("Елена Новикова", "ЕН", "#fa8c16", "Дизайнер", "Неактивен", SgBadgeVariant.Muted)
    };

    private List<PropertyPanelItem> _tabsProperties = new()
    {
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Вкладки", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ActiveTitle", Value = "string", BadgeText = "Активная вкладка", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "CssClass", Value = "string", BadgeText = "CSS класс", BadgeVariant = SgBadgeVariant.Info }
    };

    private List<PropertyPanelItem> _tabPanelProperties = new()
    {
        new() { Label = "Title",        Value = "string",         BadgeText = "Заголовок вкладки", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Содержимое",        BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Disabled",     Value = "bool",           BadgeText = "Отключена",         BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Icon",         Value = "RenderFragment", BadgeText = "Иконка",            BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Badge",        Value = "object?",        BadgeText = "Значок",            BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "BadgeVariant", Value = "string",         BadgeText = "Стиль значка",      BadgeVariant = SgBadgeVariant.Info }
    };
}
