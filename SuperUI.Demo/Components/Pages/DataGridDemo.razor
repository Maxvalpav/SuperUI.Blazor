@page "/datagrid-demo/full"
@using SuperUI.Components
@using SuperUI.Demo.Models

<PageTitle>Таблица данных - SUI</PageTitle>
<SgSeoHead Description="Компонент для отображения и управления табличными данными. Поддерживает сортировку, фильтрацию, пагинацию, поиск, редактирование, группировку, экспорт и виртуализацию." />

<SgCard Title="SgDataGrid — Таблица данных" 
        Subtitle="Компонент для отображения и управления табличными данными. Поддерживает сортировку, фильтрацию, пагинацию, поиск, редактирование, группировку, экспорт и виртуализацию.">
    
    <!-- 1. Основная таблица с явными колонками -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">1. Основная таблица — явные колонки</SgTypography>
        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Таблица с явно определёнными колонками, поиском, фильтрацией (включая специальный фильтр для <b>bool</b>), сортировкой и пагинацией.</SgTypography>
        
        <SgCard Title="Интерактивная таблица" Style="margin-top: 16px;">
            <SgDataGrid Height="500px" TItem="Employee" 
                            Items="_employees"
                            ShowSearch="true"
                            ShowQuickFilters="true"
                            ShowColumnChooser="true"
                            ShowStatusBar="true"
                            ShowExportCsv="true"
                            ShowExportExcel="true"
                            AllowMultiSelect="true"
                            PageSize="15"
                            EnablePaging="true">
                    <ChildContent>
                        <SgDataGridColumn TItem="Employee" ColumnKey="Id" Title="ID" Value="@(e => e.Id)" Width="60" Sortable="true" Filterable="true" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="FirstName" Title="Имя" Value="@(e => e.FirstName)" Width="120" Sortable="true" Filterable="true" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="LastName" Title="Фамилия" Value="@(e => e.LastName)" Width="120" Sortable="true" Filterable="true" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Department" Title="Отдел" Value="@(e => e.Department)" Width="120" Sortable="true" Filterable="true" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="IsActive" Title="Статус (bool)" Value="@(e => e.IsActive)" Width="120" Sortable="true" Filterable="true" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Salary" Title="Зарплата" Value="@(e => e.Salary)" Width="100" Sortable="true" Filterable="true" Format="C0" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="HireDate" Title="Дата найма" Value="@(e => e.HireDate)" Width="120" Sortable="true" Filterable="true" Format="dd.MM.yyyy" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Email" Title="Email" Value="@(e => e.Email)" Width="150" Sortable="true" Filterable="true" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Phone" Title="Телефон" Value="@(e => e.Phone)" Width="130" Sortable="true" Filterable="true" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Position" Title="Должность" Value="@(e => e.Position)" Width="140" Sortable="true" Filterable="true" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Manager" Title="Руководитель" Value="@(e => e.Manager)" Width="140" Sortable="true" Filterable="true" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="YearsOfExperience" Title="Опыт (лет)" Value="@(e => e.YearsOfExperience)" Width="110" Sortable="true" Filterable="true" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Level" Title="Уровень" Value="@(e => e.Level)" Width="100" Sortable="true" Filterable="true" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="ProjectsCount" Title="Проектов" Value="@(e => e.ProjectsCount)" Width="90" Sortable="true" Filterable="true" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Rating" Title="Рейтинг" Value="@(e => e.Rating)" Width="90" Sortable="true" Filterable="true" Format="N2" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="LastVacationDate" Title="Последний отпуск" Value="@(e => e.LastVacationDate)" Width="140" Sortable="true" Filterable="true" Format="dd.MM.yyyy" />
                    </ChildContent>
                </SgDataGrid>

        </SgCard>
    </div>

    <!-- 2. Master-Detail таблица -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">2. Master-Detail (Вложенные детали)</SgTypography>
        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Использование <code>DetailTemplate</code> для отображения дополнительной информации при развертывании строки.</SgTypography>
        
        <SgCard Title="Детализация сотрудников" Style="margin-top: 16px;">
            <SgDataGrid Height="500px" TItem="Employee" 
                            Items="_employees.Take(100)"
                            ShowQuickFilters="true"
                            PageSize="10"
                            EnablePaging="true">
                    <ChildContent>
                        <SgDataGridColumn TItem="Employee" ColumnKey="Id" Title="ID" Value="@(e => e.Id)" Width="60" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="FullName" Title="ФИО" Value="@(e => $"{e.FirstName} {e.LastName}")" Width="200" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Email" Title="Email" Value="@(e => e.Email)" Width="200" />
                    </ChildContent>
                    
                    <DetailTemplate>
                        <SgCard Title="Подробная информация" Style="margin: 8px; background: var(--sui-bg-secondary);">
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                                <div>
                                    <div style="font-weight: 600; font-size: 12px; color: var(--sui-text-secondary);">ОТДЕЛ</div>
                                    <div style="font-size: 14px;">@context.Department</div>
                                </div>
                                <div>
                                    <div style="font-weight: 600; font-size: 12px; color: var(--sui-text-secondary);">ЗАРПЛАТА</div>
                                    <div style="font-size: 14px;">@context.Salary.ToString("C2")</div>
                                </div>
                                <div>
                                    <div style="font-weight: 600; font-size: 12px; color: var(--sui-text-secondary);">ДАТА НАЙМА</div>
                                    <div style="font-size: 14px;">@context.HireDate.ToLongDateString()</div>
                                </div>
                                <div>
                                    <div style="font-weight: 600; font-size: 12px; color: var(--sui-text-secondary);">СТАТУС</div>
                                    <div style="display: flex; align-items: center; gap: 8px; font-size: 14px;">
                                        <input type="checkbox" checked="@context.IsActive" disabled style="accent-color: var(--sui-accent);" />
                                        <span>@(context.IsActive ? "Действующий сотрудник" : "Уволен")</span>
                                    </div>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(context.Notes))
                            {
                                <div style="margin-top: 16px;">
                                    <div style="font-weight: 600; font-size: 12px; color: var(--sui-text-secondary);">ЗАМЕТКИ</div>
                                    <div style="font-size: 13px; font-style: italic;">@context.Notes</div>
                                </div>
                            }
                        </SgCard>
                    </DetailTemplate>
                </SgDataGrid>

        </SgCard>
    </div>

    <!-- 3. Таблица с кастомным тулбаром -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">3. Кастомный тулбар и шаблоны</SgTypography>
        <p>Использование <code>ToolbarContent</code> для добавления своих кнопок и <code>EmptyDataTemplate</code>.</p>
        
        <SgCard Title="Расширенное управление" Style="margin-top: 16px;">
            <SgDataGrid Height="400px" TItem="Employee" 
                            Items="_employees.Take(5)"
                            Title="Команда проекта"
                            ShowStatusBar="true">
                    <ToolbarContent>
                        <SgButton Variant="SgButtonVariant.Primary" Size="SgSize.Sm">
                            <Icon>➕</Icon>
                            <ChildContent>Добавить</ChildContent>
                        </SgButton>
                        <SgButton Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" @onclick="() => StateHasChanged()">
                            <Icon>🔄</Icon>
                            <ChildContent>Обновить</ChildContent>
                        </SgButton>
                        <div style="width: 1px; height: 20px; background: var(--sui-border); margin: 0 4px;"></div>
                        <SgButton Variant="SgButtonVariant.Danger" Size="SgSize.Sm" Disabled="true">
                            <Icon>🗑️</Icon>
                            <ChildContent>Удалить выбранные</ChildContent>
                        </SgButton>
                    </ToolbarContent>

                    <ChildContent>
                        <SgDataGridColumn TItem="Employee" ColumnKey="FirstName" Title="Имя" Value="@(e => e.FirstName)" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="LastName" Title="Фамилия" Value="@(e => e.LastName)" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Email" Title="Email" Value="@(e => e.Email)" />
                    </ChildContent>
                </SgDataGrid>

        </SgCard>
    </div>

    <!-- 4. Состояние загрузки (Skeleton) -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">4. Состояние загрузки (Skeleton)</SgTypography>
        <p>Демонстрация использования <code>Loading</code> параметра и компонента <code>SgSkeleton</code>.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px;">
            <SgCard Title="Загрузка таблицы" Loading="_isLoading">
                <SgDataGrid Height="250px" TItem="Employee" Items="_employees" Loading="true">
                        <ChildContent>
                            <SgDataGridColumn TItem="Employee" Title="Имя" Value="@(e => e.FirstName)" />
                            <SgDataGridColumn TItem="Employee" Title="Отдел" Value="@(e => e.Department)" />
                        </ChildContent>
                    </SgDataGrid>

            </SgCard>

            <SgCard Title="Управление">
                <p>Нажмите кнопку, чтобы переключить состояние загрузки карточки слева.</p>
                <SgButton Variant="@(_isLoading ? SgButtonVariant.Primary : SgButtonVariant.Ghost)" @onclick="() => _isLoading = !_isLoading">
                    @(_isLoading ? "Завершить загрузку" : "Начать загрузку")
                </SgButton>
                
                <div style="margin-top: 24px;">
                    <h4>Кастомные скелетоны:</h4>
                    <div style="display: flex; align-items: center; gap: 12px; margin-top: 12px;">
                        <SgSkeleton Shape="SgSkeletonShape.Circle" Width="48px" Height="48px" />
                        <div style="flex: 1;">
                            <SgSkeleton Width="40%" Height="14px" />
                            <SgSkeleton Width="80%" Height="10px" />
                        </div>
                    </div>
                </div>
            </SgCard>
        </div>
    </div>

    <!-- 5. Виртуализация (10,000 строк) -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">5. Виртуализация (10,000 строк)</SgTypography>
        <p>Высокая производительность при работе с огромными списками данных без пагинации.</p>
        
        <SgCard Title="Таблица с виртуализацией">
            <SgDataGrid Height="500px" TItem="Employee" 
                            Items="_employees"
                            EnableVirtualization="true"
                            EnablePaging="false"
                            ShowStatusBar="true">
                    <ChildContent>
                        <SgDataGridColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="80" />
                        <SgDataGridColumn TItem="Employee" Title="Имя" Value="@(e => e.FirstName)" Width="150" />
                        <SgDataGridColumn TItem="Employee" Title="Фамилия" Value="@(e => e.LastName)" Width="150" />
                        <SgDataGridColumn TItem="Employee" Title="Отдел" Value="@(e => e.Department)" Width="200" />
                        <SgDataGridColumn TItem="Employee" Title="Зарплата" Value="@(e => e.Salary)" Format="C0" Width="120" />
                    </ChildContent>
                </SgDataGrid>

        </SgCard>
    </div>

    <!-- 6. Таблица с автогенерацией колонок -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">6. Таблица с автогенерацией колонок</SgTypography>
        <p>Таблица с автоматическим созданием колонок из свойств модели Employee.</p>
        
        <SgCard Title="Таблица с автогенерацией" Style="margin-top: 16px;">
            <SgDataGrid Height="400px" TItem="Employee" 
                            Items="_employees.Take(100)"
                            AutoGenerateColumns="true"
                            ShowSearch="true"
                            ShowQuickFilters="true"
                            PageSize="10"
                            EnablePaging="true" />
        </SgCard>
    </div>

    <!-- 7. Массовое обновление -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">7. Массовое обновление (AllowBulkEdit)</SgTypography>
        <p>Выделите строки чекбоксами → нажмите <b>Массовое обновление</b> → отметьте колонки → нажмите <b>Изменить</b> → заполните значения → <b>Сохранить</b>.</p>

        <SgCard Title="Пример" Style="margin-top: 16px;">
            <SgDataGrid Height="460px" TItem="Employee"
                            Items="_employees.Take(50)"
                            AllowMultiSelect="true"
                            AllowEdit="true"
                            UseModalForEdit="true"
                            AllowBulkEdit="true"
                            ShowQuickFilters="true"
                            ShowStatusBar="true"
                            PageSize="10"
                            EnablePaging="true"
                            OnBulkSave="HandleBulkSave">
                    <ChildContent>
                        <SgDataGridColumn TItem="Employee" ColumnKey="Id"         Title="ID"       Value="@(e => e.Id)"         Width="60"  Sortable="true" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="FirstName"  Title="Имя"      Value="@(e => e.FirstName)"  Width="120" Sortable="true" Editable="true" ValueType="typeof(string)" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="LastName"   Title="Фамилия"  Value="@(e => e.LastName)"   Width="120" Sortable="true" Editable="true" ValueType="typeof(string)" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Department" Title="Отдел"    Value="@(e => e.Department)" Width="140" Sortable="true" Editable="true" ValueType="typeof(DepartmentType)" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Salary"     Title="Зарплата" Value="@(e => e.Salary)"     Width="110" Sortable="true" Editable="true" ValueType="typeof(decimal)" Format="C0" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="IsActive"   Title="Активен"  Value="@(e => e.IsActive)"   Width="100" Sortable="true" Editable="true" ValueType="typeof(bool)" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="HireDate"   Title="Дата найма" Value="@(e => e.HireDate)" Width="120" Sortable="true" Editable="true" ValueType="typeof(DateTime)" />
                    </ChildContent>
                </SgDataGrid>

            @if (_bulkLog.Count > 0)
            {
                <div style="margin-top: 12px; padding: 10px 12px; background: var(--sui-bg-secondary); border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); font-size: 12px;">
                    <div style="font-weight: 600; margin-bottom: 6px;">Последнее массовое обновление:</div>
                    @foreach (var line in _bulkLog)
                    {
                        <div style="color: var(--sui-muted);">@line</div>
                    }
                </div>
            }
        </SgCard>
    </div>

    <!-- 7b. Параметры колонки -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Параметры SgDataGridColumn</SgTypography>
        <SgCard Style="margin-top: 16px;">
            <PropertyTable Items="_columnProperties" />
        </SgCard>
    </div>

    <!-- 8. Параметры компонента -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">8. Таблица с экспортом данных</SgTypography>
        <p>Таблица с возможностью экспорта в CSV и Excel форматы.</p>

        <SgCard Title="Таблица с экспортом" Style="margin-top: 16px;">
            <SgDataGrid Height="400px" TItem="Employee"
                            Items="_employees.Take(100)"
                            ShowStatusBar="true"
                            ShowExportCsv="true"
                            ShowExportExcel="true"
                            AllowAutoFit="true"
                            PageSize="10"
                            EnablePaging="true">
                    <ChildContent>
                        <SgDataGridColumn TItem="Employee" ColumnKey="Id"         Title="ID"       Value="@(e => e.Id)"         Width="60" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="FirstName"  Title="Имя"      Value="@(e => e.FirstName)"  Width="120" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="LastName"   Title="Фамилия"  Value="@(e => e.LastName)"   Width="120" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Department" Title="Отдел"    Value="@(e => e.Department)" Width="120" ValueType="typeof(DepartmentType)" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Salary"     Title="Зарплата" Value="@(e => e.Salary)"     Width="100" Format="C0" ValueType="typeof(decimal)" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="HireDate"   Title="Дата найма" Value="@(e => e.HireDate)" Width="120" ValueType="typeof(DateTime)" />
                    </ChildContent>
                </SgDataGrid>

        </SgCard>
    </div>

    <!-- 9. Одиночный выбор (AllowSingleSelect) -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">9. Одиночный выбор (AllowSingleSelect)</SgTypography>
        <p>Параметр <code>AllowSingleSelect="true"</code> включает режим одиночного выбора строки через радиокнопку. При выборе новой строки предыдущая автоматически снимается.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px;">
            <SgCard Title="Таблица с одиночным выбором">
                <SgDataGrid Height="380px" TItem="Employee"
                                Items="_employees.Take(50)"
                                AllowSingleSelect="true"
                                ShowStatusBar="true"
                                PageSize="10"
                                EnablePaging="true"
                                SelectedItemsChanged="OnSingleSelectChanged">
                        <ChildContent>
                            <SgDataGridColumn TItem="Employee" ColumnKey="Id"         Title="ID"       Value="@(e => e.Id)"         Width="60"  Sortable="true" />
                            <SgDataGridColumn TItem="Employee" ColumnKey="FirstName"  Title="Имя"      Value="@(e => e.FirstName)"  Width="120" Sortable="true" />
                            <SgDataGridColumn TItem="Employee" ColumnKey="LastName"   Title="Фамилия"  Value="@(e => e.LastName)"   Width="120" Sortable="true" />
                            <SgDataGridColumn TItem="Employee" ColumnKey="Department" Title="Отдел"    Value="@(e => e.Department)" Width="140" Sortable="true" />
                        </ChildContent>
                    </SgDataGrid>

            </SgCard>

            <SgCard Title="Выбранная строка">
                @if (_singleSelectedEmployee is not null)
                {
                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        <div>
                            <div style="font-size: 11px; font-weight: 600; color: var(--sui-text-secondary); text-transform: uppercase; margin-bottom: 2px;">ID</div>
                            <div>@_singleSelectedEmployee.Id</div>
                        </div>
                        <div>
                            <div style="font-size: 11px; font-weight: 600; color: var(--sui-text-secondary); text-transform: uppercase; margin-bottom: 2px;">ФИО</div>
                            <div>@_singleSelectedEmployee.FirstName @_singleSelectedEmployee.LastName</div>
                        </div>
                        <div>
                            <div style="font-size: 11px; font-weight: 600; color: var(--sui-text-secondary); text-transform: uppercase; margin-bottom: 2px;">Отдел</div>
                            <div>@_singleSelectedEmployee.Department</div>
                        </div>
                        <div>
                            <div style="font-size: 11px; font-weight: 600; color: var(--sui-text-secondary); text-transform: uppercase; margin-bottom: 2px;">Зарплата</div>
                            <div>@_singleSelectedEmployee.Salary.ToString("C0")</div>
                        </div>
                        <div>
                            <div style="font-size: 11px; font-weight: 600; color: var(--sui-text-secondary); text-transform: uppercase; margin-bottom: 2px;">Статус</div>
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <input type="checkbox" checked="@_singleSelectedEmployee.IsActive" disabled style="accent-color: var(--sui-accent);" />
                                <span>@(_singleSelectedEmployee.IsActive ? "Активен" : "Неактивен")</span>
                            </div>
                        </div>
                        <div>
                            <div style="font-size: 11px; font-weight: 600; color: var(--sui-text-secondary); text-transform: uppercase; margin-bottom: 2px;">Дата найма</div>
                            <div>@_singleSelectedEmployee.HireDate.ToString("dd.MM.yyyy")</div>
                        </div>
                    </div>
                }
                else
                {
                    <div style="color: var(--sui-text-secondary); font-size: 13px; padding: 16px 0;">
                        Выберите строку в таблице слева
                    </div>
                }
            </SgCard>
        </div>
    </div>

    <!-- 10. Параметры компонента -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">10. Параметры компонента</SgTypography>
        <p>Полный список параметров SgDataGrid и SgDataGridColumn.</p>

        <SgCard Title="SgDataGrid — основные" Style="margin-top: 16px;">
            <PropertyTable Items="_mainProperties" />
        </SgCard>

        <SgCard Title="SgDataGrid — отображение" Style="margin-top: 16px;">
            <PropertyTable Items="_displayProperties" />
        </SgCard>

        <SgCard Title="SgDataGrid — функциональность" Style="margin-top: 16px;">
            <PropertyTable Items="_functionalityProperties" />
        </SgCard>

        <SgCard Title="SgDataGrid — редактирование и массовое обновление" Style="margin-top: 16px;">
            <PropertyTable Items="_editingProperties" />
        </SgCard>

        <SgCard Title="SgDataGrid — события" Style="margin-top: 16px;">
            <PropertyTable Items="_eventProperties" />
        </SgCard>

        <SgCard Title="SgDataGridColumn — параметры колонки" Style="margin-top: 16px;">
            <PropertyTable Items="_columnProperties" />
        </SgCard>
    </div>
</SgCard>

<!-- AutoDetail Demo -->
<div style="margin-top: 32px;">
    <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">AutoDetail — автоматические детали строки</SgTypography>
    <p>
        Параметр <code>AutoDetail="true"</code> автоматически строит панель деталей через reflection:
        объектные свойства отображаются как форма (<code>SgDataForm</code>),
        коллекции — как вложенный грид (<code>SgDataGrid</code>).
        Используйте <code>AutoDetailFields</code> чтобы выбрать конкретные поля.
    </p>

    <SgCard Title="Все поля (Address + Projects + Skills)" Style="margin-top: 16px;">
        <p style="margin-bottom: 8px; font-size: 12px; color: var(--sui-text-muted);">
            Нажмите на стрелку слева от строки чтобы раскрыть детали.
        </p>
        <SgDataGrid Height="480px" TItem="EmployeeDetailed"
                        Items="_detailedEmployees"
                        AutoDetail="true"
                        ShowSearch="true"
                        ShowQuickFilters="true"
                        PageSize="10"
                        EnablePaging="true">
                <ChildContent>
                    <SgDataGridColumn TItem="EmployeeDetailed" Title="ID"       Value="@(e => e.Id)"         Width="60" />
                    <SgDataGridColumn TItem="EmployeeDetailed" Title="Имя"      Value="@(e => e.FirstName)"  Width="120" />
                    <SgDataGridColumn TItem="EmployeeDetailed" Title="Фамилия"  Value="@(e => e.LastName)"   Width="130" />
                    <SgDataGridColumn TItem="EmployeeDetailed" Title="Отдел"    Value="@(e => e.Department)" Width="130" />
                    <SgDataGridColumn TItem="EmployeeDetailed" Title="Зарплата" Value="@(e => e.Salary)"     Width="110" Format="N0" />
                    <SgDataGridColumn TItem="EmployeeDetailed" Title="Активен"  Value="@(e => e.IsActive)"   Width="90" />
                    <SgDataGridColumn TItem="EmployeeDetailed" Title="Город" Value="@(e => e.Address.City)" Width="130" />
                </ChildContent>
            </SgDataGrid>

    </SgCard>

    <SgCard Title="Только выбранные поля (AutoDetailFields)" Style="margin-top: 16px;">
        <p style="margin-bottom: 8px; font-size: 12px; color: var(--sui-text-muted);">
            <code>AutoDetailFields="@(new[]{"Address","Projects"})"</code> — показывает только адрес и проекты.
        </p>
        <SgDataGrid Height="420px" TItem="EmployeeDetailed"
                        Items="_detailedEmployees"
                        AutoDetail="true"
                        AutoDetailFields="@(new[]{"Address","Projects"})"
                        ShowSearch="false"
                        ShowColumnChooser="false"
                        ShowRowHighlighter="false"
                        PageSize="8"
                        EnablePaging="true">
                <ChildContent>
                    <SgDataGridColumn TItem="EmployeeDetailed" Title="Имя"      Value="@(e => e.FirstName)"  Width="130" />
                    <SgDataGridColumn TItem="EmployeeDetailed" Title="Фамилия"  Value="@(e => e.LastName)"   Width="130" />
                    <SgDataGridColumn TItem="EmployeeDetailed" Title="Отдел"    Value="@(e => e.Department)" Width="130" />
                    <SgDataGridColumn TItem="EmployeeDetailed" Title="Зарплата" Value="@(e => e.Salary)"     Width="110" Format="N0" />
                </ChildContent>
            </SgDataGrid>

    </SgCard>

    <SgCard Title="Только навыки (AutoDetailFields = Skills)" Style="margin-top: 16px;">
        <p style="margin-bottom: 8px; font-size: 12px; color: var(--sui-text-muted);">
            <code>AutoDetailFields="@(new[]{"Skills"})"</code> — только вложенный грид навыков.
        </p>
        <SgDataGrid Height="400px" TItem="EmployeeDetailed"
                        Items="_detailedEmployees"
                        AutoDetail="true"
                        AutoDetailFields="@(new[]{"Skills"})"
                        ShowSearch="false"
                        ShowColumnChooser="false"
                        ShowRowHighlighter="false"
                        PageSize="8"
                        EnablePaging="true">
                <ChildContent>
                    <SgDataGridColumn TItem="EmployeeDetailed" Title="Имя"     Value="@(e => e.FirstName)"  Width="130" />
                    <SgDataGridColumn TItem="EmployeeDetailed" Title="Фамилия" Value="@(e => e.LastName)"   Width="130" />
                    <SgDataGridColumn TItem="EmployeeDetailed" Title="Город"   Value="@(e => e.Address.City)" Width="130" />
                </ChildContent>
            </SgDataGrid>

    </SgCard>
</div>

<!-- Saved Views Demo -->
<div style="margin-top: 32px;">
    <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Сохранённые виды (Saved Views)</SgTypography>
    <p>
        Параметр <code>ShowSavedViews="true"</code> добавляет кнопку <b>Виды</b> в тулбар.
        Панель позволяет сохранять именованные снимки настроек грида (фильтры, сортировка, группировка,
        расположение колонок, правила окрашивания) в <b>localStorage</b> браузера.
        Для сохранения в БД используйте <code>OnSaveViewToDb</code> и <code>DbViews</code>.
    </p>

    <SgCard Title="Грид с сохранёнными видами" Style="margin-top: 16px;">
        <p style="margin-bottom: 8px; font-size: 12px; color: var(--sui-text-muted);">
            Настройте фильтры, сортировку или группировку — затем нажмите <b>Виды → Сохранить</b>.
            Вид сохранится в localStorage и будет доступен после перезагрузки страницы.
        </p>
        <SgDataGrid Height="520px" TItem="Employee"
                        Items="_employees"
                        ShowSearch="true"
                        ShowQuickFilters="true"
                        ShowColumnChooser="true"
                        ShowStatusBar="true"
                        ShowRowHighlighter="true"
                        ShowSavedViews="true"
                        SavedViewsStorageKey="demo-employees-views"
                        PersistStateKey="demo-employees-state"
                        DbViews="@_mockDbViews"
                        OnSaveViewToDb="@OnSaveViewToDb"
                        OnDeleteViewFromDb="@OnDeleteViewFromDb"
                        PageSize="15"
                        EnablePaging="true">
                <ChildContent>
                    <SgDataGridColumn TItem="Employee" ColumnKey="Id"         Title="ID"       Value="@(e => e.Id)"         Width="60"  />
                    <SgDataGridColumn TItem="Employee" ColumnKey="FirstName"  Title="Имя"      Value="@(e => e.FirstName)"  Width="120" />
                    <SgDataGridColumn TItem="Employee" ColumnKey="LastName"   Title="Фамилия"  Value="@(e => e.LastName)"   Width="130" />
                    <SgDataGridColumn TItem="Employee" ColumnKey="Department" Title="Отдел"    Value="@(e => e.Department)" Width="130" />
                    <SgDataGridColumn TItem="Employee" ColumnKey="IsActive"   Title="Статус"   Value="@(e => e.IsActive)"   Width="100" />
                    <SgDataGridColumn TItem="Employee" ColumnKey="Salary"   Title="Зарплата"   Value="@(e => e.Salary)"   Width="110" Format="N0" />
                    <SgDataGridColumn TItem="Employee" ColumnKey="HireDate" Title="Дата найма" Value="@(e => e.HireDate)" Width="120" Format="dd.MM.yyyy" />
                </ChildContent>
            </SgDataGrid>

        @if (_savedViewsLog.Count > 0)
        {
            <div style="margin-top: 12px; padding: 10px 12px; background: var(--sui-bg-secondary); border-radius: var(--sui-radius-md); font-size: 12px;">
                <div style="font-weight: 600; margin-bottom: 6px; color: var(--sui-text-secondary);">ЛОГ ОПЕРАЦИЙ С БД:</div>
                @foreach (var entry in _savedViewsLog)
                {
                    <div style="color: var(--sui-text-primary); padding: 2px 0;">@entry</div>
                }
            </div>
        }
    </SgCard>

    <SgCard Title="Параметры" Style="margin-top: 16px;">
        <PropertyTable Items="_savedViewsProperties" />
    </SgCard>
</div>

