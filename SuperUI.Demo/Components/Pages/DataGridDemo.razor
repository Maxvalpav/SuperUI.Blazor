@page "/datagrid-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models

<PageTitle>Таблица данных - SUI</PageTitle>

<SgCard Title="SgDataGrid - Таблица данных" 
        Subtitle="rомпонент для отображения и управления табличными данными. Поддерживает сортировку, фильтрацию, пагинацию, поиск, редактирование, группировку, экспорт и виртуализацию.">
    
    <!-- 1. Основная таблица с явными колонками -->
    <div style="margin-top: 32px;">
        <h2>1. Основная таблица - явные колонки</h2>
        <p>Таблица с явно определёнными колонками, поиском, фильтрацией (включая специальный фильтр для <b>bool</b>), сортировкой и пагинацией.</p>
        
        <SgCard Title="Интерактивная таблица" Style="margin-top: 16px;">
            <div style="height: 500px; border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); overflow: hidden;">
                <SgDataGrid TItem="Employee" 
                            Items="_employees"
                            ShowSearch="true"
                            ShowQuickFilters="true"
                            ShowColumnChooser="true"
                            ShowStatusBar="true"
                            AllowMultiSelect="true"
                            PageSize="15"
                            EnablePaging="true">
                    <ChildContent>
                        <SgDataGridColumn TItem="Employee" ColumnKey="Id" Title="ID" Value="@(e => e.Id)" Width="60" Sortable="true" Filterable="true" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="FirstName" Title="Имя" Value="@(e => e.FirstName)" Width="120" Sortable="true" Filterable="true" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="LastName" Title="Фамилия" Value="@(e => e.LastName)" Width="120" Sortable="true" Filterable="true" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Department" Title="Отдел" Value="@(e => e.Department)" Width="120" Sortable="true" Filterable="true" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="IsActive" Title="Статус (bool)" Value="@(e => e.IsActive)" Width="120" Sortable="true" Filterable="true">
                            <Template>
                                <SgBadge Variant="@(context.IsActive ? SgBadgeVariant.Success : SgBadgeVariant.Danger)">
                                    @(context.IsActive ? "Активен" : "Неактивен")
                                </SgBadge>
                            </Template>
                        </SgDataGridColumn>
                        <SgDataGridColumn TItem="Employee" ColumnKey="Salary" Title="Зарплата" Value="@(e => e.Salary)" Width="100" Sortable="true" Filterable="true" Format="C0" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="HireDate" Title="Дата найма" Value="@(e => e.HireDate)" Width="120" Sortable="true" Filterable="true" Format="dd.MM.yyyy" />
                    </ChildContent>
                </SgDataGrid>
            </div>
        </SgCard>
    </div>

    <!-- 2. Master-Detail таблица -->
    <div style="margin-top: 32px;">
        <h2>2. Master-Detail (Вложенные детали)</h2>
        <p>Использование <code>DetailTemplate</code> для отображения дополнительной информации при развертывании строки.</p>
        
        <SgCard Title="Детализация сотрудников" Style="margin-top: 16px;">
            <div style="height: 500px; border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); overflow: hidden;">
                <SgDataGrid TItem="Employee" 
                            Items="_employees.Take(100)"
                            ShowQuickFilters="true"
                            PageSize="10"
                            EnablePaging="true">
                    <ChildContent>
                        <SgDataGridColumn TItem="Employee" ColumnKey="Id" Title="ID" Value="@(e => e.Id)" Width="60" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="FullName" Title="ФИО" Value="@(e => $"{e.FirstName} {e.LastName}")" Width="200" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Email" Title="Email" Value="@(e => e.Email)" Width="200" />
                    </ChildContent>
                    
                    <DetailTemplate>
                        <SgCard Title="Подробная информация" Style="margin: 8px; background: var(--sui-bg-secondary);">
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                                <div>
                                    <div style="font-weight: 600; font-size: 12px; color: var(--sui-text-secondary);">ОТДЕЛ</div>
                                    <div style="font-size: 14px;">@context.Department</div>
                                </div>
                                <div>
                                    <div style="font-weight: 600; font-size: 12px; color: var(--sui-text-secondary);">ЗАРПЛАТА</div>
                                    <div style="font-size: 14px;">@context.Salary.ToString("C2")</div>
                                </div>
                                <div>
                                    <div style="font-weight: 600; font-size: 12px; color: var(--sui-text-secondary);">ДАТА НАЙМА</div>
                                    <div style="font-size: 14px;">@context.HireDate.ToLongDateString()</div>
                                </div>
                                <div>
                                    <div style="font-weight: 600; font-size: 12px; color: var(--sui-text-secondary);">СТАТУС</div>
                                    <SgBadge Variant="@(context.IsActive ? SgBadgeVariant.Success : SgBadgeVariant.Danger)">
                                        @(context.IsActive ? "Действующий сотрудник" : "Уволен")
                                    </SgBadge>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(context.Notes))
                            {
                                <div style="margin-top: 16px;">
                                    <div style="font-weight: 600; font-size: 12px; color: var(--sui-text-secondary);">ЗАМЕТКИ</div>
                                    <div style="font-size: 13px; font-style: italic;">@context.Notes</div>
                                </div>
                            }
                        </SgCard>
                    </DetailTemplate>
                </SgDataGrid>
            </div>
        </SgCard>
    </div>

    <!-- 3. Таблица с кастомным тулбаром -->
    <div style="margin-top: 32px;">
        <h2>3. Кастомный тулбар и шаблоны</h2>
        <p>Использование <code>ToolbarContent</code> для добавления своих кнопок и <code>EmptyDataTemplate</code>.</p>
        
        <SgCard Title="Расширенное управление" Style="margin-top: 16px;">
            <div style="height: 400px; border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); overflow: hidden;">
                <SgDataGrid TItem="Employee" 
                            Items="_employees.Take(5)"
                            Title="Команда проекта"
                            ShowStatusBar="true">
                    <ToolbarContent>
                        <SgButton Variant="SgButtonVariant.Primary" Size="SgSize.Sm">
                            <Icon>➕</Icon>
                            <ChildContent>Добавить</ChildContent>
                        </SgButton>
                        <SgButton Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" @onclick="() => StateHasChanged()">
                            <Icon>🔄</Icon>
                            <ChildContent>Обновить</ChildContent>
                        </SgButton>
                        <div style="width: 1px; height: 20px; background: var(--sui-border); margin: 0 4px;"></div>
                        <SgButton Variant="SgButtonVariant.Danger" Size="SgSize.Sm" Disabled="true">
                            <Icon>🗑️</Icon>
                            <ChildContent>Удалить выбранные</ChildContent>
                        </SgButton>
                    </ToolbarContent>

                    <ChildContent>
                        <SgDataGridColumn TItem="Employee" ColumnKey="FirstName" Title="Имя" Value="@(e => e.FirstName)" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="LastName" Title="Фамилия" Value="@(e => e.LastName)" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Email" Title="Email" Value="@(e => e.Email)" />
                    </ChildContent>
                </SgDataGrid>
            </div>
        </SgCard>
    </div>

    <!-- 4. Состояние загрузки (Skeleton) -->
    <div style="margin-top: 32px;">
        <h2>4. Состояние загрузки (Skeleton)</h2>
        <p>Демонстрация использования <code>Loading</code> параметра и компонента <code>SgSkeleton</code>.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px;">
            <SgCard Title="Загрузка таблицы" Loading="_isLoading">
                <div style="height: 250px; border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); overflow: hidden;">
                    <SgDataGrid TItem="Employee" Items="_employees" Loading="true">
                        <ChildContent>
                            <SgDataGridColumn TItem="Employee" Title="Имя" Value="@(e => e.FirstName)" />
                            <SgDataGridColumn TItem="Employee" Title="Отдел" Value="@(e => e.Department)" />
                        </ChildContent>
                    </SgDataGrid>
                </div>
            </SgCard>

            <SgCard Title="Управление">
                <p>Нажмите кнопку, чтобы переключить состояние загрузки карточки слева.</p>
                <SgButton Variant="@(_isLoading ? SgButtonVariant.Primary : SgButtonVariant.Ghost)" @onclick="() => _isLoading = !_isLoading">
                    @(_isLoading ? "Завершить загрузку" : "Начать загрузку")
                </SgButton>
                
                <div style="margin-top: 24px;">
                    <h4>Кастомные скелетоны:</h4>
                    <div style="display: flex; align-items: center; gap: 12px; margin-top: 12px;">
                        <SgSkeleton Shape="SgSkeletonShape.Circle" Width="48px" Height="48px" />
                        <div style="flex: 1;">
                            <SgSkeleton Width="40%" Height="14px" />
                            <SgSkeleton Width="80%" Height="10px" />
                        </div>
                    </div>
                </div>
            </SgCard>
        </div>
    </div>

    <!-- 5. Виртуализация (10,000 строк) -->
    <div style="margin-top: 32px;">
        <h2>5. Виртуализация (10,000 строк)</h2>
        <p>Высокая производительность при работе с огромными списками данных без пагинации.</p>
        
        <SgCard Title="Таблица с виртуализацией">
            <div style="height: 500px; border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); overflow: hidden;">
                <SgDataGrid TItem="Employee" 
                            Items="_employees"
                            EnableVirtualization="true"
                            EnablePaging="false"
                            ShowStatusBar="true">
                    <ChildContent>
                        <SgDataGridColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="80" />
                        <SgDataGridColumn TItem="Employee" Title="Имя" Value="@(e => e.FirstName)" Width="150" />
                        <SgDataGridColumn TItem="Employee" Title="Фамилия" Value="@(e => e.LastName)" Width="150" />
                        <SgDataGridColumn TItem="Employee" Title="Отдел" Value="@(e => e.Department)" Width="200" />
                        <SgDataGridColumn TItem="Employee" Title="Зарплата" Value="@(e => e.Salary)" Format="C0" Width="120" />
                    </ChildContent>
                </SgDataGrid>
            </div>
        </SgCard>
    </div>

    <!-- 6. Таблица с автогенерацией колонок -->
    <div style="margin-top: 32px;">
        <h2>6. Таблица с автогенерацией колонок</h2>
        <p>Таблица с автоматическим созданием колонок из свойств модели Employee.</p>
        
        <SgCard Title="Таблица с автогенерацией" Style="margin-top: 16px;">
            <div style="height: 400px; border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); overflow: hidden;">
                <SgDataGrid TItem="Employee" 
                            Items="_employees.Take(100)"
                            AutoGenerateColumns="true"
                            ShowSearch="true"
                            ShowQuickFilters="true"
                            PageSize="10"
                            EnablePaging="true" />
            </div>
        </SgCard>
    </div>

    <!-- 7. Массовое обновление -->
    <div style="margin-top: 32px;">
        <h2>7. Массовое обновление (AllowBulkEdit)</h2>
        <p>Выделите строки чекбоксами → нажмите <b>Массовое обновление</b> → отметьте колонки → нажмите <b>Изменить</b> → заполните значения → <b>Сохранить</b>.</p>

        <SgCard Title="Пример" Style="margin-top: 16px;">
            <div style="height: 460px; border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); overflow: hidden;">
                <SgDataGrid TItem="Employee"
                            Items="_employees.Take(50)"
                            AllowMultiSelect="true"
                            AllowEdit="true"
                            UseModalForEdit="true"
                            AllowBulkEdit="true"
                            ShowQuickFilters="true"
                            ShowStatusBar="true"
                            PageSize="10"
                            EnablePaging="true"
                            OnBulkSave="HandleBulkSave">
                    <ChildContent>
                        <SgDataGridColumn TItem="Employee" ColumnKey="Id"         Title="ID"       Value="@(e => e.Id)"         Width="60"  Sortable="true" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="FirstName"  Title="Имя"      Value="@(e => e.FirstName)"  Width="120" Sortable="true" Editable="true" ValueType="typeof(string)" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="LastName"   Title="Фамилия"  Value="@(e => e.LastName)"   Width="120" Sortable="true" Editable="true" ValueType="typeof(string)" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Department" Title="Отдел"    Value="@(e => e.Department)" Width="140" Sortable="true" Editable="true" ValueType="typeof(DepartmentType)" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Salary"     Title="Зарплата" Value="@(e => e.Salary)"     Width="110" Sortable="true" Editable="true" ValueType="typeof(decimal)" Format="C0" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="IsActive"   Title="Активен"  Value="@(e => e.IsActive)"   Width="100" Sortable="true" Editable="true" ValueType="typeof(bool)">
                            <Template>
                                <SgBadge Variant="@(context.IsActive ? SgBadgeVariant.Success : SgBadgeVariant.Danger)">
                                    @(context.IsActive ? "Да" : "Нет")
                                </SgBadge>
                            </Template>
                        </SgDataGridColumn>
                        <SgDataGridColumn TItem="Employee" ColumnKey="HireDate"   Title="Дата найма" Value="@(e => e.HireDate)" Width="120" Sortable="true" Editable="true" ValueType="typeof(DateTime)" />
                    </ChildContent>
                </SgDataGrid>
            </div>
            @if (_bulkLog.Count > 0)
            {
                <div style="margin-top: 12px; padding: 10px 12px; background: var(--sui-bg-secondary); border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); font-size: 12px;">
                    <div style="font-weight: 600; margin-bottom: 6px;">Последнее массовое обновление:</div>
                    @foreach (var line in _bulkLog)
                    {
                        <div style="color: var(--sui-muted);">@line</div>
                    }
                </div>
            }
        </SgCard>
    </div>

    <!-- 7b. Параметры колонки -->
    <div style="margin-top: 32px;">
        <h2>Параметры SgDataGridColumn</h2>
        <SgCard Style="margin-top: 16px;">
            <PropertyTable Items="_columnProperties" />
        </SgCard>
    </div>

    <!-- 8. Параметры компонента -->
    <div style="margin-top: 32px;">
        <h2>8. Таблица с экспортом данных</h2>
        <p>Таблица с возможностью экспорта в CSV и Excel форматы.</p>

        <SgCard Title="Таблица с экспортом" Style="margin-top: 16px;">
            <div style="height: 400px; border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); overflow: hidden;">
                <SgDataGrid TItem="Employee"
                            Items="_employees.Take(100)"
                            ShowStatusBar="true"
                            ShowExportCsv="true"
                            ShowExportExcel="true"
                            AllowAutoFit="true"
                            PageSize="10"
                            EnablePaging="true">
                    <ChildContent>
                        <SgDataGridColumn TItem="Employee" ColumnKey="Id"         Title="ID"       Value="@(e => e.Id)"         Width="60" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="FirstName"  Title="Имя"      Value="@(e => e.FirstName)"  Width="120" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="LastName"   Title="Фамилия"  Value="@(e => e.LastName)"   Width="120" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Department" Title="Отдел"    Value="@(e => e.Department)" Width="120" ValueType="typeof(DepartmentType)" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="Salary"     Title="Зарплата" Value="@(e => e.Salary)"     Width="100" Format="C0" ValueType="typeof(decimal)" />
                        <SgDataGridColumn TItem="Employee" ColumnKey="HireDate"   Title="Дата найма" Value="@(e => e.HireDate)" Width="120" ValueType="typeof(DateTime)" />
                    </ChildContent>
                </SgDataGrid>
            </div>
        </SgCard>
    </div>

    <!-- 9. Одиночный выбор (AllowSingleSelect) -->
    <div style="margin-top: 32px;">
        <h2>9. Одиночный выбор (AllowSingleSelect)</h2>
        <p>Параметр <code>AllowSingleSelect="true"</code> включает режим одиночного выбора строки через радиокнопку. При выборе новой строки предыдущая автоматически снимается.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px;">
            <SgCard Title="Таблица с одиночным выбором">
                <div style="height: 380px; border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); overflow: hidden;">
                    <SgDataGrid TItem="Employee"
                                Items="_employees.Take(50)"
                                AllowSingleSelect="true"
                                ShowStatusBar="true"
                                PageSize="10"
                                EnablePaging="true"
                                SelectedItemsChanged="OnSingleSelectChanged">
                        <ChildContent>
                            <SgDataGridColumn TItem="Employee" ColumnKey="Id"         Title="ID"       Value="@(e => e.Id)"         Width="60"  Sortable="true" />
                            <SgDataGridColumn TItem="Employee" ColumnKey="FirstName"  Title="Имя"      Value="@(e => e.FirstName)"  Width="120" Sortable="true" />
                            <SgDataGridColumn TItem="Employee" ColumnKey="LastName"   Title="Фамилия"  Value="@(e => e.LastName)"   Width="120" Sortable="true" />
                            <SgDataGridColumn TItem="Employee" ColumnKey="Department" Title="Отдел"    Value="@(e => e.Department)" Width="140" Sortable="true" />
                        </ChildContent>
                    </SgDataGrid>
                </div>
            </SgCard>

            <SgCard Title="Выбранная строка">
                @if (_singleSelectedEmployee is not null)
                {
                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        <div>
                            <div style="font-size: 11px; font-weight: 600; color: var(--sui-text-secondary); text-transform: uppercase; margin-bottom: 2px;">ID</div>
                            <div>@_singleSelectedEmployee.Id</div>
                        </div>
                        <div>
                            <div style="font-size: 11px; font-weight: 600; color: var(--sui-text-secondary); text-transform: uppercase; margin-bottom: 2px;">ФИО</div>
                            <div>@_singleSelectedEmployee.FirstName @_singleSelectedEmployee.LastName</div>
                        </div>
                        <div>
                            <div style="font-size: 11px; font-weight: 600; color: var(--sui-text-secondary); text-transform: uppercase; margin-bottom: 2px;">Отдел</div>
                            <div>@_singleSelectedEmployee.Department</div>
                        </div>
                        <div>
                            <div style="font-size: 11px; font-weight: 600; color: var(--sui-text-secondary); text-transform: uppercase; margin-bottom: 2px;">Зарплата</div>
                            <div>@_singleSelectedEmployee.Salary.ToString("C0")</div>
                        </div>
                        <div>
                            <div style="font-size: 11px; font-weight: 600; color: var(--sui-text-secondary); text-transform: uppercase; margin-bottom: 2px;">Статус</div>
                            <SgBadge Variant="@(_singleSelectedEmployee.IsActive ? SgBadgeVariant.Success : SgBadgeVariant.Danger)">
                                @(_singleSelectedEmployee.IsActive ? "Активен" : "Неактивен")
                            </SgBadge>
                        </div>
                        <div>
                            <div style="font-size: 11px; font-weight: 600; color: var(--sui-text-secondary); text-transform: uppercase; margin-bottom: 2px;">Дата найма</div>
                            <div>@_singleSelectedEmployee.HireDate.ToString("dd.MM.yyyy")</div>
                        </div>
                    </div>
                }
                else
                {
                    <div style="color: var(--sui-text-secondary); font-size: 13px; padding: 16px 0;">
                        Выберите строку в таблице слева
                    </div>
                }
            </SgCard>
        </div>
    </div>

    <!-- 10. Параметры компонента -->
    <div style="margin-top: 32px;">
        <h2>10. Параметры компонента</h2>
        <p>Полный список параметров SgDataGrid и SgDataGridColumn.</p>

        <SgCard Title="SgDataGrid — основные" Style="margin-top: 16px;">
            <PropertyTable Items="_mainProperties" />
        </SgCard>

        <SgCard Title="SgDataGrid — отображение" Style="margin-top: 16px;">
            <PropertyTable Items="_displayProperties" />
        </SgCard>

        <SgCard Title="SgDataGrid — функциональность" Style="margin-top: 16px;">
            <PropertyTable Items="_functionalityProperties" />
        </SgCard>

        <SgCard Title="SgDataGrid — редактирование и массовое обновление" Style="margin-top: 16px;">
            <PropertyTable Items="_editingProperties" />
        </SgCard>

        <SgCard Title="SgDataGrid — события" Style="margin-top: 16px;">
            <PropertyTable Items="_eventProperties" />
        </SgCard>

        <SgCard Title="SgDataGridColumn — параметры колонки" Style="margin-top: 16px;">
            <PropertyTable Items="_columnProperties" />
        </SgCard>
    </div>
</SgCard>

@code {
    private List<Employee> _employees = new();
    private bool _isLoading = false;
    private List<string> _bulkLog = new();
    private Employee? _singleSelectedEmployee;

    private void OnSingleSelectChanged(IReadOnlyCollection<Employee> selected)
    {
        _singleSelectedEmployee = selected.FirstOrDefault();
    }

    private void HandleBulkSave(SgBulkEditEventArgs<Employee> args)
    {
        _bulkLog.Clear();
        _bulkLog.Add($"Строк: {args.Items.Count}");
        foreach (var (key, val) in args.Changes)
        {
            if (!string.IsNullOrEmpty(val))
                _bulkLog.Add($"  {key} = \"{val}\"");
        }
        // Apply changes to items
        foreach (var item in args.Items)
        {
            foreach (var (key, val) in args.Changes)
            {
                if (string.IsNullOrEmpty(val)) continue;
                switch (key)
                {
                    case "FirstName":  item.FirstName  = val; break;
                    case "LastName":   item.LastName   = val; break;
                    case "Department": if (Enum.TryParse<DepartmentType>(val, out var dept)) item.Department = dept; break;
                    case "Salary":     if (decimal.TryParse(val, out var sal)) item.Salary = sal; break;
                    case "IsActive":   item.IsActive   = val == "true"; break;
                    case "HireDate":
                        if (DateTime.TryParseExact(val, "yyyy-MM-dd",
                            System.Globalization.CultureInfo.InvariantCulture,
                            System.Globalization.DateTimeStyles.None, out var dt))
                            item.HireDate = dt;
                        break;
                }
            }
        }
    }

    // ── Property tables ───────────────────────────────────────────────────────

    private List<PropertyPanelItem> _mainProperties = new()
    {
