    private Task OnSaveViewToDb(SgSavedViews<Employee>.SavedViewItem view)
    {
        var msg = $"[{DateTime.Now.ToString("HH:mm:ss")}] SAVE → id={view.Id[..8]}… name=\"{view.Name}\" ({view.StateJson.Length} байт JSON)";
        _savedViewsLog.Insert(0, msg);
        if (_savedViewsLog.Count > 5) _savedViewsLog.RemoveAt(_savedViewsLog.Count - 1);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnDeleteViewFromDb(string id)
    {
        var msg = $"[{DateTime.Now.ToString("HH:mm:ss")}] DELETE → id={id[..8]}…";
        _savedViewsLog.Insert(0, msg);
        if (_savedViewsLog.Count > 5) _savedViewsLog.RemoveAt(_savedViewsLog.Count - 1);
        StateHasChanged();
        return Task.CompletedTask;
    }

