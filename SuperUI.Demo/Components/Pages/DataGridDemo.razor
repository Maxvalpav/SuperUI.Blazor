@page "/datagrid-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models

<PageTitle>Таблица данных - SUI</PageTitle>

<SgCard Title="SgDataGrid - Таблица данных" 
        Subtitle="rомпонент для отображения и управления табличными данными. Поддерживает сортировку, фильтрацию, пагинацию, поиск, редактирование, группировку, экспорт и виртуализацию.">
    
    <!-- 1. Основная таблица с явными колонками -->
    <div style="margin-top: 32px;">
        <h2>1. Основная таблица - явные колонки (10,000 строк)</h2>
        <p>Таблица с явно определёнными колонками, поиском, фильтрацией, сортировкой и пагинацией.</p>
        
        <SgCard Title="Интерактивная таблица" Style="margin-top: 16px;">
            <div style="height: 600px; overflow: auto; border: 1px solid var(--sui-border); border-radius: 4px;">
                <SgDataGrid TItem="Employee" 
                            Items="_employees"
                            ShowSearch="true"
                            ShowQuickFilters="true"
                            ShowColumnChooser="true"
                            ShowStatusBar="true"
                            AllowMultiSelect="true"
                            AllowEdit="true"
                            AllowDelete="true"
                            PageSize="50"
                            EnablePaging="true">
                    <SgDataGridColumn TItem="Employee" ColumnKey="Id" Title="ID" Value="@(e => e.Id)" Width="60" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="Employee" ColumnKey="FirstName" Title="Имя" Value="@(e => e.FirstName)" Width="120" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="Employee" ColumnKey="LastName" Title="Фамилия" Value="@(e => e.LastName)" Width="120" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="Employee" ColumnKey="Email" Title="Email" Value="@(e => e.Email)" Width="180" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="Employee" ColumnKey="Department" Title="Отдел" Value="@(e => e.Department)" Width="120" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="Employee" ColumnKey="Salary" Title="Зарплата" Value="@(e => e.Salary)" Width="100" Sortable="true" Filterable="true" Format="C2" />
                    <SgDataGridColumn TItem="Employee" ColumnKey="HireDate" Title="Дата найма" Value="@(e => e.HireDate)" Width="120" Sortable="true" Filterable="true" Format="dd.MM.yyyy" />
                    <SgDataGridColumn TItem="Employee" ColumnKey="IsActive" Title="Активен" Value="@(e => e.IsActive)" Width="80" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="Employee" ColumnKey="Notes" Title="Заметки" Value="@(e => e.Notes)" Width="140" Sortable="true" Filterable="true" />
                </SgDataGrid>
            </div>
        </SgCard>
    </div>

    <!-- 2. Таблица с автогенерацией колонок -->
    <div style="margin-top: 32px;">
        <h2>2. Таблица с автогенерацией колонок</h2>
        <p>Таблица с автоматическим созданием колонок из свойств модели Employee.</p>
        
        <SgCard Title="Таблица с автогенерацией" Style="margin-top: 16px;">
            <div style="height: 600px; overflow: auto; border: 1px solid var(--sui-border); border-radius: 4px;">
                <SgDataGrid TItem="Employee" 
                            Items="_employees"
                            AutoGenerateColumns="true"
                            ShowSearch="true"
                            ShowQuickFilters="true"
                            ShowColumnChooser="true"
                            ShowStatusBar="true"
                            AllowMultiSelect="true"
                            AllowEdit="true"
                            AllowDelete="true"
                            PageSize="50"
                            EnablePaging="true" />
            </div>
        </SgCard>
    </div>


    <!-- 4. Таблица с экспортом -->
    <div style="margin-top: 32px;">
        <h2>4. Таблица с экспортом данных</h2>
        <p>Таблица с возможностью экспорта в CSV и Excel форматы.</p>
        
        <SgCard Title="Таблица с экспортом" Style="margin-top: 16px;">
            <div style="height: 600px; overflow: auto; border: 1px solid var(--sui-border); border-radius: 4px;">
                <SgDataGrid TItem="Employee" 
                            Items="_employees"
                            ShowSearch="true"
                            ShowColumnChooser="true"
                            ShowStatusBar="true"
                            ShowExportCsv="true"
                            ShowExportExcel="true"
                            AllowAutoFit="true"
                            PageSize="50"
                            EnablePaging="true">
                    <SgDataGridColumn TItem="Employee" ColumnKey="Id" Title="ID" Value="@(e => e.Id)" Width="60" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="Employee" ColumnKey="FirstName" Title="Имя" Value="@(e => e.FirstName)" Width="120" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="Employee" ColumnKey="LastName" Title="Фамилия" Value="@(e => e.LastName)" Width="120" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="Employee" ColumnKey="Email" Title="Email" Value="@(e => e.Email)" Width="180" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="Employee" ColumnKey="Department" Title="Отдел" Value="@(e => e.Department)" Width="120" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="Employee" ColumnKey="Salary" Title="Зарплата" Value="@(e => e.Salary)" Width="100" Sortable="true" Filterable="true" Format="C2" />
                </SgDataGrid>
            </div>
        </SgCard>
    </div>





    <!-- 7. Параметры компонента -->
    <div style="margin-top: 32px;">
        <h2>7. Параметры компонента</h2>
        <p>Полный список параметров SgDataGrid для настройки поведения и внешнего вида.</p>
        
        <SgCard Title="Основные параметры" Style="margin-top: 16px;">
            <PropertyTable Items="_mainProperties" />
        </SgCard>

        <SgCard Title="Параметры отображения" Style="margin-top: 16px;">
            <PropertyTable Items="_displayProperties" />
        </SgCard>

        <SgCard Title="Параметры функциональности" Style="margin-top: 16px;">
            <PropertyTable Items="_functionalityProperties" />
        </SgCard>

        <SgCard Title="Параметры редактирования" Style="margin-top: 16px;">
            <PropertyTable Items="_editingProperties" />
        </SgCard>

        <SgCard Title="События и обработчики" Style="margin-top: 16px;">
            <PropertyTable Items="_eventProperties" />
        </SgCard>
    </div>
</SgCard>


@code {
    private List<Employee> _employees = new();

    private List<PropertyPanelItem> _mainProperties = new()
    {
        new() { Label = "Items", Value = "IEnumerable<T>", BadgeText = "Обязательно", BadgeVariant = "danger" },
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Колонки", BadgeVariant = "info" },
        new() { Label = "Title", Value = "string", BadgeText = "Заголовок", BadgeVariant = "info" },
        new() { Label = "CssClass", Value = "string", BadgeText = "CSS класс", BadgeVariant = "info" },
        new() { Label = "EmptyText", Value = "string", BadgeText = "Пусто", BadgeVariant = "info" }
    };

    private List<PropertyPanelItem> _displayProperties = new()
    {
        new() { Label = "ShowSearch", Value = "bool", BadgeText = "Поиск", BadgeVariant = "warn" },
        new() { Label = "ShowQuickFilters", Value = "bool", BadgeText = "Быстрые фильтры", BadgeVariant = "warn" },
        new() { Label = "ShowColumnChooser", Value = "bool", BadgeText = "Выбор колонок", BadgeVariant = "warn" },
        new() { Label = "ShowStatusBar", Value = "bool", BadgeText = "Статус-бар", BadgeVariant = "warn" },
        new() { Label = "ShowColumnBorders", Value = "bool", BadgeText = "Границы", BadgeVariant = "warn" },
        new() { Label = "ShowExportCsv", Value = "bool", BadgeText = "Экспорт CSV", BadgeVariant = "warn" },
        new() { Label = "ShowExportExcel", Value = "bool", BadgeText = "Экспорт Excel", BadgeVariant = "warn" },
        new() { Label = "FullWidth", Value = "bool", BadgeText = "На всю ширину", BadgeVariant = "warn" }
    };

    private List<PropertyPanelItem> _functionalityProperties = new()
    {
        new() { Label = "AutoGenerateColumns", Value = "bool", BadgeText = "Автогенерация", BadgeVariant = "warn" },
        new() { Label = "EnablePaging", Value = "bool", BadgeText = "Пагинация", BadgeVariant = "warn" },
        new() { Label = "PageSize", Value = "int", BadgeText = "На странице", BadgeVariant = "info" },
        new() { Label = "PageSizeOptions", Value = "IReadOnlyList<int>", BadgeText = "Варианты", BadgeVariant = "info" },
        new() { Label = "AllowMultiSelect", Value = "bool", BadgeText = "Множественный выбор", BadgeVariant = "warn" },
        new() { Label = "AllowEdit", Value = "bool", BadgeText = "Редактирование", BadgeVariant = "warn" },
        new() { Label = "AllowDelete", Value = "bool", BadgeText = "Удаление", BadgeVariant = "warn" },
        new() { Label = "AllowAutoFit", Value = "bool", BadgeText = "Автоподгонка", BadgeVariant = "warn" },
        new() { Label = "Loading", Value = "bool", BadgeText = "Загрузка", BadgeVariant = "warn" }
    };

    private List<PropertyPanelItem> _editingProperties = new()
    {
        new() { Label = "UseModalForEdit", Value = "bool", BadgeText = "Модальное окно", BadgeVariant = "warn" },
        new() { Label = "EditModalWidth", Value = "int", BadgeText = "Ширина", BadgeVariant = "info" },
        new() { Label = "EditModalAddTitle", Value = "string", BadgeText = "Заголовок добавления", BadgeVariant = "info" },
        new() { Label = "EditModalEditTitle", Value = "string", BadgeText = "Заголовок редактирования", BadgeVariant = "info" },
        new() { Label = "CreateItemFactory", Value = "Func<T>", BadgeText = "Фабрика", BadgeVariant = "info" },
        new() { Label = "DetailTemplate", Value = "RenderFragment<T>", BadgeText = "Детали", BadgeVariant = "info" },
        new() { Label = "DetailPlacement", Value = "DetailPlacement", BadgeText = "Размещение", BadgeVariant = "info" }
    };

    private List<PropertyPanelItem> _eventProperties = new()
    {
        new() { Label = "RowClicked", Value = "EventCallback<T>", BadgeText = "Клик строки", BadgeVariant = "success" },
        new() { Label = "RowDoubleClicked", Value = "EventCallback<T>", BadgeText = "Двойной клик", BadgeVariant = "success" },
        new() { Label = "SelectedItemsChanged", Value = "EventCallback<IReadOnlyCollection<T>>", BadgeText = "Выбор", BadgeVariant = "success" },
        new() { Label = "RowDeleted", Value = "EventCallback<T>", BadgeText = "Удаление", BadgeVariant = "success" },
        new() { Label = "RowCreated", Value = "EventCallback<T>", BadgeText = "Создание", BadgeVariant = "success" },
        new() { Label = "OnRowContextMenu", Value = "EventCallback<SgDataGridContextMenuEventArgs<T>>", BadgeText = "Контекстное меню", BadgeVariant = "success" }
    };

    protected override void OnInitialized()
    {
        _employees = SampleDataService.GenerateEmployees(10000);
    }
}

