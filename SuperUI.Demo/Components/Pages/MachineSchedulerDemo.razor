@page "/machine-scheduler-demo"
@using SuperUI.Components
@using SuperUI.Components.SgMachineScheduler
@using SuperUI.Components.SgMachineScheduler.Models

<div class="p-4 d-flex flex-column" style="height: 100vh; background: var(--sg-bg-subtle);">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="mb-1" style="font-weight: 700; color: #1e293b;">🏭 Производственное планирование</h3>
            <p class="text-muted mb-0">Управление загрузкой мощностей в реальном времени (SkiaSharp Canvas)</p>
        </div>
        
        <div class="d-flex gap-2 align-items-center bg-white p-2 rounded-3 shadow-sm">
            <div class="d-flex gap-1 border-end pe-2 me-1">
                <SgIconButton Icon="@Icons.ZoomOut" Title="Уменьшить" OnClick="() => _scheduler?.ZoomOut()" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
                <SgIconButton Icon="@Icons.ZoomIn" Title="Увеличить" OnClick="() => _scheduler?.ZoomIn()" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
            </div>
            <SgButton Variant="SgButtonVariant.Outlined" Size="SgSize.Sm" OnClick="ScrollToNow" Text="Сегодня" />
            <SgButton Variant="SgButtonVariant.Primary" Size="SgSize.Sm" OnClick="GenerateRandomData" Text="Обновить данные" />
        </div>
    </div>
    
    <div class="card border-0 shadow-sm flex-grow-1 overflow-hidden" style="border-radius: 12px;">
        <div class="card-body p-0 position-relative d-flex flex-column">
            <SgMachineScheduler @ref="_scheduler"
                               Resources="_resources" 
                               Reservations="_reservations"
                               Downtimes="_downtimes"
                               VisibleStart="_start"
                               VisibleEnd="_end"
                               OnReservationMoved="HandleMove" />
        </div>
    </div>
    
    <div class="mt-3 d-flex flex-wrap gap-4 px-2">
        <div class="d-flex align-items-center gap-2">
            <div style="width:10px;height:10px;background:#3B82F6;border-radius:50%;"></div>
            <span style="font-size: 13px; color: #64748b;">Запланировано</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div style="width:10px;height:10px;background:#10B981;border-radius:50%;"></div>
            <span style="font-size: 13px; color: #64748b;">В работе</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div style="width:10px;height:10px;background:#F59E0B;border-radius:50%;"></div>
            <span style="font-size: 13px; color: #64748b;">Задержка</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div style="width:10px;height:10px;background:#EF4444;border-radius:50%;"></div>
            <span style="font-size: 13px; color: #64748b;">Критично / Простой</span>
        </div>
        <div class="ms-auto">
            <span style="font-size: 12px; color: #94a3b8;">Управление: Ctrl + Колесо мыши (Зум), Shift + Колесо (Гориз. скролл)</span>
        </div>
    </div>
</div>

@code {
    private SgMachineScheduler? _scheduler;
    private DateTime _start = DateTime.Today.AddDays(-1);
    private DateTime _end = DateTime.Today.AddDays(7);
    
    private List<MachineResource> _resources = new();
    private List<MachineReservation> _reservations = new();
    private List<MachineDowntime> _downtimes = new();

    protected override void OnInitialized()
    {
        GenerateData();
    }

    private void GenerateData()
    {
        _resources = new List<MachineResource>
        {
            new MachineResource { Id = 1, Name = "Haas VF-2 #1", Group = "Токарная", Status = MachineStatus.Online },
            new MachineResource { Id = 2, Name = "Haas VF-2 #2", Group = "Токарная", Status = MachineStatus.Online },
            new MachineResource { Id = 3, Name = "Haas VF-3 #1", Group = "Токарная", Status = MachineStatus.Maintenance },
            new MachineResource { Id = 4, Name = "DMG Mori NTX", Group = "Фрезерная", Status = MachineStatus.Online },
            new MachineResource { Id = 5, Name = "Mazak Variaxis", Group = "Фрезерная", Status = MachineStatus.Online },
            new MachineResource { Id = 6, Name = "Trumpf TruLaser", Group = "Лазерная", Status = MachineStatus.Online },
            new MachineResource { Id = 7, Name = "Bystronic ByStar", Group = "Лазерная", Status = MachineStatus.Fault },
            new MachineResource { Id = 8, Name = "Сварочный пост A", Group = "Сварка", Status = MachineStatus.Online },
            new MachineResource { Id = 9, Name = "Сварочный пост B", Group = "Сварка", Status = MachineStatus.Online },
            new MachineResource { Id = 10, Name = "Покрасочная камера", Group = "Финишная", Status = MachineStatus.Online },
            new MachineResource { Id = 11, Name = "Контроль ОТК", Group = "Финишная", Status = MachineStatus.Online }
        };

        _reservations = new List<MachineReservation>();
        _downtimes = new List<MachineDowntime>();

        var rand = new Random();
        int resId = 1;
        
        foreach (var m in _resources)
        {
            var currentTime = DateTime.Today.AddHours(8);
            
            for (int i = 0; i < 5; i++)
            {
                var duration = rand.Next(2, 12);
                var gap = rand.Next(0, 4);
                
                var startTime = currentTime.AddHours(gap);
                var endTime = startTime.AddHours(duration);
                
                var status = ReservationStatus.Planned;
                if (endTime < DateTime.Now) status = ReservationStatus.Completed;
                else if (startTime < DateTime.Now) status = ReservationStatus.InProgress;
                else if (rand.Next(10) > 8) status = ReservationStatus.Delayed;

                _reservations.Add(new MachineReservation
                {
                    Id = resId++,
                    MachineId = m.Id,
                    OrderNumber = $"ORD-{rand.Next(1000, 9999)}",
                    OperationName = GetRandomOp(m.Group),
                    PartNumber = $"PN-{rand.Next(100, 999)}-{(char)rand.Next(65, 90)}",
                    StartTime = startTime,
                    EndTime = endTime,
                    Status = status,
                    ActualStart = (status == ReservationStatus.InProgress || status == ReservationStatus.Completed) ? startTime : null
                });
                
                currentTime = endTime;
            }

            if (rand.Next(10) > 7)
            {
                _downtimes.Add(new MachineDowntime
                {
                    Id = rand.Next(1000),
                    MachineId = m.Id,
                    Start = DateTime.Today.AddDays(rand.Next(1, 3)).AddHours(rand.Next(8, 16)),
                    End = DateTime.Today.AddDays(rand.Next(1, 3)).AddHours(rand.Next(17, 22)),
                    Reason = DowntimeReason.Maintenance,
                    Note = "Плановое ТО"
                });
            }
        }
    }

    private string GetRandomOp(string group) => group switch
    {
        "Токарная" => "Обточка вала",
        "Фрезерная" => "Фрезеровка паза",
        "Лазерная" => "Резка контура",
        "Сварка" => "Сварка шва",
        _ => "Операция"
    };

    private void GenerateRandomData()
    {
        GenerateData();
        StateHasChanged();
    }

    private void ScrollToNow()
    {
        _start = DateTime.Today.AddDays(-1);
        _end = DateTime.Today.AddDays(7);
        StateHasChanged();
    }

    private void HandleMove(MachineReservation res)
    {
        Console.WriteLine($"Moved {res.OrderNumber} to machine {res.MachineId} at {res.StartTime}");
    }

    public static class Icons
    {
        public const string ZoomIn = @"<svg width=""16"" height=""16"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2"" stroke-linecap=""round"" stroke-linejoin=""round""><circle cx=""11"" cy=""11"" r=""8""/><line x1=""21"" y1=""21"" x2=""16.65"" y2=""16.65""/><line x1=""11"" y1=""8"" x2=""11"" y2=""14""/><line x1=""8"" y1=""11"" x2=""14"" y2=""11""/></svg>";
        public const string ZoomOut = @"<svg width=""16"" height=""16"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2"" stroke-linecap=""round"" stroke-linejoin=""round""><circle cx=""11"" cy=""11"" r=""8""/><line x1=""21"" y1=""21"" x2=""16.65"" y2=""16.65""/><line x1=""8"" y1=""11"" x2=""14"" y2=""11""/></svg>";
    }
}
