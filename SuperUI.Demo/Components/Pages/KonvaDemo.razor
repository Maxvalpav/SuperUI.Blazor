@page "/konva-demo"
@using SuperUI.Components

<PageTitle>План этажа — SUI</PageTitle>

<div class="fp-page">

    <!-- ── Шапка ──────────────────────────────────────────────────────── -->
    <div class="fp-header">
        <div class="fp-header-left">
            <h1 class="fp-title">🏢 План этажа</h1>
            <p class="fp-subtitle">Интерактивная 2D-визуализация на Konva.js — клик по помещению, смена статуса, зум колесом мыши</p>
        </div>
        <div class="fp-header-right">
            <div class="fp-legend">
                <div class="fp-legend-item"><span class="fp-dot fp-dot-available"></span>Свободно</div>
                <div class="fp-legend-item"><span class="fp-dot fp-dot-occupied"></span>Занято</div>
                <div class="fp-legend-item"><span class="fp-dot fp-dot-reserved"></span>Зарезервировано</div>
                <div class="fp-legend-item"><span class="fp-dot fp-dot-maintenance"></span>Обслуживание</div>
                <div class="fp-legend-item"><span class="fp-dot fp-dot-closed"></span>Закрыто</div>
            </div>
        </div>
    </div>

    <!-- ── Тулбар ─────────────────────────────────────────────────────── -->
    <div class="fp-toolbar">
        <div class="fp-toolbar-group">
            <span class="fp-toolbar-label">Этаж</span>
            @foreach (var f in new[]{ 1, 2, 3 })
            {
                var ff = f;
                <button class="fp-btn @(_activeFloor == ff ? "active" : "")"
                        @onclick="@(() => SwitchFloor(ff))">@ff</button>
            }
        </div>
        <div class="fp-toolbar-sep"></div>
        <div class="fp-toolbar-group">
            <button class="fp-btn fp-btn-accent" @onclick="RandomizeStatuses">↻ Случайно</button>
            <label class="fp-toggle-label">
                <input type="checkbox" @bind="_draggable" @bind:after="OnDraggableChanged" />
                <span>Перетаскивание</span>
            </label>
        </div>
        <div class="fp-toolbar-sep"></div>
        <div class="fp-toolbar-group">
            <button class="fp-btn" @onclick="@(() => _konva?.ZoomInAsync())">🔍+</button>
            <button class="fp-btn" @onclick="@(() => _konva?.ZoomOutAsync())">🔍−</button>
            <button class="fp-btn" @onclick="@(() => _konva?.FitViewAsync())">⛶ Вписать</button>
            <button class="fp-btn" @onclick="@(() => _konva?.ExportPngAsync())">⬇ PNG</button>
        </div>

        <!-- Статистика -->
        <div class="fp-toolbar-stats">
            <span class="fp-stat-chip fp-stat-total">Помещений: <b>@_stats.Total</b></span>
            <span class="fp-stat-chip fp-stat-available">Своб: <b>@_stats.Available</b></span>
            <span class="fp-stat-chip fp-stat-occupied">Занято: <b>@_stats.Occupied</b></span>
            <span class="fp-stat-chip fp-stat-reserved">Резерв: <b>@_stats.Reserved</b></span>
            @if (_stats.Total > 0)
            {
                <span class="fp-stat-chip fp-stat-fill">
                    <b>@((_stats.Occupied * 100 / _stats.Total))%</b> занято
                </span>
            }
        </div>
    </div>

    <!-- ── Основная область ────────────────────────────────────────────── -->
    <div class="fp-main">

        <div class="fp-canvas-wrap">
            <SgKonva @ref="_konva"
                     FloorPlan="@_floorPlan"
                     Options="@_konvaOpts"
                     Height="100%"
                     ShowToolbar="false"
                     OnShapeClick="OnRoomClick"
                     OnShapeDrag="OnRoomDrag" />
        </div>

        <!-- Панель помещения -->
        <div class="fp-panel @(_selectedRoom is not null ? "fp-panel-open" : "")">
            @if (_selectedRoom is not null)
            {
                <div class="fp-panel-header">
                    <div>
                        <div class="fp-panel-name">@_selectedRoom.Name</div>
                        <div class="fp-panel-type">@RoomTypeLabel(_selectedRoom.Type)</div>
                    </div>
                    <button class="fp-panel-close" @onclick="() => { _selectedRoom = null; StateHasChanged(); }">✕</button>
                </div>

                <div class="fp-panel-body">

                    <!-- Статус -->
                    <div class="fp-panel-section">
                        <div class="fp-section-title">Статус</div>
                        <div class="fp-status-grid">
                            @foreach (var s in Enum.GetValues<SgFloorRoomStatus>())
                            {
                                var ss = s;
                                <button class="fp-status-btn fp-status-@ss.ToString().ToLower() @(_selectedRoom.Status == ss ? "active" : "")"
                                        @onclick="@(() => SetRoomStatus(ss))">
                                    <span class="fp-status-dot"></span>@StatusLabel(ss)
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Информация -->
                    <div class="fp-panel-section">
                        <div class="fp-section-title">Информация</div>
                        <div class="fp-info-grid">
                            <div class="fp-info-item">
                                <span class="fp-info-label">ID</span>
                                <code class="fp-info-code">@_selectedRoom.Id</code>
                            </div>
                            <div class="fp-info-item">
                                <span class="fp-info-label">Этаж</span>
                                <span class="fp-info-value">@_selectedRoom.Floor</span>
                            </div>
                            @if (_selectedRoom.Capacity.HasValue)
                            {
                                <div class="fp-info-item">
                                    <span class="fp-info-label">Вместимость</span>
                                    <span class="fp-info-value">@_selectedRoom.Capacity чел.</span>
                                </div>
                            }
                            @if (_selectedRoom.CurrentOccupancy.HasValue)
                            {
                                <div class="fp-info-item">
                                    <span class="fp-info-label">Сейчас</span>
                                    <span class="fp-info-value fp-info-occ">@_selectedRoom.CurrentOccupancy чел.</span>
                                </div>
                            }
                            <div class="fp-info-item">
                                <span class="fp-info-label">Площадь</span>
                                <span class="fp-info-value">@(Math.Round(_selectedRoom.Width * _selectedRoom.Height / 100)) м²</span>
                            </div>
                        </div>
                    </div>

                    <!-- Заполненность -->
                    @if (_selectedRoom.Capacity.HasValue && _selectedRoom.CurrentOccupancy.HasValue)
                    {
                        var pct = (int)Math.Round((double)_selectedRoom.CurrentOccupancy.Value / _selectedRoom.Capacity.Value * 100);
                        <div class="fp-panel-section">
                            <div class="fp-section-title">Заполненность — @pct%</div>
                            <div class="fp-occ-bar-bg">
                                <div class="fp-occ-bar-fill @(pct > 85 ? "fp-occ-high" : pct > 60 ? "fp-occ-mid" : "fp-occ-low")"
                                     style="width:@pct%"></div>
                            </div>
                        </div>
                    }

                    <!-- Изменить заполненность -->
                    @if (_selectedRoom.Capacity.HasValue)
                    {
                        <div class="fp-panel-section">
                            <div class="fp-section-title">Текущая заполненность</div>
                            <div class="fp-occ-controls">
                                <button class="fp-occ-btn" @onclick="() => ChangeOccupancy(-5)">−5</button>
                                <button class="fp-occ-btn" @onclick="() => ChangeOccupancy(-1)">−1</button>
                                <span class="fp-occ-value">@(_selectedRoom.CurrentOccupancy ?? 0)</span>
                                <button class="fp-occ-btn" @onclick="() => ChangeOccupancy(+1)">+1</button>
                                <button class="fp-occ-btn" @onclick="() => ChangeOccupancy(+5)">+5</button>
                            </div>
                        </div>
                    }

                </div>
            }
            else
            {
                <div class="fp-panel-empty">
                    <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.3">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <path d="M3 9h18M9 21V9"/>
                    </svg>
                    <p>Кликните на помещение</p>
                </div>
            }
        </div>

    </div>
</div>

