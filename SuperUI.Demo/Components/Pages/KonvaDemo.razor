    // ── Actions ───────────────────────────────────────────────────────────────

    private void SwitchFloor(int floor)
    {
        _activeFloor  = floor;
        _floorPlan    = DeepCopy(_floors[floor]);
        _selectedRoom = null;
        RecalcStats();
        StateHasChanged();
    }

    private void RandomizeStatuses()
    {
        if (_floorPlan is null) return;
        var statuses = new[] {
            SgFloorRoomStatus.Available, SgFloorRoomStatus.Available, SgFloorRoomStatus.Available,
            SgFloorRoomStatus.Occupied,  SgFloorRoomStatus.Occupied,
            SgFloorRoomStatus.Reserved,
            SgFloorRoomStatus.Maintenance,
        };
        foreach (var r in _floorPlan.Rooms)
        {
            if (r.Type is SgFloorRoomType.Corridor or SgFloorRoomType.Stairs or SgFloorRoomType.Elevator)
                continue;
            r.Status = statuses[_rnd.Next(statuses.Length)];
            if (r.Capacity.HasValue)
                r.CurrentOccupancy = r.Status == SgFloorRoomStatus.Occupied
                    ? _rnd.Next(1, r.Capacity.Value + 1)
                    : r.Status == SgFloorRoomStatus.Available
                        ? _rnd.Next(0, (int)(r.Capacity.Value * 0.5) + 1)
                        : 0;
        }
        RecalcStats();
        StateHasChanged();
    }

    private async Task OnDraggableChanged()
    {
        _konvaOpts = new SgKonvaOptions { DraggableRooms = _draggable };
        if (_konva is not null) await _konva.RefreshAsync();
    }

    private void OnRoomClick(SgKonvaClickEventArgs e)
    {
        if (string.IsNullOrEmpty(e.Id)) return;

        // First try to find room directly from the floor plan (most reliable)
        var room = _floorPlan?.Rooms.FirstOrDefault(r => r.Id == e.Id);
        if (room is not null)
        {
            _selectedRoom = room;
            StateHasChanged();
            return;
        }

        // Fallback: deserialize from Data payload
        if (!string.IsNullOrEmpty(e.Data))
        {
            try
            {
                _selectedRoom = System.Text.Json.JsonSerializer.Deserialize<SgFloorRoom>(
                    e.Data,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            }
            catch
            {
                _selectedRoom = new() { Id = e.Id, Name = e.Id };
            }
        }
        else
        {
            _selectedRoom = new() { Id = e.Id, Name = e.Id };
        }

        StateHasChanged();
    }

    private void OnRoomDrag(SgKonvaDragEventArgs e)
    {
        var room = _floorPlan?.Rooms.FirstOrDefault(r => r.Id == e.Id);
        if (room is null) return;
        room.X = e.X;
        room.Y = e.Y;
    }

    private async Task SetRoomStatus(SgFloorRoomStatus status)
    {
        if (_selectedRoom is null || _floorPlan is null) return;
        _selectedRoom.Status = status;
        var r = _floorPlan.Rooms.FirstOrDefault(x => x.Id == _selectedRoom.Id);
        if (r is not null) r.Status = status;
        RecalcStats();
        if (_konva is not null)
            await _konva.UpdateRoomStatusAsync(_selectedRoom.Id, status);
        StateHasChanged();
    }

    private async Task ChangeOccupancy(int delta)
    {
        if (_selectedRoom is null || !_selectedRoom.Capacity.HasValue) return;
        var cur = _selectedRoom.CurrentOccupancy ?? 0;
        _selectedRoom.CurrentOccupancy = Math.Clamp(cur + delta, 0, _selectedRoom.Capacity.Value);
        var r = _floorPlan?.Rooms.FirstOrDefault(x => x.Id == _selectedRoom.Id);
        if (r is not null) r.CurrentOccupancy = _selectedRoom.CurrentOccupancy;
        if (_konva is not null) await _konva.RefreshAsync();
        StateHasChanged();
    }

    private void RecalcStats()
    {
        if (_floorPlan is null) { _stats = new(0,0,0,0); return; }
        var rooms = _floorPlan.Rooms.Where(r =>
            r.Type is not SgFloorRoomType.Corridor and
                      not SgFloorRoomType.Stairs and
                      not SgFloorRoomType.Elevator).ToList();
        _stats = new(
            rooms.Count,
            rooms.Count(r => r.Status == SgFloorRoomStatus.Available),
            rooms.Count(r => r.Status == SgFloorRoomStatus.Occupied),
            rooms.Count(r => r.Status == SgFloorRoomStatus.Reserved));
    }

    // Deep copy to avoid mutating the static template
    private static SgFloorPlan DeepCopy(SgFloorPlan src) => new()
    {
        Name   = src.Name,
        Width  = src.Width,
        Height = src.Height,
        Walls  = src.Walls.Select(w => new SgFloorWall { X1=w.X1, Y1=w.Y1, X2=w.X2, Y2=w.Y2, Thickness=w.Thickness }).ToList(),
        Rooms  = src.Rooms.Select(r => new SgFloorRoom
        {
            Id               = r.Id,
            Name             = r.Name,
            Type             = r.Type,
            Status           = r.Status,
            X                = r.X,
            Y                = r.Y,
            Width            = r.Width,
            Height           = r.Height,
            Capacity         = r.Capacity,
            CurrentOccupancy = r.CurrentOccupancy,
            Floor            = r.Floor,
            Meta             = r.Meta,
        }).ToList(),
    };

    protected override void OnInitialized() => SwitchFloor(1);
}
