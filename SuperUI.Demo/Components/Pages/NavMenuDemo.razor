@code {
    // ═══════════════════════════════════════════════════════════════════════
    // Main header
    // ═══════════════════════════════════════════════════════════════════════
    private RenderFragment _mainHeader => __builder =>
    {
        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
            
            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">Navigation Components</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    SgNavMenu / SgNavGroup / SgNavLink — sidebar navigation with collapsible groups, badges, icons, search, accordion mode, and responsive mobile behavior.
                </SgTypography>
            </SgStack>
        </SgStack>
    };

    // ═══════════════════════════════════════════════════════════════════════
    // Section 1 — NavMenu state
    // ═══════════════════════════════════════════════════════════════════════
    private bool _navMini;
    private bool _navBorderless;
    private bool _navRounded;
    private bool _navCollapsible = true;
    private bool _navShowSearch = true;
    private bool _navAccordion;
    private bool _navGroupDisabled;
    private bool _navGroup1Expanded = true;
    private bool _navGroup2Expanded;
    private bool _navGroup3Expanded = true;
    private SgOrientation _navOrientation = SgOrientation.Vertical;

    private string[] _navCodeLines = Array.Empty<string>();

    private void UpdateNavCode()
    {
        var lines = new List<string>();
        lines.Add("<SgNavMenu Title=\"SuperUI\"");
        if (!_navCollapsible) lines.Add("           Collapsible=\"false\"");
        if (_navShowSearch) lines.Add("           ShowSearch=\"true\"");
        if (_navMini) lines.Add("           Mini=\"true\"");
        if (_navBorderless) lines.Add("           Borderless=\"true\"");
        if (_navRounded) lines.Add("           Rounded=\"true\"");
        if (_navAccordion) lines.Add("           Accordion=\"true\"");
        if (_navOrientation == SgOrientation.Horizontal) lines.Add("           Orientation=\"Horizontal\"");
        lines.Add("           SearchPlaceholder=\"Search...\">");
        lines.Add("    <SgNavLink Href=\"/\" Icon=\"@SgIcons.Home\">Dashboard</SgNavLink>");
        lines.Add("    <SgNavGroup Title=\"Components\" Icon=\"@SgIcons.Box\">");
        lines.Add("        <SgNavLink Href=\"/inputs\" Icon=\"@SgIcons.Edit\">Inputs</SgNavLink>");
        lines.Add("        <SgNavLink Href=\"/data\" Icon=\"@SgIcons.Table\" BadgeText=\"New\">Data Grid</SgNavLink>");
        lines.Add("    </SgNavGroup>");
        lines.Add("    <SgNavGroup Title=\"Analytics\" Icon=\"@SgIcons.Chart\" BadgeText=\"Pro\">");
        lines.Add("        <SgNavLink Href=\"/charts\" Icon=\"@SgIcons.BarChart\">Charts</SgNavLink>");
        lines.Add("    </SgNavGroup>");
        lines.Add("</SgNavMenu>");
        _navCodeLines = lines.ToArray();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Section 3 — Constructor state
    // ═══════════════════════════════════════════════════════════════════════
    private string _ctorTitle = "My App";
    private bool _ctorCollapsible = true;
    private bool _ctorShowSearch = true;
    private bool _ctorMini;
    private bool _ctorBorderless;
    private bool _ctorRounded;
    private bool _ctorAccordion;
    private int _ctorGroupCount = 3;

    private string _ctorCopyIcon = "📋";
    private string _ctorCopyLabel = "Copy";
    private string[] _ctorCodeLines = Array.Empty<string>();

    private readonly string[] _groupNames = { "Getting Started", "Components", "Settings", "Analytics", "Tools" };
    private readonly string[] _groupIcons = { SgIcons.Book, SgIcons.Box, SgIcons.Settings, SgIcons.Chart, SgIcons.Zap };
    private readonly string[] _groupIconNames = { "SgIcons.Book", "SgIcons.Box", "SgIcons.Settings", "SgIcons.Chart", "SgIcons.Zap" };
    private readonly string[] _linkNames = { "Introduction", "Installation", "Configuration", "Buttons", "Forms", "Tables", "Profile", "Security", "Billing", "Reports", "Dashboard", "Metrics", "Calculator", "Converter", "Export" };

    private readonly List<SgSegmentedOption<bool>> _boolSegOffOn = new()
    {
        new() { Value = false, Label = "Off" },
        new() { Value = true,  Label = "On" },
    };

    private readonly List<SgSegmentedOption<bool>> _boolSegYesNo = new()
    {
        new() { Value = true,  Label = "Yes" },
        new() { Value = false, Label = "No" },
    };

    private readonly List<SgSegmentedOption<int>> _groupCountOptions = new()
    {
        new() { Value = 1, Label = "1" },
        new() { Value = 2, Label = "2" },
        new() { Value = 3, Label = "3" },
        new() { Value = 4, Label = "4" },
        new() { Value = 5, Label = "5" },
    };

    private readonly List<SgSegmentedOption<SgOrientation>> _orientationOptions = new()
    {
        new() { Value = SgOrientation.Vertical, Label = "Vertical" },
        new() { Value = SgOrientation.Horizontal, Label = "Horizontal" },
    };

    // ═══════════════════════════════════════════════════════════════════════
    // Lifecycle
    // ═══════════════════════════════════════════════════════════════════════
    protected override void OnInitialized()
    {
        UpdateNavCode();
        UpdateCtorCode();
    }

    private void OnCtorTitleChange(ChangeEventArgs e)
    {
        _ctorTitle = e.Value?.ToString() ?? "My App";
        UpdateCtorCode();
    }

    private void UpdateCtorCode()
    {
        var lines = new List<string>();
        lines.Add($"<SgNavMenu Title=\"{_ctorTitle}\"");
        if (!_ctorCollapsible) lines.Add($"           Collapsible=\"false\"");
        if (_ctorShowSearch) lines.Add($"           ShowSearch=\"true\"");
        if (_ctorMini) lines.Add($"           Mini=\"true\"");
        if (_ctorBorderless) lines.Add($"           Borderless=\"true\"");
        if (_ctorRounded) lines.Add($"           Rounded=\"true\"");
        if (_ctorAccordion) lines.Add($"           Accordion=\"true\"");
        lines.Add($"           SearchPlaceholder=\"Search...\">");
        for (int i = 0; i < _ctorGroupCount; i++)
        {
            var name = _groupNames[i % _groupNames.Length];
            var iconName = _groupIconNames[i % _groupIconNames.Length];
            lines.Add($"    <SgNavGroup Title=\"{name}\" Icon=\"@{iconName}\">");
            lines.Add($"        <SgNavLink Href=\"#\" Text=\"Item {i * 3 + 1}\" />");
            lines.Add($"        <SgNavLink Href=\"#\" Text=\"Item {i * 3 + 2}\" />");
            lines.Add($"        <SgNavLink Href=\"#\" Text=\"Item {i * 3 + 3}\" />");
            lines.Add($"    </SgNavGroup>");
        }
        lines.Add($"    <SgNavLink Href=\"#\" Text=\"Home\" Icon=\"@SgIcons.Home\" />");
        lines.Add("</SgNavMenu>");
        _ctorCodeLines = lines.ToArray();
    }

    private async Task CopyCtorCodeAsync()
    {
        var code = string.Join("\n", _ctorCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _ctorCopyIcon = "✓";
            _ctorCopyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _ctorCopyIcon = "📋";
            _ctorCopyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _ctorCopyIcon = "✗";
            _ctorCopyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _ctorCopyIcon = "📋";
            _ctorCopyLabel = "Copy";
            StateHasChanged();
        }
    }

