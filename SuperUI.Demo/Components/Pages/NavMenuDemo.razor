@page "/navmenu-demo"
@using SuperUI.Components

<PageTitle>NavMenu - SUI</PageTitle>

<SgCard Title="SgNavMenu - Боковое меню навигации"
        Subtitle="Компонент для создания боковой панели навигации приложения. Поддерживает вложенные группы ссылок, свертывание, кастомный логотип и подвал.">

    <div style="margin-top: 32px;">
        <h2>Пример использования</h2>
        <p>SgNavMenu с группами и ссылками.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Пример">
                <div style="height: 400px; border: 1px solid var(--sui-border); border-radius: 4px; overflow: hidden;">
                    <SgNavMenu Title="SuperUI">
                        <SgNavLink Href="/" Icon="🏠" Match="NavLinkMatch.All">Главная</SgNavLink>
                        <SgNavGroup Title="Компоненты" Icon="🧩" Expanded="true">
                            <SgNavLink Href="/inputs" Icon="⌨️">Ввод</SgNavLink>
                            <SgNavLink Href="/feedback" Icon="💬">Обратная связь</SgNavLink>
                            <SgNavLink Href="/layout" Icon="📐">Макет</SgNavLink>
                        </SgNavGroup>
                        <SgNavGroup Title="Настройки" Icon="⚙️" Expanded="false">
                            <SgNavLink Href="/profile" Icon="👤">Профиль</SgNavLink>
                            <SgNavLink Href="/security" Icon="🔒">Безопасность</SgNavLink>
                        </SgNavGroup>
                        <SgNavLink Href="/docs" Icon="📖">Документация</SgNavLink>
                    </SgNavMenu>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_navMenuProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Вложенные компоненты</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="SgNavLink">
                <PropertyTable Items="_navLinkProperties" />
            </SgCard>
            <SgCard Title="SgNavGroup">
                <PropertyTable Items="_navGroupProperties" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private List<PropertyPanelItem> _navMenuProperties = new()
    {
        new() { Label = "Title", Value = "string", BadgeText = "Заголовок", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Collapsible", Value = "bool", BadgeText = "Сворачиваемое", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Collapsed", Value = "bool", BadgeText = "Свёрнуто", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "LogoContent", Value = "RenderFragment", BadgeText = "Логотип", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "FooterContent", Value = "RenderFragment", BadgeText = "Подвал", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "CssClass", Value = "string", BadgeText = "CSS класс", BadgeVariant = SgBadgeVariant.Info }
    };

    private List<PropertyPanelItem> _navLinkProperties = new()
    {
        new() { Label = "Href", Value = "string", BadgeText = "Ссылка", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Icon", Value = "string", BadgeText = "Иконка", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Text", Value = "string", BadgeText = "Текст", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Match", Value = "NavLinkMatch", BadgeText = "Совпадение", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Содержимое", BadgeVariant = SgBadgeVariant.Info }
    };

    private List<PropertyPanelItem> _navGroupProperties = new()
    {
        new() { Label = "Title", Value = "string", BadgeText = "Заголовок", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Icon", Value = "string", BadgeText = "Иконка", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Expanded", Value = "bool", BadgeText = "Развёрнуто", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Содержимое", BadgeVariant = SgBadgeVariant.Info }
    };
}
