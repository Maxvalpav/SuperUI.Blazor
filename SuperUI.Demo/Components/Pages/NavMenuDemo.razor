@page "/navmenu-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>SgNavMenu — Navigation Components — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. SgNavMenu — Sidebar Navigation                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgNavMenu — Sidebar Navigation
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                A collapsible sidebar with nested groups, search, mini mode, badges,
                and full responsive mobile behavior. All parameters optional.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Live Preview" Shadow="SgShadow.Sm" Size="SgSize.Sm" NoPadding="true">
                <div class="demo-nav-preview">
                    <SgNavMenu Title="SuperUI"
                               Collapsible="@_navCollapsible"
                               ShowSearch="@_navShowSearch"
                               SearchPlaceholder="Search..."
                               Borderless="@_navBorderless"
                               Rounded="@_navRounded"
                               Mini="@_navMini"
                               MiniChanged="@((v) => { _navMini = v; StateHasChanged(); })"
                               Accordion="@_navAccordion"
                               Orientation="@_navOrientation"
                               OrientationChanged="@((v) => { _navOrientation = v; StateHasChanged(); UpdateNavCode(); })">
                        <SgNavLink Href="/navmenu-demo" Icon="@SgIcons.Home" Match="NavLinkMatch.All">Dashboard</SgNavLink>
                        <SgNavGroup Title="Components" Icon="@SgIcons.Box" Expanded="@_navGroup1Expanded" OnToggle="@((v) => { _navGroup1Expanded = v; StateHasChanged(); })">
                            <SgNavLink Href="/inputs" Icon="@SgIcons.Edit">Input Controls</SgNavLink>
                            <SgNavLink Href="/feedback" Icon="@SgIcons.Bell">Feedback</SgNavLink>
                            <SgNavLink Href="/layout" Icon="@SgIcons.Layout">Layout</SgNavLink>
                            <SgNavLink Href="/data" Icon="@SgIcons.Table" BadgeText="New" BadgeVariant="SgBadgeVariant.Success">Data Grid</SgNavLink>
                        </SgNavGroup>
                        <SgNavGroup Title="Analytics" Icon="@SgIcons.Chart" Expanded="@_navGroup2Expanded" OnToggle="@((v) => { _navGroup2Expanded = v; StateHasChanged(); })" BadgeText="Pro" BadgeVariant="SgBadgeVariant.Info">
                            <SgNavLink Href="/charts" Icon="@SgIcons.BarChart">Charts</SgNavLink>
                            <SgNavLink Href="/reports" Icon="@SgIcons.FileText" BadgeText="3" BadgeVariant="SgBadgeVariant.Info">Reports</SgNavLink>
                            <SgNavLink Href="/dashboard" Icon="@SgIcons.Gauge">Dashboard</SgNavLink>
                        </SgNavGroup>
                        <SgNavGroup Title="Settings" Icon="@SgIcons.Settings" Expanded="@_navGroup3Expanded" OnToggle="@((v) => { _navGroup3Expanded = v; StateHasChanged(); })" Disabled="@_navGroupDisabled">
                            <SgNavLink Href="/profile" Icon="@SgIcons.User">Profile</SgNavLink>
                            <SgNavLink Href="/security" Icon="@SgIcons.Shield">Security</SgNavLink>
                        </SgNavGroup>
                        <SgNavLink Href="/docs" Icon="@SgIcons.Book">Documentation</SgNavLink>
                        <SgNavLink Href="/help" Icon="@SgIcons.HelpCircle" BadgeText="?" BadgeVariant="SgBadgeVariant.Default">Help Center</SgNavLink>
                    </SgNavMenu>
                </div>
            </SgCard>

            <SgCard Title="Controls" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Collapsible</SgTypography>
                        <SgSegmented TValue="bool"
                                     Value="_navCollapsible"
                                     ValueChanged="v => { _navCollapsible = v; StateHasChanged(); UpdateNavCode(); }"
                                     Size="sm"
                                     Options="@_boolSegOffOn" />
                    </SgStack>
                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">ShowSearch</SgTypography>
                        <SgSegmented TValue="bool"
                                     Value="_navShowSearch"
                                     ValueChanged="v => { _navShowSearch = v; StateHasChanged(); UpdateNavCode(); }"
                                     Size="sm"
                                     Options="@_boolSegOffOn" />
                    </SgStack>
                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Mini Mode</SgTypography>
                        <SgSegmented TValue="bool"
                                     Value="_navMini"
                                     ValueChanged="v => { _navMini = v; StateHasChanged(); UpdateNavCode(); }"
                                     Size="sm"
                                     Options="@_boolSegOffOn" />
                    </SgStack>
                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Borderless</SgTypography>
                        <SgSegmented TValue="bool"
                                     Value="_navBorderless"
                                     ValueChanged="v => { _navBorderless = v; StateHasChanged(); UpdateNavCode(); }"
                                     Size="sm"
                                     Options="@_boolSegOffOn" />
                    </SgStack>
                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Rounded</SgTypography>
                        <SgSegmented TValue="bool"
                                     Value="_navRounded"
                                     ValueChanged="v => { _navRounded = v; StateHasChanged(); UpdateNavCode(); }"
                                     Size="sm"
                                     Options="@_boolSegOffOn" />
                    </SgStack>
                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Accordion</SgTypography>
                        <SgSegmented TValue="bool"
                                     Value="_navAccordion"
                                     ValueChanged="v => { _navAccordion = v; StateHasChanged(); UpdateNavCode(); }"
                                     Size="sm"
                                     Options="@_boolSegOffOn" />
                    </SgStack>
                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Orientation</SgTypography>
                        <SgSegmented TValue="SgOrientation"
                                     Value="_navOrientation"
                                     ValueChanged="v => { _navOrientation = v; StateHasChanged(); UpdateNavCode(); }"
                                     Size="sm"
                                     Options="@_orientationOptions" />
                    </SgStack>
                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Settings Disabled</SgTypography>
                        <SgSegmented TValue="bool"
                                     Value="_navGroupDisabled"
                                     ValueChanged="v => { _navGroupDisabled = v; StateHasChanged(); }"
                                     Size="sm"
                                     Options="@_boolSegOffOn" />
                    </SgStack>

                    <SgDivider />

                    <SgStack Vertical Space="SgSize.Sm">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                        <div class="code-block" style="max-height:200px;overflow-y:auto;">
                            @foreach (var line in _navCodeLines)
                            {
                                <code>@line</code>
                            }
                        </div>
                    </SgStack>
                </SgStack>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. SgNavGroup & SgNavLink — Nested Navigation Features              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgNavGroup & SgNavLink — Feature Showcase
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Groups with expand/collapse, badges, disabled items, nested groups,
                external links, keyboard shortcut hints, and full active-state detection.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Group Features" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Badge on Group
                                <SgTag Variant="SgTagVariant.Info" Size="SgSize.Sm" Style="margin-left:8px;">BadgeText + BadgeVariant</SgTag>
                            </SgTypography>
                            <div class="demo-nav-mini">
                                <SgNavGroup Title="Notifications" Icon="@SgIcons.Bell" Expanded="true" BadgeText="12" BadgeVariant="SgBadgeVariant.Warn">
                                    <SgNavLink Href="#" Text="Inbox" />
                                    <SgNavLink Href="#" Text="Archived" />
                                </SgNavGroup>
                            </div>
                        </div>
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Disabled Group
                                <SgTag Variant="SgTagVariant.Warn" Size="SgSize.Sm" Style="margin-left:8px;">Disabled=true</SgTag>
                            </SgTypography>
                            <div class="demo-nav-mini">
                                <SgNavGroup Title="Coming Soon" Icon="@SgIcons.Tag" Expanded="false" Disabled="true">
                                    <SgNavLink Href="#" Text="Feature A" />
                                    <SgNavLink Href="#" Text="Feature B" />
                                </SgNavGroup>
                            </div>
                        </div>
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Nested Groups
                                <SgTag Variant="SgTagVariant.Success" Size="SgSize.Sm" Style="margin-left:8px;">Group in Group</SgTag>
                            </SgTypography>
                            <div class="demo-nav-mini">
                                <SgNavGroup Title="Visuals" Icon="@SgIcons.PieChart" Expanded="true">
                                    <SgNavGroup Title="Charts" Icon="@SgIcons.BarChart" Expanded="true">
                                        <SgNavLink Href="#" Text="Chart.js" ActiveClass="active" />
                                        <SgNavLink Href="#" Text="D3.js" />
                                    </SgNavGroup>
                                    <SgNavGroup Title="Maps" Icon="@SgIcons.Globe" Expanded="false">
                                        <SgNavLink Href="#" Text="OpenLayers" />
                                        <SgNavLink Href="#" Text="Leaflet" />
                                    </SgNavGroup>
                                </SgNavGroup>
                            </div>
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>

            <SgCol Md="6">
                <SgCard Title="Link Features" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Badge on Link
                                <SgTag Variant="SgTagVariant.Info" Size="SgSize.Sm" Style="margin-left:8px;">BadgeText + BadgeVariant</SgTag>
                            </SgTypography>
                            <div class="demo-nav-mini">
                                <SgNavLink Href="#" Text="Inbox" Icon="@SgIcons.Bell" BadgeText="99+" BadgeVariant="SgBadgeVariant.Danger" />
                                <SgNavLink Href="#" Text="Tasks" Icon="@SgIcons.Check" BadgeText="5" BadgeVariant="SgBadgeVariant.Info" />
                                <SgNavLink Href="#" Text="Drafts" Icon="@SgIcons.Edit" BadgeText="2" BadgeVariant="SgBadgeVariant.Warn" />
                            </div>
                        </div>
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Shortcut Hints
                                <SgTag Variant="SgTagVariant.Info" Size="SgSize.Sm" Style="margin-left:8px;">ShortcutHint</SgTag>
                            </SgTypography>
                            <div class="demo-nav-mini">
                                <SgNavLink Href="#" Text="Quick Search" Icon="@SgIcons.Search" ShortcutHint="Ctrl+K" />
                                <SgNavLink Href="#" Text="New Document" Icon="@SgIcons.Edit" ShortcutHint="Ctrl+N" />
                                <SgNavLink Href="#" Text="Save All" Icon="@SgIcons.Download" ShortcutHint="Ctrl+S" />
                            </div>
                        </div>
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                External Link & Disabled
                                <SgTag Variant="SgTagVariant.Warn" Size="SgSize.Sm" Style="margin-left:8px;">Target / Disabled</SgTag>
                            </SgTypography>
                            <div class="demo-nav-mini">
                                <SgNavLink Href="https://google.com" Text="Google (External)" Icon="@SgIcons.Globe" Target="_blank" ShowExternalIcon="true" />
                                <SgNavLink Href="#" Text="Disabled Link" Icon="@SgIcons.Shield" Disabled="true" />
                            </div>
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>

        <SgRow Space="SgSize.Lg" Style="margin-top:24px;">
            <SgCol Md="6">
                <SgCard Title="SgNavGroup Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_navGroupProperties" />
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="SgNavLink Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_navLinkProperties" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Live Constructor                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live SgNav Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Build a custom nav menu interactively. Toggle features and copy the generated code.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Title -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Nav Title</SgTypography>
                            <input type="text" class="demo-ctrl-input"
                                   value="@_ctorTitle"
                                   @oninput="OnCtorTitleChange"
                                   placeholder="My App" />
                        </SgStack>

                        <!-- Toggles -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Collapsible</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorCollapsible"
                                                 ValueChanged="v => { _ctorCollapsible = v; UpdateCtorCode(); }"
                                                 Size="sm"
                                                 Block="true"
                                                 Options="@_boolSegYesNo" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Search</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorShowSearch"
                                                 ValueChanged="v => { _ctorShowSearch = v; UpdateCtorCode(); }"
                                                 Size="sm"
                                                 Block="true"
                                                 Options="@_boolSegYesNo" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Accordion</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorAccordion"
                                                 ValueChanged="v => { _ctorAccordion = v; UpdateCtorCode(); }"
                                                 Size="sm"
                                                 Block="true"
                                                 Options="@_boolSegYesNo" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Mini</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorMini"
                                                 ValueChanged="v => { _ctorMini = v; UpdateCtorCode(); }"
                                                 Size="sm"
                                                 Block="true"
                                                 Options="@_boolSegYesNo" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Borderless</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorBorderless"
                                                 ValueChanged="v => { _ctorBorderless = v; UpdateCtorCode(); }"
                                                 Size="sm"
                                                 Block="true"
                                                 Options="@_boolSegYesNo" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Rounded</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorRounded"
                                                 ValueChanged="v => { _ctorRounded = v; UpdateCtorCode(); }"
                                                 Size="sm"
                                                 Block="true"
                                                 Options="@_boolSegYesNo" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Groups -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Group Count</SgTypography>
                            <SgSegmented TValue="int"
                                         Value="_ctorGroupCount"
                                         ValueChanged="v => { _ctorGroupCount = v; UpdateCtorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="@_groupCountOptions" />
                        </SgStack>

                        <!-- Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Title</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorTitle" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Groups</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Success" Text="@_ctorGroupCount.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Mode</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@(_ctorMini ? "Mini" : _ctorAccordion ? "Accordion" : "Normal")" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <div class="constructor-preview" id="ctor-preview">
                                <SgNavMenu Title="@_ctorTitle"
                                           Collapsible="@_ctorCollapsible"
                                           ShowSearch="@_ctorShowSearch"
                                           Mini="@_ctorMini"
                                           Borderless="@_ctorBorderless"
                                           Rounded="@_ctorRounded"
                                           Accordion="@_ctorAccordion">
                                    @for (int i = 0; i < _ctorGroupCount; i++)
                                    {
                                        var idx = i;
                                        <SgNavGroup Title="@_groupNames[idx % _groupNames.Length]"
                                                     Icon="@_groupIcons[idx % _groupIcons.Length]"
                                                     Expanded="@(i == 0)">
                                            @for (int j = 0; j < 3; j++)
                                            {
                                                <SgNavLink Href="#" Text="@_linkNames[(idx * 3 + j) % _linkNames.Length]" />
                                            }
                                        </SgNavGroup>
                                    }
                                    <SgNavLink Href="#" Text="Home" Icon="@SgIcons.Home" />
                                </SgNavMenu>
                            </div>
                        </SgStack>

                        <!-- Code with Copy -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCtorCodeAsync">
                                    <span id="ctor-copy-icon">@_ctorCopyIcon</span>
                                    <span id="ctor-copy-text" style="font-size:11px;font-weight:600;">@_ctorCopyLabel</span>
                                </button>
                            </div>
                            <div class="code-block" id="ctor-code-block">
                                @foreach (var line in _ctorCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

    </ChildContent>
</SgCard>

<style>
    /* ── Section layout ─────────────────────────────────────────────────────── */
    .demo-section {
        margin-top: 48px;
    }
    .demo-section-header {
        margin-bottom: 20px;
    }

    .demo-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
