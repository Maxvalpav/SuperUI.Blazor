@page "/permission-gate-demo"
@using SuperUI.Components

<PageTitle>PermissionGate - SUI</PageTitle>

<SgCard Title="SgPermissionGate - Условный рендеринг"
        Subtitle="Компонент для управления доступом на основе прав и ролей пользователя.">

    <div style="margin-top: 32px;">
        <h2>Примеры использования</h2>
        <p>Демонстрация различных режимов проверки прав доступа.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Проверка по разрешению">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Permission="CanEdit"</div>
                        <SgPermissionGate Permission="CanEdit">
                            <div style="padding: 12px; background: var(--sui-success); color: white; border-radius: var(--sui-radius);">
                                ✓ Контент виден - у пользователя есть право CanEdit
                            </div>
                        </SgPermissionGate>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Permission="CanDelete" (нет доступа)</div>
                        <SgPermissionGate Permission="CanDelete">
                            <div style="padding: 12px; background: var(--sui-success); color: white; border-radius: var(--sui-radius);">
                                Контент виден
                            </div>
                        </SgPermissionGate>
                        <div style="padding: 8px; color: var(--sui-text-muted); font-size: 12px;">
                            Контент не отображается (нет права CanDelete)
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Несколько разрешений (OR логика)">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Любое из разрешений</div>
                        <SgPermissionGate Permissions="@(new[] { "CanView", "CanEdit" })">
                            <div style="padding: 12px; background: var(--sui-success); color: white; border-radius: var(--sui-radius);">
                                ✓ Видно - есть хотя бы одно разрешение
                            </div>
                        </SgPermissionGate>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Fallback контент</div>
                        <SgPermissionGate Permission="AdminOnly">
                            <ChildContent>
                                <div style="padding: 12px; background: var(--sui-success); color: white; border-radius: var(--sui-radius);">
                                    Админ контент
                                </div>
                            </ChildContent>
                            <FallbackContent>
                                <div style="padding: 12px; background: var(--sui-bg-secondary); border-radius: var(--sui-radius);">
                                    <SgBadge Text="Ограниченный доступ" Variant="warn" />
                                    <p style="margin: 8px 0 0; font-size: 12px;">
                                        У вас нет прав для просмотра этого контента.
                                    </p>
                                </div>
                            </FallbackContent>
                        </SgPermissionGate>
                    </div>
                </div>
            </SgCard>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 24px;">
            <SgCard Title="Проверка по ролям">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Role="Admin"</div>
                        <SgPermissionGate Role="Admin">
                            <div style="padding: 12px; background: var(--sui-success); color: white; border-radius: var(--sui-radius);">
                                ✓ Панель администратора доступна
                            </div>
                        </SgPermissionGate>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Любая из ролей</div>
                        <SgPermissionGate Roles="@(new[] { "Manager", "Editor" })">
                            <div style="padding: 12px; background: var(--sui-info); color: white; border-radius: var(--sui-radius);">
                                ✓ Менеджер/Редактор функции
                            </div>
                        </SgPermissionGate>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Требовать все разрешения (AND логика)">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">RequireAll="true"</div>
                        <SgPermissionGate Permissions="@(new[] { "CanView", "CanEdit" })" RequireAll="true">
                            <div style="padding: 12px; background: var(--sui-success); color: white; border-radius: var(--sui-radius);">
                                ✓ Все разрешения присутствуют
                            </div>
                        </SgPermissionGate>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">RequireAllPermissions</div>
                        <SgPermissionGate RequireAllPermissions="@(new[] { "CanCreate", "CanEdit", "CanDelete" })">
                            <div style="padding: 12px; background: var(--sui-success); color: white; border-radius: var(--sui-radius);">
                                ✓ Полный доступ
                            </div>
                        </SgPermissionGate>
                    </div>
                </div>
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h3>Интеграция с IPermissionService</h3>
        <p>Реализуйте интерфейс для интеграции с вашей системой авторизации:</p>
        <pre style="background: var(--sui-bg-secondary); padding: 16px; border-radius: var(--sui-radius); overflow-x: auto;">
<code>@("public interface IPermissionService\n{\n    Task<bool> HasPermissionAsync(string permission);\n    Task<bool> IsInRoleAsync(string role);\n    Task<IEnumerable<string>> GetUserPermissionsAsync();\n    Task<IEnumerable<string>> GetUserRolesAsync();\n}")</code>
        </pre>
    </div>

</SgCard>

@code {
}
