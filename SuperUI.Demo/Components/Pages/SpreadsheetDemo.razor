@page "/spreadsheet-demo"
@using SuperUI.Components

<PageTitle>Spreadsheet — SuperUI</PageTitle>

<SgCard Title="SgSpreadsheet — Электронная таблица"
        Subtitle="Красивый и функциональный компонент для работы с табличными данными. Поддерживает редактирование, форматирование, выделение строк и столбцов.">
    
    <!-- Базовый пример -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Базовый пример</SgTypography>
        <p>Простая электронная таблица с возможностью редактирования ячеек.</p>
        
        <SgCard Title="Пример" Style="margin-top: 16px;">
            <SgSpreadsheet Title="Моя таблица"
                         Description="Двойной клик для редактирования ячейки"
                         Rows="10"
                         Columns="@_basicColumns" />
        </SgCard>
    </div>

    <!-- Создание новой таблицы -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Создание таблицы</SgTypography>
        <p>Если строки или столбцы не заданы, отображается пустое состояние с кнопкой создания.</p>
        
        <SgCard Title="Пустая таблица" Style="margin-top: 16px;">
            <SgSpreadsheet Title="Новая таблица" />
        </SgCard>
    </div>

    <!-- С формулой и статусбаром -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Строка формул и статус-бар</SgTypography>
        <p>Строка формул позволяет редактировать выбранную ячейку, а статус-бар показывает статистику.</p>
        
        <SgCard Title="Пример" Style="margin-top: 16px;">
            <SgSpreadsheet Title="Таблица с формулами"
                         Rows="15"
                         Columns="@_formulaColumns"
                         ShowFormulaBar="true"
                         ShowStatusBar="true" />
        </SgCard>
    </div>

    <!-- Только чтение -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Режим только чтение</SgTypography>
        <p>Таблица доступна только для просмотра.</p>
        
        <SgCard Title="Пример" Style="margin-top: 16px;">
            <SgSpreadsheet Title="Таблица (только чтение)"
                         Rows="5"
                         Columns="@_readOnlyColumns"
                         ReadOnly="true" />
        </SgCard>
    </div>

    <!-- Компактный вид -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Компактный вид</SgTypography>
        <p>Уменьшенные отступы и размер шрифта.</p>
        
        <SgCard Title="Пример" Style="margin-top: 16px;">
            <SgSpreadsheet Title="Компактная таблица"
                         Rows="8"
                         Columns="@_compactColumns"
                         Compact="true" />
        </SgCard>
    </div>

    <!-- Без тулбара -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Без панели инструментов</SgTypography>
        <p>Скрытие панели инструментов для упрощенного вида.</p>
        
        <SgCard Title="Пример" Style="margin-top: 16px;">
            <SgSpreadsheet Title="Таблица без тулбара"
                         Rows="6"
                         Columns="@_noToolbarColumns"
                         ShowToolbar="false" />
        </SgCard>
    </div>

    <!-- Свойства компонента -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Свойства</SgTypography>
        <SgCard Title="Параметры SgSpreadsheet" Style="margin-top: 16px;">
            <PropertyTable Items="_spreadsheetProperties" />
        </SgCard>
    </div>
</SgCard>

@code {
    private Dictionary<string, string> _basicColumns = new()
    {
        { "A", "Имя" },
        { "B", "Возраст" },
        { "C", "Город" },
        { "D", "Зарплата" }
    };

    private Dictionary<string, string> _formulaColumns = new()
    {
        { "A", "Товар" },
        { "B", "Цена" },
        { "C", "Количество" },
        { "D", "Сумма" }
    };

    private Dictionary<string, string> _readOnlyColumns = new()
    {
        { "A", "Данные" },
        { "B", "Значение" }
    };

    private Dictionary<string, string> _compactColumns = new()
    {
        { "A", "A" },
        { "B", "B" },
        { "C", "C" }
    };

    private Dictionary<string, string> _noToolbarColumns = new()
    {
        { "A", "A" },
        { "B", "B" }
    };

    private List<PropertyPanelItem> _spreadsheetProperties = new()
    {
        new() { Label = "Columns", Value = "Dictionary<string, string>", BadgeText = "Столбцы", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Rows", Value = "int (0)", BadgeText = "Строки", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "CellData", Value = "Dictionary<string, SpreadsheetCellData>?", BadgeText = "Данные", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "CellDataChanged", Value = "EventCallback", BadgeText = "Изменение", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "ReadOnly", Value = "bool (false)", BadgeText = "Только чтение", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowToolbar", Value = "bool (true)", BadgeText = "Тулбар", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowFormulaBar", Value = "bool (true)", BadgeText = "Формулы", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowStatusBar", Value = "bool (true)", BadgeText = "Статус", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Title", Value = "string?", BadgeText = "Заголовок", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Description", Value = "string?", BadgeText = "Описание", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Compact", Value = "bool (false)", BadgeText = "Компактный", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Loading", Value = "bool (false)", BadgeText = "Загрузка", BadgeVariant = SgBadgeVariant.Warn },
    };
}