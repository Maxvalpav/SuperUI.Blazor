@page "/locale-editor-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Demo.Components

<PageTitle>Locale Editor — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Locale Editor" Subtitle="Browse, search, and override translation keys at runtime. Changes persist to localStorage and load automatically on return." Icon="@SgHeroicons.Outline.GlobeAlt" GradientFrom="#667eea" GradientTo="#764ba2" />
    </HeaderContent>
    <ChildContent>

    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Interactive Locale Editor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Expand any domain to browse its translation keys. Edit values in the <strong>Override</strong> column, then save to persist changes to your browser's localStorage.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm" NoPadding="true">
            <SgLocaleEditor />
        </SgCard>
    </div>

    <div class="demo-section" style="margin-top: 32px;">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                How It Works
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                The editor loads the full locale catalog and lets you override any key at runtime.
            </SgTypography>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 16px;">
            <SgCard Title="Browse" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    All translation keys are grouped by domain. Expand domains to see individual keys and their current values.
                </SgTypography>
            </SgCard>
            <SgCard Title="Search" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Filter keys and values in real time using the search box. Matching entries are shown across all domains.
                </SgTypography>
            </SgCard>
            <SgCard Title="Override" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Type a new value in the Override column for any key. Modified rows are highlighted. Save to persist or reset to discard.
                </SgTypography>
            </SgCard>
            <SgCard Title="Persist" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Overrides are saved to <code>localStorage</code> and survive page reloads. Download as JSON to share or back up, upload to restore.
                </SgTypography>
            </SgCard>
        </div>
    </div>

    <div class="demo-section" style="margin-top: 32px;">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Properties Reference
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                SgLocaleEditor is a self-contained component — no parameters required. Simply place <code>&lt;SgLocaleEditor /&gt;</code> anywhere.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <PropertyTable Items="@_properties" />
        </SgCard>
    </div>

    </ChildContent>
</SgCard>

@code {
    private List<PropertyPanelItem> _properties = new()
    {
        new() { Label = "CssClass",    Value = "string?",          BadgeText = "CSS class override", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Style",       Value = "string?",          BadgeText = "Inline style",       BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Id",          Value = "string?",          BadgeText = "Element ID",         BadgeVariant = SgBadgeVariant.Info },
    };
}
