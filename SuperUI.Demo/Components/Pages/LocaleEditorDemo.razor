@page "/locale-editor-demo"
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>Locale Editor — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" HeaderContent="@_headerContent">
    <SgLocaleEditor />
</SgCard>

@code {
    private RenderFragment _headerContent => __builder =>
    {
        <SgStack Horizontal Align="SgAlignItems.Center" Space="SgSize.Md">
            <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 10px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <SgIcon Icon="@SgIcons.Globe" Size="20px" />
            </div>
            <div>
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">
                    Locale Editor
                </SgTypography>
                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                    Browse, search, and override translation keys at runtime
                </SgTypography>
            </div>
        </SgStack>
    };
}
