@page "/inter-demo"
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>Inter — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <SgStack Vertical Space="SgSize.Sm">
            <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">
                Inter — гарнитура по умолчанию
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Inter 4.1 (SIL OFL) — открытая гуманистическая гарнитура, спроектированная Rasmus Andersson для экранного отображения. Интегрирована с φ-типографической шкалой SuperUI.
            </SgTypography>
        </SgStack>
    </HeaderContent>
    <ChildContent>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- 1. Weight samples                               -->
    <!-- ═══════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Начертания
            </SgTypography>
        </div>
        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgStack Vertical Space="SgSize.Md">
                <div class="weight-sample" style="font-weight:300"><span class="weight-tag">Light 300</span> Съешь ещё этих мягких французских булок, да выпей же чаю.</div>
                <div class="weight-sample" style="font-weight:400"><span class="weight-tag">Regular 400</span> Съешь ещё этих мягких французских булок, да выпей же чаю.</div>
                <div class="weight-sample" style="font-weight:500"><span class="weight-tag">Medium 500</span> Съешь ещё этих мягких французских булок, да выпей же чаю.</div>
                <div class="weight-sample" style="font-weight:600"><span class="weight-tag">Semibold 600</span> Съешь ещё этих мягких французских булок, да выпей же чаю.</div>
                <div class="weight-sample" style="font-weight:700"><span class="weight-tag">Bold 700</span> Съешь ещё этих мягких французских булок, да выпей же чаю.</div>
                <div class="weight-sample" style="font-weight:400;font-style:italic"><span class="weight-tag">Italic</span> Съешь ещё этих мягких французских булок, да выпей же чаю.</div>
            </SgStack>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- 2. Phi Typographic Scale                        -->
    <!-- ═══════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                &phi; Typographic Scale
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Размеры шрифта по золотому сечению &phi;ⁿ относительно базы 16px.
            </SgTypography>
        </div>
        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <div class="phi-scale-showcase">
                <div class="phi-scale-item phi-poster"><span class="phi-scale-label">Poster &phi;⁶ 287px</span><span>Aa</span></div>
                <div class="phi-scale-item phi-display"><span class="phi-scale-label">Display &phi;⁵ 177px</span><span>Aa</span></div>
                <div class="phi-scale-item phi-h1"><span class="phi-scale-label">H1 &phi;⁴ 110px</span><span>Aa</span></div>
                <div class="phi-scale-item phi-h2"><span class="phi-scale-label">H2 &phi;³ 68px</span><span>Aa</span></div>
                <div class="phi-scale-item phi-h3"><span class="phi-scale-label">H3 &phi;² 42px</span><span>Aa</span></div>
                <div class="phi-scale-item phi-lead"><span class="phi-scale-label">Lead &phi;¹ 26px</span><span>Aa</span></div>
                <div class="phi-scale-item phi-body"><span class="phi-scale-label">Body &phi;⁰ 16px</span><span>The quick brown fox jumps over the lazy dog. Inter отлично читается при любом кегле.</span></div>
                <div class="phi-scale-item phi-caption"><span class="phi-scale-label">Caption &phi;⁻¹ 10px</span><span>The quick brown fox jumps over the lazy dog. Caption text при &phi;-обратном размере.</span></div>
            </div>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- 3. Text samples                                 -->
    <!-- ═══════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Примеры текста
            </SgTypography>
        </div>
        <div class="demo-two-col">
            <SgCard Title="Кириллица" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgTypography>
                        В чащах юга жил бы цитрус? Да, но фальшивый экземпляр! Съешь ещё этих мягких французских булок, да выпей же чаю. Интер-гарнитура отлично поддерживает кириллические глифы.
                    </SgTypography>
                    <SgDivider />
                    <SgTypography>
                        Широкая электрификация южных губерний даст мощный толчок подъёму сельского хозяйства. Панграмма содержит все буквы алфавита.
                    </SgTypography>
                </SgStack>
            </SgCard>
            <SgCard Title="Латиница + цифры" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgTypography>
                        The quick brown fox jumps over the lazy dog. Inter 4.1 brings improved Cyrillic, mathematical operators, and currency symbols.
                    </SgTypography>
                    <SgDivider />
                    <SgTypography>
                        0123456789 · $ € ₽ ¥ £ ¢ ₸ ₴ ₪ ₫ ₀₁₂₃₄₅₆₇₈₉ · ½ ¼ ¾ ² ³
                    </SgTypography>
                </SgStack>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- 4. CSS Variables                                -->
    <!-- ═══════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                CSS Variable Integration
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                φ-шкала доступна через CSS-переменные и утилитарные классы.
            </SgTypography>
        </div>
        <div class="demo-two-col">
            <SgCard Title="Typography Variables" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <pre class="token-preview"><code>--sg-text-phi-micro:   0.24rem;
--sg-text-phi-caption: 0.618rem;
--sg-text-phi-body:    1rem;
--sg-text-phi-lead:    1.618rem;
--sg-text-phi-h3:      2.618rem;
--sg-text-phi-h2:      4.236rem;
--sg-text-phi-h1:      6.854rem;
--sg-text-phi-display: 11.09rem;
--sg-text-phi-poster:  17.95rem;

--sg-lh-phi-display: 1.272;
--sg-lh-phi-body:    1.618;
--sg-lh-phi-caption: 2.058;</code></pre>
            </SgCard>
            <SgCard Title="CSS Classes" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Utility-классы для быстрого применения:
                    </SgTypography>
                    <SgStack Vertical Space="SgSize.Sm">
                        <div class="css-class-row"><code>.sgc-typo-phi-body</code> <span style="font-size:var(--sg-text-phi-body);line-height:var(--sg-lh-phi-body)">Body text</span></div>
                        <div class="css-class-row"><code>.sgc-typo-phi-lead</code> <span style="font-size:var(--sg-text-phi-lead);line-height:var(--sg-lh-phi-body)">Lead text</span></div>
                        <div class="css-class-row"><code>.sgc-typo-phi-h3</code> <span style="font-size:var(--sg-text-phi-h3);line-height:var(--sg-lh-phi-display)">Heading 3</span></div>
                        <div class="css-class-row"><code>.sgc-typo-phi-h2</code> <span style="font-size:var(--sg-text-phi-h2);line-height:var(--sg-lh-phi-display)">Heading 2</span></div>
                        <div class="css-class-row"><code>.sgc-typo-phi-h1</code> <span style="font-size:var(--sg-text-phi-h1);line-height:1.1">Heading 1</span></div>
                    </SgStack>
                    <SgDivider />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Fibonacci spacing:
                    </SgTypography>
                    <SgStack Horizontal Space="SgSize.Sm" Wrap="true">
                        <span class="fib-space-chip" style="width:var(--sg-space-fib-1);height:var(--sg-space-fib-1)"></span><code>8px</code>
                        <span class="fib-space-chip" style="width:var(--sg-space-fib-2);height:var(--sg-space-fib-2)"></span><code>13px</code>
                        <span class="fib-space-chip" style="width:var(--sg-space-fib-3);height:var(--sg-space-fib-3)"></span><code>21px</code>
                        <span class="fib-space-chip" style="width:var(--sg-space-fib-4);height:var(--sg-space-fib-4)"></span><code>34px</code>
                    </SgStack>
                </SgStack>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- 5. License                                      -->
    <!-- ═══════════════════════════════════════════════ -->
    <div class="demo-section">
        <SgCard Title="License" Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgStack Vertical Space="SgSize.Sm">
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Inter is licensed under the <strong>SIL Open Font License 1.1</strong>. You may use, modify, and distribute it freely.
                    Font files are bundled with SuperUI for convenience. Source: <a href="https://github.com/rsms/inter" target="_blank" rel="noopener">github.com/rsms/inter</a>.
                </SgTypography>
            </SgStack>
        </SgCard>
    </div>

    </ChildContent>
</SgCard>

<style>
    .weight-sample { display:flex; gap:16px; align-items:center; font-size:1.125rem; padding:6px 0; }
    .weight-tag { min-width:120px; font-size:0.7rem; font-weight:600; color:var(--sg-text-muted); font-family:var(--sg-font-mono); }
    .phi-scale-showcase { display:flex; flex-direction:column; gap:4px; }
    .phi-scale-item { position:relative; padding:8px 16px; border-radius:4px; transition:background .2s; }
    .phi-scale-item:hover { background:var(--sg-surface-alt,#f3f4f6); }
    .phi-scale-label { position:absolute; right:16px; top:50%; transform:translateY(-50%); font-size:.625rem; color:var(--sg-text-muted); font-family:var(--sg-font-mono); background:var(--sg-bg,#fff); padding:2px 6px; border-radius:4px; border:1px solid var(--sg-border,#e5e7eb); }
    .phi-poster { font-size:var(--sg-text-phi-poster); line-height:1; font-weight:700; }
    .phi-display { font-size:var(--sg-text-phi-display); line-height:1; font-weight:700; }
    .phi-h1 { font-size:var(--sg-text-phi-h1); line-height:1.1; font-weight:700; }
    .phi-h2 { font-size:var(--sg-text-phi-h2); line-height:var(--sg-lh-phi-display); font-weight:700; }
    .phi-h3 { font-size:var(--sg-text-phi-h3); line-height:var(--sg-lh-phi-display); font-weight:600; }
    .phi-lead { font-size:var(--sg-text-phi-lead); line-height:var(--sg-lh-phi-body); }
    .phi-body { font-size:var(--sg-text-phi-body); line-height:var(--sg-lh-phi-body); }
    .phi-caption { font-size:var(--sg-text-phi-caption); line-height:var(--sg-lh-phi-caption); }
    .phi-micro { font-size:var(--sg-text-phi-micro); line-height:var(--sg-lh-phi-caption); }
    .token-preview { background:var(--sg-bg-muted,#1e1e2e)!important; color:#cdd6f4; padding:16px; border-radius:8px; font-size:.75rem; line-height:1.6; overflow-x:auto; margin:0; font-family:var(--sg-font-mono); }
    .css-class-row { display:flex; gap:12px; align-items:center; padding:4px 0; }
    .css-class-row code { min-width:180px; font-size:.75rem; }
    .demo-section { margin-bottom:32px; }
    .demo-section-header { margin-bottom:16px; }
    .demo-two-col { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
    .fib-space-chip { display:inline-block; background:var(--sg-primary,#2563eb); border-radius:4px; opacity:.6; vertical-align:middle; }
</style>
