@page "/datagrid-demo/editing"
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Demo.Components
@using SuperUI.Demo.Models
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Editing — DataGrid – SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg" Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Editing — Inline &amp; Modal"
                        Subtitle="Toggle between inline cell editing and modal form editing. Add and delete rows with undo support."
                        Icon="@SgHeroicons.Outline.PencilSquare" GradientFrom="#f59e0b" GradientTo="#ef4444" />
    </HeaderContent>
    <ChildContent>

        <div class="dg-nav-row" style="margin-bottom:16px;">
        <a class="dg-nav-link" href="/datagrid-demo">← Menu</a>
        <a class="dg-nav-link" href="/datagrid-demo/basic">Basic</a>
        <a class="dg-nav-link active" href="/datagrid-demo/editing">Editing</a>
        <a class="dg-nav-link" href="/datagrid-demo/selection">Selection</a>
        <a class="dg-nav-link" href="/datagrid-demo/grouping">Grouping</a>
        <a class="dg-nav-link" href="/datagrid-demo/detail">Detail</a>
        <a class="dg-nav-link" href="/datagrid-demo/export">Export</a>
        <a class="dg-nav-link" href="/datagrid-demo/virtualization">Virtualization</a>
        <a class="dg-nav-link" href="/datagrid-demo/persistence">Persistence</a>
    </div>

    <div class="dg-config">
        <div class="dg-config-panel">
            <div class="dg-config-panel-title">Data Generator</div>
            <div class="dg-config-row">
                <label>Rows:</label>
                <input type="range" min="10" max="200" step="5" value="@_rowCount"
                       @oninput="OnRowCountChange" />
                <input type="number" class="dg-number-input" min="10" max="200" value="@_rowCount"
                       @oninput="OnRowCountChange" />
                <span class="dg-value">@_rowCount</span>
            </div>
            <div style="margin-top:8px;">
                <button class="dg-config-row dg-toggle" @onclick="Regenerate" style="border-color:var(--sg-primary);color:var(--sg-primary);">⟳ Regenerate</button>
            </div>
        </div>
        <div class="dg-config-panel">
            <div class="dg-config-panel-title">Edit Mode</div>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:4px;">
                <label class="dg-toggle @(_useModal ? "" : "active")">
                    <input type="radio" name="editMode" checked="@(!_useModal)" @onchange="e => { _useModal = false; StateHasChanged(); UpdateGeneratedCode(); }" />
                    <span>Inline</span>
                </label>
                <label class="dg-toggle @(_useModal ? "active" : "")">
                    <input type="radio" name="editMode" checked="@_useModal" @onchange="e => { _useModal = true; StateHasChanged(); UpdateGeneratedCode(); }" />
                    <span>Modal</span>
                </label>
            </div>
            <div class="dg-config-row" style="margin-top:8px;">
                <label class="dg-toggle @(_allowAdd ? "active" : "")">
                    <input type="checkbox" checked="@_allowAdd" @onchange="e => { _allowAdd = !_allowAdd; StateHasChanged(); UpdateGeneratedCode(); }" />
                    <span>Allow Add</span>
                </label>
                <label class="dg-toggle @(_allowDelete ? "active" : "")">
                    <input type="checkbox" checked="@_allowDelete" @onchange="e => { _allowDelete = !_allowDelete; StateHasChanged(); UpdateGeneratedCode(); }" />
                    <span>Allow Delete</span>
                </label>
            </div>
            <div class="dg-config-row">
                <label>Modal width:</label>
                <input type="range" min="400" max="800" step="20" value="@_modalWidth"
                       @oninput="OnModalWidthChange" />
                <span class="dg-value">@_modalWidth px</span>
            </div>
        </div>
    </div>

    <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm" NoPadding="true" OverflowHidden="true">
        <SgDataGrid TItem="Employee" Items="_data"
                    Height="460px"
                    AllowEdit="true"
                    UseModalForEdit="@_useModal"
                    AllowAdd="@_allowAdd"
                    AllowDelete="@_allowDelete"
                    EditModalWidth="@_modalWidth"
                    EditModalAddTitle="Add Employee"
                    EditModalEditTitle="Edit Employee"
                CreateItemFactory="@(() => new Employee())"
                    ShowStatusBar="true"
                    PageSize="10"
                    EnablePaging="true"
                    RowSaved="OnRowSaved">
            <ChildContent>
                <SgDataGridColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="60" Editable="false" />
                <SgDataGridColumn TItem="Employee" Title="First Name" Value="@(e => e.FirstName)" Width="130" Editable="true" ValueType="typeof(string)" />
                <SgDataGridColumn TItem="Employee" Title="Last Name" Value="@(e => e.LastName)" Width="130" Editable="true" ValueType="typeof(string)" />
                <SgDataGridColumn TItem="Employee" Title="Department" Value="@(e => e.Department)" Width="130" Editable="true" ValueType="typeof(DepartmentType)" />
                <SgDataGridColumn TItem="Employee" Title="Salary" Value="@(e => e.Salary)" Width="110" Editable="true" ValueType="typeof(decimal)" Format="C0" />
                <SgDataGridColumn TItem="Employee" Title="Active" Value="@(e => e.IsActive)" Width="90" Editable="true" ValueType="typeof(bool)" />
                <SgDataGridColumn TItem="Employee" Title="Hire Date" Value="@(e => e.HireDate)" Width="120" Editable="true" ValueType="typeof(DateTime)" Format="dd.MM.yyyy" />
                <SgDataGridColumn TItem="Employee" Title="Position" Value="@(e => e.Position)" Width="140" Editable="true" ValueType="typeof(string)" />
                <SgDataGridColumn TItem="Employee" Title="Level" Value="@(e => e.Level)" Width="100" Editable="true" ValueType="typeof(string)" />
            </ChildContent>
        </SgDataGrid>
    </SgCard>

        <!-- Generated Code -->
        <div style="margin-top:24px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                <span style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--sg-text-muted);">Generated Code</span>
                <button type="button" @onclick="CopyCodeToClipboard" style="display:inline-flex;align-items:center;gap:4px;background:var(--sg-surface-alt);border:1px solid var(--sg-border);border-radius:6px;padding:4px 10px;cursor:pointer;color:var(--sg-text-muted);font-family:inherit;font-size:12px;">
                    <span>@_copyIcon</span>
                    <span style="font-size:11px;font-weight:600;">@_copyLabel</span>
                </button>
            </div>
            <div class="code-block">@_generatedCode</div>
        </div>

    </ChildContent>
</SgCard>

@code {
    private List<Employee> _data = new();
    private int _rowCount = 25;
    private bool _useModal;
    private bool _allowAdd = true;
    private bool _allowDelete = true;
    private int _modalWidth = 500;
    private string _generatedCode = "";
    private string _copyIcon = "📋";
    private string _copyLabel = "Copy";

    private void OnRowCountChange(ChangeEventArgs e) { _rowCount = int.Parse(e.Value?.ToString() ?? "25"); Regenerate(); }
    private void OnModalWidthChange(ChangeEventArgs e) { _modalWidth = int.Parse(e.Value?.ToString() ?? "500"); UpdateGeneratedCode(); }

    protected override void OnInitialized() { Regenerate(); UpdateGeneratedCode(); }

    private void Regenerate() => _data = SampleDataService.GenerateEmployees(_rowCount, 42);

    private void OnRowSaved(Employee item) { /* item already in grid */ }

    private void UpdateGeneratedCode()
    {
        _generatedCode = $"""
            <SgDataGrid TItem="Employee" Items="@_data"
                Height="460px"
                AllowEdit="true"
                UseModalForEdit="{_useModal.ToString().ToLower()}"
                AllowAdd="{_allowAdd.ToString().ToLower()}"
                AllowDelete="{_allowDelete.ToString().ToLower()}"
                EditModalWidth="{_modalWidth}"
                EditModalAddTitle="Add Employee"
                EditModalEditTitle="Edit Employee"
                CreateItemFactory="@(() => new Employee())"
                ShowStatusBar="true"
                PageSize="10"
                EnablePaging="true"
                RowSaved="OnRowSaved">
                <ChildContent>
                    <SgDataGridColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="60" Editable="false" />
                    <SgDataGridColumn TItem="Employee" Title="First Name" Value="@(e => e.FirstName)" Width="130" Editable="true" ValueType="typeof(string)" />
                    <SgDataGridColumn TItem="Employee" Title="Last Name" Value="@(e => e.LastName)" Width="130" Editable="true" ValueType="typeof(string)" />
                    <SgDataGridColumn TItem="Employee" Title="Department" Value="@(e => e.Department)" Width="130" Editable="true" ValueType="typeof(DepartmentType)" />
                    <SgDataGridColumn TItem="Employee" Title="Salary" Value="@(e => e.Salary)" Width="110" Editable="true" ValueType="typeof(decimal)" Format="C0" />
                    <SgDataGridColumn TItem="Employee" Title="Active" Value="@(e => e.IsActive)" Width="90" Editable="true" ValueType="typeof(bool)" />
                    <SgDataGridColumn TItem="Employee" Title="Hire Date" Value="@(e => e.HireDate)" Width="120" Editable="true" ValueType="typeof(DateTime)" Format="dd.MM.yyyy" />
                    <SgDataGridColumn TItem="Employee" Title="Position" Value="@(e => e.Position)" Width="140" Editable="true" ValueType="typeof(string)" />
                    <SgDataGridColumn TItem="Employee" Title="Level" Value="@(e => e.Level)" Width="100" Editable="true" ValueType="typeof(string)" />
                </ChildContent>
            </SgDataGrid>
            """;
    }

    private async Task CopyCodeToClipboard()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _generatedCode);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }
}
