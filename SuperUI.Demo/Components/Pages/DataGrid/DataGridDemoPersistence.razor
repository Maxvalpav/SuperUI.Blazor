@page "/datagrid-demo/persistence"
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Demo.Components
@using SuperUI.Demo.Models
@inject NavigationManager Nav

<PageTitle>Persistence — DataGrid – SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg" Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="State Persistence &amp; Saved Views"
                        Subtitle="Auto-save grid state (filters, sort, columns, pagination) to localStorage. Named saved views with mock DB operations."
                        Icon="@SgHeroicons.Outline.BookmarkSquare" GradientFrom="#14b8a6" GradientTo="#06b6d4" />
    </HeaderContent>
    <ChildContent>

        <div style="margin-bottom:20px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            <SgButton Text="← Menu" Href="/datagrid-demo" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
            <span style="color:var(--sg-text-muted);font-size:12px;">|</span>
            @foreach (var p in _navPages)
            {
                var active = Nav.Uri.EndsWith(p.Path);
                <SgButton Text="@p.Label" Href="@p.Path" Size="SgSize.Sm"
                          Variant="@(active ? SgButtonVariant.Primary : SgButtonVariant.Outlined)" />
            }
        </div>

        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Configuration</SgTypography>
            </div>
            <SgRow Space="SgSize.Sm">
                <SgCol Xs="12">
                    <SgSegmented TValue="string" Options="@_presetOptions" ValueChanged="@(v => { if (v is not null) LoadPreset(v); })" Size="xs" Block />
                </SgCol>
            </SgRow>
            <div style="position:sticky;top:0;z-index:10;background:var(--sg-surface);">
                <SgRow Space="SgSize.Sm">
                    <SgCol Xs="4">
                        <SgCard Title="Data Generator" Status="SgCardStatus.Info" Shadow="SgShadow.Sm" Size="SgSize.Sm" Compact="true">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgSlider TValue="int" @bind-Value="_rowCount" Min="10" Max="200" Step="5" Label="Rows" ShowInput="true" />
                                <SgRow Space="SgSize.Sm">
                                    <SgCol Xs="6"><SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined" OnClick="@Regenerate" Block="true">↻ Regenerate</SgButton></SgCol>
                                    <SgCol Xs="6"><SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Primary" OnClick="@ApplySettings" Block="true">Apply</SgButton></SgCol>
                                </SgRow>
                            </SgStack>
                        </SgCard>
                    </SgCol>
                    <SgCol Xs="4">
                        <SgCard Title="Features" Status="SgCardStatus.Success" Shadow="SgShadow.Sm" Size="SgSize.Sm" Compact="true">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgSwitch @bind-Value="_persist" Label="Persist State" Size="SgSize.Sm" />
                                <SgSwitch @bind-Value="_showViews" Label="Saved Views" Size="SgSize.Sm" />
                            </SgStack>
                            <div style="margin-top:4px;font-size:10px;color:var(--sg-text-muted);">
                                Try: sort columns, hide/show columns, apply filters, change page size — then refresh the page. Your state is restored from localStorage.
                            </div>
                        </SgCard>
                    </SgCol>
                    <SgCol Xs="4">
                        <SgCard Title="Display" Status="SgCardStatus.Warning" Shadow="SgShadow.Sm" Size="SgSize.Sm" Compact="true">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgSlider TValue="int" @bind-Value="_gridHeight" Min="300" Max="900" Step="20" Label="Height" Suffix="px" ShowInput="true" />
                            </SgStack>
                        </SgCard>
                    </SgCol>
                </SgRow>
            </div>
        </div>

        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm" NoPadding="true" OverflowHidden="true">
            <SgDataGrid TItem="Employee" Items="_data"
                        Height="@($"{_gridHeight}px")"
                        ShowSearch="true"
                        ShowQuickFilters="true"
                        ShowColumnChooser="true"
                        ShowStatusBar="true"
                        ShowRowHighlighter="true"
                        PersistStateKey="@(_persist ? "demo-employees-state" : null)"
                        ShowSavedViews="@_showViews"
                        SavedViewsStorageKey="@(_showViews ? "demo-employees-views" : null)"
                        DbViews="@(_showViews ? _mockDbViews : null)"
                        OnSaveViewToDb="OnSaveViewToDb"
                        OnDeleteViewFromDb="OnDeleteViewFromDb"
                        PageSize="15"
                        EnablePaging="true">
                <ChildContent>
                    <SgDataGridColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="60" />
                    <SgDataGridColumn TItem="Employee" Title="First Name" Value="@(e => e.FirstName)" Width="120" />
                    <SgDataGridColumn TItem="Employee" Title="Last Name" Value="@(e => e.LastName)" Width="130" />
                    <SgDataGridColumn TItem="Employee" Title="Email" Value="@(e => e.Email)" Width="200" />
                    <SgDataGridColumn TItem="Employee" Title="Department" Value="@(e => e.Department)" Width="130" />
                    <SgDataGridColumn TItem="Employee" Title="Salary" Value="@(e => e.Salary)" Width="110" Format="N0" />
                    <SgDataGridColumn TItem="Employee" Title="Hire Date" Value="@(e => e.HireDate)" Width="120" Format="dd.MM.yyyy" />
                    <SgDataGridColumn TItem="Employee" Title="Active" Value="@(e => e.IsActive)" Width="90" />
                    <SgDataGridColumn TItem="Employee" Title="Position" Value="@(e => e.Position)" Width="140" />
                </ChildContent>
            </SgDataGrid>
        </SgCard>

        @if (_viewsLog.Count > 0)
        {
            <div style="margin-top:8px;padding:8px 12px;background:var(--sg-bg-subtle);border-radius:var(--sg-radius-md);font-size:12px;">
                <div style="font-weight:600;margin-bottom:4px;color:var(--sg-text-muted);">DB Operations Log:</div>
                @foreach (var entry in _viewsLog)
                {
                    <div style="color:var(--sg-text-muted);">@entry</div>
                }
            </div>
        }

        <div class="demo-section" style="margin-top:32px;">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Generated Code</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Razor markup for the current configuration</SgTypography>
            </div>
            <DemoCodeBlock Code="@_generatedCode" Language="Razor" Title="SgDataGrid markup" Highlighted="true" RawCode="@_plainCode" />
        </div>

    </ChildContent>
</SgCard>

@code {
    private static readonly List<SgSegmentedOption<string>> _presetOptions = [
        new() { Value = "Minimal", Label = "Minimal" },
        new() { Value = "Standard", Label = "Standard" },
        new() { Value = "FullFeatured", Label = "Full Featured" },
        new() { Value = "PowerUser", Label = "Power User" }
    ];

    private List<Employee> _data = new();
    private int _rowCount = 50;
    private int _gridHeight = 520;
    private bool _persist = true;
    private bool _showViews = true;
    private List<string> _viewsLog = new();
    private string _plainCode = "";
    private string _generatedCode = "";

    private static readonly List<(string Label, string Path)> _navPages = new()
    {
        ("Basic", "/datagrid-demo/basic"),
        ("Editing", "/datagrid-demo/editing"),
        ("Selection", "/datagrid-demo/selection"),
        ("Grouping", "/datagrid-demo/grouping"),
        ("Detail", "/datagrid-demo/detail"),
        ("Export", "/datagrid-demo/export"),
        ("Virtualization", "/datagrid-demo/virtualization"),
        ("Persistence", "/datagrid-demo/persistence"),
    };

    private List<SgSavedViews<Employee>.SavedViewItem> _mockDbViews = new()
    {
        new() { Id = "db-view-1", Name = "Active Only (DB)", StateJson = """{"search":null,"quickFilters":{"IsActive":"true"},"valueFilters":{},"conditionFilters":{},"queryRules":[],"sort":[{"key":"LastName","dir":"Ascending"}],"hiddenColumns":[],"columnWidths":{},"columnOrder":{},"groupBy":[],"pageSize":15,"rowHighlightRules":[]}""", CreatedAt = new DateTime(2025, 1, 15), UpdatedAt = new DateTime(2025, 1, 15) },
        new() { Id = "db-view-2", Name = "By Dept (DB)", StateJson = """{"search":null,"quickFilters":{},"valueFilters":{},"conditionFilters":{},"queryRules":[],"sort":[{"key":"Department","dir":"Ascending"},{"key":"Salary","dir":"Descending"}],"hiddenColumns":[],"columnWidths":{},"columnOrder":{},"groupBy":["Department"],"pageSize":15,"rowHighlightRules":[]}""", CreatedAt = new DateTime(2025, 2, 1), UpdatedAt = new DateTime(2025, 2, 1) }
    };

    protected override void OnInitialized() { Regenerate(); UpdateGeneratedCode(); }

    private void ApplySettings() { UpdateGeneratedCode(); }

    private void Regenerate()
    {
        _data = SampleDataService.GenerateEmployees(_rowCount, 42);
        UpdateGeneratedCode();
    }

    private Task OnSaveViewToDb(SgSavedViews<Employee>.SavedViewItem view)
    {
        var msg = $"[{DateTime.Now:HH:mm:ss}] SAVE id={view.Id[..8]}... \"{view.Name}\" ({view.StateJson.Length} bytes)";
        _viewsLog.Insert(0, msg);
        if (_viewsLog.Count > 5) _viewsLog.RemoveAt(_viewsLog.Count - 1);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnDeleteViewFromDb(string viewId)
    {
        var msg = $"[{DateTime.Now:HH:mm:ss}] DELETE id={viewId[..8]}...";
        _viewsLog.Insert(0, msg);
        if (_viewsLog.Count > 5) _viewsLog.RemoveAt(_viewsLog.Count - 1);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void UpdateGeneratedCode()
    {
        _plainCode = $"""
            <SgDataGrid TItem="Employee" Items="@_data"
                Height="520px"
                ShowSearch="true"
                ShowQuickFilters="true"
                ShowColumnChooser="true"
                ShowStatusBar="true"
                ShowRowHighlighter="true"
                PersistStateKey="{(_persist ? "demo-employees-state" : "null")}"
                ShowSavedViews="{_showViews.ToString().ToLower()}"
                SavedViewsStorageKey="{(_showViews ? "demo-employees-views" : "null")}"
                PageSize="15"
                EnablePaging="true">
                <ChildContent>
                    <SgDataGridColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="60" />
                    <SgDataGridColumn TItem="Employee" Title="First Name" Value="@(e => e.FirstName)" Width="120" />
                    <SgDataGridColumn TItem="Employee" Title="Last Name" Value="@(e => e.LastName)" Width="130" />
                    <SgDataGridColumn TItem="Employee" Title="Email" Value="@(e => e.Email)" Width="200" />
                    <SgDataGridColumn TItem="Employee" Title="Department" Value="@(e => e.Department)" Width="130" />
                    <SgDataGridColumn TItem="Employee" Title="Salary" Value="@(e => e.Salary)" Width="110" Format="N0" />
                    <SgDataGridColumn TItem="Employee" Title="Hire Date" Value="@(e => e.HireDate)" Width="120" Format="dd.MM.yyyy" />
                    <SgDataGridColumn TItem="Employee" Title="Active" Value="@(e => e.IsActive)" Width="90" />
                    <SgDataGridColumn TItem="Employee" Title="Position" Value="@(e => e.Position)" Width="140" />
                </ChildContent>
            </SgDataGrid>
            """;
        _generatedCode = DataGridCodeHighlighter.AutoHighlight(_plainCode);
    }

    private void LoadPreset(string name)
    {
        switch (name)
        {
            case "Minimal":
                _rowCount = 10; _persist = true; _showViews = false;
                break;
            case "Standard":
                _rowCount = 50; _persist = true; _showViews = true;
                break;
            case "FullFeatured":
                _rowCount = 100; _persist = true; _showViews = true;
                break;
            case "PowerUser":
                _rowCount = 200; _persist = true; _showViews = true;
                break;
        }
    }
}
