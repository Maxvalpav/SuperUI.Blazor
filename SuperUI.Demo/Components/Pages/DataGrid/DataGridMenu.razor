@page "/datagrid-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Demo.Components

<PageTitle>DataGrid — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="SgDataGrid — Demos"
                        Subtitle="Explore the full power of SuperUI's data grid. Each demo is a live interactive playground with configurable settings and data generators."
                        Icon="@SgHeroicons.Outline.TableCells" />
    </HeaderContent>
    <ChildContent>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;margin-top:8px;">
            <SgCard Title="Basic + All Features" Shadow="SgShadow.Sm" Radius="SgSize.Md" Hoverable="true" Clickable="true" OnClick="NavToBasic" Animated="true" Compact="true">
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">30-column BigEmployee grid with toggles for search, status bar, pagination, column chooser, row numbers, borders, and more.</SgTypography>
                <div style="margin-top:8px;display:flex;gap:4px;flex-wrap:wrap;">
                    <SgBadge Text="30 columns" Variant="SgBadgeVariant.Info" Size="SgSize.Sm" Standalone="true" />
                    <SgBadge Text="Live config" Variant="SgBadgeVariant.Success" Size="SgSize.Sm" Standalone="true" />
                    <SgBadge Text="BigEmployee" Variant="SgBadgeVariant.Default" Size="SgSize.Sm" Standalone="true" />
                </div>
            </SgCard>
            <SgCard Title="Editing" Shadow="SgShadow.Sm" Radius="SgSize.Md" Hoverable="true" Clickable="true" OnClick="NavToEditing" Animated="true" Compact="true">
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Inline and modal editing with add/delete operations. Toggle between edit modes, configure editable columns.</SgTypography>
                <div style="margin-top:8px;display:flex;gap:4px;flex-wrap:wrap;">
                    <SgBadge Text="Inline edit" Variant="SgBadgeVariant.Warn" Size="SgSize.Sm" Standalone="true" />
                    <SgBadge Text="Modal edit" Variant="SgBadgeVariant.Info" Size="SgSize.Sm" Standalone="true" />
                    <SgBadge Text="Add/Delete" Variant="SgBadgeVariant.Danger" Size="SgSize.Sm" Standalone="true" />
                </div>
            </SgCard>
            <SgCard Title="Selection + Bulk Edit" Shadow="SgShadow.Sm" Radius="SgSize.Md" Hoverable="true" Clickable="true" OnClick="NavToSelection" Animated="true" Compact="true">
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Multi-select and single-select modes with bulk edit operations on selected rows.</SgTypography>
                <div style="margin-top:8px;display:flex;gap:4px;flex-wrap:wrap;">
                    <SgBadge Text="Multi-select" Variant="SgBadgeVariant.Success" Size="SgSize.Sm" Standalone="true" />
                    <SgBadge Text="Single-select" Variant="SgBadgeVariant.Info" Size="SgSize.Sm" Standalone="true" />
                    <SgBadge Text="Bulk edit" Variant="SgBadgeVariant.Warn" Size="SgSize.Sm" Standalone="true" />
                </div>
            </SgCard>
            <SgCard Title="Grouping & Aggregates" Shadow="SgShadow.Sm" Radius="SgSize.Md" Hoverable="true" Clickable="true" OnClick="NavToGrouping" Animated="true" Compact="true">
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Group rows by department with aggregate functions: sum, average, min, max, count.</SgTypography>
                <div style="margin-top:8px;display:flex;gap:4px;flex-wrap:wrap;">
                    <SgBadge Text="Grouping" Variant="SgBadgeVariant.Info" Size="SgSize.Sm" Standalone="true" />
                    <SgBadge Text="Aggregates" Variant="SgBadgeVariant.Success" Size="SgSize.Sm" Standalone="true" />
                </div>
            </SgCard>
            <SgCard Title="Master-Detail" Shadow="SgShadow.Sm" Radius="SgSize.Md" Hoverable="true" Clickable="true" OnClick="NavToDetail" Animated="true" Compact="true">
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Expandable detail rows with Inline, Drawer, and Window placements. Auto-detail via reflection.</SgTypography>
                <div style="margin-top:8px;display:flex;gap:4px;flex-wrap:wrap;">
                    <SgBadge Text="Inline" Variant="SgBadgeVariant.Default" Size="SgSize.Sm" Standalone="true" />
                    <SgBadge Text="Drawer" Variant="SgBadgeVariant.Info" Size="SgSize.Sm" Standalone="true" />
                    <SgBadge Text="Window" Variant="SgBadgeVariant.Warn" Size="SgSize.Sm" Standalone="true" />
                    <SgBadge Text="Auto-detail" Variant="SgBadgeVariant.Success" Size="SgSize.Sm" Standalone="true" />
                </div>
            </SgCard>
            <SgCard Title="Export & Row Highlight" Shadow="SgShadow.Sm" Radius="SgSize.Md" Hoverable="true" Clickable="true" OnClick="NavToExport" Animated="true" Compact="true">
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">CSV and Excel export. Conditional row highlighting with visual rule builder.</SgTypography>
                <div style="margin-top:8px;display:flex;gap:4px;flex-wrap:wrap;">
                    <SgBadge Text="CSV" Variant="SgBadgeVariant.Success" Size="SgSize.Sm" Standalone="true" />
                    <SgBadge Text="Excel" Variant="SgBadgeVariant.Info" Size="SgSize.Sm" Standalone="true" />
                    <SgBadge Text="Highlight" Variant="SgBadgeVariant.Warn" Size="SgSize.Sm" Standalone="true" />
                </div>
            </SgCard>
            <SgCard Title="Virtualization" Shadow="SgShadow.Sm" Radius="SgSize.Md" Hoverable="true" Clickable="true" OnClick="NavToVirtualization" Animated="true" Compact="true">
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Performance demo: 1K to 100K rows with BigEmployee (30 cols). Virtualized rendering with smooth scrolling.</SgTypography>
                <div style="margin-top:8px;display:flex;gap:4px;flex-wrap:wrap;">
                    <SgBadge Text="100K rows" Variant="SgBadgeVariant.Danger" Size="SgSize.Sm" Standalone="true" />
                    <SgBadge Text="Virtual scroll" Variant="SgBadgeVariant.Success" Size="SgSize.Sm" Standalone="true" />
                    <SgBadge Text="30 columns" Variant="SgBadgeVariant.Info" Size="SgSize.Sm" Standalone="true" />
                </div>
            </SgCard>
            <SgCard Title="State Persistence" Shadow="SgShadow.Sm" Radius="SgSize.Md" Hoverable="true" Clickable="true" OnClick="NavToPersistence" Animated="true" Compact="true">
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Auto-save grid state to localStorage. Named saved views with DB operations simulation.</SgTypography>
                <div style="margin-top:8px;display:flex;gap:4px;flex-wrap:wrap;">
                    <SgBadge Text="localStorage" Variant="SgBadgeVariant.Default" Size="SgSize.Sm" Standalone="true" />
                    <SgBadge Text="Saved views" Variant="SgBadgeVariant.Info" Size="SgSize.Sm" Standalone="true" />
                    <SgBadge Text="Persist state" Variant="SgBadgeVariant.Success" Size="SgSize.Sm" Standalone="true" />
                </div>
            </SgCard>
        </div>
    </ChildContent>
</SgCard>

@code {
    private void NavToBasic() => NavManager.NavigateTo("/datagrid-demo/basic");
    private void NavToEditing() => NavManager.NavigateTo("/datagrid-demo/editing");
    private void NavToSelection() => NavManager.NavigateTo("/datagrid-demo/selection");
    private void NavToGrouping() => NavManager.NavigateTo("/datagrid-demo/grouping");
    private void NavToDetail() => NavManager.NavigateTo("/datagrid-demo/detail");
    private void NavToExport() => NavManager.NavigateTo("/datagrid-demo/export");
    private void NavToVirtualization() => NavManager.NavigateTo("/datagrid-demo/virtualization");
    private void NavToPersistence() => NavManager.NavigateTo("/datagrid-demo/persistence");

    [Inject] private NavigationManager NavManager { get; set; } = default!;
}
