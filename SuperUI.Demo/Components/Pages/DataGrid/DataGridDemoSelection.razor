@page "/datagrid-demo/selection"
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Demo.Components
@using SuperUI.Demo.Models
@inject NavigationManager Nav

<PageTitle>Selection — DataGrid – SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg" Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Selection + Bulk Edit"
                        Subtitle="Multi-select, single-select, and bulk edit operations. Select rows, then apply changes in bulk."
                        Icon="@SgHeroicons.Outline.CheckCircle" GradientFrom="#10b981" GradientTo="#059669" />
    </HeaderContent>
    <ChildContent>

        <div style="margin-bottom:20px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            <SgButton Text="← Menu" Href="/datagrid-demo" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
            <span style="color:var(--sg-text-muted);font-size:12px;">|</span>
            @foreach (var p in _navPages)
            {
                var active = Nav.Uri.EndsWith(p.Path);
                <SgButton Text="@p.Label" Href="@p.Path" Size="SgSize.Sm"
                          Variant="@(active ? SgButtonVariant.Primary : SgButtonVariant.Outlined)" />
            }
        </div>

        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Configuration</SgTypography>
            </div>
            <SgRow Space="SgSize.Sm">
                <SgCol Xs="12">
                    <SgSegmented TValue="string" Options="@_presetOptions" ValueChanged="@(v => { if (v is not null) LoadPreset(v); })" Size="xs" Block />
                </SgCol>
            </SgRow>
            <div style="position:sticky;top:0;z-index:10;background:var(--sg-surface);">
                <SgRow Space="SgSize.Sm">
                    <SgCol Xs="4">
                        <SgCard Title="Data Generator" Status="SgCardStatus.Info" Shadow="SgShadow.Sm" Size="SgSize.Sm" Compact="true">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgSlider TValue="int" @bind-Value="_rowCount" Min="10" Max="200" Step="5" Label="Rows" ShowInput="true" />
                                <SgRow Space="SgSize.Sm">
                                    <SgCol Xs="6"><SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined" OnClick="@Regenerate" Block="true">↻ Regenerate</SgButton></SgCol>
                                    <SgCol Xs="6"><SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Primary" OnClick="@ApplySettings" Block="true">Apply</SgButton></SgCol>
                                </SgRow>
                            </SgStack>
                        </SgCard>
                    </SgCol>
                    <SgCol Xs="4">
                        <SgCard Title="Selection Mode" Status="SgCardStatus.Success" Shadow="SgShadow.Sm" Size="SgSize.Sm" Compact="true">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgSwitch @bind-Value="_multi" Label="Multi-select" Size="SgSize.Sm" />
                                <SgSwitch @bind-Value="_single" Label="Single-select" Size="SgSize.Sm" />
                                <SgSwitch @bind-Value="_bulk" Label="Bulk Edit" Size="SgSize.Sm" />
                            </SgStack>
                        </SgCard>
                    </SgCol>
                    <SgCol Xs="4">
                        <SgCard Title="Display" Status="SgCardStatus.Warning" Shadow="SgShadow.Sm" Size="SgSize.Sm" Compact="true">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgSlider TValue="int" @bind-Value="_gridHeight" Min="300" Max="800" Step="20" Label="Height" Suffix="px" ShowInput="true" />
                            </SgStack>
                        </SgCard>
                    </SgCol>
                </SgRow>
            </div>
        </div>

        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm" NoPadding="true" OverflowHidden="true">
            <SgDataGrid TItem="Employee" Items="_data"
                        Height="@($"{_gridHeight}px")"
                        AllowMultiSelect="@_multi"
                        AllowSingleSelect="@_single"
                        AllowBulkEdit="@_bulk"
                        ShowStatusBar="true"
                        PageSize="10"
                        EnablePaging="true"
                        SelectedItemsChanged="OnSelectionChanged"
                        OnBulkSave="OnBulkSave">
                <ChildContent>
                    <SgDataGridColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="60" />
                    <SgDataGridColumn TItem="Employee" Title="First Name" Value="@(e => e.FirstName)" Width="130" Editable="true" ValueType="typeof(string)" />
                    <SgDataGridColumn TItem="Employee" Title="Last Name" Value="@(e => e.LastName)" Width="130" Editable="true" ValueType="typeof(string)" />
                    <SgDataGridColumn TItem="Employee" Title="Department" Value="@(e => e.Department)" Width="130" Editable="true" ValueType="typeof(DepartmentType)" />
                    <SgDataGridColumn TItem="Employee" Title="Salary" Value="@(e => e.Salary)" Width="110" Editable="true" ValueType="typeof(decimal)" Format="C0" />
                    <SgDataGridColumn TItem="Employee" Title="Active" Value="@(e => e.IsActive)" Width="90" Editable="true" ValueType="typeof(bool)" />
                    <SgDataGridColumn TItem="Employee" Title="Position" Value="@(e => e.Position)" Width="140" />
                </ChildContent>
            </SgDataGrid>
        </SgCard>

        @if (_selectedCount > 0)
        {
            <div style="margin-top:8px;padding:8px 12px;background:var(--sg-bg-subtle);border-radius:var(--sg-radius-md);font-size:12px;display:flex;align-items:center;gap:8px;">
                <span style="font-weight:600;">Selected: @_selectedCount rows</span>
                @if (_bulkLog.Count > 0)
                {
                    <span style="color:var(--sg-text-muted);">| Last bulk edit: @string.Join(", ", _bulkLog)</span>
                }
            </div>
        }

        <div class="demo-section" style="margin-top:32px;">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Generated Code</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Razor markup for the current configuration</SgTypography>
            </div>
            <DemoCodeBlock Code="@_generatedCode" Language="Razor" Title="SgDataGrid markup" Highlighted="true" Wrap="true" RawCode="@_plainCode" />
        </div>

    </ChildContent>
</SgCard>

@code {
    private static readonly List<SgSegmentedOption<string>> _presetOptions = [
        new() { Value = "Minimal", Label = "Minimal" },
        new() { Value = "Standard", Label = "Standard" },
        new() { Value = "FullFeatured", Label = "Full Featured" },
        new() { Value = "PowerUser", Label = "Power User" }
    ];

    private List<Employee> _data = new();
    private int _rowCount = 50;
    private int _gridHeight = 460;
    private bool _multi = true;
    private bool _single;
    private bool _bulk = true;
    private int _selectedCount;
    private List<string> _bulkLog = new();
    private string _plainCode = "";
    private string _generatedCode = "";

    private static readonly List<(string Label, string Path)> _navPages = new()
    {
        ("Basic", "/datagrid-demo/basic"),
        ("Editing", "/datagrid-demo/editing"),
        ("Selection", "/datagrid-demo/selection"),
        ("Grouping", "/datagrid-demo/grouping"),
        ("Detail", "/datagrid-demo/detail"),
        ("Export", "/datagrid-demo/export"),
        ("Virtualization", "/datagrid-demo/virtualization"),
        ("Persistence", "/datagrid-demo/persistence"),
    };

    protected override void OnInitialized() { Regenerate(); UpdateGeneratedCode(); }

    private void ApplySettings() { UpdateGeneratedCode(); }

    private void Regenerate()
    {
        _data = SampleDataService.GenerateEmployees(_rowCount, 42);
        UpdateGeneratedCode();
    }

    private void OnSelectionChanged(IReadOnlyCollection<Employee> selected) { _selectedCount = selected.Count; }

    private void OnBulkSave(SgBulkEditEventArgs<Employee> args)
    {
        _bulkLog.Clear();
        _bulkLog.Add($"{args.Items.Count} rows affected");
        foreach (var (key, val) in args.Changes)
            if (!string.IsNullOrEmpty(val))
                _bulkLog.Add($"{key} = \"{val}\"");
        foreach (var item in args.Items)
            foreach (var (key, val) in args.Changes)
            {
                if (string.IsNullOrEmpty(val)) continue;
                switch (key)
                {
                    case "FirstName": item.FirstName = val; break;
                    case "LastName": item.LastName = val; break;
                    case "Department": if (Enum.TryParse<DepartmentType>(val, out var d)) item.Department = d; break;
                    case "Salary": if (decimal.TryParse(val, out var s)) item.Salary = s; break;
                    case "IsActive": item.IsActive = val == "true"; break;
                }
            }
    }

    private void UpdateGeneratedCode()
    {
        _plainCode = $"""
            <SgDataGrid TItem="Employee" Items="@_data"
                Height="460px"
                AllowMultiSelect="{_multi.ToString().ToLower()}"
                AllowSingleSelect="{_single.ToString().ToLower()}"
                AllowBulkEdit="{_bulk.ToString().ToLower()}"
                ShowStatusBar="true"
                PageSize="10"
                EnablePaging="true"
                SelectedItemsChanged="OnSelectionChanged"
                OnBulkSave="OnBulkSave">
                <ChildContent>
                    <SgDataGridColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="60" />
                    <SgDataGridColumn TItem="Employee" Title="First Name" Value="@(e => e.FirstName)" Width="130" Editable="true" ValueType="typeof(string)" />
                    <SgDataGridColumn TItem="Employee" Title="Last Name" Value="@(e => e.LastName)" Width="130" Editable="true" ValueType="typeof(string)" />
                    <SgDataGridColumn TItem="Employee" Title="Department" Value="@(e => e.Department)" Width="130" Editable="true" ValueType="typeof(DepartmentType)" />
                    <SgDataGridColumn TItem="Employee" Title="Salary" Value="@(e => e.Salary)" Width="110" Editable="true" ValueType="typeof(decimal)" Format="C0" />
                    <SgDataGridColumn TItem="Employee" Title="Active" Value="@(e => e.IsActive)" Width="90" Editable="true" ValueType="typeof(bool)" />
                    <SgDataGridColumn TItem="Employee" Title="Position" Value="@(e => e.Position)" Width="140" />
                </ChildContent>
            </SgDataGrid>
            """;
        _generatedCode = DataGridCodeHighlighter.AutoHighlight(_plainCode);
    }

    private void LoadPreset(string name)
    {
        switch (name)
        {
            case "Minimal":
                _rowCount = 10; _multi = true; _single = false; _bulk = false;
                break;
            case "Standard":
                _rowCount = 50; _multi = true; _single = false; _bulk = true;
                break;
            case "FullFeatured":
                _rowCount = 100; _multi = true; _single = true; _bulk = true;
                break;
            case "PowerUser":
                _rowCount = 200; _multi = false; _single = true; _bulk = true;
                break;
        }
    }
}
