@page "/datagrid-demo/selection"
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Demo.Components
@using SuperUI.Demo.Models
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Selection — DataGrid – SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg" Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Selection + Bulk Edit"
                        Subtitle="Multi-select, single-select, and bulk edit operations. Select rows, then apply changes in bulk."
                        Icon="@SgHeroicons.Outline.CheckCircle" GradientFrom="#10b981" GradientTo="#059669" />
    </HeaderContent>
    <ChildContent>

        <div class="dg-nav-row" style="margin-bottom:16px;">
        <a class="dg-nav-link" href="/datagrid-demo">← Menu</a>
        <a class="dg-nav-link" href="/datagrid-demo/basic">Basic</a>
        <a class="dg-nav-link" href="/datagrid-demo/editing">Editing</a>
        <a class="dg-nav-link active" href="/datagrid-demo/selection">Selection</a>
        <a class="dg-nav-link" href="/datagrid-demo/grouping">Grouping</a>
        <a class="dg-nav-link" href="/datagrid-demo/detail">Detail</a>
        <a class="dg-nav-link" href="/datagrid-demo/export">Export</a>
        <a class="dg-nav-link" href="/datagrid-demo/virtualization">Virtualization</a>
        <a class="dg-nav-link" href="/datagrid-demo/persistence">Persistence</a>
    </div>

    <div class="dg-config">
        <div class="dg-config-panel">
            <div class="dg-config-panel-title">Data Generator</div>
            <div class="dg-config-row">
                <label>Rows:</label>
                <input type="range" min="10" max="200" step="5" value="@_rowCount"
                       @oninput="OnRowCountChange" />
                <input type="number" class="dg-number-input" min="10" max="200" value="@_rowCount"
                       @oninput="OnRowCountChange" />
                <span class="dg-value">@_rowCount</span>
            </div>
            <div style="margin-top:8px;">
                <button class="dg-config-row dg-toggle" @onclick="Regenerate" style="border-color:var(--sg-primary);color:var(--sg-primary);">⟳ Regenerate</button>
            </div>
        </div>
        <div class="dg-config-panel">
            <div class="dg-config-panel-title">Selection Mode</div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <label class="dg-toggle @(_multi ? "active" : "")">
                    <input type="checkbox" checked="@_multi" @onchange="e => { _multi = !_multi; _single = false; StateHasChanged(); UpdateGeneratedCode(); }" />
                    <span>Multi-select</span>
                </label>
                <label class="dg-toggle @(_single ? "active" : "")">
                    <input type="checkbox" checked="@_single" @onchange="e => { _single = !_single; _multi = false; StateHasChanged(); UpdateGeneratedCode(); }" />
                    <span>Single-select</span>
                </label>
                <label class="dg-toggle @(_bulk ? "active" : "")">
                    <input type="checkbox" checked="@_bulk" @onchange="e => { _bulk = !_bulk; StateHasChanged(); UpdateGeneratedCode(); }" />
                    <span>Bulk Edit</span>
                </label>
            </div>
        </div>
    </div>

    <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm" NoPadding="true" OverflowHidden="true">
        <SgDataGrid TItem="Employee" Items="_data"
                    Height="460px"
                    AllowMultiSelect="@_multi"
                    AllowSingleSelect="@_single"
                    AllowBulkEdit="@_bulk"
                    ShowStatusBar="true"
                    PageSize="10"
                    EnablePaging="true"
                    SelectedItemsChanged="OnSelectionChanged"
                    OnBulkSave="OnBulkSave">
            <ChildContent>
                <SgDataGridColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="60" />
                <SgDataGridColumn TItem="Employee" Title="First Name" Value="@(e => e.FirstName)" Width="130" Editable="true" ValueType="typeof(string)" />
                <SgDataGridColumn TItem="Employee" Title="Last Name" Value="@(e => e.LastName)" Width="130" Editable="true" ValueType="typeof(string)" />
                <SgDataGridColumn TItem="Employee" Title="Department" Value="@(e => e.Department)" Width="130" Editable="true" ValueType="typeof(DepartmentType)" />
                <SgDataGridColumn TItem="Employee" Title="Salary" Value="@(e => e.Salary)" Width="110" Editable="true" ValueType="typeof(decimal)" Format="C0" />
                <SgDataGridColumn TItem="Employee" Title="Active" Value="@(e => e.IsActive)" Width="90" Editable="true" ValueType="typeof(bool)" />
                <SgDataGridColumn TItem="Employee" Title="Position" Value="@(e => e.Position)" Width="140" />
            </ChildContent>
        </SgDataGrid>
    </SgCard>

    @if (_selectedCount > 0)
    {
        <div style="margin-top:8px;padding:8px 12px;background:var(--sg-bg-subtle);border-radius:var(--sg-radius-md);font-size:12px;display:flex;align-items:center;gap:8px;">
            <span style="font-weight:600;">Selected: @_selectedCount rows</span>
            @if (_bulkLog.Count > 0)
            {
                <span style="color:var(--sg-text-muted);">| Last bulk edit: @string.Join(", ", _bulkLog)</span>
            }
        </div>
    }

        <!-- Generated Code -->
        <div style="margin-top:24px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                <span style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--sg-text-muted);">Generated Code</span>
                <button type="button" @onclick="CopyCodeToClipboard" style="display:inline-flex;align-items:center;gap:4px;background:var(--sg-surface-alt);border:1px solid var(--sg-border);border-radius:6px;padding:4px 10px;cursor:pointer;color:var(--sg-text-muted);font-family:inherit;font-size:12px;">
                    <span>@_copyIcon</span>
                    <span style="font-size:11px;font-weight:600;">@_copyLabel</span>
                </button>
            </div>
            <div class="code-block">@_generatedCode</div>
        </div>

    </ChildContent>
</SgCard>

@code {
    private List<Employee> _data = new();
    private int _rowCount = 50;
    private bool _multi = true;
    private bool _single;
    private bool _bulk = true;
    private int _selectedCount;
    private List<string> _bulkLog = new();
    private string _generatedCode = "";
    private string _copyIcon = "📋";
    private string _copyLabel = "Copy";

    private void OnRowCountChange(ChangeEventArgs e) { _rowCount = int.Parse(e.Value?.ToString() ?? "50"); Regenerate(); }

    protected override void OnInitialized() { Regenerate(); UpdateGeneratedCode(); }
    private void Regenerate() => _data = SampleDataService.GenerateEmployees(_rowCount, 42);

    private void OnSelectionChanged(IReadOnlyCollection<Employee> selected) { _selectedCount = selected.Count; UpdateGeneratedCode(); }

    private void OnBulkSave(SgBulkEditEventArgs<Employee> args)
    {
        _bulkLog.Clear();
        _bulkLog.Add($"{args.Items.Count} rows affected");
        foreach (var (key, val) in args.Changes)
            if (!string.IsNullOrEmpty(val))
                _bulkLog.Add($"{key} = \"{val}\"");
        foreach (var item in args.Items)
            foreach (var (key, val) in args.Changes)
            {
                if (string.IsNullOrEmpty(val)) continue;
                switch (key)
                {
                    case "FirstName": item.FirstName = val; break;
                    case "LastName": item.LastName = val; break;
                    case "Department": if (Enum.TryParse<DepartmentType>(val, out var d)) item.Department = d; break;
                    case "Salary": if (decimal.TryParse(val, out var s)) item.Salary = s; break;
                    case "IsActive": item.IsActive = val == "true"; break;
                }
            }
    }

    private void UpdateGeneratedCode()
    {
        _generatedCode = $"""
            <SgDataGrid TItem="Employee" Items="@_data"
                Height="460px"
                AllowMultiSelect="{_multi.ToString().ToLower()}"
                AllowSingleSelect="{_single.ToString().ToLower()}"
                AllowBulkEdit="{_bulk.ToString().ToLower()}"
                ShowStatusBar="true"
                PageSize="10"
                EnablePaging="true"
                SelectedItemsChanged="OnSelectionChanged"
                OnBulkSave="OnBulkSave">
                <ChildContent>
                    <SgDataGridColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="60" />
                    <SgDataGridColumn TItem="Employee" Title="First Name" Value="@(e => e.FirstName)" Width="130" Editable="true" ValueType="typeof(string)" />
                    <SgDataGridColumn TItem="Employee" Title="Last Name" Value="@(e => e.LastName)" Width="130" Editable="true" ValueType="typeof(string)" />
                    <SgDataGridColumn TItem="Employee" Title="Department" Value="@(e => e.Department)" Width="130" Editable="true" ValueType="typeof(DepartmentType)" />
                    <SgDataGridColumn TItem="Employee" Title="Salary" Value="@(e => e.Salary)" Width="110" Editable="true" ValueType="typeof(decimal)" Format="C0" />
                    <SgDataGridColumn TItem="Employee" Title="Active" Value="@(e => e.IsActive)" Width="90" Editable="true" ValueType="typeof(bool)" />
                    <SgDataGridColumn TItem="Employee" Title="Position" Value="@(e => e.Position)" Width="140" />
                </ChildContent>
            </SgDataGrid>
            """;
    }

    private async Task CopyCodeToClipboard()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _generatedCode);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }
}
