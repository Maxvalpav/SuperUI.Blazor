@page "/datagrid-demo/detail"
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Demo.Components
@using SuperUI.Demo.Models
@inject NavigationManager Nav

<PageTitle>Detail — DataGrid – SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg" Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Master-Detail"
                        Subtitle="Expandable detail rows with Inline, Drawer, and Window placements. Auto-detail via reflection for complex models."
                        Icon="@SgHeroicons.Outline.ChevronDown" GradientFrom="#06b6d4" GradientTo="#3b82f6" />
    </HeaderContent>
    <ChildContent>

        <div style="margin-bottom:20px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            <SgButton Text="← Menu" Href="/datagrid-demo" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
            <span style="color:var(--sg-text-muted);font-size:12px;">|</span>
            @foreach (var p in _navPages)
            {
                var active = Nav.Uri.EndsWith(p.Path);
                <SgButton Text="@p.Label" Href="@p.Path" Size="SgSize.Sm"
                          Variant="@(active ? SgButtonVariant.Primary : SgButtonVariant.Outlined)" />
            }
        </div>

        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Configuration</SgTypography>
            </div>
            <SgRow Space="SgSize.Sm">
                <SgCol Xs="12">
                    <SgSegmented TValue="string" Options="@_presetOptions" ValueChanged="@(v => { if (v is not null) LoadPreset(v); })" Size="xs" Block />
                </SgCol>
            </SgRow>
            <div style="position:sticky;top:0;z-index:10;background:var(--sg-surface);">
                <SgRow Space="SgSize.Sm">
                    <SgCol Xs="4">
                        <SgCard Title="Data Generator" Status="SgCardStatus.Info" Shadow="SgShadow.Sm" Size="SgSize.Sm" Compact="true">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgSlider TValue="int" @bind-Value="_rowCount" Min="5" Max="100" Step="5" Label="Rows" ShowInput="true" />
                                <SgRow Space="SgSize.Sm">
                                    <SgCol Xs="6"><SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined" OnClick="@Regenerate" Block="true">↻ Regenerate</SgButton></SgCol>
                                    <SgCol Xs="6"><SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Primary" OnClick="@ApplySettings" Block="true">Apply</SgButton></SgCol>
                                </SgRow>
                            </SgStack>
                        </SgCard>
                    </SgCol>
                    <SgCol Xs="4">
                        <SgCard Title="Detail Mode" Status="SgCardStatus.Success" Shadow="SgShadow.Sm" Size="SgSize.Sm" Compact="true">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Placement</SgTypography>
                                    <SgSegmented TValue="DetailPlacement" Options="@_placementOptions" @bind-Value="_placement" Size="SgSize.Sm" />
                                </SgStack>
                                <SgSwitch @bind-Value="_autoDetail" Label="Auto-detail" Size="SgSize.Sm" />
                                @if (!_autoDetail)
                                {
                                    <SgTextBox @bind-Value="_drawerTitle" Label="Drawer title" />
                                    <SgSlider TValue="int" @bind-Value="_windowSize" Min="400" Max="900" Step="20" Label="Window size" Suffix="px" ShowInput="true" />
                                }
                            </SgStack>
                        </SgCard>
                    </SgCol>
                    <SgCol Xs="4">
                        <SgCard Title="Display" Status="SgCardStatus.Warning" Shadow="SgShadow.Sm" Size="SgSize.Sm" Compact="true">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgSlider TValue="int" @bind-Value="_gridHeight" Min="300" Max="900" Step="20" Label="Height" Suffix="px" ShowInput="true" />
                            </SgStack>
                        </SgCard>
                    </SgCol>
                </SgRow>
            </div>
        </div>

        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm" NoPadding="true" OverflowHidden="true">
            @if (_autoDetail)
            {
                <SgDataGrid TItem="EmployeeDetailed" Items="_detailed"
                            Height="@($"{_gridHeight}px")"
                            AutoDetail="true"
                            ShowStatusBar="true"
                            PageSize="10"
                            EnablePaging="true">
                    <ChildContent>
                        <SgDataGridColumn TItem="EmployeeDetailed" Title="ID" Value="@(e => e.Id)" Width="60" />
                        <SgDataGridColumn TItem="EmployeeDetailed" Title="First Name" Value="@(e => e.FirstName)" Width="130" />
                        <SgDataGridColumn TItem="EmployeeDetailed" Title="Last Name" Value="@(e => e.LastName)" Width="130" />
                        <SgDataGridColumn TItem="EmployeeDetailed" Title="Department" Value="@(e => e.Department)" Width="130" />
                        <SgDataGridColumn TItem="EmployeeDetailed" Title="Salary" Value="@(e => e.Salary)" Width="110" Format="N0" />
                        <SgDataGridColumn TItem="EmployeeDetailed" Title="City" Value="@(e => e.Address.City)" Width="120" />
                    </ChildContent>
                </SgDataGrid>
            }
            else
            {
                <SgDataGrid TItem="Employee" Items="_data"
                            Height="@($"{_gridHeight}px")"
                            DetailPlacement="@_placement"
                            DetailDrawerTitle="@_drawerTitle"
                            DetailWindowTitle="Employee Detail"
                            DetailWindowWidth="@_windowSize"
                            DetailWindowHeight="400"
                            ShowStatusBar="true"
                            PageSize="10"
                            EnablePaging="true">
                    <ChildContent>
                        <SgDataGridColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="60" />
                        <SgDataGridColumn TItem="Employee" Title="Name" Value="@(e => e.FirstName + " " + e.LastName)" Width="180" />
                        <SgDataGridColumn TItem="Employee" Title="Email" Value="@(e => e.Email)" Width="200" />
                        <SgDataGridColumn TItem="Employee" Title="Department" Value="@(e => e.Department)" Width="130" />
                        <SgDataGridColumn TItem="Employee" Title="Salary" Value="@(e => e.Salary)" Width="110" Format="C0" />
                    </ChildContent>
                    <DetailTemplate>
                        <div style="padding:16px;display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                            <div><div style="font-size:11px;font-weight:600;color:var(--sg-text-muted);">Name</div><div style="font-size:14px;">@context.FirstName @context.LastName</div></div>
                            <div><div style="font-size:11px;font-weight:600;color:var(--sg-text-muted);">Email</div><div style="font-size:14px;">@context.Email</div></div>
                            <div><div style="font-size:11px;font-weight:600;color:var(--sg-text-muted);">Department</div><div style="font-size:14px;">@context.Department</div></div>
                            <div><div style="font-size:11px;font-weight:600;color:var(--sg-text-muted);">Salary</div><div style="font-size:14px;">@context.Salary.ToString("C2")</div></div>
                            <div><div style="font-size:11px;font-weight:600;color:var(--sg-text-muted);">Status</div><div style="font-size:14px;">@(context.IsActive ? "Active" : "Inactive")</div></div>
                            <div><div style="font-size:11px;font-weight:600;color:var(--sg-text-muted);">Position</div><div style="font-size:14px;">@context.Position</div></div>
                            <div><div style="font-size:11px;font-weight:600;color:var(--sg-text-muted);">Hire Date</div><div style="font-size:14px;">@context.HireDate.ToString("dd.MM.yyyy")</div></div>
                            <div><div style="font-size:11px;font-weight:600;color:var(--sg-text-muted);">Rating</div><div style="font-size:14px;">@(context.Rating?.ToString("N2") ?? "-")</div></div>
                        </div>
                    </DetailTemplate>
                </SgDataGrid>
            }
        </SgCard>

        <div class="demo-section" style="margin-top:32px;">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Generated Code</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Razor markup for the current configuration</SgTypography>
            </div>
            <DemoCodeBlock Code="@_generatedCode" Language="Razor" Title="SgDataGrid markup" Highlighted="true" RawCode="@_plainCode" />
        </div>

    </ChildContent>
</SgCard>

@code {
    private static readonly List<SgSegmentedOption<string>> _presetOptions = [
        new() { Value = "Minimal", Label = "Minimal" },
        new() { Value = "Standard", Label = "Standard" },
        new() { Value = "FullFeatured", Label = "Full Featured" },
        new() { Value = "PowerUser", Label = "Power User" }
    ];

    private List<Employee> _data = new();
    private List<EmployeeDetailed> _detailed = new();
    private int _rowCount = 20;
    private int _gridHeight = 520;
    private DetailPlacement _placement = DetailPlacement.Inline;
    private bool _autoDetail;
    private string _drawerTitle = "Employee Details";
    private int _windowSize = 640;
    private string _plainCode = "";
    private string _generatedCode = "";

    private static readonly List<(string Label, string Path)> _navPages = new()
    {
        ("Basic", "/datagrid-demo/basic"),
        ("Editing", "/datagrid-demo/editing"),
        ("Selection", "/datagrid-demo/selection"),
        ("Grouping", "/datagrid-demo/grouping"),
        ("Detail", "/datagrid-demo/detail"),
        ("Export", "/datagrid-demo/export"),
        ("Virtualization", "/datagrid-demo/virtualization"),
        ("Persistence", "/datagrid-demo/persistence"),
    };

    private static readonly List<SgSegmentedOption<DetailPlacement>> _placementOptions = new()
    {
        new() { Value = DetailPlacement.Inline, Label = "Inline" },
        new() { Value = DetailPlacement.Drawer, Label = "Drawer" },
        new() { Value = DetailPlacement.Window, Label = "Window" },
    };

    protected override void OnInitialized() { Regenerate(); UpdateGeneratedCode(); }

    private void ApplySettings() { UpdateGeneratedCode(); }

    private void Regenerate()
    {
        _data = SampleDataService.GenerateEmployees(_rowCount, 42);
        _detailed = SampleDataService.GenerateDetailedEmployees(_rowCount, 42);
        UpdateGeneratedCode();
    }

    private void UpdateGeneratedCode()
    {
        if (_autoDetail)
        {
            _plainCode = """
                <SgDataGrid TItem="EmployeeDetailed" Items="@_detailed"
                    Height="520px"
                    AutoDetail="true"
                    ShowStatusBar="true"
                    PageSize="10"
                    EnablePaging="true">
                    <ChildContent>
                        <SgDataGridColumn TItem="EmployeeDetailed" Title="ID" Value="@(e => e.Id)" Width="60" />
                        <SgDataGridColumn TItem="EmployeeDetailed" Title="First Name" Value="@(e => e.FirstName)" Width="130" />
                        <SgDataGridColumn TItem="EmployeeDetailed" Title="Last Name" Value="@(e => e.LastName)" Width="130" />
                        <SgDataGridColumn TItem="EmployeeDetailed" Title="Department" Value="@(e => e.Department)" Width="130" />
                        <SgDataGridColumn TItem="EmployeeDetailed" Title="Salary" Value="@(e => e.Salary)" Width="110" Format="N0" />
                        <SgDataGridColumn TItem="EmployeeDetailed" Title="City" Value="@(e => e.Address.City)" Width="120" />
                    </ChildContent>
                </SgDataGrid>
                """;
        }
        else
        {
            _plainCode = $"""
                <SgDataGrid TItem="Employee" Items="@_data"
                    Height="520px"
                    DetailPlacement="SgDetailPlacement.{_placement}"
                    DetailDrawerTitle="{_drawerTitle}"
                    DetailWindowTitle="Employee Detail"
                    DetailWindowWidth="{_windowSize}"
                    DetailWindowHeight="400"
                    ShowStatusBar="true"
                    PageSize="10"
                    EnablePaging="true">
                    <ChildContent>
                        <SgDataGridColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="60" />
                        <SgDataGridColumn TItem="Employee" Title="Name" Value="@(e => e.FirstName + " " + e.LastName)" Width="180" />
                        <SgDataGridColumn TItem="Employee" Title="Email" Value="@(e => e.Email)" Width="200" />
                        <SgDataGridColumn TItem="Employee" Title="Department" Value="@(e => e.Department)" Width="130" />
                        <SgDataGridColumn TItem="Employee" Title="Salary" Value="@(e => e.Salary)" Width="110" Format="C0" />
                    </ChildContent>
                    <DetailTemplate>
                        <div style="padding:16px;display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                            <div><span>Name</span><span>@context.FirstName @context.LastName</span></div>
                            <div><span>Email</span><span>@context.Email</span></div>
                            <div><span>Department</span><span>@context.Department</span></div>
                            <div><span>Salary</span><span>@context.Salary.ToString("C2")</span></div>
                            <div><span>Status</span><span>@(context.IsActive ? "Active" : "Inactive")</span></div>
                            <div><span>Position</span><span>@context.Position</span></div>
                            <div><span>Hire Date</span><span>@context.HireDate.ToString("dd.MM.yyyy")</span></div>
                            <div><span>Rating</span><span>@(context.Rating?.ToString("N2") ?? "-")</span></div>
                        </div>
                    </DetailTemplate>
                </SgDataGrid>
                """;
        }
        _generatedCode = DataGridCodeHighlighter.AutoHighlight(_plainCode);
    }

    private void LoadPreset(string name)
    {
        switch (name)
        {
            case "Minimal":
                _rowCount = 5; _placement = DetailPlacement.Inline; _autoDetail = false; _drawerTitle = "Details"; _windowSize = 450;
                break;
            case "Standard":
                _rowCount = 20; _placement = DetailPlacement.Inline; _autoDetail = false; _drawerTitle = "Employee Details"; _windowSize = 640;
                break;
            case "FullFeatured":
                _rowCount = 30; _placement = DetailPlacement.Window; _autoDetail = true; _drawerTitle = "Full Details"; _windowSize = 800;
                break;
            case "PowerUser":
                _rowCount = 50; _placement = DetailPlacement.Drawer; _autoDetail = false; _drawerTitle = "Employee Details"; _windowSize = 900;
                break;
        }
    }
}
