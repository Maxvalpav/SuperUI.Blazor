@page "/datagrid-demo/virtualization"
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Demo.Components
@using SuperUI.Demo.Models
@using System.Diagnostics
@inject NavigationManager Nav

<PageTitle>Virtualization — DataGrid – SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg" Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Virtualization — Big Data"
                        Subtitle="Performance demo: from 1K to 100K rows with the 30-column BigEmployee model. Virtualized rendering for smooth scrolling."
                        Icon="@SgHeroicons.Outline.Server" GradientFrom="#ef4444" GradientTo="#f97316" />
    </HeaderContent>
    <ChildContent>

        <div style="margin-bottom:20px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            <SgButton Text="← Menu" Href="/datagrid-demo" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
            <span style="color:var(--sg-text-muted);font-size:12px;">|</span>
            @foreach (var p in _navPages)
            {
                var active = Nav.Uri.EndsWith(p.Path);
                <SgButton Text="@p.Label" Href="@p.Path" Size="SgSize.Sm"
                          Variant="@(active ? SgButtonVariant.Primary : SgButtonVariant.Outlined)" />
            }
        </div>

        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Configuration</SgTypography>
            </div>
            <SgRow Space="SgSize.Sm">
                <SgCol Xs="12">
                    <SgSegmented TValue="string" Options="@_presetOptions" ValueChanged="@(v => { if (v is not null) LoadPreset(v); })" Size="xs" Block />
                </SgCol>
            </SgRow>
            <div style="position:sticky;top:0;z-index:10;background:var(--sg-surface);">
                <SgRow Space="SgSize.Sm">
                    <SgCol Xs="4">
                        <SgCard Title="Data Generator" Status="SgCardStatus.Info" Shadow="SgShadow.Sm" Size="SgSize.Sm" Compact="true">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgSelect TValue="int" @bind-Value="_rowCount" Items="_rowCountOptions" Label="Rows" />
                                <SgSelect TValue="string" @bind-Value="_modelType" Items="@_modelTypes" Label="Model" Block />
                                <SgRow Space="SgSize.Sm">
                                    <SgCol Xs="6"><SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined" OnClick="@Regenerate" Block="true">↻ Regenerate</SgButton></SgCol>
                                    <SgCol Xs="6"><SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Primary" OnClick="@ApplySettings" Block="true">Apply</SgButton></SgCol>
                                </SgRow>
                            </SgStack>
                            @if (_genTimeMs > 0)
                            {
                                <div style="margin-top:4px;font-size:10px;color:var(--sg-text-muted);">
                                    Generated @_rowCount.ToString("N0") rows in @_genTimeMs ms
                                </div>
                            }
                        </SgCard>
                    </SgCol>
                    <SgCol Xs="4">
                        <SgCard Title="Settings" Status="SgCardStatus.Success" Shadow="SgShadow.Sm" Size="SgSize.Sm" Compact="true">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgSelect TValue="int" @bind-Value="_rowHeight" Items="@_rowHeightOptions" Label="Est. row h" />
                                <SgRow Space="SgSize.Sm">
                                    <SgCol Auto><SgSwitch @bind-Value="_showSearch" Label="Search" Size="SgSize.Sm" Block /></SgCol>
                                    <SgCol Auto><SgSwitch @bind-Value="_showStatus" Label="Status Bar" Size="SgSize.Sm" Block /></SgCol>
                                    <SgCol Auto><SgSwitch @bind-Value="_showColChooser" Label="Col Chooser" Size="SgSize.Sm" Block /></SgCol>
                                </SgRow>
                            </SgStack>
                        </SgCard>
                    </SgCol>
                    <SgCol Xs="4">
                        <SgCard Title="Display" Status="SgCardStatus.Warning" Shadow="SgShadow.Sm" Size="SgSize.Sm" Compact="true">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgSlider TValue="int" @bind-Value="_gridHeight" Min="300" Max="800" Step="20" Label="Height" Suffix="px" ShowInput="true" />
                            </SgStack>
                        </SgCard>
                    </SgCol>
                </SgRow>
            </div>
        </div>

        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm" NoPadding="true" OverflowHidden="true">
            @if (_modelType == "BigEmployee")
            {
                <SgDataGrid TItem="BigEmployee" Items="_bigData"
                            Height="@($"{_gridHeight}px")"
                            EnableVirtualization="true"
                            EnablePaging="false"
                            EstimatedRowHeight="@_rowHeight"
                            ShowSearch="@_showSearch"
                            ShowStatusBar="@_showStatus"
                            ShowColumnChooser="@_showColChooser">
                    <ChildContent>
                        <SgDataGridColumn TItem="BigEmployee" Title="ID" Value="@(e => e.Id)" Width="70" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Code" Value="@(e => e.EmployeeCode)" Width="110" />
                        <SgDataGridColumn TItem="BigEmployee" Title="First Name" Value="@(e => e.FirstName)" Width="120" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Last Name" Value="@(e => e.LastName)" Width="120" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Email" Value="@(e => e.Email)" Width="220" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Department" Value="@(e => e.Department)" Width="130" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Position" Value="@(e => e.Position)" Width="160" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Level" Value="@(e => e.Level)" Width="100" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Salary" Value="@(e => e.Salary)" Width="110" Format="N0" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Bonus" Value="@(e => e.Bonus)" Width="110" Format="N0" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Active" Value="@(e => e.IsActive)" Width="80" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Hire Date" Value="@(e => e.HireDate)" Width="110" Format="dd.MM.yyyy" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Rating" Value="@(e => e.Rating)" Width="80" Format="N1" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Projects" Value="@(e => e.ProjectsCount)" Width="80" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Efficiency" Value="@(e => e.Efficiency)" Width="90" Format="P0" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Last Login" Value="@(e => e.LastLogin)" Width="170" Format="g" />
                    </ChildContent>
                </SgDataGrid>
            }
            else
            {
                <SgDataGrid TItem="Employee" Items="_empData"
                            Height="@($"{_gridHeight}px")"
                            EnableVirtualization="true"
                            EnablePaging="false"
                            EstimatedRowHeight="@_rowHeight"
                            ShowSearch="@_showSearch"
                            ShowStatusBar="@_showStatus"
                            ShowColumnChooser="@_showColChooser">
                    <ChildContent>
                        <SgDataGridColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="60" />
                        <SgDataGridColumn TItem="Employee" Title="First Name" Value="@(e => e.FirstName)" Width="120" />
                        <SgDataGridColumn TItem="Employee" Title="Last Name" Value="@(e => e.LastName)" Width="120" />
                        <SgDataGridColumn TItem="Employee" Title="Email" Value="@(e => e.Email)" Width="200" />
                        <SgDataGridColumn TItem="Employee" Title="Department" Value="@(e => e.Department)" Width="130" />
                        <SgDataGridColumn TItem="Employee" Title="Salary" Value="@(e => e.Salary)" Width="110" Format="C0" />
                        <SgDataGridColumn TItem="Employee" Title="Active" Value="@(e => e.IsActive)" Width="90" />
                        <SgDataGridColumn TItem="Employee" Title="Hire Date" Value="@(e => e.HireDate)" Width="110" Format="dd.MM.yyyy" />
                        <SgDataGridColumn TItem="Employee" Title="Position" Value="@(e => e.Position)" Width="140" />
                        <SgDataGridColumn TItem="Employee" Title="Rating" Value="@(e => e.Rating)" Width="80" Format="N2" />
                    </ChildContent>
                </SgDataGrid>
            }
        </SgCard>

        <div class="demo-section" style="margin-top:32px;">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Generated Code</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Razor markup for the current configuration</SgTypography>
            </div>
            <DemoCodeBlock Code="@_generatedCode" Language="Razor" Title="SgDataGrid markup" Highlighted="true" RawCode="@_plainCode" />
        </div>

    </ChildContent>
</SgCard>

@code {
    private static readonly List<SgSegmentedOption<string>> _presetOptions = [
        new() { Value = "Minimal", Label = "Minimal" },
        new() { Value = "Standard", Label = "Standard" },
        new() { Value = "FullFeatured", Label = "Full Featured" },
        new() { Value = "PowerUser", Label = "Power User" }
    ];

    private List<BigEmployee> _bigData = new();
    private List<Employee> _empData = new();
    private int _rowCount = 10000;
    private int _gridHeight = 500;
    private int _rowHeight = 32;
    private long _genTimeMs;
    private string _modelType = "BigEmployee";
    private bool _showSearch = true;
    private bool _showStatus = true;
    private bool _showColChooser = true;
    private string _plainCode = "";
    private string _generatedCode = "";

    private static readonly List<(string Label, string Path)> _navPages = new()
    {
        ("Basic", "/datagrid-demo/basic"),
        ("Editing", "/datagrid-demo/editing"),
        ("Selection", "/datagrid-demo/selection"),
        ("Grouping", "/datagrid-demo/grouping"),
        ("Detail", "/datagrid-demo/detail"),
        ("Export", "/datagrid-demo/export"),
        ("Virtualization", "/datagrid-demo/virtualization"),
        ("Persistence", "/datagrid-demo/persistence"),
    };

    private static readonly int[] _rowCountOptions = [1000, 5000, 10000, 25000, 50000, 100000];
    private static readonly int[] _rowHeightOptions = [28, 32, 36, 40];
    private static readonly string[] _modelTypes = ["BigEmployee", "Employee"];

    protected override void OnInitialized() { Regenerate(); UpdateGeneratedCode(); }

    private void ApplySettings() { UpdateGeneratedCode(); }

    private void Regenerate()
    {
        var sw = Stopwatch.StartNew();
        if (_modelType == "BigEmployee")
            _bigData = SampleDataService.GenerateBigEmployees(_rowCount, 42);
        else
            _empData = SampleDataService.GenerateEmployees(_rowCount, 42);
        sw.Stop();
        _genTimeMs = sw.ElapsedMilliseconds;
        UpdateGeneratedCode();
    }

    private void UpdateGeneratedCode()
    {
        if (_modelType == "BigEmployee")
        {
            _plainCode = $"""
                <SgDataGrid TItem="BigEmployee" Items="@_bigData"
                    Height="{_gridHeight}px"
                    EnableVirtualization="true"
                    EnablePaging="false"
                    EstimatedRowHeight="{_rowHeight}"
                    ShowSearch="{_showSearch.ToString().ToLower()}"
                    ShowStatusBar="{_showStatus.ToString().ToLower()}"
                    ShowColumnChooser="{_showColChooser.ToString().ToLower()}">
                    <ChildContent>
                        <SgDataGridColumn TItem="BigEmployee" Title="ID" Value="@(e => e.Id)" Width="70" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Code" Value="@(e => e.EmployeeCode)" Width="110" />
                        <SgDataGridColumn TItem="BigEmployee" Title="First Name" Value="@(e => e.FirstName)" Width="120" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Last Name" Value="@(e => e.LastName)" Width="120" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Email" Value="@(e => e.Email)" Width="220" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Department" Value="@(e => e.Department)" Width="130" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Position" Value="@(e => e.Position)" Width="160" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Salary" Value="@(e => e.Salary)" Width="110" Format="N0" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Active" Value="@(e => e.IsActive)" Width="80" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Hire Date" Value="@(e => e.HireDate)" Width="110" Format="dd.MM.yyyy" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Rating" Value="@(e => e.Rating)" Width="80" Format="N1" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Projects" Value="@(e => e.ProjectsCount)" Width="80" />
                        <SgDataGridColumn TItem="BigEmployee" Title="Efficiency" Value="@(e => e.Efficiency)" Width="90" Format="P0" />
                    </ChildContent>
                </SgDataGrid>
                """;
        }
        else
        {
            _plainCode = $"""
                <SgDataGrid TItem="Employee" Items="@_empData"
                    Height="{_gridHeight}px"
                    EnableVirtualization="true"
                    EnablePaging="false"
                    EstimatedRowHeight="{_rowHeight}"
                    ShowSearch="{_showSearch.ToString().ToLower()}"
                    ShowStatusBar="{_showStatus.ToString().ToLower()}"
                    ShowColumnChooser="{_showColChooser.ToString().ToLower()}">
                    <ChildContent>
                        <SgDataGridColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="60" />
                        <SgDataGridColumn TItem="Employee" Title="First Name" Value="@(e => e.FirstName)" Width="120" />
                        <SgDataGridColumn TItem="Employee" Title="Last Name" Value="@(e => e.LastName)" Width="120" />
                        <SgDataGridColumn TItem="Employee" Title="Email" Value="@(e => e.Email)" Width="200" />
                        <SgDataGridColumn TItem="Employee" Title="Department" Value="@(e => e.Department)" Width="130" />
                        <SgDataGridColumn TItem="Employee" Title="Salary" Value="@(e => e.Salary)" Width="110" Format="C0" />
                        <SgDataGridColumn TItem="Employee" Title="Active" Value="@(e => e.IsActive)" Width="90" />
                        <SgDataGridColumn TItem="Employee" Title="Hire Date" Value="@(e => e.HireDate)" Width="110" Format="dd.MM.yyyy" />
                        <SgDataGridColumn TItem="Employee" Title="Position" Value="@(e => e.Position)" Width="140" />
                        <SgDataGridColumn TItem="Employee" Title="Rating" Value="@(e => e.Rating)" Width="80" Format="N2" />
                    </ChildContent>
                </SgDataGrid>
                """;
        }
        _generatedCode = DataGridCodeHighlighter.AutoHighlight(_plainCode);
    }

    private void LoadPreset(string name)
    {
        switch (name)
        {
            case "Minimal":
                _rowCount = 1000; _gridHeight = 300; _rowHeight = 28; _modelType = "Employee"; _showSearch = false; _showStatus = false; _showColChooser = false;
                break;
            case "Standard":
                _rowCount = 10000; _gridHeight = 500; _rowHeight = 32; _modelType = "BigEmployee"; _showSearch = true; _showStatus = true; _showColChooser = true;
                break;
            case "FullFeatured":
                _rowCount = 50000; _gridHeight = 700; _rowHeight = 36; _modelType = "BigEmployee"; _showSearch = true; _showStatus = true; _showColChooser = true;
                break;
            case "PowerUser":
                _rowCount = 100000; _gridHeight = 800; _rowHeight = 28; _modelType = "BigEmployee"; _showSearch = true; _showStatus = true; _showColChooser = true;
                break;
        }
    }
}
