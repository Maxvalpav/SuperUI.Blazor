@page "/datagrid-demo/grouping"
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Demo.Components
@using SuperUI.Demo.Models
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Grouping — DataGrid – SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg" Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Grouping &amp; Aggregates"
                        Subtitle="Group rows by department with aggregate summaries — sum, average, min, max, and count per group."
                        Icon="@SgHeroicons.Outline.Funnel" GradientFrom="#8b5cf6" GradientTo="#6366f1" />
    </HeaderContent>
    <ChildContent>

        <div class="dg-nav-row" style="margin-bottom:16px;">
        <a class="dg-nav-link" href="/datagrid-demo">← Menu</a>
        <a class="dg-nav-link" href="/datagrid-demo/basic">Basic</a>
        <a class="dg-nav-link" href="/datagrid-demo/editing">Editing</a>
        <a class="dg-nav-link" href="/datagrid-demo/selection">Selection</a>
        <a class="dg-nav-link active" href="/datagrid-demo/grouping">Grouping</a>
        <a class="dg-nav-link" href="/datagrid-demo/detail">Detail</a>
        <a class="dg-nav-link" href="/datagrid-demo/export">Export</a>
        <a class="dg-nav-link" href="/datagrid-demo/virtualization">Virtualization</a>
        <a class="dg-nav-link" href="/datagrid-demo/persistence">Persistence</a>
    </div>

    <div class="dg-config">
        <div class="dg-config-panel">
            <div class="dg-config-panel-title">Data Generator</div>
            <div class="dg-config-row">
                <label>Rows:</label>
                <input type="range" min="20" max="500" step="10" value="@_rowCount"
                       @oninput="OnRowCountChange" />
                <input type="number" class="dg-number-input" min="20" max="500" value="@_rowCount"
                       @oninput="OnRowCountChange" />
                <span class="dg-value">@_rowCount</span>
            </div>
            <div style="margin-top:8px;">
                <button class="dg-config-row dg-toggle" @onclick="Regenerate" style="border-color:var(--sg-primary);color:var(--sg-primary);">⟳ Regenerate</button>
            </div>
        </div>
        <div class="dg-config-panel">
            <div class="dg-config-panel-title">Aggregate Functions</div>
            <div class="dg-config-row">
                <label>Salary agg:</label>
                <select value="@_salaryAgg" @onchange="OnSalaryAggChange">
                    <option value="Average">Average</option>
                    <option value="Sum">Sum</option>
                    <option value="Min">Min</option>
                    <option value="Max">Max</option>
                    <option value="Count">Count</option>
                    <option value="None">None</option>
                </select>
            </div>
            <div class="dg-config-row">
                <label>Rating agg:</label>
                <select value="@_ratingAgg" @onchange="OnRatingAggChange">
                    <option value="Average">Average</option>
                    <option value="Sum">Sum</option>
                    <option value="Min">Min</option>
                    <option value="Max">Max</option>
                    <option value="Count">Count</option>
                    <option value="None">None</option>
                </select>
            </div>
            <div class="dg-config-row">
                <label>Page size:</label>
                <select value="@_pageSize" @onchange="OnPageSizeChange">
                    <option value="15">15</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>
    </div>

    <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm" NoPadding="true" OverflowHidden="true">
        <SgDataGrid TItem="Employee" Items="_data"
                    Height="560px"
                    ShowStatusBar="true"
                    ShowColumnChooser="true"
                    PageSize="@_pageSize"
                    EnablePaging="true">
            <ChildContent>
                <SgDataGridColumn TItem="Employee" Title="Department" Value="@(e => e.Department)" Width="140" Sortable="true" Filterable="true" GroupBy="true" />
                <SgDataGridColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="60" />
                <SgDataGridColumn TItem="Employee" Title="First Name" Value="@(e => e.FirstName)" Width="120" />
                <SgDataGridColumn TItem="Employee" Title="Last Name" Value="@(e => e.LastName)" Width="120" />
                <SgDataGridColumn TItem="Employee" Title="Salary" Value="@(e => e.Salary)" Width="110" Format="N0" Aggregate="@GetAggregate(_salaryAgg)" />
                <SgDataGridColumn TItem="Employee" Title="Active" Value="@(e => e.IsActive)" Width="90" />
                <SgDataGridColumn TItem="Employee" Title="Rating" Value="@(e => e.Rating)" Width="90" Format="N2" Aggregate="@GetAggregate(_ratingAgg)" />
                <SgDataGridColumn TItem="Employee" Title="Position" Value="@(e => e.Position)" Width="140" />
            </ChildContent>
        </SgDataGrid>
    </SgCard>

        <!-- Generated Code -->
        <div style="margin-top:24px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                <span style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--sg-text-muted);">Generated Code</span>
                <button type="button" @onclick="CopyCodeToClipboard" style="display:inline-flex;align-items:center;gap:4px;background:var(--sg-surface-alt);border:1px solid var(--sg-border);border-radius:6px;padding:4px 10px;cursor:pointer;color:var(--sg-text-muted);font-family:inherit;font-size:12px;">
                    <span>@_copyIcon</span>
                    <span style="font-size:11px;font-weight:600;">@_copyLabel</span>
                </button>
            </div>
            <div class="code-block">@_generatedCode</div>
        </div>

    </ChildContent>
</SgCard>

@code {
    private List<Employee> _data = new();
    private int _rowCount = 100;
    private int _pageSize = 25;
    private string _salaryAgg = "Average";
    private string _ratingAgg = "Average";
    private string _generatedCode = "";
    private string _copyIcon = "📋";
    private string _copyLabel = "Copy";

    private void OnRowCountChange(ChangeEventArgs e) { _rowCount = int.Parse(e.Value?.ToString() ?? "100"); Regenerate(); }
    private void OnSalaryAggChange(ChangeEventArgs e) { _salaryAgg = e.Value?.ToString() ?? "Average"; UpdateGeneratedCode(); }
    private void OnRatingAggChange(ChangeEventArgs e) { _ratingAgg = e.Value?.ToString() ?? "Average"; UpdateGeneratedCode(); }
    private void OnPageSizeChange(ChangeEventArgs e) { _pageSize = int.Parse(e.Value?.ToString() ?? "25"); UpdateGeneratedCode(); }

    protected override void OnInitialized() { Regenerate(); UpdateGeneratedCode(); }
    private void Regenerate() => _data = SampleDataService.GenerateEmployees(_rowCount, 42);

    private static Aggregate GetAggregate(string name) => name switch
    {
        "Average" => Aggregate.Average,
        "Sum" => Aggregate.Sum,
        "Min" => Aggregate.Min,
        "Max" => Aggregate.Max,
        "Count" => Aggregate.Count,
        _ => Aggregate.None
    };

    private void UpdateGeneratedCode()
    {
        _generatedCode = $"""
            <SgDataGrid TItem="Employee" Items="@_data"
                Height="560px"
                ShowStatusBar="true"
                ShowColumnChooser="true"
                PageSize="{_pageSize}"
                EnablePaging="true">
                <ChildContent>
                    <SgDataGridColumn TItem="Employee" Title="Department" Value="@(e => e.Department)" Width="140" Sortable="true" Filterable="true" GroupBy="true" />
                    <SgDataGridColumn TItem="Employee" Title="ID" Value="@(e => e.Id)" Width="60" />
                    <SgDataGridColumn TItem="Employee" Title="First Name" Value="@(e => e.FirstName)" Width="120" />
                    <SgDataGridColumn TItem="Employee" Title="Last Name" Value="@(e => e.LastName)" Width="120" />
                    <SgDataGridColumn TItem="Employee" Title="Salary" Value="@(e => e.Salary)" Width="110" Format="N0" Aggregate="@GetAggregate("{_salaryAgg}")" />
                    <SgDataGridColumn TItem="Employee" Title="Active" Value="@(e => e.IsActive)" Width="90" />
                    <SgDataGridColumn TItem="Employee" Title="Rating" Value="@(e => e.Rating)" Width="90" Format="N2" Aggregate="@GetAggregate("{_ratingAgg}")" />
                    <SgDataGridColumn TItem="Employee" Title="Position" Value="@(e => e.Position)" Width="140" />
                </ChildContent>
            </SgDataGrid>
            """;
    }

    private async Task CopyCodeToClipboard()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _generatedCode);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }
}
