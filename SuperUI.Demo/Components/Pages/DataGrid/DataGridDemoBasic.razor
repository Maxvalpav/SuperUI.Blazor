@page "/datagrid-demo/basic"
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Demo.Components
@using SuperUI.Demo.Models
@inject NavigationManager Nav

<PageTitle>Basic — DataGrid – SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg" Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Basic + All Features"
                        Subtitle="30-column BigEmployee grid with all feature toggles. Resize, reorder, pin, sort, and filter to your heart's content."
                        Icon="@SgHeroicons.Outline.TableCells" GradientFrom="#6366f1" GradientTo="#8b5cf6" />
    </HeaderContent>
    <ChildContent>

        <div style="margin-bottom:20px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            <SgButton Text="← Menu" Href="/datagrid-demo" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
            <span style="color:var(--sg-text-muted);font-size:12px;">|</span>
            @foreach (var p in _navPages)
            {
                var active = Nav.Uri.EndsWith(p.Path);
                <SgButton Text="@p.Label" Href="@p.Path" Size="SgSize.Sm"
                          Variant="@(active ? SgButtonVariant.Primary : SgButtonVariant.Outlined)" />
            }
        </div>

        <div class="demo-section">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Configuration</SgTypography>
            </div>
            <SgRow Space="SgSize.Sm">
                <SgCol Xs="12">
                    <SgSegmented TValue="string" Options="@_presetOptions" ValueChanged="@(v => { if (v is not null) LoadPreset(v); })" Size="xs" Block />
                </SgCol>
            </SgRow>
            <div style="position:sticky;top:0;z-index:10;background:var(--sg-surface);">
                <SgRow Space="SgSize.Sm">
                    <SgCol Xs="4">
                        <SgCard Title="Data Generator" Status="SgCardStatus.Info" Shadow="SgShadow.Sm" Size="SgSize.Sm" Compact="true">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgSlider TValue="int" @bind-Value="_rowCount" Min="10" Max="500" Step="10" Label="Rows" ShowInput="true" />
                                <SgSlider TValue="int" @bind-Value="_seed" Min="1" Max="100" Label="Seed" ShowInput="true" />
                                <SgRow Space="SgSize.Sm">
                                    <SgCol Xs="6"><SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined" OnClick="@Regenerate" Block="true">↻ Regenerate</SgButton></SgCol>
                                    <SgCol Xs="6"><SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Primary" OnClick="@ApplySettings" Block="true">Apply</SgButton></SgCol>
                                </SgRow>
                            </SgStack>
                        </SgCard>
                    </SgCol>
                    <SgCol Xs="4">
                        <SgCard Title="Feature Toggles" Status="SgCardStatus.Success" Shadow="SgShadow.Sm" Size="SgSize.Sm" Compact="true">
                            <SgRow Space="SgSize.Sm">
                                <SgCol Auto><SgSwitch @bind-Value="_showSearch" Label="Search" Size="SgSize.Sm" /></SgCol>
                                <SgCol Auto><SgSwitch @bind-Value="_showStatusBar" Label="StatusBar" Size="SgSize.Sm" /></SgCol>
                                <SgCol Auto><SgSwitch @bind-Value="_showColChooser" Label="ColChooser" Size="SgSize.Sm" /></SgCol>
                                <SgCol Auto><SgSwitch @bind-Value="_showQuickFilter" Label="QuickFilter" Size="SgSize.Sm" /></SgCol>
                                <SgCol Auto><SgSwitch @bind-Value="_enablePaging" Label="Pagination" Size="SgSize.Sm" /></SgCol>
                                <SgCol Auto><SgSwitch @bind-Value="_showRowNumbers" Label="RowNumbers" Size="SgSize.Sm" /></SgCol>
                                <SgCol Auto><SgSwitch @bind-Value="_showColBorders" Label="ColBorders" Size="SgSize.Sm" /></SgCol>
                                <SgCol Auto><SgSwitch @bind-Value="_wrapCells" Label="WrapCells" Size="SgSize.Sm" /></SgCol>
                                <SgCol Auto><SgSwitch @bind-Value="_showRowHighlighter" Label="RowHighlighter" Size="SgSize.Sm" /></SgCol>
                                <SgCol Auto><SgSwitch @bind-Value="_showExportCsv" Label="ExportCSV" Size="SgSize.Sm" /></SgCol>
                                <SgCol Auto><SgSwitch @bind-Value="_showExportExcel" Label="ExportExcel" Size="SgSize.Sm" /></SgCol>
                                <SgCol Auto><SgSwitch @bind-Value="_allowAutoFit" Label="AutoFit" Size="SgSize.Sm" /></SgCol>
                                <SgCol Auto><SgSwitch @bind-Value="_pinnedId" Label="PinnedID" Size="SgSize.Sm" /></SgCol>
                            </SgRow>
                        </SgCard>
                    </SgCol>
                    <SgCol Xs="4">
                        <SgCard Title="Display" Status="SgCardStatus.Warning" Shadow="SgShadow.Sm" Size="SgSize.Sm" Compact="true">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgSlider TValue="int" @bind-Value="_gridHeight" Min="200" Max="800" Step="20" Label="Grid Height" Suffix="px" ShowInput="true" />
                                <SgSelect TValue="int" @bind-Value="_pageSize" Items="_pageSizeOptions" Label="Page Size" />
                            </SgStack>
                        </SgCard>
                    </SgCol>
                </SgRow>
            </div>
        </div>

        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm" NoPadding="true" OverflowHidden="true">
            <SgDataGrid TItem="BigEmployee" Items="_data"
                        Height="@($"{_gridHeight}px")"
                        ShowSearch="@_showSearch"
                        ShowStatusBar="@_showStatusBar"
                        ShowColumnChooser="@_showColChooser"
                        ShowQuickFilters="@_showQuickFilter"
                        EnablePaging="@_enablePaging"
                        PageSize="@_pageSize"
                        ShowRowNumbers="@_showRowNumbers"
                        ShowColumnBorders="@_showColBorders"
                        WrapCells="@_wrapCells"
                        ShowRowHighlighter="@_showRowHighlighter"
                        ShowExportCsv="@_showExportCsv"
                        ShowExportExcel="@_showExportExcel"
                        AllowAutoFit="@_allowAutoFit">
                <ChildContent>
                    <SgDataGridColumn TItem="BigEmployee" Title="ID" Value="@(e => e.Id)" Width="60" Sortable="true" Filterable="true" Pinned="@_pinnedId" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Code" Value="@(e => e.EmployeeCode)" Width="100" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Global ID" Value="@(e => e.GlobalId)" Width="220" Sortable="true" Filterable="false" />
                    <SgDataGridColumn TItem="BigEmployee" Title="First Name" Value="@(e => e.FirstName)" Width="120" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Last Name" Value="@(e => e.LastName)" Width="120" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Middle Name" Value="@(e => e.MiddleName)" Width="120" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Email" Value="@(e => e.Email)" Width="200" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Phone" Value="@(e => e.Phone)" Width="130" Sortable="false" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Department" Value="@(e => e.Department)" Width="130" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Position" Value="@(e => e.Position)" Width="150" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Level" Value="@(e => e.Level)" Width="100" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Salary" Value="@(e => e.Salary)" Width="110" Sortable="true" Filterable="true" Format="N0" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Bonus" Value="@(e => e.Bonus)" Width="100" Sortable="true" Filterable="true" Format="N0" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Tax Rate" Value="@(e => e.TaxRate)" Width="90" Sortable="true" Filterable="true" Format="P0" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Hire Date" Value="@(e => e.HireDate)" Width="110" Sortable="true" Filterable="true" Format="dd.MM.yyyy" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Last Review" Value="@(e => e.LastReviewDate)" Width="110" Sortable="true" Filterable="true" Format="dd.MM.yyyy" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Birth Date" Value="@(e => e.BirthDate)" Width="100" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Shift Start" Value="@(e => e.ShiftStart)" Width="100" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Active" Value="@(e => e.IsActive)" Width="80" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Manager" Value="@(e => e.IsManager)" Width="90" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Exp (yrs)" Value="@(e => e.YearsOfExperience)" Width="80" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Projects" Value="@(e => e.ProjectsCount)" Width="80" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Rating" Value="@(e => e.Rating)" Width="80" Sortable="true" Filterable="true" Format="N1" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Efficiency" Value="@(e => e.Efficiency)" Width="90" Sortable="true" Filterable="true" Format="P0" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Vacation" Value="@(e => e.VacationDaysRemaining)" Width="80" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Sick Days" Value="@(e => e.SickDaysThisYear)" Width="80" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Last Login" Value="@(e => e.LastLogin)" Width="160" Sortable="true" Filterable="true" Format="g" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Session" Value="@(e => e.SessionDuration)" Width="100" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Notes" Value="@(e => e.Notes)" Width="200" Sortable="false" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Skills" Value="@(e => string.Join(", ", e.Skills))" Width="250" Sortable="false" Filterable="true" />
                </ChildContent>
            </SgDataGrid>
        </SgCard>

        <div class="demo-section" style="margin-top:32px;">
            <div class="demo-section-header">
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">Generated Code</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Razor markup for the current configuration</SgTypography>
            </div>
            <DemoCodeBlock Code="@_generatedCode" Language="Razor" Title="SgDataGrid markup" Highlighted="true" RawCode="@_plainCode" />
        </div>

    </ChildContent>
</SgCard>

@code {
    private static readonly List<SgSegmentedOption<string>> _presetOptions = [
        new() { Value = "Minimal", Label = "Minimal" },
        new() { Value = "Standard", Label = "Standard" },
        new() { Value = "FullFeatured", Label = "Full Featured" },
        new() { Value = "PowerUser", Label = "Power User" }
    ];

    private List<BigEmployee> _data = new();
    private int _rowCount = 50;
    private int _seed = 42;
    private int _gridHeight = 460;
    private int _pageSize = 15;
    private string _plainCode = "";
    private string _generatedCode = "";

    private bool _showSearch = true, _showStatusBar = true, _showColChooser = true,
                  _showQuickFilter, _enablePaging = true, _showRowNumbers,
                  _showColBorders, _wrapCells, _showRowHighlighter = true,
                  _showExportCsv, _showExportExcel, _allowAutoFit, _pinnedId;

    private static readonly List<(string Label, string Path)> _navPages = new()
    {
        ("Basic", "/datagrid-demo/basic"),
        ("Editing", "/datagrid-demo/editing"),
        ("Selection", "/datagrid-demo/selection"),
        ("Grouping", "/datagrid-demo/grouping"),
        ("Detail", "/datagrid-demo/detail"),
        ("Export", "/datagrid-demo/export"),
        ("Virtualization", "/datagrid-demo/virtualization"),
        ("Persistence", "/datagrid-demo/persistence"),
    };

    private static readonly int[] _pageSizeOptions = [5, 10, 15, 25, 50];

    protected override void OnInitialized()
    {
        Regenerate();
        UpdateGeneratedCode();
    }

    private void ApplySettings()
    {
        UpdateGeneratedCode();
    }

    private void Regenerate()
    {
        _data = SampleDataService.GenerateBigEmployees(_rowCount, _seed);
        UpdateGeneratedCode();
    }

    private void UpdateGeneratedCode()
    {
        _plainCode = $"""
            <SgDataGrid TItem="BigEmployee" Items="@_data"
                Height="{_gridHeight}px"
                ShowSearch="{_showSearch.ToString().ToLower()}"
                ShowStatusBar="{_showStatusBar.ToString().ToLower()}"
                ShowColumnChooser="{_showColChooser.ToString().ToLower()}"
                ShowQuickFilters="{_showQuickFilter.ToString().ToLower()}"
                EnablePaging="{_enablePaging.ToString().ToLower()}"
                PageSize="{_pageSize}"
                ShowRowNumbers="{_showRowNumbers.ToString().ToLower()}"
                ShowColumnBorders="{_showColBorders.ToString().ToLower()}"
                WrapCells="{_wrapCells.ToString().ToLower()}"
                ShowRowHighlighter="{_showRowHighlighter.ToString().ToLower()}"
                ShowExportCsv="{_showExportCsv.ToString().ToLower()}"
                ShowExportExcel="{_showExportExcel.ToString().ToLower()}"
                AllowAutoFit="{_allowAutoFit.ToString().ToLower()}">
                <ChildContent>
                    <SgDataGridColumn TItem="BigEmployee" Title="ID" Value="@(e => e.Id)" Width="60" Sortable="true" Filterable="true" Pinned="{_pinnedId.ToString().ToLower()}" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Code" Value="@(e => e.EmployeeCode)" Width="100" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Global ID" Value="@(e => e.GlobalId)" Width="220" Sortable="true" Filterable="false" />
                    <SgDataGridColumn TItem="BigEmployee" Title="First Name" Value="@(e => e.FirstName)" Width="120" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Last Name" Value="@(e => e.LastName)" Width="120" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Middle Name" Value="@(e => e.MiddleName)" Width="120" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Email" Value="@(e => e.Email)" Width="200" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Department" Value="@(e => e.Department)" Width="130" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Position" Value="@(e => e.Position)" Width="150" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Salary" Value="@(e => e.Salary)" Width="110" Sortable="true" Filterable="true" Format="N0" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Hire Date" Value="@(e => e.HireDate)" Width="110" Sortable="true" Filterable="true" Format="dd.MM.yyyy" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Last Review" Value="@(e => e.LastReviewDate)" Width="110" Sortable="true" Filterable="true" Format="dd.MM.yyyy" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Active" Value="@(e => e.IsActive)" Width="80" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Rating" Value="@(e => e.Rating)" Width="80" Sortable="true" Filterable="true" Format="N1" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Efficiency" Value="@(e => e.Efficiency)" Width="90" Sortable="true" Filterable="true" Format="P0" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Projects" Value="@(e => e.ProjectsCount)" Width="80" Sortable="true" Filterable="true" />
                </ChildContent>
            </SgDataGrid>
            """;
        _generatedCode = DataGridCodeHighlighter.AutoHighlight(_plainCode);
    }

    private void LoadPreset(string name)
    {
        switch (name)
        {
            case "Minimal":
                _rowCount = 10; _seed = 1; _gridHeight = 300; _pageSize = 5;
                _showSearch = false; _showStatusBar = false; _showColChooser = false;
                _showQuickFilter = false; _enablePaging = true; _showRowNumbers = false;
                _showColBorders = false; _wrapCells = false; _showRowHighlighter = false;
                _showExportCsv = false; _showExportExcel = false; _allowAutoFit = false; _pinnedId = false;
                break;
            case "Standard":
                _rowCount = 50; _seed = 42; _gridHeight = 460; _pageSize = 15;
                _showSearch = true; _showStatusBar = true; _showColChooser = true;
                _showQuickFilter = false; _enablePaging = true; _showRowNumbers = false;
                _showColBorders = false; _wrapCells = false; _showRowHighlighter = true;
                _showExportCsv = false; _showExportExcel = false; _allowAutoFit = false; _pinnedId = false;
                break;
            case "FullFeatured":
                _rowCount = 100; _seed = 42; _gridHeight = 600; _pageSize = 15;
                _showSearch = true; _showStatusBar = true; _showColChooser = true;
                _showQuickFilter = true; _enablePaging = true; _showRowNumbers = true;
                _showColBorders = true; _wrapCells = true; _showRowHighlighter = true;
                _showExportCsv = true; _showExportExcel = true; _allowAutoFit = true; _pinnedId = true;
                break;
            case "PowerUser":
                _rowCount = 200; _seed = 99; _gridHeight = 800; _pageSize = 25;
                _showSearch = true; _showStatusBar = true; _showColChooser = true;
                _showQuickFilter = true; _enablePaging = true; _showRowNumbers = false;
                _showColBorders = true; _wrapCells = false; _showRowHighlighter = true;
                _showExportCsv = true; _showExportExcel = true; _allowAutoFit = true; _pinnedId = true;
                break;
        }
    }
}
