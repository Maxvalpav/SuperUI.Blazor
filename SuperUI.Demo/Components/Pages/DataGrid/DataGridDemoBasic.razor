@page "/datagrid-demo/basic"
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Demo.Components
@using SuperUI.Demo.Models
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Basic — DataGrid – SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg" Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Basic + All Features"
                        Subtitle="30-column BigEmployee grid with all feature toggles. Resize, reorder, pin, sort, and filter to your heart's content."
                        Icon="@SgHeroicons.Outline.TableCells" GradientFrom="#6366f1" GradientTo="#8b5cf6" />
    </HeaderContent>
    <ChildContent>

        <div class="dg-nav-row" style="margin-bottom:16px;">
        <a class="dg-nav-link" href="/datagrid-demo">← Menu</a>
        <a class="dg-nav-link active" href="/datagrid-demo/basic">Basic</a>
        <a class="dg-nav-link" href="/datagrid-demo/editing">Editing</a>
        <a class="dg-nav-link" href="/datagrid-demo/selection">Selection</a>
        <a class="dg-nav-link" href="/datagrid-demo/grouping">Grouping</a>
        <a class="dg-nav-link" href="/datagrid-demo/detail">Detail</a>
        <a class="dg-nav-link" href="/datagrid-demo/export">Export</a>
        <a class="dg-nav-link" href="/datagrid-demo/virtualization">Virtualization</a>
        <a class="dg-nav-link" href="/datagrid-demo/persistence">Persistence</a>
    </div>

    <div class="dg-config">
        <div class="dg-config-panel">
            <div class="dg-config-panel-title">Data Generator</div>
            <div class="dg-config-row">
                <label>Rows:</label>
                <input type="range" min="10" max="500" step="10" value="@_rowCount"
                       @oninput="OnRowCountChange" />
                <input type="number" class="dg-number-input" min="10" max="500" value="@_rowCount"
                       @oninput="OnRowCountChange" />
                <span class="dg-value">@_rowCount</span>
            </div>
            <div class="dg-config-row">
                <label>Seed:</label>
                <input type="range" min="1" max="100" value="@_seed"
                       @oninput="OnSeedChange" />
                <span class="dg-value">@_seed</span>
            </div>
            <div style="margin-top:8px;">
                <button class="dg-config-row dg-toggle" @onclick="Regenerate" style="border-color:var(--sg-primary);color:var(--sg-primary);">
                    ⟳ Regenerate
                </button>
            </div>
        </div>
        <div class="dg-config-panel">
            <div class="dg-config-panel-title">Feature Toggles</div>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:4px;">
                @foreach (var key in _featureKeys)
                {
                    var k = key;
                    <label class="dg-toggle @(_features[k] ? "active" : "")">
                        <input type="checkbox" checked="@_features[k]" @onchange="() => ToggleFeature(k)" />
                        <span>@k</span>
                    </label>
                }
            </div>
            <div class="dg-config-row" style="margin-top:8px;">
                <label>Height:</label>
                <input type="range" min="200" max="800" step="20" value="@_gridHeight"
                       @oninput="OnGridHeightChange" />
                <span class="dg-value">@_gridHeight px</span>
            </div>
            <div class="dg-config-row">
                <label>Page size:</label>
                <select value="@_pageSize" @onchange="OnPageSizeChange">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="15">15</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
        </div>
    </div>

    <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm" NoPadding="true" OverflowHidden="true">
        <SgDataGrid TItem="BigEmployee" Items="_data"
                    Height="@($"{_gridHeight}px")"
                    ShowSearch="@_features["Search"]"
                    ShowStatusBar="@_features["StatusBar"]"
                    ShowColumnChooser="@_features["ColChooser"]"
                    ShowQuickFilters="@_features["QuickFilter"]"
                    EnablePaging="@_features["Pagination"]"
                    PageSize="@_pageSize"
                    ShowRowNumbers="@_features["RowNumbers"]"
                    ShowColumnBorders="@_features["ColBorders"]"
                    WrapCells="@_features["WrapCells"]"
                    ShowRowHighlighter="@_features["RowHighlighter"]"
                    ShowExportCsv="@_features["ExportCSV"]"
                    ShowExportExcel="@_features["ExportExcel"]"
                    AllowAutoFit="@_features["AutoFit"]">
            <ChildContent>
                <SgDataGridColumn TItem="BigEmployee" Title="ID" Value="@(e => e.Id)" Width="60" Sortable="true" Filterable="true" Pinned="@_features["PinnedID"]" />
                <SgDataGridColumn TItem="BigEmployee" Title="Code" Value="@(e => e.EmployeeCode)" Width="100" Sortable="true" Filterable="true" />
                <SgDataGridColumn TItem="BigEmployee" Title="Global ID" Value="@(e => e.GlobalId)" Width="220" Sortable="true" Filterable="false" />
                <SgDataGridColumn TItem="BigEmployee" Title="First Name" Value="@(e => e.FirstName)" Width="120" Sortable="true" Filterable="true" />
                <SgDataGridColumn TItem="BigEmployee" Title="Last Name" Value="@(e => e.LastName)" Width="120" Sortable="true" Filterable="true" />
                <SgDataGridColumn TItem="BigEmployee" Title="Middle Name" Value="@(e => e.MiddleName)" Width="120" Sortable="true" Filterable="true" />
                <SgDataGridColumn TItem="BigEmployee" Title="Email" Value="@(e => e.Email)" Width="200" Sortable="true" Filterable="true" />
                <SgDataGridColumn TItem="BigEmployee" Title="Phone" Value="@(e => e.Phone)" Width="130" Sortable="false" Filterable="true" />
                <SgDataGridColumn TItem="BigEmployee" Title="Department" Value="@(e => e.Department)" Width="130" Sortable="true" Filterable="true" />
                <SgDataGridColumn TItem="BigEmployee" Title="Position" Value="@(e => e.Position)" Width="150" Sortable="true" Filterable="true" />
                <SgDataGridColumn TItem="BigEmployee" Title="Level" Value="@(e => e.Level)" Width="100" Sortable="true" Filterable="true" />
                <SgDataGridColumn TItem="BigEmployee" Title="Salary" Value="@(e => e.Salary)" Width="110" Sortable="true" Filterable="true" Format="N0" />
                <SgDataGridColumn TItem="BigEmployee" Title="Bonus" Value="@(e => e.Bonus)" Width="100" Sortable="true" Filterable="true" Format="N0" />
                <SgDataGridColumn TItem="BigEmployee" Title="Tax Rate" Value="@(e => e.TaxRate)" Width="90" Sortable="true" Filterable="true" Format="P0" />
                <SgDataGridColumn TItem="BigEmployee" Title="Hire Date" Value="@(e => e.HireDate)" Width="110" Sortable="true" Filterable="true" Format="dd.MM.yyyy" />
                <SgDataGridColumn TItem="BigEmployee" Title="Last Review" Value="@(e => e.LastReviewDate)" Width="110" Sortable="true" Filterable="true" Format="dd.MM.yyyy" />
                <SgDataGridColumn TItem="BigEmployee" Title="Birth Date" Value="@(e => e.BirthDate)" Width="100" Sortable="true" Filterable="true" />
                <SgDataGridColumn TItem="BigEmployee" Title="Shift Start" Value="@(e => e.ShiftStart)" Width="100" Sortable="true" Filterable="true" />
                <SgDataGridColumn TItem="BigEmployee" Title="Active" Value="@(e => e.IsActive)" Width="80" Sortable="true" Filterable="true" />
                <SgDataGridColumn TItem="BigEmployee" Title="Manager" Value="@(e => e.IsManager)" Width="90" Sortable="true" Filterable="true" />
                <SgDataGridColumn TItem="BigEmployee" Title="Exp (yrs)" Value="@(e => e.YearsOfExperience)" Width="80" Sortable="true" Filterable="true" />
                <SgDataGridColumn TItem="BigEmployee" Title="Projects" Value="@(e => e.ProjectsCount)" Width="80" Sortable="true" Filterable="true" />
                <SgDataGridColumn TItem="BigEmployee" Title="Rating" Value="@(e => e.Rating)" Width="80" Sortable="true" Filterable="true" Format="N1" />
                <SgDataGridColumn TItem="BigEmployee" Title="Efficiency" Value="@(e => e.Efficiency)" Width="90" Sortable="true" Filterable="true" Format="P0" />
                <SgDataGridColumn TItem="BigEmployee" Title="Vacation" Value="@(e => e.VacationDaysRemaining)" Width="80" Sortable="true" Filterable="true" />
                <SgDataGridColumn TItem="BigEmployee" Title="Sick Days" Value="@(e => e.SickDaysThisYear)" Width="80" Sortable="true" Filterable="true" />
                <SgDataGridColumn TItem="BigEmployee" Title="Last Login" Value="@(e => e.LastLogin)" Width="160" Sortable="true" Filterable="true" Format="g" />
                <SgDataGridColumn TItem="BigEmployee" Title="Session" Value="@(e => e.SessionDuration)" Width="100" Sortable="true" Filterable="true" />
                <SgDataGridColumn TItem="BigEmployee" Title="Notes" Value="@(e => e.Notes)" Width="200" Sortable="false" Filterable="true" />
                <SgDataGridColumn TItem="BigEmployee" Title="Skills" Value="@(e => string.Join(", ", e.Skills))" Width="250" Sortable="false" Filterable="true" />
            </ChildContent>
        </SgDataGrid>
    </SgCard>

        <!-- Generated Code -->
        <div style="margin-top:24px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                <span style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--sg-text-muted);">Generated Code</span>
                <button type="button" @onclick="CopyCodeToClipboard" style="display:inline-flex;align-items:center;gap:4px;background:var(--sg-surface-alt);border:1px solid var(--sg-border);border-radius:6px;padding:4px 10px;cursor:pointer;color:var(--sg-text-muted);font-family:inherit;font-size:12px;">
                    <span>@_copyIcon</span>
                    <span style="font-size:11px;font-weight:600;">@_copyLabel</span>
                </button>
            </div>
            <div class="code-block">@_generatedCode</div>
        </div>

    </ChildContent>
</SgCard>

@code {
    private List<BigEmployee> _data = new();
    private int _rowCount = 50;
    private int _seed = 42;
    private int _gridHeight = 460;
    private int _pageSize = 15;
    private string _generatedCode = "";
    private string _copyIcon = "📋";
    private string _copyLabel = "Copy";

    private Dictionary<string, bool> _features = new()
    {
        ["Search"] = true, ["StatusBar"] = true, ["ColChooser"] = true,
        ["QuickFilter"] = false, ["Pagination"] = true, ["RowNumbers"] = false,
        ["ColBorders"] = false, ["WrapCells"] = false, ["RowHighlighter"] = true,
        ["ExportCSV"] = false, ["ExportExcel"] = false, ["AutoFit"] = false,
        ["PinnedID"] = false
    };
    private List<string> _featureKeys => _features.Keys.ToList();

    protected override void OnInitialized() { Regenerate(); UpdateGeneratedCode(); }

    private void OnRowCountChange(ChangeEventArgs e) { _rowCount = int.Parse(e.Value?.ToString() ?? "50"); Regenerate(); }
    private void OnSeedChange(ChangeEventArgs e) { _seed = int.Parse(e.Value?.ToString() ?? "42"); Regenerate(); }
    private void OnGridHeightChange(ChangeEventArgs e) { _gridHeight = int.Parse(e.Value?.ToString() ?? "460"); UpdateGeneratedCode(); }
    private void OnPageSizeChange(ChangeEventArgs e) { _pageSize = int.Parse(e.Value?.ToString() ?? "15"); UpdateGeneratedCode(); }
    private void ToggleFeature(string key) { _features[key] = !_features[key]; StateHasChanged(); UpdateGeneratedCode(); }

    private void Regenerate()
    {
        _data = SampleDataService.GenerateBigEmployees(_rowCount, _seed);
    }

    private void UpdateGeneratedCode()
    {
        var c = _features;
        _generatedCode = $"""
            <SgDataGrid TItem="BigEmployee" Items="@_data"
                Height="{_gridHeight}px"
                ShowSearch="{c["Search"].ToString().ToLower()}"
                ShowStatusBar="{c["StatusBar"].ToString().ToLower()}"
                ShowColumnChooser="{c["ColChooser"].ToString().ToLower()}"
                ShowQuickFilters="{c["QuickFilter"].ToString().ToLower()}"
                EnablePaging="{c["Pagination"].ToString().ToLower()}"
                PageSize="{_pageSize}"
                ShowRowNumbers="{c["RowNumbers"].ToString().ToLower()}"
                ShowColumnBorders="{c["ColBorders"].ToString().ToLower()}"
                WrapCells="{c["WrapCells"].ToString().ToLower()}"
                ShowRowHighlighter="{c["RowHighlighter"].ToString().ToLower()}"
                ShowExportCsv="{c["ExportCSV"].ToString().ToLower()}"
                ShowExportExcel="{c["ExportExcel"].ToString().ToLower()}"
                AllowAutoFit="{c["AutoFit"].ToString().ToLower()}">
                <ChildContent>
                    <SgDataGridColumn TItem="BigEmployee" Title="ID" Value="@(e => e.Id)" Width="60" Sortable="true" Filterable="true" Pinned="{c["PinnedID"].ToString().ToLower()}" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Code" Value="@(e => e.EmployeeCode)" Width="100" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Global ID" Value="@(e => e.GlobalId)" Width="220" Sortable="true" Filterable="false" />
                    <SgDataGridColumn TItem="BigEmployee" Title="First Name" Value="@(e => e.FirstName)" Width="120" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Last Name" Value="@(e => e.LastName)" Width="120" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Middle Name" Value="@(e => e.MiddleName)" Width="120" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Email" Value="@(e => e.Email)" Width="200" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Department" Value="@(e => e.Department)" Width="130" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Position" Value="@(e => e.Position)" Width="150" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Salary" Value="@(e => e.Salary)" Width="110" Sortable="true" Filterable="true" Format="N0" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Hire Date" Value="@(e => e.HireDate)" Width="110" Sortable="true" Filterable="true" Format="dd.MM.yyyy" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Last Review" Value="@(e => e.LastReviewDate)" Width="110" Sortable="true" Filterable="true" Format="dd.MM.yyyy" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Active" Value="@(e => e.IsActive)" Width="80" Sortable="true" Filterable="true" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Rating" Value="@(e => e.Rating)" Width="80" Sortable="true" Filterable="true" Format="N1" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Efficiency" Value="@(e => e.Efficiency)" Width="90" Sortable="true" Filterable="true" Format="P0" />
                    <SgDataGridColumn TItem="BigEmployee" Title="Projects" Value="@(e => e.ProjectsCount)" Width="80" Sortable="true" Filterable="true" />
                </ChildContent>
            </SgDataGrid>
            """;
    }

    private async Task CopyCodeToClipboard()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _generatedCode);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }
}
