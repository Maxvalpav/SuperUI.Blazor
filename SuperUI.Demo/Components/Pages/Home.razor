@page "/"
@using SuperUI.Components

<PageTitle>SUI - Компоненты Blazor</PageTitle>

<div style="max-width: 1400px; margin: 0 auto; padding: 40px 20px;">
    <div style="text-align: center; margin-bottom: 48px;">
        <div style="display: inline-flex; align-items: center; gap: 20px; margin-bottom: 16px;">
            <a href="/" style="text-decoration: none; display: flex; align-items: center; gap: 20px;">
                <div style="background-color: var(--sg-color-primary); padding:12px; border-radius: var(--sg-radius-md);">
                    <div style="display:grid; grid-template-columns: repeat(3, 14px); grid-template-rows: repeat(3, 14px); gap: 3px;">
                        <div style="background:rgba(255,255,255,0.2);"></div>
                        <div style="background:rgba(255,255,255,0.4);"></div>
                        <div style="background:rgba(255,255,255,0.1);"></div>
                        
                        <div style="background:var(--sg-color-primary-fg); display:flex; align-items:center; justify-content:center; color:var(--sg-color-primary); font-weight:900; font-size:10px;">S</div>
                        <div style="background:rgba(255,255,255,0.8); display:flex; align-items:center; justify-content:center; color:var(--sg-color-primary); font-weight:900; font-size:10px;">U</div>
                        <div style="background:rgba(255,255,255,0.5); display:flex; align-items:center; justify-content:center; color:var(--sg-color-primary); font-weight:900; font-size:10px;">I</div>
                        
                        <div style="background:rgba(255,255,255,0.1);"></div>
                        <div style="background:rgba(255,255,255,0.3);"></div>
                        <div style="background:rgba(255,255,255,0.2);"></div>
                    </div>
                </div>
                <h1 style="font-size: 2.5rem; font-weight: 700; margin: 0; color: var(--sg-fg);">
                    SUI
                </h1>
            </a>
        </div>
        <p style="font-size: 1.125rem; color: var(--sg-fg-muted); max-width: 600px; margin: 0 auto; line-height: 1.6;">
            Современная библиотека компонентов для Blazor. Создана для разработки сложных корпоративных интерфейсов с поддержкой множества тем и кастомизации.
        </p>
    </div>

    <div style="margin-bottom: 48px;">
        <h2 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 24px; color: var(--sg-fg);">
            Компоненты
        </h2>

        <SgDashboard Items="_dashboardItems"
                     Columns="3"
                     AllowDrag="false"
                     AllowResize="false"
                     AllowDelete="false">
            <WidgetTemplate>
                <div style="padding: 8px 0;">
                    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                        @if (context.Tag is List<DemoItem> items)
                        {
                            @foreach (var item in items)
                            {
                                <a href="@item.Url" style="text-decoration: none;">
                                    <SgChip Text="@item.Text" Variant="SgChipVariant.Default" />
                                </a>
                            }
                        }
                    </div>
                </div>
            </WidgetTemplate>
        </SgDashboard>
    </div>
</div>

