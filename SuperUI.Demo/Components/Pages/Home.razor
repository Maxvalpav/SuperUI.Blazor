@page "/"
@using SuperUI.Components

<PageTitle>SUI - Компоненты Blazor</PageTitle>

<div style="padding: 40px 20px;">
    <SgDashboard Items="_dashboardItems"
                 Columns="3"
                 AllowDrag="false"
                 AllowResize="false"
                 AllowDelete="false">
        <WidgetTemplate>
            <div style="padding: 8px 0;">
                <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                    @if (context.Tag is List<DemoItem> items)
                    {
                        @foreach (var item in items)
                        {
                            <a href="@item.Url" style="text-decoration: none;">
                                <SgChip Text="@item.Text" Variant="SgChipVariant.Default" />
                            </a>
                        }
                    }
                </div>
            </div>
        </WidgetTemplate>
    </SgDashboard>
</div>

