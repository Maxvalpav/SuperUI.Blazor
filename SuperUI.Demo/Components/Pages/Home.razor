@page "/"
@using SuperUI.Components

<PageTitle>SUI - Главная</PageTitle>

<div style="max-width: 1200px; margin: 0 auto; padding: 20px;">
    <div style="margin-bottom: 32px; text-align: center;">
        <h1 style="font-size: 2.5rem; font-weight: 800; color: var(--sui-fg); margin-bottom: 8px;">SUI</h1>
        <p style="font-size: 1.1rem; color: var(--sui-muted);">Библиотека компонентов на Blazor</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
        <SgCard Title="Таблицы и данные" Subtitle="Инструменты визуализации">
            <div style="padding: 16px 0;">              
                <div style="display: flex; flex-direction: column; gap: 10px;">
                    <a href="datagrid-demo" style="text-decoration: none;"><SgButton Text="Открыть DataGrid Demo" Variant="primary" Block="true" /></a>
                    <a href="query-builder" style="text-decoration: none;"><SgButton Text="Конструктор запросов" Variant="ghost" Block="true" /></a>
                    <a href="canvas-grid-demo" style="text-decoration: none;"><SgButton Text="Открыть Canvas Grid" Variant="ghost" Block="true" /></a>
                </div>
            </div>
        </SgCard>

        <SgCard Title="Формы и ввод" Subtitle="Ускоренная разработка CRUD">
            <div style="padding: 16px 0;">            
                <div style="display: flex; flex-direction: column; gap: 10px;">
                    <a href="data-form-demo" style="text-decoration: none;"><SgButton Text="Обзор DataForm" Variant="primary" Block="true" /></a>
                    <a href="data-form-crud" style="text-decoration: none;"><SgButton Text="CRUD пример" Variant="ghost" Block="true" /></a>
                    <a href="entity-picker-demo" style="text-decoration: none;"><SgButton Text="Entity Picker" Variant="ghost" Block="true" /></a>
                </div>
            </div>
        </SgCard>

        <SgCard Title="Бизнес-инструменты" Subtitle="Корпоративные функции">
            <div style="padding: 16px 0;">              
                <div style="display: flex; flex-direction: column; gap: 10px;">
                    <a href="gantt" style="text-decoration: none;"><SgButton Text="Диаграмма Ганта" Variant="primary" Block="true" /></a>
                    <a href="kanban" style="text-decoration: none;"><SgButton Text="Канбан-доска" Variant="ghost" Block="true" /></a>
                    <a href="pivot" style="text-decoration: none;"><SgButton Text="Сводные таблицы" Variant="ghost" Block="true" /></a>
                    <a href="calendar" style="text-decoration: none;"><SgButton Text="Календарь" Variant="ghost" Block="true" /></a>
                </div>
            </div>
        </SgCard>

        <SgCard Title="Enterprise" Subtitle="Корпоративные компоненты">
            <div style="padding: 16px 0;">       
                <div style="display: flex; flex-direction: column; gap: 10px;">
                    <a href="permission-gate-demo" style="text-decoration: none;"><SgButton Text="Permission Gate" Variant="primary" Block="true" /></a>
                    <a href="command-bar-demo" style="text-decoration: none;"><SgButton Text="Command Bar" Variant="ghost" Block="true" /></a>
                    <a href="rich-text-editor-demo" style="text-decoration: none;"><SgButton Text="Rich Text Editor" Variant="ghost" Block="true" /></a>
                </div>
            </div>
        </SgCard>

        <SgCard Title="Общие компоненты" Subtitle="Простые элементы UI">
            <div style="padding: 16px 0;">            
                <div style="display: flex; flex-direction: column; gap: 10px;">
                    <a href="data-display-demo" style="text-decoration: none;"><SgButton Text="Отображение данных" Variant="primary" Block="true" /></a>
                    <a href="inputs-demo" style="text-decoration: none;"><SgButton Text="Поля ввода" Variant="ghost" Block="true" /></a>
                    <a href="feedback-demo" style="text-decoration: none;"><SgButton Text="Обратная связь" Variant="ghost" Block="true" /></a>
                </div>
            </div>
        </SgCard>
    </div>

</div>

