@page "/"
@using SuperUI
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>SuperUI — Blazor Components</PageTitle>
<HeadContent>
    <meta name="description" content="SuperUI — enterprise-grade Blazor component library with 70+ components: DataGrid, Charts, DockManager, Forms, Navigation, and more. Open-source MIT license." />
    <meta property="og:description" content="SuperUI — enterprise-grade Blazor component library with 70+ components: DataGrid, Charts, DockManager, Forms, Navigation, and more. Open-source MIT license." />
    <meta property="og:title" content="SuperUI — Blazor Components" />
    <meta name="twitter:description" content="SuperUI — enterprise-grade Blazor component library with 70+ components: DataGrid, Charts, DockManager, Forms, Navigation, and more. Open-source MIT license." />
</HeadContent>

<style>
    .home-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
    }

    .hero-layout {
        display: flex;
        align-items: center;
        gap: 64px;
        padding: 60px 0;
        margin-bottom: 24px;
    }

    .hero-main {
        flex: 1.2;
    }

    .hero-visual {
        flex: 1;
        position: relative;
        display: flex;
        justify-content: center;
    }

    /* ── Logo Animation ── */
    .logo-container {
        position: relative;
        width: 100px;
        height: 100px;
        margin-bottom: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .logo-grid {
        display: grid;
        grid-template-columns: repeat(3, 26px);
        grid-template-rows: repeat(3, 26px);
        gap: 5px;
        z-index: 2;
    }

    .logo-cell {
        border-radius: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        font-size: 12px;
        color: white;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .logo-cell:hover {
        transform: scale(1.15) rotate(5deg);
        filter: brightness(1.2);
    }

    .logo-grid .cell-1 { background: var(--sg-color-primary); opacity: 0.3; animation: pulseCell 2s infinite 0.1s; }
    .logo-grid .cell-2 { background: var(--sg-color-primary); opacity: 0.6; animation: pulseCell 2s infinite 0.2s; }
    .logo-grid .cell-3 { background: var(--sg-color-primary); opacity: 0.2; animation: pulseCell 2s infinite 0.3s; }
    
    .logo-grid .cell-s { background: var(--sg-color-primary); box-shadow: 0 4px 12px var(--sg-color-primary-subtle); z-index: 3; }
    .logo-grid .cell-u { background: var(--sg-color-primary); opacity: 0.9; }
    .logo-grid .cell-i { background: var(--sg-color-primary); opacity: 0.5; }
    
    .logo-grid .cell-7 { background: var(--sg-color-primary); opacity: 0.15; animation: pulseCell 2s infinite 0.4s; }
    .logo-grid .cell-8 { background: var(--sg-color-primary); opacity: 0.4; animation: pulseCell 2s infinite 0.5s; }
    .logo-grid .cell-9 { background: var(--sg-color-primary); opacity: 0.3; animation: pulseCell 2s infinite 0.6s; }

    @@keyframes pulseCell {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(0.95); opacity: 0.4; }
    }

    .logo-glow {
        position: absolute;
        width: 150px;
        height: 150px;
        background: radial-gradient(circle, var(--sg-color-primary-subtle) 0%, transparent 70%);
        filter: blur(20px);
        animation: rotateGlow 8s linear infinite;
    }

    @@keyframes rotateGlow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .install-command {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 12px 18px;
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-divider);
        border-radius: 10px;
        font-family: var(--sg-font-mono);
        font-size: 14px;
        margin-top: 32px;
        width: fit-content;
        box-shadow: var(--sg-shadow-sm);
    }

    .abstract-shape {
        width: 400px;
        height: 400px;
        background: var(--sg-color-primary);
        border-radius: 40% 60% 60% 40% / 40% 40% 60% 60%;
        filter: blur(80px);
        opacity: 0.12;
        position: absolute;
        animation: morphShape 10s ease-in-out infinite alternate;
    }

    @@keyframes morphShape {
        from { border-radius: 40% 60% 60% 40% / 40% 40% 60% 60%; }
        to { border-radius: 60% 40% 40% 60% / 60% 60% 40% 40%; }
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
    }
</style>

<div class="home-container">
    @* ── Hero ────────────────────────────────────────────────────────── *@
    <div class="hero-layout">
        <div class="hero-main">
            <div class="logo-container">
                <div class="logo-glow"></div>
                <div class="logo-grid">
                    <div class="logo-cell cell-1"></div><div class="logo-cell cell-2"></div><div class="logo-cell cell-3"></div>
                    <div class="logo-cell cell-s">S</div><div class="logo-cell cell-u">U</div><div class="logo-cell cell-i">I</div>
                    <div class="logo-cell cell-7"></div><div class="logo-cell cell-8"></div><div class="logo-cell cell-9"></div>
                </div>
            </div>

            <SgTypography Variant="SgTypographyVariant.Heading1" Weight="SgTypographyWeight.Bold" Style="font-size: 4rem; line-height: 0.9; margin-bottom: 24px; letter-spacing: -2px;">
                SuperUI
            </SgTypography>
            <SgTypography Variant="SgTypographyVariant.Heading5" Color="var(--sg-text-muted)" Style="max-width: 520px; font-weight: 400; line-height: 1.5; font-size: 1.25rem;">
                Blazor Component Library
            </SgTypography>
            
            <div class="install-command">
                <span style="color: var(--sg-color-primary); font-weight: bold;">></span>
                <span>dotnet add package SuperUI</span>
                <SgIconButton Icon="@SgHeroicons.Outline.Clipboard" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" />
            </div>
        </div>

        <div class="hero-visual">
            <div class="abstract-shape"></div>
            <SgCard Style="width: 340px; transform: rotate(-3deg) translateY(-20px); z-index: 2; border: 1px solid var(--sg-color-primary-subtle);" Shadow="SgShadow.Xl" Radius="SgSize.Lg">
                 <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <SgTypography Variant="SgTypographyVariant.Heading6" Weight="SgTypographyWeight.Bold">Data Grid</SgTypography>
                    <SgTag Size="SgSize.Sm" Variant="SgTagVariant.Primary">Active</SgTag>
                 </div>
                 <div style="display: flex; flex-direction: column; gap: 10px;">
                    <div style="height: 10px; width: 100%; background: var(--sg-surface-alt); border-radius: 6px;"></div>
                    <div style="height: 10px; width: 85%; background: var(--sg-surface-alt); border-radius: 6px;"></div>
                    <div style="height: 10px; width: 95%; background: var(--sg-color-primary-subtle); border-radius: 6px;"></div>
                 </div>
            </SgCard>
            <SgCard Style="width: 220px; position: absolute; bottom: -20px; right: 20px; transform: rotate(5deg); z-index: 3; border: 1px solid var(--sg-color-success-subtle);" Shadow="SgShadow.Xl" Radius="SgSize.Lg">
                 <SgStatistic Title="Performance" Value="60 FPS" Size="SgSize.Sm" Color="var(--sg-color-success)" />
            </SgCard>
        </div>
    </div>

    @* ── Features ────────────────────────────────────────────────────── *@
    <div class="home-section">
        <div class="feature-grid">
            @foreach (var f in _features)
            {
                <SgCard Hoverable="true" Style="padding: 24px; border: 1px solid transparent; transition: all 0.3s;" Class="hover-border-primary" OnClick='() => NavTo(f.Path)'>
                    <div style="color: @f.Color; margin-bottom: 16px; opacity: 0.8;">
                        <SgIcon Icon="@f.Icon" Size="28px" />
                    </div>
                    <SgTypography Variant="SgTypographyVariant.Heading6" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px;">@f.Title</SgTypography>
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" Style="line-height: 1.5;">@f.Desc</SgTypography>
                </SgCard>
            }
        </div>
    </div>
</div>

<style>
    .hover-border-primary:hover {
        border-color: var(--sg-color-primary-subtle) !important;
        box-shadow: var(--sg-shadow-lg) !important;
    }
</style>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
    private void NavTo(string path) => Nav.NavigateTo(path);

    private record Feature(string Title, string Desc, string Icon, string Color, string Path);
    private List<Feature> _features = new()
    {
        new("Data Management", "High-performance Grids, Kanban, Gantt, and Pivot.", SgHeroicons.Outline.ServerStack, "var(--sg-color-primary)", "datagrid-demo"),
        new("Visualization", "Interactive Charts (ECharts, Chart.js) and SVG Maps.", SgHeroicons.Outline.ChartPie, "var(--sg-color-success)", "echarts-demo"),
        new("Layout", "Enterprise UI: Dock manager, Splitters, and Ribbon panels.", SgHeroicons.Outline.ViewColumns, "var(--sg-color-info)", "ribbon-demo"),
        new("Forms", "Smart forms, rich editors, and built-in validation.", SgHeroicons.Outline.PencilSquare, "var(--sg-color-warning)", "smart-form-demo"),
        new("Navigation", "Tabs, Steppers, Breadcrumbs, and multi-level menus.", SgHeroicons.Outline.Bars3, "var(--sg-color-danger)", "nav-menu-demo"),
        new("Modern Utils", "Monaco editor, Terminal, and adaptive utilities.", SgHeroicons.Outline.CommandLine, "var(--sg-text-muted)", "monaco-demo"),
    };
}
