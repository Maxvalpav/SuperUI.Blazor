@page "/components-home"
@using SuperUI
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>SuperUI — Blazor Components</PageTitle>

<style>
    .sui-widget-card {
        padding: 12px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .sui-widget-card .sui-stat-ico {
        flex-shrink: 0;
        width: 28px;
        height: 28px;
    }
    .sui-widget-card .sui-stat-body {
        flex: 1;
    }
    .sui-widget-card .sui-stat-val {
        font-size: 1.4rem;
        font-weight: 700;
        line-height: 1.2;
    }
    .sui-widget-card .sui-stat-lbl {
        font-size: .8rem;
        color: var(--sg-text-muted);
    }
    .sui-example-card {
        padding: 8px 12px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }
    .sui-example-card .sui-ex-ico {
        flex-shrink: 0;
        width: 22px;
        height: 22px;
        margin-top: 2px;
    }
    .sui-example-card .sui-ex-body {
        flex: 1;
        min-width: 0;
    }
    .sui-example-card h4 {
        margin: 0 0 2px;
        font-size: .95rem;
        font-weight: 600;
    }
    .sui-example-card p {
        margin: 0;
        font-size: .8rem;
        color: var(--sg-text-muted);
    }
    .sui-nav-widget a {
        font-size: .85rem;
        color: var(--sg-primary);
        text-decoration: none;
        padding: 2px 0;
        display: block;
        font-weight: 500;
        transition: color .15s;
    }
    .sui-nav-widget a:hover {
        color: var(--sg-primary-hover);
        text-decoration: underline;
    }
    .sui-nav-header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 0;
    }
    .sui-nav-header .sui-nav-ico {
        flex-shrink: 0;
        width: 20px;
        height: 20px;
    }
    .sui-nav-header .sui-nav-label {
        font-size: .9rem;
        font-weight: 600;
        text-transform: capitalize;
    }
    .sui-hero {
        text-align: center;
        padding: 32px 0 20px;
    }
    .sui-hero h1 {
        font-size: 2.2rem;
        font-weight: 700;
        margin: 0 0 4px;
    }
    .sui-hero p {
        color: var(--sg-text-muted);
        max-width: 480px;
        margin: 0 auto;
    }
    .sui-hero .sui-btns {
        margin-top: 12px;
        display: flex;
        gap: 8px;
        justify-content: center;
        flex-wrap: wrap;
    }
    .sui-section-title {
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0;
        padding: 8px 0;
    }
</style>

<div class="sui-hero">
    <h1>SuperUI</h1>
    <p>90+ Blazor components — data grid, charts, gantt, scheduler, kanban, org chart, forms, AI, maps. Dark mode, localization.</p>
    <div class="sui-btns">
        <SgButton Text="GitHub" Variant="SgButtonVariant.Primary" Size="SgSize.Sm" />
        <SgButton Text="NuGet" Variant="SgButtonVariant.Primary" Size="SgSize.Sm" />
        <SgButton Text="dotnet add package SuperUI" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" CssClass="sgc-font-mono" />
    </div>
</div>

<SgDashboard Columns="24"
             Items="@Items"
             AllowDrag="false"
             AllowResize="false"
             AllowDelete="false"
             Compact="true"
             RowMinHeight="80">

    <WidgetTemplate>
        @if (context.Id == "stat-components")
        {
            <div class="sui-widget-card">
                <span class="sui-stat-ico" style="color:var(--sg-primary);">@((MarkupString)SgHeroicons.Outline.Squares2x2)</span>
                <div class="sui-stat-body">
                    <div class="sui-stat-val" style="color:var(--sg-primary);">90+</div>
                    <div class="sui-stat-lbl">Components</div>
                </div>
            </div>
        }
        else if (context.Id == "stat-version")
        {
            <div class="sui-widget-card">
                <span class="sui-stat-ico" style="color:var(--sg-color-success);">@((MarkupString)SgHeroicons.Outline.Tag)</span>
                <div class="sui-stat-body">
                    <div class="sui-stat-val" style="color:var(--sg-color-success);">1.2.1</div>
                    <div class="sui-stat-lbl">Version</div>
                </div>
            </div>
        }
        else if (context.Id == "stat-license")
        {
            <div class="sui-widget-card">
                <span class="sui-stat-ico" style="color:var(--sg-color-warning);">@((MarkupString)SgHeroicons.Outline.ShieldCheck)</span>
                <div class="sui-stat-body">
                    <div class="sui-stat-val" style="color:var(--sg-color-warning);">MIT</div>
                    <div class="sui-stat-lbl">License</div>
                </div>
            </div>
        }
        else if (context.Id == "stat-hosting")
        {
            <div class="sui-widget-card">
                <span class="sui-stat-ico" style="color:var(--sg-color-info);">@((MarkupString)SgHeroicons.Outline.GlobeAlt)</span>
                <div class="sui-stat-body">
                    <div class="sui-stat-val" style="color:var(--sg-color-info);">WASM</div>
                    <div class="sui-stat-lbl">Hosting</div>
                </div>
            </div>
        }
        else if (context.Id == "title-examples")
        {
            <div class="sui-nav-header">
                <span class="sui-nav-ico" style="color:var(--sg-primary);">@((MarkupString)SgHeroicons.Outline.Sparkles)</span>
                <div class="sui-nav-label">Examples</div>
            </div>
        }
        else if (context.Id == "ex-datagrid")
        {
            <a href="datagrid-demo" style="text-decoration:none;display:block;">
                <div class="sui-example-card" style="border-left:3px solid var(--sg-color-info);">
                    <span class="sui-ex-ico" style="color:var(--sg-color-info);">@((MarkupString)SgHeroicons.Outline.TableCells)</span>
                    <div class="sui-ex-body">
                        <h4>Data Grid</h4>
                        <p>Sorting, filtering, grouping, paging, inline edit, export.</p>
                    </div>
                </div>
            </a>
        }
        else if (context.Id == "ex-charts")
        {
            <a href="charts-demo" style="text-decoration:none;display:block;">
                <div class="sui-example-card" style="border-left:3px solid var(--sg-color-success);">
                    <span class="sui-ex-ico" style="color:var(--sg-color-success);">@((MarkupString)SgHeroicons.Outline.ChartBar)</span>
                    <div class="sui-ex-body">
                        <h4>Charts</h4>
                        <p>Chart.js, ECharts, D3.js, Three.js, Mermaid — line, bar, pie.</p>
                    </div>
                </div>
            </a>
        }
        else if (context.Id == "ex-gantt")
        {
            <a href="gantt" style="text-decoration:none;display:block;">
                <div class="sui-example-card" style="border-left:3px solid var(--sg-color-warning);">
                    <span class="sui-ex-ico" style="color:var(--sg-color-warning);">@((MarkupString)SgHeroicons.Outline.CalendarDays)</span>
                    <div class="sui-ex-body">
                        <h4>Gantt &amp; Scheduler</h4>
                        <p>Interactive Gantt, drag-resize. Scheduler day/week/month.</p>
                    </div>
                </div>
            </a>
        }
        else if (context.Id == "ex-ai")
        {
            <a href="chat-demo" style="text-decoration:none;display:block;">
                <div class="sui-example-card" style="border-left:3px solid var(--sg-color-danger);">
                    <span class="sui-ex-ico" style="color:var(--sg-color-danger);">@((MarkupString)SgHeroicons.Outline.Bolt)</span>
                    <div class="sui-ex-body">
                        <h4>AI &amp; Chat</h4>
                        <p>LLM chat, RAG, smart forms, state inspector, OCR.</p>
                    </div>
                </div>
            </a>
        }
        else if (context.Id == "ex-pivot")
        {
            <a href="pivot" style="text-decoration:none;display:block;">
                <div class="sui-example-card" style="border-left:3px solid var(--sg-color-info);">
                    <span class="sui-ex-ico" style="color:var(--sg-color-info);">@((MarkupString)SgHeroicons.Outline.AdjustmentsHorizontal)</span>
                    <div class="sui-ex-body">
                        <h4>Pivot &amp; Kanban</h4>
                        <p>Pivot table, heatmap. Kanban drag-drop, swimlanes.</p>
                    </div>
                </div>
            </a>
        }
        else if (context.Id == "ex-maps")
        {
            <a href="yandex-map-demo" style="text-decoration:none;display:block;">
                <div class="sui-example-card" style="border-left:3px solid var(--sg-color-success);">
                    <span class="sui-ex-ico" style="color:var(--sg-color-success);">@((MarkupString)SgHeroicons.Outline.MapPin)</span>
                    <div class="sui-ex-body">
                        <h4>Maps</h4>
                        <p>Google Maps, Yandex Maps, Leaflet, 2GIS, vehicle tracking.</p>
                    </div>
                </div>
            </a>
        }
        else if (context.Id == "title-components")
        {
            <div class="sui-nav-header">
                <span class="sui-nav-ico" style="color:var(--sg-primary);">@((MarkupString)SgHeroicons.Outline.Squares2x2)</span>
                <div class="sui-nav-label">Components</div>
            </div>
        }
        else if (context.Id.StartsWith("cat-"))
        {
            var (ico, clr) = context.Id switch
            {
                "cat-data"     => (SgHeroicons.Outline.ServerStack, "var(--sg-color-info)"),
                "cat-forms"    => (SgHeroicons.Outline.PencilSquare, "var(--sg-color-success)"),
                "cat-overlays" => (SgHeroicons.Outline.Window, "var(--sg-color-warning)"),
                "cat-nav"      => (SgHeroicons.Outline.Bars3, "var(--sg-color-danger)"),
                "cat-layout"   => (SgHeroicons.Outline.ViewColumns, "var(--sg-color-info)"),
                "cat-charts"   => (SgHeroicons.Outline.ChartPie, "var(--sg-color-success)"),
                "cat-ai"       => (SgHeroicons.Outline.CpuChip, "var(--sg-color-danger)"),
                "cat-maps"     => (SgHeroicons.Outline.Map, "var(--sg-color-warning)"),
                _              => ("", "var(--sg-text-muted)")
            };
            var links = context.Id switch
            {
                "cat-data" => new[] {
                    ("DataGrid", "datagrid-demo"),
                    ("Table", "sgtable-demo"),
                    ("Pivot Table", "pivot"),
                    ("Kanban", "kanban"),
                    ("Gantt", "gantt"),
                    ("Scheduler", "scheduler-demo"),
                    ("Spreadsheet", "spreadsheet-demo"),
                    ("Org Chart", "orgchart-demo"),
                },
                "cat-forms" => new[] {
                    ("Button", "button-demo"),
                    ("Select", "select-demo"),
                    ("AutoComplete", "autocomplete-demo"),
                    ("DatePicker", "date-time-picker-demo"),
                    ("Slider", "slider-demo"),
                    ("Rich Text", "rich-text-editor-demo"),
                    ("Query Builder", "query-builder"),
                    ("Data Form", "data-form-demo"),
                },
                "cat-overlays" => new[] {
                    ("Modal", "modal-demo"),
                    ("Drawer", "drawer-demo"),
                    ("Popover", "popover-demo"),
                    ("Tooltip", "tooltip-demo"),
                    ("Spinner", "spinner-demo"),
                    ("Alert", "alert-demo"),
                    ("Progress", "progress-demo"),
                    ("Notifications", "notification-panel-demo"),
                },
                "cat-nav" => new[] {
                    ("Tabs", "tabs-demo"),
                    ("Stepper", "stepper-demo"),
                    ("Breadcrumb", "breadcrumb-demo"),
                    ("Pagination", "pagination-demo"),
                    ("CommandBar", "command-bar-demo"),
                    ("NavMenu", "navmenu-demo"),
                },
                "cat-layout" => new[] {
                    ("Row/Col Grid", "row-demo"),
                    ("Splitter", "splitter-demo"),
                    ("Accordion", "accordion-demo"),
                    ("Collapse", "collapse-demo"),
                    ("Resizable", "resizable-demo"),
                    ("Ribbon", "ribbon-demo"),
                },
                "cat-charts" => new[] {
                    ("Chart.js", "charts-demo"),
                    ("ECharts", "echarts-demo"),
                    ("D3.js", "d3-demo"),
                    ("Three.js", "three-demo"),
                    ("Mermaid", "mermaid-demo"),
                    ("BPMN", "bpmn-demo"),
                },
                "cat-ai" => new[] {
                    ("Chat", "chat-demo"),
                    ("RAG", "rag-demo"),
                    ("LLM Studio", "llm-studio-demo"),
                    ("OCR", "ocr-demo"),
                    ("Smart Form", "smart-form-demo"),
                },
                "cat-maps" => new[] {
                    ("Yandex Maps", "yandex-map-demo"),
                    ("Leaflet", "leaflet-demo"),
                    ("Google Maps", "google-map-demo"),
                    ("Terminal", "terminal-demo"),
                    ("Network", "network-trace-demo"),
                },
                _ => Array.Empty<(string, string)>()
            };
            <div class="sui-nav-widget" style="padding:8px 0;">
                <div class="sui-nav-header" style="padding:0 0 6px;">
                    <span class="sui-nav-ico" style="color:@clr;">@((MarkupString)ico)</span>
                    <div class="sui-nav-label" style="color:@clr;">@(context.Id.Replace("cat-", ""))</div>
                </div>
                @foreach (var (name, href) in links)
                {
                    <a href="@href">@name</a>
                }
            </div>
        }
    </WidgetTemplate>

</SgDashboard>

<div style="text-align:center;padding:24px 0 8px;">
    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
        Built on .NET 10 &middot; MIT &copy; 2026 SuperUI Contributors
    </SgTypography>
</div>

@code {
    private List<SgDashboardWidgetItem> Items { get; set; } = new()
    {
        // Stats
        new() { Id = "stat-components", Title = "", ColumnSpan = 6 },
        new() { Id = "stat-version",    Title = "", ColumnSpan = 6 },
        new() { Id = "stat-license",    Title = "", ColumnSpan = 6 },
        new() { Id = "stat-hosting",    Title = "", ColumnSpan = 6 },

        // Examples title
        new() { Id = "title-examples",  Title = "", ColumnSpan = 24, Locked = true },

        // Examples
        new() { Id = "ex-datagrid", Title = "", ColumnSpan = 8 },
        new() { Id = "ex-charts",   Title = "", ColumnSpan = 8 },
        new() { Id = "ex-gantt",    Title = "", ColumnSpan = 8 },
        new() { Id = "ex-ai",       Title = "", ColumnSpan = 8 },
        new() { Id = "ex-pivot",    Title = "", ColumnSpan = 8 },
        new() { Id = "ex-maps",     Title = "", ColumnSpan = 8 },

        // Components title
        new() { Id = "title-components", Title = "", ColumnSpan = 24, Locked = true },

        // Component categories
        new() { Id = "cat-data",     Title = "", ColumnSpan = 6 },
        new() { Id = "cat-forms",    Title = "", ColumnSpan = 6 },
        new() { Id = "cat-overlays", Title = "", ColumnSpan = 6 },
        new() { Id = "cat-nav",      Title = "", ColumnSpan = 6 },
        new() { Id = "cat-layout",   Title = "", ColumnSpan = 6 },
        new() { Id = "cat-charts",   Title = "", ColumnSpan = 6 },
        new() { Id = "cat-ai",       Title = "", ColumnSpan = 6 },
        new() { Id = "cat-maps",     Title = "", ColumnSpan = 6 },
    };
}
