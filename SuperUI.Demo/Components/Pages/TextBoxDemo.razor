@page "/demo/textbox"
@using SuperUI.Demo.Components

<div class="demo-page">
    <div class="demo-hero">
        <section class="demo-hero-main">
            <div class="demo-header">
                <div class="demo-kicker">Form Components</div>
                <h1 class="demo-title">SgTextBox</h1>
                <p class="demo-subtitle">
                    Flexible text field for forms, search, passwords and multiline content with validation hooks,
                    prefix/suffix support and clean form integration.
                </p>
            </div>
        </section>

        <aside class="demo-hero-side">
            <div class="demo-side-title">Highlights</div>
            <div class="demo-pill-list">
                <span class="demo-pill demo-pill-accent">EditContext Ready</span>
                <span class="demo-pill">Password Toggle</span>
                <span class="demo-pill">Prefix / Suffix</span>
                <span class="demo-pill">Validation</span>
            </div>

            <div class="demo-meta-grid">
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Modes</span>
                    <span class="demo-meta-value">Single line, password, textarea</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">UX</span>
                    <span class="demo-meta-value">Counter, clear button, debounce, enter callback</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Rendering</span>
                    <span class="demo-meta-value">SSR-safe interactive field behavior</span>
                </div>
            </div>
        </aside>
    </div>

    <SgDemoSection Eyebrow="Usage" Title="Examples" Description="Representative field layouts for forms, profile pages and data entry screens.">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Basic Field</h3>
                    <p class="demo-showcase-desc">Standard labeled input with hint text and live binding.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgTextBox @bind-Value="_text"
                                   Label="Username"
                                   Placeholder="Enter your username"
                                   Hint="Use letters and numbers only"
                                   ShowClearButton="true" />
                        <div class="demo-inline-value">Current value: @(string.IsNullOrWhiteSpace(_text) ? "empty" : _text)</div>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Password</h3>
                    <p class="demo-showcase-desc">Secure entry with built-in visibility toggle.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgTextBox TValue="string"
                                   Type="password"
                                   Label="Password"
                                   Placeholder="Enter password"
                                   Hint="Use at least 8 characters" />
                    </div>
                    <div class="demo-note">This mode is ideal for login and reset forms.</div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Affixes And Search</h3>
                    <p class="demo-showcase-desc">Use prefix, suffix and icons to clarify the expected value.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgTextBox TValue="string" Label="Price" Placeholder="0.00" Prefix="$" Suffix="USD" />
                        <SgTextBox TValue="string" Label="Search" Placeholder="Type here..." ShowClearButton="true">
                            <StartIcon>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                            </StartIcon>
                        </SgTextBox>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Textarea And States</h3>
                    <p class="demo-showcase-desc">Long text, readonly and invalid states in one place.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgTextBox TValue="string"
                                   Multiline="true"
                                   Rows="4"
                                   Label="Bio"
                                   Placeholder="Tell us about yourself..."
                                   ShowCounter="true"
                                   MaxLength="200" />
                        <SgTextBox TValue="string" Label="ReadOnly" ReadOnly="true" Value="@("You can see but not edit")" />
                        <SgTextBox TValue="string" Label="Invalid" ErrorText="This field is required" Value="@("")" />
                    </div>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoParams Description="Most frequently used public parameters for `SgTextBox<TValue>`.">
        <SgDemoParam Name="Label" Type="string" Description="Field title shown above or beside the input." Values="Any text value" DefaultValue="null" />
        <SgDemoParam Name="Placeholder" Type="string" Description="Placeholder shown when value is empty." Values="Any text value" DefaultValue="null" />
        <SgDemoParam Name="Type" Type="string" Description="HTML input type." Values="text | password | email | search | tel | ..." DefaultValue="text" />
        <SgDemoParam Name="Multiline" Type="bool" Description="Switches to textarea rendering." Values="true | false" DefaultValue="false" />
        <SgDemoParam Name="Rows" Type="int" Description="Visible row count for textarea mode." Values="Any positive integer" DefaultValue="3" />
        <SgDemoParam Name="ShowClearButton" Type="bool" Description="Shows a clear control when there is a value." Values="true | false" DefaultValue="false" />
        <SgDemoParam Name="ShowCounter" Type="bool" Description="Shows live character count when `MaxLength` is set." Values="true | false" DefaultValue="false" />
        <SgDemoParam Name="Prefix / Suffix" Type="string" Description="Static text rendered inside the input area." Values="Currency, units, search prefix, etc." DefaultValue="null" />
        <SgDemoParam Name="Debounce" Type="int" Description="Defers update propagation while typing." Values="Milliseconds, 0 disables debounce" DefaultValue="0" />
    </SgDemoParams>
</div>

@code {
    private string? _text;
}
