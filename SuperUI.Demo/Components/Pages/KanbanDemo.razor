@page "/kanban"
@using SuperUI.Components

<PageTitle>Канбан-доска - SUI</PageTitle>

<SgCard Title="SgKanban - Канбан-доска" 
        Subtitle="Гибкая канбан-доска для визуального управления рабочими процессами. Поддерживает перетаскивание задач, редактирование, управление статусами и WIP-лимиты.">
    
    <!-- 1. Основная канбан-доска -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">1. Интерактивная канбан-доска</SgTypography>
        <p>Канбан-доска с поддержкой перетаскивания задач между колонками, редактирования и управления статусами.</p>
        
        <SgCard Title="Канбан-доска" Style="margin-top: 16px;">
            <div style="height: 600px; border: 1px solid var(--sui-border); border-radius: 8px; overflow: hidden; background: #f8f9fa;">
                <SgKanban @bind-Tasks="_tasks" @bind-Columns="_columns" />
            </div>
        </SgCard>
    </div>

    <!-- 2. Канбан-доска с WIP лимитами -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">2. Канбан-доска с WIP лимитами</SgTypography>
        <p>Канбан-доска с установленными лимитами работ в процессе (WIP) для каждой колонки.</p>
        
        <SgCard Title="Канбан-доска с WIP лимитами" Style="margin-top: 16px;">
            <div style="height: 600px; border: 1px solid var(--sui-border); border-radius: 8px; overflow: hidden; background: #f8f9fa;">
                <SgKanban @bind-Tasks="_tasksWithWip" @bind-Columns="_columnsWithWip" />
            </div>
        </SgCard>
    </div>

    <!-- 3. Статистика проекта -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">3. Статистика проекта</SgTypography>
        <p>Обзор текущего состояния задач по колонкам и статусам.</p>
        
        <SgCard Title="Статистика проекта" Style="margin-top: 16px;">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px;">
                @foreach (var col in _columns)
                {
                    var count = _tasks.Count(t => t.ColumnId == col.Id);
                    var percentage = _tasks.Count > 0 ? (count * 100 / _tasks.Count) : 0;
                    <div style="padding: 16px; border: 1px solid var(--sui-border); border-radius: 8px; border-left: 4px solid @col.Color;">
                        <div style="font-size: 12px; color: var(--sui-text-muted); text-transform: uppercase; letter-spacing: 0.5px;">@col.Title</div>
                        <div style="font-size: 24px; font-weight: 700; margin-top: 4px;">@count</div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-top: 8px;">@percentage% от всех</div>
                    </div>
                }
            </div>
        </SgCard>
    </div>

    <!-- 4. Параметры компонента -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">4. Параметры компонента</SgTypography>
        <p>Полный список параметров SgKanban для настройки поведения и внешнего вида.</p>
        
        <SgCard Title="Основные параметры" Style="margin-top: 16px;">
            <PropertyTable Items="_mainProperties" />
        </SgCard>

        <SgCard Title="Параметры отображения" Style="margin-top: 16px;">
            <PropertyTable Items="_displayProperties" />
        </SgCard>

        <SgCard Title="События и обработчики" Style="margin-top: 16px;">
            <PropertyTable Items="_eventProperties" />
        </SgCard>
    </div>

    <!-- 5. Структура данных -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">5. Структура данных</SgTypography>
        <p>Описание структуры объектов SgKanbanTask и SgKanbanColumn.</p>
        
        <SgCard Title="SgKanbanTask" Style="margin-top: 16px;">
            <PropertyTable Items="_taskProperties" />
        </SgCard>

        <SgCard Title="SgKanbanColumn" Style="margin-top: 16px;">
            <PropertyTable Items="_columnProperties" />
        </SgCard>
    </div>
</SgCard>

