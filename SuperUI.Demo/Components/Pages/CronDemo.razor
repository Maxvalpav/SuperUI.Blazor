    private bool _ctorShowCalendar;
    private bool _ctorShowTimeZone;
    private bool _ctorShowComplexity = true;
    private bool _ctorShowLibrary;
    private bool _ctorShowIcalExport;
    private bool _ctorShowPreview = true;
    private bool _ctorBlock = true;
    private bool _ctorCompact;

    // ── Code generation ─────────────────────────────────────────────────
    private string[] _ctorCodeLines = Array.Empty<string>();
    private string _ctorCopyIcon = "📋";
    private string _ctorCopyLabel = "Copy";

    // ── Lifecycle ───────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add("<SgCron");
        lines.Add("           Value=\"@_myValue\"");
        lines.Add("           Label=\"Constructor Preview\"");
        lines.Add("           Hint=\"All feature flags applied.\"");
        if (_ctorShowNextFireTimes)
        {
            if (_ctorNextFireCount != 5)
                lines.Add($"           ShowNextFireTimes=\"true\" NextFireCount=\"{_ctorNextFireCount}\"");
            else
                lines.Add("           ShowNextFireTimes=\"true\"");
        }
        if (_ctorShowCalendar)
            lines.Add("           ShowCalendar=\"true\"");
        if (_ctorShowTimeZone)
            lines.Add("           ShowTimeZone=\"true\"");
        if (_ctorShowComplexity)
            lines.Add("           ShowComplexity=\"true\"");
        if (_ctorShowLibrary)
            lines.Add("           ShowLibrary=\"true\"");
        if (_ctorShowIcalExport)
            lines.Add("           ShowIcalExport=\"true\"");
        if (!_ctorShowPreview)
            lines.Add("           ShowPreview=\"false\"");
        if (!_ctorBlock)
            lines.Add("           Block=\"false\"");
        if (_ctorCompact)
            lines.Add("           Compact=\"true\"");
        lines.Add("           UseEnglish=\"true\"");
        lines.Add("           />");
        _ctorCodeLines = lines.ToArray();
    }

    private async Task CopyCtorCodeToClipboard()
    {
        var code = string.Join("\n", _ctorCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _ctorCopyIcon = "✓";
            _ctorCopyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _ctorCopyIcon = "📋";
            _ctorCopyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _ctorCopyIcon = "✗";
            _ctorCopyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _ctorCopyIcon = "📋";
            _ctorCopyLabel = "Copy";
            StateHasChanged();
        }
    }

    // ── Helper record for syntax table ──────────────────────────────────
    private sealed record SyntaxRow(string Description, string Expression);
