@page "/cron-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgCron & SgCronPicker — Cron Builder — SuperUI</PageTitle>

<SgSeoHead Description="SgCron — Visual cron expression builder with tabs, presets, and human-readable output. SgCronPicker — compact dropdown variant." />

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Cron Builder" Subtitle="SgCron — Visual cron expression builder with tabs, presets, and human-readable output. SgCronPicker — compact dropdown variant." Icon="SgHeroicons.Outline.Clock" GradientFrom="var(--sg-color-primary)" GradientTo="#8b5cf6" />
    </HeaderContent>
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Interactive Builder                                             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Interactive Builder
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Build cron expressions visually. The expression and human-readable description update in real time.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Visual Editor" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgCron @bind-Value="_expression"
                        Label="Schedule"
                        Hint="Configure each field."
                        ShowNextFireTimes="true"
                        ShowCalendar="true"
                        ShowComplexity="true"
                        ShowIcalExport="true"
                        UseEnglish="true"
                        OnValidationChanged="v => { _isExpressionValid = v; StateHasChanged(); }" />
            </SgCard>

            <SgCard Title="Current Value" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:6px;">
                            Expression
                        </SgTypography>
                        <code class="demo-cron-expr">@_expression</code>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:6px;">
                            Human-Readable
                        </SgTypography>
                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-secondary)">
                            @SgCronHumanizer.DescribeEn(_expression)
                        </SgTypography>
                    </div>
                    <SgDivider />
                    <div>
                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                            <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <SgIcon Icon="@SgHeroicons.Outline.Clock" Size="16px" Color="var(--sg-text-muted)" />
                                <SgTag Variant="SgTagVariant.Info" Size="SgSize.Sm" Style="font-family:monospace;">@_expression</SgTag>
                            </SgStack>
                            <SgBadge Variant="@(_isExpressionValid ? SgBadgeVariant.Success : SgBadgeVariant.Danger)"
                                     Text="@(_isExpressionValid ? "Valid" : "Invalid")"
                                     Standalone="true" />
                        </SgStack>
                    </div>
                </SgStack>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. SgCron — Variants                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgCron — Variants
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Standard, compact, disabled, and all-features modes.
            </SgTypography>
        </div>

        <div class="demo-three-col">
            <SgCard Title="All Features" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgCron Value="0 9 * * 1-5"
                        Label="Schedule"
                        Hint="Calendar, timezone, complexity, library, iCal export."
                        ShowNextFireTimes="true"
                        ShowCalendar="true"
                        ShowTimeZone="true"
                        ShowComplexity="true"
                        ShowLibrary="true"
                        ShowIcalExport="true"
                        UseEnglish="true" />
            </SgCard>

            <SgCard Title="Disabled" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgCron Value="0 9 * * 1-5"
                        Disabled="true"
                        Label="Fixed Schedule"
                        Hint="Read-only field." />
            </SgCard>

            <SgCard Title="Compact" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgCron @bind-Value="_compactExpr"
                        Compact="true"
                        Label="Compact"
                        Hint="Denser layout."
                        ShowNextFireTimes="true"
                        ShowComplexity="true"
                        UseEnglish="true" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. SgCronPicker — Dropdown Picker                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgCronPicker — Dropdown Picker
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                A compact trigger that opens a full <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgCron</SgTypography> in a popup. Changes apply on "Apply".
            </SgTypography>
        </div>

        <div class="demo-three-col">
            <SgCard Title="Basic" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgCronPicker @bind-Value="_pickerExpr"
                                  Label="Schedule"
                                  Hint="Click to open builder."
                                  UseEnglish="true" />
                    <SgDivider />
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Selected</SgTypography>
                        <code class="demo-cron-expr">@(_pickerExpr ?? "—")</code>
                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-secondary)">
                            @SgCronHumanizer.DescribeEn(_pickerExpr)
                        </SgTypography>
                    </SgStack>
                </SgStack>
            </SgCard>

            <SgCard Title="Allow Clear" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgCronPicker @bind-Value="_pickerExpr2"
                                  Label="Schedule"
                                  AllowClear="true"
                                  Placeholder="Not set"
                                  UseEnglish="true" />
                    <SgDivider />
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Selected</SgTypography>
                        <code class="demo-cron-expr">@(_pickerExpr2 ?? "—")</code>
                    </SgStack>
                </SgStack>
            </SgCard>

            <SgCard Title="Compact Popup" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgCronPicker @bind-Value="_pickerExpr3"
                                  Label="Schedule"
                                  Compact="true"
                                  Hint="Compact inside popup."
                                  UseEnglish="true" />
                    <SgDivider />
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Selected</SgTypography>
                        <code class="demo-cron-expr">@(_pickerExpr3 ?? "—")</code>
                    </SgStack>
                </SgStack>
            </SgCard>
        </div>

        <SgRow Space="SgSize.Lg" Style="margin-top:24px;">
            <SgCol Md="4">
                <SgCard Title="Disabled" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgCronPicker Value="0 9 * * 1-5"
                                  Label="Schedule"
                                  Disabled="true"
                                  Hint="Not editable." />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Live Constructor                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Toggle feature flags and see the <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgCron</SgTypography> markup in real time.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Next Fire Times -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Next Fire Times</SgTypography>
                            <SgSwitch Value="_ctorShowNextFireTimes" ValueChanged="v => { _ctorShowNextFireTimes = v; UpdateConstructorCode(); }" />
                            @if (_ctorShowNextFireTimes)
                            {
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Count: @_ctorNextFireCount</SgTypography>
                                    <SgSlider TValue="int" Value="_ctorNextFireCount" ValueChanged="v => { _ctorNextFireCount = v; UpdateConstructorCode(); }" Min="1" Max="20" Step="1" ShowTooltip="true" />
                                </SgStack>
                            }
                        </SgStack>

                        <!-- Toggle row: Calendar, TimeZone, Complexity -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Calendar</SgTypography>
                                    <SgSwitch Value="_ctorShowCalendar" ValueChanged="v => { _ctorShowCalendar = v; UpdateConstructorCode(); }" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Time Zone</SgTypography>
                                    <SgSwitch Value="_ctorShowTimeZone" ValueChanged="v => { _ctorShowTimeZone = v; UpdateConstructorCode(); }" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Complexity</SgTypography>
                                    <SgSwitch Value="_ctorShowComplexity" ValueChanged="v => { _ctorShowComplexity = v; UpdateConstructorCode(); }" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Library</SgTypography>
                                    <SgSwitch Value="_ctorShowLibrary" ValueChanged="v => { _ctorShowLibrary = v; UpdateConstructorCode(); }" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">iCal Export</SgTypography>
                                    <SgSwitch Value="_ctorShowIcalExport" ValueChanged="v => { _ctorShowIcalExport = v; UpdateConstructorCode(); }" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Preview</SgTypography>
                                    <SgSwitch Value="_ctorShowPreview" ValueChanged="v => { _ctorShowPreview = v; UpdateConstructorCode(); }" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Block</SgTypography>
                                    <SgSwitch Value="_ctorBlock" ValueChanged="v => { _ctorBlock = v; UpdateConstructorCode(); }" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Compact</SgTypography>
                                    <SgSwitch Value="_ctorCompact" ValueChanged="v => { _ctorCompact = v; UpdateConstructorCode(); }" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Next Fire Times</SgTypography>
                                    <SgBadge Variant="@(_ctorShowNextFireTimes ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_ctorShowNextFireTimes ? $"On ({_ctorNextFireCount})" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Calendar</SgTypography>
                                    <SgBadge Variant="@(_ctorShowCalendar ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_ctorShowCalendar ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Time Zone</SgTypography>
                                    <SgBadge Variant="@(_ctorShowTimeZone ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_ctorShowTimeZone ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Complexity</SgTypography>
                                    <SgBadge Variant="@(_ctorShowComplexity ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_ctorShowComplexity ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Library</SgTypography>
                                    <SgBadge Variant="@(_ctorShowLibrary ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_ctorShowLibrary ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">iCal Export</SgTypography>
                                    <SgBadge Variant="@(_ctorShowIcalExport ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_ctorShowIcalExport ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Preview</SgTypography>
                                    <SgBadge Variant="@(_ctorShowPreview ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_ctorShowPreview ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Block</SgTypography>
                                    <SgBadge Variant="@(_ctorBlock ? SgBadgeVariant.Warn : SgBadgeVariant.Default)" Text="@(_ctorBlock ? "Yes" : "No")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Compact</SgTypography>
                                    <SgBadge Variant="@(_ctorCompact ? SgBadgeVariant.Warn : SgBadgeVariant.Default)" Text="@(_ctorCompact ? "Yes" : "No")" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <div class="constructor-preview">
                                <SgCron Value="*/15 * * * *"
                                        Label="Constructor Preview"
                                        Hint="All feature flags applied."
                                        ShowNextFireTimes="@_ctorShowNextFireTimes"
                                        NextFireCount="@_ctorNextFireCount"
                                        ShowCalendar="@_ctorShowCalendar"
                                        ShowTimeZone="@_ctorShowTimeZone"
                                        ShowComplexity="@_ctorShowComplexity"
                                        ShowLibrary="@_ctorShowLibrary"
                                        ShowIcalExport="@_ctorShowIcalExport"
                                        ShowPreview="@_ctorShowPreview"
                                        Block="@_ctorBlock"
                                        Compact="@_ctorCompact"
                                        UseEnglish="true" />
                            </div>
                        </SgStack>

                        <!-- Code with Copy -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCtorCodeToClipboard">
                                    <span id="ctor-copy-icon">@_ctorCopyIcon</span>
                                    <span id="ctor-copy-text" style="font-size:11px;font-weight:600;">@_ctorCopyLabel</span>
                                </button>
                            </div>
                            <div class="code-block" id="ctor-code-block">
                                @foreach (var line in _ctorCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Component API                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Component API
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                All public parameters for <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgCron</SgTypography> and <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgCronPicker</SgTypography>.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="SgCron Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_cronProperties" />
            </SgCard>
            <SgCard Title="SgCronPicker Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_pickerProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. Syntax Reference                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Syntax Reference
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Common 5-field cron expressions and what they mean. Fields: minute, hour, day-of-month, month, day-of-week.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm" NoPadding="true">
            <table class="demo-syntax-table">
                <thead>
                    <tr>
                        <th>Expression</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _syntaxRows)
                    {
                        <tr>
                            <td><code>@row.Expression</code></td>
                            <td>@row.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </SgCard>
    </div>

    </ChildContent>
</SgCard>

<style>
    /* ── Section layout ─────────────────────────────────────────────────────── */
    .demo-section {
        margin-top: 48px;
    }
    .demo-section-header {
        margin-bottom: 20px;
    }

    .demo-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }
    .demo-three-col {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 24px;
    }
    @@media (max-width: 992px) {
        .demo-two-col, .demo-three-col { grid-template-columns: 1fr; }
    }
    @@media (min-width: 993px) and (max-width: 1200px) {
        .demo-three-col { grid-template-columns: 1fr 1fr; }
    }

    /* ── Cron expression box ─────────────────────────────────────────────────── */
    .demo-cron-expr {
        display: block;
