@page "/cron-demo"
@using SuperUI.Components

<PageTitle>Cron Builder - SUI</PageTitle>

<SgCard Title="SgCron — Конструктор Cron-выражений"
        Subtitle="Удобный визуальный билдер расписаний. Поддержка стандарта 5 полей: минуты, часы, день месяца, месяц, день недели.">

    <div style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 24px; margin-top: 16px;">
        <SgCard Title="Интерактивный билдер">
            <SgCron @bind-Value="_expression"
                    Label="Расписание"
                    Hint="Выберите режим в каждой вкладке — выражение и человекочитаемое описание обновляются автоматически." />
        </SgCard>

        <SgCard Title="Текущее значение">
            <div style="display:flex; flex-direction:column; gap: 12px;">
                <div>
                    <div style="font-size:11px; color: var(--sui-text-muted); text-transform: uppercase; letter-spacing: .05em; font-weight: 600;">Cron-выражение</div>
                    <code style="display:block; padding: 12px; background: var(--sui-bg-secondary); border: 1px solid var(--sui-border); border-radius: 8px; font-size: 16px; color: var(--sui-accent); font-weight: 700; margin-top: 6px;">@_expression</code>
                </div>

                <div>
                    <div style="font-size:11px; color: var(--sui-text-muted); text-transform: uppercase; letter-spacing: .05em; font-weight: 600;">Быстрые шаблоны</div>
                    <div style="display:flex; flex-direction: column; gap: 6px; margin-top: 6px;">
                        <SgButton Text="Каждые 15 минут" Variant="SgButtonVariant.Outlined" Block="true" OnClick="@(() => _expression = "*/15 * * * *")" />
                        <SgButton Text="По будням в 09:30" Variant="SgButtonVariant.Outlined" Block="true" OnClick="@(() => _expression = "30 9 * * 1-5")" />
                        <SgButton Text="1-го числа в полночь" Variant="SgButtonVariant.Outlined" Block="true" OnClick="@(() => _expression = "0 0 1 * *")" />
                        <SgButton Text="Сброс" Variant="SgButtonVariant.Ghost" Block="true" OnClick="@(() => _expression = "* * * * *")" />
                    </div>
                </div>
            </div>
        </SgCard>
    </div>

    <SgDivider />

    <div style="margin-top: 24px;">
        <h2>Состояния</h2>
        <p>Компонент поддерживает обычный, отключённый и состояние с ошибкой.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Только чтение / отключён">
                <SgCron Value="0 9 * * 1-5"
                        Disabled="true"
                        Label="Запланированное расписание"
                        Hint="Поле отключено и недоступно для редактирования." />
            </SgCard>

            <SgCard Title="С пользовательскими шаблонами">
                <SgCron @bind-Value="_customExpr"
                        Label="Со своими пресетами"
                        Presets="_customPresets" />
            </SgCard>
        </div>
    </div>

    <SgDivider />

    <div style="margin-top: 24px;">
        <h2>Компактный режим</h2>
        <p>Установите <code>Compact="true"</code>, чтобы получить плотную версию с иконочными вкладками и сжатым превью — удобно для боковых панелей и форм с ограниченной шириной.</p>
        <div style="display: grid; grid-template-columns: 360px 1fr; gap: 24px; margin-top: 16px; align-items: start;">
            <SgCard Title="Compact">
                <SgCron @bind-Value="_compactExpr"
                        Compact="true"
                        Label="Расписание"
                        Hint="Иконочные вкладки и плотная сетка." />
            </SgCard>
            <SgCard Title="Текущее значение">
                <code style="display:block; padding: 12px; background: var(--sui-bg-secondary); border: 1px solid var(--sui-border); border-radius: 8px; font-size: 16px; color: var(--sui-accent); font-weight: 700;">@_compactExpr</code>
            </SgCard>
        </div>
    </div>

    <SgDivider />

    <div style="margin-top: 24px;">
        <h2>SgCronPicker — выпадающий пикер</h2>
        <p>Компактный триггер-кнопка, раскрывающая полный <code>SgCron</code> в попапе. Изменения применяются только после нажатия «Применить».</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px; align-items: start;">
            <SgCard Title="Базовый">
                <SgCronPicker @bind-Value="_pickerExpr"
                              Label="Расписание задачи"
                              Hint="Нажмите, чтобы открыть конструктор." />
            </SgCard>

            <SgCard Title="Текущее значение">
                <div style="display:flex; flex-direction:column; gap: 8px;">
                    <div>
                        <div style="font-size:11px; color: var(--sui-text-muted); text-transform: uppercase; letter-spacing: .05em; font-weight: 600;">Выражение</div>
                        <code style="display:block; padding: 10px 12px; background: var(--sui-bg-secondary); border: 1px solid var(--sui-border); border-radius: 8px; font-size: 15px; color: var(--sui-accent); font-weight: 700; margin-top: 6px;">@(_pickerExpr ?? "—")</code>
                    </div>
                    <div>
                        <div style="font-size:11px; color: var(--sui-text-muted); text-transform: uppercase; letter-spacing: .05em; font-weight: 600;">Описание</div>
                        <div style="margin-top: 6px; font-size: 13px; color: var(--sui-text-secondary);">@SgCronHumanizer.Describe(_pickerExpr)</div>
                    </div>
                </div>
            </SgCard>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24px; margin-top: 24px; align-items: start;">
            <SgCard Title="С очисткой">
                <SgCronPicker @bind-Value="_pickerExpr2"
                              Label="Расписание"
                              AllowClear="true"
                              Placeholder="Не задано" />
            </SgCard>

            <SgCard Title="Компактный попап">
                <SgCronPicker @bind-Value="_pickerExpr3"
                              Label="Расписание"
                              Compact="true"
                              Hint="Compact=true внутри попапа." />
            </SgCard>

            <SgCard Title="Отключён">
                <SgCronPicker Value="0 9 * * 1-5"
                              Label="Расписание"
                              Disabled="true"
                              Hint="Поле недоступно для редактирования." />
            </SgCard>
        </div>
    </div>

    <SgDivider />

    <div style="margin-top: 24px;">
        <h2>Поддерживаемые синтаксисы</h2>
        <p>SgCron понимает стандартное 5-полевое cron-выражение и расширения <code>L</code>, <code>?</code>, <code>*/N</code>, <code>X-Y</code>, перечисления через запятую.</p>
        <ul style="line-height: 1.9;">
            <li><code>* * * * *</code> — каждую минуту</li>
            <li><code>*/5 * * * *</code> — каждые 5 минут</li>
            <li><code>0 9-18 * * 1-5</code> — каждый час с 09 до 18 в будние дни</li>
            <li><code>0 0 L * *</code> — в последний день месяца в полночь</li>
            <li><code>30 8,12,18 * * *</code> — три раза в день: 08:30, 12:30, 18:30</li>
        </ul>
    </div>

</SgCard>

@code {
    private string? _expression = "0 9 * * 1-5";
    private string? _customExpr = "0 */2 * * *";
    private string? _compactExpr = "*/15 * * * *";
    private string? _pickerExpr = "0 9 * * 1-5";
    private string? _pickerExpr2 = "*/30 * * * *";
    private string? _pickerExpr3 = "0 0 * * 0";

    private readonly IReadOnlyList<SgCronPreset> _customPresets = new[]
    {
        new SgCronPreset("Каждые 30 сек невозможно — мин минимум", "* * * * *"),
        new SgCronPreset("Раз в полчаса", "*/30 * * * *"),
        new SgCronPreset("Каждые 2 часа", "0 */2 * * *"),
        new SgCronPreset("Каждое воскресенье", "0 12 * * 0"),
    };
}
