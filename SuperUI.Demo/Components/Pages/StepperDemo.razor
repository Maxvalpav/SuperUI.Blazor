@page "/stepper-demo"
@using SuperUI.Components

<PageTitle>Пошаговый процесс - SUI</PageTitle>

<SgCard Title="SgStepper - Пошаговый процесс"
        Subtitle="Компонент для отображения пошагового процесса. Поддерживает горизонтальный и вертикальный режимы, кликабельные шаги.">

    <div style="margin-top: 32px;">
        <h2>Горизонтальный степпер</h2>
        <p>Стандартный горизонтальный пошаговый процесс с навигацией.</p>

        <SgCard Title="Процесс регистрации" Style="margin-top: 16px;">
            <SgStepper Steps="_registrationSteps" Active="_currentStep" ActiveChanged="v => _currentStep = v" />

            <div style="margin-top: 24px; padding: 16px; border: 1px solid var(--sui-border); border-radius: 8px; min-height: 100px;">
                @switch (_currentStep)
                {
                    case 0:
                        <div style="display: flex; flex-direction: column; gap: 12px; max-width: 400px;">
                            <SgTextBox TValue="string" @bind-Value="@_regName" Label="Полное имя" Placeholder="Иван Петров" />
                            <SgDatePicker @bind-Value="@_regBirthDate" Label="Дата рождения" />
                        </div>
                        break;
                    case 1:
                        <div style="display: flex; flex-direction: column; gap: 12px; max-width: 400px;">
                            <SgTextBox TValue="string" @bind-Value="@_regEmail" Label="Email" Type="email" Placeholder="ivan@example.com" />
                            <SgTextBox TValue="string" @bind-Value="@_regPhone" Label="Телефон" Type="tel" Placeholder="+7 (999) 999-99-99" />
                        </div>
                        break;
                    case 2:
                        <div style="display: flex; flex-direction: column; gap: 12px; max-width: 400px;">
                            <SgTextBox TValue="string" @bind-Value="@_regPassword" Label="Пароль" Type="password" Placeholder="Минимум 8 символов" />
                            <SgCheckBox @bind-Value="@_regTerms" Label="Согласен с условиями использования" />
                        </div>
                        break;
                    case 3:
                        <div>
                            <SgResult Status="SgResult.SgResultStatus.Success" Title="Регистрация завершена!" SubTitle="Добро пожаловать в SuperUI." />
                        </div>
                        break;
                }
            </div>

            <div style="margin-top: 16px; display: flex; gap: 12px;">
                <SgButton Text="← Назад"
                          OnClick="@(() => _currentStep = Math.Max(0, _currentStep - 1))"
                          Disabled="@(_currentStep == 0)" />
                @if (_currentStep < _registrationSteps.Count - 1)
                {
                    <SgButton Text="Далее →"
                              Variant="primary"
                              OnClick="@(() => _currentStep = Math.Min(_registrationSteps.Count - 1, _currentStep + 1))" />
                }
                else
                {
                    <SgButton Text="Начать заново" OnClick="@(() => _currentStep = 0)" />
                }
            </div>
        </SgCard>
    </div>

    <div style="margin-top: 32px;">
        <h2>Вертикальный степпер</h2>
        <p>Вертикальный режим для отображения в боковой панели.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Статусы задачи">
                <SgStepper Steps="_taskSteps" Active="_taskStep" ActiveChanged="v => _taskStep = v" Vertical="true" Clickable="true" />
            </SgCard>

            <SgCard Title="Прогресс проекта">
                <SgStepper Steps="_projectSteps" Active="2" Vertical="true" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Свойства компонента</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="SgStepper">
                <PropertyTable Items="_stepperProperties" />
            </SgCard>
            <SgCard Title="StepperItem">
                <PropertyTable Items="_stepperItemProperties" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private int _currentStep = 0;
    private int _taskStep = 1;

    // Registration form fields
    private string? _regName;
    private DateTime? _regBirthDate;
    private string? _regEmail;
    private string? _regPhone;
    private string? _regPassword;
    private bool _regTerms;

    private List<StepperItem> _registrationSteps = new()
    {
        new() { Title = "Личные данные", Description = "Имя и дата рождения" },
        new() { Title = "Контакты", Description = "Email и телефон" },
        new() { Title = "Безопасность", Description = "Пароль и условия" },
        new() { Title = "Готово", Description = "Регистрация завершена" }
    };

    private List<StepperItem> _taskSteps = new()
    {
        new() { Title = "Создана", Description = "15.04.2026" },
        new() { Title = "В работе", Description = "16.04.2026" },
        new() { Title = "На проверке", Description = "Ожидает" },
        new() { Title = "Завершена", Description = "Ожидает" }
    };

    private List<StepperItem> _projectSteps = new()
    {
        new() { Title = "Планирование", Description = "Завершено" },
        new() { Title = "Дизайн", Description = "Завершено" },
        new() { Title = "Разработка", Description = "В процессе" },
        new() { Title = "Тестирование", Description = "Ожидает" },
        new() { Title = "Релиз", Description = "Ожидает" }
    };

    private List<PropertyPanelItem> _stepperProperties = new()
    {
        new() { Label = "Steps", Value = "IEnumerable<StepperItem>", BadgeText = "Шаги", BadgeVariant = "info" },
        new() { Label = "Active", Value = "int", BadgeText = "Активный шаг", BadgeVariant = "warn" },
        new() { Label = "ActiveChanged", Value = "EventCallback<int>", BadgeText = "Событие", BadgeVariant = "success" },
        new() { Label = "Vertical", Value = "bool", BadgeText = "Вертикально", BadgeVariant = "warn" },
        new() { Label = "Clickable", Value = "bool", BadgeText = "Кликабельно", BadgeVariant = "warn" },
        new() { Label = "CssClass", Value = "string", BadgeText = "CSS класс", BadgeVariant = "info" }
    };

    private List<PropertyPanelItem> _stepperItemProperties = new()
    {
        new() { Label = "Title", Value = "string", BadgeText = "Заголовок", BadgeVariant = "info" },
        new() { Label = "Description", Value = "string", BadgeText = "Описание", BadgeVariant = "info" }
    };
}
