@page "/stepper-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgStepper — Step Progress — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Horizontal Stepper — Interactive Registration                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Horizontal Stepper — Interactive Registration
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                A complete multi-step form with validation and navigation. Each step shows relevant input fields. Try navigating with the stepper or the buttons below.
            </SgTypography>
        </div>

        <SgCard Title="User Registration" Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgStack Vertical Space="SgSize.Md">
                <SgStepper Steps="_registrationSteps" Active="_currentStep"
                           ActiveChanged="v => _currentStep = v"
                           Size="SgSize.Md"
                           Animated="true"
                           ShowLines="true"
                           Linear="_linearReg" />

                <div class="demo-step-content">
                    @switch (_currentStep)
                    {
                        case 0:
                            <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Start">
                                <SgTypography Variant="SgTypographyVariant.Heading6">Personal Information</SgTypography>
                                <SgRow Space="SgSize.Md" Style="width:100%;max-width:480px;">
                                    <SgCol Span="12">
                                        <SgTextBox TValue="string" @bind-Value="_regName" Label="Full Name" Placeholder="John Doe" />
                                    </SgCol>
                                    <SgCol Xs="12" Md="6">
                                        <SgDatePicker @bind-Value="_regBirthDate" Label="Date of Birth" />
                                    </SgCol>
                                    <SgCol Xs="12" Md="6">
                                        <SgSelect TValue="string" @bind-Value="_regGender"
                                                  Label="Gender"
                                                  Items="_genderOptions"
                                                  LabelSelector="x => x"
                                                  Block="true" />
                                    </SgCol>
                                </SgRow>
                            </SgStack>
                            break;
                        case 1:
                            <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Start">
                                <SgTypography Variant="SgTypographyVariant.Heading6">Contact Details</SgTypography>
                                <SgRow Space="SgSize.Md" Style="width:100%;max-width:480px;">
                                    <SgCol Span="12">
                                        <SgTextBox TValue="string" @bind-Value="_regEmail" Label="Email" Type="email" Placeholder="john@example.com" />
                                    </SgCol>
                                    <SgCol Span="12">
                                        <SgTextBox TValue="string" @bind-Value="_regPhone" Label="Phone" Type="tel" Placeholder="+1 (555) 123-4567" />
                                    </SgCol>
                                </SgRow>
                            </SgStack>
                            break;
                        case 2:
                            <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Start">
                                <SgTypography Variant="SgTypographyVariant.Heading6">Security</SgTypography>
                                <SgRow Space="SgSize.Md" Style="width:100%;max-width:480px;">
                                    <SgCol Span="12">
                                        <SgTextBox TValue="string" @bind-Value="_regPassword" Label="Password" Type="password" Placeholder="Min 8 characters" />
                                    </SgCol>
                                    <SgCol Span="12">
                                        <SgCheckBox @bind-Value="_regTerms" Label="I agree to the Terms of Service" />
                                    </SgCol>
                                </SgRow>
                            </SgStack>
                            break;
                        case 3:
                            <SgStack Vertical Space="SgSize.Lg" Align="SgAlignItems.Center">
                                <SgResult Status="SgResultStatus.Success"
                                          Title="Registration Complete!"
                                          SubTitle="Welcome to SuperUI."
                                          Size="SgSize.Sm">
                                    <ExtraContent>
                                        <SgSpace Size="middle">
                                            <SgButton Variant="SgButtonVariant.Primary" OnClick="@(() => _currentStep = 0)">
                                                Start Over
                                            </SgButton>
                                            <SgButton Variant="SgButtonVariant.Outlined">
                                                View Dashboard
                                            </SgButton>
                                        </SgSpace>
                                    </ExtraContent>
                                </SgResult>
                            </SgStack>
                            break;
                    }
                </div>

                <SgRow Space="SgSize.Sm" Justify="SgJustifyContent.SpaceBetween" Align="SgAlignItems.Center">
                    <SgCol Auto="true">
                        <SgButton Text="← Back"
                                  OnClick="@(() => _currentStep = Math.Max(0, _currentStep - 1))"
                                  Disabled="@(_currentStep == 0)"
                                  Variant="SgButtonVariant.Outlined" />
                    </SgCol>
                    <SgCol Auto="true">
                        <SgSpace Size="small">
                            <SgCheckBox @bind-Value="_linearReg" Label="Linear" Size="SgSize.Sm" />
                        </SgSpace>
                    </SgCol>
                    <SgCol Auto="true">
                        @if (_currentStep < _registrationSteps.Count - 1)
                        {
                            <SgButton Text="Next →"
                                      Variant="SgButtonVariant.Primary"
                                      OnClick="@(() => _currentStep = Math.Min(_registrationSteps.Count - 1, _currentStep + 1))" />
                        }
                        else
                        {
                            <SgBadge Variant="SgBadgeVariant.Success" Text="✓ Completed" Standalone="true" />
                        }
                    </SgCol>
                </SgRow>
            </SgStack>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Vertical + Non-interactive Examples                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Vertical &amp; Use Case Examples
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Vertical orientation for side panels, and specialized use cases with custom statuses, optional steps, and icons.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Xs="12" Md="6" Lg="4">
                <SgCard Title="Task Workflow" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgStepper Steps="_taskSteps" Active="_taskStep"
                                   ActiveChanged="v => _taskStep = v"
                                   Vertical="true"
                                   Clickable="true"
                                   Size="SgSize.Md" />
                        <SgSpace Size="small">
                            <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined"
                                      OnClick="@(() => _taskStep = Math.Max(0, _taskStep - 1))"
                                      Disabled="@(_taskStep == 0)">← Prev</SgButton>
                            <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Primary"
                                      OnClick="@(() => _taskStep = Math.Min(_taskSteps.Count - 1, _taskStep + 1))"
                                      Disabled="@(_taskStep >= _taskSteps.Count - 1)">Next →</SgButton>
                        </SgSpace>
                    </SgStack>
                </SgCard>
            </SgCol>

            <SgCol Xs="12" Md="6" Lg="4">
                <SgCard Title="Project Milestones" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStepper Steps="_projectSteps" Active="2" Vertical="true" Clickable="false" Size="SgSize.Sm" />
                </SgCard>
            </SgCol>

            <SgCol Xs="12" Lg="4">
                <SgCard Title="Custom Statuses &amp; Options" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStepper Steps="_customSteps" Active="1" Vertical="true" Clickable="false" Size="SgSize.Sm" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Size Variants                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Size Variants
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                The <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Size</SgTypography> parameter changes the overall scale: <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Sm</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Md</SgTypography> (default), <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Lg</SgTypography>.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Xs="12" Md="4">
                <SgCard Title="Small (Sm)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStepper Steps="_sizeExampleSteps" Active="1" Size="SgSize.Sm" />
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Md="4">
                <SgCard Title="Medium (Md) — Default" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStepper Steps="_sizeExampleSteps" Active="1" Size="SgSize.Md" />
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Md="4">
                <SgCard Title="Large (Lg)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStepper Steps="_sizeExampleSteps" Active="1" Size="SgSize.Lg" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Live Constructor                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live Stepper Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure parameters and see the result in real time. Click <strong>Copy</strong> to grab the generated code.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Step count -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Step Count</SgTypography>
                            <SgSegmented TValue="int"
                                         Value="_ceStepCount"
                                         ValueChanged="v => { _ceStepCount = v; _ceActiveStep = Math.Min(_ceActiveStep, v - 1); UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_stepCountOptions" />
                        </SgStack>

                        <!-- Active step -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Active Step</SgTypography>
                            <SgSegmented TValue="int"
                                         Value="_ceActiveStep"
                                         ValueChanged="v => { _ceActiveStep = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_ceActiveOptions" />
                        </SgStack>

                        <!-- Size -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                            <SgSegmented TValue="SgSize"
                                         Value="_ceSize"
                                         ValueChanged="v => { _ceSize = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_sizeSegOptions" />
                        </SgStack>

                        <!-- Orientation -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Orientation</SgTypography>
                            <SgSegmented TValue="string"
                                         Value="_ceOrientation"
                                         ValueChanged="v => { _ceOrientation = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_orientSegOptions" />
                        </SgStack>

                        <!-- Toggles -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Linear</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ceLinear"
                                                 ValueChanged="v => { _ceLinear = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Animated</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ceAnimated"
                                                 ValueChanged="v => { _ceAnimated = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Show Lines</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ceShowLines"
                                                 ValueChanged="v => { _ceShowLines = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Clickable</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ceClickable"
                                                 ValueChanged="v => { _ceClickable = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Compact -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Compact</SgTypography>
                            <SgSegmented TValue="bool"
                                         Value="_ceCompact"
                                         ValueChanged="v => { _ceCompact = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_boolSegOptions" />
                        </SgStack>

                        <!-- Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Steps</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_ceStepCount.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Active</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Warn" Text="@_ceActiveStep.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Orientation</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_ceOrientation" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Linear</SgTypography>
                                    <SgBadge Variant="@(_ceLinear ? SgBadgeVariant.Info : SgBadgeVariant.Muted)" Text="@(_ceLinear ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgRow Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                <SgCol Auto="true">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                                </SgCol>
                                <SgCol Auto="true">
                                    <div class="demo-viewport-indicator" id="viewport-indicator">
                                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                                            <span id="bp-label">xs</span>
                                        </SgTypography>
                                    </div>
                                </SgCol>
                            </SgRow>
                            <div class="constructor-preview" id="constructor-preview">
                                <SgStepper Steps="_ceSteps"
                                           Active="_ceActiveStep"
                                           ActiveChanged="v => { _ceActiveStep = v; UpdateConstructorCode(); }"
                                           Size="_ceSize"
                                           Vertical="@(_ceOrientation == "Vertical")"
                                           Linear="_ceLinear"
                                           Animated="_ceAnimated"
                                           ShowLines="_ceShowLines"
                                           Clickable="_ceClickable"
                                           Compact="_ceCompact" />
                            </div>
                        </SgStack>

                        <!-- Code with Copy -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgRow Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                <SgCol Auto="true">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                </SgCol>
                                <SgCol Auto="true">
                                    <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                        <span id="copy-icon">@_copyIcon</span>
                                        <span id="copy-text" style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                    </button>
                                </SgCol>
                            </SgRow>
                            <div class="code-block" id="code-block">
                                @foreach (var line in _generatedCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Properties                                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Component API
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Full list of configurable parameters for <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgStepper</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">StepperItem</SgTypography>, and the <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgStepStatus</SgTypography> enum.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Xs="12" Md="6" Lg="4">
                <SgCard Title="SgStepper" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_stepperProperties" />
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Md="6" Lg="4">
                <SgCard Title="StepperItem" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_stepperItemProperties" />
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Lg="4">
                <SgCard Title="SgStepStatus Enum" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_stepStatusEnum" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

</ChildContent>
</SgCard>

<style>
    /* ── Section layout ─────────────────────────────────────────────────────── */
    .demo-section {
        margin-top: 48px;
    }
    .demo-section-header {
        margin-bottom: 20px;
    }

    /* ── Step content panel ─────────────────────────────────────────────────── */
    .demo-step-content {
        padding: 20px;
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        min-height: 140px;
        background: var(--sg-surface);
        transition: all 0.25s ease;
    }

    /* ── Constructor ────────────────────────────────────────────────────────── */
    .constructor-preview {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 20px;
        min-height: 80px;
        transition: all 0.3s ease;
    }
    .ctrl-summary {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 12px 14px;
    }
    .code-block {
        background: #0f172a;
        color: #7dd3fc;
        padding: 14px 16px;
        border-radius: 8px;
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 12px;
        line-height: 1.9;
        overflow-x: auto;
        position: relative;
    }
    .code-block code {
        background: none;
        padding: 0;
        color: inherit;
        font-size: inherit;
        display: block;
        white-space: pre;
    }

    /* ── Copy button ────────────────────────────────────────────────────────── */
    .demo-copy-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 6px;
        padding: 4px 10px;
        cursor: pointer;
        color: var(--sg-text-muted);
        transition: all 0.2s ease;
        font-family: inherit;
    }
    .demo-copy-btn:hover {
        color: var(--sg-primary);
        border-color: var(--sg-primary);
        background: color-mix(in srgb, var(--sg-primary) 8%, transparent);
    }
    .demo-copy-btn:active {
        transform: scale(0.95);
    }
    .demo-copy-btn.copied {
        color: var(--sg-color-success);
        border-color: var(--sg-color-success);
