    private bool _ceCompact;

    private List<StepperItem> _ceSteps => Enumerable.Range(0, _ceStepCount).Select(i => new StepperItem
    {
        Title = $"Step {i + 1}",
        Description = $"Description for step {i + 1}"
    }).ToList();

    // ── Code generation ──────────────────────────────────────────────────
    private string[] _generatedCodeLines = Array.Empty<string>();
    private string _copyIcon = "📋";
    private string _copyLabel = "Copy";

