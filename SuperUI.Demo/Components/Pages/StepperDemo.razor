    {
        new() { Value = "Horizontal", Label = "Horizontal" },
        new() { Value = "Vertical", Label = "Vertical" },
    };

    private readonly List<SgSegmentedOption<bool>> _boolSegOptions = new()
    {
        new() { Value = false, Label = "Off" },
        new() { Value = true, Label = "On" },
    };

    // ── Lifecycle ────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add($"<SgStepper Steps=\"@_mySteps\"");
        lines.Add($"           Active=\"@_activeStep\"");
        if (_ceSize != SgSize.Md)
            lines.Add($"           Size=\"SgSize.{_ceSize}\"");
        if (_ceOrientation == "Vertical")
            lines.Add($"           Vertical=\"true\"");
        if (_ceLinear)
            lines.Add($"           Linear=\"true\"");
        if (!_ceAnimated)
            lines.Add($"           Animated=\"false\"");
        if (!_ceShowLines)
            lines.Add($"           ShowLines=\"false\"");
        if (!_ceClickable)
            lines.Add($"           Clickable=\"false\"");
        if (_ceCompact)
            lines.Add($"           Compact=\"true\"");
        lines.Add($"           ActiveChanged=\"v => _activeStep = v\" />");
        lines.Add("");
        lines.Add($"@code {{");
        lines.Add($"    private int _activeStep = {_ceActiveStep};");
        lines.Add($"    private List<StepperItem> _mySteps = new() {{");
        for (int i = 0; i < _ceStepCount; i++)
        {
            lines.Add($"        new() {{ Title = \"Step {i + 1}\", Description = \"...\" }},");
        }
        lines.Add($"    }};");
        lines.Add($"}}");
        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

