        new() { Value = 5, Label = "5" },
        new() { Value = 6, Label = "6" },
    };

    private List<SgSegmentedOption<int>> _ceActiveOptions =>
        Enumerable.Range(0, _ceStepCount).Select(i => new SgSegmentedOption<int>
        {
            Value = i,
            Label = (i + 1).ToString()
        }).ToList();

    private readonly List<SgSegmentedOption<SgSize>> _sizeSegOptions = new()
    {
        new() { Value = SgSize.Sm, Label = "Sm" },
        new() { Value = SgSize.Md, Label = "Md" },
        new() { Value = SgSize.Lg, Label = "Lg" },
    };

