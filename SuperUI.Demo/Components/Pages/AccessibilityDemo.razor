@page "/accessibility-demo"
@using SuperUI.Components

<PageTitle>Accessibility — SuperUI</PageTitle>

<div class="sg-demo-header">
    <SgStack Align="SgAlignItems.Center" Gap="12px">
        <SgIcon Icon="@SgIcons.Eye" Size="28" Color="var(--sg-primary)" />
        <div>
            <h1 class="sg-demo-title">Доступность и Eye Tracking</h1>
            <p class="sg-demo-subtitle">Управление интерфейсом и контроль внимания с помощью взгляда.</p>
        </div>
    </SgStack>
</div>

<SgStack Orientation="SgOrientation.Vertical" Gap="24px">
    
    <SgRow Gutter="16">
        <SgCol Span="24">
            <SgCard Title="Трекинг взгляда (WebGazer.js)" Variant="SgCardVariant.Glass">
                <ChildContent>
                    <SgEyeTracker />
                    
                    <div style="margin-top: 40px; text-align: center; padding: 60px; border: 2px dashed var(--sg-primary); border-radius: 20px;">
                        <h2>Посмотрите сюда, чтобы активировать</h2>
                        <p style="color: var(--sg-text-secondary)">
                            Эта зона может реагировать на задержку взгляда (Gaze-dwell), 
                            позволяя нажимать кнопки без использования рук.
                        </p>
                        
                        <SgStack Justify="SgJustifyContent.Center" Gap="24px" Style="margin-top: 30px;">
                            <div class="gaze-target" @onclick='() => OnGazeClick("Кнопка 1")'>Кнопка 1</div>
                            <div class="gaze-target" @onclick='() => OnGazeClick("Кнопка 2")'>Кнопка 2</div>
                            <div class="gaze-target" @onclick='() => OnGazeClick("Кнопка 3")'>Кнопка 3</div>
                        </SgStack>
                        
                        @if (!string.IsNullOrEmpty(_lastClicked))
                        {
                            <div style="margin-top: 20px; color: var(--sg-success); font-weight: bold; animation: fadeIn 0.5s;">
                                Активировано взглядом: @_lastClicked!
                            </div>
                        }
                    </div>
                </ChildContent>
            </SgCard>
        </SgCol>
    </SgRow>

</SgStack>

<style>
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .gaze-target {
        padding: 20px 40px;
        background: var(--sg-surface);
        border: 2px solid var(--sg-border);
        border-radius: 12px;
        font-weight: bold;
        transition: all 0.3s;
        cursor: pointer;
    }
    .gaze-target:active {
        background: var(--sg-primary-light);
        transform: scale(0.95);
    }
    .gaze-target:hover {
        border-color: var(--sg-primary);
        transform: scale(1.1);
        box-shadow: 0 0 20px rgba(var(--sg-primary-rgb), 0.3);
    }
</style>

@code {
    private string? _lastClicked;

    private void OnGazeClick(string name)
    {
        _lastClicked = name;
        StateHasChanged();
    }
}
