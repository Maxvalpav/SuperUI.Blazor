@page "/textarea-demo"
@using SuperUI.Components

<PageTitle>TextArea - SUI</PageTitle>

<SgCard Title="SgTextArea - Multi-line Text Input"
        Subtitle="Dedicated textarea component with validation, counter, and auto-resize support.">

    <div style="margin-top: 32px;">
        <h2>Basic Usage</h2>
        <p>Simple multi-line text input with label and placeholder.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">With label</div>
                        <SgTextArea Label="Description" @bind-Value="_basic" Placeholder="Enter description..." Rows="4" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Without label</div>
                        <SgTextArea @bind-Value="_plain" Placeholder="Type something..." Rows="3" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_basicProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Counter & Clear</h2>
        <p>Character counter and clear button for better UX.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">With counter</div>
                        <SgTextArea @bind-Value="_counter" Placeholder="Bio (max 200 chars)" MaxLength="200" ShowCounter="true" Rows="3" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">With clear button</div>
                        <SgTextArea @bind-Value="_clearable" Placeholder="Type and clear..." ShowClearButton="true" Rows="2" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_extraProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>States</h2>
        <p>Disabled and read-only states.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Disabled</div>
                        <SgTextArea @bind-Value="_disabled" Placeholder="Disabled textarea" Disabled="true" Rows="2" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Read-only</div>
                        <SgTextArea @bind-Value="_readonly" ReadOnly="true" Rows="2" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_stateProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Two-way Binding</h2>
        <p>Value updates immediately as you type.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <SgTextArea @bind-Value="_bound" Placeholder="Type to see binding..." Rows="3" />
                <div style="margin-top: 8px; font-size: 12px; color: var(--sui-text-muted);">
                    Value: <strong>@_bound</strong>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_bindingProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Code example -->
    <div style="margin-top: 32px;">
        <h2>Примеры кода</h2>
        <SgCode Language="SgCodeLanguage.Razor" Code="@_textAreaCode" />
    </div>

</SgCard>

@code {
    private string _basic = "";
    private string _plain = "";
    private string _counter = "";
    private string _clearable = "Clear me!";
    private string _disabled = "This field is disabled.";
    private string _readonly = "This field is read-only.";
    private string _bound = "Hello from SgTextArea!";

    private List<PropertyPanelItem> _basicProperties = new()
    {
        new() { Label = "Label", Value = "string?", BadgeText = "Label text" },
        new() { Label = "Placeholder", Value = "string?", BadgeText = "Placeholder text" },
        new() { Label = "Rows", Value = "int (default: 3)", BadgeText = "Visible rows" },
        new() { Label = "Value", Value = "string", BadgeText = "Two-way binding" }
    };

    private List<PropertyPanelItem> _extraProperties = new()
    {
        new() { Label = "MaxLength", Value = "int?", BadgeText = "Max characters" },
        new() { Label = "ShowCounter", Value = "bool", BadgeText = "Show char count" },
        new() { Label = "ShowClearButton", Value = "bool", BadgeText = "Clear button" },
        new() { Label = "AutoResize", Value = "bool", BadgeText = "Auto height" }
    };

    private List<PropertyPanelItem> _stateProperties = new()
    {
        new() { Label = "Disabled", Value = "bool", BadgeText = "Disabled state" },
        new() { Label = "ReadOnly", Value = "bool", BadgeText = "Read-only state" },
        new() { Label = "Required", Value = "bool", BadgeText = "Required field" }
    };

    private List<PropertyPanelItem> _bindingProperties = new()
    {
        new() { Label = "Value",        Value = "string",                  BadgeText = "Current text" },
        new() { Label = "ValueChanged", Value = "EventCallback<string>",   BadgeText = "Change event" },
        new() { Label = "Immediate",    Value = "bool (default: true)",    BadgeText = "Update on input" },
        new() { Label = "Debounce",     Value = "int",                     BadgeText = "Debounce delay (ms)" }
    };

    // ── Code snippet ──────────────────────────────────────────────────────────
    private string _textAreaCode = """
        <!-- Базовый -->
        <SgTextArea @bind-Value="_text"
                    Label="Описание"
                    Placeholder="Введите текст..."
                    Rows="4" />

        <!-- Со счётчиком и очисткой -->
        <SgTextArea @bind-Value="_bio"
                    Label="О себе"
                    MaxLength="200"
                    ShowCounter="true"
                    ShowClearButton="true"
                    Rows="3" />

        <!-- Авторазмер -->
        <SgTextArea @bind-Value="_notes"
                    Label="Заметки"
                    AutoResize="true"
                    Rows="2" />

        <!-- Метка слева -->
        <SgTextArea @bind-Value="_comment"
                    Label="Комментарий"
                    LabelPosition="SgLabelPosition.Left"
                    Rows="3" />
        """;
}
