    };

    private readonly List<SgSegmentedOption<SgTextResize>> _cResizeOptions = new()
    {
        new() { Value = SgTextResize.None,       Label = "None" },
        new() { Value = SgTextResize.Vertical,   Label = "Vert" },
        new() { Value = SgTextResize.Horizontal, Label = "Horiz" },
        new() { Value = SgTextResize.Both,       Label = "Both" },
    };

    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add($"<SgTextArea");
        lines.Add($"    @@bind-Value=\"_myValue\"");
        lines.Add($"    Placeholder=\"Interactive SgTextArea...\"");
        lines.Add($"    Rows=\"{_cRows}\"");
        if (_cMaxLength.HasValue)
            lines.Add($"    MaxLength=\"{_cMaxLength}\"");
        if (_cShowCounter)
            lines.Add($"    ShowCounter=\"true\"");
        if (!_cAllowClear)
            lines.Add($"    AllowClear=\"false\"");
        if (_cAutoResize)
            lines.Add($"    AutoResize=\"true\"");
        if (_cDisabled)
            lines.Add($"    Disabled=\"true\"");
        if (_cResize != SgTextResize.Vertical)
            lines.Add($"    Resize=\"SgTextResize.{_cResize}\"");
        lines.Add($"    />");
        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

