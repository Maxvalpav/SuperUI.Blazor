@page "/demo/textarea"
@using SuperUI.Demo.Components

<div class="demo-page">
    <div class="demo-hero">
        <section class="demo-hero-main">
            <div class="demo-header">
                <div class="demo-kicker">Input Components</div>
                <h1 class="demo-title">SgTextArea</h1>
                <p class="demo-subtitle">
                    Multiline text input for notes, comments and descriptions with debounce, live counters,
                    auto-resize and validation-friendly form integration.
                </p>
            </div>
        </section>

        <aside class="demo-hero-side">
            <div class="demo-side-title">Highlights</div>
            <div class="demo-pill-list">
                <span class="demo-pill demo-pill-accent">Auto Resize</span>
                <span class="demo-pill">Counter</span>
                <span class="demo-pill">Debounce</span>
                <span class="demo-pill">Form Ready</span>
            </div>

            <div class="demo-meta-grid">
                <div class="demo-meta-card">
                    <span class="demo-meta-label">UX</span>
                    <span class="demo-meta-value">Clear button, resize modes, live update</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Scenarios</span>
                    <span class="demo-meta-value">Descriptions, comments, changelogs, notes</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Render</span>
                    <span class="demo-meta-value">SSR-safe with interactive enhancement</span>
                </div>
            </div>
        </aside>
    </div>

    <SgDemoSection Eyebrow="Usage" Title="Examples" Description="Common textarea setups for forms, ticketing systems and admin panels.">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Basic Field</h3>
                    <p class="demo-showcase-desc">Simple multiline field with placeholder and helper text.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgTextArea @bind-Value="_description"
                                    Label="Description"
                                    Placeholder="Write a short description..."
                                    Hint="Keep it concise and user-friendly."
                                    Rows="4" />
                        <div class="demo-inline-value">Length: @(_description?.Length ?? 0) characters</div>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Counter And Clear</h3>
                    <p class="demo-showcase-desc">Great for constrained content such as bios or summaries.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgTextArea @bind-Value="_bio"
                                    Label="Short Bio"
                                    MaxLength="160"
                                    ShowCounter="true"
                                    ShowClearButton="true"
                                    Rows="4" />
                    </div>
                    <div class="demo-note">Use the counter when the input must fit cards, grids or API limits.</div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Auto Resize</h3>
                    <p class="demo-showcase-desc">The field grows with content to reduce nested scrolling.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgTextArea @bind-Value="_notes"
                                    Label="Notes"
                                    AutoResize="true"
                                    Rows="3"
                                    MaxRows="8"
                                    Placeholder="Start typing multiple lines..." />
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Debounced Input</h3>
                    <p class="demo-showcase-desc">Reduce update frequency for expensive live previews or search.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgTextArea @bind-Value="_debounced"
                                    Label="Live Notes"
                                    Debounce="450"
                                    Immediate="true"
                                    Rows="4"
                                    Resize="SgTextResize.Both" />
                        <div class="demo-inline-value">Latest value: @(_debounced ?? "empty")</div>
                    </div>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoParams Title="TextArea Parameters" Description="Parameters for customizing the appearance and behavior of the SgTextArea component.">
        <SgDemoParam Name="Value" Type="string" Description="The current textarea value." DefaultValue="null" />
        <SgDemoParam Name="Label" Type="string" Description="Field label rendered above or beside the textarea." DefaultValue="null" />
        <SgDemoParam Name="Placeholder" Type="string" Description="Placeholder shown when the field is empty." DefaultValue="null" />
        <SgDemoParam Name="Rows" Type="int" Description="Initial visible row count." Values="Any positive integer" DefaultValue="3" />
        <SgDemoParam Name="AutoResize" Type="bool" Description="Automatically adjusts height to fit content." Values="true, false" DefaultValue="false" />
        <SgDemoParam Name="MaxRows" Type="int" Description="Maximum visible rows when auto-resize is enabled." Values="0 or positive integer" DefaultValue="0" />
        <SgDemoParam Name="Resize" Type="SgTextResize" Description="Controls the resize handle behavior." Values="None, Vertical, Horizontal, Both" DefaultValue="Vertical" />
        <SgDemoParam Name="ShowCounter" Type="bool" Description="Shows a live character counter." Values="true, false" DefaultValue="false" />
        <SgDemoParam Name="ShowClearButton" Type="bool" Description="Shows a clear action when the field has content." Values="true, false" DefaultValue="false" />
        <SgDemoParam Name="Debounce" Type="int" Description="Delays change propagation while typing." Values="Milliseconds, 0 disables debounce" DefaultValue="0" />
        <SgDemoParam Name="Immediate" Type="bool" Description="Updates bound value on input instead of change." Values="true, false" DefaultValue="true" />
    </SgDemoParams>
</div>

@code {
    private string? _description = "SuperUI makes large Blazor screens feel structured and consistent.";
    private string? _bio = "Product-focused .NET engineer building fast internal tools.";
    private string? _notes = "First line\nSecond line\nThird line";
    private string? _debounced;
}
