@page "/textarea-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@using System.ComponentModel.DataAnnotations
@inject IJSRuntime JS

<PageTitle>SgTextArea — Multi-line Input — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Basic Usage                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Basic Usage
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Simple multi-line text input with label, placeholder, and hint support. Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">@@bind-Value</SgTypography> for two-way binding.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With label & hint
                        </SgTypography>
                        <SgTextArea Label="Description" @bind-Value="_basic" Placeholder="Enter a detailed description..." Hint="Tell us about your project" Rows="4" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Without label
                        </SgTypography>
                        <SgTextArea @bind-Value="_plain" Placeholder="Type something..." Rows="3" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Live preview
                        </SgTypography>
                        <SgTextArea @bind-Value="_basic" Placeholder="Typing updates the preview..." Rows="2" />
                        <div class="demo-preview-box">
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Current value: <strong>@_basic</strong></SgTypography>
                        </div>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_basicProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Counter & Clear                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Counter & Clear
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Character counter with threshold warning and one-click clear button. The counter turns amber when approaching the limit.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With character counter (max 100)
                        </SgTypography>
                        <SgTextArea @bind-Value="_counter" Placeholder="Bio (max 100 chars)..." MaxLength="100" ShowCounter="true" Rows="3" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With clear button
                        </SgTypography>
                        <SgTextArea @bind-Value="_clearable" Placeholder="Type something and clear..." AllowClear="true" Rows="2" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Counter + Clear together (max 50)
                        </SgTypography>
                        <SgTextArea @bind-Value="_counterClear" Placeholder="Short text only..." MaxLength="50" ShowCounter="true" AllowClear="true" Rows="2" />
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_counterProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Auto-resize & Rows                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Auto-Resize & Rows
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Textarea grows automatically as you type. Set <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">AutoResize="true"</SgTypography> with optional <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">MaxRows</SgTypography> to cap the height.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Auto-resize (unlimited)
                        </SgTypography>
                        <SgTextArea @bind-Value="_autoResize" Placeholder="Type here — height grows automatically..." AutoResize="true" Rows="2" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Auto-resize with max rows (5)
                        </SgTypography>
                        <SgTextArea @bind-Value="_autoResizeMax" Placeholder="Grows but stops at 5 rows..." AutoResize="true" Rows="2" MaxRows="5" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Resize handle: Both directions
                        </SgTypography>
                        <SgTextArea @bind-Value="_resizeBoth" Placeholder="Drag the corner to resize..." Resize="SgTextResize.Both" Rows="3" />
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_resizeProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. States                                                          -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                States
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Disabled, read-only, required, and error states for different form scenarios.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgRow Space="SgSize.Md">
                        <SgCol Span="6">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Disabled
                            </SgTypography>
                            <SgTextArea @bind-Value="_disabled" Placeholder="Disabled textarea" Disabled="true" Rows="2" />
                        </SgCol>
                        <SgCol Span="6">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Read-only
                            </SgTypography>
                            <SgTextArea @bind-Value="_readonly" ReadOnly="true" Rows="2" />
                        </SgCol>
                    </SgRow>
                    <SgRow Space="SgSize.Md">
                        <SgCol Span="6">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Required
                            </SgTypography>
                            <SgTextArea Label="Feedback" Placeholder="Required field..." Required="true" Rows="2" />
                        </SgCol>
                        <SgCol Span="6">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:8px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                                Error state
                            </SgTypography>
                            <SgTextArea Label="Comments" @bind-Value="_error" Placeholder="This field has an error..." ErrorText="Comments must be at least 10 characters" Rows="2" />
                        </SgCol>
                    </SgRow>
                </SgStack>
            </SgCard>

            <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_stateProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Two-way Binding                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Two-way Binding
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Value updates in real time. The panel below reflects every keystroke via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">@@bind-Value</SgTypography>.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Live Binding" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgTextArea @bind-Value="_bound" Placeholder="Type something here..." Rows="4" />
                        <div class="demo-preview-box">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Value: <strong>@_bound</strong></SgTypography>
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Length: <strong>@(_bound?.Length ?? 0)</strong> characters</SgTypography>
                            </SgStack>
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_bindingProperties" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. Validation (EditForm)                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Form Validation
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Integrates with Blazor <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">EditForm</SgTypography> and <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">DataAnnotationsValidator</SgTypography>. Validation messages appear automatically.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Validation Example" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <EditForm Model="@_model">
                        <DataAnnotationsValidator />
                        <SgStack Vertical Space="SgSize.Md">
                            <SgTextArea Label="Bio" @bind-Value="_model.Bio" Placeholder="Enter your bio (5-200 chars)..." MaxLength="200" ShowCounter="true" Rows="3" />
                            <SgTextArea Label="Notes" @bind-Value="_model.Notes" Placeholder="Optional notes..." Rows="2" />
                            <SgButton Variant="SgButtonVariant.Primary" Type="SgButtonType.Submit">Submit</SgButton>
                        </SgStack>
                    </EditForm>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Validation Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_validationProperties" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 7. Live Constructor                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live SgTextArea Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Tweak parameters interactively and see the result in real time. Click the copy button to grab the generated code.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Rows -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Rows</SgTypography>
                            <SgSegmented TValue="int"
                                         Value="_cRows"
                                         ValueChanged="v => { _cRows = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_cRowsOptions" />
                        </SgStack>

                        <!-- MaxLength -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">MaxLength</SgTypography>
                            <SgSegmented TValue="int?"
                                         Value="@_cMaxLength"
                                         ValueChanged="v => { _cMaxLength = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_cMaxLengthOptions" />
                        </SgStack>

                        <!-- Toggles row -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">ShowCounter</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_cShowCounter"
                                                 ValueChanged="v => { _cShowCounter = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_cBoolOpts" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">AllowClear</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_cAllowClear"
                                                 ValueChanged="v => { _cAllowClear = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_cBoolOpts2" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- AutoResize + Disabled -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">AutoResize</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_cAutoResize"
                                                 ValueChanged="v => { _cAutoResize = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_cBoolOpts" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Disabled</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_cDisabled"
                                                 ValueChanged="v => { _cDisabled = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_cBoolOpts" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Resize style -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Resize Handle</SgTypography>
                            <SgSegmented TValue="SgTextResize"
                                         Value="@_cResize"
                                         ValueChanged="v => { _cResize = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_cResizeOptions" />
                        </SgStack>

                        <!-- Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Rows</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_cRows.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">MaxLength</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Success" Text="@(_cMaxLength?.ToString() ?? "∞")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Resize</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_cResize.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">AutoResize</SgTypography>
                                    <SgBadge Variant="@(_cAutoResize ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_cAutoResize ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <div class="constructor-preview">
                                <SgTextArea @bind-Value="_cValue"
                                            Placeholder="Interactive SgTextArea..."
                                            Rows="@_cRows"
                                            MaxLength="@_cMaxLength"
                                            ShowCounter="@_cShowCounter"
                                            AllowClear="@_cAllowClear"
                                            AutoResize="@_cAutoResize"
                                            Disabled="@_cDisabled"
                                            Resize="@_cResize" />
                            </div>
                        </SgStack>

                        <!-- Generated Code -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                    <span id="copy-icon">@_copyIcon</span>
                                    <span id="copy-text" style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                </button>
                            </div>
                            <div class="code-block" id="code-block">
                                @foreach (var line in _generatedCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

    </ChildContent>
</SgCard>

<style>
    /* ── Section layout ─────────────────────────────────────────────────────── */
    .demo-section {
        margin-top: 48px;
    }
    .demo-section-header {
        margin-bottom: 20px;
    }

    .demo-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
