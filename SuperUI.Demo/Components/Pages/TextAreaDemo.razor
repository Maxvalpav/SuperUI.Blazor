    private int _cRows = 3;
    private int? _cMaxLength = null;
    private bool _cShowCounter;
    private bool _cAllowClear = true;
    private bool _cAutoResize;
    private bool _cDisabled;
    private SgTextResize _cResize = SgTextResize.Vertical;
    private string _cValue = "";

    // ── Code generation ───────────────────────────────────────────────────
    private string[] _generatedCodeLines = Array.Empty<string>();
    private string _copyIcon = "📋";
    private string _copyLabel = "Copy";

    // ── Segmented options ─────────────────────────────────────────────────
    private readonly List<SgSegmentedOption<int>> _cRowsOptions = new()
    {
        new() { Value = 1, Label = "1" },
