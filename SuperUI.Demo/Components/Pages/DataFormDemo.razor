@page "/data-form-demo"
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@inject SgToastService Toasts

<PageTitle>DataForm Demo — SUI</PageTitle>

<div style="display:flex; flex-direction:column; gap:18px; max-width:1100px;">
    <SgCard Title="SgDataForm">
        <div style="display:flex; flex-direction:column; gap:8px;">
            <SgAlert Dense="true" Text="Автогенерируемая форма по модели с поддержкой DataAnnotations и кастомных шаблонов полей." />
            <div style="font-size:13px; color:var(--sui-muted);">
                Компонент подходит для CRUD-экранов, быстрых административных форм и редактирования записей в модалках или drawer.
            </div>
            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                <a href="/components" style="text-decoration:none;">
                    <SgButton Text="Назад к компонентам" Variant="SgButtonVariant.Ghost" />
                </a>
                <SgButton Text="Открыть форму в модалке" Variant="SgButtonVariant.Primary" OnClick="@(() => _modalVisible = true)" />
            </div>
        </div>
    </SgCard>

    <div style="display:grid; grid-template-columns: minmax(0, 1fr) 360px; gap:18px; align-items:start;">
        <SgCard Title="Базовая форма">
            <SgDataForm TModel="Employee"
                        Model="_employee"
                        Columns="2"
                        SubmitText="Сохранить"
                        ShowValidationSummary="true"
                        OnValidSubmit="SaveEmployeeAsync" />
        </SgCard>

        <SgCard Title="Текущее значение модели">
            <pre style="margin:0; white-space:pre-wrap; word-break:break-word; font-size:12px;">@EmployeeJson</pre>
        </SgCard>
    </div>

    <SgCard Title="Кастомный шаблон поля">
        <SgDataForm TModel="Employee"
                    Model="_employeeTemplate"
                    Columns="2"
                    SubmitText="Сохранить шаблон"
                    OnValidSubmit="SaveTemplateEmployeeAsync">
            <FieldTemplate Context="field">
                @if (field.PropertyName == nameof(Employee.Notes))
                {
                    <div style="grid-column:1 / -1;">
                        <label class="sgc-label @(field.Required ? "sgc-required" : "")">@field.Label</label>
                        <textarea class="sgc-textarea"
                                  rows="5"
                                  readonly="@field.ReadOnly"
                                  @onchange="async e => await field.SetValueAsync(e.Value?.ToString())">@((field.Value?.ToString()) ?? string.Empty)</textarea>
                        @foreach (var message in field.Messages)
                        {
                            <span class="sgc-error">@message</span>
                        }
                    </div>
                }
                else
                {
                    <div style="display:flex; flex-direction:column; gap:6px;">
                        <div style="font-size:12px; color:var(--sui-muted);">@field.PropertyName</div>
                        <div style="font-weight:600;">@field.Label</div>
                        <div style="font-size:13px; color:var(--sui-fg);">@(field.Value?.ToString() ?? "—")</div>
                    </div>
                }
            </FieldTemplate>
        </SgDataForm>
    </SgCard>

    <SgCard Title="SgDataForm в SgModal">
        <div style="display:flex; flex-direction:column; gap:12px;">
            <div style="font-size:13px; color:var(--sui-muted);">
                Типичный CRUD-сценарий: открываем запись в модальном окне, редактируем через `SgDataForm`, сохраняем и закрываем.
            </div>
            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                <SgButton Text="Редактировать сотрудника" Variant="SgButtonVariant.Primary" OnClick="OpenModalDemo" />
                <SgButton Text="Сбросить модель" Variant="SgButtonVariant.Ghost" OnClick="ResetModalModel" />
            </div>
            <pre style="margin:0; white-space:pre-wrap; word-break:break-word; font-size:12px;">@ModalEmployeeJson</pre>
        </div>
    </SgCard>

    <SgCard Title="API SgDataForm">
        <div style="display:grid; grid-template-columns: 220px 1fr; gap:10px 16px; font-size:13px;">
            <div><b>Model</b></div><div>Обязательная модель формы.</div>
            <div><b>AutoGenerate</b></div><div>Включает автогенерацию полей по свойствам модели.</div>
            <div><b>Columns</b></div><div>Количество колонок в сетке формы.</div>
            <div><b>ReadOnly</b></div><div>Переводит форму в режим только чтения.</div>
            <div><b>IncludeFields</b></div><div>Позволяет явно включить нужные поля.</div>
            <div><b>ExcludeFields</b></div><div>Исключает поля из автогенерации.</div>
            <div><b>FieldTemplate</b></div><div>Кастомный шаблон рендера поля с доступом к значению и `SetValueAsync`.</div>
            <div><b>Actions</b></div><div>Переопределяет нижний блок кнопок.</div>
            <div><b>OnValidSubmit</b></div><div>Вызывается после успешной валидации.</div>
            <div><b>OnInvalidSubmit</b></div><div>Вызывается при невалидной форме.</div>
        </div>
    </SgCard>
</div>

<SgModal @bind-Visible="_modalVisible" Title="Редактирование сотрудника" Width="720px">
    <ChildContent>
        <SgDataForm TModel="Employee"
                    Model="_modalEmployee"
                    Columns="2"
                    SubmitText="Сохранить в модалке"
                    ShowValidationSummary="true"
                    OnValidSubmit="SaveModalEmployeeAsync" />
    </ChildContent>
</SgModal>

@code {
    private readonly Employee _employee = new()
    {
        FirstName = "Анна",
        LastName = "Петрова",
        Email = "anna.petrova@superui.dev",
        Department = DepartmentType.Engineering,
        Salary = 180000,
        IsActive = true,
        HireDate = DateTime.Today.AddDays(-40),
        Notes = "Отвечает за развитие библиотеки компонентов."
    };

    private readonly Employee _employeeTemplate = new()
    {
        FirstName = "Иван",
        LastName = "Смирнов",
        Email = "ivan.smirnov@superui.dev",
        Department = DepartmentType.Design,
        Salary = 145000,
        IsActive = true,
        HireDate = DateTime.Today,
        Notes = "Это пример использования кастомного шаблона поля."
    };
    private Employee _modalEmployee = CreateModalEmployee();
    private bool _modalVisible;

    private static readonly System.Text.Json.JsonSerializerOptions _jsonOpts = new()
    {
        WriteIndented = true,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
    };

    private string EmployeeJson      => System.Text.Json.JsonSerializer.Serialize(_employee,      _jsonOpts);
    private string ModalEmployeeJson => System.Text.Json.JsonSerializer.Serialize(_modalEmployee, _jsonOpts);

    private Task SaveEmployeeAsync(Employee model)
    {
        Toasts.Success($"Форма сохранена: {model.FirstName} {model.LastName}");
        return Task.CompletedTask;
    }

    private Task SaveTemplateEmployeeAsync(Employee model)
    {
        Toasts.Info($"Шаблонная форма сохранена для {model.FirstName}");
        return Task.CompletedTask;
    }

    private void OpenModalDemo()
    {
        _modalVisible = true;
    }

    private void ResetModalModel()
    {
        _modalEmployee = CreateModalEmployee();
    }

    private Task SaveModalEmployeeAsync(Employee model)
    {
        _modalVisible = false;
        Toasts.Success($"Сотрудник сохранен в модалке: {model.FirstName} {model.LastName}");
        return Task.CompletedTask;
    }

    private static Employee CreateModalEmployee() => new()
    {
        FirstName = "Екатерина",
        LastName = "Орлова",
        Email = "ekaterina.orlova@superui.dev",
        Department = DepartmentType.Product,
        Salary = 210000,
        IsActive = true,
        HireDate = DateTime.Today.AddMonths(-4),
        Notes = "Пример модели для модального редактирования."
    };
}

