</style>

@code {
    // ── Main header ────────────────────────────────────────────────────
    private RenderFragment _mainHeader => __builder =>
    {
        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
            <div style="display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,var(--sg-primary),#8b5cf6);color:#fff;flex-shrink:0;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/><path d="M12 22v-4"/><path d="M12 14v-2"/><path d="M12 10V8"/><path d="M4.93 4.93l2.83 2.83"/><path d="M19.07 4.93l-2.83 2.83"/><path d="M4.93 19.07l2.83-2.83"/><path d="M19.07 19.07l-2.83-2.83"/>
                </svg>
            </div>
            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">SgDropdown — Dropdown Menu</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Versatile dropdown with items, icons, search, keyboard navigation, subtext, and multiple trigger modes.
                </SgTypography>
            </SgStack>
        </SgStack>
    };

    // ── State ───────────────────────────────────────────────────────────
    private List<string> _logs = new();
    private string _sortBy = "name";
    private bool _isLoading;

    private void Log(string msg)
    {
        _logs.Insert(0, $"[{DateTime.Now:HH:mm:ss}] {msg}");
        if (_logs.Count > 15) _logs.RemoveAt(15);
    }

    private void LogView() => Log("View clicked");
    private void LogEdit() => Log("Edit clicked");
    private void LogDelete() => Log("Delete clicked");
    private void ClearLogs() => _logs.Clear();

    // ── Constructor state ───────────────────────────────────────────────
    private string _constructorTriggerText = "Actions";
    private SgButtonVariant _constructorVariant = SgButtonVariant.Default;
    private SgPlacement _constructorPlacement = SgPlacement.BottomStart;
    private bool _constructorShowCaret = true;
    private bool _constructorSearchable;

    private string[] _generatedCodeLines = Array.Empty<string>();
    private string _copyIcon = "📋";
    private string _copyLabel = "Copy";

    private readonly List<SgSegmentedOption<SgButtonVariant>> _variantSegOptions = new()
    {
        new() { Value = SgButtonVariant.Default, Label = "Default" },
        new() { Value = SgButtonVariant.Primary, Label = "Primary" },
        new() { Value = SgButtonVariant.Outlined, Label = "Outlined" },
        new() { Value = SgButtonVariant.Ghost, Label = "Ghost" },
    };

    private readonly List<SgSegmentedOption<bool>> _boolSegOptions = new()
    {
        new() { Value = false, Label = "Off" },
        new() { Value = true,  Label = "On" },
    };

    private readonly List<SgPlacement> _placementItems = new()
    {
        SgPlacement.BottomStart, SgPlacement.BottomEnd,
        SgPlacement.TopStart, SgPlacement.TopEnd
    };

    protected override void OnInitialized() => UpdateConstructorCode();

    private void UpdateConstructorCode()
    {
        var lines = new List<string>
        {
            $"<SgDropdown Text=\"{_constructorTriggerText}\""
        };
        if (_constructorVariant != SgButtonVariant.Default)
            lines.Add($"           Variant=\"SgButtonVariant.{_constructorVariant}\"");
        if (_constructorPlacement != SgPlacement.BottomStart)
            lines.Add($"           Placement=\"SgPlacement.{_constructorPlacement}\"");
        if (_constructorShowCaret)
            lines.Add("           ShowCaret=\"true\"");
        if (_constructorSearchable)
            lines.Add("           Searchable=\"true\"");
        lines.Add("           MinWidth=\"180\">");
        lines.Add("    <SgDropdownItem Text=\"View\" Icon=\"@SgHeroicons.Outline.Eye\" />");
        lines.Add("    <SgDropdownItem Text=\"Edit\" Icon=\"@SgHeroicons.Outline.Pencil\" />");
        lines.Add("    <SgDropdownItem Text=\"Delete\" Icon=\"@SgHeroicons.Outline.Trash\" Danger=\"true\" />");
        lines.Add("</SgDropdown>");
        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

    // ── Property tables ─────────────────────────────────────────────────
    private List<PropertyPanelItem> _basicProperties = new()
    {
        new() { Label = "Text", Value = "string?", BadgeText = "Trigger label" },
        new() { Label = "Variant", Value = "SgButtonVariant", BadgeText = "Button style", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Size", Value = "SgSize", BadgeText = "Button size", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Disabled", Value = "bool", BadgeText = "Disabled", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "TriggerContent", Value = "RenderFragment?", BadgeText = "Custom trigger" },
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Menu items" },
        new() { Label = "HeaderContent", Value = "RenderFragment?", BadgeText = "Header area" },
        new() { Label = "FooterContent", Value = "RenderFragment?", BadgeText = "Footer area" },
        new() { Label = "ShowCaret", Value = "bool", BadgeText = "Caret arrow" },
        new() { Label = "CloseOnSelect", Value = "bool", BadgeText = "Auto-close", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Placement", Value = "SgPlacement", BadgeText = "Menu position", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Trigger", Value = "SgDropdownTrigger", BadgeText = "Open mode", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "MaxHeight", Value = "int?", BadgeText = "Max menu height" },
        new() { Label = "MinWidth", Value = "int?", BadgeText = "Min menu width" },
        new() { Label = "Loading", Value = "bool", BadgeText = "Loading state", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Searchable", Value = "bool", BadgeText = "Search filter", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "SearchPlaceholder", Value = "string?", BadgeText = "Search hint" },
        new() { Label = "MatchWidth", Value = "bool", BadgeText = "Match trigger" },
        new() { Label = "Gap", Value = "string?", BadgeText = "Trigger gap" },
        new() { Label = "MenuMaxWidth", Value = "int?", BadgeText = "Max width" },
        new() { Label = "Animation", Value = "bool", BadgeText = "Animate", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "CssClass / MenuCssClass", Value = "string?", BadgeText = "Custom CSS" },
    };

    private List<PropertyPanelItem> _itemProperties = new()
    {
        new() { Label = "Text", Value = "string", BadgeText = "Item label" },
        new() { Label = "Subtext", Value = "string?", BadgeText = "Description", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Icon", Value = "string?", BadgeText = "SVG icon markup" },
        new() { Label = "IconColor", Value = "string?", BadgeText = "Icon color" },
        new() { Label = "Shortcut", Value = "string?", BadgeText = "Keyboard hint" },
        new() { Label = "Disabled", Value = "bool", BadgeText = "Disabled", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Danger", Value = "bool", BadgeText = "Danger style", BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "Selected", Value = "bool", BadgeText = "Checkmark", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Divider", Value = "bool", BadgeText = "Separator" },
        new() { Label = "Href", Value = "string?", BadgeText = "Link mode", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "OnClick", Value = "EventCallback", BadgeText = "Click event" },
        new() { Label = "ChildContent", Value = "RenderFragment?", BadgeText = "Custom content" },
    };

    private List<PropertyPanelItem> _loadingProperties = new()
    {
        new() { Label = "Loading", Value = "bool", BadgeText = "Loading state", BadgeVariant = SgBadgeVariant.Info },
    };
}
