@page "/dropdown-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgDropdown — Dropdown Menu — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Basic Usage                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Basic Usage
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Simple dropdown with action items. Click the button to open, click an item to select.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Actions Menu
                        </SgTypography>
                        <SgSpace>
                            <SgDropdown Text="Actions" ShowCaret="true">
                                <SgDropdownItem Text="View" OnClick="@LogView" />
                                <SgDropdownItem Text="Edit" OnClick="@LogEdit" />
                                <SgDropdownItem Text="Delete" Danger="true" OnClick="@LogDelete" />
                            </SgDropdown>
                            <SgDropdown Text="More" Variant="SgButtonVariant.Outlined" ShowCaret="true">
                                <SgDropdownItem Text="Duplicate" OnClick="@(() => Log("Duplicate"))" />
                                <SgDropdownItem Text="Move" OnClick="@(() => Log("Move"))" />
                                <SgDropdownItem Divider="true" />
                                <SgDropdownItem Text="Archive" OnClick="@(() => Log("Archive"))" />
                            </SgDropdown>
                        </SgSpace>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Event Log
                            @if (_logs.Count > 0)
                            {
                                <button type="button" class="demo-inline-btn" @onclick="ClearLogs" title="Clear log">✕</button>
                            }
                        </SgTypography>
                        <div class="demo-log">
                            @if (_logs.Count == 0)
                            {
                                <span class="demo-log-empty">Click a dropdown item to see events</span>
                            }
                            @foreach (var log in _logs)
                            {
                                <div class="demo-log-entry">@log</div>
                            }
                        </div>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="SgDropdown Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_basicProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. With Icons                                                      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                With Icons
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Dropdown items with Heroicons leading icons via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Icon</SgTypography> parameter.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            User Settings
                        </SgTypography>
                        <SgDropdown Text="Settings" Variant="SgButtonVariant.Primary" ShowCaret="true">
                            <SgDropdownItem Text="Profile" Icon="@SgHeroicons.Outline.User" OnClick="@(() => Log("Profile"))" />
                            <SgDropdownItem Text="Security" Icon="@SgHeroicons.Outline.LockClosed" OnClick="@(() => Log("Security"))" />
                            <SgDropdownItem Text="Notifications" Icon="@SgHeroicons.Outline.Bell" OnClick="@(() => Log("Notifications"))" />
                            <SgDropdownItem Divider="true" />
                            <SgDropdownItem Text="Logout" Icon="@SgHeroicons.Outline.ArrowRightOnRectangle" Danger="true" OnClick="@(() => Log("Logout"))" />
                        </SgDropdown>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            File Actions
                        </SgTypography>
                        <SgDropdown Text="File" Variant="SgButtonVariant.Outlined">
                            <SgDropdownItem Text="New" Icon="@SgHeroicons.Outline.DocumentPlus" OnClick="@(() => Log("New"))" />
                            <SgDropdownItem Text="Open" Icon="@SgHeroicons.Outline.FolderOpen" OnClick="@(() => Log("Open"))" />
                            <SgDropdownItem Text="Save" Icon="@SgHeroicons.Outline.ArrowDownOnSquare" Shortcut="⌘S" OnClick="@(() => Log("Save"))" />
                            <SgDropdownItem Divider="true" />
                            <SgDropdownItem Text="Export PDF" Icon="@SgHeroicons.Outline.DocumentArrowDown" OnClick="@(() => Log("Export PDF"))" />
                            <SgDropdownItem Text="Print" Icon="@SgHeroicons.Outline.Printer" Shortcut="⌘P" Disabled="true" OnClick="@(() => Log("Print"))" />
                        </SgDropdown>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="SgDropdownItem Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_itemProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Custom Trigger                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Custom Trigger
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Use any content as the dropdown trigger via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">TriggerContent</SgTypography>.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Button Trigger" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgDropdown>
                    <TriggerContent>
                        <SgButton Variant="SgButtonVariant.Success" Text="Export Data" />
                    </TriggerContent>
                    <ChildContent>
                        <SgDropdownItem Text="Export CSV" Icon="@SgHeroicons.Outline.DocumentArrowDown" OnClick="@(() => Log("CSV"))" />
                        <SgDropdownItem Text="Export PDF" Icon="@SgHeroicons.Outline.DocumentText" OnClick="@(() => Log("PDF"))" />
                        <SgDropdownItem Text="Export XLSX" Icon="@SgHeroicons.Outline.TableCells" OnClick="@(() => Log("XLSX"))" />
                        <SgDropdownItem Divider="true" />
                        <SgDropdownItem Text="Print" Icon="@SgHeroicons.Outline.Printer" Disabled="true" OnClick="@(() => Log("Print"))" />
                    </ChildContent>
                </SgDropdown>
            </SgCard>
            <SgCard Title="Icon-only Trigger" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgDropdown>
                    <TriggerContent>
                        <SgButton Variant="SgButtonVariant.Ghost" Text="⚙" />
                    </TriggerContent>
                    <ChildContent>
                        <SgDropdownItem Text="Profile" Icon="@SgHeroicons.Outline.User" OnClick="@(() => Log("Profile"))" />
                        <SgDropdownItem Text="Settings" Icon="@SgHeroicons.Outline.Cog6Tooth" OnClick="@(() => Log("Settings"))" />
                        <SgDropdownItem Text="Help" Icon="@SgHeroicons.Outline.QuestionMarkCircle" OnClick="@(() => Log("Help"))" />
                    </ChildContent>
                </SgDropdown>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Placements                                                      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Placements
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Control menu position via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Placement</SgTypography>.
            </SgTypography>
        </div>

        <SgCard Title="Placement Variants" Shadow="SgShadow.Sm" Size="SgSize.Sm" NoPadding="true">
            <div style="padding:32px;display:flex;flex-wrap:wrap;gap:24px;align-items:flex-start;justify-content:center;min-height:280px;">
                <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)">BottomStart</SgTypography>
                    <SgDropdown Text="BottomStart" Placement="SgPlacement.BottomStart">
                        <SgDropdownItem Text="Item 1" OnClick="@(() => Log("Placement"))" />
                        <SgDropdownItem Text="Item 2" OnClick="@(() => Log("Placement"))" />
                    </SgDropdown>
                </SgStack>
                <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)">BottomEnd</SgTypography>
                    <SgDropdown Text="BottomEnd" Placement="SgPlacement.BottomEnd">
                        <SgDropdownItem Text="Item 1" OnClick="@(() => Log("Placement"))" />
                        <SgDropdownItem Text="Item 2" OnClick="@(() => Log("Placement"))" />
                    </SgDropdown>
                </SgStack>
                <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)">TopStart</SgTypography>
                    <SgDropdown Text="TopStart" Placement="SgPlacement.TopStart">
                        <SgDropdownItem Text="Item 1" OnClick="@(() => Log("Placement"))" />
                        <SgDropdownItem Text="Item 2" OnClick="@(() => Log("Placement"))" />
                    </SgDropdown>
                </SgStack>
                <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)">TopEnd</SgTypography>
                    <SgDropdown Text="TopEnd" Placement="SgPlacement.TopEnd">
                        <SgDropdownItem Text="Item 1" OnClick="@(() => Log("Placement"))" />
                        <SgDropdownItem Text="Item 2" OnClick="@(() => Log("Placement"))" />
                    </SgDropdown>
                </SgStack>
            </div>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Trigger Modes                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Trigger Modes
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Click</SgTypography> (default), <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Hover</SgTypography>, or <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ContextMenu</SgTypography>.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="4">
                <SgCard Title="Click (Default)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:12px;">
                        Click to open, click item or outside to close.
                    </SgTypography>
                    <SgDropdown Text="Click me" ShowCaret="true">
                        <SgDropdownItem Text="Option A" OnClick="@(() => Log("Click A"))" />
                        <SgDropdownItem Text="Option B" OnClick="@(() => Log("Click B"))" />
                    </SgDropdown>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Hover" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:12px;">
                        Hover to open with configurable delay.
                    </SgTypography>
                    <SgDropdown Text="Hover me" Trigger="SgDropdownTrigger.Hover" ShowCaret="true" OpenDelay="150" CloseDelay="200">
                        <SgDropdownItem Text="Option A" OnClick="@(() => Log("Hover A"))" />
                        <SgDropdownItem Text="Option B" OnClick="@(() => Log("Hover B"))" />
                    </SgDropdown>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Context Menu" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:12px;">
                        Right-click to open.
                    </SgTypography>
                    <SgDropdown Text="Right-click me" Trigger="SgDropdownTrigger.ContextMenu" ShowCaret="true">
                        <SgDropdownItem Text="Option A" OnClick="@(() => Log("Context A"))" />
                        <SgDropdownItem Text="Option B" OnClick="@(() => Log("Context B"))" />
                    </SgDropdown>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. Searchable                                                      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Searchable
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Filter items by typing when <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Searchable="true"</SgTypography>.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Searchable Dropdown" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgDropdown Text="Select country" Searchable="true" ShowCaret="true" MinWidth="220">
                    <SgDropdownItem Text="United States" Icon="@SgHeroicons.Outline.GlobeAmericas" Subtext="North America" OnClick="@(() => Log("US"))" />
                    <SgDropdownItem Text="United Kingdom" Icon="@SgHeroicons.Outline.GlobeEuropeAfrica" Subtext="Europe" OnClick="@(() => Log("UK"))" />
                    <SgDropdownItem Text="Germany" Icon="@SgHeroicons.Outline.GlobeEuropeAfrica" Subtext="Europe" OnClick="@(() => Log("Germany"))" />
                    <SgDropdownItem Text="France" Icon="@SgHeroicons.Outline.GlobeEuropeAfrica" Subtext="Europe" OnClick="@(() => Log("France"))" />
                    <SgDropdownItem Text="Japan" Icon="@SgHeroicons.Outline.GlobeAsiaAustralia" Subtext="Asia" OnClick="@(() => Log("Japan"))" />
                    <SgDropdownItem Text="Brazil" Icon="@SgHeroicons.Outline.GlobeAmericas" Subtext="South America" OnClick="@(() => Log("Brazil"))" />
                    <SgDropdownItem Text="Australia" Icon="@SgHeroicons.Outline.GlobeAsiaAustralia" Subtext="Oceania" OnClick="@(() => Log("Australia"))" />
                    <SgDropdownItem Text="Canada" Icon="@SgHeroicons.Outline.GlobeAmericas" Subtext="North America" OnClick="@(() => Log("Canada"))" />
                </SgDropdown>
            </SgCard>

            <SgCard Title="New Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="@(new List<PropertyPanelItem>
                {
                    new() { Label = "Searchable", Value = "bool", BadgeText = "Show search", BadgeVariant = SgBadgeVariant.Success },
                    new() { Label = "SearchPlaceholder", Value = "string?", BadgeText = "Input hint" },
                    new() { Label = "Loading", Value = "bool", BadgeText = "Loading state", BadgeVariant = SgBadgeVariant.Info },
                    new() { Label = "MatchWidth", Value = "bool", BadgeText = "Match trigger width" },
                    new() { Label = "Gap", Value = "string?", BadgeText = "Custom gap" },
                    new() { Label = "MenuMaxWidth", Value = "int?", BadgeText = "Menu max width" },
                    new() { Label = "Animation", Value = "bool", BadgeText = "Animation", BadgeVariant = SgBadgeVariant.Success },
                })" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 7. Items with Subtext & Shortcuts                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Subtext, Shortcuts & Selection
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Enhanced items with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Subtext</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Shortcut</SgTypography>, and <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Selected</SgTypography> state.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Rich Items" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With Subtext
                        </SgTypography>
                        <SgDropdown Text="Select view" Variant="SgButtonVariant.Outlined" ShowCaret="true" MinWidth="200">
                            <SgDropdownItem Text="Table" Icon="@SgHeroicons.Outline.TableCells" Subtext="Grid layout with columns" OnClick="@(() => Log("Table view"))" />
                            <SgDropdownItem Text="Cards" Icon="@SgHeroicons.Outline.Squares2x2" Subtext="Card-based layout" OnClick="@(() => Log("Cards view"))" />
                            <SgDropdownItem Text="Timeline" Icon="@SgHeroicons.Outline.ListBullet" Subtext="Chronological feed" OnClick="@(() => Log("Timeline view"))" />
                        </SgDropdown>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With Shortcuts
                        </SgTypography>
                        <SgDropdown Text="Edit" Variant="SgButtonVariant.Default" ShowCaret="true">
                            <SgDropdownItem Text="Undo" Shortcut="⌘Z" OnClick="@(() => Log("Undo"))" />
                            <SgDropdownItem Text="Redo" Shortcut="⌘⇧Z" OnClick="@(() => Log("Redo"))" />
                            <SgDropdownItem Divider="true" />
                            <SgDropdownItem Text="Cut" Shortcut="⌘X" OnClick="@(() => Log("Cut"))" />
                            <SgDropdownItem Text="Copy" Shortcut="⌘C" OnClick="@(() => Log("Copy"))" />
                            <SgDropdownItem Text="Paste" Shortcut="⌘V" OnClick="@(() => Log("Paste"))" />
                        </SgDropdown>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Selected State" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:12px;">
                    Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Xs">Selected="true"</SgTypography> to show a checkmark.
                </SgTypography>
                <SgDropdown Text="Sort by" Variant="SgButtonVariant.Outlined" ShowCaret="true" MinWidth="180">
                    <SgDropdownItem Text="Name" Selected="@(_sortBy == "name")" OnClick="@(() => { _sortBy = "name"; Log("Sort: name"); })" />
                    <SgDropdownItem Text="Date" Selected="@(_sortBy == "date")" OnClick="@(() => { _sortBy = "date"; Log("Sort: date"); })" />
                    <SgDropdownItem Text="Size" Selected="@(_sortBy == "size")" OnClick="@(() => { _sortBy = "size"; Log("Sort: size"); })" />
                    <SgDropdownItem Text="Type" Selected="@(_sortBy == "type")" OnClick="@(() => { _sortBy = "type"; Log("Sort: type"); })" />
                </SgDropdown>
                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Style="display:block;margin-top:12px;">
                    Current: <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Semibold">@_sortBy</SgTypography>
                </SgTypography>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 8. Loading State                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Loading State
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Show a loading spinner via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Loading="true"</SgTypography>.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Loading Example" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgDropdown Text="@(_isLoading ? "Loading..." : "Load data")" Loading="@_isLoading" ShowCaret="true" Variant="@(_isLoading ? SgButtonVariant.Default : SgButtonVariant.Primary)">
                    @if (!_isLoading)
                    {
                        <SgDropdownItem Text="Users" Icon="@SgHeroicons.Outline.Users" OnClick="@(() => Log("Users"))" />
                        <SgDropdownItem Text="Posts" Icon="@SgHeroicons.Outline.DocumentText" OnClick="@(() => Log("Posts"))" />
                        <SgDropdownItem Text="Comments" Icon="@SgHeroicons.Outline.ChatBubbleLeft" OnClick="@(() => Log("Comments"))" />
                    }
                </SgDropdown>
                <SgButton Text="@(_isLoading ? "Stop loading" : "Toggle loading")" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" Style="margin-top:12px;" OnClick="@(() => _isLoading = !_isLoading)" />
            </SgCard>

            <SgCard Title="Loading Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_loadingProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 9. Live Constructor                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live Dropdown Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure parameters interactively and see the result in real time.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Trigger text -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Trigger Text</SgTypography>
                            <SgTextBox @bind-Value="_constructorTriggerText" Placeholder="Button label" Block="true" />
                        </SgStack>

                        <!-- Variant -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Variant</SgTypography>
                            <SgSegmented TValue="SgButtonVariant"
                                         Value="_constructorVariant"
                                         ValueChanged="v => { _constructorVariant = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_variantSegOptions" />
                        </SgStack>

                        <!-- Placement -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Placement</SgTypography>
                            <SgSelect TValue="SgPlacement"
                                      @bind-Value="_constructorPlacement"
                                      Items="_placementItems"
                                      LabelSelector="x => x.ToString()"
                                      Block="true" />
                        </SgStack>

                        <!-- Toggles -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">ShowCaret</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_constructorShowCaret"
                                                 ValueChanged="v => { _constructorShowCaret = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Searchable</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_constructorSearchable"
                                                 ValueChanged="v => { _constructorSearchable = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Variant</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_constructorVariant.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Placement</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_constructorPlacement.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Searchable</SgTypography>
                                    <SgBadge Variant="@(_constructorSearchable ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_constructorSearchable ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            <div class="constructor-preview" id="constructor-preview">
                                <SgDropdown Text="@_constructorTriggerText"
                                            Variant="@_constructorVariant"
                                            Placement="@_constructorPlacement"
                                            ShowCaret="@_constructorShowCaret"
                                            Searchable="@_constructorSearchable">
                                    <SgDropdownItem Text="View" Icon="@SgHeroicons.Outline.Eye" OnClick="@(() => Log("Constructor: View"))" />
                                    <SgDropdownItem Text="Edit" Icon="@SgHeroicons.Outline.Pencil" OnClick="@(() => Log("Constructor: Edit"))" />
                                    <SgDropdownItem Text="Delete" Icon="@SgHeroicons.Outline.Trash" Danger="true" OnClick="@(() => Log("Constructor: Delete"))" />
                                </SgDropdown>
                            </div>
                        </SgStack>

                        <!-- Code with Copy -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                    <span id="copy-icon">@_copyIcon</span>
                                    <span id="copy-text" style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                </button>
                            </div>
                            <div class="code-block" id="code-block">
                                @foreach (var line in _generatedCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

</ChildContent>
</SgCard>

<style>
    .demo-section { margin-top: 48px; }
