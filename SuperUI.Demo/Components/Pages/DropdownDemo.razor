@page "/dropdown-demo"
@using SuperUI.Components

<PageTitle>Dropdown - SUI</PageTitle>

<SgCard Title="SgDropdown - Dropdown Menu"
        Subtitle="Button-triggered dropdown menu with items, icons, and custom triggers.">

    <div style="margin-top: 32px;">
        <h2>Basic Usage</h2>
        <p>Simple dropdown with action items.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Actions menu</div>
                        <SgDropdown Text="Actions">
                            <SgDropdownItem Text="View" OnClick="OnView" />
                            <SgDropdownItem Text="Edit" OnClick="OnEdit" />
                            <SgDropdownItem Text="Delete" Danger="true" OnClick="OnDelete" />
                        </SgDropdown>
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Event log</div>
                        <div style="background: var(--sui-bg-secondary); padding: 8px; border-radius: var(--sui-radius); font-size: 11px; min-height: 40px;">
                            @foreach (var log in _logs)
                            {
                                <div>@log</div>
                            }
                        </div>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_basicProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>With Icons</h2>
        <p>Dropdown items with leading icons.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <SgDropdown Text="Settings">
                    <SgDropdownItem Text="Profile" Icon="@Icons.User" OnClick="OnProfile" />
                    <SgDropdownItem Text="Security" Icon="@Icons.Lock" OnClick="OnSecurity" />
                    <SgDropdownItem Text="Logout" Danger="true" Icon="@Icons.LogOut" OnClick="OnLogout" />
                </SgDropdown>
            </SgCard>

            <SgCard Title="Item Properties">
                <PropertyTable Items="_itemProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Custom Trigger</h2>
        <p>Use any content as the dropdown trigger.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Example">
                <SgDropdown>
                    <TriggerContent>
                        <SgButton Variant="primary" Text="Export" />
                    </TriggerContent>
                    <ChildContent>
                        <SgDropdownItem Text="Export CSV" OnClick="OnCsv" />
                        <SgDropdownItem Text="Export PDF" OnClick="OnPdf" />
                        <SgDropdownItem Text="Print" Disabled="true" OnClick="OnPrint" />
                    </ChildContent>
                </SgDropdown>
            </SgCard>

            <SgCard Title="Trigger Properties">
                <PropertyTable Items="_triggerProperties" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private List<string> _logs = new();

    private void AddLog(string msg)
    {
        _logs.Insert(0, $"{DateTime.Now:HH:mm:ss} - {msg}");
        if (_logs.Count > 6) _logs.RemoveAt(_logs.Count - 1);
    }

    private void OnView() => AddLog("View clicked");
    private void OnEdit() => AddLog("Edit clicked");
    private void OnDelete() => AddLog("Delete clicked");
    private void OnProfile() => AddLog("Profile");
    private void OnSecurity() => AddLog("Security");
    private void OnLogout() => AddLog("Logout");
    private void OnCsv() => AddLog("CSV");
    private void OnPdf() => AddLog("PDF");
    private void OnPrint() => AddLog("Print");

    private List<PropertyPanelItem> _basicProperties = new()
    {
        new() { Label = "Text", Value = "string?", BadgeText = "Trigger button text" },
        new() { Label = "Disabled", Value = "bool", BadgeText = "Disabled state" },
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Menu items" },
        new() { Label = "CssClass", Value = "string?", BadgeText = "Custom CSS" }
    };

    private List<PropertyPanelItem> _itemProperties = new()
    {
        new() { Label = "Text", Value = "string", BadgeText = "Item label" },
        new() { Label = "Icon", Value = "string?", BadgeText = "SVG icon markup" },
        new() { Label = "Disabled", Value = "bool", BadgeText = "Disabled item" },
        new() { Label = "Danger", Value = "bool", BadgeText = "Danger style" },
        new() { Label = "OnClick", Value = "EventCallback", BadgeText = "Click event" }
    };

    private List<PropertyPanelItem> _triggerProperties = new()
    {
        new() { Label = "TriggerContent", Value = "RenderFragment?", BadgeText = "Custom trigger" },
        new() { Label = "Variant", Value = "string", BadgeText = "Button variant" },
        new() { Label = "Size", Value = "string", BadgeText = "Button size" },
        new() { Label = "OpenChanged", Value = "EventCallback<bool>", BadgeText = "Open state changed" }
    };

    private static class Icons
    {
        public const string User = @"<svg width=""14"" height=""14"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2"" stroke-linecap=""round"" stroke-linejoin=""round""><path d=""M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2""/><circle cx=""12"" cy=""7"" r=""4""/></svg>";
        public const string Lock = @"<svg width=""14"" height=""14"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2"" stroke-linecap=""round"" stroke-linejoin=""round""><rect width=""18"" height=""11"" x=""3"" y=""11"" rx=""2""/><path d=""M7 11V7a5 5 0 0 1 10 0v4""/></svg>";
        public const string LogOut = @"<svg width=""14"" height=""14"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2"" stroke-linecap=""round"" stroke-linejoin=""round""><path d=""M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4""/><polyline points=""16 17 21 12 16 7""/><line x1=""21"" x2=""9"" y1=""12"" y2=""12""/></svg>";
    }
}
