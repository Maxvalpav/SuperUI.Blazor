@page "/kpi-card-demo"
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>KPI Card - SUI</PageTitle>

<SgCard Title="SgKPICard — Карточки ключевых показателей"
        Subtitle="5 режимов отображения: Card, Ring, Inline, Ban, Analytic">

    @* ── 1. CARD MODE ─────────────────────────────────────────────────────── *@
    <div style="margin-top: 32px;">
        <h2>Card — Градиентные карточки</h2>
        <p>Цветной градиентный фон, волновой график снизу, белый текст.</p>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 16px;">

            <SgKPICard DisplayMode="SgKPIDisplayMode.Card"
                       Title="Выручка"
                       Subtitle="За текущий месяц"
                       Value="124500"
                       Format="C0"
                       Variant="SgKPIVariant.Primary"
                       TrendPercent="12.5"
                       TrendLabel="vs прошлый месяц"
                       ChartData="@_salesData"
                       ChartType="SgKPIChartType.Area" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Card"
                       Title="Конверсия"
                       Value="3.42"
                       Suffix="%"
                       Variant="SgKPIVariant.Success"
                       TrendPercent="0.8"
                       ChartData="@_conversionData"
                       ChartType="SgKPIChartType.Line" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Card"
                       Title="Заказы"
                       Subtitle="За 7 дней"
                       Value="856"
                       Variant="SgKPIVariant.Warning"
                       TrendPercent="18.3"
                       ChartData="@_ordersData"
                       ChartType="SgKPIChartType.Bar" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Card"
                       Title="Ошибки"
                       Value="12"
                       Variant="SgKPIVariant.Danger"
                       TrendPercent="-45.5"
                       InvertTrend="true"
                       TrendLabel="vs прошлый час"
                       ChartData="@_errorsData"
                       ChartType="SgKPIChartType.Bar" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Card"
                       Title="Трафик"
                       Value="45.2"
                       Suffix="K"
                       Variant="SgKPIVariant.Info"
                       TrendPercent="15.8"
                       ChartData="@_trafficData"
                       ChartType="SgKPIChartType.Area" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Card"
                       Title="Доход"
                       Subtitle="Квартал"
                       Value="1245000"
                       Format="C0"
                       Variant="SgKPIVariant.Default"
                       TrendPercent="24.5"
                       ChartData="@_revenueData"
                       ChartType="SgKPIChartType.Line" />
        </div>
    </div>

    @* ── 2. RING MODE ─────────────────────────────────────────────────────── *@
    <div style="margin-top: 40px;">
        <h2>Ring — Круговые индикаторы</h2>
        <p>SVG-кольцо с числом внутри. Заполнение = Value / Target.</p>
        <div style="display: flex; gap: 24px; flex-wrap: wrap; align-items: flex-end; margin-top: 16px;">

            <SgKPICard DisplayMode="SgKPIDisplayMode.Ring"
                       Title="Suppliers"
                       Value="804"
                       Variant="SgKPIVariant.Default"
                       Size="SgSize.Lg" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Ring"
                       Title="Contracted"
                       Value="61"
                       Suffix="%"
                       Target="100"
                       Variant="SgKPIVariant.Success"
                       Size="SgSize.Lg" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Ring"
                       Title="Unlisted"
                       Value="39"
                       Suffix="%"
                       Target="100"
                       Variant="SgKPIVariant.Danger"
                       Size="SgSize.Lg" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Ring"
                       Title="Выполнено"
                       Value="78"
                       Target="100"
                       Variant="SgKPIVariant.Primary"
                       Size="SgSize.Md" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Ring"
                       Title="NPS"
                       Value="4.8"
                       Target="5"
                       Variant="SgKPIVariant.Warning"
                       Size="SgSize.Sm" />
        </div>
    </div>

    @* ── 3. INLINE MODE ───────────────────────────────────────────────────── *@
    <div style="margin-top: 40px;">
        <h2>Inline — Строчные метрики</h2>
        <p>Горизонтальная строка: метка · значение · пунктирный sparkline · тренд. Для плотных таблиц.</p>
        <div style="display: flex; flex-direction: column; gap: 4px; margin-top: 16px; max-width: 600px;">

            <SgKPICard DisplayMode="SgKPIDisplayMode.Inline"
                       Title="Total Spending"
                       Value="2113507"
                       Format="C0"
                       Variant="SgKPIVariant.Default"
                       TrendPercent="5.2"
                       ChartData="@_salesData" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Inline"
                       Title="Savings"
                       Value="96788"
                       Format="C0"
                       Variant="SgKPIVariant.Success"
                       TrendPercent="12.1"
                       ChartData="@_conversionData" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Inline"
                       Title="Foregone Savings"
                       Value="52536"
                       Format="C0"
                       Variant="SgKPIVariant.Danger"
                       TrendPercent="-8.4"
                       ChartData="@_errorsData" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Inline"
                       Title="Avg. Cycle Time"
                       Value="7.2"
                       Suffix=" d"
                       Variant="SgKPIVariant.Info"
                       TrendPercent="-3.1"
                       InvertTrend="true"
                       ChartData="@_temperatureData" />
        </div>
    </div>

    @* ── 4. BAN MODE ──────────────────────────────────────────────────────── *@
    <div style="margin-top: 40px;">
        <h2>Ban — Big Ass Number</h2>
        <p>Заголовок сверху, огромное число, inline-бейдж тренда, строка delta-метрик снизу. Стиль Power BI.</p>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 16px;">

            <SgKPICard DisplayMode="SgKPIDisplayMode.Ban"
                       Title="Sales"
                       Value="230800000"
                       Format="C0"
                       Suffix="m"
                       ValueText="$230.8m"
                       TrendPercent="17.1"
                       TrendLabel="vs Prior Year"
                       Variant="SgKPIVariant.Default" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Ban"
                       Title="Quantity"
                       ValueText="19.9k"
                       TrendPercent="-1.6"
                       TrendLabel="vs Prior Year"
                       Variant="SgKPIVariant.Danger" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Ban"
                       Title="Profit"
                       ValueText="53.9m"
                       TrendPercent="23.9"
                       TrendLabel="vs Prior Year"
                       Variant="SgKPIVariant.Success" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Ban"
                       Title="Orders"
                       Value="1912"
                       TrendPercent="-0.5"
                       TrendLabel="Change vs Prior Year"
                       Variant="SgKPIVariant.Default"
                       Deltas="@(new List<SgKPIDelta> {
                           new() { Label = "vs PY (%)", Value = -0.5, IsPercent = true },
                           new() { Label = "vs PY (#)", Value = -10 }
                       })" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Ban"
                       Title="Выручка"
                       Value="124500"
                       Format="C0"
                       TrendPercent="12.5"
                       TrendLabel="vs прошлый месяц"
                       Variant="SgKPIVariant.Primary"
                       Deltas="@(new List<SgKPIDelta> {
                           new() { Label = "vs PY (%)", Value = 12.5, IsPercent = true },
                           new() { Label = "vs PY (#)", Value = 13800 }
                       })" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Ban"
                       Title="Конверсия"
                       Value="3.42"
                       Suffix="%"
                       TrendPercent="0.8"
                       TrendLabel="vs прошлый месяц"
                       Variant="SgKPIVariant.Info"
                       Deltas="@(new List<SgKPIDelta> {
                           new() { Label = "vs PY (%)", Value = 0.8, IsPercent = true },
                           new() { Label = "Абс.", Value = 0.03 }
                       })" />
        </div>
    </div>

    @* ── 5. ANALYTIC MODE ─────────────────────────────────────────────────── *@
    <div style="margin-top: 40px;">
        <h2>Analytic — Аналитические карточки</h2>
        <p>Иконка + заголовок, sparkline сверху, значение + delta-строка снизу. Стиль Tableau BAN.</p>
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 16px;">

            <SgKPICard DisplayMode="SgKPIDisplayMode.Analytic"
                       Title="Sales"
                       Icon="@SgIcons.TrendingUp"
                       IconColor="#f43f5e"
                       IconBackground="rgba(244,63,94,.15)"
                       PeriodLabel="Current month"
                       Value="6505"
                       Variant="SgKPIVariant.Danger"
                       ChartData="@_salesData"
                       ChartType="SgKPIChartType.Line"
                       ChartColor="#f43f5e"
                       Deltas="@(new List<SgKPIDelta> {
                           new() { Label = "vs PY (%)", Value = -37.9, IsPercent = true },
                           new() { Label = "vs PY (#)", Value = -3977 }
                       })" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Analytic"
                       Title="Sales"
                       Icon="@SgIcons.TrendingUp"
                       IconColor="#f43f5e"
                       IconBackground="rgba(244,63,94,.15)"
                       PeriodLabel="Current month"
                       Value="6955"
                       Variant="SgKPIVariant.Danger"
                       ChartData="@_ordersData"
                       ChartType="SgKPIChartType.Line"
                       ChartColor="#f43f5e"
                       Deltas="@(new List<SgKPIDelta> {
                           new() { Label = "vs PY (%)", Value = -23.8, IsPercent = true },
                           new() { Label = "vs PY (#)", Value = -2166 }
                       })" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Analytic"
                       Title="Sales"
                       Icon="@SgIcons.TrendingUp"
                       IconColor="#0ea5e9"
                       IconBackground="rgba(14,165,233,.15)"
                       PeriodLabel="Current month"
                       Value="5585"
                       Variant="SgKPIVariant.Info"
                       ChartData="@_conversionData"
                       ChartType="SgKPIChartType.Line"
                       ChartColor="#0ea5e9"
                       Deltas="@(new List<SgKPIDelta> {
                           new() { Label = "vs PY (%)", Value = 108.1, IsPercent = true },
                           new() { Label = "vs PY (#)", Value = 2901 }
                       })" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Analytic"
                       Title="Sales"
                       Icon="@SgIcons.TrendingUp"
                       IconColor="#f43f5e"
                       IconBackground="rgba(244,63,94,.15)"
                       PeriodLabel="Current month"
                       Value="12362"
                       Variant="SgKPIVariant.Danger"
                       ChartData="@_revenueData"
                       ChartType="SgKPIChartType.Line"
                       ChartColor="#f43f5e"
                       Deltas="@(new List<SgKPIDelta> {
                           new() { Label = "vs PY (%)", Value = -14.1, IsPercent = true },
                           new() { Label = "vs PY (#)", Value = -2029 }
                       })" />
        </div>
    </div>

    @* ── 6. LOADING STATE ─────────────────────────────────────────────────── *@
    <div style="margin-top: 40px;">
        <h2>Состояние загрузки</h2>
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 16px;">
            <SgKPICard IsLoading="true" DisplayMode="SgKPIDisplayMode.Card" Variant="SgKPIVariant.Primary" />
            <SgKPICard IsLoading="true" DisplayMode="SgKPIDisplayMode.Ban" />
            <SgKPICard IsLoading="true" DisplayMode="SgKPIDisplayMode.Analytic" />
            <SgKPICard IsLoading="true" Size="SgSize.Sm" />
        </div>
    </div>

</SgCard>

@code {
    private double[] _conversionData  = { 2.8, 3.1, 2.9, 3.3, 3.0, 3.5, 3.42 };
    private double[] _ordersData      = { 95, 110, 125, 105, 140, 130, 156 };
    private double[] _salesData       = { 75000, 82000, 78000, 85000, 88000, 87000, 89500 };
    private double[] _revenueData     = { 980000, 1050000, 1120000, 1180000, 1245000 };
    private double[] _temperatureData = { 22.1, 22.8, 23.2, 22.9, 23.5, 23.8, 23.5 };
    private double[] _trafficData     = { 38.5, 40.2, 42.1, 41.8, 43.5, 44.2, 45.2 };
    private double[] _errorsData      = { 22, 18, 15, 14, 10, 8, 12 };
}
