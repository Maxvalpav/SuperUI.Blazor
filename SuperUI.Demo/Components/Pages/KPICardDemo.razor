@page "/kpi-card-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@implements IDisposable
@inject IJSRuntime JS

<PageTitle>SgKPICard — KPI Cards — SuperUI</PageTitle>
<SgSeoHead Description="SgKPICard — Five display modes: Card, Ring, Inline, Ban, and Analytic. Built-in charts, trend badges, ring indicators, and delta metrics." />

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="KPI Cards" Subtitle="SgKPICard — Five display modes: Card, Ring, Inline, Ban, and Analytic. Built-in charts, trend badges, ring indicators, and delta metrics." Icon="@SgHeroicons.Outline.ChartBarSquare" GradientFrom="var(--sg-primary)" GradientTo="#8b5cf6" />
    </HeaderContent>
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Card Mode                                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Card — Gradient Card Tiles
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Colorful gradient backgrounds with full-bleed wave, area, line, or bar charts. White text overlays for high contrast.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Md">
            <SgCol Xs="12" Sm="6" Md="4">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Card"
                           Title="Revenue"
                           Subtitle="Current month"
                           Value="124500"
                           Format="C0"
                           Variant="SgKPIVariant.Primary"
                           TrendPercent="12.5"
                           TrendLabel="vs last month"
                           ChartData="@_salesData"
                           ChartType="SgKPIChartType.Area" />
            </SgCol>
            <SgCol Xs="12" Sm="6" Md="4">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Card"
                           Title="Conversion"
                           Value="3.42"
                           Suffix="%"
                           Variant="SgKPIVariant.Success"
                           TrendPercent="0.8"
                           ChartData="@_conversionData"
                           ChartType="SgKPIChartType.Line" />
            </SgCol>
            <SgCol Xs="12" Sm="6" Md="4">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Card"
                           Title="Orders"
                           Subtitle="Last 7 days"
                           Value="856"
                           Variant="SgKPIVariant.Warning"
                           TrendPercent="18.3"
                           ChartData="@_ordersData"
                           ChartType="SgKPIChartType.Bar" />
            </SgCol>
            <SgCol Xs="12" Sm="6" Md="4">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Card"
                           Title="Errors"
                           Value="12"
                           Variant="SgKPIVariant.Danger"
                           TrendPercent="-45.5"
                           InvertTrend="true"
                           TrendLabel="vs last hour"
                           ChartData="@_errorsData"
                           ChartType="SgKPIChartType.Bar" />
            </SgCol>
            <SgCol Xs="12" Sm="6" Md="4">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Card"
                           Title="Traffic"
                           Value="45.2"
                           Suffix="K"
                           Variant="SgKPIVariant.Info"
                           TrendPercent="15.8"
                           ChartData="@_trafficData"
                           ChartType="SgKPIChartType.Area" />
            </SgCol>
            <SgCol Xs="12" Sm="6" Md="4">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Card"
                           Title="Profit"
                           Subtitle="Quarterly"
                           Value="1245000"
                           Format="C0"
                           Variant="SgKPIVariant.Default"
                           TrendPercent="24.5"
                           ChartData="@_revenueData"
                           ChartType="SgKPIChartType.Line" />
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1b. Format Label & Extra Features                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                FormatLabel, Compact, Glass & Flip
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Custom value formatter via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">FormatLabel</SgTypography>, compact padding, glassmorphism, and hover-to-flip card.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Md">
            <SgCol Xs="12" Sm="6" Md="4">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Card"
                           Title="CPU Usage"
                           Subtitle="Real-time"
                           Value="@_cpuValue"
                           FormatLabel="@(v => $"{v:F1}%")"
                           Variant="SgKPIVariant.Warning"
                           TrendPercent="3.2"
                           TrendLabel="vs 5m ago"
                           Compact="true"
                           ChartData="@_cpuHistory"
                           ChartType="SgKPIChartType.Area"
                           ChartColor="#f59e0b" />
            </SgCol>
            <SgCol Xs="12" Sm="6" Md="4">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Card"
                           Title="Memory"
                           Value="14.2"
                           Suffix="GB"
                           Variant="SgKPIVariant.Info"
                           TrendPercent="-2.1"
                           Glass="true"
                           ChartData="@_memoryHistory"
                           ChartType="SgKPIChartType.Area" />
            </SgCol>
            <SgCol Xs="12" Sm="6" Md="4">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Card"
                           Title="Uptime"
                           Value="99.97"
                           Suffix="%"
                           Variant="SgKPIVariant.Success"
                           TrendPercent="0.01"
                           Flipable="true"
                           BackContent="@(new RenderFragment(b => b.AddMarkupContent(0, $@"
                               <div style='padding:8px;font-size:12px;color:var(--sg-text-muted);'>
                                   <strong style='color:#fff;'>Details</strong><br/>
                                   Last restart: 14 days ago<br/>
                                   Incidents: 0<br/>
                                   SLA: 99.97%
                               </div>")))" />
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Ring Mode                                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Ring — Circular SVG Indicators
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                SVG ring with value inside. Fill ratio = Value / Target. Available in Sm, Md, and Lg sizes.
            </SgTypography>
        </div>

        <SgSpace Space="SgSize.Lg" Align="SgAlignItems.Center" Wrap="true">
            <SgKPICard DisplayMode="SgKPIDisplayMode.Ring"
                       Title="Suppliers"
                       Value="804"
                       Variant="SgKPIVariant.Default"
                       Size="SgSize.Lg" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Ring"
                       Title="Contracted"
                       Value="61"
                       Suffix="%"
                       Target="100"
                       Variant="SgKPIVariant.Success"
                       Size="SgSize.Lg" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Ring"
                       Title="Unlisted"
                       Value="39"
                       Suffix="%"
                       Target="100"
                       Variant="SgKPIVariant.Danger"
                       Size="SgSize.Lg" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Ring"
                       Title="Completed"
                       Value="78"
                       Target="100"
                       Variant="SgKPIVariant.Primary"
                       Size="SgSize.Md" />

            <SgKPICard DisplayMode="SgKPIDisplayMode.Ring"
                       Title="NPS"
                       Value="4.8"
                       Target="5"
                       Variant="SgKPIVariant.Warning"
                       Size="SgSize.Sm" />
        </SgSpace>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Inline Mode                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Inline — Compact Metric Rows
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Horizontal row: label — value — dotted sparkline — trend badge. Ideal for dense tables and sidebars.
            </SgTypography>
        </div>

        <div style="max-width:700px;">
            <SgStack Vertical Space="SgSize.Sm">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Inline"
                           Title="Total Spending"
                           Value="2113507"
                           Format="C0"
                           Variant="SgKPIVariant.Default"
                           TrendPercent="5.2"
                           ChartData="@_salesData" />

                <SgKPICard DisplayMode="SgKPIDisplayMode.Inline"
                           Title="Savings"
                           Value="96788"
                           Format="C0"
                           Variant="SgKPIVariant.Success"
                           TrendPercent="12.1"
                           ChartData="@_conversionData" />

                <SgKPICard DisplayMode="SgKPIDisplayMode.Inline"
                           Title="Foregone Savings"
                           Value="52536"
                           Format="C0"
                           Variant="SgKPIVariant.Danger"
                           TrendPercent="-8.4"
                           ChartData="@_errorsData" />

                <SgKPICard DisplayMode="SgKPIDisplayMode.Inline"
                           Title="Avg. Cycle Time"
                           Value="7.2"
                           Suffix=" d"
                           Variant="SgKPIVariant.Info"
                           TrendPercent="-3.1"
                           InvertTrend="true"
                           ChartData="@_temperatureData" />
            </SgStack>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Ban Mode                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Ban — Big Ass Number
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Title top-left, huge centered value, inline trend badge, and optional delta metrics row. Power BI BAN style.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Md">
            <SgCol Xs="12" Md="4">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Ban"
                           Title="Sales"
                           Value="230800000"
                           Format="C0"
                           ValueText="$230.8m"
                           TrendPercent="17.1"
                           TrendLabel="vs Prior Year"
                           Variant="SgKPIVariant.Default" />
            </SgCol>
            <SgCol Xs="12" Md="4">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Ban"
                           Title="Quantity"
                           ValueText="19.9k"
                           TrendPercent="-1.6"
                           TrendLabel="vs Prior Year"
                           Variant="SgKPIVariant.Danger" />
            </SgCol>
            <SgCol Xs="12" Md="4">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Ban"
                           Title="Profit"
                           ValueText="53.9m"
                           TrendPercent="23.9"
                           TrendLabel="vs Prior Year"
                           Variant="SgKPIVariant.Success" />
            </SgCol>
            <SgCol Xs="12" Md="4">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Ban"
                           Title="Orders"
                           Value="1912"
                           TrendPercent="-0.5"
                           TrendLabel="Change vs Prior Year"
                           Variant="SgKPIVariant.Default"
                           Deltas="@(new List<SgKPIDelta> {
                               new() { Label = "vs PY (%)", Value = -0.5, IsPercent = true },
                               new() { Label = "vs PY (#)", Value = -10 }
                           })" />
            </SgCol>
            <SgCol Xs="12" Md="4">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Ban"
                           Title="Revenue"
                           Value="124500"
                           Format="C0"
                           TrendPercent="12.5"
                           TrendLabel="vs last month"
                           Variant="SgKPIVariant.Primary"
                           Deltas="@(new List<SgKPIDelta> {
                               new() { Label = "vs PY (%)", Value = 12.5, IsPercent = true },
                               new() { Label = "vs PY (#)", Value = 13800 }
                           })" />
            </SgCol>
            <SgCol Xs="12" Md="4">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Ban"
                           Title="Conversion"
                           Value="3.42"
                           Suffix="%"
                           TrendPercent="0.8"
                           TrendLabel="vs last month"
                           Variant="SgKPIVariant.Info"
                           Deltas="@(new List<SgKPIDelta> {
                               new() { Label = "vs PY (%)", Value = 0.8, IsPercent = true },
                               new() { Label = "Abs.", Value = 0.03 }
                           })" />
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Analytic Mode                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Analytic — Icon + Sparkline Cards
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Icon header, sparkline chart area, period label, value with multiple comparison deltas. Tableau BAN template style.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Md">
            <SgCol Xs="12" Sm="6" Lg="3">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Analytic"
                           Title="Sales"
                           Icon="@SgHeroicons.Outline.ArrowTrendingUp"
                           IconColor="#f43f5e"
                           IconBackground="rgba(244,63,94,.15)"
                           PeriodLabel="Current month"
                           Value="6505"
                           Variant="SgKPIVariant.Danger"
                           ChartData="@_salesData"
                           ChartType="SgKPIChartType.Line"
                           ChartColor="#f43f5e"
                           Deltas="@(new List<SgKPIDelta> {
                               new() { Label = "vs PY (%)", Value = -37.9, IsPercent = true },
                               new() { Label = "vs PY (#)", Value = -3977 }
                           })" />
            </SgCol>
            <SgCol Xs="12" Sm="6" Lg="3">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Analytic"
                           Title="Visitors"
                           Icon="@SgHeroicons.Outline.Users"
                           IconColor="#8b5cf6"
                           IconBackground="rgba(139,92,246,.15)"
                           PeriodLabel="Current month"
                           Value="12850"
                           Variant="SgKPIVariant.Warning"
                           ChartData="@_trafficData"
                           ChartType="SgKPIChartType.Line"
                           ChartColor="#8b5cf6"
                           Deltas="@(new List<SgKPIDelta> {
                               new() { Label = "vs PY (%)", Value = 15.2, IsPercent = true },
                               new() { Label = "vs PY (#)", Value = 1690 }
                           })" />
            </SgCol>
            <SgCol Xs="12" Sm="6" Lg="3">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Analytic"
                           Title="Orders"
                           Icon="@SgHeroicons.Outline.ShoppingCart"
                           IconColor="#0ea5e9"
                           IconBackground="rgba(14,165,233,.15)"
                           PeriodLabel="Current month"
                           Value="5585"
                           Variant="SgKPIVariant.Info"
                           ChartData="@_conversionData"
                           ChartType="SgKPIChartType.Line"
                           ChartColor="#0ea5e9"
                           Deltas="@(new List<SgKPIDelta> {
                               new() { Label = "vs PY (%)", Value = 108.1, IsPercent = true },
                               new() { Label = "vs PY (#)", Value = 2901 }
                           })" />
            </SgCol>
            <SgCol Xs="12" Sm="6" Lg="3">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Analytic"
                           Title="Revenue"
                           Icon="@SgHeroicons.Outline.CurrencyDollar"
                           IconColor="#10b981"
                           IconBackground="rgba(16,185,129,.15)"
                           PeriodLabel="Current month"
                           Value="12362"
                           Variant="SgKPIVariant.Success"
                           ChartData="@_revenueData"
                           ChartType="SgKPIChartType.Line"
                           ChartColor="#10b981"
                           Deltas="@(new List<SgKPIDelta> {
                               new() { Label = "vs PY (%)", Value = 14.1, IsPercent = true },
                               new() { Label = "vs PY (#)", Value = 1529 }
                           })" />
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. Dashboard Demo — Realistic KPI Grid                             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Dashboard — Animated KPI Grid
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                A realistic dashboard section with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">MountAnimation</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">CornerBadge</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ProgressBar</SgTypography>, and custom trend icons. Cards fade in staggered.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Md">
            <SgCol Xs="12" Sm="6" Xl="3">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Card"
                           Title="Total Revenue"
                           Subtitle="vs forecast"
                           Value="2845000"
                           Format="C0"
                           Variant="SgKPIVariant.Primary"
                           TrendPercent="18.7"
                           TrendLabel="vs last year"
                           CornerBadge="Hot"
                           ProgressBar="true"
                           ProgressBarMax="3000000"
                           MountAnimation="true"
                           ChartData="@_salesData"
                           ChartType="SgKPIChartType.Area" />
            </SgCol>
            <SgCol Xs="12" Sm="6" Xl="3">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Card"
                           Title="Active Users"
                           Value="12850"
                           Variant="SgKPIVariant.Success"
                           TrendPercent="32.4"
                           TrendLabel="vs last month"
                           CornerBadge="New"
                           CornerBadgeVariant="SgKPIVariant.Success"
                           ProgressBar="true"
                           ProgressBarMax="20000"
                           ProgressBarColor="#10b981"
                           MountAnimation="true"
                           ChartData="@_trafficData"
                           ChartType="SgKPIChartType.Area" />
            </SgCol>
            <SgCol Xs="12" Sm="6" Xl="3">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Card"
                           Title="Conversion Rate"
                           Value="3.42"
                           Suffix="%"
                           Variant="SgKPIVariant.Info"
                           TrendPercent="0.8"
                           CornerBadge="Stable"
                           CornerBadgeVariant="SgKPIVariant.Info"
                           ProgressBar="true"
                           ProgressBarMax="5"
                           ProgressBarColor="#0ea5e9"
                           MountAnimation="true"
                           ChartData="@_conversionData"
                           ChartType="SgKPIChartType.Line" />
            </SgCol>
            <SgCol Xs="12" Sm="6" Xl="3">
                <SgKPICard DisplayMode="SgKPIDisplayMode.Card"
                           Title="Error Rate"
                           Value="0.42"
                           Suffix="%"
                           Variant="SgKPIVariant.Danger"
                           TrendPercent="-12.5"
                           InvertTrend="true"
                           TrendUpIcon="@_customTrendDownIcon"
                           TrendDownIcon="@_customTrendUpIcon"
                           CornerBadge="-45%"
                           CornerBadgeVariant="SgKPIVariant.Danger"
                           ProgressBar="true"
                           ProgressBarMax="2"
                           ProgressBarColor="#ef4444"
                           MountAnimation="true"
                           ChartData="@_errorsData"
                           ChartType="SgKPIChartType.Bar" />
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 7. Loading State                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Loading State
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Skeleton placeholders for each display mode. Set <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">IsLoading="true"</SgTypography> to show.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Md">
            <SgCol Xs="12" Sm="6" Md="3">
                <SgKPICard IsLoading="true" DisplayMode="SgKPIDisplayMode.Card" Variant="SgKPIVariant.Primary" />
            </SgCol>
            <SgCol Xs="12" Sm="6" Md="3">
                <SgKPICard IsLoading="true" DisplayMode="SgKPIDisplayMode.Ring" Size="SgSize.Lg" />
            </SgCol>
            <SgCol Xs="12" Sm="6" Md="3">
                <SgKPICard IsLoading="true" DisplayMode="SgKPIDisplayMode.Ban" />
            </SgCol>
            <SgCol Xs="12" Sm="6" Md="3">
                <SgKPICard IsLoading="true" DisplayMode="SgKPIDisplayMode.Analytic" />
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 7. Live Constructor                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live SgKPICard Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure every parameter interactively. Toggle features and copy the generated code.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Mode / Size / Variant row -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Display Mode</SgTypography>
                                    <SgSegmented TValue="SgKPIDisplayMode"
                                                 Value="_liveMode"
                                                 ValueChanged="v => { _liveMode = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_displayModeOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgSegmented TValue="SgSize"
                                                 Value="_liveSize"
                                                 ValueChanged="v => { _liveSize = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_sizeOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Variant</SgTypography>
                            <SgSegmented TValue="SgKPIVariant"
                                         Value="_liveVariant"
                                         ValueChanged="v => { _liveVariant = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_variantOptions" />
                        </SgStack>

                        <!-- Chart Type -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Chart Type</SgTypography>
                            <SgSegmented TValue="SgKPIChartType"
                                         Value="_liveChartType"
                                         ValueChanged="v => { _liveChartType = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_chartTypeOptions" />
                        </SgStack>

                        <!-- Value Slider -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">
                                Value: <SgBadge Variant="SgBadgeVariant.Info" Text="@_liveValue.ToString("N0")" Standalone="true" Size="SgSize.Sm" />
                            </SgTypography>
                            <input type="range" min="0" max="500000" step="1000"
                                   value="@_liveValue"
                                   @oninput="OnLiveValueChanged"
                                   style="width:100%;accent-color:var(--sg-primary);" />
                        </SgStack>

                        <!-- Toggles row 1 -->
                        <SgDivider Text="Toggles" />
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgSwitch Value="_liveShowTrend"
                                          ValueChanged="v => { _liveShowTrend = v; UpdateConstructorCode(); }"
                                          Label="Show Trend" Size="SgSize.Sm" />
                            </SgCol>
                            <SgCol Span="6">
                                <SgSwitch Value="_liveIsLoading"
                                          ValueChanged="v => { _liveIsLoading = v; UpdateConstructorCode(); }"
                                          Label="Is Loading" Size="SgSize.Sm" />
                            </SgCol>
                        </SgRow>
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgSwitch Value="_liveClickable"
                                          ValueChanged="v => { _liveClickable = v; UpdateConstructorCode(); }"
                                          Label="Clickable" Size="SgSize.Sm" />
                            </SgCol>
                            <SgCol Span="6">
                                <SgSwitch Value="_liveInvertTrend"
                                          ValueChanged="v => { _liveInvertTrend = v; UpdateConstructorCode(); }"
                                          Label="Invert Trend" Size="SgSize.Sm" />
                            </SgCol>
                        </SgRow>
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgSwitch Value="_liveAnimatedValue"
                                          ValueChanged="v => { _liveAnimatedValue = v; UpdateConstructorCode(); }"
                                          Label="Animated Value" Size="SgSize.Sm" />
                            </SgCol>
                            <SgCol Span="6">
                                <SgSwitch Value="_liveCompact"
                                          ValueChanged="v => { _liveCompact = v; UpdateConstructorCode(); }"
                                          Label="Compact" Size="SgSize.Sm" />
                            </SgCol>
                        </SgRow>
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgSwitch Value="_liveGlass"
                                          ValueChanged="v => { _liveGlass = v; UpdateConstructorCode(); }"
                                          Label="Glass" Size="SgSize.Sm" />
                            </SgCol>
                            <SgCol Span="6">
                                <SgSwitch Value="_liveFlipable"
                                          ValueChanged="v => { _liveFlipable = v; UpdateConstructorCode(); }"
                                          Label="Flipable" Size="SgSize.Sm" />
                            </SgCol>
                        </SgRow>
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgSwitch Value="_liveProgressBar"
                                          ValueChanged="v => { _liveProgressBar = v; UpdateConstructorCode(); }"
                                          Label="Progress Bar" Size="SgSize.Sm" />
                            </SgCol>
                            <SgCol Span="6">
                                <SgSwitch Value="_liveMountAnimation"
                                          ValueChanged="v => { _liveMountAnimation = v; UpdateConstructorCode(); }"
                                          Label="Mount Animation" Size="SgSize.Sm" />
                            </SgCol>
                        </SgRow>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Preview</SgTypography>
                            <div class="constructor-preview" id="constructor-preview">
                                @if (_liveMode == SgKPIDisplayMode.Inline)
                                {
                                    <SgKPICard DisplayMode="@_liveMode"
                                               Title="Live Preview"
                                               Value="@_liveValue"
                                               Format="C0"
                                               Variant="@_liveVariant"
                                               Size="@_liveSize"
                                               ShowTrend="@_liveShowTrend"
                                               IsLoading="@_liveIsLoading"
                                               Clickable="@_liveClickable"
                                               InvertTrend="@_liveInvertTrend"
                                               AnimatedValue="@_liveAnimatedValue"
                                               Compact="@_liveCompact"
                                               Glass="@_liveGlass"
                                               Flipable="@_liveFlipable"
                                               ProgressBar="@_liveProgressBar"
                                               MountAnimation="@_liveMountAnimation"
                                               TrendPercent="12.5"
                                               ChartData="@_salesData"
                                               ChartType="@_liveChartType" />
                                }
                                else if (_liveMode == SgKPIDisplayMode.Ring)
                                {
                                    <div style="display:flex;justify-content:center;padding:16px 0;">
                                        <SgKPICard DisplayMode="@_liveMode"
                                                   Title="Live Preview"
                                                   Value="78"
                                                   Target="100"
                                                   Suffix="%"
                                                   Variant="@_liveVariant"
                                                   Size="@_liveSize"
                                                   ShowTrend="@_liveShowTrend"
                                                   IsLoading="@_liveIsLoading"
                                                   Clickable="@_liveClickable"
                                                   InvertTrend="@_liveInvertTrend"
                                                   AnimatedValue="@_liveAnimatedValue"
                                                   Compact="@_liveCompact"
                                                   Glass="@_liveGlass"
                                                   Flipable="@_liveFlipable"
                                                   ProgressBar="@_liveProgressBar"
                                                   MountAnimation="@_liveMountAnimation" />
                                    </div>
                                }
                                else if (_liveMode == SgKPIDisplayMode.Analytic)
                                {
                                    <SgKPICard DisplayMode="@_liveMode"
                                               Title="Live Preview"
                                               Value="@_liveValue"
                                               Format="C0"
                                               Icon="@SgHeroicons.Outline.ArrowTrendingUp"
                                               IconColor="var(--sg-primary)"
                                               IconBackground="rgba(0,111,238,.12)"
                                               PeriodLabel="Current month"
                                               Variant="@_liveVariant"
                                               Size="@_liveSize"
                                               ShowTrend="@_liveShowTrend"
                                               IsLoading="@_liveIsLoading"
                                               Clickable="@_liveClickable"
                                               InvertTrend="@_liveInvertTrend"
                                               AnimatedValue="@_liveAnimatedValue"
                                               Compact="@_liveCompact"
                                               Glass="@_liveGlass"
                                               Flipable="@_liveFlipable"
                                               ProgressBar="@_liveProgressBar"
                                               MountAnimation="@_liveMountAnimation"
                                               TrendPercent="12.5"
                                               ChartData="@_salesData"
                                               ChartType="@_liveChartType" />
                                }
                                else
                                {
                                    <SgKPICard DisplayMode="@_liveMode"
                                               Title="Live Preview"
                                               Value="@_liveValue"
                                               Format="C0"
                                               Variant="@_liveVariant"
                                               Size="@_liveSize"
                                               ShowTrend="@_liveShowTrend"
                                               IsLoading="@_liveIsLoading"
                                               Clickable="@_liveClickable"
                                               InvertTrend="@_liveInvertTrend"
                                               AnimatedValue="@_liveAnimatedValue"
                                               Compact="@_liveCompact"
                                               Glass="@_liveGlass"
                                               Flipable="@_liveFlipable"
                                               ProgressBar="@_liveProgressBar"
                                               MountAnimation="@_liveMountAnimation"
                                               TrendPercent="12.5"
                                               TrendLabel="vs last month"
                                               ChartData="@_salesData"
                                               ChartType="@_liveChartType" />
                                }
                            </div>
                        </SgStack>

                        <!-- Code with Copy -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                    <span id="copy-icon">@_copyIcon</span>
                                    <span id="copy-text" style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                </button>
                            </div>
                            <div class="code-block" id="code-block">
                                @foreach (var line in _generatedCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>

        <!-- Property Table -->
        <SgCard Title="SgKPICard Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm" Style="margin-top:20px;">
            <PropertyTable Items="_properties" />
        </SgCard>
    </div>

</ChildContent>
</SgCard>

<style>
    /* ── Section layout ─────────────────────────────────────────────────────── */
    .demo-section {
        margin-top: 48px;
    }
    .demo-section-header {
        margin-bottom: 20px;
    }

    /* ── Constructor ────────────────────────────────────────────────────────── */
    .constructor-preview {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 16px;
        min-height: 100px;
        transition: all 0.3s ease;
    }
    .ctrl-summary {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 12px 14px;
    }
    .code-block {
        background: #0f172a;
        color: #7dd3fc;
        padding: 14px 16px;
        border-radius: 8px;
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 12px;
        line-height: 1.9;
        overflow-x: auto;
        position: relative;
    }
    .code-block code {
        background: none;
        padding: 0;
        color: inherit;
        font-size: inherit;
        display: block;
        white-space: pre;
    }

    /* ── Copy button ────────────────────────────────────────────────────────── */
    .demo-copy-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 6px;
        padding: 4px 10px;
        cursor: pointer;
        color: var(--sg-text-muted);
        transition: all 0.2s ease;
        font-family: inherit;
    }
    .demo-copy-btn:hover {
        color: var(--sg-primary);
        border-color: var(--sg-primary);
        background: color-mix(in srgb, var(--sg-primary) 8%, transparent);
    }
    .demo-copy-btn:active {
        transform: scale(0.95);
    }
    .demo-copy-btn.copied {
        color: var(--sg-color-success);
        border-color: var(--sg-color-success);
    }
</style>

@code {
    // ── Main card header ─────────────────────────────────────────────────
    // ── Chart data ───────────────────────────────────────────────────────
    private double[] _conversionData   = { 2.8, 3.1, 2.9, 3.3, 3.0, 3.5, 3.42 };
    private double[] _ordersData       = { 95, 110, 125, 105, 140, 130, 156 };
    private double[] _salesData        = { 75000, 82000, 78000, 85000, 88000, 87000, 89500 };
    private double[] _revenueData      = { 980000, 1050000, 1120000, 1180000, 1245000 };
    private double[] _temperatureData  = { 22.1, 22.8, 23.2, 22.9, 23.5, 23.8, 23.5 };
    private double[] _trafficData      = { 38.5, 40.2, 42.1, 41.8, 43.5, 44.2, 45.2 };
    private double[] _errorsData       = { 22, 18, 15, 14, 10, 8, 12 };
    private double[] _cpuHistory       = { 45, 52, 48, 55, 62, 58, 51, 47, 53, 59, 63, 58 };
    private double[] _memoryHistory    = { 10.2, 11.5, 12.1, 11.8, 13.2, 14.0, 14.2 };

    private Timer? _liveTimer;
    private double _cpuValue = 54.7;

    // ── Custom trend icons (inverted for "good" down-trend) ─────────────
    private string _customTrendUpIcon = """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>""";
    private string _customTrendDownIcon = """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 15 12 9 18 15"/></svg>""";

    // ── Live constructor state ───────────────────────────────────────────
    private SgKPIDisplayMode _liveMode = SgKPIDisplayMode.Card;
    private SgSize _liveSize = SgSize.Md;
    private SgKPIVariant _liveVariant = SgKPIVariant.Primary;
    private SgKPIChartType _liveChartType = SgKPIChartType.Area;
    private double _liveValue = 128450;
    private bool _liveShowTrend = true;
    private bool _liveIsLoading;
    private bool _liveClickable;
    private bool _liveInvertTrend;
    private bool _liveAnimatedValue;
    private bool _liveCompact;
    private bool _liveGlass;
    private bool _liveFlipable;
    private bool _liveProgressBar;
    private bool _liveMountAnimation;

    // ── Code generation ───────────────────────────────────────────────────
    private string[] _generatedCodeLines = Array.Empty<string>();
    private string _copyIcon = "📋";
    private string _copyLabel = "Copy";

    // ── SgSegmented options ──────────────────────────────────────────────
    private readonly List<SgSegmentedOption<SgKPIDisplayMode>> _displayModeOptions = new()
    {
        new() { Value = SgKPIDisplayMode.Card,     Label = "Card" },
        new() { Value = SgKPIDisplayMode.Ring,     Label = "Ring" },
        new() { Value = SgKPIDisplayMode.Inline,   Label = "Inline" },
        new() { Value = SgKPIDisplayMode.Ban,      Label = "Ban" },
        new() { Value = SgKPIDisplayMode.Analytic, Label = "Analytic" },
    };

    private readonly List<SgSegmentedOption<SgSize>> _sizeOptions = new()
    {
        new() { Value = SgSize.Sm, Label = "Sm" },
        new() { Value = SgSize.Md, Label = "Md" },
        new() { Value = SgSize.Lg, Label = "Lg" },
    };

    private readonly List<SgSegmentedOption<SgKPIVariant>> _variantOptions = new()
    {
        new() { Value = SgKPIVariant.Default, Label = "Default" },
        new() { Value = SgKPIVariant.Primary, Label = "Primary" },
        new() { Value = SgKPIVariant.Success, Label = "Success" },
        new() { Value = SgKPIVariant.Warning, Label = "Warning" },
        new() { Value = SgKPIVariant.Danger,  Label = "Danger" },
        new() { Value = SgKPIVariant.Info,    Label = "Info" },
    };

    private readonly List<SgSegmentedOption<SgKPIChartType>> _chartTypeOptions = new()
    {
        new() { Value = SgKPIChartType.Area,      Label = "Area" },
        new() { Value = SgKPIChartType.Line,      Label = "Line" },
        new() { Value = SgKPIChartType.Bar,       Label = "Bar" },
        new() { Value = SgKPIChartType.Step,      Label = "Step" },
        new() { Value = SgKPIChartType.Candle,    Label = "Candle" },
    };

    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        UpdateConstructorCode();

        _liveTimer = new Timer(_ =>
        {
            _ = InvokeAsync(() =>
            {
                _cpuValue = Math.Round(45 + Random.Shared.NextDouble() * 30, 1);
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    public void Dispose()
    {
        _liveTimer?.Dispose();
    }

    private void OnLiveValueChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var val))
        {
            _liveValue = val;
            UpdateConstructorCode();
        }
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add($"<SgKPICard DisplayMode=\"SgKPIDisplayMode.{_liveMode}\"");
        lines.Add($"           Title=\"Live Preview\"");
        lines.Add($"           Value=\"{_liveValue}\"");
        if (_liveMode is not SgKPIDisplayMode.Ring && _liveMode is not SgKPIDisplayMode.Ban)
            lines.Add($"           Format=\"C0\"");
        lines.Add($"           Variant=\"SgKPIVariant.{_liveVariant}\"");
        lines.Add($"           Size=\"SgSize.{_liveSize}\"");
        if (_liveChartType != SgKPIChartType.Area && _liveMode is not SgKPIDisplayMode.Ring)
            lines.Add($"           ChartType=\"SgKPIChartType.{_liveChartType}\"");
        if (_liveShowTrend)       lines.Add($"           ShowTrend=\"true\"");
        if (_liveIsLoading)       lines.Add($"           IsLoading=\"true\"");
        if (_liveClickable)       lines.Add($"           Clickable=\"true\"");
        if (_liveInvertTrend)     lines.Add($"           InvertTrend=\"true\"");
        if (_liveAnimatedValue)   lines.Add($"           AnimatedValue=\"true\"");
        if (_liveCompact)         lines.Add($"           Compact=\"true\"");
        if (_liveGlass)           lines.Add($"           Glass=\"true\"");
        if (_liveFlipable)        lines.Add($"           Flipable=\"true\"");
        if (_liveProgressBar)     lines.Add($"           ProgressBar=\"true\"");
        if (_liveMountAnimation)  lines.Add($"           MountAnimation=\"true\"");
        lines.Add($"           TrendPercent=\"12.5\" />");
        _generatedCodeLines = lines.ToArray();
        StateHasChanged();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

    // ── Property table items ─────────────────────────────────────────────
    private List<PropertyPanelItem> _properties = new()
    {
        new() { Label = "DisplayMode",   Value = "SgKPIDisplayMode",       BadgeText = "Card|Ring|Inline|Ban|Analytic", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Variant",       Value = "SgKPIVariant",           BadgeText = "Color scheme",                   BadgeVariant = SgBadgeVariant.Info },
