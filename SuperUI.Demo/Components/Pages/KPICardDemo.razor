@page "/kpi-card-demo"
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>KPI Card - SUI</PageTitle>

<SgCard Title="KPI Card — Карточки ключевых показателей"
        Subtitle="Современные компоненты для отображения метрик, трендов и графиков с поддержкой различных вариантов и размеров.">

    <!-- Basic KPI Cards -->
    <div style="margin-top: 32px;">
        <h2>SgKPICard — Основные варианты</h2>
        <p>Универсальная карточка для отображения ключевых показателей эффективности с трендами и мини-графиками.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Простые карточки</div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                            <SgKPICard Title="Выручка"
                                      Subtitle="За текущий месяц"
                                      Value="124500"
                                      Format="C0"
                                      Icon="@SgIcons.TrendingUp"
                                      IconColor="#10b981"
                                      IconBackground="rgba(16, 185, 129, 0.1)"
                                      TrendPercent="12.5"
                                      TrendLabel="vs прошлый месяц" />
                            
                            <SgKPICard Title="Пользователи"
                                      Subtitle="Активные за сутки"
                                      Value="1240"
                                      Icon="@SgIcons.MessageSquare"
                                      IconColor="#0ea5e9"
                                      IconBackground="rgba(14, 165, 233, 0.1)"
                                      TrendPercent="-3.2"
                                      TrendLabel="vs вчера" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">С графиками</div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                            <SgKPICard Title="Конверсия"
                                      Subtitle="Средний показатель"
                                      Value="3.42"
                                      Suffix="%"
                                      Icon="@SgIcons.TrendingUp"
                                      IconColor="#f59e0b"
                                      IconBackground="rgba(245, 158, 11, 0.1)"
                                      TrendPercent="0.8"
                                      ChartData="@_conversionData"
                                      ChartType="SgKPIChartType.Area" />
                            
                            <SgKPICard Title="Заказы"
                                      Subtitle="За последние 7 дней"
                                      Value="856"
                                      Icon="@SgIcons.BarChart"
                                      IconColor="#8b5cf6"
                                      IconBackground="rgba(139, 92, 246, 0.1)"
                                      TrendPercent="18.3"
                                      ChartData="@_ordersData"
                                      ChartType="SgKPIChartType.Bar" />
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_basicProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Sizes -->
    <div style="margin-top: 32px;">
        <h2>Размеры</h2>
        <p>Четыре размера для различных сценариев использования.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Small (Sm)</div>
                        <SgKPICard Title="Посетители"
                                  Value="2450"
                                  Size="SgSize.Sm"
                                  Icon="@SgIcons.Search"
                                  IconColor="#06b6d4"
                                  IconBackground="rgba(6, 182, 212, 0.1)"
                                  TrendPercent="5.2" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Medium (Md) — по умолчанию</div>
                        <SgKPICard Title="Продажи"
                                  Value="89500"
                                  Format="C0"
                                  Size="SgSize.Md"
                                  Icon="@SgIcons.TrendingUp"
                                  IconColor="#10b981"
                                  IconBackground="rgba(16, 185, 129, 0.1)"
                                  TrendPercent="12.8"
                                  ChartData="@_salesData"
                                  ChartType="SgKPIChartType.Area" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Large (Lg)</div>
                        <SgKPICard Title="Доход"
                                  Subtitle="Общий за квартал"
                                  Value="1245000"
                                  Format="C0"
                                  Size="SgSize.Lg"
                                  Icon="@SgIcons.TrendingUp"
                                  IconColor="#8b5cf6"
                                  IconBackground="rgba(139, 92, 246, 0.1)"
                                  TrendPercent="24.5"
                                  TrendLabel="vs прошлый квартал"
                                  ChartData="@_revenueData"
                                  ChartType="SgKPIChartType.Line" />
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства Size">
                <PropertyTable Items="_sizeProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Variants -->
    <div style="margin-top: 32px;">
        <h2>Цветовые варианты</h2>
        <p>Шесть встроенных цветовых схем для различных типов метрик.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <SgKPICard Title="Default"
                              Value="1234"
                              Variant="SgKPIVariant.Default"
                              Icon="@SgIcons.BarChart"
                              TrendPercent="5.2" />
                    
                    <SgKPICard Title="Primary"
                              Value="5678"
                              Variant="SgKPIVariant.Primary"
                              Icon="@SgIcons.TrendingUp"
                              TrendPercent="8.4" />
                    
                    <SgKPICard Title="Success"
                              Value="9012"
                              Variant="SgKPIVariant.Success"
                              Icon="@SgIcons.Check"
                              TrendPercent="12.1" />
                    
                    <SgKPICard Title="Warning"
                              Value="3456"
                              Variant="SgKPIVariant.Warning"
                              Icon="@SgIcons.Clock"
                              TrendPercent="-2.3" />
                    
                    <SgKPICard Title="Danger"
                              Value="789"
                              Variant="SgKPIVariant.Danger"
                              Icon="@SgIcons.X"
                              TrendPercent="-8.7" />
                    
                    <SgKPICard Title="Info"
                              Value="2345"
                              Variant="SgKPIVariant.Info"
                              Icon="@SgIcons.MessageSquare"
                              TrendPercent="3.9" />
                </div>
            </SgCard>
            <SgCard Title="Свойства Variant">
                <PropertyTable Items="_variantProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Chart Types -->
    <div style="margin-top: 32px;">
        <h2>Типы графиков</h2>
        <p>Три типа мини-графиков для визуализации трендов.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Line Chart</div>
                        <SgKPICard Title="Температура"
                                  Value="23.5"
                                  Suffix="°C"
                                  Icon="@SgIcons.Flame"
                                  IconColor="#0ea5e9"
                                  IconBackground="rgba(14, 165, 233, 0.1)"
                                  TrendPercent="1.2"
                                  ChartData="@_temperatureData"
                                  ChartType="SgKPIChartType.Line"
                                  ChartColor="#0ea5e9" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Area Chart</div>
                        <SgKPICard Title="Трафик"
                                  Value="45.2"
                                  Suffix="K"
                                  Icon="@SgIcons.TrendingUp"
                                  IconColor="#10b981"
                                  IconBackground="rgba(16, 185, 129, 0.1)"
                                  TrendPercent="15.8"
                                  ChartData="@_trafficData"
                                  ChartType="SgKPIChartType.Area"
                                  ChartColor="#10b981" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Bar Chart</div>
                        <SgKPICard Title="Продажи по дням"
                                  Value="128"
                                  Icon="@SgIcons.BarChart"
                                  IconColor="#f59e0b"
                                  IconBackground="rgba(245, 158, 11, 0.1)"
                                  TrendPercent="8.3"
                                  ChartData="@_dailySalesData"
                                  ChartType="SgKPIChartType.Bar"
                                  ChartColor="#f59e0b" />
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства Chart">
                <PropertyTable Items="_chartProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Advanced Features -->
    <div style="margin-top: 32px;">
        <h2>Дополнительные возможности</h2>
        <p>Кастомизация, действия, футеры и интерактивность.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">С действием в заголовке</div>
                        <SgKPICard Title="Хранилище"
                                  Subtitle="Использовано"
                                  Value="1024"
                                  Suffix="GB"
                                  Icon="@SgIcons.Database"
                                  IconColor="#8b5cf6"
                                  IconBackground="rgba(139, 92, 246, 0.1)"
                                  TrendPercent="5.2">
                            <ActionContent>
                                <SgIconButton Icon="@SgIcons.Refresh" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" />
                            </ActionContent>
                        </SgKPICard>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">С кастомным футером</div>
                        <SgKPICard Title="Рейтинг"
                                  Value="4.8"
                                  Suffix="/5.0"
                                  Icon="@SgIcons.TrendingUp"
                                  IconColor="#f59e0b"
                                  IconBackground="rgba(245, 158, 11, 0.1)"
                                  TrendPercent="0.3"
                                  ChartData="@_ratingData"
                                  ChartType="SgKPIChartType.Area">
                            <FooterContent>
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <span>На основе 1,234 отзывов</span>
                                    <SgBadge Text="Отлично" Variant="SgBadgeVariant.Success" />
                                </div>
                            </FooterContent>
                        </SgKPICard>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Кликабельная карточка</div>
                        <SgKPICard Title="Уведомления"
                                  Value="@_notificationCount"
                                  Icon="@SgIcons.MessageSquare"
                                  IconColor="#ef4444"
                                  IconBackground="rgba(239, 68, 68, 0.1)"
                                  TrendPercent="25.0"
                                  Clickable="true"
                                  OnClick="HandleNotificationClick">
                            <FooterContent>
                                <span style="font-size: 11px;">Нажмите для просмотра</span>
                            </FooterContent>
                        </SgKPICard>
                    </div>
                    <SgDivider />
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Инвертированный тренд (меньше = лучше)</div>
                        <SgKPICard Title="Ошибки"
                                  Subtitle="За последний час"
                                  Value="12"
                                  Icon="@SgIcons.X"
                                  IconColor="#ef4444"
                                  IconBackground="rgba(239, 68, 68, 0.1)"
                                  TrendPercent="-45.5"
                                  InvertTrend="true"
                                  TrendLabel="vs прошлый час"
                                  ChartData="@_errorsData"
                                  ChartType="SgKPIChartType.Bar" />
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства Advanced">
                <PropertyTable Items="_advancedProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Loading State -->
    <div style="margin-top: 32px;">
        <h2>Состояние загрузки</h2>
        <p>Skeleton loader для индикации загрузки данных.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <SgKPICard IsLoading="true" Size="SgSize.Sm" />
                    <SgKPICard IsLoading="true" />
                    <SgKPICard IsLoading="true" Size="SgSize.Lg" />
                    <div style="display: flex; align-items: center; justify-content: center; padding: 20px;">
                        <SgButton OnClick="ToggleLoading" Variant="SgButtonVariant.Primary">
                            @(isLoading ? "Загрузить данные" : "Показать загрузку")
                        </SgButton>
                    </div>
                </div>
                @if (isLoading)
                {
                    <div style="margin-top: 16px;">
                        <SgKPICard IsLoading="true" />
                    </div>
                }
                else
                {
                    <div style="margin-top: 16px;">
                        <SgKPICard Title="Загружено!"
                                  Value="100"
                                  Suffix="%"
                                  Icon="@SgIcons.Check"
                                  IconColor="#10b981"
                                  IconBackground="rgba(16, 185, 129, 0.1)"
                                  TrendPercent="100"
                                  Variant="SgKPIVariant.Success" />
                    </div>
                }
            </SgCard>
            <SgCard Title="Свойства Loading">
                <PropertyTable Items="_loadingProperties" />
                <div style="margin-top: 16px;">
                    <SgAlert Variant="SgAlertVariant.Info" Title="Skeleton Loader">
                        <ChildContent>
                            Компонент автоматически показывает анимированный skeleton при <code>IsLoading="true"</code>. 
                            Это улучшает UX, показывая пользователю, что данные загружаются.
                        </ChildContent>
                    </SgAlert>
                </div>
            </SgCard>
        </div>
    </div>

</SgCard>


@code {
    // ═══════════════════════════════════════════════════════════════════════════
    //                              STATE
    // ═══════════════════════════════════════════════════════════════════════════
    
    private bool isLoading = false;
    private int _notificationCount = 42;
    
    // ═══════════════════════════════════════════════════════════════════════════
    //                              CHART DATA
    // ═══════════════════════════════════════════════════════════════════════════
    
    private double[] _conversionData = { 2.8, 3.1, 2.9, 3.3, 3.0, 3.5, 3.42 };
    private double[] _ordersData = { 95, 110, 125, 105, 140, 130, 156 };
    private double[] _salesData = { 75000, 82000, 78000, 85000, 88000, 87000, 89500 };
    private double[] _revenueData = { 980000, 1050000, 1120000, 1180000, 1245000 };
    private double[] _temperatureData = { 22.1, 22.8, 23.2, 22.9, 23.5, 23.8, 23.5 };
    private double[] _trafficData = { 38.5, 40.2, 42.1, 41.8, 43.5, 44.2, 45.2 };
    private double[] _dailySalesData = { 95, 110, 125, 105, 140, 130, 128 };
    private double[] _ratingData = { 4.5, 4.6, 4.7, 4.7, 4.8, 4.8, 4.8 };
    private double[] _errorsData = { 22, 18, 15, 14, 10, 8, 12 };
    
    // ═══════════════════════════════════════════════════════════════════════════
    //                              METHODS
    // ═══════════════════════════════════════════════════════════════════════════
    
    private void HandleNotificationClick()
    {
        _notificationCount = 0;
        StateHasChanged();
    }
    
    private void ToggleLoading()
    {
        isLoading = !isLoading;
    }
    
    // ═══════════════════════════════════════════════════════════════════════════
    //                              PROPERTY TABLES
    // ═══════════════════════════════════════════════════════════════════════════
    
    private List<PropertyPanelItem> _basicProperties = new()
    {
        new() { Label = "Title", Value = "string?", BadgeText = "Заголовок карточки" },
        new() { Label = "Subtitle", Value = "string?", BadgeText = "Подзаголовок или описание" },
        new() { Label = "Value", Value = "double?", BadgeText = "Основное значение" },
        new() { Label = "ValueText", Value = "string?", BadgeText = "Кастомный текст значения (переопределяет Value)" },
        new() { Label = "Format", Value = "string?", BadgeText = "Формат числа (N0, C2, P1 и т.д.)" },
        new() { Label = "Prefix", Value = "string?", BadgeText = "Префикс перед значением ($, €)" },
        new() { Label = "Suffix", Value = "string?", BadgeText = "Суффикс после значения (%, kg)" },
        new() { Label = "Description", Value = "string?", BadgeText = "Дополнительное описание под значением" },
        new() { Label = "Icon", Value = "string?", BadgeText = "SVG иконка" },
        new() { Label = "IconColor", Value = "string?", BadgeText = "Цвет иконки" },
        new() { Label = "IconBackground", Value = "string?", BadgeText = "Фон иконки" },
    };
    
    private List<PropertyPanelItem> _sizeProperties = new()
    {
        new() { Label = "Size", Value = "SgSize", BadgeText = "Размер карточки: Sm, Md, Lg, Xl" },
        new() { Label = "Sm", Value = "140px", BadgeText = "Компактный размер" },
        new() { Label = "Md", Value = "180px", BadgeText = "Стандартный размер (по умолчанию)" },
        new() { Label = "Lg", Value = "220px", BadgeText = "Большой размер" },
        new() { Label = "Xl", Value = "260px", BadgeText = "Очень большой размер" },
    };
    
    private List<PropertyPanelItem> _variantProperties = new()
    {
        new() { Label = "Variant", Value = "SgKPIVariant", BadgeText = "Цветовой вариант карточки" },
        new() { Label = "Default", Value = "Gray", BadgeText = "Серый (по умолчанию)" },
        new() { Label = "Primary", Value = "Blue", BadgeText = "Синий" },
        new() { Label = "Success", Value = "Green", BadgeText = "Зеленый" },
        new() { Label = "Warning", Value = "Orange", BadgeText = "Оранжевый" },
        new() { Label = "Danger", Value = "Red", BadgeText = "Красный" },
        new() { Label = "Info", Value = "Cyan", BadgeText = "Голубой" },
    };
    
    private List<PropertyPanelItem> _chartProperties = new()
    {
        new() { Label = "ChartData", Value = "double[]?", BadgeText = "Массив данных для графика" },
        new() { Label = "ChartType", Value = "SgKPIChartType", BadgeText = "Тип графика: Line, Area, Bar" },
        new() { Label = "ChartColor", Value = "string?", BadgeText = "Цвет графика (авто по тренду)" },
        new() { Label = "ChartHeight", Value = "double", BadgeText = "Высота графика в SVG единицах (по умолчанию 50)" },
    };
    
    private List<PropertyPanelItem> _advancedProperties = new()
    {
        new() { Label = "TrendValue", Value = "double?", BadgeText = "Абсолютное изменение" },
        new() { Label = "TrendPercent", Value = "double?", BadgeText = "Процентное изменение" },
        new() { Label = "ShowTrend", Value = "bool", BadgeText = "Показывать индикатор тренда (по умолчанию true)" },
        new() { Label = "TrendLabel", Value = "string?", BadgeText = "Метка тренда (vs last month)" },
        new() { Label = "InvertTrend", Value = "bool", BadgeText = "Инвертировать цвета тренда (меньше = лучше)" },
        new() { Label = "Clickable", Value = "bool", BadgeText = "Карточка кликабельна" },
        new() { Label = "OnClick", Value = "EventCallback", BadgeText = "Событие клика" },
        new() { Label = "ActionContent", Value = "RenderFragment?", BadgeText = "Контент действия (справа вверху)" },
        new() { Label = "FooterContent", Value = "RenderFragment?", BadgeText = "Контент футера" },
        new() { Label = "ValueColor", Value = "string?", BadgeText = "Кастомный цвет значения" },
    };
    
    private List<PropertyPanelItem> _loadingProperties = new()
    {
        new() { Label = "IsLoading", Value = "bool", BadgeText = "Состояние загрузки (показывает skeleton)" },
    };
}
