@page "/kpi-card-demo"
@using SuperUI.Components
@using System.Globalization

<PageTitle>KPI Card - SUI</PageTitle>

<SgCard Title="SgKPICard - Карточка показателя"
        Subtitle="Отображает значение, дельту с трендом, спарклайн график и иконку. Поддерживает клик для drill-down.">

    <div style="margin-top: 32px;">
        <h2>Basic Usage</h2>
        <p>Карточка с значением, изменением, спарклайном и иконкой.</p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 16px;">
            <SgKPICard Title="Revenue"
                       Value="_revenue"
                       Delta="_revenueDelta"
                       DeltaPercent="_revenueDeltaPercent"
                       Icon="@SgIcons.TrendingUp"
                       IconColor="#10b981"
                       SparklineData="_revenueSparkline"
                       SparklineColor="#10b981"
                       Prefix="$"
                       Clickable="true"
                       OnClick="@(() => _selectedKPI = "Revenue")">
                <HeaderContent>
                    <div class="sgc-kpi-header-content">
                        <span class="sgc-kpi-title">Revenue</span>
                        <span class="sgc-kpi-subtitle">This month</span>
                    </div>
                </HeaderContent>
            </SgKPICard>

            <SgKPICard Title="Users"
                       Value="_users"
                       Delta="_usersDelta"
                       DeltaPercent="_usersDeltaPercent"
                       Icon="@SgIcons.BarChart"
                       IconColor="#3b82f6"
                       SparklineData="_usersSparkline"
                       SparklineColor="#3b82f6"
                       Clickable="true"
                       OnClick="@(() => _selectedKPI = "Users")">
                <HeaderContent>
                    <div class="sgc-kpi-header-content">
                        <span class="sgc-kpi-title">Active Users</span>
                        <span class="sgc-kpi-subtitle">Last 30 days</span>
                    </div>
                </HeaderContent>
            </SgKPICard>

            <SgKPICard Title="Conversion"
                       Value="_conversion"
                       Delta="_conversionDelta"
                       DeltaPercent="_conversionDeltaPercent"
                       Icon="@SgIcons.Check"
                       IconColor="#8b5cf6"
                       SparklineData="_conversionSparkline"
                       SparklineColor="#8b5cf6"
                       Suffix="%"
                       Formatter="F1">
                <HeaderContent>
                    <div class="sgc-kpi-header-content">
                        <span class="sgc-kpi-title">Conversion Rate</span>
                        <span class="sgc-kpi-subtitle">E-commerce</span>
                    </div>
                </HeaderContent>
            </SgKPICard>

            <SgKPICard Title="Bounce Rate"
                       Value="_bounceRate"
                       Delta="_bounceRateDelta"
                       DeltaPercent="_bounceRateDeltaPercent"
                       Icon="@SgIcons.ArrowDown"
                       IconColor="#ef4444"
                       SparklineData="_bounceRateSparkline"
                       SparklineColor="#ef4444"
                       Suffix="%"
                       Formatter="F1">
                <HeaderContent>
                    <div class="sgc-kpi-header-content">
                        <span class="sgc-kpi-title">Bounce Rate</span>
                        <span class="sgc-kpi-subtitle">Landing pages</span>
                    </div>
                </HeaderContent>
            </SgKPICard>
        </div>

        @if (!string.IsNullOrEmpty(_selectedKPI))
        {
            <div style="margin-top: 16px; padding: 12px 16px; background: var(--sui-bg-secondary, #f3f4f6); border-radius: 8px; font-size: 14px;">
                Drill-down: @_selectedKPI clicked! (здесь можно открыть детальный отчет)
            </div>
        }
    </div>

    <div style="margin-top: 32px;">
        <h2>States</h2>
        <p>Различные состояния карточки.</p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 16px;">
            <SgKPICard Title="Loading"
                       IsLoading="true">
            </SgKPICard>

            <SgKPICard Title="Neutral Trend"
                       Value="1250"
                       Delta="0"
                       DeltaPercent="0"
                       Icon="@SgIcons.BarChart"
                       IconColor="#6b7280"
                       SparklineData="@(new double[] { 1200.0, 1250, 1220, 1250, 1240, 1250 })">
                <HeaderContent>
                    <div class="sgc-kpi-header-content">
                        <span class="sgc-kpi-title">Neutral</span>
                        <span class="sgc-kpi-subtitle">No change</span>
                    </div>
                </HeaderContent>
            </SgKPICard>

            <SgKPICard Title="Negative Trend"
                       Value="850"
                       Delta="-120"
                       DeltaPercent="-12.4"
                       Icon="@SgIcons.ArrowDown"
                       IconColor="#ef4444"
                       SparklineData="@(new double[] { 1000, 970, 950, 920, 890, 850 })"
                       SparklineColor="#ef4444">
                <HeaderContent>
                    <div class="sgc-kpi-header-content">
                        <span class="sgc-kpi-title">Errors</span>
                        <span class="sgc-kpi-subtitle">Last 7 days</span>
                    </div>
                </HeaderContent>
            </SgKPICard>

            <SgKPICard Title="Without Sparkline"
                       Value="98.5"
                       Delta="2.1"
                       DeltaPercent="2.2"
                       Icon="@SgIcons.Check"
                       IconColor="#10b981"
                       Suffix="%">
                <HeaderContent>
                    <div class="sgc-kpi-header-content">
                        <span class="sgc-kpi-title">Uptime</span>
                        <span class="sgc-kpi-subtitle">SLA</span>
                    </div>
                </HeaderContent>
            </SgKPICard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Custom Styling</h2>
        <p>Карточка с кастомными стилями и футером.</p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 16px;">
            <SgKPICard Title="Custom Colors"
                       Value="42.5"
                       Delta="3.2"
                       DeltaPercent="8.1"
                       Icon="@SgIcons.Flame"
                       IconColor="#f59e0b"
                       SparklineData="_customSparkline"
                       SparklineColor="#f59e0b"
                       CssClass="sgc-kpi-card-highlight">
                <HeaderContent>
                    <div class="sgc-kpi-header-content">
                        <span class="sgc-kpi-title">Customer Satisfaction</span>
                        <span class="sgc-kpi-subtitle">NPS Score</span>
                    </div>
                </HeaderContent>
                <FooterContent>
                    <span>Target: 45.0</span>
                </FooterContent>
            </SgKPICard>

            <SgKPICard Title="Compact"
                       Value="1.2"
                       Suffix="M"
                       CssClass="sgc-kpi-card-compact"
                       Icon="@SgIcons.Database"
                       IconColor="#06b6d4">
                <HeaderContent>
                    <div class="sgc-kpi-header-content">
                        <span class="sgc-kpi-title">Queries</span>
                    </div>
                </HeaderContent>
            </SgKPICard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Properties</h2>
        <PropertyTable Items="_properties" />
    </div>

</SgCard>

<style>
    .sgc-kpi-title {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--sui-fg);
        display: block;
    }
    
    .sgc-kpi-subtitle {
        font-size: 0.75rem;
        color: var(--sui-muted);
        display: block;
    }
    
    .sgc-kpi-card-highlight {
        border-color: #f59e0b;
        border-width: 2px;
    }
    
    .sgc-kpi-card-compact {
        padding: 16px;
        min-height: 120px;
    }
</style>

@code {
    private string? _selectedKPI;

    // Revenue data
    private double _revenue = 42500;
    private double _revenueDelta = 5000;
    private double _revenueDeltaPercent = 12.5;
    private double[] _revenueSparkline = new double[] { 32000.0, 35000, 38000, 36000, 41000, 42500 };

    // Users data
    private double _users = 1248;
    private double _usersDelta = 65;
    private double _usersDeltaPercent = 5.2;
    private double[] _usersSparkline = new double[] { 1100.0, 1150, 1180, 1200, 1220, 1248 };

    // Conversion data
    private double _conversion = 3.2;
    private double _conversionDelta = 0.4;
    private double _conversionDeltaPercent = 14.3;
    private double[] _conversionSparkline = new double[] { 2.5, 2.8, 3.0, 2.9, 3.1, 3.2 };

    // Bounce rate data
    private double _bounceRate = 42.5;
    private double _bounceRateDelta = -3.2;
    private double _bounceRateDeltaPercent = -7.0;
    private double[] _bounceRateSparkline = new double[] { 48.0, 47.0, 45.5, 44.0, 43.0, 42.5 };

    // Custom sparkline
    private double[] _customSparkline = new double[] { 38.0, 40.0, 39.5, 41.0, 42.0, 42.5 };

    private List<PropertyPanelItem> _properties = new()
    {
        new() { Label = "Value", Value = "double?", BadgeText = "Main value", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Delta", Value = "double?", BadgeText = "Change", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "DeltaPercent", Value = "double?", BadgeText = "% change", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowDelta", Value = "bool (default: true)", BadgeText = "Show delta", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "ShowDeltaPercent", Value = "bool (default: true)", BadgeText = "Show %", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Icon", Value = "string?", BadgeText = "SVG icon", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "IconColor", Value = "string?", BadgeText = "Icon color", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "TrendColor", Value = "string?", BadgeText = "Trend color", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "UseTrendColor", Value = "bool (default: true)", BadgeText = "Auto trend color", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "SparklineData", Value = "double[]?", BadgeText = "Chart data", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SparklineHeight", Value = "int (default: 40)", BadgeText = "Chart height", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SparklineColor", Value = "string?", BadgeText = "Line color", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SparklineFill", Value = "bool (default: true)", BadgeText = "Fill area", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Prefix", Value = "string?", BadgeText = "Before value", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Suffix", Value = "string?", BadgeText = "After value", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Formatter", Value = "string?", BadgeText = "Format string", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Clickable", Value = "bool", BadgeText = "Enable click", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnClick", Value = "EventCallback", BadgeText = "Click event", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "IsLoading", Value = "bool", BadgeText = "Loading state", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "HeaderContent", Value = "RenderFragment?", BadgeText = "Custom header", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "FooterContent", Value = "RenderFragment?", BadgeText = "Custom footer", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "CssClass", Value = "string?", BadgeText = "Custom CSS", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Style", Value = "string?", BadgeText = "Inline style", BadgeVariant = SgBadgeVariant.Info }
    };
}