@page "/kpi-card-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Demo.Models

<PageTitle>KPI Card - SUI</PageTitle>

<SgCard Title="SgKPICard - Карточка показателя"
        Subtitle="Компактный компонент для отображения ключевых метрик с трендами и графиками.">

    <!-- Базовое использование -->
    <div style="margin-top: 32px;">
        <h2>Базовое использование</h2>
        <p>Карточки с акцентом на ключевые показатели. Иерархия данных стала более наглядной.</p>
        
        <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Интерактивные примеры">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <SgKPICard Title="Выручка"
                               Subtitle="Всего за месяц"
                               Value="124500"
                               Prefix="$"
                               Delta="12500"
                               DeltaPercent="11.2"
                               Icon="@SgIcons.TrendingUp"
                               IconColor="#10b981"
                               IconBackgroundColor="rgba(16, 185, 129, 0.1)"
                               SparklineData="@(new double[] { 100, 110, 105, 130, 120, 140, 124.5 })"
                               Clickable="true" />

                    <SgKPICard Title="Пользователи"
                               Subtitle="Активные за сутки"
                               Value="1240"
                               Delta="-85"
                               DeltaPercent="-6.4"
                               Icon="@SgIcons.Database"
                               IconColor="#3b82f6"
                               IconBackgroundColor="rgba(59, 130, 246, 0.1)"
                               SparklineData="@(new double[] { 150, 140, 145, 130, 120, 110, 124 })"
                               SparklineColor="#3b82f6" />
                </div>

                <div style="margin-top: 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <SgKPICard Title="Конверсия"
                               Subtitle="Средний показатель"
                               Value="3.42"
                               Suffix="%"
                               Formatter="N2"
                               Delta="0.12"
                               DeltaPercent="3.5"
                               Variant="SgKPICardVariant.Outlined"
                               Icon="@SgIcons.Check"
                               IconColor="#10b981" />

                    <SgKPICard Title="Ошибки"
                               Subtitle="Критические сбои"
                               Value="12"
                               TrendColor="#ef4444"
                               Delta="5"
                               DeltaPercent="42"
                               Icon="@SgIcons.X"
                               IconColor="#ef4444"
                               Variant="SgKPICardVariant.Elevated" />
                </div>
            </SgCard>

            <SgCard Title="Свойства SgKPICard">
                <PropertyTable Items="_kpiProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Состояния и кастомизация -->
    <div style="margin-top: 32px;">
        <h2>Состояния и кастомизация</h2>
        <p>Поддержка загрузки, пустых состояний и произвольного контента.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgKPICard IsLoading="true" />
                    
                    <SgKPICard Title="С кастомным футером"
                               Value="89"
                               Suffix="/100"
                               Icon="@SgIcons.Settings">
                        <FooterContent>
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <span>Цель: 95</span>
                                <SgButton Text="Детали" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" />
                            </div>
                        </FooterContent>
                    </SgKPICard>

                    <SgKPICard Title="С действием в заголовке"
                               Value="1024"
                               Prefix="GB ">
                        <ActionContent>
                            <SgIconButton Icon="@SgIcons.Refresh" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" />
                        </ActionContent>
                    </SgKPICard>
                </div>
            </SgCard>

            <SgCard Title="Варианты (SgKPICardVariant)">
                <div style="font-size: 13px; line-height: 1.6;">
                    <ul style="padding-left: 20px;">
                        <li><strong>Default</strong> — стандартная карточка с рамкой.</li>
                        <li><strong>Elevated</strong> — карточка с легкой тенью.</li>
                        <li><strong>Outlined</strong> — без фона, только контур.</li>
                    </ul>
                    <SgAlert Variant="SgAlertVariant.Info" style="margin-top: 16px;">
                        Используйте <code>IconBackgroundColor</code> для создания мягких подложек под иконки, что придает карточке современный вид.
                    </SgAlert>
                </div>
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private List<PropertyPanelItem> _kpiProperties = new()
    {
        new() { Label = "Variant", Value = "SgKPICardVariant", BadgeText = "Стиль карточки", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Title", Value = "string", BadgeText = "Заголовок", BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "Value", Value = "double", BadgeText = "Значение", BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "Delta", Value = "double", BadgeText = "Изменение", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Icon", Value = "string", BadgeText = "SVG иконка", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "SparklineData", Value = "double[]", BadgeText = "Массив данных", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "IsLoading", Value = "bool", BadgeText = "Скелетон", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "HeaderContent", Value = "RenderFragment", BadgeText = "Свой заголовок", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ActionContent", Value = "RenderFragment", BadgeText = "Кнопка в углу", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "FooterContent", Value = "RenderFragment", BadgeText = "Подвал", BadgeVariant = SgBadgeVariant.Info }
    };
}
