        new() { Label = "PeriodLabel",   Value = "string?",                BadgeText = "Analytic period text",            BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Deltas",        Value = "IReadOnlyList<>",        BadgeText = "Comparison metrics",              BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "ComparisonValue",Value = "double?",               BadgeText = "Previous period value",           BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "ForecastValue", Value = "double?",                BadgeText = "Projected value",                 BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "AnimatedValue", Value = "bool",                   BadgeText = "Animate from zero",               BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ShowMiniGauge", Value = "bool",                   BadgeText = "Corner mini-ring",                BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "StatusDot",     Value = "SgAvatarStatus?",        BadgeText = "Status indicator",                BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Glass",         Value = "bool",                   BadgeText = "Frosted glass",                   BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Flipable",      Value = "bool",                   BadgeText = "Hover-to-flip",                   BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Compact",       Value = "bool",                   BadgeText = "Dense padding",                   BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "ProgressBar",   Value = "bool",                   BadgeText = "Horizontal progress fill",         BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ProgressBarMax",Value = "double",                 BadgeText = "Progress bar max (100)",            BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "ProgressBarColor",Value = "string?",             BadgeText = "Progress fill color",               BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "CornerBadge",   Value = "string?",                BadgeText = "Top-right label",                   BadgeVariant = SgBadgeVariant.Info },
