@page "/demo/accordion"
@using SuperUI.Demo.Components

<div class="demo-page">
    <div class="demo-hero">
        <section class="demo-hero-main">
            <div class="demo-header">
                <div class="demo-kicker">Navigation Components</div>
                <h1 class="demo-title">SgAccordion</h1>
                <p class="demo-subtitle">
                    Organize content into collapsible sections to save vertical space. Supports multiple variants, 
                    keyboard navigation, and single or multiple expanded items.
                </p>
            </div>
        </section>

        <aside class="demo-hero-side">
            <div class="demo-side-title">Highlights</div>
            <div class="demo-pill-list">
                <span class="demo-pill demo-pill-accent">Collapsible</span>
                <span class="demo-pill">Keyboard Nav</span>
                <span class="demo-pill">Multiple Mode</span>
                <span class="demo-pill">Variants</span>
            </div>
        </aside>
    </div>

    <SgDemoSection Eyebrow="Usage" Title="Examples" Description="Patterns for FAQs, settings, and complex forms.">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Default (Single)</h3>
                    <p class="demo-showcase-desc">Standard behavior where only one section is open at a time.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgAccordion>
                            <SgAccordionItem Title="Section 1" Icon="@SgIcons.Info">
                                Content for the first section. This is the default style.
                            </SgAccordionItem>
                            <SgAccordionItem Title="Section 2" Icon="@SgIcons.Settings">
                                Content for the second section. Opening this will close Section 1.
                            </SgAccordionItem>
                            <SgAccordionItem Title="Section 3" Disabled="true">
                                This section is disabled.
                            </SgAccordionItem>
                        </SgAccordion>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Multiple & Bordered</h3>
                    <p class="demo-showcase-desc">Allow multiple sections to be expanded simultaneously.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgAccordion Multiple="true" Variant="SgAccordionVariant.Bordered">
                            <SgAccordionItem Title="System Health" Expanded="true">
                                <div class="demo-stack">
                                    <div style="display:flex; justify-content:space-between;">
                                        <span>CPU</span>
                                        <span style="color:var(--sui-success);">Normal</span>
                                    </div>
                                    <div style="display:flex; justify-content:space-between;">
                                        <span>Memory</span>
                                        <span style="color:var(--sui-warning);">85%</span>
                                    </div>
                                </div>
                            </SgAccordionItem>
                            <SgAccordionItem Title="Network Status">
                                All systems operational. 12 active connections.
                            </SgAccordionItem>
                        </SgAccordion>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Separated Variant</h3>
                    <p class="demo-showcase-desc">Sections are visually separated with margins.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgAccordion Variant="SgAccordionVariant.Separated">
                            <SgAccordionItem Title="Account Settings">
                                Manage your profile and security settings.
                            </SgAccordionItem>
                            <SgAccordionItem Title="Notifications">
                                Configure how you receive updates.
                            </SgAccordionItem>
                        </SgAccordion>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Compact & Filled</h3>
                    <p class="demo-showcase-desc">Dense layout with background fill.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgAccordion Compact="true" Variant="SgAccordionVariant.Filled">
                            <SgAccordionItem Title="Compact Item A">
                                Small padding and font for dense UIs.
                            </SgAccordionItem>
                            <SgAccordionItem Title="Compact Item B">
                                Looks great in sidebars.
                            </SgAccordionItem>
                        </SgAccordion>
                    </div>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoParams Title="Accordion Parameters">
        <SgDemoParam Name="Multiple" Type="bool" Description="Allow multiple items to be expanded." DefaultValue="false" />
        <SgDemoParam Name="Variant" Type="SgAccordionVariant" Description="Visual style of the accordion." Values="Default, Bordered, Ghost, Filled, Separated" DefaultValue="Default" />
        <SgDemoParam Name="Compact" Type="bool" Description="Use dense layout with smaller paddings." DefaultValue="false" />
        <SgDemoParam Name="CssClass" Type="string" Description="Additional CSS classes." />
    </SgDemoParams>

    <SgDemoParams Title="AccordionItem Parameters">
        <SgDemoParam Name="Title" Type="string" Description="Text displayed in the header." />
        <SgDemoParam Name="Icon" Type="RenderFragment" Description="Icon displayed before the title." />
        <SgDemoParam Name="Expanded" Type="bool" Description="Whether the item is initially expanded." DefaultValue="false" />
        <SgDemoParam Name="Disabled" Type="bool" Description="Prevents interaction." DefaultValue="false" />
    </SgDemoParams>
</div>
