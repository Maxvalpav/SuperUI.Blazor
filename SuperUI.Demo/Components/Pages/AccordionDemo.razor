@page "/accordion-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgAccordion — Accordion — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. SgAccordion — Basic Usage                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgAccordion — Basic Usage
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                A vertically stacked set of expandable sections. Each item has a title, optional icon, subtitle, and custom content.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Single Open (Default)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgAccordion>
                        <SgAccordionItem Title="Getting Started" Expanded="true"
                                         Subtitle="Installation & setup">
                            <div class="demo-acc-content">
                                <p>Install SuperUI via NuGet:</p>
                                <code class="demo-code-inline">dotnet add package SuperUI</code>
                                <p style="margin-top:8px;">Add <strong>SgThemeProvider</strong>, <strong>SgToastHost</strong>, and <strong>SgPortalHost</strong> to your MainLayout.</p>
                            </div>
                        </SgAccordionItem>
                        <SgAccordionItem Title="Component Overview"
                                         Subtitle="90+ Blazor components">
                            <div class="demo-acc-content">
                                <p>SuperUI provides a comprehensive set of UI components including data grid, charts, forms, navigation, and more.</p>
                            </div>
                        </SgAccordionItem>
                        <SgAccordionItem Title="Theming" Disabled="true"
                                         Subtitle="Light & dark mode">
                            <div class="demo-acc-content">
                                <p>Theming support coming soon. This section is disabled for illustration.</p>
                            </div>
                        </SgAccordionItem>
                        <SgAccordionItem Title="Contributing"
                                         Subtitle="Open source">
                            <div class="demo-acc-content">
                                <p>Contributions are welcome! Check out the GitHub repository for guidelines.</p>
                            </div>
                        </SgAccordionItem>
                    </SgAccordion>
                </SgStack>
            </SgCard>

            <SgCard Title="SgAccordion Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_accordionProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Multiple + Variants                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgAccordion — Multiple & Variants
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Multiple</SgTypography> allows several sections open at once. <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Variant</SgTypography> changes the visual style.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Multiple=True" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)" Style="margin-bottom:12px;display:block;">
                        Open several sections simultaneously.
                    </SgTypography>
                    <SgAccordion Multiple="true">
                        <SgAccordionItem Title="Notifications" Expanded="true" Icon="@SgIcons.Bell">
                            <div class="demo-acc-content">You have 3 unread notifications.</div>
                        </SgAccordionItem>
                        <SgAccordionItem Title="Messages" Expanded="true" Icon="@SgIcons.MessageSquare">
                            <div class="demo-acc-content">2 new messages from your team.</div>
                        </SgAccordionItem>
                        <SgAccordionItem Title="Updates" Icon="@SgIcons.RefreshCw">
                            <div class="demo-acc-content">All components are up to date.</div>
                        </SgAccordionItem>
                    </SgAccordion>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="With Icons & Extra Content" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgAccordion>
                        <SgAccordionItem Title="Profile" Icon="@SgIcons.User">
                            <ExtraContent>
                                <SgTag Variant="SgTagVariant.Success" Size="SgSize.Sm">Active</SgTag>
                            </ExtraContent>
                            <ChildContent>
                                <div class="demo-acc-content">Manage your profile settings and preferences.</div>
                            </ChildContent>
                        </SgAccordionItem>
                        <SgAccordionItem Title="Security" Icon="@SgIcons.Shield">
                            <ExtraContent>
                                <SgBadge Variant="SgBadgeVariant.Warn" Text="2FA" Standalone="true" />
                            </ExtraContent>
                            <ChildContent>
                                <div class="demo-acc-content">Configure two-factor authentication and access keys.</div>
                            </ChildContent>
                        </SgAccordionItem>
                        <SgAccordionItem Title="Billing" Icon="@SgIcons.DollarSign">
                            <ExtraContent>
                                <SgBadge Variant="SgBadgeVariant.Info" Text="Pro" Standalone="true" />
                            </ExtraContent>
                            <ChildContent>
                                <div class="demo-acc-content">View invoices, payment methods, and subscription details.</div>
                            </ChildContent>
                        </SgAccordionItem>
                    </SgAccordion>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Variants                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgAccordion — Variants
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Five visual styles: <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Default</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Bordered</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Ghost</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Filled</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Separated</SgTypography>.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="4">
                <SgCard Title="Default" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgAccordion Variant="SgAccordionVariant.Default">
                        <SgAccordionItem Title="Default item" Expanded="true">
                            <div class="demo-acc-content">Thin border, clean look.</div>
                        </SgAccordionItem>
                        <SgAccordionItem Title="Second item">
                            <div class="demo-acc-content">Item content here.</div>
                        </SgAccordionItem>
                    </SgAccordion>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Bordered" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgAccordion Variant="SgAccordionVariant.Bordered">
                        <SgAccordionItem Title="Bordered item" Expanded="true">
                            <div class="demo-acc-content">Clear visible borders.</div>
                        </SgAccordionItem>
                        <SgAccordionItem Title="Second item">
                            <div class="demo-acc-content">Item content here.</div>
                        </SgAccordionItem>
                    </SgAccordion>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Ghost" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgAccordion Variant="SgAccordionVariant.Ghost">
                        <SgAccordionItem Title="Ghost item" Expanded="true">
                            <div class="demo-acc-content">No borders at all.</div>
                        </SgAccordionItem>
                        <SgAccordionItem Title="Second item">
                            <div class="demo-acc-content">Item content here.</div>
                        </SgAccordionItem>
                    </SgAccordion>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Filled" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgAccordion Variant="SgAccordionVariant.Filled">
                        <SgAccordionItem Title="Filled item" Expanded="true">
                            <div class="demo-acc-content">Filled header background.</div>
                        </SgAccordionItem>
                        <SgAccordionItem Title="Second item">
                            <div class="demo-acc-content">Item content here.</div>
                        </SgAccordionItem>
                    </SgAccordion>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Separated" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgAccordion Variant="SgAccordionVariant.Separated">
                        <SgAccordionItem Title="Separated item" Expanded="true">
                            <div class="demo-acc-content">Cards with gaps.</div>
                        </SgAccordionItem>
                        <SgAccordionItem Title="Second item">
                            <div class="demo-acc-content">Item content here.</div>
                        </SgAccordionItem>
                    </SgAccordion>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Compact" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgAccordion Variant="SgAccordionVariant.Default" Compact="true">
                        <SgAccordionItem Title="Compact item" Expanded="true">
                            <div class="demo-acc-content">Smaller padding, denser layout.</div>
                        </SgAccordionItem>
                        <SgAccordionItem Title="Second item">
                            <div class="demo-acc-content">Item content here.</div>
                        </SgAccordionItem>
                    </SgAccordion>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Size Variants                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgAccordion — Size Variants
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Three sizes: <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Sm</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Md (default)</SgTypography>, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Lg</SgTypography>.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="4">
                <SgCard Title="Size = Sm" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgAccordion Size="SgSize.Sm">
                        <SgAccordionItem Title="Small item" Expanded="true">
                            <div class="demo-acc-content">Compact size with smaller headers.</div>
                        </SgAccordionItem>
                        <SgAccordionItem Title="Second item">
                            <div class="demo-acc-content">Content here.</div>
                        </SgAccordionItem>
                    </SgAccordion>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Size = Md (Default)" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgAccordion Size="SgSize.Md">
                        <SgAccordionItem Title="Medium item" Expanded="true">
                            <div class="demo-acc-content">Standard size for most use cases.</div>
                        </SgAccordionItem>
                        <SgAccordionItem Title="Second item">
                            <div class="demo-acc-content">Content here.</div>
                        </SgAccordionItem>
                    </SgAccordion>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Size = Lg" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgAccordion Size="SgSize.Lg">
                        <SgAccordionItem Title="Large item" Expanded="true">
                            <div class="demo-acc-content">Spacious headers with more padding.</div>
                        </SgAccordionItem>
                        <SgAccordionItem Title="Second item">
                            <div class="demo-acc-content">Content here.</div>
                        </SgAccordionItem>
                    </SgAccordion>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. SgAccordionItem Properties                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgAccordionItem Properties
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Each item can be individually configured with title, subtitle, icon, disabled state, and extra content.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Interactive Example" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)">
                        Use buttons to toggle items programmatically:
                    </SgTypography>
                    <SgSpace>
                        <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Primary" OnClick="() => _accItem1Expanded = !_accItem1Expanded">Toggle Item 1</SgButton>
                        <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined" OnClick="() => _accItem2Expanded = !_accItem2Expanded">Toggle Item 2</SgButton>
                    </SgSpace>
                    <SgAccordion Multiple="true">
                        <SgAccordionItem Title="Programmatic Item 1"
                                         Expanded="@_accItem1Expanded"
                                         ExpandedChanged="v => _accItem1Expanded = v">
                            <div class="demo-acc-content">
                                This item is controlled externally. Current: @(_accItem1Expanded ? "Expanded" : "Collapsed")
                            </div>
                        </SgAccordionItem>
                        <SgAccordionItem Title="Programmatic Item 2"
                                         Expanded="@_accItem2Expanded"
                                         ExpandedChanged="v => _accItem2Expanded = v">
                            <div class="demo-acc-content">
                                This item is controlled externally. Current: @(_accItem2Expanded ? "Expanded" : "Collapsed")
                            </div>
                        </SgAccordionItem>
                    </SgAccordion>
                </SgStack>
            </SgCard>

            <SgCard Title="SgAccordionItem Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_accordionItemProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. Enums                                                            -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgAccordion — Enumerations
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="SgAccordionVariant" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_variantEnum" />
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="SgSize" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_sizeEnum" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

</ChildContent>
</SgCard>

<style>
    .demo-section { margin-top: 48px; }
    .demo-section-header { margin-bottom: 20px; }
    .demo-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    @@media (max-width: 768px) { .demo-two-col { grid-template-columns: 1fr; } }
    .demo-acc-content { padding: 4px 0; font-size: 13px; line-height: 1.6; color: var(--sg-text-secondary); }
    .demo-acc-content p { margin: 0 0 6px; }
    .demo-acc-content p:last-child { margin-bottom: 0; }
    .demo-code-inline { background: var(--sg-surface-alt); padding: 6px 10px; border-radius: 4px; font-size: 12px; display: inline-block; border: 1px solid var(--sg-border); font-family: 'JetBrains Mono', monospace; }
</style>

@code {
    // ── Main card header ─────────────────────────────────────────────────
    private RenderFragment _mainHeader => __builder =>
    {
        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
            <div style="display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,var(--sg-primary),#8b5cf6);color:#fff;flex-shrink:0;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="6" rx="2"/><rect x="3" y="15" width="18" height="6" rx="2"/>
                </svg>
            </div>
            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">SgAccordion</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Vertically stacked expandable sections with multiple variants, keyboard navigation, icons, and programmatic control.
                </SgTypography>
            </SgStack>
        </SgStack>
    };

    private bool _accItem1Expanded = true;
    private bool _accItem2Expanded;

    // ── Property tables ───────────────────────────────────────────────────
    private List<PropertyPanelItem> _accordionProperties = new()
    {
        new() { Label = "Multiple",     Value = "bool (default false)",   BadgeText = "Multi-open", BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Variant",      Value = "SgAccordionVariant",     BadgeText = "Style",      BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Compact",      Value = "bool",                   BadgeText = "Dense",      BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Size",         Value = "SgSize (Sm|Md|Lg)",     BadgeText = "Size",       BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Animated",     Value = "bool (default true)",    BadgeText = "Animation",  BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "ChildContent", Value = "RenderFragment",          BadgeText = "Content",    BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "CssClass",     Value = "string?",                 BadgeText = "Custom CSS", BadgeVariant = SgBadgeVariant.Info    },
    };

    private List<PropertyPanelItem> _accordionItemProperties = new()
    {
        new() { Label = "Title",            Value = "string",                       BadgeText = "Header",    BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Subtitle",         Value = "string?",                      BadgeText = "Subheader", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Expanded",         Value = "bool",                         BadgeText = "Open",      BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Disabled",         Value = "bool",                         BadgeText = "Disabled",  BadgeVariant = SgBadgeVariant.Warn    },
        new() { Label = "Icon",             Value = "string? (SVG)",                BadgeText = "Icon",      BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "HeaderContent",    Value = "RenderFragment?",              BadgeText = "Custom",    BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "ExtraContent",     Value = "RenderFragment?",              BadgeText = "Actions",   BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "ChildContent",     Value = "RenderFragment?",              BadgeText = "Content",   BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "AnimationDuration",Value = "int (ms, default 250)",        BadgeText = "Duration",  BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "ExpandedChanged",  Value = "EventCallback<bool>",          BadgeText = "Event",     BadgeVariant = SgBadgeVariant.Success },
    };

    // ── Enum tables ──────────────────────────────────────────────────────────
    private List<PropertyPanelItem> _variantEnum = new()
    {
        new() { Label = "Default",   Value = "SgAccordionVariant.Default",   BadgeText = "Thin border",  BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Bordered",  Value = "SgAccordionVariant.Bordered",  BadgeText = "Clear border", BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Ghost",     Value = "SgAccordionVariant.Ghost",     BadgeText = "No border",    BadgeVariant = SgBadgeVariant.Muted   },
        new() { Label = "Filled",    Value = "SgAccordionVariant.Filled",    BadgeText = "Filled head",  BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Separated", Value = "SgAccordionVariant.Separated", BadgeText = "Cards",        BadgeVariant = SgBadgeVariant.Info    },
    };

    private List<PropertyPanelItem> _sizeEnum = new()
    {
        new() { Label = "Sm", Value = "SgSize.Sm", BadgeText = "Compact",  BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Md", Value = "SgSize.Md", BadgeText = "Default",  BadgeVariant = SgBadgeVariant.Info    },
        new() { Label = "Lg", Value = "SgSize.Lg", BadgeText = "Spacious", BadgeVariant = SgBadgeVariant.Info    },
    };
}
