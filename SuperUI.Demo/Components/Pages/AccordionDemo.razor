@page "/accordion-demo"
@using SuperUI.Components

<PageTitle>Аккордеон - SUI</PageTitle>

<SgCard Title="SgAccordion - Аккордеон"
        Subtitle="Компонент для отображения коллапсируемого содержимого. Поддерживает одновременное открытие нескольких элементов и кастомизацию.">

    <div style="margin-top: 32px;">
        <h2>Примеры использования</h2>
        <p>Интерактивный аккордеон с различными вариантами.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Базовый аккордеон (один открытый)">
                <SgAccordion>
                    <SgAccordionItem Title="Раздел 1" Expanded="true">
                        <div style="padding: 12px 0;">
                            Содержимое первого раздела. Здесь может быть любой HTML-контент.
                        </div>
                    </SgAccordionItem>
                    <SgAccordionItem Title="Раздел 2">
                        <div style="padding: 12px 0;">
                            Содержимое второго раздела с дополнительной информацией.
                        </div>
                    </SgAccordionItem>
                    <SgAccordionItem Title="Раздел 3">
                        <div style="padding: 12px 0;">
                            Содержимое третьего раздела. Можно добавлять сложные компоненты.
                        </div>
                    </SgAccordionItem>
                </SgAccordion>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_accordionProperties" />
            </SgCard>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 24px;">
            <SgCard Title="Множественное открытие">
                <SgAccordion Multiple="true">
                    <SgAccordionItem Title="Первый раздел" Expanded="true">
                        <div style="padding: 12px 0;">
                            Этот раздел открыт по умолчанию. При Multiple=true можно открыть несколько разделов одновременно.
                        </div>
                    </SgAccordionItem>
                    <SgAccordionItem Title="Второй раздел" Expanded="true">
                        <div style="padding: 12px 0;">
                            Этот раздел тоже открыт по умолчанию.
                        </div>
                    </SgAccordionItem>
                    <SgAccordionItem Title="Третий раздел">
                        <div style="padding: 12px 0;">
                            Этот раздел закрыт по умолчанию.
                        </div>
                    </SgAccordionItem>
                </SgAccordion>
            </SgCard>

            <SgCard Title="Свойства SgAccordionItem">
                <PropertyTable Items="_accordionItemProperties" />
            </SgCard>
        </div>
    </div>
    <div style="margin-top: 32px;">
        <h2>Варианты стиля (SgAccordionVariant)</h2>
        <p>Параметр <code>Variant</code> управляет внешним видом аккордеона.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Bordered">
                <SgAccordion Variant="SgAccordionVariant.Bordered">
                    <SgAccordionItem Title="Bordered раздел 1" Expanded="true">
                        <div style="padding: 12px 0;">Содержимое с чёткой границей.</div>
                    </SgAccordionItem>
                    <SgAccordionItem Title="Bordered раздел 2">
                        <div style="padding: 12px 0;">Второй раздел.</div>
                    </SgAccordionItem>
                </SgAccordion>
            </SgCard>

            <SgCard Title="Ghost">
                <SgAccordion Variant="SgAccordionVariant.Ghost">
                    <SgAccordionItem Title="Ghost раздел 1" Expanded="true">
                        <div style="padding: 12px 0;">Без границы.</div>
                    </SgAccordionItem>
                    <SgAccordionItem Title="Ghost раздел 2">
                        <div style="padding: 12px 0;">Второй раздел.</div>
                    </SgAccordionItem>
                </SgAccordion>
            </SgCard>
        </div>
    </div>

    <!-- Примеры кода -->
    <div style="margin-top: 32px;">
        <h2>Примеры кода</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Базовое использование">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_basicCode" />
            </SgCard>

            <SgCard Title="Перечисление SgAccordionVariant">
                <PropertyTable Items="_variantEnum" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private List<PropertyPanelItem> _accordionProperties = new()
    {
        new() { Label = "Multiple", Value = "bool", BadgeText = "Несколько открытых", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Содержимое", BadgeVariant = SgBadgeVariant.Info }
    };

    private List<PropertyPanelItem> _accordionItemProperties = new()
    {
        new() { Label = "Title",        Value = "string",          BadgeText = "Заголовок",   BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Expanded",     Value = "bool",            BadgeText = "Развёрнут",   BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ChildContent", Value = "RenderFragment",  BadgeText = "Содержимое",  BadgeVariant = SgBadgeVariant.Info }
    };

    // ── Enum tables ──────────────────────────────────────────────────────────
    private List<PropertyPanelItem> _variantEnum = new()
    {
        new() { Label = "SgAccordionVariant.Default",   Value = "\"default\"",   BadgeText = "Тонкая граница (по умолч.)", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "SgAccordionVariant.Bordered",  Value = "\"bordered\"",  BadgeText = "Чёткая граница",             BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgAccordionVariant.Ghost",     Value = "\"ghost\"",     BadgeText = "Без границы",                BadgeVariant = SgBadgeVariant.Muted },
        new() { Label = "SgAccordionVariant.Filled",    Value = "\"filled\"",    BadgeText = "Заливка заголовка",          BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgAccordionVariant.Separated", Value = "\"separated\"", BadgeText = "Карточки с отступами",       BadgeVariant = SgBadgeVariant.Info },
    };

    private string _basicCode = """
        <!-- Один открытый (по умолчанию) -->
        <SgAccordion>
            <SgAccordionItem Title="Раздел 1" Expanded="true">
                Содержимое первого раздела.
            </SgAccordionItem>
            <SgAccordionItem Title="Раздел 2">
                Содержимое второго раздела.
            </SgAccordionItem>
        </SgAccordion>

        <!-- Несколько открытых + стиль -->
        <SgAccordion Multiple="true" Variant="SgAccordionVariant.Bordered">
            <SgAccordionItem Title="Раздел A" Expanded="true">...</SgAccordionItem>
            <SgAccordionItem Title="Раздел B" Expanded="true">...</SgAccordionItem>
        </SgAccordion>
        """;
}
