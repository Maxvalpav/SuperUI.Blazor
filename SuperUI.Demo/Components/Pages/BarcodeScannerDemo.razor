@page "/barcode-scanner-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models

<PageTitle>Barcode Scanner — Сканер штрих-кодов - SUI</PageTitle>
<SgSeoHead Description="Сканирование штрих-кодов и QR-кодов на базе zxing-js — поддержка всех популярных форматов, выбор камеры, фонарик, захват изображения и загрузка из файла." />

<SgCard Title="SgBarcodeScanner — Сканер штрих-кодов и QR-кодов"
        Subtitle="Сканирование штрих-кодов и QR-кодов на базе zxing-js — поддержка всех популярных форматов, выбор камеры, фонарик, захват изображения и загрузка из файла.">

    <!-- Основной сканер -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Демонстрация сканирования</SgTypography>
        <p>Используйте камеру вашего устройства для мгновенного распознавания кодов или загрузите изображение для анализа.</p>

        <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Сканер">
                <SgBarcodeScanner @ref="_scanner"
                                   Title="@_title"
                                   VideoWidth="@_videoWidth"
                                   VideoHeight="@_videoHeight"
                                   StartCameraAutomatically="@_startAutomatically"
                                   ShowStart="@_showStart"
                                   ShowReset="@_showReset"
                                   ShowVideoDeviceList="@_showDeviceList"
                                   ShowToggleTorch="@_showTorch"
                                   ShowFileInput="@_showFileInput"
                                   DecodedPictureCapture="@_capturePicture"
                                   DecodeFormats="@_selectedFormats"
                                   OnBarcodeReceived="OnBarcodeReceived"
                                   OnError="OnError"
                                   OnDecodeError="OnDecodeError"
                                   OnDeviceListChanged="OnDeviceListChanged"
                                   OnSelectedDeviceChanged="OnSelectedDeviceChanged" />
            </SgCard>

            <SgCard Title="Параметры SgBarcodeScanner">
                <PropertyTable Items="_basicProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Настройки и результат -->
    <div style="margin-top: 32px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Конфигурация">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <SgTextBox TValue="string" @bind-Value="_title" Label="Заголовок сканера" Placeholder="Например: Вход по QR" />
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <SgNumberInput TValue="int" @bind-Value="_videoWidth" Label="Ширина видео" Min="320" Max="1280" />
                        <SgNumberInput TValue="int" @bind-Value="_videoHeight" Label="Высота видео" Min="240" Max="720" />
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <SgCheckBox @bind-Value="_startAutomatically" Label="Автозапуск" />
                        <SgCheckBox @bind-Value="_showStart" Label="Кнопка Старт" />
                        <SgCheckBox @bind-Value="_showTorch" Label="Фонарик" />
                        <SgCheckBox @bind-Value="_showFileInput" Label="Загрузка файла" />
                        <SgCheckBox @bind-Value="_capturePicture" Label="Снимок кода" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Последний результат">
                @if (_lastScan is not null)
                {
                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        <div style="padding: 16px; background: var(--sui-bg-muted); border-radius: 8px; border: 1px solid var(--sui-border);">
                            <div style="font-size: 11px; color: var(--sui-text-muted); text-transform: uppercase; margin-bottom: 4px;">Данные</div>
                            <div style="font-family: monospace; font-size: 16px; font-weight: 600; word-break: break-all;">@_lastScan.Text</div>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <div style="font-size: 11px; color: var(--sui-text-muted); text-transform: uppercase; margin-bottom: 4px;">Формат</div>
                                <SgBadge Text="@_lastScan.Format" Variant="SgBadgeVariant.Info" />
                            </div>
                            <SgButton Text="Копировать" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="CopyLastResult">
                                <Icon>@((MarkupString)SgIcons.Copy)</Icon>
                            </SgButton>
                        </div>
                        @if (_lastScan.Picture is not null)
                        {
                            <div style="border-radius: 8px; overflow: hidden; border: 1px solid var(--sui-border);">
                                <img src="@_lastScan.Picture" alt="Scan" style="width: 100%; height: auto; display: block;" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="color: var(--sui-text-muted); text-align: center; padding: 48px 24px; border: 2px dashed var(--sui-border); border-radius: 8px;">
                        Наведите камеру на код для сканирования
                    </div>
                }
            </SgCard>
        </div>
    </div>

    <!-- История -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">История сканирований</SgTypography>
        <SgCard Title="Предыдущие коды" Style="margin-top: 16px;">
            @if (_scanHistory.Count > 0)
            {
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    @foreach (var scan in _scanHistory)
                    {
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 16px; background: var(--sui-bg-muted); border-radius: 8px; border: 1px solid var(--sui-border);">
                            <div style="display: flex; align-items: center; gap: 12px; min-width: 0;">
                                <SgBadge Text="@scan.Format" Variant="SgBadgeVariant.Info" Size="SgSize.Sm" />
                                <span style="font-size: 14px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@scan.Text</span>
                            </div>
                            <SgButton Text="Детали" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="() => _lastScan = scan" />
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="color: var(--sui-text-muted); text-align: center; padding: 24px;">
                    История пуста
                </div>
            }
        </SgCard>
    </div>

</SgCard>

@code {
    private SgBarcodeScanner? _scanner;
    private string? _title = "Сканер";
    private int _videoWidth = 640;
    private int _videoHeight = 480;
    private bool _startAutomatically = false;
    private bool _showStart = true;
    private bool _showReset = true;
    private bool _showDeviceList = true;
    private bool _showTorch = true;
    private bool _showFileInput = true;
    private bool _capturePicture = true;
    private SgBarcodeReceivedEventArgs? _lastScan;
    private List<SgBarcodeReceivedEventArgs> _scanHistory = new();
    private IEnumerable<string> _selectedFormatNames = new List<string> { "All" };

    private List<SgBarcodeFormat> _selectedFormats => _selectedFormatNames.Select(name => Enum.Parse<SgBarcodeFormat>(name)).ToList();

    private void OnBarcodeReceived(SgBarcodeReceivedEventArgs e)
    {
        _lastScan = e;
        _scanHistory.Insert(0, e);
        if (_scanHistory.Count > 10) _scanHistory.RemoveAt(10);
        StateHasChanged();
    }

    private async Task CopyLastResult()
    {
        if (_lastScan is not null)
        {
            // Implementation of copy would go here via JS
            Console.WriteLine($"Copied: {_lastScan.Text}");
        }
    }

    private void OnError(string error) => Console.WriteLine($"Error: {error}");
    private void OnDecodeError(string error) => Console.WriteLine($"Decode error: {error}");
    private void OnDeviceListChanged(SgDeviceListChangedEventArgs e) => Console.WriteLine($"Devices: {e.Devices.Count}");
    private void OnSelectedDeviceChanged(string deviceId) => Console.WriteLine($"Device changed: {deviceId}");

    private List<PropertyPanelItem> _basicProperties = new()
    {
        new() { Label = "VideoWidth", Value = "int", BadgeText = "Ширина видео", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "VideoHeight", Value = "int", BadgeText = "Высота видео", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ShowStart", Value = "bool", BadgeText = "Кнопка старта", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "ShowToggleTorch", Value = "bool", BadgeText = "Фонарик", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "ShowFileInput", Value = "bool", BadgeText = "Загрузка файла", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "DecodedPictureCapture", Value = "bool", BadgeText = "Снимок кода", BadgeVariant = SgBadgeVariant.Warn }
    };
}
