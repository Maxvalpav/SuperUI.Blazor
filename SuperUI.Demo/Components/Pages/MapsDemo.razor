@page "/maps-demo"
@using SuperUI.Components

<PageTitle>Google & Yandex Maps — SUI</PageTitle>
<SgSeoHead Description="Explore Google &amp; Yandex Maps — SuperUI Blazor component library demo with live examples, code snippets, and API documentation." />

<div class="maps-page">

    <!-- ── Header ──────────────────────────────────────────────────────── -->
    <div class="maps-header">
        <div>
            <h1 class="maps-title">SgGoogleMap / SgYandexMap</h1>
            <p class="maps-subtitle">Обвязки Google Maps и Яндекс Карт — маркеры, маршруты, полигоны</p>
        </div>
        <div class="maps-header-right">
            <span class="maps-label">Карта:</span>
            <button class="maps-tab-btn @(_activeMap == "google" ? "active" : "")"
                    @onclick='@(() => { _activeMap = "google"; StateHasChanged(); })'>
                <span>🌐</span> Google Maps
            </button>
            <button class="maps-tab-btn @(_activeMap == "yandex" ? "active" : "")"
                    @onclick='@(() => { _activeMap = "yandex"; StateHasChanged(); })'>
                <span>🗺</span> Яндекс Карты
            </button>
        </div>
    </div>

    <!-- ── Main ────────────────────────────────────────────────────────── -->
    <div class="maps-main">

        <!-- ── Map canvas ── -->
        <div class="maps-canvas">

            @if (_activeMap == "google")
            {
                <SgGoogleMap @ref="_gmap"
                             Options="@_gmapOpts"
                             Sources="@_gmapSources"
                             Markers="@_gmarkers"
                             Height="100%"
                             OnMapClick="OnGMapClick"
                             OnMarkerClick="OnGMarkerClick"
                             OnViewChanged="@(e => { _viewLat=e.CenterLat; _viewLon=e.CenterLon; _viewZoom=e.Zoom; StateHasChanged(); })" />
            }
            else
            {
                <SgYandexMap @ref="_ymap"
                             Options="@_ymapOpts"
                             Sources="@_ymapSources"
                             Markers="@_ymarkers"
                             Height="100%"
                             OnMapClick="OnYMapClick"
                             OnMarkerClick="OnYMarkerClick"
                             OnViewChanged="@(e => { _viewLat=e.CenterLat; _viewLon=e.CenterLon; _viewZoom=e.Zoom; StateHasChanged(); })" />
            }

            <!-- Route variants overlay -->
            @if (_routeResult?.Routes.Count > 1)
            {
                <div class="maps-route-overlay">
                    @for (var i = 0; i < _routeResult.Routes.Count; i++)
                    {
                        var ri = i;
                        var rv = _routeResult.Routes[ri];
                        <button class="maps-overlay-btn @(_routeResult.SelectedIndex == ri ? "active" : "")"
                                @onclick="@(() => SelectRoute(ri))">
                            <span class="maps-overlay-num">@(ri + 1)</span>
                            <span class="maps-overlay-dist">@rv.DistanceFormatted</span>
                            @if (rv.DurationMin.HasValue)
                            {
                                <span class="maps-overlay-time">@rv.DurationFormatted</span>
                            }
                        </button>
                    }
                </div>
            }

            @if (_routeLoading)
            {
                <div class="maps-loading-overlay">
                    <div class="maps-spinner"></div>
                    <span>Строим маршрут…</span>
                </div>
            }
        </div>

        <!-- ── Sidebar ── -->
        <div class="maps-sidebar">

            <!-- API Keys -->
            <SgCard Title="⚙ API ключи" style="margin-bottom:10px">
                @if (_activeMap == "google")
                {
                    <SgTextBox TValue="string"
                               @bind-Value="_googleApiKey"
                               Label="Google Maps API Key"
                               Placeholder="AIza..."
                               Hint="console.cloud.google.com → Maps JavaScript API" />
                    <SgButton Size="SgSize.Sm" Variant="@(HasApiKey ? SgButtonVariant.Primary : SgButtonVariant.Outlined)"
                              OnClick="ApplyGoogleKey" style="margin-top:6px" Block="true">
                        ✓ Применить ключ и перезагрузить карту
                    </SgButton>
                    @if (!HasApiKey)
                    {
                        <div style="font-size:10px;color:var(--sui-text-secondary);margin-top:4px">
                            ⚠ Без ключа доступна только прямая линия
                        </div>
                    }
                }
                else
                {
                    <SgTextBox TValue="string"
                               @bind-Value="_yandexApiKey"
                               Label="Yandex Maps API Key"
                               Placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                               Hint="developer.tech.yandex.ru → Карты JS API v3" />
                    <SgButton Size="SgSize.Sm" Variant="@(HasApiKey ? SgButtonVariant.Primary : SgButtonVariant.Outlined)"
                              OnClick="ApplyYandexKey" style="margin-top:6px" Block="true">
                        ✓ Применить ключ и перезагрузить карту
                    </SgButton>
                    @if (!HasApiKey)
                    {
                        <div style="font-size:10px;color:var(--sui-text-secondary);margin-top:4px">
                            ⚠ Без ключа доступна только прямая линия
                        </div>
                    }
                }
            </SgCard>

            <!-- Map type -->
            <SgCard Title="🗺 Тип карты" style="margin-bottom:10px">
                @if (_activeMap == "google")
                {
                    <div class="maps-type-grid">
                        @foreach (var t in _googleMapTypes)
                        {
                            var tt = t;
                            <button class="maps-type-btn @(_googleMapType == tt.Key ? "active" : "")"
                                    @onclick="@(() => SetGoogleMapType(tt.Key))">
                                <span>@tt.Value.Icon</span>
                                <span>@tt.Value.Name</span>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="maps-type-grid">
                        @foreach (var t in _yandexMapTypes)
                        {
                            var tt = t;
                            <button class="maps-type-btn @(_yandexMapType == tt.Key ? "active" : "")"
                                    @onclick="@(() => SetYandexMapType(tt.Key))">
                                <span>@tt.Value.Icon</span>
                                <span>@tt.Value.Name</span>
                            </button>
                        }
                    </div>
                    <div style="margin-top:8px">
                        <SgSwitch @bind-Value="_showTraffic" Label="Пробки"
                                  @bind-Value:after="StateHasChanged" />
                    </div>
                }
            </SgCard>

            <!-- Markers -->
            <SgCard Title="📍 Маркеры" style="margin-bottom:10px">
                <div class="maps-hint">💡 Кликните на карту чтобы добавить маркер</div>

                <div style="display:flex;gap:6px;margin-bottom:8px">
                    <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Primary"
                              OnClick="AddRandomMarker" Block="true">+ Случайный</SgButton>
                    <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Danger"
                              OnClick="ClearMarkers"
                              Disabled="@(ActiveMarkers.Count == 0)">✕ Все</SgButton>
                </div>

                <div class="maps-marker-list">
                    @foreach (var m in ActiveMarkers.Take(6))
                    {
                        var mm = m;
                        <div class="maps-marker-row">
                            <span class="maps-marker-dot" style="background:@(mm.Color ?? "#006fee")">@(mm.Icon ?? "📍")</span>
                            <div class="maps-marker-info">
                                <span class="maps-marker-name">@mm.Title</span>
                                <span class="maps-marker-coords">@mm.Latitude.ToString("F3"), @mm.Longitude.ToString("F3")</span>
                            </div>
                            <button class="maps-marker-del" @onclick="@(() => RemoveMarker(mm.Id))">✕</button>
                        </div>
                    }
                    @if (ActiveMarkers.Count > 6)
                    {
                        <div class="maps-marker-more">+@(ActiveMarkers.Count - 6) ещё</div>
                    }
                </div>
            </SgCard>

            <!-- Route -->
            <SgCard Title="🛣 Маршрут" style="margin-bottom:10px">
                <div class="maps-route-row">
                    <span class="maps-route-badge" style="background:#2563eb">A</span>
                    <SgCoordinateInput @bind-Latitude="_routeFromLat"
                                       @bind-Longitude="_routeFromLon"
                                       ShowCopyButton="false"
                                       ShowClearButton="false"
                                       CssClass="maps-coord" />
                </div>
                <div class="maps-route-row" style="margin-top:6px">
                    <span class="maps-route-badge" style="background:#dc2626">B</span>
                    <SgCoordinateInput @bind-Latitude="_routeToLat"
                                       @bind-Longitude="_routeToLon"
                                       ShowCopyButton="false"
                                       ShowClearButton="false"
                                       CssClass="maps-coord" />
                </div>

                <div class="maps-presets">
                    @foreach (var p in _routePresets)
                    {
                        var pp = p;
                        <button class="maps-preset-btn" @onclick="@(() => ApplyPreset(pp))">@pp.Name</button>
                    }
                </div>

                <div style="display:flex;gap:6px;margin-top:8px">
                    <SgButton Variant="SgButtonVariant.Primary"
                              Disabled="@_routeLoading"
                              Loading="@_routeLoading"
                              OnClick="DrawRoute" Block="true">
                        🗺 @(HasApiKey ? "Реальный маршрут" : "Прямой маршрут")
                    </SgButton>
                    @if (_routeDrawn)
                    {
                        <SgButton Variant="SgButtonVariant.Danger" OnClick="ClearRoute">✕</SgButton>
                    }
                </div>

                <div class="maps-route-options">
                    <SgSwitch @bind-Value="_routeAlternatives" Label="Альтернативы" />
                </div>

                @if (!HasApiKey)
                {
                    <div class="maps-route-hint">
                        💡 Введите API ключ выше для реального маршрута по дорогам
                    </div>
                }
                else
                {
                    <div class="maps-route-hint" style="border-left-color:var(--sui-success,#16a34a);background:rgba(22,163,74,0.05)">
                        ✅ Ключ введён. Убедитесь что в Google Cloud Console включены: <b>Maps JavaScript API</b> и <b>Directions API</b>
                    </div>
                }

                @if (_routeResult is not null)
                {
                    var best = _routeResult.Best;
                    <div class="maps-route-result">
                        <div class="maps-route-result-row">
                            <div class="maps-route-stat">
                                <span>📏 Расстояние</span>
                                <b>@_routeResult.DistanceFormatted</b>
                            </div>
                            @if (_routeResult.DurationMin.HasValue)
                            {
                                <div class="maps-route-stat">
                                    <span>⏱ Время</span>
                                    <b>@_routeResult.DurationFormatted</b>
                                </div>
                            }
                        </div>

                        <!-- Variants selector -->
                        @if (_routeResult.Routes.Count > 1)
                        {
                            <div class="maps-variants">
                                <div class="maps-variants-label">Варианты:</div>
                                @for (var i = 0; i < _routeResult.Routes.Count; i++)
                                {
                                    var ri = i;
                                    var rv = _routeResult.Routes[ri];
                                    <button class="maps-variant-btn @(_routeResult.SelectedIndex == ri ? "active" : "")"
                                            @onclick="@(() => SelectRoute(ri))">
                                        <span class="maps-variant-num">@(ri + 1)</span>
                                        <div class="maps-variant-info">
                                            <span>@rv.DistanceFormatted</span>
                                            @if (rv.DurationMin.HasValue)
                                            {
                                                <span>@rv.DurationFormatted</span>
                                            }
                                        </div>
                                        @if (ri == 0) { <span class="maps-variant-tag">Лучший</span> }
                                    </button>
                                }
                            </div>
                        }

                        @if (_routeResult.Straight)
                        {
                            <SgAlert Variant="SgAlertVariant.Warn" Dense="true" style="margin-top:6px"
                                     Text="Прямая линия (нет API ключа)" />
                        }
                        @if (!string.IsNullOrEmpty(_routeResult.Error) && !_routeResult.Ok)
                        {
                            string errText;
                            if (_routeResult.Error?.Contains("REQUEST_DENIED") == true)
                                errText = "Directions API не включён. В Google Cloud Console включите: Maps JavaScript API + Directions API для этого ключа.";
                            else if (_routeResult.Error?.Contains("ZERO_RESULTS") == true)
                                errText = "Маршрут не найден между этими точками.";
                            else if (_routeResult.Error?.Contains("NOT_FOUND") == true)
                                errText = "Одна из точек не найдена на карте.";
                            else
                                errText = $"Ошибка: {_routeResult.Error}";
                            <SgAlert Variant="SgAlertVariant.Danger" Dense="true" style="margin-top:6px"
                                     Text="@errText" />
                        }                        @if (_routeResult.Steps.Count > 0)
                        {
                            <div class="maps-steps">
                                @foreach (var s in _routeResult.Steps.Take(8))
                                {
                                    <div class="maps-step-row">
                                        <span class="maps-step-text">@s.Instruction</span>
                                        <span class="maps-step-dist">@s.Distance</span>
                                    </div>
                                }
                                @if (_routeResult.Steps.Count > 8)
                                {
                                    <div class="maps-step-more">+@(_routeResult.Steps.Count - 8) шагов</div>
                                }
                            </div>
                        }
                    </div>
                }
            </SgCard>

            <!-- Stats -->
            <SgCard Title="📊 Карта">
                <div class="maps-stat-grid">
                    <div class="maps-stat"><span>Широта</span><b>@_viewLat.ToString("F4")</b></div>
                    <div class="maps-stat"><span>Долгота</span><b>@_viewLon.ToString("F4")</b></div>
                    <div class="maps-stat"><span>Зум</span><b>@_viewZoom.ToString("F1")</b></div>
                    <div class="maps-stat"><span>Маркеров</span><b>@ActiveMarkers.Count</b></div>
                </div>

                @if (_lastClick is not null)
                {
                    <div style="margin-top:8px;font-size:11px;color:var(--sui-text-secondary)">
                        Последний клик: @_lastClick.Latitude.ToString("F5"), @_lastClick.Longitude.ToString("F5")
                    </div>
                }

                @if (_selectedMarkerTitle is not null)
                {
                    <SgAlert Variant="SgAlertVariant.Success" Dense="true" style="margin-top:8px"
                             Text="@($"Маркер: {_selectedMarkerTitle}")" />
                }
            </SgCard>

        </div>
    </div>
</div>

@code {
    private SgGoogleMap? _gmap;
    private SgYandexMap? _ymap;

    private string _activeMap = "google";

    // ── API keys ──────────────────────────────────────────────────────────────
    private string _googleApiKey = "";
    private string _yandexApiKey = "";
    // Sources are initialized with empty key — map loads without key first
    // When user enters key and clicks Apply, Sources updates → map reinitializes with key
    private SgGoogleMapSources _gmapSources = new();
    private SgYandexMapSources _ymapSources = new();

    // ── State ─────────────────────────────────────────────────────────────────
    private bool   _loading  = false;
    private double _viewLat  = 55.751, _viewLon = 37.618, _viewZoom = 10;
    private SgMapClickEventArgs? _lastClick;
    private string? _selectedMarkerTitle;
    private bool   _showTraffic = false;

    // ── Map types ─────────────────────────────────────────────────────────────
    private string _googleMapType = "roadmap";
    private string _yandexMapType = "map";

    private record MapTypeInfo(string Name, string Icon);
    private readonly Dictionary<string, MapTypeInfo> _googleMapTypes = new()
    {
        ["roadmap"]   = new("Схема",     "🗺"),
        ["satellite"] = new("Спутник",   "🛰"),
        ["hybrid"]    = new("Гибрид",    "🌍"),
        ["terrain"]   = new("Рельеф",    "⛰"),
    };
    private readonly Dictionary<string, MapTypeInfo> _yandexMapTypes = new()
    {
        ["map"]       = new("Схема",     "🗺"),
        ["satellite"] = new("Спутник",   "🛰"),
        ["hybrid"]    = new("Гибрид",    "🌍"),
    };

    // ── Map options ───────────────────────────────────────────────────────────
    private SgGoogleMapOptions _gmapOpts => new()
    {
        CenterLat = 55.751, CenterLon = 37.618, Zoom = 10,
        MapTypeId = _googleMapType switch {
            "satellite" => SgGoogleMapType.Satellite,
            "hybrid"    => SgGoogleMapType.Hybrid,
            "terrain"   => SgGoogleMapType.Terrain,
            _           => SgGoogleMapType.Roadmap,
        },
        ShowControls = true, ShowStreetView = false,
    };

    private SgYandexMapOptions _ymapOpts => new()
    {
        CenterLat = 55.751, CenterLon = 37.618, Zoom = 10,
        MapType = _yandexMapType switch {
            "satellite" => SgYandexMapType.Satellite,
            "hybrid"    => SgYandexMapType.Hybrid,
            _           => SgYandexMapType.Map,
        },
        ShowControls = true, ShowTraffic = _showTraffic,
    };

    // ── Markers ───────────────────────────────────────────────────────────────
    private static readonly Random _rnd = new(Environment.TickCount);

    private List<SgGoogleMapMarker> _gmarkers = new()
    {
        new() { Id="g1", Title="Кремль",        Latitude=55.7520, Longitude=37.6173, Color="#ef4444", Icon="🏛️" },
        new() { Id="g2", Title="Красная площадь",Latitude=55.7539, Longitude=37.6208, Color="#f59e0b", Icon="⭐" },
        new() { Id="g3", Title="Большой театр", Latitude=55.7601, Longitude=37.6155, Color="#8b5cf6", Icon="🎭" },
    };

    private List<SgYandexMapMarker> _ymarkers = new()
    {
        new() { Id="y1", Title="Кремль",        Latitude=55.7520, Longitude=37.6173, Color="#ef4444", Icon="🏛️" },
        new() { Id="y2", Title="Красная площадь",Latitude=55.7539, Longitude=37.6208, Color="#f59e0b", Icon="⭐" },
        new() { Id="y3", Title="Большой театр", Latitude=55.7601, Longitude=37.6155, Color="#8b5cf6", Icon="🎭" },
    };

    private List<dynamic> ActiveMarkers => _activeMap == "google"
        ? _gmarkers.Cast<dynamic>().ToList()
        : _ymarkers.Cast<dynamic>().ToList();

    // ── Route ─────────────────────────────────────────────────────────────────
    private double? _routeFromLat = 55.7520;
    private double? _routeFromLon = 37.6173;
    private double? _routeToLat   = 55.9726;
    private double? _routeToLon   = 37.4146;
    private bool    _routeDrawn        = false;
    private bool    _routeLoading      = false;
    private bool    _routeAlternatives = true;
    private SgMapRouteResult? _routeResult;

    // Always allow routing — if coords empty use fallback straight line
    private bool CanDrawRoute => true;

    private bool HasApiKey =>
        _activeMap == "google"
            ? !string.IsNullOrWhiteSpace(_googleApiKey)
            : !string.IsNullOrWhiteSpace(_yandexApiKey);

    private record RoutePreset(string Name, double FromLat, double FromLon, double ToLat, double ToLon);
    private readonly RoutePreset[] _routePresets =
    [
        new("Кремль→Арбат",    55.7520, 37.6173, 55.7490, 37.5960),
        new("Центр→Аэропорт",  55.7520, 37.6173, 55.9726, 37.4146),
        new("Москва→СПб",      55.7520, 37.6173, 59.9343, 30.3351),
    ];

    private static readonly string[] _names  = ["Офис","Склад","Магазин","Ресторан","Отель","Парк","Музей","Театр"];
    private static readonly string[] _icons  = ["🏢","📦","🏪","🍽️","🏨","🌳","🏛️","🎭"];
    private static readonly string[] _colors = ["#ef4444","#f59e0b","#10b981","#2563eb","#8b5cf6","#06b6d4","#ec4899","#f97316"];

    // ── Actions ───────────────────────────────────────────────────────────────

    private void ApplyGoogleKey()
    {
        _gmapSources = new SgGoogleMapSources
        {
            ApiKey = string.IsNullOrWhiteSpace(_googleApiKey) ? null : _googleApiKey.Trim()
        };
        StateHasChanged();
    }

    private void ApplyYandexKey()
    {
        _ymapSources = new SgYandexMapSources
        {
            ApiKey = string.IsNullOrWhiteSpace(_yandexApiKey) ? null : _yandexApiKey.Trim()
        };
        StateHasChanged();
    }

    private void SetGoogleMapType(string t) { _googleMapType = t; StateHasChanged(); }
    private void SetYandexMapType(string t) { _yandexMapType = t; StateHasChanged(); }

    private void ApplyPreset(RoutePreset p)
    {
        _routeFromLat = p.FromLat; _routeFromLon = p.FromLon;
        _routeToLat   = p.ToLat;   _routeToLon   = p.ToLon;
        StateHasChanged();
    }

    private void AddRandomMarker()
    {
        var i = _rnd.Next(_names.Length);
        var id = $"m{DateTime.Now.Ticks}";
        var lat = 55.6 + _rnd.NextDouble() * 0.3;
        var lon = 37.4 + _rnd.NextDouble() * 0.5;
        if (_activeMap == "google")
            _gmarkers = [.._gmarkers, new() { Id=id, Title=_names[i], Latitude=lat, Longitude=lon, Color=_colors[i%_colors.Length], Icon=_icons[i] }];
        else
            _ymarkers = [.._ymarkers, new() { Id=id, Title=_names[i], Latitude=lat, Longitude=lon, Color=_colors[i%_colors.Length], Icon=_icons[i] }];
        StateHasChanged();
    }

    private void ClearMarkers()
    {
        if (_activeMap == "google") _gmarkers = new();
        else _ymarkers = new();
        StateHasChanged();
    }

    private void RemoveMarker(string id)
    {
        if (_activeMap == "google") _gmarkers = _gmarkers.Where(m => m.Id != id).ToList();
        else _ymarkers = _ymarkers.Where(m => m.Id != id).ToList();
        StateHasChanged();
    }

    private async Task DrawRoute()
    {
        // Validate coords
        if (!_routeFromLat.HasValue || !_routeFromLon.HasValue ||
            !_routeToLat.HasValue   || !_routeToLon.HasValue)
        {
            _routeResult = new SgMapRouteResult { Ok = false, Error = "Введите координаты точек A и B или выберите пресет" };
            StateHasChanged();
            return;
        }

        _routeLoading = true; StateHasChanged();

        var apiKey = _activeMap == "google"
            ? (string.IsNullOrWhiteSpace(_googleApiKey) ? null : _googleApiKey.Trim())
            : (string.IsNullOrWhiteSpace(_yandexApiKey) ? null : _yandexApiKey.Trim());

        SgMapRouteResult result;
        if (_activeMap == "google")
            result = await (_gmap?.BuildRouteAsync(_routeFromLat!.Value, _routeFromLon!.Value, _routeToLat!.Value, _routeToLon!.Value, apiKey, _routeAlternatives) ?? Task.FromResult(new SgMapRouteResult()));
        else
            result = await (_ymap?.BuildRouteAsync(_routeFromLat!.Value, _routeFromLon!.Value, _routeToLat!.Value, _routeToLon!.Value, apiKey, _routeAlternatives) ?? Task.FromResult(new SgMapRouteResult()));

        _routeResult  = result;
        _routeDrawn   = true;
        _routeLoading = false;
        StateHasChanged();
    }

    private async Task SelectRoute(int idx)
    {
        if (_routeResult is null) return;
        _routeResult.SelectedIndex = idx;

        if (_activeMap == "google")
            await (_gmap?.SelectRouteAsync(idx) ?? Task.CompletedTask);
        else
            await (_ymap?.SelectRouteAsync(idx) ?? Task.CompletedTask);

        StateHasChanged();
    }

    private async Task ClearRoute()
    {
        if (_activeMap == "google")
        {
            await (_gmap?.ClearPolylineAsync("route")      ?? Task.CompletedTask);
            await (_gmap?.ClearPolylineAsync("__route__")  ?? Task.CompletedTask);
            await (_gmap?.ClearPolylineAsync("__route_0__") ?? Task.CompletedTask);
        }
        else
        {
            await (_ymap?.ClearPolylineAsync("route")      ?? Task.CompletedTask);
            await (_ymap?.ClearPolylineAsync("__route__")  ?? Task.CompletedTask);
            await (_ymap?.ClearPolylineAsync("__route_0__") ?? Task.CompletedTask);
        }
        _routeDrawn = false; _routeResult = null;
        StateHasChanged();
    }

    // ── Events ────────────────────────────────────────────────────────────────

    private void OnGMapClick(SgMapClickEventArgs e)    { _lastClick = e; _selectedMarkerTitle = null; StateHasChanged(); }
    private void OnYMapClick(SgMapClickEventArgs e)    { _lastClick = e; _selectedMarkerTitle = null; StateHasChanged(); }
    private void OnGMarkerClick(SgGoogleMapMarkerClickEventArgs e) { _selectedMarkerTitle = e.Title; StateHasChanged(); }
    private void OnYMarkerClick(SgYandexMapMarkerClickEventArgs e) { _selectedMarkerTitle = e.Title; StateHasChanged(); }
}
