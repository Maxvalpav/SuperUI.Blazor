@page "/query-builder"
@using SuperUI.Components

<PageTitle>Конструктор запросов - SUI</PageTitle>

<SgCard Title="SgQueryBuilder - Конструктор запросов" 
        Subtitle="Компонент для создания сложных фильтров и запросов с визуальным интерфейсом. Поддерживает логические операторы, условия и сохранение фильтров.">
    <!-- SgQueryBuilder -->
    <div style="margin-top: 32px;">
        <h2>Построение запроса</h2>
        <p>Интерактивный конструктор для создания условий фильтрации.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Конструктор запросов" Style="grid-column: 1 / -1;">
                <div style="margin-bottom: 16px; display: flex; gap: 12px;">
                    <SgCheckBox Label="Показать превью (LINQ/SQL)" @bind-Value="_showPreview" />
                    <SgCheckBox Label="Кнопки сохранения" @bind-Value="_showStorage" />
                </div>
                <div style="border: 1px solid var(--sui-border); border-radius: 4px; overflow: auto; background: white; padding: 16px;">
                    <SgQueryBuilder RootGroup="_queryGroup" 
                                    Fields="_queryFields" 
                                    OnChanged="HandleQueryChanged"
                                    ShowPreview="_showPreview"
                                    ShowStorageActions="_showStorage"
                                    StorageKey="demo-query" />
                </div>
                @if (!string.IsNullOrEmpty(_queryResult))
                {
                    <div style="margin-top: 16px; padding: 12px; background: var(--sui-bg-secondary); border-radius: 4px; border-left: 3px solid #1890ff;">
                        <div style="font-size: 11px; color: var(--sui-text-muted); text-transform: uppercase; margin-bottom: 4px;">Результат запроса</div>
                        <div style="font-size: 12px; font-family: monospace; word-break: break-all;">@_queryResult</div>
                    </div>
                }
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента" Style="grid-column: 1 / -1;">
                <PropertyTable Items="_queryBuilderProperties" />
            </SgCard>
        </div>
    </div>
</SgCard>

@code {
    private QueryGroup _queryGroup = new();
    private List<QueryField> _queryFields = new();
    private string _queryResult = string.Empty;
    private bool _showPreview = true;
    private bool _showStorage = true;

    private List<PropertyPanelItem> _queryBuilderProperties = new()
    {
        new() { Label = "RootGroup", Value = "QueryGroup", BadgeText = "Группа", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Fields", Value = "IReadOnlyList<QueryField>", BadgeText = "Поля", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "CssClass", Value = "string", BadgeText = "CSS класс", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "OnChanged", Value = "EventCallback<QueryGroup>", BadgeText = "Изменение", BadgeVariant = SgBadgeVariant.Success }
    };

    protected override void OnInitialized()
    {
        // Инициализируем доступные поля для конструктора запросов.
        // Типы (decimal, int, bool, DateTime со временем/без, string) автоматически
        // подбирают соответствующий инпут в фильтре: number / date / datetime-local / select.
        _queryFields = new()
        {
            new QueryField { Name = "FirstName",   Label = "Имя",          Type = typeof(string) },
            new QueryField { Name = "LastName",    Label = "Фамилия",      Type = typeof(string) },
            new QueryField { Name = "Department",  Label = "Отдел",        Type = typeof(string) },
            new QueryField { Name = "Age",         Label = "Возраст",      Type = typeof(int) },
            new QueryField { Name = "Salary",      Label = "Зарплата",     Type = typeof(decimal) },
            new QueryField { Name = "IsActive",    Label = "Активен",      Type = typeof(bool) },
            new QueryField { Name = "HireDate",    Label = "Дата найма",   Type = typeof(DateTime) },
            new QueryField { Name = "LastLogin",   Label = "Последний вход", Type = typeof(DateTime), ShowTime = true }
        };

        // Инициализируем начальный запрос
        _queryGroup = new()
        {
            Operator = QueryLogicOperator.And,
            Rules = new()
            {
                new QueryRule 
                { 
                    FieldName = "Salary", 
                    Operator = QueryFieldOperator.GreaterThan, 
                    Value = "100000" 
                }
            }
        };

        UpdateQueryResult();
    }

    private void HandleQueryChanged(QueryGroup group)
    {
        _queryGroup = group;
        UpdateQueryResult();
    }

    private void UpdateQueryResult()
    {
        _queryResult = FormatQueryGroup(_queryGroup);
    }

    private string FormatQueryGroup(QueryGroup group, int indent = 0)
    {
        var indentStr = new string(' ', indent * 2);
        var result = $"{indentStr}({group.Operator}\n";

        foreach (var rule in group.Rules)
        {
            var field = _queryFields.FirstOrDefault(f => f.Name == rule.FieldName);
            var fieldLabel = field?.Label ?? rule.FieldName ?? "?";
            result += $"{indentStr}  {fieldLabel} {rule.Operator} {rule.Value}\n";
        }

        foreach (var subGroup in group.Groups)
        {
            result += FormatQueryGroup(subGroup, indent + 1);
        }

        result += $"{indentStr})\n";
        return result;
    }
}

