@page "/chat-demo"
@using SuperUI.Components.Llm

<PageTitle>AI Chat Demo — SUI</PageTitle>

<div class="chat-demo-container">
    <div class="chat-demo-header">
        <h1>💬 AI Chat Component</h1>
        <p>Standalone LLM chat with multimodal support (images/PDFs) and multiple providers.</p>
    </div>

    <div class="chat-demo-layout">
        <div class="chat-demo-main">
            <SgChat Title="SuperUI Assistant" />
        </div>
        
        <div class="chat-demo-info">
            <h3>Features</h3>
            <ul>
                <li><strong>Multimodal:</strong> Send images and documents.</li>
                <li><strong>Streaming:</strong> Real-time token generation.</li>
                <li><strong>Multiple Providers:</strong> OpenAI, OpenRouter, and local WebLLM.</li>
                <li><strong>Extracted Service:</strong> Logic decoupled from RAG.</li>
            </ul>

            <div class="chat-demo-card">
                <h4>How to use</h4>
                <p>1. Open Settings (top right).</p>
                <p>2. Select provider and enter API Key.</p>
                <p>3. Click "Apply Settings".</p>
                <p>4. Start chatting!</p>
            </div>
        </div>
    </div>
</div>

<style>
    .chat-demo-container {
        padding: 20px 40px;
        max-width: 1600px;
        margin: 0 auto;
    }
    .chat-demo-header {
        margin-bottom: 32px;
    }
    .chat-demo-layout {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 32px;
        height: 800px;
    }
    .chat-demo-main {
        height: 100%;
    }
    .chat-demo-info h3 { margin-top: 0; }
    .chat-demo-info ul { padding-left: 20px; color: #4b5563; }
    .chat-demo-info li { margin-bottom: 8px; }
    .chat-demo-card {
        margin-top: 24px;
        padding: 16px;
        background: #f3f4f6;
        border-radius: 12px;
        font-size: 14px;
    }
    .chat-demo-card h4 { margin: 0 0 8px 0; }
    .chat-demo-card p { margin: 4px 0; color: #4b5563; }
</style>
