@page "/chat-demo"
@using SuperUI.Components.Llm

<PageTitle>AI Chat Demo — SUI</PageTitle>
<SgSeoHead Description="Explore AI Chat — SuperUI Blazor component library demo with live examples, code snippets, and API documentation." />

<div class="chat-demo-container">
    <div class="chat-demo-header">
        <SgTypography Variant="SgTypographyVariant.Heading3" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 12px; display: block;">💬 AI Chat Component</SgTypography>
        <p>Standalone LLM chat with multimodal support (images/PDFs) and multiple providers.</p>
    </div>

    <div class="chat-demo-layout">
        <SgChat Title="SuperUI Assistant" />
    </div>
</div>

<style>
    .chat-demo-container {
        padding: 20px 40px;
        max-width: 1600px;
        margin: 0 auto;
        height: 100vh;
        display: flex;
        flex-direction: column;
    }
    .chat-demo-header {
        margin-bottom: 24px;
        flex: 0 0 auto;
    }
    .chat-demo-layout {
        flex: 1;
        min-height: 0;
    }
</style>
