@page "/vertical-grid-demo"
@using SuperUI.Components

<PageTitle>Vertical Grid - SUI</PageTitle>

<SgCard Title="SgVerticalGrid — Вертикальная таблица свойств"
        Subtitle="Отображает данные одной записи в виде строк «Свойство — Значение». Поддерживает секции, поиск, инлайн-редактирование, копирование и кастомные шаблоны.">

    <div style="margin-top: 24px;">
        <h2>Базовый пример</h2>
        <p>Секции, bool-значения, бейджи, иконки, поиск, копирование.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgVerticalGrid Rows="_employeeRows"
                            ShowSearch="true"
                            ShowSections="true"
                            ShowStatusBar="true"
                            ShowCopyAll="true"
                            ShowRowCopy="true"
                            LabelWidth="42%" />

            <SgVerticalGrid Rows="_serverRows"
                            ShowSearch="true"
                            ShowSections="true"
                            ShowStatusBar="true"
                            LabelWidth="38%" />
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Инлайн-редактирование</h2>
        <p>Строки с <code>Editable=true</code> показывают кнопку редактирования при наведении. Нажмите Enter для сохранения, Esc — для отмены.</p>

        <div style="max-width: 560px; margin-top: 16px;">
            <SgVerticalGrid Rows="_editableRows"
                            RowsChanged="rows => { _editableRows = rows; StateHasChanged(); }"
                            ShowSearch="false"
                            ShowStatusBar="true"
                            LabelWidth="40%" />
        </div>

        @if (_lastEdited is not null)
        {
            <div style="margin-top: 10px; padding: 8px 12px; background: var(--sui-success-bg); border: 1px solid var(--sui-success-border); border-radius: var(--sui-radius-md); font-size: 12px; color: var(--sui-success);">
                Изменено: <strong>@_lastEdited.Label</strong> = «@_lastEdited.Value»
            </div>
        }
    </div>

    <div style="margin-top: 32px;">
        <h2>Кастомный шаблон значения</h2>
        <p>Параметр <code>ValueTemplate</code> позволяет рендерить произвольный контент в ячейке значения.</p>

        <div style="max-width: 560px; margin-top: 16px;">
            <SgVerticalGrid Rows="_templateRows" ShowSearch="false" ShowStatusBar="false" LabelWidth="38%">
                <ValueTemplate Context="row">
                    @if (row.Tag is string color && row.Label.Contains("Цвет"))
                    {
                        <span style="display:inline-flex;align-items:center;gap:8px;">
                            <span style="width:16px;height:16px;border-radius:3px;background:@color;border:1px solid var(--sui-border);flex-shrink:0;"></span>
                            <span>@color</span>
                        </span>
                    }
                    else if (row.Tag is int pct)
                    {
                        <span style="display:inline-flex;align-items:center;gap:8px;width:100%;">
                            <span style="flex:1;height:6px;background:var(--sui-bg-tertiary);border-radius:3px;overflow:hidden;">
                                <span style="display:block;height:100%;width:@(pct)%;background:var(--sui-accent);border-radius:3px;"></span>
                            </span>
                            <span style="font-size:11px;color:var(--sui-muted);min-width:28px;text-align:right;">@pct%</span>
                        </span>
                    }
                    else
                    {
                        <span>@row.Value</span>
                    }
                </ValueTemplate>
            </SgVerticalGrid>
        </div>
    </div>

    <div style="margin-top: 32px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
        <SgCard Title="Параметры SgVerticalGrid">
            <PropertyTable Items="_props" />
        </SgCard>
        <SgCard Title="Параметры SgVerticalGridRow">
            <PropertyTable Items="_rowProps" />
        </SgCard>
    </div>

</SgCard>

