@page "/llm-studio-demo"
@using SuperUI.Components

<PageTitle>LLM Studio Demo — SUI</PageTitle>
<SgSeoHead Description="Explore LLM Studio — SuperUI Blazor component library demo with live examples, code snippets, and API documentation." />

<div class="llm-studio-demo">
    <div class="llm-studio-header">
        <SgTypography Variant="SgTypographyVariant.Heading3" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 12px; display: block;">🧠 LLM Studio</SgTypography>
        <p>
            Полный набор возможностей провайдера: чат, генерация и редактирование
            изображений, STT/TTS, эмбеддинги, модерация, vision и video.
        </p>
    </div>

    <SgLlmStudio ShowSettings="true" />
</div>

<style>
    .llm-studio-demo {
        padding: 20px 40px;
        max-width: 1600px;
        margin: 0 auto;
    }
    .llm-studio-header {
        margin-bottom: 16px;
    }
</style>
