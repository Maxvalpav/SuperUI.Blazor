@page "/demo/card"
@using SuperUI.Demo.Components

<div class="demo-page">
    <div class="demo-hero">
        <section class="demo-hero-main">
            <div class="demo-header">
                <div class="demo-kicker">Layout Components</div>
                <h1 class="demo-title">SgCard</h1>
                <p class="demo-subtitle">
                    Flexible surface component for dashboards, settings panels, analytics blocks and content-rich summaries.
                    Supports variants, status accents, actions and interactive states.
                </p>
            </div>
        </section>

        <aside class="demo-hero-side">
            <div class="demo-side-title">Highlights</div>
            <div class="demo-pill-list">
                <span class="demo-pill demo-pill-accent">Composable</span>
                <span class="demo-pill">Status Accent</span>
                <span class="demo-pill">Selectable</span>
                <span class="demo-pill">Collapsible</span>
            </div>

            <div class="demo-meta-grid">
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Variants</span>
                    <span class="demo-meta-value">Default, Elevated, Outlined, Filled, Ghost</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Content</span>
                    <span class="demo-meta-value">Cover, header, body, actions, footer</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Behavior</span>
                    <span class="demo-meta-value">Hover, select, collapse, loading</span>
                </div>
            </div>
        </aside>
    </div>

    <SgDemoSection Eyebrow="Usage" Title="Examples" Description="Common card compositions for dashboards, settings and feature highlights.">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Variants</h3>
                    <p class="demo-showcase-desc">Choose the right surface depth for the layout hierarchy.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-grid-cards">
                        <SgCard Title="Default" Subtitle="Balanced card">
                            Standard surface with soft border and spacing.
                        </SgCard>
                        <SgCard Title="Elevated" Variant="SgCardVariant.Elevated">
                            Stronger shadow to pull the card forward.
                        </SgCard>
                        <SgCard Title="Outlined" Variant="SgCardVariant.Outlined">
                            Crisp edge with minimal visual weight.
                        </SgCard>
                        <SgCard Title="Filled" Variant="SgCardVariant.Filled">
                            Great for secondary contextual panels.
                        </SgCard>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Status Accents</h3>
                    <p class="demo-showcase-desc">Visual status stripe helps scan health or workflow state fast.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-grid-auto">
                        <SgCard Title="Success" Status="SgCardStatus.Success">Task completed successfully.</SgCard>
                        <SgCard Title="Warning" Status="SgCardStatus.Warning">Review requires attention.</SgCard>
                        <SgCard Title="Danger" Status="SgCardStatus.Danger">Critical issue detected.</SgCard>
                        <SgCard Title="Info" Status="SgCardStatus.Info">New update available.</SgCard>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Interactive States</h3>
                    <p class="demo-showcase-desc">Cards can feel like controls when needed.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-grid-cards">
                        <SgCard Title="Hoverable" Hoverable="true">
                            Lifts on hover for discoverable actions.
                        </SgCard>
                        <SgCard Title="Selectable" Selectable="true" @bind-Selected="_isSelected">
                            Click to select. Current value: @_isSelected
                        </SgCard>
                        <SgCard Title="Collapsible" Collapsible="true">
                            Hide the body while keeping the header visible.
                        </SgCard>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Rich Content</h3>
                    <p class="demo-showcase-desc">A realistic marketing or product highlight block.</p>
                </div>
                <div class="demo-preview">
                    <SgCard Title="SuperUI Framework" Subtitle="Modern Blazor Components">
                        <CoverContent>
                            <div style="height:140px; background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%); display:flex; align-items:center; justify-content:center; color:white; font-size:24px; font-weight:bold;">
                                SuperUI
                            </div>
                        </CoverContent>
                        <ActionContent>
                            <SgButton Variant="SgButtonVariant.Ghost" Size="SgSize.Sm">
                                <Icon>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                                </Icon>
                            </SgButton>
                        </ActionContent>
                        <ChildContent>
                            The most advanced component library for Blazor developers who care about performance, render-safety and polished UI ergonomics.
                        </ChildContent>
                        <FooterContent>
                            <div style="display:flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;">
                                <span class="demo-inline-value">Version 1.0.0</span>
                                <SgButton Text="Get Started" Size="SgSize.Sm" Variant="SgButtonVariant.Primary" />
                            </div>
                        </FooterContent>
                    </SgCard>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoParams Title="Card Parameters" Description="Parameters for customizing the appearance and behavior of the SgCard component.">
        <SgDemoParam Name="Title" Type="string" Description="The main title of the card." DefaultValue="null" />
        <SgDemoParam Name="Subtitle" Type="string" Description="The subtitle of the card." DefaultValue="null" />
        <SgDemoParam Name="Icon" Type="string" Description="An optional icon string to display in the header." DefaultValue="null" />
        <SgDemoParam Name="Variant" Type="SgCardVariant" Description="The visual variant of the card." Values="Default, Elevated, Outlined, Filled, Ghost" DefaultValue="Default" />
        <SgDemoParam Name="Size" Type="SgSize" Description="The size of the card (controls padding and font sizes)." Values="Sm, Md, Lg" DefaultValue="Md" />
        <SgDemoParam Name="Status" Type="SgCardStatus" Description="Adds a semantic status accent stripe." Values="None, Info, Success, Warning, Danger, Muted" DefaultValue="None" />
        <SgDemoParam Name="Bordered" Type="bool" Description="Whether to display a border." DefaultValue="true" />
        <SgDemoParam Name="Hoverable" Type="bool" Description="Whether the card responds to hover events." DefaultValue="false" />
        <SgDemoParam Name="Loading" Type="bool" Description="Whether the card is in a loading state (shows a skeleton)." DefaultValue="false" />
        <SgDemoParam Name="Collapsible" Type="bool" Description="Whether the card can be collapsed." DefaultValue="false" />
        <SgDemoParam Name="Collapsed" Type="bool" Description="The current collapsed state." DefaultValue="false" />
        <SgDemoParam Name="Selectable" Type="bool" Description="Whether the card is selectable." DefaultValue="false" />
        <SgDemoParam Name="Selected" Type="bool" Description="The current selected state." DefaultValue="false" />
        <SgDemoParam Name="NoPadding" Type="bool" Description="Whether to remove default padding from the card body." DefaultValue="false" />
        <SgDemoParam Name="CoverContent" Type="RenderFragment" Description="Custom content for the card cover area." DefaultValue="null" />
        <SgDemoParam Name="HeaderContent" Type="RenderFragment" Description="Custom content for the card header area." DefaultValue="null" />
        <SgDemoParam Name="ActionContent" Type="RenderFragment" Description="Custom content for the card actions area (in header)." DefaultValue="null" />
        <SgDemoParam Name="ChildContent" Type="RenderFragment" Description="The main body content of the card." DefaultValue="null" />
        <SgDemoParam Name="FooterContent" Type="RenderFragment" Description="Custom content for the card footer area." DefaultValue="null" />
    </SgDemoParams>
</div>

@code {
    private bool _isSelected;
}
