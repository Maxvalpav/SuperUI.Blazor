@page "/autocomplete-demo"
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>SgAutoComplete — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Basic Usage                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Basic Usage
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Start typing to filter suggestions. <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">AllowClear</SgTypography> adds a clear button.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Programming Languages
                        </SgTypography>
                        <SgAutoComplete TItem="string"
                                        @bind-Value="@_lang"
                                        Items="@_languages"
                                        Label="Language"
                                        Placeholder="Type to search..."
                                        MinCharacters="0" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Countries (with clear)
                        </SgTypography>
                        <SgAutoComplete TItem="string"
                                        @bind-Value="@_country"
                                        Items="@_countries"
                                        Label="Country"
                                        Placeholder="Type a country..."
                                        AllowClear="true" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Selected Values
                        </SgTypography>
                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                            <SgBadge Variant="SgBadgeVariant.Info" Text="@(_lang ?? "—")" Standalone="true" />
                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">/</SgTypography>
                            <SgBadge Variant="SgBadgeVariant.Success" Text="@(_country ?? "—")" Standalone="true" />
                        </SgStack>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="SgAutoComplete Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_acProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Custom Objects                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Custom Objects — LabelSelector
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">LabelSelector</SgTypography> to define how each item is displayed in the list and after selection.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="User Picker" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgAutoComplete TItem="UserItem"
                                    @bind-Value="@_selectedUser"
                                    Items="@_users"
                                    LabelSelector="@(u => $"{u.Name} ({u.Email})")"
                                    Label="User"
                                    Placeholder="Search by name or email..."
                                    AllowClear="true" />

                    @if (_selectedUser != null)
                    {
                        <div style="padding:12px;background:var(--sg-surface-alt);border-radius:6px;font-size:13px;">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)" Style="width:60px;">Name</SgTypography>
                                    <SgTypography>@_selectedUser.Name</SgTypography>
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)" Style="width:60px;">Email</SgTypography>
                                    <SgTypography>@_selectedUser.Email</SgTypography>
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Color="var(--sg-text-muted)" Style="width:60px;">Role</SgTypography>
                                    <SgTag Color="GetTagColor(_selectedUser.Role)" Size="SgSize.Sm">@_selectedUser.Role</SgTag>
                                </SgStack>
                            </SgStack>
                        </div>
                    }
                    else
                    {
                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">No user selected</SgTypography>
                    }
                </SgStack>
            </SgCard>

            <SgCard Title="Parameters" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_acObjectProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Variants & Sizes                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Variants & Sizes
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Three visual variants and three sizes. Compact (Sm) for dense UIs, Large (Lg) for prominent inputs.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Variants" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:6px;">
                            Outlined (default)
                        </SgTypography>
                        <SgAutoComplete TItem="string" Items="@_languages"
                                        Label="Outlined" Placeholder="Variant=Outlined" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:6px;">
                            Filled
                        </SgTypography>
                        <SgAutoComplete TItem="string" Items="@_languages"
                                        Label="Filled" Placeholder="Variant=Filled"
                                        Variant="SgCascaderVariant.Filled" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:6px;">
                            Borderless
                        </SgTypography>
                        <SgAutoComplete TItem="string" Items="@_languages"
                                        Label="Borderless" Placeholder="Variant=Borderless"
                                        Variant="SgCascaderVariant.Borderless" />
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Sizes" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:6px;">
                            Small (Size=Sm)
                        </SgTypography>
                        <SgAutoComplete TItem="string" Items="@_languages"
                                        Label="Compact" Placeholder="Sm size"
                                        Size="SgSize.Sm" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:6px;">
                            Medium (Size=Md, default)
                        </SgTypography>
                        <SgAutoComplete TItem="string" Items="@_languages"
                                        Label="Default" Placeholder="Md size" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:6px;">
                            Large (Size=Lg)
                        </SgTypography>
                        <SgAutoComplete TItem="string" Items="@_languages"
                                        Label="Large" Placeholder="Lg size"
                                        Size="SgSize.Lg" />
                    </div>
                </SgStack>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. States & Validation                                             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                States & Validation
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                All form states: normal, required, error, hint, disabled, and loading.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgAutoComplete TItem="string" @bind-Value="@_stateNormal"
                                    Items="@_languages"
                                    Label="Normal" Placeholder="Normal state" />

                    <SgAutoComplete TItem="string" @bind-Value="@_stateRequired"
                                    Items="@_languages"
                                    Label="Required" Placeholder="Must select a value"
                                    Required="true" />

                    <SgAutoComplete TItem="string" @bind-Value="@_stateError"
                                    Items="@_languages"
                                    Label="With Error" Placeholder="Type..."
                                    ErrorText="Please select a language from the list" />

                    <SgAutoComplete TItem="string" @bind-Value="@_stateHint"
                                    Items="@_languages"
                                    Label="With Hint" Placeholder="Type..."
                                    Hint="Start typing to see suggestions" />

                    <SgAutoComplete TItem="string" Items="@_languages"
                                    Label="Disabled" Disabled="true" Value="@("C#")" />

                    <SgAutoComplete TItem="string" Items="@_languages"
                                    Label="Loading" Loading="true" Placeholder="Loading..." />
                </SgStack>
            </SgCard>

            <SgCard Title="State Parameters" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_acStateProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Search & Highlight                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Search & Highlight
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">MinCharacters</SgTypography> delays suggestions until enough input. <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">MaxResults</SgTypography> limits options. Matching text is highlighted by default.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Filtering Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            MinCharacters=2 (type at least 2 chars)
                        </SgTypography>
                        <SgAutoComplete TItem="string"
                                        @bind-Value="@_city2"
                                        Items="@_cities"
                                        Label="City"
                                        Placeholder="Type min 2 characters..."
                                        MinCharacters="2" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            MaxResults=3 (max 3 suggestions)
                        </SgTypography>
                        <SgAutoComplete TItem="string"
                                        @bind-Value="@_city3"
                                        Items="@_cities"
                                        Label="City"
                                        Placeholder="Only 3 suggestions..."
                                        MaxResults="3" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            DebounceMs=300 (with debounce)
                        </SgTypography>
                        <SgAutoComplete TItem="string"
                                        Items="@_languages"
                                        Label="Language"
                                        Placeholder="300ms debounce..."
                                        DebounceMs="300" />
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="Search Parameters" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_acSearchProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. Advanced Features                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Advanced Features
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Grouping, custom icons, prefix/suffix, custom templates, dropdown header/footer.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Grouped Options" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgAutoComplete TItem="FrameworkItem"
                                    @bind-Value="@_selectedFramework"
                                    Items="@_frameworks"
                                    LabelSelector="@(f => f.Name)"
                                    Label="Framework"
                                    Placeholder="Search frameworks..."
                                    GroupSelector="@(f => f.Category)" />
                    @if (_selectedFramework != null)
                    {
                        <div style="margin-top:8px;">
                            <SgTag Variant="SgTagVariant.Info" Size="SgSize.Sm">@_selectedFramework.Category: @_selectedFramework.Name</SgTag>
                        </div>
                    }
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Prefix / Suffix" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgAutoComplete TItem="string"
                                    Items="@_languages"
                                    Label="With Icons"
                                    Placeholder="Search language..."
                                    ShowSearchIcon="true">
                        <Prefix>
                            <span style="color:var(--sg-color-primary);font-size:13px;font-weight:600;">@@</span>
                        </Prefix>
                        <Suffix>
                            <SgTag Variant="SgTagVariant.Success" Size="SgSize.Sm">.NET</SgTag>
                        </Suffix>
                    </SgAutoComplete>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Custom Icons" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgAutoComplete TItem="string"
                                    Items="@_languages"
                                    Label="Custom Caret"
                                    Placeholder="Search..."
                                    ShowSearchIcon="true">
                        <CaretIconOverride>
                            <span style="color:var(--sg-color-primary);font-size:16px;">&#x25BC;</span>
                        </CaretIconOverride>
                    </SgAutoComplete>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Dropdown Header/Footer" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgAutoComplete TItem="string"
                                    Items="@_languages"
                                    Label="With Header/Footer"
                                    Placeholder="Search...">
                        <DropdownHeader>
                            <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <SgIcon Icon="@SgHeroicons.Outline.MagnifyingGlass" Style="width:12px;height:12px;" />
                                <span style="font-size:10px;font-weight:600;">SELECT A LANGUAGE</span>
                            </SgStack>
                        </DropdownHeader>
                        <DropdownFooter>
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">@_languages.Count languages available</SgTypography>
                        </DropdownFooter>
                    </SgAutoComplete>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="ItemTemplate" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgAutoComplete TItem="UserItem"
                                    @bind-Value="@_selectedUser2"
                                    Items="@_users"
                                    LabelSelector="@(u => u.Name)"
                                    Label="User Cards"
                                    Placeholder="Search users...">
                        <ItemTemplate Context="user">
                            <SgStack Vertical Style="flex:1;min-width:0;">
                                <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold">@user.Name</SgTypography>
                                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">@user.Email — @user.Role</SgTypography>
                            </SgStack>
                        </ItemTemplate>
                    </SgAutoComplete>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Fixed Position + MatchWidth" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgAutoComplete TItem="string"
                                    Items="@_languages"
                                    Label="Fixed Dropdown"
                                    Placeholder="Pinned to trigger width..."
                                    Fixed="true"
                                    MatchWidth="true" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 8. FilterOption + SortComparer                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                FilterOption &amp; SortComparer
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Custom filtering logic and initial sort order.
            </SgTypography>
        </div>
        <div class="demo-two-col">
            <SgCard Title="Fuzzy + Sorted" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgAutoComplete TItem="string"
                                Items="@_countries"
                                Label="Starts-with filter, sorted descending"
                                Placeholder="Type..."
                                FilterOption="@((item, q) => item.StartsWith(q, StringComparison.OrdinalIgnoreCase))"
                                SortComparer="@((a, b) => string.Compare(b, a, StringComparison.Ordinal))" />
            </SgCard>
            <SgCard Title="FilterOption signature" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_acFilterProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 9. AllowCreate                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                AllowCreate — Type to Add
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                When no match is found, a "Create" option lets you add a new item.
            </SgTypography>
        </div>
        <div class="demo-two-col">
            <SgCard Title="Create string items" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Sm">
                    <SgAutoComplete TItem="string"
                                    Items="@_createdLanguages"
                                    @bind-Value="@_newLang"
                                    Label="Language (create new)"
                                    Placeholder="Type a new language..."
                                    AllowCreate="true" />
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Selected: @(_newLang ?? "—")
                    </SgTypography>
                </SgStack>
            </SgCard>
            <SgCard Title="AllowCreate properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_acCreateProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 10. Collapsible Groups + ShowCheckedStrategy + OptionDescription  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Collapsible Groups, Checked Strategy &amp; Description
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Group headers can collapse/expand. Descriptions provide secondary info.
            </SgTypography>
        </div>
        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Collapsible Groups" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgAutoComplete TItem="FrameworkItem"
                                    Items="@_frameworks"
                                    LabelSelector="@(f => f.Name)"
                                    Label="Framework"
                                    Placeholder="Search..."
                                    GroupSelector="@(f => f.Category)"
                                    CollapsibleGroups="true"
                                    ShowCheckedStrategy="SgCheckedStrategy.ShowLeaf" />
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Option Descriptions" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgAutoComplete TItem="UserItem"
                                    Items="@_users"
                                    LabelSelector="@(u => u.Name)"
                                    Label="User with description"
                                    Placeholder="Search users..."
                                    OptionDescription="@(u => u.Email)" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 11. Animated + MenuElevation + AutoFocus + ShowAllOnFocus        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                UX Polish — Animation, Elevation, AutoFocus, ShowAllOnFocus
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Smooth animations, configurable shadow, automatic focus, and show-all-on-focus.
            </SgTypography>
        </div>
        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Elevated &amp; Animated" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgAutoComplete TItem="string"
                                    Items="@_languages"
                                    Label="Language"
                                    Placeholder="Try me..."
                                    Animated="true"
                                    MenuElevation="SgShadow.Lg" />
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="AutoFocus + ShowAllOnFocus" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgAutoComplete TItem="string"
                                    Items="@_languages"
                                    Label="Focused on load"
                                    Placeholder="Shows all on focus..."
                                    AutoFocus="true"
                                    ShowAllOnFocus="true" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 12. Live Constructor                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live SgAutoComplete Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure parameters and see the result in real time.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Variant -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Variant</SgTypography>
                            <SgSegmented TValue="SgCascaderVariant"
                                         Value="@_ctorVariant"
                                         ValueChanged="v => { _ctorVariant = v; UpdateCtorCode(); }"
                                         Block="true" Size="sm"
                                         Options="_variantSegOptions" />
                        </SgStack>

                        <!-- Size -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                            <SgSegmented TValue="SgSize"
                                         Value="@_ctorSize"
                                         ValueChanged="v => { _ctorSize = v; UpdateCtorCode(); }"
                                         Block="true" Size="sm"
                                         Options="_sizeSegOptions" />
                        </SgStack>

                        <!-- Toggles -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">ShowSearchIcon</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorShowSearch"
                                                 ValueChanged="v => { _ctorShowSearch = v; UpdateCtorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">AllowClear</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorAllowClear"
                                                 ValueChanged="v => { _ctorAllowClear = v; UpdateCtorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Disabled</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorDisabled"
                                                 ValueChanged="v => { _ctorDisabled = v; UpdateCtorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="_boolSegOptions2" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Loading</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorLoading"
                                                 ValueChanged="v => { _ctorLoading = v; UpdateCtorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="_boolSegOptions2" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- MinCharacters + MaxResults -->
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">MinChars</SgTypography>
                                    <SgSelect TValue="int"
                                              Value="@_ctorMinChars"
                                              ValueChanged="v => { _ctorMinChars = v; UpdateCtorCode(); }"
                                              Items="@_minCharOptions"
                                              Block="true" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">MaxResults</SgTypography>
                                    <SgSelect TValue="int"
                                              Value="@_ctorMaxResults"
                                              ValueChanged="v => { _ctorMaxResults = v; UpdateCtorCode(); }"
                                              Items="@_maxResultOptions"
                                              Block="true" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Variant</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorVariant.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Success" Text="@_ctorSize.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">MinCharacters</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorMinChars.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">MaxResults</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorMaxResults.ToString()" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <SgAutoComplete TItem="string"
                                            Items="@_languages"
                                            Label="Constructor Demo"
                                            Placeholder="Type to search..."
                                            Variant="@_ctorVariant"
                                            Size="@_ctorSize"
                                            ShowSearchIcon="@_ctorShowSearch"
                                            AllowClear="@_ctorAllowClear"
                                            Disabled="@_ctorDisabled"
                                            Loading="@_ctorLoading"
                                            MinCharacters="@_ctorMinChars"
                                            MaxResults="@_ctorMaxResults" />
                        </SgStack>

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                            <pre class="demo-code-block"><code>@_ctorCode</code></pre>
                            <SgSpace>
                                <SgButton Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" @onclick="CopyCtorCodeAsync">
                                    <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                        <SgIcon Icon="@SgHeroicons.Outline.Clipboard" Style="width:12px;height:12px;" />
                                        <span>Copy</span>
                                    </SgStack>
                                </SgButton>
                            </SgSpace>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

    </ChildContent>
</SgCard>

@code {
