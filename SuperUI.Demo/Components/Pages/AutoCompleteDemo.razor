    {
        new() { Value = false, Label = "Off" },
        new() { Value = true, Label = "On" }
    };

    private List<int> _minCharOptions = new() { 0, 1, 2, 3 };
    private List<int> _maxResultOptions = new() { 5, 10, 25, 50 };

    // ── Constructor state ──

    private SgCascaderVariant _ctorVariant = SgCascaderVariant.Outlined;
    private SgSize _ctorSize = SgSize.Md;
    private bool _ctorShowSearch = true;
    private bool _ctorAllowClear = true;
    private bool _ctorDisabled;
    private bool _ctorLoading;
    private int _ctorMinChars;
    private int _ctorMaxResults = 50;
    private string _ctorCode = "";

    protected override void OnInitialized()
    {
        UpdateCtorCode();
    }

    private void UpdateCtorCode()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("""<SgAutoComplete TItem="string" """);
        sb.AppendLine("""             Items="@_languages" """);
        sb.AppendLine("""             Label="Language" """);
        if (_ctorVariant != SgCascaderVariant.Outlined)
            sb.AppendLine($"             Variant=\"SgCascaderVariant.{_ctorVariant}\"");
        if (_ctorSize != SgSize.Md)
            sb.AppendLine($"             Size=\"SgSize.{_ctorSize}\"");
        if (!_ctorShowSearch)
            sb.AppendLine("             ShowSearchIcon=\"false\"");
        if (!_ctorAllowClear)
            sb.AppendLine("             AllowClear=\"false\"");
        if (_ctorDisabled)
            sb.AppendLine("             Disabled=\"true\"");
        if (_ctorLoading)
            sb.AppendLine("             Loading=\"true\"");
        if (_ctorMinChars > 0)
            sb.AppendLine($"             MinCharacters=\"{_ctorMinChars}\"");
        if (_ctorMaxResults < 50)
            sb.AppendLine($"             MaxResults=\"{_ctorMaxResults}\"");
        sb.Append(" />");
        _ctorCode = sb.ToString();
    }

    private async Task CopyCtorCodeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _ctorCode);
        }
        catch { }
    }

    // ── Records ──

    private record UserItem(string Name, string Email, string Role);
    private record FrameworkItem(string Name, string Category, string Ecosystem);
