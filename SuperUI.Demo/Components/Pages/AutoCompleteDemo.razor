@page "/autocomplete-demo"
@using SuperUI.Components

<PageTitle>Автодополнение - SUI</PageTitle>

<SgCard Title="SgAutoComplete - Автодополнение"
        Subtitle="Компонент для ввода текста с автоматическим предложением вариантов из списка. Поддерживает фильтрацию, минимальное количество символов, очистку и валидацию.">

    <!-- Базовое использование -->
    <div style="margin-top: 32px;">
        <h2>Базовое использование</h2>
        <p>Начните вводить текст — компонент предложит подходящие варианты.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgAutoComplete TItem="string"
                                    @bind-Value="@_lang"
                                    Items="@_languages"
                                    Label="Язык программирования"
                                    Placeholder="Начните вводить..." />

                    <SgAutoComplete TItem="string"
                                    @bind-Value="@_country"
                                    Items="@_countries"
                                    Label="Страна"
                                    Placeholder="Начните вводить..."
                                    AllowClear="true" />

                    <div style="font-size: 12px; color: var(--sui-text-muted);">
                        Выбрано: <strong>@(_lang ?? "—")</strong> / <strong>@(_country ?? "—")</strong>
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_acProperties" />
            </SgCard>
        </div>
    </div>

    <!-- MinCharacters -->
    <div style="margin-top: 32px;">
        <h2>Минимальное количество символов</h2>
        <p>Список появляется только после ввода заданного количества символов.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">MinCharacters=0 (сразу)</div>
                        <SgAutoComplete TItem="string"
                                        @bind-Value="@_city1"
                                        Items="@_cities"
                                        Label="Город"
                                        Placeholder="Нажмите или начните вводить"
                                        MinCharacters="0" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">MinCharacters=2 (после 2 символов)</div>
                        <SgAutoComplete TItem="string"
                                        @bind-Value="@_city2"
                                        Items="@_cities"
                                        Label="Город"
                                        Placeholder="Введите минимум 2 символа"
                                        MinCharacters="2" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">MaxResults=3 (максимум 3 варианта)</div>
                        <SgAutoComplete TItem="string"
                                        @bind-Value="@_city3"
                                        Items="@_cities"
                                        Label="Город"
                                        Placeholder="Начните вводить..."
                                        MaxResults="3" />
                    </div>
                </div>
            </SgCard>

            <SgCard Title="Параметры фильтрации">
                <PropertyTable Items="_acFilterProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Пользовательские объекты -->
    <div style="margin-top: 32px;">
        <h2>Пользовательские объекты</h2>
        <p>Автодополнение с объектами — используйте LabelSelector для отображения.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgAutoComplete TItem="UserItem"
                                    @bind-Value="@_selectedUser"
                                    Items="@_users"
                                    LabelSelector="@(u => $"{u.Name} ({u.Email})")"
                                    Label="Пользователь"
                                    Placeholder="Поиск по имени или email..." />

                    @if (_selectedUser != null)
                    {
                        <div style="padding: 12px; background: var(--sui-bg-secondary); border-radius: 6px; font-size: 13px;">
                            <div><strong>Выбран:</strong> @_selectedUser.Name</div>
                            <div><strong>Email:</strong> @_selectedUser.Email</div>
                            <div><strong>Роль:</strong> @_selectedUser.Role</div>
                        </div>
                    }
                </div>
            </SgCard>

            <SgCard Title="Параметры">
                <PropertyTable Items="_acObjectProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Состояния -->
    <div style="margin-top: 32px;">
        <h2>Состояния</h2>
        <p>Различные состояния компонента.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <SgAutoComplete TItem="string"
                                    @bind-Value="@_stateNormal"
                                    Items="@_languages"
                                    Label="Обычное поле"
                                    Placeholder="Начните вводить..." />

                    <SgAutoComplete TItem="string"
                                    @bind-Value="@_stateRequired"
                                    Items="@_languages"
                                    Label="Обязательное поле"
                                    Placeholder="Начните вводить..."
                                    Required="true" />

                    <SgAutoComplete TItem="string"
                                    @bind-Value="@_stateError"
                                    Items="@_languages"
                                    Label="Поле с ошибкой"
                                    Placeholder="Начните вводить..."
                                    ErrorText="Выберите язык из списка" />

                    <SgAutoComplete TItem="string"
                                    @bind-Value="@_stateHint"
                                    Items="@_languages"
                                    Label="Поле с подсказкой"
                                    Placeholder="Начните вводить..."
                                    Hint="Выберите язык программирования" />

                    <SgAutoComplete TItem="string"
                                    @bind-Value="@_stateDisabled"
                                    Items="@_languages"
                                    Label="Отключённое поле"
                                    Disabled="true" />
                </div>
            </SgCard>

            <SgCard Title="Параметры состояний">
                <PropertyTable Items="_acStateProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Code example -->
    <div style="margin-top: 32px;">
        <h2>Примеры кода</h2>
        <SgCode Language="SgCodeLanguage.Razor" Code="@_autoCompleteCode" />
    </div>

</SgCard>

@code {
    // Basic
    private string? _lang;
    private string? _country;

    // MinCharacters
    private string? _city1;
    private string? _city2;
    private string? _city3;

    // Custom objects
    private UserItem? _selectedUser;

    // States
    private string? _stateNormal;
    private string? _stateRequired;
    private string? _stateError;
    private string? _stateHint;
    private string? _stateDisabled = "C#";

    private List<string> _languages = new()
    {
        "C#", "C++", "Java", "JavaScript", "Python",
        "TypeScript", "Go", "Rust", "PHP", "Ruby",
        "Swift", "Kotlin", "Scala", "Haskell", "Elixir"
    };

    private List<string> _countries = new()
    {
        "Россия", "США", "Канада", "Великобритания", "Франция",
        "Германия", "Испания", "Италия", "Япония", "Китай",
        "Австралия", "Бразилия", "Индия", "Мексика", "Аргентина"
    };

    private List<string> _cities = new()
    {
        "Москва", "Санкт-Петербург", "Новосибирск", "Екатеринбург",
        "Казань", "Нижний Новгород", "Челябинск", "Самара",
        "Омск", "Ростов-на-Дону", "Уфа", "Красноярск"
    };

    private List<UserItem> _users = new()
    {
        new("Иван Петров", "ivan@example.com", "Разработчик"),
        new("Мария Сидорова", "maria@example.com", "Дизайнер"),
        new("Алексей Козлов", "alex@example.com", "Менеджер"),
        new("Елена Новикова", "elena@example.com", "Аналитик"),
        new("Дмитрий Волков", "dmitry@example.com", "DevOps")
    };

    private record UserItem(string Name, string Email, string Role);

    private List<PropertyPanelItem> _acProperties = new()
    {
        new() { Label = "TItem", Value = "generic", BadgeText = "Тип элемента", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Items", Value = "IEnumerable<TItem>", BadgeText = "Список вариантов", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Value", Value = "TItem?", BadgeText = "Выбранное значение", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ValueChanged", Value = "EventCallback<TItem?>", BadgeText = "Событие изменения", BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "Label", Value = "string", BadgeText = "Метка поля", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Placeholder", Value = "string", BadgeText = "Подсказка", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "AllowClear", Value = "bool (default: true)", BadgeText = "Кнопка очистки", BadgeVariant = SgBadgeVariant.Warn }
    };

    private List<PropertyPanelItem> _acFilterProperties = new()
    {
        new() { Label = "MinCharacters", Value = "int (default: 0)", BadgeText = "Мин. символов", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "MaxResults", Value = "int (default: 8)", BadgeText = "Макс. результатов", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "EmptyText", Value = "string", BadgeText = "Текст при пустом списке", BadgeVariant = SgBadgeVariant.Info }
    };

    private List<PropertyPanelItem> _acObjectProperties = new()
    {
        new() { Label = "LabelSelector", Value = "Func<TItem, string>", BadgeText = "Отображение элемента", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Block", Value = "bool (default: true)", BadgeText = "На всю ширину", BadgeVariant = SgBadgeVariant.Warn }
    };

    private List<PropertyPanelItem> _acStateProperties = new()
    {
        new() { Label = "Required", Value = "bool",   BadgeText = "Обязательное",    BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Disabled", Value = "bool",   BadgeText = "Отключить",       BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ErrorText",Value = "string", BadgeText = "Текст ошибки",    BadgeVariant = SgBadgeVariant.Danger },
        new() { Label = "Hint",     Value = "string", BadgeText = "Подсказка снизу", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "CssClass", Value = "string", BadgeText = "CSS класс",       BadgeVariant = SgBadgeVariant.Info }
    };

    // ── Code snippet ──────────────────────────────────────────────────────────
    private string _autoCompleteCode = """
        <!-- Строки -->
        <SgAutoComplete TItem="string"
                        @bind-Value="_lang"
                        Items="@_languages"
                        Label="Язык"
                        Placeholder="Начните вводить..."
                        MinCharacters="1"
                        MaxResults="5"
                        AllowClear="true" />

        <!-- Объекты с LabelSelector -->
        <SgAutoComplete TItem="User"
                        @bind-Value="_user"
                        Items="@_users"
                        LabelSelector="@(u => $"{u.Name} ({u.Email})")"
                        Label="Пользователь"
                        Placeholder="Поиск..." />

        @code {
            private string? _lang;
            private User? _user;
            private List<string> _languages = new() { "C#", "Go", "Rust" };
            private List<User> _users = new()
            {
                new("Иван", "ivan@example.com"),
                new("Мария", "maria@example.com")
            };
            private record User(string Name, string Email);
        }
        """;
}
