    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void Push(SgBadgeVariant variant)
    {
        _counter++;
        var (title, message) = variant switch
        {
            SgBadgeVariant.Success => ("Operation succeeded", $"Successful event #{_counter}"),
            SgBadgeVariant.Warn => ("Attention", $"Warning #{_counter}"),
            SgBadgeVariant.Danger => ("Error", $"Processing failure #{_counter}"),
            _ => ("Information", $"Information event #{_counter}")
        };
        Notifications.Push(title, message, variant, "Demo", "just now");
        var toastVariant = variant switch
        {
            SgBadgeVariant.Success => SgToastVariant.Success,
            SgBadgeVariant.Warn => SgToastVariant.Warn,
            SgBadgeVariant.Danger => SgToastVariant.Danger,
            _ => SgToastVariant.Default
        };
        Toasts.Show($"Notification sent (#{_counter})", "Done", toastVariant);
    }

    private void PushUrgent()
    {
        _counter++;
        Notifications.Push(new NotificationItem
        {
            Title = "CRITICAL: Service outage",
            Message = $"Payment gateway timeout — urgent investigation needed #{_counter}",
            Time = "just now",
            Variant = SgBadgeVariant.Danger,
            Priority = SgNotificationPriority.Urgent,
            Category = "Demo"
        });
        Toasts.Error($"Urgent notification sent (#{_counter})");
    }

    private void PushPinned()
    {
        _counter++;
        Notifications.Push(new NotificationItem
        {
            Title = "Pinned announcement",
            Message = $"This important notice stays at the top #{_counter}",
            Time = "just now",
            Variant = SgBadgeVariant.Warn,
            Priority = SgNotificationPriority.High,
            IsPinned = true,
            Category = "Demo"
        });
        Toasts.Show($"Pinned notification sent (#{_counter})", "Pinned", SgToastVariant.Warn);
    }

    private void PushWithAvatar()
    {
        _counter++;
        var names = new[] { "JD", "MR", "AK", "LP" };
        Notifications.Push(new NotificationItem
        {
            Title = $"{names[_counter % names.Length]} mentioned you",
