    private void PushWithChannel()
    {
        _counter++;
        var channels = new[] { "billing", "system", "email", "alerts" };
        Notifications.Push(new NotificationItem
        {
            Title = $"[{channels[_counter % channels.Length]}] Event #{_counter}",
            Message = $"Notification with channel '{channels[_counter % channels.Length]}'",
            Time = "just now",
