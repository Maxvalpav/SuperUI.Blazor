            Notifications.Push("Deploy completed", "Build v1.2.0 deployed to production.", SgBadgeVariant.Success, "System", "30 min ago");
            Notifications.Push("High API load", "CPU threshold exceeded on server api-2.", SgBadgeVariant.Warn, "System", "1 hour ago");
        }

        _avatarItems = new()
        {
            new()
            {
                Title = "Anna Petrova",
                Message = "Commented on task #142: \"Please review the PR when you have a moment.\"",
                Time = "5 min ago",
                Variant = SgBadgeVariant.Info,
                AvatarName = "AP",
                Tag = "New",
                Actions = new()
                {
                    new() { Text = "Reply", Icon = SgHeroicons.Outline.ArrowUturnLeft, OnClick = () => { Toasts.Info("Reply clicked"); return Task.CompletedTask; } },
                    new() { Text = "Resolve", OnClick = () => { Toasts.Success("Resolved"); return Task.CompletedTask; } }
