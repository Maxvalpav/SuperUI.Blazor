@page "/notification-panel-demo"
@using SuperUI.Components
@implements IDisposable
@inject SgToastService Toasts
@inject SgNotificationService Notifications

<PageTitle>Панель уведомлений - SUI</PageTitle>

<SgCard Title="SgNotificationPanel - Панель уведомлений"
        Subtitle="Список уведомлений с фильтром, отметкой прочитано/непрочитано, удалением и группировкой. Через SgNotificationService можно слать уведомления и в колокольчик в шапке.">

    <div style="margin-top: 24px;">
        <h2>Отправить уведомление</h2>
        <p>Кнопки ниже добавляют запись в общий <code>SgNotificationService</code>. Запись появится здесь и в колокольчике в шапке.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px;">
            <SgButton Text="Info" Variant="SgButtonVariant.Default" OnClick="@(() => Push(SgBadgeVariant.Default))" />
            <SgButton Text="Success" Variant="SgButtonVariant.Success" OnClick="@(() => Push(SgBadgeVariant.Success))" />
            <SgButton Text="Warning" Variant="SgButtonVariant.Default" OnClick="@(() => Push(SgBadgeVariant.Warn))" />
            <SgButton Text="Danger" Variant="SgButtonVariant.Danger" OnClick="@(() => Push(SgBadgeVariant.Danger))" />
            <SgButton Text="Очистить" Variant="SgButtonVariant.Default" OnClick="@(() => Notifications.Clear())" />
        </div>
    </div>

    <div style="margin-top: 24px; display: grid; grid-template-columns: minmax(360px, 420px) 1fr; gap: 24px; align-items: flex-start;">
        <SgNotificationPanel Items="Notifications.Items"
                             OnItemClick="HandleItemClick"
                             OnReadToggle="HandleReadToggle"
                             OnDismiss="HandleDismiss"
                             OnMarkAllRead="HandleMarkAllRead"
                             OnClearAll="HandleClearAll">
            <FooterContent>
                <a href="#" @onclick:preventDefault="true" @onclick="HandleViewAll">Все уведомления →</a>
            </FooterContent>
        </SgNotificationPanel>

        <SgCard Title="Свойства компонента">
            <PropertyTable Items="_properties" />
        </SgCard>
    </div>

    <div style="margin-top: 32px;">
        <h2>С группировкой по категории</h2>
        <p>Используйте параметр <code>GroupBy</code>, чтобы сгруппировать уведомления.</p>

        <div style="max-width: 420px;">
            <SgNotificationPanel Items="_grouped"
                                 GroupBy="@(n => n.Category ?? "Прочее")"
                                 ShowFilter="false"
                                 ShowDefaultActions="false" />
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Пустое состояние</h2>
        <div style="max-width: 420px;">
            <SgNotificationPanel Items="_empty" EmptyText="Пока нет уведомлений" />
        </div>
    </div>

    <!-- Code example -->
    <div style="margin-top: 32px;">
        <h2>Примеры кода</h2>
    </div>

</SgCard>

@code {
    private int _counter;

    private List<NotificationItem> _grouped = new()
    {
        new() { Title = "Резервное копирование", Message = "Бэкап БД выполнен", Time = "10:00", Variant = SgBadgeVariant.Success, Category = "Система" },
        new() { Title = "Сертификат истекает", Message = "TLS-сертификат истечёт через 7 дней", Time = "Вчера", Variant = SgBadgeVariant.Warn, Category = "Система" },
        new() { Title = "Новый клиент", Message = "ООО \"Ромашка\" подписал договор", Time = "Сегодня", Variant = SgBadgeVariant.Info, Category = "Продажи" },
        new() { Title = "Счёт оплачен", Message = "Счёт #INV-00481 оплачен", Time = "Сегодня", Variant = SgBadgeVariant.Success, Category = "Биллинг" }
    };

    private List<NotificationItem> _empty = new();

    private List<PropertyPanelItem> _properties = new()
    {
        new() { Label = "Items",              Value = "IEnumerable<NotificationItem>",  BadgeText = "Список",              BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Title",              Value = "string",                         BadgeText = "Заголовок панели",    BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ShowFilter",         Value = "bool",                           BadgeText = "Вкладки фильтра",     BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ShowDefaultActions", Value = "bool",                           BadgeText = "Кнопки в заголовке", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "AllowDismiss",       Value = "bool",                           BadgeText = "Удаление",            BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "AllowClear",         Value = "bool",                           BadgeText = "Очистить все",        BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "GroupBy",            Value = "Func<NotificationItem,string>?", BadgeText = "Группировка",         BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "MaxHeight",          Value = "string?",                        BadgeText = "Высота скролла",      BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "EmptyText",          Value = "string",                         BadgeText = "Пустое состояние",    BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "OnItemClick",        Value = "EventCallback<NotificationItem>",BadgeText = "Событие",             BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnReadToggle",       Value = "EventCallback<NotificationItem>",BadgeText = "Событие",             BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnDismiss",          Value = "EventCallback<NotificationItem>",BadgeText = "Событие",             BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnMarkAllRead",      Value = "EventCallback",                  BadgeText = "Событие",             BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnClearAll",         Value = "EventCallback",                  BadgeText = "Событие",             BadgeVariant = SgBadgeVariant.Success }
    };

    protected override void OnInitialized()
    {
        Notifications.Changed += OnChanged;
        if (Notifications.Items.Count == 0)
        {
            Notifications.Push("Новый комментарий", "Иван Петров ответил на ваш комментарий в задаче #142.", SgBadgeVariant.Info, "Сообщения", "5 мин назад");
            Notifications.Push("Деплой завершён", "Сборка v1.2.0 успешно задеплоена на production.", SgBadgeVariant.Success, "Система", "30 мин назад");
            Notifications.Push("Высокая нагрузка на API", "Превышен порог 80% по CPU на сервере api-2.", SgBadgeVariant.Warn, "Система", "1 ч назад");
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void Push(SgBadgeVariant variant)
    {
        _counter++;
        var (title, message) = variant switch
        {
            SgBadgeVariant.Success => ("Операция выполнена", $"Успешное событие №{_counter}"),
            SgBadgeVariant.Warn    => ("Внимание", $"Предупреждение №{_counter}"),
            SgBadgeVariant.Danger  => ("Ошибка", $"Сбой при обработке №{_counter}"),
            _                      => ("Информация", $"Информационное событие №{_counter}")
        };
        Notifications.Push(title, message, variant, "Демо", "только что");
        var toastVariant = variant switch
        {
            SgBadgeVariant.Success => SgToastVariant.Success,
            SgBadgeVariant.Warn    => SgToastVariant.Warn,
            SgBadgeVariant.Danger  => SgToastVariant.Danger,
            _                      => SgToastVariant.Default
        };
        Toasts.Show($"Уведомление отправлено в шапку (#{_counter})", "Готово", toastVariant);
    }

    private void HandleItemClick(NotificationItem item)
    {
        Notifications.MarkAsRead(item.Id);
        Toasts.Info($"Открыто: {item.Title}", "Уведомление");
    }

    private void HandleReadToggle(NotificationItem item) => Notifications.MarkAsRead(item.Id);

    private void HandleDismiss(NotificationItem item)
    {
        Notifications.Remove(item.Id);
        Toasts.Show($"Удалено: {item.Title}", "Уведомление", SgToastVariant.Default);
    }

    private void HandleMarkAllRead()
    {
        Notifications.MarkAllAsRead();
        Toasts.Success("Все уведомления отмечены как прочитанные");
    }

    private void HandleClearAll()
    {
        Notifications.Clear();
        Toasts.Show("Список уведомлений очищен", "Уведомление", SgToastVariant.Default);
    }

    private void HandleViewAll() => Toasts.Info("Переход на страницу всех уведомлений", "Навигация");

    public void Dispose() => Notifications.Changed -= OnChanged;
}
