            Channel = channels[_counter % channels.Length],
            Category = "Demo"
        });
        Toasts.Info($"Channel notification sent (#{_counter})");
    }

    private void PushToast()
    {
        _counter++;
        Notifications.PushToast("Toast alert", $"This is a transient toast #{_counter}", SgBadgeVariant.Info);
    }

    private void PushToastError()
    {
        _counter++;
        Notifications.PushToast("Error", $"Something went wrong #{_counter}", SgBadgeVariant.Danger, 6000);
    }

    private void UnsnoozeDue()
    {
        var count = Notifications.UnsnoozeDueItems();
        if (count > 0)
            Toasts.Success($"{count} snoozed notification(s) reappeared");
        else
            Toasts.Show("No snoozed items due", "Info", SgToastVariant.Default);
    }

    private void HandleItemClick(NotificationItem item)
    {
        if (!Notifications.Items.Any(x => x.Id == item.Id)) return;
        Notifications.MarkAsRead(item.Id);
        Toasts.Info($"Opened: {item.Title}", "Notification");
    }

    private void HandleReadToggle(NotificationItem item) => Notifications.ToggleRead(item.Id);

    private void HandleDismiss(NotificationItem item)
    {
        Notifications.Remove(item.Id);
        Toasts.Show($"Dismissed: {item.Title}", "Notification", SgToastVariant.Default);
    }

    private void HandleMarkAllRead()
    {
        Notifications.MarkAllAsRead();
        Toasts.Success("All notifications marked as read");
    }

    private void HandleClearAll()
    {
        Notifications.Clear();
        Toasts.Show("Notification list cleared", "Cleared", SgToastVariant.Default);
    }

    private void HandleBulkMarkRead(IEnumerable<string> ids)
    {
        Notifications.MarkManyAsRead(ids);
        Toasts.Success("Selected notifications marked as read");
    }

    private void HandleBulkDismiss(IEnumerable<string> ids)
    {
        Notifications.RemoveMany(ids);
        Toasts.Show("Selected notifications dismissed", "Bulk", SgToastVariant.Default);
    }

    private void HandleBulkMarkUnread(IEnumerable<string> ids)
    {
        Notifications.MarkManyAsUnread(ids);
        Toasts.Info("Selected notifications marked as unread");
    }

    private void HandleSnooze((string Id, DateTimeOffset Until) args)
    {
        Notifications.Snooze(args.Id, args.Until);
        var friendly = args.Until switch
        {
            { } when args.Until <= DateTimeOffset.Now.AddHours(2) => "1 hour",
            { } when args.Until <= DateTimeOffset.Now.AddHours(5) => "3 hours",
            { } when args.Until.Date == DateTimeOffset.Now.Date.AddDays(1) => "tomorrow",
            _ => "next week"
        };
        Toasts.Show($"Snoozed until {friendly}", "Snoozed", SgToastVariant.Info);
    }

    private void HandleViewAll() => Toasts.Info("Navigating to all notifications", "Navigation");

    // ── Code constructor ──────────────────────────────────────────────────
    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add("<SgNotificationPanel");
        lines.Add($"    Items=\"...\"");
        lines.Add($"    Title=\"Constructor Demo\"");
        if (!_showHeader) lines.Add($"    ShowHeader=\"false\"");
        if (_showFilter) lines.Add($"    ShowFilter=\"true\"");
        else lines.Add($"    ShowFilter=\"false\"");
        if (!_allowDismiss) lines.Add($"    AllowDismiss=\"false\"");
        if (!_showDefaultActions) lines.Add($"    ShowDefaultActions=\"false\"");
        if (!_showPinnedSeparately) lines.Add($"    ShowPinnedSeparately=\"false\"");
        if (_allowBulkActions) lines.Add($"    AllowBulkActions=\"true\"");
        if (_allowSearch) lines.Add($"    AllowSearch=\"true\"");
        if (_allowSnooze) lines.Add($"    AllowSnooze=\"true\"");
        if (_showChannel) lines.Add($"    ShowChannel=\"true\"");
        if (_collapsibleGroups) lines.Add($"    CollapsibleGroups=\"true\"");
        lines.Add($"    MaxHeight=\"300px\"");
        lines.Add($"    OnItemClick=\"...\"");
        lines.Add($"    OnReadToggle=\"...\"");
        lines.Add($"    OnDismiss=\"...\">");
        lines.Add($"    <FooterContent>...</FooterContent>");
        lines.Add("</SgNotificationPanel>");
        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyLabel = "✓ Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyLabel = "📋 Copy";
            StateHasChanged();
        }
        catch
        {
            _copyLabel = "✗ Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyLabel = "📋 Copy";
            StateHasChanged();
        }
    }

    public void Dispose() => Notifications.Changed -= OnChanged;
}
