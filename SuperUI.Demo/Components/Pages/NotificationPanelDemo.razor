@page "/notification-panel-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@implements IDisposable
@inject IJSRuntime JS
@inject SgToastService Toasts
@inject SgNotificationService Notifications

<PageTitle>SgNotificationPanel — Notifications — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Basic Notification Panel                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Basic Notification Panel
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Full-featured panel with filter tabs, bulk actions, and item-level read/dismiss controls. Uses the shared <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgNotificationService</SgTypography> so notifications also appear in the header bell icon.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Send & Manage Notifications" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                        Click a button below to push a notification. Items appear here and in the header bell at the top-right.
                    </SgTypography>

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:12px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Standard Variants
                        </SgTypography>
                        <SgStack Horizontal Space="SgSize.Md" Wrap="true">
                            <SgButton Text="Info" Variant="SgButtonVariant.Default" OnClick="@(() => Push(SgBadgeVariant.Info))" />
                            <SgButton Text="Success" Variant="SgButtonVariant.Success" OnClick="@(() => Push(SgBadgeVariant.Success))" />
                            <SgButton Text="Warning" Variant="SgButtonVariant.Default" OnClick="@(() => Push(SgBadgeVariant.Warn))" />
                            <SgButton Text="Danger" Variant="SgButtonVariant.Danger" OnClick="@(() => Push(SgBadgeVariant.Danger))" />
                            <SgButton Text="Urgent" Variant="SgButtonVariant.Danger" OnClick="@(() => PushUrgent())" />
                        </SgStack>
                    </div>

                    <SgDivider />

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:12px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Special Items
                        </SgTypography>
                        <SgStack Horizontal Space="SgSize.Md" Wrap="true">
                            <SgButton Text="Send Pinned" Variant="SgButtonVariant.Outlined" OnClick="@(() => PushPinned())" />
                            <SgButton Text="Send with Avatar" Variant="SgButtonVariant.Outlined" OnClick="@(() => PushWithAvatar())" />
                            <SgButton Text="Send with Channel" Variant="SgButtonVariant.Outlined" OnClick="@(() => PushWithChannel())" />
                            <SgButton Text="Clear All" Variant="SgButtonVariant.Ghost" OnClick="@(() => Notifications.Clear())" />
                        </SgStack>
                    </div>

                    <SgDivider />

                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:12px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Interactive
                        </SgTypography>
                        <SgStack Horizontal Space="SgSize.Md" Wrap="true">
                            <SgButton Text="Push Toast" Variant="SgButtonVariant.Default" OnClick="@(() => PushToast())" />
                            <SgButton Text="Error Toast" Variant="SgButtonVariant.Danger" OnClick="@(() => PushToastError())" />
                            <SgButton Text="Unsnooze Due" Variant="SgButtonVariant.Ghost" OnClick="@(() => UnsnoozeDue())" />
                        </SgStack>
                    </div>

                    <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center" Style="background:var(--sg-surface-alt);padding:12px;border-radius:8px;border:1px solid var(--sg-border-subtle);">
                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Medium">Total:</SgTypography>
                        <SgBadge Text="@Notifications.Items.Count.ToString()" Variant="SgBadgeVariant.Default" />
                        <div style="flex:1"></div>
                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Medium">Unread:</SgTypography>
                        <SgBadge Text="@Notifications.UnreadCount.ToString()" Variant="SgBadgeVariant.Danger" />
                    </SgStack>
                </SgStack>
            </SgCard>

            <SgCard Title="SgNotificationPanel Parameters" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_panelProperties" />
            </SgCard>
        </div>

        <div style="margin-top:16px;max-width:420px;">
            <SgNotificationPanel Items="Notifications.Items"
                                 OnItemClick="HandleItemClick"
                                 OnReadToggle="HandleReadToggle"
                                 OnDismiss="HandleDismiss"
                                 OnMarkAllRead="HandleMarkAllRead"
                                 OnClearAll="HandleClearAll"
                                 OnBulkMarkRead="HandleBulkMarkRead"
                                 OnBulkDismiss="HandleBulkDismiss"
                                 OnBulkMarkUnread="HandleBulkMarkUnread"
                                 OnSnooze="HandleSnooze"
                                 ShowPinnedSeparately="true"
                                 AllowBulkActions="true"
                                 AllowSearch="true"
                                 AllowSnooze="true"
                                 ShowChannel="true">
                <FooterContent>
                    <a href="#" @onclick:preventDefault="true" @onclick="HandleViewAll" style="color:var(--sg-color-primary);text-decoration:none;font-size:12px;font-weight:500;">
                        View all notifications →
                    </a>
                </FooterContent>
            </SgNotificationPanel>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Priority & Tags                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Priority Levels & Tags
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Items are automatically sorted by priority (Urgent → High → Normal → Low), then by timestamp. High and Urgent items show a pulsing indicator.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <div style="max-width:420px;">
                <SgNotificationPanel Items="_priorityItems"
                                     ShowFilter="false"
                                     ShowDefaultActions="false"
                                     ShowHeader="true"
                                     MaxHeight="340px"
                                     AllowDismiss="false"
                                     Title="Priority Inbox" />
            </div>

            <SgCard Title="SgNotificationPriority" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_priorityProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Avatars & Action Buttons                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Avatars, Tags & Action Buttons
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Items can display user avatars (image or initials), status tags, and inline action buttons.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <div style="max-width:420px;">
                <SgNotificationPanel Items="_avatarItems"
                                     ShowFilter="false"
                                     ShowDefaultActions="false"
                                     MaxHeight="340px"
                                     Title="Activity Feed" />
            </div>

            <SgCard Title="NotificationItem Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_itemProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Grouped by Category (collapsible)                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Grouped by Category (Collapsible)
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">GroupBy</SgTypography> with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">CollapsibleGroups=true</SgTypography> to let users collapse/expand groups.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <div style="max-width:420px;">
                <SgNotificationPanel Items="_groupedItems"
                                     GroupBy="@(n => n.Category ?? "Other")"
                                     CollapsibleGroups="true"
                                     ShowFilter="false"
                                     ShowDefaultActions="false"
                                     Title="Categorized"
                                     MaxHeight="320px" />
            </div>

            <SgCard Title="Collapsible & GroupBy" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Set <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">CollapsibleGroups="true"</SgTypography> to make group headers clickable. <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">GroupBy</SgTypography> accepts any <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Func&lt;NotificationItem, string&gt;</SgTypography>.
                </SgTypography>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Importance Threshold                                             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Importance Threshold
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Items at or below the threshold priority are hidden behind a "Show N more" link. Cleaner list for high-volume scenarios.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <div style="max-width:420px;">
                <SgNotificationPanel Items="_importanceItems"
                                     ImportanceThreshold="SgNotificationPriority.High"
                                     ShowFilter="false"
                                     ShowDefaultActions="false"
                                     Title="Threshold: High+"
                                     MaxHeight="320px" />
            </div>
            <SgCard Title="ImportanceThreshold" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Set <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ImportanceThreshold="SgNotificationPriority.High"</SgTypography> to show only High and Urgent items by default; Normal/Low items are collapsed.
                </SgTypography>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. Channels, Snooze & Swipe                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Channels, Snooze & Swipe
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Items with a <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Channel</SgTypography> value show a channel badge. Snooze lets you postpone items. Enable swipe-to-dismiss on touch devices.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <div style="max-width:420px;">
                <SgNotificationPanel Items="_channelItems"
                                     ShowFilter="false"
                                     ShowDefaultActions="false"
                                     ShowChannel="true"
                                     AllowSnooze="true"
                                     Title="Channels & Snooze"
                                     MaxHeight="340px" />
            </div>
            <SgCard Title="New Feature Parameters" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Enable <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ShowChannel</SgTypography> to display channel badges, <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">AllowSnooze</SgTypography> for snooze presets, and <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">AllowSwipeDismiss</SgTypography> for touch devices.
                </SgTypography>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 7. Empty State                                                      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Empty State
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                When no items exist and no filter matches, the panel shows an empty state with an icon and customizable text.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <div style="max-width:420px;">
                <SgNotificationPanel Items="@_emptyItems"
                                     EmptyText="You're all caught up!"
                                     ShowDefaultActions="false"
                                     Title="Inbox" />
            </div>

            <SgCard Title="Empty State Parameters" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_emptyProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 8. Live Constructor                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Tweak parameters below and see the panel update in real time. The generated code can be copied to your own project.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <SgStack Vertical Space="SgSize.Lg">
                <SgStack Horizontal Space="SgSize.Lg" Align="SgAlignItems.Center" Wrap="true">
                    <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Medium">Show Header:</SgTypography>
                    <SgSwitch @bind-Value="_showHeader" OnChange="@(() => UpdateConstructorCode())" ShowLabel="false" Size="SgSize.Sm" />
                </SgStack>

                <SgStack Horizontal Space="SgSize.Lg" Align="SgAlignItems.Center" Wrap="true">
                    <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Medium">Show Filter:</SgTypography>
                    <SgSwitch @bind-Value="_showFilter" OnChange="@(() => UpdateConstructorCode())" ShowLabel="false" Size="SgSize.Sm" />
                </SgStack>

                <SgStack Horizontal Space="SgSize.Lg" Align="SgAlignItems.Center" Wrap="true">
                    <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Medium">Allow Dismiss:</SgTypography>
                    <SgSwitch @bind-Value="_allowDismiss" OnChange="@(() => UpdateConstructorCode())" ShowLabel="false" Size="SgSize.Sm" />
                </SgStack>

                <SgStack Horizontal Space="SgSize.Lg" Align="SgAlignItems.Center" Wrap="true">
                    <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Medium">Show Default Actions:</SgTypography>
                    <SgSwitch @bind-Value="_showDefaultActions" OnChange="@(() => UpdateConstructorCode())" ShowLabel="false" Size="SgSize.Sm" />
                </SgStack>

                <SgStack Horizontal Space="SgSize.Lg" Align="SgAlignItems.Center" Wrap="true">
                    <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Medium">Pinned Separately:</SgTypography>
                    <SgSwitch @bind-Value="_showPinnedSeparately" OnChange="@(() => UpdateConstructorCode())" ShowLabel="false" Size="SgSize.Sm" />
                </SgStack>

                <SgStack Horizontal Space="SgSize.Lg" Align="SgAlignItems.Center" Wrap="true">
                    <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Medium">Allow Bulk Actions:</SgTypography>
                    <SgSwitch @bind-Value="_allowBulkActions" OnChange="@(() => UpdateConstructorCode())" ShowLabel="false" Size="SgSize.Sm" />
                </SgStack>

                <SgStack Horizontal Space="SgSize.Lg" Align="SgAlignItems.Center" Wrap="true">
                    <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Medium">Allow Search:</SgTypography>
                    <SgSwitch @bind-Value="_allowSearch" OnChange="@(() => UpdateConstructorCode())" ShowLabel="false" Size="SgSize.Sm" />
                </SgStack>

                <SgStack Horizontal Space="SgSize.Lg" Align="SgAlignItems.Center" Wrap="true">
                    <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Medium">Allow Snooze:</SgTypography>
                    <SgSwitch @bind-Value="_allowSnooze" OnChange="@(() => UpdateConstructorCode())" ShowLabel="false" Size="SgSize.Sm" />
                </SgStack>

                <SgStack Horizontal Space="SgSize.Lg" Align="SgAlignItems.Center" Wrap="true">
                    <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Medium">Show Channel:</SgTypography>
                    <SgSwitch @bind-Value="_showChannel" OnChange="@(() => UpdateConstructorCode())" ShowLabel="false" Size="SgSize.Sm" />
                </SgStack>

                <SgStack Horizontal Space="SgSize.Lg" Align="SgAlignItems.Center" Wrap="true">
                    <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Medium">Collapsible Groups:</SgTypography>
                    <SgSwitch @bind-Value="_collapsibleGroups" OnChange="@(() => UpdateConstructorCode())" ShowLabel="false" Size="SgSize.Sm" />
                </SgStack>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                    <div>
                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Style="margin-bottom:8px;display:block;">Preview</SgTypography>
                        <SgNotificationPanel Items="_constructorItems"
                                             ShowHeader="@_showHeader"
                                             ShowFilter="@_showFilter"
                                             AllowDismiss="@_allowDismiss"
                                             ShowDefaultActions="@_showDefaultActions"
                                             ShowPinnedSeparately="@_showPinnedSeparately"
                                             AllowBulkActions="@_allowBulkActions"
                                             AllowSearch="@_allowSearch"
                                             AllowSnooze="@_allowSnooze"
                                             ShowChannel="@_showChannel"
                                             CollapsibleGroups="@_collapsibleGroups"
                                             MaxHeight="300px"
                                             Title="Constructor Demo" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Style="margin-bottom:8px;display:block;">Generated Code</SgTypography>
                        <div style="position:relative;background:var(--sg-bg-subtle, #f5f5f5);border:1px solid var(--sg-border, #d0d0d0);border-radius:8px;padding:12px;font-size:12px;font-family:var(--sg-font-mono, monospace);">
                            <button type="button" @onclick="CopyCodeToClipboard" title="Copy code"
                                    style="position:absolute;top:8px;right:8px;padding:4px 10px;font-size:11px;background:var(--sg-bg, #fff);border:1px solid var(--sg-border, #d0d0d0);border-radius:4px;cursor:pointer;color:var(--sg-fg, #333);">
                                @_copyLabel
                            </button>
                            <pre style="margin:0;white-space:pre-wrap;word-break:break-word;"><code style="background:transparent;padding:0;font-size:12px;">@string.Join("\n", _generatedCodeLines)</code></pre>
                        </div>
                    </div>
                </div>
            </SgStack>
        </SgCard>
    </div>

    </ChildContent>
</SgCard>

@code {
    // ── Main card header ─────────────────────────────────────────────────
    private RenderFragment _mainHeader => __builder =>
    {
        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
            <div style="display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,var(--sg-primary),#8b5cf6);color:#fff;flex-shrink:0;">
                @((MarkupString)SgHeroicons.Outline.Bell)
            </div>
            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">Notification Panel</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    SgNotificationPanel — Filterable notification list with unread tracking, grouping, priority levels, pinning, avatars, action buttons, bulk ops, search, channels, snooze, swipe, and code constructor.
                </SgTypography>
            </SgStack>
        </SgStack>
    };

    // ── Demo data: priority items ─────────────────────────────────────────
    private List<NotificationItem> _priorityItems = new()
    {
        new() { Title = "Server down", Message = "Primary DB node is unreachable", Time = "2 min ago", Priority = SgNotificationPriority.Urgent, Variant = SgBadgeVariant.Danger },
        new() { Title = "SSL certificate expiring", Message = "TLS cert expires in 3 days", Time = "1 hour ago", Priority = SgNotificationPriority.High, Variant = SgBadgeVariant.Warn },
        new() { Title = "Deploy completed", Message = "v2.4.1 deployed to production", Time = "3 hours ago", Priority = SgNotificationPriority.Normal, Variant = SgBadgeVariant.Success },
        new() { Title = "Weekly report ready", Message = "Q3 analytics report generated", Time = "Yesterday", Priority = SgNotificationPriority.Low, Variant = SgBadgeVariant.Info }
    };

    // ── Demo data: avatar & action items ──────────────────────────────────
    private List<NotificationItem> _avatarItems = new();

    // ── Demo data: grouped items ──────────────────────────────────────────
    private List<NotificationItem> _groupedItems = new()
    {
        new() { Title = "Backup complete", Message = "DB backup finished", Time = "10:00", Variant = SgBadgeVariant.Success, Category = "System" },
        new() { Title = "Certificate expiring", Message = "TLS cert expires in 7 days", Time = "Yesterday", Variant = SgBadgeVariant.Warn, Category = "System" },
        new() { Title = "New client onboarded", Message = "LLC \"Example\" signed the contract", Time = "Today", Variant = SgBadgeVariant.Info, Category = "Sales" },
        new() { Title = "Invoice paid", Message = "Invoice #INV-00481 paid", Time = "Today", Variant = SgBadgeVariant.Success, Category = "Billing" }
    };

    // ── Demo data: importance threshold ───────────────────────────────────
    private List<NotificationItem> _importanceItems = new()
    {
        new() { Title = "CRITICAL: Payment failure", Message = "Payment gateway timeout", Time = "2 min ago", Priority = SgNotificationPriority.Urgent, Variant = SgBadgeVariant.Danger },
        new() { Title = "DB connection pool full", Message = "Connection pool reached 90% capacity", Time = "10 min ago", Priority = SgNotificationPriority.High, Variant = SgBadgeVariant.Warn },
        new() { Title = "Cache refresh done", Message = "Redis cache refreshed successfully", Time = "1 hour ago", Priority = SgNotificationPriority.Normal, Variant = SgBadgeVariant.Success },
        new() { Title = "Analytics export ready", Message = "Monthly report available for download", Time = "3 hours ago", Priority = SgNotificationPriority.Low, Variant = SgBadgeVariant.Info }
    };

    // ── Demo data: channels & snooze ─────────────────────────────────────
    private List<NotificationItem> _channelItems = new()
    {
