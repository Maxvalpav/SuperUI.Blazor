@page "/data-form-create"
@inject SgToastService Toasts

<PageTitle>Создание записи — SUI</PageTitle>
<SgSeoHead Description="Режим создания: пустая модель с валидацией обязательных полей." />

<div style="display:flex; flex-direction:column; gap:18px; max-width:800px;">
    <SgCard Title="Создание нового сотрудника">
        <div style="margin-bottom:16px;">
            <SgAlert Dense="true" Text="Режим создания: пустая модель с валидацией обязательных полей." />
        </div>
        
        <SgDataForm TModel="Employee"
                    Model="_newEmployee"
                    Columns="2"
                    SubmitText="Создать сотрудника"
                    OnValidSubmit="HandleCreate" />
    </SgCard>

    @if (_lastCreated != null)
    {
        <SgAlert Variant="SgAlertVariant.Success" Text="@($"Сотрудник {_lastCreated.FirstName} {_lastCreated.LastName} успешно создан!")" />
    }
</div>

@code {
    private Employee _newEmployee = new();
    private Employee? _lastCreated;

    private void HandleCreate(Employee model)
    {
        _lastCreated = model;
        Toasts.Success("Сотрудник успешно создан");
        _newEmployee = new(); // Сброс формы
    }
}

