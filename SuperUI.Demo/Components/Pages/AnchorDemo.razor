@page "/anchor-demo"
@using SuperUI.Components

<PageTitle>Anchor — SuperUI</PageTitle>

<SgCard Title="SgAnchor — Якорная навигация"
        Subtitle="Компонент для автоматического сканирования заголовков и создания навигационного меню с отслеживанием активного раздела.">
    
    <!-- Автосканирование -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Автоматическое сканирование</SgTypography>
        <p>Компонент автоматически находит заголовки H2 и H3 на странице и создает навигацию.</p>
        
        <div style="display: grid; grid-template-columns: 250px 1fr; gap: 24px; margin-top: 16px;">
            <SgAnchor AutoScan="true" 
                      Selector="h2, h3" 
                      Position="Sticky" 
                      ShowScrollProgress="true" 
                      Title="Содержание" />
            
            <div>
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" As="SgTypographyElement.H2" id="section1">Раздел 1: Введение</SgTypography>
                <p>Это первый раздел страницы. При скролле навигация слева будет подсвечивать текущий раздел.</p>
                <p>Текст для заполнения пространства. Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
                
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Bold" As="SgTypographyElement.H3" id="subsection1-1">Подраздел 1.1</SgTypography>
                <p>Детали первого раздела. Обратите внимание, как якорь реагирует на прокрутку.</p>
                <p>Еще больше текста, чтобы страница прокручивалась. Blazor - это круто!</p>
                
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" As="SgTypographyElement.H2" id="section2">Раздел 2: Основные возможности</SgTypography>
                <p>Второй раздел с описанием функций. Попробуйте нажать на ссылку в навигации.</p>
                
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Bold" As="SgTypographyElement.H3" id="subsection2-1">Подраздел 2.1</SgTypography>
                <p>Подробности о возможностях. Компонент SgAnchor идеально подходит для документации.</p>
                
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" As="SgTypographyElement.H2" id="section3">Раздел 3: Заключение</SgTypography>
                <p>Финальный раздел. Если вы дошли до этого места, значит навигация работает корректно.</p>
            </div>
        </div>
    </div>

    <!-- Ручное задание пунктов -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Ручное задание пунктов</SgTypography>
        <p>Можно передать список пунктов через параметр Items.</p>
        
        <SgCard Title="Пример" Style="margin-top: 16px;">
            <SgAnchor Items="@ManualItems" 
                      Position="Static" 
                      ShowBadge="true" />
        </SgCard>
    </div>

    <!-- Горизонтальная ориентация -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Горизонтальная ориентация</SgTypography>
        <p>Навигация может располагаться горизонтально.</p>
        
        <SgCard Title="Пример" Style="margin-top: 16px;">
            <SgAnchor Items="@ManualItems" 
                      Orientation="Horizontal" 
                      Position="Static" />
        </SgCard>
    </div>

    <!-- Свойства -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Свойства</SgTypography>
        <SgCard Title="Параметры SgAnchor" Style="margin-top: 16px;">
            <PropertyTable Items="_anchorProperties" />
        </SgCard>
    </div>

</SgCard>

@code {
    private List<AnchorItem> ManualItems = new()
    {
        new AnchorItem("sec1", "Главная", 2, false, "🏠"),
        new AnchorItem("sec2", "Услуги", 2, false, "⚙️"),
        new AnchorItem("sec3", "Контакты", 2, false, "📞"),
        new AnchorItem("sec2-1", "Веб-разработка", 3, false),
        new AnchorItem("sec2-2", "Дизайн", 3, false)
    };

    private List<PropertyPanelItem> _anchorProperties = new()
    {
        new() { Label = "AutoScan", Value = "bool (true)", BadgeText = "Автосканирование", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Selector", Value = "string (h2, h3, h4)", BadgeText = "Селектор", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Items", Value = "List<AnchorItem>", BadgeText = "Пункты", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Position", Value = "Static|Sticky|Fixed", BadgeText = "Позиция", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Orientation", Value = "Vertical|Horizontal", BadgeText = "Ориентация", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ShowScrollProgress", Value = "bool", BadgeText = "Прогресс", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowBadge", Value = "bool", BadgeText = "Бейдж", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "OnAnchorChanged", Value = "EventCallback<string>", BadgeText = "Событие", BadgeVariant = SgBadgeVariant.Success },
    };
}
