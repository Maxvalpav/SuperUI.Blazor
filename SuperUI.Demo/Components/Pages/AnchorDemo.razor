@page "/anchor-demo"
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>Anchor — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" HeaderContent="@_headerContent">
    @* ── Automatic Scanning ──────────────────────────────────────────────── *@
    <div class="sgc-demo-section" style="padding: 32px;">
        <div class="demo-section-header" style="margin-bottom: 24px;">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Bold">Automatic Scanning</SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                The component automatically discovers H2 and H3 tags within the target area and builds a navigation menu with scroll tracking.
            </SgTypography>
        </div>
        
        <div style="display: grid; grid-template-columns: 280px 1fr; gap: 48px; align-items: start;">
            <div style="position: sticky; top: 32px;">
                <SgCard Style="border-radius: 12px; border: 1px solid var(--sg-border-subtle); background: var(--sg-surface-alt);">
                    <div style="padding: 16px;">
                        <SgAnchor AutoScan="true" 
                                  Selector="h2, h3" 
                                  Position="Static" 
                                  ShowScrollProgress="true" 
                                  Title="On This Page" />
                    </div>
                </SgCard>
            </div>
            
            <div style="background: var(--sg-bg); padding: 40px; border-radius: 16px; border: 1px solid var(--sg-border); box-shadow: var(--sg-shadow-sm);">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" As="SgTypographyElement.H2" id="section1" Style="margin-bottom: 16px;">
                    1. Introduction to Anchor
                </SgTypography>
                <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" Style="margin-bottom: 24px; line-height: 1.7;">
                    Anchor navigation provides a smooth way to jump between different sections of a long page. 
                    It's particularly useful for documentation, articles, and landing pages.
                </SgTypography>
                
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold" As="SgTypographyElement.H3" id="subsection1-1" Style="margin-bottom: 12px; color: var(--sg-color-primary);">
                    1.1 Real-time Tracking
                </SgTypography>
                <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" Style="margin-bottom: 32px; line-height: 1.7;">
                    As you scroll, the anchor component updates the active state of its links to reflect the current section in view. 
                    The progress bar at the bottom of each link indicates how much of the section has been read.
                </SgTypography>
                
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" As="SgTypographyElement.H2" id="section2" Style="margin-bottom: 16px;">
                    2. Core Features
                </SgTypography>
                <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" Style="margin-bottom: 24px; line-height: 1.7;">
                    The component supports both automatic scanning and manual item definition. 
                    You can also customize the offset, scroll duration, and visual indicators.
                </SgTypography>
                
                <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold" As="SgTypographyElement.H3" id="subsection2-1" Style="margin-bottom: 12px; color: var(--sg-color-primary);">
                    2.1 Custom Styling
                </SgTypography>
                <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" Style="margin-bottom: 32px; line-height: 1.7;">
                    SuperUI's Anchor follows the design tokens of the library, ensuring a consistent look and feel with other components like Badges and Typography.
                </SgTypography>
                
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" As="SgTypographyElement.H2" id="section3" Style="margin-bottom: 16px;">
                    3. Conclusion
                </SgTypography>
                <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" Style="line-height: 1.7;">
                    If you can see the links updating on the left, the component is working correctly. 
                    Try clicking on a link to smoothly scroll to that section.
                </SgTypography>
            </div>
        </div>
    </div>

    @* ── Manual Configuration ─────────────────────────────────────────────── *@
    <div class="sgc-demo-section" style="padding: 32px; border-top: 1px solid var(--sg-border-subtle);">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 48px;">
            <div>
                <div class="demo-section-header" style="margin-bottom: 24px;">
                    <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Bold">Manual Items</SgTypography>
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Define navigation items manually with custom icons and badges.</SgTypography>
                </div>
                
                <SgCard Style="border-radius: 12px; border: 1px solid var(--sg-border-subtle); padding: 16px;">
                    <SgAnchor Items="@ManualItems" 
                              Position="Static" 
                              ShowBadge="true" />
                </SgCard>
            </div>

            <div>
                <div class="demo-section-header" style="margin-bottom: 24px;">
                    <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Bold">Horizontal Orientation</SgTypography>
                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Perfect for secondary navigation bars or wizards.</SgTypography>
                </div>
                
                <SgCard Style="border-radius: 12px; border: 1px solid var(--sg-border-subtle); padding: 16px;">
                    <SgAnchor Items="@ManualItems" 
                              Orientation="SgOrientation.Horizontal" 
                              Position="Static" />
                </SgCard>
            </div>
        </div>
    </div>

    @* ── Properties Reference ─────────────────────────────────────────────── *@
    <div class="sgc-demo-section" style="padding: 32px; background: var(--sg-surface-alt);">
        <div class="demo-section-header" style="margin-bottom: 24px;">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Bold">Properties Reference</SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">API parameters for the SgAnchor component.</SgTypography>
        </div>

        <SgCard Style="border-radius: 16px; border: 1px solid var(--sg-border-subtle);">
            <PropertyTable Items="_anchorProperties" />
        </SgCard>
    </div>
</SgCard>

@code {
    private RenderFragment _headerContent => __builder => {
        <SgStack Horizontal Align="SgAlignItems.Center" Space="SgSize.Md">
            <div style="width: 40px; height: 40px; background: var(--sg-color-primary); color: #fff; border-radius: 10px; display: flex; align-items: center; justify-content: center; box-shadow: var(--sg-shadow-md);">
                <SgIcon Icon="@SgIcons.Menu" Size="24px" />
            </div>
            <div>
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="line-height: 1.2;">Anchor Navigation</SgTypography>
                <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">Smooth scrolling and section tracking</SgTypography>
            </div>
        </SgStack>
    };

    private List<AnchorItem> ManualItems = new()
    {
        new AnchorItem("sec1", "Home", 2, false, SgIcons.Home),
        new AnchorItem("sec2", "Services", 2, false, SgIcons.Settings),
        new AnchorItem("sec3", "Contacts", 2, false, SgIcons.User),
        new AnchorItem("sec2-1", "Web Development", 3, false),
        new AnchorItem("sec2-2", "UI/UX Design", 3, false)
    };

    private List<PropertyPanelItem> _anchorProperties = new()
    {
        new() { Label = "AutoScan", Value = "bool (default true)", BadgeText = "Auto-discovery", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Selector", Value = "string (h2, h3)", BadgeText = "DOM Selector", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Items", Value = "List<AnchorItem>", BadgeText = "Manual data", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Position", Value = "Static|Sticky|Fixed", BadgeText = "Layout", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Orientation", Value = "Vertical|Horizontal", BadgeText = "Layout", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ShowScrollProgress", Value = "bool", BadgeText = "Visual", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowBadge", Value = "bool", BadgeText = "Visual", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "OnAnchorChanged", Value = "EventCallback<string>", BadgeText = "Event", BadgeVariant = SgBadgeVariant.Success },
    };
}

