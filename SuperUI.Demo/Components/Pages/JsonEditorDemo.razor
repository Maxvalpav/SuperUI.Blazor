@page "/json-editor-demo"
@using SuperUI.Components
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>JSON Schema Editor — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Schema Selector                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Schema Selector
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Choose a JSON Schema to render as an interactive form. Each schema highlights different UI widgets, validation rules, and field types.
            </SgTypography>
        </div>
        <SgSpace Space="SgSize.Md" Wrap="true">
            <SgButton Variant="@(_selectedSchema == 0 ? SgButtonVariant.Primary : SgButtonVariant.Outlined)"
                      OnClick="@(() => SelectSchema(0))">
                @((MarkupString)SgHeroicons.Outline.ShieldCheck)
                <span style="margin-left:6px;">Access Rights</span>
            </SgButton>
            <SgButton Variant="@(_selectedSchema == 1 ? SgButtonVariant.Primary : SgButtonVariant.Outlined)"
                      OnClick="@(() => SelectSchema(1))">
                @((MarkupString)SgHeroicons.Outline.Cog6Tooth)
                <span style="margin-left:6px;">System Settings</span>
            </SgButton>
            <SgButton Variant="@(_selectedSchema == 2 ? SgButtonVariant.Primary : SgButtonVariant.Outlined)"
                      OnClick="@(() => SelectSchema(2))">
                @((MarkupString)SgHeroicons.Outline.User)
                <span style="margin-left:6px;">User Profile</span>
            </SgButton>
        </SgSpace>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Form + Editor                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Form &amp; Editor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                The JSON Schema renders a dynamic form on the left. The right panel shows a live read-only JSON preview, validation status, and schema metrics.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Xs="12" Md="7">
                <SgCard Title="@((CurrentSchema?.Title ?? "Schema") + " (Form)")" Shadow="SgShadow.Sm" NoPadding="true">
                    <SgJsonSchemaForm Schema="@CurrentSchema"
                                      Value="@_jsonValue"
                                      ValueChanged="@OnValueChangedAsync"
                                      ShowRawEditor="false"
                                      ReadOnly="@_readOnly"
                                      OnValidate="@OnValidated"
                                      ShowJsonPath="@_ctorShowJsonPath"
                                      EnableUndoRedo="@_ctorEnableUndoRedo"
                                      ShowSize="@_ctorShowSize"
                                      AllowFormat="@_ctorAllowFormat"
                                      ShowDiff="@_ctorShowDiff"
                                      GenerateSchemaEnabled="@_ctorGenerateSchema"
                                      GenerateClassEnabled="@_ctorGenerateClass"
                                      CompareWith="@_ctorCompareWith"
                                      CssClass="je-schema-form" />
                </SgCard>
            </SgCol>
            <SgCol Xs="12" Md="5">
                <SgStack Vertical Space="SgSize.Md">

                    <!-- Raw JSON Preview -->
                    <SgCard Title="Raw JSON" Shadow="SgShadow.Sm">
                        <ChildContent>
                            <SgStack Vertical Space="SgSize.Sm">
                                <div style="display:flex;align-items:center;gap:8px;">
                                    <SgBadge Variant="@(_isValidJson ? SgBadgeVariant.Success : SgBadgeVariant.Danger)"
                                             Text="@(_isValidJson ? "Valid" : "Invalid")"
                                             Icon="@(_isValidJson ? SgHeroicons.Outline.Check : SgHeroicons.Outline.XMark)"
                                             Standalone="true" />
                                    <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                                        @(_jsonValue?.Length ?? 0) chars
                                    </SgTypography>
                                </div>
                                <SgMonaco Value="@_jsonValue"
                                          Height="220px"
                                          Options="@_previewOpts"
                                          CssClass="je-preview-monaco" />
                            </SgStack>
                        </ChildContent>
                    </SgCard>

                    <!-- Validation Status -->
                    @if (_lastValidation is not null)
                    {
                        if (_lastValidation.IsValid)
                        {
                            <SgAlert Variant="SgAlertVariant.Success" Text="JSON is valid" Dense="true" />
                        }
                        else
                        {
                            <SgAlert Variant="SgAlertVariant.Danger" Title="Validation Errors" Dense="true">
                                <ul style="margin:4px 0 0 0;padding-left:20px;">
                                    @foreach (var err in _lastValidation.Errors)
                                    {
                                        <li style="font-size:12px;margin-bottom:2px;">@err</li>
                                    }
                                </ul>
                            </SgAlert>
                        }
                    }

                    <!-- Schema Info -->
                    <SgCard Title="Schema Info" Shadow="SgShadow.Sm">
                        <ChildContent>
                            <SgStack Vertical Space="SgSize.Sm">
                                <div style="display:flex;align-items:center;justify-content:space-between;">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Fields</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@(CurrentSchema?.Properties?.Count.ToString() ?? "0")" Standalone="true" />
                                </div>
                                <div style="display:flex;align-items:center;justify-content:space-between;">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Required</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Warn" Text="@(CurrentSchema?.Required?.Count.ToString() ?? "0")" Standalone="true" />
                                </div>
                                <SgRow Space="SgSize.Sm">
                                    <SgCol Span="12">
                                        <div style="display:flex;align-items:center;justify-content:space-between;padding-top:8px;border-top:1px solid var(--sg-border);">
                                            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Read Only</SgTypography>
                                            <SgSwitch Value="@_readOnly" ValueChanged="@(v => { _readOnly = v; StateHasChanged(); })" />
                                        </div>
                                    </SgCol>
                                </SgRow>
                            </SgStack>
                        </ChildContent>
                    </SgCard>

                    <!-- Editor Options -->
                    <SgCard Title="Editor Options" Shadow="SgShadow.Sm">
                        <ChildContent>
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgRow Space="SgSize.Sm">
                                    <SgCol Span="6">
                                        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                                            <SgTypography Size="SgTypographySize.Xs">Show JSON Path</SgTypography>
                                            <SgSwitch Value="_ctorShowJsonPath" ValueChanged="v => { _ctorShowJsonPath = v; StateHasChanged(); }" />
                                        </SgStack>
                                    </SgCol>
                                    <SgCol Span="6">
                                        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                                            <SgTypography Size="SgTypographySize.Xs">Undo/Redo</SgTypography>
                                            <SgSwitch Value="_ctorEnableUndoRedo" ValueChanged="v => { _ctorEnableUndoRedo = v; StateHasChanged(); }" />
                                        </SgStack>
                                    </SgCol>
                                </SgRow>
                                <SgRow Space="SgSize.Sm">
                                    <SgCol Span="6">
                                        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                                            <SgTypography Size="SgTypographySize.Xs">Show Size</SgTypography>
                                            <SgSwitch Value="_ctorShowSize" ValueChanged="v => { _ctorShowSize = v; StateHasChanged(); }" />
                                        </SgStack>
                                    </SgCol>
                                    <SgCol Span="6">
                                        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                                            <SgTypography Size="SgTypographySize.Xs">Format Buttons</SgTypography>
                                            <SgSwitch Value="_ctorAllowFormat" ValueChanged="v => { _ctorAllowFormat = v; StateHasChanged(); }" />
                                        </SgStack>
                                    </SgCol>
                                </SgRow>
                                <SgRow Space="SgSize.Sm">
                                    <SgCol Span="6">
                                        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                                            <SgTypography Size="SgTypographySize.Xs">Show Diff</SgTypography>
                                            <SgSwitch Value="_ctorShowDiff" ValueChanged="v => { _ctorShowDiff = v; StateHasChanged(); }" />
                                        </SgStack>
                                    </SgCol>
                                    <SgCol Span="6">
                                        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                                            <SgTypography Size="SgTypographySize.Xs">Generate Schema</SgTypography>
                                            <SgSwitch Value="_ctorGenerateSchema" ValueChanged="v => { _ctorGenerateSchema = v; StateHasChanged(); }" />
                                        </SgStack>
                                    </SgCol>
                                </SgRow>
                                <SgRow Space="SgSize.Sm">
                                    <SgCol Span="6">
                                        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
                                            <SgTypography Size="SgTypographySize.Xs">Generate C# Class</SgTypography>
                                            <SgSwitch Value="_ctorGenerateClass" ValueChanged="v => { _ctorGenerateClass = v; StateHasChanged(); }" />
                                        </SgStack>
                                    </SgCol>
                                </SgRow>
                                @if (_ctorShowDiff)
                                {
                                    <SgRow Space="SgSize.Sm">
                                        <SgCol Span="12">
                                            <SgStack Vertical Space="SgSize.Sm">
                                                <SgTypography Size="SgTypographySize.Xs">Compare With (JSON)</SgTypography>
                                                <SgTextBox TValue="string" Value="_ctorCompareWith" ValueChanged="v => { _ctorCompareWith = v; StateHasChanged(); }" Placeholder="Paste JSON to compare..." Block="true" />
                                            </SgStack>
                                        </SgCol>
                                    </SgRow>
                                }
                            </SgStack>
                        </ChildContent>
                    </SgCard>

                </SgStack>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Live Constructor                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Quickly switch schemas, toggle read-only mode, format the JSON, or copy it to the clipboard.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="4" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Schema -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Schema</SgTypography>
                            <SgSegmented TValue="int"
                                         Value="_selectedSchema"
                                         ValueChanged="v => SelectSchema(v)"
                                         Block="true"
                                         Size="sm"
                                         Options="_schemaSegOptions" />
                        </SgStack>

                        <!-- Read Only -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Read Only</SgTypography>
                            <SgSegmented TValue="bool"
                                         Value="_readOnly"
                                         ValueChanged="v => { _readOnly = v; StateHasChanged(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_boolSegOptions" />
                        </SgStack>

                        <!-- Form Options -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Form Options</SgTypography>
                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs">Show JSON Path</SgTypography>
                                        <SgSegmented TValue="bool" Value="_ctorShowJsonPath" ValueChanged="v => { _ctorShowJsonPath = v; StateHasChanged(); }" Block="true" Size="sm" Options="_boolSegOptions" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs">Undo/Redo</SgTypography>
                                        <SgSegmented TValue="bool" Value="_ctorEnableUndoRedo" ValueChanged="v => { _ctorEnableUndoRedo = v; StateHasChanged(); }" Block="true" Size="sm" Options="_boolSegOptions" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>
                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs">Show Size</SgTypography>
                                        <SgSegmented TValue="bool" Value="_ctorShowSize" ValueChanged="v => { _ctorShowSize = v; StateHasChanged(); }" Block="true" Size="sm" Options="_boolSegOptions" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs">Format Buttons</SgTypography>
                                        <SgSegmented TValue="bool" Value="_ctorAllowFormat" ValueChanged="v => { _ctorAllowFormat = v; StateHasChanged(); }" Block="true" Size="sm" Options="_boolSegOptions" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>
                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs">Show Diff</SgTypography>
                                        <SgSegmented TValue="bool" Value="_ctorShowDiff" ValueChanged="v => { _ctorShowDiff = v; StateHasChanged(); }" Block="true" Size="sm" Options="_boolSegOptions" />
                                    </SgStack>
                                </SgCol>
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs">Generate Schema</SgTypography>
                                        <SgSegmented TValue="bool" Value="_ctorGenerateSchema" ValueChanged="v => { _ctorGenerateSchema = v; StateHasChanged(); }" Block="true" Size="sm" Options="_boolSegOptions" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>
                            <SgRow Space="SgSize.Sm">
                                <SgCol Span="6">
                                    <SgStack Vertical Space="SgSize.Sm">
                                        <SgTypography Size="SgTypographySize.Xs">Generate C# Class</SgTypography>
                                        <SgSegmented TValue="bool" Value="_ctorGenerateClass" ValueChanged="v => { _ctorGenerateClass = v; StateHasChanged(); }" Block="true" Size="sm" Options="_boolSegOptions" />
                                    </SgStack>
                                </SgCol>
                            </SgRow>
                            @if (_ctorShowDiff)
                            {
                                <SgRow Space="SgSize.Sm">
                                    <SgCol Span="12">
                                        <SgStack Vertical Space="SgSize.Sm">
                                            <SgTypography Size="SgTypographySize.Xs">Compare With</SgTypography>
                                            <SgTextBox TValue="string" Value="_ctorCompareWith" ValueChanged="v => { _ctorCompareWith = v; StateHasChanged(); }" Placeholder="Paste JSON to compare..." Block="true" />
                                        </SgStack>
                                    </SgCol>
                                </SgRow>
                            }
                        </SgStack>

                        <!-- Actions -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Actions</SgTypography>
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgButton Variant="SgButtonVariant.Ghost" Block="true" OnClick="@FormatPreviewJsonAsync">
                                    @((MarkupString)SgHeroicons.Outline.ArrowPathRoundedSquare)
                                    <span style="margin-left:6px;">Format JSON</span>
                                </SgButton>
                                <SgButton Variant="SgButtonVariant.Ghost" Block="true" OnClick="@CopyJsonToClipboard">
                                    @((MarkupString)SgHeroicons.Outline.Clipboard)
                                    <span style="margin-left:6px;">@_copyLabel</span>
                                </SgButton>
                            </SgStack>
                        </SgStack>

                        <!-- Stats Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Schema</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@CurrentSchemaName" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Fields</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Success" Text="@(CurrentSchema?.Properties?.Count.ToString() ?? "0")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Required</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Warn" Text="@(CurrentSchema?.Required?.Count.ToString() ?? "0")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Read Only</SgTypography>
                                    <SgBadge Variant="@(_readOnly ? SgBadgeVariant.Warn : SgBadgeVariant.Default)" Text="@(_readOnly ? "Yes" : "No")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">JSON Path</SgTypography>
                                    <SgBadge Variant="@(_ctorShowJsonPath ? SgBadgeVariant.Warn : SgBadgeVariant.Default)" Text="@(_ctorShowJsonPath ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Undo/Redo</SgTypography>
                                    <SgBadge Variant="@(_ctorEnableUndoRedo ? SgBadgeVariant.Warn : SgBadgeVariant.Default)" Text="@(_ctorEnableUndoRedo ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Show Size</SgTypography>
                                    <SgBadge Variant="@(_ctorShowSize ? SgBadgeVariant.Warn : SgBadgeVariant.Default)" Text="@(_ctorShowSize ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Format</SgTypography>
                                    <SgBadge Variant="@(_ctorAllowFormat ? SgBadgeVariant.Warn : SgBadgeVariant.Default)" Text="@(_ctorAllowFormat ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Diff</SgTypography>
                                    <SgBadge Variant="@(_ctorShowDiff ? SgBadgeVariant.Warn : SgBadgeVariant.Default)" Text="@(_ctorShowDiff ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Gen Schema</SgTypography>
                                    <SgBadge Variant="@(_ctorGenerateSchema ? SgBadgeVariant.Warn : SgBadgeVariant.Default)" Text="@(_ctorGenerateSchema ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Gen C# Class</SgTypography>
                                    <SgBadge Variant="@(_ctorGenerateClass ? SgBadgeVariant.Warn : SgBadgeVariant.Default)" Text="@(_ctorGenerateClass ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">JSON Valid</SgTypography>
                                    <SgBadge Variant="@(_isValidJson ? SgBadgeVariant.Success : SgBadgeVariant.Danger)" Text="@(_isValidJson ? "Yes" : "No")" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview ── -->
                <SgCol Xs="12" Md="8" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Component Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Rendered Form</SgTypography>
                            <div class="constructor-preview">
                                <SgJsonSchemaForm Schema="@CurrentSchema"
                                                  Value="@_jsonValue"
                                                  ValueChanged="@OnValueChangedAsync"
                                                  ShowRawEditor="false"
                                                  ReadOnly="@_readOnly"
                                                  OnValidate="@OnValidated"
                                                  ShowJsonPath="@_ctorShowJsonPath"
                                                  EnableUndoRedo="@_ctorEnableUndoRedo"
                                                  ShowSize="@_ctorShowSize"
                                                  AllowFormat="@_ctorAllowFormat"
                                                  ShowDiff="@_ctorShowDiff"
                                                  GenerateSchemaEnabled="@_ctorGenerateSchema"
                                                  GenerateClassEnabled="@_ctorGenerateClass"
                                                  CompareWith="@_ctorCompareWith" />
                            </div>
                        </SgStack>

                        <!-- JSON Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Current JSON</SgTypography>
                                <SgBadge Variant="@(_isValidJson ? SgBadgeVariant.Success : SgBadgeVariant.Danger)"
                                         Text="@(_isValidJson ? "Valid" : "Invalid")"
                                         Standalone="true" />
                            </div>
                            <SgMonaco Value="@_jsonValue"
                                      Height="160px"
                                      Options="@_previewOpts"
                                      CssClass="je-preview-monaco" />
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. SgJsonTreeView                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
