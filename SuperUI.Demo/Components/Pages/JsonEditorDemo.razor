    {
        new() { Value = 0, Label = "0" },
        new() { Value = 1, Label = "1" },
        new() { Value = 2, Label = "2" },
        new() { Value = 3, Label = "3" },
        new() { Value = 99, Label = "All" },
    };

    // ── Lifecycle ───────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        try { _accessJson  = await Http.GetStringAsync("json/access-rights.json"); }    catch { _accessJson  = "{}"; }
        try { _systemJson  = await Http.GetStringAsync("json/system-settings.json"); }  catch { _systemJson  = "{}"; }
        try { _profileJson = await Http.GetStringAsync("json/user-profile.json"); }     catch { _profileJson = "{}"; }

        _jsonValue = CurrentJsonForSchema(_selectedSchema);
        _isValidJson = TryParseJson(_jsonValue);
    }

    private string? CurrentJsonForSchema(int idx) => idx switch
    {
        1 => _systemJson,
        2 => _profileJson,
        _ => _accessJson,
    };

    // ── Handlers ────────────────────────────────────────────────────────
    private void SelectSchema(int idx)
    {
        _selectedSchema = idx;
        _jsonValue = CurrentJsonForSchema(idx);
        _isValidJson = TryParseJson(_jsonValue);
        _lastValidation = null;
        StateHasChanged();
    }

    private async Task OnValueChangedAsync(string? json)
    {
        _jsonValue = json;
        _isValidJson = TryParseJson(json);
        await InvokeAsync(StateHasChanged);
    }

    private void OnValidated(SgJsonSchemaValidationResult result)
    {
        _lastValidation = result;
        StateHasChanged();
    }

    private bool TryParseJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return true;
        try { System.Text.Json.JsonDocument.Parse(json); return true; }
        catch { return false; }
    }

    private async Task FormatPreviewJsonAsync()
    {
        if (string.IsNullOrWhiteSpace(_jsonValue)) return;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(_jsonValue);
            _jsonValue = System.Text.Json.JsonSerializer.Serialize(doc.RootElement, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            _isValidJson = true;
        }
        catch { _isValidJson = false; }
        StateHasChanged();
    }

    private async Task CopyJsonToClipboard()
    {
        if (string.IsNullOrWhiteSpace(_jsonValue)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _jsonValue);
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

