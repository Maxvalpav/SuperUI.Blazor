@page "/transpose-grid-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Demo.Models

<PageTitle>Transpose Grid - SUI</PageTitle>
<SgSeoHead Description="Транспонированная таблица: строки — поля, колонки — записи. Поддерживает секции, поиск, инлайн-редактирование, кастомные шаблоны и агрегаты." />

<SgCard Title="SgTransposeGrid — Вертикальный DataGrid"
        Subtitle="Транспонированная таблица: строки — поля, колонки — записи. Поддерживает секции, поиск, инлайн-редактирование, кастомные шаблоны и агрегаты.">

    <div style="margin-top: 24px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Сравнение сотрудников</SgTypography>
        <p>Каждая колонка — один сотрудник. Строки — поля. Двойной клик по ячейке для редактирования.</p>

        <div style="margin-top: 16px; height: 520px; border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); overflow: hidden;">
            <SgTransposeGrid TItem="Employee"
                             Items="_employees"
                             Columns="_columns"
                             Title="Сотрудники"
                             FieldColumnTitle="Поле"
                             FieldColumnWidth="180px"
                             ShowSearch="true"
                             ShowSections="true"
                             ShowStatusBar="true"
                             ShowColumnBorders="true"
                             ShowAggregates="true"
                             OnCellEdited="HandleEdit">
                <HeaderTemplate Context="emp">
                    <div style="display:flex;flex-direction:column;gap:1px;">
                        <span style="font-weight:600;">@emp.FirstName @emp.LastName</span>
                        <span style="font-size:10px;color:var(--sui-muted);font-weight:400;">@emp.Department</span>
                    </div>
                </HeaderTemplate>
                <CellTemplate Context="ctx">
                    @RenderEmployeeCell(ctx)
                </CellTemplate>
            </SgTransposeGrid>
        </div>

        @if (_lastEdit is not null)
        {
            <div style="margin-top: 10px; padding: 8px 12px; background: var(--sui-success-bg); border: 1px solid var(--sui-success-border); border-radius: var(--sui-radius-md); font-size: 12px; color: var(--sui-success);">
                Изменено: <strong>@_lastEdit.Column.Title</strong> для <strong>@_lastEdit.Item.FirstName @_lastEdit.Item.LastName</strong> = «@_lastEdit.NewValue»
            </div>
        }
    </div>

    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Сравнение серверов</SgTypography>
        <p>Кастомный шаблон для прогресс-баров загрузки ресурсов.</p>

        <div style="margin-top: 16px; height: 340px; border: 1px solid var(--sui-border); border-radius: var(--sui-radius-md); overflow: hidden;">
            <SgTransposeGrid TItem="ServerInfo"
                             Items="_servers"
                             Columns="_serverColumns"
                             Title="Серверы"
                             FieldColumnWidth="160px"
                             ShowSearch="false"
                             ShowSections="false"
                             ShowStatusBar="true"
                             ShowColumnBorders="true">
                <HeaderTemplate Context="srv">
                    <div style="display:flex;flex-direction:column;gap:1px;">
                        <span style="font-weight:600;">@srv.Name</span>
                        <span style="font-size:10px;color:var(--sui-muted);font-weight:400;">@srv.IP</span>
                    </div>
                </HeaderTemplate>
                <CellTemplate Context="ctx">
                    @RenderServerCell(ctx)
                </CellTemplate>
            </SgTransposeGrid>
        </div>
    </div>

    <div style="margin-top: 32px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
        <SgCard Title="Параметры SgTransposeGrid">
            <PropertyTable Items="_gridProps" />
        </SgCard>
        <SgCard Title="Параметры SgTransposeColumn">
            <PropertyTable Items="_colProps" />
        </SgCard>
    </div>

</SgCard>

@code {
    private SgTransposeEditEventArgs<Employee>? _lastEdit;
    private void HandleEdit(SgTransposeEditEventArgs<Employee> e) { _lastEdit = e; }

    // ── Employees ─────────────────────────────────────────────────────────────
    private List<Employee> _employees = new()
    {
        new() { Id=1, FirstName="Мария",    LastName="Петрова",  Department=DepartmentType.Engineering, Salary=185000, IsActive=true,  HireDate=new DateTime(2021,3,15),  Email="m.petrova@corp.ru" },
        new() { Id=2, FirstName="Иван",     LastName="Иванов",   Department=DepartmentType.Design,      Salary=142000, IsActive=true,  HireDate=new DateTime(2020,7,1),   Email="i.ivanov@corp.ru"  },
        new() { Id=3, FirstName="Елена",    LastName="Смирнова", Department=DepartmentType.Marketing,   Salary=98000,  IsActive=false, HireDate=new DateTime(2019,11,20), Email="e.smirnova@corp.ru"},
        new() { Id=4, FirstName="Алексей",  LastName="Козлов",   Department=DepartmentType.Product,     Salary=210000, IsActive=true,  HireDate=new DateTime(2022,1,10),  Email="a.kozlov@corp.ru"  },
        new() { Id=5, FirstName="Наталья",  LastName="Новикова", Department=DepartmentType.HR,          Salary=87000,  IsActive=true,  HireDate=new DateTime(2023,5,3),   Email="n.novikova@corp.ru"},
    };

    private List<SgTransposeColumn<Employee>> _columns = new()
    {
        new() { Section="Личные данные", Title="Имя",        ValueSelector=e=>e.FirstName,  Editable=true  },
        new() { Section="Личные данные", Title="Фамилия",    ValueSelector=e=>e.LastName,   Editable=true  },
        new() { Section="Личные данные", Title="Email",      ValueSelector=e=>e.Email,      Highlighted=true },
        new() { Section="Работа",        Title="Отдел",      ValueSelector=e=>e.Department.ToString() },
        new() { Section="Работа",        Title="Зарплата",   ValueSelector=e=>e.Salary,     Format="C0",   Aggregate=SgTransposeAggregate.Average, Highlighted=true },
        new() { Section="Работа",        Title="Дата найма", ValueSelector=e=>e.HireDate,   Format="dd.MM.yyyy" },
        new() { Section="Работа",        Title="Статус",     ValueSelector=e=>e.IsActive },
        new() { Section="Система",       Title="ID",         ValueSelector=e=>e.Id,         Muted=true },
    };

    // ── Servers ───────────────────────────────────────────────────────────────
    public sealed class ServerInfo
    {
        public string Name { get; init; } = "";
        public string IP { get; init; } = "";
        public bool Online { get; init; }
        public int Cpu { get; init; }
        public int Ram { get; init; }
        public int Disk { get; init; }
        public string Os { get; init; } = "";
        public string Uptime { get; init; } = "";
    }

    private List<ServerInfo> _servers = new()
    {
        new() { Name="web-prod-01", IP="10.0.1.10", Online=true,  Cpu=72, Ram=64, Disk=88, Os="Ubuntu 24.04", Uptime="142 дня"  },
        new() { Name="web-prod-02", IP="10.0.1.11", Online=true,  Cpu=45, Ram=38, Disk=55, Os="Ubuntu 24.04", Uptime="98 дней"  },
        new() { Name="db-master",   IP="10.0.2.10", Online=true,  Cpu=91, Ram=82, Disk=76, Os="Debian 12",    Uptime="201 день" },
        new() { Name="db-replica",  IP="10.0.2.11", Online=false, Cpu=12, Ram=20, Disk=60, Os="Debian 12",    Uptime="0 дней"   },
        new() { Name="cache-01",    IP="10.0.3.10", Online=true,  Cpu=33, Ram=55, Disk=22, Os="Alpine 3.19",  Uptime="67 дней"  },
    };

    private List<SgTransposeColumn<ServerInfo>> _serverColumns = new()
    {
        new() { Title="Статус",  ValueSelector=s=>s.Online },
        new() { Title="ОС",      ValueSelector=s=>s.Os },
        new() { Title="CPU",     ValueSelector=s=>s.Cpu,  Aggregate=SgTransposeAggregate.Average },
        new() { Title="RAM",     ValueSelector=s=>s.Ram,  Aggregate=SgTransposeAggregate.Average },
        new() { Title="Диск",    ValueSelector=s=>s.Disk, Aggregate=SgTransposeAggregate.Average },
        new() { Title="Uptime",  ValueSelector=s=>s.Uptime },
    };

    // ── Cell render helpers ───────────────────────────────────────────────────

    private RenderFragment RenderEmployeeCell(SgTransposeCellContext<Employee> ctx) => __builder =>
    {
        if (ctx.Column.Title == "Статус")
        {
            var active = ctx.RawValue is bool b && b;
            __builder.OpenElement(0, "span");
            __builder.AddAttribute(1, "class", active ? "sgc-badge sgc-badge-success" : "sgc-badge sgc-badge-danger");
            __builder.AddContent(2, active ? "Активен" : "Неактивен");
            __builder.CloseElement();
        }
        else if (ctx.Column.Title == "Зарплата")
        {
            __builder.OpenElement(0, "span");
            __builder.AddAttribute(1, "style", "font-weight:600;color:var(--sui-accent);");
            __builder.AddContent(2, ctx.Display);
            __builder.CloseElement();
        }
        else
        {
            __builder.AddContent(0, ctx.Display);
        }
    };

    private RenderFragment RenderServerCell(SgTransposeCellContext<ServerInfo> ctx) => __builder =>
    {
        var isProgress = ctx.RawValue is int &&
            (ctx.Column.Title.Contains("CPU") || ctx.Column.Title.Contains("RAM") || ctx.Column.Title.Contains("Диск"));

        if (isProgress && ctx.RawValue is int pct)
        {
            var color = pct >= 90 ? "var(--sui-danger)" : pct >= 70 ? "var(--sui-warn)" : "var(--sui-success)";
            __builder.OpenElement(0, "span");
            __builder.AddAttribute(1, "style", "display:flex;align-items:center;gap:6px;width:100%;");
            __builder.OpenElement(2, "span");
            __builder.AddAttribute(3, "style", "flex:1;height:5px;background:var(--sui-bg-tertiary);border-radius:3px;overflow:hidden;");
            __builder.OpenElement(4, "span");
            __builder.AddAttribute(5, "style", $"display:block;height:100%;width:{pct}%;background:{color};border-radius:3px;");
            __builder.CloseElement();
            __builder.CloseElement();
            __builder.OpenElement(6, "span");
            __builder.AddAttribute(7, "style", $"font-size:11px;min-width:28px;text-align:right;color:{color};font-weight:600;");
            __builder.AddContent(8, $"{pct}%");
            __builder.CloseElement();
            __builder.CloseElement();
        }
        else if (ctx.RawValue is bool online)
        {
            __builder.OpenElement(0, "span");
            __builder.AddAttribute(1, "class", online ? "sgc-badge sgc-badge-success" : "sgc-badge sgc-badge-danger");
            __builder.AddContent(2, online ? "Online" : "Offline");
            __builder.CloseElement();
        }
        else
        {
            __builder.AddContent(0, ctx.Display);
        }
    };
    private List<PropertyPanelItem> _gridProps = new()
    {
        new() { Label="Items",            Value="IEnumerable<T>",                    BadgeText="Данные",              BadgeVariant=SgBadgeVariant.Warn    },
        new() { Label="Columns",          Value="List<SgTransposeColumn<T>>",        BadgeText="Поля (строки)",       BadgeVariant=SgBadgeVariant.Warn    },
        new() { Label="HeaderSelector",   Value="Func<T, string>?",                  BadgeText="Заголовок колонки",   BadgeVariant=SgBadgeVariant.Info    },
        new() { Label="HeaderTemplate",   Value="RenderFragment<T>?",                BadgeText="Кастомный заголовок", BadgeVariant=SgBadgeVariant.Info    },
        new() { Label="CellTemplate",     Value="RenderFragment<SgTransposeCellContext<T>>?", BadgeText="Кастомная ячейка", BadgeVariant=SgBadgeVariant.Info },
        new() { Label="FieldColumnWidth", Value="string (default: \"200px\")",       BadgeText="Ширина поля",         BadgeVariant=SgBadgeVariant.Info    },
        new() { Label="ShowSearch",       Value="bool (default: true)",              BadgeText="Поиск по полям",      BadgeVariant=SgBadgeVariant.Warn    },
        new() { Label="ShowSections",     Value="bool (default: true)",              BadgeText="Секции",              BadgeVariant=SgBadgeVariant.Warn    },
        new() { Label="ShowColumnBorders",Value="bool (default: true)",              BadgeText="Границы колонок",     BadgeVariant=SgBadgeVariant.Warn    },
        new() { Label="ShowAggregates",   Value="bool (default: true)",              BadgeText="Агрегаты в футере",   BadgeVariant=SgBadgeVariant.Warn    },
        new() { Label="OnCellEdited",     Value="EventCallback<SgTransposeEditEventArgs<T>>", BadgeText="Редактирование", BadgeVariant=SgBadgeVariant.Success },
    };

    private List<PropertyPanelItem> _colProps = new()
    {
        new() { Label="Title",         Value="string",              BadgeText="Метка поля",          BadgeVariant=SgBadgeVariant.Danger  },
        new() { Label="ValueSelector", Value="Func<T, object?>?",   BadgeText="Значение",            BadgeVariant=SgBadgeVariant.Warn    },
        new() { Label="Format",        Value="string?",             BadgeText="Формат",              BadgeVariant=SgBadgeVariant.Info    },
        new() { Label="Section",       Value="string?",             BadgeText="Секция",              BadgeVariant=SgBadgeVariant.Info    },
        new() { Label="Icon",          Value="string? (SVG)",       BadgeText="Иконка",              BadgeVariant=SgBadgeVariant.Info    },
        new() { Label="Hint",          Value="string?",             BadgeText="Подсказка (i)",       BadgeVariant=SgBadgeVariant.Info    },
        new() { Label="Highlighted",   Value="bool",                BadgeText="Выделить строку",     BadgeVariant=SgBadgeVariant.Warn    },
        new() { Label="Muted",         Value="bool",                BadgeText="Приглушить",          BadgeVariant=SgBadgeVariant.Warn    },
        new() { Label="Editable",      Value="bool",                BadgeText="Двойной клик = edit", BadgeVariant=SgBadgeVariant.Warn    },
        new() { Label="Aggregate",     Value="None|Sum|Avg|Min|Max|Count", BadgeText="Агрегат",     BadgeVariant=SgBadgeVariant.Info    },
        new() { Label="OnValueChanged",Value="Action<T, string?>?", BadgeText="Callback",           BadgeVariant=SgBadgeVariant.Success },
    };
}
