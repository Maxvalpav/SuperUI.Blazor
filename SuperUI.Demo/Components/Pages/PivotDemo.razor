@page "/pivot"
@using SuperUI.Components
@using SuperUI.Demo.Models

<PageTitle>Сводная таблица - SUI</PageTitle>

<SgCard Title="SgPivotTable - Сводная таблица" 
        Subtitle="Компонент для анализа и сводки данных. Поддерживает группировку, агрегацию, различные функции расчета и интерактивный конструктор полей.">
    
    <!-- 1. Сводная таблица с конструктором -->
    <div style="margin-top: 32px;">
        <h2>1. Сводная таблица с конструктором полей</h2>
        <p>Интерактивная сводная таблица с конструктором для настройки строк, столбцов и значений. Перетаскивайте поля между областями.</p>
        
        <SgCard Title="Сводная таблица с конструктором" Style="margin-top: 16px;">
            <div style="height: 700px; border: 1px solid var(--sui-border); border-radius: 4px; overflow: auto;">
                <SgPivotTable TItem="Product" 
                              Items="_products" 
                              State="_pivotState" 
                              Fields="_pivotFields" 
                              ShowDesigner="true" 
                              ShowTotal="true" />
            </div>
        </SgCard>
    </div>

    <!-- 2. Сводная таблица - Анализ по категориям и доступности -->
    <div style="margin-top: 32px;">
        <h2>2. Анализ по категориям и доступности</h2>
        <p>Сводная таблица, сгруппированная по категориям (строки) и доступности (столбцы) с суммой цен.</p>
        
        <SgCard Title="Анализ по категориям" Style="margin-top: 16px;">
            <div style="height: 500px; border: 1px solid var(--sui-border); border-radius: 4px; overflow: auto;">
                <SgPivotTable TItem="Product" 
                              Items="_products" 
                              State="_pivotStateByCategoryAvailability" 
                              Fields="_pivotFields" 
                              ShowDesigner="false" 
                              ShowTotal="true" />
            </div>
        </SgCard>
    </div>

    <!-- 3. Сводная таблица - Количество товаров по категориям -->
    <div style="margin-top: 32px;">
        <h2>3. Количество товаров по категориям</h2>
        <p>Сводная таблица с подсчетом количества товаров в каждой категории.</p>
        
        <SgCard Title="Количество товаров" Style="margin-top: 16px;">
            <div style="height: 500px; border: 1px solid var(--sui-border); border-radius: 4px; overflow: auto;">
                <SgPivotTable TItem="Product" 
                              Items="_products" 
                              State="_pivotStateByCategory" 
                              Fields="_pivotFields" 
                              ShowDesigner="false" 
                              ShowTotal="true" />
            </div>
        </SgCard>
    </div>

    <!-- 4. Параметры компонента -->
    <div style="margin-top: 32px;">
        <h2>4. Параметры компонента</h2>
        <p>Полный список параметров SgPivotTable для настройки поведения и внешнего вида.</p>
        
        <SgCard Title="Основные параметры" Style="margin-top: 16px;">
            <PropertyTable Items="_mainProperties" />
        </SgCard>

        <SgCard Title="Параметры отображения" Style="margin-top: 16px;">
            <PropertyTable Items="_displayProperties" />
        </SgCard>

        <SgCard Title="События и обработчики" Style="margin-top: 16px;">
            <PropertyTable Items="_eventProperties" />
        </SgCard>
    </div>

    <!-- 5. Типы агрегации -->
    <div style="margin-top: 32px;">
        <h2>5. Типы агрегации</h2>
        <p>Доступные функции агрегации для расчета значений в сводной таблице.</p>
        
        <SgCard Title="Типы агрегации" Style="margin-top: 16px;">
            <PropertyTable Items="_aggregationTypes" />
        </SgCard>
    </div>
</SgCard>

@code {
    private List<Product> _products = new();
    private SgPivotState<Product> _pivotState = new();
    private SgPivotState<Product> _pivotStateByCategoryAvailability = new();
    private SgPivotState<Product> _pivotStateByCategory = new();
    private List<SgPivotField<Product>> _pivotFields = new();

    private List<PropertyPanelItem> _mainProperties = new()
    {
        new() { Label = "Items", Value = "IEnumerable<TItem>", BadgeText = "Данные", BadgeVariant = "info" },
        new() { Label = "State", Value = "SgPivotState<TItem>", BadgeText = "Состояние", BadgeVariant = "info" },
        new() { Label = "Fields", Value = "List<SgPivotField<TItem>>", BadgeText = "Поля", BadgeVariant = "info" },
        new() { Label = "CssClass", Value = "string", BadgeText = "CSS класс", BadgeVariant = "info" }
    };

    private List<PropertyPanelItem> _displayProperties = new()
    {
        new() { Label = "ShowDesigner", Value = "bool", BadgeText = "Конструктор", BadgeVariant = "warn" },
        new() { Label = "ShowTotal", Value = "bool", BadgeText = "Итоги", BadgeVariant = "warn" }
    };

    private List<PropertyPanelItem> _eventProperties = new()
    {
        new() { Label = "OnDrillDown", Value = "EventCallback<IEnumerable<TItem>>", BadgeText = "Детализация", BadgeVariant = "success" }
    };

    private List<PropertyPanelItem> _aggregationTypes = new()
    {
        new() { Label = "Sum", Value = "Сумма", BadgeText = "Числовые", BadgeVariant = "info" },
        new() { Label = "Count", Value = "Количество", BadgeText = "Все типы", BadgeVariant = "info" },
        new() { Label = "Average", Value = "Среднее", BadgeText = "Числовые", BadgeVariant = "info" },
        new() { Label = "Min", Value = "Минимум", BadgeText = "Числовые", BadgeVariant = "info" },
        new() { Label = "Max", Value = "Максимум", BadgeText = "Числовые", BadgeVariant = "info" }
    };

    protected override void OnInitialized()
    {
        _products = SampleDataService.GenerateProducts(500);
        
        // Инициализируем доступные поля для сводной таблицы
        _pivotFields = new()
        {
            new SgPivotField<Product> 
            { 
                Name = "Category", 
                Label = "Категория", 
                Selector = p => p.Category 
            },
            new SgPivotField<Product> 
            { 
                Name = "IsAvailable", 
                Label = "Доступность", 
                Selector = p => p.IsAvailable ? "Доступен" : "Недоступен" 
            },
            new SgPivotField<Product> 
            { 
                Name = "Price", 
                Label = "Цена", 
                Selector = p => p.Price,
                AggregateType = SgPivotAggregateType.Sum,
                Format = "C2"
            },
            new SgPivotField<Product> 
            { 
                Name = "Stock", 
                Label = "Запас", 
                Selector = p => p.Stock,
                AggregateType = SgPivotAggregateType.Sum
            },
            new SgPivotField<Product> 
            { 
                Name = "Count", 
                Label = "Кол-во товаров", 
                Selector = p => 1,
                AggregateType = SgPivotAggregateType.Count
            }
        };

        // Конфигурация 1: Категория x Доступность с суммой цен
        _pivotStateByCategoryAvailability = new()
        {
            RowFields = new() { _pivotFields[0] }, // Категория в строки
            ColumnFields = new() { _pivotFields[1] }, // Доступность в столбцы
            ValueFields = new() { _pivotFields[2] } // Цена в значения
        };

        // Конфигурация 2: Категория с подсчетом товаров
        _pivotStateByCategory = new()
        {
            RowFields = new() { _pivotFields[0] }, // Категория в строки
            ColumnFields = new(), // Нет столбцов
            ValueFields = new() { _pivotFields[4] } // Количество в значения
        };

        // Устанавливаем начальную конфигурацию для конструктора
        _pivotState = new()
        {
            RowFields = new() { _pivotFields[0] }, // Категория в строки
            ColumnFields = new() { _pivotFields[1] }, // Доступность в столбцы
            ValueFields = new() { _pivotFields[2] } // Цена в значения
        };
    }
}

