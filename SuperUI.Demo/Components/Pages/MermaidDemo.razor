@page "/mermaid-demo"
@using SuperUI.Components

<PageTitle>Mermaid.js — SUI</PageTitle>

<div class="mm-page">

    <!-- ── Шапка ──────────────────────────────────────────────────────── -->
    <div class="mm-header">
        <div class="mm-header-left">
            <h1 class="mm-title">SgMermaid</h1>
            <p class="mm-subtitle">Диаграммы из текста — flowchart, sequence, class, state, ER, Gantt, pie, git, mindmap</p>
        </div>
        <div class="mm-header-right">
            <span class="mm-header-label">Тема:</span>
            @foreach (var th in Enum.GetValues<SgMermaidTheme>())
            {
                var tth = th;
                <button class="mm-theme-btn @(_theme == tth ? "active" : "")"
                        @onclick="@(() => { _theme = tth; _pendingApply = true; StateHasChanged(); })">@th</button>
            }
            @if (_pendingApply)
            {
                <button class="mm-apply-header-btn" @onclick="ApplySettings">✓ Применить</button>
            }
            <div class="mm-header-sep"></div>
            <button class="mm-action-btn" @onclick="ExportSvg" title="Скачать SVG">
                <svg viewBox="0 0 16 16" width="14" height="14"><path fill="currentColor" d="M2 2h7l3 3v9H2V2Zm7 0v3h3"/></svg>
                SVG
            </button>
            <button class="mm-action-btn" @onclick="ExportPng" title="Скачать PNG">
                <svg viewBox="0 0 16 16" width="14" height="14"><path fill="currentColor" d="M8 1v8.6L5.7 7.3 4.3 8.7 8 12.4l3.7-3.7-1.4-1.4L9 9.6V1H8Zm-6 12h12v2H2v-2Z"/></svg>
                PNG
            </button>
        </div>
    </div>

    <!-- ── Основная область ────────────────────────────────────────────── -->
    <div class="mm-main">

        <!-- Конструктор слева -->
        <div class="mm-constructor">

            <!-- Тип диаграммы -->
            <div class="mm-section">
                <div class="mm-section-title">Тип диаграммы</div>
                <div class="mm-type-grid">
                    @foreach (var t in _diagramTypes)
                    {
                        var tt = t;
                        <button class="mm-type-btn @(_currentType == tt.Key ? "active" : "")"
                                title="@tt.Value.Desc"
                                @onclick="@(() => SwitchType(tt.Key))">
                            <span class="mm-type-icon">@tt.Value.Icon</span>
                            <span class="mm-type-name">@tt.Key</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Конструктор элементов -->
            <div class="mm-section">
                <div class="mm-section-title">Добавить элемент</div>
                <div class="mm-elements">
                    @foreach (var el in CurrentElements)
                    {
                        var eel = el;
                        <button class="mm-el-btn" @onclick="@(() => InsertSnippet(eel.Code))"
                                title="@eel.Desc">
                            <span class="mm-el-icon">@eel.Icon</span>
                            <span class="mm-el-label">@eel.Label</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Шаблоны -->
            <div class="mm-section">
                <div class="mm-section-title">Шаблоны</div>
                <div class="mm-templates">
                    @foreach (var t in CurrentTemplates)
                    {
                        var tt = t;
                        <button class="mm-tpl-btn @(_activeTemplate == tt.Key ? "active" : "")"
                                @onclick="@(() => LoadTemplate(tt.Key))">
                            @tt.Key
                        </button>
                    }
                </div>
            </div>

            <!-- Настройки -->
            <div class="mm-section">
                <div class="mm-section-title">Настройки</div>
                <div class="mm-settings">
                    <label class="mm-setting-row">
                        <span>Кривые</span>
                        <select class="mm-select" @bind="_curve">
                            <option value="basis">basis</option>
                            <option value="linear">linear</option>
                            <option value="cardinal">cardinal</option>
                        </select>
                    </label>
                    <label class="mm-setting-row">
                        <span>Шрифт</span>
                        <input type="range" min="10" max="20" @bind="_fontSize" class="mm-range" />
                        <span class="mm-range-val">@_fontSize px</span>
                    </label>
                    <button class="mm-apply-btn" @onclick="ApplySettings">
                        ✓ Применить
                    </button>
                </div>
            </div>

            <!-- Клик по узлу -->
            @if (_lastNodeClick is not null)
            {
                <div class="mm-section">
                    <div class="mm-section-title">Последний клик</div>
                    <div class="mm-click-info">
                        <span class="mm-click-label">Узел:</span>
                        <code class="mm-click-id">@_lastNodeClick.NodeId</code>
                    </div>
                </div>
            }

        </div>

        <!-- Splitter: редактор | предпросмотр -->
        <SgSplitter Size="@_editorSize"
                    SizeChanged="@(v => _editorSize = v)"
                    Min="200" Max="900"
                    CssClass="mm-splitter">
            <First>
                <div class="mm-editor-col">
                    <div class="mm-editor-header">
                        <span class="mm-editor-title">Определение</span>
                        <button class="mm-clear-btn" @onclick="ClearEditor" title="Очистить">✕ Очистить</button>
                    </div>
                    <textarea class="mm-textarea"
                              @bind="_definition"
                              @bind:event="oninput"
                              spellcheck="false"></textarea>
                </div>
            </First>
            <Second>
                <div class="mm-preview-col">
                    <div class="mm-preview-header">
                        <span class="mm-editor-title">Предпросмотр</span>
                        @if (!string.IsNullOrWhiteSpace(_definition))
                        {
                            <span class="mm-preview-chars">@_definition.Length симв.</span>
                        }
                    </div>
                    <div class="mm-preview-body">
                        <SgMermaid @ref="_mermaid"
                                   Definition="@_definition"
                                   Options="@CurrentOpts"
                                   ShowToolbar="false"
                                   OnNodeClick="OnNodeClick" />
                    </div>
                </div>
            </Second>
        </SgSplitter>

    </div>
</div>

@code {
    private SgMermaid? _mermaid;
    private SgMermaidTheme _theme = SgMermaidTheme.Default;
    private string _definition = "";
    private string _currentType = "Flowchart";
    private string _activeTemplate = "";
    private string _curve = "basis";
    private int _fontSize = 14;
    private SgMermaidClickEventArgs? _lastNodeClick;
    private double _editorSize = 420;
    private bool _pendingApply = false;

    private SgMermaidOptions CurrentOpts => new()
    {
        Theme = _theme, FontSize = _fontSize, FlowchartCurve = _curve,
    };

    private void OnNodeClick(SgMermaidClickEventArgs e) { _lastNodeClick = e; StateHasChanged(); }
    private async Task ExportSvg() { if (_mermaid is not null) await _mermaid.ExportSvgAsync(); }
    private async Task ExportPng() { if (_mermaid is not null) await _mermaid.ExportPngAsync(); }
    private void ClearEditor() { _definition = ""; _activeTemplate = ""; StateHasChanged(); }

    private async Task ApplySettings()
    {
        _pendingApply = false;
        if (_mermaid is not null) await _mermaid.RefreshAsync();
        StateHasChanged();
    }

    // ── Diagram types ─────────────────────────────────────────────────────────

    private record DiagramTypeInfo(string Icon, string Desc);

    private readonly Dictionary<string, DiagramTypeInfo> _diagramTypes = new()
    {
        ["Flowchart"] = new("🔀", "Блок-схема процесса"),
        ["Sequence"]  = new("↔️", "Диаграмма последовательности"),
        ["Class"]     = new("🏛️", "Диаграмма классов"),
        ["State"]     = new("🔄", "Диаграмма состояний"),
        ["ER"]        = new("🗄️", "ER-диаграмма БД"),
        ["Gantt"]     = new("📅", "Диаграмма Ганта"),
        ["Pie"]       = new("🥧", "Круговая диаграмма"),
        ["Git"]       = new("🌿", "Git-граф"),
        ["Mindmap"]   = new("🧠", "Ментальная карта"),
        ["Timeline"]  = new("📆", "Временная шкала"),
    };

    private void SwitchType(string type)
    {
        _currentType    = type;
        _activeTemplate = "";
        // Load first template for this type automatically
        var tpls = CurrentTemplates;
        if (tpls.Count > 0) LoadTemplate(tpls.Keys.First());
        StateHasChanged();
    }

    // ── Elements per type ─────────────────────────────────────────────────────

    private record ElementInfo(string Icon, string Label, string Code, string Desc);

    private List<ElementInfo> CurrentElements => _currentType switch
    {
        "Flowchart" =>
        [
            new("⬜","Прямоугольник",  "    Node[Текст]\n",                    "Обычный узел"),
            new("🔷","Ромб (решение)", "    Dec{Условие?}\n",                  "Узел-решение"),
            new("⭕","Овал (старт)",   "    Start([Старт])\n",                 "Начало/конец"),
            new("🔲","Подпроцесс",     "    Sub[[Подпроцесс]]\n",              "Подпроцесс"),
            new("🗃️","База данных",    "    DB[(База данных)]\n",              "Хранилище"),
            new("➡️","Стрелка",        "    A --> B\n",                        "Связь"),
            new("📝","Стрелка с меткой","    A -->|Метка| B\n",               "Связь с меткой"),
            new("⚡","Пунктир",        "    A -.-> B\n",                       "Пунктирная связь"),
            new("🎨","Стиль узла",     "    style A fill:#dbeafe,stroke:#3b82f6\n","Стиль"),
        ],
        "Sequence" =>
        [
            new("👤","Актор",          "    actor A as Имя\n",                 "Участник-человек"),
            new("📦","Участник",       "    participant B as Сервис\n",        "Участник"),
            new("→","Запрос",          "    A->>B: Сообщение\n",               "Синхронный вызов"),
            new("⇢","Ответ",           "    B-->>A: Ответ\n",                  "Ответное сообщение"),
            new("🔀","Альтернатива",   "    alt Условие\n    else\n    end\n", "Ветвление"),
            new("🔁","Цикл",           "    loop Повтор\n    end\n",           "Цикл"),
            new("📌","Заметка",        "    Note over A: Заметка\n",           "Аннотация"),
            new("⚡","Активация",      "    activate A\n    deactivate A\n",   "Активация"),
        ],
        "Class" =>
        [
            new("🏛️","Класс",          "    class ИмяКласса {\n        +string Поле\n        +Метод() void\n    }\n", "Класс"),
            new("→","Наследование",    "    Родитель <|-- Потомок\n",          "Наследование"),
            new("◇","Агрегация",       "    Целое o-- Часть\n",               "Агрегация"),
            new("◆","Композиция",      "    Целое *-- Часть\n",               "Композиция"),
            new("⇢","Зависимость",     "    A ..> B\n",                        "Зависимость"),
            new("🔗","Ассоциация",     "    A \"1\" --> \"*\" B : метка\n",    "Ассоциация с кратностью"),
        ],
        "State" =>
        [
            new("▶️","Начало",         "    [*] --> Состояние\n",              "Начальное состояние"),
            new("⏹️","Конец",          "    Состояние --> [*]\n",              "Конечное состояние"),
            new("🔄","Переход",        "    A --> B : Событие\n",              "Переход"),
            new("📦","Составное",      "    state Составное {\n        A --> B\n    }\n","Составное состояние"),
            new("🔀","Параллельное",   "    state fork_state <<fork>>\n",      "Разветвление"),
            new("📝","Заметка",        "    note right of A : Заметка\n",      "Аннотация"),
        ],
        "ER" =>
        [
            new("🗄️","Сущность",       "    ENTITY {\n        int id PK\n        string name\n    }\n","Сущность"),
            new("1→*","Один-ко-многим","    A ||--o{ B : \"связь\"\n",         "Один ко многим"),
            new("1→1","Один-к-одному", "    A ||--|| B : \"связь\"\n",         "Один к одному"),
            new("*→*","Многие-ко-многим","    A }o--o{ B : \"связь\"\n",       "Многие ко многим"),
        ],
        "Gantt" =>
        [
            new("📋","Секция",         "    section Название\n",               "Раздел"),
            new("✅","Выполнено",      "        Задача :done, id1, 2025-01-01, 7d\n","Выполненная задача"),
            new("🔵","Активно",        "        Задача :active, id2, 2025-01-08, 5d\n","Активная задача"),
            new("⬜","Задача",         "        Задача :id3, after id2, 3d\n", "Обычная задача"),
            new("🔴","Критическая",    "        Задача :crit, id4, 2025-01-15, 2d\n","Критическая задача"),
            new("🔗","Зависимость",    "        Задача :id5, after id4, 4d\n", "Задача после другой"),
        ],
        "Pie" =>
        [
            new("🥧","Сегмент",        "    \"Название\" : 25\n",              "Сегмент диаграммы"),
        ],
        "Git" =>
        [
            new("📌","Коммит",         "    commit id: \"Описание\"\n",        "Коммит"),
            new("🌿","Ветка",          "    branch feature/name\n",            "Создать ветку"),
            new("🔀","Переключиться",  "    checkout main\n",                  "Переключиться на ветку"),
            new("🔗","Слияние",        "    merge feature/name\n",             "Слить ветку"),
            new("🏷️","Тег",            "    commit tag: \"v1.0.0\"\n",         "Тег коммита"),
        ],
        "Mindmap" =>
        [
            new("🌐","Корень",         "  root((Тема))\n",                     "Корневой узел"),
            new("📁","Ветка",          "    Ветка\n",                          "Ветка первого уровня"),
            new("📄","Лист",           "      Лист\n",                         "Конечный узел"),
            new("⬜","Прямоугольник",  "    Узел[Текст]\n",                    "Прямоугольный узел"),
            new("⭕","Круг",           "    Узел((Текст))\n",                  "Круглый узел"),
        ],
        "Timeline" =>
        [
            new("📅","Секция",         "    section Год\n",                    "Временной раздел"),
            new("📌","Событие",        "        Событие : Описание\n",         "Событие на шкале"),
        ],
        _ => [],
    };

    // ── Templates per type ────────────────────────────────────────────────────

    private Dictionary<string, string> CurrentTemplates => _currentType switch
    {
        "Flowchart" => new()
        {
            ["Процесс заказа"] = """
                flowchart TD
                    A([🛒 Заказ]) --> B{Проверка}
                    B -->|✅ OK| C[💳 Оплата]
                    B -->|❌ Ошибка| D([🚫 Отклонён])
                    C --> E{Оплата?}
                    E -->|Да| F[📦 Сборка]
                    E -->|Нет| G([❌ Ошибка])
                    F --> H([✅ Доставлен])
                    style A fill:#dbeafe,stroke:#3b82f6
                    style H fill:#dcfce7,stroke:#16a34a
                    style D fill:#fee2e2,stroke:#dc2626
                """,
            ["CI/CD Pipeline"] = """
                flowchart LR
                    A[📝 Commit] --> B[🔨 Build]
                    B --> C{Tests}
                    C -->|Pass| D[🐳 Docker]
                    C -->|Fail| E[❌ Notify]
                    D --> F{Branch?}
                    F -->|main| G[🚀 Prod]
                    F -->|dev| H[🧪 Staging]
                """,
        },
        "Sequence" => new()
        {
            ["Авторизация"] = """
                sequenceDiagram
                    actor U as 👤 Пользователь
                    participant C as 🌐 Клиент
                    participant A as 🔐 Auth
                    participant DB as 🗄️ БД
                    U->>C: Логин/пароль
                    C->>A: POST /login
                    A->>DB: Поиск
                    DB-->>A: Данные
                    alt Успех
                        A-->>C: JWT токен
                        C-->>U: ✅ Вход
                    else Ошибка
                        A-->>C: 401
                        C-->>U: ❌ Ошибка
                    end
                """,
            ["REST API"] = """
                sequenceDiagram
                    participant Client
                    participant API
                    participant Cache
                    participant DB
                    Client->>API: GET /products
                    API->>Cache: Проверка кэша
                    alt Кэш есть
                        Cache-->>API: Данные
                    else Кэш пуст
                        API->>DB: SELECT
                        DB-->>API: Результат
                        API->>Cache: Сохранить
                    end
                    API-->>Client: 200 JSON
                """,
        },
        "Class" => new()
        {
            ["Интернет-магазин"] = """
                classDiagram
                    class Order {
                        +string Id
                        +DateTime CreatedAt
                        +decimal Total
                        +Place() void
                        +Cancel() void
                    }
                    class OrderItem {
                        +string ProductId
                        +int Quantity
                        +decimal Price
                    }
                    class Product {
                        +string Name
                        +decimal Price
                        +int Stock
                    }
                    class Customer {
                        +string Name
                        +string Email
                    }
                    Order "1" --> "*" OrderItem
                    OrderItem "*" --> "1" Product
                    Customer "1" --> "*" Order
                """,
        },
        "State" => new()
        {
            ["Жизненный цикл заказа"] = """
                stateDiagram-v2
                    [*] --> Новый
                    Новый --> Подтверждён : Оплата
                    Новый --> Отменён : Отмена
                    Подтверждён --> Собирается
                    Собирается --> Отправлен
                    Отправлен --> Доставлен
                    Отправлен --> Возврат
                    Доставлен --> [*]
                    Отменён --> [*]
                    Возврат --> [*]
                """,
        },
        "ER" => new()
        {
            ["Схема БД"] = """
                erDiagram
                    CUSTOMER {
                        int id PK
                        string name
                        string email
                    }
                    ORDER {
                        int id PK
                        int customer_id FK
                        string status
                        decimal total
                    }
                    PRODUCT {
                        int id PK
                        string name
                        decimal price
                    }
                    ORDER_ITEM {
                        int id PK
                        int order_id FK
                        int product_id FK
                        int quantity
                    }
                    CUSTOMER ||--o{ ORDER : "размещает"
                    ORDER ||--|{ ORDER_ITEM : "содержит"
                    PRODUCT ||--o{ ORDER_ITEM : "входит в"
                """,
        },
        "Gantt" => new()
        {
            ["План Q1"] = """
                gantt
                    title 📅 План Q1 2025
                    dateFormat YYYY-MM-DD
                    section Дизайн
                        Исследование :done, 2025-01-01, 10d
                        Прототип     :done, 2025-01-08, 12d
                        UI Kit       :active, 2025-01-18, 14d
                    section Разработка
                        Backend API  :2025-01-15, 30d
                        Frontend     :2025-02-01, 25d
                    section Релиз
                        Деплой       :crit, 2025-03-10, 3d
                """,
        },
        "Pie" => new()
        {
            ["Трафик"] = """
                pie title 🥧 Источники трафика
                    "Органика" : 38.5
                    "Прямые" : 22.1
                    "Соцсети" : 18.4
                    "Email" : 11.2
                    "Реклама" : 9.8
                """,
        },
        "Git" => new()
        {
            ["Feature workflow"] = """
                gitGraph
                    commit id: "Init"
                    commit id: "Base"
                    branch feature/auth
                    checkout feature/auth
                    commit id: "JWT"
                    commit id: "Refresh"
                    checkout main
                    merge feature/auth
                    commit id: "v1.0.0" tag: "v1.0.0"
                    branch hotfix
                    checkout hotfix
                    commit id: "Fix"
                    checkout main
                    merge hotfix tag: "v1.0.1"
                """,
        },
        "Mindmap" => new()
        {
            ["Архитектура"] = """
                mindmap
                  root((🏗️ Система))
                    Frontend
                      Blazor
                      TypeScript
                    Backend
                      ASP.NET Core
                      REST API
                    База данных
                      PostgreSQL
                      Redis
                    Инфраструктура
                      Docker
                      K8s
                """,
        },
        "Timeline" => new()
        {
            ["История"] = """
                timeline
                    title 📅 История компании
                    section 2020
                        Основание : Стартап
                    section 2021
                        Раунд A : $2M
                    section 2022
                        Рост : 100 клиентов
                    section 2023
                        Раунд B : $10M
                    section 2024
                        IPO : Выход на биржу
                """,
        },
        _ => new(),
    };

    // ── Actions ───────────────────────────────────────────────────────────────

    private void InsertSnippet(string code)
    {
        _definition += code;
        StateHasChanged();
    }

    private void LoadTemplate(string key)
    {
        _activeTemplate = key;
        if (CurrentTemplates.TryGetValue(key, out var def))
            _definition = def.Trim();
        StateHasChanged();
    }

    protected override void OnInitialized() => SwitchType("Flowchart");
}
