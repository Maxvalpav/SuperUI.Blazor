@page "/demo/timepicker"
@using SuperUI.Demo.Components

<div class="demo-page">
    <div class="demo-hero">
        <section class="demo-hero-main">
            <div class="demo-header">
                <div class="demo-kicker">Input Components</div>
                <h1 class="demo-title">SgTimePicker</h1>
                <p class="demo-subtitle">
                    Time picker for appointments, shifts and precise scheduling with optional seconds support,
                    clear action and validation-aware form integration.
                </p>
            </div>
        </section>

        <aside class="demo-hero-side">
            <div class="demo-side-title">Highlights</div>
            <div class="demo-pill-list">
                <span class="demo-pill demo-pill-accent">Hours / Minutes</span>
                <span class="demo-pill">Optional Seconds</span>
                <span class="demo-pill">Clearable</span>
                <span class="demo-pill">Readonly Mode</span>
            </div>

            <div class="demo-meta-grid">
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Scenarios</span>
                    <span class="demo-meta-value">Meetings, shifts, dispatch windows</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Precision</span>
                    <span class="demo-meta-value">Minute-based or second-level selection</span>
                </div>
                <div class="demo-meta-card">
                    <span class="demo-meta-label">Accessibility</span>
                    <span class="demo-meta-value">Combobox semantics with labeled popup list</span>
                </div>
            </div>
        </aside>
    </div>

    <SgDemoSection Eyebrow="Usage" Title="Examples" Description="Time selection flows for operations, booking and workflow configuration.">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Basic Time</h3>
                    <p class="demo-showcase-desc">Compact hour and minute picking for everyday forms.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgTimePicker @bind-Value="_meetingTime"
                                      Label="Meeting Time"
                                      Hint="Pick a start time for the session" />
                        <div class="demo-inline-value">Selected: @FormatTime(_meetingTime, false)</div>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Second Precision</h3>
                    <p class="demo-showcase-desc">Useful for automation windows and technical scheduling.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgTimePicker @bind-Value="_cutoffTime"
                                      Label="Cutoff Time"
                                      ShowSeconds="true"
                                      Placeholder="--:--:--" />
                        <div class="demo-inline-value">Selected: @FormatTime(_cutoffTime, true)</div>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Clear And Placeholder</h3>
                    <p class="demo-showcase-desc">Keep optional time fields visually lightweight until needed.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgTimePicker @bind-Value="_optionalTime"
                                      Label="Optional Reminder"
                                      Placeholder="Choose reminder time"
                                      AllowClear="true" />
                    </div>
                    <div class="demo-note">Great for optional reminder or escalation deadlines.</div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Readonly And Disabled</h3>
                    <p class="demo-showcase-desc">Lock values when a schedule is system-controlled.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface demo-stack">
                        <SgTimePicker Label="Readonly" Value="@(new TimeSpan(9, 30, 0))" ReadOnly="true" />
                        <SgTimePicker Label="Disabled" Value="@(new TimeSpan(18, 0, 0))" Disabled="true" />
                    </div>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoParams Title="TimePicker Parameters" Description="Core public parameters for configuring the SgTimePicker component.">
        <SgDemoParam Name="Value" Type="TimeSpan?" Description="Currently selected time value." DefaultValue="null" />
        <SgDemoParam Name="ShowSeconds" Type="bool" Description="Adds a seconds column to the popup selector." Values="true, false" DefaultValue="false" />
        <SgDemoParam Name="Placeholder" Type="string" Description="Text shown when no time is selected." DefaultValue="--:--" />
        <SgDemoParam Name="AllowClear" Type="bool" Description="Shows a clear button when a value exists." Values="true, false" DefaultValue="true" />
        <SgDemoParam Name="Required" Type="bool" Description="Marks the field as required." Values="true, false" DefaultValue="false" />
        <SgDemoParam Name="Disabled" Type="bool" Description="Disables interaction with the picker." Values="true, false" DefaultValue="false" />
        <SgDemoParam Name="ReadOnly" Type="bool" Description="Prevents editing while keeping the value visible." Values="true, false" DefaultValue="false" />
        <SgDemoParam Name="Label" Type="string" Description="Field label displayed near the control." DefaultValue="null" />
        <SgDemoParam Name="Hint" Type="string" Description="Helper text shown below the control." DefaultValue="null" />
    </SgDemoParams>
</div>

@code {
    private TimeSpan? _meetingTime = new(14, 30, 0);
    private TimeSpan? _cutoffTime = new(23, 45, 30);
    private TimeSpan? _optionalTime;

    private static string FormatTime(TimeSpan? value, bool showSeconds)
    {
        if (!value.HasValue) return "none";
        return showSeconds
            ? $"{value.Value.Hours:D2}:{value.Value.Minutes:D2}:{value.Value.Seconds:D2}"
            : $"{value.Value.Hours:D2}:{value.Value.Minutes:D2}";
    }
}
