@page "/slider-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgSlider & SgRating — Range & Rating — SuperUI</PageTitle>
<SgSeoHead Description="SgSlider — fully customizable range slider with marks, tooltips, sizes, colors, vertical mode, and format callbacks. SgRating — star rating with half-star precision, sizes, colors, and animation." />

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <HeaderContent>
        <DemoPageHeader Title="Range &amp; Rating"
                        Subtitle="SgSlider — fully customizable range slider with marks, tooltips, sizes, colors, vertical mode, and format callbacks. SgRating — star rating with half-star precision, sizes, colors, and animation."
                        Icon="@SgHeroicons.Outline.ChartBarSquare"
                        GradientFrom="var(--sg-color-warning)"
                        GradientTo="var(--sg-color-danger)" />
    </HeaderContent>
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. SgSlider                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgSlider — Range Slider
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Numeric range selector with configurable min/max, step, marks, tooltips, sizes, colors, and vertical orientation. Supports <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">@@bind-Value</SgTypography> and <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">OnChange</SgTypography> callback.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Basic
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgSlider TValue="double" @bind-Value="@_slider1" Label="Simple slider" Min="0" Max="100" />
                            <SgSlider TValue="double" @bind-Value="@_slider2" Label="Step 10" Min="0" Max="100" Step="10" />
                            <SgSlider TValue="double" @bind-Value="@_slider3" Label="Suffix %" Min="0" Max="100" Suffix="%" />
                            <SgSlider TValue="double" @bind-Value="@_slider4" Label="Prefix $" Min="0" Max="100" Prefix="$" />
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            States
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgSlider TValue="double" @bind-Value="@_slider5" Label="Disabled" Min="0" Max="100" Disabled="true" />
                            <SgSlider TValue="double" @bind-Value="@_slider6" Label="With tooltip" Min="0" Max="100" ShowTooltip="true" />
                            <SgSlider TValue="double" @bind-Value="@_slider7" Label="Custom color" Min="0" Max="100" Color="var(--sg-color-success)" />
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Marks & Labels
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgSlider TValue="double" @bind-Value="@_slider8" Label="With marks" Min="0" Max="100" Step="25" Marks="@_marks1" />
                            <SgSlider TValue="double" @bind-Value="@_slider9" Label="Marks + labels" Min="0" Max="100" Step="25" Marks="@_marks1" ShowMarksLabels="true" />
                            <SgSlider TValue="double" @bind-Value="@_slider10" Label="Custom mark labels" Min="0" Max="100" Step="25" Marks="@_marks1" MarksLabels="@_markLabels" />
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Sizes
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgSlider TValue="double" @bind-Value="@_slider11" Label="Small (Sm)" Min="0" Max="100" Size="SgSize.Sm" />
                            <SgSlider TValue="double" @bind-Value="@_slider12" Label="Medium (Md, default)" Min="0" Max="100" Size="SgSize.Md" />
                            <SgSlider TValue="double" @bind-Value="@_slider13" Label="Large (Lg)" Min="0" Max="100" Size="SgSize.Lg" />
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Vertical
                        </SgTypography>
                        <SgStack Horizontal Space="SgSize.Lg" Align="SgAlignItems.Center" Style="min-height:180px;">
                            <SgSlider TValue="double" @bind-Value="@_slider14" Label="Sm" Min="0" Max="100" Size="SgSize.Sm" Vertical="true" ShowTooltip="true" />
                            <SgSlider TValue="double" @bind-Value="@_slider15" Label="Md" Min="0" Max="100" Vertical="true" ShowTooltip="true" />
                            <SgSlider TValue="double" @bind-Value="@_slider16" Label="Lg" Min="0" Max="100" Size="SgSize.Lg" Vertical="true" ShowTooltip="true" />
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            FormatValue (custom formatter)
                        </SgTypography>
                        <SgSlider TValue="double" @bind-Value="@_slider17" Label="Temperature" Min="-20" Max="50" FormatValue="@(v => $"{v:F1}°C")" ShowTooltip="true" Color="#ef4444" />
                        <SgSlider TValue="double" @bind-Value="@_slider18" Label="Progress" Min="0" Max="1" Step="0.01" FormatValue="@(v => $"{v:P0}")" ShowTooltip="true" Color="#8b5cf6" />
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="SgSlider Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_sliderProperties" />
            </SgCard>
        </div>

        <!-- Live value displays -->
        <div style="margin-top:16px;display:flex;flex-wrap:wrap;gap:8px;align-items:center;">
            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="margin-right:4px;">Live Values:</SgTypography>
            @foreach (var val in _liveValues)
            {
                <span class="demo-live-chip">@val.Label: <strong>@val.Value</strong></span>
            }
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. SgRating                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgRating — Star Rating
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Star-based rating widget with half-star precision, custom colors, sizes, labels, character/emoji mode, custom icons, clearable, tooltips, and read-only display. Supports <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">@@bind-Value</SgTypography>.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Basic
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Sm">
                            <div class="demo-flex-row" style="align-items:center;gap:12px;">
                                <SgRating @bind-Value="@_rating1" />
                                <SgBadge Variant="SgBadgeVariant.Warn" Text="@($"Value: {_rating1:F1}")" Standalone="true" />
                            </div>
                            <div class="demo-flex-row" style="align-items:center;gap:12px;">
                                <SgRating @bind-Value="@_rating2" Label="Rating" ShowValue="true" />
                            </div>
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            States
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgRating Value="7" Max="10" ReadOnly="true" Label="10 stars (read-only)" ShowValue="true" />
                            <SgRating Value="3" Max="5" Disabled="true" Label="Disabled" ShowValue="true" />
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Half-star & Colors
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgRating Value="3.5" Max="5" HalfStar="true" Label="Half-star" ShowValue="true" />
                            <SgRating Value="4" Max="5" Color="var(--sg-color-success)" Label="Success" ShowValue="true" />
                            <SgRating Value="2.5" Max="5" HalfStar="true" Color="#e91e63" Label="Custom" ShowValue="true" />
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Sizes
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgRating Value="3" Max="5" Size="SgSize.Sm" Label="Small" ShowValue="true" />
                            <SgRating Value="3" Max="5" Size="SgSize.Md" Label="Medium (default)" ShowValue="true" />
                            <SgRating Value="3" Max="5" Size="SgSize.Lg" Label="Large" ShowValue="true" />
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            No animation
                        </SgTypography>
                        <SgRating Value="3" Max="5" Animation="false" Label="Animation disabled" ShowValue="true" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Advanced
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Sm">
                            <div class="demo-flex-row" style="align-items:center;gap:12px;">
                                <SgRating @bind-Value="@_ratingClear" Clearable="true" Label="Clearable (click again)" ShowValue="true" />
                            </div>
                            <div class="demo-flex-row" style="align-items:center;gap:12px;">
                                <SgRating Value="4" Max="5" Icon="@SgIcons.Heart" FillIcon="@SgIcons.HeartFill" Color="#ef4444" Label="Heart icons" ShowValue="true" />
                            </div>
                            <div class="demo-flex-row" style="align-items:center;gap:12px;">
                                <SgRating @bind-Value="@_ratingChar" Character="❤" Label="Character mode" ShowValue="true" Color="#ef4444" />
                            </div>
                            <div class="demo-flex-row" style="align-items:center;gap:12px;">
                                <SgRating Value="3" Max="5" Character="👍" Label="Thumbs up" ShowValue="true" Color="#22c55e" />
                            </div>
                            <div class="demo-flex-row" style="align-items:center;gap:12px;">
                                <SgRating Value="3" Max="5" Tooltip="@(v => v switch { 1 => "Poor", 2 => "Fair", 3 => "Good", 4 => "Very Good", 5 => "Excellent", _ => "" })" Label="Tooltip (hover stars)" ShowValue="true" />
                            </div>
                        </SgStack>
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="SgRating Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_ratingProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. SgRangeSlider                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgRangeSlider — Dual-Thumb Range
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Two-thumb range slider for selecting a min-max interval. Supports labels, tooltips, sizes, colors, and disabled state with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">LowerValue</SgTypography>/<SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">UpperValue</SgTypography> binding.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Examples" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Lg">
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Basic
                        </SgTypography>
                        <SgRangeSlider @bind-LowerValue="@_rangeLow1" @bind-UpperValue="@_rangeHigh1" Label="Price range" Min="0" Max="1000" Step="10" ShowValue="true" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            With tooltip
                        </SgTypography>
                        <SgRangeSlider @bind-LowerValue="@_rangeLow2" @bind-UpperValue="@_rangeHigh2" Label="Temperature" Min="-10" Max="40" Step="1" ShowTooltip="true" Color="#ef4444" />
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Custom format + sizes
                        </SgTypography>
                        <SgStack Vertical Space="SgSize.Md">
                            <SgRangeSlider @bind-LowerValue="@_rangeLow3" @bind-UpperValue="@_rangeHigh3" Label="Budget" Min="0" Max="10000" Step="500" FormatValue="@(v => $"${v:F0}")" Size="SgSize.Sm" />
                            <SgRangeSlider @bind-LowerValue="@_rangeLow4" @bind-UpperValue="@_rangeHigh4" Label="Percentage" Min="0" Max="100" Step="5" FormatValue="@(v => $"{v:F0}%")" Size="SgSize.Lg" Color="#8b5cf6" />
                        </SgStack>
                    </div>
                    <div>
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;margin-bottom:10px;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">
                            Disabled
                        </SgTypography>
                        <SgRangeSlider LowerValue="25" UpperValue="75" Label="Disabled range" Min="0" Max="100" Disabled="true" ShowValue="true" />
                    </div>
                </SgStack>
            </SgCard>

            <SgCard Title="SgRangeSlider Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_rangeSliderProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Live SgSlider Constructor                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live SgSlider Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure parameters and see the result in real time. Click any preview to copy its code.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">
                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">
                        <!-- Value -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Value: @_ctorSliderValue.ToString("F0")</SgTypography>
                            <SgSlider TValue="double" @bind-Value="@_ctorSliderValue" Min="0" Max="100" ShowTooltip="true" />
                        </SgStack>

                        <!-- Min / Max -->
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Min</SgTypography>
                                    <SgSlider TValue="double" @bind-Value="@_ctorMin" Min="-100" Max="0" Step="10" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Max</SgTypography>
                                    <SgSlider TValue="double" @bind-Value="@_ctorMax" Min="10" Max="200" Step="10" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Step -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Step</SgTypography>
                            <SgSegmented TValue="double"
                                         Value="@_ctorStep"
                                         ValueChanged="v => { _ctorStep = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_stepSegOptions" />
                        </SgStack>

                        <!-- Size -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                            <SgSegmented TValue="SgSize"
                                         Value="@_ctorSize"
                                         ValueChanged="v => { _ctorSize = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_sizeSegOptions" />
                        </SgStack>

                        <!-- Toggles -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">ShowTooltip</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorShowTooltip"
                                                 ValueChanged="v => { _ctorShowTooltip = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Vertical</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_ctorVertical"
                                                 ValueChanged="v => { _ctorVertical = v; UpdateConstructorCode(); }"
                                                 Block="true"
                                                 Size="sm"
                                                 Options="_boolSegOptions" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Suffix -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Suffix</SgTypography>
                            <SgSegmented TValue="string"
                                         Value="@_ctorSuffix"
                                         ValueChanged="v => { _ctorSuffix = v; UpdateConstructorCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_suffixSegOptions" />
                        </SgStack>

                        <!-- Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Min</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorMin.ToString("F0")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Max</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorMax.ToString("F0")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Step</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Success" Text="@_ctorStep.ToString("F0")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_ctorSize.ToString()" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>
                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">
                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <div class="constructor-preview" id="constructor-preview" style="@(_ctorVertical ? "height:200px;display:flex;align-items:center;justify-content:center;" : "")">
                                <SgSlider TValue="double"
                                          Value="@_ctorSliderValue"
                                          ValueChanged="v => { _ctorSliderValue = v; UpdateConstructorCode(); StateHasChanged(); }"
                                          Min="@_ctorMin"
                                          Max="@_ctorMax"
                                          Step="@_ctorStep"
                                          Size="@_ctorSize"
                                          Suffix="@_ctorSuffix"
                                          ShowTooltip="@_ctorShowTooltip"
                                          Vertical="@_ctorVertical"
                                          ShowValue="true" />
                            </div>
                        </SgStack>

                        <!-- Code with Copy -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCodeToClipboard">
                                    <span id="copy-icon">@_copyIcon</span>
                                    <span id="copy-text" style="font-size:11px;font-weight:600;">@_copyLabel</span>
                                </button>
                            </div>
                            <div class="code-block" id="code-block">
                                @foreach (var line in _generatedCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>
                    </SgStack>
                </SgCol>
            </SgRow>
        </SgCard>
    </div>

    </ChildContent>
</SgCard>

