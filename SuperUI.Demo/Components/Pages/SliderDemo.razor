    // ── Lifecycle ───────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add($"<SgSlider TValue=\"double\"");
        lines.Add($"           Value=\"@_myValue\"");
        lines.Add($"           Min=\"{_ctorMin:F0}\" Max=\"{_ctorMax:F0}\"");
        if (_ctorStep != 1)
            lines.Add($"           Step=\"{_ctorStep:F0}\"");
        if (_ctorSize != SgSize.Md)
            lines.Add($"           Size=\"SgSize.{_ctorSize}\"");
        if (!string.IsNullOrEmpty(_ctorSuffix))
            lines.Add($"           Suffix=\"{_ctorSuffix}\"");
        if (_ctorShowTooltip)
            lines.Add($"           ShowTooltip=\"true\"");
        if (_ctorVertical)
            lines.Add($"           Vertical=\"true\"");
        lines.Add($"           ShowValue=\"true\" />");
        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyCodeToClipboard()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copyIcon = "✓";
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _copyIcon = "✗";
            _copyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _copyIcon = "📋";
            _copyLabel = "Copy";
            StateHasChanged();
        }
    }

