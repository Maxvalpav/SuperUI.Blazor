@page "/slider-demo"
@using SuperUI.Components
@using SuperUI.Demo.Models

<PageTitle>Ползунки и рейтинг - SUI</PageTitle>

<SgCard Title="Компоненты выбора значения"
        Subtitle="Визуальные компоненты для выбора числовых значений — ползунки и рейтинг."
        CssClass="sgc-card-flush">

    @* ── SgSlider ─────────────────────────────────────────────────── *@
    <div class="sgc-demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading2">SgSlider</SgTypography>
            <span class="demo-live-badge">Интерактивный</span>
        </div>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" CssClass="demo-section-desc">Компонент для выбора значения в диапазоне с визуальным ползунком. Перетащите ползунок для изменения значения.</SgTypography>

        <div class="demo-grid-adaptive">
            <SgCard Title="Примеры использования" CssClass="demo-interactive-card">
                <div class="demo-flex-col">
                    <SgSlider TValue="double" @bind-Value="@_slider1" Label="Простой ползунок" Min="0" Max="100" ShowValue="true" />
                    <SgSlider TValue="double" @bind-Value="@_slider2" Label="С шагом 10" Min="0" Max="100" Step="10" ShowValue="true" />
                    <SgSlider TValue="double" @bind-Value="@_slider3" Label="С суффиксом %" Min="0" Max="100" Suffix="%" ShowValue="true" />
                    <SgSlider TValue="double" @bind-Value="@_slider4" Label="Отключённый" Min="0" Max="100" Disabled="true" ShowValue="true" />
                    <SgSlider TValue="double" @bind-Value="@_slider5" Label="С тултипом" Min="0" Max="100" ShowValue="true" ShowTooltip="true" />
                    <SgSlider TValue="double" @bind-Value="@_slider6" Label="С метками" Min="0" Max="100" Step="25" ShowValue="true" Marks="@_sliderMarks" />
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_sliderProperties" />
            </SgCard>
        </div>

        <div class="demo-interactive-controls">
            <div class="demo-control-group">
                <span>Текущие значения:</span>
            </div>
            <div class="demo-value-display">
                <span class="demo-value-display-label">Slider 1</span>
                <span class="demo-value-display-value">@_slider1.ToString("F0")</span>
            </div>
            <div class="demo-value-display">
                <span class="demo-value-display-label">Slider 2</span>
                <span class="demo-value-display-value">@_slider2.ToString("F0")</span>
            </div>
            <div class="demo-value-display">
                <span class="demo-value-display-label">Slider 3</span>
                <span class="demo-value-display-value">@_slider3.ToString("F0")%</span>
            </div>
            <div class="demo-value-display">
                <span class="demo-value-display-label">Tooltip</span>
                <span class="demo-value-display-value">@_slider5.ToString("F0")</span>
            </div>
            <div class="demo-value-display">
                <span class="demo-value-display-label">Marks</span>
                <span class="demo-value-display-value">@_slider6.ToString("F0")</span>
            </div>
        </div>

        <div style="margin-top:16px;">
            <pre class="demo-code-block"><span class="demo-code-comment">&lt;!-- SgSlider with live value display --&gt;</span>
<span class="demo-code-keyword">&lt;SgSlider</span> <span class="demo-code-attr">TValue</span>=<span class="demo-code-string">"double"</span>
          <span class="demo-code-attr">@@bind-Value</span>=<span class="demo-code-string">"@@_myValue"</span>
          <span class="demo-code-attr">Min</span>=<span class="demo-code-string">"0"</span> <span class="demo-code-attr">Max</span>=<span class="demo-code-string">"100"</span>
          <span class="demo-code-attr">Step</span>=<span class="demo-code-string">"5"</span>
          <span class="demo-code-attr">Suffix</span>=<span class="demo-code-string">"%"</span>
          <span class="demo-code-attr">ShowValue</span>=<span class="demo-code-string">"true"</span> <span class="demo-code-keyword">/&gt;</span>
<span class="demo-code-comment">&lt;!-- With tooltip and marks --&gt;</span>
<span class="demo-code-keyword">&lt;SgSlider</span> <span class="demo-code-attr">TValue</span>=<span class="demo-code-string">"double"</span> <span class="demo-code-attr">@@bind-Value</span>=<span class="demo-code-string">"@@_v"</span>
          <span class="demo-code-attr">ShowTooltip</span>=<span class="demo-code-string">"true"</span>
          <span class="demo-code-attr">ShowValue</span>=<span class="demo-code-string">"true"</span> <span class="demo-code-keyword">/&gt;</span>
<span class="demo-code-keyword">&lt;SgSlider</span> <span class="demo-code-attr">TValue</span>=<span class="demo-code-string">"double"</span> <span class="demo-code-attr">@@bind-Value</span>=<span class="demo-code-string">"@@_v"</span>
          <span class="demo-code-attr">Step</span>=<span class="demo-code-string">"25"</span> <span class="demo-code-attr">Marks</span>=<span class="demo-code-string">"@@(new List&lt;double&gt; { 0, 25, 50, 75, 100 })"</span> <span class="demo-code-keyword">/&gt;</span></pre>
        </div>
    </div>

    @* ── SgRating ─────────────────────────────────────────────────── *@
    <div class="sgc-demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading2">SgRating</SgTypography>
            <span class="demo-live-badge">Интерактивный</span>
        </div>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)" CssClass="demo-section-desc">Компонент для выбора числового значения в виде звезд. Динамическая оценка.</SgTypography>

        <div class="demo-grid-adaptive">
            <SgCard Title="Примеры использования" CssClass="demo-interactive-card">
                <div class="demo-flex-col">
                    <div>
                        <div class="demo-label">Базовый — нажмите звезду</div>
                        <div class="demo-flex-row">
                            <SgRating @bind-Value="@_rating1" />
                            <div class="demo-value-display">
                                <span class="demo-value-display-label">Value:</span>
                                <span class="demo-value-display-value">@_rating1.ToString("0.#") / 5</span>
                            </div>
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div class="demo-label">10 звезд, только чтение</div>
                        <div style="margin-top:8px;">
                            <SgRating Value="7" Max="10" ReadOnly="true" />
                        </div>
                    </div>
                    <SgDivider />
                    <div>
                        <div class="demo-label">Half-star &amp; Color</div>
                        <div class="demo-flex-row" style="margin-top:8px;">
                            <SgRating Value="3.5" Max="5" HalfStar="true" />
                            <SgRating Value="4" Max="5" Color="var(--sg-color-success)" />
                            <SgRating Value="2.5" Max="5" HalfStar="true" Color="#e91e63" />
                        </div>
                    </div>
                </div>
            </SgCard>
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_ratingProperties" />
            </SgCard>
        </div>

        <div style="margin-top:16px;">
            <pre class="demo-code-block"><span class="demo-code-comment">&lt;!-- SgRating with live binding --&gt;</span>
<span class="demo-code-keyword">&lt;SgRating</span> <span class="demo-code-attr">@@bind-Value</span>=<span class="demo-code-string">"@@_myRating"</span> <span class="demo-code-keyword">/&gt;</span>
<span class="demo-code-keyword">&lt;SgRating</span> <span class="demo-code-attr">Value</span>=<span class="demo-code-string">"7"</span> <span class="demo-code-attr">Max</span>=<span class="demo-code-string">"10"</span> <span class="demo-code-attr">ReadOnly</span>=<span class="demo-code-string">"true"</span> <span class="demo-code-keyword">/&gt;</span>
<span class="demo-code-comment">&lt;!-- Half-star and color variants --&gt;</span>
<span class="demo-code-keyword">&lt;SgRating</span> <span class="demo-code-attr">Value</span>=<span class="demo-code-string">"3.5"</span> <span class="demo-code-attr">Max</span>=<span class="demo-code-string">"5"</span> <span class="demo-code-attr">HalfStar</span>=<span class="demo-code-string">"true"</span> <span class="demo-code-keyword">/&gt;</span>
<span class="demo-code-keyword">&lt;SgRating</span> <span class="demo-code-attr">Value</span>=<span class="demo-code-string">"4"</span> <span class="demo-code-attr">Max</span>=<span class="demo-code-string">"5"</span> <span class="demo-code-attr">Color</span>=<span class="demo-code-string">"var(--sg-color-success)"</span> <span class="demo-code-keyword">/&gt;</span></pre>
        </div>
    </div>

</SgCard>

<style>
    .sgc-card-flush > .sgc-card-body {
        padding: 0 24px 24px;
    }
    @@media (max-width: 640px) {
        .sgc-card-flush > .sgc-card-body {
            padding: 0 12px 12px;
        }
    }
    .demo-mt-2 { margin-top: 8px; }
</style>

@code {
    // Slider
    private double _slider1 = 50;
    private double _slider2 = 30;
    private double _slider3 = 75;
    private double _slider4 = 40;
    private double _slider5 = 60;
    private double _slider6 = 25;
    private List<double> _sliderMarks = new() { 0, 25, 50, 75, 100 };

    private double _rating1 = 4;

    private List<PropertyPanelItem> _sliderProperties = new()
    {
        new() { Label = "Value", Value = "TValue", BadgeText = "Значение", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Min", Value = "double", BadgeText = "Минимум", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Max", Value = "double", BadgeText = "Максимум", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Step", Value = "double", BadgeText = "Шаг", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Label", Value = "string", BadgeText = "Метка", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Suffix", Value = "string", BadgeText = "Суффикс", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ShowValue", Value = "bool", BadgeText = "Показать значение", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ShowTooltip", Value = "bool", BadgeText = "Тултип над бегунком", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Marks", Value = "List&lt;double&gt;?", BadgeText = "Метки на шкале", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Disabled", Value = "bool", BadgeText = "Отключить", BadgeVariant = SgBadgeVariant.Warn }
    };

    private List<PropertyPanelItem> _ratingProperties = new()
    {
        new() { Label = "Value", Value = "double", BadgeText = "Текущее значение", Description = "0" },
        new() { Label = "Max", Value = "int", BadgeText = "Максимум", Description = "5" },
        new() { Label = "Disabled", Value = "bool", BadgeText = "Отключено", Description = "false" },
        new() { Label = "ReadOnly", Value = "bool", BadgeText = "Только для чтения", Description = "false" },
        new() { Label = "HalfStar", Value = "bool", BadgeText = "Половина звезды", Description = "false" },
        new() { Label = "Color", Value = "string?", BadgeText = "Цвет активных", Description = "—" }
    };
}
