@page "/timeline-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgTimeline — Timeline — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Modes — Left / Right / Alternate                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Modes — SgTimelineMode
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Three layout modes: <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Left</SgTypography> (default), <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Right</SgTypography>, and <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Alternate</SgTypography>.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="4">
                <SgCard Title="Left" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTimeline Items="_projectTimeline" />
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Right" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTimeline Items="_projectTimeline" Mode="SgTimelineMode.Right" />
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Alternate" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgTimeline Items="_projectTimeline" Mode="SgTimelineMode.Alternate" />
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Status Variants + Colors                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Status Variants &amp; Dot Colors
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Status</SgTypography> for semantic dots (Default, Active, Done, Error, Pending) or <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Color</SgTypography> for custom colors.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Semantic Statuses" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgTimeline Items="_statusTimeline" />
            </SgCard>
            <SgCard Title="Custom Dot Colors" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgTimeline Items="_colorTimeline" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Dot Sizes & Line Styles                                          -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Dot Sizes &amp; Line Styles
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Control dot size with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">DotSize</SgTypography> (Sm/Md/Lg/Xl) and line style with <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">LineStyle</SgTypography> (Solid/Dashed/Dotted).
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="Dot Sizes" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgTimeline Items="_smItem" DotSize="SgSize.Sm" />
                        <SgTimeline Items="_mdItem" DotSize="SgSize.Md" />
                        <SgTimeline Items="_lgItem" DotSize="SgSize.Lg" />
                        <SgTimeline Items="_xlItem" DotSize="SgSize.Xl" />
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Line Styles" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">Solid</SgTypography>
                        <SgTimeline Items="_lineStyleDemo" />
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;border-bottom:1px solid var(--sg-border);padding-bottom:4px;margin-top:8px;">Dashed</SgTypography>
                        <SgTimeline Items="_lineStyleDemo" LineStyle="SgTimelineLineStyle.Dashed" />
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;border-bottom:1px solid var(--sg-border);padding-bottom:4px;margin-top:8px;">Dotted</SgTypography>
                        <SgTimeline Items="_lineStyleDemo" LineStyle="SgTimelineLineStyle.Dotted" />
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;border-bottom:1px solid var(--sg-border);padding-bottom:4px;margin-top:8px;">None</SgTypography>
                        <SgTimeline Items="_lineStyleDemo" LineStyle="SgTimelineLineStyle.None" />
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Clickable Items + Pending + ShowLine                             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Interactive — Click, Pending &amp; ShowLine
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Clickable</SgTypography> + <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">OnItemClick</SgTypography> for click events. <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Pending</SgTypography> adds a ghost last item. <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ShowLine</SgTypography> hides connecting lines.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Clickable Timeline" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgTimeline Items="_clickableTimeline" Clickable="true" OnItemClick="OnTimelineItemClick" />
                    @if (_lastClicked is not null)
                    {
                        <SgAlert Variant="SgAlertVariant.Info" Dismissible="true" OnClose="() => _lastClicked = null">
                            <ChildContent>
                                <SgTypography Size="SgTypographySize.Sm">Clicked: <strong>@_lastClicked.Title</strong> — @_lastClicked.Description</SgTypography>
                            </ChildContent>
                        </SgAlert>
                    }
                </SgStack>
            </SgCard>
            <SgCard Title="Pending + ShowLine=false" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;border-bottom:1px solid var(--sg-border);padding-bottom:4px;">Pending ghost item</SgTypography>
                    <SgTimeline Items="_pendingTimeline" Pending="@_pendingItem" />
                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="display:block;border-bottom:1px solid var(--sg-border);padding-bottom:4px;margin-top:8px;">No connecting lines (ShowLine=false)</SgTypography>
                    <SgTimeline Items="_showLineTimeline" ShowLine="false" />
                </SgStack>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Extra Content + Icons in Dots                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Extra Content &amp; Icons
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">ExtraContent</SgTypography> for expandable details, cards, or badges. Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Icon</SgTypography> to render an SVG inside the dot.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Extra content panels" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgTimeline Items="_extraTimeline" />
            </SgCard>
            <SgCard Title="Icons in dots" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgTimeline Items="_iconTimeline" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. Live Constructor                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure parameters and see the timeline render in real time. Copy the generated code.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Mode</SgTypography>
                            <SgSegmented TValue="SgTimelineMode"
                                         Value="@_ctorMode"
                                         ValueChanged="v => { _ctorMode = v; UpdateCtorCode(); }"
                                         Block="true" Size="sm"
                                         Options="@(_ctorModeOptions)" />
                        </SgStack>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Dot Size</SgTypography>
                                    <SgSegmented TValue="SgSize"
                                                 Value="@_ctorDotSize"
                                                 ValueChanged="v => { _ctorDotSize = v; UpdateCtorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="@(_ctorSizeOptions)" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Line Style</SgTypography>
                                    <SgSegmented TValue="SgTimelineLineStyle"
                                                 Value="@_ctorLineStyle"
                                                 ValueChanged="v => { _ctorLineStyle = v; UpdateCtorCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="@(_ctorLineStyleOptions)" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Reverse</SgTypography>
                                    <SgSwitch Value="@_ctorReverse"
                                              ValueChanged="v => { _ctorReverse = v; UpdateCtorCode(); }" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Animation</SgTypography>
                                    <SgSwitch Value="@_ctorAnim"
                                              ValueChanged="v => { _ctorAnim = v; UpdateCtorCode(); }" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgRow Space="SgSize.Sm">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">ShowLine</SgTypography>
                                    <SgSwitch Value="@_ctorShowLine"
                                              ValueChanged="v => { _ctorShowLine = v; UpdateCtorCode(); }" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Clickable</SgTypography>
                                    <SgSwitch Value="@_ctorClickable"
                                              ValueChanged="v => { _ctorClickable = v; UpdateCtorCode(); }" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Mode</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorMode.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Dot Size</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorDotSize.ToString()" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <div class="constructor-preview">
                                <SgTimeline Items="@_ctorItems"
                                            Mode="@_ctorMode"
                                            DotSize="@_ctorDotSize"
                                            LineStyle="@_ctorLineStyle"
                                            Reverse="@_ctorReverse"
                                            Animation="@_ctorAnim"
                                            ShowLine="@_ctorShowLine"
                                            Clickable="@_ctorClickable" />
                            </div>
                        </SgStack>

                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCtorCode">
                                    <span id="copy-icon">@_ctorCopyIcon</span>
                                    <span id="copy-text" style="font-size:11px;font-weight:600;">@_ctorCopyLabel</span>
                                </button>
                            </div>
                            <div class="code-block">
                                @foreach (var line in _ctorCodeLines)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>
                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 7. Properties                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                All SgTimeline Parameters
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Complete reference of public parameters on <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgTimeline</SgTypography> and <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">TimelineItem</SgTypography>.
            </SgTypography>
        </div>

        <SgStack Vertical Space="SgSize.Md">
            <SgCard Title="SgTimeline" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_tlProps" />
            </SgCard>
            <SgCard Title="TimelineItem" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_itemProps" />
            </SgCard>
            <SgCard Title="Enums" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_enumProps" />
            </SgCard>
        </SgStack>
    </div>

    </ChildContent>
</SgCard>

<style>
    .demo-section { margin-top: 48px; }
    .demo-section-header { margin-bottom: 20px; }
    .demo-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    @@media (max-width: 768px) { .demo-two-col { grid-template-columns: 1fr; } }
    .constructor-preview {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 20px;
        min-height: 180px;
        transition: all 0.3s ease;
    }
    .ctrl-summary {
        background: var(--sg-surface-alt);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        padding: 12px 14px;
    }
    .code-block {
        background: #0f172a;
        color: #7dd3fc;
        padding: 14px 16px;
        border-radius: 8px;
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 12px;
        line-height: 1.9;
        overflow-x: auto;
    }
    .code-block code {
        background: none; padding: 0; color: inherit; font-size: inherit;
        display: block; white-space: pre;
    }
    .demo-copy-btn {
        display: inline-flex; align-items: center; gap: 4px;
        background: var(--sg-surface-alt); border: 1px solid var(--sg-border);
        border-radius: 6px; padding: 4px 10px; cursor: pointer;
        color: var(--sg-text-muted); transition: all 0.2s ease; font-family: inherit;
    }
    .demo-copy-btn:hover {
        color: var(--sg-primary); border-color: var(--sg-primary);
        background: color-mix(in srgb, var(--sg-primary) 8%, transparent);
    }
    .demo-copy-btn:active { transform: scale(0.95); }
</style>

@code {
    // ── Main card header ─────────────────────────────────────────────────
    private RenderFragment _mainHeader => __builder =>
    {
        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
            <div style="display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,var(--sg-primary),#8b5cf6);color:#fff;flex-shrink:0;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
            </div>
            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">SgTimeline — Timeline</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    Vertical timeline with modes, status dots, clickable items, icons, extra content, pending ghost item, and more.
                </SgTypography>
            </SgStack>
        </SgStack>
    };

    // ── Clickable demo ──────────────────────────────────────────────────
    private TimelineItem? _lastClicked;

    private void OnTimelineItemClick(TimelineItem item) => _lastClicked = item;

    // ── Timeline data ──────────────────────────────────────────────────
    private readonly List<TimelineItem> _projectTimeline = new()
    {
        new() { Title = "Project Created",  Description = "Repository init & environment setup", Time = "15 Jan 2026", Status = "done" },
        new() { Title = "Release v1.0",     Description = "Core components: Button, Card, Grid", Time = "1 Feb 2026",  Status = "done" },
        new() { Title = "Data Components",  Description = "DataGrid, PivotTable, Kanban",         Time = "10 Mar 2026", Status = "done" },
        new() { Title = "Release v1.2",     Description = "Charts, 7 types, LTTB decimation",    Time = "28 Apr 2026", Status = "active" },
        new() { Title = "Planned v2.0",     Description = "WCAG 2.1 AA support, new components", Time = "Jun 2026",    Status = "pending" },
    };

    private readonly List<TimelineItem> _statusTimeline = new()
    {
        new() { Title = "Default",     Description = "Neutral dot",                              Time = "Status: Default" },
        new() { Title = "Active",      Description = "In progress — pulsing dot",                Time = "Status: Active",  StatusEnum = SgTimelineStatus.InProgress },
        new() { Title = "Done",        Description = "Completed — green dot",                    Time = "Status: Done",    StatusEnum = SgTimelineStatus.Done },
        new() { Title = "Error",       Description = "Failed — red dot",                         Time = "Status: Error",   StatusEnum = SgTimelineStatus.Error },
        new() { Title = "Pending",     Description = "Awaiting — muted dot",                     Time = "Status: Pending", StatusEnum = SgTimelineStatus.Pending },
    };

    private readonly List<TimelineItem> _colorTimeline = new()
    {
        new() { Title = "Violet",      Description = "Custom #7c3aed",     Time = "Custom color", Color = "#7c3aed" },
