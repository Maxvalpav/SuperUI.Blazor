@page "/timeline-demo"
@using SuperUI.Components

<PageTitle>Временная шкала - SUI</PageTitle>

<SgCard Title="SgTimeline — Временная шкала"
        Subtitle="Компонент для отображения последовательности событий. Поддерживает статусы, цвета, иконки и режимы выравнивания.">

    <div style="margin-top: 32px;">
        <h2>История проекта</h2>
        <p>Хронология ключевых событий с цветовыми статусами.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Режим left (по умолчанию)">
                <SgTimeline Items="_projectTimeline" />
            </SgCard>

            <SgCard Title="Режим alternate">
                <SgTimeline Items="_projectTimeline" Mode="SgTimelineMode.Alternate" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Статусы задачи</h2>
        <p>Используйте <code>Status</code> для семантической окраски точки без явного цвета.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Статусы (default / active / done / error / pending)">
                <SgTimeline Items="_taskTimeline" />
            </SgCard>

            <SgCard Title="Активность за сегодня">
                <SgTimeline Items="_activityTimeline" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Свойства компонента</h2>
        <PropertyTable Items="_timelineProperties" />
    </div>

    <!-- Enum tables + code -->
    <div style="margin-top: 32px;">
        <h2>Перечисления</h2>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="SgTimelineMode">
                <PropertyTable Items="_modeEnum" />
            </SgCard>
            <SgCard Title="SgTimelineStatus (TimelineItem.Status)">
                <PropertyTable Items="_statusEnum" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Примеры кода</h2>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="SgTimeline">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_timelineCode" />
            </SgCard>
            <SgCard Title="SgActivityFeed">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_feedCode" />
            </SgCard>
        </div>
    </div>

</SgCard>

<SgCard Title="SgActivityFeed — Лента активности"
        Subtitle="Компонент для отображения ленты событий с аватарами пользователей, группировкой и поддержкой кликов."
        style="margin-top: 24px;">

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
        <SgCard Title="Базовый пример">
            <SgActivityFeed Items="_activityFeedItems"
                            Title="Активность"
                            Subtitle="Последние действия в системе"
                            OnItemClick="OnFeedItemClick" />
        </SgCard>

        <SgCard Title="С группировкой по дате">
            <SgActivityFeed Items="_activityFeedGrouped"
                            GroupBy="@(item => item.Time ?? "")" />
        </SgCard>
    </div>

    @if (_lastClicked is not null)
    {
        <SgAlert Variant="SgAlertVariant.Info" Text="@($"Клик: {_lastClicked.Title}")" Dismissible="true" style="margin-top: 16px;" />
    }

    <div style="margin-top: 24px;">
        <h2>Свойства компонента</h2>
        <PropertyTable Items="_activityFeedProperties" />
    </div>

</SgCard>

