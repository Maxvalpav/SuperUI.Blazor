@page "/timeline-demo"
@using SuperUI.Components

<PageTitle>Временная шкала - SUI</PageTitle>

<SgCard Title="SgTimeline - Временная шкала"
        Subtitle="Компонент для отображения последовательности событий. Поддерживает различные статусы, цвета и иконки.">

    <div style="margin-top: 32px;">
        <h2>История проекта</h2>
        <p>Хронология ключевых событий проекта.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <SgTimeline Items="_projectTimeline" />
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_timelineProperties" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Лента активности</h2>
        <p>Последние действия пользователей в системе.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Активность за сегодня">
                <SgTimeline Items="_activityTimeline" />
            </SgCard>

            <SgCard Title="Статусы задач">
                <SgTimeline Items="_taskTimeline" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>SgActivityFeed - Лента активности</h2>
        <p>Компонент для отображения ленты событий с аватарами пользователей.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <SgActivityFeed Items="_activityFeedItems" />
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_activityFeedProperties" />
            </SgCard>
        </div>
    </div>

</SgCard>

