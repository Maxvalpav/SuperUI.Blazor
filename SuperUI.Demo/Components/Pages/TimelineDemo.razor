    protected override void OnInitialized() => UpdateCtorCode();

    private void UpdateCtorCode()
    {
        var lines = new List<string>();
        var attrs = new List<string> { "Items=\"_myItems\"" };
        if (_ctorMode != SgTimelineMode.Left) attrs.Add($"Mode=\"SgTimelineMode.{_ctorMode}\"");
        if (_ctorDotSize != SgSize.Sm) attrs.Add($"DotSize=\"SgSize.{_ctorDotSize}\"");
        if (_ctorLineStyle != SgTimelineLineStyle.Solid) attrs.Add($"LineStyle=\"SgTimelineLineStyle.{_ctorLineStyle}\"");
        if (_ctorReverse) attrs.Add("Reverse=\"true\"");
        if (!_ctorAnim) attrs.Add("Animation=\"false\"");
        if (!_ctorShowLine) attrs.Add("ShowLine=\"false\"");
        if (_ctorClickable) attrs.Add("Clickable=\"true\"");
        lines.Add("<SgTimeline " + string.Join("\n               ", attrs) + " />");
        _ctorCodeLines = lines.ToArray();
    }

    private async Task CopyCtorCode()
    {
        var code = string.Join("\n", _ctorCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _ctorCopyIcon = "✓";
            _ctorCopyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _ctorCopyIcon = "📋";
            _ctorCopyLabel = "Copy";
            StateHasChanged();
        }
        catch
        {
            _ctorCopyIcon = "✗";
            _ctorCopyLabel = "Failed";
            StateHasChanged();
            await Task.Delay(1500);
            _ctorCopyIcon = "📋";
            _ctorCopyLabel = "Copy";
            StateHasChanged();
        }
    }

