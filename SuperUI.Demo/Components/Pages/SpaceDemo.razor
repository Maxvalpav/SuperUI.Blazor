@page "/space-demo"
@using SuperUI.Components
@using SuperUI.Enums

<PageTitle>Space — SuperUI</PageTitle>

<div class="sg-demo-header">
    <h1>Space</h1>
    <p class="sg-text-muted">Set components spacing.</p>
</div>

<SgStack Orientation="SgOrientation.Vertical" Gap="24px">

    <SgCard Title="Basic Usage" Compact="true">
        <SgSpace>
            <SgButton Variant="SgButtonVariant.Primary">Button 1</SgButton>
            <SgButton Variant="SgButtonVariant.Outlined">Button 2</SgButton>
            <SgButton Variant="SgButtonVariant.Ghost">Button 3</SgButton>
        </SgSpace>
    </SgCard>

    <SgCard Title="Sizes" Compact="true">
        <SgStack Orientation="SgOrientation.Vertical" Gap="16px">
            <SgSpace Size="small">
                <SgTag>Small</SgTag>
                <SgTag>8px</SgTag>
            </SgSpace>
            <SgSpace Size="middle">
                <SgTag>Middle</SgTag>
                <SgTag>16px</SgTag>
            </SgSpace>
            <SgSpace Size="large">
                <SgTag>Large</SgTag>
                <SgTag>24px</SgTag>
            </SgSpace>
            <SgSpace Size="40px">
                <SgTag>Custom</SgTag>
                <SgTag>40px</SgTag>
            </SgSpace>
        </SgStack>
    </SgCard>

    <SgCard Title="Vertical Orientation" Compact="true">
        <SgSpace Orientation="SgOrientation.Vertical" Size="middle">
            <SgCard Style="width: 200px;">Item 1</SgCard>
            <SgCard Style="width: 200px;">Item 2</SgCard>
            <SgCard Style="width: 200px;">Item 3</SgCard>
        </SgSpace>
    </SgCard>

    <SgCard Title="Alignment" Compact="true">
        <div style="background: var(--sg-bg-subtle); padding: 16px; border-radius: 8px;">
            <SgSpace Align="SgAlignItems.End" Style="height: 100px;">
                <SgButton Variant="SgButtonVariant.Primary">Align End</SgButton>
                <SgCard>Tall Item<br/>Extra line</SgCard>
            </SgSpace>
        </div>
    </SgCard>

    <SgCard Title="Wrapping" Compact="true">
        <div style="width: 300px; border: 1px dashed var(--sg-border); padding: 8px;">
            <SgSpace Wrap="true" Size="small">
                @for (int i = 1; i <= 10; i++)
                {
                    <SgButton Variant="SgButtonVariant.Outlined">Btn @i</SgButton>
                }
            </SgSpace>
        </div>
    </SgCard>

</SgStack>
