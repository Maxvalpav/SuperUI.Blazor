@page "/skeleton-demo"
@using SuperUI.Components

<PageTitle>Скелет загрузки - SUI</PageTitle>

<SgCard Title="SgSkeleton - Скелет загрузки"
        Subtitle="Компонент для отображения заполнителей во время загрузки контента. Поддерживает различные формы и анимацию.">

    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">Варианты скелетов</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Различные конфигурации скелетов для разных типов контента.</SgTypography>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Текстовый скелет">
                <SgSkeleton Active="true" Paragraph="true" />
            </SgCard>

            <SgCard Title="Скелет с аватаром">
                <SgSkeleton Active="true" Avatar="true" Paragraph="true" />
            </SgCard>

            <SgCard Title="Только заголовок">
                <SgSkeleton Active="true" Paragraph="false" />
            </SgCard>

            <SgCard Title="Округлённый">
                <SgSkeleton Active="true" Round="true" Paragraph="true" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">Интерактивный пример</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Переключите загрузку для просмотра скелета и реального контента.</SgTypography>

        <SgCard Title="Карточка пользователя" Style="margin-top: 16px;">
            <div style="margin-bottom: 16px;">
                <SgSwitch @bind-Value="@_isLoading" Label="Режим загрузки" />
            </div>

            @if (_isLoading)
            {
                <SgSkeleton Active="true" Avatar="true" Paragraph="true" />
            }
            else
            {
                <div style="display: flex; align-items: flex-start; gap: 16px;">
                    <SgAvatar Title="Иван Петров" Color="#1890ff" Size="SgSize.Lg" />
                    <div>
                        <div style="font-size: 16px; font-weight: 600;">Иван Петров</div>
                        <div style="color: var(--sui-text-muted); margin-top: 4px;">Старший разработчик · Отдел R&D</div>
                        <div style="margin-top: 8px; display: flex; gap: 8px;">
                            <SgBadge Text="Blazor" Variant="SgBadgeVariant.Success" />
                            <SgBadge Text="C#" Variant="SgBadgeVariant.Default" />
                            <SgBadge Text=".NET" Variant="SgBadgeVariant.Default" />
                        </div>
                        <div style="margin-top: 12px; font-size: 13px; color: var(--sui-text-muted);">
                            Разрабатывает компоненты SuperUI с 2024 года. Специализируется на производительности и доступности.
                        </div>
                    </div>
                </div>
            }
        </SgCard>
    </div>

    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">Список с загрузкой</SgTypography>
        <SgTypography Variant="SgTypographyVariant.Body" Color="var(--sg-text-muted)">Скелеты для списков и таблиц.</SgTypography>

        <SgCard Title="Список элементов" Style="margin-top: 16px;">
            <div style="display: flex; flex-direction: column; gap: 16px;">
                @for (int i = 0; i < 3; i++)
                {
                    <SgSkeleton Active="true" Avatar="true" Paragraph="false" />
                }
            </div>
        </SgCard>
    </div>

    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">Свойства компонента</SgTypography>

        <SgCard Title="SgSkeleton" Style="margin-top: 16px;">
            <PropertyTable Items="_skeletonProperties" />
        </SgCard>
    </div>

    <!-- Enum + code -->
    <div style="margin-top: 32px;">
        <SgTypography Variant="SgTypographyVariant.Heading2">Перечисление SgSkeletonShape и примеры кода</SgTypography>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="SgSkeletonShape">
                <PropertyTable Items="_shapeEnum" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private bool _isLoading = true;

    private List<PropertyPanelItem> _skeletonProperties = new()
    {
        new() { Label = "Active",        Value = "bool",                    BadgeText = "Анимация",              BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Avatar",        Value = "bool",                    BadgeText = "Показать аватар",       BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Paragraph",     Value = "bool",                    BadgeText = "Показать параграф",     BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Round",         Value = "bool",                    BadgeText = "Округлённые края",      BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Shape",         Value = "text|rect|circle",        BadgeText = "Форма (SgSkeletonShape)", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Width",         Value = "string",                  BadgeText = "Ширина",                BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Height",        Value = "string",                  BadgeText = "Высота",                BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ChildContent",  Value = "RenderFragment",          BadgeText = "Содержимое",            BadgeVariant = SgBadgeVariant.Info }
    };

    // ── Enum tables ──────────────────────────────────────────────────────────
    private List<PropertyPanelItem> _shapeEnum = new()
    {
        new() { Label = "SgSkeletonShape.Text",   Value = "\"text\"",   BadgeText = "Строка текста (по умолч.)", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "SgSkeletonShape.Rect",   Value = "\"rect\"",   BadgeText = "Прямоугольник",             BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgSkeletonShape.Circle", Value = "\"circle\"", BadgeText = "Круг (аватар)",             BadgeVariant = SgBadgeVariant.Info },
    };
}
