@page "/skeleton-demo"
@using SuperUI.Components

<PageTitle>Скелет загрузки - SUI</PageTitle>

<SgCard Title="SgSkeleton - Скелет загрузки"
        Subtitle="Компонент для отображения заполнителей во время загрузки контента. Поддерживает различные формы и анимацию.">

    <div style="margin-top: 32px;">
        <h2>Варианты скелетов</h2>
        <p>Различные конфигурации скелетов для разных типов контента.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Текстовый скелет">
                <SgSkeleton Active="true" Paragraph="true" />
            </SgCard>

            <SgCard Title="Скелет с аватаром">
                <SgSkeleton Active="true" Avatar="true" Paragraph="true" />
            </SgCard>

            <SgCard Title="Только заголовок">
                <SgSkeleton Active="true" Paragraph="false" />
            </SgCard>

            <SgCard Title="Округлённый">
                <SgSkeleton Active="true" Round="true" Paragraph="true" />
            </SgCard>
        </div>
    </div>

    <div style="margin-top: 32px;">
        <h2>Интерактивный пример</h2>
        <p>Переключите загрузку для просмотра скелета и реального контента.</p>

        <SgCard Title="Карточка пользователя" Style="margin-top: 16px;">
            <div style="margin-bottom: 16px;">
                <SgSwitch @bind-Value="@_isLoading" Label="Режим загрузки" />
            </div>

            @if (_isLoading)
            {
                <SgSkeleton Active="true" Avatar="true" Paragraph="true" />
            }
            else
            {
                <div style="display: flex; align-items: flex-start; gap: 16px;">
                    <SgAvatar Title="Иван Петров" Color="#1890ff" Size="lg" />
                    <div>
                        <div style="font-size: 16px; font-weight: 600;">Иван Петров</div>
                        <div style="color: var(--sui-text-muted); margin-top: 4px;">Старший разработчик · Отдел R&D</div>
                        <div style="margin-top: 8px; display: flex; gap: 8px;">
                            <SgBadge Text="Blazor" Variant="success" />
                            <SgBadge Text="C#" Variant="default" />
                            <SgBadge Text=".NET" Variant="default" />
                        </div>
                        <div style="margin-top: 12px; font-size: 13px; color: var(--sui-text-muted);">
                            Разрабатывает компоненты SuperUI с 2024 года. Специализируется на производительности и доступности.
                        </div>
                    </div>
                </div>
            }
        </SgCard>
    </div>

    <div style="margin-top: 32px;">
        <h2>Список с загрузкой</h2>
        <p>Скелеты для списков и таблиц.</p>

        <SgCard Title="Список элементов" Style="margin-top: 16px;">
            <div style="display: flex; flex-direction: column; gap: 16px;">
                @for (int i = 0; i < 3; i++)
                {
                    <SgSkeleton Active="true" Avatar="true" Paragraph="false" />
                }
            </div>
        </SgCard>
    </div>

    <div style="margin-top: 32px;">
        <h2>Свойства компонента</h2>

        <SgCard Title="SgSkeleton" Style="margin-top: 16px;">
            <PropertyTable Items="_skeletonProperties" />
        </SgCard>
    </div>

</SgCard>

@code {
    private bool _isLoading = true;

    private List<PropertyPanelItem> _skeletonProperties = new()
    {
        new() { Label = "Active", Value = "bool", BadgeText = "Анимация", BadgeVariant = "warn" },
        new() { Label = "Avatar", Value = "bool", BadgeText = "Показать аватар", BadgeVariant = "warn" },
        new() { Label = "Paragraph", Value = "bool", BadgeText = "Показать параграф", BadgeVariant = "warn" },
        new() { Label = "Round", Value = "bool", BadgeText = "Округлённые края", BadgeVariant = "warn" },
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Содержимое", BadgeVariant = "info" }
    };
}
