@page "/orgchart-demo"
@using SuperUI.Components

<PageTitle>Org Chart - SUI</PageTitle>
<SgSeoHead Description="Visualize company structure, reporting lines, approval chains, and responsibility centers with nodes and edges." />

<SgCard Title="SgDiagram — Organizational Hierarchy"
        Subtitle="Visualize company structure, reporting lines, approval chains, and responsibility centers with nodes and edges.">

    <!-- ── Interactive Diagram Editor ──────────────────────────────────── -->
    <div style="margin-top:32px">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Interactive Diagram Editor</SgTypography>
        <p>Build any diagram: add nodes by clicking the canvas, draw edges in Connect mode, drag to reposition, click a node to edit label / color / shape.</p>
        <SgCard Title="Example" style="margin-top:16px">
            <SgDiagramEditor @bind-Nodes="_interactiveNodes"
                             @bind-Edges="_interactiveEdges" />
        </SgCard>
        <div style="margin-top:16px">
            <PropertyTable Items="_interactiveProperties" />
        </div>
    </div>

    <!-- ── Company Structure ────────────────────────────────────────────── -->
    <div style="margin-top:40px">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Company Structure (Auto Layout)</SgTypography>
        <p>Hierarchy layout automatically positions nodes. SVG edges with arrow markers connect reporting lines.</p>

        <div class="demo-grid-adaptive" style="margin-top:16px">
            <SgCard Title="Example">
                <SgDiagram Nodes="_companyNodes"
                           Edges="_companyEdges"
                           Layout="SgDiagramLayoutType.Hierarchy"
                           OnNodeClick="n => _selected = n.Label"
                           HorizontalGap="32"
                           VerticalGap="48">
                    <NodeTemplate>
                        <div style="display:flex;align-items:center;gap:8px;width:100%;height:100%;padding:8px 12px 8px 15px;box-sizing:border-box;">
                            @if (context.Data is Employee emp)
                            {
                                <div style="width:32px;height:32px;border-radius:50%;background:var(--sui-bg-secondary);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:var(--sui-fg);flex-shrink:0;">
                                    @(GetInitials(emp.Name))
                                </div>
                                <div style="display:flex;flex-direction:column;min-width:0;overflow:hidden;">
                                    <span style="font-size:12px;font-weight:600;color:var(--sui-fg);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@emp.Name</span>
                                    <span style="font-size:10px;color:var(--sui-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@emp.Title</span>
                                </div>
                            }
                            else
                            {
                                <span style="font-size:12px;font-weight:600;color:var(--sui-fg);">@context.Label</span>
                            }
                        </div>
                    </NodeTemplate>
                </SgDiagram>
                @if (!string.IsNullOrEmpty(_selected))
                {
                    <div style="margin-top:8px;font-size:12px;color:var(--sui-muted)">
                        Selected: <strong>@_selected</strong>
                    </div>
                }
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_diagramProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ── Approval Flow ────────────────────────────────────────────────── -->
    <div style="margin-top:40px">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">Approval Flow</SgTypography>
        <p>Process diagram with decision nodes and curved edges. Each node shows its approval status via a badge.</p>

        <div class="demo-grid-adaptive" style="margin-top:16px">
            <SgCard Title="Example">
                <SgDiagram Nodes="_approvalNodes"
                           Edges="_approvalEdges"
                           Layout="SgDiagramLayoutType.Hierarchy"
                           HorizontalGap="24"
                           VerticalGap="56">
                    <NodeTemplate>
                        @if (context.Data is ApprovalStep step)
                        {
                            <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;height:100%;padding:8px;box-sizing:border-box;gap:4px;">
                                <span style="font-size:11px;font-weight:600;color:var(--sui-fg);text-align:center;line-height:1.2;">@step.Name</span>
                                <span class="sgc-badge @GetStatusClass(step.Status)" style="font-size:9px;">@step.Status</span>
                            </div>
                        }
                        else
                        {
                            <div class="sgc-diagram-node-default">
                                <span class="sgc-diagram-node-label">@context.Label</span>
                            </div>
                        }
                    </NodeTemplate>
                </SgDiagram>
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_flowProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ── SgOrgChart Tree ───────────────────────────────────────────────── -->
    <div style="margin-top:40px">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">SgOrgChart (Tree Component)</SgTypography>
        <p>Lightweight org chart using recursive tree rendering with CSS connectors. Supports expand/collapse, avatars, custom colors.</p>

        <div class="demo-grid-adaptive" style="margin-top:16px">
            <SgCard Title="Example">
                <SgOrgChart Nodes="_simpleOrg" OnNodeClick="n => _selected = n.Name" />
                @if (!string.IsNullOrEmpty(_selected))
                {
                    <div style="margin-top:8px;font-size:12px;color:var(--sui-muted)">
                        Selected: <strong>@_selected</strong>
                    </div>
                }
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_treeProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ── Cumulative Sum ────────────────────────────────────────────────── -->
    <div style="margin-top:40px">
        <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Style="margin-bottom: 8px; display: block;">SgOrgChart — Cumulative Sum</SgTypography>
        <p>
            Set <code>ShowSum="true"</code> and assign <code>Value</code> to any node (leaf or parent).
            Each card shows three rows: <strong>Own</strong> (node's own value),
            <strong>Children</strong> (sum of descendants), <strong>Total</strong> (own + children).
            Computation is bottom-up — leaves first, then parents.
        </p>

        <div class="demo-grid-adaptive" style="margin-top:16px">
            <SgCard Title="Budget rollup">
                <SgOrgChart Nodes="_budgetOrg"
                            ShowSum="true"
                            SumLabel="Budget:"
                            SumFormat="N0"
                            OnNodeClick="n => _selected = n.Name" />
                @if (!string.IsNullOrEmpty(_selected))
                {
                    <div style="margin-top:8px;font-size:12px;color:var(--sui-muted)">
                        Selected: <strong>@_selected</strong>
                    </div>
                }
            </SgCard>

            <SgCard Title="Properties">
                <PropertyTable Items="_sumProperties" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private string? _selected;

    // Interactive diagram state — bound to SgDiagramEditor
    private List<SgDiagramNode> _interactiveNodes = new();
    private List<SgDiagramEdge> _interactiveEdges = new();

    private List<PropertyPanelItem> _interactiveProperties = new()
    {
        new() { Label = "Nodes / Edges",  Value = "List<SgDiagramNode/Edge>",      BadgeText = "Two-way bind",  BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "HorizontalGap",  Value = "double",                         BadgeText = "Spacing",       BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "VerticalGap",    Value = "double",                         BadgeText = "Spacing",       BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Node: Label",    Value = "string",                         BadgeText = "Editable",      BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Node: Shape",    Value = "Rectangle / Circle / Diamond",   BadgeText = "Editable",      BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Node: Color",    Value = "string (hex)",                   BadgeText = "Editable",      BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Edge: Type",     Value = "Straight / Curved / Ortho",      BadgeText = "Toolbar",       BadgeVariant = SgBadgeVariant.Info },
    };

    private List<SgDiagramNode> _companyNodes = new();
    private List<SgDiagramEdge> _companyEdges = new();
    private List<SgDiagramNode> _approvalNodes = new();
    private List<SgDiagramEdge> _approvalEdges = new();

    private List<SgOrgChartNode> _simpleOrg = new()
    {
        new()
        {
            Name = "Elena Petrova", Title = "CEO", Department = "Executive", Color = "#6366f1",
            Children = new()
            {
                new() { Name = "Dmitry Sokolov", Title = "CTO", Department = "Engineering", Color = "#0ea5e9" },
                new() { Name = "Olga Morozova", Title = "CFO", Department = "Finance", Color = "#10b981" },
                new() { Name = "Alexey Smirnov", Title = "COO", Department = "Operations", Color = "#f59e0b" }
            }
        }
    };

    public record Employee(string Name, string Title, string? Avatar = null);
    public record ApprovalStep(string Name, string Status);

    protected override void OnInitialized()
    {
        BuildCompanyDiagram();
        BuildApprovalDiagram();
    }

    private void BuildCompanyDiagram()
    {
        var ceo = new SgDiagramNode { Id = "ceo", Label = "Elena Petrova", Width = 180, Height = 56, Color = "#6366f1", Data = new Employee("Elena Petrova", "CEO") };
        var cto = new SgDiagramNode { Id = "cto", Label = "Dmitry Sokolov", Width = 180, Height = 56, Color = "#0ea5e9", Data = new Employee("Dmitry Sokolov", "CTO") };
        var cfo = new SgDiagramNode { Id = "cfo", Label = "Olga Morozova", Width = 180, Height = 56, Color = "#10b981", Data = new Employee("Olga Morozova", "CFO") };
        var coo = new SgDiagramNode { Id = "coo", Label = "Alexey Smirnov", Width = 180, Height = 56, Color = "#f59e0b", Data = new Employee("Alexey Smirnov", "COO") };
        var em1 = new SgDiagramNode { Id = "em1", Label = "Anna Kuznetsova", Width = 170, Height = 56, Color = "#0ea5e9", Data = new Employee("Anna Kuznetsova", "Eng. Manager") };
        var em2 = new SgDiagramNode { Id = "em2", Label = "Ivan Volkov", Width = 170, Height = 56, Color = "#0ea5e9", Data = new Employee("Ivan Volkov", "Eng. Manager") };
        var fm1 = new SgDiagramNode { Id = "fm1", Label = "Sergey Lebedev", Width = 170, Height = 56, Color = "#10b981", Data = new Employee("Sergey Lebedev", "Fin. Manager") };
        var fm2 = new SgDiagramNode { Id = "fm2", Label = "Natalia Fedorova", Width = 170, Height = 56, Color = "#10b981", Data = new Employee("Natalia Fedorova", "Fin. Manager") };
        var om1 = new SgDiagramNode { Id = "om1", Label = "Maria Orlova", Width = 170, Height = 56, Color = "#f59e0b", Data = new Employee("Maria Orlova", "Ops Manager") };
        var om2 = new SgDiagramNode { Id = "om2", Label = "Pavel Kozlov", Width = 170, Height = 56, Color = "#f59e0b", Data = new Employee("Pavel Kozlov", "Ops Manager") };

        _companyNodes = new() { ceo, cto, cfo, coo, em1, em2, fm1, fm2, om1, om2 };
        _companyEdges = new()
        {
            new() { SourceId = "ceo", TargetId = "cto" },
            new() { SourceId = "ceo", TargetId = "cfo" },
            new() { SourceId = "ceo", TargetId = "coo" },
            new() { SourceId = "cto", TargetId = "em1" },
            new() { SourceId = "cto", TargetId = "em2" },
            new() { SourceId = "cfo", TargetId = "fm1" },
            new() { SourceId = "cfo", TargetId = "fm2" },
            new() { SourceId = "coo", TargetId = "om1" },
            new() { SourceId = "coo", TargetId = "om2" }
        };
    }

    private void BuildApprovalDiagram()
    {
        var req = new SgDiagramNode { Id = "req", Label = "Request", Width = 120, Height = 48, Color = "#94a3b8", Data = new ApprovalStep("Request", "Draft") };
        var tl = new SgDiagramNode { Id = "tl", Label = "Team Lead", Width = 120, Height = 48, Color = "#10b981", Data = new ApprovalStep("Team Lead", "Approved") };
        var dh = new SgDiagramNode { Id = "dh", Label = "Dept Head", Width = 120, Height = 48, Color = "#10b981", Data = new ApprovalStep("Dept Head", "Approved") };
        var fin = new SgDiagramNode { Id = "fin", Label = "Finance", Width = 120, Height = 48, Color = "#f59e0b", Data = new ApprovalStep("Finance", "Pending") };
        var ceo = new SgDiagramNode { Id = "ceo2", Label = "CEO", Width = 120, Height = 48, Color = "#f59e0b", Data = new ApprovalStep("CEO", "Pending") };

        _approvalNodes = new() { req, tl, dh, fin, ceo };
        _approvalEdges = new()
        {
            new() { SourceId = "req", TargetId = "tl", Type = SgDiagramEdgeType.Curved },
            new() { SourceId = "tl", TargetId = "dh", Type = SgDiagramEdgeType.Curved, Label = "yes" },
            new() { SourceId = "dh", TargetId = "fin", Type = SgDiagramEdgeType.Curved, Label = ">100k" },
            new() { SourceId = "dh", TargetId = "ceo2", Type = SgDiagramEdgeType.Curved, Label = ">500k" }
        };
    }

    private List<PropertyPanelItem> _diagramProperties = new()
    {
        new() { Label = "Nodes", Value = "List<SgDiagramNode>", BadgeText = "Canvas nodes", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Edges", Value = "List<SgDiagramEdge>", BadgeText = "Connections", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Layout", Value = "SgDiagramLayoutType", BadgeText = "Auto layout", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "NodeTemplate", Value = "RenderFragment<SgDiagramNode>", BadgeText = "Custom", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "OnNodeClick", Value = "EventCallback<SgDiagramNode>", BadgeText = "Selection", BadgeVariant = SgBadgeVariant.Info },
    };

    private List<PropertyPanelItem> _flowProperties = new()
    {
        new() { Label = "Edge.Type", Value = "SgDiagramEdgeType", BadgeText = "Straight/Curved/Orthogonal", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Edge.Label", Value = "string?", BadgeText = "Edge text", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Edge.Color", Value = "string?", BadgeText = "Line color", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "HorizontalGap", Value = "double", BadgeText = "Spacing", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "VerticalGap", Value = "double", BadgeText = "Spacing", BadgeVariant = SgBadgeVariant.Info },
    };

    private List<PropertyPanelItem> _treeProperties = new()
    {
        new() { Label = "Nodes",       Value = "List<SgOrgChartNode>", BadgeText = "Required",       BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Expandable",  Value = "bool",                 BadgeText = "Default: true",  BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "NodeTemplate",Value = "RenderFragment",       BadgeText = "Custom card",    BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "OnNodeClick", Value = "EventCallback",        BadgeText = "Click handler",  BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ShowSum",     Value = "bool",                 BadgeText = "Sum rollup",     BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Node.Name",   Value = "string",               BadgeText = "Display name",   BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Node.Title",  Value = "string?",              BadgeText = "Role / title",   BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Node.Color",  Value = "string?",              BadgeText = "Accent color",   BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Node.Children", Value = "List<SgOrgChartNode>", BadgeText = "Sub-nodes",    BadgeVariant = SgBadgeVariant.Warn },
    };

    // ── Budget rollup demo ────────────────────────────────────────────────────

    private List<SgOrgChartNode> _budgetOrg = new()
    {
        new()
        {
            Name = "Company", Title = "Total budget", Color = "#6366f1",
            Value = 50_000,   // own HQ overhead
            Children = new()
            {
                new()
                {
                    Name = "Engineering", Title = "CTO", Color = "#0ea5e9",
                    Value = 30_000,       // CTO office overhead
                    Children = new()
                    {
                        new() { Name = "Frontend",  Title = "Team",  Color = "#0ea5e9", Value = 120_000 },
                        new() { Name = "Backend",   Title = "Team",  Color = "#0ea5e9", Value = 180_000 },
                        new() { Name = "DevOps",    Title = "Team",  Color = "#0ea5e9", Value =  60_000 },
                    }
                },
                new()
                {
                    Name = "Finance", Title = "CFO", Color = "#10b981",
                    Value = 20_000,       // CFO office overhead
                    Children = new()
                    {
                        new() { Name = "Accounting",  Title = "Dept", Color = "#10b981", Value =  80_000 },
                        new() { Name = "Controlling", Title = "Dept", Color = "#10b981", Value =  50_000 },
                    }
                },
                new()
                {
                    Name = "Operations", Title = "COO", Color = "#f59e0b",
                    // no own value — total = children only
                    Children = new()
                    {
                        new() { Name = "Logistics", Title = "Dept", Color = "#f59e0b", Value =  90_000 },
                        new() { Name = "HR",        Title = "Dept", Color = "#f59e0b", Value =  70_000 },
                    }
                },
            }
        }
    };

    private List<PropertyPanelItem> _sumProperties = new()
    {
        new() { Label = "ShowSum",          Value = "bool",    BadgeText = "Enable rollup",          BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "SumLabel",         Value = "string",  BadgeText = "Own value prefix",       BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SumFormat",        Value = "string",  BadgeText = "N0 / C2 / F1 …",        BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Node.Value",       Value = "double?", BadgeText = "Own value (any node)",   BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Node.ChildrenSum", Value = "double",  BadgeText = "Sum of children",        BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Node.ComputedSum", Value = "double",  BadgeText = "Own + ChildrenSum",      BadgeVariant = SgBadgeVariant.Info },
    };

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Length > 0 ? parts[0][0].ToString() : "?";
        return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }

    private static string GetStatusClass(string status)
    {
        return status switch
        {
            "Draft" => "sgc-badge-muted",
            "Pending" => "sgc-badge-warning",
            "Approved" => "sgc-badge-success",
            "Rejected" => "sgc-badge-danger",
            _ => ""
        };
    }
}
