@page "/monaco-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>SgMonaco — Code Editor — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Interactive Editor                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Interactive Editor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Full-featured Monaco editor with live controls. Try switching languages, themes, and toggling options.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm" NoPadding="true">
            <div class="monaco-toolbar">
                <div class="monaco-toolbar-row">
                    <div class="monaco-toolbar-group">
                        <label class="monaco-toolbar-label">Language</label>
                        <select @bind="_selLang" class="demo-select" @bind:after="SyncEditorOptions">
                            @foreach (var l in _languages) { <option value="@l">@l</option> }
                        </select>
                    </div>
                    <div class="monaco-toolbar-group">
                        <label class="monaco-toolbar-label">Theme</label>
                        <select @bind="_selTheme" class="demo-select" @bind:after="SyncEditorOptions">
                            @foreach (var t in _themes) { <option value="@t">@t</option> }
                        </select>
                    </div>
                    <div class="monaco-toolbar-group" style="flex:2;">
                        <label class="monaco-toolbar-label">Font Size @_selFontSize</label>
                        <div class="monaco-range-wrap">
                            <input type="range" min="10" max="28" step="1" @bind="_selFontSize" @bind:after="SyncEditorOptions" />
                            <span class="monaco-range-value">@_selFontSize</span>
                        </div>
                    </div>
                    <div class="monaco-toolbar-group">
                        <label class="monaco-toolbar-label">Snippets</label>
                        <select @bind="_selSnippet" class="demo-select" @bind:after="LoadSnippet">
                            @foreach (var s in _snippets) { <option value="@s.Key">@s.Key</option> }
                        </select>
                    </div>
                </div>
                <div class="monaco-toolbar-row monaco-toolbar-actions">
                    <SgSpace Size="SgSize.Sm" Wrap="true">
                        <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Ghost"
                                  OnClick="@(async () => await _editor?.FormatAsync())"
                                  Title="Format code (Shift+Alt+F)">
                            <SgHeroicon Name="SgHeroicons.Names.CodeBracket" Size="14px" />
                            <span>Format</span>
                        </SgButton>
                        <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Ghost"
                                  OnClick="@(async () => await CopyCodeAsync())"
                                  Title="Copy to clipboard">
                            <SgHeroicon Name="SgHeroicons.Names.Clipboard" Size="14px" />
                            <span>@(_copied ? "Copied!" : "Copy")</span>
                        </SgButton>
                        <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Ghost"
                                  OnClick="@ResetCode"
                                  Title="Reset to default">
                            <SgHeroicon Name="SgHeroicons.Names.ArrowPath" Size="14px" />
                            <span>Reset</span>
                        </SgButton>
                        <div class="monaco-toggle-group">
                            <label class="monaco-toggle" title="Toggle line numbers">
                                <input type="checkbox" @bind="_selLineNumbers" @bind:after="SyncEditorOptions" />
                                <span>Line #</span>
                            </label>
                            <label class="monaco-toggle" title="Toggle word wrap">
                                <input type="checkbox" @bind="_selWordWrap" @bind:after="SyncEditorOptions" />
                                <span>Wrap</span>
                            </label>
                            <label class="monaco-toggle" title="Toggle minimap">
                                <input type="checkbox" @bind="_selMinimap" @bind:after="SyncEditorOptions" />
                                <span>Minimap</span>
                            </label>
                            <label class="monaco-toggle" title="Toggle read-only">
                                <input type="checkbox" @bind="_selReadOnly" @bind:after="SyncEditorOptions" />
                                <span>Read Only</span>
                            </label>
                        </div>
                    </SgSpace>
                </div>
            </div>

            <SgMonaco @ref="_editor"
                      @bind-Value="_code"
                      Height="440px"
                      FormatEnabled="true"
                      OnReady="@OnEditorReady"
                      OnCursorPositionChanged="@OnCursorMoved"
                      Options="_editorOptions" />

            @if (_editorReady)
            {
                <div class="monaco-statusbar">
                    <span class="monaco-status-item">
                        <SgHeroicon Name="SgHeroicons.Names.CursorArrowRays" Size="12px" />
                        Ln @_cursorLine, Col @_cursorCol
                    </span>
                    <span class="monaco-status-item">
                        <SgHeroicon Name="SgHeroicons.Names.DocumentText" Size="12px" />
                        @_lineCount lines
                    </span>
                    <span class="monaco-status-item">
                        <SgHeroicon Name="SgHeroicons.Names.Hashtag" Size="12px" />
                        @_charCount chars
                    </span>
                    <span class="monaco-status-item monaco-status-lang">
                        <SgHeroicon Name="SgHeroicons.Names.Language" Size="12px" />
                        @_selLang
                    </span>
                </div>
            }
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Code Snippets Library                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Code Snippets Library
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Click a template to load it into the editor above. Each snippet demonstrates a different language.
            </SgTypography>
        </div>
        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <div class="snippet-grid">
                @foreach (var s in _snippets.Take(6))
                {
                    <button class="snippet-card" @onclick="() => LoadSnippetByKey(s.Key)">
                        <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm">@s.Key</SgTypography>
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">@GetLangForSnippet(s.Key)</SgTypography>
                    </button>
                }
            </div>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. API Reference                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                API Reference
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                All configurable options on <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgMonacoOptions</SgTypography>.
            </SgTypography>
        </div>
        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <PropertyTable Items="_optionsProperties" />
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Source Code                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Source Code
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                This demo page source code.
            </SgTypography>
        </div>
        <DemoCodeBlock Code="@_demoSourceCode" Language="razor" Title="MonacoDemo.razor" />
    </div>

    </ChildContent>
</SgCard>

<style>
    .demo-section { margin-top: 48px; }
    .demo-section-header { margin-bottom: 20px; }

    .monaco-toolbar {
        border-bottom: 1px solid var(--sg-border);
        background: var(--sg-surface);
    }
    .monaco-toolbar-row {
        padding: 10px 14px;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: flex-end;
    }
    .monaco-toolbar-row + .monaco-toolbar-row {
        padding-top: 0;
    }
    .monaco-toolbar-row.monaco-toolbar-actions {
        border-top: 1px solid var(--sg-border);
        padding-top: 8px;
        padding-bottom: 8px;
        background: var(--sg-bg-tertiary, #f8fafc);
    }
    .monaco-toolbar-group {
        flex: 1;
        min-width: 100px;
    }
    .monaco-toolbar-label {
        display: block;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--sg-text-muted, #94a3b8);
        margin-bottom: 4px;
    }
    .monaco-range-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .monaco-range-wrap input[type="range"] {
        flex: 1;
        height: 4px;
        accent-color: var(--sg-primary, #2563eb);
    }
    .monaco-range-value {
        font-size: 12px;
        min-width: 24px;
        color: var(--sg-text-muted);
        font-variant-numeric: tabular-nums;
    }
    .monaco-toggle-group {
        display: flex;
        flex-wrap: wrap;
        gap: 2px;
        margin-left: auto;
    }
    .monaco-toggle {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 11px;
        cursor: pointer;
        color: var(--sg-text-secondary);
        background: var(--sg-surface);
        border: 1px solid var(--sg-border);
        transition: all 0.15s;
        user-select: none;
    }
    .monaco-toggle:hover {
        border-color: var(--sg-primary);
        color: var(--sg-primary);
    }
    .monaco-toggle input[type="checkbox"] {
        width: 12px;
        height: 12px;
        accent-color: var(--sg-primary, #2563eb);
        margin: 0;
        cursor: pointer;
    }

    .demo-select {
        width: 100%;
        padding: 5px 8px;
        border: 1px solid var(--sg-border);
        border-radius: 5px;
        background: var(--sg-surface);
        color: var(--sg-text);
        font-size: 12px;
        font-family: inherit;
    }

    .monaco-statusbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
        padding: 5px 14px;
        border-top: 1px solid var(--sg-border);
        background: var(--sg-bg-tertiary, #f8fafc);
        font-size: 11px;
        color: var(--sg-text-muted, #94a3b8);
    }
    .monaco-status-item {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-variant-numeric: tabular-nums;
    }
    .monaco-status-lang {
        margin-left: auto;
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 0.05em;
    }

    .snippet-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 8px;
    }
    .snippet-card {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 10px 12px;
        border-radius: 6px;
        border: 1px solid var(--sg-border);
        background: var(--sg-surface);
        cursor: pointer;
        text-align: left;
        transition: all 0.15s;
        font-family: inherit;
        color: inherit;
    }
    .snippet-card:hover {
        border-color: var(--sg-primary);
        background: color-mix(in srgb, var(--sg-primary) 5%, var(--sg-surface));
    }
</style>

@code {
    private SgMonaco? _editor;
    private bool _editorReady;
    private int _cursorLine = 1, _cursorCol = 1;
    private int _lineCount, _charCount;
    private bool _copied;

    private string _code = _snippetDefaults["csharp"];
    private string _selLang = "csharp";
    private string _selTheme = "vs-dark";
    private int _selFontSize = 14;
    private bool _selMinimap = true;
    private bool _selLineNumbers = true;
    private bool _selWordWrap;
    private bool _selReadOnly;
    private string _selSnippet = "csharp";

    private SgMonacoOptions _editorOptions = new()
    {
        Language = "csharp", Theme = "vs-dark", FontSize = 14,
        Minimap = true, LineNumbers = true,
        OccurrencesHighlight = true, SelectionHighlight = true,
        Folding = true, CodeLens = true, QuickSuggestions = true,
        ParameterHints = true, BracketPairColorization = true,
    };

    private void SyncEditorOptions()
    {
        _editorOptions = new SgMonacoOptions
        {
            Language = _selLang, Theme = _selTheme, FontSize = _selFontSize,
            Minimap = _selMinimap, LineNumbers = _selLineNumbers,
            WordWrap = _selWordWrap, ReadOnly = _selReadOnly,
            OccurrencesHighlight = true, SelectionHighlight = true,
            Folding = true, CodeLens = true, QuickSuggestions = true,
            ParameterHints = true, BracketPairColorization = true,
        };
    }

    private readonly List<string> _languages = new() { "csharp", "javascript", "typescript", "html", "css", "json", "python", "markdown", "sql", "xml", "yaml" };
    private readonly List<string> _themes = new() { "vs-dark", "vs", "hc-black", "sg-auto", "sg-light", "sg-dark" };

    private static readonly Dictionary<string, string> _snippetDefaults = new()
    {
        ["csharp"] = "using SuperUI.Components;\n\npublic class MonacoDemo\n{\n    public async Task RunAsync()\n    {\n        var editor = new SgMonaco();\n        editor.Height = \"400px\";\n        await editor.FormatAsync();\n        \n        var value = await editor.GetValueAsync();\n        Console.WriteLine(value);\n    }\n}",
        ["javascript"] = "// Monaco Editor — JavaScript Demo\nfunction initEditor() {\n    const container = document.getElementById('editor');\n    const editor = monaco.editor.create(container, {\n        value: 'Hello, Monaco!',\n        language: 'javascript',\n        theme: 'vs-dark',\n        fontSize: 14,\n        minimap: { enabled: false }\n    });\n    \n    editor.onDidChangeModelContent(() => {\n        console.log('Content changed:', editor.getValue());\n    });\n}",
        ["typescript"] = "interface IMonacoDemo {\n    name: string;\n    version: string;\n    settings: {\n        theme: 'light' | 'dark';\n        fontSize: number;\n        readonly: boolean;\n    };\n}\n\nconst config: IMonacoDemo = {\n    name: 'Monaco Editor',\n    version: '1.0.0',\n    settings: {\n        theme: 'dark',\n        fontSize: 14,\n        readonly: false\n    }\n};\n\nexport default config;",
        ["html"] = "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Monaco Demo</title>\n    <link rel=\"stylesheet\" href=\"styles.css\" />\n</head>\n<body>\n    <div id=\"editor-container\" class=\"editor\"></div>\n    <script type=\"module\" src=\"app.js\"></script>\n</body>\n</html>",
        ["css"] = "/* Monaco Editor — Custom Styles */\n:root {\n    --editor-font: 'JetBrains Mono', 'Fira Code', monospace;\n    --editor-bg: #1e1e2e;\n    --editor-fg: #cdd6f4;\n}\n\n.editor-container {\n    width: 100%;\n    height: 500px;\n    border-radius: 8px;\n    overflow: hidden;\n    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.12);\n}\n\n.monaco-editor .margin {\n    background: var(--editor-bg) !important;\n}",
        ["json"] = "{\n  \"$schema\": \"https://raw.githubusercontent.com/microsoft/vscode/main/extensions/package.json\",\n  \"name\": \"monaco-editor\",\n  \"version\": \"0.55.0\",\n  \"displayName\": \"Monaco Editor\",\n  \"description\": \"The VS Code editor in the browser\",\n  \"license\": \"MIT\",\n  \"contributes\": {\n    \"languages\": [\n      {\n        \"id\": \"csharp\",\n        \"aliases\": [\"C#\", \"csharp\"],\n        \"extensions\": [\".cs\"]\n      }\n    ]\n  }\n}",
        ["python"] = "import asyncio\nfrom dataclasses import dataclass\n\n\n@dataclass\nclass EditorConfig:\n    language: str = \"python\"\n    theme: str = \"vs-dark\"\n    font_size: int = 14\n    minimap: bool = True\n    line_numbers: bool = True\n\n\nasync def create_editor(config: EditorConfig) -> None:\n    \"\"\"Initialize Monaco editor with given config.\"\"\"\n    print(f\"Creating editor with {config.language} language\")\n    # Editor initialization would happen here\n    await asyncio.sleep(0.1)\n    print(\"Editor ready!\")",
        ["markdown"] = "# Monaco Editor Demo\n\n## Features\n\n- **Syntax Highlighting** for 50+ languages\n- **IntelliSense** autocompletion\n- **Multi-cursor** editing (Alt+Click)\n- **Find & Replace** (Ctrl+F)\n- **Code Folding**\n- **Minimap** for navigation\n\n## Quick Start\n\n```bash\ndotnet add package SuperUI\n```\n\n```razor\n<SgMonaco @bind-Value=\"code\" Height=\"400px\" />\n```\n\n> Built for Blazor WASM and Server.",
        ["sql"] = "-- Sample Database Schema\nCREATE TABLE users (\n    id          INT PRIMARY KEY GENERATED ALWAYS AS IDENTITY,\n    email       VARCHAR(255) NOT NULL UNIQUE,\n    username    VARCHAR(100) NOT NULL,\n    created_at  TIMESTAMPTZ DEFAULT NOW(),\n    updated_at  TIMESTAMPTZ DEFAULT NOW()\n);\n\nCREATE TABLE posts (\n    id          INT PRIMARY KEY GENERATED ALWAYS AS IDENTITY,\n    user_id     INT NOT NULL REFERENCES users(id),\n    title       VARCHAR(255) NOT NULL,\n    body        TEXT,\n    created_at  TIMESTAMPTZ DEFAULT NOW()\n);\n\nCREATE INDEX idx_posts_user_id ON posts(user_id);\nCREATE INDEX idx_posts_created_at ON posts(created_at DESC);",
        ["xml"] = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<configuration>\n    <appSettings>\n        <add key=\"EditorTheme\" value=\"vs-dark\" />\n        <add key=\"FontSize\" value=\"14\" />\n        <add key=\"MinimapEnabled\" value=\"true\" />\n        <add key=\"LineNumbers\" value=\"true\" />\n    </appSettings>\n    <connectionStrings>\n        <add name=\"Default\" connectionString=\"Server=localhost;Database=editor;Trusted_Connection=true;\" />\n    </connectionStrings>\n</configuration>",
        ["yaml"] = "# Monaco Editor Configuration\nserver:\n  port: 8080\n  host: \"localhost\"\n  cors:\n    enabled: true\n    origins:\n      - \"http://localhost:3000\"\n      - \"https://example.com\"\n\neditor:\n  theme: \"vs-dark\"\n  font_size: 14\n  language: \"yaml\"\n  features:\n    minimap: true\n    folding: true\n    bracket_pair_colorization: true\n    word_wrap: false",
    };

    private readonly Dictionary<string, string> _snippets = _snippetDefaults;

    private void LoadSnippet()
    {
        if (_snippetDefaults.TryGetValue(_selSnippet, out var code))
            _code = code;
    }

    private void LoadSnippetByKey(string key)
    {
        _selSnippet = key;
        _selLang = GetLangForSnippet(key);
        SyncEditorOptions();
        if (_snippetDefaults.TryGetValue(key, out var code))
            _code = code;
    }

    private static string GetLangForSnippet(string key) => key switch
    {
        "csharp" => "C#", "javascript" => "JS", "typescript" => "TS", "html" => "HTML",
        "css" => "CSS", "json" => "JSON", "python" => "Python", "markdown" => "MD",
        "sql" => "SQL", "xml" => "XML", "yaml" => "YAML", _ => key
    };

    private void OnEditorReady()
    {
        _editorReady = true;
        _lineCount = _code.Split('\n').Length;
        _charCount = _code.Length;
    }

    private void OnCursorMoved(SgMonacoCursorPosition pos)
    {
        _cursorLine = pos.LineNumber;
        _cursorCol = pos.Column;
    }

    private async Task CopyCodeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _code);
            _copied = true;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(1500);
            _copied = false;
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private void ResetCode()
    {
        if (_snippetDefaults.TryGetValue(_selLang, out var code))
            _code = code;
    }

    private RenderFragment _mainHeader => __builder =>
    {
        <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center">
            <div style="display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#10b981,#059669);color:#fff;flex-shrink:0;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
                </svg>
            </div>
            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">Monaco Editor</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    <SgHeroicon Name="SgHeroicons.Names.CodeBracket" Size="14px" /> SgMonaco — Blazor wrapper for the Monaco Editor (VS Code engine). 50+ languages, IntelliSense, themes, and more.
                </SgTypography>
            </SgStack>
        </SgStack>
    };

    private List<PropertyPanelItem> _optionsProperties = new()
    {
        new() { Label = "Language", Value = "string", BadgeText = "Syntax", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Theme", Value = "string", BadgeText = "vs / vs-dark / hc-black / sg-*", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "FontSize", Value = "int (default 13)", BadgeText = "px", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ReadOnly", Value = "bool", BadgeText = "Lock", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Minimap", Value = "bool", BadgeText = "Minimap", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "LineNumbers", Value = "bool", BadgeText = "Gutter", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "WordWrap", Value = "bool", BadgeText = "Wrap", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "AutoFormat", Value = "bool", BadgeText = "Format", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "FontFamily", Value = "string?", BadgeText = "Font", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "FontLigatures", Value = "bool", BadgeText = "Ligatures", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "TabSize", Value = "int (default 2)", BadgeText = "Indent", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Folding", Value = "bool", BadgeText = "Fold", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "BracketPairColor", Value = "bool", BadgeText = "Brackets", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "QuickSuggestions", Value = "bool", BadgeText = "IntelliSense", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "ParameterHints", Value = "bool", BadgeText = "Hints", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "CodeLens", Value = "bool", BadgeText = "Lens", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "Occurrences", Value = "bool", BadgeText = "Highlight", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "SelectionHighlight", Value = "bool", BadgeText = "Match", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "StickyScroll", Value = "bool", BadgeText = "Scope", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "FormatOnPaste", Value = "bool", BadgeText = "Format", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "MinHeight / MaxHeight", Value = "int?", BadgeText = "px", BadgeVariant = SgBadgeVariant.Default },
    };

