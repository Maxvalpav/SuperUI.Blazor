    private bool _basicAutoSave;
    private int _basicAutoSaveDelay = 2000;
    private bool _basicFormatEnabled;
    private string? _basicLastSave;
    private IReadOnlyList<SgMonacoMarker> _basicMarkers = Array.Empty<SgMonacoMarker>();

    private void ToggleReadOnly()
    {
        _basicReadOnly = !_basicReadOnly;
    }

    private void ValidateBasicJson(string? value)
    {
        if (_basicLang != "json" || string.IsNullOrEmpty(value))
        {
            _basicMarkers = Array.Empty<SgMonacoMarker>();
            return;
        }
        try
        {
            System.Text.Json.JsonDocument.Parse(value);
            _basicMarkers = Array.Empty<SgMonacoMarker>();
        }
        catch (System.Text.Json.JsonException ex)
        {
            _basicMarkers = new[]
            {
                new SgMonacoMarker
                {
                    Line = (int)Math.Max(1, (ex.LineNumber ?? 0) + 1),
                    Column = (int)Math.Max(1, (ex.BytePositionInLine ?? 0) + 1),
                    Message = ex.Message,
                    Severity = SgMonacoMarkerSeverity.Error
                }
            };
        }
    }

    // ── Section 2: Languages & Themes ────────────────────────────────────
    private string _dynamicCode = "public class Hello {\n    public void Say() => Console.WriteLine(\"Hello World\");\n}";
