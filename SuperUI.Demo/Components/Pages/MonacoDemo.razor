@page "/monaco-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgMonaco — Code Editor — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Basic Editing                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Basic Editing
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                JSON editor with auto-save, Ctrl+S handler, format keyboard shortcut, and live syntax markers on invalid JSON.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="JSON Editor" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgRow Space="SgSize.Sm" Align="SgAlignItems.End">
                        <SgCol Fill="true">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="margin-bottom:6px;">Language</SgTypography>
                            <SgSelect TValue="string" Value="@_basicLang" ValueChanged="@(v => { _basicLang = v; ValidateBasicJson(_basicCode); StateHasChanged(); })" Items="_languages" LabelSelector="x => x" Block="true" />
                        </SgCol>
                        <SgCol Auto="true">
                            <SgButton Variant="@(_basicReadOnly ? SgButtonVariant.Primary : SgButtonVariant.Outlined)"
                                      Size="SgSize.Sm"
                                      OnClick="ToggleReadOnly">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                    @if (_basicReadOnly)
                                    {
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                        </svg>
                                        <span>Read-Only</span>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/>
                                        </svg>
                                        <span>Editable</span>
                                    }
                                </SgStack>
                            </SgButton>
                        </SgCol>
                    </SgRow>
                    <SgRow Space="SgSize.Sm" Align="SgAlignItems.Center">
                        <SgCol Auto="true">
                            <SgSwitch @bind-Value="_basicAutoSave" Label="Auto-Save" Size="SgSize.Sm" />
                        </SgCol>
                        <SgCol Auto="true">
                            <SgSwitch @bind-Value="_basicFormatEnabled" Label="Format (Shift+Alt+F)" Size="SgSize.Sm" />
                        </SgCol>
                        <SgCol Fill="true">
                            @if (_basicLastSave is not null)
                            {
                                <SgBadge Text="@_basicLastSave" Variant="SgBadgeVariant.Success" Size="SgSize.Sm" />
                            }
                        </SgCol>
                    </SgRow>
                    <SgRow Space="SgSize.Sm" Align="SgAlignItems.Center">
                        <SgCol Fill="true">
                            <SgSlider TValue="int" @bind-Value="_basicAutoSaveDelay" Label="Auto-Save Delay (ms)" Min="500" Max="5000" Step="100" ShowValue="true" Suffix="ms" Size="SgSize.Sm" />
                        </SgCol>
                    </SgRow>
                    <SgMonaco Value="@_basicCode"
                              ValueChanged="@(v => { _basicCode = v; ValidateBasicJson(v); StateHasChanged(); })"
                              Height="300px"
                              AutoSave="_basicAutoSave"
                              AutoSaveDelay="_basicAutoSaveDelay"
                              OnAutoSave="@(v => { _basicLastSave = "Auto: " + DateTime.Now.ToString("HH:mm:ss"); StateHasChanged(); })"
                              FormatEnabled="_basicFormatEnabled"
                              OnSave="@(v => { _basicLastSave = "Ctrl+S: " + DateTime.Now.ToString("HH:mm:ss"); StateHasChanged(); })"
                              Markers="@_basicMarkers"
                              Options="@(new SgMonacoOptions { Language = _basicLang, Minimap = false, ReadOnly = _basicReadOnly })" />
                </SgStack>
            </SgCard>
            <SgStack Vertical Space="SgSize.Md">
                <SgCard Title="Live Value" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <div class="demo-code-preview">
                        @_basicCode
                    </div>
                </SgCard>
                <SgCard Title="SgMonaco Properties" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_monacoProperties" />
                </SgCard>
            </SgStack>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Languages & Themes                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Languages & Themes
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Switch between programming languages, color themes, font settings, and editor height constraints.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Live Demo" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgRow Space="SgSize.Sm">
                        <SgCol Xs="12" Md="6">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="margin-bottom:6px;">Language</SgTypography>
                            <SgSelect TValue="string" @bind-Value="_selectedLang" Items="_languages" LabelSelector="x => x" Block="true" />
                        </SgCol>
                        <SgCol Xs="12" Md="6">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="margin-bottom:6px;">Theme</SgTypography>
                            <SgSelect TValue="string" @bind-Value="_selectedTheme" Items="_themes" LabelSelector="x => x" Block="true" />
                        </SgCol>
                    </SgRow>
                    <SgRow Space="SgSize.Sm">
                        <SgCol Xs="12" Md="6">
                            <SgSlider TValue="int" @bind-Value="_section2FontSize" Label="Font Size" Min="8" Max="28" Step="1" ShowValue="true" Suffix="px" Size="SgSize.Sm" />
                        </SgCol>
                        <SgCol Xs="12" Md="6">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="margin-bottom:6px;">Tab Size</SgTypography>
                            <SgSelect TValue="int" @bind-Value="_section2TabSize" Items="_tabSizeOptions" LabelSelector="x => x.ToString()" Block="true" />
                        </SgCol>
                    </SgRow>
                    <SgRow Space="SgSize.Sm" Align="SgAlignItems.Center">
                        <SgCol Auto="true">
                            <SgSwitch @bind-Value="_section2FontLigatures" Label="Font Ligatures" Size="SgSize.Sm" />
                        </SgCol>
                        <SgCol Fill="true">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="margin-bottom:6px;">Min Height</SgTypography>
                            <SgSelect TValue="string" @bind-Value="_section2MinHeight" Items="_heightOptions" LabelSelector="@(x => string.IsNullOrEmpty(x) ? "none" : x)" Block="true" />
                        </SgCol>
                        <SgCol Fill="true">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="margin-bottom:6px;">Max Height</SgTypography>
                            <SgSelect TValue="string" @bind-Value="_section2MaxHeight" Items="_heightOptions" LabelSelector="@(x => string.IsNullOrEmpty(x) ? "none" : x)" Block="true" />
                        </SgCol>
                    </SgRow>
                    <SgMonaco @bind-Value="_dynamicCode"
                              Height="300px"
                              MinHeight="@_section2MinHeight"
                              MaxHeight="@_section2MaxHeight"
                              Options="@(new SgMonacoOptions {
                                  Language = _selectedLang,
                                  Theme = _selectedTheme,
                                  FontSize = _section2FontSize,
                                  FontLigatures = _section2FontLigatures,
                                  TabSize = _section2TabSize,
                                  Minimap = true
                              })" />
                </SgStack>
            </SgCard>
            <SgCard Title="SgMonacoOptions" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_optionsProperties" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Two-way Binding — Markdown Preview                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Two-way Binding — Markdown Preview
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Edit markdown on the left; the preview pane updates in real time via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">@@bind-Value</SgTypography>.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Editor" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgMonaco @bind-Value="_markdownCode"
                          Height="350px"
                          Options="@(new SgMonacoOptions { Language = "markdown", Minimap = false, WordWrap = true })" />
            </SgCard>
            <SgCard Title="Rendered Preview" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <div class="demo-markdown-preview">
                    @_markdownCode
                </div>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. IDE-like Demo (SgDockManager)                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                IDE-like Dock Layout
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                SgDockManager with editor, explorer, and output panels. Resize panels by dragging the splitters.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Sm" Radius="SgSize.Lg" NoPadding="true">
            <div style="height:500px;">
                <SgDockManager Panels="_idePanels"
                               EnableConstructor="true"
                               StatusBarContent="@_statusBar">
                    <PanelTemplate>
                        @if (context.Id == "editor")
                        {
                            <SgMonaco Value="@_ideCode"
                                      Height="100%"
                                      Options="@(new SgMonacoOptions { Language = "csharp", Theme = "vs-dark", Minimap = true })" />
                        }
                        else if (context.Id == "explorer")
                        {
                            <div class="demo-explorer-panel">
                                <SgStack Vertical Space="SgSize.Sm">
                                    @foreach (var file in _explorerFiles)
                                    {
                                        <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--sg-text-muted);flex-shrink:0;">
                                                <path d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
                                            </svg>
                                            <span style="font-size:13px;">@file</span>
                                        </SgStack>
                                    }
                                </SgStack>
                            </div>
                        }
                        else if (context.Id == "output")
                        {
                            <div class="demo-output-panel">
                                @foreach (var line in _outputLines)
                                {
                                    <div class="demo-output-line">@line</div>
                                }
                            </div>
                        }
                        else
                        {
                            <div style="padding:16px;color:var(--sg-text-muted);font-size:13px;">
                                @context.Title
                            </div>
                        }
                    </PanelTemplate>
                </SgDockManager>
            </div>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. SgMonacoOptions Reference                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgMonacoOptions Reference
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                All configuration properties available on <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgMonacoOptions</SgTypography>.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Sm" Size="SgSize.Sm">
            <PropertyTable Items="_allOptionsProperties" />
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. Format & Diff Demo                                             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Format &amp; Diff
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Use <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">FormatAsync()</SgTypography> to beautify JSON, or switch to diff mode to compare changes.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="JSON Formatter" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgSpace>
                        <SgButton Variant="SgButtonVariant.Primary"
                                  OnClick="FormatCode">
                            <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182"/>
                                </svg>
                                <span>Format</span>
                            </SgStack>
                        </SgButton>
                        <SgButton Variant="SgButtonVariant.Outlined"
                                  OnClick="ResetFormatCode">
                            <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3"/>
                                </svg>
                                <span>Reset</span>
                            </SgStack>
                        </SgButton>
                    </SgSpace>
                    <SgMonaco @ref="_formatRef"
                              @bind-Value="_formatCode"
                              Height="300px"
                              FormatEnabled="true"
                              Options="@(new SgMonacoOptions { Language = "json", Minimap = false, AutoFormat = false })" />
                </SgStack>
            </SgCard>
            <SgCard Title="Diff Viewer" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgRow Space="SgSize.Sm" Align="SgAlignItems.Center">
                        <SgCol Auto="true">
                            <SgSegmented TValue="bool"
                                         Value="_formatDiffMode"
                                         ValueChanged="v => { _formatDiffMode = v; StateHasChanged(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_formatModeOptions" />
                        </SgCol>
                        <SgCol Auto="true">
                            <SgSwitch @bind-Value="_formatReadOnlyBadge" Label="Read Only Badge" Size="SgSize.Sm" />
                        </SgCol>
                    </SgRow>
                    <SgStack Vertical Space="SgSize.Sm">
                        <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Diff Original Value</SgTypography>
                        <SgTextBox @bind-Value="_diffValue" Placeholder="Enter original value for diff comparison..." Block="true" />
                    </SgStack>
                    <SgMonaco @bind-Value="_formatDiffCode"
                              Height="300px"
                              ReadOnlyBadge="_formatReadOnlyBadge"
                              DiffValue="@(_formatDiffMode ? _diffValue : null)"
                              Options="@(new SgMonacoOptions { Language = "json", Minimap = false, ReadOnly = _formatDiffMode })" />
                </SgStack>
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 7. Live SgMonaco Constructor                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live SgMonaco Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure parameters and see the result in real time. Click <strong>Copy</strong> to copy the generated code.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Language -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Language</SgTypography>
                            <SgSelect TValue="string" @bind-Value="_ctorLang" Items="_languages" LabelSelector="x => x" Block="true" />
                        </SgStack>

                        <!-- Theme -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Theme</SgTypography>
                            <SgSelect TValue="string" @bind-Value="_ctorTheme" Items="_themes" LabelSelector="x => x" Block="true" />
                        </SgStack>

                        <!-- Font Size -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgSlider TValue="int" @bind-Value="_ctorFontSize" Label="Font Size" Min="8" Max="28" Step="1" ShowValue="true" Suffix="px" Size="SgSize.Sm" />
                        </SgStack>

                        <!-- Read Only + ReadOnlyBadge row -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Xs="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Read Only</SgTypography>
                                    <SgSegmented TValue="bool" Value="_ctorReadOnly" ValueChanged="v => { _ctorReadOnly = v; UpdateConstructorCode(); StateHasChanged(); }" Block="true" Size="sm" Options="_boolOnOff" />
                                </SgStack>
                            </SgCol>
                            <SgCol Xs="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Badge</SgTypography>
                                    <SgSegmented TValue="bool" Value="_ctorReadOnlyBadge" ValueChanged="v => { _ctorReadOnlyBadge = v; UpdateConstructorCode(); StateHasChanged(); }" Block="true" Size="sm" Options="_boolOnOff" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Format Enabled + AutoSave row -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Xs="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Format Enabled</SgTypography>
                                    <SgSegmented TValue="bool" Value="_ctorFormatEnabled" ValueChanged="v => { _ctorFormatEnabled = v; UpdateConstructorCode(); StateHasChanged(); }" Block="true" Size="sm" Options="_boolOnOff" />
                                </SgStack>
                            </SgCol>
                            <SgCol Xs="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Auto Save</SgTypography>
                                    <SgSegmented TValue="bool" Value="_ctorAutoSave" ValueChanged="v => { _ctorAutoSave = v; UpdateConstructorCode(); StateHasChanged(); }" Block="true" Size="sm" Options="_boolOnOff" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Min Height + Max Height row -->
                        <SgRow Space="SgSize.Sm">
                            <SgCol Xs="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Min Height</SgTypography>
                                    <SgSelect TValue="string" @bind-Value="_ctorMinHeight" Items="_ctorHeightOptions" LabelSelector="@(x => string.IsNullOrEmpty(x) ? "none" : x)" Block="true" />
                                </SgStack>
                            </SgCol>
                            <SgCol Xs="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Max Height</SgTypography>
                                    <SgSelect TValue="string" @bind-Value="_ctorMaxHeight" Items="_ctorHeightOptions" LabelSelector="@(x => string.IsNullOrEmpty(x) ? "none" : x)" Block="true" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Diff Value -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Diff Value</SgTypography>
                            <SgTextBox @bind-Value="_ctorDiffValue" Placeholder="Original value for diff editor..." Block="true" />
                        </SgStack>

                        <!-- Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Language</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorLang" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Theme</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_ctorTheme" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Font Size</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@($"{_ctorFontSize}px")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Read Only</SgTypography>
                                    <SgBadge Variant="@(_ctorReadOnly ? SgBadgeVariant.Warn : SgBadgeVariant.Default)" Text="@(_ctorReadOnly ? "Yes" : "No")" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Read Only Badge</SgTypography>
                                    <SgBadge Variant="@(_ctorReadOnlyBadge ? SgBadgeVariant.Success : SgBadgeVariant.Default)" Text="@(_ctorReadOnlyBadge ? "On" : "Off")" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                    </SgStack>
                </SgCol>

                <!-- ── Preview + Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Preview -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Result</SgTypography>
                            </div>
                            <div class="constructor-preview">
                                <SgMonaco @bind-Value="_ctorContent"
                                          Height="300px"
                                          AutoSave="_ctorAutoSave"
                                          FormatEnabled="_ctorFormatEnabled"
                                          ReadOnlyBadge="_ctorReadOnlyBadge"
                                          MinHeight="@_ctorMinHeight"
                                          MaxHeight="@_ctorMaxHeight"
                                          DiffValue="@(string.IsNullOrEmpty(_ctorDiffValue) ? null : _ctorDiffValue)"
                                          Options="@(new SgMonacoOptions {
                                              Language = _ctorLang,
                                              Theme = _ctorTheme,
                                              FontSize = _ctorFontSize,
                                              ReadOnly = _ctorReadOnly,
                                              Minimap = false
                                          })" />
                            </div>
                        </SgStack>

                        <!-- Generated Code -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyConstructorCode">
                                    <span style="font-size:11px;font-weight:600;">📋 Copy</span>
                                </button>
                            </div>
                            <div class="demo-code-block">
                                @foreach (var line in _generatedCodeLines)
                                {
                                    <code>@line</code>
                                    <br />
                                }
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

    </ChildContent>
</SgCard>

