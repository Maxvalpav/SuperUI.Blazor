    private async Task FormatCode()
    {
        if (_formatRef is not null)
            await _formatRef.FormatAsync();
    }

    private async Task ResetFormatCode()
    {
        _formatCode = _formatOriginalCode;
        StateHasChanged();
    }

    // ── Section 7: Constructor ───────────────────────────────────────────
    private string _ctorLang = "json";
    private string _ctorTheme = "vs-dark";
    private int _ctorFontSize = 14;
    private bool _ctorReadOnly;
    private bool _ctorReadOnlyBadge = true;
    private bool _ctorFormatEnabled;
    private bool _ctorAutoSave;
    private string _ctorMinHeight = "";
    private string _ctorMaxHeight = "";
    private string _ctorDiffValue = "";
    private string _ctorContent = "{\n  \"name\": \"Live Constructor\",\n  \"version\": \"1.0.0\"\n}";
    private string[] _generatedCodeLines = Array.Empty<string>();

    private readonly List<string> _ctorHeightOptions = new() { "", "200px", "300px", "400px", "500px", "600px" };
    private readonly List<SgSegmentedOption<bool>> _boolOnOff = new()
    {
        new() { Value = true,  Label = "On" },
        new() { Value = false, Label = "Off" },
    };

    protected override void OnInitialized()
    {
        UpdateConstructorCode();
    }

    private void UpdateConstructorCode()
    {
        var lines = new List<string>();
        lines.Add("<SgMonaco");
        lines.Add("    Height=\"300px\"");
        if (_ctorAutoSave)
            lines.Add("    AutoSave=\"true\"");
        if (_ctorFormatEnabled)
            lines.Add("    FormatEnabled=\"true\"");
        if (!_ctorReadOnlyBadge)
            lines.Add("    ReadOnlyBadge=\"false\"");
        if (!string.IsNullOrEmpty(_ctorMinHeight))
            lines.Add($"    MinHeight=\"{_ctorMinHeight}\"");
        if (!string.IsNullOrEmpty(_ctorMaxHeight))
            lines.Add($"    MaxHeight=\"{_ctorMaxHeight}\"");
        if (!string.IsNullOrEmpty(_ctorDiffValue))
            lines.Add($"    DiffValue=\"{_ctorDiffValue.Replace("\"", "&quot;")}\"");
        lines.Add("    Options=\"@(new SgMonacoOptions {");
        lines.Add($"        Language = \"{_ctorLang}\",");
        lines.Add($"        Theme = \"{_ctorTheme}\",");
        lines.Add($"        FontSize = {_ctorFontSize},");
        lines.Add($"        ReadOnly = {(_ctorReadOnly ? "true" : "false")},");
        lines.Add($"        Minimap = false");
        lines.Add("    })\" />");
        _generatedCodeLines = lines.ToArray();
    }

    private async Task CopyConstructorCode()
    {
        var code = string.Join("\n", _generatedCodeLines);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
        }
        catch { }
    }

