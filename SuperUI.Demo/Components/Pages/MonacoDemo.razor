    private readonly string _formatOriginalCode = "{\n  \"name\": \"SuperUI\",\n\"version\":\"1.0.0\",\n  \"dependencies\": {\n \"monaco\":\"0.45.0\",\n\"blazor\":\"9.0.0\"\n  }\n}";
