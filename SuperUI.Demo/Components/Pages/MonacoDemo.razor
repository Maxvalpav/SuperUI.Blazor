                    <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
                </svg>
            </div>
            <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Start">
                <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold">Monaco Editor</SgTypography>
                <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                    SgMonaco — a Blazor wrapper around the Monaco Editor (VS Code engine). Supports syntax highlighting, Intellisense, multi-language editing, customizable themes, diff view, auto-save, and diagnostic markers.
                </SgTypography>
            </SgStack>
        </SgStack>
    };

    // ── Section 1: Basic Editing ─────────────────────────────────────────
    private string _basicCode = "{\n  \"name\": \"SuperUI\",\n  \"version\": \"1.0.0\",\n  \"features\": [\n    \"Fast\",\n    \"Modern\",\n    \"Blazor\"\n  ]\n}";
    private string _basicLang = "json";
