@page "/warehouse-demo"
@using SuperUI.Components

<PageTitle>Склад — SUI</PageTitle>

<div class="wh-page">

    @* ── Header / KPI cards ─────────────────────────────────────────────── *@
    <SgRow Gutter="12px">
        <SgCol Md="4" Xs="12">
            <SgCard Bordered="true" Hoverable="true" CssClass="wh-hero-card">
                <SgStack Orientation="SgOrientation.Vertical" Gap="4px">
                    <h2 class="wh-title">📦 Складская визуализация</h2>
                    <span class="wh-subtitle">
                        Ячеистое хранение · конструктор зон и стоек · вид сверху + drill-in (ярус × позиция)
                    </span>
                </SgStack>
            </SgCard>
        </SgCol>

        <SgCol Md="2" Xs="6">
            <SgCard Bordered="true" Hoverable="true">
                <SgStatistic Title="Стоек" Value="@_layout.Racks.Count.ToString()" />
            </SgCard>
        </SgCol>
        <SgCol Md="2" Xs="6">
            <SgCard Bordered="true" Hoverable="true">
                <SgStatistic Title="Ячеек" Value="@_kpi.Total.ToString()" />
            </SgCard>
        </SgCol>
        <SgCol Md="2" Xs="6">
            <SgCard Bordered="true" Hoverable="true">
                <SgStatistic Title="Заполнено" Value="@($"{_kpi.OccupancyPct:F1}%")">
                    <SuffixContent>
                        <SgBadge Variant="SgBadgeVariant.Success" Text="@($"{_kpi.Occupied}")" />
                    </SuffixContent>
                </SgStatistic>
            </SgCard>
        </SgCol>
        <SgCol Md="2" Xs="6">
            <SgCard Bordered="true" Hoverable="true">
                <SgStatistic Title="Резерв / Брак" Value="@_kpi.Reserved.ToString()">
                    <SuffixContent>
                        <SgBadge Variant="SgBadgeVariant.Danger"
                                 Text="@((_kpi.Damaged + _kpi.Expired + _kpi.Blocked).ToString())" />
                    </SuffixContent>
                </SgStatistic>
            </SgCard>
        </SgCol>
    </SgRow>

    @* ── Toolbar ─────────────────────────────────────────────────────────── *@
    <SgCard Bordered="true" CssClass="wh-toolbar-card">
        <SgStack Orientation="SgOrientation.Horizontal" Gap="14px" Wrap="true" Align="SgAlignItems.Center">

            <SgStack Orientation="SgOrientation.Horizontal" Gap="6px" Align="SgAlignItems.Center">
                <span class="wh-tb-label">Раскраска</span>
                <SgSegmented TValue="SgWhColorMode"
                             Options="_colorModeOptions"
                             Value="_options.ColorMode"
                             ValueChanged="SetColorMode" />
            </SgStack>

            <div class="wh-tb-sep"></div>

            <SgStack Orientation="SgOrientation.Horizontal" Gap="6px" Align="SgAlignItems.Center">
                <span class="wh-tb-label">SKU</span>
                <div style="width:200px">
                    <SgTextBox TValue="string"
                               Value="@_options.HighlightSku"
                               ValueChanged="OnSkuChanged"
                               Placeholder="например, SKU-1042"
                               ShowClearButton="true" />
                </div>
            </SgStack>

            <div class="wh-tb-sep"></div>

            <SgStack Orientation="SgOrientation.Horizontal" Gap="14px" Align="SgAlignItems.Center">
                <SgSwitch @bind-Value="_options.ShowLabels"      Label="Метки" />
                <SgSwitch @bind-Value="_options.ShowGrid"        Label="Сетка" />
                <SgSwitch @bind-Value="_options.ShowOccupancyBar" Label="Бар" />
            </SgStack>

            <div class="wh-tb-spacer"></div>

            <SgStack Orientation="SgOrientation.Horizontal" Gap="6px">
                <SgButton Text="Симуляция" Variant="SgButtonVariant.Outlined" OnClick="Randomize" />
                <SgButton Text="Сброс" Variant="SgButtonVariant.Ghost" OnClick="ResetData" />
                <SgButton Text="@(_constructorOpen ? "Закрыть конструктор" : "Конструктор")"
                          Variant="SgButtonVariant.Primary"
                          OnClick="ToggleConstructor" />
            </SgStack>

        </SgStack>
    </SgCard>

    @* ── Canvas area ─────────────────────────────────────────────────────── *@
    <div class="wh-canvas-wrap">
        <SgWarehouse @ref="_wh"
                     Layout="@_layout"
                     Options="@_options"
                     Height="100%"
                     OnCellClick="OnCellClicked"
                     OnRackClick="OnRackClicked" />
    </div>
</div>

@* ── Constructor drawer (left) ──────────────────────────────────────────── *@
<SgDrawer Visible="_constructorOpen"
          VisibleChanged="@((bool v) => _constructorOpen = v)"
          Title="Конструктор склада"
          Placement="SgPlacement.Left"
          Size="360px">

    <SgFormSection Title="@($"Зоны · {_layout.Zones.Count}")">
        <SgStack Orientation="SgOrientation.Vertical" Gap="6px">
            @foreach (var z in _layout.Zones)
            {
                var zz = z;
                <SgStack Orientation="SgOrientation.Horizontal" Gap="6px" Align="SgAlignItems.Center"
                         CssClass="wh-row">
                    <SgBadge Variant="@ZoneBadgeVariant(zz.Type)" Text="@ZoneTypeLabel(zz.Type)" />
                    <span class="wh-row-name">@zz.Name</span>
                    <div class="wh-tb-spacer"></div>
                    <SgButton Text="✕" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm"
                              OnClick="@(() => RemoveZone(zz))" />
                </SgStack>
            }
        </SgStack>

        <SgFormRow>
            <SgTextBox TValue="string" @bind-Value="_newZoneName" Label="Название" Placeholder="например, Хранение C" />
        </SgFormRow>
        <SgFormRow>
            <SgSelect TValue="SgWhZoneType"
                      @bind-Value="_newZoneType"
                      EnumType="typeof(SgWhZoneType)"
                      LabelSelector="z => ZoneTypeLabel(z)"
                      Label="Тип" />
        </SgFormRow>
        <SgFormRow>
            <SgButton Text="+ Добавить зону" Variant="SgButtonVariant.Primary" Block="true" OnClick="AddZone" />
        </SgFormRow>
    </SgFormSection>

    <SgFormSection Title="@($"Стойки · {_layout.Racks.Count}")">
        <div class="wh-rack-list">
            <SgStack Orientation="SgOrientation.Vertical" Gap="6px">
                @foreach (var r in _layout.Racks.OrderBy(r => r.Code))
                {
                    var rr = r;
                    <SgStack Orientation="SgOrientation.Horizontal" Gap="6px" Align="SgAlignItems.Center"
                             CssClass="wh-row wh-row-clickable" OnClick="@(() => FocusRack(rr.Id))">
                        <SgChip Text="@rr.Code" Variant="SgChipVariant.Primary" Outlined="true" />
                        <span class="wh-row-meta">@(rr.Levels)×@(rr.CellsPerLevel) · @TempLabel(rr.Temperature)</span>
                        <div class="wh-tb-spacer"></div>
                        <SgButton Text="✕" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm"
                                  OnClick="@(() => RemoveRack(rr))" />
                    </SgStack>
                }
            </SgStack>
        </div>

        <SgFormRow>
            <SgTextBox TValue="string" @bind-Value="_newRackCode" Label="Код" Placeholder="например, A-12" />
        </SgFormRow>
        <SgFormRow>
            <SgTextBox TValue="int" @bind-Value="_newRackLevels"   Label="Ярусы"   Type="number" />
            <SgTextBox TValue="int" @bind-Value="_newRackPositions" Label="Позиции" Type="number" />
        </SgFormRow>
        <SgFormRow>
            <SgComboBox TValue="string"
                        Items="_zoneIdItems"
                        @bind-Value="_newRackZone"
                        LabelSelector="ZoneIdLabel"
                        Label="Зона"
                        Placeholder="Без зоны"
                        AllowClear="true" />
        </SgFormRow>
        <SgFormRow>
            <SgSelect TValue="SgWhTemperature"
                      @bind-Value="_newRackTemp"
                      EnumType="typeof(SgWhTemperature)"
                      LabelSelector="t => TempLabel(t)"
                      Label="Температура" />
        </SgFormRow>
        <SgFormRow>
            <SgButton Text="+ Добавить стойку" Variant="SgButtonVariant.Primary" Block="true" OnClick="AddRack" />
        </SgFormRow>
    </SgFormSection>
</SgDrawer>

@* ── Cell detail drawer (right) ─────────────────────────────────────────── *@
<SgDrawer Visible="@(_selectedCell is not null)"
          VisibleChanged="@((bool v) => { if (!v) _selectedCell = null; })"
          Title="@CellTitle"
          Placement="SgPlacement.Right"
          Size="400px">

    @if (_selectedCell is { Cell: not null } sel)
    {
        var c = sel.Cell;

        <SgFormSection Title="Статус">
            <SgStack Orientation="SgOrientation.Horizontal" Gap="6px" Wrap="true">
                @foreach (var s in Enum.GetValues<SgWhCellStatus>())
                {
                    var ss = s;
                    var isActive = c.Status == ss;
                    <SgChip Text="@StatusLabel(ss)"
                            Variant="@StatusChipVariant(ss)"
                            Outlined="@(!isActive)"
                            CssClass="wh-status-chip"
                            OnClick="@(() => SetStatus(ss))" />
                }
            </SgStack>
        </SgFormSection>

        <SgFormSection Title="Содержимое">
            <SgFormRow>
                <SgTextBox TValue="string" @bind-Value="c.Sku"         Label="SKU" />
                <SgTextBox TValue="string" @bind-Value="c.ProductName" Label="Наименование" />
            </SgFormRow>
            <SgFormRow>
                <SgTextBox TValue="string" @bind-Value="c.Lot" Label="Партия" />
                <SgSelect TValue="SgWhAbcClass"
                          @bind-Value="c.Abc"
                          EnumType="typeof(SgWhAbcClass)"
                          Label="ABC" />
            </SgFormRow>
            <SgFormRow>
                <SgTextBox TValue="int?" Value="@_qtyEdit" ValueChanged="OnQtyChanged" Label="Кол-во"      Type="number" />
                <SgTextBox TValue="int?" Value="@_capEdit" ValueChanged="OnCapChanged" Label="Вместимость" Type="number" />
            </SgFormRow>
        </SgFormSection>

        @if (c.Capacity is > 0 && c.Quantity is not null)
        {
            var pct = (c.Quantity ?? 0) * 100.0 / c.Capacity!.Value;
            <SgFormSection Title="@($"Заполнение · {pct:F0}%")">
                <SgProgress Value="@pct" Max="100" ShowLabel="false" />
            </SgFormSection>
        }

        <SgPropertyPanel Items="BuildPropertyItems(c)" Columns="2" Dense="true" />

        <SgStack Orientation="SgOrientation.Horizontal" Gap="6px">
            <SgButton Text="Открыть стойку" Variant="SgButtonVariant.Primary" Block="true" OnClick="EnterRackFromCell" />
            <SgButton Text="Очистить"        Variant="SgButtonVariant.Danger"  OnClick="ClearCell" />
        </SgStack>
    }
    else
    {
        <SgEmpty Text="Кликните на стойку, затем на ячейку" />
    }
</SgDrawer>

@code {
    private static readonly Random _rnd = new(11);

    private SgWarehouse?       _wh;
    private SgWhLayout         _layout = new();
    private SgWarehouseOptions _options = new() { ColorMode = SgWhColorMode.Status };
    private SgWhCellEventArgs? _selectedCell;

    private bool _constructorOpen;

    // Constructor form state
    private string         _newZoneName = "";
    private SgWhZoneType   _newZoneType = SgWhZoneType.Storage;
    private string         _newRackCode = "";
    private int            _newRackLevels = 4;
    private int            _newRackPositions = 6;
    private string?        _newRackZone;
    private SgWhTemperature _newRackTemp = SgWhTemperature.Ambient;

    private int? _qtyEdit, _capEdit;

    private record Kpi(int Total, int Occupied, int Reserved, int Damaged, int Expired, int Blocked, double OccupancyPct);
    private Kpi _kpi = new(0, 0, 0, 0, 0, 0, 0);

    // Segmented options (built once)
    private IEnumerable<SgSegmentedOption<SgWhColorMode>> _colorModeOptions = Array.Empty<SgSegmentedOption<SgWhColorMode>>();
    private IEnumerable<string> _zoneIdItems => _layout.Zones.Select(z => z.Id);

    private string CellTitle =>
        _selectedCell is { Cell: not null } s
            ? $"{s.RackCode}-{s.Cell.Level + 1:00}-{s.Cell.Position + 1:00}"
            : "Ячейка";

    protected override void OnInitialized()
    {
        _layout = BuildSampleLayout();
        _colorModeOptions = Enum.GetValues<SgWhColorMode>()
            .Select(m => new SgSegmentedOption<SgWhColorMode> { Value = m, Label = ColorModeLabel(m) })
            .ToList();
        RecalcKpi();
    }

    // ── Sample layout ───────────────────────────────────────────────────────

    private static SgWhLayout BuildSampleLayout()
    {
        var layout = new SgWhLayout
        {
            Name  = "Склад «Север-1»",
            Width = 1200, Height = 800,
            Zones =
            [
                new() { Id="Z-RCV", Name="Приёмка",   Type=SgWhZoneType.Receiving, X=20,  Y=20,  Width=320, Height=140 },
                new() { Id="Z-STG", Name="Стейджинг", Type=SgWhZoneType.Staging,   X=360, Y=20,  Width=200, Height=140 },
                new() { Id="Z-SHP", Name="Отгрузка",  Type=SgWhZoneType.Shipping,  X=860, Y=20,  Width=320, Height=140 },
                new() { Id="Z-PCK", Name="Пикинг",    Type=SgWhZoneType.Picking,   X=580, Y=20,  Width=260, Height=140 },
                new() { Id="Z-STO", Name="Хранение A", Type=SgWhZoneType.Storage,  X=20,  Y=200, Width=560, Height=420 },
                new() { Id="Z-STB", Name="Хранение B", Type=SgWhZoneType.Storage,  X=600, Y=200, Width=580, Height=300 },
                new() { Id="Z-CLD", Name="Холод",      Type=SgWhZoneType.Cold,     X=600, Y=520, Width=280, Height=160 },
                new() { Id="Z-RET", Name="Возвраты",   Type=SgWhZoneType.Returns,  X=900, Y=520, Width=280, Height=160 },
                new() { Id="Z-OFF", Name="Офис",       Type=SgWhZoneType.Office,   X=20,  Y=640, Width=200, Height=120 },
            ],
            Aisles =
            [
                new() { X=20, Y=170, Width=1160, Height=20, Label="Главный проезд" },
                new() { X=20, Y=690, Width=1160, Height=20, Label="Эвакуационный" },
            ],
        };

        var sx = 40.0; var sy = 220.0; var rw = 90.0; var rh = 30.0;
        for (var row = 0; row < 4; row++)
            for (var col = 0; col < 5; col++)
                layout.Racks.Add(BuildRack($"R-A-{row}-{col}", $"A-{row + 1}{col + 1:00}", "Z-STO",
                    sx + col * 105, sy + row * 95, rw, rh, 4, 6,
                    SgWhTemperature.Ambient, fillRate: 0.55 + row * 0.08));

        sx = 620; sy = 220; rw = 100; rh = 32;
        for (var row = 0; row < 3; row++)
            for (var col = 0; col < 5; col++)
                layout.Racks.Add(BuildRack($"R-B-{row}-{col}", $"B-{row + 1}{col + 1:00}", "Z-STB",
                    sx + col * 110, sy + row * 90, rw, rh, 5, 8,
                    SgWhTemperature.Ambient, fillRate: 0.40 + col * 0.05));

        sx = 620; sy = 545; rw = 80; rh = 38;
        for (var row = 0; row < 2; row++)
            for (var col = 0; col < 3; col++)
                layout.Racks.Add(BuildRack($"R-C-{row}-{col}", $"C-{row + 1}{col + 1:00}", "Z-CLD",
                    sx + col * 90, sy + row * 65, rw, rh, 3, 4,
                    col == 2 ? SgWhTemperature.Frozen : SgWhTemperature.Cold,
                    fillRate: 0.65));

        return layout;
    }

    private static readonly string[] _skuSamples =
    {
        "SKU-1042 / Болт M8",
        "SKU-2055 / Кабель UTP cat6",
        "SKU-3081 / Шуруп 4x40",
        "SKU-4112 / Лента изоляционная",
        "SKU-5224 / Подшипник 6204",
        "SKU-6101 / Ремень ГРМ",
        "SKU-7330 / Тормозные колодки",
        "SKU-8021 / Свеча зажигания",
        "SKU-9145 / Фильтр масляный",
        "SKU-1290 / Лампа H7",
    };

    private static SgWhRack BuildRack(string id, string code, string zoneId, double x, double y, double w, double h,
        int levels, int posPerLevel, SgWhTemperature temp, double fillRate)
    {
        var rack = new SgWhRack
        {
            Id = id, Code = code, ZoneId = zoneId,
            X = x, Y = y, Width = w, Height = h,
            Levels = levels, CellsPerLevel = posPerLevel,
            Temperature = temp, MaxLoadKg = 350,
        };
        for (var L = 0; L < levels; L++)
        {
            for (var P = 0; P < posPerLevel; P++)
            {
                var roll = _rnd.NextDouble();
                if (roll > fillRate)
                {
                    rack.Cells.Add(new SgWhCell { Id = $"{id}-{L}-{P}", Level = L, Position = P, Status = SgWhCellStatus.Empty });
                    continue;
                }

                var status = _rnd.NextDouble() switch
                {
                    < 0.04 => SgWhCellStatus.Damaged,
                    < 0.07 => SgWhCellStatus.Expired,
                    < 0.12 => SgWhCellStatus.Reserved,
                    < 0.16 => SgWhCellStatus.Picking,
                    < 0.18 => SgWhCellStatus.Blocked,
                    _      => SgWhCellStatus.Occupied,
                };

                var sample = _skuSamples[_rnd.Next(_skuSamples.Length)].Split(" / ");
                var cap = _rnd.Next(40, 200);
                var qty = (int)(cap * (0.3 + _rnd.NextDouble() * 0.7));
                rack.Cells.Add(new SgWhCell
                {
                    Id           = $"{id}-{L}-{P}",
                    Level        = L,
                    Position     = P,
                    Status       = status,
                    Sku          = sample[0],
                    ProductName  = sample.Length > 1 ? sample[1] : null,
                    Quantity     = qty,
                    Capacity     = cap,
                    WeightKg     = qty * 0.8,
                    Lot          = $"LOT-{_rnd.Next(2024, 2026)}-{_rnd.Next(100, 999)}",
                    ExpiresOn    = DateTime.Today.AddDays(_rnd.Next(-10, 365)),
                    Abc          = _rnd.NextDouble() < 0.2 ? SgWhAbcClass.A : _rnd.NextDouble() < 0.5 ? SgWhAbcClass.B : SgWhAbcClass.C,
                    Turnover30d  = _rnd.Next(0, 40),
                    LastMovedAt  = DateTime.Now.AddHours(-_rnd.Next(0, 720)),
                });
            }
        }
        return rack;
    }

    // ── Actions ─────────────────────────────────────────────────────────────

    private void SetColorMode(SgWhColorMode m) { _options.ColorMode = m; StateHasChanged(); }

    private void OnSkuChanged(string? v) { _options.HighlightSku = string.IsNullOrWhiteSpace(v) ? null : v; StateHasChanged(); }

    private void ToggleConstructor() { _constructorOpen = !_constructorOpen; }

    private void Randomize()
    {
        foreach (var r in _layout.Racks)
        foreach (var c in r.Cells)
        {
            if (c.Status == SgWhCellStatus.Empty && _rnd.NextDouble() < 0.15)
            {
                c.Status = SgWhCellStatus.Occupied;
                var s = _skuSamples[_rnd.Next(_skuSamples.Length)].Split(" / ");
                c.Sku = s[0]; c.ProductName = s.Length > 1 ? s[1] : null;
                c.Capacity = _rnd.Next(50, 200); c.Quantity = (int)(c.Capacity * 0.5);
            }
            else if (c.Status == SgWhCellStatus.Occupied && _rnd.NextDouble() < 0.1)
            {
                c.Status = SgWhCellStatus.Picking;
            }
            else if (_rnd.NextDouble() < 0.05)
            {
                c.Status = SgWhCellStatus.Reserved;
            }
        }
        RecalcKpi();
        StateHasChanged();
    }

    private void ResetData()
    {
        _layout = BuildSampleLayout();
        _selectedCell = null;
        _wh?.ExitRack();
        RecalcKpi();
        StateHasChanged();
    }

    // ── Constructor handlers ───────────────────────────────────────────────

    private void AddZone()
    {
        if (string.IsNullOrWhiteSpace(_newZoneName)) return;
        var idx = _layout.Zones.Count;
        _layout.Zones.Add(new SgWhZone
        {
            Id = $"Z-NEW-{Guid.NewGuid().ToString("N")[..6]}",
            Name = _newZoneName.Trim(),
            Type = _newZoneType,
            X = 240 + (idx % 3) * 220,
            Y = 200 + (idx / 3) * 160,
            Width = 200, Height = 140,
        });
        _newZoneName = "";
    }

    private void RemoveZone(SgWhZone z)
    {
        _layout.Zones.Remove(z);
        foreach (var r in _layout.Racks.Where(r => r.ZoneId == z.Id))
            r.ZoneId = null;
    }

    private void AddRack()
    {
        if (string.IsNullOrWhiteSpace(_newRackCode)) return;
        var idx = _layout.Racks.Count;
        var rack = new SgWhRack
        {
            Id = $"R-NEW-{Guid.NewGuid().ToString("N")[..6]}",
            Code = _newRackCode.Trim(),
            ZoneId = string.IsNullOrEmpty(_newRackZone) ? null : _newRackZone,
            Levels = Math.Clamp(_newRackLevels, 1, 10),
            CellsPerLevel = Math.Clamp(_newRackPositions, 1, 20),
            Temperature = _newRackTemp,
            X = 40 + (idx % 10) * 100,
            Y = 720,
            Width = 90, Height = 30,
        };
        for (var L = 0; L < rack.Levels; L++)
            for (var P = 0; P < rack.CellsPerLevel; P++)
                rack.Cells.Add(new SgWhCell { Id = $"{rack.Id}-{L}-{P}", Level = L, Position = P });
        _layout.Racks.Add(rack);
        _newRackCode = "";
        RecalcKpi();
    }

    private void RemoveRack(SgWhRack r)
    {
        _layout.Racks.Remove(r);
        if (_selectedCell?.RackId == r.Id) _selectedCell = null;
        RecalcKpi();
    }

    private void FocusRack(string rackId) => _wh?.FocusRack(rackId);

    private string ZoneIdLabel(string id)
    {
        var z = _layout.Zones.FirstOrDefault(z => z.Id == id);
        return z is null ? id : $"{z.Name} · {ZoneTypeLabel(z.Type)}";
    }

    // ── Cell / rack interactions ───────────────────────────────────────────

    private void OnRackClicked(SgWhRackEventArgs e) { /* drill-in handled internally */ }

    private void OnCellClicked(SgWhCellEventArgs e)
    {
        _selectedCell = e;
        _qtyEdit = e.Cell?.Quantity;
        _capEdit = e.Cell?.Capacity;
        StateHasChanged();
    }

    private void SetStatus(SgWhCellStatus s)
    {
        if (_selectedCell?.Cell is null) return;
        _selectedCell.Cell.Status = s;
        RecalcKpi();
    }

    private void OnQtyChanged(int? v)
    {
        _qtyEdit = v;
        if (_selectedCell?.Cell is null) return;
        _selectedCell.Cell.Quantity = v;
    }

    private void OnCapChanged(int? v)
    {
        _capEdit = v;
        if (_selectedCell?.Cell is null) return;
        _selectedCell.Cell.Capacity = v;
    }

    private void ClearCell()
    {
        if (_selectedCell?.Cell is null) return;
        var c = _selectedCell.Cell;
        c.Status = SgWhCellStatus.Empty;
        c.Sku = c.ProductName = c.Lot = null;
        c.Quantity = c.Capacity = null;
        c.Abc = SgWhAbcClass.None;
        _qtyEdit = _capEdit = null;
        RecalcKpi();
    }

    private void EnterRackFromCell()
    {
        if (_selectedCell is null) return;
        _wh?.FocusRack(_selectedCell.RackId);
    }

    // ── Property panel for selected cell ───────────────────────────────────

    private static IEnumerable<PropertyPanelItem> BuildPropertyItems(SgWhCell c) =>
    [
        new() { Label = "Вес",          Value = c.WeightKg is null ? "—" : $"{c.WeightKg:F1} кг" },
        new() { Label = "Оборот за 30д", Value = c.Turnover30d?.ToString() ?? "—" },
        new() { Label = "Срок годн.",   Value = c.ExpiresOn?.ToString("dd.MM.yyyy") ?? "—" },
        new() { Label = "Перемещение",  Value = c.LastMovedAt?.ToString("dd.MM HH:mm") ?? "—" },
    ];

    // ── KPI ────────────────────────────────────────────────────────────────

    private void RecalcKpi()
    {
        var total   = _layout.Racks.Sum(r => r.Levels * r.CellsPerLevel);
        var defined = _layout.Racks.SelectMany(r => r.Cells).ToList();
        var occ = defined.Count(c => c.Status is SgWhCellStatus.Occupied or SgWhCellStatus.Picking);
        var res = defined.Count(c => c.Status == SgWhCellStatus.Reserved);
        var dmg = defined.Count(c => c.Status == SgWhCellStatus.Damaged);
        var exp = defined.Count(c => c.Status == SgWhCellStatus.Expired);
        var blk = defined.Count(c => c.Status == SgWhCellStatus.Blocked);
        var pct = total == 0 ? 0 : (occ + res) * 100.0 / total;
        _kpi = new Kpi(total, occ, res, dmg, exp, blk, pct);
    }

