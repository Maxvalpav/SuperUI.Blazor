        new() { Label = "Collapsed", Value = "bool", BadgeText = "Свёрнуто", BadgeVariant = "warn" },
        new() { Label = "FooterContent", Value = "RenderFragment", BadgeText = "Подвал", BadgeVariant = "info" }
    };

    private List<BreadcrumbItem> _breadcrumbItems1 = new()
    {
        new() { Text = "Главная", Href = "/" },
        new() { Text = "Компоненты", Href = "/components" },
        new() { Text = "Навигация" }
    };

    private List<BreadcrumbItem> _breadcrumbItems2 = new()
