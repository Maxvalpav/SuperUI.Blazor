@page "/navigation-demo"
@using SuperUI.Components

<PageTitle>Навигация - SUI</PageTitle>

<SgCard Title="Компоненты навигации" 
        Subtitle="Компоненты для организации навигации и управления переходами между страницами.">

    <!-- SgBreadcrumb -->
    <div style="margin-top: 32px;">
        <h2>SgBreadcrumb - Хлебные крошки</h2>
        <p>Компонент для отображения пути навигации в приложении.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Стандартные крошки</div>
                        <SgBreadcrumb Items="_breadcrumbItems1" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">С иконками</div>
                        <SgBreadcrumb Items="_breadcrumbItems2" Separator="/" />
                    </div>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_breadcrumbProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgTabs -->
    <div style="margin-top: 32px;">
        <h2>SgTabs - Вкладки</h2>
        <p>Компонент для организации контента в виде вкладок.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <SgTabs>
                    <SgTabPanel Title="Вкладка 1">
                        <div style="padding: 16px;">Содержимое первой вкладки</div>
                    </SgTabPanel>
                    <SgTabPanel Title="Вкладка 2">
                        <div style="padding: 16px;">Содержимое второй вкладки</div>
                    </SgTabPanel>
                    <SgTabPanel Title="Вкладка 3">
                        <div style="padding: 16px;">Содержимое третьей вкладки</div>
                    </SgTabPanel>
                </SgTabs>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_tabsProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgStepper -->
    <div style="margin-top: 32px;">
        <h2>SgStepper - Шаги</h2>
        <p>Компонент для отображения многошагового процесса.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Горизонтальный</div>
                        <SgStepper Steps="_stepperItems" Active="1" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Вертикальный</div>
                        <SgStepper Steps="_stepperItems" Active="1" Vertical="true" />
                    </div>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_stepperProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgPagination -->
    <div style="margin-top: 32px;">
        <h2>SgPagination - Пагинация</h2>
        <p>Компонент для навигации по страницам больших наборов данных.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Стандартная пагинация</div>
                        <SgPagination TotalItems="100" PageSize="10" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">С информацией</div>
                        <SgPagination TotalItems="100" PageSize="10" ShowInfo="true" />
                    </div>
                    <div>
                        <div style="font-size: 12px; color: var(--sui-text-muted); margin-bottom: 8px;">Компактная</div>
                        <SgPagination TotalItems="100" PageSize="10" Siblings="0" />
                    </div>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_paginationProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgMenu -->
    <div style="margin-top: 32px;">
        <h2>SgMenu - Меню</h2>
        <p>Компонент для отображения списка действий и навигационных ссылок.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <SgMenu>
                    <SgMenuItem Text="Пункт 1" />
                    <SgMenuItem Text="Пункт 2" />
                    <SgMenuSeparator />
                    <SgMenuItem Text="Пункт 3" />
                    <SgMenuItem Text="Удалить" Variant="SgMenuItemVariant.Danger" />
                </SgMenu>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_menuProperties" />
            </SgCard>
        </div>
    </div>

    <!-- SgNavMenu -->
    <div style="margin-top: 32px;">
        <h2>SgNavMenu - Боковое меню навигации</h2>
        <p>Компонент для создания боковой панели навигации приложения.</p>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <!-- Примеры -->
            <SgCard Title="Примеры использования">
                <div style="height: 300px; border: 1px solid var(--sui-border); border-radius: 4px; overflow: hidden;">
                    <SgNavMenu Title="SuperUI">
                        <SgNavLink Href="/" Icon="🏠" Match="NavLinkMatch.All">Главная</SgNavLink>
                        <SgNavGroup Title="Компоненты" Icon="🧩" Expanded="true">
                            <SgNavLink Href="/inputs" Icon="⌨️">Ввод</SgNavLink>
                            <SgNavLink Href="/feedback" Icon="💬">Обратная связь</SgNavLink>
                            <SgNavLink Href="/layout" Icon="📐">Макет</SgNavLink>
                        </SgNavGroup>
                        <SgNavLink Href="/docs" Icon="📖">Документация</SgNavLink>
                    </SgNavMenu>
                </div>
            </SgCard>

            <!-- Property Grid -->
            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_navMenuProperties" />
            </SgCard>
        </div>
    </div>

    <!-- Примеры кода -->
    <div style="margin-top: 32px;">
        <h2>Примеры кода</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="SgBreadcrumb">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_breadcrumbCode" />
            </SgCard>

            <SgCard Title="SgTabs">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_tabsCode" />
            </SgCard>

            <SgCard Title="SgStepper">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_stepperCode" />
            </SgCard>

            <SgCard Title="SgPagination">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_paginationCode" />
            </SgCard>

            <SgCard Title="SgMenu">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_menuCode" />
            </SgCard>

            <SgCard Title="SgNavMenu">
                <SgCode Language="SgCodeLanguage.Razor" Code="@_navMenuCode" />
            </SgCard>
        </div>
    </div>

</SgCard>

@code {
    private List<PropertyPanelItem> _breadcrumbProperties = new()
    {
        new() { Label = "Separator", Value = "string", BadgeText = "Разделитель", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Items", Value = "IEnumerable<BreadcrumbItem>", BadgeText = "Элементы", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "CssClass", Value = "string", BadgeText = "CSS класс", BadgeVariant = SgBadgeVariant.Info }
    };

    private List<PropertyPanelItem> _tabsProperties = new()
    {
        new() { Label = "Position", Value = "top|bottom|left|right", BadgeText = "Позиция", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ActiveTitle", Value = "string", BadgeText = "Активная", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Type", Value = "line|card", BadgeText = "Тип", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ChildContent", Value = "RenderFragment", BadgeText = "Содержимое", BadgeVariant = SgBadgeVariant.Info }
    };

    private List<PropertyPanelItem> _stepperProperties = new()
    {
        new() { Label = "Steps", Value = "IEnumerable<StepperItem>", BadgeText = "Шаги", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Active", Value = "int", BadgeText = "Активный", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Vertical", Value = "bool", BadgeText = "Вертикальный", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Clickable", Value = "bool", BadgeText = "Кликабельный", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "ActiveChanged", Value = "EventCallback<int>", BadgeText = "Изменение", BadgeVariant = SgBadgeVariant.Success }
    };

    private List<PropertyPanelItem> _paginationProperties = new()
    {
        new() { Label = "TotalItems", Value = "int", BadgeText = "Всего", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "PageSize", Value = "int", BadgeText = "На странице", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Page", Value = "int", BadgeText = "Текущая", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ShowInfo", Value = "bool", BadgeText = "Информация", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Simple", Value = "bool", BadgeText = "Компактная", BadgeVariant = SgBadgeVariant.Warn }
    };

    private List<PropertyPanelItem> _menuProperties = new()
    {
        new() { Label = "Text", Value = "string", BadgeText = "Текст", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Icon", Value = "RenderFragment", BadgeText = "Иконка", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Variant", Value = "default|danger", BadgeText = "Стиль", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Disabled", Value = "bool", BadgeText = "Отключить", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "OnClick", Value = "EventCallback", BadgeText = "Событие", BadgeVariant = SgBadgeVariant.Success }
    };

    private List<PropertyPanelItem> _navMenuProperties = new()
    {
        new() { Label = "Title", Value = "string", BadgeText = "Заголовок", BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Collapsible", Value = "bool", BadgeText = "Сворачиваемое", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Collapsed", Value = "bool", BadgeText = "Свёрнуто", BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "FooterContent", Value = "RenderFragment", BadgeText = "Подвал", BadgeVariant = SgBadgeVariant.Info }
    };

    private List<BreadcrumbItem> _breadcrumbItems1 = new()
    {
        new() { Text = "Главная", Href = "/" },
        new() { Text = "Компоненты", Href = "/components" },
        new() { Text = "Навигация" }
    };

    private List<BreadcrumbItem> _breadcrumbItems2 = new()
    {
        new() { Text = "📁 Документы", Href = "/" },
        new() { Text = "📄 Проекты", Href = "/projects" },
        new() { Text = "✏️ Редактирование" }
    };

    private List<StepperItem> _stepperItems = new()
    {
        new() { Title = "Шаг 1", Description = "Выбор типа" },
        new() { Title = "Шаг 2", Description = "Заполнение данных" },
        new() { Title = "Шаг 3", Description = "Подтверждение" }
    };

    // ── Code snippets ─────────────────────────────────────────────────────────
    private string _breadcrumbCode = """
        <SgBreadcrumb Items="_items" Separator="/" />

        @code {
            private List<BreadcrumbItem> _items = new()
            {
                new() { Text = "Главная",    Href = "/" },
                new() { Text = "Компоненты", Href = "/components" },
                new() { Text = "Навигация" }
            };
        }
        """;

    private string _tabsCode = """
        <SgTabs>
            <SgTabPanel Title="Вкладка 1">
                Содержимое первой вкладки
            </SgTabPanel>
            <SgTabPanel Title="Вкладка 2">
                Содержимое второй вкладки
            </SgTabPanel>
            <SgTabPanel Title="Вкладка 3" Disabled="true">
                Отключённая вкладка
            </SgTabPanel>
        </SgTabs>
        """;

    private string _stepperCode = """
        <SgStepper Steps="_steps" @bind-Active="_step" />

        @code {
            private int _step = 1;
            private List<StepperItem> _steps = new()
            {
                new() { Title = "Шаг 1", Description = "Выбор типа" },
                new() { Title = "Шаг 2", Description = "Данные" },
                new() { Title = "Шаг 3", Description = "Подтверждение" }
            };
        }
        """;

    private string _paginationCode = """
        <SgPagination TotalItems="100"
                      PageSize="10"
                      @bind-Page="_page"
                      ShowInfo="true" />

        @code {
            private int _page = 1;
        }
        """;

    private string _menuCode = """
        <SgMenu>
            <SgMenuItem Text="Редактировать" />
            <SgMenuItem Text="Дублировать" />
            <SgMenuSeparator />
            <SgMenuItem Text="Удалить" Variant="SgMenuItemVariant.Danger" />
        </SgMenu>
        """;

    private string _navMenuCode = """
        <SgNavMenu Title="Моё приложение">
            <SgNavLink Href="/"     Icon="🏠" Match="NavLinkMatch.All">
                Главная
            </SgNavLink>
            <SgNavGroup Title="Разделы" Icon="📂" Expanded="true">
                <SgNavLink Href="/users"    Icon="👤">Пользователи</SgNavLink>
                <SgNavLink Href="/settings" Icon="⚙️">Настройки</SgNavLink>
            </SgNavGroup>
        </SgNavMenu>
        """;
}


