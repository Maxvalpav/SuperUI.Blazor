        new() { Label = "Page", Value = "int", BadgeText = "Текущая", BadgeVariant = "info" },
        new() { Label = "ShowInfo", Value = "bool", BadgeText = "Информация", BadgeVariant = "warn" },
        new() { Label = "Simple", Value = "bool", BadgeText = "Компактная", BadgeVariant = "warn" }
