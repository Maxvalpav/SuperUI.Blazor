@page "/mention-demo"
@using SuperUI.Components

<PageTitle>Mention — SuperUI</PageTitle>
<SgSeoHead Description="@("Trigger suggestion dropdowns with @, #, or other characters. Navigate with arrow keys, select with Enter or click.")" />

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false">
    <ChildContent>

    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                SgMention — &#64;mention Input
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Trigger suggestion dropdowns with &#64;, #, or other characters.
                Navigate with arrow keys, select with Enter or click.
            </SgTypography>
        </div>

        <div class="demo-examples">
            <SgCard Title="@("Default " + _atString + "mention (users)")" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgMention Options="@_users"
                           Triggers="@_atString"
                           Placeholder="@("Type " + _atString + " to mention someone...")"
                           Label="Comment"
                           Value="@_comment"
                           ValueChanged="@OnCommentChanged" />
                <div class="demo-value-display">
                    <strong>Value:</strong> @_comment
                </div>
            </SgCard>

            <SgCard Title="With avatars + groups" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgMention Options="@_usersWithAvatars"
                           Triggers="@_atString"
                           Placeholder="Mention a team member..."
                           Label="Team mention" />
            </SgCard>

            <SgCard Title="@("Multi-trigger (" + _atString + " and #)")" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgMention Options="@_multiTriggerItems"
                           Triggers="@_atHashString"
                           Placeholder="@("Use " + _atString + " for users, # for tags...")"
                           Label="Multi-trigger" />
            </SgCard>

            <SgCard Title="Read-only" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgMention Options="@_users"
                           Triggers="@_atString"
                           Value="@("Hello " + _atString + "alice, have you seen " + _atString + "bob?")"
                           ReadOnly="true"
                           Label="Read-only" />
            </SgCard>
        </div>
    </div>

    </ChildContent>
</SgCard>

<style>
    .demo-examples {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 16px;
        margin-top: 16px;
    }
    .demo-value-display {
        margin-top: 8px;
        padding: 8px 12px;
        background: var(--sg-bg-subtle, #f9fafb);
        border-radius: var(--sg-radius-sm, 4px);
        font-size: 13px;
        word-break: break-all;
        color: var(--sg-fg-subtle, #6b7280);
    }
</style>

@code {
    private string _comment = "";
    private string _atString = "@";
    private string _atHashString = "@#";

    private Task OnCommentChanged(string value)
    {
        _comment = value;
        return Task.CompletedTask;
    }

    private List<SgMentionOption> _users = new()
    {
        new() { Value = "alice", DisplayText = "Alice Johnson" },
        new() { Value = "bob", DisplayText = "Bob Smith" },
        new() { Value = "charlie", DisplayText = "Charlie Brown" },
        new() { Value = "diana", DisplayText = "Diana Prince" },
        new() { Value = "eve", DisplayText = "Eve Wilson" },
        new() { Value = "frank", DisplayText = "Frank Castle" },
    };

    private List<SgMentionOption> _usersWithAvatars = new()
    {
        new() { Value = "alice", DisplayText = "Alice Johnson", ImageUrl = "https://i.pravatar.cc/40?u=alice", Group = "Engineering" },
        new() { Value = "bob", DisplayText = "Bob Smith", ImageUrl = "https://i.pravatar.cc/40?u=bob", Group = "Engineering" },
        new() { Value = "charlie", DisplayText = "Charlie Brown", ImageUrl = "https://i.pravatar.cc/40?u=charlie", Group = "Design" },
        new() { Value = "diana", DisplayText = "Diana Prince", ImageUrl = "https://i.pravatar.cc/40?u=diana", Group = "Design" },
        new() { Value = "eve", DisplayText = "Eve Wilson", ImageUrl = "https://i.pravatar.cc/40?u=eve", Group = "Product" },
        new() { Value = "frank", DisplayText = "Frank Castle", ImageUrl = "https://i.pravatar.cc/40?u=frank", Group = "Product" },
    };

    private List<SgMentionOption> _multiTriggerItems = new()
    {
        new() { Value = "feature", DisplayText = "Feature Request", Group = "#tags" },
        new() { Value = "bug", DisplayText = "Bug Report", Group = "#tags" },
        new() { Value = "docs", DisplayText = "Documentation", Group = "#tags" },
        new() { Value = "alice", DisplayText = "Alice Johnson", Group = "@users" },
        new() { Value = "bob", DisplayText = "Bob Smith", Group = "@users" },
        new() { Value = "charlie", DisplayText = "Charlie Brown", Group = "@users" },
    };
}
