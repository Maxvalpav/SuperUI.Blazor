@page "/extractor-demo"
@using SuperUI.Components
@using SuperUI.Components.Llm

<PageTitle>Document AI Extractor — SUI</PageTitle>

<SgCard Title="SgDocumentExtractor — Document AI Extractor"
        Subtitle="Загрузка PDF / Word / изображений с автоматическим извлечением полей через OpenAI / OpenRouter, динамической формой и экспортом в JSON / PDF / Word.">

    <!-- Живой пример -->
    <div style="margin-top: 32px;">
        <h2>Живой пример</h2>
        <p>Полный сценарий: загрузка → AI-анализ → редактирование → экспорт. Введите свой API-ключ в настройках, чтобы запустить извлечение.</p>

        <SgCard Style="margin-top: 16px;">
            <SgDocumentExtractor />
        </SgCard>
    </div>

    <!-- Возможности -->
    <div style="margin-top: 32px;">
        <h2>Возможности</h2>
        <p>Полнофункциональный пайплайн обработки документов в одном компоненте.</p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin-top: 16px;">
            <SgCard Title="📁 Загрузка файлов">
                <ul style="margin: 0; padding-left: 18px; line-height: 1.8;">
                    <li>PDF, DOCX, JPG, PNG, WebP</li>
                    <li>Drag &amp; drop + выбор через диалог</li>
                    <li>Множественная загрузка (до 10 файлов)</li>
                    <li>Превью с миниатюрами</li>
                </ul>
            </SgCard>

            <SgCard Title="🤖 AI-анализ">
                <ul style="margin: 0; padding-left: 18px; line-height: 1.8;">
                    <li>OpenAI: <code>gpt-4o</code>, <code>gpt-4o-mini</code>, <code>o1</code></li>
                    <li>OpenRouter: динамическая загрузка моделей</li>
                    <li>Vision API для PDF и изображений</li>
                    <li>Кастомный system prompt</li>
                </ul>
            </SgCard>

            <SgCard Title="📋 Динамическая форма">
                <ul style="margin: 0; padding-left: 18px; line-height: 1.8;">
                    <li>Авто-генерация по JSON Schema</li>
                    <li>Поля: text, number, date, select, checkbox</li>
                    <li>Таблицы с добавлением и удалением строк</li>
                    <li>Группировка по секциям, валидация</li>
                </ul>
            </SgCard>

            <SgCard Title="📥 Экспорт">
                <ul style="margin: 0; padding-left: 18px; line-height: 1.8;">
                    <li>JSON — извлечённые данные</li>
                    <li>PDF — через QuestPDF</li>
                    <li>Word (DOCX) — через OpenXML</li>
                    <li>Режим шаблона (preserve structure)</li>
                </ul>
            </SgCard>
        </div>
    </div>

    <!-- Архитектура -->
    <div style="margin-top: 32px;">
        <h2>Архитектура</h2>
        <p>Компонент собран из независимых сервисов и подкомпонентов, регистрируемых через <code>AddSuperUI()</code>.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Сервисы (DI)">
                @RenderTable(_serviceProperties)
            </SgCard>

            <SgCard Title="Подкомпоненты">
                @RenderTable(_subComponentProperties)
            </SgCard>
        </div>
    </div>

    <!-- Пошаговая инструкция -->
    <div style="margin-top: 32px;">
        <h2>Как пользоваться</h2>
        <p>Три шага от документа к структурированным данным.</p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-top: 16px;">
            <SgCard Title="1. Загрузка">
                <p style="margin: 0;">
                    Перетащите файлы в зону загрузки или нажмите на неё. Поддерживаются PDF, Word и изображения.
                    Можно загрузить сразу несколько файлов — они будут проанализированы как один документ.
                </p>
            </SgCard>

            <SgCard Title="2. Настройки AI">
                <p style="margin: 0;">
                    Раскройте панель «AI Settings», выберите провайдера (OpenAI или OpenRouter), вставьте API-ключ
                    и выберите модель. Настройки сохраняются в <code>localStorage</code> браузера.
                </p>
            </SgCard>

            <SgCard Title="3. Извлечение и экспорт">
                <p style="margin: 0;">
                    Нажмите <b>Extract Data from All</b>. После анализа отредактируйте поля и экспортируйте
                    результат — JSON / PDF / Word или сразу всё.
                </p>
            </SgCard>
        </div>
    </div>

    <!-- Параметры -->
    <div style="margin-top: 32px;">
        <h2>Параметры компонента</h2>
        <p>Внешний API <code>SgDocumentExtractor</code>.</p>

        <SgCard>
            @RenderTable(_componentProperties)
        </SgCard>
    </div>

    <!-- Пример использования -->
    <div style="margin-top: 32px;">
        <h2>Использование</h2>

        <SgCard Title="Регистрация в Program.cs">
            <pre class="sg-code"><code>builder.Services.AddSuperUI();</code></pre>
        </SgCard>

        <SgCard Title="Razor разметка" Style="margin-top: 16px;">
            <pre class="sg-code"><code>@@using SuperUI.Components.Llm

&lt;SgDocumentExtractor /&gt;</code></pre>
        </SgCard>
    </div>

</SgCard>

<style>
    .sg-code {
        background: var(--sui-bg-secondary, #f8fafc);
        padding: 16px;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 13px;
        margin: 0;
    }

    .sg-prop-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .sg-prop-table thead tr {
        background: var(--sui-bg-secondary, #f8fafc);
    }

    .sg-prop-table th,
    .sg-prop-table td {
        text-align: left;
        padding: 8px 12px;
        border-bottom: 1px solid var(--sui-border-color, #e2e8f0);
    }

    .sg-prop-table td.type {
        color: var(--sui-text-muted, #64748b);
    }
</style>

@code {
    private record PropertyRow(string Name, string Type, string Description);

    private RenderFragment RenderTable(IEnumerable<PropertyRow> items) => __builder =>
    {
        <table class="sg-prop-table">
            <thead>
                <tr>
                    <th>Имя</th>
                    <th>Тип</th>
                    <th>Описание</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td><code>@item.Name</code></td>
                        <td class="type">@item.Type</td>
                        <td>@((MarkupString)item.Description)</td>
                    </tr>
                }
            </tbody>
        </table>
    };

    private readonly List<PropertyRow> _componentProperties = new()
    {
        new("CssClass", "string?", "Дополнительный CSS-класс для корневого элемента."),
    };

    private readonly List<PropertyRow> _serviceProperties = new()
    {
        new("IOpenAiService", "Service", "Вызовы chat/completions с vision (OpenAI / OpenRouter)."),
        new("IDocumentParserService", "Service", "PDF/Word/Image → текст + изображения страниц."),
        new("ISchemaGeneratorService", "Service", "JSON-ответ модели → DocumentSchema."),
        new("IPdfExportService", "Service", "Экспорт заполненной формы в PDF (QuestPDF)."),
        new("IWordExportService", "Service", "Экспорт в DOCX (DocumentFormat.OpenXml)."),
        new("ILlmService", "Service", "Каталог моделей OpenRouter."),
    };

    private readonly List<PropertyRow> _subComponentProperties = new()
    {
        new("SettingsPanel", "Razor", "Провайдер, API-ключ, модель, температура, max tokens."),
        new("FileUploadZone", "Razor", "Drag &amp; drop + InputFile."),
        new("FilePreview", "Razor", "Сетка миниатюр загруженных файлов."),
        new("DynamicFormRenderer", "Razor", "Динамическая форма по схеме."),
        new("FieldComponents/*", "Razor", "TextField, NumberField, DateField, SelectField, CheckboxField, TextAreaField, TableField."),
        new("ExportPanel", "Razor", "Кнопки экспорта + переключатель «template mode»."),
    };
}
