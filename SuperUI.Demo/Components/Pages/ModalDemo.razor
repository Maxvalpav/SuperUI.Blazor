@page "/modal-demo"
@using SuperUI.Components

<PageTitle>Модальное окно - SUI</PageTitle>

<SgCard Title="SgModal - Модальное окно"
        Subtitle="Компонент для отображения модальных диалогов. Поддерживает различные размеры, кастомные действия и анимации.">

    <div style="margin-top: 32px;">
        <h2>Примеры использования</h2>
        <p>Интерактивные модальные окна с различными конфигурациями.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="Примеры использования">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <SgButton Text="Открыть базовое окно" Variant="SgButtonVariant.Primary" OnClick="@(() => _showBasic = true)" />
                    <SgButton Text="Открыть окно с формой" OnClick="@(() => _showForm = true)" />
                    <SgButton Text="Открыть подтверждение" Variant="SgButtonVariant.Danger" OnClick="@(() => _showConfirm = true)" />
                    <SgButton Text="Широкое окно" Variant="SgButtonVariant.Outlined" OnClick="@(() => _showWide = true)" />
                </div>
            </SgCard>

            <SgCard Title="Свойства компонента">
                <PropertyTable Items="_modalProperties" />
            </SgCard>
        </div>
    </div>
    <div style="margin-top: 32px;">
        <h2>Анимация и перечисление SgModalAnimation</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16px;">
            <SgCard Title="SgModalAnimation">
                <PropertyTable Items="_animationEnum" />
            </SgCard>
        </div>
    </div>

</SgCard>

<!-- Базовое модальное окно -->
<SgModal @bind-Visible="@_showBasic" Title="Базовое окно">
    <ChildContent>
        <p>Это содержимое модального окна. Вы можете добавить любой контент здесь.</p>
        <SgAlert Variant="SgAlertVariant.Info" Text="Модальное окно поддерживает любой HTML-контент." />
    </ChildContent>
    <FooterContent>
        <SgButton Text="Закрыть" OnClick="CloseBasic" />
    </FooterContent>
</SgModal>

<!-- Модальное окно с формой -->
<SgModal @bind-Visible="@_showForm" Title="Форма в окне">
    <ChildContent>
        <div style="display: flex; flex-direction: column; gap: 16px; padding: 8px 0;">
            <SgTextBox TValue="string" @bind-Value="@_formName" Label="Имя" Placeholder="Введите имя" />
            <SgTextBox TValue="string" @bind-Value="@_formEmail" Label="Email" Placeholder="Введите email" Type="email" />
            <SgSelect TValue="string" @bind-Value="@_formRole" Items="@_roles" Label="Роль" Placeholder="Выберите роль..." />
        </div>
    </ChildContent>
    <FooterContent>
        <SgButton Text="Сохранить" Variant="SgButtonVariant.Primary" OnClick="SaveForm" />
        <SgButton Text="Отмена" OnClick="@(() => _showForm = false)" />
    </FooterContent>
</SgModal>

<!-- Модальное окно подтверждения -->
<SgModal @bind-Visible="@_showConfirm" Title="Подтверждение удаления">
    <ChildContent>
        <SgAlert Variant="SgAlertVariant.Danger" Text="Это действие необратимо. Вы уверены, что хотите удалить запись?" />
    </ChildContent>
    <FooterContent>
        <SgButton Text="Удалить" Variant="SgButtonVariant.Danger" OnClick="ConfirmDelete" />
        <SgButton Text="Отмена" OnClick="@(() => _showConfirm = false)" />
    </FooterContent>
</SgModal>

<!-- Широкое модальное окно -->
<SgModal @bind-Visible="@_showWide" Title="Широкое окно" Width="800px">
    <ChildContent>
        <p>Это широкое модальное окно для отображения большого объёма информации.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px;">
            <SgTextBox TValue="string" @bind-Value="@_wideField1" Label="Поле 1" Placeholder="Введите значение" />
            <SgTextBox TValue="string" @bind-Value="@_wideField2" Label="Поле 2" Placeholder="Введите значение" />
            <SgTextBox TValue="string" @bind-Value="@_wideField3" Label="Поле 3" Placeholder="Введите значение" />
            <SgTextBox TValue="string" @bind-Value="@_wideField4" Label="Поле 4" Placeholder="Введите значение" />
        </div>
    </ChildContent>
    <FooterContent>
        <SgButton Text="Сохранить" Variant="SgButtonVariant.Primary" OnClick="SaveWide" />
        <SgButton Text="Закрыть" OnClick="@(() => _showWide = false)" />
    </FooterContent>
</SgModal>

@code {
    private bool _showBasic;
    private bool _showForm;
    private bool _showConfirm;
    private bool _showWide;

    private string? _formName;
    private string? _formEmail;
    private string? _formRole;
    private string? _wideField1;
    private string? _wideField2;
    private string? _wideField3;
    private string? _wideField4;

    private List<string> _roles = new() { "Администратор", "Менеджер", "Пользователь", "Гость" };

    private void CloseBasic()
    {
        _showBasic = false;
    }

    private void SaveForm()
    {
        _showForm = false;
    }

    private void ConfirmDelete()
    {
        _showConfirm = false;
    }

    private void SaveWide()
    {
        _showWide = false;
    }

    private List<PropertyPanelItem> _modalProperties = new()
    {
        new() { Label = "Visible",         Value = "bool",                BadgeText = "Видимо",           BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Title",           Value = "string",              BadgeText = "Заголовок",         BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Width",           Value = "string",              BadgeText = "Ширина",            BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "ShowClose",       Value = "bool",                BadgeText = "Кнопка закрытия",  BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "CloseOnBackdrop", Value = "bool",                BadgeText = "Закрыть по фону",  BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "CloseOnEscape",   Value = "bool",                BadgeText = "Закрыть по Esc",   BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "Animation",       Value = "scale|fade|slide",    BadgeText = "Анимация (enum)",  BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "Draggable",       Value = "bool",                BadgeText = "Перетаскиваемое",  BadgeVariant = SgBadgeVariant.Warn },
        new() { Label = "VisibleChanged",  Value = "EventCallback<bool>", BadgeText = "Событие",          BadgeVariant = SgBadgeVariant.Success },
        new() { Label = "OnClose",         Value = "EventCallback",       BadgeText = "Закрытие",          BadgeVariant = SgBadgeVariant.Success }
    };

    // ── Enum tables ──────────────────────────────────────────────────────────
    private List<PropertyPanelItem> _animationEnum = new()
    {
        new() { Label = "SgModalAnimation.Scale", Value = "\"scale\"", BadgeText = "Масштаб (по умолч.)", BadgeVariant = SgBadgeVariant.Default },
        new() { Label = "SgModalAnimation.Fade",  Value = "\"fade\"",  BadgeText = "Затухание",           BadgeVariant = SgBadgeVariant.Info },
        new() { Label = "SgModalAnimation.Slide", Value = "\"slide\"", BadgeText = "Сдвиг",               BadgeVariant = SgBadgeVariant.Info },
    };
}
