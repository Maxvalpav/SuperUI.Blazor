@page "/modal-demo"
@using SuperUI.Components
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>SgModal — Modal Dialog — SuperUI</PageTitle>

<SgCard Variant="SgCardVariant.Default" Shadow="SgShadow.Md" Radius="SgSize.Lg"
        Status="SgCardStatus.Info" Hoverable="false"
        HeaderContent="@_mainHeader">
    <ChildContent>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. Examples — Interactive Usage                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Interactive Examples
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Click buttons to open modals with different configurations.
            </SgTypography>
        </div>

        <div class="demo-two-col">
            <SgCard Title="Usage Scenarios" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <SgStack Vertical Space="SgSize.Md">
                    <SgButton Text="Basic Modal" Variant="SgButtonVariant.Primary"
                              OnClick="@(() => _showBasic = true)"
                              PrefixIcon="@SgHeroicons.Outline.Window" />
                    <SgButton Text="Form Modal" Variant="SgButtonVariant.Outlined"
                              OnClick="@(() => _showForm = true)"
                              PrefixIcon="@SgHeroicons.Outline.DocumentText" />
                    <SgButton Text="Confirm Delete" Variant="SgButtonVariant.Danger"
                              OnClick="@(() => _showConfirm = true)"
                              PrefixIcon="@SgHeroicons.Outline.Trash" />
                    <SgButton Text="Full Screen" Variant="SgButtonVariant.Ghost"
                              OnClick="@(() => _showFullscreen = true)"
                              PrefixIcon="@SgHeroicons.Outline.ArrowsPointingOut" />
                </SgStack>
            </SgCard>

            <SgCard Title="Key Features" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                <PropertyTable Items="_keyFeatures" />
            </SgCard>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 2. Size Variants                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Size Variants
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Four preset sizes via <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">Size</SgTypography> parameter.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Md">
            @foreach (var size in _sizes)
            {
                var s = size;
                <SgCol Md="3">
                    <SgCard Title="@s.Label" Size="SgSize.Sm" Shadow="SgShadow.Sm">
                        <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                            <div class="size-box" style="width:@s.PreviewW">@s.Label</div>
                            <SgButton Text="Open" Size="SgSize.Sm"
                                      OnClick="@(() => OpenSizeModal(s.Value))" />
                            <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                                @s.Width
                            </SgTypography>
                        </SgStack>
                    </SgCard>
                </SgCol>
            }
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 3. Animations                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Animation Types
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                All 9 animation variants from <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgModalAnimation</SgTypography>.
            </SgTypography>
        </div>

        <div class="anim-grid">
            @foreach (var anim in _animations)
            {
                var a = anim;
                <SgCard Size="SgSize.Sm" Shadow="SgShadow.Sm" NoPadding="true">
                    <button class="anim-btn" @onclick="() => OpenAnimModal(a.Value)">
                        <SgStack Vertical Space="SgSize.Sm" Align="SgAlignItems.Center">
                            <SgIcon Icon="@SgHeroicons.Outline.Play" Size="28px" Color="var(--sg-primary)" />
                            <SgTypography Size="SgTypographySize.Sm" Weight="SgTypographyWeight.Semibold" Align="SgTypographyAlign.Center">
                                @a.Label
                            </SgTypography>
                        </SgStack>
                    </button>
                </SgCard>
            }
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 4. Position + Advanced Features                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Position &amp; Advanced Features
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Vertical positioning, draggable, glassmorphism, and more.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="4">
                <SgCard Title="Position" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgButton Text="Top" OnClick="@(() => OpenPosModal(SgModalPosition.Top))"
                                  PrefixIcon="@SgHeroicons.Outline.ChevronUp" Variant="SgButtonVariant.Outlined" />
                        <SgButton Text="Center" OnClick="@(() => OpenPosModal(SgModalPosition.Center))"
                                  PrefixIcon="@SgHeroicons.Outline.Minus" Variant="SgButtonVariant.Primary" />
                        <SgButton Text="Bottom" OnClick="@(() => OpenPosModal(SgModalPosition.Bottom))"
                                  PrefixIcon="@SgHeroicons.Outline.ChevronDown" Variant="SgButtonVariant.Outlined" />
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Features" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgButton Text="Draggable" OnClick="@(() => _showDraggable = true)"
                                  PrefixIcon="@SgHeroicons.Outline.ArrowsPointingOut" Variant="SgButtonVariant.Outlined" />
                        <SgButton Text="Glass Effect" OnClick="@(() => _showGlass = true)"
                                  PrefixIcon="@SgHeroicons.Outline.Sparkles" Variant="SgButtonVariant.Ghost" />
                        <SgButton Text="No Padding" OnClick="@(() => _showNoPad = true)"
                                  PrefixIcon="@SgHeroicons.Outline.Squares2x2" Variant="SgButtonVariant.Ghost" />
                    </SgStack>
                </SgCard>
            </SgCol>
            <SgCol Md="4">
                <SgCard Title="Anim + Size" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <SgButton Text="Zoom + Lg" OnClick="@(() => OpenComboModal(SgModalAnimation.Zoom, SgModalSize.Lg))"
                                  PrefixIcon="@SgHeroicons.Outline.MagnifyingGlassPlus" Variant="SgButtonVariant.Outlined" />
                        <SgButton Text="SlideUp + Sm" OnClick="@(() => OpenComboModal(SgModalAnimation.SlideUp, SgModalSize.Sm))"
                                  PrefixIcon="@SgHeroicons.Outline.ArrowUp" Variant="SgButtonVariant.Outlined" />
                        <SgButton Text="Fade + Xl" OnClick="@(() => OpenComboModal(SgModalAnimation.Fade, SgModalSize.Xl))"
                                  PrefixIcon="@SgHeroicons.Outline.ArrowsPointingOut" Variant="SgButtonVariant.Outlined" />
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 5. Live Constructor                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                Live Modal Constructor
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Configure parameters interactively. Click <strong>Open</strong> to see the result.
            </SgTypography>
        </div>

        <SgCard Shadow="SgShadow.Md" Radius="SgSize.Lg" NoPadding="true">
            <SgRow Space="SgSize.Md">

                <!-- ── Control Panel ── -->
                <SgCol Xs="12" Md="5" Style="padding:24px;border-right:1px solid var(--sg-border);">
                    <SgStack Vertical Space="SgSize.Lg">

                        <!-- Size -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Size</SgTypography>
                            <SgSegmented TValue="SgModalSize"
                                         Value="_cSize"
                                         ValueChanged="v => { _cSize = v; UpdateCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_sizeSegOpts" />
                        </SgStack>

                        <!-- Animation -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Animation</SgTypography>
                            <SgSelect TValue="SgModalAnimation"
                                      @bind-Value="_cAnim"
                                      Items="_animItems"
                                      LabelSelector="x => x.ToString()"
                                      Block="true" />
                        </SgStack>

                        <!-- Position -->
                        <SgStack Vertical Space="SgSize.Sm">
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Position</SgTypography>
                            <SgSegmented TValue="SgModalPosition"
                                         Value="_cPos"
                                         ValueChanged="v => { _cPos = v; UpdateCode(); }"
                                         Block="true"
                                         Size="sm"
                                         Options="_posSegOpts" />
                        </SgStack>

                        <!-- Toggles -->
                        <SgRow Space="SgSize.Md">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Draggable</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_cDrag"
                                                 ValueChanged="v => { _cDrag = v; UpdateCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="_boolSegOpts" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">FullScreen</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_cFull"
                                                 ValueChanged="v => { _cFull = v; UpdateCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="_boolSegRevOpts" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <SgRow Space="SgSize.Md">
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">ShowClose</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_cShowClose"
                                                 ValueChanged="v => { _cShowClose = v; UpdateCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="_boolSegOpts" />
                                </SgStack>
                            </SgCol>
                            <SgCol Span="6">
                                <SgStack Vertical Space="SgSize.Sm">
                                    <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">CloseOnEsc</SgTypography>
                                    <SgSegmented TValue="bool"
                                                 Value="_cEsc"
                                                 ValueChanged="v => { _cEsc = v; UpdateCode(); }"
                                                 Block="true" Size="sm"
                                                 Options="_boolSegOpts" />
                                </SgStack>
                            </SgCol>
                        </SgRow>

                        <!-- Summary -->
                        <div class="ctrl-summary">
                            <SgStack Vertical Space="SgSize.Sm">
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Size</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Info" Text="@_cSize.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Animation</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Success" Text="@_cAnim.ToString()" Standalone="true" />
                                </SgStack>
                                <SgStack Horizontal Space="SgSize.Sm" Align="SgAlignItems.Center" Justify="SgJustifyContent.SpaceBetween">
                                    <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">Position</SgTypography>
                                    <SgBadge Variant="SgBadgeVariant.Default" Text="@_cPos.ToString()" Standalone="true" />
                                </SgStack>
                            </SgStack>
                        </div>

                        <SgButton Text="Open Modal" Variant="SgButtonVariant.Primary" Block="true"
                                  OnClick="@(() => _showConstructor = true)" />

                    </SgStack>
                </SgCol>

                <!-- ── Code ── -->
                <SgCol Xs="12" Md="7" Style="padding:24px;">
                    <SgStack Vertical Space="SgSize.Lg">

                        <SgStack Vertical Space="SgSize.Sm">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)">Generated Code</SgTypography>
                                <button type="button" class="demo-copy-btn" title="Copy to clipboard" @onclick="CopyCode">
                                    <SgIcon Icon="@SgHeroicons.Outline.Clipboard" Size="14px" />
                                    <span style="font-size:11px;font-weight:600;margin-left:4px;">@_copyLabel</span>
                                </button>
                            </div>
                            <div class="code-block">
                                @foreach (var line in _generatedCode)
                                {
                                    <code>@line</code>
                                }
                            </div>
                        </SgStack>

                    </SgStack>
                </SgCol>

            </SgRow>
        </SgCard>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 6. API Reference                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div class="demo-section">
        <div class="demo-section-header">
            <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold">
                API Reference
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Full parameter list for <SgTypography As="SgTypographyElement.Code" Size="SgTypographySize.Sm">SgModal</SgTypography>.
            </SgTypography>
        </div>

        <SgRow Space="SgSize.Lg">
            <SgCol Md="6">
                <SgCard Title="SgModal Parameters" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <PropertyTable Items="_modalProperties" />
                </SgCard>
            </SgCol>
            <SgCol Md="6">
                <SgCard Title="Enums" Shadow="SgShadow.Sm" Size="SgSize.Sm">
                    <SgStack Vertical Space="SgSize.Md">
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="margin-bottom:8px;display:block;">
                                SgModalAnimation
                            </SgTypography>
                            <PropertyTable Items="_animEnum" />
                        </div>
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="margin-bottom:8px;display:block;">
                                SgModalSize
                            </SgTypography>
                            <PropertyTable Items="_sizeEnum" />
                        </div>
                        <div>
                            <SgTypography Size="SgTypographySize.Xs" Weight="SgTypographyWeight.Bold" Transform="SgTypographyTransform.Uppercase" Tracking="SgTypographyTracking.Wide" Color="var(--sg-text-muted)" Style="margin-bottom:8px;display:block;">
                                SgModalPosition
                            </SgTypography>
                            <PropertyTable Items="_posEnum" />
                        </div>
                    </SgStack>
                </SgCard>
            </SgCol>
        </SgRow>
    </div>

</ChildContent>
</SgCard>

@* ── Modal Instances ─────────────────────────────────────────────────────── *@

<!-- Basic Modal -->
<SgModal @bind-Visible="@_showBasic" Title="Basic Modal"
         Animation="SgModalAnimation.Scale"
         OnOpened="@(() => _lastEvent = "Modal opened!")">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md">
            <SgTypography>
                This is a basic modal with default settings.
            </SgTypography>
            <SgAlert Variant="SgAlertVariant.Info" Text="You can place any content here." />
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)">
                Last event: @_lastEvent
            </SgTypography>
        </SgStack>
    </ChildContent>
    <FooterContent>
        <SgButton Text="Close" OnClick="@(() => _showBasic = false)" />
    </FooterContent>
</SgModal>

<!-- Form Modal -->
<SgModal @bind-Visible="@_showForm" Title="Form Modal"
         Animation="SgModalAnimation.SlideUp" Size="SgModalSize.Lg"
         Icon="@SgHeroicons.Outline.DocumentText">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md">
            <SgTypography>Fill in the details below:</SgTypography>
            <SgRow Space="SgSize.Md">
                <SgCol Span="6">
                    <SgTextBox TValue="string" @bind-Value="@_formName" Label="Name" Placeholder="Enter name" />
                </SgCol>
                <SgCol Span="6">
                    <SgTextBox TValue="string" @bind-Value="@_formEmail" Label="Email" Placeholder="Enter email" Type="email" />
                </SgCol>
            </SgRow>
            <SgSelect TValue="string" @bind-Value="@_formRole" Items="@_roles" Label="Role" Placeholder="Select role..." />
        </SgStack>
    </ChildContent>
    <FooterContent>
        <SgButton Text="Save" Variant="SgButtonVariant.Primary" OnClick="SaveForm" />
        <SgButton Text="Cancel" OnClick="@(() => _showForm = false)" />
    </FooterContent>
</SgModal>

<!-- Confirm Delete Modal -->
<SgModal @bind-Visible="@_showConfirm" Title="Confirm Deletion"
         Animation="SgModalAnimation.Zoom">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
            <SgIcon Icon="@SgHeroicons.Outline.ExclamationTriangle" Size="48px" Color="var(--sg-color-danger)" />
            <SgTypography Variant="SgTypographyVariant.Heading6" Align="SgTypographyAlign.Center">
                Are you sure?
            </SgTypography>
            <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" Align="SgTypographyAlign.Center">
                This action cannot be undone.
            </SgTypography>
        </SgStack>
    </ChildContent>
    <FooterContent>
        <SgButton Text="Delete" Variant="SgButtonVariant.Danger" OnClick="ConfirmDelete" />
        <SgButton Text="Cancel" OnClick="@(() => _showConfirm = false)" />
    </FooterContent>
</SgModal>

<!-- FullScreen Modal -->
<SgModal @bind-Visible="@_showFullscreen" Title="Full Screen Modal"
         FullScreen="true" Animation="SgModalAnimation.Fade">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Lg" Align="SgAlignItems.Center" Style="padding:40px;text-align:center;">
            <SgIcon Icon="@SgHeroicons.Outline.ArrowsPointingOut" Size="64px" Color="var(--sg-primary)" />
            <SgTypography Variant="SgTypographyVariant.Heading3" Weight="SgTypographyWeight.Bold">
                Full Screen Mode
            </SgTypography>
            <SgTypography Size="SgTypographySize.Lg" Color="var(--sg-text-muted)" Style="max-width:600px;">
                Perfect for immersive experiences.
            </SgTypography>
            <SgButton Text="Close" Variant="SgButtonVariant.Primary" OnClick="@(() => _showFullscreen = false)" />
        </SgStack>
    </ChildContent>
</SgModal>

@* ── Size Modals ────────────────────────────────────────────────────────── *@
<SgModal @bind-Visible="@_showSize" Title="@("Size: " + _activeSizeLabel)"
         Size="@_activeSize" Animation="SgModalAnimation.Scale">
    <ChildContent>
        <SgTypography>This modal uses <SgTypography As="SgTypographyElement.Code">Size="@_activeSizeLabel"</SgTypography>.</SgTypography>
    </ChildContent>
    <FooterContent>
        <SgButton Text="Close" OnClick="@(() => _showSize = false)" />
    </FooterContent>
</SgModal>

@* ── Animation Modals ───────────────────────────────────────────────────── *@
<SgModal @bind-Visible="@_showAnim" Title="@("Animation: " + _activeAnimLabel)"
         Animation="@_activeAnim" Size="SgModalSize.Sm">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
            <SgIcon Icon="@SgHeroicons.Outline.Play" Size="40px" Color="var(--sg-primary)" />
            <SgTypography>Animation: <SgTypography As="SgTypographyElement.Code">@_activeAnimLabel</SgTypography></SgTypography>
        </SgStack>
    </ChildContent>
    <FooterContent>
        <SgButton Text="Close" OnClick="@(() => _showAnim = false)" />
    </FooterContent>
</SgModal>

@* ── Position Modals ────────────────────────────────────────────────────── *@
<SgModal @bind-Visible="@_showPos" Title="@("Position: " + _activePosLabel)"
         Position="@_activePos" Size="SgModalSize.Sm"
         Animation="SgModalAnimation.SlideUp">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
            <SgIcon Icon="@SgHeroicons.Outline.MapPin" Size="40px" Color="var(--sg-primary)" />
            <SgTypography>Position: <SgTypography As="SgTypographyElement.Code">@_activePosLabel</SgTypography></SgTypography>
        </SgStack>
    </ChildContent>
    <FooterContent>
        <SgButton Text="Close" OnClick="@(() => _showPos = false)" />
    </FooterContent>
</SgModal>

@* ── Draggable Modal ────────────────────────────────────────────────────── *@
<SgModal @bind-Visible="@_showDraggable" Title="Draggable Modal"
         Draggable="true" Animation="SgModalAnimation.Scale" Size="SgModalSize.Sm">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
            <SgIcon Icon="@SgHeroicons.Outline.ArrowsPointingOut" Size="40px" Color="var(--sg-primary)" />
            <SgTypography>Drag the header to move this modal.</SgTypography>
        </SgStack>
    </ChildContent>
    <FooterContent>
        <SgButton Text="Close" OnClick="@(() => _showDraggable = false)" />
    </FooterContent>
</SgModal>

@* ── Glass Modal ────────────────────────────────────────────────────────── *@
<SgModal @bind-Visible="@_showGlass" Title="Glass Modal"
         Glass="true" Size="SgModalSize.Sm" Animation="SgModalAnimation.Fade">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
            <SgIcon Icon="@SgHeroicons.Outline.Sparkles" Size="40px" Color="var(--sg-primary)" />
            <SgTypography>Glassmorphism effect with backdrop blur.</SgTypography>
        </SgStack>
    </ChildContent>
    <FooterContent>
        <SgButton Text="Close" OnClick="@(() => _showGlass = false)" />
    </FooterContent>
</SgModal>

@* ── No Padding Modal ───────────────────────────────────────────────────── *@
<SgModal @bind-Visible="@_showNoPad" Title="No Padding"
         NoPadding="true" Size="SgModalSize.Sm" Animation="SgModalAnimation.SlideUp">
    <ChildContent>
        <div style="background:linear-gradient(135deg,var(--sg-primary),#8b5cf6);padding:40px;text-align:center;color:#fff;">
            <SgTypography Variant="SgTypographyVariant.Heading4" Weight="SgTypographyWeight.Bold" Color="#fff">
                Edge-to-Edge Content
            </SgTypography>
            <SgTypography Color="rgba(255,255,255,0.8)">
                Perfect for hero images and banners.
            </SgTypography>
        </div>
    </ChildContent>
    <FooterContent>
        <SgButton Text="Close" OnClick="@(() => _showNoPad = false)" />
    </FooterContent>
</SgModal>

@* ── Combo Modal ────────────────────────────────────────────────────────── *@
<SgModal @bind-Visible="@_showCombo" Title="@($"Combo: {_comboAnimLabel} + {_comboSizeLabel}")"
         Animation="@_comboAnim" Size="@_comboSize">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
            <SgIcon Icon="@SgHeroicons.Outline.Beaker" Size="40px" Color="var(--sg-primary)" />
            <SgTypography>
                <SgTypography As="SgTypographyElement.Code">Animation=@_comboAnimLabel</SgTypography> +
                <SgTypography As="SgTypographyElement.Code">Size=@_comboSizeLabel</SgTypography>
            </SgTypography>
        </SgStack>
    </ChildContent>
    <FooterContent>
        <SgButton Text="Close" OnClick="@(() => _showCombo = false)" />
    </FooterContent>
</SgModal>

@* ── Constructor Modal ──────────────────────────────────────────────────── *@
<SgModal @bind-Visible="@_showConstructor" Title="Constructor Result"
         Size="@_cSize" Animation="@_cAnim" Position="@_cPos"
         Draggable="@_cDrag" FullScreen="@_cFull"
         ShowClose="@_cShowClose" CloseOnEscape="@_cEsc"
         OnOpened="@(() => _constructorOpened = true)">
    <ChildContent>
        <SgStack Vertical Space="SgSize.Md" Align="SgAlignItems.Center">
            <SgIcon Icon="@SgHeroicons.Outline.Cog6Tooth" Size="40px" Color="var(--sg-primary)" />
            <SgTypography>Built from the constructor settings above.</SgTypography>
            <SgCard Size="SgSize.Sm" Shadow="SgShadow.Sm" NoPadding="true">
                <div style="padding:12px;font-size:12px;line-height:2;background:var(--sg-surface-alt);border-radius:6px;font-family:monospace;">
                    <div>Size: @_cSize</div>
                    <div>Animation: @_cAnim</div>
                    <div>Position: @_cPos</div>
                    <div>Draggable: @_cDrag</div>
                    <div>FullScreen: @_cFull</div>
                    <div>ShowClose: @_cShowClose</div>
                    <div>CloseOnEscape: @_cEsc</div>
                </div>
            </SgCard>
        </SgStack>
    </ChildContent>
    <FooterContent>
        <SgButton Text="Close" OnClick="@(() => _showConstructor = false)" />
    </FooterContent>
</SgModal>

