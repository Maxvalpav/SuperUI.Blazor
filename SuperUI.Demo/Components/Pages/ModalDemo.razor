@page "/demo/modal"
@using SuperUI.Demo.Components

<div class="demo-page">
    <div class="demo-hero">
        <section class="demo-hero-main">
            <div class="demo-header">
                <div class="demo-kicker">Feedback & Overlay</div>
                <h1 class="demo-title">SgModal</h1>
                <p class="demo-subtitle">
                    Overlay windows for confirmations, complex forms, or detailed information. Features 
                    animations, z-index management, and draggable headers.
                </p>
            </div>
        </section>

        <aside class="demo-hero-side">
            <div class="demo-side-title">Highlights</div>
            <div class="demo-pill-list">
                <span class="demo-pill demo-pill-accent">Draggable</span>
                <span class="demo-pill">Animations</span>
                <span class="demo-pill">Esc Close</span>
                <span class="demo-pill">Footer Support</span>
            </div>
        </aside>
    </div>

    <SgDemoSection Eyebrow="Usage" Title="Examples">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Basic Dialog</h3>
                    <p class="demo-showcase-desc">Standard modal with header, body and footer.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgButton OnClick="() => _showBasic = true">Open Basic Modal</SgButton>
                        <SgModal @bind-Visible="_showBasic" Title="Welcome">
                            <ChildContent>
                                <p>This is a basic modal dialog. It can contain any HTML content or Blazor components.</p>
                            </ChildContent>
                            <FooterContent>
                                <SgButton Variant="SgButtonVariant.Ghost" OnClick="() => _showBasic = false">Cancel</SgButton>
                                <SgButton OnClick="() => _showBasic = false">Confirm</SgButton>
                            </FooterContent>
                        </SgModal>
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Advanced Features</h3>
                    <p class="demo-showcase-desc">Draggable modal with custom animation and width.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgButton Variant="SgButtonVariant.Default" OnClick="() => _showAdv = true">Open Draggable Modal</SgButton>
                        <SgModal @bind-Visible="_showAdv" 
                                 Title="Settings" 
                                 Draggable="true" 
                                 Width="600px"
                                 Animation="SgModalAnimation.Slide">
                            <ChildContent>
                                <div class="demo-stack">
                                    <SgTextBox TValue="string" Label="Username" Value="@("admin")" />
                                    <SgSwitch Label="Enable notifications" Value="true" />
                                    <p style="font-size:12px; color:var(--sui-text-secondary);">
                                        Try dragging this modal by its header!
                                    </p>
                                </div>
                            </ChildContent>
                            <FooterContent>
                                <SgButton OnClick="() => _showAdv = false">Save Changes</SgButton>
                            </FooterContent>
                        </SgModal>
                    </div>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoParams Title="Modal Parameters">
        <SgDemoParam Name="Visible" Type="bool" Description="Controls modal visibility (two-way bindable)." DefaultValue="false" />
        <SgDemoParam Name="Title" Type="string" Description="Text shown in the header." />
        <SgDemoParam Name="Draggable" Type="bool" Description="Allows moving the modal by dragging the header." DefaultValue="false" />
        <SgDemoParam Name="Animation" Type="SgModalAnimation" Description="Transition effect when opening/closing." Values="Scale, Fade, Slide" DefaultValue="Scale" />
        <SgDemoParam Name="Width" Type="string" Description="Custom CSS width (e.g. 500px, 80%)." />
        <SgDemoParam Name="ShowClose" Type="bool" Description="Display the 'X' button in header." DefaultValue="true" />
        <SgDemoParam Name="CloseOnBackdrop" Type="bool" Description="Close when clicking outside the modal." DefaultValue="true" />
    </SgDemoParams>
</div>

@code {
    private bool _showBasic;
    private bool _showAdv;
}
