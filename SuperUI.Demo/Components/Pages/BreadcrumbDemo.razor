@page "/demo/breadcrumb"
@using SuperUI.Demo.Components

<div class="demo-page">
    <div class="demo-hero">
        <section class="demo-hero-main">
            <div class="demo-header">
                <div class="demo-kicker">Navigation Components</div>
                <h1 class="demo-title">SgBreadcrumb</h1>
                <p class="demo-subtitle">
                    Help users track their location within the application's hierarchy. Supports auto-generation 
                    from URLs and custom path definitions.
                </p>
            </div>
        </section>

        <aside class="demo-hero-side">
            <div class="demo-side-title">Highlights</div>
            <div class="demo-pill-list">
                <span class="demo-pill demo-pill-accent">Auto-Generate</span>
                <span class="demo-pill">Custom Sep</span>
                <span class="demo-pill">SSR Friendly</span>
                <span class="demo-pill">ARIA Support</span>
            </div>
        </aside>
    </div>

    <SgDemoSection Eyebrow="Usage" Title="Examples">
        <div class="demo-showcase-grid">
            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Auto Generation</h3>
                    <p class="demo-showcase-desc">Derived automatically from the current browser URI.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgBreadcrumb AutoGenerate="true" />
                    </div>
                </div>
            </div>

            <div class="demo-showcase-card">
                <div class="demo-showcase-header">
                    <h3 class="demo-showcase-title">Manual Definition</h3>
                    <p class="demo-showcase-desc">Explicitly defined path with custom separator.</p>
                </div>
                <div class="demo-preview">
                    <div class="demo-preview-surface">
                        <SgBreadcrumb Items="_manualItems" Separator=">" />
                    </div>
                </div>
            </div>
        </div>
    </SgDemoSection>

    <SgDemoParams Title="Breadcrumb Parameters">
        <SgDemoParam Name="Items" Type="IEnumerable<BreadcrumbItem>" Description="Custom list of items to display." />
        <SgDemoParam Name="AutoGenerate" Type="bool" Description="Generate path from current URL automatically." DefaultValue="true" />
        <SgDemoParam Name="Separator" Type="string" Description="Separator between items." DefaultValue="/" />
        <SgDemoParam Name="CssClass" Type="string" Description="Additional CSS classes." />
    </SgDemoParams>
</div>

@code {
    private List<BreadcrumbItem> _manualItems = new()
    {
        new BreadcrumbItem("Home", "/"),
        new BreadcrumbItem("Store", "/store"),
        new BreadcrumbItem("Electronics", "/store/electronics"),
        new BreadcrumbItem("Laptops", "/store/electronics/laptops")
    };
}
