@page "/leaflet-demo"
@using SuperUI.Components

<PageTitle>Leaflet.js — SUI</PageTitle>
<SgSeoHead Description="Explore Leaflet.js — SuperUI Blazor component library demo with live examples, code snippets, and API documentation." />

<div class="lf-page">

    <!-- ── Шапка ──────────────────────────────────────────────────────── -->
    <div class="lf-header">
        <div>
            <h1 class="lf-title">SgLeaflet</h1>
            <p class="lf-subtitle">Leaflet.js — карты, маркеры, маршруты, полигоны, круги</p>
        </div>
        <div class="lf-header-right">
            <span class="lf-label">Слой:</span>
            @foreach (var tl in _tileLayers)
            {
                var ttl = tl;
                <SgButton Size="SgSize.Sm"
                          Variant="@(_tileLayer == ttl.Key ? SgButtonVariant.Primary : SgButtonVariant.Default)"
                          OnClick="@(() => ChangeTileLayer(ttl.Key))">
                    @ttl.Value
                </SgButton>
            }
            <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="FitMarkers">⛶ Вписать</SgButton>
            <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="ExportPng">⬇ PNG</SgButton>
        </div>
    </div>

    <!-- ── Основная область ────────────────────────────────────────────── -->
    <div class="lf-main">

        <!-- Карта -->
        <div class="lf-canvas">
            <SgLeaflet @ref="_map"
                       Options="@CurrentOpts"
                       Markers="@_markers"
                       Polylines="@(_showRoute ? _routePolylines : null)"
                       Polygons="@(_showZone ? _zonePolygons : null)"
                       Circles="@(_showCircles ? _circles : null)"
                       Height="100%"
                       OnMarkerClick="OnMarkerClick"
                       OnMapClick="OnMapClick"
                       OnViewChanged="OnViewChanged" />
        </div>

        <!-- Боковая панель -->
        <div class="lf-sidebar">

            <!-- Вид карты -->
            <SgCard Title="Вид карты" style="margin-bottom:12px">
                <div class="lf-stat-grid">
                    <div class="lf-stat"><span>Широта</span><b>@_viewLat.ToString("F4")</b></div>
                    <div class="lf-stat"><span>Долгота</span><b>@_viewLon.ToString("F4")</b></div>
                    <div class="lf-stat"><span>Зум</span><b>@_viewZoom.ToString("F1")</b></div>
                    <div class="lf-stat"><span>Маркеров</span><b>@_markers.Count</b></div>
                </div>
            </SgCard>

            <!-- Маршрут A → B -->
            <SgCard Title="Маршрут A → B" style="margin-bottom:12px">
                <div class="lf-route-row">
                    <span class="lf-route-badge lf-route-a">A</span>
                    <SgCoordinateInput @bind-Latitude="_routeFromLat"
                                       @bind-Longitude="_routeFromLon"
                                       ShowCopyButton="false"
                                       CssClass="lf-route-coord" />
                </div>
                <div class="lf-route-row" style="margin-top:6px">
                    <span class="lf-route-badge lf-route-b">B</span>
                    <SgCoordinateInput @bind-Latitude="_routeToLat"
                                       @bind-Longitude="_routeToLon"
                                       ShowCopyButton="false"
                                       CssClass="lf-route-coord" />
                </div>

                <div class="lf-route-presets">
                    <span class="lf-label">Пресеты:</span>
                    @foreach (var p in _routePresets)
                    {
                        var pp = p;
                        <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined"
                                  OnClick="@(() => ApplyPreset(pp))">@pp.Name</SgButton>
                    }
                </div>

                <div class="lf-route-style">
                    <span class="lf-label">Цвет:</span>
                    @foreach (var c in _routeColors)
                    {
                        var cc = c;
                        <button class="lf-color-dot @(_routeColor == cc.Hex ? "active" : "")"
                                style="background:@cc.Hex" title="@cc.Name"
                                @onclick="@(() => _routeColor = cc.Hex)"></button>
                    }
                    <SgSwitch @bind-Value="_routeDashed" Label="Пунктир" />
                </div>

                <div style="display:flex;gap:6px;margin-top:10px">
                    <SgButton Variant="SgButtonVariant.Primary"
                              Disabled="@_routeLoading"
                              Loading="@_routeLoading"
                              OnClick="DrawRoute"
                              Block="true">
                        🗺️ Построить маршрут
                    </SgButton>
                    @if (_routeDrawn)
                    {
                        <SgButton Variant="SgButtonVariant.Danger" OnClick="ClearRoute">✕</SgButton>
                    }
                </div>

                <div style="margin-top:6px">
                    <SgSwitch @bind-Value="_routeAlternatives" Label="Альтернативы" />
                </div>

                @if (_routeResult is not null)
                {
                    @if (_routeResult.Ok && _routeResult.Best is not null)
                    {
                        <div class="lf-route-result">
                            <div class="lf-route-stat">
                                <span>📏</span><b>@_routeResult.DistanceFormatted</b>
                            </div>
                            @if (_routeResult.DurationMin.HasValue)
                            {
                                <div class="lf-route-stat">
                                    <span>⏱</span><b>@_routeResult.DurationFormatted</b>
                                </div>
                            }
                        </div>
                        @if (_routeResult.Straight)
                        {
                            <SgAlert Variant="SgAlertVariant.Warn" Dense="true" style="margin-top:6px"
                                     Text="Прямая линия (GraphHopper недоступен)" />
                        }
                        @if (_routeResult.Routes.Count > 1)
                        {
                            <div style="margin-top:6px;font-size:11px;color:var(--sui-text-secondary)">
                                @_routeResult.Routes.Count вариантов маршрута
                            </div>
                        }
                        @if (_routeResult.Best?.Steps.Count > 0)
                        {
                            <div class="lf-steps">
                                @foreach (var s in _routeResult.Best.Steps.Take(6))
                                {
                                    <div class="lf-step-row">
                                        <span class="lf-step-text">@s.Instruction</span>
                                        <span class="lf-step-dist">@s.Distance</span>
                                    </div>
                                }
                                @if (_routeResult.Best.Steps.Count > 6)
                                {
                                    <div style="font-size:10px;color:var(--sui-text-secondary);text-align:center;padding:3px">
                                        +@(_routeResult.Best.Steps.Count - 6) шагов
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (!string.IsNullOrEmpty(_routeResult.Error))
                    {
                        <SgAlert Variant="SgAlertVariant.Danger" Dense="true" style="margin-top:6px"
                                 Text="@_routeResult.Error" />
                    }
                }
            </SgCard>

            <!-- Маркеры -->
            <SgCard Title="Маркеры" style="margin-bottom:12px">
                <div class="lf-hint">💡 Кликните на карту чтобы добавить маркер</div>
                <div style="display:flex;gap:6px;margin-bottom:10px">
                    <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Primary"
                              OnClick="AddRandomMarker" Block="true">+ Случайный</SgButton>
                    <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Danger"
                              Disabled="@(_markers.Count == 0)"
                              OnClick="ClearMarkers">✕ Все</SgButton>
                </div>

                <div class="lf-marker-list">
                    @foreach (var m in _markers.Take(8))
                    {
                        var mm = m;
                        <div class="lf-marker-row @(_selectedMarkerId == mm.Id ? "selected" : "")"
                             @onclick="@(() => SelectMarker(mm))">
                            <span class="lf-marker-icon" style="background:@(mm.Color ?? "#006fee")">@(mm.Icon ?? "📍")</span>
                            <div class="lf-marker-info">
                                <span class="lf-marker-name">@mm.Title</span>
                                <span class="lf-marker-coords">@mm.Latitude.ToString("F3"), @mm.Longitude.ToString("F3")</span>
                            </div>
                            <button class="lf-marker-del" @onclick:stopPropagation="true"
                                    @onclick="@(() => RemoveMarker(mm.Id))">✕</button>
                        </div>
                    }
                    @if (_markers.Count > 8)
                    {
                        <div class="lf-marker-more">+@(_markers.Count - 8) ещё</div>
                    }
                </div>
            </SgCard>

            <!-- Слои -->
            <SgCard Title="Слои" style="margin-bottom:12px">
                <div style="display:flex;flex-direction:column;gap:8px">
                    <SgSwitch @bind-Value="_showRoute"   Label="Маршрут (полилиния)"
                              @bind-Value:after="StateHasChanged" />
                    <SgSwitch @bind-Value="_showZone"    Label="Зона (полигон)"
                              @bind-Value:after="StateHasChanged" />
                    <SgSwitch @bind-Value="_showCircles" Label="Круги"
                              @bind-Value:after="StateHasChanged" />
                </div>
            </SgCard>

            <!-- Выбранный маркер / клик на карту -->
            @if (_selectedMarker is not null)
            {
                <SgCard Title="Выбранный маркер" style="margin-bottom:12px">
                    <SgCoordinateInput Latitude="@_selectedMarker.Latitude"
                                       Longitude="@_selectedMarker.Longitude"
                                       ShowClearButton="false"
                                       ShowDms="true"
                                       Disabled="true" />
                    <div style="margin-top:6px;font-size:12px;font-weight:500;color:var(--sui-text-primary)">
                        @_selectedMarker.Title
                    </div>
                    @if (!string.IsNullOrEmpty(_selectedMarker.Description))
                    {
                        <div style="font-size:11px;color:var(--sui-text-secondary);margin-top:2px">
                            @_selectedMarker.Description
                        </div>
                    }
                    <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Outlined"
                              OnClick="@(() => SelectMarker(_selectedMarker))"
                              style="margin-top:8px">
                        🎯 Центрировать
                    </SgButton>
                </SgCard>
            }
            else if (_lastMapClick is not null)
            {
                <SgCard Title="Клик на карте" style="margin-bottom:12px">
                    <SgCoordinateInput Latitude="@_lastMapClick.Latitude"
                                       Longitude="@_lastMapClick.Longitude"
                                       ShowClearButton="false"
                                       ShowDms="true"
                                       Disabled="true" />
                    <SgButton Size="SgSize.Sm" Variant="SgButtonVariant.Primary"
                              OnClick="AddMarkerAtClick"
                              style="margin-top:8px" Block="true">
                        + Маркер здесь
                    </SgButton>
                </SgCard>
            }

        </div>
    </div>
</div>

@code {
    private static readonly Random _rnd = new(Environment.TickCount);

    private SgLeaflet? _map;
    private SgLeafletTileLayer _tileLayer = SgLeafletTileLayer.OpenStreetMap;
    private double _viewLat = 55.751, _viewLon = 37.618, _viewZoom = 10;
    private string? _selectedMarkerId;
    private SgLeafletMarker? _selectedMarker;
    private SgLeafletClickEventArgs? _lastMapClick;
    private bool _showRoute   = true;
    private bool _showZone    = true;
    private bool _showCircles = true;

    // ── Route ─────────────────────────────────────────────────────────────────
    private double? _routeFromLat = 55.7520;
    private double? _routeFromLon = 37.6173;
    private double? _routeToLat   = 55.9726;
    private double? _routeToLon   = 37.4146;
    private string  _routeColor  = "#2563eb";
    private bool    _routeDashed = false;
    private bool    _routeDrawn  = false;
    private bool    _routeLoading = false;
    private bool    _routeAlternatives = true;
    private SgLeafletRouteResult? _routeResult;

    private bool CanDrawRoute => true;

    private record RoutePreset(string Name, double FromLat, double FromLon, double ToLat, double ToLon);
    private readonly RoutePreset[] _routePresets =
    [
        new("Кремль→Арбат",   55.7520, 37.6173, 55.7490, 37.5960),
        new("Центр→Аэропорт", 55.7520, 37.6173, 55.9726, 37.4146),
        new("Москва→СПб",     55.7520, 37.6173, 59.9343, 30.3351),
    ];

    private record RouteColor(string Name, string Hex);
    private readonly RouteColor[] _routeColors =
    [
        new("Синий",      "#2563eb"),
        new("Красный",    "#dc2626"),
        new("Зелёный",    "#16a34a"),
        new("Оранжевый",  "#ea580c"),
        new("Фиолетовый", "#7c3aed"),
    ];

    private readonly Dictionary<SgLeafletTileLayer, string> _tileLayers = new()
    {
        [SgLeafletTileLayer.OpenStreetMap]    = "OSM",
        [SgLeafletTileLayer.CartoDB_Positron] = "Carto Light",
        [SgLeafletTileLayer.CartoDB_DarkMatter] = "Carto Dark",
        [SgLeafletTileLayer.Esri_WorldImagery]  = "Satellite",
        [SgLeafletTileLayer.Stamen_Toner]       = "Toner",
    };

    private SgLeafletOptions CurrentOpts => new()
    {
        TileLayer        = _tileLayer,
        CenterLat        = 55.751,
        CenterLon        = 37.618,
        Zoom             = 10,
        ShowZoomControl  = true,
        ShowScaleControl = true,
        ShowAttribution  = true,
        ShowPopup        = true,
    };

    // ── Markers ───────────────────────────────────────────────────────────────
    private List<SgLeafletMarker> _markers = new()
    {
        new() { Id="m1", Title="Кремль",          Description="Исторический центр",   Longitude=37.6173, Latitude=55.7520, Color="#ef4444", Icon="🏛️", Size=36 },
        new() { Id="m2", Title="Красная площадь", Description="Главная площадь",      Longitude=37.6208, Latitude=55.7539, Color="#f59e0b", Icon="⭐",  Size=34 },
        new() { Id="m3", Title="Большой театр",   Description="Театр оперы и балета", Longitude=37.6155, Latitude=55.7601, Color="#8b5cf6", Icon="🎭", Size=34 },
        new() { Id="m4", Title="Парк Горького",   Description="Центральный парк",     Longitude=37.6010, Latitude=55.7298, Color="#10b981", Icon="🌳", Size=34 },
        new() { Id="m5", Title="Арбат",           Description="Пешеходная улица",     Longitude=37.5960, Latitude=55.7490, Color="#2563eb", Icon="🚶", Size=32 },
    };

    // ── Polylines ─────────────────────────────────────────────────────────────
    private readonly List<SgLeafletPolyline> _routePolylines = new()
    {
        new() { Id="route1", Color="#2563eb", Width=4,
            Coordinates = [
                new() { Longitude=37.6173, Latitude=55.7520 },
                new() { Longitude=37.6208, Latitude=55.7539 },
                new() { Longitude=37.6155, Latitude=55.7601 },
                new() { Longitude=37.6010, Latitude=55.7298 },
                new() { Longitude=37.5960, Latitude=55.7490 },
            ]},
    };

    // ── Polygons ──────────────────────────────────────────────────────────────
    private readonly List<SgLeafletPolygon> _zonePolygons = new()
    {
        new() { Id="zone1", Title="Центральный район",
            FillColor="#dcfce7", StrokeColor="#16a34a", StrokeWidth=2,
            Coordinates = [
                new() { Longitude=37.580, Latitude=55.770 },
                new() { Longitude=37.660, Latitude=55.770 },
                new() { Longitude=37.660, Latitude=55.730 },
                new() { Longitude=37.580, Latitude=55.730 },
                new() { Longitude=37.580, Latitude=55.770 },
            ]},
    };

    // ── Circles ───────────────────────────────────────────────────────────────
    private readonly List<SgLeafletCircle> _circles = new()
    {
        new() { Id="c1", Title="Зона Кремля",        Latitude=55.7520, Longitude=37.6173, Radius=300,  Color="#ef4444", FillColor="rgba(239,68,68,0.12)" },
        new() { Id="c2", Title="Зона Большого театра",Latitude=55.7601, Longitude=37.6155, Radius=200,  Color="#8b5cf6", FillColor="rgba(139,92,246,0.12)" },
        new() { Id="c3", Title="Зона Парка Горького", Latitude=55.7298, Longitude=37.6010, Radius=400,  Color="#10b981", FillColor="rgba(16,185,129,0.12)" },
    };

    // ── Random marker data ────────────────────────────────────────────────────
    private static readonly string[] _names  = ["Офис","Склад","Магазин","Ресторан","Отель","Парк","Музей","Театр","Стадион","Аэропорт","Вокзал","Больница"];
    private static readonly string[] _icons  = ["🏢","📦","🏪","🍽️","🏨","🌳","🏛️","🎭","⚽","✈️","🚂","🏥"];
    private static readonly string[] _colors = ["#ef4444","#f59e0b","#10b981","#2563eb","#8b5cf6","#06b6d4","#ec4899","#f97316"];

    // ── Actions ───────────────────────────────────────────────────────────────

    private async Task ChangeTileLayer(SgLeafletTileLayer tl)
    {
        _tileLayer = tl;
        if (_map is not null)
            await _map.SetTileLayerAsync(tl);
        StateHasChanged();
    }

    private void AddRandomMarker()
    {
        var i = _rnd.Next(_names.Length);
        _markers = [.._markers, new()
        {
            Id          = $"m{DateTime.Now.Ticks}",
            Title       = _names[i],
            Description = $"Точка #{_markers.Count + 1}",
            Longitude   = 37.4 + _rnd.NextDouble() * 0.5,
            Latitude    = 55.6 + _rnd.NextDouble() * 0.3,
            Color       = _colors[i % _colors.Length],
            Icon        = _icons[i],
            Size        = 32,
        }];
        StateHasChanged();
    }

    private void ClearMarkers()
    {
        _markers = new(); _selectedMarkerId = null; StateHasChanged();
    }

    private void RemoveMarker(string id)
    {
        _markers = _markers.Where(m => m.Id != id).ToList();
        if (_selectedMarkerId == id) _selectedMarkerId = null;
        StateHasChanged();
    }

    private async Task SelectMarker(SgLeafletMarker m)
    {
        _selectedMarkerId = m.Id;
        _selectedMarker   = m;
        _lastMapClick     = null;
        if (_map is not null) await _map.SetCenterAsync(m.Latitude, m.Longitude, 14);
        StateHasChanged();
    }

    private void AddMarkerAtClick()
    {
        if (_lastMapClick is null) return;
        var i = _rnd.Next(_names.Length);
        _markers = [.._markers, new()
        {
            Id        = $"click-{DateTime.Now.Ticks}",
            Title     = $"Точка {_markers.Count + 1}",
            Longitude = _lastMapClick.Longitude,
            Latitude  = _lastMapClick.Latitude,
            Color     = "#2563eb", Icon = "📌", Size = 32,
        }];
        _lastMapClick = null;
        StateHasChanged();
    }

    private async Task FitMarkers()  { if (_map is not null) await _map.FitToMarkersAsync(); }
    private async Task ExportPng()   { if (_map is not null) await _map.ExportPngAsync(); }

    // ── Route ─────────────────────────────────────────────────────────────────
    private void ApplyPreset(RoutePreset p)
    {
        _routeFromLat = p.FromLat; _routeFromLon = p.FromLon;
        _routeToLat   = p.ToLat;   _routeToLon   = p.ToLon;
        StateHasChanged();
    }

    private async Task DrawRoute()
    {
        if (_map is null) return;
        if (!_routeFromLat.HasValue || !_routeFromLon.HasValue || !_routeToLat.HasValue || !_routeToLon.HasValue)
        {
            _routeResult = new SgLeafletRouteResult { Ok = false, Error = "Введите координаты точек A и B" };
            StateHasChanged(); return;
        }
        _routeLoading = true; StateHasChanged();

        _routeResult = await _map.BuildRouteAsync(
            "main-route",
            _routeFromLat.Value, _routeFromLon.Value,
            _routeToLat.Value,   _routeToLon.Value,
            _routeColor, 5, _routeDashed, _routeAlternatives);

        _routeDrawn   = true;
        _routeLoading = false;
        StateHasChanged();
    }

    private async Task ClearRoute()
    {
        if (_map is null) return;
        await _map.ClearRouteAsync("main-route");
        _routeDrawn = false; _routeResult = null;
        StateHasChanged();
    }

    // ── Events ────────────────────────────────────────────────────────────────
    private void OnMarkerClick(SgLeafletMarkerClickEventArgs e)
    {
        _selectedMarkerId = e.MarkerId;
        _selectedMarker   = _markers.FirstOrDefault(m => m.Id == e.MarkerId);
        _lastMapClick     = null;
        StateHasChanged();
    }

    private void OnMapClick(SgLeafletClickEventArgs e)
    {
        _lastMapClick   = e;
        _selectedMarker = null;
        _selectedMarkerId = null;
        StateHasChanged();
    }

    private void OnViewChanged(SgLeafletViewChangedEventArgs e)
    {
        _viewLat = e.CenterLat; _viewLon = e.CenterLon; _viewZoom = e.Zoom;
        StateHasChanged();
    }
}
