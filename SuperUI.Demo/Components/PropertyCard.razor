@namespace SuperUI.Demo.Components

<div class="property-card @CssClass" style="@Style">
    @if (HeaderContent is not null || !string.IsNullOrEmpty(Title) || !string.IsNullOrEmpty(Subtitle))
    {
        <div class="property-card-header">
            @if (HeaderContent is not null)
            {
                @HeaderContent
            }
            else
            {
                <div style="display:flex; flex-direction:column; gap:2px;">
                    <span>@Title</span>
                    @if (!string.IsNullOrEmpty(Subtitle) )
                    {
                        <span style="font-size: 11px; font-weight: normal; color: var(--sui-muted);">@Subtitle</span>
                    }
                </div>
            }
        </div>
    }
    <div class="property-card-body">
        @ChildContent
    </div>
    @if (FooterContent is not null)
    {
        <div class="property-card-footer">
            @FooterContent
        </div>
    }
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? HeaderContent { get; set;  }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
}
