@namespace SuperUI.Demo.Components

<div class="property-card @CssClass" style="@Style">
    @if (HeaderContent is not null || !string.IsNullOrEmpty(Title) || !string.IsNullOrEmpty(Subtitle))
    {
        <div class="property-card-header">
            @if (HeaderContent is not null)
            {
                @HeaderContent
            }
            else
            {
                <div class="property-card-header-content">
                    @if (!string.IsNullOrEmpty(Title))
                    {
                        <SgTypography Weight="SgTypographyWeight.Semibold" Size="SgTypographySize.Sm" Color="var(--sg-fg)">
                            @Title
                        </SgTypography>
                    }
                    @if (!string.IsNullOrEmpty(Subtitle))
                    {
                        <SgTypography Size="SgTypographySize.Xs" Color="var(--sg-text-muted)">
                            @Subtitle
                        </SgTypography>
                    }
                </div>
            }
        </div>
    }
    <div class="property-card-body">
        @ChildContent
    </div>
    @if (FooterContent is not null)
    {
        <div class="property-card-footer">
            @FooterContent
        </div>
    }
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
}
