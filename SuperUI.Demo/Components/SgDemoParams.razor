@namespace SuperUI.Demo.Components

<section class="demo-doc-card demo-doc-params">
    <div class="demo-doc-card-header">
        <div>
            <h3 class="demo-doc-card-title">@Title</h3>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="demo-doc-card-desc">@Description</p>
            }
        </div>
    </div>

    <div class="demo-doc-table-wrap">
        <table class="demo-doc-table">
            <thead>
                <tr>
                    <th>Property</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th>Values</th>
                    <th>Default</th>
                </tr>
            </thead>
            <tbody>
                @ChildContent
            </tbody>
        </table>
    </div>
</section>

@code {
    [Parameter] public string Title { get; set; } = "Component Properties";
    [Parameter] public string? Description { get; set; } = "Core public parameters for this component.";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
