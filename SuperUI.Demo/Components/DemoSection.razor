@namespace SuperUI.Demo.Components

<div class="sgc-demo-section @CssClass" style="@Style">
    @if (!string.IsNullOrEmpty(Title) || !string.IsNullOrEmpty(Subtitle) || HeaderContent is not null)
    {
        <div class="sgc-demo-section-header">
            @if (HeaderContent is not null)
            {
                @HeaderContent
            }
            else
            {
                <div class="sgc-demo-section-header-content">
                    <div class="sgc-demo-section-title-row">
                        @if (!string.IsNullOrEmpty(Title))
                        {
                            <SgTypography Variant="SgTypographyVariant.Heading3" Weight="SgTypographyWeight.Semibold">
                                @Title
                            </SgTypography>
                        }
                        @if (!string.IsNullOrEmpty(BadgeText))
                        {
                            <SgBadge Text="@BadgeText" Variant="@BadgeVariant" Size="SgSize.Sm" />
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(Subtitle))
                    {
                        <SgTypography Size="SgTypographySize.Sm" Color="var(--sg-text-muted)" CssClass="sgc-demo-section-subtitle">
                            @Subtitle
                        </SgTypography>
                    }
                </div>
            }
        </div>
    }
    <div class="sgc-demo-section-body">
        @ChildContent
    </div>
    @if (FooterContent is not null)
    {
        <div class="sgc-demo-section-footer">
            @FooterContent
        </div>
    }
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? BadgeText { get; set; }
    [Parameter] public SgBadgeVariant BadgeVariant { get; set; } = SgBadgeVariant.Info;
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
}
