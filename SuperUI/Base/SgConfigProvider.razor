@* SuperUI/Base/SgConfigProvider.razor *@
@* 
    Провайдер конфигурации SuperUI.
    Оборачивает дочерние компоненты в каскадные параметры.
    
    Использование:
    <SgConfigProvider Theme="dark" Locale="ru-RU">
        <SgToastHost />
        @Body
    </SgConfigProvider>
*@
@using Microsoft.Extensions.Options
@inject IOptions<SgLibraryOptions> LibraryOptions

<CascadingValue Value="_config" IsFixed="false">
    <CascadingValue Value="_theme" IsFixed="false">
        @ChildContent
    </CascadingValue>
</CascadingValue>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string Theme   { get; set; } = "auto";
    [Parameter] public string Locale { get; set; } = "en-US";
    [Parameter] public bool   IsRtl   { get; set; } = false;
    [Parameter] public bool   AnimationsEnabled { get; set; } = true;
    [Parameter] public SgSize DefaultSize { get; set; } = SgSize.Md;
    [Parameter] public Dictionary<string, string>? ThemeVariables { get; set; }

    private SgConfigContext _config  = new();
    private SgThemeContext  _theme   = new();

    protected override void OnParametersSet()
    {
        var opts = LibraryOptions.Value;
        
        var isDark = Theme == "dark" ||
                     (Theme == "auto" && IsSystemDark());

        _config = new SgConfigContext
        {
            DefaultSize = DefaultSize,
            AnimationsEnabled = AnimationsEnabled && opts.AnimationsEnabled,
            AnimationDurationMs = opts.AnimationDurationMs,
            EnableAria = opts.EnableAria,
            Locale = !string.IsNullOrWhiteSpace(Locale) ? Locale : opts.Locale,
            BaseZIndex = opts.BaseZIndex,
            ZIndexStep = opts.ZIndexStep,
            CssPrefix = opts.CssPrefix
        };

        _theme = new SgThemeContext
        {
            Theme = isDark ? SgTheme.Dark : SgTheme.Light,
            IsRtl = IsRtl || opts.RightToLeft,
            Variables = ThemeVariables?.Count > 0 
                ? new Dictionary<string, string>(ThemeVariables, StringComparer.Ordinal)
                : new Dictionary<string, string>(opts.ThemeVariables, StringComparer.Ordinal)
        };
    }

    private static bool IsSystemDark()
    {
        // Определяется JS-стороной, здесь default
        return false;
    }
}
