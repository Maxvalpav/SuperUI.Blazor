@* SuperUI/Base/SgConfigProvider.razor *@
@* 
    Провайдер конфигурации SuperUI.
    Оборачивает дочерние компоненты в каскадные параметры.
    
    Использование:
    <SgConfigProvider Theme="dark" Culture="ru-RU">
        <SgToastHost />
        @Body
    </SgConfigProvider>
*@

<CascadingValue Value="_config" IsFixed="false">
    <CascadingValue Value="_theme" IsFixed="false">
        @ChildContent
    </CascadingValue>
</CascadingValue>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string Theme   { get; set; } = "auto";
    [Parameter] public string Culture { get; set; } = "en-US";
    [Parameter] public bool   Compact { get; set; } = false;
    [Parameter] public bool   IsRtl   { get; set; } = false;
    [Parameter] public bool   AnimationsEnabled { get; set; } = true;

    private SgConfigContext _config  = new();
    private SgThemeContext  _theme   = new();

    protected override void OnParametersSet()
    {
        var isDark = Theme == "dark" ||
                     (Theme == "auto" && IsSystemDark());

        _config = new SgConfigContext
        {
            Theme             = Theme,
            Culture           = Culture,
            IsRtl             = IsRtl,
            Compact           = Compact,
            AnimationsEnabled = AnimationsEnabled,
        };

        _theme = new SgThemeContext
        {
            ThemeName = isDark ? "dark" : "light",
            IsDark    = isDark,
        };
    }

    private static bool IsSystemDark()
    {
        // Определяется JS-стороной, здесь default
        return false;
    }
}
