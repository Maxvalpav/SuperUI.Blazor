@* SuperUI/Base/SgConfigProvider.razor *@
@namespace SuperUI.Base
@inherits ComponentBase
@implements IDisposable

<CascadingValue Value="Options" IsFixed="false">
    <div class="@CssClass" style="@StyleAttribute" @attributes="AdditionalAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    [Parameter] public SgLibraryOptions Options { get; set; } = new();
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string? StyleAttribute => GenerateStyleAttribute();
    private bool _disposed;

    protected override void OnInitialized()
    {
        // Ensure defaults
        Options.AnimationsEnabled = Options.AnimationsEnabled;
        Options.AnimationDurationMs = Options.AnimationDurationMs > 0 ? Options.AnimationDurationMs : 200;
        Options.EnableAria = Options.EnableAria;
        Options.Locale = Options.Locale ?? "en-US";
        Options.BaseZIndex = Options.BaseZIndex > 0 ? Options.BaseZIndex : 1000;
        Options.ZIndexStep = Options.ZIndexStep > 0 ? Options.ZIndexStep : 100;
        Options.CssPrefix = Options.CssPrefix ?? "sg-";
        Options.RightToLeft = Options.RightToLeft;
        Options.ThemeVariables ??= new Dictionary<string, string>();
    }

    private string? GenerateStyleAttribute()
    {
        var sb = new System.Text.StringBuilder();

        // Theme CSS variables
        foreach (var (key, value) in Options.ThemeVariables)
        {
            if (!string.IsNullOrEmpty(key))
                sb.Append("--sg-").Append(key).Append(':').Append(value).Append(';');
        }

        // Animation durations
        sb.Append("--sg-anim-duration:").Append(Options.AnimationDurationMs).Append("ms;");

        // Z-index bases
        sb.Append("--sg-z-base:").Append(Options.BaseZIndex).Append(';');
        sb.Append("--sg-z-step:").Append(Options.ZIndexStep).Append(';');

        // RTL
        if (Options.RightToLeft)
            sb.Append("direction:rtl;");

        return sb.Length > 0 ? sb.ToString() : null;
    }

    public void Dispose()
    {
        _disposed = true;
        GC.SuppressFinalize(this);
    }
}
