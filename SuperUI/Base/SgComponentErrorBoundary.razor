@using System.Threading.Tasks
@inherits Microsoft.AspNetCore.Components.Web.ErrorBoundary

@* Компонент Error Boundary для изоляции ошибок отдельного компонента *@

@if (_error is null)
{
    @ChildContent
}
else
{
    @if (FallbackContent is not null)
    {
        @FallbackContent(_error)
    }
    else
    {
        <div class="sg-error-boundary" role="alert">
            <div class="sg-error-boundary__message">
                ⚠️ Ошибка компонента: @_error.Message
            </div>
            <button class="sg-btn sg-btn--sm sg-btn--secondary"
                    type="button"
                    @onclick="ResetAsync">
                Повторить
            </button>
        </div>
    }
}

@code {
    [Parameter] public RenderFragment?             ChildContent    { get; set; }
    [Parameter] public RenderFragment<Exception>?  FallbackContent { get; set; }
    [Parameter] public EventCallback<Exception>    OnError         { get; set; }

    private Exception? _error;

    protected override void OnParametersSet()
    {
        // Сброс ошибки при смене параметров — позволяет восстановление извне
        _error = null;
    }

    /// <summary>
    /// ✅ ИСПРАВЛЕНИЕ CS0508:
    /// Было:   protected override async ValueTask OnErrorAsync(Exception exception)
    ///         → CS0508: возвращаемый тип должен быть Task
    /// Стало:  protected override async Task OnErrorAsync(Exception exception)
    ///
    /// В Blazor 8+ сигнатура ErrorBoundary.OnErrorAsync вернулась к Task (не ValueTask).
    /// Контракт: Microsoft.AspNetCore.Components.Web.ErrorBoundary.OnErrorAsync(Exception)
    /// </summary>
    protected override async Task OnErrorAsync(Exception exception)
    {
        _error = exception;

        // Уведомляем внешних подписчиков об ошибке
        if (OnError.HasDelegate)
            await OnError.InvokeAsync(exception);
    }

    private async Task ResetAsync()
    {
        _error = null;
        Recover(); // встроенный метод ErrorBoundary для сброса состояния
        await Task.CompletedTask;
    }
}
