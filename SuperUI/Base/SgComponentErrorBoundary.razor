@namespace SuperUI.Base
@inherits Microsoft.AspNetCore.Components.Web.ErrorBoundary

@if (CurrentException == null)
{
    @ChildContent
}
else
{
    <div class="sg-error-boundary @ErrorClass" role="alert" aria-live="assertive">
        <h3 class="sg-error-boundary__title">@ErrorTitle</h3>
        <p class="sg-error-boundary__description">@ErrorDescription</p>

        @if (ShowTechnicalDetails)
        {
            <details class="sg-error-boundary__details">
                <summary>Technical Details</summary>
                <pre class="sg-error-boundary__stacktrace">@CurrentException.ToString()</pre>
            </details>
        }

        @if (_retryCount < MaxRetryAttempts)
        {
            <button class="sg-error-boundary__retry-btn" 
                    @onclick="RecoverAsync" 
                    disabled="@_isRecovering">
                @(_isRecovering ? "Recovering..." : RetryText)
            </button>
            <span class="sg-error-boundary__attempts">Attempt @_retryCount of @MaxRetryAttempts</span>
        }
        else
        {
            <p class="sg-error-boundary__max-attempts">Maximum retry attempts reached. Please refresh the page.</p>
        }
    </div>
}
