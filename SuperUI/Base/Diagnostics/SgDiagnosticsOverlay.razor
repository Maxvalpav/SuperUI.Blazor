@* Встроенный профайлер компонента. В режиме разработки показывает overlay с метриками. *@
@using SuperUI.Base.Diagnostics
@inherits ComponentBase

@if (Diagnostics != null)
{
    <div class="sg-diagnostics-overlay" style="position: fixed; bottom: 10px; right: 10px; background: rgba(0,0,0,0.9); color: #0f0; padding: 8px 12px; border-radius: 4px; font-family: monospace; font-size: 11px; z-index: 99999;">
        <div><strong>@Diagnostics.ComponentId</strong></div>
        <div>Renders: @Diagnostics.RenderCount</div>
        <div>Avg: @Diagnostics.AverageRenderMs.ToString("F1")ms</div>
        <div>Last: @Diagnostics.LastRenderMs.ToString("F1")ms</div>
        <div>Params: @Diagnostics.ParameterChangeCount</div>
    </div>
}

@code {
    [Parameter] public string ComponentId { get; set; } = "";
    [Parameter] public ComponentDiagnostics? Diagnostics { get; set; }
}