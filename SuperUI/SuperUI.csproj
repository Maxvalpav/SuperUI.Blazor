<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Assembly Information -->
    <AssemblyName>SuperUI</AssemblyName>
    <RootNamespace>SuperUI</RootNamespace>
    
    <!-- NuGet Package Metadata -->
    <PackageId>SuperUI</PackageId>
    <Version>1.0.0</Version>
    <Authors>SuperUI Contributors</Authors>
    <Company>SuperUI</Company>
    <Product>SuperUI</Product>
    <Description>SuperUI — enterprise-ready Blazor component library with 86+ components including advanced data grid, forms, overlays, navigation, and layout components. Features full IntelliSense support, dark mode, localization (en-US, ru-RU), and WCAG 2.1 accessibility compliance.</Description>
    <PackageTags>blazor;blazor-components;ui;components;datagrid;forms;modal;drawer;tabs;enterprise;razor;wasm;server;dark-mode;accessibility;wcag</PackageTags>
    <PackageProjectUrl>https://github.com/Maxvalpav/SuperUI.Blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Maxvalpav/SuperUI.Blazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial release with 86+ components, full IntelliSense support, dark mode, and localization.</PackageReleaseNotes>
    <Copyright>Copyright © 2026 SuperUI Contributors</Copyright>
    
    <!-- Build Configuration -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    
    <!-- Generate XML documentation for IntelliSense -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    
    <!-- Symbol Package for Debugging -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    
    <!-- Enable resource file generation -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
