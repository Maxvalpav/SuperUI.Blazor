<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Assembly Information -->
    <AssemblyName>SuperUI</AssemblyName>
    <RootNamespace>SuperUI</RootNamespace>
    
    <!-- NuGet Package Metadata -->
    <PackageId>SuperUI</PackageId>
    <Version>1.0.38</Version>
    <Authors>SuperUI Contributors</Authors>
    <Company>SuperUI</Company>
    <Product>SuperUI</Product>
    <Description>SuperUI — Blazor component library with 25+ components including advanced data grid, forms, overlays, navigation, and layout components.</Description>
    <PackageTags>blazor;blazor-components;ui;components;datagrid;forms;modal;drawer;tabs;enterprise;razor;wasm;server;dark-mode;accessibility;wcag</PackageTags>
    <PackageProjectUrl>https://github.com/Maxvalpav/SuperUI.Blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Maxvalpav/SuperUI.Blazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial release with 25+ components.</PackageReleaseNotes>
	<PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright © 2026 SuperUI Contributors</Copyright>
    
    <!-- Build Configuration -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    
    <!-- Generate XML documentation for IntelliSense -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Note: 1591 warnings are now enabled to ensure all public APIs are documented -->
    <NoWarn>$(NoWarn)</NoWarn>
    
    <!-- Symbol Package for Debugging -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    
    <!-- Enable resource file generation -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>

    <!-- ИСПРАВЛЕНО CS0227: разрешаем unsafe блоки для stackalloc в ref struct -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.9" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.9" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
	<None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Trimmer roots for Blazor WASM (preserve reflection-based code) -->
  <ItemGroup>
    <TrimmerRootDescriptor Include="SuperUI.TrimmerRoots.xml" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Services\" />
  </ItemGroup>

</Project>
