<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Assembly Information -->
    <AssemblyName>SuperUI</AssemblyName>
    <RootNamespace>SuperUI</RootNamespace>
    
    <!-- NuGet Package Metadata -->
    <PackageId>SuperUI</PackageId>
    <Version>1.5.0</Version>
    <Authors>SuperUI Contributors</Authors>
    <Company>SuperUI</Company>
    <Product>SuperUI</Product>
    <Description>SuperUI — Blazor component library with 25+ components including advanced data grid, forms, overlays, navigation, and layout components.</Description>
    <PackageTags>blazor;blazor-components;ui;components;datagrid;forms;modal;drawer;tabs;enterprise;razor;wasm;server;dark-mode;accessibility;wcag</PackageTags>
    <PackageProjectUrl>https://github.com/Maxvalpav/SuperUI.Blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Maxvalpav/SuperUI.Blazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>1.5.0 — SgNavMenu: visual rhythm harmonization (single 28px row, 14px type, unified active indicator, depth-based indentation). New `Width` parameter on `SgNavMenu`. Removed `.sgc-nav-search-hint`. Sub-group headers no longer use UPPERCASE — color/weight only.</PackageReleaseNotes>
	<PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright © 2026 SuperUI Contributors</Copyright>
    
    <!-- Build Configuration -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    
    <!-- Generate XML documentation for IntelliSense -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    
    <!-- Automatic versioning via git tags (MinVer) -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    
    <!-- Symbol Package for Debugging -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\locales\**\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.CustomElements" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.0.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="2.1.0" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.Views.Blazor" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
	<None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Base\" />
  </ItemGroup>

</Project>
