{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superui.dev/schemas/theme.schema.json",
  "title": "SuperUI Theme Definition",
  "description": "JSON representation of a SuperUI theme. Mirrors IThemeDefinition for drop-in compatibility with SgThemeGenerator. Tokens are passed through as raw CSS values.",
  "type": "object",
  "required": ["id", "name", "version", "primitives", "light"],
  "properties": {
    "id":           { "type": "string", "description": "Unique theme identifier (used in [data-theme-id] and localStorage)." },
    "name":         { "type": "string", "description": "Display name shown in theme picker." },
    "description":  { "type": ["string", "null"] },
    "author":       { "type": ["string", "null"] },
    "version":      { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "category":     { "type": "string", "default": "Core" },
    "additionalCss":{ "type": ["string", "null"], "description": "Optional raw CSS appended to the generated theme stylesheet." },

    "primitives":  { "$ref": "#/$defs/primitives" },
    "light":       { "$ref": "#/$defs/semantic" },
    "dark":        { "$ref": "#/$defs/semantic" },
    "components":  { "$ref": "#/$defs/components" },
    "typography":  { "$ref": "#/$defs/typography" }
  },

  "$defs": {
    "primitives": {
      "type": "object",
      "description": "Primitive color scales + fonts + radii. Not consumed directly by components.",
      "required": ["neutral", "primary", "success", "danger", "warning", "info", "fonts", "radius"],
      "properties": {
        "neutral": { "$ref": "#/$defs/neutralScale" },
        "primary": { "$ref": "#/$defs/colorScale10" },
        "success": { "$ref": "#/$defs/colorScale5" },
        "danger":  { "$ref": "#/$defs/colorScale5" },
        "warning": { "$ref": "#/$defs/colorScale4" },
        "info":    { "$ref": "#/$defs/colorScale4" },
        "fonts": {
          "type": "object",
          "required": ["sans", "mono"],
          "properties": {
            "sans":  { "type": "string" },
            "mono":  { "type": "string" },
            "serif": { "type": ["string", "null"] }
          }
        },
        "radius": {
          "type": "object",
          "required": ["none", "xs", "sm", "md", "lg", "xl", "2xl", "full"],
          "properties": {
            "none": { "type": "string" },
            "xs":   { "type": "string" },
            "sm":   { "type": "string" },
            "md":   { "type": "string" },
            "lg":   { "type": "string" },
            "xl":   { "type": "string" },
            "2xl":  { "type": "string" },
            "full": { "type": "string" }
          }
        }
      }
    },

    "neutralScale": {
      "type": "object",
      "required": ["0", "50", "100", "200", "300", "400", "500", "600", "700", "800", "900"],
      "properties": {
        "0":   { "type": "string" },
        "50":  { "type": "string" },
        "100": { "type": "string" },
        "200": { "type": "string" },
        "300": { "type": "string" },
        "400": { "type": "string" },
        "500": { "type": "string" },
        "600": { "type": "string" },
        "700": { "type": "string" },
        "800": { "type": "string" },
        "900": { "type": "string" }
      }
    },
    "colorScale10": {
      "type": "object",
      "required": ["50", "100", "200", "300", "400", "500", "600", "700", "800", "900"],
      "properties": {
        "50":  { "type": "string" }, "100": { "type": "string" }, "200": { "type": "string" },
        "300": { "type": "string" }, "400": { "type": "string" }, "500": { "type": "string" },
        "600": { "type": "string" }, "700": { "type": "string" }, "800": { "type": "string" },
        "900": { "type": "string" }
      }
    },
    "colorScale5": {
      "type": "object",
      "required": ["50", "100", "500", "600"],
      "properties": {
        "50":  { "type": "string" }, "100": { "type": "string" },
        "500": { "type": "string" }, "600": { "type": "string" }
      }
    },
    "colorScale4": {
      "type": "object",
      "required": ["50", "100", "500", "600"],
      "properties": {
        "50":  { "type": "string" }, "100": { "type": "string" },
        "500": { "type": "string" }, "600": { "type": "string" }
      }
    },

    "semantic": {
      "type": "object",
      "description": "Semantic tokens for one mode (light or dark).",
      "required": ["bg", "surface", "fg", "border", "colorPrimary", "colorSuccess", "colorDanger", "colorWarning", "colorInfo", "font", "text", "fontWeight", "lineHeight", "shadow", "radius", "transition", "focusRing", "z"],
      "properties": {
        "bg":      { "$ref": "#/$defs/bgGroup" },
        "surface": { "$ref": "#/$defs/surfaceGroup" },
        "fg":      { "$ref": "#/$defs/fgGroup" },
        "border":  { "$ref": "#/$defs/borderGroup" },
        "divider": { "type": "string" },

        "colorPrimary":   { "$ref": "#/$defs/colorGroup" },
        "colorSuccess":   { "$ref": "#/$defs/colorGroup" },
        "colorDanger":    { "$ref": "#/$defs/colorGroup" },
        "colorWarning":   { "$ref": "#/$defs/colorGroup" },
        "colorInfo":      { "$ref": "#/$defs/colorGroup" },

        "font":     { "$ref": "#/$defs/fontGroup" },
        "text":     { "$ref": "#/$defs/textScale" },
        "fontWeight": { "$ref": "#/$defs/fontWeightGroup" },
        "lineHeight": { "$ref": "#/$defs/lineHeightGroup" },

        "shadow":   { "$ref": "#/$defs/shadowScale" },
        "radius":   { "$ref": "#/$defs/radiusScale" },
        "transition": { "$ref": "#/$defs/transitionGroup" },
        "focusRing": { "$ref": "#/$defs/focusRingGroup" },
        "z":         { "$ref": "#/$defs/zGroup" }
      }
    },

    "bgGroup": {
      "type": "object",
      "required": ["default", "subtle", "muted", "emphasized", "overlay", "glass"],
      "properties": {
        "default":    { "type": "string" },
        "subtle":     { "type": "string" },
        "muted":      { "type": "string" },
        "emphasized": { "type": "string" },
        "overlay":    { "type": "string" },
        "glass":      { "type": "string" }
      }
    },
    "surfaceGroup": {
      "type": "object",
      "required": ["default", "raised", "overlay"],
      "properties": {
        "default": { "type": "string" },
        "raised":  { "type": "string" },
        "overlay": { "type": "string" }
      }
    },
    "fgGroup": {
      "type": "object",
      "required": ["default", "subtle", "muted", "disabled", "inverse", "link", "linkHover"],
      "properties": {
        "default":   { "type": "string" },
        "subtle":    { "type": "string" },
        "muted":     { "type": "string" },
        "disabled":  { "type": "string" },
        "inverse":   { "type": "string" },
        "link":      { "type": "string" },
        "linkHover": { "type": "string" }
      }
    },
    "borderGroup": {
      "type": "object",
      "required": ["default", "subtle", "strong", "focus"],
      "properties": {
        "default": { "type": "string" },
        "subtle":  { "type": "string" },
        "strong":  { "type": "string" },
        "focus":   { "type": "string" }
      }
    },
    "colorGroup": {
      "type": "object",
      "required": ["default", "subtle", "hover", "fg"],
      "properties": {
        "default": { "type": "string" },
        "subtle":  { "type": "string" },
        "hover":   { "type": "string" },
        "fg":      { "type": "string" }
      }
    },
    "fontGroup": {
      "type": "object",
      "required": ["default", "mono"],
      "properties": {
        "default": { "type": "string" },
        "mono":    { "type": "string" }
      }
    },
    "textScale": {
      "type": "object",
      "required": ["xs", "sm", "base", "lg", "xl", "2xl", "3xl"],
      "properties": {
        "xs":  { "type": "string" },
        "sm":  { "type": "string" },
        "base":{ "type": "string" },
        "lg":  { "type": "string" },
        "xl":  { "type": "string" },
        "2xl": { "type": "string" },
        "3xl": { "type": "string" }
      }
    },
    "fontWeightGroup": {
      "type": "object",
      "required": ["normal", "medium", "semibold", "bold"],
      "properties": {
        "normal":   { "type": "string" },
        "medium":   { "type": "string" },
        "semibold": { "type": "string" },
        "bold":     { "type": "string" }
      }
    },
    "lineHeightGroup": {
      "type": "object",
      "required": ["tight", "normal", "relaxed"],
      "properties": {
        "tight":   { "type": "string" },
        "normal":  { "type": "string" },
        "relaxed": { "type": "string" }
      }
    },
    "shadowScale": {
      "type": "object",
      "required": ["xs", "sm", "md", "lg", "xl"],
      "properties": {
        "xs": { "type": "string" }, "sm": { "type": "string" },
        "md": { "type": "string" }, "lg": { "type": "string" },
        "xl": { "type": "string" }
      }
    },
    "radiusScale": {
      "type": "object",
      "required": ["sm", "md", "lg", "xl", "full"],
      "properties": {
        "sm":   { "type": "string" },
        "md":   { "type": "string" },
        "lg":   { "type": "string" },
        "xl":   { "type": "string" },
        "full": { "type": "string" }
      }
    },
    "transitionGroup": {
      "type": "object",
      "required": ["fast", "base", "slow"],
      "properties": {
        "fast": { "type": "string" },
        "base": { "type": "string" },
        "slow": { "type": "string" }
      }
    },
    "focusRingGroup": {
      "type": "object",
      "required": ["default", "danger"],
      "properties": {
        "default": { "type": "string" },
        "danger":  { "type": "string" }
      }
    },
    "zGroup": {
      "type": "object",
      "required": ["dropdown", "sticky", "modal", "toast", "tooltip"],
      "properties": {
        "dropdown": { "type": "integer" },
        "sticky":   { "type": "integer" },
        "modal":    { "type": "integer" },
        "toast":    { "type": "integer" },
        "tooltip":  { "type": "integer" }
      }
    },

    "components": {
      "type": "object",
      "description": "Per-component overrides. All groups optional.",
      "properties": {
        "button": { "$ref": "#/$defs/buttonTokens" },
        "input":  { "$ref": "#/$defs/inputTokens" },
        "card":   { "$ref": "#/$defs/cardTokens" },
        "modal":  { "type": "object", "properties": { "radius": { "type": "string" } } },
        "table":  { "type": "object", "properties": { "radius": { "type": "string" }, "headerFontWeight": { "type": "string" } } },
        "tabs":   { "type": "object", "properties": { "indicatorHeight": { "type": "string" } } },
        "tooltip":{ "type": "object", "properties": { "maxWidth": { "type": "string" } } },
        "header": { "type": "object", "properties": { "bg": { "type": "string" }, "fg": { "type": "string" } } },
        "nav":    { "type": "object", "properties": { "bg": { "type": "string" }, "fg": { "type": "string" }, "activeBg": { "type": "string" }, "activeFg": { "type": "string" } } }
      }
    },
    "buttonTokens": {
      "type": "object",
      "required": ["radius", "fontSize", "fontWeight", "height", "heightSm", "heightLg"],
      "properties": {
        "radius":    { "type": "string" },
        "fontSize":  { "type": "string" },
        "fontWeight":{ "type": "string" },
        "height":    { "type": "string" },
        "heightSm":  { "type": "string" },
        "heightLg":  { "type": "string" }
      }
    },
    "inputTokens": {
      "type": "object",
      "required": ["radius", "fontSize", "height", "heightSm", "heightLg"],
      "properties": {
        "radius":   { "type": "string" },
        "fontSize": { "type": "string" },
        "height":   { "type": "string" },
        "heightSm": { "type": "string" },
        "heightLg": { "type": "string" }
      }
    },
    "cardTokens": {
      "type": "object",
      "required": ["radius", "padding", "borderColor", "bg"],
      "properties": {
        "radius":      { "type": "string" },
        "padding":     { "type": "string" },
        "borderColor": { "type": "string" },
        "bg":          { "type": "string" }
      }
    },

    "typography": {
      "type": "object",
      "description": "Optional heading scale + Google Fonts import.",
      "required": ["googleFontsImportUrl", "headings"],
      "properties": {
        "googleFontsImportUrl": { "type": "string" },
        "embedGoogleFontsImport": { "type": "boolean", "default": true },
        "headingFont": { "type": ["string", "null"] },
        "headings": {
          "type": "object",
          "required": ["h1", "h2", "h3", "h4", "h5", "h6"],
          "properties": {
            "h1": { "$ref": "#/$defs/headingSettings" },
            "h2": { "$ref": "#/$defs/headingSettings" },
            "h3": { "$ref": "#/$defs/headingSettings" },
            "h4": { "$ref": "#/$defs/headingSettings" },
            "h5": { "$ref": "#/$defs/headingSettings" },
            "h6": { "$ref": "#/$defs/headingSettings" }
          }
        }
      }
    },
    "headingSettings": {
      "type": "object",
      "required": ["fontSize"],
      "properties": {
        "fontSize":      { "type": "string" },
        "fontFamily":    { "type": ["string", "null"] },
        "fontWeight":    { "type": ["string", "null"] },
        "lineHeight":    { "type": ["string", "null"] },
        "letterSpacing": { "type": ["string", "null"] }
      }
    }
  }
}
