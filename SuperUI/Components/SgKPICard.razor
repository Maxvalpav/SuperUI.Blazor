@namespace SuperUI.Components
@using SuperUI.Enums
@using Microsoft.AspNetCore.Components.Web

@* ═══════════════════════════════════════════════════════════════════════════
   SgKPICard — bold KPI card with split layout, inline sparkline,
   animated trend pill, optional progress bar and target indicator.
   ═══════════════════════════════════════════════════════════════════════════ *@

<div class="@RootClass"
     style="@RootStyle"
     role="@(Clickable ? "button" : null)"
     tabindex="@(Clickable ? "0" : null)"
     aria-label="@(Clickable ? (Title ?? "KPI Card") : null)"
     @onclick="HandleClickAsync"
     @onkeydown="HandleKeyDownAsync"
     @attributes="AdditionalAttributes">

    @if (IsLoading)
    {
        <!-- ── Skeleton ── -->
        <div class="sgc-kpi-body">
            <div class="sgc-kpi-skeleton">
                <div class="sgc-kpi-skel-row">
                    <SgSkeleton Width="32px" Height="32px" Shape="SgSkeletonShape.Rect" />
                    <div class="sgc-kpi-skel-lines">
                        <SgSkeleton Width="55%" Height="11px" />
                        <SgSkeleton Width="35%" Height="9px" />
                    </div>
                </div>
                <SgSkeleton Width="48%" Height="30px" CssClass="sgc-kpi-skel-val" />
                <SgSkeleton Width="38%" Height="9px" />
            </div>
        </div>
    }
    else
    {
        <!-- ── Main layout: left content + right sparkline ── -->
        <div class="sgc-kpi-inner @(HasChart ? "sgc-kpi-split" : "")">

            <!-- LEFT: all text content -->
            <div class="sgc-kpi-body">

                <!-- Header: icon + title + action -->
                <div class="sgc-kpi-header">
                    @if (!string.IsNullOrEmpty(Icon))
                    {
                        <div class="sgc-kpi-icon" style="@IconStyle" aria-hidden="true">
                            @((MarkupString)Icon)
                        </div>
                    }
                    <div class="sgc-kpi-header-text">
                        @if (!string.IsNullOrEmpty(Title))
                        {
                            <span class="sgc-kpi-title">@Title</span>
                        }
                        @if (!string.IsNullOrEmpty(Subtitle))
                        {
                            <span class="sgc-kpi-subtitle">@Subtitle</span>
                        }
                    </div>
                    @if (ActionContent is not null)
                    {
                        <div class="sgc-kpi-action" @onclick:stopPropagation="true">
                            @ActionContent
                        </div>
                    }
                </div>

                <!-- Value -->
                <div class="sgc-kpi-value-row">
                    <span class="sgc-kpi-value" style="@ValueColorStyle">
                        @if (!string.IsNullOrEmpty(Prefix))
                        {
                            <span class="sgc-kpi-affix sgc-kpi-prefix">@Prefix</span>
                        }
                        @FormattedValue
                        @if (!string.IsNullOrEmpty(Suffix))
                        {
                            <span class="sgc-kpi-affix sgc-kpi-suffix">@Suffix</span>
                        }
                    </span>
                </div>

                @if (!string.IsNullOrEmpty(Description))
                {
                    <div class="sgc-kpi-description">@Description</div>
                }

                <!-- Trend pill -->
                @if (ShowTrend && (TrendPercent.HasValue || TrendValue.HasValue))
                {
                    <div class="sgc-kpi-trend-wrap">
                        <span class="sgc-kpi-trend-pill @TrendClass" aria-label="@TrendAriaLabel">
                            <span class="sgc-kpi-trend-dot" aria-hidden="true"></span>
                            <span class="sgc-kpi-trend-icon" aria-hidden="true">
                                @((MarkupString)(IsPositiveTrend ? ArrowUpSvg : ArrowDownSvg))
                            </span>
                            <span class="sgc-kpi-trend-val">
                                @if (TrendPercent.HasValue)
                                {
                                    @($"{Math.Abs(TrendPercent.Value):0.#}%")
                                }
                                else if (TrendValue.HasValue)
                                {
                                    @($"{(TrendValue.Value >= 0 ? "+" : "")}{TrendValue.Value:0.##}")
                                }
                            </span>
                        </span>
                        @if (!string.IsNullOrEmpty(TrendLabel))
                        {
                            <span class="sgc-kpi-trend-label">@TrendLabel</span>
                        }
                    </div>
                }

                <!-- Progress bar (optional) -->
                @if (Target.HasValue && Value.HasValue)
                {
                    var pct = Math.Min(100.0, Math.Max(0.0, Value.Value / Target.Value * 100.0));
                    <div class="sgc-kpi-progress" role="progressbar"
                         aria-valuenow="@((int)pct)" aria-valuemin="0" aria-valuemax="100"
                         aria-label="@($"{pct:0}% of target")">
                        <div class="sgc-kpi-progress-track">
                            <div class="sgc-kpi-progress-fill @TrendClass"
                                 style="width:@(pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%">
                            </div>
                        </div>
                        <span class="sgc-kpi-progress-label">
                            @($"{pct:0}%")
                            @if (!string.IsNullOrEmpty(TargetLabel))
                            {
                                <span class="sgc-kpi-progress-target"> @TargetLabel</span>
                            }
                        </span>
                    </div>
                }

                <!-- Footer slot -->
                @if (FooterContent is not null)
                {
                    <div class="sgc-kpi-footer">@FooterContent</div>
                }

            </div>

            <!-- RIGHT: sparkline (only when chart data present) -->
            @if (HasChart)
            {
                <div class="sgc-kpi-spark" aria-hidden="true">
                    @RenderChart()
                </div>
            }

        </div>

        <!-- BOTTOM: full-bleed chart strip (when no split) -->
        @if (!HasChart && ChartData is { Length: > 1 })
        {
            <!-- fallback: shouldn't happen, HasChart covers this -->
        }
    }

    <!-- Variant glow layer (decorative) -->
    <div class="sgc-kpi-glow" aria-hidden="true"></div>

</div>

@code {
    // ── Value & display ───────────────────────────────────────────────────────

    /// <summary>Card title.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Subtitle below the title.</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Primary numeric value.</summary>
    [Parameter] public double? Value { get; set; }

    /// <summary>Custom text value — overrides <see cref="Value"/>.</summary>
    [Parameter] public string? ValueText { get; set; }

    /// <summary>Number format string (N0, C2, P1, etc.).</summary>
    [Parameter] public string? Format { get; set; }

    /// <summary>Prefix before the value ($, €).</summary>
    [Parameter] public string? Prefix { get; set; }

    /// <summary>Suffix after the value (%, kg).</summary>
    [Parameter] public string? Suffix { get; set; }

    /// <summary>Small description text below the value.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Custom color for the value text.</summary>
    [Parameter] public string? ValueColor { get; set; }

    // ── Target / progress ─────────────────────────────────────────────────────

    /// <summary>Target value — enables the progress bar when set alongside <see cref="Value"/>.</summary>
    [Parameter] public double? Target { get; set; }

    /// <summary>Label shown next to the progress percentage (e.g. "of target").</summary>
    [Parameter] public string? TargetLabel { get; set; }

    // ── Icon ──────────────────────────────────────────────────────────────────

    /// <summary>Inline SVG icon string.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Icon foreground color.</summary>
    [Parameter] public string? IconColor { get; set; }

    /// <summary>Icon background color.</summary>
    [Parameter] public string? IconBackground { get; set; }

    // ── Trend ─────────────────────────────────────────────────────────────────

    /// <summary>Absolute trend value.</summary>
    [Parameter] public double? TrendValue { get; set; }

    /// <summary>Percentage trend value.</summary>
    [Parameter] public double? TrendPercent { get; set; }

    /// <summary>Show the trend pill. Default true.</summary>
    [Parameter] public bool ShowTrend { get; set; } = true;

    /// <summary>Label after the trend pill (e.g. "vs last month").</summary>
    [Parameter] public string? TrendLabel { get; set; }

    /// <summary>Invert trend colors — lower is better.</summary>
    [Parameter] public bool InvertTrend { get; set; }

    // ── Chart ─────────────────────────────────────────────────────────────────

    /// <summary>Data points for the sparkline.</summary>
    [Parameter] public double[]? ChartData { get; set; }

    /// <summary>Sparkline type. Default <see cref="SgKPIChartType.Area"/>.</summary>
    [Parameter] public SgKPIChartType ChartType { get; set; } = SgKPIChartType.Area;

    /// <summary>Sparkline color. Defaults to trend color.</summary>
    [Parameter] public string? ChartColor { get; set; }

    // ── Appearance ────────────────────────────────────────────────────────────

    /// <summary>Color variant.</summary>
    [Parameter] public SgKPIVariant Variant { get; set; } = SgKPIVariant.Default;

    /// <summary>Card size.</summary>
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;

    // ── State ─────────────────────────────────────────────────────────────────

    /// <summary>Shows skeleton loader.</summary>
    [Parameter] public bool IsLoading { get; set; }

    // ── Interaction ───────────────────────────────────────────────────────────

    /// <summary>Makes the card clickable.</summary>
    [Parameter] public bool Clickable { get; set; }

    /// <summary>Click callback.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    // ── Slots ─────────────────────────────────────────────────────────────────

    /// <summary>Right-aligned action in the header.</summary>
    [Parameter] public RenderFragment? ActionContent { get; set; }

    /// <summary>Footer slot.</summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    // ── Passthrough ───────────────────────────────────────────────────────────

    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // ── Computed ──────────────────────────────────────────────────────────────

    private bool HasChart => ChartData is { Length: > 1 };

    private bool IsPositiveTrend
    {
        get
        {
            var raw = TrendPercent ?? TrendValue ?? 0;
            return InvertTrend ? raw < 0 : raw >= 0;
        }
    }

    private string TrendClass => IsPositiveTrend ? "sgc-kpi-up" : "sgc-kpi-down";

    private string TrendAriaLabel
    {
        get
        {
            var dir = IsPositiveTrend ? "up" : "down";
            if (TrendPercent.HasValue) return $"Trend {dir} {Math.Abs(TrendPercent.Value):0.#}%";
            if (TrendValue.HasValue)   return $"Trend {dir} {Math.Abs(TrendValue.Value):0.##}";
            return $"Trend {dir}";
        }
    }

    private string FormattedValue
    {
        get
        {
            if (!string.IsNullOrEmpty(ValueText)) return ValueText;
            if (!Value.HasValue) return "—";
            if (!string.IsNullOrEmpty(Format)) return Value.Value.ToString(Format);
            return Value.Value % 1 == 0
                ? ((long)Value.Value).ToString("N0")
                : Value.Value.ToString("G");
        }
    }

    private string? ValueColorStyle => !string.IsNullOrEmpty(ValueColor) ? $"color:{ValueColor};" : null;

    private string? IconStyle
    {
        get
        {
            if (string.IsNullOrEmpty(IconColor) && string.IsNullOrEmpty(IconBackground)) return null;
            var sb = new System.Text.StringBuilder();
            if (!string.IsNullOrEmpty(IconColor))      sb.Append($"color:{IconColor};");
            if (!string.IsNullOrEmpty(IconBackground)) sb.Append($"background:{IconBackground};");
            return sb.ToString();
        }
    }

    private string RootClass
    {
        get
        {
            var cls = new List<string> { "sgc-kpi", $"sgc-kpi-{SizeKey}", $"sgc-kpi-v-{VariantKey}" };
            if (Clickable)                            cls.Add("sgc-kpi-clickable");
            if (IsLoading)                            cls.Add("sgc-kpi-loading");
            if (HasChart)                             cls.Add("sgc-kpi-has-chart");
            if (!string.IsNullOrWhiteSpace(CssClass)) cls.Add(CssClass!);
            return string.Join(' ', cls);
        }
    }

    private string? RootStyle => string.IsNullOrWhiteSpace(Style) ? null : Style;

    private string SizeKey => Size switch
    {
        SgSize.Sm => "sm",
        SgSize.Lg => "lg",
        SgSize.Xl => "xl",
        _         => "md"
    };

    private string VariantKey => Variant switch
    {
        SgKPIVariant.Primary => "primary",
        SgKPIVariant.Success => "success",
        SgKPIVariant.Warning => "warning",
        SgKPIVariant.Danger  => "danger",
        SgKPIVariant.Info    => "info",
        _                    => "default"
    };

    // ── Sparkline ─────────────────────────────────────────────────────────────

    private RenderFragment RenderChart() => __builder =>
    {
        if (ChartData is not { Length: > 1 }) return;

        var data  = ChartData;
        var count = data.Length;
        var min   = data.Min();
        var max   = data.Max();
        var range = max - min;

        // Coordinate space: 100×60, 3px top pad so stroke isn't clipped
        const double W = 100.0, H = 60.0, PT = 3.0;

        double X(int i)    => count == 1 ? W / 2 : W * i / (count - 1);
        double Y(double v) => range < 1e-9 ? H / 2 : PT + (H - PT) * (1.0 - (v - min) / range);

        var color = !string.IsNullOrEmpty(ChartColor)
            ? ChartColor
            : IsPositiveTrend ? "#10b981" : "#f43f5e";

        var ic = System.Globalization.CultureInfo.InvariantCulture;

        if (ChartType == SgKPIChartType.Bar)
        {
            __builder.OpenElement(0, "svg");
            __builder.AddAttribute(1, "viewBox", $"0 0 {W} {H}");
            __builder.AddAttribute(2, "preserveAspectRatio", "none");
            __builder.AddAttribute(3, "class", "sgc-kpi-spark-svg");

            var slot = W / count;
            var bw   = slot * 0.6;
            var boff = slot * 0.2;

            for (int i = 0; i < count; i++)
            {
                var bx = slot * i + boff;
                var by = Y(data[i]);
                var bh = H - by;
                // Taller bars get full opacity, shorter ones fade slightly
                var op = 0.55 + 0.45 * (bh / H);
                __builder.OpenElement(5, "rect");
                __builder.AddAttribute(6,  "x",       bx.ToString("F2", ic));
                __builder.AddAttribute(7,  "y",       by.ToString("F2", ic));
                __builder.AddAttribute(8,  "width",   bw.ToString("F2", ic));
                __builder.AddAttribute(9,  "height",  bh.ToString("F2", ic));
                __builder.AddAttribute(10, "fill",    color);
                __builder.AddAttribute(11, "rx",      "2");
                __builder.AddAttribute(12, "opacity", op.ToString("F2", ic));
                __builder.CloseElement();
            }
            __builder.CloseElement();
        }
        else
        {
            // Build smooth cubic bezier path
            var points = Enumerable.Range(0, count)
                .Select(i => (x: X(i), y: Y(data[i])))
                .ToArray();

            var path = BuildSmoothPath(points);

            __builder.OpenElement(0, "svg");
            __builder.AddAttribute(1, "viewBox", $"0 0 {W} {H}");
            __builder.AddAttribute(2, "preserveAspectRatio", "none");
            __builder.AddAttribute(3, "class", "sgc-kpi-spark-svg");

            // Unique gradient id per instance (use GetHashCode for uniqueness)
            var gid = $"kpi-g-{Math.Abs(GetHashCode())}";

            // Gradient fill
            __builder.OpenElement(4, "defs");
            __builder.OpenElement(5, "linearGradient");
            __builder.AddAttribute(6, "id",  gid);
            __builder.AddAttribute(7, "x1",  "0"); __builder.AddAttribute(8,  "y1", "0");
            __builder.AddAttribute(9, "x2",  "0"); __builder.AddAttribute(10, "y2", "1");
            __builder.OpenElement(11, "stop");
            __builder.AddAttribute(12, "offset",     "0%");
            __builder.AddAttribute(13, "stop-color", color);
            __builder.AddAttribute(14, "stop-opacity", "0.35");
            __builder.CloseElement(); // stop
            __builder.OpenElement(15, "stop");
            __builder.AddAttribute(16, "offset",     "100%");
            __builder.AddAttribute(17, "stop-color", color);
            __builder.AddAttribute(18, "stop-opacity", "0");
            __builder.CloseElement(); // stop
            __builder.CloseElement(); // linearGradient
            __builder.CloseElement(); // defs

            if (ChartType == SgKPIChartType.Area)
            {
                var x0   = points[0].x.ToString("F2", ic);
                var xEnd = points[^1].x.ToString("F2", ic);
                var bot  = H.ToString("F2", ic);
                var areaPath = $"{path} L {xEnd},{bot} L {x0},{bot} Z";

                __builder.OpenElement(19, "path");
                __builder.AddAttribute(20, "d",    areaPath);
                __builder.AddAttribute(21, "fill", $"url(#{gid})");
                __builder.CloseElement();
            }

            // Stroke
            __builder.OpenElement(22, "path");
            __builder.AddAttribute(23, "d",            path);
            __builder.AddAttribute(24, "fill",         "none");
            __builder.AddAttribute(25, "stroke",       color);
            __builder.AddAttribute(26, "stroke-width", "2");
            __builder.AddAttribute(27, "stroke-linecap",  "round");
            __builder.AddAttribute(28, "stroke-linejoin", "round");
            __builder.CloseElement();

            // Terminal dot — last data point
            var lx = points[^1].x;
            var ly = points[^1].y;
            __builder.OpenElement(29, "circle");
            __builder.AddAttribute(30, "cx",   lx.ToString("F2", ic));
            __builder.AddAttribute(31, "cy",   ly.ToString("F2", ic));
            __builder.AddAttribute(32, "r",    "2.5");
            __builder.AddAttribute(33, "fill", color);
            __builder.CloseElement();

            __builder.CloseElement(); // svg
        }
    };

    /// <summary>Builds a smooth cubic bezier SVG path through the given points.</summary>
    private static string BuildSmoothPath((double x, double y)[] pts)
    {
        if (pts.Length == 0) return "";
        if (pts.Length == 1) return $"M {pts[0].x:F2},{pts[0].y:F2}";

        var ic = System.Globalization.CultureInfo.InvariantCulture;
        var sb = new System.Text.StringBuilder();
        sb.Append($"M {pts[0].x.ToString("F2", ic)},{pts[0].y.ToString("F2", ic)}");

        for (int i = 1; i < pts.Length; i++)
        {
            var prev = pts[i - 1];
            var curr = pts[i];
            // Control points: 1/3 of the horizontal distance
            var cpx = (curr.x - prev.x) * 0.4;
            var cp1x = (prev.x + cpx).ToString("F2", ic);
            var cp1y = prev.y.ToString("F2", ic);
            var cp2x = (curr.x - cpx).ToString("F2", ic);
            var cp2y = curr.y.ToString("F2", ic);
            sb.Append($" C {cp1x},{cp1y} {cp2x},{cp2y} {curr.x.ToString("F2", ic)},{curr.y.ToString("F2", ic)}");
        }
        return sb.ToString();
    }

    // ── Interaction ───────────────────────────────────────────────────────────

    private async Task HandleClickAsync(MouseEventArgs _)
    {
        if (!Clickable || IsLoading) return;
        if (OnClick.HasDelegate) await OnClick.InvokeAsync();
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (!Clickable || IsLoading) return;
        if (e.Key is "Enter" or " " or "Spacebar")
            if (OnClick.HasDelegate) await OnClick.InvokeAsync();
    }

    // ── SVG icons ─────────────────────────────────────────────────────────────

    private const string ArrowUpSvg =
        """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>""";

    private const string ArrowDownSvg =
        """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>""";
}
