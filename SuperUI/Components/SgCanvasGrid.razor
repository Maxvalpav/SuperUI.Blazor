@namespace SuperUI.Components
@using Microsoft.JSInterop
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@typeparam TItem

<div class="sg-canvas-grid-wrapper" style="width: @Width; height: @Height;">
    @if (ShowToolbar)
    {
        <div class="sg-canvas-grid-toolbar">
            <div class="sg-canvas-grid-search">
                <input type="text" 
                       class="sg-textbox" 
                       placeholder="@Localizer["DataGrid_Search"]" 
                       value="@_filterText"
                       @oninput="OnSearchInput" />
            </div>
            
            @foreach (var property in _groupBy)
            {
                var col = _effectiveColumns.FirstOrDefault(c => c.Property == property);
                if (col == null) continue;
                <div class="sg-chip sg-group-chip" style="margin-left: 8px;">
                    <span>@Localizer["DataGrid_FilterGroupBy"]: @col.Title</span>
                    <button class="sg-chip-x" title="@Localizer["DataGrid_FilterRemoveCondition"]" @onclick="() => ToggleGroupBy(property)">&times;</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_sortProperty))
            {
                var col = _effectiveColumns.FirstOrDefault(c => c.Property == _sortProperty);
                if (col != null)
                {
                    <div class="sg-chip sg-sort-chip" style="margin-left: 8px;">
                        <span>@(_sortDescending ? "▼" : "▲") @col.Title</span>
                        <button class="sg-chip-x" title="@Localizer["DataGrid_FilterReset"]" @onclick="ClearSort">&times;</button>
                    </div>
                }
            }

            <div style="margin-left: auto; display: flex; gap: 8px; align-items: center;">
                @if (_columnFiltersValues.Any() || _conditionFilters.Any() || !string.IsNullOrEmpty(_filterText))
                {
                    <SgButton Text="@Localizer["DataGrid_ResetFilters"]" Size="sm" Variant="ghost" OnClick="ResetAll" />
                }
                
                @if (ShowColumnChooser)
                {
                    <SgButton Size="sm" Variant="ghost" OnClick="ToggleColumnChooser" title="@Localizer["DataGrid_Columns"]">
                        <Icon><i class="sui-icon sui-icon-settings"></i></Icon>
                    </SgButton>
                }

                @if (ShowExport)
                {
                    <div class="sg-dropdown">
                        <SgButton Size="sm" Variant="ghost" OnClick="ToggleExportMenu" title="@Localizer["DataGrid_Export"]">
                            <Icon><i class="sui-icon sui-icon-download"></i></Icon>
                        </SgButton>
                        @if (_showExportMenu)
                        {
                            <div class="sg-dropdown-menu sg-dropdown-menu-right show">
                                <div class="sg-dropdown-item" @onclick="() => ExportToCsvAsync()">@Localizer["DataGrid_ExportCsv"]</div>
                                <div class="sg-dropdown-item" @onclick="() => ExportExcelAsync()">@Localizer["DataGrid_ExportExcel"]</div>
                                <div class="sg-dropdown-item" @onclick="() => ExportToImageAsync()">@Localizer["ExportPNG"]</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
    
    @if (_showColumnChooser)
    {
        <div class="sgc-context-menu-overlay" @onclick="ToggleColumnChooser"></div>
        <div class="sgc-context-menu" style="right: 12px; top: 45px; padding: 12px; width: 220px; z-index: 100;">
            <div style="font-weight: 600; margin-bottom: 8px; font-size: 13px;">@Localizer["DataGrid_ShowColumns"]</div>
            <div style="max-height: 300px; overflow-y: auto;">
                @foreach (var col in Columns ?? new())
                {
                    <div style="display: flex; align-items: center; gap: 8px; padding: 4px 0; cursor: pointer;" @onclick="() => ToggleColumnVisibility(col)">
                        <input type="checkbox" checked="@(!col.Hidden)" readonly />
                        <span style="font-size: 13px;">@col.Title</span>
                    </div>
                }
            </div>
        </div>
    }
    <div class="sg-canvas-grid-container" @ref="_container" style="width: 100%;">
        <canvas @ref="_canvas" class="sg-canvas-grid"></canvas>
        
        @* Accessibility Fallback - Hidden but readable by screen readers *@
        <div class="sg-canvas-grid-a11y-fallback" aria-hidden="true" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0;">
            <table role="grid">
                <thead>
                    <tr>
                        @foreach (var col in _effectiveColumns)
                        {
                            <th scope="col">@col.Title</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (_processedItems != null)
                    {
                        @* Render only a subset of items for a11y to avoid bloating DOM *@
                        @foreach (var item in _processedItems.Take(100))
                        {
                            <tr>
                                @foreach (var col in _effectiveColumns)
                                {
                                    <td>@GetDisplay(item, col)</td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="sg-canvas-grid-scroll-v" @ref="_scrollV" style="top: @(HeaderHeight)px;">
            <div style="height: @(_totalItems * RowHeight)px; width: 1px;"></div>
        </div>
        <div class="sg-canvas-grid-scroll-h" @ref="_scrollH">
            <div style="width: @(_totalWidth)px; height: 1px;"></div>
        </div>

        @if (_isLoading)
        {
            <div class="sg-canvas-grid-loading">
                <div class="sg-canvas-grid-loading-inner">
                    <div class="sg-canvas-spinner">
                        <div class="sg-canvas-spinner-ring"></div>
                    </div>
                    <span class="sg-canvas-loading-text">@Localizer["Loading"]</span>
                </div>
            </div>
        }

        @if (_editingCell != null)
        {
            <div class="sg-canvas-grid-editor" style="left: @(_editingCell.Value.X)px; top: @(_editingCell.Value.Y)px; width: @(_editingCell.Value.Width)px; height: @(_editingCell.Value.Height)px;">
                <input type="text" 
                       value="@_editingValue" 
                       @oninput="@(e => _editingValue = e.Value?.ToString() ?? "")"
                       @onblur="EndEdit" 
                       @onkeydown="OnEditorKeyDown"
                       autofocus />
            </div>
        }

        @if (_filterPopup != null)
        {
            <div class="sgc-context-menu-overlay" @onclick="CloseFilter"></div>
            <div class="sgc-context-menu" style="left: @(_filterPopup.Value.X)px; top: @(_filterPopup.Value.Y)px; padding: 0; width: 280px; display: flex; flex-direction: column; max-height: 450px; overflow: hidden; background-color: var(--sui-bg-primary); z-index: 5001;">
                <div style="padding: 10px 12px; border-bottom: 1px solid var(--sui-border-soft); font-weight: 600; display: flex; align-items: center; justify-content: space-between; background: var(--sui-bg-secondary);">
                    <span>Фильтр: @(_effectiveColumns.FirstOrDefault(c => c.Property == _filterPopup.Value.Property)?.Title ?? _filterPopup.Value.Property)</span>
                    <button class="sgc-modal-x" @onclick="CloseFilter">×</button>
                </div>

                <div style="padding: 4px 0; border-bottom: 1px solid var(--sui-border-soft);">
                    <button type="button" class="sg-filter-item sg-filter-item--row" @onclick="@(() => SetSort(_filterPopup.Value.Property, false))">
                        <i class="sui-icon sui-icon-sort-ascending sg-filter-item-icon"></i> @Localizer["DataGrid_Sort"] (А-Я)
                    </button>
                    <button type="button" class="sg-filter-item sg-filter-item--row" @onclick="@(() => SetSort(_filterPopup.Value.Property, true))">
                        <i class="sui-icon sui-icon-sort-descending sg-filter-item-icon"></i> @Localizer["DataGrid_Sort"] (Я-А)
                    </button>
                    @if (_sortProperty == _filterPopup.Value.Property)
                    {
                        <button type="button" class="sg-filter-item sg-filter-item--row" @onclick="ClearSort">
                            <i class="sui-icon sui-icon-close sg-filter-item-icon"></i> @Localizer["DataGrid_ResetSort"]
                        </button>
                    }
                    <div style="height: 1px; background: var(--sui-border-soft); margin: 4px 0;"></div>
                    <button type="button" class="sg-filter-item sg-filter-item--row" @onclick="@(() => ToggleGroupBy(_filterPopup.Value.Property))">
                        <i class="sui-icon sui-icon-group sg-filter-item-icon"></i> @(_groupBy.Contains(_filterPopup.Value.Property) ? Localizer["DataGrid_FilterUnGroupBy"] : Localizer["DataGrid_FilterGroupBy"])
                    </button>
                </div>

                @{
                    var tabStyle1 = !_showConditionFilter ? "border-bottom: 2px solid var(--sui-accent); color: var(--sui-accent);" : "color: var(--sui-muted);";
                    var tabStyle2 = _showConditionFilter ? "border-bottom: 2px solid var(--sui-accent); color: var(--sui-accent);" : "color: var(--sui-muted);";
                }
                <div style="display: flex; border-bottom: 1px solid var(--sui-border-soft); background: var(--sui-bg-secondary);">
                    <div @onclick="@(() => _showConditionFilter = false)" style="flex: 1; padding: 8px; text-align: center; cursor: pointer; font-size: 12px; font-weight: 500; @tabStyle1">@Localizer["DataGrid_FilterOrValues"]</div>
                    <div @onclick="@(() => _showConditionFilter = true)" style="flex: 1; padding: 8px; text-align: center; cursor: pointer; font-size: 12px; font-weight: 500; @tabStyle2">@Localizer["DataGrid_FilterApply"]</div>
                </div>
                
                @if (!_showConditionFilter)
                {
                    <div style="padding: 8px; border-bottom: 1px solid var(--sui-border-soft);">
                        <input type="text" class="sg-textbox" placeholder="@Localizer["DataGrid_Search"]" 
                               @bind="_columnSearchText[_filterPopup.Value.Property]" 
                               @bind:event="oninput"
                               style="width: 100%; height: 32px;"
                               @onclick:stopPropagation />
                    </div>

                    <div style="flex: 1; overflow-y: auto; padding: 4px 0; min-height: 120px; max-height: 250px; background: var(--sui-bg-primary);">
                        <button type="button" class="sg-filter-item sg-filter-item--row-sm" @onclick="@(() => SelectAllFilterValues(_filterPopup.Value.Property))">
                            <input type="checkbox" checked="@(!_columnFiltersValues.ContainsKey(_filterPopup.Value.Property) || !_columnFiltersValues[_filterPopup.Value.Property].Any())" readonly tabindex="-1" />
                            <span style="font-size: 13px;">@Localizer["DataGrid_FilterAll"]</span>
                        </button>

                        @foreach (var option in _currentFilterOptions.Where(o => {
                            var searchText = _columnSearchText.GetValueOrDefault(_filterPopup.Value.Property);
                            return string.IsNullOrEmpty(searchText) || o.Contains(searchText, StringComparison.OrdinalIgnoreCase);
                        }))
                        {
                            <button type="button" class="sg-filter-item sg-filter-item--row-sm" @onclick="@(() => ToggleFilterValue(_filterPopup.Value.Property, option))">
                                <input type="checkbox" checked="@IsFilterValueSelected(_filterPopup.Value.Property, option)" readonly tabindex="-1" />
                                <span style="font-size: 13px;">@(string.IsNullOrEmpty(option) ? Localizer["DataGrid_FilterEmpty"] : option)</span>
                            </button>
                        }
                    </div>

                    <div style="padding: 8px 12px; border-top: 1px solid var(--sui-border-soft); background: var(--sui-bg-secondary); display: flex; justify-content: flex-end; gap: 8px;">
                        <SgButton Text="@Localizer["DataGrid_FilterReset"]" Size="sm" Variant="ghost" OnClick="@(() => ClearFilter(_filterPopup.Value.Property))" />
                        <div style="flex: 1;"></div>
                        <SgButton Text="@Localizer["DataGrid_FilterCancel"]" Size="sm" Variant="ghost" OnClick="CloseFilter" />
                        <SgButton Text="@Localizer["DataGrid_FilterOk"]" Size="sm" OnClick="ApplyCurrentFilter" />
                    </div>
                }
                else
                {
                    <div style="flex: 1; overflow-y: auto; padding: 12px; min-height: 150px; max-height: 300px;">
                        @for (var i = 0; i < _pendingRules.Count; i++)
                        {
                            var idx = i;
                            <div style="display: flex; gap: 4px; margin-bottom: 8px; align-items: center;">
                                <select class="sg-select" style="flex: 1; height: 32px; font-size: 12px;" 
                                        value="@_pendingRules[idx].Condition"
                                        @onchange="@(e => _pendingRules[idx] = _pendingRules[idx] with { Condition = Enum.Parse<FilterCondition>(e.Value?.ToString() ?? "Contains") })">
                                    <option value="@FilterCondition.Contains">@Localizer["DataGrid_FilterContains"]</option>
                                    <option value="@FilterCondition.NotContains">@Localizer["DataGrid_FilterNotContains"]</option>
                                    <option value="@FilterCondition.Equals">@Localizer["DataGrid_FilterEquals"]</option>
                                    <option value="@FilterCondition.NotEquals">@Localizer["DataGrid_FilterNotEquals"]</option>
                                    <option value="@FilterCondition.StartsWith">@Localizer["DataGrid_FilterStartsWith"]</option>
                                    <option value="@FilterCondition.EndsWith">@Localizer["DataGrid_FilterEndsWith"]</option>
                                    @if (IsNumericColumn(_filterPopup.Value.Property))
                                    {
                                        <option value="@FilterCondition.GreaterThan">@Localizer["DataGrid_FilterGreaterThan"]</option>
                                        <option value="@FilterCondition.LessThan">@Localizer["DataGrid_FilterLessThan"]</option>
                                        <option value="@FilterCondition.GreaterOrEqual">@Localizer["DataGrid_FilterGreaterOrEqual"]</option>
                                        <option value="@FilterCondition.LessOrEqual">@Localizer["DataGrid_FilterLessOrEqual"]</option>
                                    }
                                    <option value="@FilterCondition.IsEmpty">@Localizer["DataGrid_FilterIsEmpty"]</option>
                                    <option value="@FilterCondition.IsNotEmpty">@Localizer["DataGrid_FilterIsNotEmpty"]</option>
                                </select>
                                
                                @if (_pendingRules[idx].Condition != FilterCondition.IsEmpty && _pendingRules[idx].Condition != FilterCondition.IsNotEmpty)
                                {
                                    <input type="text" class="sg-textbox" style="flex: 1; height: 32px; font-size: 12px;" 
                                           placeholder="@Localizer["DataGrid_FilterValue"]"
                                           value="@_pendingRules[idx].Value"
                                           @oninput="@(e => _pendingRules[idx] = _pendingRules[idx] with { Value = e.Value?.ToString() })" />
                                }

                                <SgButton Size="sm" Variant="ghost" OnClick="@(() => RemovePendingRule(idx))" style="padding: 0 4px;">
                                    <Icon><i class="sui-icon sui-icon-close"></i></Icon>
                                </SgButton>
                            </div>

                            @if (idx < _pendingRules.Count - 1)
                            {
                                <div style="display: flex; justify-content: center; margin-bottom: 8px;">
                                    <div class="sg-btn-group">
                                        <button class="sg-btn sg-btn-sm @(_pendingRulesAnd ? "sg-btn-primary" : "sg-btn-ghost")" @onclick="@(() => _pendingRulesAnd = true)" style="font-size: 10px; padding: 2px 8px;">@Localizer["DataGrid_FilterAnd"]</button>
                                        <button class="sg-btn sg-btn-sm @(!_pendingRulesAnd ? "sg-btn-primary" : "sg-btn-ghost")" @onclick="@(() => _pendingRulesAnd = false)" style="font-size: 10px; padding: 2px 8px;">@Localizer["DataGrid_FilterOr"]</button>
                                    </div>
                                </div>
                            }
                        }
                        
                        <SgButton Text="@Localizer["DataGrid_FilterAddCondition"]" Size="sm" Variant="ghost" OnClick="AddPendingRule" style="width: 100%; margin-top: 4px;" />
                        
                        <div style="margin-top: 12px;">
                            <SgButton Text="@Localizer["DataGrid_FilterApply"]" Size="sm" OnClick="ApplyConditionFilter" style="width: 100%;" />
                        </div>
                    </div>

                    <div style="padding: 8px 12px; border-top: 1px solid var(--sui-border-soft); background: var(--sui-bg-secondary); display: flex; justify-content: flex-end; gap: 8px;">
                        <SgButton Text="@Localizer["DataGrid_FilterReset"]" Size="sm" Variant="ghost" OnClick="@(() => ClearFilter(_filterPopup.Value.Property))" />
                        <div style="flex: 1;"></div>
                        <SgButton Text="@Localizer["DataGrid_FilterCancel"]" Size="sm" Variant="ghost" OnClick="CloseFilter" />
                        <SgButton Text="@Localizer["DataGrid_FilterOk"]" Size="sm" OnClick="ApplyConditionFilter" />
                    </div>
                }
            </div>
        }
    </div>
    @if (ShowStatus)
    {
        <div class="sg-canvas-grid-status" style="border-top: 1px solid var(--sui-border-soft); background: var(--sui-bg-secondary); padding: 4px 12px; font-size: 11px;">
            <div style="display: flex; gap: 12px; align-items: center;">
                <span>@Localizer["DataGrid_RowsFrom"]: <strong>@(_processedItems?.Count ?? 0)</strong></span>

                @if (_selectedItems.Count > 0)
                {
                    <span>@Localizer["DataGrid_Selected"]: <strong>@_selectedItems.Count</strong></span>
                }
            </div>

            @if (_aggregates.Any())
            {
                <div style="margin-left: auto; display: flex; gap: 16px; align-items: center;">
                    @foreach (var agg in _aggregates)
                    {
                        <div class="sg-agg-item">
                            <span style="color: var(--sui-muted); margin-right: 4px;">@(_effectiveColumns.FirstOrDefault(c => c.Property == agg.Key)?.Title):</span>
                            <strong>@agg.Value</strong>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>
