@namespace SuperUI.Components
@inherits SgFormFieldBase<bool>

<div class="@GetRootClasses()" style="@Style">
    <label class="@GetCheckClasses()">
        <span class="@GetSwitchClasses()">
            <input id="@EffectiveId"
                   type="checkbox"
                   role="switch"
                   checked="@Value"
                   disabled="@IsEffectivelyDisabled"
                   aria-checked="@AriaChecked"
                   aria-invalid="@(HasError ? "true" : null)"
                   aria-describedby="@DescribedBy"
                   @onchange="OnChangeAsync"
                   @onfocus="HandleFocusAsync"
                   @onblur="HandleBlurAsync"
                   @attributes="AdditionalAttributesFiltered" />
            <span class="sgc-switch-slider"></span>
        </span>
        @if (!string.IsNullOrEmpty(OnLabel) || !string.IsNullOrEmpty(OffLabel))
        {
            <span class="sgc-switch-label sgc-switch-label-on">@OnLabel</span>
            <span class="sgc-switch-label sgc-switch-label-off">@OffLabel</span>
        }
        else if (ChildContent is not null)
        {
            @ChildContent
        }
        else if (!string.IsNullOrEmpty(Label))
        {
            <span>@Label</span>
        }
    </label>

    @if (HasError)
    {
        <span id="@($"{EffectiveId}-err")" class="sgc-error">@DisplayedError</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@($"{EffectiveId}-hint")" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    [Parameter] public string? OnLabel { get; set; }
    [Parameter] public string? OffLabel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Block { get; set; }
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;
    [Parameter] public string? CssClass { get; set; }

    protected override string ComponentPrefix => "sw";

    private string AriaChecked => Value ? "true" : "false";
    private string? DescribedBy => HasError ? $"{EffectiveId}-err" : (!string.IsNullOrEmpty(Hint) ? $"{EffectiveId}-hint" : null);
    private string? DisplayedError => !string.IsNullOrEmpty(ErrorText) ? ErrorText : ValidationMessages.FirstOrDefault();

    private string GetRootClasses() => Css("sgc-check-field")
        .AddIf("sgc-block", Block)
        .Add(CssClass)
        .Add(Class)
        .ToString();

    private string GetCheckClasses() => Css("sgc-check")
        .AddIf("sgc-disabled", IsEffectivelyDisabled)
        .AddIf("sgc-check-invalid", HasError)
        .ToString();

    private string GetSwitchClasses() => Css("sgc-switch")
        .AddIf("sgc-switch-sm", Size == SgSize.Sm)
        .AddIf("sgc-switch-lg", Size == SgSize.Lg)
        .ToString();

    private Task OnChangeAsync(ChangeEventArgs e) => SetValueAsync(e.Value is true);

    protected override IReadOnlyDictionary<string, object> BuildAriaAttributes()
    {
        return new AriaBuilder()
            .Label(Label)
            .Checked(Value)
            .Required(Required)
            .Invalid(HasError)
            .Disabled(Disabled)
            .Build();
    }
}
