@namespace SuperUI.Components
@inherits SgInputBase<bool>

<label class="sgc-check @(Disabled ? "sgc-disabled" : "") @CssClass">
    <span class="sgc-switch">
        <input type="checkbox"
               role="switch"
               checked="@Value"
               disabled="@Disabled"
               aria-checked="@Value.ToString().ToLowerInvariant()"
               aria-invalid="@(HasValidationErrors ? "true" : null)"
               @onchange="OnChangeAsync"
               @attributes="AdditionalAttributes" />
        <span class="sgc-switch-slider"></span>
    </span>
    @if (ChildContent is not null) { @ChildContent }
    else if (!string.IsNullOrEmpty(Label)) { <span>@Label</span> }
</label>

@code {
    /// <summary>
    /// Gets or sets the label text displayed next to the switch.
    /// Ignored if <see cref="ChildContent"/> is provided.
    /// </summary>
    [Parameter] public string? Label { get; set; }
    
    /// <summary>
    /// Gets or sets custom content to render next to the switch.
    /// Takes precedence over <see cref="Label"/>.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    
    /// <summary>
    /// Gets or sets whether the switch is disabled.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }
    
    /// <summary>
    /// Gets or sets additional CSS class names to apply to the switch label.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the input element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private Task OnChangeAsync(ChangeEventArgs e) => SetValueAsync(e.Value is true);
}
