@namespace SuperUI.Components

<div class="sgc-skeleton @ShapeClass @CssClass" 
     style="@GetStyle()">
</div>

@code {
    /// <summary>
    /// Gets or sets the shape of the skeleton. 
    /// Supported values: "text", "rect", "circle". Default is "text".
    /// </summary>
    [Parameter] public string Shape { get; set; } = "text";

    /// <summary>
    /// Gets or sets the width of the skeleton (e.g., "100%", "200px").
    /// </summary>
    [Parameter] public string? Width { get; set; }

    /// <summary>
    /// Gets or sets the height of the skeleton (e.g., "1rem", "40px").
    /// </summary>
    [Parameter] public string? Height { get; set; }

    /// <summary>
    /// Gets or sets additional CSS class names.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Gets or sets whether the skeleton is animated. Default is true.
    /// </summary>
    [Parameter] public bool Animated { get; set; } = true;

    private string ShapeClass => Shape switch
    {
        "circle" => "sgc-skeleton-circle",
        "rect" => "sgc-skeleton-rect",
        _ => "sgc-skeleton-text"
    };

    private string GetStyle()
    {
        var styles = new List<string>();
        if (!string.IsNullOrEmpty(Width)) styles.Add($"width: {Width}");
        if (!string.IsNullOrEmpty(Height)) styles.Add($"height: {Height}");
        if (!Animated) styles.Add("animation: none");
        return string.Join("; ", styles);
    }
}
