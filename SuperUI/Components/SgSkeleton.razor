@namespace SuperUI.Components

@if (Variant == "lines")
{
    <div class="sgc-skeleton-lines @CssClass">
        @for (var i = 0; i < Lines; i++)
        {
            var lineWidth = i == Lines - 1 ? "60%" : "100%";
            <span class="sgc-skeleton sgc-skeleton-line" style="width:@lineWidth;"></span>
        }
    </div>
}
else if (Variant == "circle")
{
    <span class="sgc-skeleton sgc-skeleton-circle @CssClass" style="@CircleStyle"></span>
}
else
{
    <span class="sgc-skeleton sgc-skeleton-block @CssClass" style="@BlockStyle"></span>
}

@code {
    [Parameter] public string Variant { get; set; } = "lines"; // lines|circle|block
    [Parameter] public int Lines { get; set; } = 3;
    [Parameter] public string Width { get; set; } = "100%";
    [Parameter] public string Height { get; set; } = "16px";
    [Parameter] public string Size { get; set; } = "32px";
    [Parameter] public string? CssClass { get; set; }

    private string BlockStyle => $"width:{Width}; height:{Height};";
    private string CircleStyle => $"width:{Size}; height:{Size};";
}
