@namespace SuperUI.Components
@typeparam TValue
@inherits SgFormFieldBase<TValue>

<div class="@GetFieldClasses()" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label id="@($"{EffectiveId}-label")" class="sgc-label @(Required ? "sgc-required" : "")" for="@EffectiveId">@Label</label>
    }

    <select id="@EffectiveId"
            class="@GetSelectClasses()"
            disabled="@IsEffectivelyDisabled"
            value="@ValueString"
            aria-labelledby="@(string.IsNullOrEmpty(Label) ? null : $"{EffectiveId}-label")"
            aria-required="@(Required ? "true" : null)"
            aria-invalid="@(HasError ? "true" : null)"
            aria-describedby="@DescribedBy"
            @onchange="OnChangeAsync"
            @onfocus="HandleFocusAsync"
            @onblur="HandleBlurAsync"
            @attributes="AdditionalAttributesFiltered">
        @if (!string.IsNullOrEmpty(Placeholder))
        {
            <option value="" disabled="@(!AllowClear)" hidden="@(!AllowClear && Value is not null)" selected="@(Value is null)">@Placeholder</option>
        }
        @if (IsEnumMode)
        {
            @foreach (var item in EnumItems)
            {
                <option value="@item.GetKey(EnumKeyMode)"
                        selected="@IsEnumItemSelected(item)"
                        title="@item.Description">@item.Label</option>
            }
        }
        else
        {
            @foreach (var item in Items)
            {
                var key = KeyFrom(item);
                <option value="@key" selected="@IsSelected(item)">@LabelFrom(item)</option>
            }
        }
    </select>

    @if (HasError)
    {
        <span id="@($"{EffectiveId}-err")" class="sgc-error">@DisplayedError</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@($"{EffectiveId}-hint")" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private List<SgEnumItem>? _enumItems;
    private Type? _lastEnumType;

    [Parameter] public IEnumerable<TValue> Items { get; set; } = Array.Empty<TValue>();
    [Parameter] public Type? EnumType { get; set; }
    [Parameter] public SgEnumKeyMode EnumKeyMode { get; set; } = SgEnumKeyMode.Name;
    [Parameter] public Func<TValue, string>? LabelSelector { get; set; }
    [Parameter] public Func<TValue, object>? ValueSelector { get; set; }
    [Parameter] public SgLabelPosition LabelPosition { get; set; } = SgLabelPosition.Top;
    [Parameter] public bool AllowClear { get; set; }
    [Parameter] public bool Block { get; set; } = true;
    [Parameter] public string? CssClass { get; set; }

    protected override string ComponentPrefix => "sel";

    private bool IsEnumMode => _enumItems is not null;
    private List<SgEnumItem> EnumItems => _enumItems ?? [];
    private string? DisplayedError => !string.IsNullOrEmpty(ErrorText) ? ErrorText : ValidationMessages.FirstOrDefault();
    private string? DescribedBy => HasError ? $"{EffectiveId}-err" : (!string.IsNullOrEmpty(Hint) ? $"{EffectiveId}-hint" : null);
    private string ValueString => Value is null ? string.Empty : KeyFrom(Value);

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (EnumType is not null && EnumType != _lastEnumType)
        {
            _lastEnumType = EnumType;
            _enumItems = SgEnumHelper.GetItems(EnumType);
        }
        else if (EnumType is null)
        {
            _enumItems = null;
            _lastEnumType = null;
        }
    }

    private string GetFieldClasses() => Css("sgc-field")
        .AddIf("sgc-block", Block)
        .AddEnum(LabelPosition, "sgc-label-")
        .Add(CssClass)
        .Add(Class)
        .ToString();

    private string GetSelectClasses() => Css("sgc-select")
        .AddIf("sgc-invalid", HasError)
        .ToString();

    private string LabelFrom(TValue value)
    {
        if (LabelSelector is not null)
            return LabelSelector(value);

        if (IsEnumMode)
        {
            var key = value?.ToString() ?? string.Empty;
            var item = _enumItems!.FirstOrDefault(x => x.Name == key || x.IntValue.ToString() == key);
            return item?.Label ?? key;
        }

        return value?.ToString() ?? string.Empty;
    }

    private string KeyFrom(TValue value)
    {
        if (IsEnumMode)
        {
            var key = value?.ToString() ?? string.Empty;
            var item = _enumItems!.FirstOrDefault(x => x.Name == key || x.IntValue.ToString() == key);
            return item?.GetKey(EnumKeyMode) ?? key;
        }

        return (ValueSelector is not null ? ValueSelector(value) : value)?.ToString() ?? string.Empty;
    }

    private bool IsSelected(TValue value) => EqualityComparer<TValue>.Default.Equals(value, Value!);

    private bool IsEnumItemSelected(SgEnumItem item)
    {
        if (Value is null) return false;

        var valueText = Value.ToString() ?? string.Empty;
        return item.Name == valueText || item.IntValue.ToString() == valueText;
    }

    private async Task OnChangeAsync(ChangeEventArgs e)
    {
        var key = e.Value?.ToString();
        TValue? next = default;

        if (!string.IsNullOrEmpty(key))
        {
            if (IsEnumMode)
            {
                var item = _enumItems!.FirstOrDefault(x => x.GetKey(EnumKeyMode) == key);
                if (item is not null)
                    next = ParseEnumValue(item);
            }
            else
            {
                foreach (var item in Items)
                {
                    if (KeyFrom(item) == key)
                    {
                        next = item;
                        break;
                    }
                }
            }
        }

        await SetValueAsync(next);
    }

    private TValue? ParseEnumValue(SgEnumItem item)
    {
        var target = typeof(TValue);
        var underlying = Nullable.GetUnderlyingType(target) ?? target;

        try
        {
            if (underlying == typeof(string))
                return (TValue)(object)(EnumKeyMode == SgEnumKeyMode.IntValue ? item.IntValue.ToString() : item.Name);

            if (underlying == typeof(int))
                return (TValue)(object)item.IntValue;

            if (underlying.IsEnum)
                return (TValue)Enum.Parse(underlying, item.Name);
        }
        catch
        {
        }

        return default;
    }

    protected override IReadOnlyDictionary<string, object> BuildAriaAttributes()
    {
        return new AriaBuilder()
            .Label(Label)
            .Required(Required)
            .Invalid(HasError)
            .Disabled(Disabled)
            .Build();
    }
}
