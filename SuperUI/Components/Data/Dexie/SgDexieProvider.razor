@namespace SuperUI.Components.Data.Dexie
@using SuperUI.Services.Data
@inject SgDexieService DexieService

<CascadingValue Value="this" IsFixed="true">
    @if (_isInitialized)
    {
        @ChildContent
    }
    else
    {
        <div class="sg-dexie-loading">
            <SgSpinner Size="SgSize.Md" />
            <span>Инициализация базы данных @DbName...</span>
        </div>
    }
</CascadingValue>

@code {
    /// <summary>The name of the IndexedDB database.</summary>
    [Parameter] public string DbName { get; set; } = "SuperUIDB";
    /// <summary>The database schema defining table names and their index definitions.</summary>
    [Parameter] public Dictionary<string, string> Schema { get; set; } = new();
    /// <summary>The content rendered after the database is initialized.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Fired when the IndexedDB database has been initialized.</summary>
    [Parameter] public new EventCallback OnInitialized { get; set; }

    private bool _isInitialized;

    /// <summary>Gets the underlying Dexie service used for database operations.</summary>
    public SgDexieService Service => DexieService;

    protected override async Task OnInitializedAsync()
    {
        if (Schema.Count > 0)
        {
            await DexieService.InitializeAsync(DbName, Schema);
            _isInitialized = true;
            await OnInitialized.InvokeAsync();
        }
    }

    /// <summary>Adds an item to the specified table.</summary>
    public async Task AddAsync<T>(string tableName, T item) => await DexieService.AddAsync(DbName, tableName, item);
    /// <summary>Adds multiple items to the specified table in a single transaction.</summary>
    public async Task BulkAddAsync<T>(string tableName, IEnumerable<T> items) => await DexieService.BulkAddAsync(DbName, tableName, items);
    /// <summary>Puts (inserts or updates) an item in the specified table.</summary>
    public async Task PutAsync<T>(string tableName, T item) => await DexieService.PutAsync(DbName, tableName, item);
    /// <summary>Gets an item by its ID from the specified table.</summary>
    public async Task<T?> GetAsync<T>(string tableName, object id) => await DexieService.GetAsync<T>(DbName, tableName, id);
    /// <summary>Gets all items from the specified table.</summary>
    public async Task<List<T>> GetAllAsync<T>(string tableName) => await DexieService.GetAllAsync<T>(DbName, tableName);
    /// <summary>Queries items from the specified table with an optional filter.</summary>
    public async Task<List<T>> QueryAsync<T>(string tableName, object? filter = null) => await DexieService.QueryAsync<T>(DbName, tableName, filter);
    /// <summary>Deletes an item by its ID from the specified table.</summary>
    public async Task DeleteAsync(string tableName, object id) => await DexieService.DeleteAsync(DbName, tableName, id);
    /// <summary>Clears all items from the specified table.</summary>
    public async Task ClearTableAsync(string tableName) => await DexieService.ClearTableAsync(DbName, tableName);
}

<style>
    .sg-dexie-loading {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px;
        gap: 16px;
        color: var(--sg-fg-muted);
    }
</style>
