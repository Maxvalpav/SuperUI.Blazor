@namespace SuperUI.Components
@typeparam TItem

<div class="sg-virtual-list-container @CssClass" 
     role="list"
     @ref="_container" 
     style="height: @Height; overflow-y: auto; position: relative;">
    <div class="sg-virtual-list-sentinel sg-virtual-list-sentinel-top"
         aria-hidden="true"
         @ref="_topSentinel"
         style="position: absolute; top: 0; left: 0; width: 1px; height: 1px;"></div>
    <div class="sg-virtual-list-phantom" style="height: @(GetTotalHeight())px; width: 100%;" aria-hidden="true"></div>
    <div class="sg-virtual-list-content" style="position: absolute; top: 0; left: 0; right: 0;">
        @foreach (var item in GetVisibleItems())
        {
            <div class="sg-virtual-list-item"
                 role="listitem"
                 data-index="@item.Index"
                 @key="GetItemRenderKey(item.Item, item.Index)"
                 style="@GetItemStyle(item.Index)">
                @ChildContent?.Invoke(item.Item)
            </div>
        }
    </div>
    <div class="sg-virtual-list-sentinel sg-virtual-list-sentinel-bottom"
         aria-hidden="true"
         @ref="_bottomSentinel"
         style="position: absolute; top: @(Math.Max(0, GetTotalHeight() - 1))px; left: 0; width: 1px; height: 1px;"></div>
</div>
