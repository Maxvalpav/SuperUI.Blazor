@namespace SuperUI.Components
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer
@typeparam TItem

<div class="sgc-pivot-designer @CssClass">
    <div class="sgc-pivot-designer-header">
        <span>@Localizer["PivotDesigner_Title"]</span>
        @if (AllowCollapse)
        {
            <button type="button" class="sgc-pivot-designer-toggle" @onclick="ToggleCollapsed">
                @(_isCollapsed ? Localizer["Expand"] : Localizer["Collapse"])
            </button>
        }
    </div>

    @if (!_isCollapsed)
    {
    <div class="sgc-pivot-designer-section">
        <div class="sgc-pivot-designer-label">@Localizer["PivotDesigner_AvailableFields"]</div>
        <div class="sgc-pivot-designer-search">
            <SgTextBox TValue="string" Placeholder="@Localizer["PivotDesigner_SearchFields"]" Value="@_searchText" ValueChanged="@OnSearchChanged" Size="SgSize.Sm" />
        </div>
        <div class="sgc-pivot-field-list">
            @foreach (var field in Fields.Where(f => !State.RowFields.Contains(f) && !State.ColumnFields.Contains(f) && !State.ValueFields.Contains(f) && (string.IsNullOrEmpty(_searchText) || f.Label.Contains(_searchText, StringComparison.OrdinalIgnoreCase))))
            {
                <div class="sgc-pivot-field-item">
                    <span>@field.Label</span>
                    <div class="sgc-pivot-field-actions">
                        <button type="button" @onclick="() => AddToRows(field)" title="@Localizer["PivotDesigner_ToRows"]">R</button>
                        <button type="button" @onclick="() => AddToCols(field)" title="@Localizer["PivotDesigner_ToColumns"]">C</button>
                        <button type="button" @onclick="() => AddToValues(field)" title="@Localizer["PivotDesigner_ToValues"]">Σ</button>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="sgc-pivot-designer-grid">
        <div class="sgc-pivot-designer-section">
            <div class="sgc-pivot-designer-label">@Localizer["PivotDesigner_Rows"]</div>
            <div class="sgc-pivot-field-list sgc-active-list">
                @foreach (var field in State.RowFields)
                {
                    <div class="sgc-pivot-field-item sgc-active-field">
                        <span @onclick="() => ShowFilter(field)" class="sgc-filter-trigger" title="@Localizer["PivotDesigner_Filter_Tooltip"]">
                            @((MarkupString)SgIcons.Search)
                        </span>
                        <span class="sgc-label">@field.Label</span>
                        <button type="button" class="sgc-remove" aria-label="@Localizer["Remove"]" @onclick="() => RemoveField(field, State.RowFields)">
                            @((MarkupString)SgIcons.X)
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="sgc-pivot-designer-section">
            <div class="sgc-pivot-designer-label">@Localizer["PivotDesigner_Columns"]</div>
            <div class="sgc-pivot-field-list sgc-active-list">
                @foreach (var field in State.ColumnFields)
                {
                    <div class="sgc-pivot-field-item sgc-active-field">
                        <span @onclick="() => ShowFilter(field)" class="sgc-filter-trigger" title="@Localizer["PivotDesigner_Filter_Tooltip"]">
                            @((MarkupString)SgIcons.Search)
                        </span>
                        <span class="sgc-label">@field.Label</span>
                        <button type="button" class="sgc-remove" aria-label="@Localizer["Remove"]" @onclick="() => RemoveField(field, State.ColumnFields)">
                            @((MarkupString)SgIcons.X)
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="sgc-pivot-designer-section">
            <div class="sgc-pivot-designer-label">@Localizer["PivotDesigner_Values"]</div>
            <div class="sgc-pivot-field-list sgc-active-list">
                @foreach (var field in State.ValueFields)
                {
                    <div class="sgc-pivot-field-item sgc-active-field sgc-value-field">
                        <div class="sgc-value-field-content">
                            <span class="sgc-label" title="@field.Label">@field.Label</span>
                            <div class="sgc-aggr-badge">
                                <select class="sgc-aggr-select" @onchange="@(e => UpdateAggr(field, e))">
                                    <option value="@SgPivotAggregateType.Sum" selected="@(field.AggregateType == SgPivotAggregateType.Sum)">@Localizer["DataGrid_AggregateSum"]</option>
                                    <option value="@SgPivotAggregateType.Count" selected="@(field.AggregateType == SgPivotAggregateType.Count)">@Localizer["DataGrid_AggregateCount"]</option>
                                    <option value="@SgPivotAggregateType.Average" selected="@(field.AggregateType == SgPivotAggregateType.Average)">@Localizer["DataGrid_AggregateAverage"]</option>
                                    <option value="@SgPivotAggregateType.Min" selected="@(field.AggregateType == SgPivotAggregateType.Min)">@Localizer["DataGrid_AggregateMin"]</option>
                                    <option value="@SgPivotAggregateType.Max" selected="@(field.AggregateType == SgPivotAggregateType.Max)">@Localizer["DataGrid_AggregateMax"]</option>
                                </select>
                            </div>
                        </div>
                        <button type="button" class="sgc-remove" aria-label="@Localizer["Remove"]" @onclick="() => RemoveField(field, State.ValueFields)">
                            @((MarkupString)SgIcons.X)
                        </button>
                    </div>
                }
            </div>
        </div>

        @if (_filterField != null)
        {
            <div class="sgc-pivot-filter-overlay" @onclick="() => _filterField = null">
                <div class="sgc-pivot-filter-popup" @onclick:stopPropagation>
                    <div class="sgc-pivot-filter-header">
                        <span>@Localizer.GetString("PivotDesigner_Filter", _filterField.Label)</span>
                        <button type="button" aria-label="@Localizer["Close"]" @onclick="() => _filterField = null">@((MarkupString)SgIcons.X)</button>
                    </div>
                    <div class="sgc-pivot-filter-body">
                        <div class="sgc-pivot-filter-actions">
                            <button type="button" @onclick="SelectAll">@Localizer["PivotDesigner_SelectAll"]</button>
                            <button type="button" @onclick="ClearAll">@Localizer["PivotDesigner_ClearAll"]</button>
                        </div>
                        <div class="sgc-pivot-filter-list">
                            @foreach (var val in GetUniqueValues(_filterField))
                            {
                                <label class="sgc-pivot-filter-item">
                                    <input type="checkbox" 
                                           checked="@(!_filterField.ExcludedValues.Contains(val))" 
                                           @onchange="@(e => ToggleFilter(val, e))" />
                                    <span>@val</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public SgPivotState<TItem> State { get; set; } = default!;
    [Parameter, EditorRequired] public List<SgPivotField<TItem>> Fields { get; set; } = new();
    [Parameter, EditorRequired] public IEnumerable<TItem> Items { get; set; } = Enumerable.Empty<TItem>();
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool AllowCollapse { get; set; } = true;
    [Parameter] public bool InitiallyCollapsed { get; set; }

    private bool _isCollapsed;
    private string _searchText = "";
    private SgPivotField<TItem>? _filterField;

    protected override void OnInitialized()
    {
        _isCollapsed = InitiallyCollapsed;
    }

    private void OnSearchChanged(string val) => _searchText = val;

    private void AddToRows(SgPivotField<TItem> f) 
    { 
        RemoveFromAll(f);
        State.RowFields.Add(f); 
        State.NotifyChanged(); 
        StateHasChanged(); 
    }
    private void AddToCols(SgPivotField<TItem> f) 
    { 
        RemoveFromAll(f);
        State.ColumnFields.Add(f); 
        State.NotifyChanged(); 
        StateHasChanged(); 
    }
    private void AddToValues(SgPivotField<TItem> f) 
    { 
        RemoveFromAll(f);
        State.ValueFields.Add(f); 
        State.NotifyChanged(); 
        StateHasChanged(); 
    }

    private void RemoveFromAll(SgPivotField<TItem> f)
    {
        State.RowFields.Remove(f);
        State.ColumnFields.Remove(f);
        State.ValueFields.Remove(f);
    }

    private void RemoveField(SgPivotField<TItem> f, List<SgPivotField<TItem>> list) 
    { 
        list.Remove(f); 
        State.NotifyChanged(); 
        StateHasChanged(); 
    }
    private void ToggleCollapsed() => _isCollapsed = !_isCollapsed;
    
    private void UpdateAggr(SgPivotField<TItem> f, ChangeEventArgs e) 
    { 
        if (Enum.TryParse<SgPivotAggregateType>(e.Value?.ToString(), out var res))
        {
            f.AggregateType = res;
            State.NotifyChanged();
        }
    }

    private void ShowFilter(SgPivotField<TItem> f) => _filterField = f;

    private List<string> GetUniqueValues(SgPivotField<TItem> f) => 
        Items.Select(f.Selector).Where(v => v != null).Select(v => v!.ToString()!).Distinct().OrderBy(x => x).ToList();

    private void ToggleFilter(string val, ChangeEventArgs e)
    {
        if (_filterField == null) return;
        bool isChecked = (bool)(e.Value ?? true);
        if (isChecked) _filterField.ExcludedValues.Remove(val);
        else _filterField.ExcludedValues.Add(val);
        State.NotifyChanged();
    }

    private void SelectAll() { _filterField?.ExcludedValues.Clear(); State.NotifyChanged(); }
    private void ClearAll() 
    { 
        if (_filterField == null) return;
        foreach (var v in GetUniqueValues(_filterField)) _filterField.ExcludedValues.Add(v);
        State.NotifyChanged();
    }
}
