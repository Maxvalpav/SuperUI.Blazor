@namespace SuperUI.Components
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer
@inject IJSRuntime JS

<div class="sg-pager sg-pager-@SizeClass @PagerAlignmentClass @CssClass">
    @if (ShowInfo)
    {
        <div class="sg-pager-info">
            @{
                var startRow = (Page - 1) * PageSize + 1;
                var endRow = Math.Min(Page * PageSize, TotalItems);
                if (TotalItems == 0) startRow = 0;
            }
            @startRow-@endRow @Localizer["Table_Of"] @TotalItems

            @if (SelectedCount > 0)
            {
                <span class="sg-pager-selected">
                    @Localizer["Selected"]: @SelectedCount
                </span>
            }
        </div>
    }

    @if (PageSizeOptions?.Any() == true)
    {
        <div class="sg-pager-size">
            <select value="@PageSize" @onchange="OnPageSizeChangedAsync">
                @foreach (var size in PageSizeOptions)
                {
                    <option value="@size">@size</option>
                }
            </select>
        </div>
    }

    @if (Simple)
    {
        <button class="sg-page-btn" type="button" disabled="@(Page <= 1)" @onclick="() => GoAsync(Page - 1)" title="@Localizer["Previous"]">‹</button>
        <span class="sg-page-simple-info">
            <span class="sg-page-simple-current">@Page</span>
            <span class="sg-page-simple-sep">/</span>
            <span class="sg-page-simple-total">@TotalPages</span>
        </span>
        <button class="sg-page-btn" type="button" disabled="@(Page >= TotalPages)" @onclick="() => GoAsync(Page + 1)" title="@Localizer["Next"]">›</button>
    }
    else
    {
        @if (ShowFirstLast)
        {
            <button class="sg-page-btn" type="button" disabled="@(Page <= 1)" @onclick="() => GoAsync(1)" title="@Localizer["First"]">«</button>
        }
        <button class="sg-page-btn" type="button" disabled="@(Page <= 1)" @onclick="() => GoAsync(Page - 1)" title="@Localizer["Previous"]">‹</button>

        @foreach (var p in BuildPages())
        {
            if (p < 0)
            {
                <span class="sg-page-gap">...</span>
            }
            else
            {
                var pl = p;
                <button class="sg-page-btn @(pl == Page ? "current" : "")"
                        type="button" @onclick="() => GoAsync(pl)">
                    <span class="sg-page-btn-text">@pl</span>
                </button>
            }
        }

        <button class="sg-page-btn" type="button" disabled="@(Page >= TotalPages)" @onclick="() => GoAsync(Page + 1)" title="@Localizer["Next"]">›</button>
        @if (ShowFirstLast)
        {
            <button class="sg-page-btn" type="button" disabled="@(Page >= TotalPages)" @onclick="() => GoAsync(TotalPages)" title="@Localizer["Last"]">»</button>
        }
    }

    @if (ShowJump)
    {
        <div class="sg-pager-jump">
            <span>@Localizer["GoTo"]</span>
            <input type="number"
                   class="sg-pager-input"
                   value="@Page"
                   @onchange="OnJumpChanged"
                   min="1" max="@TotalPages" />
        </div>
    }
</div>

@code {
    /// <summary>
    /// Gets or sets the total number of items across all pages.
    /// </summary>
    [Parameter] public int TotalItems { get; set; }

    /// <summary>
    /// Gets or sets the number of items per page. Default is 25.
    /// </summary>
    [Parameter] public int PageSize { get; set; } = 25;

    /// <summary>
    /// Gets or sets the current page number (1-based). Supports two-way binding.
    /// </summary>
    [Parameter] public int Page { get; set; } = 1;

    /// <summary>
    /// Gets or sets the callback invoked when the page changes.
    /// </summary>
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    /// <summary>
    /// Gets or sets the number of sibling page buttons to show on each side of the current page. Default is 1.
    /// </summary>
    [Parameter] public int Siblings { get; set; } = 1;

    /// <summary>
    /// Gets or sets whether to show info text (e.g. "1-10 of 100"). Default is true.
    /// </summary>
    [Parameter] public bool ShowInfo { get; set; } = true;

    /// <summary>
    /// Gets or sets the number of selected items displayed in the info bar.
    /// </summary>
    [Parameter] public int SelectedCount { get; set; }

    /// <summary>
    /// Gets or sets whether to show the jump-to-page input.
    /// </summary>
    [Parameter] public bool ShowJump { get; set; }

    /// <summary>
    /// Gets or sets whether to scroll to top on page change.
    /// </summary>
    [Parameter] public bool ScrollToTop { get; set; }

    /// <summary>
    /// Gets or sets the available page size options displayed as a dropdown.
    /// </summary>
    [Parameter] public IEnumerable<int>? PageSizeOptions { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the page size changes.
    /// </summary>
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    /// <summary>
    /// Gets or sets whether to use compact "prev / next" mode instead of full page buttons.
    /// </summary>
    [Parameter] public bool Simple { get; set; }

    /// <summary>
    /// Gets or sets the size of the pagination controls. Default is <see cref="SgSize.Md"/>.
    /// </summary>
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;

    /// <summary>
    /// Gets or sets whether to show the first and last page buttons. Default is true.
    /// </summary>
    [Parameter] public bool ShowFirstLast { get; set; } = true;

    /// <summary>
    /// Gets or sets the horizontal alignment of the pagination controls. Default is <see cref="SgJustifyContent.Start"/>.
    /// </summary>
    [Parameter] public SgJustifyContent Alignment { get; set; } = SgJustifyContent.Start;

    /// <summary>
    /// Gets or sets additional CSS classes to apply to the component.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    private string SizeClass => Size switch
    {
        SgSize.Sm => "sm",
        SgSize.Lg => "lg",
        _ => "md"
    };

    private string PagerAlignmentClass => Alignment switch
    {
        SgJustifyContent.Center => "sg-pager-center",
        SgJustifyContent.End => "sg-pager-end",
        _ => ""
    };

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalItems / Math.Max(1, PageSize)));

    private async Task GoAsync(int p)
    {
        p = Math.Max(1, Math.Min(TotalPages, p));
        if (p == Page) return;
        Page = p;
        if (PageChanged.HasDelegate) await PageChanged.InvokeAsync(p);

        if (ScrollToTop)
        {
            try { await JS.InvokeVoidAsync("window.scrollTo", 0, 0); }
            catch { }
        }
    }

    private async Task OnJumpChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var p))
            await GoAsync(p);
    }

    private async Task OnPageSizeChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
        {
            PageSize = size;
            if (PageSizeChanged.HasDelegate) await PageSizeChanged.InvokeAsync(size);
            await GoAsync(1);
        }
    }

    private IEnumerable<int> BuildPages()
    {
        var total = TotalPages;
        var current = Page;
        var window = Siblings > 0 ? Siblings : 2;

        if (total <= 7)
        {
            for (int i = 1; i <= total; i++) yield return i;
            yield break;
        }

        yield return 1;

        int start = Math.Max(2, current - window);
        int end = Math.Min(total - 1, current + window);

        if (start > 2) yield return -1;

        for (int i = start; i <= end; i++) yield return i;

        if (end < total - 1) yield return -2;

        yield return total;
    }
}

