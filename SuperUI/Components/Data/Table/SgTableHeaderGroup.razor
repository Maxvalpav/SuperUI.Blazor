@namespace SuperUI.Components
@typeparam TItem
@implements IDisposable

@code {
    [CascadingParameter] private SgTable<TItem>? Table { get; set; }
    /// <summary>The display title of the header group.</summary>
    [Parameter] public string Title { get; set; } = string.Empty;
    /// <summary>The number of columns this header group spans.</summary>
    [Parameter] public int ColumnCount { get; set; } = 1;

    protected override void OnInitialized()
    {
        Table?.RegisterHeaderGroup(this);
    }

    /// <summary>Unregisters this header group from the owning table.</summary>
    public void Dispose()
    {
        Table?.UnregisterHeaderGroup(this);
    }
}
