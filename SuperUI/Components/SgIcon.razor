@namespace SuperUI.Components

<span class="sgc-icon @CssClass" style="@GetStyle()" aria-hidden="true">
    @((MarkupString)Icon)
</span>

@code {
    /// <summary>SVG markup of the icon.</summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = "";

    /// <summary>Size of the icon (e.g., "16px").</summary>
    [Parameter] public string? Size { get; set; }

    /// <summary>Color of the icon (CSS color).</summary>
    [Parameter] public string? Color { get; set; }

    /// <summary>Additional CSS classes.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Additional inline styles.</summary>
    [Parameter] public string? Style { get; set; }

    private string GetStyle()
    {
        var styles = new List<string>();
        if (!string.IsNullOrEmpty(Size))
        {
            styles.Add($"width: {Size}");
            styles.Add($"height: {Size}");
            styles.Add($"display: inline-flex");
            styles.Add($"align-items: center");
            styles.Add($"justify-content: center");
        }
        if (!string.IsNullOrEmpty(Color)) styles.Add($"color: {Color}");
        if (!string.IsNullOrEmpty(Style)) styles.Add(Style);
        return string.Join("; ", styles);
    }
}
