@namespace SuperUI.Components
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ISuperUILocalizer Localizer
@using SuperUI.Enums

<div class="sg-three-container @CssClass"
     style="height: @Height; width: @Width;"
     @attributes="AdditionalAttributes">

    @if (_error is not null)
    {
        <div class="sg-three-error" role="alert">
            <p>@_error</p>
            <button type="button" class="sg-btn" @onclick="RetryAsync">@Localizer["Three_Retry"]</button>
        </div>
    }
    else
    {
        @if (ShowToolbar && _ready)
        {
            <div class="sg-three-toolbar" role="toolbar">
                <button type="button" class="sg-three-tool" title="@Localizer["Three_ResetCamera"]"
                        @onclick="ResetCameraAsync" aria-label="@Localizer["Three_ResetCamera"]">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path fill="currentColor" d="M8 3a5 5 0 1 1 1.46 3.54l1-1A3.5 3.5 0 1 0 9.5 3H8V1L6 3.5 8 6V3Z"/>
                    </svg>
                </button>
                <button type="button" class="sg-three-tool" title="@Localizer["Three_Screenshot"]"
                        @onclick="TakeScreenshotAsync" aria-label="@Localizer["Three_Screenshot"]">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path fill="currentColor" d="M8 1v8.6L5.7 7.3 4.3 8.7 8 12.4l3.7-3.7-1.4-1.4L9 9.6V1H8Zm-6 12h12v2H2v-2Z"/>
                    </svg>
                </button>
            </div>
        }

        <div @ref="_containerRef"
             class="sg-three-canvas"
             style="@(_ready ? null : "visibility:hidden;")"></div>

        @if (!_ready)
        {
            <div class="sg-three-loading" aria-live="polite">
                <div class="sg-three-skeleton">
                    <span></span><span></span><span></span><span></span><span></span>
                </div>
                <span class="sg-three-loading-text">@Localizer["Three_Loading"]</span>
            </div>
        }
    }
</div>

@code {
    private ElementReference _containerRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SgThree>? _selfRef;
    private readonly string _instanceId = $"sg-three-{Guid.NewGuid():N}";
    private bool _ready;
    private string? _error;
    private bool _isDisposed;

    // Change-detection snapshots
    private SgThreeScene _lastScene;
    private object? _lastOptsRef;
    private object? _lastLayoutRef;
    private object? _lastBarRef;
    private bool _refreshScheduled;
    private bool _refreshPending;

    // ── Parameters ────────────────────────────────────────────────────────────

    /// <summary>Built-in scene preset. Default <see cref="SgThreeScene.RotatingCube"/>.</summary>
    [Parameter] public SgThreeScene Scene { get; set; } = SgThreeScene.RotatingCube;

    /// <summary>Renderer and scene options.</summary>
    [Parameter] public SgThreeOptions? Options { get; set; }

    /// <summary>Warehouse layout data (used when <see cref="Scene"/> is <see cref="SgThreeScene.Warehouse"/>).</summary>
    [Parameter] public SgWarehouseLayout? WarehouseLayout { get; set; }

    /// <summary>Bar data (used when <see cref="Scene"/> is <see cref="SgThreeScene.BarChart3D"/>).</summary>
    [Parameter] public IEnumerable<SgThreeBarItem>? BarData { get; set; }

    /// <summary>Container height. Default "500px".</summary>
    [Parameter] public string Height { get; set; } = "500px";

    /// <summary>Container width. Default "100%".</summary>
    [Parameter] public string Width { get; set; } = "100%";

    /// <summary>Show built-in toolbar (reset camera, screenshot).</summary>
    [Parameter] public bool ShowToolbar { get; set; } = true;

    /// <summary>Three.js source URL override.</summary>
    [Parameter] public SgThreeSources? Sources { get; set; }

    /// <summary>Additional CSS class for the container.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Fired when the user clicks a 3-D object.</summary>
    [Parameter] public EventCallback<SgThreeClickEventArgs> OnObjectClick { get; set; }
    /// <summary>Captures unmatched HTML attributes passed to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override void OnParametersSet()
    {
        if (!_ready) return;
        var changed =
            Scene != _lastScene ||
            !ReferenceEquals(Options,         _lastOptsRef)   ||
            !ReferenceEquals(WarehouseLayout, _lastLayoutRef) ||
            !ReferenceEquals(BarData,         _lastBarRef);

        if (changed && !_refreshScheduled)
        {
            _refreshScheduled = true;
            _ = ScheduleRefreshAsync();
        }
    }

    private async Task ScheduleRefreshAsync()
    {
        try   { await RefreshAsync(); }
        finally
        {
            _refreshScheduled = false;
            if (_refreshPending)
            {
                _refreshPending   = false;
                _refreshScheduled = true;
                _ = ScheduleRefreshAsync();
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isDisposed || !firstRender) return;
        try
        {
            _module  = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/sg-three.js");
            if (_isDisposed) return;
            _selfRef = DotNetObjectReference.Create(this);
            await InitAsync();
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch (Exception ex)
        {
            _error = $"{Localizer["Three_FailedToLoad"]}: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task InitAsync()
    {
        if (_module is null || _selfRef is null) return;
        try
        {
            var opts    = BuildOpts();
            var layout  = WarehouseLayout;
            var barData = BarData?.ToList();
            await _module.InvokeVoidAsync("initThree",
                _selfRef, _containerRef, _instanceId,
                Scene.ToString(), opts, layout, barData,
                Sources ?? new SgThreeSources());
            CaptureSnapshot();
            _ready = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch (Exception ex)
        {
            _error = $"{Localizer["Three_FailedToInitialize"]}: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CaptureSnapshot()
    {
        _lastScene     = Scene;
        _lastOptsRef   = Options;
        _lastLayoutRef = WarehouseLayout;
        _lastBarRef    = BarData;
    }

    private object BuildOpts()
    {
        var o = Options ?? new SgThreeOptions();
        return new
        {
            backgroundColor      = o.BackgroundColor,
            orbitControls        = o.OrbitControls,
            autoRotate           = o.AutoRotate,
            autoRotateSpeed      = o.AutoRotateSpeed,
            showAxes             = o.ShowAxes,
            showGrid             = o.ShowGrid,
            shadows              = o.Shadows,
            ambientIntensity     = o.AmbientIntensity,
            directionalIntensity = o.DirectionalIntensity,
            cameraType           = o.CameraType.ToString(),
            fov                  = o.Fov,
            cameraPosition       = o.CameraPosition,
            maxPixelRatio        = o.MaxPixelRatio,
            antialias            = o.Antialias,
            exposure             = o.Exposure,
        };
    }

    // ── Public methods ────────────────────────────────────────────────────────

    /// <summary>Rebuilds the scene with current parameters.</summary>
    public async Task RefreshAsync()
    {
        if (_module is null || !_ready) { _refreshPending = true; return; }
        try
        {
            // Full reinit — Three.js scenes are not easily hot-swappable
            _ready = false;
            await InvokeAsync(StateHasChanged);
            var opts    = BuildOpts();
            var layout  = WarehouseLayout;
            var barData = BarData?.ToList();
            await _module.InvokeVoidAsync("initThree",
                _selfRef, _containerRef, _instanceId,
                Scene.ToString(), opts, layout, barData,
                Sources ?? new SgThreeSources());
            CaptureSnapshot();
            _ready = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch (Exception ex)
        {
            _error = $"{Localizer["Three_FailedToRefresh"]}: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Updates warehouse cell statuses without rebuilding the scene.</summary>
    public async Task UpdateWarehouseCellsAsync(IEnumerable<SgWarehouseCell> cells)
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("updateWarehouseCells", _instanceId, cells.ToList()); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch { }
    }

    /// <summary>Moves the camera to the specified world-space position.</summary>
    public async Task SetCameraPositionAsync(double x, double y, double z)
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("setCameraPosition", _instanceId, x, y, z); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch { }
    }

    /// <summary>Resets the camera to its initial position.</summary>
    public async Task ResetCameraAsync()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("resetCamera", _instanceId); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch { }
    }

    /// <summary>Downloads a PNG screenshot of the current frame.</summary>
    public async Task TakeScreenshotAsync()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("takeScreenshot", _instanceId); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch { }
    }

    /// <summary>Retries loading after an error.</summary>
    public async Task RetryAsync()
    {
        _error = null; _ready = false;
        await InvokeAsync(StateHasChanged);
        await InitAsync();
    }

    // ── JS callbacks ──────────────────────────────────────────────────────────

    [JSInvokable]
    public async Task OnObjectClickedAsync(SgThreeClickEventArgs args)
    {
        if (OnObjectClick.HasDelegate)
            await OnObjectClick.InvokeAsync(args);
    }

    // ── Dispose ───────────────────────────────────────────────────────────────

    public async ValueTask DisposeAsync()
    {
        if (_isDisposed) return;
        _isDisposed = true;

        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("disposeThree", _instanceId); }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException)   { }
            catch { }
        }

        var selfRef = _selfRef;
        _selfRef = null;
        selfRef?.Dispose();

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException)   { }
            catch { }
            _module = null;
        }
    }
}
