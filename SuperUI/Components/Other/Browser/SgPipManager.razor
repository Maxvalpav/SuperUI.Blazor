@namespace SuperUI.Components
@inherits SgJsComponentBase

<SgButton Text="@Text" OnClick="ToggleAsync" Variant="@Variant">
    <Icon>
        <SgIcon Icon="@SgIcons.Video" />
    </Icon>
</SgButton>

@code {
    [Parameter] public string VideoElementId { get; set; } = "";
    [Parameter] public string Text { get; set; } = "Картинка в картинке";
    [Parameter] public SgButtonVariant Variant { get; set; } = SgButtonVariant.Default;

    protected override string ModulePath => "./_content/SuperUI/superui-browser-features.js";

    private async Task ToggleAsync()
    {
        if (string.IsNullOrEmpty(VideoElementId)) return;
        await SafeInvokeVoidAsync("togglePip", VideoElementId);
    }
}
