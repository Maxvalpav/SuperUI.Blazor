@namespace SuperUI.Components
@inherits SgJsComponentBase

@code {
    protected override string ModulePath => "./_content/SuperUI/superui-browser-features.js";

    /// <summary>Shows a system notification.</summary>
    public async Task<bool> ShowAsync(string title, string body = "", string icon = "")
    {
        var options = new
        {
            body = body,
            icon = icon
        };
        return await SafeInvokeAsync<bool>("showNotification", title, options);
    }
}
