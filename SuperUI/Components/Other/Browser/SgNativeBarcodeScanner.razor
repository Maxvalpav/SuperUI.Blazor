@namespace SuperUI.Components
@inherits SgJsComponentBase
<div class="@Css("sgc-barcode-scanner").Build()" style="@Style">
    @if (!_isSupported)
    {
        <SgAlert Variant="SgAlertVariant.Warn" Title="API не поддерживается">
            Barcode Detector API не поддерживается вашим браузером. Требуется Chrome/Edge и включенные экспериментальные функции.
        </SgAlert>
    }

    <div style="position: relative; width: 100%; aspect-ratio: 4/3; background: #000; border-radius: 12px; overflow: hidden; margin-top: 12px;">
        <video id="@_videoId" autoplay playsinline style="width: 100%; height: 100%; object-fit: cover;"></video>
        
        @if (!_scanning)
        {
            <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.5);">
                <SgButton Text="@Localizer["Browser_EnableScanner"]" OnClick="StartAsync" Variant="SgButtonVariant.Primary" Disabled="!_isSupported" />
            </div>
        }
        else
        {
            <div style="position: absolute; inset: 0; border: 2px solid var(--sui-primary-color); opacity: 0.5; pointer-events: none; animation: scan-line 2s infinite linear;"></div>
            <div style="position: absolute; bottom: 12px; left: 12px; right: 12px; text-align: center;">
                <SgButton Text="@Localizer["Browser_StopScanner"]" OnClick="StopAsync" Variant="SgButtonVariant.Danger" Size="SgSize.Sm" />
            </div>
        }
    </div>
</div>

<style>
    @@keyframes scan-line {
        0% { border-top-width: 2px; border-bottom-width: 0; }
        50% { border-top-width: 0; border-bottom-width: 2px; }
        100% { border-top-width: 2px; border-bottom-width: 0; }
    }
</style>

@code {
    private readonly string _videoId = "b-" + Guid.NewGuid().ToString("N")[..8];
    private bool _scanning;
    private bool _isSupported = true;
    private BarcodeResult? _lastResult;
    private System.Threading.Timer? _timer;

    /// <summary>Fires when a barcode is detected from the camera feed.</summary>
    [Parameter] public EventCallback<BarcodeResult> OnDetected { get; set; }

    protected override string ModulePath => "./_content/SuperUI/superui-browser-features.js";

    protected override async ValueTask OnInteractiveAsync()
    {
        _isSupported = await SafeInvokeAsync<bool>("checkApiSupport", "BarcodeDetector");
        StateHasChanged();
    }

    private async Task StartAsync()
    {
        try 
        {
            if (!_isSupported) return;

            var success = await SafeInvokeAsync<bool>("setupCamera", _videoId);
            if (success)
            {
                _scanning = true;
                _timer = new System.Threading.Timer(async _ => await TickAsync(), null, 1000, 500);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task StopAsync()
    {
        await JS.InvokeVoidAsync("eval", $"const v = document.getElementById('{_videoId}'); if(v.srcObject) {{ v.srcObject.getTracks().forEach(t => t.stop()); v.srcObject = null; }}");
        _scanning = false;
        _timer?.Dispose();
        _timer = null;
        StateHasChanged();
    }

    private async Task TickAsync()
    {
        if (!_scanning || IsDisposed) return;

        var results = await SafeInvokeAsync<List<BarcodeResult>>("detectBarcodes", _videoId);
        if (IsDisposed || results == null || !results.Any()) return;
        _lastResult = results.First();
        await InvokeAsync(async () =>
        {
            if (IsDisposed) return;
            await OnDetected.InvokeAsync(_lastResult);
            StateHasChanged();
        });
    }

    public override async ValueTask DisposeAsync()
    {
        _scanning = false;
        _timer?.Dispose();
        await base.DisposeAsync();
    }

    /// <summary>Result from a native barcode detection operation.</summary>
    public class BarcodeResult
    {
        /// <summary>Decoded barcode value.</summary>
        public string RawValue { get; set; } = "";
        /// <summary>Barcode format (e.g. "qr_code", "ean_13").</summary>
        public string Format { get; set; } = "";
    }
}
