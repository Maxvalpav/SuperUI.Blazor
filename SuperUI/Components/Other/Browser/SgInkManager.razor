@namespace SuperUI.Components
@inherits SgJsComponentBase
<div class="@Css("sgc-ink-manager").Build()" style="@Style">
    <div style="background: var(--sui-bg-secondary); border-radius: 12px; border: 1px solid var(--sui-border-color); overflow: hidden;">
        <div style="padding: 12px; border-bottom: 1px solid var(--sui-border-color); display: flex; gap: 12px; align-items: center; background: var(--sui-bg-primary);">
            <input type="color" value="@_color" @onchange="OnColorChanged" style="width: 32px; height: 32px; border: none; padding: 0; background: none; cursor: pointer;" />
            <SgButton Text="@Localizer["Browser_InkClear"]" OnClick="ClearAsync" Variant="SgButtonVariant.Default" Size="SgSize.Sm" />
            <div style="font-size: 12px; color: var(--sui-fg-muted); margin-left: auto;">Ink API: Минимальная задержка</div>
        </div>
        <canvas id="@_canvasId" style="width: 100%; height: 400px; display: block; touch-action: none; cursor: crosshair; background: white;"></canvas>
    </div>
</div>

@code {
    private readonly string _canvasId = "ink-" + Guid.NewGuid().ToString("N")[..8];
    private string _color = "#000000";

    protected override string ModulePath => "./_content/SuperUI/superui-browser-features.js";

    protected override async ValueTask OnInteractiveAsync()
    {
        await SafeInvokeVoidAsync("setupInk", _canvasId, _color, 2);
    }

    private async Task OnColorChanged(ChangeEventArgs e)
    {
        _color = e.Value?.ToString() ?? "#000000";
        await SafeInvokeVoidAsync("updateInkSettings", _canvasId, _color, 2);
    }

    private async Task ClearAsync()
    {
        await JS.InvokeVoidAsync("eval", $"const c = document.getElementById('{_canvasId}'); c.getContext('2d').clearRect(0,0,c.width,c.height);");
    }
}
