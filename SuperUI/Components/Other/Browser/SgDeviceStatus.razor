@namespace SuperUI.Components
@inherits SgJsComponentBase

<div class="@Css("sgc-device-status").Build()" style="@Style">
    <div style="display: flex; gap: 16px;">
        @if (_battery != null)
        {
            <div class="sgc-status-chip">
                <div class="sgc-status-icon" style="color: @(GetBatteryColor())">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                        <rect x="1" y="6" width="18" height="12" rx="2"/>
                        <path d="M23 10v4"/>
                        @if (_battery.Charging) { <path d="M7 12l2 2 4-4" stroke-width="3"/> }
                    </svg>
                </div>
                <span>@Math.Round(_battery.Level)%</span>
            </div>
        }

        @if (_network != null)
        {
            <div class="sgc-status-chip">
                <div class="sgc-status-icon" style="color: var(--sui-primary-color)">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M5 12.55a11 11 0 0 1 14.08 0"/>
                        <path d="M1.42 9a16 16 0 0 1 21.16 0"/>
                        <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
                        <line x1="12" y1="20" x2="12.01" y2="20" stroke-width="4"/>
                    </svg>
                </div>
                <span>@_network.Type.ToUpper() (@_network.Downlink Мбит/с)</span>
            </div>
        }
    </div>
</div>

<style>
    .sgc-status-chip {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        background: var(--sui-bg-secondary);
        border: 1px solid var(--sui-border-color);
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }
    .sgc-status-icon {
        display: flex;
        align-items: center;
    }
</style>

@code {
    private BatteryInfo? _battery;
    private NetworkInfo? _network;

    protected override string ModulePath => "./_content/SuperUI/superui-browser-features.js";

    protected override async ValueTask OnInteractiveAsync()
    {
        await RefreshStatusAsync();
    }

    /// <summary>Refreshes battery and network status information.</summary>
    public async Task RefreshStatusAsync()
    {
        _battery = await SafeInvokeAsync<BatteryInfo>("getBatteryStatus");
        _network = await SafeInvokeAsync<NetworkInfo>("getNetworkStatus");
        StateHasChanged();
    }

    private string GetBatteryColor()
    {
        if (_battery == null) return "currentColor";
        if (_battery.Charging) return "var(--sui-success-color)";
        if (_battery.Level < 20) return "var(--sui-danger-color)";
        if (_battery.Level < 50) return "var(--sui-warning-color)";
        return "var(--sui-success-color)";
    }

    /// <summary>Represents the device battery status.</summary>
    public class BatteryInfo
    {
        /// <summary>Battery level as a percentage (0-100).</summary>
        public double Level { get; set; }
        /// <summary>Whether the battery is currently charging.</summary>
        public bool Charging { get; set; }
    }

    /// <summary>Represents the device network connection status.</summary>
    public class NetworkInfo
    {
        /// <summary>Network type (e.g. "wifi", "cellular", "ethernet").</summary>
        public string Type { get; set; } = "unknown";
        /// <summary>Downlink speed in Mbps.</summary>
        public double Downlink { get; set; }
    }
}
