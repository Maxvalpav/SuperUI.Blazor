@namespace SuperUI.Components
@inherits SgJsComponentBase
<div class="@Css("sgc-app-badge").Build()" style="@Style">
    <div style="padding: 16px; background: var(--sui-bg-secondary); border-radius: 12px; border: 1px solid var(--sui-border-color); display: flex; align-items: center; gap: 12px;">
        <SgTextBox TValue="int" @bind-Value="_badgeValue" Label="@Localizer["Browser_BadgeNumber"]" Style="width: 100px;" />
        <SgButton Text="@Localizer["Browser_InstallBadge"]" OnClick="SetBadgeAsync" Variant="SgButtonVariant.Primary" Size="SgSize.Sm" />
        <SgButton Text="@Localizer["Browser_Clear"]" OnClick="ClearBadgeAsync" Variant="SgButtonVariant.Default" Size="SgSize.Sm" />
    </div>
</div>

@code {
    private int _badgeValue = 5;

    protected override string ModulePath => "./_content/SuperUI/superui-browser-features.js";

    private async Task SetBadgeAsync()
    {
        await SafeInvokeVoidAsync("setAppBadge", _badgeValue);
    }

    private async Task ClearBadgeAsync()
    {
        await SafeInvokeVoidAsync("clearAppBadge");
    }
}
