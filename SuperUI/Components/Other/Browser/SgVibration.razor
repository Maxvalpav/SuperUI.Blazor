@namespace SuperUI.Components
@inherits SgJsComponentBase

<div class="@Css("sgc-vibration").Build()" style="@Style">
    <SgButton Variant="Variant" OnClick="VibrateAsync" Disabled="Disabled">
        <Icon><SgIcon Icon="@SgIcons.Activity" /></Icon>
        <ChildContent>
            @if (ShowText)
            {
                <span>@ButtonText</span>
            }
        </ChildContent>
    </SgButton>
</div>

@code {
    /// <summary>Button text label.</summary>
    [Parameter] public string ButtonText { get; set; } = "Вибрация";
    /// <summary>Whether the text label is shown.</summary>
    [Parameter] public bool ShowText { get; set; } = true;
    /// <summary>Whether the button is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Button variant style.</summary>
    [Parameter] public SgButtonVariant Variant { get; set; } = SgButtonVariant.Default;
    /// <summary>Vibration duration in milliseconds (used when no pattern is specified).</summary>
    [Parameter] public int Duration { get; set; } = 200;
    /// <summary>Vibration pattern as an array of on/off durations in milliseconds.</summary>
    [Parameter] public int[]? Pattern { get; set; }

    protected override string ModulePath => "./_content/SuperUI/superui-browser-features.js";

    private async Task VibrateAsync()
    {
        object pattern = Pattern ?? (object)Duration;
        await SafeInvokeAsync<bool>("vibrate", pattern);
    }
}
