@namespace SuperUI.Components
@inherits SgJsComponentBase

<div class="@Css("sgc-share-button").Build()" style="@Style">
    <SgButton Variant="Variant" OnClick="ShareAsync" Disabled="Disabled" Title="@Title">
        <Icon><SgIcon Icon="@SgIcons.Activity" /></Icon>
        <ChildContent>
            @if (ShowText)
            {
                <span>@ButtonText</span>
            }
        </ChildContent>
    </SgButton>
</div>

@code {
    [Parameter] public string ButtonText { get; set; } = "Поделиться";
    [Parameter] public bool ShowText { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public SgButtonVariant Variant { get; set; } = SgButtonVariant.Default;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? Url { get; set; }

    protected override string ModulePath => "./_content/SuperUI/superui-browser-features.js";

    private async Task ShareAsync()
    {
        var data = new
        {
            title = Title,
            text = Text,
            url = Url ?? ""
        };

        await SafeInvokeAsync<bool>("share", data);
    }
}
