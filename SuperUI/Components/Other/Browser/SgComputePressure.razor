@namespace SuperUI.Components
@inherits SgJsComponentBase

@*
    Compute Pressure API Component.
*@

@code {
    /// <summary>Fires when the system compute pressure state changes.</summary>
    [Parameter] public EventCallback<SgComputePressureState> OnPressureChanged { get; set; }

    protected override string ModulePath => "./_content/SuperUI/superui-browser-features.js";

    protected override async ValueTask OnInteractiveAsync()
    {
        await SafeInvokeVoidAsync("observeComputePressure", SelfRef);
    }

    [JSInvokable]
    public async Task HandlePressureChanged(IEnumerable<PressureRecord> records)
    {
        var lastRecord = records.LastOrDefault();
        if (lastRecord != null && Enum.TryParse<SgComputePressureState>(lastRecord.State, true, out var pressureState))
        {
            await OnPressureChanged.InvokeAsync(pressureState);
        }
    }

    [JSInvokable]
    public async Task OnPressureUpdate(string state)
    {
        if (Enum.TryParse<SgComputePressureState>(state, true, out var pressureState))
        {
            await OnPressureChanged.InvokeAsync(pressureState);
        }
    }

    /// <summary>Represents a compute pressure data record from the browser API.</summary>
    public class PressureRecord
    {
        /// <summary>Source of the pressure data (e.g. "cpu").</summary>
        public string Source { get; set; } = "";
        /// <summary>Pressure state value (e.g. "nominal", "fair", "serious", "critical").</summary>
        public string State { get; set; } = "";
    }
}
