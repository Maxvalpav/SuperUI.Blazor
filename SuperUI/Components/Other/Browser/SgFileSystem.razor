@namespace SuperUI.Components
@inherits SgJsComponentBase
<div class="@Css("sgc-file-system").Build()" style="@Style">
    <div style="display: flex; gap: 12px;">
        <SgButton Text="@Localizer["Browser_OpenFile"]" OnClick="OpenFileAsync">
            <Icon><SgIcon Icon="@SgIcons.Activity" /></Icon>
        </SgButton>
        <SgButton Text="@Localizer["Browser_SaveFile"]" OnClick="SaveFileAsync" Variant="SgButtonVariant.Primary" Disabled="@(string.IsNullOrEmpty(Content))" />
    </div>
</div>

@code {
    /// <summary>Current file content value.</summary>
    [Parameter] public string? Content { get; set; }
    /// <summary>Fires when the file content changes via file open.</summary>
    [Parameter] public EventCallback<string> ContentChanged { get; set; }
    /// <summary>Default file name used when saving.</summary>
    [Parameter] public string DefaultFileName { get; set; } = "document.txt";

    protected override string ModulePath => "./_content/SuperUI/superui-browser-features.js";

    private async Task OpenFileAsync()
    {
        var file = await SafeInvokeAsync<FileData>("openFile");
        if (file != null)
        {
            Content = file.Content;
            await ContentChanged.InvokeAsync(file.Content);
        }
    }

    private async Task SaveFileAsync()
    {
        if (string.IsNullOrEmpty(Content)) return;
        await SafeInvokeAsync<bool>("saveFile", Content, DefaultFileName, "text/plain");
    }

    /// <summary>Data for a file read from the File System Access API.</summary>
    public class FileData
    {
        /// <summary>File name with extension.</summary>
        public string Name { get; set; } = "";
        /// <summary>File size in bytes.</summary>
        public long Size { get; set; }
        /// <summary>MIME type of the file.</summary>
        public string Type { get; set; } = "";
        /// <summary>Text content of the file.</summary>
        public string Content { get; set; } = "";
    }
}
