@namespace SuperUI.Components
@inherits SgJsComponentBase

<div class="@Css("sgc-geolocation").Build()" style="@Style">
    <SgButton Variant="Variant" OnClick="GetPositionAsync" Loading="_loading" Disabled="Disabled">
        <Icon><SgIcon Icon="@SgIcons.Activity" /></Icon>
        <ChildContent>
            @if (ShowText)
            {
                <span>@ButtonText</span>
            }
        </ChildContent>
    </SgButton>
</div>

@code {
    private bool _loading;

    /// <summary>Text displayed on the location button.</summary>
    [Parameter] public string ButtonText { get; set; } = "Моё местоположение";
    /// <summary>Whether the button text label is shown.</summary>
    [Parameter] public bool ShowText { get; set; } = true;
    /// <summary>Whether the button is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Button variant style.</summary>
    [Parameter] public SgButtonVariant Variant { get; set; } = SgButtonVariant.Default;
    
    /// <summary>Fires when the device's geographic position is obtained.</summary>
    [Parameter] public EventCallback<SgGeoPosition> OnLocationFound { get; set; }
    /// <summary>Fires when a geolocation error occurs.</summary>
    [Parameter] public EventCallback<string> OnError { get; set; }

    protected override string ModulePath => "./_content/SuperUI/superui-browser-features.js";

    /// <summary>Gets the device's current geographic position.</summary>
    public async Task GetPositionAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var pos = await SafeInvokeAsync<SgGeoPosition>("getCurrentPosition");
            if (pos != null)
            {
                await OnLocationFound.InvokeAsync(pos);
            }
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    /// <summary>Represents a geographic position from the Geolocation API.</summary>
    public class SgGeoPosition
    {
        /// <summary>Latitude in decimal degrees.</summary>
        public double Latitude { get; set; }
        /// <summary>Longitude in decimal degrees.</summary>
        public double Longitude { get; set; }
        /// <summary>Accuracy of the position in meters.</summary>
        public double Accuracy { get; set; }
        /// <summary>Altitude in meters above sea level (if available).</summary>
        public double? Altitude { get; set; }
    }
}
