@namespace SuperUI.Components
@inherits SgJsComponentBase

@code {
    protected override string ModulePath => "./_content/SuperUI/superui-browser-features.js";

    public async Task<bool> CopyAsync(string text)
    {
        return await SafeInvokeAsync<bool>("copyToClipboard", text);
    }

    public async Task<string?> ReadAsync()
    {
        return await SafeInvokeAsync<string>("readFromClipboard");
    }
}
