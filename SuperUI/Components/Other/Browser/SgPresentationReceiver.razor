@namespace SuperUI.Components
@inherits SgJsComponentBase

<div class="@Css("sgc-presentation-receiver").Build()" style="@Style">
    <div style="padding: 24px; text-align: center; background: #000; color: #fff; border-radius: 12px; min-height: 200px; display: flex; flex-direction: column; justify-content: center; gap: 16px;">
        <div style="font-size: 40px;">📺</div>
        @if (_messages.Any())
        {
            <div style="font-size: 24px; font-weight: bold;">@_messages.Last()</div>
            <div style="font-size: 14px; opacity: 0.6;">Всего сообщений: @_messages.Count</div>
        }
        else
        {
            <div style="font-size: 18px; opacity: 0.8;">Ожидание подключения контроллера...</div>
            <div style="font-size: 12px; opacity: 0.5;">Presentation Receiver API активен</div>
        }
    </div>
</div>

@code {
    private List<string> _messages = new();

    protected override string ModulePath => "./_content/SuperUI/superui-browser-features.js";

    protected override async ValueTask OnInteractiveAsync()
    {
        await SafeInvokeVoidAsync("initPresentationReceiver", SelfRef);
    }

    [JSInvokable]
    public void OnPresentationMessage(string message)
    {
        _messages.Add(message);
        StateHasChanged();
    }
}
