@namespace SuperUI.Components
@inherits SgJsComponentBase
@using SuperUI.Enums

<div @ref="RootRef" class="@GetRootClasses()" style="@(string.IsNullOrWhiteSpace(Style) ? $"" : Style)" @attributes="AdditionalAttributes">

    @* ─── Toolbar ─── *@
    <div class="sgc-img-editor-toolbar">
        <div class="sgc-img-editor-tool-group">
            <button type="button" class="sgc-img-editor-btn @(_activeTool == EditorTool.Select ? "sgc-active" : "")"
                    title="Select" @onclick="() => SetTool(EditorTool.Select)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <path d="M3 3l7.07 16.97 2.51-7.39 7.39-2.51L3 3z" /><path d="M13 13l6 6" />
                </svg>
            </button>
            <button type="button" class="sgc-img-editor-btn @(_activeTool == EditorTool.Crop ? "sgc-active" : "")"
                    title="Crop" @onclick="() => SetTool(EditorTool.Crop)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <path d="M6.13 1L6 16a2 2 0 0 0 2 2h15" /><path d="M1 6.13L16 6a2 2 0 0 1 2 2v15" />
                </svg>
            </button>
            <button type="button" class="sgc-img-editor-btn @(_activeTool == EditorTool.Draw ? "sgc-active" : "")"
                    title="Draw" @onclick="() => SetTool(EditorTool.Draw)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <path d="M12 19l7-7 3 3-7 7-3-3z" /><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" />
                    <path d="M2 2l7.586 7.586" /><circle cx="11" cy="11" r="2" />
                </svg>
            </button>
        </div>

        <div class="sgc-img-editor-sep"></div>

        <div class="sgc-img-editor-tool-group">
            <button type="button" class="sgc-img-editor-btn" title="Rotate 90° CW" @onclick="RotateCwAsync">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <polyline points="23 4 23 10 17 10" /><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
                </svg>
            </button>
            <button type="button" class="sgc-img-editor-btn" title="Rotate 90° CCW" @onclick="RotateCcwAsync">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <polyline points="1 4 1 10 7 10" /><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" />
                </svg>
            </button>
            <button type="button" class="sgc-img-editor-btn" title="Flip Horizontal" @onclick="FlipHAsync">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <path d="M3 12h18" /><path d="M7 8l-4 4 4 4" /><path d="M17 8l4 4-4 4" />
                </svg>
            </button>
            <button type="button" class="sgc-img-editor-btn" title="Flip Vertical" @onclick="FlipVAsync">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <path d="M12 3v18" /><path d="M8 7l-4 4 4 4" /><path d="M16 7l4 4-4 4" />
                </svg>
            </button>
        </div>

        <div class="sgc-img-editor-sep"></div>

        <div class="sgc-img-editor-tool-group">
            <select class="sgc-img-editor-select" @bind="_filter" @bind:after="ApplyFilterAsync" aria-label="Filter">
                <option value="">No Filter</option>
                <option value="grayscale(100%)">Grayscale</option>
                <option value="sepia(100%)">Sepia</option>
                <option value="invert(100%)">Invert</option>
                <option value="blur(3px)">Blur</option>
                <option value="brightness(150%)">Bright</option>
                <option value="contrast(200%)">High Contrast</option>
                <option value="hue-rotate(90deg)">Hue Shift</option>
            </select>
        </div>

        <div class="sgc-img-editor-sep"></div>

        <div class="sgc-img-editor-tool-group sgc-img-editor-zoom-group">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
                <line x1="11" y1="8" x2="11" y2="14" /><line x1="8" y1="11" x2="14" y2="11" />
            </svg>
            <input type="range" min="10" max="400" value="@_zoomPercent" @@oninput="OnZoomInput" aria-label="Zoom" />
            <span>@(_zoomPercent)%</span>
        </div>

        <div class="sgc-img-editor-sep"></div>

        <div class="sgc-img-editor-tool-group">
            <button type="button" class="sgc-img-editor-btn" title="Undo" @onclick="UndoAsync" disabled="@(!_canUndo)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <polyline points="1 4 1 10 7 10" /><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" />
                </svg>
            </button>
            <button type="button" class="sgc-img-editor-btn" title="Redo" @onclick="RedoAsync" disabled="@(!_canRedo)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <polyline points="23 4 23 10 17 10" /><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
                </svg>
            </button>
        </div>

        <div class="sgc-img-editor-sep"></div>

        <div class="sgc-img-editor-tool-group">
            <button type="button" class="sgc-img-editor-btn" title="Reset" @onclick="ResetAsync">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <polyline points="1 4 1 10 7 10" /><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" />
                </svg>
            </button>
        </div>

        <div class="sgc-img-editor-toolbar-spacer"></div>

        <div class="sgc-img-editor-tool-group">
            <label class="sgc-img-editor-upload-label" title="Open Image">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" />
                </svg>
                <input type="file" accept="image/*" @@onchange="OnFileSelected" hidden />
            </label>
            <button type="button" class="sgc-img-editor-btn sgc-img-editor-btn-primary" title="Download" @onclick="DownloadAsync">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" />
                </svg>
                <span>Download</span>
            </button>
        </div>
    </div>

    @* ─── Canvas area ─── *@
    <div class="sgc-img-editor-canvas-area" @@onclick:stopPropagation>
        <div class="sgc-img-editor-canvas-stage" @ref="_canvasStageRef">
            <canvas @ref="_canvasRef" class="sgc-img-editor-main-canvas"></canvas>
            <canvas @ref="_overlayRef" class="sgc-img-editor-overlay-canvas"></canvas>

            @* Crop action buttons (shown when crop is active in JS) *@
            @if (_cropActive)
            {
                <div class="sgc-img-editor-crop-actions">
                    <button type="button" class="sgc-img-editor-btn sgc-img-editor-btn-primary" @onclick="ApplyCropAsync">Apply</button>
                    <button type="button" class="sgc-img-editor-btn" @onclick="CancelCrop">Cancel</button>
                </div>
            }
        </div>

        @if (_error is not null)
        {
            <div class="sgc-img-editor-error">@_error</div>
        }
        @if (!_imageLoaded && string.IsNullOrEmpty(Src) && _error is null)
        {
            <div class="sgc-img-editor-empty" @onclick="TriggerFileUpload">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48" opacity=".4">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                    <circle cx="8.5" cy="8.5" r="1.5" />
                    <polyline points="21 15 16 10 5 21" />
                </svg>
                <span>Click or drop an image to start editing</span>
            </div>
        }
    </div>

    <input type="file" accept="image/*" @ref="_fileInputRef" @@onchange="OnFileSelected" hidden />
</div>
