@namespace SuperUI.Components
@using SuperUI.Services.FeatureFlags
@using SuperUI.Base.ComponentBases
@inherits SgComponentBase
@inject SgFeatureFlagService FlagService

<div class="@Css("sgc-feature-flag-manager").Build()">
    <h4 class="sgc-title">Feature Flags Control</h4>
    <div class="sgc-flag-list">
        @foreach (var flag in FlagService.GetAll())
        {
            <div class="sgc-flag-item">
                <span class="sgc-flag-name">@flag.Key</span>
                <SgSwitch Value="@flag.Value" ValueChanged="@((val) => OnToggle(flag.Key, val))" />
            </div>
        }
    </div>
</div>

<style>
    .sgc-feature-flag-manager {
        padding: 16px;
        background: #f9f9f9;
        border: 1px solid #ddd;
        border-radius: 8px;
        width: 300px;
    }
    .sgc-flag-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid #eee;
    }
    .sgc-flag-name { font-size: 13px; font-weight: 500; }
</style>

@code {
    private void OnToggle(string name, bool enabled)
    {
        FlagService.SetFlag(name, enabled);
        StateHasChanged();
    }
}
