@namespace SuperUI.Components
@using SuperUI.Enums
@inherits SgJsComponentBase
@inject ISuperUILocalizer Localizer

<div class="@Css("sg-barcode-scanner").AddClass("sg-scanning", _isScanning).AddClass("sg-compact", Compact).Build()"
     style="@Styles().AddStyle("width", Width, Width != "100%").Build()"
     @ref="RootRef"
     @attributes="AdditionalAttributes">

    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="sg-barcode-scanner-head">
            <h3 class="sg-barcode-scanner-title">@Title</h3>
            <span class="sg-barcode-scanner-status sg-status-@StatusKey">
                <span class="sg-barcode-scanner-status-dot"></span>
                @StatusLabel
            </span>
        </div>
    }

    @if (_error is not null)
    {
        <div class="sg-barcode-scanner-alert sg-alert-error" role="alert">
            <span class="sg-barcode-scanner-alert-icon">@((MarkupString)SgIcons.X)</span>
            <span class="sg-barcode-scanner-alert-text">@_error</span>
            <button type="button"
                    class="sg-barcode-scanner-alert-action"
                    title="@(Loc("BarcodeScanner_Retry") ?? "Retry")"
                    @onclick="RetryAsync">
                <span>@((MarkupString)SgIcons.Refresh)</span>
                @(Loc("BarcodeScanner_Retry") ?? "Retry")
            </button>
        </div>
    }

    <div class="sg-barcode-scanner-stage">
        <video id="@(ResolvedId)-video" class="sg-barcode-scanner-video" playsinline muted></video>

        @if (string.IsNullOrEmpty(_error))
        {
            <div class="sg-barcode-scanner-overlay" aria-hidden="true">
                <div class="sg-barcode-scanner-reticle">
                    <span class="sg-corner sg-corner-tl"></span>
                    <span class="sg-corner sg-corner-tr"></span>
                    <span class="sg-corner sg-corner-bl"></span>
                    <span class="sg-corner sg-corner-br"></span>
                    @if (_isScanning)
                    {
                        <span class="sg-barcode-scanner-scanline"></span>
                    }
                </div>
                @if (!_isScanning && _lastScan is null)
                {
                    <div class="sg-barcode-scanner-hint">
                        @(Loc("BarcodeScanner_Hint") ?? "Press Start to scan")
                    </div>
                }
            </div>
        }

        @if (_torchOn)
        {
            <span class="sg-barcode-scanner-torch-indicator" title="@(Loc("BarcodeScanner_Torch") ?? "Torch")">
                @((MarkupString)IconTorch)
            </span>
        }
    </div>

    <div class="sg-barcode-scanner-controls">
        @if (ShowVideoDeviceList && _devices.Count > 1)
        {
            <div class="sg-barcode-scanner-device-select-wrap">
                <label class="sg-barcode-scanner-label" for="@_deviceSelectId">@(Loc("BarcodeScanner_Camera") ?? "Camera")</label>
                <select id="@_deviceSelectId"
                        class="sg-barcode-scanner-select"
                        value="@_selectedDeviceId"
                        @onchange="OnDeviceChanged">
                    @foreach (var device in _devices)
                    {
                        <option value="@device.DeviceId">@device.Label</option>
                    }
                </select>
            </div>
        }

        <div class="sg-barcode-scanner-buttons">
            @if (ShowStart)
            {
                <button type="button"
                        class="sg-barcode-scanner-btn sg-barcode-scanner-btn-primary"
                        @onclick="StartAsync"
                        disabled="@(_isScanning || !_isReady)"
                        title="@(Loc("BarcodeScanner_Start") ?? "Start")">
                    <span class="sg-btn-ico">@((MarkupString)IconPlay)</span>
                    <span>@(Loc("BarcodeScanner_Start") ?? "Start")</span>
                </button>
            }

            <button type="button"
                    class="sg-barcode-scanner-btn sg-barcode-scanner-btn-secondary"
                    @onclick="StopAsync"
                    disabled="@(!_isScanning)"
                    title="@(Loc("BarcodeScanner_Stop") ?? "Stop")">
                <span class="sg-btn-ico">@((MarkupString)IconStop)</span>
                <span>@(Loc("BarcodeScanner_Stop") ?? "Stop")</span>
            </button>

            @if (ShowToggleTorch)
            {
                <button type="button"
                        class="sg-barcode-scanner-btn sg-barcode-scanner-btn-secondary @(_torchOn ? "sg-active" : "")"
                        @onclick="ToggleTorchAsync"
                        title="@(Loc("BarcodeScanner_Torch") ?? "Torch")">
                    <span class="sg-btn-ico">@((MarkupString)IconTorch)</span>
                    <span>@(Loc("BarcodeScanner_Torch") ?? "Torch")</span>
                </button>
            }

            @if (ShowReset)
            {
                <button type="button"
                        class="sg-barcode-scanner-btn sg-barcode-scanner-btn-tertiary"
                        @onclick="ResetAsync"
                        title="@(Loc("BarcodeScanner_Reset") ?? "Reset")">
                    <span class="sg-btn-ico">@((MarkupString)SgIcons.Refresh)</span>
                    <span>@(Loc("BarcodeScanner_Reset") ?? "Reset")</span>
                </button>
            }

            @if (ShowFileInput)
            {
                <label class="sg-barcode-scanner-btn sg-barcode-scanner-btn-tertiary"
                       title="@(Loc("BarcodeScanner_UploadFile") ?? "Upload")">
                    <span class="sg-btn-ico">@((MarkupString)IconUpload)</span>
                    <span>@(Loc("BarcodeScanner_UploadFile") ?? "Upload")</span>
                    <InputFile OnChange="OnFileSelected" accept="image/*" style="display:none" />
                </label>
            }
        </div>
    </div>

    @if (_decodeError is not null)
    {
        <div class="sg-barcode-scanner-alert sg-alert-warn" role="status">
            <span class="sg-barcode-scanner-alert-icon">@((MarkupString)SgIcons.X)</span>
            <span class="sg-barcode-scanner-alert-text">
                @(Loc("BarcodeScanner_DecodeError") ?? "Decode error"): @_decodeError
            </span>
        </div>
    }

    @if (_lastScan is not null)
    {
        <div class="sg-barcode-scanner-result" role="status" aria-live="polite">
            <div class="sg-barcode-scanner-result-header">
                <span class="sg-barcode-scanner-result-title">
                    <span class="sg-barcode-scanner-result-check">@((MarkupString)SgIcons.Check)</span>
                    @(Loc("BarcodeScanner_Result") ?? "Result")
                </span>
                <span class="sg-barcode-scanner-result-format">@_lastScan.Format</span>
                <button type="button"
                        class="sg-barcode-scanner-result-copy"
                        title="@(Loc("BarcodeScanner_Copy") ?? "Copy")"
                        @onclick="CopyResultAsync">
                    @if (_copied)
                    {
                        @((MarkupString)SgIcons.Check)
                    }
                    else
                    {
                        @((MarkupString)SgIcons.Copy)
                    }
                </button>
            </div>
            <div class="sg-barcode-scanner-result-text">@_lastScan.Text</div>
            @if (_lastScan.Picture is not null)
            {
                <div class="sg-barcode-scanner-result-picture">
                    <img src="@_lastScan.Picture" alt="@(Loc("BarcodeScanner_ResultImage") ?? "Scanned image")" />
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _isReady;
    private bool _permissionRequested;
    private bool _isScanning;
    private bool _torchOn;
    private bool _copied;
    private string? _error;
    private string? _decodeError;
    private List<SgVideoDevice> _devices = new();
    private string _selectedDeviceId = string.Empty;
    private SgBarcodeReceivedEventArgs? _lastScan;
    private readonly string _deviceSelectId = SgIdGenerator.NewId("sg-barcode-scanner-device");

    protected override string ModulePath => "./_content/SuperUI/sg-barcode-scanner.js";
    protected override string IdPrefix   => "sg-barcode-scanner";

    [Parameter] public string? Title { get; set; }
    [Parameter] public int VideoWidth { get; set; } = 640;
    [Parameter] public int VideoHeight { get; set; } = 480;
    [Parameter] public bool StartCameraAutomatically { get; set; }
    [Parameter] public bool ShowStart { get; set; } = true;
    [Parameter] public bool ShowReset { get; set; } = true;
    [Parameter] public bool ShowVideoDeviceList { get; set; } = true;
    [Parameter] public bool ShowToggleTorch { get; set; }
    [Parameter] public bool ShowFileInput { get; set; } = true;
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool StopOnResult { get; set; }
    [Parameter] public bool BeepOnResult { get; set; }
    [Parameter] public List<SgBarcodeFormat> DecodeFormats { get; set; } = new() { SgBarcodeFormat.All };
    [Parameter] public bool DecodedPictureCapture { get; set; }
    [Parameter] public string? SelectedDeviceId { get; set; }
    [Parameter] public string Width { get; set; } = "100%";
    [Parameter] public SgBarcodeScannerSources? Sources { get; set; }
    [Parameter] public EventCallback<SgBarcodeReceivedEventArgs> OnBarcodeReceived { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }
    [Parameter] public EventCallback<string> OnDecodeError { get; set; }
    [Parameter] public EventCallback<SgDeviceListChangedEventArgs> OnDeviceListChanged { get; set; }
    [Parameter] public EventCallback<string> OnSelectedDeviceChanged { get; set; }

    private string? Loc(string key)
    {
        try { return Localizer[key]; } catch { return null; }
    }

    private string StatusKey => _error is not null ? "error" : (_isScanning ? "live" : "idle");
    private string StatusLabel => _error is not null
        ? (Loc("BarcodeScanner_StatusError") ?? "Error")
        : (_isScanning
            ? (Loc("BarcodeScanner_StatusScanning") ?? "Scanning")
            : (Loc("BarcodeScanner_StatusIdle") ?? "Idle"));

    private const string IconPlay =
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"6 4 20 12 6 20 6 4\" fill=\"currentColor\"></polygon></svg>";
    private const string IconStop =
        "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"6\" y=\"6\" width=\"12\" height=\"12\" rx=\"1.5\"></rect></svg>";
    private const string IconTorch =
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 2h6v4l-1.5 3v3h-3V9L9 6V2Z\"></path><path d=\"M10.5 12h3v9l-1.5 1-1.5-1v-9Z\"></path></svg>";
    private const string IconUpload =
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path><polyline points=\"17 8 12 3 7 8\"></polyline><line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"></line></svg>";

    protected override async ValueTask OnInteractiveAsync()
    {
        try
        {
            var sources = Sources ?? new SgBarcodeScannerSources();
            await SafeInvokeVoidAsync("initBarcodeScanner", SelfRef, ResolvedId, sources);

            if (StartCameraAutomatically)
            {
                await StartAsync();
            }
        }
        catch (Exception ex)
        {
            _error = $"{Loc("BarcodeScanner_FailedToLoad") ?? "Failed to load"}: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    public async Task StartAsync()
    {
        if (!IsInteractive || _isScanning) return;

        if (!_permissionRequested)
        {
            _permissionRequested = true;
            try
            {
                var granted = await SafeInvokeAsync<bool>("requestCameraPermission", ResolvedId);
                if (!granted)
                {
                    await InvokeAsync(StateHasChanged);
                    return;
                }
            }
            catch (Exception ex)
            {
                _error = $"{Loc("BarcodeScanner_FailedToStart") ?? "Failed to start"}: {ex.Message}";
                await InvokeAsync(StateHasChanged);
                return;
            }
        }

        _isScanning = true;
        _error = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            await SafeInvokeVoidAsync("startScanner",
                ResolvedId,
                ResolvedId + "-video",
                _selectedDeviceId,
                DecodeFormats,
                DecodedPictureCapture,
                VideoWidth,
                VideoHeight);
        }
        catch (Exception ex)
        {
            _error = $"{Loc("BarcodeScanner_FailedToStart") ?? "Failed to start"}: {ex.Message}";
            _isScanning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task OnReadyAsync()
    {
        _isReady = true;
        await InvokeAsync(StateHasChanged);
    }

    public async Task<bool> RequestCameraPermissionAsync()
    {
        if (!IsInteractive) return false;
        _permissionRequested = true;
        try
        {
            var granted = await SafeInvokeAsync<bool>("requestCameraPermission", ResolvedId);
            await InvokeAsync(StateHasChanged);
            return granted;
        }
        catch { return false; }
    }

    public async Task StopAsync()
    {
        if (!IsInteractive || !_isScanning) return;

        await SafeInvokeVoidAsync("stopScanner", ResolvedId);
        _isScanning = false;
        _torchOn = false;
        await InvokeAsync(StateHasChanged);
    }

    public async Task ResetAsync()
    {
        _lastScan = null;
        _decodeError = null;
        _copied = false;
        await StopAsync();
        await StartAsync();
    }

    private async Task OnDeviceChanged(ChangeEventArgs e)
    {
        _selectedDeviceId = e.Value?.ToString() ?? string.Empty;
        if (OnSelectedDeviceChanged.HasDelegate)
            await OnSelectedDeviceChanged.InvokeAsync(_selectedDeviceId);

        if (_isScanning)
        {
            await ResetAsync();
        }
    }

    public async Task ToggleTorchAsync()
    {
        if (!IsInteractive) return;
        _torchOn = !_torchOn;
        try
        {
            await SafeInvokeVoidAsync("toggleTorch", ResolvedId, _torchOn);
        }
        catch { _torchOn = !_torchOn; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task CopyResultAsync()
    {
        if (_lastScan is null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _lastScan.Text);
            _copied = true;
            StateHasChanged();
            await Task.Delay(1500);
            _copied = false;
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    [JSInvokable]
    public async Task OnBarcodeReceivedAsync(System.Text.Json.JsonElement result)
    {
        var args = new SgBarcodeReceivedEventArgs
        {
            Text = result.TryGetProperty("text", out var textProp) ? textProp.GetString() ?? string.Empty : string.Empty,
            Format = result.TryGetProperty("format", out var formatProp) ? formatProp.GetString() ?? string.Empty : string.Empty,
            Picture = result.TryGetProperty("picture", out var pictureProp) && pictureProp.ValueKind != System.Text.Json.JsonValueKind.Null ? pictureProp.GetString() : null
        };

        _lastScan = args;
        _decodeError = null;
        _copied = false;
        await InvokeAsync(StateHasChanged);

        if (BeepOnResult)
        {
            try { await JS.InvokeVoidAsync("eval", "(()=>{try{const a=new(window.AudioContext||window.webkitAudioContext)();const o=a.createOscillator(),g=a.createGain();o.connect(g);g.connect(a.destination);o.frequency.value=880;g.gain.value=0.05;o.start();setTimeout(()=>{o.stop();a.close();},90);}catch(e){}})()"); }
            catch { }
        }

        if (OnBarcodeReceived.HasDelegate)
            await OnBarcodeReceived.InvokeAsync(args);

        if (StopOnResult && _isScanning)
        {
            await StopAsync();
        }
    }

    [JSInvokable]
    public async Task OnErrorAsync(string error)
    {
        _error = error;
        _isScanning = false;
        await InvokeAsync(StateHasChanged);
        if (OnError.HasDelegate)
            await OnError.InvokeAsync(error);
    }

    [JSInvokable]
    public async Task OnDecodeErrorAsync(string error)
    {
        _decodeError = error;
        await InvokeAsync(StateHasChanged);

        if (OnDecodeError.HasDelegate)
            await OnDecodeError.InvokeAsync(error);
    }

    [JSInvokable]
    public async Task OnDeviceListChangedAsync(List<SgVideoDevice> devices)
    {
        _devices = devices;
        if (string.IsNullOrEmpty(_selectedDeviceId) && _devices.Count > 0)
        {
            _selectedDeviceId = _devices[0].DeviceId;
        }
        await InvokeAsync(StateHasChanged);
        if (OnDeviceListChanged.HasDelegate)
            await OnDeviceListChanged.InvokeAsync(new SgDeviceListChangedEventArgs { Devices = devices });
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _decodeError = null;
        await InvokeAsync(StateHasChanged);

        using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        var dataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(memoryStream.ToArray())}";

        await DecodeFromFileAsync(dataUrl);
    }

    public async Task DecodeFromFileAsync(string dataUrl) =>
        await SafeInvokeVoidAsync("decodeFromFile", ResolvedId, dataUrl, DecodeFormats, DecodedPictureCapture);

    public async Task RetryAsync()
    {
        _error = null;
        _permissionRequested = false;
        StateHasChanged();
        if (IsInteractive)
        {
            var sources = Sources ?? new SgBarcodeScannerSources();
            await SafeInvokeVoidAsync("initBarcodeScanner", SelfRef, ResolvedId, sources);
        }
    }

    protected override async ValueTask OnDisposingAsync()
    {
        await SafeInvokeVoidAsync("disposeBarcodeScanner", ResolvedId);
    }
}
