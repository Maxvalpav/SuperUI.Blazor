@namespace SuperUI.Components
@inherits SgComponentBase
@implements IDisposable

@* Invisible — counts renders for debugging *@

@code {
    /// <summary>Fires after each render cycle with the current render count.</summary>
    [Parameter] public EventCallback<int> OnRender { get; set; }

    /// <summary>Total number of times the component has rendered.</summary>
    public int RenderCount { get; private set; }

    protected override void OnAfterRender(bool firstRender)
    {
        RenderCount++;
        _ = OnRender.InvokeAsync(RenderCount);
    }

    public void Dispose() { /* no resources */ }
}
