@namespace SuperUI.Components
@inject SgSettingsService SettingsService
@inject SgThemeService ThemeService
@inject ISuperUILocalizer Localizer
@inject SgConfirmService ConfirmService
@inject SgToastService ToastService
@using SuperUI.Services.Llm
@using SuperUI.Themes
@using SuperUI.Services.Analytics
@using System.Globalization
@inject SgHeatmapService HeatmapService
@implements IDisposable

@*
    Settings UI is organised around three principles:
      1. **Search-first** — every label, hint and section title is indexed so a
         user can locate any switch in one keystroke instead of guessing which
         tab it lives under.
      2. **Predictable feedback** — settings save instantly; a transient
         "Saved ✓" pill confirms it. The user never wonders whether the click
         did anything.
      3. **One layout, repeated** — every row uses the same shape:
         label · helper text · control. No inline ad-hoc styles per tab.
*@

<div class="sgc-settings-container" style="@Style">
    <header class="sgc-settings-header">
        <div class="sgc-settings-title-row">
            <h2 class="sgc-settings-title">@Localizer["Settings_Title"]</h2>
            @if (_showSavedPill)
            {
                <span class="sgc-settings-saved-pill" role="status" aria-live="polite">
                    <span aria-hidden="true">✓</span> @Localizer["Settings_Saved"]
                </span>
            }
        </div>
        <div class="sgc-settings-search-wrap">
            <span class="sgc-settings-search-icon" aria-hidden="true">@((MarkupString)SgIcons.Search)</span>
            <input type="search"
                   class="sgc-settings-search"
                   placeholder="@Localizer["Settings_Search"]"
                   aria-label="@Localizer["Settings_Search"]"
                   @bind="_searchText"
                   @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(_searchText))
            {
                <button type="button" class="sgc-settings-search-clear" @onclick="@(() => _searchText = string.Empty)" aria-label="Clear">✕</button>
            }
        </div>
    </header>

    @if (IsSearching && !HasAnyMatch)
    {
        <div class="sgc-settings-empty">
            <span aria-hidden="true">🔍</span>
            <p>@Localizer["Settings_NoSearchResults"]</p>
        </div>
    }
    else
    {
        <SgTabs Vertical="true">
            @if (TabVisible(_appearanceKeys))
            {
                <SgTabPanel Title="@Localizer["Settings_Appearance"]">
                    <Icon>@((MarkupString)SgIcons.Palette)</Icon>
                    <ChildContent>
                        @SectionHeader(Localizer["Settings_Appearance_Title"], Localizer["Settings_AppearanceHint"])

                        @if (Match(Localizer["Settings_Theme"]))
                        {
                            @SettingRow(Localizer["Settings_Theme"], null,
                                @<div role="radiogroup" aria-label="@Localizer["Settings_Theme"]">
                                    @{
                                        var grouped = _themes
                                            .GroupBy(t => GetHueGroup(t))
                                            .OrderBy(g => GroupOrder(g.Key))
                                            .Select(g => new { Group = g.Key, Themes = g.OrderBy(t => t.Name) });
                                    }
                                    @foreach (var g in grouped)
                                    {
                                        <div class="sgc-theme-group-label">@g.Group</div>
                                        <div class="sgc-theme-grid">
                                            @foreach (var theme in g.Themes)
                                            {
                                                var isActive = ThemeService.CurrentTheme.Id == theme.Id;
                                                <button type="button"
                                                        role="radio"
                                                        aria-checked="@(isActive ? "true" : "false")"
                                                        class="sgc-theme-card @(isActive ? "sgc-active" : "")"
                                                        @onclick="() => OnPickThemeAsync(theme)">
                                                    <span class="sgc-theme-preview" style="background: @theme.Primitives.Primary500;"></span>
                                                    <span class="sgc-theme-name">@theme.Name</span>
                                                    <span class="sgc-theme-font">@GetFontName(theme.Primitives.FontSans)</span>
                                                    @if (isActive)
                                                    {
                                                        <span class="sgc-theme-check" aria-hidden="true">✓</span>
                                                    }
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>)
                        }

                        @if (Match(Localizer["Settings_Mode"]))
                        {
                            @SettingRow(Localizer["Settings_Mode"], null,
                                @<SgSegmented TValue="string" @bind-Value="CurrentMode" Options="_modeOptions" />)
                        }

                        @if (Match(Localizer["Settings_Density"]))
                        {
                            @SettingRow(Localizer["Settings_Density"], null,
                                @<SgSegmented TValue="string" @bind-Value="CurrentDensity" Options="_densityOptions" />)
                        }

                        @if (Match(Localizer["Settings_TabbedMode"], Localizer["Settings_TabbedModeHint"]))
                        {
                            @SettingRow(Localizer["Settings_TabbedMode"], Localizer["Settings_TabbedModeHint"],
                                @<SgSwitch @bind-Value="IsTabbedMode" Label="@Localizer["Settings_TabbedModeLabel"]" />)
                        }
                    </ChildContent>
                </SgTabPanel>
            }

            @if (TabVisible(_typographyKeys))
            {
                <SgTabPanel Title="@Localizer["Settings_Typography"]">
                    <Icon>@((MarkupString)SgIcons.Type)</Icon>
                    <ChildContent>
                        @SectionHeader(Localizer["Settings_Typography"], Localizer["Settings_TypographyHint"])

                        @if (Match(Localizer["Settings_FontSize"]))
                        {
                            @SettingRow(Localizer["Settings_FontSize"], null,
                                @<SgSegmented TValue="string" @bind-Value="CurrentFontSize" Options="_fontSizeOptions" />)
                        }

                        @if (Match(Localizer["Settings_FontFamily"]))
                        {
                            @SettingRow(Localizer["Settings_FontFamily"], null,
                                @<SgSegmented TValue="string" @bind-Value="CurrentFontFamily" Options="_fontFamilyOptions" />)
                        }
                    </ChildContent>
                </SgTabPanel>
            }

            @if (TabVisible(_formatsKeys))
            {
                <SgTabPanel Title="@Localizer["Settings_Formats"]">
                    <Icon>@((MarkupString)SgIcons.Calendar)</Icon>
                    <ChildContent>
                        @SectionHeader(Localizer["Settings_Formats"], Localizer["Settings_FormatsHint"])

                        @if (Match(Localizer["Settings_DateFormat"]))
                        {
                            @SettingRow(Localizer["Settings_DateFormat"], null,
                                @<SgSelect TValue="string" Items="_dateFormats" @bind-Value="CurrentDateFormat" />)
                        }

                        @if (Match(Localizer["Settings_NumberSeparator"]))
                        {
                            @SettingRow(Localizer["Settings_NumberSeparator"], null,
                                @<SgSegmented TValue="string" @bind-Value="CurrentNumberSeparator" Options="_numberSeparatorOptions" />)
                        }
                    </ChildContent>
                </SgTabPanel>
            }

            @if (TabVisible(_languageKeys))
            {
                <SgTabPanel Title="@Localizer["Settings_Language"]">
                    <Icon>@((MarkupString)SgIcons.Globe)</Icon>
                    <ChildContent>
                        @SectionHeader(Localizer["Settings_Language_Title"], Localizer["Settings_LanguageHint"])

                        @if (Match(Localizer["Settings_SelectLanguage"]))
                        {
                            @SettingRow(Localizer["Settings_SelectLanguage"], null,
                                @<div style="display:flex;gap:8px;align-items:center;flex:1">
                                    <SgSelect TValue="string"
                                               Items="_languages"
                                               @bind-Value="CurrentLanguage"
                                               LabelSelector="GetLanguageLabel"
                                               Style="flex:1" />
                                    <button type="button"
                                            class="sgc-icon-btn"
                                            title="@Localizer["Settings_EditTranslations"]"
                                            aria-label="@Localizer["Settings_EditTranslations"]"
                                            @onclick="() => _showLocaleEditor = !_showLocaleEditor">
                                        @((MarkupString)SgIcons.Edit)
                                    </button>
                                </div>)
                        }
                        @if (_showLocaleEditor)
                        {
                            <div style="margin-top:16px;border-top:1px solid var(--sg-border-subtle,#e5e7eb);padding-top:16px;">
                                <SgLocaleEditor />
                            </div>
                        }
                    </ChildContent>
                </SgTabPanel>
            }

            @if (TabVisible(_aiKeys))
            {
                <SgTabPanel Title="@Localizer["Settings_AI"]">
                    <Icon>@((MarkupString)SgIcons.Cpu)</Icon>
                    <ChildContent>
                        @SectionHeader(Localizer["Settings_AI"], Localizer["Settings_AIHint"])
                        <SgLlmSettings Config="_llmConfig" ConfigChanged="OnLlmConfigChanged" />
                    </ChildContent>
                </SgTabPanel>
            }

            @if (TabVisible(_analyticsKeys))
            {
                <SgTabPanel Title="@Localizer["Settings_Analytics"]">
                    <Icon>@((MarkupString)SgIcons.Activity)</Icon>
                    <ChildContent>
                        @SectionHeader(Localizer["Settings_Analytics"], Localizer["Settings_AnalyticsHint"])

                        @if (Match(Localizer["Settings_HeatmapAdmin"], Localizer["Settings_HeatmapAdminHint"]))
                        {
                            @SettingRow(Localizer["Settings_HeatmapAdmin"], Localizer["Settings_HeatmapAdminHint"],
                                @<SgSwitch @bind-Value="IsHeatmapAdminMode" Label="@Localizer["Settings_HeatmapAdminLabel"]" />)
                        }

                        @if (Match(Localizer["Settings_ClearAnalytics"]))
                        {
                            @SettingRow(Localizer["Settings_ClearAnalytics"], null,
                                @<SgButton Variant="SgButtonVariant.Danger" Size="SgSize.Sm" OnClick="OnClearHeatmapData">
                                    @Localizer["Settings_ClearAnalytics"]
                                </SgButton>)
                        }
                    </ChildContent>
                </SgTabPanel>
            }

            @if (TabVisible(_systemKeys))
            {
                <SgTabPanel Title="@Localizer["Settings_System"]">
                    <Icon>@((MarkupString)SgIcons.Terminal)</Icon>
                    <ChildContent>
                        @SectionHeader(Localizer["Settings_System"], Localizer["Settings_SystemHint"])

                        @if (Match(Localizer["Settings_ClearCache"], Localizer["Settings_ClearCacheHint"]))
                        {
                            @SettingRow(Localizer["Settings_ClearCache"], Localizer["Settings_ClearCacheHint"],
                                @<SgButton Variant="SgButtonVariant.Outlined" OnClick="OnClearCache">
                                    @Localizer["Settings_ClearCache"]
                                </SgButton>)
                        }

                        @if (Match(Localizer["Settings_ResetAll"], Localizer["Settings_ResetAllHint"]))
                        {
                            @SettingRow(Localizer["Settings_ResetAll"], Localizer["Settings_ResetAllHint"],
                                @<SgButton Variant="SgButtonVariant.Danger" OnClick="OnResetAll">
                                    @Localizer["Settings_ResetAll"]
                                </SgButton>)
                        }

                        <div style="margin-top:24px;border-top:1px solid var(--sg-border-subtle,#e5e7eb);padding-top:16px;">
                            <SgVersionManager />
                        </div>
                    </ChildContent>
                </SgTabPanel>
            }
        </SgTabs>
    }
</div>

@code {
    /// <summary>Custom CSS styles applied to the root container.</summary>
    [Parameter] public string? Style { get; set; }
    [Inject] private ThemeRegistry ThemeRegistry { get; set; } = default!;

    private List<IThemeDefinition> _themes = new();

    static string GetFontName(string fontFamily)
    {
        var name = fontFamily.Split(',')[0].Trim().Trim('\'');
        return name;
    }

    static string GetHueGroup(IThemeDefinition theme)
    {
        var raw = theme.Primitives.Primary500;
        var parts = raw.Split(' ');
        var hueStr = parts.Length >= 3 ? parts[2].TrimEnd(')', '/') : "0";
        var hue = double.TryParse(hueStr, NumberStyles.Any, CultureInfo.InvariantCulture, out var h) ? h : 0;

        return hue switch
        {
            >= 340 or < 20  => "Rose / Red",
            >= 20  and < 40 => "Red / Orange",
            >= 40  and < 60 => "Orange / Gold",
            >= 60  and < 90 => "Yellow / Amber",
            >= 90  and < 150 => "Green",
            >= 150 and < 200 => "Teal / Cyan",
            >= 200 and < 280 => "Blue",
            >= 280 and < 340 => "Purple / Violet",
            _ => "Neutral"
        };
    }

    static int GroupOrder(string group) => group switch
    {
        "Blue"            => 0,
        "Green"           => 1,
        "Purple / Violet" => 2,
        "Teal / Cyan"     => 3,
        "Yellow / Amber"  => 4,
        "Orange / Gold"   => 5,
        "Red / Orange"    => 6,
        "Rose / Red"      => 7,
        "Neutral"         => 8,
        _ => 9
    };
    private List<SgSegmentedOption<string>> _modeOptions = new();
    private List<SgSegmentedOption<string>> _densityOptions = new();
    private List<SgSegmentedOption<string>> _fontSizeOptions = new();
    private List<SgSegmentedOption<string>> _fontFamilyOptions = new();
    private List<SgSegmentedOption<string>> _numberSeparatorOptions = new();

    private List<string> _languages = new() { "en-US", "ru-RU" };
    private List<string> _dateFormats = new() { "DD.MM.YYYY", "YYYY-MM-DD", "MM/DD/YYYY" };
    private SgLlmConfig _llmConfig = new();
    private bool _showLocaleEditor;

    // ── Search filter ─────────────────────────────────────────────────────
    private string _searchText = string.Empty;
    private bool IsSearching => !string.IsNullOrWhiteSpace(_searchText);
    private bool HasAnyMatch => _appearanceKeys.Concat(_typographyKeys).Concat(_formatsKeys)
                                              .Concat(_languageKeys).Concat(_aiKeys)
                                              .Concat(_analyticsKeys).Concat(_systemKeys)
                                              .Any(MatchPair);

    // Per-tab haystacks. Each entry is "label|hint" — Match() picks them apart.
    private IEnumerable<string> _appearanceKeys => new[]
    {
        $"{Localizer["Settings_Appearance_Title"]}|{Localizer["Settings_AppearanceHint"]}",
        $"{Localizer["Settings_Theme"]}|",
        $"{Localizer["Settings_Mode"]}|",
        $"{Localizer["Settings_Density"]}|",
        $"{Localizer["Settings_TabbedMode"]}|{Localizer["Settings_TabbedModeHint"]}",
    };
    private IEnumerable<string> _typographyKeys => new[]
    {
        $"{Localizer["Settings_Typography"]}|{Localizer["Settings_TypographyHint"]}",
        $"{Localizer["Settings_FontSize"]}|",
        $"{Localizer["Settings_FontFamily"]}|",
    };
    private IEnumerable<string> _formatsKeys => new[]
    {
        $"{Localizer["Settings_Formats"]}|{Localizer["Settings_FormatsHint"]}",
        $"{Localizer["Settings_DateFormat"]}|",
        $"{Localizer["Settings_NumberSeparator"]}|",
    };
    private IEnumerable<string> _languageKeys => new[]
    {
        $"{Localizer["Settings_Language_Title"]}|{Localizer["Settings_LanguageHint"]}",
        $"{Localizer["Settings_SelectLanguage"]}|",
    };
    private IEnumerable<string> _aiKeys => new[]
    {
        $"{Localizer["Settings_AI"]}|{Localizer["Settings_AIHint"]}",
    };
    private IEnumerable<string> _analyticsKeys => new[]
    {
        $"{Localizer["Settings_Analytics"]}|{Localizer["Settings_AnalyticsHint"]}",
        $"{Localizer["Settings_HeatmapAdmin"]}|{Localizer["Settings_HeatmapAdminHint"]}",
        $"{Localizer["Settings_ClearAnalytics"]}|",
    };
    private IEnumerable<string> _systemKeys => new[]
    {
        $"{Localizer["Settings_System"]}|{Localizer["Settings_SystemHint"]}",
        $"{Localizer["Settings_ClearCache"]}|{Localizer["Settings_ClearCacheHint"]}",
        $"{Localizer["Settings_ResetAll"]}|{Localizer["Settings_ResetAllHint"]}",
    };

    private bool TabVisible(IEnumerable<string> keys) => !IsSearching || keys.Any(MatchPair);
    private bool MatchPair(string pair)
    {
        if (!IsSearching) return true;
        var parts = pair.Split('|', 2);
        return Match(parts[0], parts.Length > 1 ? parts[1] : null);
    }
    private bool Match(string? primary, string? secondary = null)
    {
        if (!IsSearching) return true;
        var q = _searchText.Trim();
        bool Contains(string? s) => !string.IsNullOrEmpty(s) && s.Contains(q, StringComparison.OrdinalIgnoreCase);
        return Contains(primary) || Contains(secondary);
    }

    // ── Saved-pill feedback ───────────────────────────────────────────────
    private bool _showSavedPill;
    private CancellationTokenSource? _savedPillCts;
    private async Task FlashSavedAsync()
    {
        _savedPillCts?.Cancel();
        _savedPillCts = new CancellationTokenSource();
        var token = _savedPillCts.Token;
        _showSavedPill = true;
        StateHasChanged();
        try
        {
            await Task.Delay(1500, token);
            _showSavedPill = false;
            StateHasChanged();
        }
        catch (TaskCanceledException) { /* superseded by another save */ }
    }

    // ── Two-way bound properties ──────────────────────────────────────────
    // Two-way bindings must be synchronous, so the async setters are
    // fire-and-forget. We wrap them so a failure surfaces as a toast instead
    // of leaving the UI showing the old value next to a silent service error.
    private string CurrentMode
    {
        get => ThemeService.CurrentMode;
        set => SafeFireAndForget(ThemeService.SetModeAsync(value), Localizer["Settings_Mode"]);
    }
    private string CurrentDensity
    {
        get => ThemeService.Density;
        set => SafeFireAndForget(ThemeService.SetDensityAsync(value), Localizer["Settings_Density"]);
    }
    private string CurrentFontSize
    {
        get => ThemeService.FontSize;
        set => SafeFireAndForget(ThemeService.SetFontSizeAsync(value), Localizer["Settings_FontSize"]);
    }
    private string CurrentFontFamily
    {
        get => ThemeService.FontFamily;
        set => SafeFireAndForget(ThemeService.SetFontFamilyAsync(value), Localizer["Settings_FontFamily"]);
    }
    private string CurrentDateFormat
    {
        get => SettingsService.DateFormat;
        set => SafeFireAndForget(SettingsService.SetDateFormatAsync(value), Localizer["Settings_DateFormat"]);
    }
    private string CurrentNumberSeparator
    {
        get => SettingsService.NumberSeparator;
        set => SafeFireAndForget(SettingsService.SetNumberSeparatorAsync(value), Localizer["Settings_NumberSeparator"]);
    }
    private bool IsTabbedMode
    {
        get => SettingsService.IsTabbedMode;
        set => SafeFireAndForget(SettingsService.SetTabbedModeAsync(value), Localizer["Settings_TabbedMode"]);
    }
    private bool IsHeatmapAdminMode
    {
        get => HeatmapService.IsAdminMode;
        set => SafeFireAndForget(HeatmapService.ToggleAdminModeAsync(value), Localizer["Settings_HeatmapAdmin"]);
    }

    private async void SafeFireAndForget(Task work, string label)
    {
        try
        {
            await work;
            await InvokeAsync(FlashSavedAsync);
        }
        catch (Exception ex)
        {
            _ = InvokeAsync(() => ToastService.Error($"{label}: {ex.Message}"));
        }
    }

    private async Task OnPickThemeAsync(IThemeDefinition theme)
    {
        try
        {
            await ThemeService.SetThemeAsync(theme);
            await FlashSavedAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"{Localizer["Settings_Theme"]}: {ex.Message}");
        }
    }

    private async Task OnClearHeatmapData()
    {
        var confirmed = await ConfirmService.ConfirmAsync(
            Localizer["Settings_ClearAnalyticsConfirm"],
            Localizer["Settings_ClearAnalyticsTitle"]);
        if (confirmed)
        {
            await HeatmapService.ClearDataAsync();
            ToastService.Success(Localizer["Settings_ClearAnalyticsDone"]);
        }
    }

    private string _currentLanguage = "ru-RU";
    private string CurrentLanguage
    {
        get => _currentLanguage;
        set
        {
            if (_currentLanguage != value)
            {
                _currentLanguage = value;
                SafeFireAndForget(SettingsService.SetLanguageAsync(value), Localizer["Settings_Language"]);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _themes = ThemeRegistry.GetAll().ToList();
        var savedLang = await SettingsService.GetLanguageAsync();
        if (_languages.Contains(savedLang))
        {
            _currentLanguage = savedLang;
            await SettingsService.SetLanguageAsync(savedLang);
        }
        else
        {
            _currentLanguage = "en-US";
        }
        _llmConfig = (await SettingsService.LoadDefaultLlmConfigAsync()) ?? SettingsService.GetDefaultLlmConfig();

        _modeOptions = new List<SgSegmentedOption<string>>
        {
            new() { Value = "light", Label = Localizer["Theme_LightMode"], Icon = builder => builder.AddContent(0, (MarkupString)SgIcons.Sun) },
            new() { Value = "dark", Label = Localizer["Theme_DarkMode"], Icon = builder => builder.AddContent(0, (MarkupString)SgIcons.Moon) },
            new() { Value = "auto", Label = Localizer["Theme_AutoMode"], Icon = builder => builder.AddContent(0, (MarkupString)SgIcons.Monitor) }
        };

        _densityOptions = new List<SgSegmentedOption<string>>
        {
            new() { Value = "compact", Label = Localizer["Density_Compact"] },
            new() { Value = "relaxed", Label = Localizer["Density_Relaxed"] }
        };

        _fontSizeOptions = new List<SgSegmentedOption<string>>
        {
            new() { Value = "sm", Label = Localizer["FontSize_Small"] },
            new() { Value = "md", Label = Localizer["FontSize_Medium"] },
            new() { Value = "lg", Label = Localizer["FontSize_Large"] }
        };

        _fontFamilyOptions = new List<SgSegmentedOption<string>>
        {
            new() { Value = "sans", Label = Localizer["FontFamily_Sans"] },
            new() { Value = "mono", Label = Localizer["FontFamily_Mono"] }
        };

        _numberSeparatorOptions = new List<SgSegmentedOption<string>>
        {
            new() { Value = "space", Label = "1 000" },
            new() { Value = "comma", Label = "1,000" },
            new() { Value = "none",  Label = "1000" }
        };
    }

    private async Task OnLlmConfigChanged(SgLlmConfig config)
    {
        await SettingsService.SaveDefaultLlmConfigAsync(config);
        await FlashSavedAsync();
    }

    private string GetLanguageLabel(string lang) => lang switch
    {
        "en-US" => Localizer["Language_English"],
        "ru-RU" => Localizer["Language_Russian"],
        _ => lang
    };

    private async Task OnClearCache()
    {
        await SettingsService.ClearCacheAsync();
        ToastService.Success(Localizer["Settings_ClearCacheDone"]);
    }

    private async Task OnResetAll()
    {
        if (await ConfirmService.ConfirmAsync(Localizer["Settings_ResetConfirm"]))
        {
            await SettingsService.ResetAllSettingsAsync();
        }
    }

    // ── Render helpers ────────────────────────────────────────────────────
    // One row, one shape: label, optional hint, control. Inlined to keep the
    // markup readable instead of a forest of tiny components.
    private RenderFragment SectionHeader(string title, string? hint) => __builder =>
    {
        <div class="sgc-settings-section-head">
            <h3 class="sgc-settings-section-title">@title</h3>
            @if (!string.IsNullOrEmpty(hint))
            {
                <p class="sgc-settings-section-hint">@hint</p>
            }
        </div>
    };

    private RenderFragment SettingRow(string label, string? hint, RenderFragment control) => __builder =>
    {
        <div class="sgc-setting-row">
            <div class="sgc-setting-info">
                <label class="sgc-setting-label">@label</label>
                @if (!string.IsNullOrEmpty(hint))
                {
                    <p class="sgc-setting-hint">@hint</p>
                }
            </div>
            <div class="sgc-setting-control">
                @control
            </div>
        </div>
    };

    public void Dispose()
    {
        _savedPillCts?.Cancel();
        _savedPillCts?.Dispose();
        _savedPillCts = null;
    }
}

<style>
.sgc-settings-container {
    background: var(--sg-bg);
    overflow-y: auto;
    overflow-x: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
}

/* ── Sticky header: title, saved-pill, search ───────────────────────── */
.sgc-settings-header {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px 20px 12px;
    background: var(--sg-bg);
    border-bottom: 1px solid var(--sg-border);
}
.sgc-settings-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}
.sgc-settings-title {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    color: var(--sg-fg);
    letter-spacing: -0.01em;
}
.sgc-settings-saved-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 500;
    color: var(--sg-color-success, #2e7d32);
    background: var(--sg-color-success-subtle, rgba(46, 125, 50, 0.1));
    border-radius: 999px;
    animation: sgc-fade-in 0.18s ease-out;
}
@@keyframes sgc-fade-in {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
}

.sgc-settings-search-wrap {
    position: relative;
    display: flex;
    align-items: center;
}
.sgc-settings-search-icon {
    position: absolute;
    left: 12px;
    display: inline-flex;
    width: 16px;
    height: 16px;
    color: var(--sg-fg-subtle);
    pointer-events: none;
}
.sgc-settings-search-icon :deep(svg) { width: 16px; height: 16px; }
.sgc-settings-search {
    width: 100%;
    height: 36px;
    padding: 0 36px 0 36px;
    font-size: 13px;
    background: var(--sg-bg-subtle);
    border: 1px solid var(--sg-border);
    border-radius: var(--sg-radius-md, 8px);
