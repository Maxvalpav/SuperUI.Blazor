    // ----- JS callbacks -----

    [JSInvokable]
    public async Task UpdateActiveFormats() => await UpdateActiveFormatsAsync();

    [JSInvokable]
    public async Task NotifyContentChanged() => await UpdateContentAsync();

    private async Task UpdateActiveFormatsAsync()
    {
        if (_jsModule == null || _showCodeView) return;

        var formats = await _jsModule.InvokeAsync<string[]>("queryActiveFormats");
        _activeFormats = new HashSet<string>(formats);

        var blockFormat = await _jsModule.InvokeAsync<string>("queryCommandValue", "formatBlock");
        _currentBlock = blockFormat?.ToUpperInvariant() switch
        {
            "H1" or "H2" or "H3" or "H4" or "BLOCKQUOTE" or "PRE" => blockFormat.ToUpperInvariant(),
            _ => "P"
        };

        var fontSize = await _jsModule.InvokeAsync<string>("queryCommandValue", "fontSize");
        _currentFontSize = fontSize ?? "";

        _currentFormat = formats.FirstOrDefault() switch
        {
            "bold" => Localizer["Bold"],
            "italic" => Localizer["Italic"],
            "underline" => Localizer["Underline"],
            "strikeThrough" => Localizer["Strikethrough"],
            _ => ""
        };

        StateHasChanged();
    }

    private async Task UpdateContentAsync()
    {
        if (_jsModule == null || _isUpdating || _showCodeView) return;

        _isUpdating = true;
        try
        {
            var html = await _jsModule.InvokeAsync<string>("getHtmlContent", _editorRef);
            var text = await _jsModule.InvokeAsync<string>("getTextContent", _editorRef);

            if (html != Value)
            {
                Value = html;
                await ValueChanged.InvokeAsync(html);
                await HtmlChanged.InvokeAsync(html);
                await TextChanged.InvokeAsync(text);
                await UpdateStatsAsync();
            }
        }
        finally
        {
            _isUpdating = false;
        }
    }

    private async Task UpdateStatsAsync()
    {
        if (_jsModule == null) return;

        var text = await _jsModule.InvokeAsync<string>("getTextContent", _editorRef);
        _charCount = text?.Length ?? 0;
        _wordCount = string.IsNullOrWhiteSpace(text)
            ? 0
            : text.Split(new[] { ' ', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries).Length;

        StateHasChanged();
    }

    private async Task UpdateSelectionCountAsync()
    {
        if (_jsModule == null) return;
        var selected = await _jsModule.InvokeAsync<string>("getSelectedText");
        _selectedCount = selected?.Length ?? 0;
        StateHasChanged();
    }

