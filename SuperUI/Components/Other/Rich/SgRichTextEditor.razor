    // ===== Auto-Save =====

    private void StartAutoSave()
    {
        if (AutoSaveMs <= 0) return;
        _autoSaveCts?.Cancel();
        _autoSaveCts = new CancellationTokenSource();
        var ct = _autoSaveCts.Token;
        _autoSaveTask = AutoSaveLoopAsync(ct);
    }

    private async Task AutoSaveLoopAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(AutoSaveMs, ct);
                if (!ct.IsCancellationRequested && OnAutoSave.HasDelegate)
                {
                    var html = await GetHtmlAsync();
                    await OnAutoSave.InvokeAsync(html);
                }
            }
            catch (TaskCanceledException) { break; }
        }
    }

    // ===== AI Assistant =====

    private async Task ToggleAiPanel()
    {
        if (_aiBusy) return;
        if (LlmService == null && string.IsNullOrEmpty(AiEndpoint))
        {
            _aiResult = "AI service is not configured. Inject ILlmService or set AiEndpoint.";
            StateHasChanged();
            return;
        }
        _aiResult = null;
        _aiPrompt = "";
        StateHasChanged();
    }

    private async Task SendAiPromptAsync()
    {
        if (_aiBusy || string.IsNullOrWhiteSpace(_aiPrompt) || _jsModule == null) return;
        _aiBusy = true;
        _aiResult = null;
        StateHasChanged();

        try
        {
            var html = await GetHtmlAsync();
            var context = string.IsNullOrWhiteSpace(html) ? "(empty document)" : html;

            if (LlmService != null)
            {
                var request = new SgLlmChatRequest
                {
                    Messages = new()
                    {
                        new() { Role = "system", Content = AiSystemPrompt },
                        new() { Role = "user", Content = $"Document context: {context}\n\nUser request: {_aiPrompt}" }
                    }
                };
                var result = await LlmService.CompleteAsync(request);
                _aiResult = result?.Content;

                if (!string.IsNullOrEmpty(_aiResult))
                {
                    var clean = System.Net.WebUtility.HtmlEncode(_aiResult);
                    await _jsModule.InvokeVoidAsync("saveSelection", _editorRef);
                    await _jsModule.InvokeVoidAsync("insertHtmlAt", _editorRef, clean);
                    await UpdateContentAsync();
                }
            }
            else if (!string.IsNullOrEmpty(AiEndpoint))
            {
                using var client = new HttpClient();
                var payload = new
                {
                    model = string.IsNullOrEmpty(AiModel) ? "gpt-4o-mini" : AiModel,
                    messages = new[]
                    {
                        new { role = "system", content = AiSystemPrompt },
                        new { role = "user", content = $"Document context: {context}\n\nUser request: {_aiPrompt}" }
                    }
                };
                var json = System.Text.Json.JsonSerializer.Serialize(payload);
                var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
                var response = await client.PostAsync(AiEndpoint, content);
                response.EnsureSuccessStatusCode();
                var responseJson = await response.Content.ReadAsStringAsync();
                _aiResult = "AI response received. Check console for details.";
            }
        }
        catch (Exception ex)
        {
            _aiResult = $"Error: {ex.Message}";
        }
        finally
        {
            _aiBusy = false;
            StateHasChanged();
        }
    }

    private async Task RunAiPresetAsync(AiPromptPreset preset)
    {
        if (_jsModule == null) return;
        _aiPrompt = preset.Prompt;
        var html = await GetHtmlAsync();
        var context = string.IsNullOrWhiteSpace(html) ? "(empty document)" : html;

        if (LlmService != null && _jsModule != null)
        {
            _aiBusy = true;
            StateHasChanged();
            try
            {
                var request = new SgLlmChatRequest
                {
                    Messages = new()
                    {
                        new() { Role = "system", Content = AiSystemPrompt },
                        new() { Role = "user", Content = $"Document context: {context}\n\n{preset.Prompt}" }
                    }
                };
                var result = await LlmService.CompleteAsync(request);
                var text = result?.Content;
                if (!string.IsNullOrEmpty(text))
                {
                    var clean = System.Net.WebUtility.HtmlEncode(text);
                    await _jsModule.InvokeVoidAsync("saveSelection", _editorRef);
                    await _jsModule.InvokeVoidAsync("insertHtmlAt", _editorRef, clean);
                    await UpdateContentAsync();
                }
            }
            catch (Exception ex)
            {
                _aiResult = $"Error: {ex.Message}";
            }
            finally
            {
                _aiBusy = false;
                StateHasChanged();
            }
        }
    }

