@namespace SuperUI.Components
@inherits SgJsComponentBase

<div class="@Css("sgc-tts").Build()" style="@Style">
    <SgButton Variant="Variant" OnClick="SpeakAsync" Disabled="@(Disabled || string.IsNullOrEmpty(Text))">
        <Icon><SgIcon Icon="@SgIcons.Volume2" /></Icon>
        <ChildContent>
            @if (ShowText)
            {
                <span>@ButtonText</span>
            }
        </ChildContent>
    </SgButton>
</div>

@code {
    /// <summary>Text to be spoken aloud.</summary>
    [Parameter] public string Text { get; set; } = "";
    /// <summary>Button text label.</summary>
    [Parameter] public string ButtonText { get; set; } = "Озвучить";
    /// <summary>Whether the button text label is shown.</summary>
    [Parameter] public bool ShowText { get; set; } = true;
    /// <summary>Whether the button is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Button variant style.</summary>
    [Parameter] public SgButtonVariant Variant { get; set; } = SgButtonVariant.Default;
    
    /// <summary>Speech synthesis language code (e.g. "ru-RU", "en-US").</summary>
    [Parameter] public string Language { get; set; } = "ru-RU";
    /// <summary>Speech pitch (0.0 to 2.0, default 1.0).</summary>
    [Parameter] public double Pitch { get; set; } = 1.0;
    /// <summary>Speech rate (0.1 to 10.0, default 1.0).</summary>
    [Parameter] public double Rate { get; set; } = 1.0;
    /// <summary>Speech volume (0.0 to 1.0, default 1.0).</summary>
    [Parameter] public double Volume { get; set; } = 1.0;

    protected override string ModulePath => "./_content/SuperUI/superui-multimedia.js";

    /// <summary>Speaks the configured text using browser speech synthesis.</summary>
    public async Task SpeakAsync()
    {
        if (string.IsNullOrEmpty(Text)) return;

        await SafeInvokeVoidAsync("speak", Text, new {
            lang = Language,
            pitch = Pitch,
            rate = Rate,
            volume = Volume
        });
    }
}
