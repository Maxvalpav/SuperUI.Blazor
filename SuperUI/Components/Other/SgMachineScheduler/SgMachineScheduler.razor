@using SkiaSharp.Views.Blazor
@using SkiaSharp
@using SuperUI.Components.SgMachineScheduler.Models
@namespace SuperUI.Components.SgMachineScheduler

<div class="sg-machine-scheduler-container"
     @ref="_containerElement"
     @onwheel="OnWheel"
     @onpointerdown="OnPointerDown"
     @onpointermove="OnPointerMove"
     @onpointerup="OnPointerUp"
     @onpointerleave="OnPointerLeave">

    <SKCanvasView @ref="_canvasView"
                  OnPaintSurface="OnPaintSurface"
                  IgnorePixelScaling="false"
                  class="sg-machine-scheduler-canvas"
                  style="width: 100%; height: 100%;" />

    @if (_tooltipVisible)
    {
        <div class="sg-machine-scheduler-tooltip" 
             style="left: @(_tooltipX)px; top: @(_tooltipY)px;">
            @_tooltipContent
        </div>
    }
</div>
