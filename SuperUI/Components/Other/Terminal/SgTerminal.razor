@using Microsoft.JSInterop
@using SuperUI.Base.ComponentBases
@namespace SuperUI.Components
@inherits SgJsComponentBase

<div @ref="_containerRef" class="@Css("sg-terminal-container").Build()" style="@Styles().Build()">
</div>

<style>
    .sg-terminal-container {
        width: 100%;
        height: 100%;
        min-height: 200px;
        background: #1e1e1e;
        padding: 8px;
        border-radius: var(--sg-radius-md);
        overflow: hidden;
    }
    .sg-terminal-container .xterm {
        padding: 4px;
    }
</style>

@code {
    private ElementReference _containerRef;
    private string? _terminalId;
    private DotNetObjectReference<SgTerminal>? _objRef;

    /// <summary>Terminal font size in pixels (default 14).</summary>
    [Parameter] public int FontSize { get; set; } = 14;
    /// <summary>Terminal font family.</summary>
    [Parameter] public string FontFamily { get; set; } = "Consolas, 'Courier New', monospace";
    /// <summary>Custom terminal color theme.</summary>
    [Parameter] public TerminalTheme? Theme { get; set; }
    /// <summary>Fires when data is received from the terminal input.</summary>
    [Parameter] public EventCallback<string> OnData { get; set; }

    protected override string ModulePath => "./_content/SuperUI/sg-terminal.js";

    protected override async ValueTask OnInteractiveAsync()
    {
        _objRef = DotNetObjectReference.Create(this);
        
        var options = new {
            fontSize = FontSize,
            fontFamily = FontFamily,
            theme = Theme
        };

        _terminalId = await SafeInvokeAsync<string>("initTerminal", _containerRef, options, _objRef);
    }

    /// <summary>Writes text to the terminal without a newline.</summary>
    public async Task WriteAsync(string data)
    {
        if (_terminalId != null)
            await SafeInvokeVoidAsync("write", _terminalId, data);
    }
    /// <summary>Writes text to the terminal followed by a newline.</summary>
    public async Task WritelnAsync(string data)
    {
        if (_terminalId != null)
            await SafeInvokeVoidAsync("writeln", _terminalId, data);
    }
    /// <summary>Clears the terminal screen.</summary>
    public async Task ClearAsync()
    {
        if (_terminalId != null)
            await SafeInvokeVoidAsync("clear", _terminalId);
    }
    /// <summary>JS-invokable callback for terminal input data.</summary>
    [JSInvokable]
    public async Task OnDataReceived(string data)
    {
        await OnData.InvokeAsync(data);
    }

    public override async ValueTask DisposeAsync()
    {
        if (_terminalId != null)
        {
            try { await SafeInvokeVoidAsync("dispose", _terminalId); } catch { }
        }
        _objRef?.Dispose();
        await base.DisposeAsync();
    }

    /// <summary>Color theme for the terminal emulator.</summary>
    public class TerminalTheme
    {
        /// <summary>Terminal background color.</summary>
        public string? Background { get; set; }
        /// <summary>Default foreground (text) color.</summary>
        public string? Foreground { get; set; }
        /// <summary>Cursor color.</summary>
        public string? Cursor { get; set; }
        /// <summary>Selection background color.</summary>
        public string? Selection { get; set; }
        /// <summary>ANSI black color.</summary>
        public string? Black { get; set; }
        /// <summary>ANSI red color.</summary>
        public string? Red { get; set; }
        /// <summary>ANSI green color.</summary>
        public string? Green { get; set; }
        /// <summary>ANSI yellow color.</summary>
        public string? Yellow { get; set; }
        /// <summary>ANSI blue color.</summary>
        public string? Blue { get; set; }
        /// <summary>ANSI magenta color.</summary>
        public string? Magenta { get; set; }
        /// <summary>ANSI cyan color.</summary>
        public string? Cyan { get; set; }
        /// <summary>ANSI white color.</summary>
        public string? White { get; set; }
    }
}
