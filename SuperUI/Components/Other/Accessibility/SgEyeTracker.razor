@namespace SuperUI.Components
@inherits SgJsComponentBase
<div class="sgc-eye-tracker">
    @if (!_isActive)
    {
        <SgCard Variant="SgCardVariant.Glass" Style="max-width: 400px; margin: 20px auto;">
            <SgStack Orientation="SgOrientation.Vertical" Align="SgAlignItems.Center" Gap="16px">
                <SgIcon Icon="@SgIcons.Eye" Style="width: 48px; height: 48px; color: var(--sg-primary);" />
                <div style="text-align: center;">
                    <h3 style="margin: 0;">Eye Tracking</h3>
                    <p style="color: var(--sg-text-secondary); font-size: 14px;">
                        Активируйте трекер взгляда для управления интерфейсом или контроля внимания.
                    </p>
                </div>
                <SgButton Variant="SgButtonVariant.Primary" OnClick="StartTrackerAsync" Text="@Localizer["EyeTracker_Activate"]" />
            </SgStack>
        </SgCard>
    }
    else
    {
        @if (!_isInitializedJs)
        {
            <div class="sgc-eye-tracker-loading">
                <SgSpinner Size="SgSize.Lg" />
                <p>Инициализация трекера...</p>
            </div>
        }
        
        <div @ref="_dotRef" class="sgc-eye-tracker-dot">
            <div @ref="_dotInnerRef" class="sgc-eye-tracker-dot-inner"></div>
        </div>
        
        <div class="sgc-eye-tracker-toolbar">
            <SgButton Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" OnClick="CalibrateAsync" Text="@Localizer["EyeTracker_Calibrate"]" />
            <SgButton Variant="SgButtonVariant.Danger" Size="SgSize.Sm" OnClick="StopTrackerAsync" Text="@Localizer["EyeTracker_Stop"]" />
        </div>
    }
</div>

<style>
    .sgc-eye-tracker-dot {
        position: fixed;
        top: 0;
        left: 0;
        width: 44px;
        height: 44px;
        margin-left: -22px;
        margin-top: -22px;
        z-index: 10000;
        pointer-events: none;
        transition: transform 0.08s ease-out;
        display: flex;
        align-items: center;
        justify-content: center;
        --dwell-progress: 0%;
    }

    /* Кольцо прогресса задержки взгляда */
    .sgc-eye-tracker-dot::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 50%;
        padding: 3px; /* Толщина кольца */
        background: conic-gradient(var(--sg-primary) var(--dwell-progress), rgba(var(--sg-primary-rgb), 0.2) 0);
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        opacity: 0;
        transition: opacity 0.2s;
    }

    .sgc-eye-tracker-dot.is-dwelling::before {
        opacity: 1;
    }

    .sgc-eye-tracker-dot-inner {
        width: 10px;
        height: 10px;
        background: var(--sg-primary);
        border-radius: 50%;
        box-shadow: 0 0 12px var(--sg-primary);
        transition: transform 0.2s;
    }

    .sgc-eye-tracker-dot.is-dwelling .sgc-eye-tracker-dot-inner {
        transform: scale(1.5);
    }

    .sgc-eye-tracker-loading {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: rgba(var(--sg-bg-rgb), 0.8);
        backdrop-filter: blur(4px);
        z-index: 100;
        border-radius: var(--sg-radius-lg);
    }

    /* Эффект клика */
    .sgc-eye-tracker-dot.gaze-clicked .sgc-eye-tracker-dot-inner {
        animation: gaze-pop 0.3s ease-out;
    }

    @@keyframes gaze-pop {
        0% { transform: scale(1.5); opacity: 1; }
        50% { transform: scale(3); opacity: 0.5; }
        100% { transform: scale(1); opacity: 1; }
    }
    .sgc-eye-tracker-toolbar {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 10001;
        display: flex;
        gap: 8px;
        padding: 8px;
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(8px);
        border-radius: var(--sg-radius-md);
        border: 1px solid var(--sg-border);
        box-shadow: var(--sg-shadow-md);
    }
    [data-theme="dark"] .sgc-eye-tracker-toolbar {
        background: rgba(30, 30, 35, 0.7);
    }
</style>

@code {
    private ElementReference _dotRef;
    private ElementReference _dotInnerRef;
    private bool _isActive;
    private bool _isInitializedJs;

    /// <summary>Fires on each gaze point update with the current X/Y coordinates.</summary>
    [Parameter] public EventCallback<SgGazePoint> OnGazeUpdate { get; set; }

    protected override string ModulePath => "./_content/SuperUI/sg-eye-tracker.js";

    /// <summary>Starts the eye tracker and initializes the gaze detection.</summary>
    public async Task StartTrackerAsync()
    {
        _isActive = true;
        _isInitializedJs = false;
        StateHasChanged();
        
        // Даем Blazor время отрендерить элементы _dotRef
        await Task.Yield();
        
        try 
        {
            var result = await SafeInvokeAsync<bool>("initEyeTracker", _dotRef, _dotInnerRef);
            if (!result) 
            {
                _isActive = false;
            }
            else
            {
                _isInitializedJs = true;
            }
        }
        catch
        {
            _isActive = false;
        }
        
        StateHasChanged();
    }

    /// <summary>Stops the eye tracker and deactivates gaze detection.</summary>
    public async Task StopTrackerAsync()
    {
        await SafeInvokeVoidAsync("stopEyeTracker");
        _isActive = false;
        StateHasChanged();
    }

    /// <summary>Calibrates the eye tracker for improved gaze accuracy.</summary>
    public async Task CalibrateAsync()
    {
        await SafeInvokeVoidAsync("calibrate");
    }

    public override async ValueTask DisposeAsync()
    {
        try { await SafeInvokeVoidAsync("dispose"); } catch { }
        await base.DisposeAsync();
    }

    /// <summary>Represents a gaze point coordinate on the screen.</summary>
    public class SgGazePoint
    {
        /// <summary>Horizontal gaze position in pixels.</summary>
        public double X { get; set; }
        /// <summary>Vertical gaze position in pixels.</summary>
        public double Y { get; set; }
    }
}
