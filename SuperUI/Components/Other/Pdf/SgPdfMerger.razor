@using Microsoft.JSInterop
@using SuperUI.Base.ComponentBases
@using SuperUI.Components.Other.Pdf
@namespace SuperUI.Components
@inherits SgJsComponentBase

<div class="@Css("sg-pdf-merger").Build()" style="@Styles().Build()">
    <SgRow Gutter="24">
        <SgCol Span="10">
            <SgCard Title="Сборка документа" Subtitle="Перетащите файлы для изменения порядка">
                <div @ref="_listRef" class="sg-pdf-file-list">
                    @for (int i = 0; i < _files.Count; i++)
                    {
                        var file = _files[i];
                        <div class="sg-pdf-file-item" data-id="@i">
                            <SgIcon Icon="@SgIcons.GripVertical" style="cursor: grab; margin-right: 12px;" />
                            <div class="sg-pdf-file-info">
                                <span class="sg-pdf-file-name">@file.Name</span>
                                <span class="sg-pdf-file-size">PDF Документ</span>
                            </div>
                            <SgButton Variant="SgButtonVariant.Ghost" OnClick="() => RemoveFile(file)">
                                <Icon><SgIcon Icon="@SgIcons.X" /></Icon>
                            </SgButton>
                        </div>
                    }
                </div>

                <div style="margin-top: 20px;">
                    <SgButton Variant="SgButtonVariant.Primary" OnClick="MergeFiles" Block Disabled="!_files.Any()">
                        Объединить и скачать
                    </SgButton>
                </div>
            </SgCard>
        </SgCol>

        <SgCol Span="14">
            <SgCard Title="Предпросмотр результата" Style="height: 100%; min-height: 600px;">
                @if (!string.IsNullOrEmpty(_resultUrl))
                {
                    <iframe src="@_resultUrl" style="width: 100%; height: 600px; border: none;"></iframe>
                }
                else
                {
                    <div class="sg-pdf-placeholder">
                        <SgIcon Icon="@SgIcons.Layers" Size="48" style="opacity: 0.2;" />
                        <p>Добавьте файлы для объединения</p>
                    </div>
                }
            </SgCard>
        </SgCol>
    </SgRow>
</div>

<style>
    .sg-pdf-file-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .sg-pdf-file-item {
        display: flex;
        align-items: center;
        padding: 12px;
        background: var(--sg-bg-primary);
        border: 1px solid var(--sg-border-color);
        border-radius: var(--sg-radius-md);
    }
    .sg-pdf-file-info {
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .sg-pdf-file-name {
        font-weight: 500;
        font-size: 0.9rem;
    }
    .sg-pdf-file-size {
        font-size: 0.75rem;
        opacity: 0.6;
    }
</style>

@code {
    [Parameter] public List<SgPdfFileInfo> InitialFiles { get; set; } = new();
    
    private List<SgPdfFileInfo> _files = new();
    private ElementReference _listRef;
    private string? _resultUrl;
    private DotNetObjectReference<SgPdfMerger>? _objRef;

    protected override string ModulePath => "./_content/SuperUI/sg-pdf-suite.js";

    protected override async ValueTask OnInteractiveAsync()
    {
        _files = InitialFiles.ToList();
        _objRef = DotNetObjectReference.Create(this);
        await SafeInvokeVoidAsync("initSortable", _listRef, _objRef);
    }

    [JSInvokable]
    public void OnReorder(int oldIndex, int newIndex)
    {
        var item = _files[oldIndex];
        _files.RemoveAt(oldIndex);
        _files.Insert(newIndex, item);
        StateHasChanged();
    }

    private void RemoveFile(SgPdfFileInfo file)
    {
        _files.Remove(file);
        StateHasChanged();
    }

    private async Task MergeFiles()
    {
        if (!_files.Any()) return;
        
        var urls = _files.Select(f => f.Url).ToList();
        _resultUrl = await SafeInvokeAsync<string>("mergePdfs", urls);
        StateHasChanged();
    }

    public class SgPdfFileInfo
    {
        public string Name { get; set; } = "";
        public string Url { get; set; } = "";
    }
}
