@namespace SuperUI.Components
@using SuperUI.Enums
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable

@* ═══════════════════════════════════════════════════════════════════════════
   SgKPICard — three display modes:
     Card   — gradient card with full-bleed wave chart
     Ring   — circular SVG ring with value inside
     Inline — horizontal row: label · value · dot sparkline
   ═══════════════════════════════════════════════════════════════════════════ *@

<style>
/* ── Glass effect ───────────────────────────────────────────────────── */
.sgc-kpi-glass {
    background: rgba(255, 255, 255, 0.1) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
}
[data-theme="dark"] .sgc-kpi-glass {
    background: rgba(30, 30, 35, 0.3) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
}

/* ── Flip card ──────────────────────────────────────────────────────── */
.sgc-kpi-flipable {
    perspective: 1000px;
}
.sgc-kpi-flip-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}
.sgc-kpi-flipable:hover .sgc-kpi-flip-inner {
    transform: rotateY(180deg);
}
.sgc-kpi-flip-front,
.sgc-kpi-flip-back {
    position: relative;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
}
.sgc-kpi-flip-back {
    position: absolute;
    inset: 0;
    transform: rotateY(180deg);
    display: flex;
    flex-direction: column;
    padding: 16px;
    overflow: auto;
}
.sgc-kpi-flip-back-content {
    flex: 1;
    display: flex;
    flex-direction: column;
}

/* ── Status dot ─────────────────────────────────────────────────────── */
.sgc-kpi-status-dot {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-inline-end: 6px;
    flex-shrink: 0;
}
.sgc-kpi-status-dot-circle {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
}
.sgc-kpi-status-dot-online { background: #10b981; box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25); }
.sgc-kpi-status-dot-offline { background: #9ca3af; }
.sgc-kpi-status-dot-busy { background: #f43f5e; box-shadow: 0 0 0 2px rgba(244, 63, 94, 0.25); }
.sgc-kpi-status-dot-away { background: #f59e0b; box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.25); }
.sgc-kpi-status-dot-text {
    font-size: 10px;
    font-weight: 500;
    color: var(--sg-fg-muted, #9ca3af);
    white-space: nowrap;
}

/* ── Comparison row ─────────────────────────────────────────────────── */
.sgc-kpi-compare {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 4px;
}
.sgc-kpi-compare-label {
    font-size: 10px;
    font-weight: 500;
    color: var(--sg-fg-muted, #9ca3af);
}
.sgc-kpi-compare-values {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
}
.sgc-kpi-compare-val {
    color: var(--sg-fg-subtle, #4b5563);
}
.sgc-kpi-compare-diff {
    font-weight: 700;
}
.sgc-kpi-compare-diff.sgc-kpi-up { color: #059669; }
.sgc-kpi-compare-diff.sgc-kpi-down { color: #e11d48; }
.sgc-kpi-compare-pct {
    font-weight: 600;
}
.sgc-kpi-compare-pct.sgc-kpi-up { color: #10b981; }
.sgc-kpi-compare-pct.sgc-kpi-down { color: #f43f5e; }

/* ── Forecast row ───────────────────────────────────────────────────── */
.sgc-kpi-forecast {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
    opacity: 0.7;
}
.sgc-kpi-forecast-label {
    font-size: 10px;
    font-weight: 500;
    color: var(--sg-fg-muted, #9ca3af);
    text-transform: uppercase;
    letter-spacing: 0.04em;
}
.sgc-kpi-forecast-value {
    font-size: 12px;
    font-weight: 600;
    color: var(--sg-fg-subtle, #4b5563);
    font-variant-numeric: tabular-nums;
    border-bottom: 1px dashed var(--sg-fg-muted, #9ca3af);
    padding-bottom: 1px;
}

/* ── Mini gauge ─────────────────────────────────────────────────────── */
.sgc-kpi-mini-gauge {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 44px;
    height: 44px;
    z-index: 2;
}
.sgc-kpi-mini-gauge-svg {
    width: 100%;
    height: 100%;
    display: block;
}

/* Card mode: override for gradient layout */
.sgc-kpi-card .sgc-kpi-mini-gauge {
    top: 14px;
    right: 14px;
}

/* ── Card mode comparison/forecast overrides ────────────────────────── */
.sgc-kpi-card .sgc-kpi-compare-label,
.sgc-kpi-card .sgc-kpi-compare-val,
.sgc-kpi-card .sgc-kpi-forecast-label,
.sgc-kpi-card .sgc-kpi-forecast-value {
    color: rgba(255, 255, 255, 0.8);
}
.sgc-kpi-card .sgc-kpi-compare-diff.sgc-kpi-up { color: #6ee7b7; }
.sgc-kpi-card .sgc-kpi-compare-diff.sgc-kpi-down { color: #fda4af; }
.sgc-kpi-card .sgc-kpi-compare-pct.sgc-kpi-up { color: #6ee7b7; }
.sgc-kpi-card .sgc-kpi-compare-pct.sgc-kpi-down { color: #fda4af; }
</style>

<div class="@RootClass"
     style="@RootStyle"
     role="@(Clickable ? "button" : null)"
     tabindex="@(Clickable ? "0" : null)"
     aria-label="@AriaLabel"
     @onclick="HandleClickAsync"
     @onkeydown="HandleKeyDownAsync"
     @attributes="AdditionalAttributes">

    @if (Flipable)
    {
        <div class="sgc-kpi-flip-inner">
            <div class="sgc-kpi-flip-front">
                @RenderBody()
            </div>
            <div class="sgc-kpi-flip-back">
                <div class="sgc-kpi-flip-back-content">
                    @BackContent
                </div>
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

</div>

@code {
    // ── Value & display ───────────────────────────────────────────────────────
    /// <summary>Card title displayed in the header.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>Subtitle shown below the title.</summary>
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>Primary numeric value displayed in the card.</summary>
    [Parameter] public double? Value { get; set; }
    /// <summary>Explicit text to display instead of the formatted Value.</summary>
    [Parameter] public string? ValueText { get; set; }
    /// <summary>.NET numeric format string applied to Value (e.g. "N2", "C0").</summary>
    [Parameter] public string? Format { get; set; }
    /// <summary>Text prepended to the value (e.g. "$").</summary>
    [Parameter] public string? Prefix { get; set; }
    /// <summary>Text appended to the value (e.g. "GB").</summary>
    [Parameter] public string? Suffix { get; set; }
    /// <summary>Extra description text shown below the value.</summary>
    [Parameter] public string? Description { get; set; }
    /// <summary>Custom CSS color for the value text.</summary>
    [Parameter] public string? ValueColor { get; set; }

    // ── Target / progress ─────────────────────────────────────────────────────
    /// <summary>Optional target value for progress bar (Card mode) or ring completion (Ring mode).</summary>
    [Parameter] public double? Target { get; set; }
    /// <summary>Label shown next to the progress percentage.</summary>
    [Parameter] public string? TargetLabel { get; set; }

    // ── Delta metrics (Ban / Analytic modes) ──────────────────────────────────
    /// <summary>Secondary comparison metrics shown below the main value (Ban/Analytic modes).</summary>
    [Parameter] public IReadOnlyList<SgKPIDelta>? Deltas { get; set; }

    /// <summary>Period label shown above the value in Analytic mode (e.g. "Current month").</summary>
    [Parameter] public string? PeriodLabel { get; set; }

    // ── Icon ──────────────────────────────────────────────────────────────────
    /// <summary>HTML / SVG markup for the icon rendered in the header.</summary>
    [Parameter] public string? Icon { get; set; }
    /// <summary>Custom CSS color for the icon.</summary>
    [Parameter] public string? IconColor { get; set; }
    /// <summary>Custom CSS background for the icon container.</summary>
    [Parameter] public string? IconBackground { get; set; }

    // ── Trend ─────────────────────────────────────────────────────────────────
    /// <summary>Absolute trend value shown as a delta badge.</summary>
    [Parameter] public double? TrendValue { get; set; }
    /// <summary>Percentage trend value shown as a delta badge.</summary>
    [Parameter] public double? TrendPercent { get; set; }
    /// <summary>Whether the trend badge is visible. Default <c>true</c>.</summary>
    [Parameter] public bool ShowTrend { get; set; } = true;
    /// <summary>Label text next to the trend badge.</summary>
    [Parameter] public string? TrendLabel { get; set; }
    /// <summary>When <c>true</c>, inverts the positive/negative trend coloring.</summary>
    [Parameter] public bool InvertTrend { get; set; }

    // ── Chart ─────────────────────────────────────────────────────────────────
    /// <summary>Data points for the sparkline / wave chart.</summary>
    [Parameter] public double[]? ChartData { get; set; }
    /// <summary>Chart visualization style. Default <see cref="SgKPIChartType.Area"/>.</summary>
    [Parameter] public SgKPIChartType ChartType { get; set; } = SgKPIChartType.Area;
    /// <summary>Stroke / fill color for the chart.</summary>
    [Parameter] public string? ChartColor { get; set; }

    // ── Appearance ────────────────────────────────────────────────────────────
    /// <summary>Color variant accent. Default <see cref="SgKPIVariant.Default"/>.</summary>
    [Parameter] public SgKPIVariant Variant { get; set; } = SgKPIVariant.Default;
    /// <summary>Component size. Default <see cref="SgSize.Md"/>.</summary>
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;

    /// <summary>Visual layout mode. Default <see cref="SgKPIDisplayMode.Card"/>.</summary>
    [Parameter] public SgKPIDisplayMode DisplayMode { get; set; } = SgKPIDisplayMode.Card;

    // ── State ─────────────────────────────────────────────────────────────────
    /// <summary>When <c>true</c> the card shows a skeleton placeholder instead of content.</summary>
    [Parameter] public bool IsLoading { get; set; }

    // ── Interaction ───────────────────────────────────────────────────────────
    /// <summary>When <c>true</c> the card behaves as a clickable button.</summary>
    [Parameter] public bool Clickable { get; set; }
    /// <summary>Fired when the card is clicked (only when <see cref="Clickable"/> is <c>true</c>).</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    // ── Slots ─────────────────────────────────────────────────────────────────
    /// <summary>Optional action content rendered in the header area (e.g. a context menu).</summary>
    [Parameter] public RenderFragment? ActionContent { get; set; }
    /// <summary>Optional content rendered at the bottom of the card, separated by a divider.</summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    // ── Formatting ────────────────────────────────────────────────────────────
    /// <summary>Custom formatter callback. When set, overrides <see cref="Format"/> and <see cref="ValueText"/>.</summary>
    [Parameter] public Func<double, string>? FormatLabel { get; set; }

    // ── Display ───────────────────────────────────────────────────────────────
    /// <summary>Tighter padding for dense dashboard layouts.</summary>
    [Parameter] public bool Compact { get; set; }
    /// <summary>Explicit chart area height in px. Default is 60 (Card area), 56 (Analytic sparkline).</summary>
    [Parameter] public int? ChartHeight { get; set; }

    // ── Passthrough ───────────────────────────────────────────────────────────
    /// <summary>Additional CSS class names appended to the root element.</summary>
    [Parameter] public string? CssClass { get; set; }
    /// <summary>Inline styles appended to the root element.</summary>
    [Parameter] public string? Style { get; set; }
    /// <summary>Captures unmatched HTML attributes and passes them to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // ═══════════════════════════════════════════════════════════════════════════
    //  NEW FEATURE PARAMETERS
    // ═══════════════════════════════════════════════════════════════════════════

    // ── AnimatedValue ─────────────────────────────────────────────────────────
    /// <summary>
    /// When <c>true</c> the displayed value animates from zero to <see cref="Value"/>
    /// over <see cref="AnimateDuration"/> milliseconds on initial render and on value change.
    /// </summary>
    [Parameter] public bool AnimatedValue { get; set; }
    /// <summary>Animation duration in milliseconds when <see cref="AnimatedValue"/> is <c>true</c>. Default 1000.</summary>
    [Parameter] public int AnimateDuration { get; set; } = 1000;

    // ── ComparisonValue ───────────────────────────────────────────────────────
    /// <summary>Value from a previous period used for comparison delta display.</summary>
    [Parameter] public double? ComparisonValue { get; set; }
    /// <summary>Label for the comparison row. Default "vs previous period".</summary>
    [Parameter] public string? ComparisonLabel { get; set; } = "vs previous period";

    // ── ForecastValue ─────────────────────────────────────────────────────────
    /// <summary>Projected or forecast value shown as a subtle dashed indicator.</summary>
    [Parameter] public double? ForecastValue { get; set; }
    /// <summary>Label for the forecast row. Default "Forecast".</summary>
    [Parameter] public string? ForecastLabel { get; set; } = "Forecast";

    // ── MiniGauge ─────────────────────────────────────────────────────────────
    /// <summary>
    /// When <c>true</c> a small circular progress gauge is shown at the top-right corner
    /// of the card. Only applies in <see cref="SgKPIDisplayMode.Card"/> and <see cref="SgKPIDisplayMode.Ban"/> modes.
    /// </summary>
    [Parameter] public bool ShowMiniGauge { get; set; }

    // ── StatusDot / StatusText ────────────────────────────────────────────────
    /// <summary>Status indicator dot color. When set, a small colored dot is shown in the header.</summary>
    [Parameter] public SgAvatarStatus? StatusDot { get; set; }
    /// <summary>Text label rendered next to the <see cref="StatusDot"/>.</summary>
    [Parameter] public string? StatusText { get; set; }

    // ── Glass effect ──────────────────────────────────────────────────────────
    /// <summary>
    /// When <c>true</c> applies a frosted-glass visual effect:
    /// semi-transparent background, backdrop-filter blur, and a subtle border.
    /// </summary>
    [Parameter] public bool Glass { get; set; }

    // ── Flip card ─────────────────────────────────────────────────────────────
    /// <summary>
    /// When <c>true</c> the card flips on hover using CSS 3D transforms to reveal
    /// <see cref="BackContent"/> on the reverse side.
    /// </summary>
    [Parameter] public bool Flipable { get; set; }
    /// <summary>Content rendered on the back face of the card when <see cref="Flipable"/> is <c>true</c>.</summary>
    [Parameter] public RenderFragment? BackContent { get; set; }

    // ── Progress bar (independent of Target) ───────────────────────────────────
    /// <summary>Shows a standalone horizontal progress bar below the value. Independent of <see cref="Target"/>.</summary>
    [Parameter] public bool ProgressBar { get; set; }
    /// <summary>Max value for the progress bar. Default 100.</summary>
    [Parameter] public double ProgressBarMax { get; set; } = 100;
    /// <summary>Custom CSS color for the progress fill.</summary>
    [Parameter] public string? ProgressBarColor { get; set; }

    // ── Corner badge ───────────────────────────────────────────────────────────
    /// <summary>Small label text displayed in the top-right corner (e.g. "New", "Hot", "+12%").</summary>
    [Parameter] public string? CornerBadge { get; set; }
    /// <summary>Color variant for the corner badge. Default <see cref="SgKPIVariant.Primary"/>.</summary>
    [Parameter] public SgKPIVariant CornerBadgeVariant { get; set; } = SgKPIVariant.Primary;

    // ── Animation ──────────────────────────────────────────────────────────────
    /// <summary>When <c>true</c> applies a subtle fade-in-up animation on mount.</summary>
    [Parameter] public bool MountAnimation { get; set; }

    // ── Trend icons ────────────────────────────────────────────────────────────
    /// <summary>Custom SVG markup for the up-trend icon. Default is a chevron-up.</summary>
    [Parameter] public string? TrendUpIcon { get; set; }
    /// <summary>Custom SVG markup for the down-trend icon. Default is a chevron-down.</summary>
    [Parameter] public string? TrendDownIcon { get; set; }

    // ── Fields ────────────────────────────────────────────────────────────────

    private CancellationTokenSource? _cts;
    private Task? _animationTask;
    private double _displayValue;
    private double? _previousValue;

    // ── Computed ──────────────────────────────────────────────────────────────

    private bool HasChart => ChartData is { Length: > 1 };

    private bool IsAnimating => AnimatedValue && _cts is { IsCancellationRequested: false };

    private double? DisplayValue => IsAnimating ? _displayValue : Value;

    private bool IsPositiveTrend
    {
        get
        {
            var raw = TrendPercent ?? TrendValue ?? 0;
            return InvertTrend ? raw < 0 : raw >= 0;
        }
    }

    private string TrendClass => IsPositiveTrend ? "sgc-kpi-up" : "sgc-kpi-down";

    private string TrendAriaLabel
    {
        get
        {
            var dir = IsPositiveTrend ? "up" : "down";
            if (TrendPercent.HasValue) return $"Trend {dir} {Math.Abs(TrendPercent.Value):0.#}%";
            if (TrendValue.HasValue)   return $"Trend {dir} {Math.Abs(TrendValue.Value):0.##}";
            return $"Trend {dir}";
        }
    }

    private string TrendIconSvg => IsPositiveTrend
        ? (TrendUpIcon ?? ArrowUpSvg)
        : (TrendDownIcon ?? ArrowDownSvg);

    private double ProgressBarPct => ProgressBarMax > 0
        ? Math.Clamp((Value ?? 0) / ProgressBarMax, 0, 1)
        : 0;

    private string FormattedValue
    {
        get
        {
            if (FormatLabel is not null && DisplayValue.HasValue) return FormatLabel(DisplayValue.Value);
            if (!string.IsNullOrEmpty(ValueText)) return ValueText;
            var val = DisplayValue;
            if (!val.HasValue) return "—";
            if (!string.IsNullOrEmpty(Format)) return val.Value.ToString(Format);
            return val.Value % 1 == 0
                ? ((long)val.Value).ToString("N0")
                : val.Value.ToString("G");
        }
    }

    private string? ValueColorStyle => !string.IsNullOrEmpty(ValueColor) ? $"color:{ValueColor};" : null;

    private string? IconStyle
    {
        get
        {
            if (string.IsNullOrEmpty(IconColor) && string.IsNullOrEmpty(IconBackground)) return null;
            var sb = new System.Text.StringBuilder();
            if (!string.IsNullOrEmpty(IconColor))      sb.Append($"color:{IconColor};");
            if (!string.IsNullOrEmpty(IconBackground)) sb.Append($"background:{IconBackground};");
            return sb.ToString();
        }
    }

    private string? AriaLabel => Clickable ? (Title ?? "KPI Card") : null;

    private string RootClass
    {
        get
        {
            var mode = DisplayMode switch
            {
                SgKPIDisplayMode.Ring     => "sgc-kpi-ring",
                SgKPIDisplayMode.Inline   => "sgc-kpi-inline",
                SgKPIDisplayMode.Ban      => "sgc-kpi-ban",
                SgKPIDisplayMode.Analytic => "sgc-kpi-analytic",
                _                         => "sgc-kpi-card"
            };
            var cls = new List<string> { "sgc-kpi", mode, $"sgc-kpi-{SizeKey}", $"sgc-kpi-v-{VariantKey}" };
            if (Clickable)                            cls.Add("sgc-kpi-clickable");
            if (IsLoading)                            cls.Add("sgc-kpi-loading");
            if (HasChart)                             cls.Add("sgc-kpi-has-chart");
            if (Glass)                                cls.Add("sgc-kpi-glass");
            if (Flipable)                             cls.Add("sgc-kpi-flipable");
            if (ShowMiniGauge && (DisplayMode == SgKPIDisplayMode.Card || DisplayMode == SgKPIDisplayMode.Ban))
                                                      cls.Add("sgc-kpi-has-gauge");
            if (Compact)                              cls.Add("sgc-kpi-compact");
            if (!string.IsNullOrEmpty(CornerBadge))   cls.Add("sgc-kpi-has-badge");
            if (MountAnimation)                       cls.Add("sgc-kpi-mount-animate");
            if (!string.IsNullOrWhiteSpace(CssClass)) cls.Add(CssClass!);
            return string.Join(' ', cls);
        }
    }

    private string? RootStyle => string.IsNullOrWhiteSpace(Style) ? null : Style;

    private string SizeKey => Size switch
    {
        SgSize.Sm => "sm",
        SgSize.Lg => "lg",
        SgSize.Xl => "xl",
        _         => "md"
    };

    private string VariantKey => Variant switch
    {
        SgKPIVariant.Primary => "primary",
        SgKPIVariant.Success => "success",
        SgKPIVariant.Warning => "warning",
        SgKPIVariant.Danger  => "danger",
        SgKPIVariant.Info    => "info",
        _                    => "default"
    };

    private string RingColor => Variant switch
    {
        SgKPIVariant.Success => "#10b981",
        SgKPIVariant.Warning => "#f59e0b",
        SgKPIVariant.Danger  => "#f43f5e",
        SgKPIVariant.Info    => "#0ea5e9",
        SgKPIVariant.Primary => "#006fee",
        _                    => "#9ca3af"
    };

    // ── Status dot helpers ────────────────────────────────────────────────────

    private string StatusDotClass => StatusDot switch
    {
        SgAvatarStatus.Online  => "sgc-kpi-status-dot-online",
        SgAvatarStatus.Offline => "sgc-kpi-status-dot-offline",
        SgAvatarStatus.Busy    => "sgc-kpi-status-dot-busy",
        SgAvatarStatus.Away    => "sgc-kpi-status-dot-away",
        _                      => ""
    };

    // ── Comparison helpers ────────────────────────────────────────────────────

    private double? ComparisonDiff => ComparisonValue.HasValue && Value.HasValue
        ? Value.Value - ComparisonValue.Value : null;

    private double? ComparisonPct => ComparisonValue.HasValue && ComparisonValue.Value != 0 && Value.HasValue
        ? ((Value.Value - ComparisonValue.Value) / Math.Abs(ComparisonValue.Value)) * 100.0 : null;

    private bool IsComparisonPositive => ComparisonDiff >= 0;
    private string ComparisonDiffClass => IsComparisonPositive ? "sgc-kpi-up" : "sgc-kpi-down";

    // ── Mini gauge helpers ────────────────────────────────────────────────────

    private double GaugeMax => Target ?? (ChartData is { Length: > 0 } ? ChartData.Max() : Value ?? 100);
    private double GaugePct => GaugeMax > 0 ? Math.Min(1.0, Math.Max(0.0, (Value ?? 0) / GaugeMax)) : 0;

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnParametersSetAsync()
    {
        if (AnimatedValue && Value.HasValue && Value != _previousValue)
        {
            _previousValue = Value;
            _cts?.Cancel();
            _cts?.Dispose();
            _cts = new CancellationTokenSource();
            _displayValue = 0;
            var target = Value.Value;
            var token = _cts.Token;
            _animationTask = AnimateValueAsync(target, AnimateDuration, token);
        }
        else if (!AnimatedValue)
        {
            _displayValue = Value ?? 0;
        }
        _previousValue = Value;
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private async Task AnimateValueAsync(double target, int durationMs, CancellationToken ct)
    {
        var start = DateTime.UtcNow;
        try
        {
            while (!ct.IsCancellationRequested)
            {
                var elapsed = (DateTime.UtcNow - start).TotalMilliseconds;
                if (elapsed >= durationMs)
                {
                    _displayValue = target;
                    await InvokeAsync(StateHasChanged);
                    return;
                }
                var progress = elapsed / durationMs;
                progress = 1.0 - Math.Pow(1.0 - progress, 3);
                _displayValue = progress * target;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(16, ct);
            }
        }
        catch (OperationCanceledException) { }
    }

    // ── Body — routes to the correct mode renderer ────────────────────────────

    private RenderFragment RenderBody() => __builder =>
    {
        if (IsLoading)
        {
            __builder.AddContent(0, RenderSkeleton());
        }
        else if (DisplayMode == SgKPIDisplayMode.Ring)
        {
            __builder.AddContent(1, RenderRing());
        }
        else if (DisplayMode == SgKPIDisplayMode.Inline)
        {
            __builder.AddContent(2, RenderInline());
        }
        else if (DisplayMode == SgKPIDisplayMode.Ban)
        {
            __builder.AddContent(3, RenderBan());
        }
        else if (DisplayMode == SgKPIDisplayMode.Analytic)
        {
            __builder.AddContent(4, RenderAnalytic());
        }
        else
        {
            __builder.AddContent(5, RenderCard());
        }
    };

    // ── Render fragments ──────────────────────────────────────────────────────

    private RenderFragment RenderSkeleton() => __builder =>
    {
        <div class="sgc-kpi-body">
            <div class="sgc-kpi-skeleton">
                <div class="sgc-kpi-skel-row">
                    <SgSkeleton Width="32px" Height="32px" Shape="SgSkeletonShape.Rect" />
                    <div class="sgc-kpi-skel-lines">
                        <SgSkeleton Width="55%" Height="11px" />
                        <SgSkeleton Width="35%" Height="9px" />
                    </div>
                </div>
                <SgSkeleton Width="48%" Height="30px" CssClass="sgc-kpi-skel-val" />
                <SgSkeleton Width="38%" Height="9px" />
            </div>
        </div>
    };

    private RenderFragment RenderCard() => __builder =>
    {
        <div class="sgc-kpi-body">
            @RenderCornerBadge()
            <div class="sgc-kpi-header">
                <div class="sgc-kpi-header-text">
                    @RenderStatusDot()
                    @if (!string.IsNullOrEmpty(Title))   { <span class="sgc-kpi-title">@Title</span> }
                    @if (!string.IsNullOrEmpty(Subtitle)){ <span class="sgc-kpi-subtitle">@Subtitle</span> }
                </div>
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <div class="sgc-kpi-icon" style="@IconStyle" aria-hidden="true">@((MarkupString)Icon)</div>
                }
                @if (ActionContent is not null)
                {
                    <div class="sgc-kpi-action" @onclick:stopPropagation="true">@ActionContent</div>
                }
            </div>

            @if (ShowMiniGauge && (DisplayMode == SgKPIDisplayMode.Card || DisplayMode == SgKPIDisplayMode.Ban))
            {
                @RenderMiniGauge()
            }

            <div class="sgc-kpi-spacer"></div>

            <div class="sgc-kpi-value-row">
                <span class="sgc-kpi-value" style="@ValueColorStyle">
                    @if (!string.IsNullOrEmpty(Prefix)) { <span class="sgc-kpi-affix sgc-kpi-prefix">@Prefix</span> }
                    @FormattedValue
                    @if (!string.IsNullOrEmpty(Suffix)) { <span class="sgc-kpi-affix sgc-kpi-suffix">@Suffix</span> }
                </span>
            </div>

            @if (!string.IsNullOrEmpty(Description)) { <div class="sgc-kpi-description">@Description</div> }

            @RenderComparison()

            @RenderForecast()

            @if (ShowTrend && (TrendPercent.HasValue || TrendValue.HasValue))
            {
                <div class="sgc-kpi-trend-wrap">
                    <span class="sgc-kpi-trend-pill @TrendClass" aria-label="@TrendAriaLabel">
                        <span class="sgc-kpi-trend-icon" aria-hidden="true">
                            @((MarkupString)TrendIconSvg)
                        </span>
                        <span class="sgc-kpi-trend-val">@TrendText</span>
                    </span>
                    @if (!string.IsNullOrEmpty(TrendLabel)) { <span class="sgc-kpi-trend-label">@TrendLabel</span> }
                </div>
            }

            @if (Target.HasValue && Value.HasValue)
            {
                var pct = Math.Min(100.0, Math.Max(0.0, Value!.Value / Target!.Value * 100.0));
                <div class="sgc-kpi-progress" role="progressbar"
                     aria-valuenow="@((int)pct)" aria-valuemin="0" aria-valuemax="100">
                    <div class="sgc-kpi-progress-track">
                        <div class="sgc-kpi-progress-fill" style="width:@(pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    </div>
                    <span class="sgc-kpi-progress-label">@($"{pct:0}%")
                        @if (!string.IsNullOrEmpty(TargetLabel)) { <span class="sgc-kpi-progress-target"> @TargetLabel</span> }
                    </span>
                </div>
            }

            @RenderProgressBar()

            @if (FooterContent is not null) { <div class="sgc-kpi-footer">@FooterContent</div> }
        </div>

        @if (HasChart)
        {
            <div class="sgc-kpi-wave" aria-hidden="true">@RenderChart()</div>
        }
    };

    private RenderFragment RenderRing() => __builder =>
    {
        var (sz, sw, fs, lfs) = Size switch
        {
            SgSize.Sm => (80,  7,  18, 10),
            SgSize.Lg => (130, 10, 32, 13),
            SgSize.Xl => (160, 12, 40, 14),
            _         => (100, 8,  24, 11)
        };

        var r    = (sz - sw) / 2.0;
        var circ = 2 * Math.PI * r;
        var pct  = (Target.HasValue && Value.HasValue)
            ? Math.Min(1.0, Math.Max(0.0, Value!.Value / Target!.Value))
            : 1.0;
        var dash = pct * circ;
        var gap  = circ - dash;
        var ic   = System.Globalization.CultureInfo.InvariantCulture;
        var cx   = sz / 2.0;
        var cy   = sz / 2.0;
        var color = !string.IsNullOrEmpty(IconColor) ? IconColor : RingColor;

        <div class="sgc-kpi-ring-wrap">
            <svg class="sgc-kpi-ring-svg"
                 viewBox="@($"0 0 {sz} {sz}")"
                 width="@sz" height="@sz"
                 aria-hidden="true">
                <circle cx="@cx.ToString("F1",ic)" cy="@cy.ToString("F1",ic)"
                        r="@r.ToString("F1",ic)"
                        fill="none"
                        stroke="var(--sg-bg-muted,#f3f4f6)"
                        stroke-width="@sw" />
                <circle cx="@cx.ToString("F1",ic)" cy="@cy.ToString("F1",ic)"
                        r="@r.ToString("F1",ic)"
                        fill="none"
                        stroke="@color"
                        stroke-width="@sw"
                        stroke-linecap="round"
                        stroke-dasharray="@($"{dash.ToString("F2",ic)} {gap.ToString("F2",ic)}")"
                        transform="@($"rotate(-90 {cx.ToString("F1",ic)} {cy.ToString("F1",ic)})")" />
                <text x="@cx.ToString("F1",ic)" y="@cy.ToString("F1",ic)"
                      text-anchor="middle" dominant-baseline="central"
                      font-size="@fs" font-weight="700"
                      fill="var(--sg-fg,#111827)"
                      font-family="inherit">
                    @FormattedValue
                </text>
            </svg>
            @if (!string.IsNullOrEmpty(Title))
            {
                <span class="sgc-kpi-ring-label" style="@($"font-size:{lfs}px")">
                    @RenderStatusDot()
                    @Title
                </span>
            }
        </div>
    };

    private RenderFragment RenderInline() => __builder =>
    {
        var color = !string.IsNullOrEmpty(ChartColor)
            ? ChartColor
            : IsPositiveTrend ? "#10b981" : "#f43f5e";

        <div class="sgc-kpi-inline-label">
            @if (StatusDot.HasValue && StatusDot.Value != SgAvatarStatus.None)
            {
                <span class="sgc-kpi-status-dot">
