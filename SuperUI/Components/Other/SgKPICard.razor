                    @if (!string.IsNullOrEmpty(StatusText)) { <span class="sgc-kpi-status-dot-text">@StatusText</span> }
                </span>
            }
            @if (!string.IsNullOrEmpty(Icon))
            {
                <span class="sgc-kpi-inline-icon" style="@IconStyle" aria-hidden="true">@((MarkupString)Icon)</span>
            }
            @if (!string.IsNullOrEmpty(Title))
            {
                <span class="sgc-kpi-inline-title">@Title</span>
            }
        </div>

        <div class="sgc-kpi-inline-value">
            @if (!string.IsNullOrEmpty(Prefix)) { <span class="sgc-kpi-affix sgc-kpi-prefix">@Prefix</span> }
            <span class="sgc-kpi-value" style="@ValueColorStyle">@FormattedValue</span>
            @if (!string.IsNullOrEmpty(Suffix)) { <span class="sgc-kpi-affix sgc-kpi-suffix">@Suffix</span> }
        </div>

        @if (HasChart)
        {
            <div class="sgc-kpi-inline-spark" aria-hidden="true">
                @RenderDotSparkline(color)
            </div>
        }

        @if (ShowTrend && (TrendPercent.HasValue || TrendValue.HasValue))
        {
