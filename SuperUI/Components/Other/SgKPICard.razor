    // ── Dot sparkline (Inline mode) ───────────────────────────────────────────
    private RenderFragment RenderDotSparkline(string color) => __builder =>
    {
        if (ChartData is not { Length: > 1 }) return;
        var data  = ChartData;
        var count = data.Length;
        var min   = data.Min();
        var max   = data.Max();
        var range = max - min;
        const double W = 80.0, H = 24.0, PT = 3.0;
        var ic = System.Globalization.CultureInfo.InvariantCulture;

        var pts = Enumerable.Range(0, count)
            .Select(i => (
                x: count == 1 ? W / 2 : W * i / (count - 1),
                y: range < 1e-9 ? H / 2 : PT + (H - PT) * (1.0 - (data[i] - min) / range)
            )).ToArray();
        var path = BuildSmoothPath(pts);

        __builder.OpenElement(0, "svg");
        __builder.AddAttribute(1, "viewBox", $"0 0 {W} {H}");
        __builder.AddAttribute(2, "preserveAspectRatio", "none");
        __builder.AddAttribute(3, "class", "sgc-kpi-dot-svg");

        __builder.OpenElement(4, "path");
        __builder.AddAttribute(5, "d",              path);
        __builder.AddAttribute(6, "fill",           "none");
        __builder.AddAttribute(7, "stroke",         color);
        __builder.AddAttribute(8, "stroke-width",   "1.5");
        __builder.AddAttribute(9, "stroke-dasharray", "3 2");
        __builder.AddAttribute(10, "stroke-linecap", "round");
        __builder.CloseElement();

        foreach (var (i, pt) in pts.Select((p, i) => (i, p)))
        {
            var isLast = i == count - 1;
            __builder.OpenElement(11 + i * 3, "circle");
            __builder.AddAttribute(12 + i * 3, "cx",   pt.x.ToString("F2", ic));
            __builder.AddAttribute(13 + i * 3, "cy",   pt.y.ToString("F2", ic));
            __builder.AddAttribute(14 + i * 3, "r",    isLast ? "3" : "2");
            __builder.AddAttribute(15 + i * 3, "fill", color);
            __builder.AddAttribute(16 + i * 3, "stroke", "var(--sgc-card-bg,#fff)");
            __builder.AddAttribute(17 + i * 3, "stroke-width", "1.5");
            __builder.CloseElement();
        }

        __builder.CloseElement();
    };

    // ── Wave / area chart (Card mode) ─────────────────────────────────────────
    private RenderFragment RenderChart() => __builder =>
    {
        if (ChartData is not { Length: > 1 }) return;

        var data  = ChartData;
        var count = data.Length;
        var min   = data.Min();
        var max   = data.Max();
        var range = max - min;
        var ch = (ChartHeight ?? 60);
        const double W = 200.0;
        double H = ch, PT = 4.0;

        var color = !string.IsNullOrEmpty(ChartColor) ? ChartColor : "rgba(255,255,255,0.9)";
        var ic    = System.Globalization.CultureInfo.InvariantCulture;

        var points = Enumerable.Range(0, count).Select(i => (
            x: count == 1 ? W / 2 : W * i / (count - 1),
            y: range < 1e-9 ? H / 2 : PT + (H - PT) * (1.0 - (data[i] - min) / range)
        )).ToArray();

        // ── Bar chart ─────────────────────────────────────────────────────────
        if (ChartType is SgKPIChartType.Bar or SgKPIChartType.SparkBar)
        {
            __builder.OpenElement(0, "svg");
            __builder.AddAttribute(1, "viewBox", $"0 0 {W} {H}");
            __builder.AddAttribute(2, "preserveAspectRatio", "none");
            __builder.AddAttribute(3, "class", "sgc-kpi-wave-svg");

            var slot = W / count;
            var bw   = slot * 0.6;
            var boff = slot * 0.2;
            for (int i = 0; i < count; i++)
            {
                var bx = slot * i + boff;
                var by = range < 1e-9 ? H / 2 : PT + (H - PT) * (1.0 - (data[i] - min) / range);
                var bh = H - by;
                var op = 0.5 + 0.5 * (bh / H);
                __builder.OpenElement(5, "rect");
                __builder.AddAttribute(6,  "x",       bx.ToString("F2", ic));
                __builder.AddAttribute(7,  "y",       by.ToString("F2", ic));
                __builder.AddAttribute(8,  "width",   bw.ToString("F2", ic));
                __builder.AddAttribute(9,  "height",  bh.ToString("F2", ic));
                __builder.AddAttribute(10, "fill",    color);
                __builder.AddAttribute(11, "rx",      "2");
                __builder.AddAttribute(12, "opacity", op.ToString("F2", ic));
                __builder.CloseElement();
            }
            __builder.CloseElement();
        }
        // ── Step chart ────────────────────────────────────────────────────────
        else if (ChartType == SgKPIChartType.Step)
        {
            __builder.OpenElement(0, "svg");
            __builder.AddAttribute(1, "viewBox", $"0 0 {W} {H}");
            __builder.AddAttribute(2, "preserveAspectRatio", "none");
            __builder.AddAttribute(3, "class", "sgc-kpi-wave-svg");

            var sb = new System.Text.StringBuilder();
            sb.Append($"M {points[0].x.ToString("F2",ic)},{points[0].y.ToString("F2",ic)}");
            for (int i = 1; i < points.Length; i++)
            {
                sb.Append($" L {points[i].x.ToString("F2",ic)},{points[i-1].y.ToString("F2",ic)}");
                sb.Append($" L {points[i].x.ToString("F2",ic)},{points[i].y.ToString("F2",ic)}");
            }

            __builder.OpenElement(4, "polyline");
            __builder.AddAttribute(5, "points",           sb.ToString());
            __builder.AddAttribute(6, "fill",             "none");
            __builder.AddAttribute(7, "stroke",           color);
            __builder.AddAttribute(8, "stroke-width",     "2");
            __builder.AddAttribute(9, "stroke-linecap",   "round");
            __builder.AddAttribute(10, "stroke-linejoin", "round");
            __builder.CloseElement();
            __builder.CloseElement();
        }
        // ── Candle chart ──────────────────────────────────────────────────────
        else if (ChartType == SgKPIChartType.Candle)
        {
            __builder.OpenElement(0, "svg");
            __builder.AddAttribute(1, "viewBox", $"0 0 {W} {H}");
            __builder.AddAttribute(2, "preserveAspectRatio", "none");
            __builder.AddAttribute(3, "class", "sgc-kpi-wave-svg");

            var slot = W / count;
            var cw   = slot * 0.5;
            var coff = slot * 0.25;

            for (int i = 0; i < count; i++)
            {
                var open  = i > 0 ? data[i - 1] : data[0] * 0.98;
                var close = data[i];
                var hi    = Math.Max(open, close) * 1.01 + 0.01;
                var lo    = Math.Min(open, close) * 0.99 - 0.01;
                var isUp  = close >= open;

                var cxVal = slot * i + coff + cw / 2;
                var hiY   = range < 1e-9 ? H / 2 : PT + (H - PT) * (1.0 - (hi - min) / range);
                var loY   = range < 1e-9 ? H / 2 : PT + (H - PT) * (1.0 - (lo - min) / range);
                var openY = range < 1e-9 ? H / 2 : PT + (H - PT) * (1.0 - (open - min) / range);
                var closeY = range < 1e-9 ? H / 2 : PT + (H - PT) * (1.0 - (close - min) / range);
                var rectY  = Math.Min(openY, closeY);
                var rectH  = Math.Max(1.0, Math.Abs(closeY - openY));
                var candleColor = isUp ? "#10b981" : "#f43f5e";

                // Wick
                __builder.OpenElement(5 + i * 5, "line");
                __builder.AddAttribute(6 + i * 5, "x1", cxVal.ToString("F2", ic));
                __builder.AddAttribute(7 + i * 5, "y1", hiY.ToString("F2", ic));
                __builder.AddAttribute(8 + i * 5, "x2", cxVal.ToString("F2", ic));
                __builder.AddAttribute(9 + i * 5, "y2", loY.ToString("F2", ic));
                __builder.AddAttribute(10 + i * 5, "stroke", candleColor);
                __builder.AddAttribute(11 + i * 5, "stroke-width", "1");
                __builder.CloseElement();

                // Body
                __builder.OpenElement(12 + i * 5, "rect");
                __builder.AddAttribute(13 + i * 5, "x",      (slot * i + coff).ToString("F2", ic));
                __builder.AddAttribute(14 + i * 5, "width",  cw.ToString("F2", ic));
                __builder.AddAttribute(15 + i * 5, "y",      rectY.ToString("F2", ic));
                __builder.AddAttribute(16 + i * 5, "height", rectH.ToString("F2", ic));
                __builder.AddAttribute(17 + i * 5, "fill",   candleColor);
                __builder.AddAttribute(18 + i * 5, "rx",     "1");
                __builder.CloseElement();
            }
            __builder.CloseElement();
        }
        // ── Area chart ────────────────────────────────────────────────────────
        else if (ChartType is SgKPIChartType.Area or SgKPIChartType.SparkArea)
        {
            var path = BuildSmoothPath(points);
            var gid  = $"kpi-wg-{Math.Abs(GetHashCode())}";

            __builder.OpenElement(0, "svg");
            __builder.AddAttribute(1, "viewBox", $"0 0 {W} {H}");
            __builder.AddAttribute(2, "preserveAspectRatio", "none");
            __builder.AddAttribute(3, "class", "sgc-kpi-wave-svg");

            __builder.OpenElement(4, "defs");
            __builder.OpenElement(5, "linearGradient");
            __builder.AddAttribute(6, "id", gid);
            __builder.AddAttribute(7, "x1", "0"); __builder.AddAttribute(8, "y1", "0");
            __builder.AddAttribute(9, "x2", "0"); __builder.AddAttribute(10, "y2", "1");
            __builder.OpenElement(11, "stop");
            __builder.AddAttribute(12, "offset", "0%");
            __builder.AddAttribute(13, "stop-color", color);
            __builder.AddAttribute(14, "stop-opacity", "0.45");
            __builder.CloseElement();
            __builder.OpenElement(15, "stop");
            __builder.AddAttribute(16, "offset", "100%");
            __builder.AddAttribute(17, "stop-color", color);
            __builder.AddAttribute(18, "stop-opacity", "0.05");
            __builder.CloseElement();
            __builder.CloseElement(); // linearGradient
            __builder.CloseElement(); // defs

            var x0   = points[0].x.ToString("F2", ic);
            var xEnd = points[^1].x.ToString("F2", ic);
            var bot  = H.ToString("F2", ic);
            __builder.OpenElement(19, "path");
            __builder.AddAttribute(20, "d",    $"{path} L {xEnd},{bot} L {x0},{bot} Z");
            __builder.AddAttribute(21, "fill", $"url(#{gid})");
            __builder.CloseElement();

            __builder.OpenElement(22, "path");
            __builder.AddAttribute(23, "d",               path);
            __builder.AddAttribute(24, "fill",            "none");
            __builder.AddAttribute(25, "stroke",          color);
            __builder.AddAttribute(26, "stroke-width",    "2");
            __builder.AddAttribute(27, "stroke-linecap",  "round");
            __builder.AddAttribute(28, "stroke-linejoin", "round");
            __builder.CloseElement();

            __builder.CloseElement(); // svg
        }
        // ── Line chart (default) ──────────────────────────────────────────────
        else // Line, SparkLine
        {
            var path = BuildSmoothPath(points);

            __builder.OpenElement(0, "svg");
            __builder.AddAttribute(1, "viewBox", $"0 0 {W} {H}");
            __builder.AddAttribute(2, "preserveAspectRatio", "none");
            __builder.AddAttribute(3, "class", "sgc-kpi-wave-svg");

            __builder.OpenElement(4, "path");
            __builder.AddAttribute(5, "d",               path);
            __builder.AddAttribute(6, "fill",            "none");
            __builder.AddAttribute(7, "stroke",          color);
            __builder.AddAttribute(8, "stroke-width",    "2");
            __builder.AddAttribute(9, "stroke-linecap",  "round");
            __builder.AddAttribute(10, "stroke-linejoin","round");
            __builder.CloseElement();

            __builder.CloseElement(); // svg
        }
    };

    // ── BAN mode ──────────────────────────────────────────────────────────────
    private RenderFragment RenderBan() => __builder =>
    {
        @RenderCornerBadge()
        <div class="sgc-kpi-ban-header">
            @if (StatusDot.HasValue && StatusDot.Value != SgAvatarStatus.None)
            {
                @RenderStatusDot()
            }
            @if (!string.IsNullOrEmpty(Icon))
            {
                <span class="sgc-kpi-ban-icon" style="@IconStyle" aria-hidden="true">@((MarkupString)Icon)</span>
            }
            <span class="sgc-kpi-ban-title">@Title</span>
            @if (ActionContent is not null)
            {
                <div class="sgc-kpi-action" @onclick:stopPropagation="true">@ActionContent</div>
            }
        </div>

        <div class="sgc-kpi-ban-center">
            @if (ShowMiniGauge && DisplayMode == SgKPIDisplayMode.Ban)
            {
                @RenderMiniGauge()
            }

            <span class="sgc-kpi-ban-value" style="@ValueColorStyle">
                @if (!string.IsNullOrEmpty(Prefix)) { <span class="sgc-kpi-affix sgc-kpi-prefix">@Prefix</span> }
                @FormattedValue
                @if (!string.IsNullOrEmpty(Suffix)) { <span class="sgc-kpi-affix sgc-kpi-suffix">@Suffix</span> }
            </span>

            @if (ShowTrend && (TrendPercent.HasValue || TrendValue.HasValue))
            {
                <span class="sgc-kpi-ban-badge @TrendClass" aria-label="@TrendAriaLabel">
                    <span class="sgc-kpi-trend-icon" aria-hidden="true">
                        @((MarkupString)TrendIconSvg)
                    </span>
                    @TrendText
                </span>
            }
        </div>

        @if (!string.IsNullOrEmpty(TrendLabel))
        {
            <div class="sgc-kpi-ban-sublabel">@TrendLabel</div>
        }

        @RenderComparison()
        @RenderForecast()

        @if (Deltas is { Count: > 0 })
        {
            <div class="sgc-kpi-ban-deltas">
                @foreach (var d in Deltas)
                {
                    var dc = (d.Value >= 0) != d.Invert ? "sgc-kpi-up" : "sgc-kpi-down";
                    <div class="sgc-kpi-ban-delta">
                        <span class="sgc-kpi-ban-delta-label">@d.Label</span>
                        <span class="sgc-kpi-ban-delta-val @dc">
                            @((MarkupString)((d.Value >= 0) != d.Invert ? ArrowUpSvg : ArrowDownSvg))
                            @FormatDelta(d)
                        </span>
                    </div>
                }
            </div>
        }

        @RenderProgressBar()

        @if (FooterContent is not null) { <div class="sgc-kpi-footer">@FooterContent</div> }
    };

    // ── Analytic mode ─────────────────────────────────────────────────────────
    private RenderFragment RenderAnalytic() => __builder =>
    {
        var sparkColor = !string.IsNullOrEmpty(ChartColor)
            ? ChartColor
            : IsPositiveTrend ? "#10b981" : "#f43f5e";

        @RenderCornerBadge()
        <div class="sgc-kpi-an-header">
            @if (StatusDot.HasValue && StatusDot.Value != SgAvatarStatus.None)
            {
                @RenderStatusDot()
            }
            @if (!string.IsNullOrEmpty(Icon))
            {
                <span class="sgc-kpi-an-icon" style="@IconStyle" aria-hidden="true">@((MarkupString)Icon)</span>
            }
            <span class="sgc-kpi-an-title">@Title</span>
            @if (ActionContent is not null)
            {
                <div class="sgc-kpi-action" @onclick:stopPropagation="true">@ActionContent</div>
            }
        </div>

        @if (HasChart)
        {
            <div class="sgc-kpi-an-chart" aria-hidden="true">
                @RenderAnalyticSparkline(sparkColor)
            </div>
        }

        @if (!string.IsNullOrEmpty(PeriodLabel))
        {
            <div class="sgc-kpi-an-period">@PeriodLabel</div>
        }

        <div class="sgc-kpi-an-value-row">
            <span class="sgc-kpi-an-value" style="@ValueColorStyle">
                @if (!string.IsNullOrEmpty(Prefix)) { <span class="sgc-kpi-affix sgc-kpi-prefix">@Prefix</span> }
                @FormattedValue
                @if (!string.IsNullOrEmpty(Suffix)) { <span class="sgc-kpi-affix sgc-kpi-suffix">@Suffix</span> }
            </span>
        </div>

        @RenderComparison()
        @RenderForecast()

        @if (Deltas is { Count: > 0 })
        {
            <div class="sgc-kpi-an-deltas">
                @foreach (var d in Deltas)
                {
                    var dc = (d.Value >= 0) != d.Invert ? "sgc-kpi-up" : "sgc-kpi-down";
                    <div class="sgc-kpi-an-delta">
                        @if (!string.IsNullOrEmpty(d.Label))
                        {
                            <span class="sgc-kpi-an-delta-label">@d.Label</span>
                        }
                        <span class="sgc-kpi-an-delta-val @dc">@FormatDelta(d)</span>
                    </div>
                }
            </div>
        }

        @RenderProgressBar()

        @if (FooterContent is not null) { <div class="sgc-kpi-footer">@FooterContent</div> }
    };

    // ── Analytic sparkline — jagged line with dots ────────────────────────────
    private RenderFragment RenderAnalyticSparkline(string color) => __builder =>
    {
        if (ChartData is not { Length: > 1 }) return;
        var data  = ChartData;
        var count = data.Length;
        var min   = data.Min();
        var max   = data.Max();
        var range = max - min;
        var ah = (ChartHeight ?? 56);
        const double W = 200.0;
        double H = ah;
        const double PT = 5.0, PB = 5.0;
        var ic = System.Globalization.CultureInfo.InvariantCulture;

        var pointList = Enumerable.Range(0, count).Select(i => (
            x: count == 1 ? W / 2 : W * i / (count - 1),
            y: range < 1e-9 ? H / 2 : PT + (H - PT - PB) * (1.0 - (data[i] - min) / range)
        )).ToArray();

        var pts = string.Join(" ", pointList.Select(p =>
            $"{p.x.ToString("F1", ic)},{p.y.ToString("F1", ic)}"));

        __builder.OpenElement(0, "svg");
        __builder.AddAttribute(1, "viewBox", $"0 0 {W} {H}");
        __builder.AddAttribute(2, "preserveAspectRatio", "none");
        __builder.AddAttribute(3, "class", "sgc-kpi-an-svg");

        __builder.OpenElement(4, "polyline");
        __builder.AddAttribute(5, "points",          pts);
        __builder.AddAttribute(6, "fill",            "none");
        __builder.AddAttribute(7, "stroke",          color);
        __builder.AddAttribute(8, "stroke-width",    "1.5");
        __builder.AddAttribute(9, "stroke-linecap",  "round");
        __builder.AddAttribute(10, "stroke-linejoin","round");
        __builder.CloseElement();

        int seq = 11;
        foreach (var pt in pointList)
        {
            __builder.OpenElement(seq++, "circle");
            __builder.AddAttribute(seq++, "cx",           pt.x.ToString("F1", ic));
            __builder.AddAttribute(seq++, "cy",           pt.y.ToString("F1", ic));
            __builder.AddAttribute(seq++, "r",            "2.5");
            __builder.AddAttribute(seq++, "fill",         "var(--sgc-card-bg,#fff)");
            __builder.AddAttribute(seq++, "stroke",       color);
            __builder.AddAttribute(seq++, "stroke-width", "1.5");
            __builder.CloseElement();
        }

        __builder.CloseElement();
    };

    // ═══════════════════════════════════════════════════════════════════════════
    //  NEW RENDER HELPERS
    // ═══════════════════════════════════════════════════════════════════════════

    // ── Status dot ────────────────────────────────────────────────────────────
    private RenderFragment RenderStatusDot() => __builder =>
    {
        if (StatusDot.HasValue && StatusDot.Value != SgAvatarStatus.None)
        {
            <span class="sgc-kpi-status-dot">
                <span class="sgc-kpi-status-dot-circle @StatusDotClass"></span>
                @if (!string.IsNullOrEmpty(StatusText))
                {
                    <span class="sgc-kpi-status-dot-text">@StatusText</span>
                }
            </span>
        }
    };

    // ── Comparison row ────────────────────────────────────────────────────────
    private RenderFragment RenderComparison() => __builder =>
    {
        if (!ComparisonValue.HasValue || !Value.HasValue) return;

        var pct = ComparisonPct;
        var diff = ComparisonDiff;
        var pctStr = pct.HasValue
            ? $" ({(IsComparisonPositive ? "+" : "")}{pct.Value:0.#}%)"
            : "";
        var diffStr = diff.HasValue
            ? $"{(IsComparisonPositive ? "+" : "")}{diff.Value:0.##}"
            : "";

        <div class="sgc-kpi-compare">
            @if (!string.IsNullOrEmpty(ComparisonLabel))
            {
                <span class="sgc-kpi-compare-label">@ComparisonLabel</span>
            }
            <span class="sgc-kpi-compare-values">
                <span class="sgc-kpi-compare-val">@ComparisonValue.Value.ToString(Format ?? "G")</span>
                @if (!string.IsNullOrEmpty(diffStr))
                {
                    <span class="sgc-kpi-compare-diff @ComparisonDiffClass">@diffStr</span>
                }
                @if (!string.IsNullOrEmpty(pctStr))
                {
                    <span class="sgc-kpi-compare-pct @ComparisonDiffClass">@pctStr</span>
                }
            </span>
        </div>
    };

    // ── Forecast row ──────────────────────────────────────────────────────────
    private RenderFragment RenderForecast() => __builder =>
    {
        if (!ForecastValue.HasValue) return;

        <div class="sgc-kpi-forecast">
            @if (!string.IsNullOrEmpty(ForecastLabel))
            {
                <span class="sgc-kpi-forecast-label">@ForecastLabel</span>
            }
            <span class="sgc-kpi-forecast-value">
                @(ForecastValue.Value.ToString(Format ?? "G"))
            </span>
        </div>
    };

    // ── Mini gauge ────────────────────────────────────────────────────────────
    private RenderFragment RenderMiniGauge() => __builder =>
    {
        if (!ShowMiniGauge) return;
        if (DisplayMode != SgKPIDisplayMode.Card && DisplayMode != SgKPIDisplayMode.Ban) return;

        const double sz = 44.0, sw = 4.0;
        var r = (sz - sw) / 2.0;
        var circ = 2 * Math.PI * r;
        var dash = GaugePct * circ;
        var gap = circ - dash;
        var pctDisplay = (int)(GaugePct * 100);
        var ic = System.Globalization.CultureInfo.InvariantCulture;
        var cx = sz / 2.0;
        var cy = sz / 2.0;

        <div class="sgc-kpi-mini-gauge">
            <svg class="sgc-kpi-mini-gauge-svg"
                 viewBox="@($"0 0 {sz} {sz}")"
                 aria-hidden="true">
                <circle cx="@cx.ToString("F1",ic)" cy="@cy.ToString("F1",ic)"
                        r="@r.ToString("F1",ic)"
                        fill="none"
                        stroke="rgba(255,255,255,0.15)"
                        stroke-width="@sw" />
                <circle cx="@cx.ToString("F1",ic)" cy="@cy.ToString("F1",ic)"
                        r="@r.ToString("F1",ic)"
                        fill="none"
                        stroke="#fff"
                        stroke-width="@sw"
                        stroke-linecap="round"
                        stroke-dasharray="@($"{dash.ToString("F2",ic)} {gap.ToString("F2",ic)}")"
                        transform="@($"rotate(-90 {cx.ToString("F1",ic)} {cy.ToString("F1",ic)})")"
                        opacity="0.85" />
                <text x="@cx.ToString("F1",ic)" y="@cy.ToString("F1",ic)"
                      text-anchor="middle" dominant-baseline="central"
                      font-size="9" font-weight="700"
                      fill="currentColor"
                      font-family="inherit">
                    @pctDisplay
                </text>
            </svg>
        </div>
    };

    // ── Progress bar ──────────────────────────────────────────────────────────
    private RenderFragment RenderProgressBar() => __builder =>
    {
        if (!ProgressBar || !Value.HasValue) return;
        var pct = ProgressBarPct * 100;
        var color = ProgressBarColor ?? "";
        var colorStyle = !string.IsNullOrEmpty(color) ? $"background:{color};" : "";

        <div class="sgc-kpi-pb" role="progressbar"
             aria-valuenow="@((int)pct)" aria-valuemin="0" aria-valuemax="100">
            <div class="sgc-kpi-pb-track">
                <div class="sgc-kpi-pb-fill" style="width:@(pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;@colorStyle"></div>
            </div>
        </div>
    };

    // ── Corner badge ──────────────────────────────────────────────────────────
    private RenderFragment RenderCornerBadge() => __builder =>
    {
        if (string.IsNullOrEmpty(CornerBadge)) return;
        var vk = CornerBadgeVariant switch
        {
            SgKPIVariant.Primary => "primary",
            SgKPIVariant.Success => "success",
            SgKPIVariant.Warning => "warning",
            SgKPIVariant.Danger  => "danger",
            SgKPIVariant.Info    => "info",
            _                    => "default"
        };

        <div class="sgc-kpi-badge sgc-kpi-badge-@vk">@CornerBadge</div>
    };

    // ── Utility ───────────────────────────────────────────────────────────────

    private static string FormatDelta(SgKPIDelta d)
    {
        var sign = d.Value >= 0 ? "+" : "";
        return d.IsPercent
            ? $"{sign}{d.Value:0.#}%"
            : $"{sign}{d.Value:0.##}";
    }

    private static string BuildSmoothPath((double x, double y)[] pts)
    {
        if (pts.Length == 0) return "";
        if (pts.Length == 1) return $"M {pts[0].x:F2},{pts[0].y:F2}";
        var ic = System.Globalization.CultureInfo.InvariantCulture;
        var sb = new System.Text.StringBuilder();
        sb.Append($"M {pts[0].x.ToString("F2",ic)},{pts[0].y.ToString("F2",ic)}");
        for (int i = 1; i < pts.Length; i++)
        {
            var prev = pts[i - 1];
            var curr = pts[i];
            var cpx  = (curr.x - prev.x) * 0.4;
            sb.Append($" C {(prev.x+cpx).ToString("F2",ic)},{prev.y.ToString("F2",ic)} {(curr.x-cpx).ToString("F2",ic)},{curr.y.ToString("F2",ic)} {curr.x.ToString("F2",ic)},{curr.y.ToString("F2",ic)}");
        }
        return sb.ToString();
    }

    private string TrendText
    {
        get
        {
            if (TrendPercent.HasValue) return $"{Math.Abs(TrendPercent.Value):0.#}%";
            if (TrendValue.HasValue)   return $"{(TrendValue.Value >= 0 ? "+" : "")}{TrendValue.Value:0.##}";
            return "";
        }
    }

    private async Task HandleClickAsync(MouseEventArgs _)
    {
        if (!Clickable || IsLoading) return;
        if (OnClick.HasDelegate) await OnClick.InvokeAsync();
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (!Clickable || IsLoading) return;
        if (e.Key is "Enter" or " " or "Spacebar")
            if (OnClick.HasDelegate) await OnClick.InvokeAsync();
    }

