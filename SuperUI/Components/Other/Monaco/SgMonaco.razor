@namespace SuperUI.Components
@using SuperUI.Enums
@inherits SgJsComponentBase

<div class="@Css("sg-monaco-container").Build()"
     style="@(Styles()
         .AddStyle("height", Height)
         .AddStyle("width", Width)
         .AddStyle("min-height", MinHeight)
         .AddStyle("max-height", MaxHeight)
         .AddStyle("position", "relative")
         .AddStyle("overflow", "hidden")
         .AddStyle("border:1px solid var(--sg-border-color, #d1d5db)")
         .AddStyle("border-radius:6px")
         .AddStyle("background:var(--sg-bg-primary, #fff)")
         .Build())"
     @ref="RootRef">

    @if (_error is not null)
    {
        <div class="sg-monaco-error" role="alert">
            <span>@_error</span>
            <button type="button" class="sg-monaco-retry-btn" @onclick="RetryAsync">Retry</button>
        </div>
    }
    else
    {
        <div @ref="_containerRef"
             class="sg-monaco-canvas"
             style="@(_ready ? null : "visibility:hidden;") position:absolute;inset:0;width:100%;height:100%;"></div>

        @if (!_ready)
        {
            <div class="sg-monaco-loading" aria-live="polite">
                <div class="sg-monaco-spinner" aria-hidden="true"></div>
                <span>Loading editor…</span>
            </div>
        }

        @if ((Options?.ReadOnly ?? false) && ReadOnlyBadge)
        {
            <div class="sg-monaco-readonly-badge" aria-label="Read Only">Read Only</div>
        }
    }
</div>
