@namespace SuperUI.Components
@using SuperUI.Models
@using Microsoft.JSInterop
@using SuperUI.Base.ComponentBases
@inherits SgJsComponentBase

<div @ref="RootRef" class="@Css("sgc-recorder-wrapper").Build()">
    @if (_isRecording)
    {
        <div class="sgc-recorder-indicator">
            <span class="sgc-dot"></span> RECORDING
        </div>
    }
    @ChildContent
</div>

<style>
    .sgc-recorder-wrapper {
        position: relative;
    }
    .sgc-recorder-indicator {
        position: absolute;
        top: 8px;
        right: 8px;
        background: rgba(0,0,0,0.7);
        color: #ff4d4f;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: bold;
        display: flex;
        align-items: center;
        z-index: 1000;
        pointer-events: none;
    }
    .sgc-dot {
        width: 8px;
        height: 8px;
        background: #ff4d4f;
        border-radius: 50%;
        margin-right: 6px;
        animation: sgc-blink 1s infinite;
    }
    @@keyframes sgc-blink {
        0% { opacity: 1; }
        50% { opacity: 0.3; }
        100% { opacity: 1; }
    }
</style>

@code {
    private bool _isRecording;
    private SgInteractionSession? _session;

    /// <summary>Content to record user interactions within.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Fires when a recording session completes.</summary>
    [Parameter] public EventCallback<SgInteractionSession> OnRecordingComplete { get; set; }
    /// <summary>Fires when a video capture is available.</summary>
    [Parameter] public EventCallback<string> OnVideoCaptured { get; set; }
    /// <summary>Fires when an email send is requested with recording data.</summary>
    [Parameter] public EventCallback<SgEmailSendRequest> OnEmailSendRequested { get; set; }
    /// <summary>Whether to record video of the user's interactions.</summary>
    [Parameter] public bool RecordVideo { get; set; }
    /// <summary>Whether to record audio of the user's interactions.</summary>
    [Parameter] public bool RecordAudio { get; set; }

    protected override string ModulePath => "./_content/SuperUI/superui-interaction-recorder.js";

    /// <summary>Starts recording user interactions.</summary>
    public async Task StartAsync()
    {
        _session = new SgInteractionSession { 
            UserAgent = await JS.InvokeAsync<string>("eval", "navigator.userAgent"),
            Url = await JS.InvokeAsync<string>("eval", "window.location.href")
        };
        
        var started = await SafeInvokeAsync<bool>("startRecording", RootRef, SelfRef, new { 
            recordVideo = RecordVideo,
            recordAudio = RecordAudio 
        });
        
        if (started)
        {
            _isRecording = true;
        }
        else
        {
            _isRecording = false;
        }
        StateHasChanged();
    }

    /// <summary>Stops recording and returns the interaction session.</summary>
    public async Task StopAsync()
    {
        _isRecording = false;
        await SafeInvokeVoidAsync("stopRecording");
        if (_session != null && OnRecordingComplete.HasDelegate)
        {
            await OnRecordingComplete.InvokeAsync(_session);
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void OnInteractionCaptured(SgInteractionEvent ev)
    {
        _session?.Events.Add(ev);
    }

    [JSInvokable]
    public async Task HandleVideoCaptured(string videoUrl)
    {
        if (OnVideoCaptured.HasDelegate)
        {
            await OnVideoCaptured.InvokeAsync(videoUrl);
        }
    }

    /// <summary>Exports the recorded session as a JSON string.</summary>
    public string ExportJson() => System.Text.Json.JsonSerializer.Serialize(_session);

    /// <summary>Downloads a file from the specified URL with the given file name.</summary>
    public async Task DownloadAsync(string url, string fileName)
    {
        await SafeInvokeVoidAsync("downloadUrl", url, fileName);
    }

    /// <summary>Requests sending the recorded video via email.</summary>
    public async Task RequestEmailSendAsync(string email, string videoUrl, string fileName)
    {
        if (OnEmailSendRequested.HasDelegate)
        {
            var base64 = await SafeInvokeAsync<string>("getBlobBase64", videoUrl);
            await OnEmailSendRequested.InvokeAsync(new SgEmailSendRequest
            {
                Email = email,
                FileName = fileName,
                Base64Data = base64,
                Session = _session
            });
        }
    }
}
