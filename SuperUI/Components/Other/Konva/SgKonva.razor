@namespace SuperUI.Components
@inherits SgJsComponentBase
<div class="@Css("sg-konva-container").Build()"
     style="@Styles().Add("height", Height).Add("width", Width).NullIfEmpty()"
     @attributes="AdditionalAttributes">

    @if (_error is not null)
    {
        <div class="sg-konva-error" role="alert">
            <p>@_error</p>
            <button type="button" class="sg-btn" @onclick="RetryAsync">@Localizer["Konva_Retry"]</button>
        </div>
    }
    else
    {
        @if (ShowToolbar && _ready)
        {
            <div class="sg-konva-toolbar" role="toolbar">
                <button type="button" class="sg-konva-tool" title="@Localizer["Konva_ZoomIn"]"
                        @onclick="ZoomInAsync" aria-label="@Localizer["Konva_ZoomIn"]">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path fill="currentColor" d="M6.5 1a5.5 5.5 0 1 0 3.17 9.9l3.22 3.21a.75.75 0 1 0 1.06-1.06L10.73 9.83A5.5 5.5 0 0 0 6.5 1ZM2.5 6.5a4 4 0 1 1 8 0 4 4 0 0 1-8 0ZM6 4.25a.75.75 0 0 1 .75.75v1.25H8a.75.75 0 0 1 0 1.5H6.75V9a.75.75 0 0 1-1.5 0V7.75H4a.75.75 0 0 1 0-1.5h1.25V5A.75.75 0 0 1 6 4.25Z"/>
                    </svg>
                </button>
                <button type="button" class="sg-konva-tool" title="@Localizer["Konva_ZoomOut"]"
                        @onclick="ZoomOutAsync" aria-label="@Localizer["Konva_ZoomOut"]">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path fill="currentColor" d="M6.5 1a5.5 5.5 0 1 0 3.17 9.9l3.22 3.21a.75.75 0 1 0 1.06-1.06L10.73 9.83A5.5 5.5 0 0 0 6.5 1ZM2.5 6.5a4 4 0 1 1 8 0 4 4 0 0 1-8 0ZM4 6.5a.75.75 0 0 1 .75-.75h3.5a.75.75 0 0 1 0 1.5h-3.5A.75.75 0 0 1 4 6.5Z"/>
                    </svg>
                </button>
                <button type="button" class="sg-konva-tool" title="@Localizer["Konva_FitView"]"
                        @onclick="FitViewAsync" aria-label="@Localizer["Konva_FitView"]">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path fill="currentColor" d="M1 1h4v1H2v3H1V1Zm10 0h4v4h-1V2h-3V1ZM1 11h1v3h3v1H1v-4Zm14 0v4h-4v-1h3v-3h1Z"/>
                    </svg>
                </button>
                <button type="button" class="sg-konva-tool" title="@Localizer["Konva_ExportPng"]"
                        @onclick="ExportPngAsync" aria-label="@Localizer["Konva_ExportPng"]">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path fill="currentColor" d="M8 1v8.6L5.7 7.3 4.3 8.7 8 12.4l3.7-3.7-1.4-1.4L9 9.6V1H8Zm-6 12h12v2H2v-2Z"/>
                    </svg>
                </button>
            </div>
        }

        <div @ref="_containerRef"
             class="sg-konva-canvas"
             style="@(_ready ? null : "visibility:hidden;")"></div>

        @if (!_ready)
        {
            <div class="sg-konva-loading" aria-live="polite">
                <div class="sg-konva-skeleton">
                    <span></span><span></span><span></span><span></span><span></span>
                </div>
                <span class="sg-konva-loading-text">@Localizer["Konva_Loading"]</span>
            </div>
        }
    }
</div>

@code {
    protected override string ModulePath => "./_content/SuperUI/sg-konva.js";
    protected override string IdPrefix => "sg-konva";

    private ElementReference _containerRef;
    private bool _ready;
    private string? _error;

    // Change-detection snapshots
    private object? _lastPlanRef;
    private object? _lastOptsRef;
    private bool _refreshScheduled;
    private bool _refreshPending;

    // ── Parameters ────────────────────────────────────────────────────────────

    /// <summary>Floor plan data to render.</summary>
    [Parameter] public SgFloorPlan? FloorPlan { get; set; }

    /// <summary>Canvas options (draggable rooms, etc.).</summary>
    [Parameter] public SgKonvaOptions? Options { get; set; }

    /// <summary>Container height. Default "500px".</summary>
    [Parameter] public string Height { get; set; } = "500px";

    /// <summary>Container width. Default "100%".</summary>
    [Parameter] public string Width { get; set; } = "100%";

    /// <summary>Show built-in toolbar (zoom, fit, export).</summary>
    [Parameter] public bool ShowToolbar { get; set; } = true;

    /// <summary>Konva.js source URL override.</summary>
    [Parameter] public SgKonvaSources? Sources { get; set; }

    /// <summary>Fired when a room or shape is clicked.</summary>
    [Parameter] public EventCallback<SgKonvaClickEventArgs> OnShapeClick { get; set; }

    /// <summary>Fired when a draggable room is moved.</summary>
    [Parameter] public EventCallback<SgKonvaDragEventArgs> OnShapeDrag { get; set; }

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override void OnParametersSet()
    {
        if (!_ready) return;
        var changed =
            !ReferenceEquals(FloorPlan, _lastPlanRef) ||
            !ReferenceEquals(Options,   _lastOptsRef);
        if (changed && !_refreshScheduled)
        {
            _refreshScheduled = true;
            _ = ScheduleRefreshAsync();
        }
    }

    private async Task ScheduleRefreshAsync()
    {
        try   { await RefreshAsync(); }
        finally
        {
            _refreshScheduled = false;
            if (_refreshPending)
            {
                _refreshPending   = false;
                _refreshScheduled = true;
                _ = ScheduleRefreshAsync();
            }
        }
    }

    protected override async ValueTask OnInteractiveAsync()
    {
        try
        {
            await InitAsync();
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch (Exception ex)
        {
            _error = $"{Localizer["Konva_FailedToLoad"]}: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task InitAsync()
    {
        try
        {
            var opts = BuildOpts();
            await SafeInvokeVoidAsync("initKonva",
                SelfRef, _containerRef, ResolvedId,
                FloorPlan, opts, Sources ?? new SgKonvaSources());
            _lastPlanRef = FloorPlan;
            _lastOptsRef = Options;
            _ready = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch (Exception ex)
        {
            _error = $"{Localizer["Konva_FailedToInitialize"]}: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private object BuildOpts()
    {
        var o = Options ?? new SgKonvaOptions();
        return new { draggable = o.DraggableRooms };
    }

    // ── Public methods ────────────────────────────────────────────────────────

    /// <summary>Redraws the floor plan with current data.</summary>
    public async Task RefreshAsync()
    {
        if (!_ready) { _refreshPending = true; return; }
        try
        {
            var opts = BuildOpts();
            await SafeInvokeVoidAsync("updateFloorPlan", ResolvedId, FloorPlan, opts);
            _lastPlanRef = FloorPlan;
            _lastOptsRef = Options;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch (Exception ex)
        {
            _error = $"{Localizer["Konva_FailedToRefresh"]}: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Updates a single room's status without full redraw.</summary>
    public async Task UpdateRoomStatusAsync(string roomId, SgFloorRoomStatus status)
    {
        try { await SafeInvokeVoidAsync("updateRoomStatus", ResolvedId, roomId, status.ToString()); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch { }
    }

    /// <summary>Resets zoom and pan to the default view.</summary>
    public async Task FitViewAsync()
    {
        try { await SafeInvokeVoidAsync("fitView", ResolvedId); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch { }
    }

    /// <summary>Zooms in.</summary>
    public async Task ZoomInAsync()
    {
        try { await SafeInvokeVoidAsync("zoomIn", ResolvedId); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch { }
    }

    /// <summary>Zooms out.</summary>
    public async Task ZoomOutAsync()
    {
        try { await SafeInvokeVoidAsync("zoomOut", ResolvedId); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch { }
    }

    /// <summary>Downloads the canvas as a PNG file.</summary>
    public async Task ExportPngAsync()
    {
        try { await SafeInvokeVoidAsync("exportPng", ResolvedId); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch { }
    }

    /// <summary>Retries loading after an error.</summary>
    public async Task RetryAsync()
    {
        _error = null; _ready = false;
        await InvokeAsync(StateHasChanged);
        await InitAsync();
    }

    // ── JS callbacks ──────────────────────────────────────────────────────────

    [JSInvokable]
    public async Task OnShapeClickedAsync(SgKonvaClickEventArgs args)
    {
        if (OnShapeClick.HasDelegate)
            await OnShapeClick.InvokeAsync(args);
    }

    [JSInvokable]
    public async Task OnShapeDraggedAsync(SgKonvaDragEventArgs args)
    {
        if (OnShapeDrag.HasDelegate)
            await OnShapeDrag.InvokeAsync(args);
    }

    // ── Dispose ───────────────────────────────────────────────────────────────

    protected override async ValueTask OnDisposingAsync()
    {
        try { await SafeInvokeVoidAsync("disposeKonva", ResolvedId); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch { }
    }
}
