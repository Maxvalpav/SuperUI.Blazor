@namespace SuperUI.Components

<div class="sgc-mfe-widget" style="padding: 16px; border-radius: 12px; background: white; border: 1px solid var(--sui-border-color); box-shadow: var(--sui-shadow-sm);">
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
        <div style="width: 32px; height: 32px; background: var(--sui-primary-color); color: white; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
            <SgIcon Icon="@SgIcons.Activity" />
        </div>
        <div>
            <div style="font-weight: 600; font-size: 14px;">@Title</div>
            <div style="font-size: 12px; color: var(--sui-fg-muted);">Blazor Micro Frontend</div>
        </div>
    </div>
    
    <div style="font-size: 13px; line-height: 1.5; margin-bottom: 16px;">
        @Description
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center;">
        <SgBadge Text="@Status" Variant="@(Status == "Active" ? SgBadgeVariant.Success : SgBadgeVariant.Default)" />
        <SgButton Text="Action" Size="SgSize.Sm" OnClick="HandleClick" />
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "MFE Widget";
    [Parameter] public string Description { get; set; } = "This is a Blazor component rendered as a Web Component.";
    [Parameter] public string Status { get; set; } = "Active";

    private void HandleClick()
    {
        Console.WriteLine($"Action clicked in MFE: {Title}");
    }
}
