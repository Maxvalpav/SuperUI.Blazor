@namespace SuperUI.Components
@typeparam TItem where TItem : class
@using SuperUI.Enums
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ISuperUILocalizer Localizer

<div class="sg-chart-container @(_chartReady ? null : "sg-chart-state-message") @CssClass"
     style="height: @Height; width: @Width;"
     @attributes="AdditionalAttributes">
    <CascadingValue Value="this">
        @ChildContent
    </CascadingValue>

    @if (_error is not null)
    {
        <div class="sg-chart-error" role="alert">
            <p>@_error</p>
            <button type="button" class="sg-btn" @onclick="RetryAsync">@Localizer["Chart_Retry"]</button>
        </div>
    }
    else
    {
        @if (Options?.ShowToolbar == true && _chartReady)
        {
            <div class="sg-chart-toolbar" role="toolbar">
                <button type="button" class="sg-chart-tool" title="@Localizer["Chart_ResetZoom"]"
                        @onclick="ResetZoomAsync" aria-label="@Localizer["Chart_ResetZoom"]">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path fill="currentColor" d="M3 8a5 5 0 1 1 1.46 3.54l1-1A3.5 3.5 0 1 0 4.5 8H6L4 10.5 2 8h1Z"/>
                    </svg>
                </button>
                <button type="button" class="sg-chart-tool" title="@Localizer["Chart_ExportPng"]"
                        @onclick="@(() => ExportImageAsync("png"))" aria-label="@Localizer["Chart_ExportPng"]">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path fill="currentColor" d="M8 1v8.6L5.7 7.3 4.3 8.7 8 12.4l3.7-3.7-1.4-1.4L9 9.6V1H8Zm-6 12h12v2H2v-2Z"/>
                    </svg>
                </button>
            </div>
        }

        <canvas @ref="_canvasRef"
                id="@_chartId"
                role="img"
                aria-label="@(Title ?? "Chart")"
                style="@(_chartReady ? null : "visibility:hidden;")"></canvas>

        @if (!_chartReady)
        {
            <div class="sg-chart-loading" aria-live="polite">
                <div class="sg-chart-skeleton">
                    <span></span><span></span><span></span><span></span><span></span>
                </div>
                <span class="sg-chart-loading-text">@Localizer["Chart_Loading"]</span>
            </div>
        }
        else if (_isEmpty)
        {
            <div class="sg-chart-empty">@Localizer["Chart_NoData"]</div>
        }
    }
</div>

@code {
    private ElementReference _canvasRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SgChart<TItem>>? _selfRef;
    private readonly string _chartId = $"sg-chart-{Guid.NewGuid():N}";
    private readonly List<SgChartDataset> _datasets = new();
    private SgChartXAxis? _xAxis;
    private SgChartYAxis? _yAxis;
    private bool _chartReady;
    private bool _isEmpty;
    private string? _error;
    private bool _isDisposed;

    // Snapshots used to detect parameter changes worth re-rendering the chart.
    private SgChartType _lastChartType;
    private object? _lastDataRef;
    private object? _lastOptionsRef;
    private string? _lastTitle;
    private bool _refreshScheduled;
    private bool _refreshPending;

    /// <summary>Gets or sets the chart type.</summary>
    [Parameter] public SgChartType ChartType { get; set; } = SgChartType.Line;

    /// <summary>Gets or sets the data to display in the chart.</summary>
    [Parameter] public IEnumerable<TItem>? Data { get; set; }

    /// <summary>Gets or sets the chart options.</summary>
    [Parameter] public SgChartOptions? Options { get; set; }

    /// <summary>Chart height (e.g., "400px"). Default "400px".</summary>
    [Parameter] public string Height { get; set; } = "400px";

    /// <summary>Chart width (e.g., "100%"). Default "100%".</summary>
    [Parameter] public string Width { get; set; } = "100%";

    /// <summary>Optional chart title rendered by Chart.js.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Child content containing axes / datasets.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional CSS class for the container.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Callback invoked when a data point is clicked.</summary>
    [Parameter] public EventCallback<SgChartClickEventArgs> OnDataPointClick { get; set; }

    /// <summary>Optional resolver for series labels when TItem exposes multiple values.</summary>
    [Parameter] public Func<TItem, IEnumerable<KeyValuePair<string, double>>>? SeriesSelector { get; set; }

    /// <summary>Optional explicit list of series labels paired with value selectors.</summary>
    [Parameter] public IReadOnlyList<SgChartSeries<TItem>>? Series { get; set; }

    /// <summary>
    /// Gets or sets the source URLs for Chart.js and its plugins.
    /// Override to use local copies or pin specific versions.
    /// If <c>null</c>, uses the default CDN URLs from <see cref="SgChartSources"/>.
    /// </summary>
    [Parameter] public SgChartSources? Sources { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnParametersSet()
    {
        if (!_chartReady) return;

        var changed =
            ChartType != _lastChartType ||
            !ReferenceEquals(Data, _lastDataRef) ||
            !ReferenceEquals(Options, _lastOptionsRef) ||
            !string.Equals(Title, _lastTitle, StringComparison.Ordinal);

        if (changed && !_refreshScheduled)
        {
            _refreshScheduled = true;
            _ = ScheduleRefreshAsync();
        }
    }

    private async Task ScheduleRefreshAsync()
    {
        try
        {
            await RefreshAsync();
        }
        finally
        {
            _refreshScheduled = false;
            if (_refreshPending)
            {
                _refreshPending = false;
                _refreshScheduled = true;
                _ = ScheduleRefreshAsync();
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isDisposed || !firstRender) return;

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/sg-chart.js");
            if (_isDisposed) return;
            _selfRef = DotNetObjectReference.Create(this);
            await InitializeChartAsync();
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (Exception)
        {
            _error = Localizer["Chart_FailedToLoad"];
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task InitializeChartAsync()
    {
        if (_module is null || _selfRef is null) return;

        try
        {
            var config = BuildChartConfig();
            await _module.InvokeVoidAsync("initChart", _selfRef, _canvasRef, config, Sources ?? new SgChartSources());
            CaptureSnapshot();
            _chartReady = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (Exception)
        {
            _error = Localizer["Chart_FailedToInitialize"];
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CaptureSnapshot()
    {
        _lastChartType = ChartType;
        _lastDataRef = Data;
        _lastOptionsRef = Options;
        _lastTitle = Title;
    }

    private object BuildChartConfig()
    {
        var data = Data?.ToList() ?? new List<TItem>();
        var options = Options ?? new SgChartOptions();
        var labels = ExtractLabels(data);
        var datasets = BuildDatasets(data, options);
        _isEmpty = datasets.Count == 0 || labels.Count == 0;

        var chartType = ChartType switch
        {
            SgChartType.Heatmap => "matrix",
            SgChartType.Area => "line",
            SgChartType.BarHorizontal => "bar",
            _ => ChartType.ToString().ToLowerInvariant()
        };

        var responsive = options.Responsive;
        var isCategorical = ChartType is SgChartType.Pie or SgChartType.Doughnut;

        return new
        {
            type = chartType,
            data = new { labels, datasets },
            options = new
            {
                responsive,
                maintainAspectRatio = false,
                indexAxis = ChartType == SgChartType.BarHorizontal ? "y" : "x",
                animation = new { duration = options.AnimationDuration, easing = "easeOutQuart" },
                interaction = new
                {
                    mode = isCategorical ? "nearest" : (options.SharedTooltip ? "index" : "nearest"),
                    intersect = isCategorical
                },
                onHover = new { mode = "nearest" },
                plugins = new
                {
                    legend = new
                    {
                        display = options.ShowLegend,
                        position = "top",
                        labels = new { usePointStyle = true, boxWidth = 8, padding = 14 }
                    },
                    title = new
                    {
                        display = !string.IsNullOrEmpty(Title),
                        text = Title ?? string.Empty,
                        padding = new { top = 6, bottom = 14 },
                        font = new { size = 14, weight = "600" }
                    },
                    tooltip = new
                    {
                        enabled = true,
                        usePointStyle = true,
                        padding = 10,
                        boxPadding = 4,
                        cornerRadius = 6,
                        displayColors = !isCategorical,
                        suffix = options.ValueSuffix,
                        decimals = options.ValueDecimals
                    }
                },
                scales = BuildScales(options),
                __sgClickable = OnDataPointClick.HasDelegate
            }
        };
    }

    private List<string> ExtractLabels(List<TItem> data)
    {
        if (data.Count == 0) return new List<string>();
        var labelProp = typeof(TItem).GetProperty("Label");
        if (labelProp != null)
        {
            return data.Select(item => labelProp.GetValue(item)?.ToString() ?? string.Empty).ToList();
        }
        return Enumerable.Range(0, data.Count).Select(i => i.ToString()).ToList();
    }

    private List<object> BuildDatasets(List<TItem> data, SgChartOptions options)
    {
        if (data.Count == 0) return new List<object>();

        var palette = options.Colors?.Count > 0 ? options.Colors : DefaultPalette;
        var seriesData = ResolveSeries(data);

        if (ChartType == SgChartType.Pie || ChartType == SgChartType.Doughnut)
        {
            var values = seriesData.Count > 0 ? seriesData[0].Values : new List<double>();
            var name = seriesData.Count > 0 ? seriesData[0].Name : "Data";
            return new List<object>
            {
                new
                {
                    label = name,
                    data = values,
                    backgroundColor = palette.Take(Math.Max(values.Count, 1)).ToList(),
                    borderColor = "#fff",
                    borderWidth = 2,
                    hoverOffset = 6
                }
            };
        }

        var datasets = new List<object>();
        for (var i = 0; i < seriesData.Count; i++)
        {
            var series = seriesData[i];
            var color = ResolveColor(series.Name, palette, i, options);
            datasets.Add(BuildDataset(series, color, options));
        }
        return datasets;
    }

    private object BuildDataset(SeriesData series, string color, SgChartOptions options)
    {
        if (ChartType == SgChartType.Scatter)
        {
            var scatter = series.Values.Select((v, i) => new { x = i, y = v }).ToList();
            return new
            {
                label = series.Name,
                data = scatter,
                borderColor = color,
                backgroundColor = WithAlpha(color, 0.7),
                borderWidth = 2,
                pointRadius = 4,
                pointHoverRadius = 6
            };
        }

        if (ChartType == SgChartType.Heatmap)
        {
            return new
            {
                label = series.Name,
                data = series.Values,
                borderColor = color,
                backgroundColor = WithAlpha(color, 0.5),
                borderWidth = 2
            };
        }

        if (ChartType == SgChartType.Area)
        {
            return new
            {
                label = series.Name,
                data = series.Values,
                borderColor = color,
                backgroundColor = WithAlpha(color, 0.22),
                borderWidth = 2,
                fill = true,
                tension = options.LineTension,
                pointRadius = options.ShowPoints ? 3 : 0,
                pointHoverRadius = 5,
                pointBackgroundColor = color
            };
        }

        if (ChartType == SgChartType.Line)
        {
            return new
            {
                label = series.Name,
                data = series.Values,
                borderColor = color,
                backgroundColor = WithAlpha(color, 0.15),
                borderWidth = 2,
                fill = false,
                tension = options.LineTension,
                pointRadius = options.ShowPoints ? 3 : 0,
                pointHoverRadius = 5,
                pointBackgroundColor = color
            };
        }

        // Bar / BarHorizontal
        return new
        {
            label = series.Name,
            data = series.Values,
            borderColor = color,
            backgroundColor = WithAlpha(color, 0.75),
            hoverBackgroundColor = color,
            borderWidth = 0,
            borderRadius = 4,
            borderSkipped = false,
            stack = options.Stacked ? "stack" : null
        };
    }

    private List<SeriesData> ResolveSeries(List<TItem> data)
    {
        // 1) Explicit series via parameter.
        if (Series is { Count: > 0 })
        {
            return Series
                .Select(s => new SeriesData(s.Name, data.Select(s.Value).ToList()))
                .ToList();
        }

        // 2) Selector function.
        if (SeriesSelector is not null)
        {
            var byName = new Dictionary<string, List<double>>(StringComparer.Ordinal);
            foreach (var item in data)
            {
                foreach (var kv in SeriesSelector(item))
                {
                    if (!byName.TryGetValue(kv.Key, out var list))
                    {
                        list = new List<double>(data.Count);
                        byName[kv.Key] = list;
                    }
                    list.Add(kv.Value);
                }
            }
            if (byName.Count > 0)
            {
                return byName.Select(kv => new SeriesData(kv.Key, kv.Value)).ToList();
            }
        }

        // 3) Default: single Value property.
        var valueProp = typeof(TItem).GetProperty("Value");
        if (valueProp == null) return new List<SeriesData>();

        var values = data.Select(item => ToDouble(valueProp.GetValue(item))).ToList();

        var opts = Options ?? new SgChartOptions();
        if (opts.EnableDecimation && DataDecimation.ShouldDecimate(values.Count, opts.DecimationThreshold))
        {
            values = DataDecimation.DecimateValues(values, opts.DecimationTargetPoints ?? 1000);
        }

        return new List<SeriesData> { new("Data", values) };
    }

    private static double ToDouble(object? value) => value switch
    {
        double d => d,
        float f => f,
        int i => i,
        long l => l,
        decimal m => (double)m,
        short s => s,
        _ => 0.0
    };

    private static string ResolveColor(string seriesName, List<string> palette, int index, SgChartOptions options)
    {
        // First series uses BorderColor unless user provided a palette.
        if (index == 0 && (options.Colors == null || options.Colors.Count == 0)
            && !string.IsNullOrWhiteSpace(options.BorderColor))
        {
            return options.BorderColor;
        }
        if (palette.Count == 0) return options.BorderColor;
        return palette[index % palette.Count];
    }

    private readonly record struct SeriesData(string Name, List<double> Values);

    private static readonly List<string> DefaultPalette = new()
    {
        "#2563eb", "#10b981", "#f59e0b", "#ef4444", "#8b5cf6",
        "#06b6d4", "#84cc16", "#ec4899", "#f97316", "#0ea5e9"
    };

    private static string WithAlpha(string color, double alpha)
    {
        if (string.IsNullOrWhiteSpace(color)) return $"rgba(33, 150, 243, {alpha.ToString(System.Globalization.CultureInfo.InvariantCulture)})";

        var trimmed = color.Trim();
        if (trimmed.StartsWith("rgba(", StringComparison.OrdinalIgnoreCase))
        {
            var inner = trimmed[5..^1];
            var parts = inner.Split(',');
            if (parts.Length >= 3)
            {
                return $"rgba({parts[0].Trim()},{parts[1].Trim()},{parts[2].Trim()},{alpha.ToString(System.Globalization.CultureInfo.InvariantCulture)})";
            }
        }
        if (trimmed.StartsWith("rgb(", StringComparison.OrdinalIgnoreCase))
        {
            var inner = trimmed[4..^1];
            return $"rgba({inner},{alpha.ToString(System.Globalization.CultureInfo.InvariantCulture)})";
        }
        if (trimmed.StartsWith("#") && (trimmed.Length == 7 || trimmed.Length == 4))
        {
            var hex = trimmed.Length == 4
                ? $"#{trimmed[1]}{trimmed[1]}{trimmed[2]}{trimmed[2]}{trimmed[3]}{trimmed[3]}"
                : trimmed;
            var r = Convert.ToInt32(hex.Substring(1, 2), 16);
            var g = Convert.ToInt32(hex.Substring(3, 2), 16);
            var b = Convert.ToInt32(hex.Substring(5, 2), 16);
            return $"rgba({r},{g},{b},{alpha.ToString(System.Globalization.CultureInfo.InvariantCulture)})";
        }
        return trimmed;
    }

    private object BuildScales(SgChartOptions options)
    {
        if (ChartType is SgChartType.Pie or SgChartType.Doughnut)
        {
            return new { };
        }

        var (yType, xType) = ChartType == SgChartType.BarHorizontal
            ? (_yAxis?.Type ?? "category", _xAxis?.Type ?? "linear")
            : (_yAxis?.Type ?? "linear", _xAxis?.Type ?? "category");

        var yScale = new
        {
            type = yType,
            display = _yAxis?.Display ?? true,
            beginAtZero = ChartType != SgChartType.BarHorizontal,
            stacked = options.Stacked && ChartType != SgChartType.BarHorizontal,
            min = options.MinValue ?? _yAxis?.Min,
            max = options.MaxValue ?? _yAxis?.Max,
            title = new
            {
                display = !string.IsNullOrEmpty(_yAxis?.Title),
                text = _yAxis?.Title ?? string.Empty,
                font = new { weight = "500" }
            },
            grid = new { display = options.ShowGrid && (_yAxis?.ShowGrid ?? true), color = _yAxis?.GridColor },
            border = new { display = false },
            ticks = new { display = options.ShowLabels, padding = 6 }
        };

        var xScale = new
        {
            type = xType,
            display = _xAxis?.Display ?? true,
            beginAtZero = ChartType == SgChartType.BarHorizontal,
            stacked = options.Stacked && ChartType == SgChartType.BarHorizontal,
            min = ChartType == SgChartType.BarHorizontal ? (options.MinValue ?? _xAxis?.Min) : _xAxis?.Min,
            max = ChartType == SgChartType.BarHorizontal ? (options.MaxValue ?? _xAxis?.Max) : _xAxis?.Max,
            title = new
            {
                display = !string.IsNullOrEmpty(_xAxis?.Title),
                text = _xAxis?.Title ?? string.Empty,
                font = new { weight = "500" }
            },
            grid = new { display = options.ShowGrid && (_xAxis?.ShowGrid ?? true), color = _xAxis?.GridColor },
            border = new { display = false },
            ticks = new { display = options.ShowLabels, padding = 6, autoSkip = true, maxRotation = 0 }
        };

        return new { y = yScale, x = xScale };
    }

    /// <summary>Refreshes the chart with current parameters.</summary>
    public async Task RefreshAsync()
    {
        if (_module is null || !_chartReady)
        {
            _refreshPending = true;
            return;
        }

        try
        {
            _error = null; // clear any previous error before attempting refresh
            var config = BuildChartConfig();
            await _module.InvokeVoidAsync("updateChart", _chartId, config);
            CaptureSnapshot();
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (Exception)
        {
            _error = Localizer["Chart_FailedToRefresh"];
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Updates the chart data.</summary>
    public Task UpdateDataAsync(IEnumerable<TItem> data)
    {
        Data = data;
        return RefreshAsync();
    }

    /// <summary>Zooms the Y-axis to the specified range.</summary>
    public async Task ZoomYAsync(double min, double max)
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("zoomY", _chartId, min, max); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (Exception)
        {
            _error = Localizer["Chart_FailedToZoom"];
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Resets the Y-axis zoom to original range.</summary>
    public async Task ResetZoomAsync()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("resetZoom", _chartId); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (Exception)
        {
            _error = Localizer["Chart_FailedToZoom"];
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Exports the chart as an image (png|jpg).</summary>
    public async Task ExportImageAsync(string format = "png")
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("exportImage", _chartId, format); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (Exception)
        {
            _error = Localizer["Chart_FailedToExport"];
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Returns the chart's data URL for the given format.</summary>
    public async Task<string?> GetImageDataUrlAsync(string format = "png")
    {
        if (_module is null) return null;
        try { return await _module.InvokeAsync<string?>("getImageDataUrl", _chartId, format); }
        catch (JSDisconnectedException) { return null; }
        catch (TaskCanceledException) { return null; }
        catch { return null; }
    }

    /// <summary>Triggers a manual resize. Useful when the container changes outside of a parameter update.</summary>
    public async Task ResizeAsync()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("resizeChart", _chartId); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch { }
    }

    /// <summary>Retries loading the chart after an error.</summary>
    public async Task RetryAsync()
    {
        _error = null;
        _chartReady = false;
        await InvokeAsync(StateHasChanged);
        await InitializeChartAsync();
    }

    [JSInvokable]
    public async Task OnDataPointClickedAsync(SgChartClickEventArgs args)
    {
        if (OnDataPointClick.HasDelegate)
            await OnDataPointClick.InvokeAsync(args);
    }

    internal void RegisterDataset(SgChartDataset dataset)
    {
        if (!_datasets.Contains(dataset)) _datasets.Add(dataset);
    }

    internal void RegisterXAxis(SgChartXAxis axis) => _xAxis = axis;
    internal void RegisterYAxis(SgChartYAxis axis) => _yAxis = axis;

    public async ValueTask DisposeAsync()
    {
        if (_isDisposed) return;
        _isDisposed = true;

        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _chartId); }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
            catch { }
        }

        var selfRef = _selfRef;
        _selfRef = null;
        selfRef?.Dispose();

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
            catch { }
            _module = null;
        }
    }
}
