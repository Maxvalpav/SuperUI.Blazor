@namespace SuperUI.Components
@inherits SgJsComponentBase
@inject ISuperUILocalizer Localizer

<div class="@Css("sg-gmap-container").Build()"
     style="@Styles().Add("height", Height).Add("width", Width).NullIfEmpty()"
     @attributes="AdditionalAttributes">

    @if (_error is not null)
    {
        <div class="sg-gmap-error" role="alert">
            <svg viewBox="0 0 20 20" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16zm-.75-9.25a.75.75 0 0 1 1.5 0v3.5a.75.75 0 0 1-1.5 0v-3.5zm.75 6a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5z"/>
            </svg>
            <span>@_error</span>
            <button type="button" class="sg-gmap-retry-btn" @onclick="RetryAsync">Повторить</button>
        </div>
    }
    else
    {
        <div @ref="_containerRef"
             id="@ResolvedId"
             class="sg-gmap-canvas"
             style="@(_ready ? null : "visibility:hidden;") width:100%;height:100%;"></div>

        @if (!_ready)
        {
            <div class="sg-gmap-loading" aria-live="polite">
                <div class="sg-gmap-spinner" aria-hidden="true"></div>
                <span>Загрузка карты…</span>
            </div>
        }
    }
</div>

@code {
    protected override string ModulePath => "./_content/SuperUI/sg-google-map.js";
    protected override string IdPrefix => "sg-gmap";

    private ElementReference _containerRef;
    private bool _ready;
    private string? _error;

    // ── Parameters ────────────────────────────────────────────────────────────

    /// <summary>Map configuration options (center, zoom, controls, etc.).</summary>
    [Parameter] public SgGoogleMapOptions?  Options    { get; set; }
    /// <summary>Sources configuration including Google Maps API key.</summary>
    [Parameter] public SgGoogleMapSources?  Sources    { get; set; }
    /// <summary>Collection of markers to display on the map.</summary>
    [Parameter] public IEnumerable<SgGoogleMapMarker>?  Markers   { get; set; }
    /// <summary>Collection of polylines to draw on the map.</summary>
    [Parameter] public IEnumerable<SgMapPolyline>?      Polylines { get; set; }
    /// <summary>Collection of polygons to draw on the map.</summary>
    [Parameter] public IEnumerable<SgMapPolygon>?       Polygons  { get; set; }
    /// <summary>Height of the map container.</summary>
    [Parameter] public string Height { get; set; } = "400px";
    /// <summary>Width of the map container.</summary>
    [Parameter] public string Width  { get; set; } = "100%";

    /// <summary>Callback invoked when a marker is clicked.</summary>
    [Parameter] public EventCallback<SgGoogleMapMarkerClickEventArgs> OnMarkerClick { get; set; }
    /// <summary>Callback invoked when the map background is clicked.</summary>
    [Parameter] public EventCallback<SgMapClickEventArgs>             OnMapClick    { get; set; }
    /// <summary>Callback invoked when the map view (center/zoom) changes.</summary>
    [Parameter] public EventCallback<SgMapViewChangedEventArgs>       OnViewChanged { get; set; }

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    private string? _lastMapTypeId;
    private string? _lastApiKey;

    protected override async Task OnParametersSetAsync()
    {
        if (!_ready) return;

        var src    = Sources ?? new SgGoogleMapSources();
        var typeId = (Options ?? new SgGoogleMapOptions()).MapTypeId.ToString().ToLowerInvariant();

        // API key changed → reinitialize map with new key
        if (src.ApiKey != _lastApiKey)
        {
            _lastApiKey   = src.ApiKey;
            _lastMapTypeId = typeId;
            _ready = false;
            await InvokeAsync(StateHasChanged);
            await InitAsync();
            return;
        }

        // Map type changed
        if (typeId != _lastMapTypeId)
        {
            _lastMapTypeId = typeId;
            try { await SafeInvokeVoidAsync("setMapType", ResolvedId, typeId); }
            catch { }
        }
    }

    protected override async ValueTask OnInteractiveAsync()
    {
        try
        {
            await InitAsync();
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch (Exception ex) { _error = $"Ошибка загрузки: {ex.Message}"; await InvokeAsync(StateHasChanged); }
    }

    private async Task InitAsync()
    {
        try
        {
            var src = Sources ?? new SgGoogleMapSources();
            var o   = Options  ?? new SgGoogleMapOptions();
            await SafeInvokeVoidAsync("initMap",
                SelfRef, _containerRef, ResolvedId,
                new {
                    apiKey       = src.ApiKey,
                    centerLat    = o.CenterLat,
                    centerLon    = o.CenterLon,
                    zoom         = o.Zoom,
                    mapTypeId    = o.MapTypeId.ToString().ToLowerInvariant(),
                    showControls = o.ShowControls,
                    showStreetView = o.ShowStreetView,
                    gestureHandling = o.GestureHandling,
                    styles       = o.Styles,
                },
                Markers?.ToList(),
                Polylines?.ToList(),
                Polygons?.ToList());
            _ready = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch (Exception ex) { _error = $"Ошибка инициализации: {ex.Message}"; await InvokeAsync(StateHasChanged); }
    }

    // ── Public API ────────────────────────────────────────────────────────────

    /// <summary>
    /// Sets the map center to the specified coordinates.
    /// </summary>
    public async Task SetCenterAsync(double lat, double lon, int? zoom = null)
    {
        try { await SafeInvokeVoidAsync("setCenter", ResolvedId, lat, lon, zoom); }
        catch { }
    }

    /// <summary>
    /// Adds a single marker to the map.
    /// </summary>
    public async Task AddMarkerAsync(SgGoogleMapMarker marker)
    {
        try { await SafeInvokeVoidAsync("addMarker", ResolvedId, marker); }
        catch { }
    }

    /// <summary>
    /// Removes all markers from the map.
    /// </summary>
    public async Task ClearMarkersAsync()
    {
        try { await SafeInvokeVoidAsync("clearMarkers", ResolvedId); }
        catch { }
    }

    /// <summary>
    /// Draws a polyline on the map.
    /// </summary>
    public async Task DrawPolylineAsync(string id, IEnumerable<SgMapCoord> coords,
        string color = "#2563eb", double width = 4, bool dashed = false)
    {
        try { await SafeInvokeVoidAsync("drawPolyline", ResolvedId, id, coords.ToList(), new { color, width, dashed }); }
        catch { }
    }

    /// <summary>
    /// Removes a polyline from the map by its identifier.
    /// </summary>
    public async Task ClearPolylineAsync(string id)
    {
        try { await SafeInvokeVoidAsync("clearPolyline", ResolvedId, id); }
        catch { }
    }

    /// <summary>
    /// Fits the map view to the specified bounding box.
    /// </summary>
    public async Task FitBoundsAsync(double south, double west, double north, double east)
    {
        try { await SafeInvokeVoidAsync("fitBounds", ResolvedId, south, west, north, east); }
        catch { }
    }

    /// <summary>
    /// Builds a real route using Google Directions API if apiKey is provided,
    /// otherwise draws a straight line. Returns route info (distance, duration, steps).
    /// </summary>
    public async Task<SgMapRouteResult> BuildRouteAsync(double fromLat, double fromLon, double toLat, double toLon, string? apiKey = null, bool alternatives = false)
    {
        try
        {
            var raw = await SafeInvokeAsync<System.Text.Json.JsonElement>(
                "buildRoute", ResolvedId, fromLat, fromLon, toLat, toLon, apiKey, alternatives);
            return ParseRouteResult(raw);
        }
        catch (Exception ex) { return new SgMapRouteResult { Ok = false, Error = ex.Message }; }
    }

    /// <summary>
    /// Selects a route variant by index (for alternatives generated by <see cref="BuildRouteAsync"/>).
    /// </summary>
    public async Task SelectRouteAsync(int index)
    {
        try { await SafeInvokeVoidAsync("selectRoute", ResolvedId, index); }
        catch { }
    }

    private static SgMapRouteResult ParseRouteResult(System.Text.Json.JsonElement j)
    {
        var r = new SgMapRouteResult();
        if (j.TryGetProperty("ok",            out var ok))  r.Ok            = ok.GetBoolean();
        if (j.TryGetProperty("straight",       out var st))  r.Straight      = st.GetBoolean();
        if (j.TryGetProperty("error",          out var err)) r.Error         = err.GetString();
        if (j.TryGetProperty("selectedIndex",  out var si))  r.SelectedIndex = si.GetInt32();

        if (j.TryGetProperty("routes", out var routesEl) && routesEl.ValueKind == System.Text.Json.JsonValueKind.Array)
        {
            foreach (var rv in routesEl.EnumerateArray())
            {
                var v = new SgMapRouteVariant();
                if (rv.TryGetProperty("distanceKm",   out var dk))  v.DistanceKm   = dk.GetDouble();
                if (rv.TryGetProperty("distanceText",  out var dt))  v.DistanceText = dt.GetString();
                if (rv.TryGetProperty("durationMin",   out var dm))  v.DurationMin  = dm.ValueKind == System.Text.Json.JsonValueKind.Null ? null : dm.GetDouble();
                if (rv.TryGetProperty("durationText",  out var dtt)) v.DurationText = dtt.GetString();
                if (rv.TryGetProperty("steps", out var steps) && steps.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    foreach (var s in steps.EnumerateArray())
                    {
                        var step = new SgMapRouteStep();
                        if (s.TryGetProperty("instruction", out var ins)) step.Instruction = ins.GetString() ?? "";
                        if (s.TryGetProperty("distance",    out var sd))  step.Distance    = sd.GetString() ?? "";
                        if (s.TryGetProperty("duration",    out var sdur)) step.Duration   = sdur.GetString() ?? "";
                        v.Steps.Add(step);
                    }
                }
                r.Routes.Add(v);
            }
        }
        return r;
    }

    /// <summary>
    /// Clears the error state and re-initializes the map.
    /// </summary>
    public async Task RetryAsync()
    {
        _error = null; _ready = false;
        await InvokeAsync(StateHasChanged);
        await InitAsync();
    }

    // ── JS callbacks ──────────────────────────────────────────────────────────

    [JSInvokable]
    public async Task OnMarkerClickedAsync(SgGoogleMapMarkerClickEventArgs args)
    {
        if (OnMarkerClick.HasDelegate) await OnMarkerClick.InvokeAsync(args);
    }

    [JSInvokable]
    public async Task OnMapClickedAsync(SgMapClickEventArgs args)
    {
        if (OnMapClick.HasDelegate) await OnMapClick.InvokeAsync(args);
    }

    [JSInvokable]
    public async Task OnViewChangedAsync(SgMapViewChangedEventArgs args)
    {
        if (OnViewChanged.HasDelegate) await OnViewChanged.InvokeAsync(args);
    }

    // ── Dispose ───────────────────────────────────────────────────────────────

    protected override async ValueTask OnDisposingAsync()
    {
        await SafeInvokeVoidAsync("disposeMap", ResolvedId);
    }
}
