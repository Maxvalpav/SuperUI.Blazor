@namespace SuperUI.Components
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ISuperUILocalizer Localizer

<div class="sg-ymap21-container @CssClass"
     style="height:@Height;width:@Width;position:relative;overflow:hidden;"
     @attributes="AdditionalAttributes">

    @if (_error is not null)
    {
        <div class="sg-ymap-error" role="alert">
            <svg viewBox="0 0 20 20" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16zm-.75-9.25a.75.75 0 0 1 1.5 0v3.5a.75.75 0 0 1-1.5 0v-3.5zm.75 6a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5z"/>
            </svg>
            <span>@_error</span>
            <button type="button" class="sg-ymap-retry-btn" @onclick="RetryAsync">Повторить</button>
        </div>
    }
    else
    {
        <div @ref="_containerRef"
             class="sg-ymap-canvas"
             style="@(_ready ? null : "visibility:hidden;") width:100%;height:100%;"></div>

        @if (!_ready)
        {
            <div class="sg-ymap-loading" aria-live="polite">
                <div class="sg-ymap-spinner" aria-hidden="true"></div>
                <span>Загрузка карты…</span>
            </div>
        }
    }
</div>

@code {
    private ElementReference _containerRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SgYandexMap21>? _selfRef;
    private readonly string _instanceId = $"sg-ymap21-{Guid.NewGuid():N}";
    private bool _ready;
    private string? _error;
    private bool _isDisposed;

    private string? _lastMapType;
    private bool    _lastTraffic;
    private string? _lastApiKey;

    // ── Parameters ────────────────────────────────────────────────────────────

    /// <summary>Map configuration options (center, zoom, controls, traffic, etc.).</summary>
    [Parameter] public SgYandexMapOptions?  Options   { get; set; }
    /// <summary>Sources configuration including Yandex Maps API key and language.</summary>
    [Parameter] public SgYandexMapSources?  Sources   { get; set; }
    /// <summary>Collection of markers to display on the map.</summary>
    [Parameter] public IEnumerable<SgYandexMapMarker>? Markers   { get; set; }
    /// <summary>Collection of polylines to draw on the map.</summary>
    [Parameter] public IEnumerable<SgMapPolyline>?     Polylines { get; set; }
    /// <summary>Collection of polygons to draw on the map.</summary>
    [Parameter] public IEnumerable<SgMapPolygon>?      Polygons  { get; set; }
    /// <summary>Height of the map container.</summary>
    [Parameter] public string Height { get; set; } = "400px";
    /// <summary>Width of the map container.</summary>
    [Parameter] public string Width  { get; set; } = "100%";
    /// <summary>Additional CSS classes applied to the map container.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Callback invoked when a marker is clicked.</summary>
    [Parameter] public EventCallback<SgYandexMapMarkerClickEventArgs> OnMarkerClick { get; set; }
    /// <summary>Callback invoked when the map background is clicked.</summary>
    [Parameter] public EventCallback<SgMapClickEventArgs>             OnMapClick    { get; set; }
    /// <summary>Callback invoked when the map view (center/zoom) changes.</summary>
    [Parameter] public EventCallback<SgMapViewChangedEventArgs>       OnViewChanged { get; set; }

    /// <summary>Captures unmatched HTML attributes.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnParametersSetAsync()
    {
        if (!_ready || _module is null) return;
        var src = Sources ?? new SgYandexMapSources();
        var o   = Options  ?? new SgYandexMapOptions();
        var mapType = o.MapType.ToString().ToLowerInvariant();

        if (src.ApiKey != _lastApiKey)
        {
            _lastApiKey = src.ApiKey; _lastMapType = mapType;
            _ready = false;
            await InvokeAsync(StateHasChanged);
            await InitAsync();
            return;
        }
        if (mapType != _lastMapType)
        {
            _lastMapType = mapType;
            try { await _module.InvokeVoidAsync("setMapType", _instanceId, mapType); } catch { }
        }
        if (o.ShowTraffic != _lastTraffic)
        {
            _lastTraffic = o.ShowTraffic;
            try { await _module.InvokeVoidAsync("setTraffic", _instanceId, o.ShowTraffic); } catch { }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isDisposed || !firstRender) return;
        try
        {
            _module  = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/sg-yandex-map21.js");
            if (_isDisposed) return;
            _selfRef = DotNetObjectReference.Create(this);
            await InitAsync();
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch (Exception ex) { _error = $"Ошибка загрузки: {ex.Message}"; await InvokeAsync(StateHasChanged); }
    }

    private async Task InitAsync()
    {
        if (_module is null || _selfRef is null) return;
        try
        {
            var src = Sources ?? new SgYandexMapSources();
            var o   = Options  ?? new SgYandexMapOptions();
            _lastApiKey  = src.ApiKey;
            _lastMapType = o.MapType.ToString().ToLowerInvariant();
            _lastTraffic = o.ShowTraffic;

            await _module.InvokeVoidAsync("initMap",
                _selfRef, _containerRef, _instanceId,
                new {
                    apiKey       = src.ApiKey,
                    lang         = src.Lang,
                    centerLat    = o.CenterLat,
                    centerLon    = o.CenterLon,
                    zoom         = o.Zoom,
                    mapType      = o.MapType.ToString().ToLowerInvariant(),
                    showControls = o.ShowControls,
                    showTraffic  = o.ShowTraffic,
                    showRuler    = o.ShowRuler,
                },
                Markers?.ToList(),
                Polylines?.ToList(),
                Polygons?.ToList());
            _ready = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch (Exception ex) { _error = $"Ошибка инициализации: {ex.Message}"; await InvokeAsync(StateHasChanged); }
    }

    // ── Public API ────────────────────────────────────────────────────────────

    /// <summary>
    /// Sets the map center to the specified coordinates.
    /// </summary>
    public async Task SetCenterAsync(double lat, double lon, int? zoom = null)
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("setCenter", _instanceId, lat, lon, zoom); } catch { }
    }

    /// <summary>
    /// Draws a polyline on the map.
    /// </summary>
    public async Task DrawPolylineAsync(string id, IEnumerable<SgMapCoord> coords,
        string color = "#2563eb", double width = 4, bool dashed = false)
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("drawPolyline", _instanceId, id, coords.ToList(), new { color, width, dashed }); } catch { }
    }

    /// <summary>
    /// Removes a polyline from the map by its identifier.
    /// </summary>
    public async Task ClearPolylineAsync(string id)
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("clearPolyline", _instanceId, id); } catch { }
    }

    /// <summary>
    /// Fits the map view to the specified bounding box.
    /// </summary>
    public async Task FitBoundsAsync(double south, double west, double north, double east)
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("fitBounds", _instanceId, south, west, north, east); } catch { }
    }

    /// <summary>Builds a real route using ymaps.route() — works with the same JS API key.</summary>
    public async Task<SgMapRouteResult> BuildRouteAsync(
        double fromLat, double fromLon, double toLat, double toLon,
        string? apiKey = null, bool alternatives = false)
    {
        if (_module is null) return new SgMapRouteResult { Ok = false, Error = "Map not ready" };
        try
        {
            var raw = await _module.InvokeAsync<System.Text.Json.JsonElement>(
                "buildRoute", _instanceId, fromLat, fromLon, toLat, toLon, apiKey, alternatives);
            return ParseRouteResult(raw);
        }
        catch (Exception ex) { return new SgMapRouteResult { Ok = false, Error = ex.Message }; }
    }

    /// <summary>
    /// Selects a route variant by index (for alternatives generated by <see cref="BuildRouteAsync"/>).
    /// </summary>
    public async Task SelectRouteAsync(int index)
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("selectRoute", _instanceId, index); } catch { }
    }

    /// <summary>
    /// Clears the current route drawn by <see cref="BuildRouteAsync"/>.
    /// </summary>
    public async Task ClearRouteAsync()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("clearRoute", _instanceId); } catch { }
    }

    /// <summary>
    /// Clears the error state and re-initializes the map.
    /// </summary>
    public async Task RetryAsync()
    {
        _error = null; _ready = false;
        await InvokeAsync(StateHasChanged);
        await InitAsync();
    }

    private static SgMapRouteResult ParseRouteResult(System.Text.Json.JsonElement j)
    {
        var r = new SgMapRouteResult();
        if (j.TryGetProperty("ok",           out var ok))  r.Ok           = ok.GetBoolean();
        if (j.TryGetProperty("straight",      out var st))  r.Straight     = st.GetBoolean();
        if (j.TryGetProperty("error",         out var err)) r.Error        = err.GetString();
        if (j.TryGetProperty("selectedIndex", out var si))  r.SelectedIndex = si.GetInt32();
        if (j.TryGetProperty("routes", out var routesEl) && routesEl.ValueKind == System.Text.Json.JsonValueKind.Array)
        {
            foreach (var rv in routesEl.EnumerateArray())
            {
                var v = new SgMapRouteVariant();
                if (rv.TryGetProperty("distanceKm",  out var dk))  v.DistanceKm   = dk.GetDouble();
                if (rv.TryGetProperty("distanceText", out var dt))  v.DistanceText = dt.GetString();
                if (rv.TryGetProperty("durationMin",  out var dm))  v.DurationMin  = dm.ValueKind == System.Text.Json.JsonValueKind.Null ? null : dm.GetDouble();
                if (rv.TryGetProperty("durationText", out var dtt)) v.DurationText = dtt.GetString();
                if (rv.TryGetProperty("steps", out var steps) && steps.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    foreach (var s in steps.EnumerateArray())
                    {
                        var step = new SgMapRouteStep();
                        if (s.TryGetProperty("instruction", out var ins)) step.Instruction = ins.GetString() ?? "";
                        if (s.TryGetProperty("distance",    out var sd))  step.Distance    = sd.GetString() ?? "";
                        v.Steps.Add(step);
                    }
                }
                r.Routes.Add(v);
            }
        }
        return r;
    }

    // ── JS callbacks ──────────────────────────────────────────────────────────

    [JSInvokable]
    public async Task OnMarkerClickedAsync(SgYandexMapMarkerClickEventArgs args)
    {
        if (OnMarkerClick.HasDelegate) await OnMarkerClick.InvokeAsync(args);
    }

    [JSInvokable]
    public async Task OnMapClickedAsync(SgMapClickEventArgs args)
    {
        if (OnMapClick.HasDelegate) await OnMapClick.InvokeAsync(args);
    }

    [JSInvokable]
    public async Task OnViewChangedAsync(SgMapViewChangedEventArgs args)
    {
        if (OnViewChanged.HasDelegate) await OnViewChanged.InvokeAsync(args);
    }

    // ── Dispose ───────────────────────────────────────────────────────────────

    public async ValueTask DisposeAsync()
    {
        if (_isDisposed) return;
        _isDisposed = true;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("disposeMap", _instanceId); } catch { }
            try { await _module.DisposeAsync(); } catch { }
            _module = null;
        }
        _selfRef?.Dispose();
    }
}
