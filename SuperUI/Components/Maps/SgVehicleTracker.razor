@using Microsoft.JSInterop
@inherits SgJsComponentBase
@namespace SuperUI.Components

<div id="@Id" class="sg-vehicle-tracker" style="height: @Height; width: @Width; @Style">
</div>

@code {
    /// <summary>Initial latitude of the map center.</summary>
    [Parameter] public double CenterLat { get; set; } = 55.7512;
    /// <summary>Initial longitude of the map center.</summary>
    [Parameter] public double CenterLon { get; set; } = 37.6184;
    /// <summary>Initial zoom level of the map.</summary>
    [Parameter] public int Zoom { get; set; } = 13;
    /// <summary>Height of the map container.</summary>
    [Parameter] public string Height { get; set; } = "500px";
    /// <summary>Width of the map container.</summary>
    [Parameter] public string Width { get; set; } = "100%";

    protected override string ModulePath => "./_content/SuperUI/sg-vehicle-tracker.js";
    protected override string IdPrefix => "sg-tracker";

    protected override async ValueTask OnInteractiveAsync()
    {
        await SafeInvokeVoidAsync("init", Id, CenterLat, CenterLon, Zoom);
    }

    /// <summary>
    /// Updates a vehicle's position on the map with animated movement.
    /// </summary>
    /// <param name="id">Unique vehicle identifier.</param>
    /// <param name="lat">Target latitude.</param>
    /// <param name="lon">Target longitude.</param>
    /// <param name="durationMs">Animation duration in milliseconds.</param>
    /// <param name="label">Optional label displayed near the vehicle.</param>
    /// <param name="iconUrl">Optional custom icon URL for the vehicle marker.</param>
    public async Task UpdateVehicleAsync(string id, double lat, double lon, int durationMs = 5000, string? label = null, string? iconUrl = null)
    {
        await SafeInvokeVoidAsync("updateVehicle", id, lat, lon, durationMs, label, iconUrl);
    }
}

<style>
    .sg-vehicle-tracker {
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--sg-border-light);
    }

    .sg-vehicle-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        pointer-events: none;
    }

    .sg-vehicle-label {
        background: var(--sg-bg-paper);
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
        box-shadow: var(--sg-shadow-sm);
        border: 1px solid var(--sg-border-light);
        margin-top: 2px;
        white-space: nowrap;
    }
</style>
