@using Microsoft.JSInterop
@inherits SgJsComponentBase
@namespace SuperUI.Components

<div id="@Id" class="sg-vehicle-tracker" style="height: @Height; width: @Width; @Style">
</div>

@code {
    [Parameter] public double CenterLat { get; set; } = 55.7512;
    [Parameter] public double CenterLon { get; set; } = 37.6184;
    [Parameter] public int Zoom { get; set; } = 13;
    [Parameter] public string Height { get; set; } = "500px";
    [Parameter] public string Width { get; set; } = "100%";
    [Parameter] public string? Style { get; set; }

    protected override string ModulePath => "./_content/SuperUI/sg-vehicle-tracker.js";
    protected override string IdPrefix => "sg-tracker";

    protected override async ValueTask OnInteractiveAsync()
    {
        await SafeInvokeVoidAsync("init", Id, CenterLat, CenterLon, Zoom);
    }

    public async Task UpdateVehicleAsync(string id, double lat, double lon, int durationMs = 5000, string? label = null, string? iconUrl = null)
    {
        await SafeInvokeVoidAsync("updateVehicle", id, lat, lon, durationMs, label, iconUrl);
    }
}

<style>
    .sg-vehicle-tracker {
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--sg-border-light);
    }

    .sg-vehicle-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        pointer-events: none;
    }

    .sg-vehicle-label {
        background: var(--sg-bg-paper);
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
        box-shadow: var(--sg-shadow-sm);
        border: 1px solid var(--sg-border-light);
        margin-top: 2px;
        white-space: nowrap;
    }
</style>
