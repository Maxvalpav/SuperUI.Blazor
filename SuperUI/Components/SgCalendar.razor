@namespace SuperUI.Components
@using System.Globalization
@using SuperUI.Localization

<div class="sg-calendar" style="height: @Height;">
    <div class="sg-calendar-header">
        <div class="sg-calendar-month">
            @GetHeaderTitle()
        </div>
        <div class="sg-calendar-actions">
            <div class="sg-calendar-view-switch">
                <button type="button" class="@GetViewButtonClass(SgCalendarView.Month)" @onclick="() => SetViewAsync(SgCalendarView.Month)">@Localizer["Calendar_Month"]</button>
                <button type="button" class="@GetViewButtonClass(SgCalendarView.Week)" @onclick="() => SetViewAsync(SgCalendarView.Week)">@Localizer["Calendar_Week"]</button>
                <button type="button" class="@GetViewButtonClass(SgCalendarView.Day)" @onclick="() => SetViewAsync(SgCalendarView.Day)">@Localizer["Calendar_Day"]</button>
            </div>
            <button type="button" class="sg-calendar-btn" aria-label="@Localizer["DataGrid_PagePrev"]" @onclick="PreviousRange">&lt;</button>
            <button type="button" class="sg-calendar-btn" @onclick="GoToTodayAsync">@Localizer["Calendar_GoToToday"]</button>
            <button type="button" class="sg-calendar-btn" aria-label="@Localizer["DataGrid_PageNext"]" @onclick="NextRange">&gt;</button>
        </div>
    </div>
    <div class="sg-calendar-body">
        @if (View == SgCalendarView.Day)
        {
            <div class="sg-calendar-day-panel">
                <div class="sg-calendar-day-header">
                    <div class="sg-calendar-day-title">@GetWeekdayHeader(Value)</div>
                    @if (OnAddEvent.HasDelegate || EnableCreation)
                    {
                        <button type="button" class="sg-calendar-btn" @onclick="() => HandleAddClick(Value)">+ Event</button>
                    }
                </div>
                
                @if (GetSelectedDayEvents().Any(e => e.IsAllDay))
                {
                    <div class="sg-calendar-allday-row">
                        <div class="sg-calendar-allday-label">@Localizer["Calendar_AllDay"]</div>
                        <div class="sg-calendar-allday-events">
                            @foreach (var ev in GetSelectedDayEvents().Where(e => e.IsAllDay))
                            {
                                <div class="sg-calendar-event sg-calendar-event-allday"
                                     style="@(string.IsNullOrEmpty(ev.Color) ? "" : $"background-color: {ev.Color}; border-left-color: {ev.Color};")"
                                     @onclick="() => HandleEventClick(ev)">
                                    <span class="sg-calendar-event-title">@ev.Title</span>
                                </div>
                            }
                        </div>
                    </div>
                }

<div class="sg-calendar-day-events">
                        @if (GetSelectedDayEvents().Any(e => !e.IsAllDay))
                        {
                            @foreach (var ev in GetSelectedDayEvents().Where(e => !e.IsAllDay))
                            {
                                <div class="sg-calendar-event sg-calendar-event-expanded"
                                     style="@(string.IsNullOrEmpty(ev.Color) ? "" : $"background-color: {ev.Color}; border-left-color: {ev.Color};")"
                                     @onclick="() => HandleEventClick(ev)">
                                    @if (!string.IsNullOrEmpty(ev.Icon))
                                    {
                                        <span class="sg-calendar-event-icon">@ev.Icon</span>
                                    }
                                    <div class="sg-calendar-event-stack">
                                        <span class="sg-calendar-event-title">@ev.Title</span>
                                        @if (!string.IsNullOrWhiteSpace(ev.Description))
                                        {
                                            <span class="sg-calendar-event-desc">@ev.Description</span>
                                        }
                                    </div>
                                    @if (OnDeleteEvent.HasDelegate || EnableEditing)
                                    {
                                        <button type="button" class="sg-calendar-event-delete" aria-label="@Localizer["Delete"]" @onclick:stopPropagation="true" @onclick="() => HandleDeleteEvent(ev)">×</button>
                                    }
                                </div>
                            }
                        }
                        else if (!GetSelectedDayEvents().Any(e => e.IsAllDay))
                        {
                            <div class="sg-calendar-empty">@Localizer["Calendar_NoEvents"]</div>
                        }
                    </div>
            </div>
        }
        else
        {
            <div class="sg-calendar-weekdays">
                @if (View == SgCalendarView.Week)
                {
                    @foreach (var date in GetWeekDays())
                    {
                        <div class="sg-calendar-weekday">@GetWeekdayHeader(date)</div>
                    }
                }
                else
                {
                    @foreach (var day in GetWeekdayNames())
                    {
                        <div class="sg-calendar-weekday">@day</div>
                    }
                }
            </div>
            <div class="sg-calendar-grid @(View == SgCalendarView.Week ? "sg-calendar-grid-week" : string.Empty)">
                @foreach (var date in View == SgCalendarView.Week ? GetWeekDays() : GetDays())
                {
                    <div class="@GetDayClass(date)" 
                         @onclick="() => SelectDate(date)"
                         ondragover="event.preventDefault();"
                         @ondrop="() => HandleDropOnDate(date)">
                        <div class="sg-calendar-date-header">
                            <span class="sg-calendar-date-value">@date.Day</span>
                            @if (OnAddEvent.HasDelegate || EnableCreation)
                            {
                                <button type="button" class="sg-calendar-add-event" aria-label="@Localizer["Calendar_NewEvent"]" @onclick:stopPropagation="true" @onclick="() => HandleAddClick(date)">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                </button>
                            }
                        </div>
                        <div class="sg-calendar-date-content">
                            @if (DateCellContent != null)
                            {
                                @DateCellContent(date)
                            }
                            else
                            {
                                <div class="sg-calendar-events">
                                    @foreach (var ev in GetEventsForDate(date))
                                    {
                                        <div class="sg-calendar-event"
                                             draggable="true"
                                             @ondragstart="() => _draggedEvent = ev"
                                             style="@(string.IsNullOrEmpty(ev.Color) ? "" : $"background-color: {ev.Color}; border-left-color: {ev.Color};")"
                                             @onclick:stopPropagation="true"
                                             @onclick="() => HandleEventClick(ev)">
                                            @if (!string.IsNullOrEmpty(ev.Icon))
                                            {
                                                <span class="sg-calendar-event-icon">@ev.Icon</span>
                                            }
                                            <span class="sg-calendar-event-title">@ev.Title</span>
                                            @if (OnDeleteEvent.HasDelegate || EnableEditing)
                                            {
                                                <button type="button" class="sg-calendar-event-delete" aria-label="@Localizer["Delete"]" @onclick:stopPropagation="true" @onclick="() => HandleDeleteEvent(ev)">×</button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<SgModal @bind-Visible="_isModalVisible" Title="@(_isNewEvent ? Localizer["Calendar_NewEvent"] : Localizer["Calendar_EditEvent"])" Width="400px">
    <ChildContent>
        <SgStack Orientation="vertical" Gap="16px">
            <SgTextBox Label="@Localizer["Calendar_Title"]" @bind-Value="_editingEvent.Title" Required="true" />
            <SgTextBox Label="@Localizer["Calendar_Description"]" @bind-Value="_editingEvent.Description" Multiline="true" Rows="3" />
            <div style="display: flex; gap: 8px; align-items: flex-end;">
                <SgDatePicker Label="@Localizer["Calendar_Date"]" @bind-Value="_editingEventDate" Required="true" />
                <SgCheckBox Label="@Localizer["Calendar_AllDay"]" @bind-Value="_editingEvent.IsAllDay" />
            </div>
            <SgColorPicker Label="@Localizer["Calendar_Color"]" @bind-Value="_editingEvent.Color" />
            <SgSelect TValue="string" Label="@Localizer["Calendar_Recurrence"]" 
                      Items="@_recurrenceOptions"
                      LabelSelector="@(v => Localizer[$"Recurrence_{v?.Replace("FREQ=", "") ?? "Never"}"] ?? _recurrenceLabels.GetValueOrDefault(v ?? string.Empty) ?? v)"
                      @bind-Value="_editingEvent.RecurrenceRule" 
                      Placeholder="@Localizer["Calendar_RecurrenceNone"]"
                      AllowClear="true" />
            <SgTextBox Label="@Localizer["Calendar_Icon"]" @bind-Value="_editingEvent.Icon" Placeholder="@Localizer["Calendar_IconPlaceholder"]" />
        </SgStack>
    </ChildContent>
    <FooterContent>
        <div style="display: flex; gap: 8px; justify-content: flex-end;">
            <SgButton Text="@Localizer["Cancel"]" OnClick="@(() => _isModalVisible = false)" />
            <SgButton Text="@Localizer["Save"]" Variant="primary" OnClick="SaveInternalEvent" />
        </div>
    </FooterContent>
</SgModal>
