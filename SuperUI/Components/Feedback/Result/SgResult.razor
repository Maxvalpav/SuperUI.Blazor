@namespace SuperUI.Components
@implements IDisposable

<div class="@ComputedClass"
     style="@Style"
     role="status"
     aria-live="polite"
     @attributes="AdditionalAttributes">

    @if (ShowLoading)
    {
        <div class="sgc-result-loading" aria-hidden="true">
            <div class="sgc-result-loading-spinner">
                <svg viewBox="0 0 24 24" fill="none" width="40" height="40" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" stroke="var(--sg-border)" stroke-width="3" />
                    <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round" style="transform-origin:12px 12px;animation:sgc-spin 0.8s linear infinite;" />
                </svg>
            </div>
            <div class="sgc-result-title">@(LoadingText ?? "Loading...")</div>
        </div>
    }
    else
    {
        @if (Illustration is not null)
        {
            <div class="sgc-result-illustration">@Illustration</div>
        }

        <div class="sgc-result-icon" aria-hidden="true">
            @if (IconContent is not null)
            {
                @IconContent
            }
            else if (IsStatusCode)
            {
                <span class="sgc-result-code">@ResolvedIcon</span>
            }
            else if (IsSvg)
            {
                @((MarkupString)ResolvedIcon)
            }
            else
            {
                @ResolvedIcon
            }
        </div>

        <div class="sgc-result-title" role="heading" aria-level="@TitleLevel">
            @Title
            @if (Step.HasValue && TotalSteps.HasValue)
            {
                <span class="sgc-result-step">Step @Step / @TotalSteps</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(SubTitle))
        {
            <div class="sgc-result-subtitle">@SubTitle</div>
        }

        @if (!string.IsNullOrEmpty(Description))
        {
            <div class="sgc-result-description">@Description</div>
        }

        @if (ExtraContent is not null)
        {
            <div class="sgc-result-extra">@ExtraContent</div>
        }
        else if (HasShortcutActions)
        {
            <div class="sgc-result-extra">
                @if (!string.IsNullOrEmpty(PrimaryActionText))
                {
                    <SgButton Text="@PrimaryActionText"
                              Variant="@PrimaryActionVariant"
                              OnClick="HandlePrimaryAsync" />
                }
                @if (!string.IsNullOrEmpty(SecondaryActionText))
                {
                    <SgButton Text="@SecondaryActionText"
                              Variant="@SecondaryActionVariant"
                              OnClick="HandleSecondaryAsync" />
                }
            </div>
        }

        @if (ChildContent is not null)
        {
            <div class="sgc-result-content">@ChildContent</div>
        }

        @if (FooterContent is not null)
        {
            <div class="sgc-result-footer">@FooterContent</div>
        }

        @if (AutoRedirectMs > 0 && !_autoRedirectAborted)
        {
            <div class="sgc-result-redirect" role="timer">
                <span>Redirecting in <strong>@_countdownSeconds</strong>s…</span>
                <button type="button" class="sgc-result-redirect-abort" @onclick="HandleAbortRedirect"
                        aria-label="Cancel redirect">
                    <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
                        <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
                    </svg>
                    @(AbortRedirectText ?? "Cancel")
                </button>
            </div>
        }
    }
</div>
