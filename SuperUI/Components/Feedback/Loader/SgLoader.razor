@namespace SuperUI.Components
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer

@if (Visible)
{
    <div class="sgc-loader @(Fullscreen ? "sgc-loader-fullscreen" : "") @CssClass" style="@Style">
        <div class="sgc-loader-grid"></div>
        <div class="sgc-loader-card">
            <div class="sgc-loader-logo-wrap">
                <div class="sgc-loader-ring sgc-loader-ring-1"></div>
                <div class="sgc-loader-ring sgc-loader-ring-2"></div>
                <div class="sgc-loader-ring sgc-loader-ring-3"></div>
                
                @if (LogoContent is not null)
                {
                    <div class="sgc-loader-logo-inner">
                        @LogoContent
                    </div>
                }
                else if (!string.IsNullOrEmpty(Icon))
                {
                    <div class="sgc-loader-logo-inner">
                        @((MarkupString)Icon)
                    </div>
                }
                else
                {
                    <div class="sgc-loader-logo-inner">
                        <span class="sgc-loader-logo-s">S</span><span class="sgc-loader-logo-ui">UI</span>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(Title))
            {
                <div class="sgc-loader-title">@Title</div>
            }
            
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <div class="sgc-loader-subtitle">@Subtitle</div>
            }

            <div class="sgc-loader-progress-wrap">
                <div class="sgc-loader-progress-track">
                    <div class="sgc-loader-progress-fill" style="width: @(Progress)%">
                        <div class="sgc-loader-progress-glow"></div>
                    </div>
                </div>
            </div>
            
            <div class="sgc-loader-status-row">
                <div class="sgc-loader-dots">
                    <span class="sgc-loader-dot"></span>
                    <span class="sgc-loader-dot"></span>
                    <span class="sgc-loader-dot"></span>
                </div>
                <span class="sgc-loader-status-text">@(string.IsNullOrEmpty(StatusText) ? Localizer["Common_Loading"] : StatusText)</span>
                @if (ShowPercentage)
                {
                    <span class="sgc-loader-percentage">@Progress%</span>
                }
            </div>
            
            @if (ChildContent is not null)
            {
                <div class="sgc-loader-custom-content">
                    @ChildContent
                </div>
            }
        </div>
        
        @if (Fullscreen)
        {
            <div class="sgc-loader-backdrop"></div>
        }
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; } = true;
    /// <summary>Gets or sets whether the loader covers the full viewport.</summary>
    [Parameter] public bool Fullscreen { get; set; } = false;
    /// <summary>Gets or sets the title text displayed in the loader.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>Gets or sets the subtitle text displayed below the title.</summary>
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>Gets or sets an SVG icon rendered in the center of the loader.</summary>
    [Parameter] public string? Icon { get; set; }
    /// <summary>Gets or sets the progress percentage (0-100).</summary>
    [Parameter] public int Progress { get; set; } = 0;
    /// <summary>Gets or sets the status text below the progress bar.</summary>
    [Parameter] public string? StatusText { get; set; }
    /// <summary>Gets or sets whether to show the percentage value next to the status text.</summary>
    [Parameter] public bool ShowPercentage { get; set; } = true;
    
    /// <summary>Gets or sets custom content replacing the default logo in the center.</summary>
    [Parameter] public RenderFragment? LogoContent { get; set; }
    /// <summary>Gets or sets additional custom content below the status row.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    
    /// <summary>Gets or sets additional CSS classes for the loader wrapper.</summary>
    [Parameter] public string? CssClass { get; set; }
    /// <summary>Gets or sets inline CSS styles for the loader wrapper.</summary>
    [Parameter] public string? Style { get; set; }
}
