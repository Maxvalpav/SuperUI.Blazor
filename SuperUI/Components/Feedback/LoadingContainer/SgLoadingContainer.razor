@namespace SuperUI.Components

@if (HasError && ErrorContent is not null)
{
    @ErrorContent
}
else if (HasError && !string.IsNullOrEmpty(ErrorMessage))
{
    <div class="sgc-loading-container sgc-loading-error @CssClass" style="@Style">
        <div class="sgc-loading-error-icon">⚠</div>
        <div class="sgc-loading-error-message">@ErrorMessage</div>
        @if (RetryContent is not null)
        {
            <div class="sgc-loading-retry">@RetryContent</div>
        }
    </div>
}
else if (IsLoading)
{
    <div class="sgc-loading-container @CssClass" style="@Style">
        <div class="sgc-loading-spinner">
            @if (SpinnerContent is not null)
            {
                @SpinnerContent
            }
            else
            {
                <SgSpinner Type="SpinnerType" Size="SpinnerSize" DisplayLabel="@LoadingMessage" />
            }
        </div>
    </div>
}
else if (IsEmpty)
{
    if (EmptyContent is not null)
    {
        @EmptyContent
    }
    else if (!string.IsNullOrEmpty(EmptyMessage))
    {
        <div class="sgc-loading-container sgc-loading-empty @CssClass" style="@Style">
            <div class="sgc-loading-empty-icon">📭</div>
            <div class="sgc-loading-empty-message">@EmptyMessage</div>
        </div>
    }
}
else
{
    @ChildContent
}

@code {
    /// <summary>Gets or sets whether the container is in a loading state.</summary>
    [Parameter] public bool IsLoading { get; set; }
    /// <summary>Gets or sets whether the container is in an empty state.</summary>
    [Parameter] public bool IsEmpty { get; set; }
    /// <summary>Gets or sets whether the container has encountered an error.</summary>
    [Parameter] public bool HasError { get; set; }
    /// <summary>Gets or sets the message displayed during loading.</summary>
    [Parameter] public string? LoadingMessage { get; set; }
    /// <summary>Gets or sets the message displayed when the container is empty.</summary>
    [Parameter] public string? EmptyMessage { get; set; }
    /// <summary>Gets or sets the message displayed when an error occurs.</summary>
    [Parameter] public string? ErrorMessage { get; set; }
    /// <summary>Gets or sets the spinner type used during loading.</summary>
    [Parameter] public SgSpinnerType SpinnerType { get; set; } = SgSpinnerType.Dots;
    /// <summary>Gets or sets the spinner size used during loading.</summary>
    [Parameter] public SgSize SpinnerSize { get; set; } = SgSize.Md;
    /// <summary>Gets or sets custom content replacing the default spinner during loading.</summary>
    [Parameter] public RenderFragment? SpinnerContent { get; set; }
    /// <summary>Gets or sets custom content replacing the default empty state.</summary>
    [Parameter] public RenderFragment? EmptyContent { get; set; }
    /// <summary>Gets or sets custom content replacing the default error state.</summary>
    [Parameter] public RenderFragment? ErrorContent { get; set; }
    /// <summary>Gets or sets custom content for the retry action in the error state.</summary>
    [Parameter] public RenderFragment? RetryContent { get; set; }
    /// <summary>Gets or sets the content rendered when none of the loading/empty/error states are active.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Gets or sets additional CSS classes for the container wrapper.</summary>
    [Parameter] public string? CssClass { get; set; }
    /// <summary>Gets or sets inline CSS styles for the container wrapper.</summary>
    [Parameter] public string? Style { get; set; }

}
