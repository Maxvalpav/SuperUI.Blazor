@namespace SuperUI.Components
@inherits SgInputBase<string>
@using System.Globalization
@using System.Text
@implements IDisposable

<div class="sgc-field @(Block ? "sgc-block" : "") @(LabelPosition == SgLabelPosition.Left ? "sgc-label-left" : LabelPosition == SgLabelPosition.Right ? "sgc-label-right" : "") @CssClass @StatusFieldClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sgc-label @(Required ? "sgc-required" : "")" for="@_id">@Label</label>
    }
    <div class="sgc-input-wrap sgc-size-@Size.ToString().ToLowerInvariant() @AnimClass @(IsInvalid ? "sgc-invalid-wrap" : "") @(Disabled ? "sgc-disabled" : "") @(PrefixContent != null ? "sgc-has-prefix" : "") @(SuffixContent != null ? "sgc-has-suffix" : "") @(ShowClearButton && !string.IsNullOrEmpty(Value) ? "sgc-has-clear" : "") @StatusWrapClass"
         @onmouseenter="OnWrapMouseEnter"
         @onmouseleave="OnWrapMouseLeave"
         @onwheel:preventDefault="DisableWheel">
        @if (!string.IsNullOrEmpty(LeadingIcon))
        {
            <span class="sgc-input-icon sgc-input-icon-leading">@((MarkupString)LeadingIcon)</span>
        }
        @if (PrefixContent != null)
        {
            <span class="sgc-input-affix sgc-input-affix-prefix">@PrefixContent</span>
        }
        <input id="@_id"
               type="text"
               inputmode="@InputMode"
               class="sgc-input @(IsInvalid ? "sgc-invalid" : "") @(_isNumeric ? "sgc-text-right" : "") @(IsComplete ? "sgc-mask-complete" : "")"
               placeholder="@EffectivePlaceholder"
               disabled="@Disabled"
               readonly="@ReadOnly"
               required="@Required"
               aria-required="@(Required ? "true" : null)"
               aria-invalid="@(IsInvalid ? "true" : null)"
               aria-describedby="@DescribedBy"
               value="@DisplayValue"
               maxlength="@MaxDisplayLength"
               @ref="_inputRef"
               @oninput="OnInputAsync"
               @onchange="OnChangeAsync"
               @onfocus="OnFocusAsync"
               @onblur="OnBlurAsync"
               @onkeydown="OnKeyDownAsync"
               @attributes="AdditionalAttributes" />
        @if (SuffixContent != null)
        {
            <span class="sgc-input-affix sgc-input-affix-suffix">@SuffixContent</span>
        }
        @if (!string.IsNullOrEmpty(TrailingIcon))
        {
            <span class="sgc-input-icon sgc-input-icon-trailing">@((MarkupString)TrailingIcon)</span>
        }
        @if (AllowCopy && !string.IsNullOrEmpty(Value) && !Disabled && !ReadOnly)
        {
            <button type="button" class="sgc-input-action @(_copied ? "sgc-copied" : "")"
                    aria-label="@Localizer["NumberInput_Copy"]" title="@Localizer["NumberInput_Copy"]"
                    @onclick="CopyValueAsync" tabindex="-1">
                @if (_copied)
                {
                    <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" fill="currentColor">
                        <path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"/>
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" fill="currentColor">
                        <path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"/>
                        <path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"/>
                    </svg>
                }
            </button>
        }
        @if (ShowClearButton && !string.IsNullOrEmpty(Value) && !Disabled && !ReadOnly)
        {
            <button type="button" class="sgc-input-clear" @onclick="ClearAsync" aria-label="@Localizer["Clear"]" tabindex="-1">
                <svg viewBox="0 0 16 16" width="10" height="10" fill="currentColor" aria-hidden="true">
                    <path d="M3.72 3.72a.75.75 0 011.06 0L8 6.94l3.22-3.22a.75.75 0 111.06 1.06L9.06 8l3.22 3.22a.75.75 0 11-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 01-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 010-1.06z"/>
                </svg>
            </button>
        }
    </div>
    @if (IsInvalid)
    {
        @if (ValidationPopover)
        {
            <div class="sgc-input-popover @(_popoverVisible ? "sgc-input-popover-visible" : "")" role="tooltip">@DisplayedError</div>
        }
        else
        {
            <span id="@_errorId" class="sgc-error">@DisplayedError</span>
        }
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@_hintId" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private readonly string _id = "sg-" + Guid.NewGuid().ToString("N")[..8];
    private string _hintId => _id + "-hint";
    private string _errorId => _id + "-err";
    private ElementReference _inputRef;

    private bool _focused;
    private bool _touched;
    private string? _lastCompleteRaw;
    private bool _copied;
    private string _animClass = "";
    private bool _popoverVisible;

    /// <summary>Label text displayed above the input.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Label position. Default is Top.</summary>
    [Parameter] public SgLabelPosition LabelPosition { get; set; } = SgLabelPosition.Top;

    /// <summary>Mask preset type. Default is <see cref="SgMaskType.Custom"/>.</summary>
    [Parameter] public SgMaskType MaskType { get; set; } = SgMaskType.Custom;

    /// <summary>Custom mask pattern used when <see cref="MaskType"/> is <see cref="SgMaskType.Custom"/>.
    /// Tokens: <c>9</c> digit, <c>a</c> letter, <c>A</c> uppercase letter, <c>n</c> alphanumeric, <c>*</c> any char.
    /// Other characters are treated as literals.</summary>
    [Parameter] public string? Mask { get; set; }

    /// <summary>Placeholder shown when input is empty. If null and <see cref="ShowMaskAsPlaceholder"/> is true, the mask itself is used.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Character used to fill un-typed slots when <see cref="ShowMaskWhileTyping"/> is enabled. Default is '_'.</summary>
    [Parameter] public char MaskPlaceholder { get; set; } = '_';

    /// <summary>When true, the unfilled portion of the mask is rendered as the placeholder while empty.</summary>
    [Parameter] public bool ShowMaskAsPlaceholder { get; set; } = true;

    /// <summary>When true, mask literals and <see cref="MaskPlaceholder"/> chars are kept visible while typing.</summary>
    [Parameter] public bool ShowMaskWhileTyping { get; set; }

    /// <summary>Hint text displayed below the input.</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>Error text to display. Takes precedence over validation messages.</summary>
    [Parameter] public string? ErrorText { get; set; }

    /// <summary>Whether the input is required.</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>Whether the input is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Whether the input is read-only.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Whether the input takes full width. Default is true.</summary>
    [Parameter] public bool Block { get; set; } = true;

    /// <summary>Additional CSS classes for the field container.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Whether to show a clear button. Default is true.</summary>
    [Parameter] public bool AllowClear { get; set; } = true;

    /// <summary>Whether to show a clear button. Alias for <see cref="AllowClear"/>.</summary>
    [Parameter] public bool ShowClearButton { get => AllowClear; set => AllowClear = value; }

    /// <summary>Show a copy button to copy the formatted value to clipboard. Default false.</summary>
    [Parameter] public bool AllowCopy { get; set; }

    /// <summary>Culture used for numeric / date formatting. Default is current culture.</summary>
    [Parameter] public CultureInfo? Culture { get; set; }

    /// <summary>Number of decimal places for currency / percent. Default is 2.</summary>
    [Parameter] public int DecimalPlaces { get; set; } = 2;

    /// <summary>Currency symbol for <see cref="SgMaskType.Currency"/>. Default is "₽".</summary>
    [Parameter] public string CurrencySymbol { get; set; } = "₽";

    /// <summary>When true, currency / percent values render with thousands separators. Default is true.</summary>
    [Parameter] public bool UseThousandsSeparator { get; set; } = true;

    /// <summary>Allow negative numbers in currency / percent. Default is false.</summary>
    [Parameter] public bool AllowNegative { get; set; }

    /// <summary>Optional minimum numeric value (currency / percent).</summary>
    [Parameter] public decimal? MinValue { get; set; }

    /// <summary>Optional maximum numeric value (currency / percent).</summary>
    [Parameter] public decimal? MaxValue { get; set; }

    /// <summary>Custom date pattern for <see cref="SgMaskType.Date"/>; falls back to culture short date.</summary>
    [Parameter] public string? DatePattern { get; set; }

    /// <summary>Callback invoked when Enter key is pressed.</summary>
    [Parameter] public EventCallback OnEnterPressed { get; set; }

    /// <summary>Callback invoked once the value first satisfies the mask (length-complete and valid).</summary>
    [Parameter] public EventCallback<string> OnComplete { get; set; }

    /// <summary>Optional content rendered inside the input on the leading edge.</summary>
    [Parameter] public RenderFragment? PrefixContent { get; set; }

    /// <summary>Optional content rendered inside the input on the trailing edge.</summary>
    [Parameter] public RenderFragment? SuffixContent { get; set; }

    /// <summary>SVG markup for an icon displayed before the input value (leading side).</summary>
    [Parameter] public string? LeadingIcon { get; set; }

    /// <summary>SVG markup for an icon displayed after the input value (trailing side).</summary>
    [Parameter] public string? TrailingIcon { get; set; }

    /// <summary>Semantic color status for the input border and accent. Default <c>null</c>.</summary>
    [Parameter] public SgColor? Status { get; set; }

    /// <summary>Size variant. Default is Md.</summary>
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;

    /// <summary>Select all text on focus. Default true.</summary>
    [Parameter] public bool SelectOnFocus { get; set; } = true;

    /// <summary>When true, value updates on every keystroke (input). When false, on change (blur). Default true.</summary>
    [Parameter] public bool Immediate { get; set; } = true;

    /// <summary>Disable value change on mouse wheel. Default false.</summary>
    [Parameter] public bool DisableWheel { get; set; }

    /// <summary>Briefly flash the input background on complete/incomplete events. Default false.</summary>
    [Parameter] public bool AnimateChanges { get; set; }

    /// <summary>Show validation error in a floating popover tooltip instead of static text. Default false.</summary>
    [Parameter] public bool ValidationPopover { get; set; }

    /// <summary>Additional HTML attributes for the input element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Inject] private ISuperUILocalizer Localizer { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    /// <summary>True once the raw value satisfies the mask (length matches significant slots, or numeric value is in range).</summary>
    public bool IsComplete => CheckComplete(Value);

    private bool IsInvalid =>
        !string.IsNullOrEmpty(ErrorText)
        || HasValidationErrors
        || (_touched && Required && string.IsNullOrEmpty(Value))
        || (_touched && !string.IsNullOrEmpty(Value) && !IsComplete && !_isNumeric);

    private string? DisplayedError =>
        !string.IsNullOrEmpty(ErrorText) ? ErrorText
        : ValidationMessages.FirstOrDefault()
            ?? (_touched && Required && string.IsNullOrEmpty(Value) ? Localizer["Required"] : null)
            ?? (_touched && !string.IsNullOrEmpty(Value) && !IsComplete && !_isNumeric ? Localizer["Incomplete"] : null);

    private string? DescribedBy => IsInvalid ? _errorId : (!string.IsNullOrEmpty(Hint) ? _hintId : null);

    private bool _isNumeric => MaskType is SgMaskType.Currency or SgMaskType.Percent;

    private string? StatusFieldClass => Status.HasValue ? "sgc-field-status-" + Status.Value.ToString().ToLowerInvariant() : null;
    private string? StatusWrapClass => Status.HasValue ? "sgc-input-status-" + Status.Value.ToString().ToLowerInvariant() : null;
    private string? AnimClass => string.IsNullOrEmpty(_animClass) ? null : _animClass;

    private string InputMode => MaskType switch
    {
        SgMaskType.Phone or SgMaskType.Inn or SgMaskType.Kpp or SgMaskType.Account or SgMaskType.Bic
            or SgMaskType.Snils or SgMaskType.Ogrn or SgMaskType.CreditCard or SgMaskType.CardExpiry
            or SgMaskType.Cvv or SgMaskType.Postal => "numeric",
        SgMaskType.Currency or SgMaskType.Percent => "decimal",
        SgMaskType.Iban => "text",
        _ => "text"
    };

    private string? EffectivePlaceholder
    {
        get
        {
            if (!string.IsNullOrEmpty(Placeholder)) return Placeholder;
            if (!ShowMaskAsPlaceholder) return null;
            var mask = GetMaskPattern();
            if (string.IsNullOrEmpty(mask)) return null;
            return MaskTemplate(mask, MaskPlaceholder);
        }
    }

    private string DisplayValue => GetDisplayValue();

    private void OnWrapMouseEnter() { _popoverVisible = true; }
    private void OnWrapMouseLeave() { _popoverVisible = false; }

    private string GetDisplayValue()
    {
        if (string.IsNullOrEmpty(Value))
            return ShowMaskWhileTyping && !_isNumeric ? MaskTemplate(GetMaskPattern(), MaskPlaceholder) : string.Empty;

        return MaskType switch
        {
            SgMaskType.Currency => _focused ? FormatNumericEditing(Value) : FormatCurrency(Value),
            SgMaskType.Percent  => _focused ? FormatNumericEditing(Value) : FormatPercent(Value),
            _                   => ShowMaskWhileTyping
                                    ? ApplyMaskWithPlaceholder(Value, GetMaskPattern(), MaskPlaceholder)
                                    : ApplyMask(Value, GetMaskPattern())
        };
    }

    private string GetMaskPattern() => MaskType switch
    {
        SgMaskType.Phone      => "+7 (999) 999-99-99",
        SgMaskType.Inn        => CountDigits(Value) > 10 ? "999999999999" : "9999999999",
        SgMaskType.Kpp        => "9999nn999",
        SgMaskType.Account    => "9999 9999 9999 9999 9999",
        SgMaskType.Bic        => "999999999",
        SgMaskType.Snils      => "999-999-999 99",
        SgMaskType.Ogrn       => CountDigits(Value) > 13 ? "999999999999999" : "9999999999999",
        SgMaskType.Iban       => "AAnn nnnn nnnn nnnn nnnn nnnn nnnn nn",
        SgMaskType.CreditCard => "9999 9999 9999 9999",
        SgMaskType.CardExpiry => "99/99",
        SgMaskType.Cvv        => "999",
        SgMaskType.Postal     => "999999",
        SgMaskType.Date       => DateMask(),
        SgMaskType.Time       => "99:99",
        _                     => Mask ?? ""
    };

    private string DateMask()
    {
        if (!string.IsNullOrEmpty(DatePattern)) return DigitMaskFromDatePattern(DatePattern);
        var c = Culture ?? CultureInfo.CurrentCulture;
        return DigitMaskFromDatePattern(c.DateTimeFormat.ShortDatePattern);
    }

    private static string DigitMaskFromDatePattern(string p)
    {
        var sb = new StringBuilder(p.Length);
        foreach (var c in p)
            sb.Append(char.IsLetter(c) ? '9' : c);
        return sb.ToString();
    }

    private int? MaxDisplayLength => MaskType switch
    {
        SgMaskType.Currency or SgMaskType.Percent => null,
        _ => GetMaskPattern().Length > 0 ? GetMaskPattern().Length : null
    };

    private async Task OnInputAsync(ChangeEventArgs e)
    {
        await ProcessInputAsync(e.Value?.ToString() ?? "");
    }

    private async Task OnChangeAsync(ChangeEventArgs e)
    {
        if (!Immediate)
            await ProcessInputAsync(e.Value?.ToString() ?? "");
    }

    private async Task OnFocusAsync()
    {
        _focused = true;
        if (SelectOnFocus)
        {
            await Task.Delay(1);
            try { await JS.InvokeVoidAsync("eval", $"setTimeout(() => document.getElementById('{_id}')?.select(), 0)"); }
            catch { }
        }
    }

    private async Task OnBlurAsync()
    {
        _focused = false;
        _touched = true;
        if (_isNumeric && !string.IsNullOrEmpty(Value))
            await ApplyNumericConstraintsAsync();
    }

    private async Task ProcessInputAsync(string rawInput)
    {
        try
        {
            string nextRaw = MaskType switch
            {
                SgMaskType.Currency => ParseNumericInput(rawInput, true),
                SgMaskType.Percent  => ParseNumericInput(rawInput, false),
                _                   => StripToSignificantChars(rawInput, GetMaskPattern())
            };

            if (!_isNumeric)
            {
                int maxLen = CountSignificantChars(GetMaskPattern());
                if (maxLen > 0 && nextRaw.Length > maxLen)
                    nextRaw = nextRaw[..maxLen];
            }

            await SetValueAsync(string.IsNullOrEmpty(nextRaw) ? null : nextRaw);

            if (CheckComplete(Value) && _lastCompleteRaw != Value)
            {
                _lastCompleteRaw = Value;
                if (AnimateChanges)
                {
                    _animClass = "sgc-input-flash-ok";
                    StateHasChanged();
                    _ = ClearAnimAsync();
                }
                if (OnComplete.HasDelegate)
                    await OnComplete.InvokeAsync(Value!);
            }
            else if (!CheckComplete(Value))
            {
                if (AnimateChanges && !string.IsNullOrEmpty(Value))
                {
                    _animClass = "sgc-input-flash-err";
                    StateHasChanged();
                    _ = ClearAnimAsync();
                }
                _lastCompleteRaw = null;
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[SgMaskedInput] {ex}");
        }
    }

    private async Task ClearAnimAsync()
    {
        await Task.Delay(400);
        _animClass = "";
        StateHasChanged();
    }

    private async Task ApplyNumericConstraintsAsync()
    {
        var culture = Culture ?? CultureInfo.CurrentCulture;
        if (!decimal.TryParse(Value, NumberStyles.Any, culture, out var d)) return;
        var clamped = d;
        if (MinValue.HasValue && clamped < MinValue.Value) clamped = MinValue.Value;
        if (MaxValue.HasValue && clamped > MaxValue.Value) clamped = MaxValue.Value;
        if (!AllowNegative && clamped < 0) clamped = 0;
        if (clamped != d)
            await SetValueAsync(clamped.ToString(culture));
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && OnEnterPressed.HasDelegate)
            await OnEnterPressed.InvokeAsync();
    }

    private Task ClearAsync() => SetValueAsync(null);

    private async Task CopyValueAsync()
    {
        var text = GetDisplayValue();
        if (string.IsNullOrEmpty(text)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _copied = true; StateHasChanged();
            await Task.Delay(2000);
            _copied = false; StateHasChanged();
        }
        catch { }
    }

    /// <summary>Returns the value formatted with the active mask, or null if empty.</summary>
    public string? GetFormattedValue() => string.IsNullOrEmpty(Value) ? null : GetDisplayValue();

    // ---------- Mask engine ----------

    private static bool TokenMatches(char token, char c) => token switch
    {
        '9' => char.IsDigit(c),
        'a' => char.IsLetter(c),
        'A' => char.IsLetter(c),
        'n' => char.IsLetterOrDigit(c),
        '*' => true,
        _   => false
    };

    private static bool IsToken(char c) => c is '9' or 'a' or 'A' or 'n' or '*';

    private static char TransformChar(char token, char c) => token switch
    {
        'A' => char.ToUpperInvariant(c),
        _   => c
    };

    private static string ApplyMask(string raw, string mask)
    {
        if (string.IsNullOrEmpty(mask)) return raw;
        var sb = new StringBuilder();
        int ri = 0;
        foreach (char m in mask)
        {
            if (ri >= raw.Length) break;
            if (IsToken(m))
            {
                if (TokenMatches(m, raw[ri])) { sb.Append(TransformChar(m, raw[ri])); ri++; }
                else { ri++; }
            }
            else
            {
                sb.Append(m);
            }
        }
        return sb.ToString();
    }

    private static string ApplyMaskWithPlaceholder(string raw, string mask, char ph)
    {
        if (string.IsNullOrEmpty(mask)) return raw;
        var sb = new StringBuilder();
        int ri = 0;
        foreach (char m in mask)
        {
            if (IsToken(m))
            {
                if (ri < raw.Length) { sb.Append(TransformChar(m, raw[ri])); ri++; }
                else sb.Append(ph);
            }
            else
            {
                sb.Append(m);
            }
        }
        return sb.ToString();
    }

    private static string MaskTemplate(string mask, char ph)
    {
        if (string.IsNullOrEmpty(mask)) return string.Empty;
        var sb = new StringBuilder(mask.Length);
        foreach (var m in mask)
            sb.Append(IsToken(m) ? ph : m);
        return sb.ToString();
    }

    private string StripToSignificantChars(string input, string mask)
    {
        if (string.IsNullOrEmpty(mask))
            return new string(input.Where(char.IsLetterOrDigit).ToArray());

        var sb = new StringBuilder();
        int mi = 0;
        foreach (char c in input)
        {
            if (c == MaskPlaceholder) continue;
            if (mi >= mask.Length) break;

            char m = mask[mi];
            if (IsToken(m))
            {
                if (TokenMatches(m, c))
                {
                    sb.Append(TransformChar(m, c));
                    mi++;
                }
            }
            else if (c == m)
            {
                mi++;
            }
            else if (char.IsLetterOrDigit(c))
            {
                while (mi < mask.Length && !IsToken(mask[mi])) mi++;
                if (mi < mask.Length && TokenMatches(mask[mi], c))
                {
                    sb.Append(TransformChar(mask[mi], c));
                    mi++;
                }
            }
        }
        return sb.ToString();
    }

    private static int CountSignificantChars(string mask)
    {
        int n = 0;
        foreach (char c in mask)
            if (IsToken(c)) n++;
        return n;
    }

    private static int CountDigits(string? s)
    {
        if (string.IsNullOrEmpty(s)) return 0;
        int n = 0;
        foreach (var c in s) if (char.IsDigit(c)) n++;
        return n;
    }

    private bool CheckComplete(string? raw)
    {
        if (string.IsNullOrEmpty(raw)) return false;
        if (_isNumeric)
        {
            var culture = Culture ?? CultureInfo.CurrentCulture;
            if (!decimal.TryParse(raw, NumberStyles.Any, culture, out var d)) return false;
            if (MinValue.HasValue && d < MinValue.Value) return false;
            if (MaxValue.HasValue && d > MaxValue.Value) return false;
            return true;
        }
        var mask = GetMaskPattern();
        if (string.IsNullOrEmpty(mask)) return raw.Length > 0;
        return raw.Length >= CountSignificantChars(mask);
    }

    // ---------- Numeric formatting ----------

    private string ParseNumericInput(string input, bool _)
    {
        var culture = Culture ?? CultureInfo.CurrentCulture;
        char decSep = culture.NumberFormat.NumberDecimalSeparator[0];
        var sb = new StringBuilder();
        bool hasDecimal = false;
        foreach (char c in input)
        {
            if (char.IsDigit(c))
            {
                sb.Append(c);
            }
            else if ((c == '.' || c == ',') && !hasDecimal)
            {
                sb.Append(decSep);
                hasDecimal = true;
            }
            else if (c == '-' && sb.Length == 0 && AllowNegative)
            {
                sb.Append(c);
            }
        }
        return sb.ToString();
    }

    private string FormatNumericEditing(string raw)
    {
        return raw;
    }

    private string FormatCurrency(string raw)
    {
        if (string.IsNullOrEmpty(raw)) return string.Empty;
        var culture = Culture ?? CultureInfo.CurrentCulture;
        if (decimal.TryParse(raw, NumberStyles.Any, culture, out var d))
        {
            var format = (NumberFormatInfo)culture.NumberFormat.Clone();
            format.CurrencySymbol = CurrencySymbol;
            if (!UseThousandsSeparator) format.CurrencyGroupSeparator = string.Empty;
            return d.ToString("C" + DecimalPlaces, format);
        }
        return raw;
    }

    private string FormatPercent(string raw)
    {
        if (string.IsNullOrEmpty(raw)) return string.Empty;
        var culture = Culture ?? CultureInfo.CurrentCulture;
        if (decimal.TryParse(raw, NumberStyles.Any, culture, out var d))
        {
            var format = (NumberFormatInfo)culture.NumberFormat.Clone();
            if (!UseThousandsSeparator) format.NumberGroupSeparator = string.Empty;
            return d.ToString($"N{DecimalPlaces}", format) + " %";
        }
        return raw;
    }
}
