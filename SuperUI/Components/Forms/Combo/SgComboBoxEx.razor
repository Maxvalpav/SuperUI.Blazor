@namespace SuperUI.Components
@typeparam TItem
@typeparam TKey
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer
@implements IDisposable

<div class="sgc-field @(Block ? "sgc-block" : "") @(LabelPosition == SgLabelPosition.Left ? "sgc-label-left" : LabelPosition == SgLabelPosition.Right ? "sgc-label-right" : "") @CssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sgc-label @(Required ? "sgc-required" : "")">@Label</label>
    }
    <div class="sgc-combo @(Block ? "sgc-block" : "") @(_open ? "sgc-open" : "") @(Disabled ? "sgc-disabled" : "") @(IsInvalid ? "sgc-invalid" : "")"
         role="combobox"
         aria-expanded="@(_open ? "true" : "false")"
         aria-haspopup="listbox"
         aria-required="@(Required ? "true" : null)"
         aria-disabled="@(Disabled ? "true" : null)"
         tabindex="@(Disabled ? "-1" : "0")"
         @onfocusout="HandleFocusOutAsync"
         @onkeydown="@((!Editable || !_open) ? EventCallback.Factory.Create<KeyboardEventArgs>(this, OnKeyDownAsync) : default)"
         @onclick:stopPropagation="true">
        <div class="sgc-combo-control" @onclick="ToggleAsync">
            @if (Editable && _open)
            {
                <input class="sgc-combo-input"
                       value="@_search"
                       placeholder="@EffectivePlaceholder"
                       @oninput="OnSearchInput"
                       @onkeydown="OnKeyDownAsync"
                       @onclick:stopPropagation="true" />
            }
            else
            {
                var sel = GetSelectedItem();
                if (sel is not null)
                {
                    @if (ColumnsSelector != null)
                    {
                        var cols = ColumnsSelector(sel).ToList();
                        <span class="sgc-combo-tag-cols">
                            @for (int i = 0; i < cols.Count; i++)
                            {
                                <span class="sgc-tag-col @(i == 0 ? "sgc-tag-col-main" : "sgc-tag-col-sub")">@cols[i]</span>
                            }
                        </span>
                    }
                    else
                    {
                        <span class="sgc-combo-value">@LabelFrom(sel)</span>
                    }
                }
                else
                {
                    <span class="sgc-combo-placeholder">@EffectivePlaceholder</span>
                }
            }
            @if (AllowClear && Value is not null && !Disabled)
            {
                <button class="sgc-combo-clear" type="button" title="@ClearLabel"
                        @onclick:stopPropagation="true" @onclick="ClearAsync">@((MarkupString)SgIcons.X)</button>
            }
            <span class="sgc-combo-caret">@((MarkupString)SgIcons.ChevronDown)</span>
        </div>
        @if (_open)
        {
            <div class="sgc-combo-menu">
                @if (ColumnsSelector != null)
                {
                    <div class="sgc-combo-header">
                        <div class="sgc-combo-opt-columns">
                            <span class="sgc-combo-opt-col sgc-combo-opt-check sgc-combo-header-col"></span>
                            @if (ColumnNames != null)
                            {
                                @foreach (var name in ColumnNames)
                                {
                                    <span class="sgc-combo-opt-col sgc-combo-header-col">@name</span>
                                }
                            }
                        </div>
                    </div>
                }
                @{ var filtered = GetFilteredItems().ToList(); }
                @if (filtered.Count == 0)
                {
                    <div class="sgc-combo-empty">@EffectiveEmptyText</div>
                }
                else
                {
                    @for (var i = 0; i < filtered.Count; i++)
                    {
                        var idx = i;
                        var it = filtered[idx];
                        var isSel = EqualityComparer<TKey>.Default.Equals(KeySelector(it), Value!);
                        <div class="sgc-combo-option sgc-combo-option-ex @(isSel ? "sgc-selected" : "") @(idx == _activeIndex ? "sgc-active" : "")"
                             @onclick:stopPropagation="true"
                             @onclick="() => PickAsync(it)">
                            <div class="sgc-combo-opt-columns">
                                <span class="sgc-combo-opt-col sgc-combo-opt-check">
                                    <span class="sgc-combo-check-icon" aria-hidden="true">@(isSel ? "✓" : "")</span>
                                </span>
                                @if (ColumnsSelector != null)
                                {
                                    var rowCols = ColumnsSelector(it);
                                    @foreach (var colValue in rowCols)
                                    {
                                        <span class="sgc-combo-opt-col">@colValue</span>
                                    }
                                }
                                else
                                {
                                    <span class="sgc-combo-opt-col sgc-combo-opt-main">
                                        <span class="sgc-combo-opt-label">@LabelFrom(it)</span>
                                        @{ var desc = DescriptionSelector?.Invoke(it); }
                                        @if (!string.IsNullOrEmpty(desc))
                                        {
                                            <span class="sgc-combo-opt-desc">@desc</span>
                                        }
                                    </span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </div>
    @if (IsInvalid)
    {
        <span id="@_errorId" class="sgc-error">@DisplayedError</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@_hintId" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private readonly string _hintId = "sg-cbex-hint-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _errorId = "sg-cbex-err-" + Guid.NewGuid().ToString("N")[..8];
    private bool _open;
    private string _search = string.Empty;
    private int _activeIndex = -1;
    private CancellationTokenSource? _blurCts;

    [Parameter] public TKey Value { get; set; } = default!;
    [Parameter] public EventCallback<TKey> ValueChanged { get; set; }
    [Parameter] public IEnumerable<TItem> Items { get; set; } = Array.Empty<TItem>();
    [Parameter, EditorRequired] public Func<TItem, TKey> KeySelector { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TItem, string> LabelSelector { get; set; } = default!;
    [Parameter] public Func<TItem, string>? DescriptionSelector { get; set; }
    [Parameter] public Func<TItem, IEnumerable<string>>? ColumnsSelector { get; set; }
    [Parameter] public IEnumerable<string>? ColumnNames { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? EmptyText { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public SgLabelPosition LabelPosition { get; set; } = SgLabelPosition.Top;
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public bool AllowClear { get; set; } = true;
    [Parameter] public bool Editable { get; set; } = true;
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Block { get; set; } = true;
    [Parameter] public string? CssClass { get; set; }

    private string EffectivePlaceholder => Placeholder ?? Localizer["Common_Select"];
    private string EffectiveEmptyText => string.IsNullOrEmpty(EmptyText) ? Localizer["Common_NoMatches"] : EmptyText;
    private string ClearLabel => Localizer["Common_Clear"];
    private string LabelFrom(TItem item) => LabelSelector(item);

    private bool IsInvalid => !string.IsNullOrEmpty(ErrorText);
    private string? DisplayedError => ErrorText;

    private TItem? GetSelectedItem()
    {
        if (Value is null) return default;
        foreach (var it in Items)
            if (EqualityComparer<TKey>.Default.Equals(KeySelector(it), Value)) return it;
        return default;
    }

    private IEnumerable<TItem> GetFilteredItems()
    {
        if (string.IsNullOrEmpty(_search)) return Items;
        return Items.Where(i =>
            LabelFrom(i).Contains(_search, StringComparison.CurrentCultureIgnoreCase) ||
            (DescriptionSelector?.Invoke(i) ?? "").Contains(_search, StringComparison.CurrentCultureIgnoreCase) ||
            (ColumnsSelector?.Invoke(i).Any(c => c.Contains(_search, StringComparison.CurrentCultureIgnoreCase)) ?? false));
    }

    private async Task ToggleAsync()
    {
        if (Disabled) return;
        _blurCts?.Cancel();
        _open = !_open;
        if (_open) { _search = string.Empty; _activeIndex = -1; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleFocusOutAsync(FocusEventArgs e)
    {
        _blurCts?.Cancel();
        _blurCts = new CancellationTokenSource();
        var token = _blurCts.Token;
        try
        {
            await Task.Delay(200, token);
            _open = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
    }

    private async Task CloseAsync()
    {
        _open = false; _search = string.Empty; _activeIndex = -1;
        await InvokeAsync(StateHasChanged);
    }

    private Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _activeIndex = 0;
        return InvokeAsync(StateHasChanged);
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        var filtered = GetFilteredItems().ToList();
        if (e.Key == "ArrowDown") { _activeIndex = Math.Min(filtered.Count - 1, _activeIndex + 1); await InvokeAsync(StateHasChanged); }
        else if (e.Key == "ArrowUp") { _activeIndex = Math.Max(0, _activeIndex - 1); await InvokeAsync(StateHasChanged); }
        else if (e.Key == "Enter" && _activeIndex >= 0 && _activeIndex < filtered.Count) await PickAsync(filtered[_activeIndex]);
        else if (e.Key == "Escape") await CloseAsync();
    }

    private async Task PickAsync(TItem item)
    {
        _blurCts?.Cancel();
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(KeySelector(item));
        await CloseAsync();
    }

    private async Task ClearAsync()
    {
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(default!);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _blurCts?.Cancel();
        _blurCts?.Dispose();
    }
}
