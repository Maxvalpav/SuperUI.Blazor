@namespace SuperUI.Components
@using SuperUI.Enums
@inherits SgInputBase<bool>
@inject IJSRuntime JS

<div class="sgc-check-field @(Block ? "sgc-block" : "") @(Tile ? "sgc-check-tile-wrapper" : "") @CssClass">
    <label class="sgc-check @(Disabled ? "sgc-disabled" : "") @(ReadOnly ? "sgc-readonly" : "") @(Indeterminate ? "sgc-indeterminate" : "") @(IsInvalid ? "sgc-check-invalid" : "") @(Animation ? "sgc-check-animated" : "") @(Ripple ? "sgc-check-ripple" : "") @SizeClass @(Tile ? "sgc-check-tile" : "")"
           style="@CheckStyle">
        <input type="checkbox"
               checked="@Value"
               disabled="@(Disabled || ReadOnly)"
               aria-checked="@AriaChecked"
               aria-invalid="@(IsInvalid ? "true" : null)"
               aria-describedby="@DescribedBy"
               @onchange="OnChangeAsync"
               @attributes="AdditionalAttributes"
               @ref="_inputRef" />
        @if (ChildContent is not null) { @ChildContent }
        else if (!string.IsNullOrEmpty(Label)) { <span class="sgc-check-label">@Label</span> }
    </label>
    @if (!string.IsNullOrEmpty(HelpText))
    {
        <span class="sgc-helptext">@HelpText</span>
    }
    @if (IsInvalid)
    {
        <span id="@_errorId" class="sgc-error">@(!string.IsNullOrEmpty(ErrorText) ? ErrorText : ValidationMessages.FirstOrDefault())</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@_hintId" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private readonly string _id = "sg-chk-" + Guid.NewGuid().ToString("N")[..8];
    private string _hintId => _id + "-hint";
    private string _errorId => _id + "-err";
    private ElementReference _inputRef;
    private IJSObjectReference? _module;
    private bool _lastIndeterminate;
    private bool _isDisposed;

    /// <summary>Label text shown next to the checkbox. Ignored when <see cref="ChildContent"/> is set.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Callback invoked when the checkbox value changes. Fires after the value has been updated.</summary>
    [Parameter] public EventCallback<bool> OnChange { get; set; }

    /// <summary>Hint text displayed below the checkbox.</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>Small help text displayed between the checkbox label and the error/hint text.</summary>
    [Parameter] public string? HelpText { get; set; }

    /// <summary>Override error text displayed below the checkbox. Takes precedence over EditContext validation messages.</summary>
    [Parameter] public string? ErrorText { get; set; }

    /// <summary>Whether the checkbox is in indeterminate (tri-state) state.</summary>
    [Parameter] public bool Indeterminate { get; set; }

    /// <summary>Callback raised when <see cref="Indeterminate"/> changes. Supports <c>@bind-Indeterminate</c>.</summary>
    [Parameter] public EventCallback<bool> IndeterminateChanged { get; set; }

    /// <summary>Custom content rendered next to the checkbox. Takes precedence over <see cref="Label"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Whether the checkbox is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Expand to full width of the container.</summary>
    [Parameter] public bool Block { get; set; }

    /// <summary>Size of the checkbox. Default is Md.</summary>
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;

    /// <summary>Custom CSS color value for the checkbox accent. Overrides the default theme color.</summary>
    [Parameter] public string? Color { get; set; }

    /// <summary>Semantic color for the checkbox accent. Maps to a known theme CSS variable.</summary>
    [Parameter] public SgColor? CheckColor { get; set; }

    /// <summary>When true the checkbox appearance is preserved but user toggling is prevented.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Enables a subtle scale animation on check and active states. Default is true.</summary>
    [Parameter] public bool Animation { get; set; } = true;

    /// <summary>When true renders a card/tile style checkbox with border and background.</summary>
    [Parameter] public bool Tile { get; set; }

    /// <summary>Enables a CSS ripple effect on click. Default is true.</summary>
    [Parameter] public bool Ripple { get; set; } = true;

    private bool IsInvalid => HasValidationErrors || !string.IsNullOrEmpty(ErrorText);
    private string AriaChecked => Indeterminate ? "mixed" : Value.ToString().ToLowerInvariant();
    private string? DescribedBy => IsInvalid ? _errorId : (!string.IsNullOrEmpty(Hint) ? _hintId : null);

    private string? SizeClass => Size switch
    {
        SgSize.Sm => "sgc-check-sm",
        SgSize.Lg => "sgc-check-lg",
        _ => null
    };

    private string? CheckStyle
    {
        get
        {
            if (!string.IsNullOrEmpty(Color))
                return $"--sgc-check-color:{Color}";
            if (CheckColor.HasValue)
                return $"--sgc-check-color:var(--sg-color-{CheckColor.Value.ToString().ToLowerInvariant()})";
            return null;
        }
    }

    /// <summary>Programmatically focuses the checkbox input.</summary>
    public ValueTask FocusAsync() => _inputRef.FocusAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isDisposed) return;
        if (firstRender || _lastIndeterminate != Indeterminate)
        {
            _lastIndeterminate = Indeterminate;
            await SetIndeterminateAsync();
        }
    }

    private async Task SetIndeterminateAsync()
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/superui.js");
            if (_isDisposed) return;
            await _module.InvokeVoidAsync("setIndeterminate", _inputRef, Indeterminate);
        }
        catch (JSException) { }
        catch (TaskCanceledException) { }
    }

    private async Task OnChangeAsync(ChangeEventArgs e)
    {
        if (ReadOnly) return;
        bool newVal;
        if (Indeterminate)
        {
            await SetIndeterminateAsync();
            if (IndeterminateChanged.HasDelegate)
                await IndeterminateChanged.InvokeAsync(false);
            newVal = true;
        }
        else
        {
            newVal = e.Value is true;
        }
        await SetValueAsync(newVal);
        if (OnChange.HasDelegate) await OnChange.InvokeAsync(newVal);
    }

    public override void Dispose()
    {
        _isDisposed = true;
        base.Dispose();
    }
}
