@namespace SuperUI.Components
@typeparam TValue
@inherits SgInputBase<TValue>

<div class="sgc-field @(Block ? "sgc-block" : "") @CssClass @SizeClass"
     style="@(Color is not null ? $"--sgc-slider-color:{Color}" : null)">
    @if (!string.IsNullOrEmpty(Label))
    {
        <div class="sgc-slider-header">
            <label id="@_labelId" class="sgc-label @(Required ? "sgc-required" : "")">@Label</label>
            @if (ShowValue)
            {
                var displayValue = FormatValue is not null ? FormatValue(ValueAsDouble) : $"{ValueAsDouble}{Suffix}";
                <span class="sgc-slider-value-badge">@displayValue</span>
            }
        </div>
    }
    <div class="sgc-slider-track-wrap @(ShowTooltip ? "sgc-slider-has-tooltip" : "") @(AlwaysShowTooltip && ShowTooltip ? "sgc-slider-tooltip-always" : "") @(Vertical ? "sgc-slider-vertical" : "")">
        <input id="@_sliderId"
               type="range"
               class="sgc-slider @(IsInvalid ? "sgc-invalid" : "") @(Marks is { Count: > 0 } ? "sgc-slider-has-marks" : "")"
               role="slider"
               min="@Min"
               max="@Max"
               step="@Step"
               value="@ValueAsDouble"
               disabled="@Disabled"
               style="--sgc-slider-pct: @FillPercent%"
               aria-labelledby="@_labelId"
               aria-valuemin="@Min"
               aria-valuemax="@Max"
               aria-valuenow="@ValueAsDouble"
               aria-orientation="@(Vertical ? "vertical" : "horizontal")"
               aria-required="@(Required ? "true" : null)"
               aria-invalid="@(IsInvalid ? "true" : null)"
               aria-describedby="@DescribedBy"
               @oninput="OnInputAsync"
               @onkeydown="OnKeyDownAsync"
               @attributes="AdditionalAttributes" />
        @if (ShowTooltip)
        {
            var tooltipValue = TooltipFormat is not null ? TooltipFormat(ValueAsDouble) : (FormatValue is not null ? FormatValue(ValueAsDouble) : $"{ValueAsDouble}{Suffix}");
            <span class="sgc-slider-tooltip" style="@TooltipPositionStyle">@tooltipValue</span>
        }
        @if (ShowValue && string.IsNullOrEmpty(Label) && !ShowTooltip)
        {
            var displayValue = FormatValue is not null ? FormatValue(ValueAsDouble) : $"{Prefix}{ValueAsDouble}{Suffix}";
            <span class="sgc-slider-value">@displayValue</span>
        }
        @if (ShowInput)
        {
            <input type="number"
                   class="sgc-slider-input"
                   value="@ValueAsDouble"
                   min="@Min"
                   max="@Max"
                   step="@Step"
                   disabled="@Disabled"
                   @onchange="OnInputNumberAsync"
                   @onfocus="() => _suppressUpdate = true"
                   @onblur="() => _suppressUpdate = false"
                   aria-label="@(Label ?? "Slider value")" />
        }
        @if (Marks is { Count: > 0 })
        {
            <div class="sgc-slider-marks">
                @foreach (var mark in Marks)
                {
                    var pct = Max > Min ? (mark - Min) / (Max - Min) * 100.0 : 0;
                    var labelText = MarksLabels is not null && MarksLabels.TryGetValue(mark, out var lbl) ? lbl : (ShowMarksLabels ? mark.ToString(CultureInfo.InvariantCulture) : null);
                    <span class="sgc-slider-mark @(MarksClickable ? "sgc-slider-mark-clickable" : "")"
                          style="@(Vertical ? $"bottom: {pct.ToString("F1", CultureInfo)}%" : $"left: {pct.ToString("F1", CultureInfo)}%")"
                          title="@mark.ToString(CultureInfo.InvariantCulture)"
                          @onclick="async () => await OnMarkClickAsync(mark)"
                          @onkeydown="(e) => OnMarkKeyDownAsync(e, mark)"
                          tabindex="@(MarksClickable ? "0" : null)"
                          role="@(MarksClickable ? "button" : null)"
                          aria-label="@(MarksClickable ? $"Set value to {mark}" : null)">
                        @if (labelText is not null)
                        {
                            <span class="sgc-slider-mark-label">@labelText</span>
                        }
                    </span>
                }
            </div>
        }
    </div>
    @if (IsInvalid)
    {
        <span id="@_errorId" class="sgc-error">@(string.IsNullOrEmpty(ErrorText) ? ValidationMessages.FirstOrDefault() : ErrorText)</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@_hintId" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private readonly string _labelId = "sg-slider-label-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _sliderId = "sg-slider-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _hintId = "sg-slider-hint-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _errorId = "sg-slider-err-" + Guid.NewGuid().ToString("N")[..8];

    private static readonly System.Globalization.CultureInfo CultureInfo = System.Globalization.CultureInfo.InvariantCulture;

    private CancellationTokenSource? _debounceCts;
    private bool _suppressUpdate;

    /// <summary>Gets or sets the minimum value of the slider. Default is 0.</summary>
    [Parameter] public double Min { get; set; }

    /// <summary>Gets or sets the maximum value of the slider. Default is 100.</summary>
    [Parameter] public double Max { get; set; } = 100;

    /// <summary>Gets or sets the step increment. Default is 1.</summary>
    [Parameter] public double Step { get; set; } = 1;

    /// <summary>Gets or sets the label text displayed above the slider.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Text displayed before the value (e.g., "$").</summary>
    [Parameter] public string? Prefix { get; set; }

    /// <summary>Text displayed after the value (e.g., "%", "px").</summary>
    [Parameter] public string? Suffix { get; set; }

    /// <summary>Gets or sets the hint text displayed below the slider.</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>Override error text. Takes precedence over EditContext validation messages.</summary>
    [Parameter] public string? ErrorText { get; set; }

    /// <summary>Gets or sets whether to display the current value. Default is true.</summary>
    [Parameter] public bool ShowValue { get; set; } = true;

    /// <summary>Whether to show a floating tooltip above the slider thumb displaying the current value.</summary>
    [Parameter] public bool ShowTooltip { get; set; }

    /// <summary>When true, the tooltip is always visible instead of appearing only on hover.</summary>
    [Parameter] public bool AlwaysShowTooltip { get; set; }

    /// <summary>When true renders a number input field next to the slider for precise value entry.</summary>
    [Parameter] public bool ShowInput { get; set; }

    /// <summary>List of tick-mark values to render along the slider track. Each value must be within [Min, Max].</summary>
    [Parameter] public List<double>? Marks { get; set; }

    /// <summary>When true, clicking a mark tick sets the slider value to that mark.</summary>
    [Parameter] public bool MarksClickable { get; set; }

    /// <summary>When true, renders text labels under each mark tick using the numeric value.</summary>
    [Parameter] public bool ShowMarksLabels { get; set; }

    /// <summary>Custom labels for marks keyed by mark value. Overrides ShowMarksLabels for specific marks.</summary>
    [Parameter] public Dictionary<double, string>? MarksLabels { get; set; }

    /// <summary>Custom CSS color for the slider track fill and thumb. Accepts any CSS color value.</summary>
    [Parameter] public string? Color { get; set; }

    /// <summary>Size of the slider. Default is Md.</summary>
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;

    /// <summary>When true renders the slider vertically instead of horizontally.</summary>
    [Parameter] public bool Vertical { get; set; }

    /// <summary>Optional function to format the displayed value. Receives the raw double and returns a string.
    /// When set, Prefix, Suffix and automatic formatting are ignored in favor of this function.</summary>
    [Parameter] public Func<double, string>? FormatValue { get; set; }

    /// <summary>Optional function to format the tooltip value separately from the main value display.
    /// Falls back to FormatValue when null, then to automatic formatting.</summary>
    [Parameter] public Func<double, string>? TooltipFormat { get; set; }

    /// <summary>Debounce delay in milliseconds for updating the value during slider drag.
    /// Helps reduce render pressure on slow operations. Default is 0 (no debounce).</summary>
    [Parameter] public int DebounceMs { get; set; }

    /// <summary>Mark the slider as required.</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>Gets or sets whether the slider is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Gets or sets whether the slider should take full width of its container. Default is true.</summary>
    [Parameter] public bool Block { get; set; } = true;

    private string? SizeClass => Size switch
    {
        SgSize.Sm => "sgc-slider-sm",
        SgSize.Lg => "sgc-slider-lg",
        _ => null
    };

    private bool IsInvalid => !string.IsNullOrEmpty(ErrorText) || HasValidationErrors;
    private string? DescribedBy => IsInvalid ? _errorId : (!string.IsNullOrEmpty(Hint) ? _hintId : null);
    private double ValueAsDouble => Value is not null ? Convert.ToDouble(Value, CultureInfo) : Min;

    private string FillPercent
    {
        get
        {
            var range = Max - Min;
            if (range <= 0) return "0";
            var pct = (ValueAsDouble - Min) / range * 100;
            return Math.Clamp(pct, 0, 100).ToString("F1", CultureInfo);
        }
    }

    private string TooltipPositionStyle
    {
        get
        {
            var pct = FillPercent;
            return Vertical ? $"bottom: {pct}%" : $"left: {pct}%";
        }
    }

    private async Task OnInputAsync(ChangeEventArgs e)
    {
        if (_suppressUpdate) return;
        if (!double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, CultureInfo, out var v)) return;

        if (DebounceMs > 0)
        {
            _debounceCts?.Cancel();
            _debounceCts = new CancellationTokenSource();
            var token = _debounceCts.Token;
            try
            {
                await Task.Delay(DebounceMs, token);
                if (!token.IsCancellationRequested)
                    await SetValueAsync(ConvertValue<TValue>(v));
            }
            catch (TaskCanceledException) { }
        }
        else
        {
            await SetValueAsync(ConvertValue<TValue>(v));
        }
    }

    private async Task OnInputNumberAsync(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, CultureInfo, out var v))
        {
            v = Math.Clamp(v, Min, Max);
            if (Step > 0)
                v = Math.Round(v / Step) * Step;
            await SetValueAsync(ConvertValue<TValue>(v));
        }
    }

    private async Task OnMarkClickAsync(double mark)
    {
        if (Disabled || !MarksClickable) return;
        await SetValueAsync(ConvertValue<TValue>(mark));
    }

    private async Task OnMarkKeyDownAsync(KeyboardEventArgs e, double mark)
    {
        if (Disabled || !MarksClickable) return;
        if (e.Key == "Enter" || e.Key == " ")
        {
            await SetValueAsync(ConvertValue<TValue>(mark));
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (Disabled) return;
        double newValue = ValueAsDouble;

        switch (e.Key)
        {
            case "Home":     newValue = Min; break;
            case "End":      newValue = Max; break;
            case "ArrowRight":
            case "ArrowUp":  newValue = Math.Min(ValueAsDouble + Step, Max); break;
            case "ArrowLeft":
            case "ArrowDown": newValue = Math.Max(ValueAsDouble - Step, Min); break;
            default: return;
        }

        await SetValueAsync(ConvertValue<TValue>(newValue));
    }

    private static T ConvertValue<T>(double value)
    {
        var targetType = Nullable.GetUnderlyingType(typeof(T)) ?? typeof(T);
        return (T)Convert.ChangeType(value, targetType, CultureInfo);
    }

    public override ValueTask DisposeAsync()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        return base.DisposeAsync();
    }
}
