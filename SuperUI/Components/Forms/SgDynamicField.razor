@* SuperUI/Components/Forms/SgDynamicField.razor *@
@* ИСПРАВЛЕНО: добавлен @typeparam TProp, исправлен For через object-совместимый подход *@
@typeparam TModel
@typeparam TProp

@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms

@if (FieldType == typeof(string) || FieldType == typeof(string?))
{
    <SgTextBox Label="@Label"
               Value="@(GetStringValue())"
               ValueChanged="@(async v => await SetValueAsync(v))"
               Placeholder="@Placeholder" />
}
else if (FieldType == typeof(int) || FieldType == typeof(int?))
{
    <SgNumberEdit Label="@Label"
                  Value="@(GetValue<int?>())"
                  ValueChanged="@(async v => await SetValueAsync(v))"
                  Placeholder="@Placeholder" />
}
else if (FieldType == typeof(bool) || FieldType == typeof(bool?))
{
    <SgCheckBox Label="@Label"
                Value="@(GetValue<bool>())"
                ValueChanged="@(async v => await SetValueAsync(v))" />
}
else
{
    <SgTextBox Label="@Label"
               Value="@(GetStringValue())"
               ValueChanged="@(async v => await SetValueAsync(v))"
               Placeholder="@Placeholder" />
}

@code {
    [Parameter, EditorRequired] public TModel? Model { get; set; }
    [Parameter, EditorRequired] public Expression<Func<TModel, TProp>>? For { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }

    private Type FieldType => typeof(TProp);

    private TProp? GetCurrentValue()
    {
        if (Model is null || For is null) return default;
        var compiled = For.Compile();
        return compiled(Model);
    }

    private T? GetValue<T>()
    {
        var v = GetCurrentValue();
        if (v is T typed) return typed;
        return default;
    }

    private string? GetStringValue() => GetCurrentValue()?.ToString();

    private async Task SetValueAsync<TVal>(TVal? newValue)
    {
        // Обновление через Reflection (без Expression Trees для setter)
        if (Model is null || For is null) return;

        if (For.Body is MemberExpression memberExpr)
        {
            var prop = (System.Reflection.PropertyInfo)memberExpr.Member;
            try
            {
                object? converted = newValue is TProp direct
                    ? direct
                    : Convert.ChangeType(newValue, typeof(TProp));
                prop.SetValue(Model, converted);
            }
            catch { }
        }
    }
}
