@* SuperUI/Components/Forms/SgDynamicField.razor *@
@* ИСПРАВЛЕНО:
   1. Добавлен @typeparam TProp (RZ10001)
   2. SgNumberEdit: явно указан TValue (RZ10001) — не nullable (struct constraint)
   3. typeof(string?) заменён на typeof(string) (CS8632)
   4. Generic методы в Razor заменены на typed свойства (избегаем проблем парсинга < > ?)
   5. EventCallback.Factory.Create для корректного создания типизированных EventCallback
*@
@typeparam TModel
@typeparam TProp

@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@using SuperUI.Components.Forms

@if (FieldType == typeof(string))
{
    <SgTextBox Label="@Label"
               Value="@StringValue"
               ValueChanged="@(EventCallback.Factory.Create<string?>(this, (string? v) => SetValueObjectAsync(v)))"
               Placeholder="@Placeholder" />
}
else if (FieldType == typeof(int))
{
    <SgNumberEdit TValue="int"
                  Label="@Label"
                  Value="@IntValue"
                  ValueChanged="@(EventCallback.Factory.Create(this, (object? v) => SetValueObjectAsync(v)))"
                  Placeholder="@Placeholder" />
}
else if (FieldType == typeof(double))
{
    <SgNumberEdit TValue="double"
                  Label="@Label"
                  Value="@DoubleValue"
                  ValueChanged="@(EventCallback.Factory.Create(this, (object? v) => SetValueObjectAsync(v)))"
                  Placeholder="@Placeholder" />
}
else if (FieldType == typeof(bool))
{
    <SgCheckBox Label="@Label"
                Value="@BoolValue"
                ValueChanged="@(EventCallback.Factory.Create<bool>(this, (bool v) => SetValueObjectAsync(v)))" />
}
else if (FieldType == typeof(DateTime))
{
    <SgDatePicker TValue="DateTime?"
                  Label="@Label"
                  Value="@DateTimeValue"
                  ValueChanged="@(EventCallback.Factory.Create<DateTime?>(this, (DateTime? v) => SetValueObjectAsync(v)))" />
}
else
{
    @* Fallback: текстовое поле для всех остальных типов *@
    <SgTextBox Label="@Label"
               Value="@StringValue"
               ValueChanged="@(EventCallback.Factory.Create<string?>(this, (string? v) => SetValueObjectAsync(v)))"
               Placeholder="@Placeholder" />
}

@code {
    [Parameter, EditorRequired] public TModel? Model { get; set; }
    [Parameter, EditorRequired] public Expression<Func<TModel, TProp>>? For { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }

    private Type FieldType => typeof(TProp);

    private TProp? CurrentValue
    {
        get
        {
            if (Model is null || For is null) return default;
            return For.Compile()(Model);
        }
    }

    private string? StringValue => CurrentValue?.ToString();
    private int IntValue => CurrentValue is int iv ? iv : 0;
    private double DoubleValue => CurrentValue is double dv ? dv : 0;
    private bool BoolValue => CurrentValue is bool bv && bv;
    private DateTime? DateTimeValue => CurrentValue is DateTime dtv ? dtv : null;

    private async Task SetValueObjectAsync(object? newValue)
    {
        if (Model is null || For is null) return;
        if (For.Body is MemberExpression memberExpr)
        {
            var prop = (System.Reflection.PropertyInfo)memberExpr.Member;
            try
            {
                object? converted = newValue is TProp direct
                    ? direct
                    : Convert.ChangeType(newValue, typeof(TProp));
                prop.SetValue(Model, converted);
            }
            catch { /* type mismatch — ignore */ }
        }
    }
}