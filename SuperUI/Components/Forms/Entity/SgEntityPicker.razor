@namespace SuperUI.Components
@using SuperUI.Components
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer
@typeparam TItem where TItem : notnull

<div class="sgc-field @(Block ? "sgc-block" : "") @CssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sgc-label @(Required ? "sgc-required" : "")">@Label</label>
    }

    @if (Inline)
    {
        <SgPopover @ref="_popover"
                   Open="_pickerOpen"
                   OpenChanged="OnPopoverOpenChanged"
                   CloseOnOutsideClick="true"
                   CloseOnEscape="true"
                   Trigger="SgTrigger.Manual"
                   CssClass="@("sgc-picker-pop-wrap" + (Block ? " sgc-block" : ""))">
            <TriggerContent>
                <div class="sgc-picker-control @(Block ? "sgc-block" : "") @(Disabled ? "sgc-disabled" : "") @(Readonly ? "sgc-readonly" : "")" @onclick="TogglePickerAsync">
                    @RenderControlContent()
                    <button class="sgc-picker-btn" type="button" disabled="@(Disabled || Readonly)">
                        <span class="sgc-picker-icon">🔍</span>
                    </button>
                </div>
            </TriggerContent>
            <ChildContent>
                @RenderDialogContent()
            </ChildContent>
        </SgPopover>
    }
    else
    {
        <div class="sgc-picker-control @(Block ? "sgc-block" : "") @(Disabled ? "sgc-disabled" : "") @(Readonly ? "sgc-readonly" : "")" @onclick="TogglePickerAsync">
            @RenderControlContent()
            <button class="sgc-picker-btn" type="button" disabled="@(Disabled || Readonly)">
                <span class="sgc-picker-icon">🔍</span>
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Hint))
    {
        <span class="sgc-hint">@Hint</span>
    }
</div>

@if (!Inline)
{
    <SgModal @bind-Visible="_modalVisible" Title="@EffectiveTitle" Width="@ModalWidth">
        <ChildContent>
            @RenderDialogContent()
        </ChildContent>
        <FooterContent>
            <SgButton Variant="SgButtonVariant.Primary" OnClick="ConfirmSelectionAsync">@EffectiveSelectText</SgButton>
            <SgButton OnClick="() => _modalVisible = false">@EffectiveCancelText</SgButton>
        </FooterContent>
    </SgModal>
}

@code {
    private bool _modalVisible;
    private bool _pickerOpen;
    private SgPopover? _popover;
    private SgDataGrid<TItem>? _grid;
    private HashSet<TItem> _pendingSelection = new();
    private IEnumerable<TItem>? _lazyItems;
    private bool _loading;

    /// <summary>Gets or sets the selected entity (single-select mode).</summary>
    [Parameter] public TItem? Value { get; set; }
    /// <summary>Fires when the selected entity changes (single-select mode).</summary>
    [Parameter] public EventCallback<TItem?> ValueChanged { get; set; }

    /// <summary>Gets or sets the selected entities (multi-select mode).</summary>
    [Parameter] public IEnumerable<TItem>? Values { get; set; }
    /// <summary>Fires when the selected entities change (multi-select mode).</summary>
    [Parameter] public EventCallback<IEnumerable<TItem>?> ValuesChanged { get; set; }

    /// <summary>Gets or sets the collection of items displayed in the picker grid.</summary>
    [Parameter] public IEnumerable<TItem> Items { get; set; } = Array.Empty<TItem>();
    
    /// <summary>
    /// Gets or sets a callback to load items asynchronously.
    /// </summary>
    [Parameter] public Func<string, Task<IEnumerable<TItem>>>? LoadItems { get; set; }

    [Parameter] public RenderFragment? Columns { get; set; }
    /// <summary>Gets or sets a function to produce the display text for each item.</summary>
    [Parameter] public Func<TItem, string> DisplaySelector { get; set; } = x => x?.ToString() ?? "";
    
    /// <summary>Gets or sets the label displayed above the picker.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Gets or sets the placeholder text when no item is selected.</summary>
    [Parameter] public string? Placeholder { get; set; }
    /// <summary>Gets or sets the hint text displayed below the picker.</summary>
    [Parameter] public string? Hint { get; set; }
    /// <summary>Gets or sets whether the field is required (shows indicator on label).</summary>
    [Parameter] public bool Required { get; set; }
    /// <summary>Gets or sets whether the picker is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Gets or sets whether the picker is read-only (cannot open).</summary>
    [Parameter] public bool Readonly { get; set; }
    /// <summary>Gets or sets whether a clear button is shown when an item is selected.</summary>
    [Parameter] public bool AllowClear { get; set; } = true;
    /// <summary>Gets or sets whether the picker fills the full width of its container.</summary>
    [Parameter] public bool Block { get; set; } = true;
    /// <summary>Gets or sets additional CSS classes for the wrapper element.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Gets or sets the title displayed in the picker dialog.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>Gets or sets the width of the modal dialog.</summary>
    [Parameter] public string ModalWidth { get; set; } = "800px";
    /// <summary>Gets or sets whether multiple items can be selected.</summary>
    [Parameter] public bool MultiSelect { get; set; }
    /// <summary>Gets or sets an optional storage key for persisting grid view state.</summary>
    [Parameter] public string? StorageKey { get; set; }
    /// <summary>Gets or sets whether to show the filter bar in the picker dialog.</summary>
    [Parameter] public bool ShowFilterBar { get; set; } = true;
    
    /// <summary>
    /// Gets or sets whether to show the picker in a popover instead of a modal.
    /// </summary>
    [Parameter] public bool Inline { get; set; }

    /// <summary>Gets or sets custom text for the select button. When null, uses the localizer.</summary>
    [Parameter] public string? SelectText { get; set; }
    /// <summary>Gets or sets custom text for the cancel button. When null, uses the localizer.</summary>
    [Parameter] public string? CancelText { get; set; }
    /// <summary>Gets or sets custom text for the clear button. When null, uses the localizer.</summary>
    [Parameter] public string? ClearText { get; set; }
    /// <summary>Fires when the picker dialog opens.</summary>
    [Parameter] public EventCallback OnOpen { get; set; }

    private string EffectivePlaceholder => Placeholder ?? Localizer["Common_Select"];
    private string EffectiveTitle => Title ?? Localizer["Common_Select"];
    private string EffectiveSelectText => SelectText ?? Localizer["Common_Select"];
    private string EffectiveCancelText => CancelText ?? Localizer["Common_Cancel"];
    private string EffectiveClearText => ClearText ?? Localizer["Common_Clear"];

    private RenderFragment RenderControlContent() => __builder =>
    {
        <div class="sgc-picker-content">
            @if (MultiSelect)
            {
                var list = Values?.ToList() ?? new List<TItem>();
                if (list.Count == 0)
                {
                    <span class="sgc-picker-placeholder">@EffectivePlaceholder</span>
                }
                else
                {
                    foreach (var item in list)
                    {
                        var it = item;
                        <span class="sgc-combo-tag">
                            @DisplaySelector(it)
                            @if (!Disabled && !Readonly)
                            {
                                <button class="sgc-combo-tag-x" type="button" title="@EffectiveClearText" @onclick:stopPropagation="true" @onclick="() => RemoveItemAsync(it)">×</button>
                            }
                        </span>
                    }
                }
            }
            else
            {
                if (Value is null)
                {
                    <span class="sgc-picker-placeholder">@EffectivePlaceholder</span>
                }
                else
                {
                    <span class="sgc-picker-text">@DisplaySelector(Value)</span>
                    @if (AllowClear && !Disabled && !Readonly)
                    {
                        <button class="sgc-picker-clear-btn" type="button" title="@EffectiveClearText" @onclick:stopPropagation="true" @onclick="ClearSelectionAsync">×</button>
                    }
                }
            }
        </div>
    };

    private RenderFragment RenderDialogContent() => @<div class="sgc-picker-dialog">
        @if (!string.IsNullOrEmpty(StorageKey))
        {
            <div class="sgc-sv-wrap">
                <SgSavedViews TItem="TItem" Grid="_grid" StorageKey="@StorageKey" Title="" Subtitle="" />
            </div>
        }
        
        @if (ShowFilterBar)
        {
            <SgDataGridFilterBar TItem="TItem" Grid="_grid" AutoApply="true" Title="" Subtitle="" />
        }

        @if (_loading)
        {
            <div class="sgc-picker-loading">@Localizer["Common_Loading"]</div>
        }

        <div class="sgc-picker-grid-wrap">
            <SgDataGrid @ref="_grid"
                        TItem="TItem"
                        Items="@(_lazyItems ?? Items)"
                        AllowMultiSelect="@MultiSelect"
                        AllowSingleSelect="@(!MultiSelect)"
                        SelectedItemsChanged="OnGridSelectionChanged"
                        RowClicked="OnRowClicked"
                        RowDoubleClicked="OnRowDoubleClicked"
                        ShowQuickFilters="true"
                        PageSize="@(Inline ? 5 : 10)">
                @Columns
            </SgDataGrid>
        </div>
        
        @if (Inline && MultiSelect)
        {
            <div class="sgc-picker-inline-footer" style="margin-top: 12px; display: flex; justify-content: space-between; gap: 8px;">
                <div style="display: flex; gap: 8px;">
                    <SgButton Size="SgSize.Sm" OnClick="SelectAllAsync">@Localizer["SelectAll"]</SgButton>
                    <SgButton Size="SgSize.Sm" OnClick="ClearSelectionAsync">@EffectiveClearText</SgButton>
                </div>
                <div style="display: flex; gap: 8px;">
                    <SgButton Variant="SgButtonVariant.Primary" Size="SgSize.Sm" OnClick="ConfirmSelectionAsync">@EffectiveSelectText</SgButton>
                    <SgButton Size="SgSize.Sm" OnClick="CloseInlineAsync">@EffectiveCancelText</SgButton>
                </div>
            </div>
        }
        @if (Inline && !MultiSelect && Value is not null)
        {
            <div class="sgc-picker-inline-footer" style="margin-top: 12px; display: flex; justify-content: flex-end; gap: 8px;">
                <SgButton Size="SgSize.Sm" OnClick="CloseInlineAsync">@EffectiveCancelText</SgButton>
            </div>
        }
    </div>;

    private async Task OnPopoverOpenChanged(bool open)
    {
        _pickerOpen = open;
        if (!open) return;
        await PrepareOpenAsync();
        await Task.Delay(1);
        SyncGridSelection();
        StateHasChanged();
    }

    private async Task CloseInlineAsync()
    {
        _pickerOpen = false;
        if (_popover is not null)
            await _popover.CloseAsync();
    }

    private async Task TogglePickerAsync()
    {
        if (Disabled || Readonly) return;

        if (Inline)
        {
            if (_pickerOpen)
            {
                await CloseInlineAsync();
            }
            else
            {
                _pickerOpen = true;
                if (_popover is not null)
                    await _popover.OpenAsync();
                await PrepareOpenAsync();
                await Task.Delay(1);
                SyncGridSelection();
                StateHasChanged();
            }
        }
        else
        {
            await OpenDialogAsync();
        }
    }

    private async Task PrepareOpenAsync()
    {
        _pendingSelection.Clear();
        if (MultiSelect)
        {
            if (Values is not null)
            {
                foreach (var item in Values) _pendingSelection.Add(item);
            }
        }
        else if (Value is not null)
        {
            _pendingSelection.Add(Value);
        }

        if (LoadItems != null && _lazyItems == null)
        {
            _loading = true;
            StateHasChanged();
            _lazyItems = await LoadItems("");
            _loading = false;
        }

        if (OnOpen.HasDelegate) await OnOpen.InvokeAsync();
    }

    private async Task OpenDialogAsync()
    {
        await PrepareOpenAsync();
        _modalVisible = true;
        
        await Task.Delay(1);
        SyncGridSelection();
        StateHasChanged();
    }

    private void SyncGridSelection()
    {
        if (_grid is null) return;
        _grid.SelectedItems.Clear();
        foreach (var item in _pendingSelection)
            _grid.SelectedItems.Add(item);
    }

    private void OnGridSelectionChanged(IReadOnlyCollection<TItem> selected)
    {
        _pendingSelection.Clear();
        foreach (var item in selected) _pendingSelection.Add(item);
    }

    private async Task OnRowClicked(TItem item)
    {
        if (!MultiSelect)
        {
            Value = item;
            if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(Value);
            _modalVisible = false;
            await CloseInlineAsync();
        }
    }

    private async Task OnRowDoubleClicked(TItem item)
    {
        if (MultiSelect)
        {
            if (!_pendingSelection.Contains(item))
            {
                _pendingSelection.Add(item);
            }
            await ConfirmSelectionAsync();
        }
        else
        {
            Value = item;
            if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(Value);
            _modalVisible = false;
            await CloseInlineAsync();
        }
    }

    private async Task ConfirmSelectionAsync()
    {
        if (MultiSelect)
        {
            Values = _pendingSelection.ToList();
            if (ValuesChanged.HasDelegate) await ValuesChanged.InvokeAsync(Values);
        }
        else
        {
            Value = _pendingSelection.FirstOrDefault();
            if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(Value);
        }
        _modalVisible = false;
        await CloseInlineAsync();
    }

    private async Task ClearSelectionAsync()
    {
        if (MultiSelect)
        {
            Values = Enumerable.Empty<TItem>();
            if (ValuesChanged.HasDelegate) await ValuesChanged.InvokeAsync(Values);
        }
        else
        {
            Value = default;
            if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(Value);
        }
    }

    private async Task RemoveItemAsync(TItem item)
    {
        if (Values is null) return;
        var list = Values.ToList();
        if (list.Remove(item))
        {
            Values = list;
            if (ValuesChanged.HasDelegate) await ValuesChanged.InvokeAsync(Values);
        }
    }

    private async Task SelectAllAsync()
    {
        if (_grid is null) return;
        var rows = _grid.Items ?? Items;
        if (rows != null)
        {
            _pendingSelection.Clear();
            foreach (var item in rows) _pendingSelection.Add(item);
            SyncGridSelection();
        }
    }
}
