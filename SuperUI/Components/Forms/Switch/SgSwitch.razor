@namespace SuperUI.Components
@using SuperUI.Enums
@inherits SgInputBase<bool>

<div class="sgc-check-field @(Block ? "sgc-block" : "") @CssClass">
    <label class="sgc-check @(Disabled ? "sgc-disabled" : "") @(ReadOnly ? "sgc-readonly" : "") @(IsInvalid ? "sgc-check-invalid" : "") @(Rtl ? "sgc-rtl" : "")"
           style="@SwitchColors">
        <span class="sgc-switch @SwitchSizeClass @(Animation ? "sgc-switch-animated" : "") @(Loading ? "sgc-switch-loading" : "") @(Rtl ? "sgc-switch-rtl" : "")">
            <input type="checkbox"
                   role="switch"
                   checked="@Value"
                   disabled="@(Disabled || ReadOnly || Loading)"
                   aria-checked="@Value.ToString().ToLowerInvariant()"
                   aria-invalid="@(IsInvalid ? "true" : null)"
                   aria-describedby="@DescribedBy"
                   @onchange="OnChangeAsync"
                   @attributes="AdditionalAttributes"
                   @ref="_inputRef" />
            <span class="sgc-switch-slider">
                @if (ThumbIconOn is not null || ThumbIconOff is not null)
                {
                    <span class="sgc-switch-thumb-icon">
                        @if (Value && ThumbIconOn is not null) { @ThumbIconOn }
                        else if (!Value && ThumbIconOff is not null) { @ThumbIconOff }
                    </span>
                }
            </span>
            @if (Loading)
            {
                <span class="sgc-switch-spinner"></span>
            }
        </span>
        @if (!string.IsNullOrEmpty(OnLabel) || !string.IsNullOrEmpty(OffLabel))
        {
            <span class="sgc-switch-label sgc-switch-label-on">@OnLabel</span>
            <span class="sgc-switch-label sgc-switch-label-off">@OffLabel</span>
        }
        else if (ShowLabel && ChildContent is not null)
        {
            @ChildContent
        }
        else if (ShowLabel && !string.IsNullOrEmpty(Label))
        {
            <span class="sgc-switch-label @(Animation ? "sgc-switch-label-animated" : "")">@Label</span>
        }
    </label>
    @if (!string.IsNullOrEmpty(HelpText))
    {
        <span class="sgc-helptext">@HelpText</span>
    }
    @if (IsInvalid)
    {
        <span id="@_errorId" class="sgc-error">@(!string.IsNullOrEmpty(ErrorText) ? ErrorText : ValidationMessages.FirstOrDefault())</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@_hintId" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private readonly string _id = "sg-sw-" + Guid.NewGuid().ToString("N")[..8];
    private string _hintId => _id + "-hint";
    private string _errorId => _id + "-err";
    private ElementReference _inputRef;

    /// <summary>Label text displayed next to the switch. Ignored if <see cref="ChildContent"/> or On/OffLabel are set.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Callback invoked when the switch value changes. Fires after the value has been updated.</summary>
    [Parameter] public EventCallback<bool> OnChange { get; set; }

    /// <summary>When false, the label text is hidden. Only the switch control is visible. Default is true.</summary>
    [Parameter] public bool ShowLabel { get; set; } = true;

    /// <summary>Label shown when switch is ON. When set, takes precedence over <see cref="Label"/>.</summary>
    [Parameter] public string? OnLabel { get; set; }

    /// <summary>Label shown when switch is OFF. When set, takes precedence over <see cref="Label"/>.</summary>
    [Parameter] public string? OffLabel { get; set; }

    /// <summary>Hint text displayed below the switch.</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>Small help text displayed between the switch label and the error/hint text.</summary>
    [Parameter] public string? HelpText { get; set; }

    /// <summary>Override error text displayed below the switch. Takes precedence over EditContext validation messages.</summary>
    [Parameter] public string? ErrorText { get; set; }

    /// <summary>Custom content to render next to the switch. Takes precedence over <see cref="Label"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Whether the switch is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Expand to full width of the container.</summary>
    [Parameter] public bool Block { get; set; }

    /// <summary>Size of the switch: Sm, Md (default), Lg, Xl.</summary>
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;

    /// <summary>Custom color for the switch track when ON. Accepts any CSS color value (e.g., "#34c759", "var(--sg-color-success)").</summary>
    [Parameter] public string? OnColor { get; set; }

    /// <summary>Custom color for the switch track when OFF. Accepts any CSS color value.</summary>
    [Parameter] public string? OffColor { get; set; }

    /// <summary>Custom CSS color that overrides OnColor. Takes precedence over <see cref="SwitchColor"/>.</summary>
    [Parameter] public string? Color { get; set; }

    /// <summary>Semantic color for the switch. Maps to a known theme CSS variable for OnColor.</summary>
    [Parameter] public SgColor? SwitchColor { get; set; }

    /// <summary>When true the switch appearance is preserved but user toggling is prevented.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>When true the thumb is replaced by a loading spinner and clicks are disabled.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>Enables smooth animation on the thumb. Default is true.</summary>
    [Parameter] public bool Animation { get; set; } = true;

    /// <summary>Custom icon rendered inside the thumb when switch is ON.</summary>
    [Parameter] public RenderFragment? ThumbIconOn { get; set; }

    /// <summary>Custom icon rendered inside the thumb when switch is OFF.</summary>
    [Parameter] public RenderFragment? ThumbIconOff { get; set; }

    /// <summary>Enables RTL (right-to-left) layout for the switch.</summary>
    [Parameter] public bool Rtl { get; set; }

    private bool IsInvalid => HasValidationErrors || !string.IsNullOrEmpty(ErrorText);
    private string? DescribedBy => IsInvalid ? _errorId : (!string.IsNullOrEmpty(Hint) ? _hintId : null);

    private string? SwitchColors
    {
        get
        {
            var on = ComputedOnColor;
            var off = OffColor;
            var parts = new List<string>();
            if (on is not null) parts.Add($"--sgc-switch-on-color:{on}");
            if (off is not null) parts.Add($"--sgc-switch-off-color:{off}");
            return parts.Count > 0 ? string.Join(";", parts) : null;
        }
    }

    private string? ComputedOnColor
    {
        get
        {
            if (!string.IsNullOrEmpty(Color)) return Color;
            if (SwitchColor.HasValue)
            {
                return SwitchColor.Value switch
                {
                    SgColor.Success => "var(--sg-color-success)",
                    SgColor.Danger => "#e53935",
                    SgColor.Warning => "#fb8c00",
                    _ => OnColor
                };
            }
            return OnColor;
        }
    }

    private string SwitchSizeClass => Size switch
    {
        SgSize.Sm => "sgc-switch-sm",
        SgSize.Lg => "sgc-switch-lg",
        SgSize.Xl => "sgc-switch-xl",
        _ => ""
    };

    /// <summary>Programmatically focuses the switch input.</summary>
    public ValueTask FocusAsync() => _inputRef.FocusAsync();

    private async Task OnChangeAsync(ChangeEventArgs e)
    {
        if (ReadOnly || Loading) return;
        var newVal = e.Value is true;
        await SetValueAsync(newVal);
        if (OnChange.HasDelegate) await OnChange.InvokeAsync(newVal);
    }
}
