@namespace SuperUI.Components
@typeparam TItem
@typeparam TKey
@using SuperUI.Enums
@using SuperUI.Localization
@using System.Linq.Expressions
@inject ISuperUILocalizer Localizer
@implements IDisposable

<div class="sgc-field @(Block ? "sgc-block" : "") @SizeClass @(LabelPosition == SgLabelPosition.Left ? "sgc-label-left" : LabelPosition == SgLabelPosition.Right ? "sgc-label-right" : "") @CssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label id="@_labelId" class="sgc-label @(Required ? "sgc-required" : "")">@Label</label>
    }
    <div class="sgc-combo @(Block ? "sgc-block" : "") @(_open ? "sgc-open" : "") @(Disabled ? "sgc-disabled" : "") @(IsInvalid ? "sgc-invalid" : "") @(Dropup ? "sgc-dropup" : "")"
         role="combobox"
         aria-expanded="@(_open ? "true" : "false")"
         aria-haspopup="listbox"
         aria-labelledby="@_labelId"
         aria-required="@(Required ? "true" : null)"
         aria-disabled="@(Disabled ? "true" : null)"
         aria-invalid="@(IsInvalid ? "true" : null)"
         aria-describedby="@DescribedBy"
         aria-multiselectable="true"
         tabindex="@(Disabled ? "-1" : "0")"
         @onfocusout="HandleFocusOutAsync"
         @onclick:stopPropagation="true">
        <div class="sgc-combo-control" @onclick="ToggleAsync">
            @{ var selItems = GetSelectedItems().ToList(); }
            @{ var selCount = selItems.Count; var displayItems = selItems.Take(MaxDisplayedTags).ToList(); }
            @if (selCount == 0 && !_open)
            {
                <span class="sgc-combo-placeholder">@EffectivePlaceholder</span>
            }
            else
            {
                foreach (var it in displayItems)
                {
                    var itLocal = it;
                    <span class="sgc-combo-tag">
                        @if (ColumnsSelector != null)
                        {
                            var cols = ColumnsSelector(itLocal).ToList();
                            <span class="sgc-combo-tag-cols">
                                @for (int i = 0; i < cols.Count; i++)
                                {
                                    <span class="sgc-tag-col @(i == 0 ? "sgc-tag-col-main" : "sgc-tag-col-sub")">@cols[i]</span>
                                }
                            </span>
                        }
                        else
                        {
                            @LabelFrom(itLocal)
                        }
                        @if (!Disabled)
                        {
                            <button class="sgc-combo-tag-x" type="button"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => RemoveAsync(KeySelector(itLocal))">@((MarkupString)SgIcons.X)</button>
                        }
                    </span>
                }
                if (selCount > MaxDisplayedTags)
                {
                    <span class="sgc-combo-tag sgc-combo-tag-overflow">+@(selCount - MaxDisplayedTags)</span>
                }
                @if (_open)
                {
                    <input class="sgc-combo-input"
                           value="@_search"
                           placeholder="@(selCount == 0 ? EffectivePlaceholder : "")"
                           aria-autocomplete="list"
                           aria-controls="@_listboxId"
                           @oninput="OnSearchInput"
                           @onkeydown="OnKeyDownAsync"
                           @onclick:stopPropagation="true"
                           @ref="_searchInput" />
                }
            }
            @if (AllowClear && HasSelectedValues && !Disabled)
            {
                <button class="sgc-combo-clear" type="button" aria-label="@Localizer["Clear"]" @onclick:stopPropagation="true" @onclick="ClearAllAsync">@((MarkupString)SgIcons.X)</button>
            }
            <span class="sgc-combo-caret">@((MarkupString)SgIcons.ChevronDown)</span>
        </div>
        @if (_open)
        {
            var maxH = DropdownMaxHeight;
            var menuStyle = maxH is not null ? $"max-height:{maxH}" : null;
            <div id="@_listboxId" class="sgc-combo-menu sgc-combo-multiselect" role="listbox" aria-multiselectable="true" style="@menuStyle" @ref="_menuRef">
                @if (ColumnsSelector != null)
                {
                    <div class="sgc-combo-header">
                        <div class="sgc-combo-opt-columns">
                            <span class="sgc-combo-opt-col sgc-combo-opt-check sgc-combo-header-col"></span>
                            @if (ColumnNames != null)
                            {
                                @foreach (var name in ColumnNames)
                                {
                                    <span class="sgc-combo-opt-col sgc-combo-header-col">@name</span>
                                }
                            }
                        </div>
                    </div>
                }
                @{ var filtered = GetFilteredItems().ToList(); }
                @if (filtered.Count == 0)
                {
                    <div class="sgc-combo-empty">@EffectiveEmptyText</div>
                }
                else
                {
                    var allFilteredSelected = filtered.All(it => IsSelected(KeySelector(it)));
                    <div class="sgc-select-all" @onclick:stopPropagation="true" @onclick="ToggleSelectAllAsync">
                        <input type="checkbox" checked="@allFilteredSelected" readonly tabindex="-1" style="pointer-events:none;" />
                        <span>@(allFilteredSelected ? Localizer["Common_DeselectAll"] : Localizer["Common_SelectAll"])</span>
                    </div>
                    @for (int idx = 0; idx < filtered.Count; idx++)
                    {
                        var itLocal = filtered[idx];
                        var isSel = IsSelected(KeySelector(itLocal));
                        <div class="sgc-combo-option sgc-combo-option-ex @(isSel ? "sgc-selected" : "") @(idx == _activeIndex ? "sgc-active" : "")"
                             @onclick:stopPropagation="true"
                             @onclick="() => ToggleItemAsync(KeySelector(itLocal))">
                            <div class="sgc-combo-opt-columns">
                                <span class="sgc-combo-opt-col sgc-combo-opt-check">
                                    <input type="checkbox" checked="@isSel" readonly tabindex="-1" style="pointer-events:none;flex-shrink:0;" />
                                </span>
                                @if (ColumnsSelector != null)
                                {
                                    var rowCols = ColumnsSelector(itLocal);
                                    @foreach (var colValue in rowCols)
                                    {
                                        <span class="sgc-combo-opt-col">@colValue</span>
                                    }
                                }
                                else
                                {
                                    <span class="sgc-combo-opt-col sgc-combo-opt-main">
                                        <span class="sgc-combo-opt-label">@LabelFrom(itLocal)</span>
                                        @{ var desc = DescriptionSelector?.Invoke(itLocal); }
                                        @if (!string.IsNullOrEmpty(desc))
                                        {
                                            <span class="sgc-combo-opt-desc">@desc</span>
                                        }
                                    </span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </div>
    @if (IsInvalid)
    {
        <span id="@_errorId" class="sgc-error">@DisplayedError</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@_hintId" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private readonly string _labelId = "sg-msex-label-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _listboxId = "sg-msex-listbox-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _hintId = "sg-msex-hint-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _errorId = "sg-msex-err-" + Guid.NewGuid().ToString("N")[..8];
    private bool _open;
    private string _search = string.Empty;
    private int _activeIndex;
    private SgEditContextBinder<IEnumerable<TKey>?>? _binder;
    private CancellationTokenSource? _blurCts;
    private CancellationTokenSource? _searchCts;
    private ElementReference _searchInput;
    private ElementReference _menuRef;

    /// <summary>
    /// Gets or sets the collection of selected item keys.
    /// </summary>
    [Parameter] public IEnumerable<TKey>? Values { get; set; }
    
    /// <summary>
    /// Gets or sets the callback invoked when the selected values change.
    /// </summary>
    [Parameter] public EventCallback<IEnumerable<TKey>> ValuesChanged { get; set; }
    
    /// <summary>
    /// Gets or sets the collection of items to display in the dropdown.
    /// </summary>
    [Parameter] public IEnumerable<TItem> Items { get; set; } = Array.Empty<TItem>();
    
    /// <summary>
    /// Gets or sets the function to extract the key from an item. Required.
    /// </summary>
    [Parameter, EditorRequired] public Func<TItem, TKey> KeySelector { get; set; } = default!;
    
    /// <summary>
    /// Gets or sets the function to extract the display label from an item. Required.
    /// </summary>
    [Parameter, EditorRequired] public Func<TItem, string> LabelSelector { get; set; } = default!;
    
    /// <summary>
    /// Gets or sets the function to extract an optional description from an item.
    /// The description is displayed below the label in the dropdown.
    /// </summary>
    [Parameter] public Func<TItem, string>? DescriptionSelector { get; set; }

    /// <summary>
    /// Gets or sets a function to extract multiple columns for display in the dropdown and in the selected tags.
    /// If provided, these columns will be displayed next to each other.
    /// </summary>
    [Parameter] public Func<TItem, IEnumerable<string>>? ColumnsSelector { get; set; }

    /// <summary>
    /// Gets or sets the column names to display in the header of the dropdown menu.
    /// Only used if ColumnsSelector is provided.
    /// </summary>
    [Parameter] public IEnumerable<string>? ColumnNames { get; set; }
    
    /// <summary>
    /// Gets or sets the placeholder text displayed when no items are selected.
    /// If not specified, uses the localized "Select" string.
    /// </summary>
    [Parameter] public string? Placeholder { get; set; }
    
    /// <summary>
    /// Gets or sets the text displayed when no items match the search filter.
    /// If not specified, uses the localized "NoMatches" string.
    /// </summary>
    [Parameter] public string? EmptyText { get; set; }
    
    /// <summary>
    /// Gets or sets the label text displayed above the multi-select.
    /// </summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// Gets or sets the position of the label. Default is Top.
    /// </summary>
    [Parameter] public SgLabelPosition LabelPosition { get; set; } = SgLabelPosition.Top;
    
    /// <summary>
    /// Gets or sets the hint text displayed below the multi-select.
    /// </summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>
    /// Gets or sets the error text to display below the multi-select.
    /// </summary>
    [Parameter] public string? ErrorText { get; set; }
    
    /// <summary>
    /// Gets or sets whether the field is marked as required with a visual indicator.
    /// </summary>
    [Parameter] public bool Required { get; set; }
    
    /// <summary>
    /// Gets or sets whether the multi-select is disabled.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }
    
    /// <summary>
    /// Gets or sets whether the multi-select takes the full width of its container.
    /// Default is true.
    /// </summary>
    [Parameter] public bool Block { get; set; } = true;
    
    /// <summary>
    /// Gets or sets additional CSS classes to apply to the component.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Size of the multi-select: Sm, Md (default), or Lg.</summary>
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;

    /// <summary>When true, the dropdown opens upward instead of downward.</summary>
    [Parameter] public bool Dropup { get; set; }

    /// <summary>When true, shows a clear-all button when values are selected.</summary>
    [Parameter] public bool AllowClear { get; set; }

    /// <summary>Maximum number of tags to display before showing a "+N more" overflow badge.</summary>
    [Parameter] public int MaxDisplayedTags { get; set; } = 10;

    /// <summary>Whether to automatically focus the search input on first render.</summary>
    [Parameter] public bool AutoFocus { get; set; }

    /// <summary>Gets or sets the maximum height of the dropdown menu in CSS units.</summary>
    [Parameter] public string? DropdownMaxHeight { get; set; }

    /// <summary>Debounce delay in milliseconds for search input. Default 300.</summary>
    [Parameter] public int SearchDebounceMs { get; set; } = 300;

    [CascadingParameter] private EditContext? CascadedEditContext { get; set; }

    /// <summary>
    /// Gets or sets the expression that identifies the bound value for EditContext validation.
    /// </summary>
    [Parameter] public Expression<Func<IEnumerable<TKey>?>>? ValueExpression { get; set; }

    private string EffectivePlaceholder => Placeholder ?? Localizer["Common_Select"];
    private string EffectiveEmptyText => string.IsNullOrEmpty(EmptyText) ? Localizer["Common_NoMatches"] : EmptyText;

    private bool IsInvalid => !string.IsNullOrEmpty(ErrorText) || (_binder?.HasValidationErrors ?? false);
    private string? DisplayedError => !string.IsNullOrEmpty(ErrorText) 
        ? ErrorText 
        : _binder?.ValidationMessages.FirstOrDefault();

    private string LabelFrom(TItem item) => LabelSelector(item);
    private string? DescribedBy => IsInvalid ? _errorId : (!string.IsNullOrEmpty(Hint) ? _hintId : null);
    private bool HasSelectedValues => Values?.Any() == true;

    private string? SizeClass => Size switch
    {
        SgSize.Sm => "sgc-field-sm",
        SgSize.Lg => "sgc-field-lg",
        SgSize.Xl => "sgc-field-xl",
        _         => null
    };

    protected override void OnInitialized()
    {
        _binder = new SgEditContextBinder<IEnumerable<TKey>?>(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        _binder?.Update(CascadedEditContext, ValueExpression);
    }

    private IEnumerable<TItem> GetSelectedItems()
    {
        if (Values is null) yield break;
        var keys = Values.ToHashSet();
        foreach (var it in Items)
            if (keys.Contains(KeySelector(it))) yield return it;
    }

    private bool IsSelected(TKey key)
    {
        if (Values is null) return false;
        foreach (var k in Values)
            if (EqualityComparer<TKey>.Default.Equals(k, key)) return true;
        return false;
    }

    private IEnumerable<TItem> GetFilteredItems()
    {
        if (string.IsNullOrEmpty(_search)) return Items;
        return Items.Where(i =>
            LabelFrom(i).Contains(_search, StringComparison.CurrentCultureIgnoreCase) ||
            (DescriptionSelector?.Invoke(i) ?? "").Contains(_search, StringComparison.CurrentCultureIgnoreCase) ||
            (ColumnsSelector?.Invoke(i).Any(c => c.Contains(_search, StringComparison.CurrentCultureIgnoreCase)) ?? false));
    }

    private async Task ToggleAsync()
    {
        if (Disabled) return;
        _blurCts?.Cancel();
        _open = !_open;
        if (_open)
        {
            _search = string.Empty;
            _activeIndex = 0;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleFocusOutAsync(FocusEventArgs e)
    {
        _blurCts?.Cancel();
        _blurCts = new CancellationTokenSource();
        var token = _blurCts.Token;
        try
        {
            await Task.Delay(200, token);
            _open = false;
            _activeIndex = 0;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        var currentSearch = _search;
        try
        {
            await Task.Delay(SearchDebounceMs, token);
            if (!token.IsCancellationRequested)
            {
                _search = currentSearch;
                _activeIndex = 0;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                _open = false;
                await InvokeAsync(StateHasChanged);
                break;
            case "ArrowDown":
                if (!_open) { _open = true; await InvokeAsync(StateHasChanged); return; }
                _activeIndex++;
                await InvokeAsync(StateHasChanged);
                break;
            case "ArrowUp":
                if (_activeIndex > 0) _activeIndex--;
                await InvokeAsync(StateHasChanged);
                break;
            case "Enter":
                if (_open)
                {
                    var items = GetFilteredItems().ToList();
                    if (_activeIndex >= 0 && _activeIndex < items.Count)
                        await ToggleItemAsync(KeySelector(items[_activeIndex]));
                }
                break;
        }
    }

    private async Task ToggleItemAsync(TKey key)
    {
        var list = Values?.ToList() ?? new List<TKey>();
        var idx = list.FindIndex(k => EqualityComparer<TKey>.Default.Equals(k, key));
        if (idx >= 0) list.RemoveAt(idx); else list.Add(key);
        Values = list;
        if (ValuesChanged.HasDelegate) await ValuesChanged.InvokeAsync(list);
        _binder?.NotifyFieldChanged();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveAsync(TKey key)
    {
        var list = Values?.ToList() ?? new List<TKey>();
        list.RemoveAll(k => EqualityComparer<TKey>.Default.Equals(k, key));
        Values = list;
        if (ValuesChanged.HasDelegate) await ValuesChanged.InvokeAsync(list);
        _binder?.NotifyFieldChanged();
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AutoFocus && _open)
        {
            await _searchInput.FocusAsync();
        }
    }

    private async Task ClearAllAsync()
    {
        if (Disabled) return;
        Values = Array.Empty<TKey>();
        if (ValuesChanged.HasDelegate) await ValuesChanged.InvokeAsync(Array.Empty<TKey>());
        _binder?.NotifyFieldChanged();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleSelectAllAsync()
    {
        var filtered = GetFilteredItems().ToList();
        var allSelected = filtered.All(it => IsSelected(KeySelector(it)));
        var list = Values?.ToList() ?? new List<TKey>();
        if (allSelected)
        {
            var removeKeys = filtered.Select(it => KeySelector(it)).ToHashSet();
            list.RemoveAll(k => removeKeys.Contains(k));
        }
        else
        {
            foreach (var it in filtered)
            {
                var key = KeySelector(it);
                if (!list.Contains(key)) list.Add(key);
            }
        }
        Values = list;
        if (ValuesChanged.HasDelegate) await ValuesChanged.InvokeAsync(list);
        _binder?.NotifyFieldChanged();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _blurCts?.Cancel();
        _blurCts?.Dispose();
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _binder?.Dispose();
    }
}

