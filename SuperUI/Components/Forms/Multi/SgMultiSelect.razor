@namespace SuperUI.Components
@typeparam TItem
@typeparam TKey
@using SuperUI.Enums
@using SuperUI.Localization
@using System.Linq.Expressions
@inject ISuperUILocalizer Localizer
@inject IJSRuntime JS
@implements IDisposable

<div class="sgc-field @(Block ? "sgc-block" : "") @SizeClass @(LabelPosition == SgLabelPosition.Left ? "sgc-label-left" : LabelPosition == SgLabelPosition.Right ? "sgc-label-right" : "") @CssClass @(Compact ? "sgc-compact" : "") @(FloatingLabel ? "sgc-floating-label" : "")" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label id="@_labelId" class="sgc-label @(Required ? "sgc-required" : "")">@Label</label>
    }
    <div class="sgc-combo @(Block ? "sgc-block" : "") @(_open ? "sgc-open" : "") @(Disabled ? "sgc-disabled" : "") @(IsInvalid ? "sgc-invalid" : "") @(Dropup ? "sgc-dropup" : "") @(Compact ? "sgc-compact" : "") @(FloatingLabel ? "sgc-floating-label" : "") @(ShowClearOnHover ? "sgc-clear-hover" : "")"
         role="combobox"
         aria-expanded="@(_open ? "true" : "false")"
         aria-haspopup="listbox"
         aria-labelledby="@_labelId"
         aria-required="@(Required ? "true" : null)"
         aria-disabled="@(Disabled ? "true" : null)"
         aria-invalid="@(IsInvalid ? "true" : null)"
         aria-describedby="@DescribedBy"
         tabindex="@(Disabled ? "-1" : "0")"
         @onfocusout="HandleFocusOutAsync"
         @onkeydown="OnKeyDownAsync"
         @onclick:stopPropagation="true">
        <div class="sgc-combo-control" @onclick="ToggleAsync" @ref="_comboRef">
            @if (!string.IsNullOrEmpty(PrefixText))
            {
                <span class="sgc-combo-prefix">@PrefixText</span>
            }
            @if (IsEnumMode)
            {
                var selEnumItems = GetSelectedEnumItems().ToList();
                var selEnumCount = selEnumItems.Count;
                var displayEnumItems = selEnumItems.Take(MaxDisplayedTags).ToList();
                if (selEnumCount == 0 && !_open)
                {
                    <span class="sgc-combo-placeholder">@EffectivePlaceholder</span>
                }
                else
                {
                    foreach (var ei in displayEnumItems)
                    {
                        var eiLocal = ei;
                        <span class="sgc-combo-tag" role="listitem" title="@eiLocal.Description">
                            @eiLocal.Label
                            @if (!Disabled)
                            {
                                <button class="sgc-combo-tag-x"
                                        type="button"
                                        aria-label="@Localizer["Remove"] @eiLocal.Label"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => RemoveEnumItemAsync(eiLocal)">×</button>
                            }
                        </span>
                    }
                    if (selEnumCount > MaxDisplayedTags)
                    {
                        <span class="sgc-combo-tag sgc-combo-tag-overflow">+@(selEnumCount - MaxDisplayedTags)</span>
                    }
                    @if (_open)
                    {
                        <input class="sgc-combo-input"
                               value="@_search"
                               placeholder="@(selEnumItems.Count == 0 ? EffectivePlaceholder : "")"
                               aria-autocomplete="list"
                               aria-controls="@_listboxId"
                               @oninput="OnSearchInput"
                               @onkeydown="OnKeyDownAsync"
                               @onfocus="HandleInputFocus"
                               @onclick:stopPropagation="true"
                               @ref="_searchInput" />
                    }
                }
            }
            else
            {
                var selItems = GetSelectedItems().ToList();
                var selCount = selItems.Count;
                var displayItems = selItems.Take(MaxDisplayedTags).ToList();
                if (selCount == 0 && !_open)
                {
                    <span class="sgc-combo-placeholder">@EffectivePlaceholder</span>
                }
                else
                {
                    foreach (var v in displayItems)
                    {
                        var vLocal = v;
                        <span class="sgc-combo-tag" role="listitem">
                            @if (TagTemplate is not null)
                            {
                                @TagTemplate(vLocal)
                            }
                            else
                            {
                                @LabelFrom(vLocal)
                                @if (!Disabled)
                                {
                                    <button class="sgc-combo-tag-x"
                                            type="button"
                                            aria-label="@Localizer["Remove"] @LabelFrom(vLocal)"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => RemoveAsync(KeySelector(vLocal))">×</button>
                                }
                            }
                        </span>
                    }
                    if (selCount > MaxDisplayedTags)
                    {
                        <span class="sgc-combo-tag sgc-combo-tag-overflow">+@(selCount - MaxDisplayedTags)</span>
                    }
                    @if (_open)
                    {
                        <input class="sgc-combo-input"
                               value="@_search"
                               placeholder="@(selItems.Count == 0 ? EffectivePlaceholder : "")"
                               aria-autocomplete="list"
                               aria-controls="@_listboxId"
                               @oninput="OnSearchInput"
                               @onkeydown="OnKeyDownAsync"
                               @onfocus="HandleInputFocus"
                               @onclick:stopPropagation="true"
                               @ref="_searchInput" />
                    }
                }
            }
            @if (!string.IsNullOrEmpty(SuffixText))
            {
                <span class="sgc-combo-suffix">@SuffixText</span>
            }
            @if (AllowClear && HasSelectedValues && !Disabled)
            {
                <button class="sgc-combo-clear" type="button" aria-label="@Localizer["Clear"]" @onclick:stopPropagation="true" @onclick="ClearAllAsync">@((MarkupString)SgIcons.X)</button>
            }
            <span class="sgc-combo-caret" aria-hidden="true">@((MarkupString)SgIcons.ChevronDown)</span>
        </div>
        @if (_open)
        {
            var maxH = DropdownMaxHeight;
            var menuStyle = maxH is not null ? $"max-height:{maxH}" : null;
            <div id="@_listboxId" class="sgc-combo-menu" role="listbox" aria-multiselectable="true"
                 style="@menuStyle" @ref="_menuRef" @onscroll="OnMenuScrollAsync">
                @if (DropdownHeader is not null)
                {
                    <div class="sgc-combo-menu-header">@DropdownHeader</div>
                }
                @if (_loading)
                {
                    <div class="sgc-combo-loading" role="status">
                        <span class="sgc-spinner-sm"></span>
                        @Localizer["Common_Loading"]
                    </div>
                }
                else if (IsEnumMode)
                {
                    var filteredEnum = GetFilteredEnumItems().ToList();
                    @if (filteredEnum.Count == 0)
                    {
                        @EmptyOrNoResults()
                    }
                    else
                    {
                        if (ShowSelectAll)
                        {
                            var allFilteredSelected = filteredEnum.All(ei => IsEnumItemSelected(ei));
                            <div class="sgc-select-all" @onclick:stopPropagation="true" @onclick="ToggleSelectAllEnumAsync">
                                <input type="checkbox" checked="@allFilteredSelected" readonly tabindex="-1" style="pointer-events:none;" />
                                <span>@(allFilteredSelected ? Localizer["Common_DeselectAll"] : Localizer["Common_SelectAll"])</span>
                            </div>
                        }
                        <div class="sgc-combo-options">
                        @for (int idx = 0; idx < filteredEnum.Count; idx++)
                        {
                            var eiLocal = filteredEnum[idx];
                            var selected = IsEnumItemSelected(eiLocal);
                            var atMax = !selected && MaxSelectable.HasValue && (Values?.Count() ?? 0) >= MaxSelectable.Value;
                            <div class="sgc-combo-option @(selected ? "sgc-selected" : "") @(idx == _activeIndex ? "sgc-active" : "") @(atMax ? "sgc-disabled" : "")"
                                 role="option"
                                 aria-selected="@(selected ? "true" : "false")"
                                 title="@eiLocal.Description"
                                 @onclick:stopPropagation="true"
                                 @onclick="() => { if(!atMax) ToggleEnumItemAsync(eiLocal); }">
                                <input type="checkbox" checked="@selected" readonly tabindex="-1" style="pointer-events:none;" aria-hidden="true" />
                                <span>@HighlightSearch(eiLocal.Label)</span>
                            </div>
                        }
                        </div>
                    }
                }
                else
                {
                    var filtered = GetFilteredItems().ToList();
                    @if (filtered.Count == 0)
                    {
                        @EmptyOrNoResults()
                    }
                    else
                    {
                        if (ShowSelectAll)
                        {
                            var allFilteredSelected = filtered.All(it => IsSelected(KeySelector(it)));
                            <div class="sgc-select-all" @onclick:stopPropagation="true" @onclick="ToggleSelectAllAsync">
                                <input type="checkbox" checked="@allFilteredSelected" readonly tabindex="-1" style="pointer-events:none;" />
                                <span>@(allFilteredSelected ? Localizer["Common_DeselectAll"] : Localizer["Common_SelectAll"])</span>
                            </div>
                        }
                        var useVs = VirtualScroll && filtered.Count > 100;
                        <div class="sgc-combo-options">
                        @if (useVs)
                        {
                            var itemH = ItemEstimateHeight;
                            var totalH = filtered.Count * itemH;
                            var scrollT = _scrollTop;
                            var viewEst = 320 / itemH + 10;
                            var startIdx = Math.Max(0, (int)(scrollT / itemH) - 5);
                            var endIdx = Math.Min(filtered.Count, startIdx + viewEst);
                            if (startIdx > 0)
                            {
                                <div style="height:@(startIdx * itemH)px" aria-hidden="true"></div>
                            }
                            @for (var i = startIdx; i < endIdx; i++)
                            {
                                var itLocal = filtered[i];
                                var selected = IsSelected(KeySelector(itLocal));
                                var atMax = !selected && MaxSelectable.HasValue && (Values?.Count() ?? 0) >= MaxSelectable.Value;
                                var gIdx = i;
                                <div class="sgc-combo-option @(selected ? "sgc-selected" : "") @(gIdx == _activeIndex ? "sgc-active" : "") @(atMax ? "sgc-disabled" : "")"
                                     role="option"
                                     aria-selected="@(selected ? "true" : "false")"
                                     title="@(OptionTooltipSelector?.Invoke(itLocal) ?? null)"
                                     @onclick:stopPropagation="true"
                                     @onclick="() => { if(!atMax) ToggleItemAsync(KeySelector(itLocal)); }">
                                    <input type="checkbox" checked="@selected" readonly tabindex="-1" style="pointer-events:none;" aria-hidden="true" />
                                    <span>@HighlightSearch(LabelFrom(itLocal))</span>
                                </div>
                            }
                            if (endIdx < filtered.Count)
                            {
                                <div style="height:@((filtered.Count - endIdx) * itemH)px" aria-hidden="true"></div>
                            }
                        }
                        else
                        {
                            @for (int idx = 0; idx < filtered.Count; idx++)
                            {
                                var itLocal = filtered[idx];
                                var selected = IsSelected(KeySelector(itLocal));
                                var atMax = !selected && MaxSelectable.HasValue && (Values?.Count() ?? 0) >= MaxSelectable.Value;
                                <div class="sgc-combo-option @(selected ? "sgc-selected" : "") @(idx == _activeIndex ? "sgc-active" : "") @(atMax ? "sgc-disabled" : "")"
                                     role="option"
                                     aria-selected="@(selected ? "true" : "false")"
                                     title="@(OptionTooltipSelector?.Invoke(itLocal) ?? null)"
                                     @onclick:stopPropagation="true"
                                     @onclick="() => { if(!atMax) ToggleItemAsync(KeySelector(itLocal)); }">
                                    <input type="checkbox" checked="@selected" readonly tabindex="-1" style="pointer-events:none;" aria-hidden="true" />
                                    <span>@HighlightSearch(LabelFrom(itLocal))</span>
                                </div>
                            }
                        }
                        </div>
                    }
                }
                @if (DropdownFooter is not null)
                {
                    <div class="sgc-combo-menu-footer">@DropdownFooter</div>
                }
            </div>
        }
    </div>
    @if (IsInvalid)
    {
        <span id="@_errorId" class="sgc-error">@DisplayedError</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@_hintId" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private readonly string _labelId = "sg-multi-label-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _listboxId = "sg-multi-listbox-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _hintId = "sg-multi-hint-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _errorId = "sg-multi-err-" + Guid.NewGuid().ToString("N")[..8];
    private bool _open;
    private string _search = string.Empty;
    private int _activeIndex;
    private bool _focusInput;
    private bool _loading;
    private double _scrollTop;
    private List<TItem>? _asyncItems;
    private SgEditContextBinder<IEnumerable<TKey>?>? _binder;
    private CancellationTokenSource? _blurCts;
    private CancellationTokenSource? _searchCts;
    private ElementReference _searchInput;
    private ElementReference _comboRef;
    private ElementReference _menuRef;

    private List<SgEnumItem>? _enumItems;
    private Type? _lastEnumType;

    [CascadingParameter] private EditContext? CascadedEditContext { get; set; }

    /// <summary>
    /// Gets or sets the expression that identifies the bound value for EditContext validation.
    /// </summary>
    [Parameter] public Expression<Func<IEnumerable<TKey>?>>? ValueExpression { get; set; }

    /// <summary>
    /// Gets or sets the collection of currently selected keys.
    /// </summary>
    [Parameter] public IEnumerable<TKey>? Values { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the selected keys change.
    /// </summary>
    [Parameter] public EventCallback<IEnumerable<TKey>> ValuesChanged { get; set; }

    /// <summary>
    /// Gets or sets the collection of items to display in the dropdown.
    /// Ignored when <see cref="EnumType"/> is set.
    /// </summary>
    [Parameter] public IEnumerable<TItem> Items { get; set; } = Array.Empty<TItem>();

    /// <summary>
    /// When set, populates the dropdown from the specified enum type instead of
    /// <see cref="Items"/>. Supports <c>[Display]</c> and <c>[Description]</c> attributes.
    /// <para>
    /// When using <c>EnumType</c>, <c>TKey</c> should be <c>string</c> (or <c>int</c>)
    /// and <c>KeySelector</c> / <c>LabelSelector</c> are not required.
    /// </para>
    /// </summary>
    [Parameter] public Type? EnumType { get; set; }

    /// <summary>
    /// Determines whether the enum key is the member <see cref="SgEnumKeyMode.Name"/> (default)
    /// or the underlying <see cref="SgEnumKeyMode.IntValue"/>.
    /// Only relevant when <see cref="EnumType"/> is set.
    /// </summary>
    [Parameter] public SgEnumKeyMode EnumKeyMode { get; set; } = SgEnumKeyMode.Name;

    /// <summary>
    /// Gets or sets the function to extract the key from an item. Required when not using EnumType.
    /// </summary>
    [Parameter] public Func<TItem, TKey> KeySelector { get; set; } = default!;

    /// <summary>
    /// Gets or sets the function to extract display text from each item.
    /// If not specified, uses ToString() on the item (or the enum label when EnumType is set).
    /// </summary>
    [Parameter] public Func<TItem, string>? LabelSelector { get; set; }

    /// <summary>
    /// Gets or sets the placeholder text shown when no items are selected.
    /// </summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>
    /// Gets or sets the text displayed when no items match the search filter.
    /// </summary>
    [Parameter] public string? EmptyText { get; set; }

    /// <summary>
    /// Gets or sets the label text displayed above the multi-select.
    /// </summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// Gets or sets the position of the label. Default is Top.
    /// </summary>
    [Parameter] public SgLabelPosition LabelPosition { get; set; } = SgLabelPosition.Top;

    /// <summary>
    /// Gets or sets the hint text displayed below the multi-select.
    /// </summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>
    /// Gets or sets the error text to display. Takes precedence over validation messages from EditContext.
    /// </summary>
    [Parameter] public string? ErrorText { get; set; }

    /// <summary>
    /// Gets or sets whether a selection is required.
    /// </summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>
    /// Gets or sets whether the multi-select is disabled.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets whether the multi-select should take full width of its container. Default is true.
    /// </summary>
    [Parameter] public bool Block { get; set; } = true;

    /// <summary>
    /// Gets or sets additional CSS class names to apply to the field container.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Size of the multi-select: Sm, Md (default), or Lg.</summary>
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;

    /// <summary>When true, shows a clear-all button when values are selected.</summary>
    [Parameter] public bool AllowClear { get; set; }

    /// <summary>Maximum number of tags to display before showing a "+N more" overflow badge.</summary>
    [Parameter] public int MaxDisplayedTags { get; set; } = 10;

    /// <summary>Whether to automatically focus the search input on first render.</summary>
    [Parameter] public bool AutoFocus { get; set; }

    /// <summary>Debounce delay in milliseconds for search input. Default 300.</summary>
    [Parameter] public int SearchDebounceMs { get; set; } = 300;

    /// <summary>
    /// Gets or sets additional inline CSS styles for the field container.
    /// </summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>
    /// Gets or sets the maximum height of the dropdown menu in CSS units (e.g. "300px", "50vh").
    /// Default is null which uses the CSS default (320px).
    /// </summary>
    [Parameter] public string? DropdownMaxHeight { get; set; }

    /// <summary>
    /// Gets or sets a custom header rendered inside the dropdown before the options list.
    /// </summary>
    [Parameter] public RenderFragment? DropdownHeader { get; set; }

    /// <summary>
    /// Gets or sets a custom footer rendered inside the dropdown after the options list.
    /// </summary>
    [Parameter] public RenderFragment? DropdownFooter { get; set; }

    /// <summary>
    /// Gets or sets a custom template for the empty state (when no items match search).
    /// If not set, the default localized "No matches" text is shown.
    /// </summary>
    [Parameter] public RenderFragment? NoResultsTemplate { get; set; }

    /// <summary>
    /// Gets or sets a custom template for rendering each tag.
    /// The context is the item. When set, replaces the default tag label + remove button.
    /// </summary>
    [Parameter] public RenderFragment<TItem>? TagTemplate { get; set; }

    /// <summary>
    /// Gets or sets the maximum number of items the user can select. Null (default) means unlimited.
    /// </summary>
    [Parameter] public int? MaxSelectable { get; set; }

    /// <summary>
    /// Gets or sets whether to show the "Select All" / "Deselect All" toggle in the dropdown. Default true.
    /// </summary>
    [Parameter] public bool ShowSelectAll { get; set; } = true;

    /// <summary>
    /// When true, the dropdown opens upward instead of downward.
    /// Useful when the select is near the bottom of the viewport.
    /// </summary>
    [Parameter] public bool Dropup { get; set; }

    /// <summary>
    /// When true, enables virtual scrolling for lists with many items (&gt;100).
    /// Only the visible options are rendered, reducing DOM size.
    /// </summary>
    [Parameter] public bool VirtualScroll { get; set; }

    /// <summary>
    /// Estimated height in pixels of each option item. Used by virtual scrolling
    /// to calculate the scrollable range. Default is 28.
    /// </summary>
    [Parameter] public int ItemEstimateHeight { get; set; } = 28;

    /// <summary>
    /// Callback invoked when the search text changes in async search mode.
    /// The callback receives the search string and a cancellation token,
    /// and should return the matching items. When set, client-side filtering
    /// via <see cref="Items"/> is bypassed.
    /// </summary>
    [Parameter] public Func<string, CancellationToken, Task<IEnumerable<TItem>>>? OnSearch { get; set; }

    /// <summary>
    /// When true, renders the dropdown menu with fixed positioning to avoid
    /// overflow / z-index clipping. Requires JS interop. Default is false.
    /// </summary>
    [Parameter] public bool UsePortal { get; set; }

    /// <summary>Text displayed before the tag area inside the trigger.</summary>
    [Parameter] public string? PrefixText { get; set; }

    /// <summary>Text displayed after the tag area inside the trigger.</summary>
    [Parameter] public string? SuffixText { get; set; }

    /// <summary>
    /// When true, the clear button is visible only on hover / focus.
    /// </summary>
    [Parameter] public bool ShowClearOnHover { get; set; }

    /// <summary>
    /// When true, applies compact sizing (smaller padding, font). Use with Size.Sm for best results.
    /// </summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>
    /// When true, the label floats above the trigger when values are selected or the dropdown is open.
    /// </summary>
    [Parameter] public bool FloatingLabel { get; set; }

    /// <summary>
    /// When true, scrolls the dropdown to the first selected item on open.
    /// </summary>
    [Parameter] public bool ScrollToSelected { get; set; }

    /// <summary>
    /// Function that returns a tooltip string for each option item.
    /// Return null for no tooltip.
    /// </summary>
    [Parameter] public Func<TItem, string?>? OptionTooltipSelector { get; set; }

    private string EffectivePlaceholder => Placeholder ?? Localizer["Common_Select"];
    private string EffectiveEmptyText => string.IsNullOrEmpty(EmptyText) ? Localizer["Common_NoMatches"] : EmptyText;

    private bool IsInvalid => !string.IsNullOrEmpty(ErrorText) || (_binder?.HasValidationErrors ?? false);
    private string? DisplayedError => !string.IsNullOrEmpty(ErrorText) 
        ? ErrorText 
        : _binder?.ValidationMessages.FirstOrDefault();
    private string? DescribedBy => IsInvalid ? _errorId : (!string.IsNullOrEmpty(Hint) ? _hintId : null);
    private string LabelFrom(TItem v) => LabelSelector is not null ? LabelSelector(v) : v?.ToString() ?? "";
    private bool HasSelectedValues => Values?.Any() == true;

    private string? SizeClass => Size switch
    {
        SgSize.Sm => "sgc-field-sm",
        SgSize.Lg => "sgc-field-lg",
        SgSize.Xl => "sgc-field-xl",
        _         => null
    };

    // ── Enum support ──────────────────────────────────────────────────────────

    private bool IsEnumMode => _enumItems is not null;

    private RenderFragment EmptyOrNoResults() => __builder =>
    {
        if (NoResultsTemplate is not null)
        {
            __builder.AddContent(0, NoResultsTemplate);
        }
        else
        {
            __builder.OpenElement(0, "div");
            __builder.AddAttribute(1, "class", "sgc-combo-empty");
            __builder.AddAttribute(2, "role", "status");
            __builder.AddContent(3, EffectiveEmptyText);
            __builder.CloseElement();
        }
    };

    protected override void OnInitialized()
    {
        _binder = new SgEditContextBinder<IEnumerable<TKey>?>(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        _binder?.Update(CascadedEditContext, ValueExpression);

        if (EnumType is not null && EnumType != _lastEnumType)
        {
            _lastEnumType = EnumType;
            _enumItems = SgEnumHelper.GetItems(EnumType);
        }
        else if (EnumType is null)
        {
            _enumItems = null;
            _lastEnumType = null;
        }
    }

    // ── Enum key conversion ───────────────────────────────────────────────────

    private TKey EnumItemToKey(SgEnumItem ei)
    {
        var targetType = typeof(TKey);
        var underlying = Nullable.GetUnderlyingType(targetType) ?? targetType;
        try
        {
            if (underlying == typeof(string))
                return (TKey)(object)(EnumKeyMode == SgEnumKeyMode.IntValue
                    ? ei.IntValue.ToString()
                    : ei.Name);
            if (underlying == typeof(int))
                return (TKey)(object)ei.IntValue;
            if (underlying.IsEnum)
                return (TKey)Enum.Parse(underlying, ei.Name);
        }
        catch { }
        return default!;
    }

    private string EnumKeyToString(TKey key)
    {
        if (key is null) return "";
        var str = key.ToString() ?? "";
        var keyType = typeof(TKey);
        if (keyType.IsEnum) return str;
        return str;
    }

    private bool IsEnumItemSelected(SgEnumItem ei)
    {
        if (Values is null) return false;
        var eiKey = EnumKeyMode == SgEnumKeyMode.IntValue
            ? ei.IntValue.ToString()
            : ei.Name;
        foreach (var k in Values)
        {
            var kStr = k?.ToString() ?? "";
            if (kStr == eiKey) return true;
            if (EnumKeyMode == SgEnumKeyMode.Name && int.TryParse(kStr, out var kInt) && kInt == ei.IntValue) return true;
        }
        return false;
    }

    private string EnumItemDisplayLabel(SgEnumItem ei) => ei.Label;

    // ── Filtered items ────────────────────────────────────────────────────────

    private IEnumerable<TItem> GetSelectedItems()
    {
        if (Values is null) yield break;
        var keys = Values.ToHashSet();
        foreach (var it in Items)
            if (keys.Contains(KeySelector(it))) yield return it;
    }

    private IEnumerable<SgEnumItem> GetSelectedEnumItems()
    {
        if (_enumItems is null || Values is null) yield break;
        foreach (var ei in _enumItems)
            if (IsEnumItemSelected(ei)) yield return ei;
    }

    private bool IsSelected(TKey key)
    {
        if (Values is null) return false;
        foreach (var k in Values)
            if (EqualityComparer<TKey>.Default.Equals(k, key)) return true;
        return false;
    }

    private IEnumerable<TItem> GetFilteredItems()
    {
        if (OnSearch is not null) return _asyncItems ?? Enumerable.Empty<TItem>();
        if (string.IsNullOrEmpty(_search)) return Items;
        return Items.Where(i => LabelFrom(i).Contains(_search, StringComparison.CurrentCultureIgnoreCase));
    }

    private IEnumerable<SgEnumItem> GetFilteredEnumItems()
    {
        if (_enumItems is null) return Array.Empty<SgEnumItem>();
        if (string.IsNullOrEmpty(_search)) return _enumItems;
        return _enumItems.Where(ei =>
            ei.Label.Contains(_search, StringComparison.CurrentCultureIgnoreCase) ||
            ei.Name.Contains(_search, StringComparison.CurrentCultureIgnoreCase));
    }

    // ── Toggle / focus ────────────────────────────────────────────────────────

    private async Task ToggleAsync()
    {
        if (Disabled) return;
        _blurCts?.Cancel();
        _open = !_open;
        if (_open)
        {
            _search = string.Empty;
            _activeIndex = 0;
            _scrollTop = 0;
            _focusInput = true;
        }
        await InvokeAsync(StateHasChanged);
    }

    private void HandleInputFocus()
    {
        _blurCts?.Cancel();
    }

    private async Task HandleFocusOutAsync(FocusEventArgs e)
    {
        _blurCts?.Cancel();
        _blurCts = new CancellationTokenSource();
        var token = _blurCts.Token;
        try
        {
            await Task.Delay(200, token);
            _open = false;
            _asyncItems = null;
            _activeIndex = 0;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
    }

    // ── Search ────────────────────────────────────────────────────────────────

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _blurCts?.Cancel();
        _search = e.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        var currentSearch = _search;
        try
        {
            await Task.Delay(SearchDebounceMs, token);
            if (!token.IsCancellationRequested)
            {
                _search = currentSearch;

                if (OnSearch is not null && !IsEnumMode)
                {
                    _loading = true;
                    _asyncItems = null;
                    await InvokeAsync(StateHasChanged);
                    try
                    {
                        var results = await OnSearch(_search, token);
                        if (!token.IsCancellationRequested)
                        {
                            _asyncItems = results.ToList();
                        }
                    }
                    catch (OperationCanceledException) { }
                    catch (Exception ex)
                    {
                        Console.Error.WriteLine($"[SgMultiSelect] OnSearch failed: {ex.Message}");
                    }
                    finally
                    {
                        if (!token.IsCancellationRequested)
                        {
                            _loading = false;
                        }
                    }
                }

                _activeIndex = 0;
                _scrollTop = 0;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { }
    }

    // ── Scroll (virtual) ──────────────────────────────────────────────────────

    private async Task OnMenuScrollAsync()
    {
        if (!VirtualScroll) return;
        try
        {
            var st = await JS.InvokeAsync<double>("eval", $"document.getElementById('{_listboxId}')?.scrollTop ?? 0");
            _scrollTop = st;
        }
        catch { }
    }

    private void OnMenuScroll(EventArgs e)
    {
        _ = OnMenuScrollAsync();
    }

    // ── Keyboard ──────────────────────────────────────────────────────────────

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                _open = false;
                await InvokeAsync(StateHasChanged);
                break;
            case "ArrowDown":
                if (!_open) { _open = true; await InvokeAsync(StateHasChanged); return; }
            {
                var count = IsEnumMode ? GetFilteredEnumItems().Count() : GetFilteredItems().Count();
                _activeIndex = Math.Min(count - 1, _activeIndex + 1);
                await InvokeAsync(StateHasChanged);
            }
                break;
            case "ArrowUp":
                if (_activeIndex > 0) _activeIndex--;
                await InvokeAsync(StateHasChanged);
                break;
            case "Enter":
                if (_open)
                {
                    if (IsEnumMode)
                    {
                        var enumItems = GetFilteredEnumItems().ToList();
                        if (_activeIndex >= 0 && _activeIndex < enumItems.Count)
                            await ToggleEnumItemAsync(enumItems[_activeIndex]);
                    }
                    else
                    {
                        var items = GetFilteredItems().ToList();
                        if (_activeIndex >= 0 && _activeIndex < items.Count)
                            await ToggleItemAsync(KeySelector(items[_activeIndex]));
                    }
                }
                break;
        }
    }

    // ── Toggle item ───────────────────────────────────────────────────────────

    private async Task ToggleItemAsync(TKey key)
    {
        var list = Values?.ToList() ?? new List<TKey>();
        var idx = list.FindIndex(k => EqualityComparer<TKey>.Default.Equals(k, key));
        if (idx >= 0) list.RemoveAt(idx);
        else
        {
            if (MaxSelectable.HasValue && list.Count >= MaxSelectable.Value) return;
            list.Add(key);
        }
        if (ValuesChanged.HasDelegate) await ValuesChanged.InvokeAsync(list);
        _binder?.NotifyFieldChanged();
        _focusInput = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleEnumItemAsync(SgEnumItem ei)
    {
        var key = EnumItemToKey(ei);
        await ToggleItemAsync(key);
    }

    private async Task RemoveAsync(TKey key)
    {
        var list = Values?.ToList() ?? new List<TKey>();
        list.RemoveAll(k => EqualityComparer<TKey>.Default.Equals(k, key));
        if (ValuesChanged.HasDelegate) await ValuesChanged.InvokeAsync(list);
        _binder?.NotifyFieldChanged();
        _focusInput = _open;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveEnumItemAsync(SgEnumItem ei)
    {
        var key = EnumItemToKey(ei);
        await RemoveAsync(key);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AutoFocus && _open)
        {
            await _searchInput.FocusAsync();
        }
        if (_focusInput)
        {
            _focusInput = false;
            await _searchInput.FocusAsync();
        }
        if (_open)
        {
            if (ScrollToSelected)
            {
                try
                {
                    await JS.InvokeVoidAsync("eval",
                        $"(function(){{var m=document.getElementById('{_listboxId}');if(!m)return;var s=m.querySelector('.sgc-selected');if(s){{var oh=s.offsetTop-m.offsetTop;m.scrollTop=oh-60;}}}})()");
                }
                catch { }
            }
            if (VirtualScroll && _scrollTop > 0)
            {
                try
                {
                    await JS.InvokeVoidAsync("eval", $"document.getElementById('{_listboxId}')?.scrollTo(0, {_scrollTop})");
                }
                catch { }
            }
            if (UsePortal)
            {
                try
                {
                    await JS.InvokeVoidAsync("eval",
                        $"(function(){{var m=document.getElementById('{_listboxId}'),t=document.querySelector('[aria-labelledby={_labelId}]')?.querySelector('.sgc-combo-control');if(!m||!t)return;var r=t.getBoundingClientRect();m.style.position='fixed';m.style.top=(r.bottom+2)+'px';m.style.left=r.left+'px';m.style.width=Math.max(r.width,160)+'px';m.style.minWidth=m.style.width;m.style.maxWidth=Math.min(800,innerWidth-r.left-8)+'px';}})()");
                }
                catch { }
            }
        }
        else if (UsePortal)
        {
            try
            {
                await JS.InvokeVoidAsync("eval",
                    $"(function(){{var m=document.getElementById('{_listboxId}');if(m){{m.style.position='';m.style.top='';m.style.left='';m.style.width='';m.style.minWidth='';m.style.maxWidth='';}}}})()");
            }
            catch { }
        }
    }

    private async Task ClearAllAsync()
    {
        if (Disabled) return;
        if (ValuesChanged.HasDelegate) await ValuesChanged.InvokeAsync(Array.Empty<TKey>());
        _binder?.NotifyFieldChanged();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleSelectAllAsync()
    {
        var filtered = GetFilteredItems().ToList();
        var allSelected = filtered.All(it => IsSelected(KeySelector(it)));
        var list = Values?.ToList() ?? new List<TKey>();
        if (allSelected)
        {
            var removeKeys = filtered.Select(it => KeySelector(it)).ToHashSet();
            list.RemoveAll(k => removeKeys.Contains(k));
        }
        else
        {
            foreach (var it in filtered)
            {
                var key = KeySelector(it);
                if (!list.Contains(key))
                {
                    if (MaxSelectable.HasValue && list.Count >= MaxSelectable.Value) break;
                    list.Add(key);
                }
            }
        }
        if (ValuesChanged.HasDelegate) await ValuesChanged.InvokeAsync(list);
        _binder?.NotifyFieldChanged();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleSelectAllEnumAsync()
    {
        var filtered = GetFilteredEnumItems().ToList();
        var allSelected = filtered.All(ei => IsEnumItemSelected(ei));
        var list = Values?.ToList() ?? new List<TKey>();
        if (allSelected)
        {
            foreach (var ei in filtered)
            {
                var key = EnumItemToKey(ei);
                list.RemoveAll(k => EqualityComparer<TKey>.Default.Equals(k, key));
            }
        }
        else
        {
            foreach (var ei in filtered)
            {
                var key = EnumItemToKey(ei);
                if (!list.Any(k => EqualityComparer<TKey>.Default.Equals(k, key)))
                {
                    if (MaxSelectable.HasValue && list.Count >= MaxSelectable.Value) break;
                    list.Add(key);
                }
            }
        }
        if (ValuesChanged.HasDelegate) await ValuesChanged.InvokeAsync(list);
        _binder?.NotifyFieldChanged();
        await InvokeAsync(StateHasChanged);
    }

    private RenderFragment HighlightSearch(string text) => __builder =>
    {
        if (string.IsNullOrEmpty(_search) || text is null)
        {
            __builder.AddContent(0, text);
            return;
        }
        var idx = text.IndexOf(_search, StringComparison.CurrentCultureIgnoreCase);
        if (idx < 0)
        {
            __builder.AddContent(0, text);
            return;
        }
        __builder.AddContent(0, text[..idx]);
        __builder.AddMarkupContent(1, $"<mark>{text.Substring(idx, _search.Length)}</mark>");
        __builder.AddContent(2, text[(idx + _search.Length)..]);
    };

    public void Dispose()
    {
        _blurCts?.Cancel();
        _blurCts?.Dispose();
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _binder?.Dispose();
    }
}
