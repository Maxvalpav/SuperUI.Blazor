@namespace SuperUI.Components
@using SuperUI.Enums
@inherits SgComponentBase

<div class="@Css("sgc-btn-group").AddClass(OrientationClass).AddClass("sgc-btn-group-attached", Attached).AddClass("sgc-btn-group-radio", Radio).Build()"
     role="@(Radio ? "radiogroup" : "group")"
     style="@(Justify.HasValue ? $"justify-content:{Justify.Value.ToString().ToLowerInvariant()}" : null)"
     @attributes="AttributesWithoutClassAndStyle">
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@code {
    /// <summary>
    /// Gets or sets the buttons to be rendered within the group.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the orientation of the button group. Default is <see cref="SgOrientation.Horizontal"/>.
    /// </summary>
    [Parameter] public SgOrientation Orientation { get; set; } = SgOrientation.Horizontal;

    /// <summary>
    /// Gets or sets the size for all buttons in the group.
    /// </summary>
    [Parameter] public SgSize? Size { get; set; }

    /// <summary>
    /// Gets or sets the visual variant for all buttons in the group.
    /// </summary>
    [Parameter] public SgButtonVariant? Variant { get; set; }

    /// <summary>
    /// Gets or sets the horizontal distribution of buttons within the group.
    /// </summary>
    [Parameter] public SgJustifyContent? Justify { get; set; }

    /// <summary>
    /// Gets or sets whether buttons are attached seamlessly (no gap, merged borders).
    /// </summary>
    [Parameter] public bool Attached { get; set; }

    /// <summary>
    /// Gets or sets whether the group acts as a radio button group (single selection).
    /// Buttons should use <see cref="SgButton.IsToggle"/> and manage <see cref="SgButton.Pressed"/> individually.
    /// </summary>
    [Parameter] public bool Radio { get; set; }

    private string OrientationClass => Orientation == SgOrientation.Vertical ? "sgc-vertical" : "sgc-horizontal";
}
