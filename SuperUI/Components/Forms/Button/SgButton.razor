@namespace SuperUI.Components
@inherits SgComponentBase

@if (!string.IsNullOrEmpty(Href) && !Disabled)
{
    <a href="@Href"
       target="@Target"
       rel="@Rel"
       class="@(Css("sgc-btn").AddClass(VariantClass).AddClass(SizeClass)
                  .AddClass("sgc-block", Block)
                  .AddClass("sgc-pressed", IsToggle && Pressed)
                  .AddClass("sgc-active", Active)
                  .AddClass("sgc-glow", Glow)
                  .AddClass("sgc-pulse", Pulse)
                  .AddClass("sgc-debouncing", _isDebouncing)
                  .AddClass("sgc-glass", Glass)
                  .AddClass("sgc-has-progress", HasProgress)
                  .Build())"
       title="@Title"
       @onclick="OnClickAsync"
       aria-pressed="@(IsToggle ? (Pressed ? "true" : "false") : null)"
       aria-disabled="@(Disabled ? "true" : null)"
       aria-busy="@(Loading ? "true" : "false")"
       aria-label="@(string.IsNullOrEmpty(Text) ? Title : Text)"
       @attributes="AttributesWithoutClassAndStyle">
        <span class="sgc-ripple"></span>
        @if (HasProgress && ProgressType == SgButtonProgressType.Bar) { <span class="sgc-btn-progress-fill" style="width:@(Progress)%"></span> }
        @RenderContent
    </a>
}
else
{
    <button type="@Type.ToString().ToLowerInvariant()"
            class="@(Css("sgc-btn").AddClass(VariantClass).AddClass(SizeClass)
                       .AddClass("sgc-block", Block)
                       .AddClass("sgc-pressed", IsToggle && Pressed)
                       .AddClass("sgc-active", Active)
                       .AddClass("sgc-glow", Glow)
                       .AddClass("sgc-pulse", Pulse)
                       .AddClass("sgc-debouncing", _isDebouncing)
                       .AddClass("sgc-glass", Glass)
                       .AddClass("sgc-has-progress", HasProgress)
                       .Build())"
            disabled="@(Disabled || Loading || _isDebouncing || _countdownActive || _dangerConfirmActive)"
            title="@(_dangerConfirmActive ? _confirmText : Title)"
            @onclick="OnClickAsync"
            aria-pressed="@(IsToggle ? (Pressed ? "true" : "false") : null)"
            aria-disabled="@(Disabled ? "true" : null)"
            aria-busy="@(Loading ? "true" : "false")"
            aria-label="@(string.IsNullOrEmpty(Text) ? Title : Text)"
            @attributes="AttributesWithoutClassAndStyle">
        <span class="sgc-ripple"></span>
        @if (HasProgress && ProgressType == SgButtonProgressType.Bar) { <span class="sgc-btn-progress-fill" style="width:@(Progress)%"></span> }
        @RenderContent
    </button>
}

@code {
    private bool _isDebouncing;
    private readonly SgDebouncer _debouncer = new();
    private bool _dangerConfirmActive;
    private bool _countdownActive;
    private int _countdownValue;
    private CancellationTokenSource? _countdownCts;
    private string? _confirmText;
    private CancellationTokenSource? _dangerConfirmCts;

    [CascadingParameter] public SgButtonGroup? ButtonGroup { get; set; }

    /// <summary>
    /// Gets or sets the button text content.
    /// </summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>
    /// Gets or sets the custom content to render inside the button.
    /// Takes precedence over <see cref="Text"/>.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the icon to display before the button text.
    /// </summary>
    [Parameter] public RenderFragment? Icon { get; set; }

    /// <summary>
    /// Gets or sets the HTML button type. Default is <see cref="SgButtonType.Button"/>.
    /// </summary>
    [Parameter] public SgButtonType Type { get; set; } = SgButtonType.Button;

    /// <summary>
    /// Gets or sets the button visual variant. Default is <see cref="SgButtonVariant.Default"/>.
    /// </summary>
    [Parameter] public SgButtonVariant? Variant { get; set; }

    /// <summary>
    /// Gets or sets the button size. Default is <see cref="SgSize.Md"/>.
    /// </summary>
    [Parameter] public SgSize? Size { get; set; }

    /// <summary>
    /// Gets or sets whether the button is disabled.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets whether the button is in loading state (shows spinner).
    /// </summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>
    /// Gets or sets whether the button should take full width of its container.
    /// </summary>
    [Parameter] public bool Block { get; set; }

    /// <summary>
    /// Gets or sets the tooltip text shown on hover.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// Gets or sets whether the button is in a toggle state.
    /// </summary>
    [Parameter] public bool IsToggle { get; set; }

    /// <summary>
    /// Gets or sets the pressed state for toggle buttons (two-way binding).
    /// </summary>
    [Parameter] public bool Pressed { get; set; }

    /// <summary>
    /// Callback invoked when the pressed state changes.
    /// </summary>
    [Parameter] public EventCallback<bool> PressedChanged { get; set; }

    /// <summary>
    /// Gets or sets the debounce interval in milliseconds. Default is 300ms. Set to 0 to disable.
    /// </summary>
    [Parameter] public int DebounceInterval { get; set; } = 300;

    /// <summary>
    /// Gets or sets the callback invoked when the button is clicked.
    /// </summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>
    /// Gets or sets the URL for link mode. When set, renders as an anchor tag instead of a button.
    /// </summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>
    /// Gets or sets the link target attribute (e.g., "_blank"). Only used when <see cref="Href"/> is set.
    /// </summary>
    [Parameter] public string? Target { get; set; }

    /// <summary>
    /// Gets or sets the link rel attribute. Only used when <see cref="Href"/> is set.
    /// </summary>
    [Parameter] public string? Rel { get; set; }

    /// <summary>
    /// Gets or sets whether the button is in an active/selected visual state.
    /// </summary>
    [Parameter] public bool Active { get; set; }

    /// <summary>
    /// Gets or sets whether to show a glowing neon effect (works best with primary/success/danger variants).
    /// </summary>
    [Parameter] public bool Glow { get; set; }

    /// <summary>
    /// Gets or sets whether to show a pulsing animation to draw attention.
    /// </summary>
    [Parameter] public bool Pulse { get; set; }

    /// <summary>
    /// Gets or sets whether to render with a glass-morphism effect.
    /// </summary>
    [Parameter] public bool Glass { get; set; }

    /// <summary>
    /// Gets or sets the icon shown on the right side of the button text.
    /// </summary>
    [Parameter] public RenderFragment? IconRight { get; set; }

    /// <summary>
    /// Gets or sets the position of the loading spinner as a strongly-typed enum.
    /// Preferred over the string-based <see cref="LoadingPosition"/>.
    /// </summary>
    [Parameter] public SgButtonLoadingPosition? LoadingPositionEnum { get; set; }

    /// <summary>
    /// Gets or sets the position of the loading spinner. "left", "right", or "center".
    /// When "center", icon and text are hidden during loading.
    /// Prefer <see cref="LoadingPositionEnum"/> for type-safe usage.
    /// </summary>
    [Parameter] public string LoadingPosition { get; set; } = "center";

    /// <summary>
    /// Gets or sets the confirmation text for two-step danger confirmation.
    /// When set, the first click shows this text, second click fires <see cref="OnClick"/>.
    /// </summary>
    [Parameter] public string? ConfirmText { get; set; }

    /// <summary>
    /// Gets or sets the countdown duration in seconds when the button is clicked.
    /// The button is disabled during the countdown.
    /// </summary>
    [Parameter] public int Countdown { get; set; }

    /// <summary>
    /// Gets or sets the progress value (0–100). Set to a value &gt;= 0 to show a progress fill inside the button.
    /// When used with <see cref="Loading"/>, shows a spinner + percentage. Set to 100 to show completion state.
    /// </summary>
    [Parameter] public int Progress { get; set; } = -1;

    /// <summary>
    /// Gets or sets the progress visual type. <see cref="SgButtonProgressType.Bar"/> shows a horizontal fill bar;
    /// <see cref="SgButtonProgressType.Ring"/> shows a small circular SVG ring. Default is <see cref="SgButtonProgressType.Bar"/>.
    /// </summary>
    [Parameter] public SgButtonProgressType ProgressType { get; set; } = SgButtonProgressType.Bar;

    /// <summary>
    /// Gets or sets the spinner animation type shown inside the button during loading progress.
    /// Supported values: <see cref="SgSpinnerType.Border"/> (default), <see cref="SgSpinnerType.Pulse"/>.
    /// When <c>null</c>, falls back to <see cref="SgSpinnerType.Border"/>.
    /// </summary>
    [Parameter] public SgSpinnerType? ProgressSpinnerType { get; set; }

    private bool HasProgress => Progress >= 0;

    private SgButtonVariant ActualVariant => Variant ?? ButtonGroup?.Variant ?? SgButtonVariant.Default;
    private SgSize ActualSize => Size ?? ButtonGroup?.Size ?? SgSize.Md;

    private string VariantClass => ActualVariant switch
    {
        SgButtonVariant.Primary  => "sgc-btn-primary",
        SgButtonVariant.Danger   => "sgc-btn-danger",
        SgButtonVariant.Success  => "sgc-btn-success",
        SgButtonVariant.Ghost    => "sgc-btn-ghost",
        SgButtonVariant.Outlined => "sgc-outlined",
        SgButtonVariant.Dashed   => "sgc-dashed",
        _                        => ""
    };
    private string SizeClass => ActualSize switch
    {
        SgSize.Sm => "sgc-sm",
        SgSize.Lg => "sgc-lg",
        _         => ""
    };

    private bool ShowSpinnerLeft => Loading && ResolvedLoadingPosition == SgButtonLoadingPosition.Left;
    private bool ShowSpinnerRight => Loading && ResolvedLoadingPosition == SgButtonLoadingPosition.Right;
    private bool ShowSpinnerCenter => Loading && ResolvedLoadingPosition == SgButtonLoadingPosition.Center;

    private SgButtonLoadingPosition ResolvedLoadingPosition
    {
        get
        {
            if (LoadingPositionEnum.HasValue) return LoadingPositionEnum.Value;
            if (string.IsNullOrEmpty(LoadingPosition)) return SgButtonLoadingPosition.Center;
            return LoadingPosition.ToLowerInvariant() switch
            {
                "left" => SgButtonLoadingPosition.Left,
                "right" => SgButtonLoadingPosition.Right,
                _ => SgButtonLoadingPosition.Center
            };
        }
    }

    private async Task OnClickAsync(MouseEventArgs e)
    {
        if (Disabled || Loading || _isDebouncing || _countdownActive) return;

        if (DebounceInterval > 0)
        {
            _isDebouncing = true;
            StateHasChanged();
        }

        // Danger confirm flow
        if (!string.IsNullOrEmpty(ConfirmText) && !_dangerConfirmActive)
        {
            _dangerConfirmActive = true;
            _confirmText = ConfirmText;
            _dangerConfirmCts?.Cancel();
            _dangerConfirmCts?.Dispose();
            _dangerConfirmCts = new CancellationTokenSource();
            StateHasChanged();
            try
            {
                await Task.Delay(3000, _dangerConfirmCts.Token);
            }
            catch (TaskCanceledException) { return; }
            _dangerConfirmActive = false;
            StateHasChanged();
            if (DebounceInterval > 0)
            {
                await _debouncer.RunAsync(
                    _ => { _isDebouncing = false; return InvokeAsync(StateHasChanged); },
                    TimeSpan.FromMilliseconds(DebounceInterval));
            }
            return;
        }
        _dangerConfirmActive = false;

        // Countdown
        if (Countdown > 0)
        {
            _countdownActive = true;
            _countdownValue = Countdown;
            _countdownCts?.Cancel();
            _countdownCts = new CancellationTokenSource();
            StateHasChanged();
            _ = CountdownLoopAsync(_countdownCts.Token);
        }

        if (IsToggle)
        {
            Pressed = !Pressed;
            if (PressedChanged.HasDelegate)
                await PressedChanged.InvokeAsync(Pressed);
        }

        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(e);

        if (DebounceInterval > 0)
        {
            await _debouncer.RunAsync(
                _ => { _isDebouncing = false; return InvokeAsync(StateHasChanged); },
                TimeSpan.FromMilliseconds(DebounceInterval));
        }
    }

    private async Task CountdownLoopAsync(CancellationToken ct)
    {
        while (_countdownValue > 0 && !ct.IsCancellationRequested)
        {
            await Task.Delay(1000, ct);
            if (ct.IsCancellationRequested) return;
            _countdownValue--;
            await InvokeAsync(StateHasChanged);
        }
        _countdownActive = false;
        await InvokeAsync(StateHasChanged);
    }

    public override async ValueTask DisposeAsync()
    {
        _dangerConfirmCts?.Cancel();
        _dangerConfirmCts?.Dispose();
        _countdownCts?.Cancel();
        _countdownCts?.Dispose();
        await _debouncer.DisposeAsync();
    }
}


