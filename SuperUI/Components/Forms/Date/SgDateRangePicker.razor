@namespace SuperUI.Components
@using System.Linq.Expressions
@using SuperUI.Localization
@inject IJSRuntime JS

<div class="sgc-field @(Block ? "sgc-block" : "") @CssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label id="@_labelId" class="sgc-label @(Required ? "sgc-required" : "")">@Label</label>
    }
    <div class="sgc-date @(_open ? "sgc-open" : "") @(Disabled ? "sgc-disabled" : "") @(ReadOnly ? "sgc-readonly" : "") @(IsInvalid ? "sgc-invalid" : "") sgc-size-@Size.ToString().ToLowerInvariant()"
         data-sgdrp="@_uid"
         role="combobox"
         aria-expanded="@(_open ? "true" : "false")"
         aria-haspopup="dialog"
         aria-labelledby="@_labelId"
         aria-required="@(Required ? "true" : null)"
         aria-disabled="@(Disabled ? "true" : null)"
         aria-controls="@_popupId"
         tabindex="@(Disabled ? "-1" : "0")"
         @onfocusout="HandleFocusOutAsync"
         @onclick:stopPropagation="true">
        <div class="sgc-date-control" @onclick="ToggleAsync">
            @if (HasRange)
            {
                <span class="sgc-date-value">@RangeText</span>
            }
            else
            {
                <span class="sgc-date-placeholder">
                    @if (HasPartialRange)
                    {
                        @PartialRangeText
                    }
                    else
                    {
                        @(string.IsNullOrEmpty(Placeholder) ? $"{EffectiveStartPlaceholder} - {EffectiveEndPlaceholder}" : Placeholder)
                    }
                </span>
            }
            @if (AllowClear && (HasRange || HasPartialRange) && !Disabled)
            {
                <button class="sgc-combo-clear" type="button"
                        @onclick:stopPropagation="true"
                        @onclick="ClearAsync" title="@ClearLabel">
                    <svg viewBox="0 0 16 16" width="10" height="10" fill="currentColor" aria-hidden="true">
                        <path d="M3.72 3.72a.75.75 0 011.06 0L8 6.94l3.22-3.22a.75.75 0 111.06 1.06L9.06 8l3.22 3.22a.75.75 0 11-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 01-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 010-1.06z"/>
                    </svg>
                </button>
            }
            <span class="sgc-date-caret" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
                    <path d="M11 1a1 1 0 0 0-1 1v1H6V2a1 1 0 0 0-2 0v1H3a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2h-1V2a1 1 0 0 0-1-1zM3 6h10v7H3V6z"/>
                </svg>
            </span>
        </div>
        @if (_open)
        {
            <div id="@_popupId" class="sgc-date-popup sgc-date-range-popup" role="dialog" aria-modal="false">
                <div class="sgc-date-head">
                    <button class="sgc-date-nav" type="button" @onclick="() => Shift(-1)">‹</button>
                    <span class="sgc-date-title">@_view.ToString("MMMM yyyy", System.Globalization.CultureInfo.CurrentCulture)</span>
                    <button class="sgc-date-nav" type="button" @onclick="() => Shift(1)">›</button>
                </div>
                <div class="sgc-date-grid">
                    @for (var i = 0; i < 7; i++)
                    {
                        var dow = ((int)EffectiveFirstDayOfWeek + i) % 7;
                        <div class="sgc-date-dow">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.AbbreviatedDayNames[dow]</div>
                    }
                    @foreach (var d in BuildGrid())
                    {
                        var dl = d;
                        var inMonth = dl.Month == _view.Month;
                        var isToday = dl.Date == DateTime.Today;
                        var isStart = StartValue.HasValue && dl.Date == StartValue.Value.Date;
                        var isEnd = EndValue.HasValue && dl.Date == EndValue.Value.Date;
                        var inRange = IsInRange(dl);
                        var disabled = IsDisabled(dl);
                        var exceedsRange = IsDateRangeExceeded(dl);
                        <button type="button"
                                class="sgc-date-cell @(inMonth ? "" : "sgc-out") @(isToday ? "sgc-today" : "") @(isStart ? "sgc-range-start" : "") @(isEnd ? "sgc-range-end" : "") @(inRange ? "sgc-in-range" : "") @(disabled ? "sgc-date-disabled" : "") @(exceedsRange ? "sgc-range-exceeded" : "") @(isStart || isEnd ? "sgc-selected" : "")"
                                disabled="@(disabled || exceedsRange || ReadOnly)"
                                @onclick="() => PickAsync(dl)">@dl.Day</button>
                    }
                </div>
                <div class="sgc-date-range-meta">
                    <span>@SelectionHint</span>
                    @if (HasRange)
                    {
                        <span>@DaysCountText</span>
                    }
                    @if (IsRangeInvalid)
                    {
                        <span class="sgc-range-warning">@Localizer["DateRangeInvalid"]</span>
                    }
                </div>
<div class="sgc-date-foot">
                     <button class="sgc-btn sgc-sm" type="button" @onclick="SetTodayAsync">@Localizer["Today"]</button>
                     <button class="sgc-btn sgc-sm" type="button" @onclick="SetCurrentMonthAsync">@Localizer["DataGrid_DateThisMonth"]</button>
                     @if (AllowClear)
                     {
                         <button class="sgc-btn sgc-sm sgc-ghost" type="button" @onclick="ClearAsync">@Localizer["Clear"]</button>
                     }
                 </div>
            </div>
        }
    </div>
    @if (IsInvalid)
    {
        <span class="sgc-error">@DisplayedError</span>
    }
    else if (IsRangeInvalid)
    {
        <span class="sgc-error">@Localizer["DateRangeInvalid"]</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private readonly string _labelId = "sg-daterange-label-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _popupId = "sg-daterange-popup-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _uid     = Guid.NewGuid().ToString("N")[..8];
    private bool _open;
    private DateTime _view = DateTime.Today;

    private SgEditContextBinder<DateTime?>? _startBinder;
    private SgEditContextBinder<DateTime?>? _endBinder;

    [CascadingParameter] private EditContext? CascadedEditContext { get; set; }

    /// <summary>
    /// Gets or sets the start date of the selected range.
    /// </summary>
    [Parameter] public DateTime? StartValue { get; set; }
    
    /// <summary>
    /// Gets or sets the callback invoked when the start date changes.
    /// </summary>
    [Parameter] public EventCallback<DateTime?> StartValueChanged { get; set; }
    
    /// <summary>
    /// Gets or sets the end date of the selected range.
    /// </summary>
    [Parameter] public DateTime? EndValue { get; set; }
    
    /// <summary>
    /// Gets or sets the callback invoked when the end date changes.
    /// </summary>
    [Parameter] public EventCallback<DateTime?> EndValueChanged { get; set; }
    
    /// <summary>
    /// Gets or sets the expression identifying the start value for validation.
    /// </summary>
    [Parameter] public Expression<Func<DateTime?>>? StartValueExpression { get; set; }
    
    /// <summary>
    /// Gets or sets the expression identifying the end value for validation.
    /// </summary>
    [Parameter] public Expression<Func<DateTime?>>? EndValueExpression { get; set; }
    
    /// <summary>
    /// Gets or sets the date format string for displaying the selected range.
    /// Default is "d" (short date pattern).
    /// </summary>
    [Parameter] public string Format { get; set; } = "d";
    
    /// <summary>
    /// Gets or sets the placeholder text displayed when no range is selected.
    /// If not set, uses the localized resource key "DateRangePlaceholder".
    /// </summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>
    /// Gets or sets the placeholder for the start date.
    /// If not set, uses the localized resource key "DateRangeStartPlaceholder".
    /// </summary>
    [Parameter] public string? StartPlaceholder { get; set; }

    /// <summary>
    /// Gets or sets the placeholder for the end date.
    /// If not set, uses the localized resource key "DateRangeEndPlaceholder".
    /// </summary>
    [Parameter] public string? EndPlaceholder { get; set; }
    
    /// <summary>
    /// Gets or sets the label text displayed above the date range picker.
    /// </summary>
    [Parameter] public string? Label { get; set; }
    
    /// <summary>
    /// Gets or sets the hint text displayed below the date range picker.
    /// </summary>
    [Parameter] public string? Hint { get; set; }
    
    /// <summary>
    /// Gets or sets whether the clear button is displayed when a range is selected.
    /// Default is true.
    /// </summary>
    [Parameter] public bool AllowClear { get; set; } = true;
    
    /// <summary>
    /// Gets or sets whether the field is marked as required with a visual indicator.
    /// </summary>
    [Parameter] public bool Required { get; set; }
    
    /// <summary>
    /// Gets or sets whether the date range picker is disabled.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }
    
    /// <summary>
    /// Gets or sets whether the date range picker is read-only (popup visible but no selection).
    /// </summary>
    [Parameter] public bool ReadOnly { get; set; }
    
    /// <summary>
    /// Gets or sets whether the date range picker takes the full width of its container.
    /// Default is true.
    /// </summary>
    [Parameter] public bool Block { get; set; } = true;
    
    /// <summary>
    /// Gets or sets the minimum selectable date. Dates before this are disabled.
    /// </summary>
    [Parameter] public DateTime? Min { get; set; }
    
    /// <summary>
    /// Gets or sets the maximum selectable date. Dates after this are disabled.
    /// </summary>
    [Parameter] public DateTime? Max { get; set; }
    
    /// <summary>
    /// Gets or sets the size of the component.
    /// </summary>
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;
    
    /// <summary>
    /// Gets or sets the maximum allowed range duration.
    /// Dates beyond this range from the start date are disabled.
    /// </summary>
    [Parameter] public TimeSpan? MaxDateRange { get; set; }
    
    /// <summary>
    /// Gets or sets the minimum allowed range duration.
    /// Ranges shorter than this show a warning.
    /// </summary>
    [Parameter] public TimeSpan? MinDateRange { get; set; }
    
    /// <summary>
    /// Gets or sets a callback to determine if a specific date is disabled.
    /// </summary>
    [Parameter] public Func<DateTime, bool>? DisabledDate { get; set; }
    
    /// <summary>
    /// Gets or sets the first day of the week.
    /// When null, uses the current culture's default.
    /// </summary>
    [Parameter] public DayOfWeek? FirstDayOfWeek { get; set; }
    
    /// <summary>
    /// Gets or sets additional CSS classes to apply to the component.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Gets or sets the error text to display below the date range picker.
    /// </summary>
    [Parameter] public string? ErrorText { get; set; }

    [Inject] private ISuperUILocalizer Localizer { get; set; } = default!;

    private string ClearLabel => Localizer["DateRangeClear"];
    private string DefaultPlaceholder => Localizer["DateRangePlaceholder"];
    private string DefaultStartPlaceholder => Localizer["DateRangeStartPlaceholder"];
    private string DefaultEndPlaceholder => Localizer["DateRangeEndPlaceholder"];

    private bool HasRange => StartValue.HasValue && EndValue.HasValue;
    private bool HasPartialRange => StartValue.HasValue && !EndValue.HasValue;
    private string RangeText => $"{StartValue!.Value.ToString(Format, System.Globalization.CultureInfo.CurrentCulture)} - {EndValue!.Value.ToString(Format, System.Globalization.CultureInfo.CurrentCulture)}";
    private string PartialRangeText => $"{StartValue!.Value.ToString(Format, System.Globalization.CultureInfo.CurrentCulture)} - ...";
    private string SelectionHint => HasRange
        ? Localizer["DateRangeSelected"]
        : HasPartialRange
            ? Localizer["DateRangeSelectEnd"]
            : Localizer["DateRangeSelectStart"];
    private string DaysCountText => $"{(EndValue!.Value.Date - StartValue!.Value.Date).Days + 1} {Localizer["Days"]}.";
    
    private string EffectivePlaceholder => Placeholder ?? DefaultPlaceholder;
    private string EffectiveStartPlaceholder => StartPlaceholder ?? DefaultStartPlaceholder;
    private string EffectiveEndPlaceholder => EndPlaceholder ?? DefaultEndPlaceholder;
    
    private DayOfWeek EffectiveFirstDayOfWeek => FirstDayOfWeek ?? System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.FirstDayOfWeek;

    private bool IsInvalid => !string.IsNullOrEmpty(ErrorText) || (_startBinder?.HasValidationErrors ?? false) || (_endBinder?.HasValidationErrors ?? false);
    private string? DisplayedError
    {
        get
        {
            if (!string.IsNullOrEmpty(ErrorText)) return ErrorText;
            var startErrors = _startBinder?.ValidationMessages ?? Enumerable.Empty<string>();
            var endErrors = _endBinder?.ValidationMessages ?? Enumerable.Empty<string>();
            return startErrors.Concat(endErrors).FirstOrDefault();
        }
    }

    private bool IsRangeInvalid
    {
        get
        {
            if (!HasRange) return false;
            if (MaxDateRange.HasValue && (EndValue!.Value.Date - StartValue!.Value.Date) > MaxDateRange.Value) return true;
            if (MinDateRange.HasValue && (EndValue!.Value.Date - StartValue!.Value.Date) < MinDateRange.Value) return true;
            return false;
        }
    }

    protected override void OnInitialized()
    {
        _startBinder = new SgEditContextBinder<DateTime?>(StateHasChanged);
        _endBinder = new SgEditContextBinder<DateTime?>(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        _startBinder?.Update(CascadedEditContext, StartValueExpression);
        _endBinder?.Update(CascadedEditContext, EndValueExpression);
        
        var seed = StartValue ?? EndValue;
        if (seed.HasValue && !_open)
        {
            _view = new DateTime(seed.Value.Year, seed.Value.Month, 1);
        }
    }

    private async Task HandleFocusOutAsync(FocusEventArgs e)
    {
        await Task.Delay(250);
        if (!_open) return;
        try
        {
            var isInside = await JS.InvokeAsync<bool>("eval",
                $"!!document.querySelector('[data-sgdrp=\"{_uid}\"]')?.contains(document.activeElement)");
            if (!isInside)
            {
                _open = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            _open = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task ToggleAsync()
    {
        if (Disabled) return Task.CompletedTask;
        _open = !_open;
        if (_open)
        {
            var seed = StartValue ?? EndValue ?? DateTime.Today;
            _view = new DateTime(seed.Year, seed.Month, 1);
        }
        return InvokeAsync(StateHasChanged);
    }

    private void Shift(int months) => _view = _view.AddMonths(months);

    private IEnumerable<DateTime> BuildGrid()
    {
        var first = new DateTime(_view.Year, _view.Month, 1);
        var fdow = (int)EffectiveFirstDayOfWeek;
        var startOffset = ((int)first.DayOfWeek - fdow + 7) % 7;
        var start = first.AddDays(-startOffset);
        for (var i = 0; i < 42; i++) yield return start.AddDays(i);
    }

    private bool IsDisabled(DateTime d)
    {
        if (DisabledDate is not null && DisabledDate(d.Date)) return true;
        if (Min.HasValue && d.Date < Min.Value.Date) return true;
        if (Max.HasValue && d.Date > Max.Value.Date) return true;
        return false;
    }

    private bool IsDateRangeExceeded(DateTime d)
    {
        if (!MaxDateRange.HasValue || !StartValue.HasValue || EndValue.HasValue) return false;
        var diff = (d.Date - StartValue.Value.Date).Duration();
        return diff > MaxDateRange.Value;
    }

    private bool IsInRange(DateTime d)
    {
        if (!HasRange) return false;
        return d.Date > StartValue!.Value.Date && d.Date < EndValue!.Value.Date;
    }

    private async Task PickAsync(DateTime d)
    {
        if (IsDisabled(d) || ReadOnly) return;
        if (IsDateRangeExceeded(d)) return;

        if (!StartValue.HasValue || (StartValue.HasValue && EndValue.HasValue))
        {
            StartValue = d.Date;
            EndValue = null;
        }
        else
        {
            if (d.Date < StartValue.Value.Date)
            {
                EndValue = StartValue.Value.Date;
                StartValue = d.Date;
            }
            else
            {
                EndValue = d.Date;
            }
        }

        var shouldClose = StartValue.HasValue && EndValue.HasValue;

        await NotifyAsync();

        if (shouldClose)
        {
            _open = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task SetTodayAsync() => SetRangeAsync(DateTime.Today, DateTime.Today);

    private Task SetCurrentMonthAsync()
    {
        var start = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        var end = start.AddMonths(1).AddDays(-1);
        return SetRangeAsync(start, end);
    }

    private async Task SetRangeAsync(DateTime start, DateTime end)
    {
        StartValue = start.Date;
        EndValue = end.Date;
        _open = false;
        await NotifyAsync();
    }

    private async Task ClearAsync()
    {
        StartValue = null;
        EndValue = null;
        _open = false;
        await NotifyAsync();
    }

    private async Task NotifyAsync()
    {
        if (StartValueChanged.HasDelegate) await StartValueChanged.InvokeAsync(StartValue);
        if (EndValueChanged.HasDelegate) await EndValueChanged.InvokeAsync(EndValue);
        _startBinder?.NotifyFieldChanged();
        _endBinder?.NotifyFieldChanged();
        await InvokeAsync(StateHasChanged);
    }
}
