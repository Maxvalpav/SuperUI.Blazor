@namespace SuperUI.Components
@inherits SgJsComponentBase

<div class="@GetRootClasses()"
     style="@Styles().AddStyle("width", Width).AddStyle("height", Height).Build()"
     @onfocusin="@(() => { if (!string.IsNullOrEmpty(Label)) _focused = true; })"
     @onfocusout="@(() => { if (!string.IsNullOrEmpty(Label)) _focused = false; })">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sgc-label @(Required ? "sgc-required" : "")">@Label</label>
    }
    <div class="sgc-signature-canvas-wrap">
        <canvas @ref="_canvasRef"
               class="sgc-signature-canvas"
               aria-label="Signature Pad" />
        @if (!string.IsNullOrEmpty(Placeholder) && !_hasContent && !ReadOnly)
        {
            <div class="sgc-signature-placeholder">@Placeholder</div>
        }
    </div>
    @if (ShowAnyAction)
    {
        <div class="sgc-signature-actions sgc-signature-actions-bottom-right">
            @if (ShowUndo)
            {
                <SgButton Title="Undo" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="OnUndoClick">
                    <Icon><SgIcon Icon="@SgHeroicons.Outline.ArrowUturnLeft" Size="14px" /></Icon>
                </SgButton>
            }
            @if (ShowRedo)
            {
                <SgButton Title="Redo" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="OnRedoClick">
                    <Icon><SgIcon Icon="@SgHeroicons.Outline.ArrowUturnRight" Size="14px" /></Icon>
                </SgButton>
            }
            @if (ShowCopy)
            {
                <SgButton Title="Copy to Clipboard" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="OnCopyClick">
                    <Icon><SgIcon Icon="@SgHeroicons.Outline.Clipboard" Size="14px" /></Icon>
                </SgButton>
            }
            @if (ShowDownload)
            {
                <SgButton Title="Download as PNG" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="OnDownloadClick">
                    <Icon><SgIcon Icon="@SgHeroicons.Outline.ArrowDownTray" Size="14px" /></Icon>
                </SgButton>
            }
            @if (ShowClear)
            {
                <SgButton Title="Clear" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="OnClearClick">
                    <Icon><SgIcon Icon="@SgHeroicons.Outline.Trash" Size="14px" /></Icon>
                </SgButton>
            }
        </div>
    }
</div>
