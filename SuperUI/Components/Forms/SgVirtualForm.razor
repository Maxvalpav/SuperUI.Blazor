@* SuperUI/Components/Forms/SgVirtualForm.razor *@
@* ИСПРАВЛЕНО:
   1. Явный TItem="SgFieldDescriptor" в Virtualize (RZ10000 / CS0411)
   2. SgFieldDescriptor импортируется из отдельного .cs файла
   3. SgDynamicField с явным TProp="object"
*@
@typeparam TModel

@using Microsoft.AspNetCore.Components.Web.Virtualization
@using SuperUI.Components.Forms

@if (_fields.Count > 0)
{
    @* ИСПРАВЛЕНО: явный TItem="SgFieldDescriptor" *@
    <Virtualize TItem="SgFieldDescriptor" Items="@_fields" ItemSize="@ItemHeight">
        <ItemContent>
            <div style="height: @(ItemHeight)px; display: flex; align-items: center;">
                @* ИСПРАВЛЕНО: TProp="object" + Model=Model + For через имя свойства *@
                <SgDynamicField TModel="TModel"
                                TProp="object"
                                Model="@Model"
                                Label="@context.Label"
                                Placeholder="@context.Placeholder" />
            </div>
        </ItemContent>
    </Virtualize>
}
else
{
    <p>Нет полей для отображения.</p>
}

@code {
    [Parameter, EditorRequired] public TModel? Model { get; set; }
    [Parameter] public int ItemHeight { get; set; } = 56;

    private List<SgFieldDescriptor> _fields = [];

    protected override void OnParametersSet()
    {
        if (Model is null) return;
        _fields = SgFieldDescriptorBuilder.Build<TModel>();
    }
}