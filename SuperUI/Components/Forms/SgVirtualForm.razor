@typeparam TModel

@using Microsoft.AspNetCore.Components.Web.Virtualization
@using SuperUI.Base

@inherits SgComponentBase

@if (Fields is null || Model is null)
{
    @if (LoadingContent is not null)
    {
        <div class="sg-virtual-form-loading">
            @LoadingContent
        </div>
    }
    return;
}

<Virtualize Items="@Fields" ItemSize="@ItemHeight" OverscanCount="@OverscanCount">
    <ItemContent>
        <SgDynamicField Field="@context" Model="@Model" />
    </ItemContent>
</Virtualize>

@code {
    /// <summary>
    /// Поля формы для виртуализации.
    /// </summary>
    [Parameter] public IReadOnlyList<IFormField>? Fields { get; set; }

    /// <summary>Модель данных формы.</summary>
    [Parameter] public TModel? Model { get; set; }

    /// <summary>Контент во время загрузки полей.</summary>
    [Parameter] public RenderFragment? LoadingContent { get; set; }

    /// <summary>Высота каждой строки в пикселях.</summary>
    [Parameter] public int ItemHeight { get; set; } = 72;

    /// <summary>Количество дополнительных видимых элементов.</summary>
    [Parameter] public int OverscanCount { get; set; } = 5;
}
