@* SuperUI/Components/Forms/SgVirtualForm.razor *@
@* ИСПРАВЛЕНО: явный TItem="SgFieldDescriptor" в Virtualize *@
@typeparam TModel

@using Microsoft.AspNetCore.Components.Web.Virtualization

@if (_fields.Count > 0)
{
    <div class="sg-virtual-form">
        <Virtualize TItem="SgFieldDescriptor"
                    Items="@_fields"
                    ItemSize="@ItemHeight"
                    OverscanCount="3"
                    Context="field">
            <ItemContent>
                <SgDynamicField TModel="TModel"
                                TField="object"
                                Model="@Model"
                                FieldDescriptor="@field"
                                Label="@field.Label" />
            </ItemContent>
        </Virtualize>
    </div>
}

@code {
    [Parameter, EditorRequired] public TModel? Model { get; set; }
    [Parameter] public int ItemHeight { get; set; } = 56;

    private List<SgFieldDescriptor> _fields = [];

    protected override void OnParametersSet()
    {
        if (Model is null) return;
        _fields = SgFieldDescriptorBuilder.Build<TModel>();
    }
}

/// <summary>Дескриптор поля формы для виртуализации.</summary>
public sealed class SgFieldDescriptor
{
    public string Name { get; init; } = "";
    public string? Label { get; init; }
    public Type FieldType { get; init; } = typeof(string);
    public bool Required { get; init; }
    public int Order { get; init; }
}
