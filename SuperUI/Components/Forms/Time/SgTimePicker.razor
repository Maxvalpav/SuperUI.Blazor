@namespace SuperUI.Components
@using System.Linq.Expressions
@using SuperUI.Localization
@using System.Globalization
@inject ISuperUILocalizer Localizer
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="sgc-field @(Block ? "sgc-block" : "") @(LabelPosition == SgLabelPosition.Left ? "sgc-label-left" : LabelPosition == SgLabelPosition.Right ? "sgc-label-right" : "") @SizeClass @CssClass @(Compact ? "sgc-compact" : "") @(FloatingLabel ? "sgc-floating-label" : "")" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label id="@_labelId" class="sgc-label @(Required ? "sgc-required" : "")">@Label</label>
    }
    
    <div class="sgc-combo sgc-combo-time @_sizeCss @(Block ? "sgc-block" : "") @(_open ? "sgc-open" : "") @(Disabled ? "sgc-disabled" : "") @(IsInvalid ? "sgc-invalid" : "") @(Compact ? "sgc-compact" : "") @(FloatingLabel ? "sgc-floating-label" : "") @(ShowClearOnHover ? "sgc-clear-hover" : "")"
         role="combobox"
         aria-expanded="@(_open ? "true" : "false")"
         aria-haspopup="dialog"
         aria-labelledby="@_labelId"
         aria-required="@(Required ? "true" : null)"
         aria-disabled="@(Disabled ? "true" : null)"
         aria-invalid="@(IsInvalid ? "true" : null)"
         aria-describedby="@DescribedBy"
         aria-controls="@_popupId"
         tabindex="@(Disabled ? "-1" : "0")"
         @onfocusout="HandleFocusOutAsync"
         @onclick:stopPropagation="true"
         @attributes="AdditionalAttributes">
        <div class="sgc-combo-control" @onclick="ToggleAsync" @ref="_controlRef">
            @if (AllowInput)
            {
                <input class="sgc-combo-input sgc-time-input"
                       value="@(_inputText ?? GetDisplayTime())"
                       @onchange="HandleInputChangeAsync"
                       @onclick:stopPropagation="true"
                       placeholder="@Placeholder"
                       readonly="@(Disabled || ReadOnly)" />
            }
            else if (Value.HasValue)
            {
                <span class="sgc-combo-value">@GetDisplayTime()</span>
            }
            else
            {
                <span class="sgc-combo-placeholder">@Placeholder</span>
            }
            @if (AllowClear && Value.HasValue && !Disabled && !ReadOnly)
            {
                <button class="sgc-combo-clear" type="button" aria-label="@ClearLabel" title="@ClearLabel"
                        @onclick:stopPropagation="true" @onclick="ClearAsync">
                    @((MarkupString)SgIcons.X)
                </button>
            }
            <span class="sgc-combo-caret" aria-hidden="true">@((MarkupString)SgIcons.Clock)</span>
        </div>

        @if (_open)
        {
            <div id="@_popupId" class="sgc-time-popup" role="dialog" @onmousedown:stopPropagation @onmousedown:preventDefault>
                <div class="sgc-time-header">
                    <div class="sgc-time-inputs">
                        <button type="button" class="sgc-time-input-btn @(_mode == PickerMode.Hours ? "active" : "")" 
                                @onclick="() => _mode = PickerMode.Hours">
                            @GetDisplayHour()
                        </button>
                        <span class="sgc-time-separator">:</span>
                        <button type="button" class="sgc-time-input-btn @(_mode == PickerMode.Minutes ? "active" : "")" 
                                @onclick="() => _mode = PickerMode.Minutes">
                            @GetDisplayMinute()
                        </button>
                        @if (ShowSeconds)
                        {
                            <span class="sgc-time-separator">:</span>
                            <button type="button" class="sgc-time-input-btn @(_mode == PickerMode.Seconds ? "active" : "")" 
                                    @onclick="() => _mode = PickerMode.Seconds">
                                @GetDisplaySecond()
                            </button>
                        }
                    </div>
                    @if (UseAmPm)
                    {
                        <div class="sgc-time-ampm">
                            <button type="button" class="sgc-ampm-btn @(IsAm ? "active" : "")" @onclick="() => SetAmPm(true)">AM</button>
                            <button type="button" class="sgc-ampm-btn @(!IsAm ? "active" : "")" @onclick="() => SetAmPm(false)">PM</button>
                        </div>
                    }
                </div>

                <div class="sgc-time-content">
                    @if (Items is not null && Items.Any())
                    {
                        <div class="sgc-time-items">
                            @foreach (var item in Items)
                            {
                                var it = item;
                                var isItemSelected = it == _pendingValue;
                                <div class="sgc-time-list-item @(isItemSelected ? "sgc-selected" : "")"
                                     @onclick="() => SelectItemAsync(it)">
                                    @GetItemDisplayText(it)
                                </div>
                            }
                        </div>
                    }
                    else if (_viewType == ViewType.Clock)
                    {
                        <div class="sgc-clock-face" @ref="_clockFaceRef">
                            <div class="sgc-clock-inner-ring"></div>
                            <div class="sgc-clock-center"></div>
                            <div class="sgc-clock-hand @(_isDragging ? "sgc-no-transition" : "")" style="transform: rotate(@(GetHandRotation())deg)">
                                <div class="sgc-clock-hand-dot"></div>
                            </div>
                            @if (_mode == PickerMode.Hours)
                            {
                                @for (int h = 1; h <= 12; h++)
                                {
                                    var hour = h;
                                    var angle = (hour * 30);
                                    var isSelected = IsHourSelected(hour);
                                    <div class="sgc-clock-number @(isSelected ? "selected" : "")" style="transform: translate(-50%, -50%) rotate(@(angle)deg) translateY(-82px) rotate(@(-angle)deg)">
                                        @hour
                                    </div>
                                }
                            }
                            else
                            {
                                @for (int i = 0; i < 60; i += 5)
                                {
                                    var val = i;
                                    var angle = (val * 6);
                                    var isSelected = (_mode == PickerMode.Minutes ? _pendingValue.Minutes : _pendingValue.Seconds) == val;
                                    <div class="sgc-clock-number @(isSelected ? "selected" : "")" style="transform: translate(-50%, -50%) rotate(@(angle)deg) translateY(-82px) rotate(@(-angle)deg)">
                                        @val.ToString("D2")
                                    </div>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <div class="sgc-time-lists">
                             <div class="sgc-time-list-col">
                                @for (int h = 0; h < (UseAmPm ? 12 : 24); h += HourStep)
                                {
                                    var hour = h;
                                    if (UseAmPm && h == 0) hour = 12;
                                    var currentH = hour;
                                    var isOutOfRange = IsHourOutOfRange(currentH);
                                    <div class="sgc-time-list-item @(IsHourSelected(currentH) ? "sgc-selected" : "") @(isOutOfRange ? "sgc-disabled" : "")" 
                                         @onclick="() => { if (!isOutOfRange) { SetHour(currentH); _mode = PickerMode.Minutes; } }">
                                        @currentH.ToString("D2")
                                    </div>
                                }
                            </div>
                            <div class="sgc-time-list-col">
                                @for (int m = 0; m < 60; m += MinuteStep)
                                {
                                    var min = m;
                                    var isOutOfRange = IsMinuteOutOfRange(min);
                                    <div class="sgc-time-list-item @(_pendingValue.Minutes == min ? "sgc-selected" : "") @(isOutOfRange ? "sgc-disabled" : "")" 
                                         @onclick="() => { if (!isOutOfRange) _ = SetMinuteAsync(min); }">
                                        @min.ToString("D2")
                                    </div>
                                }
                            </div>
                            @if (ShowSeconds)
                            {
                                <div class="sgc-time-list-col">
                                    @for (int s = 0; s < 60; s += SecondStep)
                                    {
                                        var sec = s;
                                        <div class="sgc-time-list-item @(_pendingValue.Seconds == sec ? "sgc-selected" : "")" 
                                             @onclick="() => _ = SetSecondAsync(sec)">
                                            @sec.ToString("D2")
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="sgc-time-footer">
                    @if (Items is null || !Items.Any())
                    {
                        <button type="button" class="sgc-time-toggle-btn" @onclick="ToggleViewTypeAsync">
                            @if (_viewType == ViewType.Clock)
                            {
                                <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor"><path d="M1 2.75C1 1.784 1.784 1 2.75 1h10.5c.966 0 1.75.784 1.75 1.75v10.5A1.75 1.75 0 0113.25 15H2.75A1.75 1.75 0 011 13.25V2.75zm1.75-.25a.25.25 0 00-.25.25v10.5c0 .138.112.25.25.25h10.5a.25.25 0 00.25-.25V2.75a.25.25 0 00-.25-.25H2.75zM4 5.5a1 1 0 112 0 1 1 0 01-2 0zM7.75 5a.75.75 0 000 1.5h4.5a.75.75 0 000-1.5h-4.5zM4 8.5a1 1 0 112 0 1 1 0 01-2 0zM7.75 8a.75.75 0 000 1.5h4.5a.75.75 0 000-1.5h-4.5zm-3.75 3a1 1 0 112 0 1 1 0 01-2 0zm3.75-.5a.75.75 0 000 1.5h4.5a.75.75 0 000-1.5h-4.5z"/></svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor"><path d="M8 16A8 8 0 118 0a8 8 0 010 16zM8 1.5a6.5 6.5 0 100 13 6.5 6.5 0 000-13z"/><path d="M8 3.5a.75.75 0 01.75.75v4.25h3a.75.75 0 010 1.5H8a.75.75 0 01-.75-.75V4.25A.75.75 0 018 3.5z"/></svg>
                            }
                        </button>
                    }
                    @if (ShowNow)
                    {
                        <button type="button" class="sgc-btn sgc-sm sgc-ghost" @onclick="SetNowAsync">@EffectiveNowText</button>
                    }
                    <div style="flex:1"></div>
                    <button type="button" class="sgc-btn sgc-sm sgc-ghost" @onclick="CloseAsync">@EffectiveCancelText</button>
                    @if (!CloseOnSelect)
                    {
                        <button type="button" class="sgc-btn sgc-sm" @onclick="ConfirmAsync">@EffectiveOkText</button>
                    }
                </div>
            </div>
        }
    </div>

    @if (IsInvalid)
    {
        <span id="@_errorId" class="sgc-error">@DisplayedError</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@_hintId" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private enum PickerMode { Hours, Minutes, Seconds }
    private enum ViewType { Clock, List }

    private readonly string _labelId = "sg-time-label-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _hintId = "sg-time-hint-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _errorId = "sg-time-err-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _popupId = "sg-time-popup-" + Guid.NewGuid().ToString("N")[..8];
    
    private bool _open;
    private PickerMode _mode = PickerMode.Hours;
    private ViewType _viewType = ViewType.List;
    private TimeSpan _pendingValue;
    private bool _isDragging;
    private string? _inputText;
    
    private ElementReference _clockFaceRef;
    private ElementReference _controlRef;
    private IJSObjectReference? _module;
    private IJSObjectReference? _clockInstance;
    private DotNetObjectReference<SgTimePicker>? _selfRef;
    private bool _disposed;

    private SgEditContextBinder<TimeSpan?>? _binder;

    [CascadingParameter] private EditContext? CascadedEditContext { get; set; }
    
    [Parameter] public Expression<Func<TimeSpan?>>? ValueExpression { get; set; }
    /// <summary>Gets or sets the selected time value.</summary>
    [Parameter] public TimeSpan? Value { get; set; }
    /// <summary>Fires when the selected time value changes.</summary>
    [Parameter] public EventCallback<TimeSpan?> ValueChanged { get; set; }
    
    /// <summary>Gets or sets whether to show seconds in the time picker.</summary>
    [Parameter] public bool ShowSeconds { get; set; }
    /// <summary>Gets or sets whether to use 12-hour (AM/PM) format.</summary>
    [Parameter] public bool UseAmPm { get; set; }
    /// <summary>Gets or sets the interval between selectable minutes.</summary>
    [Parameter] public int MinuteStep { get; set; } = 1;
    /// <summary>Gets or sets the interval between selectable hours.</summary>
    [Parameter] public int HourStep { get; set; } = 1;
    /// <summary>Gets or sets the interval between selectable seconds.</summary>
    [Parameter] public int SecondStep { get; set; } = 1;
    
    /// <summary>Gets or sets the label displayed above the time picker.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Gets or sets the label position relative to the time picker.</summary>
    [Parameter] public SgLabelPosition LabelPosition { get; set; } = SgLabelPosition.Top;
    /// <summary>Gets or sets the hint text displayed below the time picker.</summary>
    [Parameter] public string? Hint { get; set; }
    /// <summary>Gets or sets the error text displayed on validation failure.</summary>
    [Parameter] public string? ErrorText { get; set; }
    /// <summary>Gets or sets the placeholder text when no time is selected.</summary>
    [Parameter] public string Placeholder { get; set; } = "--:--";
    /// <summary>Gets or sets whether a clear button is shown when a value is selected.</summary>
    [Parameter] public bool AllowClear { get; set; } = true;
    /// <summary>Gets or sets whether the field is required (shows indicator on label).</summary>
    [Parameter] public bool Required { get; set; }
    /// <summary>Gets or sets whether the time picker is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Gets or sets whether the time picker is read-only.</summary>
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>Gets or sets whether the time picker fills the full width of its container.</summary>
    [Parameter] public bool Block { get; set; } = true;
    /// <summary>Gets or sets the size of the time picker.</summary>
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;
    /// <summary>Gets or sets additional CSS classes for the wrapper element.</summary>
    [Parameter] public string? CssClass { get; set; }
    
    /// <summary>Gets or sets additional inline CSS styles.</summary>
    [Parameter] public string? Style { get; set; }
    
    /// <summary>Gets or sets additional HTML attributes.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
    
    /// <summary>When true, applies compact sizing.</summary>
    [Parameter] public bool Compact { get; set; }
    
    /// <summary>When true, the label floats above the trigger.</summary>
    [Parameter] public bool FloatingLabel { get; set; }
    
    /// <summary>When true, the clear button is visible only on hover/focus.</summary>
    [Parameter] public bool ShowClearOnHover { get; set; }
    
    /// <summary>When true, renders the dropdown with fixed positioning via JS interop. Default false.</summary>
    [Parameter] public bool UsePortal { get; set; }
    
    /// <summary>
    /// Gets or sets a custom format string for the displayed time.
    /// When empty, uses automatic formatting based on ShowSeconds and UseAmPm.
    /// </summary>
    [Parameter] public string Format { get; set; } = "";
    
    /// <summary>
    /// Gets or sets the minimum selectable time.
    /// </summary>
    [Parameter] public TimeSpan? MinTime { get; set; }
    
    /// <summary>
    /// Gets or sets the maximum selectable time.
    /// </summary>
    [Parameter] public TimeSpan? MaxTime { get; set; }
    
    /// <summary>
    /// Gets or sets whether the user can type a time directly into the input.
    /// </summary>
    [Parameter] public bool AllowInput { get; set; }
    
    /// <summary>
    /// Gets or sets whether to show a "Now" button in the footer.
    /// </summary>
    [Parameter] public bool ShowNow { get; set; }
    
    /// <summary>
    /// Fires when the popup opens.
    /// </summary>
    [Parameter] public EventCallback OnOpen { get; set; }
    
    /// <summary>
    /// Fires when the popup closes.
    /// </summary>
    [Parameter] public EventCallback OnClose { get; set; }
    
    /// <summary>When true, skips the OK/Cancel step and closes immediately after picking minutes (or seconds). Default false.</summary>
    [Parameter] public bool CloseOnSelect { get; set; }
    
    /// <summary>Optional list of predefined time slots shown as a simple pick list instead of the clock/list view.</summary>
    [Parameter] public IEnumerable<TimeSpan>? Items { get; set; }
    
    /// <summary>When true, snaps the time to the nearest MinuteStep on open. Default false.</summary>
    [Parameter] public bool SnapToStep { get; set; }
    
    /// <summary>When true, sets the time to the current time on open if no value is set. Default false.</summary>
    [Parameter] public bool DefaultToNow { get; set; }
    
    /// <summary>
    /// Gets or sets per-instance text for the OK button.
    /// When null, uses the localizer.
    /// </summary>
    [Parameter] public string? OkText { get; set; }
    
    /// <summary>
    /// Gets or sets per-instance text for the Cancel button.
    /// When null, uses the localizer.
    /// </summary>
    [Parameter] public string? CancelText { get; set; }
    
    /// <summary>
    /// Gets or sets per-instance text for the Clear button.
    /// When null, uses the localizer.
    /// </summary>
    [Parameter] public string? ClearText { get; set; }
    
    /// <summary>
    /// Gets or sets per-instance text for the Now button.
    /// When null, uses the localizer.
    /// </summary>
    [Parameter] public string? NowText { get; set; }

    private bool IsInvalid => !string.IsNullOrEmpty(ErrorText) || (_binder?.HasValidationErrors ?? false);
    private string? DisplayedError => !string.IsNullOrEmpty(ErrorText) ? ErrorText : _binder?.ValidationMessages.FirstOrDefault();
    private string? DescribedBy => IsInvalid ? _errorId : (!string.IsNullOrEmpty(Hint) ? _hintId : null);
    private string ClearLabel => ClearText ?? Localizer["Common_Clear"];
    private string EffectiveOkText => OkText ?? Localizer["Common_OK"];
    private string EffectiveCancelText => CancelText ?? Localizer["Common_Cancel"];
    private string EffectiveNowText => NowText ?? Localizer["Common_Now"];
    
    private string? SizeClass => Size switch
    {
        SgSize.Sm => "sgc-field-sm",
        SgSize.Lg => "sgc-field-lg",
        SgSize.Xl => "sgc-field-xl",
        _ => null
    };
    private string _sizeCss => Size switch
    {
        SgSize.Sm => "sgc-size-sm",
        SgSize.Lg => "sgc-size-lg",
        SgSize.Xl => "sgc-size-xl",
        _ => "sgc-size-md"
    };

    private bool IsAm => _pendingValue.Hours < 12;

    private string GetItemDisplayText(TimeSpan t)
    {
        if (!string.IsNullOrEmpty(Format))
            return t.ToString(Format, CultureInfo.CurrentCulture);
        if (UseAmPm)
        {
            var h = t.Hours % 12;
            if (h == 0) h = 12;
            var ampm = t.Hours >= 12 ? "PM" : "AM";
            var s = ShowSeconds ? $":{t.Seconds:D2}" : "";
            return $"{h:D2}:{t.Minutes:D2}{s} {ampm}";
        }
        var time = $"{t.Hours:D2}:{t.Minutes:D2}";
        if (ShowSeconds) time += $":{t.Seconds:D2}";
        return time;
    }

    private async Task SelectItemAsync(TimeSpan time)
    {
        _pendingValue = ClampTime(time);
        await ConfirmAsync();
    }

    private TimeSpan SnapToNearestStep(TimeSpan time)
    {
        var totalMin = (int)time.TotalMinutes;
        var snapped = (int)(Math.Round((double)totalMin / MinuteStep) * MinuteStep);
        return new TimeSpan(snapped / 60, snapped % 60, time.Seconds);
    }

    protected override void OnInitialized()
    {
        _binder = new SgEditContextBinder<TimeSpan?>(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        _binder?.Update(CascadedEditContext, ValueExpression);
        if (!_open) _pendingValue = Value ?? TimeSpan.Zero;
    }

    private string GetDisplayTime()
    {
        if (!Value.HasValue) return "";
        
        if (!string.IsNullOrEmpty(Format))
        {
            return Value.Value.ToString(Format, CultureInfo.CurrentCulture);
        }
        
        var h = Value.Value.Hours;
        var m = Value.Value.Minutes;
        var s = Value.Value.Seconds;
        
        string time;
        if (UseAmPm)
        {
            var ampm = h >= 12 ? "PM" : "AM";
            h = h % 12;
            if (h == 0) h = 12;
            time = $"{h:D2}:{m:D2}";
            if (ShowSeconds) time += $":{s:D2}";
            return $"{time} {ampm}";
        }
        
        time = $"{h:D2}:{m:D2}";
        if (ShowSeconds) time += $":{s:D2}";
        return time;
    }

    private string GetDisplayHour()
    {
        var h = _pendingValue.Hours;
        if (UseAmPm)
        {
            h = h % 12;
            if (h == 0) h = 12;
        }
        return h.ToString("D2");
    }

    private string GetDisplayMinute() => _pendingValue.Minutes.ToString("D2");
    private string GetDisplaySecond() => _pendingValue.Seconds.ToString("D2");

    private bool IsHourSelected(int h)
    {
        var currentH = _pendingValue.Hours % 12;
        if (currentH == 0) currentH = 12;
        return currentH == h;
    }

    private bool IsHourOutOfRange(int h)
    {
        int actualH;
        if (UseAmPm)
        {
            var isPm = _pendingValue.Hours >= 12;
            if (isPm)
                actualH = h % 12 + 12;
            else
            {
                actualH = h % 12;
                if (actualH == 12) actualH = 0;
            }
        }
        else
        {
            var isSecondHalf = _pendingValue.Hours >= 12;
            if (isSecondHalf)
            {
                actualH = h + 12;
                if (actualH == 24) actualH = 12;
            }
            else
            {
                actualH = h;
                if (actualH == 12) actualH = 0;
            }
        }

        if (MinTime.HasValue && actualH < MinTime.Value.Hours) return true;
        if (MaxTime.HasValue && actualH > MaxTime.Value.Hours) return true;
        return false;
    }

    private bool IsMinuteOutOfRange(int m)
    {
        if (MinTime.HasValue && _pendingValue.Hours == MinTime.Value.Hours && m < MinTime.Value.Minutes) return true;
        if (MaxTime.HasValue && _pendingValue.Hours == MaxTime.Value.Hours && m > MaxTime.Value.Minutes) return true;
        return false;
    }

    private void SetAmPm(bool am)
    {
        var h = _pendingValue.Hours;
        if (am && h >= 12) h -= 12;
        else if (!am && h < 12) h += 12;
        _pendingValue = ClampTime(new TimeSpan(h, _pendingValue.Minutes, _pendingValue.Seconds));
    }

    private void SetHour(int h)
    {
        int finalH = h;
        if (UseAmPm)
        {
            var isPm = _pendingValue.Hours >= 12;
            finalH = h % 12;
            if (isPm) finalH += 12;
            else if (finalH == 12) finalH = 0;
        }
        _pendingValue = ClampTime(new TimeSpan(finalH, _pendingValue.Minutes, _pendingValue.Seconds));
    }

    private void SetMinute(int m)
    {
        _pendingValue = ClampTime(new TimeSpan(_pendingValue.Hours, m, _pendingValue.Seconds));
    }

    private async Task SetMinuteAsync(int m)
    {
        _pendingValue = ClampTime(new TimeSpan(_pendingValue.Hours, m, _pendingValue.Seconds));
        if (CloseOnSelect && !ShowSeconds)
            await ConfirmAsync();
        else if (ShowSeconds)
            _mode = PickerMode.Seconds;
        await InvokeAsync(StateHasChanged);
    }

    private void SetSecond(int s)
    {
        _pendingValue = ClampTime(new TimeSpan(_pendingValue.Hours, _pendingValue.Minutes, s));
    }

    private async Task SetSecondAsync(int s)
    {
        _pendingValue = ClampTime(new TimeSpan(_pendingValue.Hours, _pendingValue.Minutes, s));
        if (CloseOnSelect)
            await ConfirmAsync();
        await InvokeAsync(StateHasChanged);
    }

    private TimeSpan ClampTime(TimeSpan time)
    {
        if (MinTime.HasValue && time < MinTime.Value) time = MinTime.Value;
        if (MaxTime.HasValue && time > MaxTime.Value) time = MaxTime.Value;
        return time;
    }

    private double GetHandRotation()
    {
        if (_mode == PickerMode.Hours)
        {
            var h = _pendingValue.Hours % 12;
            return h * 30;
        }
        if (_mode == PickerMode.Minutes) return _pendingValue.Minutes * 6;
        return _pendingValue.Seconds * 6;
    }

    [JSInvokable]
    public void OnClockMove(double angle)
    {
        _isDragging = true;
        UpdateFromAngle(angle);
    }

    [JSInvokable]
    public async Task OnClockUp()
    {
        _isDragging = false;
        if (_mode == PickerMode.Hours)
        {
            _mode = PickerMode.Minutes;
        }
        else if (_mode == PickerMode.Minutes && ShowSeconds)
        {
            _mode = PickerMode.Seconds;
        }
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateFromAngle(double angle)
    {
        if (_mode == PickerMode.Hours)
        {
            var h = (int)Math.Round(angle / 30);
            if (h == 0) h = 12;
            
            if (HourStep > 1)
            {
                h = (int)Math.Round((double)h / HourStep) * HourStep;
                if (h == 0) h = HourStep;
                if (h > 12) h = 12;
            }
            
            if (!UseAmPm)
            {
                var isSecondHalf = _pendingValue.Hours >= 12;
                if (isSecondHalf)
                {
                    h += 12;
                    if (h == 24) h = 12;
                }
                else
                {
                    if (h == 12) h = 0;
                }
            }
            
            SetHour(h);
        }
        else if (_mode == PickerMode.Minutes)
        {
            var m = (int)Math.Round(angle / 6);
            if (m == 60) m = 0;
            
            if (MinuteStep > 1)
            {
                m = (int)Math.Round((double)m / MinuteStep) * MinuteStep;
                if (m == 60) m = 0;
            }
            
            SetMinute(m);
        }
        else if (_mode == PickerMode.Seconds)
        {
            var s = (int)Math.Round(angle / 6);
            if (s == 60) s = 0;
            
            if (SecondStep > 1)
            {
                s = (int)Math.Round((double)s / SecondStep) * SecondStep;
                if (s == 60) s = 0;
            }
            
            SetSecond(s);
        }
        StateHasChanged();
    }

    private void ToggleViewType() => _viewType = _viewType == ViewType.Clock ? ViewType.List : ViewType.Clock;

    private async Task ToggleAsync()
    {
        if (Disabled || ReadOnly) return;
        _open = !_open;
        if (_open)
        {
            _pendingValue = Value ?? (DefaultToNow ? DateTime.Now.TimeOfDay : TimeSpan.Zero);
            if (SnapToStep) _pendingValue = SnapToNearestStep(_pendingValue);
            _mode = PickerMode.Hours;
            _inputText = null;
            await OnOpen.InvokeAsync();
            
            if (_viewType == ViewType.Clock && (Items is null || !Items.Any()))
            {
                await Task.Delay(50);
                await InitJsClockAsync();
            }
        }
        else
        {
            await OnClose.InvokeAsync();
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task InitJsClockAsync()
    {
        try
        {
            if (_module == null)
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/superui-timepicker.js");
            }
            
            if (_clockInstance != null)
            {
                await _clockInstance.InvokeVoidAsync("dispose");
                _clockInstance = null;
            }
            
            _selfRef ??= DotNetObjectReference.Create(this);
            _clockInstance = await _module.InvokeAsync<IJSObjectReference>("initClock", _selfRef, _clockFaceRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to init clock JS: {ex.Message}");
        }
    }

    private async Task ToggleViewTypeAsync()
    {
        _viewType = _viewType == ViewType.Clock ? ViewType.List : ViewType.Clock;
        if (_viewType == ViewType.Clock)
        {
            await Task.Delay(50);
            await InitJsClockAsync();
        }
    }

    private async Task HandleFocusOutAsync(FocusEventArgs e)
    {
        await Task.Delay(200);
        if (!_isDragging) _open = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmAsync()
    {
        Value = _pendingValue;
        _open = false;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(Value);
        _binder?.NotifyFieldChanged();
        await OnClose.InvokeAsync();
    }

    private async Task CloseAsync()
    {
        _open = false;
        await OnClose.InvokeAsync();
    }

    private async Task ClearAsync()
    {
        _open = false;
        Value = null;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(null);
        _binder?.NotifyFieldChanged();
        await OnClose.InvokeAsync();
    }

    private async Task SetNowAsync()
    {
        _pendingValue = ClampTime(DateTime.Now.TimeOfDay);
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleInputChangeAsync(ChangeEventArgs e)
    {
        var text = e.Value?.ToString();
        _inputText = null;
        if (string.IsNullOrWhiteSpace(text)) return;

        if (TryParseTime(text, out var parsed))
        {
            _pendingValue = ClampTime(parsed);
            Value = _pendingValue;
            if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(Value);
            _binder?.NotifyFieldChanged();
        }
    }

    private static bool TryParseTime(string? text, out TimeSpan result)
    {
        result = TimeSpan.Zero;
        if (string.IsNullOrWhiteSpace(text)) return false;
        if (TimeSpan.TryParse(text, CultureInfo.CurrentCulture, out var ts))
        {
            result = ts;
            return true;
        }
        if (DateTime.TryParse(text, CultureInfo.CurrentCulture, DateTimeStyles.None, out var dt))
        {
            result = dt.TimeOfDay;
            return true;
        }
        return false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_open && UsePortal)
        {
            try
            {
                await JS.InvokeVoidAsync("eval",
                    $"(function(){{var m=document.getElementById('{_popupId}'),t=document.querySelector('[aria-labelledby={_labelId}]')?.querySelector('.sgc-combo-control');if(!m||!t)return;var r=t.getBoundingClientRect();m.style.position='fixed';m.style.top=(r.bottom+2)+'px';m.style.left=r.left+'px';m.style.width=Math.max(r.width,200)+'px';}})()");
            }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
        }
        else if (!_open && UsePortal)
        {
            try
            {
                await JS.InvokeVoidAsync("eval",
                    $"(function(){{var m=document.getElementById('{_popupId}');if(m){{m.style.position='';m.style.top='';m.style.left='';m.style.width='';}}}})()");
            }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        if (_clockInstance != null)
        {
            try { await _clockInstance.InvokeVoidAsync("dispose"); } catch (JSDisconnectedException) { } catch (TaskCanceledException) { }
            await _clockInstance.DisposeAsync();
        }
        if (_module != null) await _module.DisposeAsync();
        _selfRef?.Dispose();
        _binder?.Dispose();
    }
}
