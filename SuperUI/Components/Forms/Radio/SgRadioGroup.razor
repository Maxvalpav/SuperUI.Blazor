@namespace SuperUI.Components
@typeparam TValue
@inherits SgInputBase<TValue>

<div class="sgc-field @(Block ? "sgc-block" : "") @CssClass"
     role="radiogroup"
     aria-labelledby="@(string.IsNullOrEmpty(Label) ? null : _labelId)"
     aria-required="@(Required ? "true" : null)"
     aria-invalid="@(IsInvalid ? "true" : null)"
     @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label id="@_labelId" class="sgc-label @(Required ? "sgc-required" : "")">@Label</label>
    }
    <div class="@RadioListClass" @onkeydown="OnKeyDownAsync">
        @{
            var optionList = Options as IList<RadioOption<TValue>> ?? Options.ToList();
        }
        @for (var i = 0; i < optionList.Count; i++)
        {
            var idx = i;
            var o = optionList[idx];
            var checkedNow = EqualityComparer<TValue>.Default.Equals(Value, o.Value);
            var optDisabled = Disabled || o.Disabled;
            <label class="sgc-check @(ButtonGroup ? "sgc-radio-btn" : "") @(optDisabled ? "sgc-disabled" : "") @(checkedNow && ButtonGroup ? "sgc-radio-btn-active" : "")">
                <input type="radio"
                       name="@_name"
                       checked="@checkedNow"
                       disabled="@optDisabled"
                       tabindex="@(checkedNow || (Value is null && idx == _firstEnabledIndex) ? 0 : -1)"
                       data-sg-rg-index="@idx"
                       @onchange="() => SelectAsync(o.Value)" />
                <span>@o.Label</span>
            </label>
        }
    </div>
    @if (IsInvalid)
    {
        <span id="@_errorId" class="sgc-error">@ValidationMessages.FirstOrDefault()</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@_hintId" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private readonly string _name = "sgrg-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _labelId = "sgrg-lbl-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _hintId = "sgrg-hint-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _errorId = "sgrg-err-" + Guid.NewGuid().ToString("N")[..8];

    private int _firstEnabledIndex
    {
        get
        {
            var i = 0;
            foreach (var o in Options)
            {
                if (!(Disabled || o.Disabled)) return i;
                i++;
            }
            return 0;
        }
    }

    private string RadioListClass
    {
        get
        {
            if (ButtonGroup)
                return $"sgc-radio-btn-group {(Block ? "sgc-block" : "")}";
            return $"sgc-radio-list {(Orientation == SgRadioOrientation.Vertical ? "sgc-vertical" : "")}";
        }
    }

    private bool IsInvalid => HasValidationErrors;

    /// <summary>Gets or sets the collection of radio button options to display.</summary>
    [Parameter] public IEnumerable<RadioOption<TValue>> Options { get; set; } = Array.Empty<RadioOption<TValue>>();

    /// <summary>Gets or sets the label text displayed above the radio group.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Hint text shown below the radio group.</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>Gets or sets the layout direction of the options. Default is Horizontal.</summary>
    [Parameter] public SgRadioOrientation Orientation { get; set; } = SgRadioOrientation.Horizontal;

    /// <summary>When true, renders options as a connected segmented button group instead of radio buttons.</summary>
    [Parameter] public bool ButtonGroup { get; set; }

    /// <summary>Gets or sets whether the radio group should take full width of its container. Default is true.</summary>
    [Parameter] public bool Block { get; set; } = true;

    /// <summary>Gets or sets whether a selection is required.</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>Gets or sets whether all radio buttons are disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Gets or sets additional CSS class names to apply to the field container.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Gets or sets additional HTML attributes applied to the field container.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private Task SelectAsync(TValue? value) => SetValueAsync(value);

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (Disabled) return;
        var list = Options as IList<RadioOption<TValue>> ?? Options.ToList();
        if (list.Count == 0) return;

        var current = -1;
        for (var i = 0; i < list.Count; i++)
        {
            if (EqualityComparer<TValue>.Default.Equals(Value, list[i].Value))
            {
                current = i;
                break;
            }
        }

        int next = current;
        switch (e.Key)
        {
            case "ArrowRight":
            case "ArrowDown":
                next = NextEnabled(list, current, +1);
                break;
            case "ArrowLeft":
            case "ArrowUp":
                next = NextEnabled(list, current, -1);
                break;
            case "Home":
                next = NextEnabled(list, -1, +1);
                break;
            case "End":
                next = NextEnabled(list, list.Count, -1);
                break;
            default:
                return;
        }

        if (next >= 0 && next != current)
            await SelectAsync(list[next].Value);
    }

    private static int NextEnabled(IList<RadioOption<TValue>> list, int from, int step)
    {
        var n = list.Count;
        if (n == 0) return -1;
        for (var k = 1; k <= n; k++)
        {
            var i = ((from + step * k) % n + n) % n;
            if (!list[i].Disabled) return i;
        }
        return -1;
    }
}
