@namespace SuperUI.Components
@using SuperUI.Services.Llm
@inject ILlmService Llm
@inject ISuperUILocalizer Localizer

@*
   SgSmartFormBuilder — генерирует SgSmartFormMetadata из текстового или
   голосового описания пользователя через LLM (structured outputs / JSON schema).

   Пример: «Сделай форму для регистрации: имя, email, дата рождения, согласие на
   рассылку». Возвращает готовый Metadata, который сразу можно скормить в
   SgSmartForm.
*@

<div class="sgc-form-builder @CssClass" style="@Style">
    <SgTextArea @bind-Value="_prompt" Rows="3" Label="@Localizer["SmartForm_DescribeForm"]"
                Placeholder="Например: форма заявки на кредит: ФИО, паспорт, сумма, срок, e-mail" />

    <div class="sgc-form-builder-actions">
        <SgVoiceInput OnResult="OnVoiceResult"
                      Variant="SgButtonVariant.Outlined"
                       StartText="@Localizer["SmartForm_Voice"]" StopText="@Localizer["SmartForm_Stop"]"
                      OnError="@(e => _error = e)" />
        <SgButton Text="@Localizer["SmartForm_Build"]" OnClick="BuildAsync" Loading="_busy"
                  Variant="SgButtonVariant.Primary"
                  Disabled="@string.IsNullOrWhiteSpace(_prompt)" />
        <SgTextBox @bind-Value="_model" Placeholder="gpt-4o-mini" Label="@Localizer["SmartForm_Model"]" />
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <SgAlert Variant="SgAlertVariant.Danger">@_error</SgAlert>
    }

    @if (_metadata != null)
    {
        <SgCard>
            <div class="sgc-form-builder-meta">
                <strong>@(_metadata.Title ?? "Сгенерированная форма")</strong>
                @if (!string.IsNullOrEmpty(_metadata.Description))
                {
                    <div class="sgc-hint">@_metadata.Description</div>
                }
                <SgBadge>колонок: @_metadata.Columns</SgBadge>
                <SgBadge>полей: @_metadata.Fields.Count</SgBadge>
            </div>

            @if (ShowPreview)
            {
                <h4>Превью</h4>
                <SgSmartForm Metadata="_metadata"
                             EnableVoiceFilling="EnableVoiceFilling"
                             LlmConfig="LlmConfig"
                             OnSubmit="OnPreviewSubmit" />
            }
            else
            {
                <details>
                    <summary>Поля</summary>
                    <ul>
                        @foreach (var f in _metadata.Fields)
                        {
                            <li>
                                <code>@f.Key</code> — @f.Label
                                <SgBadge>@f.Type</SgBadge>
                                @if (f.Required) { <SgBadge Variant="SgBadgeVariant.Warn">required</SgBadge> }
                                @if (f.Options is { Count: > 0 })
                                { <span> [@string.Join(", ", f.Options.Select(o => o.Label))]</span> }
                            </li>
                        }
                    </ul>
                </details>
            }
        </SgCard>
    }
</div>

<style>
    .sgc-form-builder { display: flex; flex-direction: column; gap: 12px; padding: 12px; }
    .sgc-form-builder-actions { display: flex; gap: 8px; align-items: end; flex-wrap: wrap; }
    .sgc-form-builder-meta { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; margin-bottom: 8px; }
</style>

@code {
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";
    [Parameter] public string? Locale { get; set; } = "ru";
    [Parameter] public bool ShowPreview { get; set; } = true;
    [Parameter] public bool EnableVoiceFilling { get; set; } = true;
    [Parameter] public SgLlmConfig? LlmConfig { get; set; }
    [Parameter] public string TaskPurpose { get; set; } = SgLlmTaskPurpose.Structured;
    [Parameter] public EventCallback<SgSmartFormMetadata> OnMetadataReady { get; set; }
    [Parameter] public EventCallback<Dictionary<string, object?>> OnPreviewSubmit { get; set; }

    private string _prompt = "";
    private string _model = "";
    private bool _busy;
    private string _error = "";
    private SgSmartFormMetadata? _metadata;

    private void OnVoiceResult(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        _prompt = string.IsNullOrWhiteSpace(_prompt) ? text : _prompt + " " + text;
        StateHasChanged();
    }

    private async Task BuildAsync()
    {
        if (string.IsNullOrWhiteSpace(_prompt)) return;
        _busy = true; _error = ""; _metadata = null;
        try
        {
            var effective = Llm.ResolveConfigForTask(TaskPurpose, LlmConfig);
            await Llm.InitializeAsync(effective);

            var sys = $@"You are a UI form designer. Given a user description, output a JSON form
metadata. Always reply in language: {Locale ?? "ru"}.

Strict schema (no extra keys, all keys lowerCamel):
{{
  ""title"": string|null,
  ""description"": string|null,
  ""columns"": integer (1..3),
  ""fields"": [
    {{
      ""key"": string (camelCase),
      ""label"": string,
      ""description"": string|null,
      ""placeholder"": string|null,
      ""type"": one of [""text"",""multilineText"",""number"",""boolean"",""date"",""dateTime"",""select"",""password"",""email""],
      ""required"": boolean,
      ""fullWidth"": boolean,
      ""options"": [{{""label"": string, ""value"": string}}] | null
    }}
  ]
}}

Rules:
- Always provide options for type=select.
- Use email/password/date/number when semantics fit.
- Prefer concise camelCase keys.
- Return ONLY the JSON, no commentary.";

            var schema = @"{
  ""type"": ""object"",
  ""properties"": {
    ""title"": {""type"": [""string"",""null""]},
    ""description"": {""type"": [""string"",""null""]},
    ""columns"": {""type"": ""integer"", ""minimum"": 1, ""maximum"": 3},
    ""fields"": {
      ""type"": ""array"",
      ""items"": {
        ""type"": ""object"",
        ""properties"": {
          ""key"": {""type"": ""string""},
          ""label"": {""type"": ""string""},
          ""description"": {""type"": [""string"",""null""]},
          ""placeholder"": {""type"": [""string"",""null""]},
          ""type"": {""type"": ""string"", ""enum"": [""text"",""multilineText"",""number"",""boolean"",""date"",""dateTime"",""select"",""password"",""email""]},
          ""required"": {""type"": ""boolean""},
          ""fullWidth"": {""type"": ""boolean""},
          ""options"": {
            ""type"": [""array"",""null""],
            ""items"": {
              ""type"": ""object"",
              ""properties"": {
                ""label"": {""type"": ""string""},
                ""value"": {""type"": ""string""}
              },
              ""required"": [""label"",""value""],
              ""additionalProperties"": false
            }
          }
        },
        ""required"": [""key"",""label"",""type"",""required"",""fullWidth""],
        ""additionalProperties"": false
      }
    }
  },
  ""required"": [""columns"",""fields""],
  ""additionalProperties"": false
}";

            var res = await Llm.CompleteAsync(new SgLlmChatRequest
            {
                Messages = new()
                {
                    new() { Role = "system", Content = sys },
                    new() { Role = "user", Content = _prompt }
                },
                Model = string.IsNullOrWhiteSpace(_model) ? effective.ModelId : _model,
                ResponseFormat = "json_schema",
                JsonSchema = schema,
                Temperature = 0.2
            });

            if (!string.IsNullOrEmpty(res.Error)) { _error = res.Error; return; }
            _metadata = ParseMetadata(res.Content);
            if (_metadata != null && OnMetadataReady.HasDelegate)
                await OnMetadataReady.InvokeAsync(_metadata);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private static SgSmartFormMetadata? ParseMetadata(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return null;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            var meta = new SgSmartFormMetadata
            {
                Title = root.TryGetProperty("title", out var t) && t.ValueKind == System.Text.Json.JsonValueKind.String ? t.GetString() : null,
                Description = root.TryGetProperty("description", out var d) && d.ValueKind == System.Text.Json.JsonValueKind.String ? d.GetString() : null,
                Columns = root.TryGetProperty("columns", out var c) && c.ValueKind == System.Text.Json.JsonValueKind.Number ? c.GetInt32() : 1
            };
            if (root.TryGetProperty("fields", out var arr) && arr.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                foreach (var f in arr.EnumerateArray())
                {
                    var fm = new SgSmartFieldMetadata
                    {
                        Key = f.GetProperty("key").GetString() ?? "",
                        Label = f.GetProperty("label").GetString() ?? "",
                        Description = f.TryGetProperty("description", out var fd) && fd.ValueKind == System.Text.Json.JsonValueKind.String ? fd.GetString() : null,
                        Placeholder = f.TryGetProperty("placeholder", out var fp) && fp.ValueKind == System.Text.Json.JsonValueKind.String ? fp.GetString() : null,
                        Required = f.TryGetProperty("required", out var rq) && rq.ValueKind == System.Text.Json.JsonValueKind.True,
                        FullWidth = f.TryGetProperty("fullWidth", out var fw) && fw.ValueKind == System.Text.Json.JsonValueKind.True,
                        Type = MapType(f.GetProperty("type").GetString())
                    };
                    if (f.TryGetProperty("options", out var opts) && opts.ValueKind == System.Text.Json.JsonValueKind.Array)
                    {
                        fm.Options = new();
                        foreach (var o in opts.EnumerateArray())
                            fm.Options.Add(new SgSmartOption
                            {
                                Label = o.GetProperty("label").GetString() ?? "",
                                Value = o.GetProperty("value").GetString() ?? ""
                            });
                    }
                    meta.Fields.Add(fm);
                }
            }
            return meta;
        }
        catch { return null; }
    }

    private static SgSmartFieldType MapType(string? s) => s switch
    {
        "multilineText" => SgSmartFieldType.MultilineText,
        "number" => SgSmartFieldType.Number,
        "boolean" => SgSmartFieldType.Boolean,
        "date" => SgSmartFieldType.Date,
        "dateTime" => SgSmartFieldType.DateTime,
        "select" => SgSmartFieldType.Select,
        "password" => SgSmartFieldType.Password,
        "email" => SgSmartFieldType.Email,
        _ => SgSmartFieldType.Text
    };
}
