@namespace SuperUI.Components
@implements IAsyncDisposable
@using SuperUI.Localization
@using SuperUI.Enums
@using Microsoft.JSInterop
@inject ISuperUILocalizer Localizer
@inject IJSRuntime JS

<div class="@GetRootClasses()"
     role="combobox"
     aria-expanded="@(_open ? "true" : "false")"
     aria-haspopup="tree"
     aria-disabled="@(Disabled ? "true" : null)"
     @ref="_rootRef"
     tabindex="@(Disabled ? "-1" : "0")"
     @onkeydown="OnRootKeyDownAsync"
     @onfocusin="() => _focusWithin = true"
     @onfocusout="HandleFocusOutAsync">
    <div class="sgc-treeselect-control" @onclick="ToggleAsync">
        @{ var selectedKeys = GetSelectedKeys(); }
        @if (Prefix != null) { @Prefix }
        @if (Multiple)
        {
            @if (selectedKeys.Count == 0)
            {
                <span class="sgc-treeselect-placeholder">@Placeholder</span>
            }
            else
            {
                var displayKeys = GetDisplayKeys(selectedKeys);
                var overflowCount = selectedKeys.Count - displayKeys.Count;
                foreach (var k in displayKeys)
                {
                    var kLocal = k;
                    var label = FindText(Nodes, kLocal) ?? kLocal;
                    <span class="sgc-treeselect-tag">
                        <span class="sgc-treeselect-tag-text">@label</span>
                        @if (!Disabled)
                        {
                            <button type="button"
                                    class="sgc-treeselect-tag-x"
                                    aria-label="@Localizer["TreeSelect_Remove"]"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => RemoveKeyAsync(kLocal)">
                                @ClearIcon
                            </button>
                        }
                    </span>
                }
                @if (overflowCount > 0)
                {
                    <span class="sgc-treeselect-tag sgc-treeselect-tag-overflow">@MaxTagText.Replace("{count}", overflowCount.ToString())</span>
                }
            }
        }
        else
        {
            @if (!string.IsNullOrEmpty(Value))
            {
                if (RenderSelected != null)
                {
                    var n = FindNode(Nodes, Value!);
                    if (n != null) { @RenderSelected(n) } else { <span class="sgc-treeselect-value">@DisplayText</span> }
                }
                else
                {
                    <span class="sgc-treeselect-value">@DisplayText</span>
                }
            }
            else
            {
                <span class="sgc-treeselect-placeholder">@Placeholder</span>
            }
        }
        @if (Clearable && !Disabled && HasSelection)
        {
            <button type="button"
                    class="sgc-treeselect-clear"
                    aria-label="@Localizer["TreeSelect_Clear"]"
                    @onclick:stopPropagation="true"
                    @onclick="ClearAsync">
                @ClearIcon
            </button>
        }
        @if (Loading)
        {
            <span class="sgc-treeselect-loading" aria-hidden="true">
                @LoadingIcon
            </span>
        }
        <span class="sgc-treeselect-caret @(_open ? "sgc-caret-open" : "")" aria-hidden="true">
            @CaretIcon
        </span>
        @if (Suffix != null) { @Suffix }
    </div>
    @if (_open)
    {
        <div class="sgc-treeselect-menu" style="max-height:@CurrentMaxHeight;"
             @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
            @if (ShowSearch)
            {
                <div class="sgc-treeselect-search-wrap">
                    @if (ShowSearchIcon)
                    {
                        <span class="sgc-treeselect-search-icon">@SearchIcon</span>
                    }
                    <input type="text"
                           class="sgc-treeselect-search"
                           placeholder="@SearchPlaceholder"
                           value="@_search"
                           @oninput="OnSearchInput"
                           @ref="_searchInputRef"
                           @onkeydown="OnSearchKeyDownAsync"
                           @onclick:stopPropagation="true" />
                    @if (!string.IsNullOrEmpty(_search))
                    {
                        <span class="sgc-treeselect-search-clear" @onclick="ClearSearch" role="button" tabindex="-1">
                            @ClearIcon
                        </span>
                    }
                </div>
            }
            <div class="sgc-treeselect-tree" role="tree">
                @{ var visible = GetVisibleNodes().ToList(); }
                @if (visible.Count == 0)
                {
                    @if (EmptyContent != null)
                    {
                        @EmptyContent
                    }
                    else
                    {
                        <div class="sgc-treeselect-empty">@EmptyText</div>
                    }
                }
                else
                {
                    foreach (var entry in visible)
                    {
                        @RenderRow(entry)
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    private IJSObjectReference? _jsModule;
    private ElementReference _rootRef;
    private ElementReference _searchInputRef;
    private DotNetObjectReference<SgTreeSelect>? _dotNetRef;
    private bool _open;
    private bool _focusWithin;
    private bool _disposed;
    private string _search = "";
    private string? _focusedKey;
    private readonly HashSet<string> _expanded = new();
    private bool _expandInitialized;
    private readonly Dictionary<string, List<TreeNode>> _lazyLoadedChildren = new();
    private readonly HashSet<string> _loadingNodes = new();
    private List<TreeNode> _remoteSearchResults = new();

    [Parameter, EditorRequired] public List<TreeNode> Nodes { get; set; } = new();
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public IEnumerable<string>? Values { get; set; }
    [Parameter] public EventCallback<IEnumerable<string>> ValuesChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Block { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowSearch { get; set; }
    [Parameter] public string SearchPlaceholder { get; set; } = "";
    [Parameter] public string EmptyText { get; set; } = "";
    [Parameter] public string? Class { get; set; }
    [Parameter] public Func<TreeNode, string>? TextSelector { get; set; }
    [Parameter] public bool Cascade { get; set; } = true;
    [Parameter] public bool Clearable { get; set; }
    [Parameter] public bool LeafOnly { get; set; }
    [Parameter] public bool ExpandAll { get; set; }

    [Parameter] public SgCascaderVariant Variant { get; set; } = SgCascaderVariant.Outlined;
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;
    [Parameter] public SgPlacement Placement { get; set; } = SgPlacement.BottomStart;
    [Parameter] public string? MaxHeight { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public Func<TreeNode, bool>? DisabledOption { get; set; }
    [Parameter] public EventCallback<List<TreeNode>> OnChange { get; set; }
    [Parameter] public RenderFragment<TreeNode>? NodeTemplate { get; set; }
    [Parameter] public RenderFragment? EmptyContent { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter] public RenderFragment? CaretIconOverride { get; set; }
    [Parameter] public RenderFragment? ClearIconOverride { get; set; }
    [Parameter] public RenderFragment? LoadingIconOverride { get; set; }
    [Parameter] public RenderFragment? SearchIconOverride { get; set; }
    [Parameter] public RenderFragment? ExpandIconOverride { get; set; }
    [Parameter] public RenderFragment? CollapseIconOverride { get; set; }
    [Parameter] public RenderFragment? CheckIconOverride { get; set; }
    [Parameter] public RenderFragment? UncheckIconOverride { get; set; }
    [Parameter] public RenderFragment? IndeterminateIconOverride { get; set; }

    // ── New Premium Features ──

    /// <summary>Async callback to load children on expand. When set, node.Children is pre-loaded if non-empty, otherwise lazy.</summary>
    [Parameter] public Func<TreeNode, Task<List<TreeNode>>>? OnLoadChildren { get; set; }

    /// <summary>Async callback for remote search. When set, client-side filtering is replaced by this callback.</summary>
    [Parameter] public Func<string, Task<List<TreeNode>>>? OnSearch { get; set; }

    /// <summary>Max tags shown in multi-select trigger before "+N more". 0 = no limit.</summary>
    [Parameter] public int MaxTagCount { get; set; }

    /// <summary>Custom text for the "+N more" overflow tag. "{count}" is replaced.</summary>
    [Parameter] public string MaxTagText { get; set; } = "+{count} more";

    /// <summary>When true and Cascade=true, parent/child check states are independent (no auto-cascade).</summary>
    [Parameter] public bool CheckStrictly { get; set; }

    /// <summary>Controls which selected values appear as tags in multi-select trigger.</summary>
    [Parameter] public SgTreeSelectShowStrategy ShowCheckedStrategy { get; set; } = SgTreeSelectShowStrategy.All;

    /// <summary>Custom filter function for client-side search. Receives node and query, returns true if it matches.</summary>
    [Parameter] public Func<TreeNode, string, bool>? FilterOption { get; set; }

    /// <summary>Optional comparer to sort children at every level.</summary>
    [Parameter] public Comparison<TreeNode>? SortComparer { get; set; }

    /// <summary>Content rendered before the selected value / tags in the trigger.</summary>
    [Parameter] public RenderFragment? Prefix { get; set; }

    /// <summary>Content rendered after the caret in the trigger.</summary>
    [Parameter] public RenderFragment? Suffix { get; set; }

    /// <summary>Custom template for the selected value display in single-select mode.</summary>
    [Parameter] public RenderFragment<TreeNode>? RenderSelected { get; set; }

    /// <summary>When false, hides the search icon inside the search input.</summary>
    [Parameter] public bool ShowSearchIcon { get; set; } = true;

    /// <summary>When true, the dropdown menu width matches the trigger width.</summary>
    [Parameter] public bool MatchWidth { get; set; }

    /// <summary>When true, scrolls to the selected node when the dropdown opens.</summary>
    [Parameter] public bool ScrollToSelected { get; set; }

    private string CurrentMaxHeight => MaxHeight ?? "300px";

    private RenderFragment CaretIcon => CaretIconOverride ?? _defaultCaret;
    private RenderFragment ClearIcon => ClearIconOverride ?? _defaultClear;
    private RenderFragment LoadingIcon => LoadingIconOverride ?? _defaultLoading;
    private RenderFragment SearchIcon => SearchIconOverride ?? _defaultSearchIcon;
    private RenderFragment ExpandIcon => ExpandIconOverride ?? _defaultExpandIcon;
    private RenderFragment CollapseIcon => CollapseIconOverride ?? _defaultCollapseIcon;
    private RenderFragment CheckedIcon => CheckIconOverride ?? _defaultCheckedIcon;
    private RenderFragment UncheckedIcon => UncheckIconOverride ?? _defaultUncheckedIcon;
    private RenderFragment IndeterminateIcon => IndeterminateIconOverride ?? _defaultIndeterminateIcon;

    private string NodeText(TreeNode n) => TextSelector?.Invoke(n) ?? n.Text;
    private string DisplayText => string.IsNullOrEmpty(Value) ? "" : FindText(Nodes, Value!) ?? Value!;

    private bool HasSelection => Multiple
        ? (Values?.Any() ?? false)
        : !string.IsNullOrEmpty(Value);

    private bool IsDisabled(TreeNode n) => n.Disabled || (DisabledOption?.Invoke(n) ?? false);

    // ── Default Icons ──

    private RenderFragment _defaultCaret => __builder =>
    {
        __builder.AddMarkupContent(0, @"<svg xmlns=""http://www.w3.org/2000/svg"" viewBox=""0 0 20 20"" fill=""currentColor"" width=""16"" height=""16"">
            <path fill-rule=""evenodd"" d=""M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"" clip-rule=""evenodd""/>
        </svg>");
    };

    private RenderFragment _defaultClear => __builder =>
    {
        __builder.AddMarkupContent(0, @"<svg xmlns=""http://www.w3.org/2000/svg"" viewBox=""0 0 20 20"" fill=""currentColor"" width=""14"" height=""14"">
            <path d=""M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z""/>
