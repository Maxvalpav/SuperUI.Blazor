    // ── CSS Classes ──

    private string GetRootClasses()
    {
        var sb = new List<string> { "sgc-treeselect" };
        if (Block) sb.Add("sgc-block");
        if (_open) sb.Add("sgc-open");
        if (Disabled) sb.Add("sgc-disabled");
        if (_focusWithin) sb.Add("sgc-focus");
        if (Size != SgSize.Md) sb.Add($"sgc-treeselect-{Size.ToString().ToLowerInvariant()}");
        if (Variant != SgCascaderVariant.Outlined) sb.Add($"sgc-treeselect-{Variant.ToString().ToLowerInvariant()}");
        if (!string.IsNullOrEmpty(Class)) sb.Add(Class);
        return string.Join(" ", sb);
    }

    private string GetPlacementString() => Placement switch
    {
        SgPlacement.BottomStart => "BottomStart",
        SgPlacement.BottomEnd => "BottomEnd",
        SgPlacement.TopStart => "TopStart",
        SgPlacement.TopEnd => "TopEnd",
        _ => "BottomStart"
    };

    // ── Lifecycle ──

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _jsModule = await JS.InvokeAsync<IJSObjectReference>("import",
                    "./_content/SuperUI/superui-treeselect.js");
                _dotNetRef = DotNetObjectReference.Create(this);
                var placementStr = GetPlacementString();
                await _jsModule.InvokeVoidAsync("attach", _rootRef, _dotNetRef, placementStr, MatchWidth);
            }
            catch
            {
                // JS module not available (e.g., during testing)
            }
        }

        if (_open)
        {
            try
            {
                await _jsModule!.InvokeVoidAsync("repositionMenu", _rootRef);
                if (ScrollToSelected)
                    await _jsModule!.InvokeVoidAsync("scrollToSelected", _rootRef);
            }
            catch { }
        }
    }

    protected override void OnParametersSet()
    {
        if (!_expandInitialized)
        {
            _expandInitialized = true;
            InitExpansion(Nodes);
        }

        if (string.IsNullOrEmpty(Placeholder))
            Placeholder = Localizer["TreeSelect_Placeholder"];
        if (string.IsNullOrEmpty(SearchPlaceholder))
            SearchPlaceholder = Localizer["TreeSelect_SearchPlaceholder"];
        if (string.IsNullOrEmpty(EmptyText))
            EmptyText = Localizer["TreeSelect_EmptyText"];
    }

    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    // ── Expansion ──

    private void InitExpansion(IEnumerable<TreeNode> nodes)
    {
        foreach (var n in nodes)
        {
            if (ExpandAll || n.Expanded) _expanded.Add(n.Key);
            if (n.Children.Count > 0) InitExpansion(n.Children);
        }
    }

    private async Task ToggleExpandAsync(string key)
    {
        if (!_expanded.Add(key))
        {
            _expanded.Remove(key);
            return;
        }

        // Lazy load children
        var node = FindNode(Nodes, key);
        if (node == null) return;
        if (OnLoadChildren != null && node.Children.Count == 0 && !_lazyLoadedChildren.ContainsKey(key))
        {
            _loadingNodes.Add(key);
            StateHasChanged();
            try
            {
                var children = await OnLoadChildren(node);
                // Apply sort if set
                if (SortComparer != null) children.Sort(SortComparer);
                _lazyLoadedChildren[key] = children;
            }
            finally
            {
                _loadingNodes.Remove(key);
            }
        }
    }

    private bool HasChildren(TreeNode node) =>
        (node.Children.Count > 0 || (_lazyLoadedChildren.ContainsKey(node.Key) && _lazyLoadedChildren[node.Key].Count > 0)) && !node.IsLeaf;

    private List<TreeNode> GetChildren(TreeNode node) =>
        node.Children.Count > 0 ? node.Children
            : (_lazyLoadedChildren.TryGetValue(node.Key, out var c) ? c : new List<TreeNode>());

    // ── Selection ──

    private List<string> GetSelectedKeys()
    {
        if (Multiple) return Values?.ToList() ?? new List<string>();
        return string.IsNullOrEmpty(Value) ? new List<string>() : new List<string> { Value! };
    }

    private List<string> GetDisplayKeys(List<string> keys)
    {
        if (MaxTagCount <= 0) return keys;
        if (keys.Count <= MaxTagCount) return keys;

        if (ShowCheckedStrategy == SgTreeSelectShowStrategy.ShowLeaf)
        {
            var leafKeys = keys.Where(k => IsLeafKey(k)).ToList();
            return leafKeys.Take(MaxTagCount).ToList();
        }
        if (ShowCheckedStrategy == SgTreeSelectShowStrategy.ShowParent)
        {
            var parentKeys = keys.Where(k => !IsLeafKey(k)).ToList();
            return parentKeys.Take(MaxTagCount).ToList();
        }

        return keys.Take(MaxTagCount).ToList();
    }

    private bool IsLeafKey(string key)
    {
        var n = FindNode(Nodes, key);
        return n == null || (n.Children.Count == 0 && !HasChildren(n)) || n.IsLeaf;
    }

    private bool IsSelected(string key)
    {
        if (Multiple) return Values?.Contains(key) ?? false;
        return Value == key;
    }

    private string? FindText(List<TreeNode> list, string key)
    {
        foreach (var n in list)
        {
            if (n.Key == key) return NodeText(n);
            var child = FindText(n.Children, key);
            if (child != null) return child;
        }
        return null;
    }

    private TreeNode? FindNode(List<TreeNode> list, string key)
    {
        foreach (var n in list)
        {
            if (n.Key == key) return n;
            var found = FindNode(n.Children, key);
            if (found != null) return found;
        }
        return null;
    }

    // ── Visible rows ──

    private record struct VisibleRow(TreeNode Node, int Level, bool MatchesSearch);

    private IEnumerable<VisibleRow> GetVisibleNodes()
    {
        var query = _search?.Trim() ?? "";
        var hasQuery = !string.IsNullOrEmpty(query);

        // Remote search
        if (OnSearch != null && hasQuery)
        {
            foreach (var n in _remoteSearchResults)
                yield return new VisibleRow(n, 0, true);
            yield break;
        }

        var matched = hasQuery ? CollectMatched(Nodes, query) : null;
        foreach (var r in Walk(Nodes, 0, hasQuery, matched))
            yield return r;
    }

    private HashSet<string> CollectMatched(List<TreeNode> nodes, string query)
    {
        var result = new HashSet<string>();
        bool Visit(TreeNode n)
        {
            var self = FilterOption != null
                ? FilterOption(n, query)
                : NodeText(n).Contains(query, StringComparison.OrdinalIgnoreCase);
            var anyChild = false;
            foreach (var c in n.Children)
                if (Visit(c)) anyChild = true;
            if (self || anyChild) { result.Add(n.Key); return true; }
            return false;
        }
        // Also search lazy-loaded children
        foreach (var (key, children) in _lazyLoadedChildren)
            foreach (var c in children)
                Visit(c);
        foreach (var n in nodes) Visit(n);
        return result;
    }

    private IEnumerable<VisibleRow> Walk(List<TreeNode> nodes, int level, bool hasQuery, HashSet<string>? matched)
    {
        // Apply sort if configured
        if (SortComparer != null && nodes.Count > 1)
        {
            var sorted = nodes.ToList();
            sorted.Sort(SortComparer);
            nodes = sorted;
        }

        foreach (var n in nodes)
        {
            if (hasQuery && (matched == null || !matched.Contains(n.Key))) continue;
            var selfMatches = !hasQuery || (FilterOption != null
                ? FilterOption(n, _search!)
                : NodeText(n).Contains(_search!, StringComparison.OrdinalIgnoreCase));
            yield return new VisibleRow(n, level, selfMatches);
            var open = hasQuery || _expanded.Contains(n.Key);
            if (open && HasChildren(n))
            {
                var children = GetChildren(n);
                if (children.Count > 0)
                {
                    foreach (var r in Walk(children, level + 1, hasQuery, matched))
                        yield return r;
                }
            }
        }
    }

    // ── Check state ──

    private enum CheckState { Unchecked, Checked, Indeterminate }

    private CheckState GetCheckState(TreeNode node)
    {
        if (!Multiple) return IsSelected(node.Key) ? CheckState.Checked : CheckState.Unchecked;
        var values = Values?.ToHashSet() ?? new HashSet<string>();
        if (!Cascade || CheckStrictly)
            return values.Contains(node.Key) ? CheckState.Checked : CheckState.Unchecked;
        if (node.Children.Count == 0)
            return values.Contains(node.Key) ? CheckState.Checked : CheckState.Unchecked;
        var (total, checkedCount) = CountLeafState(node, values);
        if (checkedCount == 0) return CheckState.Unchecked;
        if (checkedCount == total) return CheckState.Checked;
        return CheckState.Indeterminate;
    }

    private (int total, int @checked) CountLeafState(TreeNode node, HashSet<string> values)
    {
        if (node.Children.Count == 0)
            return (1, values.Contains(node.Key) ? 1 : 0);
        int total = 0, ch = 0;
        foreach (var c in node.Children)
        {
            var (t, k) = CountLeafState(c, values);
            total += t; ch += k;
        }
        return (total, ch);
    }

    private void CollectLeafKeys(TreeNode node, List<string> bag)
    {
        if (node.Children.Count == 0) { bag.Add(node.Key); return; }
        foreach (var c in node.Children) CollectLeafKeys(c, bag);
    }

    private void CollectAllKeys(TreeNode node, List<string> bag)
    {
        bag.Add(node.Key);
        foreach (var c in node.Children) CollectAllKeys(c, bag);
    }

    private List<TreeNode> CollectSelectedNodes()
    {
        var keys = GetSelectedKeys();
        var result = new List<TreeNode>();
        foreach (var k in keys)
        {
            var n = FindNode(Nodes, k);
            if (n != null) result.Add(n);
        }
        return result;
    }

    private async Task NotifyOnChangeAsync()
    {
        if (OnChange.HasDelegate)
            await OnChange.InvokeAsync(CollectSelectedNodes());
    }

    private async Task ToggleAsync()
    {
        if (Disabled) return;
        _open = !_open;
        if (_open)
        {
            _focusedKey ??= GetVisibleNodes().FirstOrDefault().Node?.Key;
            if (ShowSearch)
            {
                await Task.Delay(50);
                try { await _searchInputRef.FocusAsync(); } catch { }
            }
        }
        if (OpenChanged.HasDelegate)
            await OpenChanged.InvokeAsync(_open);
        StateHasChanged();
    }

    // ── Row click ──

    private async Task OnRowClickAsync(TreeNode node)
    {
        if (Disabled || IsDisabled(node)) return;
        if (Multiple)
        {
            await ToggleNodeAsync(node);
        }
        else
        {
            if (LeafOnly && HasChildren(node) && !node.IsLeaf)
            {
                await ToggleExpandAsync(node.Key);
                return;
            }
            await SelectSingleAsync(node.Key);
        }
    }

    private async Task SelectSingleAsync(string key)
    {
        Value = key;
        _open = false;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(key);
        await NotifyOnChangeAsync();
        if (OpenChanged.HasDelegate) await OpenChanged.InvokeAsync(false);
        StateHasChanged();
    }

    private async Task ToggleNodeAsync(TreeNode node)
    {
        if (IsDisabled(node)) return;
        var current = (Values?.ToList()) ?? new List<string>();
        var set = new HashSet<string>(current);
        var state = GetCheckState(node);
        var willCheck = state != CheckState.Checked;

        if (Cascade && !CheckStrictly)
        {
            var keys = new List<string>();
            if (LeafOnly) CollectLeafKeys(node, keys); else CollectAllKeys(node, keys);
            if (willCheck) foreach (var k in keys) set.Add(k);
            else foreach (var k in keys) set.Remove(k);
            if (!LeafOnly) RecomputeAncestors(set);
        }
        else
        {
            if (willCheck) set.Add(node.Key); else set.Remove(node.Key);
        }

        var newList = set.ToList();
        Values = newList;
        if (ValuesChanged.HasDelegate) await ValuesChanged.InvokeAsync(newList);
        await NotifyOnChangeAsync();
        StateHasChanged();
    }

    private void RecomputeAncestors(HashSet<string> set)
    {
        bool Visit(TreeNode n)
        {
            if (n.Children.Count == 0) return set.Contains(n.Key);
            var allChecked = true;
            foreach (var c in n.Children)
                if (!Visit(c)) allChecked = false;
            if (allChecked) set.Add(n.Key); else set.Remove(n.Key);
            return allChecked;
        }
        foreach (var r in Nodes) Visit(r);
    }

    private async Task RemoveKeyAsync(string key)
    {
        var node = FindNode(Nodes, key);
        if (node != null) { await ToggleNodeAsync(node); return; }
        var set = (Values?.ToHashSet()) ?? new HashSet<string>();
        set.Remove(key);
        var newList = set.ToList();
        Values = newList;
        if (ValuesChanged.HasDelegate) await ValuesChanged.InvokeAsync(newList);
        await NotifyOnChangeAsync();
        StateHasChanged();
    }

    private async Task ClearAsync()
    {
        if (Multiple)
        {
            Values = Array.Empty<string>();
            if (ValuesChanged.HasDelegate) await ValuesChanged.InvokeAsync(Array.Empty<string>());
        }
        else
        {
            Value = null;
            if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(null);
        }
        await NotifyOnChangeAsync();
        StateHasChanged();
    }

    // ── Focus ──

    private async Task HandleFocusOutAsync(FocusEventArgs e)
    {
        await Task.Delay(160);
        if (_open && !_focusWithin)
        {
            _open = false;
            if (OpenChanged.HasDelegate) await OpenChanged.InvokeAsync(false);
            StateHasChanged();
        }
        _focusWithin = false;
    }

    // ── Search ──

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";

        if (OnSearch != null && !string.IsNullOrEmpty(_search))
        {
            try
            {
                _remoteSearchResults = await OnSearch(_search);
            }
            catch
            {
                _remoteSearchResults = new();
            }
        }

        var first = GetVisibleNodes().FirstOrDefault();
        _focusedKey = first.Node?.Key;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _search = "";
        _remoteSearchResults = new();
        _focusedKey = GetVisibleNodes().FirstOrDefault().Node?.Key;
        StateHasChanged();
    }

    // ── Keyboard ──

    private async Task OnRootKeyDownAsync(KeyboardEventArgs e)
    {
        if (Disabled) return;
        if (!_open)
        {
            if (e.Key == "Enter" || e.Key == " " || e.Key == "ArrowDown")
                await ToggleAsync();
            return;
        }
        await HandleMenuKeyAsync(e);
    }

    private Task OnSearchKeyDownAsync(KeyboardEventArgs e) => HandleMenuKeyAsync(e);

    private async Task HandleMenuKeyAsync(KeyboardEventArgs e)
    {
        var rows = GetVisibleNodes().ToList();
        if (rows.Count == 0)
        {
            if (e.Key == "Escape") { _open = false; StateHasChanged(); }
            return;
        }
        var idx = _focusedKey == null ? -1 : rows.FindIndex(r => r.Node.Key == _focusedKey);

        switch (e.Key)
        {
            case "ArrowDown":
                idx = idx < 0 ? 0 : Math.Min(rows.Count - 1, idx + 1);
                _focusedKey = rows[idx].Node.Key;
                await InvokeAsync(StateHasChanged);
                break;
            case "ArrowUp":
                idx = idx <= 0 ? 0 : idx - 1;
                _focusedKey = rows[idx].Node.Key;
                await InvokeAsync(StateHasChanged);
                break;
            case "ArrowRight":
                if (idx >= 0)
                {
                    var n = rows[idx].Node;
                    if (n.Children.Count > 0 && !_expanded.Contains(n.Key))
                    {
                        _expanded.Add(n.Key);
                        await InvokeAsync(StateHasChanged);
                    }
                    else if (n.Children.Count > 0 && idx + 1 < rows.Count)
                    {
                        _focusedKey = rows[idx + 1].Node.Key;
                        await InvokeAsync(StateHasChanged);
                    }
                }
                break;
            case "ArrowLeft":
                if (idx >= 0)
                {
                    var n = rows[idx].Node;
                    if (n.Children.Count > 0 && _expanded.Contains(n.Key))
                    {
                        _expanded.Remove(n.Key);
                        await InvokeAsync(StateHasChanged);
                    }
                    else
                    {
                        var lvl = rows[idx].Level;
                        for (var p = idx - 1; p >= 0; p--)
                        {
                            if (rows[p].Level < lvl) { _focusedKey = rows[p].Node.Key; break; }
                        }
                        await InvokeAsync(StateHasChanged);
                    }
                }
                break;
            case "Home":
                _focusedKey = rows[0].Node.Key;
                await InvokeAsync(StateHasChanged);
                break;
            case "End":
                _focusedKey = rows[^1].Node.Key;
                await InvokeAsync(StateHasChanged);
                break;
            case "Enter":
            case " ":
                if (idx >= 0) await OnRowClickAsync(rows[idx].Node);
                break;
            case "Escape":
                _open = false;
                if (OpenChanged.HasDelegate) await OpenChanged.InvokeAsync(false);
                await InvokeAsync(StateHasChanged);
                break;
        }
    }

    // ── JSInvokable ──

    [JSInvokable]
    public async Task CloseFromJsAsync()
    {
        if (_open)
        {
            _open = false;
            _focusWithin = false;
            if (OpenChanged.HasDelegate) await OpenChanged.InvokeAsync(false);
            StateHasChanged();
        }
    }

    // ── Row Rendering ──

    private static string HighlightMatch(string text, string query)
    {
        if (string.IsNullOrEmpty(query)) return text;
        var idx = text.IndexOf(query, StringComparison.CurrentCultureIgnoreCase);
        if (idx < 0) return text;
        var before = text[..idx];
        var match = text.Substring(idx, query.Length);
        var after = text[(idx + query.Length)..];
        return $"{before}<mark>{match}</mark>{after}";
    }

    private RenderFragment RenderRow(VisibleRow row) => __builder =>
    {
        var node = row.Node;
        var level = row.Level;
        var checkState = GetCheckState(node);
        var isSelected = !Multiple && IsSelected(node.Key);
        var isFocused = _focusedKey == node.Key;
        var hasChildren = node.Children.Count > 0 && !node.IsLeaf;
        var isExpanded = _expanded.Contains(node.Key) || !string.IsNullOrEmpty(_search?.Trim());
        var disabledLeafSelect = !Multiple && LeafOnly && hasChildren;
        var isDisabled = IsDisabled(node);

        var optClasses = "sgc-treeselect-row";
        if (isSelected) optClasses += " sgc-selected";
        if (isFocused) optClasses += " sgc-focused";
        if (disabledLeafSelect) optClasses += " sgc-non-selectable";
        if (isDisabled) optClasses += " sgc-disabled-option";
        if (!string.IsNullOrEmpty(node.CssClass)) optClasses += " " + node.CssClass;

        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "class", optClasses);
        __builder.AddAttribute(2, "role", "treeitem");
        __builder.AddAttribute(3, "aria-level", (level + 1).ToString());
        __builder.AddAttribute(4, "aria-selected", isSelected ? "true" : "false");
        __builder.AddAttribute(5, "aria-disabled", isDisabled ? "true" : "false");
        if (hasChildren) __builder.AddAttribute(6, "aria-expanded", isExpanded ? "true" : "false");
        __builder.AddAttribute(7, "style", $"padding-left: {8 + level * 16}px");

        if (!isDisabled)
        {
            __builder.AddAttribute(8, "onclick", EventCallback.Factory.Create(this, () => OnRowClickAsync(node)));
        }

        // Expand/Collapse toggle
        __builder.OpenElement(10, "span");
        __builder.AddAttribute(11, "class", "sgc-treeselect-toggle" + (hasChildren ? "" : " sgc-empty"));
        if (hasChildren)
        {
            __builder.AddAttribute(12, "onclick",
                EventCallback.Factory.Create<MouseEventArgs>(this, async _ =>
                {
                    await ToggleExpandAsync(node.Key);
                    StateHasChanged();
                }));
            __builder.AddEventStopPropagationAttribute(13, "onclick", true);
            if (isExpanded)
                __builder.AddContent(14, CollapseIcon);
            else
                __builder.AddContent(14, ExpandIcon);
        }
        __builder.CloseElement();

        // Checkbox (multi-select)
        if (Multiple)
        {
            __builder.OpenElement(20, "span");
            if (checkState == CheckState.Checked)
            {
                __builder.AddAttribute(21, "class", "sgc-treeselect-checkbox-icon sgc-checked");
                __builder.AddContent(22, CheckedIcon);
            }
            else if (checkState == CheckState.Indeterminate)
            {
                __builder.AddAttribute(21, "class", "sgc-treeselect-checkbox-icon sgc-indeterminate");
                __builder.AddContent(22, IndeterminateIcon);
            }
            else
            {
                __builder.AddAttribute(21, "class", "sgc-treeselect-checkbox-icon sgc-unchecked");
                __builder.AddContent(22, UncheckedIcon);
            }
            __builder.CloseElement();
        }

        // Custom template
        if (NodeTemplate != null)
        {
            __builder.AddContent(25, NodeTemplate(node));
        }
        else
        {
            // Icon
            if (!string.IsNullOrEmpty(node.Icon))
            {
                __builder.OpenElement(30, "span");
                __builder.AddAttribute(31, "class", "sgc-treeselect-icon");
                __builder.AddContent(32, node.Icon);
                __builder.CloseElement();
            }

            // Label (with highlight when search matches)
            __builder.OpenElement(40, "span");
            __builder.AddAttribute(41, "class", "sgc-treeselect-label");
            if (row.MatchesSearch && !string.IsNullOrEmpty(_search))
            {
                __builder.AddMarkupContent(42, HighlightMatch(NodeText(node), _search));
            }
            else
            {
                __builder.AddContent(42, NodeText(node));
            }
            __builder.CloseElement();

            // Badge
            if (!string.IsNullOrEmpty(node.BadgeText))
            {
                __builder.OpenElement(50, "span");
                __builder.AddAttribute(51, "class",
                    $"sgc-treeselect-badge sgc-badge-{node.BadgeVariant.ToString().ToLowerInvariant()}");
                __builder.AddContent(52, node.BadgeText);
                __builder.CloseElement();
            }
        }

        __builder.CloseElement();
    };

    // ── Dispose ──

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        _dotNetRef?.Dispose();
        if (_jsModule != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("detach", _rootRef);
                await _jsModule.DisposeAsync();
            }
            catch { }
        }
    }
}
