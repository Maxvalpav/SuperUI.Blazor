@namespace SuperUI.Components
@inherits SgComponentBase
@implements IDisposable

@* Invisible — tracks form dirty state *@

@code {
    /// <summary>Fires when the dirty state changes.</summary>
    [Parameter] public EventCallback<bool> IsDirtyChanged { get; set; }

    /// <summary>Whether the form has been marked as dirty.</summary>
    public bool IsDirty { get; private set; }

    /// <summary>Marks the form as dirty and fires <see cref="IsDirtyChanged"/>.</summary>
    public void MarkDirty()
    {
        if (IsDirty) return;
        IsDirty = true;
        _ = IsDirtyChanged.InvokeAsync(true);
    }

    /// <summary>Resets the dirty state and fires <see cref="IsDirtyChanged"/>.</summary>
    public void Reset()
    {
        if (!IsDirty) return;
        IsDirty = false;
        _ = IsDirtyChanged.InvokeAsync(false);
    }

    /// <summary>Clears dirty state without firing the event.</summary>
    public void SilentReset() => IsDirty = false;

    public void Dispose() { /* no resources */ }
}
