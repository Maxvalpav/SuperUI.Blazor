    private void RecomputeDerived()
    {
        var valid = ValidateFields(_currentExpression);

        if (ShowNextFireTimes)
            _nextFireTimes = CalculateNextFireTimes(_currentExpression, NextFireCount);

        if (ShowCalendar)
            BuildCalendar();

        if (ShowComplexity)
        {
            (_complexity, _complexityClass) = EvaluateComplexity(_currentExpression);
        }

        if (ShowIcalExport)
        {
            _icalRule = ToIcalRule(_currentExpression);
        }

        var isValid = valid && string.IsNullOrEmpty(ErrorText);
        if (isValid != _previousValid)
        {
            _previousValid = isValid;
            if (OnValidationChanged.HasDelegate)
                _ = OnValidationChanged.InvokeAsync(isValid);
        }
    }

