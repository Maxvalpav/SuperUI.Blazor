        StateHasChanged();
    }

    private string BuildExpression()
    {
        var minutes = BuildField(_state.MinuteMode, _state.MinuteEvery, _state.Minutes, _state.MinuteRangeFrom, _state.MinuteRangeTo, isWeek: false, isDay: false);
        var hours = BuildField(_state.HourMode, _state.HourEvery, _state.Hours, _state.HourRangeFrom, _state.HourRangeTo, isWeek: false, isDay: false);
        string days;
        if (_state.DayMode == CronMode.LastDay) days = "L";
        else days = BuildField(_state.DayMode, _state.DayEvery, _state.Days, 1, 28, isWeek: false, isDay: true);
        var months = BuildField(_state.MonthMode, _state.MonthEvery, _state.Months, 1, 12, isWeek: false, isDay: false);
        var week = BuildField(_state.WeekMode, 1, _state.WeekDays, 0, 6, isWeek: true, isDay: false);

        if (_state.WeekMode == CronMode.Specific && _state.DayMode == CronMode.Any)
        {
            days = "?";
        }
        else if (_state.WeekMode == CronMode.Any && _state.DayMode != CronMode.Any)
        {
            week = "*";
        }

        return $"{minutes} {hours} {days} {months} {week}";
    }

    private static string BuildField(CronMode mode, int every, HashSet<int> set, int from, int to, bool isWeek, bool isDay)
    {
        switch (mode)
        {
            case CronMode.Any:
                return isWeek ? "*" : "*";
            case CronMode.Every:
                return every <= 1 ? "*" : $"*/{every}";
            case CronMode.Specific:
                if (set.Count == 0) return "*";
                return string.Join(",", set.OrderBy(i => i));
            case CronMode.Range:
                return $"{from}-{to}";
            default:
                return "*";
        }
    }

    private void ParseExpression(string raw)
    {
        var parts = raw.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length != 5) parts = new[] { "*", "*", "*", "*", "*" };

        _state = new CronState();
        ParseField(parts[0], 0, 59, ref _state.MinuteMode, ref _state.MinuteEvery, _state.Minutes, ref _state.MinuteRangeFrom, ref _state.MinuteRangeTo);
        ParseField(parts[1], 0, 23, ref _state.HourMode, ref _state.HourEvery, _state.Hours, ref _state.HourRangeFrom, ref _state.HourRangeTo);
        if (parts[2] == "L")
        {
            _state.DayMode = CronMode.LastDay;
        }
        else if (parts[2] == "?")
        {
            _state.DayMode = CronMode.Any;
        }
        else
        {
            int d1 = 1, d2 = 28;
            ParseField(parts[2], 1, 31, ref _state.DayMode, ref _state.DayEvery, _state.Days, ref d1, ref d2);
        }
        int m1 = 1, m2 = 12;
        ParseField(parts[3], 1, 12, ref _state.MonthMode, ref _state.MonthEvery, _state.Months, ref m1, ref m2);

        ParseWeek(parts[4]);

        _currentExpression = BuildExpression();
        _humanReadable = HumanReadable(_currentExpression);
        RecomputeDerived();
    }

    private void ParseWeek(string token)
    {
        if (token == "*" || token == "?")
        {
            _state.WeekMode = CronMode.Any;
            _state.WeekDays.Clear();
            return;
        }
        _state.WeekMode = CronMode.Specific;
        _state.WeekDays.Clear();
        foreach (var part in token.Split(','))
        {
            if (part.Contains('-'))
            {
                var rr = part.Split('-');
                if (int.TryParse(rr[0], out var a) && int.TryParse(rr[1], out var b))
                {
                    for (int i = a; i <= b; i++) _state.WeekDays.Add(i % 7);
                }
            }
            else if (int.TryParse(part, out var v))
            {
                _state.WeekDays.Add(v % 7);
            }
        }
        if (_state.WeekDays.Count == 0) _state.WeekMode = CronMode.Any;
    }

    private static void ParseField(string token, int min, int max, ref CronMode mode, ref int every, HashSet<int> set, ref int rFrom, ref int rTo)
    {
        set.Clear();
        if (token == "*")
        {
            mode = CronMode.Any;
            return;
        }
        if (token.StartsWith("*/") && int.TryParse(token[2..], out var step))
        {
            mode = CronMode.Every;
            every = step;
            return;
        }
        if (token.Contains('-') && !token.Contains(','))
        {
            var rr = token.Split('-');
            if (int.TryParse(rr[0], out var a) && int.TryParse(rr[1], out var b))
            {
                mode = CronMode.Range;
                rFrom = Math.Clamp(a, min, max);
                rTo = Math.Clamp(b, min, max);
                return;
            }
        }
        mode = CronMode.Specific;
        foreach (var part in token.Split(','))
        {
            if (part.Contains('-'))
            {
                var rr = part.Split('-');
                if (int.TryParse(rr[0], out var a) && int.TryParse(rr[1], out var b))
                {
                    for (int i = a; i <= b; i++) set.Add(i);
                }
            }
            else if (int.TryParse(part, out var v))
            {
                set.Add(v);
            }
        }
        if (set.Count == 0) mode = CronMode.Any;
    }

    private string HumanReadable(string expr) => SgCronHumanizer.Describe(expr, UseEnglish);

