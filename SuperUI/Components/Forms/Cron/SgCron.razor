    protected override void OnInitialized()
    {
        _binder = new SgEditContextBinder<string?>(StateHasChanged);
        if (string.IsNullOrWhiteSpace(Value))
        {
            Value = "* * * * *";
        }
        ParseExpression(Value!);
        InitTimeZones();
        InitLibrary();
        Recompute();
    }

    protected override void OnParametersSet()
    {
        _binder?.Update(CascadedEditContext, ValueExpression);
        if (_suppressBindBack)
        {
            _suppressBindBack = false;
            return;
        }
        if (!string.IsNullOrWhiteSpace(Value) && Value != _currentExpression)
        {
            ParseExpression(Value!);
        }
        if (TimeZoneId != _selectedTimeZone?.Id)
        {
            ApplyTimeZoneId(TimeZoneId);
        }
    }

    private void InitTimeZones()
    {
        try
        {
            _timeZones = TimeZoneInfo.GetSystemTimeZones().ToList();
        }
        catch
        {
            _timeZones = new List<TimeZoneInfo> { TimeZoneInfo.Utc, TimeZoneInfo.Local };
        }
        ApplyTimeZoneId(TimeZoneId);
    }

    private void ApplyTimeZoneId(string? tzId)
    {
        if (string.IsNullOrEmpty(tzId))
        {
            _selectedTimeZone = null;
            return;
        }
        try
        {
            _selectedTimeZone = TimeZoneInfo.FindSystemTimeZoneById(tzId);
        }
        catch
        {
            _selectedTimeZone = _timeZones.FirstOrDefault(t => t.Id == tzId);
        }
    }

    private async Task OnTimeZoneSelectedAsync(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        _selectedTimeZone = _timeZones.FirstOrDefault(t => t.Id == id);
        Recompute();
        if (OnTimeZoneChanged.HasDelegate)
            await OnTimeZoneChanged.InvokeAsync(id ?? "");
    }

