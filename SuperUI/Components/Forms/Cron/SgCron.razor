@namespace SuperUI.Components
@using System.Linq.Expressions
@using System.Text
@using SuperUI.Localization
@implements IDisposable
@inject ISuperUILocalizer Localizer

<div class="sgc-field sgc-cron @(Block ? "sgc-block" : "") @(Compact ? "sgc-cron-compact" : "") @CssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sgc-label @(Required ? "sgc-required" : "")">@Label</label>
    }

    <div class="sgc-cron-shell @(Disabled ? "sgc-disabled" : "") @(IsInvalid ? "sgc-invalid" : "")">

        <div class="sgc-cron-tabs" role="tablist">
            @foreach (var tab in GetTabs())
            {
                var t = tab;
                <button type="button"
                        class="sgc-cron-tab @(_activeTab == t.Key ? "sgc-active" : "")"
                        role="tab"
                        aria-selected="@(_activeTab == t.Key ? "true" : "false")"
                        title="@t.Label"
                        disabled="@Disabled"
                        @onclick="() => SetTabAsync(t.Key)">
                    <span class="sgc-cron-tab-icon" aria-hidden="true">@t.Icon</span>
                    <span class="sgc-cron-tab-label">@t.Label</span>
                </button>
            }
        </div>

        <div class="sgc-cron-body">
            @switch (_activeTab)
            {
                case CronTab.Minutes:
                    @RenderMode(_state.MinuteMode, m => UpdateMode(p => p.MinuteMode = m), GetMinuteOptions())
                    @if (_state.MinuteMode == CronMode.Every)
                    {
                        @RenderEvery(_state.MinuteEvery, 1, 59, Localizer["Cron_Min"], v => UpdateState(s => s.MinuteEvery = v))
                    }
                    else if (_state.MinuteMode == CronMode.Specific)
                    {
                        @RenderGrid(0, 59, _state.Minutes, ToggleMinute, columns: Compact ? 12 : 10, label: Localizer["Cron_Minutes"])
                    }
                    else if (_state.MinuteMode == CronMode.Range)
                    {
                        @RenderRange(_state.MinuteRangeFrom, _state.MinuteRangeTo, 0, 59,
                            f => UpdateState(s => s.MinuteRangeFrom = f),
                            t => UpdateState(s => s.MinuteRangeTo = t))
                    }
                    break;

                case CronTab.Hours:
                    @RenderMode(_state.HourMode, m => UpdateMode(p => p.HourMode = m), GetHourOptions())
                    @if (_state.HourMode == CronMode.Every)
                    {
                        @RenderEvery(_state.HourEvery, 1, 23, Localizer["Cron_Hour"], v => UpdateState(s => s.HourEvery = v))
                    }
                    else if (_state.HourMode == CronMode.Specific)
                    {
                        @RenderGrid(0, 23, _state.Hours, ToggleHour, columns: Compact ? 12 : 8, label: Localizer["Cron_Hours"])
                    }
                    else if (_state.HourMode == CronMode.Range)
                    {
                        @RenderRange(_state.HourRangeFrom, _state.HourRangeTo, 0, 23,
                            f => UpdateState(s => s.HourRangeFrom = f),
                            t => UpdateState(s => s.HourRangeTo = t))
                    }
                    break;

                case CronTab.Days:
                    @RenderMode(_state.DayMode, m => UpdateMode(p => p.DayMode = m), GetDayOptions())
                    @if (_state.DayMode == CronMode.Every)
                    {
                        @RenderEvery(_state.DayEvery, 1, 31, Localizer["Cron_Days"], v => UpdateState(s => s.DayEvery = v))
                    }
                    else if (_state.DayMode == CronMode.Specific)
                    {
                        @RenderGrid(1, 31, _state.Days, ToggleDay, columns: Compact ? 10 : 8, label: Localizer["Cron_Specific"])
                    }
                    else if (_state.DayMode == CronMode.LastDay)
                    {
                        <div class="sgc-cron-info">@Localizer["Cron_LastDayOfMonth"]</div>
                    }
                    break;

                case CronTab.Months:
                    @RenderMode(_state.MonthMode, m => UpdateMode(p => p.MonthMode = m), GetMonthOptions())
                    @if (_state.MonthMode == CronMode.Every)
                    {
                        @RenderEvery(_state.MonthEvery, 1, 12, Localizer["Cron_Months"], v => UpdateState(s => s.MonthEvery = v))
                    }
                    else if (_state.MonthMode == CronMode.Specific)
                    {
                        <div class="sgc-cron-section">
                            <div class="sgc-cron-section-title">@Localizer["Cron_SpecificMonths"]</div>
                            <div class="sgc-cron-chips">
                                @for (int i = 0; i < GetMonthNames().Length; i++)
                                {
                                    var idx = i + 1;
                                    var name = GetMonthNames()[i];
                                    var on = _state.Months.Contains(idx);
                                    <button type="button"
                                            class="sgc-cron-chip @(on ? "sgc-on" : "")"
                                            disabled="@Disabled"
                                            @onclick="() => ToggleMonth(idx)">
                                        @name
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    break;

                case CronTab.WeekDays:
                    @RenderMode(_state.WeekMode, m => UpdateMode(p => p.WeekMode = m), GetWeekOptions())
                    @if (_state.WeekMode == CronMode.Specific)
                    {
                        <div class="sgc-cron-section">
                            <div class="sgc-cron-section-title">@Localizer["Cron_SpecificWeekDays"]</div>
                            <div class="sgc-cron-week">
                                @for (int i = 0; i < GetWeekDayNames().Length; i++)
                                {
                                    var idx = i;
                                    var name = GetWeekDayNames()[i];
                                    var on = _state.WeekDays.Contains(idx);
                                    <button type="button"
                                            class="sgc-cron-day @(on ? "sgc-on" : "") @(idx == 0 || idx == 6 ? "sgc-weekend" : "")"
                                            disabled="@Disabled"
                                            @onclick="() => ToggleWeekDay(idx)">
                                        @name
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    break;
            }
        </div>

        @if (ShowPreview)
        {
            <div class="sgc-cron-preview">
            @if (ShowExpressionTokens)
            {
                var exprParts = _currentExpression?.Split(' ', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
                <div class="sgc-cron-fields">
                    <div class="sgc-cron-field-group">
                        <span class="sgc-cron-field-label">@L("Cron_Minutes")</span>
                        <code class="sgc-cron-token">@(exprParts.Length > 0 ? exprParts[0] : "*")</code>
                    </div>
                    <div class="sgc-cron-field-group">
                        <span class="sgc-cron-field-label">@L("Cron_Hours")</span>
                        <code class="sgc-cron-token">@(exprParts.Length > 1 ? exprParts[1] : "*")</code>
                    </div>
                    <div class="sgc-cron-field-group">
                        <span class="sgc-cron-field-label">@L("Cron_Day")</span>
                        <code class="sgc-cron-token">@(exprParts.Length > 2 ? exprParts[2] : "*")</code>
                    </div>
                    <div class="sgc-cron-field-group">
                        <span class="sgc-cron-field-label">@L("Cron_Month")</span>
                        <code class="sgc-cron-token">@(exprParts.Length > 3 ? exprParts[3] : "*")</code>
                    </div>
                    <div class="sgc-cron-field-group">
                        <span class="sgc-cron-field-label">@L("Cron_Week")</span>
                        <code class="sgc-cron-token">@(exprParts.Length > 4 ? exprParts[4] : "*")</code>
                    </div>
                </div>
            }

            <div class="sgc-cron-summary">
                <div class="sgc-cron-summary-row">
                    <span class="sgc-cron-summary-icon" aria-hidden="true">⏱</span>
                    <code class="sgc-cron-expression">@_currentExpression</code>
                    <button type="button"
                            class="sgc-cron-copy"
                            title="@Localizer["Cron_Copy"]"
                            disabled="@Disabled"
                            @onclick="CopyAsync">
                        @if (_copied)
                        {
                            <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"/></svg>
                            <span>@Localizer["Cron_Copied"]</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"/><path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"/></svg>
                            <span>@Localizer["Cron_Copy"]</span>
                        }
                    </button>
                </div>
                @if (ShowHumanReadable)
                {
                    <div class="sgc-cron-human">@_humanReadable</div>
                }
            </div>

            @* ── TimeZone & Complexity toolbar ─────────────────────────────── *@
            @if (ShowTimeZone || ShowComplexity || ShowIcalExport)
            {
                <div class="sgc-cron-toolbar">
                    @if (ShowTimeZone)
                    {
                        <div class="sgc-cron-tz">
                            <label class="sgc-cron-tz-label">@T("Cron_TimeZone", "Time zone")</label>
                            <select class="sgc-cron-tz-select"
                                    disabled="@Disabled"
                                    @onchange="OnTimeZoneSelectedAsync">
                                @foreach (var tz in _timeZones)
                                {
                                    <option value="@tz.Id" selected="@(_selectedTimeZone?.Id == tz.Id)">@tz.DisplayName</option>
                                }
                            </select>
                        </div>
                    }
                    @if (ShowComplexity && !string.IsNullOrEmpty(_complexity))
                    {
                        <span class="sgc-cron-complexity sgc-cron-complexity-@_complexityClass" title="@T("Cron_ComplexityHint", "Expression complexity")">
                            <span class="sgc-cron-complexity-dot" aria-hidden="true"></span>
                            @_complexity
                        </span>
                    }
                    @if (ShowIcalExport)
                    {
                        <button type="button"
                                class="sgc-cron-ical-btn"
                                title="@T("Cron_CopyIcal", "Copy iCal RRULE")"
                                disabled="@(_icalRule is null || Disabled)"
                                @onclick="CopyIcalAsync">
                            @if (_icalCopied)
                            {
                                <span>@T("Cron_Copied", "Copied!")</span>
                            }
                            else
                            {
                                <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2Zm4.5 4.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0ZM8 6a.5.5 0 0 1 .5.5v5a.5.5 0 0 1-1 0V6.5A.5.5 0 0 1 8 6Zm3 .5v4a.5.5 0 0 1-1 0v-4a.5.5 0 0 1 1 0Z"/></svg>
                                <span>iCal</span>
                            }
                        </button>
                    }
                </div>
            }

            @* ── Next fire times ────────────────────────────────────────────── *@
            @if (ShowNextFireTimes && _nextFireTimes.Count > 0)
            {
                <div class="sgc-cron-section sgc-cron-nextfires">
                    <div class="sgc-cron-section-title">@T("Cron_NextFireTimes", "Next fire times")</div>
                    <ol class="sgc-cron-nextfires-list">
                        @foreach (var dt in _nextFireTimes)
                        {
                            <li>
                                <span class="sgc-cron-nextfires-date">@dt.ToString("ddd, dd MMM yyyy HH:mm")</span>
                                <span class="sgc-cron-nextfires-rel">@GetRelativeTime(dt)</span>
                            </li>
                        }
                    </ol>
                </div>
            }

            @* ── Calendar preview ──────────────────────────────────────────── *@
            @if (ShowCalendar)
            {
                <div class="sgc-cron-section sgc-cron-cal">
                    <div class="sgc-cron-cal-head">
                        <button type="button" class="sgc-cron-cal-nav" disabled="@Disabled" @onclick="() => NavigateCalendar(-1)" title="@T("Calendar_PrevMonth", "Previous month")">◀</button>
                        <span class="sgc-cron-cal-title">@_calendarDate.ToString("MMMM yyyy")</span>
                        <button type="button" class="sgc-cron-cal-nav" disabled="@Disabled" @onclick="() => NavigateCalendar(1)" title="@T("Calendar_NextMonth", "Next month")">▶</button>
                    </div>
                    <div class="sgc-cron-cal-grid">
                        <span class="sgc-cron-cal-dow">@T("Cron_Mon", "Mo")</span>
                        <span class="sgc-cron-cal-dow">@T("Cron_Tue", "Tu")</span>
                        <span class="sgc-cron-cal-dow">@T("Cron_Wed", "We")</span>
                        <span class="sgc-cron-cal-dow">@T("Cron_Thu", "Th")</span>
                        <span class="sgc-cron-cal-dow">@T("Cron_Fri", "Fr")</span>
                        <span class="sgc-cron-cal-dow sgc-cron-cal-weekend">@T("Cron_Sat", "Sa")</span>
                        <span class="sgc-cron-cal-dow sgc-cron-cal-weekend">@T("Cron_Sun", "Su")</span>
                        @for (int i = 0; i < _calendarOffset; i++)
                        {
                            <span class="sgc-cron-cal-day sgc-cron-cal-other"></span>
                        }
                        @for (int d = 1; d <= _calendarDays; d++)
                        {
                            var day = d;
                            var isActive = _calendarActiveDays.Contains(day);
                            var isToday = day == DateTime.Today.Day && _calendarDate.Year == DateTime.Today.Year && _calendarDate.Month == DateTime.Today.Month;
                            <span class="sgc-cron-cal-day @(isActive ? "sgc-cron-cal-active" : "") @(isToday ? "sgc-cron-cal-today" : "")">@day</span>
                        }
                    </div>
                </div>
            }

            @* ── Cron Library ──────────────────────────────────────────────── *@
            @if (ShowLibrary)
            {
                <div class="sgc-cron-section sgc-cron-library">
                    <button type="button"
                            class="sgc-cron-library-toggle"
                            @onclick="ToggleLibrary">
                        <span>@T("Cron_Library", "Cron library")</span>
                        <span class="sgc-cron-library-arrow @(_libraryOpen ? "sgc-open" : "")">▾</span>
                    </button>
                    @if (_libraryOpen)
                    {
                        <div class="sgc-cron-library-body">
                            @foreach (var cat in _libraryCategories)
                            {
                                <div class="sgc-cron-library-cat">
                                    <div class="sgc-cron-library-cat-title">@cat.Category</div>
                                    <div class="sgc-cron-library-items">
                                        @foreach (var item in cat.Items)
                                        {
                                            <button type="button"
                                                    class="sgc-cron-library-item @(_currentExpression == item.Expression ? "sgc-active" : "")"
                                                    disabled="@Disabled"
                                                    title="@item.Description"
                                                    @onclick="() => ApplyPreset(item.Expression)">
                                                <code>@item.Expression</code>
                                                <span class="sgc-cron-library-item-desc">@item.Description</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @* ── Presets (existing) ────────────────────────────────────────── *@
            @if (ShowPresets)
            {
                <div class="sgc-cron-presets">
                    <span class="sgc-cron-presets-label">@Localizer["Cron_Presets"]:</span>
                    @foreach (var preset in Presets)
                    {
                        var p = preset;
                        <button type="button"
                                class="sgc-cron-preset @(_currentExpression == p.Expression ? "sgc-active" : "")"
                                disabled="@Disabled"
                                title="@p.Expression"
                                @onclick="() => ApplyPreset(p.Expression)">
                            @p.Label
                        </button>
                    }
                </div>
            }
            </div>
        }
    </div>

    @if (IsInvalid)
    {
        <span class="sgc-error">@DisplayedError</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private string[] GetMonthNames() => new[] {
        Localizer["Jan"], Localizer["Feb"], Localizer["Mar"], Localizer["Apr"],
        Localizer["May"], Localizer["Jun"], Localizer["Jul"], Localizer["Aug"],
        Localizer["Sep"], Localizer["Oct"], Localizer["Nov"], Localizer["Dec"]
    };

    private string[] GetWeekDayNames() => new[] {
        Localizer["Sun"], Localizer["Mon"], Localizer["Tue"], Localizer["Wed"],
        Localizer["Thu"], Localizer["Fri"], Localizer["Sat"]
    };

    private (CronTab Key, string Label, string Icon)[] GetTabs() => new[]
    {
        (CronTab.Minutes,  Localizer["Cron_Minutes"].ToString(),   "⏲"),
        (CronTab.Hours,    Localizer["Cron_Hours"].ToString(),     "🕐"),
        (CronTab.Days,     Localizer["Cron_Day"].ToString(),       "📅"),
        (CronTab.Months,   Localizer["Cron_Month"].ToString(),     "📆"),
        (CronTab.WeekDays, Localizer["Cron_Week"].ToString(),      "🗓")
    };

    private (CronMode Mode, string Label)[] GetMinuteOptions() => new[]
    {
        (CronMode.Any, Localizer["Cron_AnyMinute"].ToString()),
        (CronMode.Every, Localizer["Cron_EveryNMinutes"].ToString()),
        (CronMode.Specific, Localizer["Cron_Specific"].ToString()),
        (CronMode.Range, Localizer["Cron_Range"].ToString()),
    };
    private (CronMode Mode, string Label)[] GetHourOptions() => new[]
    {
        (CronMode.Any,      Localizer["Cron_AnyHour"].ToString()),
        (CronMode.Every,    Localizer["Cron_EveryNHours"].ToString()),
        (CronMode.Specific, Localizer["Cron_Specific"].ToString()),
        (CronMode.Range,    Localizer["Cron_Range"].ToString()),
    };
    private (CronMode Mode, string Label)[] GetDayOptions() => new[]
    {
        (CronMode.Any, Localizer["Cron_AnyDay"].ToString()),
        (CronMode.Every, Localizer["Cron_EveryNDays"].ToString()),
        (CronMode.Specific, Localizer["Cron_Specific"].ToString()),
        (CronMode.LastDay, Localizer["Cron_LastDayOfMonth"].ToString()),
    };
    private (CronMode Mode, string Label)[] GetMonthOptions() => new[]
    {
        (CronMode.Any, Localizer["Cron_AnyMonth"]?.ToString() ?? "Any month"),
        (CronMode.Every, Localizer["Cron_EveryNMonths"]?.ToString() ?? "Every N months"),
        (CronMode.Specific, Localizer["Cron_Specific"].ToString()),
    };
    private (CronMode Mode, string Label)[] GetWeekOptions() => new[]
    {
        (CronMode.Any, Localizer["Cron_AnyWeekDay"]?.ToString() ?? "Any weekday"),
        (CronMode.Specific, Localizer["Cron_Specific"].ToString()),
    };

    private CronTab _activeTab = CronTab.Minutes;
    private CronState _state = new();
    private string _currentExpression = "* * * * *";
    private string _humanReadable = "Каждую минуту";
    private bool _copied;
    private bool _suppressBindBack;
    private SgEditContextBinder<string?>? _binder;

    // ── new feature state ──────────────────────────────────────────────────
    private List<DateTime> _nextFireTimes = new();
    private DateTime _calendarDate = DateTime.Today;
    private int _calendarOffset;
    private int _calendarDays;
    private HashSet<int> _calendarActiveDays = new();
    private string? _complexity;
    private string _complexityClass = "";
    private string? _icalRule;
    private bool _icalCopied;
    private bool _libraryOpen;
    private TimeZoneInfo? _selectedTimeZone;
    private List<TimeZoneInfo> _timeZones = new();
    private bool _previousValid;
    private string? _fieldErrorMinute;
    private string? _fieldErrorHour;
    private string? _fieldErrorDay;
    private string? _fieldErrorMonth;
    private string? _fieldErrorWeek;

    [Inject] private IJSRuntime JS { get; set; } = default!;
    [CascadingParameter] private EditContext? CascadedEditContext { get; set; }

    /// <summary>
    /// Gets or sets the cron expression value (5-field standard: minute hour dayOfMonth month dayOfWeek).
    /// </summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>
    /// Callback invoked when the cron expression changes.
    /// </summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>
    /// Expression used for EditContext validation.
    /// </summary>
    [Parameter] public Expression<Func<string?>>? ValueExpression { get; set; }

    /// <summary>
    /// Optional label rendered above the builder.
    /// </summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// Helper text rendered below the control.
    /// </summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>
    /// Error text. Takes precedence over EditContext validation messages.
    /// </summary>
    [Parameter] public string? ErrorText { get; set; }

    /// <summary>
    /// Marks the field as required.
    /// </summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>
    /// Disables all interaction.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Stretches the control to its container width. Default true.
    /// </summary>
    [Parameter] public bool Block { get; set; } = true;

    /// <summary>
    /// Shows the quick preset buttons row. Default true.
    /// </summary>
    [Parameter] public bool ShowPresets { get; set; } = true;

    /// <summary>
    /// Renders a denser, smaller layout with icon-only tabs and condensed preview. Default false.
    /// </summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>
    /// Quick preset buttons. Provide your own list to replace defaults.
    /// </summary>
    [Parameter] public IReadOnlyList<SgCronPreset> Presets { get; set; } = SgCronPreset.Defaults;

    /// <summary>
    /// Additional CSS class names for the field container.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    // ═══════════════════════════════════════════════════════════════════════
    //  NEW FEATURE PARAMETERS
    // ═══════════════════════════════════════════════════════════════════════

    /// <summary>
    /// When true, shows the next N scheduled fire times below the expression preview.
    /// </summary>
    [Parameter] public bool ShowNextFireTimes { get; set; }

    /// <summary>
    /// How many future fire times to calculate and display. Default 5.
    /// </summary>
    [Parameter] public int NextFireCount { get; set; } = 5;

    /// <summary>
    /// When true, shows a mini monthly calendar with days that match the cron expression highlighted.
    /// </summary>
    [Parameter] public bool ShowCalendar { get; set; }

    /// <summary>
    /// When true, shows a timezone selector dropdown.
    /// </summary>
    [Parameter] public bool ShowTimeZone { get; set; }

    /// <summary>
    /// Gets or sets the selected timezone identifier (e.g. "UTC", "America/New_York").
    /// When set, fire times and descriptions adjust to this timezone.
    /// </summary>
    [Parameter] public string? TimeZoneId { get; set; }

    /// <summary>
    /// Callback invoked when the selected timezone changes.
    /// </summary>
    [Parameter] public EventCallback<string> OnTimeZoneChanged { get; set; }

    /// <summary>
    /// When true, shows a complexity badge (Simple / Medium / Complex) for the cron expression.
    /// </summary>
    [Parameter] public bool ShowComplexity { get; set; }

    /// <summary>
    /// When true, shows a collapsible library of common cron expression presets organized by category.
    /// </summary>
    [Parameter] public bool ShowLibrary { get; set; }

    /// <summary>
    /// When true, shows an "iCal" button that generates and copies an iCalendar RRULE from the cron expression.
    /// </summary>
    [Parameter] public bool ShowIcalExport { get; set; }

    /// <summary>
    /// Callback invoked when the validation state changes. Receives true if the expression is valid, false otherwise.
    /// </summary>
    [Parameter] public EventCallback<bool> OnValidationChanged { get; set; }

    /// <summary>
    /// When true, shows the full expression preview (tokens + human readable + copy). Default true.
    /// </summary>
    [Parameter] public bool ShowPreview { get; set; } = true;

    /// <summary>
    /// When true, shows the individual field tokens in the preview. Default true.
    /// </summary>
    [Parameter] public bool ShowExpressionTokens { get; set; } = true;

    /// <summary>
