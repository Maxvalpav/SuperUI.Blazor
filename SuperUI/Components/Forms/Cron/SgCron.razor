    //  FIELD VALIDATION
    // ═══════════════════════════════════════════════════════════════════════

    /// <summary>
    /// Validates the 5 cron fields independently and sets per-field error messages.
    /// </summary>
    private bool ValidateFields(string expr)
    {
        _fieldErrorMinute = null;
        _fieldErrorHour = null;
        _fieldErrorDay = null;
        _fieldErrorMonth = null;
        _fieldErrorWeek = null;

        if (string.IsNullOrWhiteSpace(expr))
        {
            _fieldErrorMinute = T("Cron_ErrEmpty", "Expression is empty");
            return false;
        }

        var parts = expr.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length != 5)
        {
            _fieldErrorMinute = T("Cron_ErrFieldCount", "Expression must have exactly 5 fields");
            return false;
        }

        bool valid = true;
        if (!ValidateField(parts[0], 0, 59, out var errMin))
        {
            _fieldErrorMinute = errMin;
            valid = false;
        }
        if (!ValidateField(parts[1], 0, 23, out var errHr))
        {
            _fieldErrorHour = errHr;
            valid = false;
        }
        if (parts[2] != "L" && parts[2] != "?" && !ValidateField(parts[2], 1, 31, out var errDay))
        {
            _fieldErrorDay = errDay;
            valid = false;
        }
        if (!ValidateField(parts[3], 1, 12, out var errMon))
        {
            _fieldErrorMonth = errMon;
            valid = false;
        }
        if (parts[4] != "?" && !ValidateField(parts[4], 0, 6, out var errWk))
        {
            _fieldErrorWeek = errWk;
            valid = false;
        }
        return valid;
    }

    private static bool ValidateField(string token, int min, int max, out string? error)
    {
        error = null;
        if (token == "*" || token == "?") return true;

        if (token.StartsWith("*/"))
        {
            if (!int.TryParse(token[2..], out var step) || step < 1)
            {
                error = $"Invalid step '{token}'";
                return false;
            }
            return true;
        }

        foreach (var part in token.Split(','))
        {
            if (part.Contains('-'))
            {
                var rr = part.Split('-');
                if (rr.Length != 2 || !int.TryParse(rr[0], out var a) || !int.TryParse(rr[1], out var b))
                {
                    error = $"Invalid range '{part}'";
                    return false;
                }
                if (a < min || a > max || b < min || b > max || a > b)
                {
                    error = $"Range '{part}' out of bounds ({min}-{max})";
                    return false;
                }
            }
            else
            {
                if (!int.TryParse(part, out var v) || v < min || v > max)
                {
                    error = $"Value '{part}' out of bounds ({min}-{max})";
                    return false;
                }
            }
        }
        return true;
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  NEXT FIRE TIMES CALCULATION
    // ═══════════════════════════════════════════════════════════════════════

    /// <summary>
    /// Calculates the next N future times when the cron expression will fire.
    /// </summary>
    private List<DateTime> CalculateNextFireTimes(string expression, int count)
    {
        var result = new List<DateTime>();
        var parts = expression.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length != 5) return result;

        var now = _selectedTimeZone != null
            ? TimeZoneInfo.ConvertTime(DateTime.UtcNow, _selectedTimeZone)
            : DateTime.Now;

        var searchFrom = new DateTime(now.Year, now.Month, now.Day, now.Hour, now.Minute, 0, now.Kind).AddMinutes(1);

        var minuteFn = ParseFieldPredicate(parts[0], 0, 59);
        var hourFn = ParseFieldPredicate(parts[1], 0, 23);
        var dayFn = parts[2] == "L" ? IsLastDayOfMonth : ParseFieldPredicate(parts[2], 1, 31);
        var monthFn = ParseFieldPredicate(parts[3], 1, 12);
        var weekFn = parts[4] == "?" ? _ => true : ParseFieldPredicate(parts[4], 0, 6);

        bool useDayOrWeek = parts[2] != "*" && parts[2] != "?" && parts[4] != "*" && parts[4] != "?";

        var dt = searchFrom;
        int maxIterations = 525600;
        while (result.Count < count && maxIterations > 0)
        {
            maxIterations--;

            if (monthFn(dt.Month)
                && dayFn(dt.Day)
                && hourFn(dt.Hour)
                && minuteFn(dt.Minute))
            {
                bool weekOk = weekFn((int)dt.DayOfWeek);
                bool domOk = parts[2] == "*" || parts[2] == "?" || dayFn(dt.Day);

                if (useDayOrWeek)
                {
                    if (weekOk || domOk)
                        result.Add(dt);
                }
                else if (parts[4] == "*" || parts[4] == "?")
                {
                    result.Add(dt);
                }
                else if (weekOk)
                {
                    result.Add(dt);
                }
            }

            dt = dt.AddMinutes(1);
            if (dt.Year > now.Year + 5) break;
        }

        return result;
    }

    private static Func<int, bool> ParseFieldPredicate(string token, int min, int max)
    {
        if (token == "*" || token == "?")
            return _ => true;

        if (token.StartsWith("*/") && int.TryParse(token[2..], out var step) && step > 0)
            return v => v >= min && v <= max && (v % step == 0);

        var values = new HashSet<int>();
        foreach (var part in token.Split(','))
        {
            if (part.Contains('-'))
            {
                var rr = part.Split('-');
                if (int.TryParse(rr[0], out var a) && int.TryParse(rr[1], out var b))
                {
                    for (int i = a; i <= b; i++) values.Add(i);
                }
            }
            else if (int.TryParse(part, out var v))
            {
                values.Add(v);
            }
        }
        return v => values.Contains(v);
    }

    private static bool IsLastDayOfMonth(int day)
    {
        return false;
    }

    /// <summary>
    /// Returns a human-readable relative time string (e.g. "in 2 hours", "tomorrow at 9:00").
    /// </summary>
    private string GetRelativeTime(DateTime dt)
    {
        var now = _selectedTimeZone != null
            ? TimeZoneInfo.ConvertTime(DateTime.UtcNow, _selectedTimeZone)
            : DateTime.Now;

        var diff = dt - now;
        var totalMinutes = (int)diff.TotalMinutes;

        if (totalMinutes < 1) return T("Cron_Now", "now");
        if (totalMinutes < 60)
            return string.Format(T("Cron_InMinutes", "in {0} min"), totalMinutes);
        if (totalMinutes < 1440)
        {
            var hours = totalMinutes / 60;
            return string.Format(T("Cron_InHours", "in {0} h"), hours);
        }

        if (dt.Date == now.Date.AddDays(1))
            return T("Cron_TomorrowAt", "tomorrow") + " " + dt.ToString("HH:mm");
        if (dt.Date == now.Date.AddDays(2))
            return T("Cron_DayAfter", "day after") + " " + dt.ToString("HH:mm");

        var days = (dt.Date - now.Date).Days;
        return string.Format(T("Cron_InDays", "in {0} days"), days);
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  CALENDAR PREVIEW
    // ═══════════════════════════════════════════════════════════════════════

    private void BuildCalendar()
    {
        var year = _calendarDate.Year;
        var month = _calendarDate.Month;
        _calendarDays = DateTime.DaysInMonth(year, month);
        var firstDay = new DateTime(year, month, 1);
        _calendarOffset = ((int)firstDay.DayOfWeek + 6) % 7;

        _calendarActiveDays = GetCalendarActiveDays(year, month);
    }

    private HashSet<int> GetCalendarActiveDays(int year, int month)
    {
        var active = new HashSet<int>();
        var parts = _currentExpression.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length != 5) return active;

        var minuteFn = ParseFieldPredicate(parts[0], 0, 59);
        var hourFn = ParseFieldPredicate(parts[1], 0, 23);
        var dayFn = parts[2] == "L" ? IsLastDayOfMonth : ParseFieldPredicate(parts[2], 1, 31);
        var monthFn = ParseFieldPredicate(parts[3], 1, 12);
        var weekFn = parts[4] == "?" ? _ => true : ParseFieldPredicate(parts[4], 0, 6);

        if (!monthFn(month)) return active;

        bool useDayOrWeek = parts[2] != "*" && parts[2] != "?" && parts[4] != "*" && parts[4] != "?";
        int daysInMonth = DateTime.DaysInMonth(year, month);

        for (int day = 1; day <= daysInMonth; day++)
        {
            var dt = new DateTime(year, month, day);
            bool weekOk = weekFn((int)dt.DayOfWeek);
            bool domOk = dayFn(day);

            if (useDayOrWeek)
            {
                if (weekOk || domOk)
                    active.Add(day);
            }
            else if (parts[4] == "*" || parts[4] == "?")
            {
                if (domOk)
                    active.Add(day);
            }
            else if (weekOk)
            {
                active.Add(day);
            }
        }

        return active;
    }

    private void NavigateCalendar(int delta)
    {
        _calendarDate = _calendarDate.AddMonths(delta);
        BuildCalendar();
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  COMPLEXITY INDICATOR
    // ═══════════════════════════════════════════════════════════════════════

    /// <summary>
    /// Evaluates the cron expression and returns a complexity level and CSS class.
    /// </summary>
    private static (string label, string cssClass) EvaluateComplexity(string expr)
    {
        var parts = expr.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length != 5) return ("Unknown", "unknown");

        bool hasComplex = false;
        bool hasMedium = false;

        foreach (var field in parts)
        {
            if (field.Contains('L') || field.Contains('W') || field.Contains('#'))
                hasComplex = true;

            if (field.Contains(',') && field.Split(',').Length > 3)
                hasComplex = true;

            if (field.Contains(',') && field.Split(',').Length > 1)
                hasMedium = true;

            if (field.Contains('-'))
                hasMedium = true;
        }

        bool allAny = parts.All(p => p == "*" || p == "?");
        bool simpleStep = parts[0] == "*" || parts[0].StartsWith("*/");
        bool hourStar = parts[1] == "*" || parts[1].StartsWith("*/");
        bool dayStar = parts[2] == "*" || parts[2] == "?" || parts[2] == "L";
        bool monthStar = parts[3] == "*";
        bool weekStar = parts[4] == "*" || parts[4] == "?";

        if (allAny || (simpleStep && hourStar && dayStar && monthStar && weekStar))
            return ("Simple", "simple");

        if (hasComplex)
            return ("Complex", "complex");

        if (hasMedium)
            return ("Medium", "medium");

        return ("Simple", "simple");
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  iCAL RRULE GENERATION
    // ═══════════════════════════════════════════════════════════════════════

    /// <summary>
    /// Converts a 5-field cron expression to an iCalendar RRULE string.
    /// </summary>
    private static string? ToIcalRule(string expr)
    {
        var parts = expr.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length != 5) return null;

        var sb = new StringBuilder("FREQ=");
        var minuteToken = parts[0];
        var hourToken = parts[1];
        var dayToken = parts[2];
        var monthToken = parts[3];
        var weekToken = parts[4];

        bool hasMinuteSpecific = minuteToken != "*" && !minuteToken.StartsWith("*/");
        bool hasHourSpecific = hourToken != "*" && !hourToken.StartsWith("*/");
        bool hasDaySpecific = dayToken != "*" && dayToken != "?";
        bool hasMonthSpecific = monthToken != "*" && !monthToken.StartsWith("*/");
        bool hasWeekSpecific = weekToken != "*" && weekToken != "?";

        // Determine frequency
        bool minuteStep = minuteToken.StartsWith("*/");
        bool hourStep = hourToken.StartsWith("*/");
        bool dayStep = dayToken.StartsWith("*/");
        bool monthStep = monthToken.StartsWith("*/");

        int minuteVal = minuteStep && int.TryParse(minuteToken[2..], out var mv) ? mv : 1;
        int hourVal = hourStep && int.TryParse(hourToken[2..], out var hv) ? hv : 1;
        int dayVal = dayStep && int.TryParse(dayToken[2..], out var dv) ? dv : 1;
        int monthVal = monthStep && int.TryParse(monthToken[2..], out var mov) ? mov : 1;

        if (monthStep && monthVal > 1)
        {
            sb.Append($"MONTHLY;INTERVAL={monthVal}");
        }
        else if (dayStep && dayVal > 1)
        {
            sb.Append($"DAILY;INTERVAL={dayVal}");
        }
        else if (hourStep && hourVal > 1)
        {
            sb.Append($"HOURLY;INTERVAL={hourVal}");
        }
        else if (minuteStep && minuteVal > 1)
        {
            sb.Append($"MINUTELY;INTERVAL={minuteVal}");
        }
        else if (hasWeekSpecific)
        {
            sb.Append("WEEKLY");
        }
        else if (hasMonthSpecific && monthToken != "*")
        {
            sb.Append("MONTHLY");
        }
        else if (hasDaySpecific && dayToken != "*" && dayToken != "?")
        {
            sb.Append("DAILY");
        }
        else if (hasHourSpecific)
        {
            sb.Append("DAILY");
        }
        else if (hasMinuteSpecific)
        {
            sb.Append("HOURLY");
        }
        else
        {
            sb.Append("MINUTELY;INTERVAL=1");
        }

        // BYMINUTE
        if (hasMinuteSpecific)
        {
            sb.Append(";BYMINUTE=");
            sb.Append(minuteToken);
        }

        // BYHOUR
        if (hasHourSpecific)
        {
            sb.Append(";BYHOUR=");
            sb.Append(hourToken);
        }

        // BYMONTHDAY
        if (hasDaySpecific && dayToken != "L")
        {
            sb.Append(";BYMONTHDAY=");
            sb.Append(dayToken);
        }
        else if (dayToken == "L")
        {
            sb.Append(";BYMONTHDAY=-1");
        }

        // BYMONTH
        if (hasMonthSpecific)
        {
            sb.Append(";BYMONTH=");
            sb.Append(monthToken);
        }

        // BYDAY
        if (hasWeekSpecific && weekToken != "*" && weekToken != "?")
        {
            sb.Append(";BYDAY=");
            var dayParts = weekToken.Split(',');
            var dayNames = new[] { "SU", "MO", "TU", "WE", "TH", "FR", "SA" };
            var mapped = dayParts.Select(p =>
            {
                if (int.TryParse(p, out var d))
                    return dayNames[d % 7];
                return p;
            });
            sb.Append(string.Join(",", mapped));
        }

        return sb.ToString();
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  COPY iCal RRULE
    // ═══════════════════════════════════════════════════════════════════════

    private async Task CopyIcalAsync()
    {
        if (_icalRule is null) return;
        try
        {
            var icalText = $"RRULE:{_icalRule}";
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", icalText);
            _icalCopied = true;
            StateHasChanged();
            _ = Task.Delay(1500).ContinueWith(_ => InvokeAsync(() => { _icalCopied = false; StateHasChanged(); }));
        }
        catch { }
    }

