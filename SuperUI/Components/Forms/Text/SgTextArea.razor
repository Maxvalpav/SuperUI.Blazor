@namespace SuperUI.Components
@using SuperUI.Enums
@inherits SgInputBase<string>

<div class="sgc-field
            @(Block ? "sgc-block" : "")
            @(LabelPosition == SgLabelPosition.Left ? "sgc-label-left" : LabelPosition == SgLabelPosition.Right ? "sgc-label-right" : "")
            @(_showFloatingLabel ? "sgc-floating-label" : "")
            @(_focused || _hasValue ? "sgc-field-active" : "")
            @(IsInvalid ? "sgc-field-invalid" : "")
            @CssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sgc-label @(Required ? "sgc-required" : "")"
               for="@_id">@Label</label>
    }
    <div class="sgc-textarea-wrapper
                @(Disabled ? "sgc-disabled" : "")
                @(IsInvalid ? "sgc-invalid" : "")
                @(_focused ? "sgc-focused" : "")
                @(ShowCharProgressBar && MaxLength.HasValue ? "sgc-has-progress" : "")
                @(ShowToolbar ? "sgc-has-toolbar" : "")
                @(ShowResizeGrip ? "sgc-has-resize-grip" : "")">
        <div class="sgc-input-wrap sgc-textarea-wrap
                    @(AllowClear && _hasValue ? "sgc-has-clear" : "")
                    @(ShowCounter && MaxLength.HasValue ? "sgc-has-counter" : "")">
            @if (!string.IsNullOrEmpty(IconPrefix))
            {
                <span class="sgc-input-affix sgc-input-affix-prefix">@((MarkupString)IconPrefix!)</span>
            }
            @if (_showFloatingLabel && string.IsNullOrEmpty(Placeholder))
            {
                <div class="sgc-floating-placeholder" aria-hidden="true">@Label</div>
            }
            <textarea id="@_id"
                      class="sgc-textarea
                            @(IsInvalid ? "sgc-invalid" : "")
                            @(AutoResize ? "sgc-auto-resize" : "")
                            sgc-resize-@ResizeClass
                            @(_showFloatingLabel ? "sgc-textarea-floating" : "")"
                      rows="@Rows"
                      placeholder="@(_showFloatingLabel ? "" : Placeholder ?? (string.IsNullOrEmpty(Label) ? "" : Label))"
                      disabled="@Disabled"
                      readonly="@ReadOnly"
                      required="@Required"
                      maxlength="@(SoftMaxLength ? null : MaxLength)"
                      spellcheck="@(_spellCheckAttr)"
                      wrap="@(_wrapAttr)"
                      tabindex="@TabIndex"
                      style="@_combinedStyle"
                      aria-required="@(Required ? "true" : null)"
                      aria-invalid="@(IsInvalid ? "true" : null)"
                      aria-describedby="@DescribedBy"
                       aria-label="@(string.IsNullOrEmpty(Label) ? (Placeholder ?? Localizer["TextArea_TextInput"]) : null)"
                      value="@Value"
                      @oninput="OnInputAsync"
                      @onchange="OnChangeAsync"
                      @onfocus="OnFocusAsync"
                      @onblur="OnBlurAsync"
                      @onpaste="OnPasteAsync"
                      @ref="_textareaRef"
                      @attributes="AdditionalAttributes"></textarea>
            @if (!string.IsNullOrEmpty(IconSuffix))
            {
                <span class="sgc-input-affix sgc-input-affix-suffix">@((MarkupString)IconSuffix!)</span>
            }
            @if (ShowEmojiPicker)
            {
                <button type="button" class="sgc-textarea-emoji-btn" @onclick="ToggleEmojiPicker" aria-label="@Localizer["Common_Emoji"]" tabindex="-1">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>
                    </svg>
                </button>
                @if (_emojiPickerOpen)
                {
                    <div class="sgc-emoji-picker" @onclick:stopPropagation>
                        @foreach (var cat in EmojiCategories)
                        {
                            <div class="sgc-emoji-category">
                                <span class="sgc-emoji-cat-label">@cat.Key</span>
                                <div class="sgc-emoji-grid">
                                    @foreach (var emoji in cat.Value)
                                    {
                                        var e = emoji;
                                        <button type="button" class="sgc-emoji-item" @onclick="() => SelectEmojiAsync(e)" title="@e">@e</button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            @if (CounterTemplate is not null)
            {
                @CounterTemplate
            }
            else if (ShowCounter && MaxLength.HasValue)
            {
                <span class="sgc-textarea-counter @(_counterWarn ? "sgc-textarea-counter-warn" : "")">
                    @if (CounterMode == SgTextAreaCounterMode.CharCount || CounterMode == SgTextAreaCounterMode.Both)
                    {
                        <span class="sgc-textarea-counter-current">@_charLen</span>
                        <span class="sgc-textarea-counter-sep">/</span>
                        <span class="sgc-textarea-counter-max">@MaxLength</span>
                    }
                    @if (CounterMode == SgTextAreaCounterMode.Remaining || CounterMode == SgTextAreaCounterMode.Both)
                    {
                        var rem = Math.Max(0, MaxLength.Value - _charLen);
                        if (CounterMode == SgTextAreaCounterMode.Both)
                        {
                            <span class="sgc-textarea-counter-sep" style="margin-left:4px;">·</span>
                        }
                        <span class="sgc-textarea-counter-remaining">@string.Format(Localizer["TextArea_Remaining"], rem)</span>
                    }
                </span>
            }
            @if (ShowResizeGrip && !AutoResize)
            {
                <div class="sgc-resize-grip" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="10" height="10" fill="currentColor"><path d="M4 12h8v-1H5.5l6.5-6.5-.7-.7L4 10.3V4H3v8h1z"/></svg>
                </div>
            }
            @if (AllowClear && _hasValue)
            {
                <button type="button" class="sgc-input-clear sgc-textarea-clear" @onclick="ClearAsync" aria-label="@Localizer["Common_Clear"]" tabindex="-1">
                    <svg viewBox="0 0 16 16" width="10" height="10" fill="currentColor" aria-hidden="true">
                        <path d="M3.72 3.72a.75.75 0 011.06 0L8 6.94l3.22-3.22a.75.75 0 111.06 1.06L9.06 8l3.22 3.22a.75.75 0 11-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 01-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 010-1.06z"/>
                    </svg>
                </button>
            }
        </div>

        @if (ShowCharProgressBar && MaxLength.HasValue)
        {
            <div class="sgc-char-progress" role="progressbar" aria-valuenow="@_charLen" aria-valuemin="0" aria-valuemax="@MaxLength">
                <div class="sgc-char-progress-fill @(_counterWarn ? "sgc-char-progress-warn" : _charPct >= 95 ? "sgc-char-progress-danger" : "")"
                     style="width:@Math.Min(_charPct, 100)%"></div>
            </div>
        }

        @if (ShowWordCount || ShowLineCount)
        {
            <div class="sgc-textarea-stats">
                @if (ShowWordCount)
                {
                    <span class="sgc-textarea-stat">@_wordCount @(_wordCount == 1 ? Localizer["TextArea_Word"] : Localizer["TextArea_Words"])</span>
                }
                @if (ShowLineCount)
                {
                    <span class="sgc-textarea-stat">@_lineCount @(_lineCount == 1 ? Localizer["TextArea_Line"] : Localizer["TextArea_Lines"])</span>
                }
            </div>
        }

        @if (ShowToolbar)
        {
            <div class="sgc-textarea-toolbar">
                @if (ToolbarContent is not null)
                {
                    @ToolbarContent
                }
                else
                {
                    <div class="sgc-textarea-toolbar-left">
                        @if (ShowCounter && MaxLength.HasValue)
                        {
                            <span class="sgc-toolbar-counter @(_counterWarn ? "sgc-toolbar-counter-warn" : "")">
                                @_charLen / @MaxLength
                            </span>
                        }
                        @if (ShowWordCount)
                        {
                            <span class="sgc-toolbar-stat">@_wordCount @(_wordCount == 1 ? Localizer["TextArea_Word"] : Localizer["TextArea_Words"])</span>
                        }
                        @if (ShowLineCount)
                        {
                            <span class="sgc-toolbar-stat">@_lineCount @(_lineCount == 1 ? Localizer["TextArea_Line"] : Localizer["TextArea_Lines"])</span>
                        }
                    </div>
                    <div class="sgc-textarea-toolbar-right">
                        @if (ShowEmojiPicker)
                        {
                            <button type="button" class="sgc-toolbar-btn" @onclick="ToggleEmojiPicker" aria-label="@Localizer["Common_Emoji"]">
                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>
                                </svg>
                            </button>
                        }
                        @if (_hasValue)
                        {
                            <button type="button" class="sgc-toolbar-btn sgc-toolbar-clear" @onclick="ClearAsync" aria-label="@Localizer["Common_Clear"]">
                                <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M3.72 3.72a.75.75 0 011.06 0L8 6.94l3.22-3.22a.75.75 0 111.06 1.06L9.06 8l3.22 3.22a.75.75 0 11-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 01-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 010-1.06z"/></svg>
                            </button>
                        }
                    </div>
                }
                @if (_emojiPickerOpen)
                {
                    <div class="sgc-emoji-picker sgc-emoji-picker-toolbar" @onclick:stopPropagation>
                        @foreach (var cat in EmojiCategories)
                        {
                            <div class="sgc-emoji-category">
                                <span class="sgc-emoji-cat-label">@cat.Key</span>
                                <div class="sgc-emoji-grid">
                                    @foreach (var emoji in cat.Value)
                                    {
                                        var e = emoji;
                                        <button type="button" class="sgc-emoji-item" @onclick="() => SelectEmojiAsync(e)" title="@e">@e</button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (IsInvalid)
        {
            <span id="@_errorId" class="sgc-error sgc-textarea-error">
                <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true" style="margin-right:3px;vertical-align:middle;"><path d="M8 1a7 7 0 110 14A7 7 0 018 1zM7.25 5v3.5h1.5V5h-1.5zm0 5v1.5h1.5V10h-1.5z"/></svg>
                @DisplayedError
            </span>
        }
        else if (!string.IsNullOrEmpty(Hint))
        {
            <span id="@_hintId" class="sgc-hint">@Hint</span>
        }
    </div>
</div>
