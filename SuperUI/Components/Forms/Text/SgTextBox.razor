@namespace SuperUI.Components
@typeparam TValue
@using SuperUI.Enums
@using Microsoft.Extensions.Logging
@inherits SgInputBase<TValue>

<div class="sgc-field @(Block ? "sgc-block" : "") @(LabelPosition == SgLabelPosition.Left ? "sgc-label-left" : LabelPosition == SgLabelPosition.Right ? "sgc-label-right" : "") @SizeClass @CssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sgc-label @(Required ? "sgc-required" : "")" for="@_id">@Label</label>
    }
    <div class="sgc-input-wrap @(HasPrefix ? "sgc-has-prefix" : "") @(HasSuffix ? "sgc-has-suffix" : "") @(IsPassword && !string.IsNullOrEmpty(CurrentText) && AllowClear ? "sgc-has-eye sgc-has-clear-eye" : (IsPassword ? "sgc-has-eye" : (AllowClear && !string.IsNullOrEmpty(CurrentText) ? "sgc-has-clear" : "")))">
        @if (HasPrefix)
        {
            <span class="sgc-input-affix sgc-input-affix-prefix" aria-hidden="true">
                @if (StartIcon is not null) { @StartIcon }
                else { @Prefix }
            </span>
        }
        @if (Multiline)
        {
            <textarea id="@_id"
                      class="sgc-textarea @(IsInvalid ? "sgc-invalid" : "")"
                      rows="@Rows"
                      placeholder="@Placeholder"
                      disabled="@Disabled"
                      readonly="@ReadOnly"
                      required="@Required"
                      maxlength="@MaxLength"
                      inputmode="@InputMode"
                      autofocus="@(AutoFocus ? "autofocus" : null)"
                      aria-required="@(Required ? "true" : null)"
                      aria-invalid="@(IsInvalid ? "true" : null)"
                      aria-describedby="@DescribedBy"
                      value="@CurrentText"
                      @oninput="OnInput"
                      @onchange="OnChangeAsync"
                      @onkeydown="OnKeyDownAsync"
                      @onfocus="OnFocusAsync"
                      @onblur="OnBlurAsync"
                      @attributes="AdditionalAttributes"></textarea>
        }
        else
        {
            <input id="@_id"
                   type="@CurrentInputType"
                   class="sgc-input @(IsInvalid ? "sgc-invalid" : "")"
                   placeholder="@Placeholder"
                   disabled="@Disabled"
                   readonly="@ReadOnly"
                   required="@Required"
                   maxlength="@MaxLength"
                   inputmode="@InputMode"
                   autofocus="@(AutoFocus ? "autofocus" : null)"
                   aria-required="@(Required ? "true" : null)"
                   aria-invalid="@(IsInvalid ? "true" : null)"
                   aria-describedby="@DescribedBy"
                   value="@CurrentText"
                   @oninput="OnInput"
                   @onchange="OnChangeAsync"
                   @onkeydown="OnKeyDownAsync"
                   @onfocus="OnFocusAsync"
                   @onblur="OnBlurAsync"
                   @attributes="AdditionalAttributes" />
        }
        <div class="sgc-input-right-group">
            @if (HasSuffix && !IsPassword)
            {
                <span class="sgc-input-affix sgc-input-affix-item" aria-hidden="true">
                    @if (EndIcon is not null) { @EndIcon }
                    else { @Suffix }
                </span>
            }
            @if (ShowClearButton && !string.IsNullOrEmpty(CurrentText))
            {
                <button type="button" class="sgc-input-clear" @onclick="ClearAsync" @onclick:stopPropagation="true" aria-label="@Localizer["Common_Clear"]" tabindex="-1">
                    <svg viewBox="0 0 16 16" width="10" height="10" fill="currentColor" aria-hidden="true">
                        <path d="M3.72 3.72a.75.75 0 011.06 0L8 6.94l3.22-3.22a.75.75 0 111.06 1.06L9.06 8l3.22 3.22a.75.75 0 11-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 01-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 010-1.06z"/>
                    </svg>
                </button>
            }
            @if (IsPassword)
            {
                <button type="button"
                        class="sgc-input-eye"
                        @onclick="TogglePasswordVisibility"
                        @onclick:stopPropagation="true"
                        aria-label="@(ShowPassword ? Localizer["HidePassword"] : Localizer["ShowPassword"])"
                        tabindex="-1">
                    @if (ShowPassword)
                    {
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
                            <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486l.708.709z"/>
                            <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z"/>
                            <path d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.708z"/>
                            <path fill-rule="evenodd" d="M13.646 14.354l-12-12 .708-.708 12 12-.708.708z"/>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                        </svg>
                    }
                </button>
            }
        </div>
    </div>
    @if (ShowCounter && MaxLength.HasValue)
    {
        <span class="sgc-input-counter">@(CurrentText?.Length ?? 0) / @MaxLength</span>
    }
    @if (IsInvalid)
    {
        <span id="@_errorId" class="sgc-error">@DisplayedError</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@_hintId" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private readonly string _id = "sg-" + Guid.NewGuid().ToString("N")[..8];
    private string _hintId => _id + "-hint";
    private string _errorId => _id + "-err";
    private bool _showPassword;

    /// <summary>Label text displayed above the input.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Position of the label relative to the input. Default is <see cref="SgLabelPosition.Top"/>.</summary>
    [Parameter] public SgLabelPosition LabelPosition { get; set; } = SgLabelPosition.Top;

    /// <summary>Placeholder text displayed inside the input when empty.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Hint text displayed below the input.</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>Override error text. Takes precedence over EditContext validation messages.</summary>
    [Parameter] public string? ErrorText { get; set; }

    /// <summary>Input type attribute (e.g., "text", "email", "password", "number", "tel", "url"). Default is "text".</summary>
    [Parameter] public string Type { get; set; } = "text";

    /// <summary>Whether to render a multi-line textarea instead of a single-line input.</summary>
    [Parameter] public bool Multiline { get; set; }

    /// <summary>Number of visible rows when <see cref="Multiline"/> is true. Default is 3.</summary>
    [Parameter] public int Rows { get; set; } = 3;

    /// <summary>Mark the input as required. Adds a visual indicator to the label and sets the <c>required</c> attribute.</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>Whether the input is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Whether the input is read-only.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Expand the input to full width of its container. Default is true.</summary>
    [Parameter] public bool Block { get; set; } = true;

    /// <summary>Whether to commit the value on every keystroke (<c>true</c>) or only on blur (<c>false</c>). Default is true.</summary>
    [Parameter] public bool Immediate { get; set; } = true;

    /// <summary>Callback invoked when the Enter key is pressed while the input is focused.</summary>
    [Parameter] public EventCallback OnEnterPressed { get; set; }

    /// <summary>Callback invoked on every input event (raw keystroke, before debounce).</summary>
    [Parameter] public EventCallback<ChangeEventArgs> OnInputEvent { get; set; }

    /// <summary>Callback invoked when the input receives focus.</summary>
    [Parameter] public EventCallback<FocusEventArgs> OnFocus { get; set; }

    /// <summary>Callback invoked when the input loses focus.</summary>
    [Parameter] public EventCallback<FocusEventArgs> OnBlur { get; set; }

    /// <summary>Debounce delay in milliseconds. When set, value changes are committed after the specified delay without further input.</summary>
    [Parameter] public int Debounce { get; set; }

    /// <summary>Maximum character length for the input value. Enforced via the <c>maxlength</c> attribute.</summary>
    [Parameter] public int? MaxLength { get; set; }

    /// <summary>Whether to show a clear button when the input has a value. Default is true.</summary>
    [Parameter] public bool AllowClear { get; set; } = true;

    /// <summary>Alias for <see cref="AllowClear"/>. Kept for backwards compatibility.</summary>
    [Parameter] public bool ShowClearButton { get => AllowClear; set => AllowClear = value; }

    /// <summary>Whether to show a character counter (current / max) below the input. Requires <see cref="MaxLength"/>.</summary>
    [Parameter] public bool ShowCounter { get; set; }

    /// <summary>Text prefix shown inside the input on the left side.</summary>
    [Parameter] public string? Prefix { get; set; }

    /// <summary>Text suffix shown inside the input on the right side.</summary>
    [Parameter] public string? Suffix { get; set; }

    /// <summary>Icon rendered on the left side inside the input. Takes precedence over <see cref="Prefix"/>.</summary>
    [Parameter] public RenderFragment? StartIcon { get; set; }

    /// <summary>Icon rendered on the right side inside the input. Takes precedence over <see cref="Suffix"/>. Not shown when Type="password".</summary>
    [Parameter] public RenderFragment? EndIcon { get; set; }

    /// <summary>Size of the input: Sm, Md (default), or Lg.</summary>
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;

    /// <summary>Hint for the browser's virtual keyboard type. Values: "text", "search", "email", "tel", "url", "numeric", "decimal", "none".</summary>
    [Parameter] public string? InputMode { get; set; }

    /// <summary>Whether to automatically focus the input on first render.</summary>
    [Parameter] public bool AutoFocus { get; set; }

    [Inject] private new ISuperUILocalizer Localizer { get; set; } = default!;

    private readonly SgDebouncer _debouncer = new();

    private bool IsInvalid => !string.IsNullOrEmpty(ErrorText) || HasValidationErrors;
    private string? DisplayedError => !string.IsNullOrEmpty(ErrorText) ? ErrorText : ValidationMessages.FirstOrDefault();
    private string? DescribedBy => IsInvalid ? _errorId : (!string.IsNullOrEmpty(Hint) ? _hintId : null);
    private string? CurrentText => Value is null ? string.Empty : Convert.ToString(Value, System.Globalization.CultureInfo.CurrentCulture);

    private bool IsPassword => string.Equals(Type, "password", StringComparison.OrdinalIgnoreCase);
    private bool ShowPassword { get => _showPassword; }
    private string CurrentInputType => IsPassword && _showPassword ? "text" : Type;

    private bool HasPrefix => StartIcon is not null || !string.IsNullOrEmpty(Prefix);
    private bool HasSuffix => (EndIcon is not null || !string.IsNullOrEmpty(Suffix)) && !IsPassword;

    private string? SizeClass => Size switch
    {
        SgSize.Sm => "sgc-field-sm",
        SgSize.Lg => "sgc-field-lg",
        _         => null
    };

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    private void OnInput(ChangeEventArgs e)
    {
        if (OnInputEvent.HasDelegate)
        {
            try { _ = OnInputEvent.InvokeAsync(e); }
            catch (Exception ex) { Logger.LogError(ex, "SgTextBox.OnInputEvent handler threw"); }
        }

        if (Debounce > 0)
        {
            var raw = e.Value?.ToString();
            _ = _debouncer.RunAsync(
                async _ =>
                {
                    try { await InvokeAsync(() => CommitAsync(raw)); }
                    catch (Exception ex) { Logger.LogError(ex, "SgTextBox debounced commit failed"); }
                },
                TimeSpan.FromMilliseconds(Debounce));
        }
        else if (Immediate)
        {
            _ = SafeCommitAsync(e.Value?.ToString());
        }
    }

    private Task OnChangeAsync(ChangeEventArgs e) => !Immediate && Debounce <= 0 ? CommitAsync(e.Value?.ToString()) : Task.CompletedTask;

    private async Task SafeCommitAsync(string? raw)
    {
        try { await CommitAsync(raw); }
        catch (Exception ex) { Logger.LogError(ex, "SgTextBox.CommitAsync failed"); }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && OnEnterPressed.HasDelegate)
            await OnEnterPressed.InvokeAsync();
    }

    private async Task OnFocusAsync(FocusEventArgs e)
    {
        if (OnFocus.HasDelegate)
            await OnFocus.InvokeAsync(e);
    }

    private async Task OnBlurAsync(FocusEventArgs e)
    {
        if (Debounce > 0)
        {
            _debouncer.Cancel();
            await CommitAsync(CurrentText);
        }
        if (OnBlur.HasDelegate)
            await OnBlur.InvokeAsync(e);
    }

    private Task ClearAsync() => SetValueAsync(default);
    private Task CommitAsync(string? raw) => SetValueAsync(ConvertValue(raw));

    private static TValue? ConvertValue(string? raw)
    {
        var t = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
        if (string.IsNullOrEmpty(raw)) return default;
        try
        {
            if (t == typeof(string)) return (TValue)(object)raw!;
            if (t.IsEnum) return (TValue)Enum.Parse(t, raw, true);
            return (TValue)Convert.ChangeType(raw, t, System.Globalization.CultureInfo.CurrentCulture);
        }
        catch { return default; }
    }

    public override void Dispose()
    {
        _debouncer.Dispose();
        base.Dispose();
    }
}
