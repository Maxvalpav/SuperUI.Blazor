@namespace SuperUI.Components
@using Microsoft.AspNetCore.Components.Forms
@using System.Linq.Expressions
@inject ISuperUILocalizer Localizer
@inject IJSRuntime _jsRuntime
@using Microsoft.JSInterop
@implements IDisposable

<div class="sgc-field @(Block ? "sgc-block" : "") @CssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label id="@_labelId" class="sgc-label @(Required ? "sgc-required" : "")">@Label</label>
    }
    @if (ChildContent is not null)
    {
        <label @ref="_dropZoneRef" class="sgc-upload sgc-upload-custom @(Disabled ? "sgc-disabled" : "") @(IsInvalid ? "sgc-invalid" : "") @(_isDragOver ? "sgc-drag-over" : "")"
               aria-labelledby="@_labelId"
               aria-invalid="@(IsInvalid ? "true" : null)"
               aria-describedby="@DescribedBy"
               @ondragover:preventDefault="true"
               @ondragover="OnDragOver"
               @ondragenter="OnDragEnter"
               @ondragleave="OnDragLeave"
               @ondrop:preventDefault="true"
               @ondrop="OnDrop">
            <InputFile OnChange="OnFileInputChange" multiple="@Multiple" accept="@Accept" disabled="@Disabled" />
            @ChildContent
        </label>
    }
    else
    {
        <label @ref="_dropZoneRef" class="sgc-upload @(Disabled ? "sgc-disabled" : "") @(IsInvalid ? "sgc-invalid" : "") @(_isDragOver ? "sgc-drag-over" : "")"
               aria-labelledby="@_labelId"
               aria-invalid="@(IsInvalid ? "true" : null)"
               aria-describedby="@DescribedBy"
               @ondragover:preventDefault="true"
               @ondragover="OnDragOver"
               @ondragenter="OnDragEnter"
               @ondragleave="OnDragLeave"
               @ondrop:preventDefault="true"
               @ondrop="OnDrop">
            <InputFile OnChange="OnFileInputChange" multiple="@Multiple" accept="@Accept" disabled="@Disabled" />
            <span class="sgc-upload-icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="24" height="24" fill="currentColor">
                    <path d="M8 1a.75.75 0 0 1 .75.75v5.5h1.5a.25.25 0 0 1 .177.427l-2.25 2.25a.25.25 0 0 1-.354 0l-2.25-2.25A.25.25 0 0 1 5.75 7.25h1.5V1.75A.75.75 0 0 1 8 1zM2 11.75a.75.75 0 0 1 1.5 0v1.5h9v-1.5a.75.75 0 0 1 1.5 0v1.5A1.5 1.5 0 0 1 12.5 15h-9A1.5 1.5 0 0 1 2 13.25v-1.5z"/>
                </svg>
            </span>
            <span class="sgc-upload-text">@(string.IsNullOrEmpty(Text) ? Localizer["FileUpload_DropFiles"] : Text)</span>
            @if (!string.IsNullOrEmpty(AcceptDescription))
            {
                <span class="sgc-upload-hint-text">@AcceptDescription</span>
            }
            else if (!string.IsNullOrEmpty(Accept))
            {
                <span class="sgc-upload-hint-text">@Accept</span>
            }
            @if (MaxFileSizeBytes.HasValue)
            {
                <span class="sgc-upload-hint-text">@string.Format(Localizer["FileUpload_MaxSize"], FormatSize(MaxFileSizeBytes.Value))</span>
            }
        </label>
    }

    @if (Progress.HasValue)
    {
        <div class="sgc-upload-progress">
            <div class="sgc-upload-progress-bar" style="width:@(Progress.Value)%"></div>
            <span class="sgc-upload-progress-text">@Progress.Value%</span>
        </div>
    }

    @if (ShowFileList && _files.Count > 0)
    {
        <ul class="sgc-upload-list" role="list">
            @foreach (var f in _files)
            {
                var file = f;
                var isImage = file.ContentType?.StartsWith("image/") == true;
                <li class="sgc-upload-item" role="listitem">
                    <div class="sgc-upload-item-info">
                        @if (isImage)
                        {
                            <img src="@($"data:{file.ContentType};base64,{_previews.GetValueOrDefault(file.Name)}")"
                                 class="sgc-upload-thumb" alt="" />
                        }
                        else
                        {
                            <svg class="sgc-upload-file-icon" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
                                @if (file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                {
                                    <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/>
                                }
                                else if (file.Name.EndsWith(".doc", StringComparison.OrdinalIgnoreCase) || file.Name.EndsWith(".docx", StringComparison.OrdinalIgnoreCase))
                                {
                                    <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/>
                                }
                                else if (file.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase) || file.Name.EndsWith(".rar", StringComparison.OrdinalIgnoreCase))
                                {
                                    <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/>
                                }
                                else
                                {
                                    <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/>
                                }
                            </svg>
                        }
                        <span class="sgc-upload-item-name" title="@file.Name">@file.Name</span>
                        <span class="sgc-hint">@FormatSize(file.Size)</span>
                    </div>
                    @if (!Disabled)
                    {
                        <button type="button"
                                class="sgc-upload-remove"
                                @onclick="() => RemoveFileAsync(file)"
                                aria-label="@Localizer["Remove"] @file.Name"
                                title="@Localizer["Remove"]">
                            <svg viewBox="0 0 16 16" width="10" height="10" fill="currentColor" aria-hidden="true">
                                <path d="M3.72 3.72a.75.75 0 011.06 0L8 6.94l3.22-3.22a.75.75 0 111.06 1.06L9.06 8l3.22 3.22a.75.75 0 11-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 01-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 010-1.06z"/>
                            </svg>
                        </button>
                    }
                </li>
            }
        </ul>
    }

    @if (IsInvalid)
    {
        <span id="@_errorId" class="sgc-error">@DisplayedError</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@_hintId" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private readonly string _labelId = "sg-upload-label-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _hintId = "sg-upload-hint-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _errorId = "sg-upload-err-" + Guid.NewGuid().ToString("N")[..8];
    private readonly List<IBrowserFile> _files = new();
    private readonly Dictionary<string, string> _previews = new();
    private SgEditContextBinder<IReadOnlyList<IBrowserFile>?>? _binder;
    private bool _isDragOver;
    private ElementReference _dropZoneRef;
    private IJSObjectReference? _dropModule;

    [CascadingParameter] private EditContext? CascadedEditContext { get; set; }

    /// <summary>Gets or sets the expression that identifies the bound value for EditContext validation.</summary>
    [Parameter] public Expression<Func<IReadOnlyList<IBrowserFile>?>>? ValueExpression { get; set; }

    /// <summary>Gets or sets the collection of selected files.</summary>
    [Parameter] public IReadOnlyList<IBrowserFile>? Value { get; set; }

    /// <summary>Gets or sets the callback invoked when the selected files change.</summary>
    [Parameter] public EventCallback<IReadOnlyList<IBrowserFile>?> ValueChanged { get; set; }

    /// <summary>Gets or sets the label text displayed above the file upload area.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Gets or sets the text displayed in the upload area (overrides default).</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Gets or sets the hint text displayed below the upload area.</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>Human-readable description of accepted file types (e.g., "Images: PNG, JPG, GIF").</summary>
    [Parameter] public string? AcceptDescription { get; set; }

    /// <summary>When false, the file list is hidden. The upload area and remove buttons still work. Default is true.</summary>
    [Parameter] public bool ShowFileList { get; set; } = true;

    /// <summary>Maximum number of files allowed. When set, excess files are ignored.</summary>
    [Parameter] public int? MaxFiles { get; set; }

    /// <summary>Callback invoked when the selected files change. Fires after the file list has been updated.</summary>
    [Parameter] public EventCallback<IReadOnlyList<IBrowserFile>?> OnChange { get; set; }

    /// <summary>Gets or sets the error text to display.</summary>
    [Parameter] public string? ErrorText { get; set; }

    /// <summary>Gets or sets the accepted file types (e.g., "image/*", ".pdf,.doc").</summary>
    [Parameter] public string? Accept { get; set; }

    /// <summary>Gets or sets whether multiple files can be selected.</summary>
    [Parameter] public bool Multiple { get; set; }

    /// <summary>Gets or sets whether file selection is required.</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>Gets or sets whether the file upload is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Gets or sets whether the upload area should take full width of its container. Default is true.</summary>
    [Parameter] public bool Block { get; set; } = true;

    /// <summary>Gets or sets the maximum allowed file size in bytes. Files larger than this show a validation error.</summary>
    [Parameter] public long? MaxFileSizeBytes { get; set; }

    /// <summary>Gets or sets additional CSS class names to apply to the field container.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Custom content that replaces the default drag & drop zone content. InputFile is still rendered.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Upload progress percentage (0-100). When set, a progress bar is shown below the upload area.</summary>
    [Parameter] public double? Progress { get; set; }

    /// <summary>Gets or sets the callback invoked when files are selected (legacy).</summary>
    [Parameter] public EventCallback<IReadOnlyList<IBrowserFile>> OnFilesSelected { get; set; }

    private bool IsInvalid => !string.IsNullOrEmpty(ErrorText) || (_binder?.HasValidationErrors ?? false);
    private string? DisplayedError => !string.IsNullOrEmpty(ErrorText)
        ? ErrorText
        : _binder?.ValidationMessages.FirstOrDefault();
    private string? DescribedBy => IsInvalid ? _errorId : (!string.IsNullOrEmpty(Hint) ? _hintId : null);

    protected override void OnInitialized()
    {
        _binder = new SgEditContextBinder<IReadOnlyList<IBrowserFile>?>(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        _binder?.Update(CascadedEditContext, ValueExpression);
        if (Value != null && Value.Count > 0 && _files.Count == 0)
        {
            _files.Clear();
            foreach (var f in Value) _files.Add(f);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dropModule = await _jsRuntime.InvokeAsync<IJSObjectReference>("import",
                "./_content/SuperUI/superui-file-upload.js");
            await _dropModule.InvokeVoidAsync("initDropZone", _dropZoneRef);
        }
    }

    private void OnDragOver(DragEventArgs e) { }
    private void OnDragEnter(DragEventArgs e) { if (!Disabled) _isDragOver = true; }
    private void OnDragLeave(DragEventArgs e) { _isDragOver = false; }

    private async Task OnDrop(DragEventArgs e)
    {
        _isDragOver = false;
        // The native InputFile input is fed by the JS module (superui-file-upload.js)
        // which re-dispatches 'change', routing dropped files through OnFileInputChange.
        await Task.CompletedTask;
    }

    private async Task OnFileInputChange(InputFileChangeEventArgs e)
    {
        _isDragOver = false;
        _files.Clear();
        _previews.Clear();
        ErrorText = null;
        var max = MaxFiles.GetValueOrDefault(100);
        var candidates = Multiple ? e.GetMultipleFiles(max) : new[] { e.File };
        foreach (var f in candidates)
        {
            if (_files.Count >= max) break;
            // Size check
            if (MaxFileSizeBytes.HasValue && f.Size > MaxFileSizeBytes.Value)
            {
                ErrorText = string.Format(Localizer["FileUpload_TooLarge"] ?? "File {0} exceeds max size", f.Name);
                continue;
            }
            // Accept / MIME allow-list
            if (!IsAllowedByAccept(f))
            {
                ErrorText = string.Format(Localizer["FileUpload_InvalidType"] ?? "File type not allowed: {0}", f.Name);
                continue;
            }
            // Magic bytes check (reject HTML masquerading as image)
            var ok = await ValidateMagicBytesAsync(f);
            if (!ok)
            {
                ErrorText = string.Format(Localizer["FileUpload_InvalidType"] ?? "File type not allowed: {0}", f.Name);
                continue;
            }
            _files.Add(f);
        }

        foreach (var f in _files)
        {
            if (f.ContentType?.StartsWith("image/") == true)
            {
                try
                {
                    using var ms = new MemoryStream();
                    await f.OpenReadStream(maxAllowedSize: MaxFileSizeBytes ?? 10_485_760).CopyToAsync(ms);
                    _previews[f.Name] = Convert.ToBase64String(ms.ToArray());
                }
                catch { }
            }
        }

        var fileList = _files.AsReadOnly();
        Value = fileList;

        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(fileList);
        _binder?.NotifyFieldChanged();
        if (OnFilesSelected.HasDelegate) await OnFilesSelected.InvokeAsync(fileList);
        if (OnChange.HasDelegate) await OnChange.InvokeAsync(fileList);
    }

    private bool IsAllowedByAccept(IBrowserFile f)
    {
        if (string.IsNullOrWhiteSpace(Accept)) return true;
        // Block HTML masquerading
        if (f.ContentType == "text/html" || f.Name.EndsWith(".html", StringComparison.OrdinalIgnoreCase) || f.Name.EndsWith(".htm", StringComparison.OrdinalIgnoreCase))
            return false;
        var accept = Accept.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        var ext = System.IO.Path.GetExtension(f.Name).ToLowerInvariant();
        var mime = f.ContentType ?? "";
        foreach (var a in accept)
        {
            if (a.StartsWith(".") && ext == a.ToLowerInvariant()) return true;
            if (a.EndsWith("/*") && mime.StartsWith(a[..^1], StringComparison.OrdinalIgnoreCase)) return true;
            if (string.Equals(a, mime, StringComparison.OrdinalIgnoreCase)) return true;
            if (string.Equals(a, ext, StringComparison.OrdinalIgnoreCase)) return true;
        }
        // If Accept contains wildcard image/* etc, already covered. Otherwise strict.
        return false;
    }

    private async Task<bool> ValidateMagicBytesAsync(IBrowserFile f)
    {
        try
        {
            using var stream = f.OpenReadStream(maxAllowedSize: Math.Min(f.Size, 256));
            var buf = new byte[8];
            var read = await stream.ReadAsync(buf);
            if (read == 0) return true;
            // HTML sniff: <!DOCTYPE, <html, <script
            if (buf[0] == (byte)'<' )
            {
                var head = System.Text.Encoding.ASCII.GetString(buf, 0, read).TrimStart().ToLowerInvariant();
                if (head.StartsWith("<!doctype") || head.StartsWith("<html") || head.StartsWith("<script") || head.StartsWith("<!"))
                    return false;
            }
            // If claimed image/*, ensure magic matches
            if (f.ContentType?.StartsWith("image/") == true)
            {
                var isPng = read >= 8 && buf[0] == 0x89 && buf[1] == 0x50 && buf[2] == 0x4E && buf[3] == 0x47;
                var isJpg = read >= 3 && buf[0] == 0xFF && buf[1] == 0xD8 && buf[2] == 0xFF;
                var isGif = read >= 6 && buf[0] == 0x47 && buf[1] == 0x49 && buf[2] == 0x46;
                var isWebp = read >= 4 && buf[0] == 0x52 && buf[1] == 0x49 && buf[2] == 0x46 && buf[3] == 0x46;
                var isBmp = read >= 2 && buf[0] == 0x42 && buf[1] == 0x4D;
                var isSvg = System.Text.Encoding.ASCII.GetString(buf, 0, read).TrimStart().StartsWith("<svg", StringComparison.OrdinalIgnoreCase);
                if (!(isPng || isJpg || isGif || isWebp || isBmp || isSvg))
                    return false;
            }
            return true;
        }
        catch { return true; }
    }

    private async Task RemoveFileAsync(IBrowserFile file)
    {
        _files.Remove(file);
        _previews.Remove(file.Name);
        var fileList = _files.AsReadOnly();
        Value = fileList;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(fileList);
        _binder?.NotifyFieldChanged();
    }

    private static string FormatSize(long bytes)
    {
        string[] u = { "B", "KB", "MB", "GB" };
        double v = bytes;
        var i = 0;
        while (v >= 1024 && i < u.Length - 1) { v /= 1024; i++; }
        return $"{v:0.##} {u[i]}";
    }

    public void Dispose()
    {
        _binder?.Dispose();
        var module = _dropModule;
        _dropModule = null;
        if (module is not null)
        {
            _ = module.DisposeAsync();
        }
    }
}
