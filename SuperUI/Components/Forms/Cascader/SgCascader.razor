@namespace SuperUI.Components
@implements IAsyncDisposable

<div class="@GetRootClasses()"
     role="combobox"
     aria-expanded="@(_open ? "true" : "false")"
     aria-haspopup="tree"
     aria-label="@Placeholder"
     aria-disabled="@(Disabled ? "true" : "false")"
     @ref="_rootRef"
     tabindex="@(Disabled ? "-1" : "0")"
     @onkeydown="HandleKeyDownAsync"
     @onfocusin="() => _focusWithin = true"
     @onfocusout="HandleFocusOutAsync">

    <div class="sgc-cascader-control" @onclick="ToggleAsync">
        @if (ShowClear && Value.Count > 0 && !Disabled)
        {
            <span class="sgc-cascader-clear" @onclick:stopPropagation="true" @onclick="ClearAsync" role="button" tabindex="-1" aria-label="Clear">
                @ClearIcon
            </span>
        }
        @if (PrefixIcon != null)
        {
            <span class="sgc-cascader-prefix-icon">@PrefixIcon</span>
        }
        @if (!string.IsNullOrEmpty(DisplayText))
        {
            <span class="sgc-cascader-value" title="@DisplayText">@DisplayText</span>
        }
        else
        {
            <span class="sgc-cascader-placeholder">@Placeholder</span>
        }
        @if (Loading)
        {
            <span class="sgc-cascader-loading" aria-hidden="true">
                @LoadingIcon
            </span>
        }
        <span class="sgc-cascader-caret @(_open ? "sgc-cascader-caret-open" : "")" aria-hidden="true">
            @CaretIcon
        </span>
    </div>

    @if (_open)
    {
        <div class="sgc-cascader-menu" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
            @if (Filterable)
            {
                <div class="sgc-cascader-search">
                    <span class="sgc-cascader-search-icon">@SearchIcon</span>
                    <input type="text"
                           class="sgc-cascader-search-input"
                           placeholder="@FilterPlaceholder"
                           @bind-value="_filterText"
                           @bind-value:event="oninput"
                           @ref="_searchInputRef"
                           @onkeydown="HandleSearchKeyDownAsync"
                           @onclick:stopPropagation="true" />
                    @if (!string.IsNullOrEmpty(_filterText))
                    {
                        <span class="sgc-cascader-search-clear" @onclick="ClearFilter" role="button" tabindex="-1">
                            @FilterClearIcon
                        </span>
                    }
                </div>
            }
            <div class="sgc-cascader-columns" @ref="_columnsRef">
                @RenderCascaderContent()
            </div>
            @if (NoDataFound)
            {
                <div class="sgc-cascader-empty">@EmptyText</div>
            }
        </div>
    }
</div>
