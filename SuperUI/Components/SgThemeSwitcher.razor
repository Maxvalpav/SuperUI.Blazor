@namespace SuperUI.Components
@using SuperUI.Services
@using SuperUI.Themes
@using SuperUI.Localization
@inject SgThemeService ThemeService
@inject ISuperUILocalizer Localizer
@implements IAsyncDisposable

<SgDropdown @ref="_dropdown"
            Placement="SgPlacement.BottomEnd"
            MinWidth="280"
            MaxHeight="520"
            MenuCssClass="sgc-theme-switcher-menu">
    <TriggerContent>
        <button type="button"
                class="sgc-btn sgc-ghost sgc-theme-switcher-trigger"
                title="@Localizer.GetString("Theme_TriggerTitle", ThemeService.CurrentTheme.Name, GetModeLabel(ThemeService.CurrentMode))"
                aria-label="@Localizer["Theme_OpenMenu"]">
            <span class="sgc-theme-switcher-trigger-icon" aria-hidden="true">
                <SgIcon Icon="@GetModeIcon(ThemeService.CurrentMode)" Size="14px" />
            </span>
            <span class="sgc-theme-switcher-trigger-text">
                <span class="sgc-theme-switcher-trigger-title">@ThemeService.CurrentTheme.Name</span>
                <span class="sgc-theme-switcher-trigger-subtitle">@GetModeLabel(ThemeService.CurrentMode)</span>
            </span>
        </button>
    </TriggerContent>

    <HeaderContent>
        <div class="sgc-theme-switcher-header">
            <div class="sgc-theme-switcher-header-main">
                <div class="sgc-theme-switcher-eyebrow">@Localizer["Theme_Appearance"]</div>
                <div class="sgc-theme-switcher-title">@ThemeService.CurrentTheme.Name</div>
            </div>
            <button type="button" 
                    class="sgc-theme-reset-btn" 
                    @onclick="ResetToDefaultAsync"
                    title="@Localizer["Theme_ResetToDefault"]">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
            </button>
        </div>
    </HeaderContent>

    <ChildContent>
        <div class="sgc-theme-switcher-modes">
            <button type="button" 
                    class="sgc-theme-mode-btn @(ThemeService.CurrentMode == "light" ? "is-active" : "")"
                    @onclick='() => SetModeAsync("light")'
                    title="@Localizer["Theme_LightModeTitle"]">
                <span class="sgc-theme-mode-icon"><SgIcon Icon="@SgIcons.Sun" Size="14px" /></span>
                <span class="sgc-theme-mode-text">@Localizer["Theme_LightMode"]</span>
            </button>
            <button type="button" 
                    class="sgc-theme-mode-btn @(ThemeService.CurrentMode == "dark" ? "is-active" : "")"
                    @onclick='() => SetModeAsync("dark")'
                    title="@Localizer["Theme_DarkModeTitle"]">
                <span class="sgc-theme-mode-icon"><SgIcon Icon="@SgIcons.Moon" Size="14px" /></span>
                <span class="sgc-theme-mode-text">@Localizer["Theme_DarkMode"]</span>
            </button>
            <button type="button" 
                    class="sgc-theme-mode-btn @(ThemeService.CurrentMode == "auto" ? "is-active" : "")"
                    @onclick='() => SetModeAsync("auto")'
                    title="@Localizer["Theme_AutoModeTitle"]">
                <span class="sgc-theme-mode-icon"><SgIcon Icon="@SgIcons.Monitor" Size="14px" /></span>
                <span class="sgc-theme-mode-text">@Localizer["Theme_AutoMode"]</span>
            </button>
        </div>

        <div class="sgc-theme-switcher-divider"></div>

        <div class="sgc-theme-switcher-section">@Localizer["Theme_Collection"]</div>
        <div class="sgc-theme-grid">
            @foreach (var theme in ThemeService.GetAvailableThemes())
            {
                <button type="button" 
                        class="sgc-theme-grid-item @(ThemeService.CurrentTheme.Id == theme.Id ? "is-active" : "")"
                        @onclick='() => SetThemeAsync(theme.Id)'
                        title="@theme.Description">
                    <div class="sgc-theme-grid-preview" style="--p-color: @theme.Light.ColorPrimary; --s-color: @theme.Light.Surface;">
                        <div class="sgc-theme-grid-preview-primary"></div>
                        <div class="sgc-theme-grid-preview-surface"></div>
                        @if (ThemeService.CurrentTheme.Id == theme.Id)
                        {
                            <span class="sgc-theme-grid-check">
                                <SgIcon Icon="@SgIcons.Check" Size="10px" />
                            </span>
                        }
                    </div>
                    <span class="sgc-theme-grid-name">@theme.Name</span>
                </button>
            }
        </div>
    </ChildContent>

    <FooterContent>
        <div style="display:flex; justify-content:flex-end; padding: 10px 12px;">
            <button type="button" class="sgc-btn" @onclick="CloseAsync">@Localizer["Theme_Close"]</button>
        </div>
    </FooterContent>
</SgDropdown>

@code {
    private SgDropdown? _dropdown;

    protected override async Task OnInitializedAsync()
    {
        await ThemeService.InitializeAsync();
        ThemeService.ThemeChanged += HandleThemeChanged;
    }

    private async Task SetModeAsync(string mode)
    {
        await ThemeService.SetModeAsync(mode);
        await CloseAsync();
    }

    private async Task SetThemeAsync(string themeId)
    {
        await ThemeService.SetThemeAsync(themeId);
        await CloseAsync();
    }

    private async Task ResetToDefaultAsync()
    {
        await ThemeService.SetThemeAsync("superui-default");
        await ThemeService.SetModeAsync("light");
        await CloseAsync();
    }

    private Task CloseAsync() => _dropdown?.CloseAsync() ?? Task.CompletedTask;

    private void HandleThemeChanged(IThemeDefinition theme, string mode)
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetModeLabel(string mode) => mode switch
    {
        "dark" => Localizer["Theme_DarkMode"],
        "auto" => Localizer["Theme_AutoMode"],
        _ => Localizer["Theme_LightMode"]
    };

    private static string GetModeIcon(string mode) => mode switch
    {
        "dark" => SgIcons.Moon,
        "auto" => SgIcons.Monitor,
        _ => SgIcons.Sun
    };

    public async ValueTask DisposeAsync()
    {
        ThemeService.ThemeChanged -= HandleThemeChanged;
        await Task.CompletedTask;
    }
}
