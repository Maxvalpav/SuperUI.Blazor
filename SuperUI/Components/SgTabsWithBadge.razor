@namespace SuperUI.Components
@using SuperUI

<div class="sgc-tabs-with-badge @(Orientation == SgTabsOrientation.Horizontal ? "" : "sgc-tabs-with-badge-vertical") @CssClass"
     style="@Style"
     @attributes="AdditionalAttributes">
    <div class="sgc-tabs-with-badge-strip"
         role="tablist"
         aria-label="@AriaLabel">
        @foreach (var tab in _itemsList)
        {
            var isActive = _activeItemId == tab.Id;
            <button type="button"
                    class="sgc-tabs-with-badge-tab @(isActive ? "sgc-active" : "") @(tab.IsDisabled ? "sgc-disabled" : "") @tab.CssClass"
                    role="tab"
                    id="@tab.TabId"
                    aria-selected="@(isActive ? "true" : "false")"
                    aria-disabled="@(tab.IsDisabled ? "true" : null)"
                    aria-controls="@tab.PanelId"
                    tabindex="@(isActive ? "0" : "-1")"
                    @onclick="() => ActivateTabAsync(tab)"
                    @onkeydown="@(e => OnKeyDownAsync(e, tab))">
                @if (tab.Icon is not null)
                {
                    <span class="sgc-tabs-with-badge-tab-icon">@tab.Icon</span>
                }
                <span class="sgc-tabs-with-badge-tab-text">@tab.Title</span>
                @if (tab.Badge is not null)
                {
                    <SgBadge Variant="@tab.BadgeVariant" CssClass="sgc-tabs-with-badge-tab-badge">@tab.Badge</SgBadge>
                }
                @if (tab.IsClosable)
                {
                    <button type="button"
                            class="sgc-tabs-with-badge-tab-close"
                            aria-label="@(string.IsNullOrEmpty(AriaCloseLabel) ? $"Close {tab.Title}" : AriaCloseLabel)"
                            title="@(string.IsNullOrEmpty(CloseTooltip) ? "Close" : CloseTooltip)"
                            @onclick="async () => await CloseTabAsync(tab)"
                            @onclick:stopPropagation>
                        <span class="sgc-tabs-with-badge-tab-close-icon">@((MarkupString)SgIcons.X)</span>
                    </button>
                }
            </button>
        }
    </div>

    @if (!LazyLoad || ActiveItem is not null)
    {
        <div class="sgc-tabs-with-badge-content"
             role="tabpanel"
             id="@ActiveItem?.PanelId"
             aria-labelledby="@ActiveItem?.TabId"
             tabindex="0">
            @if (ActiveItem is not null)
            {
                @ActiveItem.Content
            }
        </div>
    }
</div>

@code {
    private string? _activeItemId;
    private List<SgTabItem> _itemsList = new();

    /// <summary>
    /// Gets or sets the collection of tab items to display.
    /// </summary>
    [Parameter] public IEnumerable<SgTabItem> Items { get; set; } = Array.Empty<SgTabItem>();

    /// <summary>
    /// Gets or sets the identifier of the currently active tab for two-way binding.
    /// </summary>
    [Parameter] public string? ActiveItemId { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the active tab changes.
    /// </summary>
    [Parameter] public EventCallback<string?> ActiveItemIdChanged { get; set; }

    /// <summary>
    /// Gets or sets the orientation of the tab strip. Default is <see cref="SgTabsOrientation.Horizontal"/>.
    /// </summary>
    [Parameter] public SgTabsOrientation Orientation { get; set; } = SgTabsOrientation.Horizontal;

    /// <summary>
    /// Gets or sets whether to lazily render the content only for the active tab. Default is true.
    /// </summary>
    [Parameter] public bool LazyLoad { get; set; } = true;

    /// <summary>
    /// Gets or sets the callback invoked when a tab's close button is clicked.
    /// The parent component should typically remove the tab from the <see cref="Items"/> collection.
    /// </summary>
    [Parameter] public EventCallback<SgTabItem> OnClose { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes to apply to the root element.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Gets or sets additional inline CSS styles to apply to the root element.
    /// </summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>
    /// Gets or sets the accessible label for the tab list.
    /// </summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// Gets or sets the accessible label for close buttons. Default is "Close {TabTitle}".
    /// </summary>
    [Parameter] public string? AriaCloseLabel { get; set; }

    /// <summary>
    /// Gets or sets the tooltip text for close buttons. Default is "Close".
    /// </summary>
    [Parameter] public string? CloseTooltip { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private SgTabItem? ActiveItem => _itemsList.FirstOrDefault(i => i.Id == _activeItemId);

    /// <summary>
    /// Initializes the component and selects the first non-disabled tab if none is set.
    /// </summary>
    protected override void OnParametersSet()
    {
        // Sync external changes to ActiveItemId
        if (ActiveItemId != _activeItemId)
        {
            _activeItemId = ActiveItemId;
        }

        _itemsList = Items?.ToList() ?? new List<SgTabItem>();

        if (_itemsList.Count == 0)
        {
            _activeItemId = null;
            return;
        }

        // If active ID is null or not present in current list, select first non-disabled
        if (string.IsNullOrEmpty(_activeItemId) || !_itemsList.Any(i => i.Id == _activeItemId))
        {
            var firstEnabled = _itemsList.FirstOrDefault(i => !i.IsDisabled);
            if (firstEnabled != null)
            {
                _activeItemId = firstEnabled.Id;
            }
            else
            {
                // All disabled; pick first
                _activeItemId = _itemsList[0].Id;
            }
        }
        else
        {
            // Active tab exists but might be disabled now
            var current = _itemsList.First(i => i.Id == _activeItemId);
            if (current.IsDisabled)
            {
                var next = _itemsList.FirstOrDefault(i => i.Id != _activeItemId && !i.IsDisabled);
                if (next != null)
                {
                    _activeItemId = next.Id;
                }
                // else keep current even if disabled (no alternative)
            }
        }
    }

    private async Task ActivateTabAsync(SgTabItem tab)
    {
        if (tab.IsDisabled) return;
        if (_activeItemId == tab.Id) return;

        _activeItemId = tab.Id;
        if (ActiveItemIdChanged.HasDelegate)
        {
            await ActiveItemIdChanged.InvokeAsync(tab.Id);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseTabAsync(SgTabItem tab)
    {
        if (tab.IsDisabled) return;

        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync(tab);
        }

        // If the closed tab was active, attempt to activate another
        if (_activeItemId == tab.Id)
        {
            var next = _itemsList.FirstOrDefault(i => i.Id != tab.Id && !i.IsDisabled);
            if (next != null)
            {
                _activeItemId = next.Id;
            }
            else if (_itemsList.Count > 1)
            {
                var any = _itemsList.First(i => i.Id != tab.Id);
                _activeItemId = any.Id;
            }
            else
            {
                _activeItemId = null;
            }

            if (ActiveItemIdChanged.HasDelegate && _activeItemId != null)
            {
                await ActiveItemIdChanged.InvokeAsync(_activeItemId);
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e, SgTabItem tab)
    {
        var index = _itemsList.IndexOf(tab);
        if (index < 0) return;

        SgTabItem? target = null;

        if (Orientation == SgTabsOrientation.Horizontal)
        {
            if (e.Key == "ArrowRight" || e.Key == "ArrowLeft")
            {
                var direction = e.Key == "ArrowRight" ? 1 : -1;
                for (var i = 1; i <= _itemsList.Count; i++)
                {
                    var idx = (index + direction * i + _itemsList.Count) % _itemsList.Count;
                    var t = _itemsList[idx];
                    if (!t.IsDisabled) { target = t; break; }
                }
            }
        }
        else // Vertical
        {
            if (e.Key == "ArrowDown" || e.Key == "ArrowUp")
            {
                var direction = e.Key == "ArrowDown" ? 1 : -1;
                for (var i = 1; i <= _itemsList.Count; i++)
                {
                    var idx = (index + direction * i + _itemsList.Count) % _itemsList.Count;
                    var t = _itemsList[idx];
                    if (!t.IsDisabled) { target = t; break; }
                }
            }
        }

        if (e.Key == "Home")
        {
            target = _itemsList.FirstOrDefault(t => !t.IsDisabled);
        }
        else if (e.Key == "End")
        {
            target = _itemsList.LastOrDefault(t => !t.IsDisabled);
        }
        else if (e.Key == "Enter" || e.Key == " ")
        {
            target = tab.IsDisabled ? null : tab;
        }

        if (target is not null)
        {
            await ActivateTabAsync(target);
        }
    }
}
