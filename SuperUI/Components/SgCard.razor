@namespace SuperUI.Components

<div class="sgc-card @CssClass" style="@Style">
    @if (HeaderContent is not null || !string.IsNullOrEmpty(Title) || !string.IsNullOrEmpty(Subtitle))
    {
        <div class="sgc-card-header">
            @if (HeaderContent is not null) { @HeaderContent }
            else 
            { 
                <div class="sgc-card-header-group">
                    <span class="sgc-card-title">@Title</span>
                    @if (!string.IsNullOrEmpty(Subtitle))
                    {
                        <span class="sgc-card-subtitle">@Subtitle</span>
                    }
                </div>
            }
        </div>
    }
    <div class="sgc-card-body">@ChildContent</div>
    @if (FooterContent is not null)
    {
        <div class="sgc-card-footer">@FooterContent</div>
    }
</div>

@code {
    /// <summary>
    /// Gets or sets the card title text displayed in the header.
    /// </summary>
    [Parameter] public string? Title { get; set; }
    
    /// <summary>
    /// Gets or sets the card subtitle text displayed below the title in the header.
    /// </summary>
    [Parameter] public string? Subtitle { get; set; }
    
    /// <summary>
    /// Gets or sets custom content to render in the card header.
    /// Takes precedence over <see cref="Title"/> and <see cref="Subtitle"/>.
    /// </summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    
    /// <summary>
    /// Gets or sets the main content to render in the card body.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    
    /// <summary>
    /// Gets or sets custom content to render in the card footer.
    /// </summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }
    
    /// <summary>
    /// Gets or sets additional CSS class names to apply to the card.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }
    
    /// <summary>
    /// Gets or sets inline CSS styles to apply to the card.
    /// </summary>
    [Parameter] public string? Style { get; set; }
}
