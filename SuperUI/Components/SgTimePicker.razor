@namespace SuperUI.Components
@using System.Linq.Expressions
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="sgc-field @(Block ? "sgc-block" : "") @(LabelPosition == SgLabelPosition.Left ? "sgc-label-left" : LabelPosition == SgLabelPosition.Right ? "sgc-label-right" : "") @CssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label id="@_labelId" class="sgc-label @(Required ? "sgc-required" : "")">@Label</label>
    }
    
    <div class="sgc-combo sgc-combo-time @(Block ? "sgc-block" : "") @(_open ? "sgc-open" : "") @(Disabled ? "sgc-disabled" : "") @(IsInvalid ? "sgc-invalid" : "")"
         role="combobox"
         aria-expanded="@(_open ? "true" : "false")"
         aria-haspopup="dialog"
         aria-labelledby="@_labelId"
         aria-required="@(Required ? "true" : null)"
         aria-disabled="@(Disabled ? "true" : null)"
         aria-invalid="@(IsInvalid ? "true" : null)"
         aria-describedby="@DescribedBy"
         aria-controls="@_popupId"
         tabindex="@(Disabled ? "-1" : "0")"
         @onfocusout="HandleFocusOutAsync"
         @onclick:stopPropagation="true">
        <div class="sgc-combo-control" @onclick="ToggleAsync">
            @if (Value.HasValue)
            {
                <span class="sgc-combo-value">@GetDisplayTime()</span>
            }
            else
            {
                <span class="sgc-combo-placeholder">@Placeholder</span>
            }
            @if (AllowClear && Value.HasValue && !Disabled && !ReadOnly)
            {
                <button class="sgc-combo-clear" type="button" aria-label="@ClearLabel" title="@ClearLabel"
                        @onclick:stopPropagation="true" @onclick="ClearAsync">
                    @((MarkupString)SgIcons.X)
                </button>
            }
            <span class="sgc-combo-caret" aria-hidden="true">@((MarkupString)SgIcons.Clock)</span>
        </div>

        @if (_open)
        {
            <div id="@_popupId" class="sgc-time-popup" role="dialog" @onmousedown:stopPropagation @onmousedown:preventDefault>
                <div class="sgc-time-header">
                    <div class="sgc-time-inputs">
                        <button type="button" class="sgc-time-input-btn @(_mode == PickerMode.Hours ? "active" : "")" 
                                @onclick="() => _mode = PickerMode.Hours">
                            @GetDisplayHour()
                        </button>
                        <span class="sgc-time-separator">:</span>
                        <button type="button" class="sgc-time-input-btn @(_mode == PickerMode.Minutes ? "active" : "")" 
                                @onclick="() => _mode = PickerMode.Minutes">
                            @GetDisplayMinute()
                        </button>
                        @if (ShowSeconds)
                        {
                            <span class="sgc-time-separator">:</span>
                            <button type="button" class="sgc-time-input-btn @(_mode == PickerMode.Seconds ? "active" : "")" 
                                    @onclick="() => _mode = PickerMode.Seconds">
                                @GetDisplaySecond()
                            </button>
                        }
                    </div>
                    @if (UseAmPm)
                    {
                        <div class="sgc-time-ampm">
                            <button type="button" class="sgc-ampm-btn @(IsAm ? "active" : "")" @onclick="() => SetAmPm(true)">AM</button>
                            <button type="button" class="sgc-ampm-btn @(!IsAm ? "active" : "")" @onclick="() => SetAmPm(false)">PM</button>
                        </div>
                    }
                </div>

                <div class="sgc-time-content">
                    @if (_viewType == ViewType.Clock)
                    {
                        <div class="sgc-clock-face" @ref="_clockFaceRef">
                            <div class="sgc-clock-inner-ring"></div>
                            <div class="sgc-clock-center"></div>
                            <div class="sgc-clock-hand @(_isDragging ? "sgc-no-transition" : "")" style="transform: rotate(@(GetHandRotation())deg)">
                                <div class="sgc-clock-hand-dot"></div>
                            </div>
                            @if (_mode == PickerMode.Hours)
                            {
                                @for (int h = 1; h <= 12; h++)
                                {
                                    var hour = h;
                                    var angle = (hour * 30);
                                    var isSelected = IsHourSelected(hour);
                                    <div class="sgc-clock-number @(isSelected ? "selected" : "")" style="transform: translate(-50%, -50%) rotate(@(angle)deg) translateY(-82px) rotate(@(-angle)deg)">
                                        @hour
                                    </div>
                                }
                            }
                            else
                            {
                                @for (int i = 0; i < 60; i += 5)
                                {
                                    var val = i;
                                    var angle = (val * 6);
                                    var isSelected = (_mode == PickerMode.Minutes ? _pendingValue.Minutes : _pendingValue.Seconds) == val;
                                    <div class="sgc-clock-number @(isSelected ? "selected" : "")" style="transform: translate(-50%, -50%) rotate(@(angle)deg) translateY(-82px) rotate(@(-angle)deg)">
                                        @val.ToString("D2")
                                    </div>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <div class="sgc-time-lists">
                             <div class="sgc-time-list-col">
                                @for (int h = 0; h < (UseAmPm ? 12 : 24); h++)
                                {
                                    var hour = h;
                                    if (UseAmPm && h == 0) hour = 12;
                                    var currentH = hour;
                                    <div class="sgc-time-list-item @(IsHourSelected(currentH) ? "sgc-selected" : "")" 
                                         @onclick="() => { SetHour(currentH); _mode = PickerMode.Minutes; }">
                                        @currentH.ToString("D2")
                                    </div>
                                }
                            </div>
                            <div class="sgc-time-list-col">
                                @for (int m = 0; m < 60; m += MinuteStep)
                                {
                                    var min = m;
                                    <div class="sgc-time-list-item @(_pendingValue.Minutes == min ? "sgc-selected" : "")" 
                                         @onclick="() => { SetMinute(min); if(ShowSeconds) _mode = PickerMode.Seconds; }">
                                        @min.ToString("D2")
                                    </div>
                                }
                            </div>
                            @if (ShowSeconds)
                            {
                                <div class="sgc-time-list-col">
                                    @for (int s = 0; s < 60; s += 5)
                                    {
                                        var sec = s;
                                        <div class="sgc-time-list-item @(_pendingValue.Seconds == sec ? "sgc-selected" : "")" 
                                             @onclick="() => SetSecond(sec)">
                                            @sec.ToString("D2")
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="sgc-time-footer">
                    <button type="button" class="sgc-time-toggle-btn" @onclick="ToggleViewTypeAsync">
                        @if (_viewType == ViewType.Clock)
                        {
                            <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor"><path d="M1 2.75C1 1.784 1.784 1 2.75 1h10.5c.966 0 1.75.784 1.75 1.75v10.5A1.75 1.75 0 0113.25 15H2.75A1.75 1.75 0 011 13.25V2.75zm1.75-.25a.25.25 0 00-.25.25v10.5c0 .138.112.25.25.25h10.5a.25.25 0 00.25-.25V2.75a.25.25 0 00-.25-.25H2.75zM4 5.5a1 1 0 112 0 1 1 0 01-2 0zM7.75 5a.75.75 0 000 1.5h4.5a.75.75 0 000-1.5h-4.5zM4 8.5a1 1 0 112 0 1 1 0 01-2 0zM7.75 8a.75.75 0 000 1.5h4.5a.75.75 0 000-1.5h-4.5zm-3.75 3a1 1 0 112 0 1 1 0 01-2 0zm3.75-.5a.75.75 0 000 1.5h4.5a.75.75 0 000-1.5h-4.5z"/></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor"><path d="M8 16A8 8 0 118 0a8 8 0 010 16zM8 1.5a6.5 6.5 0 100 13 6.5 6.5 0 000-13z"/><path d="M8 3.5a.75.75 0 01.75.75v4.25h3a.75.75 0 010 1.5H8a.75.75 0 01-.75-.75V4.25A.75.75 0 018 3.5z"/></svg>
                        }
                    </button>
                    <div style="flex:1"></div>
                    <button type="button" class="sgc-btn sgc-sm sgc-ghost" @onclick="CloseAsync">@Localizer["Common_Cancel"]</button>
                    <button type="button" class="sgc-btn sgc-sm" @onclick="ConfirmAsync">@Localizer["Common_OK"]</button>
                </div>
            </div>
        }
    </div>

    @if (IsInvalid)
    {
        <span id="@_errorId" class="sgc-error">@DisplayedError</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@_hintId" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private enum PickerMode { Hours, Minutes, Seconds }
    private enum ViewType { Clock, List }

    private readonly string _labelId = "sg-time-label-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _hintId = "sg-time-hint-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _errorId = "sg-time-err-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _popupId = "sg-time-popup-" + Guid.NewGuid().ToString("N")[..8];
    
    private bool _open;
    private PickerMode _mode = PickerMode.Hours;
    private ViewType _viewType = ViewType.List;
    private TimeSpan _pendingValue;
    private bool _isDragging;
    
    private ElementReference _clockFaceRef;
    private IJSObjectReference? _module;
    private IJSObjectReference? _clockInstance;
    private DotNetObjectReference<SgTimePicker>? _selfRef;

    private SgEditContextBinder<TimeSpan?>? _binder;

    [CascadingParameter] private EditContext? CascadedEditContext { get; set; }
    
    [Parameter] public Expression<Func<TimeSpan?>>? ValueExpression { get; set; }
    [Parameter] public TimeSpan? Value { get; set; }
    [Parameter] public EventCallback<TimeSpan?> ValueChanged { get; set; }
    
    [Parameter] public bool ShowSeconds { get; set; }
    [Parameter] public bool UseAmPm { get; set; }
    [Parameter] public int MinuteStep { get; set; } = 1;
    
    [Parameter] public string? Label { get; set; }
    [Parameter] public SgLabelPosition LabelPosition { get; set; } = SgLabelPosition.Top;
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public string Placeholder { get; set; } = "--:--";
    [Parameter] public bool AllowClear { get; set; } = true;
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Block { get; set; } = true;
    [Parameter] public string? CssClass { get; set; }

    private bool IsInvalid => !string.IsNullOrEmpty(ErrorText) || (_binder?.HasValidationErrors ?? false);
    private string? DisplayedError => !string.IsNullOrEmpty(ErrorText) ? ErrorText : _binder?.ValidationMessages.FirstOrDefault();
    private string? DescribedBy => IsInvalid ? _errorId : (!string.IsNullOrEmpty(Hint) ? _hintId : null);
    private string ClearLabel => Localizer["Common_Clear"];

    private bool IsAm => _pendingValue.Hours < 12;

    protected override void OnInitialized()
    {
        _binder = new SgEditContextBinder<TimeSpan?>(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        _binder?.Update(CascadedEditContext, ValueExpression);
        if (!_open) _pendingValue = Value ?? TimeSpan.Zero;
    }

    private string GetDisplayTime()
    {
        if (!Value.HasValue) return "";
        var h = Value.Value.Hours;
        var m = Value.Value.Minutes;
        var s = Value.Value.Seconds;
        
        string time;
        if (UseAmPm)
        {
            var ampm = h >= 12 ? "PM" : "AM";
            h = h % 12;
            if (h == 0) h = 12;
            time = $"{h:D2}:{m:D2}";
            if (ShowSeconds) time += $":{s:D2}";
            return $"{time} {ampm}";
        }
        
        time = $"{h:D2}:{m:D2}";
        if (ShowSeconds) time += $":{s:D2}";
        return time;
    }

    private string GetDisplayHour()
    {
        var h = _pendingValue.Hours;
        if (UseAmPm)
        {
            h = h % 12;
            if (h == 0) h = 12;
        }
        return h.ToString("D2");
    }

    private string GetDisplayMinute() => _pendingValue.Minutes.ToString("D2");
    private string GetDisplaySecond() => _pendingValue.Seconds.ToString("D2");

    private bool IsHourSelected(int h)
    {
        if (UseAmPm)
        {
            var currentH = _pendingValue.Hours % 12;
            if (currentH == 0) currentH = 12;
            return currentH == h;
        }
        return _pendingValue.Hours == h;
    }

    private void SetAmPm(bool am)
    {
        var h = _pendingValue.Hours;
        if (am && h >= 12) h -= 12;
        else if (!am && h < 12) h += 12;
        _pendingValue = new TimeSpan(h, _pendingValue.Minutes, _pendingValue.Seconds);
    }

    private void SetHour(int h)
    {
        int finalH = h;
        if (UseAmPm)
        {
            var isPm = _pendingValue.Hours >= 12;
            finalH = h % 12;
            if (isPm) finalH += 12;
            else if (finalH == 12) finalH = 0; // 12 AM is 0
        }
        _pendingValue = new TimeSpan(finalH, _pendingValue.Minutes, _pendingValue.Seconds);
        // Не переключаем режим здесь, так как SetHour вызывается при каждом OnClockMove
    }

    private void SetMinute(int m)
    {
        _pendingValue = new TimeSpan(_pendingValue.Hours, m, _pendingValue.Seconds);
    }

    private void SetSecond(int s)
    {
        _pendingValue = new TimeSpan(_pendingValue.Hours, _pendingValue.Minutes, s);
    }

    private double GetHandRotation()
    {
        if (_mode == PickerMode.Hours)
        {
            var h = _pendingValue.Hours % 12;
            return h * 30;
        }
        if (_mode == PickerMode.Minutes) return _pendingValue.Minutes * 6;
        return _pendingValue.Seconds * 6;
    }

    [JSInvokable]
    public void OnClockMove(double angle)
    {
        _isDragging = true;
        UpdateFromAngle(angle);
    }

    [JSInvokable]
    public async Task OnClockUp()
    {
        _isDragging = false;
        if (_mode == PickerMode.Hours)
        {
            _mode = PickerMode.Minutes;
        }
        else if (_mode == PickerMode.Minutes && ShowSeconds)
        {
            _mode = PickerMode.Seconds;
        }
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateFromAngle(double angle)
    {
        if (_mode == PickerMode.Hours)
        {
            var h = (int)Math.Round(angle / 30);
            if (h == 0) h = 12;
            SetHour(h);
        }
        else if (_mode == PickerMode.Minutes)
        {
            var m = (int)Math.Round(angle / 6);
            if (m == 60) m = 0;
            
            // Apply MinuteStep
            if (MinuteStep > 1)
            {
                m = (int)Math.Round((double)m / MinuteStep) * MinuteStep;
                if (m == 60) m = 0;
            }
            
            SetMinute(m);
        }
        else if (_mode == PickerMode.Seconds)
        {
            var s = (int)Math.Round(angle / 6);
            if (s == 60) s = 0;
            SetSecond(s);
        }
        StateHasChanged();
    }

    private void ToggleViewType() => _viewType = _viewType == ViewType.Clock ? ViewType.List : ViewType.Clock;

    private async Task ToggleAsync()
    {
        if (Disabled || ReadOnly) return;
        _open = !_open;
        if (_open)
        {
            _pendingValue = Value ?? DateTime.Now.TimeOfDay;
            _mode = PickerMode.Hours;
            
            // Initialize JS clock if in clock mode
            if (_viewType == ViewType.Clock)
            {
                await Task.Delay(50); // Wait for popup to render
                await InitJsClockAsync();
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task InitJsClockAsync()
    {
        try
        {
            if (_module == null)
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/superui-timepicker.js");
            }
            
            if (_clockInstance != null)
            {
                await _clockInstance.InvokeVoidAsync("dispose");
                _clockInstance = null;
            }
            
            _selfRef ??= DotNetObjectReference.Create(this);
            _clockInstance = await _module.InvokeAsync<IJSObjectReference>("initClock", _selfRef, _clockFaceRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to init clock JS: {ex.Message}");
        }
    }

    private async Task ToggleViewTypeAsync()
    {
        _viewType = _viewType == ViewType.Clock ? ViewType.List : ViewType.Clock;
        if (_viewType == ViewType.Clock)
        {
            await Task.Delay(50);
            await InitJsClockAsync();
        }
    }

    private async Task HandleFocusOutAsync(FocusEventArgs e)
    {
        await Task.Delay(200);
        if (!_isDragging) _open = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmAsync()
    {
        Value = _pendingValue;
        _open = false;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(Value);
        _binder?.NotifyFieldChanged();
    }

    private Task CloseAsync()
    {
        _open = false;
        return Task.CompletedTask;
    }

    private async Task ClearAsync()
    {
        _open = false;
        Value = null;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(null);
        _binder?.NotifyFieldChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_clockInstance != null)
        {
            try { await _clockInstance.InvokeVoidAsync("dispose"); } catch { }
            await _clockInstance.DisposeAsync();
        }
        if (_module != null) await _module.DisposeAsync();
        _selfRef?.Dispose();
        _binder?.Dispose();
    }
}

