@namespace SuperUI.Components
@inherits SgFormFieldBase<TimeSpan?>

<div class="@GetFieldClasses()" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sgc-label @(Required ? "sgc-required" : "")" for="@EffectiveId">@Label</label>
    }
    
    <div class="@GetControlClasses()"
         role="combobox"
         aria-expanded="@(_open ? "true" : "false")"
         aria-haspopup="listbox"
         aria-disabled="@(IsEffectivelyDisabled ? "true" : null)"
         aria-invalid="@(HasError ? "true" : null)"
         tabindex="@(IsEffectivelyDisabled ? "-1" : "0")"
         @onfocusout="HandleFocusOutAsync"
         @onclick:stopPropagation="true">
        
        <div class="sgc-combo-control" @onclick="ToggleAsync">
            @if (Value.HasValue)
            {
                <span class="sgc-combo-value">@(Value.Value.Hours.ToString("D2") + ":" + Value.Value.Minutes.ToString("D2") + (ShowSeconds ? ":" + Value.Value.Seconds.ToString("D2") : ""))</span>
            }
            else
            {
                <span class="sgc-combo-placeholder">@(Placeholder ?? "--:--")</span>
            }
            
            @if (AllowClear && Value.HasValue && !IsEffectivelyDisabled && !ReadOnly)
            {
                <button class="sgc-combo-clear" type="button" aria-label="@ClearLabel" title="@ClearLabel"
                        @onclick:stopPropagation="true" @onclick="ClearAsync">
                    @((MarkupString)SgIcons.X)
                </button>
            }
            <span class="sgc-combo-caret" aria-hidden="true">@((MarkupString)SgIcons.Clock)</span>
        </div>

        @if (_open)
        {
            <div class="sgc-time-popup" role="listbox" @onclick:stopPropagation="true">
                <div class="sgc-time-col sgc-thin-scroll">
                    @for (int h = 0; h < 24; h++)
                    {
                        var hour = h;
                        <div class="sgc-time-unit @(Value?.Hours == hour ? "sgc-selected" : "")"
                             @onmousedown:preventDefault="true"
                             @onclick="() => SetHour(hour)">
                            @hour.ToString("D2")
                        </div>
                    }
                </div>
                <div class="sgc-time-col sgc-thin-scroll">
                    @for (int m = 0; m < 60; m++)
                    {
                        var min = m;
                        <div class="sgc-time-unit @(Value?.Minutes == min ? "sgc-selected" : "")"
                             @onmousedown:preventDefault="true"
                             @onclick="() => SetMinute(min)">
                            @min.ToString("D2")
                        </div>
                    }
                </div>
                @if (ShowSeconds)
                {
                    <div class="sgc-time-col sgc-thin-scroll">
                        @for (int s = 0; s < 60; s++)
                        {
                            var sec = s;
                            <div class="sgc-time-unit @(Value?.Seconds == sec ? "sgc-selected" : "")"
                                 @onmousedown:preventDefault="true"
                                 @onclick="() => SetSecond(sec)">
                                @sec.ToString("D2")
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (HasError)
    {
        <span class="sgc-error">@ValidationMessages.FirstOrDefault()</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span class="sgc-hint">@Hint</span>
    }
</div>
