@namespace SuperUI.Components
@inject ISuperUILocalizer Localizer

<div class="sgc-activity-feed @CssClass" style="@Style">
    @if (HeaderContent is not null || !string.IsNullOrWhiteSpace(Title))
    {
        <div class="sgc-activity-feed-header">
            <div>
                @if (HeaderContent is not null)
                {
                    @HeaderContent
                }
                else
                {
                    <div class="sgc-activity-feed-title">@Title</div>
                    @if (!string.IsNullOrWhiteSpace(Subtitle))
                    {
                        <div class="sgc-activity-feed-subtitle">@Subtitle</div>
                    }
                }
            </div>
            @if (ActionsContent is not null)
            {
                <div class="sgc-activity-feed-actions">@ActionsContent</div>
            }
        </div>
    }

    @if (_items.Count == 0)
    {
        <div class="sgc-activity-feed-empty">@EmptyText</div>
    }
    else
    {
        <div class="sgc-activity-feed-list">
            @if (Virtualize)
            {
                <SgVirtualList TItem="ActivityFeedItem" Items="_items" Height="@Height" ItemHeight="100">
                    <ChildContent>
                        @RenderItem(context)
                    </ChildContent>
                </SgVirtualList>
            }
            else if (GroupBy is not null)
            {
                @foreach (var group in _items.GroupBy(GroupBy))
                {
                    <div class="sgc-activity-feed-group">
                        <div class="sgc-activity-feed-group-title">@group.Key</div>
                        @foreach (var item in group)
                        {
                            @RenderItem(item)
                        }
                    </div>
                }
            }
            else
            {
                @foreach (var item in _items)
                {
                    @RenderItem(item)
                }
            }
        </div>
    }
</div>

@code {
    private RenderFragment RenderItem(ActivityFeedItem item) =>
        @<div class="sgc-activity-feed-item @(OnItemClick.HasDelegate ? "sgc-activity-feed-item-clickable" : "")"
              @onclick="@(() => HandleItemClickAsync(item))">
            <div class="sgc-activity-feed-marker">
                <div class="sgc-activity-feed-avatar" style="background:@item.AccentColor;" aria-hidden="true">
                    @if (item.IconContent is not null)
                    {
                        @item.IconContent
                    }
                    else if (!string.IsNullOrEmpty(item.AvatarUrl))
                    {
                        <img src="@item.AvatarUrl" alt="@item.User" class="sgc-activity-feed-avatar-img" />
                    }
                    else if (!string.IsNullOrEmpty(item.User))
                    {
                        <span>@GetInitials(item.User)</span>
                    }
                </div>
                <div class="sgc-activity-feed-line"></div>
            </div>
            <div class="sgc-activity-feed-card">
                <div class="sgc-activity-feed-row">
                    <div class="sgc-activity-feed-main">
                        @if (!string.IsNullOrWhiteSpace(item.Title))
                        {
                            <div class="sgc-activity-feed-item-title">@item.Title</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <div class="sgc-activity-feed-item-description">@item.Description</div>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(item.BadgeText))
                    {
                        <SgBadge Text="@item.BadgeText" Variant="@item.BadgeVariant" />
                    }
                </div>
                <div class="sgc-activity-feed-meta">
                    @if (!string.IsNullOrWhiteSpace(item.User))
                    {
                        <span>@item.User</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.Time))
                    {
                        <span>@item.Time</span>
                    }
                </div>
                @if (item.ExtraContent is not null)
                {
                    <div class="sgc-activity-feed-extra">@item.ExtraContent</div>
                }
            </div>
        </div>;

    /// <summary>
    /// Gets or sets the panel title text.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// Gets or sets the subtitle text displayed below the title.
    /// </summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>
    /// Gets or sets the collection of activity feed items to display.
    /// </summary>
    [Parameter] public IEnumerable<ActivityFeedItem> Items { get; set; } = Array.Empty<ActivityFeedItem>();

    /// <summary>
    /// Gets or sets the text displayed when there are no items.
    /// </summary>
    [Parameter] public string EmptyText { get; set; } = "Событий пока нет.";

    /// <summary>
    /// Gets or sets additional CSS classes to apply to the component.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Gets or sets inline styles to apply to the component.
    /// </summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>
    /// Gets or sets whether to virtualize the feed.
    /// </summary>
    [Parameter] public bool Virtualize { get; set; }

    /// <summary>
    /// Gets or sets the container height used when <see cref="Virtualize"/> is true.
    /// Default is "500px".
    /// </summary>
    [Parameter] public string Height { get; set; } = "500px";

    /// <summary>
    /// Gets or sets a grouping selector (e.g. <c>item => item.Time</c> for date grouping).
    /// </summary>
    [Parameter] public Func<ActivityFeedItem, string>? GroupBy { get; set; }

    /// <summary>
    /// Gets or sets the custom header content.
    /// Takes precedence over <see cref="Title"/> and <see cref="Subtitle"/>.
    /// </summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    /// <summary>
    /// Gets or sets the action buttons content displayed in the header.
    /// </summary>
    [Parameter] public RenderFragment? ActionsContent { get; set; }

    /// <summary>
    /// Raised when an item is clicked. When not set, items are not styled as clickable.
    /// </summary>
    [Parameter] public EventCallback<ActivityFeedItem> OnItemClick { get; set; }

    private List<ActivityFeedItem> _items = new();

    protected override void OnParametersSet()
    {
        _items = Items.ToList();
    }

    private async Task HandleItemClickAsync(ActivityFeedItem item)
    {
        if (OnItemClick.HasDelegate)
            await OnItemClick.InvokeAsync(item);
    }

    private static string GetInitials(string user)
    {
        var parts = user.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}"
            : user.Length >= 2 ? user[..2] : user;
    }
}
