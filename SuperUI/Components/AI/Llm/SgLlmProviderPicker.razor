@namespace SuperUI.Components.Llm
@using SuperUI.Services.Llm
@inject ILlmService LlmService
@inject ISuperUILocalizer Localizer

@*
   SgLlmProviderPicker — каталог провайдеров с поиском, категориями-чипсами,
   быстрыми фильтрами и сеткой карточек. Стиль карточки вынесен
   в SgLlmProviderCard.
*@

<div class="sgc-llm-picker @CssClass" style="@Style">
    <div class="sgc-llm-picker-toolbar">
        <SgTextBox @bind-Value="_filter" Placeholder="@Localizer["Llm_SearchPlaceholder"]" />
        <div class="sgc-llm-picker-quick">
            <SgSwitch @bind-Value="_freeOnly" Label="@Localizer["Llm_FreeFilter"]" />
            <SgSwitch @bind-Value="_localOnly" Label="@Localizer["Llm_LocalFilter"]" />
            <SgSwitch @bind-Value="_visionOnly" Label="@Localizer["Llm_VisionFilter"]" />
            <SgSwitch @bind-Value="_embedOnly" Label="@Localizer["Llm_EmbedFilter"]" />
            <SgSwitch @bind-Value="_audioOnly" Label="@Localizer["Llm_AudioFilter"]" />
        </div>
    </div>

    <div class="sgc-llm-picker-categories">
        @foreach (var cat in _allCategories)
        {
            var label = CategoryLabel(cat);
            var count = CountForCategory(cat);
            var active = _selectedCategory == cat;
            <button type="button"
                    class="sgc-llm-picker-cat @(active ? "active" : "")"
                    @onclick="@(() => ToggleCategory(cat))">
                <span>@label</span>
                <em>@count</em>
            </button>
        }
        @if (HasAnyFilter)
        {
            <button type="button" class="sgc-llm-picker-cat clear" @onclick="ClearFilters" title="@Localizer["Llm_ResetFilters"]">
                ✕ @Localizer["Llm_ClearFilters"]
            </button>
        }
    </div>

    @{
        var visible = Filtered().ToList();
    }

    @if (visible.Count == 0)
    {
        <div class="sgc-llm-picker-empty">
            <div class="sgc-llm-picker-empty-icon">🔎</div>
            <div class="sgc-llm-picker-empty-title">@Localizer["Llm_NoProvidersFound"]</div>
            <div class="sgc-llm-picker-empty-hint">@Localizer["Llm_AdjustFiltersHint"]</div>
            <button type="button" class="sgc-llm-picker-empty-btn" @onclick="ClearFilters">@Localizer["Llm_ResetFilters"]</button>
        </div>
    }
    else
    {
        <div class="sgc-llm-picker-summary">
            @Localizer.GetString("Llm_ProvidersShown", visible.Count, SgLlmProviderRegistry.Presets.Count)
        </div>
        <div class="sgc-llm-picker-grid">
            @foreach (var p in visible)
            {
                <SgLlmProviderCard
                    Preset="p"
                    Active="@IsSelected(p)"
                    Current="@IsCurrent(p)"
                    OnClick="SelectAsync" />
            }
        </div>
    }
</div>

@code {
    /// <summary>Custom CSS class applied to the provider picker container.</summary>
    [Parameter] public string CssClass { get; set; } = "";
    /// <summary>Custom inline styles applied to the provider picker container.</summary>
    [Parameter] public string Style { get; set; } = "";
    /// <summary>Gets or sets the LLM provider configuration.</summary>
    [Parameter] public SgLlmConfig? Config { get; set; }
    /// <summary>Callback invoked when the configuration changes.</summary>
    [Parameter] public EventCallback<SgLlmConfig> ConfigChanged { get; set; }
    /// <summary>Callback invoked when a provider is selected.</summary>
    [Parameter] public EventCallback<SgLlmProviderPreset> OnSelected { get; set; }

    private string _filter = string.Empty;
    private bool _freeOnly;
    private bool _localOnly;
    private bool _visionOnly;
    private bool _embedOnly;
    private bool _audioOnly;
    private string? _selectedCategory;

    private static readonly string[] _allCategories = new[]
    {
        SgLlmProviderCategory.Frontier,
        SgLlmProviderCategory.OpenRouting,
        SgLlmProviderCategory.FastInference,
        SgLlmProviderCategory.Local,
        SgLlmProviderCategory.Free,
        SgLlmProviderCategory.Russian,
        SgLlmProviderCategory.Specialty,
        SgLlmProviderCategory.Azure
    };

    private bool HasAnyFilter =>
        !string.IsNullOrWhiteSpace(_filter)
        || _freeOnly || _localOnly || _visionOnly || _embedOnly || _audioOnly
        || _selectedCategory != null;

    private string CategoryLabel(string cat) => cat switch
    {
        SgLlmProviderCategory.Frontier => Localizer["Llm_CategoryFrontier"],
        SgLlmProviderCategory.OpenRouting => Localizer["Llm_CategoryOpenRouting"],
        SgLlmProviderCategory.FastInference => Localizer["Llm_CategoryFastInference"],
        SgLlmProviderCategory.Local => Localizer["Llm_CategoryLocal"],
        SgLlmProviderCategory.Free => Localizer["Llm_CategoryFree"],
        SgLlmProviderCategory.Russian => Localizer["Llm_CategoryRussian"],
        SgLlmProviderCategory.Specialty => Localizer["Llm_CategorySpecialty"],
        SgLlmProviderCategory.Azure => "☁ Azure",
        _ => cat
    };

    private int CountForCategory(string cat) =>
        SgLlmProviderRegistry.Presets.Count(p => p.Category == cat);

    private void ToggleCategory(string cat)
    {
        _selectedCategory = _selectedCategory == cat ? null : cat;
    }

    private void ClearFilters()
    {
        _filter = string.Empty;
        _freeOnly = _localOnly = _visionOnly = _embedOnly = _audioOnly = false;
        _selectedCategory = null;
    }

    private IEnumerable<SgLlmProviderPreset> Filtered()
    {
        var query = SgLlmProviderRegistry.Presets.AsEnumerable();

        if (_selectedCategory != null)
            query = query.Where(p => p.Category == _selectedCategory);

        if (_freeOnly)
            query = query.Where(p => p.IsFree || p.Tags.Contains(SgLlmProviderTag.Free));

        if (_localOnly)
            query = query.Where(p => p.Category == SgLlmProviderCategory.Local || p.Tags.Contains(SgLlmProviderTag.Local));

        if (_visionOnly)
            query = query.Where(p => p.SupportsVision || p.Tags.Contains(SgLlmProviderTag.Vision));

        if (_embedOnly)
            query = query.Where(p => p.SupportsEmbeddings || p.Tags.Contains(SgLlmProviderTag.Embeddings));

        if (_audioOnly)
            query = query.Where(p =>
                p.SupportsAudioStt || p.SupportsAudioTts || p.Tags.Contains(SgLlmProviderTag.Audio));

        if (!string.IsNullOrWhiteSpace(_filter))
        {
            var f = _filter.Trim();
            // Russian-language aliases: "русский" → russian tag.
            var ruRussian = f.Contains("русск", StringComparison.OrdinalIgnoreCase)
                || f.Contains("россий", StringComparison.OrdinalIgnoreCase);

            query = query.Where(p =>
                p.Label.Contains(f, StringComparison.OrdinalIgnoreCase)
                || (p.Notes?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false)
                || (p.FreeTierNotes?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false)
                || p.Provider.ToString().Contains(f, StringComparison.OrdinalIgnoreCase)
                || p.Tags.Any(t => t.Contains(f, StringComparison.OrdinalIgnoreCase))
                || p.Category.Contains(f, StringComparison.OrdinalIgnoreCase)
                || (ruRussian && p.Tags.Contains(SgLlmProviderTag.Russian)));
        }

        return query;
    }

    private bool IsSelected(SgLlmProviderPreset p) =>
        Config != null && Config.Provider == p.Provider;

    private bool IsCurrent(SgLlmProviderPreset p) =>
        LlmService.CurrentConfig != null && LlmService.CurrentConfig.Provider == p.Provider;

    private async Task SelectAsync(SgLlmProviderPreset p)
    {
        if (Config != null)
        {
            Config.Provider = p.Provider;
            Config.ModelId = null;
            if (!string.IsNullOrEmpty(p.BaseUrl)) Config.BaseUrl = p.BaseUrl;
            if (!p.RequiresKey) Config.ApiKey = string.Empty;
            if (ConfigChanged.HasDelegate) await ConfigChanged.InvokeAsync(Config);
        }
        if (OnSelected.HasDelegate) await OnSelected.InvokeAsync(p);
    }
}

