@namespace SuperUI.Components.Llm
@using SuperUI.Services.Llm
@inject ILlmService LlmService
@inject ISuperUILocalizer Localizer

@*
   SgLlmToolPlayground — позволяет описать несколько JSON-schema tools и отправить
   диалог. Поддерживает локальное "исполнение" встроенных утилит (echo / now /
   js_eval) — пользователь может тестировать tool-calling без подключения настоящих
   функций.
*@

<div class="sgc-llm-tools @CssClass" style="@Style">
    <SgLlmHeader Title="@Localizer["Llm_ToolPlayTitle"]" Subtitle="@Localizer["Llm_ToolPlaySubtitle"]"
                 TaskPurpose="@SgLlmTaskPurpose.Chat" />

    <SgTextArea @bind-Value="_systemPrompt" Rows="2"
                Placeholder="System prompt (опционально)" Label="System" />

    <div class="sgc-tools-list">
        @foreach (var (t, idx) in _tools.Select((v, i) => (v, i)))
        {
            var localIdx = idx;
            var schemaErr = ValidateToolSchema(t.ParametersJsonSchema);
            <SgCard>
                <div class="sgc-tools-row">
                    <SgTextBox @bind-Value="t.Name" Placeholder="@Localizer["Llm_ToolNamePlaceholder"]" Label="@Localizer["Llm_ToolName"]" />
                    <SgTextBox @bind-Value="t.Description" Placeholder="@Localizer["Llm_ToolDescriptionPlaceholder"]" Label="@Localizer["Llm_ToolDescription"]" />
                    <SgIconButton Icon="@SgIcons.Trash" Variant="SgButtonVariant.Ghost"
                                  OnClick="@(() => _tools.RemoveAt(localIdx))" />
                </div>
                <SgTextArea @bind-Value="t.ParametersJsonSchema" Rows="4"
                            Placeholder='{"type":"object","properties":{"x":{"type":"number"}},"required":["x"]}'
                            Label="JSON Schema параметров" />
                @if (!string.IsNullOrEmpty(schemaErr))
                {
                    <div class="sgc-tools-schema-err">⚠ @schemaErr</div>
                }
            </SgCard>
        }
    </div>

    <div class="sgc-tools-actions">
        <SgButton Text="@Localizer["Llm_AddTool"]" OnClick="AddTool" Variant="SgButtonVariant.Outlined" />
        <SgButton Text="echo" OnClick="@(() => AddBuiltIn("echo", "Возвращает ввод как есть", "{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]}"))"
                  Variant="SgButtonVariant.Ghost" />
        <SgButton Text="now" OnClick="@(() => AddBuiltIn("now", "Возвращает текущую дату/время", "{\"type\":\"object\",\"properties\":{}}"))"
                  Variant="SgButtonVariant.Ghost" />
        <SgButton Text="calc" OnClick="@(() => AddBuiltIn("calc", "Вычисляет арифметическое выражение", "{\"type\":\"object\",\"properties\":{\"expr\":{\"type\":\"string\"}},\"required\":[\"expr\"]}"))"
                  Variant="SgButtonVariant.Ghost" />
    </div>

    <SgTextArea @bind-Value="_userMessage" Rows="3"
                Placeholder="Сообщение пользователя..." Label="User" />

    <div class="sgc-tools-actions">
        <SgTextBox @bind-Value="_model" Placeholder="gpt-4o-mini" Label="Модель" />
        <SgButton Text="@Localizer["Llm_Send"]" OnClick="RunAsync" Loading="_busy" Variant="SgButtonVariant.Primary"
                  Disabled="@HasInvalidToolSchemas" />
    </div>
    @if (HasInvalidToolSchemas)
    {
        <SgAlert Variant="SgAlertVariant.Warn">У одного или нескольких инструментов невалидная JSON Schema — исправьте перед отправкой.</SgAlert>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <SgAlert Variant="SgAlertVariant.Danger">@_error</SgAlert>
    }

    @if (_transcript.Count > 0)
    {
        <SgCard>
            <h4 style="margin-top:0">Диалог</h4>
            @foreach (var step in _transcript)
            {
                <div class="sgc-tools-step">
                    <SgBadge Variant="@(step.Role == "tool" ? SgBadgeVariant.Info :
                                       step.Role == "assistant" ? SgBadgeVariant.Default :
                                       SgBadgeVariant.Muted)">@step.Role</SgBadge>
                    <pre>@step.Text</pre>
                </div>
            }
        </SgCard>
    }
</div>

<style>
    .sgc-llm-tools { display: flex; flex-direction: column; gap: 12px; padding: 12px; }
    .sgc-tools-list { display: flex; flex-direction: column; gap: 8px; }
    .sgc-tools-row { display: grid; grid-template-columns: 1fr 2fr auto; gap: 8px; align-items: end; }
    .sgc-tools-actions { display: flex; gap: 8px; align-items: end; flex-wrap: wrap; }
    .sgc-tools-step { display: flex; gap: 8px; align-items: start; margin: 6px 0; }
    .sgc-tools-step pre { margin: 0; white-space: pre-wrap; word-break: break-word; flex: 1; font-family: inherit; }
    .sgc-tools-schema-err {
        margin-top: 4px;
        background: #fef2f2; color: #991b1b; border: 1px solid #fecaca;
        border-radius: 6px; padding: 4px 8px; font-size: 11.5px; font-family: monospace;
    }
</style>

@code {
    [Parameter] public string CssClass { get; set; } = "";
    /// <summary>Custom inline styles applied to the tool playground container.</summary>
    [Parameter] public string Style { get; set; } = "";
    /// <summary>The purpose description for the tool playground.</summary>
    [Parameter] public string TaskPurpose { get; set; } = SgLlmTaskPurpose.Structured;

    private string _systemPrompt = "Ты вежливый ассистент. Если можешь использовать функцию — используй её.";
    private string _userMessage = "Сколько сейчас времени?";
    private string _model = "";
    private bool _busy;
    private string _error = "";

    private readonly List<SgLlmTool> _tools = new();
    private readonly List<TranscriptStep> _transcript = new();

    private record TranscriptStep(string Role, string Text);

    private bool HasInvalidToolSchemas =>
        _tools.Any(t => !string.IsNullOrEmpty(ValidateToolSchema(t.ParametersJsonSchema)));

    private static string ValidateToolSchema(string? schema)
    {
        if (string.IsNullOrWhiteSpace(schema)) return "";
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(schema);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object)
                return "Schema должен быть объектом ({...}).";
            return "";
        }
        catch (Exception ex)
        {
            return $"Невалидный JSON: {ex.Message}";
        }
    }

    private void AddTool() => _tools.Add(new SgLlmTool { Name = "my_func", ParametersJsonSchema = "{\"type\":\"object\",\"properties\":{}}" });

    private void AddBuiltIn(string name, string description, string schema)
    {
        if (_tools.Any(t => t.Name == name)) return;
        _tools.Add(new SgLlmTool { Name = name, Description = description, ParametersJsonSchema = schema });
    }

    private async Task RunAsync()
    {
        _busy = true; _error = ""; _transcript.Clear();
        try
        {
            var effective = LlmService.ResolveConfigForTask(TaskPurpose);
            await LlmService.InitializeAsync(effective);
            var messages = new List<SgLlmChatMsg>();
            if (!string.IsNullOrWhiteSpace(_systemPrompt))
                messages.Add(new() { Role = "system", Content = _systemPrompt });
            messages.Add(new() { Role = "user", Content = _userMessage });
            _transcript.Add(new("user", _userMessage));

            for (var hop = 0; hop < 4; hop++)
            {
                var res = await LlmService.CompleteAsync(new SgLlmChatRequest
                {
                    Messages = messages,
                    Model = string.IsNullOrWhiteSpace(_model) ? effective.ModelId : _model,
                    Tools = _tools.Where(t => !string.IsNullOrWhiteSpace(t.Name)).ToList()
                });
                if (!string.IsNullOrEmpty(res.Error)) { _error = res.Error; return; }

                if (res.ToolCalls.Count > 0)
                {
                    messages.Add(new SgLlmChatMsg
                    {
                        Role = "assistant",
                        Content = res.Content ?? "",
                        ToolCalls = res.ToolCalls
                    });
                    foreach (var call in res.ToolCalls)
                    {
                        var output = await ExecuteToolLocal(call);
                        _transcript.Add(new("assistant", $"→ call {call.Name}({call.ArgumentsJson})"));
                        _transcript.Add(new("tool", output));
                        messages.Add(new SgLlmChatMsg
                        {
                            Role = "tool",
                            Content = output,
                            ToolCallId = call.Id,
                            Name = call.Name
                        });
                    }
                    continue;
                }

                _transcript.Add(new("assistant", res.Content ?? ""));
                return;
            }
            _error = "Слишком много tool-call раундов (>4).";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private static Task<string> ExecuteToolLocal(SgLlmToolCall call)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(string.IsNullOrEmpty(call.ArgumentsJson) ? "{}" : call.ArgumentsJson);
            switch (call.Name)
            {
                case "echo":
                    return Task.FromResult(doc.RootElement.TryGetProperty("text", out var t) ? (t.GetString() ?? "") : "");
                case "now":
                    return Task.FromResult(DateTime.Now.ToString("O"));
                case "calc":
                    var expr = doc.RootElement.TryGetProperty("expr", out var e) ? e.GetString() ?? "" : "";
                    return Task.FromResult(EvalSimple(expr));
                default:
                    return Task.FromResult("(не реализовано локально — подключите свою функцию)");
            }
        }
        catch (Exception ex) { return Task.FromResult($"ERROR: {ex.Message}"); }
    }

    private static string EvalSimple(string expr)
    {
        try
        {
            var dt = new System.Data.DataTable();
            var r = dt.Compute(expr, "");
            return r?.ToString() ?? "";
        }
        catch (Exception ex) { return $"ERROR: {ex.Message}"; }
    }
}
