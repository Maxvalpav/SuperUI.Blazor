@namespace SuperUI.Components.Llm
@using SuperUI.Services.Llm
@inject IOpenRouterService OpenRouterService
@inject ISuperUILocalizer Localizer

<div class="sgc-or-picker @CssClass" style="@Style">
    <div class="sgc-or-search">
        <SgTextBox Placeholder="@Localizer["Llm_SearchModelsPlaceholder"]" @bind-Value="_searchQuery" @bind-Value:after="OnSearchChanged" AllowClear="true">
            <StartIcon>@((MarkupString)SgIcons.Search)</StartIcon>
        </SgTextBox>
        
        <div class="sgc-or-filters">
            <SgSwitch Label="@Localizer["Llm_FreeOnly"]" @bind-Value="_onlyFree" OnChanged="ApplyFilters" />
            <SgButton Text="@Localizer["Llm_RefreshList"]" Size="SgSize.Sm" OnClick="LoadModelsAsync" Loading="_loading" Variant="SgButtonVariant.Ghost" />
        </div>
    </div>

    <div class="sgc-or-list">
        @if (_loading)
        {
            <div class="sgc-or-state">
                <SgSpinner Size="SgSize.Sm" />
                <span>Загрузка моделей OpenRouter...</span>
            </div>
        }
        else if (!_filteredModels.Any())
        {
            <div class="sgc-or-state">
                @((MarkupString)SgIcons.Info)
                <span>Модели не найдены</span>
            </div>
        }
        else
        {
            @foreach (var model in _filteredModels)
            {
                <div class="sgc-or-item @(SelectedModelId == model.Id ? "sgc-active" : "")" @onclick="() => SelectModel(model)">
                    <div class="sgc-or-item-header">
                        <span class="sgc-or-model-name">@model.Name</span>
                        @if (model.IsFree)
                        {
                            <SgBadge Variant="SgBadgeVariant.Success">Free</SgBadge>
                        }
                    </div>
                    <div class="sgc-or-model-id">@model.Id</div>
                    <div class="sgc-or-model-info">
                        <span>Context: @(model.ContextLength / 1024)k</span>
                        @if (!model.IsFree)
                        {
                            <span class="sgc-or-pricing">
                                $@(model.Pricing.Prompt)/1M prompt
                            </span>
                        }
                    </div>
                </div>
            }
        }
    </div>

    @if (_selectedModel != null)
    {
        <div class="sgc-or-details">
            <h4>@_selectedModel.Name</h4>
            <p class="sgc-or-desc">@_selectedModel.Description</p>
            <div class="sgc-or-meta">
                <div class="sgc-or-meta-item">
                    <label>ID:</label> <span>@_selectedModel.Id</span>
                </div>
                <div class="sgc-or-meta-item">
                    <label>Архитектура:</label> <span>@(_selectedModel.Architecture?.Modality ?? "N/A")</span>
                </div>
                <div class="sgc-or-meta-item">
                    <label>Токенизатор:</label> <span>@(_selectedModel.Architecture?.Tokenizer ?? "N/A")</span>
                </div>
            </div>
        </div>
    }
</div>


@code {
    /// <summary>Gets or sets the selected model ID.</summary>
    [Parameter] public string? SelectedModelId { get; set; }
    /// <summary>Callback invoked when the selected model ID changes.</summary>
    [Parameter] public EventCallback<string> SelectedModelIdChanged { get; set; }
    /// <summary>Callback invoked when a model is selected.</summary>
    [Parameter] public EventCallback<SgOpenRouterModel> OnModelSelected { get; set; }
    /// <summary>Custom inline styles applied to the model picker container.</summary>
    [Parameter] public string? Style { get; set; }
    /// <summary>Custom CSS class applied to the model picker container.</summary>
    [Parameter] public string? CssClass { get; set; }

    private List<SgOpenRouterModel> _allModels = new();
    private List<SgOpenRouterModel> _filteredModels = new();
    private SgOpenRouterModel? _selectedModel;
    private bool _loading;
    private string _searchQuery = "";
    private bool _onlyFree;

    protected override async Task OnInitializedAsync()
    {
        await LoadModelsAsync();
    }

    private async Task LoadModelsAsync()
    {
        _loading = true;
        _allModels = await OpenRouterService.GetModelsAsync();
        ApplyFilters();
        _loading = false;
    }

    private void OnSearchChanged() => ApplyFilters();

    private void ApplyFilters()
    {
        var query = _searchQuery?.Trim().ToLower() ?? "";
        _filteredModels = _allModels
            .Where(m => string.IsNullOrEmpty(query) || m.Name.ToLower().Contains(query) || m.Id.ToLower().Contains(query))
            .Where(m => !_onlyFree || m.IsFree)
            .OrderBy(m => m.Name)
            .ToList();

        if (!string.IsNullOrEmpty(SelectedModelId))
        {
            _selectedModel = _allModels.FirstOrDefault(m => m.Id == SelectedModelId);
        }
    }

    private async Task SelectModel(SgOpenRouterModel model)
    {
        _selectedModel = model;
        SelectedModelId = model.Id;
        await SelectedModelIdChanged.InvokeAsync(model.Id);
        await OnModelSelected.InvokeAsync(model);
    }
}
