@namespace SuperUI.Components.Llm
@using SuperUI.Services.Llm
@inject ILlmService LlmService
@inject ISuperUILocalizer Localizer

@*
   SgLlmModerator — проверка текста через /moderations.
   Показывает категории и их веса.
*@

<div class="sgc-llm-moderator @CssClass" style="@Style">
    <SgLlmHeader Title="@Localizer["Llm_ModerationTitle"]" Subtitle="@Localizer["Llm_ModerationSubtitle"]"
                 TaskPurpose="@SgLlmTaskPurpose.Moderation" />

    <SgTextArea @bind-Value="_text" Rows="4"
                Placeholder="Текст для модерации..." />

    <div class="sgc-mod-controls">
        <SgTextBox @bind-Value="_model" Placeholder="omni-moderation-latest" Label="Модель" />
    </div>

    <div class="sgc-mod-actions">
        <SgButton Text="@Localizer["Llm_Check"]" OnClick="RunAsync" Loading="_busy"
                  Variant="SgButtonVariant.Primary" Disabled="@string.IsNullOrWhiteSpace(_text)" />
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <SgAlert Variant="SgAlertVariant.Danger">@_error</SgAlert>
    }

    @if (_result == null && !_busy && string.IsNullOrEmpty(_error))
    {
        <SgLlmEmptyState Icon="🛡" Title="@Localizer["Llm_ModerationEmptyTitle"]"
                         Message="Сервис вернёт флаги категорий (hate, sexual, violence, self-harm…) и их веса." />
    }

    @if (_result != null)
    {
        <SgCard>
            <div class="sgc-mod-header">
                <SgBadge Variant="@(_result.Flagged ? SgBadgeVariant.Danger : SgBadgeVariant.Success)">
                    @(_result.Flagged ? Localizer["Llm_Flagged"] : Localizer["Llm_Ok"])
                </SgBadge>
                @foreach (var c in _result.Categories)
                {
                    <SgBadge Variant="SgBadgeVariant.Warn">@c</SgBadge>
                }
            </div>

            <table class="sgc-mod-scores">
                <thead><tr><th>Категория</th><th>Score</th><th></th></tr></thead>
                <tbody>
                    @foreach (var kv in _result.CategoryScores.OrderByDescending(k => k.Value))
                    {
                        <tr>
                            <td>@kv.Key</td>
                            <td>@kv.Value.ToString("F4")</td>
                            <td style="width: 200px;">
                                <SgProgress Value="@(kv.Value * 100)"
                                            Variant="@ScoreVariant(kv.Value)" Size="SgSize.Sm" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </SgCard>
    }
</div>


@code {
    [Parameter] public string CssClass { get; set; } = "";
    /// <summary>Custom inline styles applied to the moderator container.</summary>
    [Parameter] public string Style { get; set; } = "";
    /// <summary>The purpose description for moderation.</summary>
    [Parameter] public string TaskPurpose { get; set; } = SgLlmTaskPurpose.Moderation;

    private string _text = "";
    private string _model = "omni-moderation-latest";
    private bool _busy;
    private string _error = "";
    private SgLlmModerationResult? _result;

    private async Task RunAsync()
    {
        if (string.IsNullOrWhiteSpace(_text)) return;
        _busy = true; _error = ""; _result = null;
        try
        {
            var effective = LlmService.ResolveConfigForTask(TaskPurpose);
            await LlmService.InitializeAsync(effective);
            _result = await LlmService.ModerateAsync(_text, string.IsNullOrWhiteSpace(_model) ? effective.ModelId : _model);
            if (!string.IsNullOrEmpty(_result.Error)) _error = _result.Error;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private static SgSpinnerVariant ScoreVariant(double s) =>
        s >= 0.7 ? SgSpinnerVariant.Danger :
        s >= 0.4 ? SgSpinnerVariant.Warn :
        SgSpinnerVariant.Success;
}
