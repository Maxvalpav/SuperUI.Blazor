@namespace SuperUI.Components
@using SuperUI.Services.Llm
@inject ILlmService LlmService

@*
   SgLlmSettings — universal LLM provider + parameter editor.

   • Compact = true:  one-row inline editor (provider chip + model + key) with a
                       popover holding the rest. Designed to live in a chat toolbar.
   • Compact = false: full panel (the original side-settings layout).

   The advanced switch (Расширенные) gates Config.UseAdvanced. When it's OFF, the
   LLM service only forwards Provider / ModelId / ApiKey / BaseUrl / SystemPrompt —
   nothing in the "Advanced" section is sent to the API.
*@

<div class="sgc-llm-settings @(Compact ? "sgc-llm-compact" : "")" style="@Style">

    @if (Compact)
    {
        <div class="sgc-llm-compact-row">
            <SgPopover ButtonText="@($"{Config.Provider}")"
                       ButtonVariant="SgButtonVariant.Outlined"
                       ButtonSize="SgSize.Sm"
                       Title="@Localizer["Llm_ProviderTitle"]"
                       Placement="SgPlacement.BottomStart">
                <ChildContent>
                    <div class="sgc-llm-provider-grid" style="min-width: 280px;">
                        @foreach (var provider in _providers)
                        {
                            <button type="button"
                                    class="sgc-provider-tab @(Config.Provider == provider ? "active" : "")"
                                    @onclick="@(() => OnProviderChanged(provider))">
                                @provider
                            </button>
                        }
                    </div>
                </ChildContent>
            </SgPopover>

            @if (Config.Provider != SgLlmProvider.None)
            {
                <SgAutoComplete TItem="string" @bind-Value="Config.ModelId" Items="_orModelIds"
                                Placeholder="@Localizer["Llm_ModelPlaceholder"]" MaxResults="200"
                                Style="flex: 1; min-width: 160px;" />

                <SgTextBox @bind-Value="Config.ApiKey" Type="password" Placeholder="sk-..."
                           Style="width: 140px;" />

                <SgIconButton Icon="@SgIcons.Refresh" OnClick="LoadModelsAsync"
                              Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" Loading="_loadingModels" />

                <SgPopover Title="@Localizer["Llm_Settings"]" Placement="SgPlacement.BottomEnd">
                    <TriggerContent>
                        <SgIconButton Icon="@SgIcons.Settings" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
                    </TriggerContent>
                    <ChildContent>
                        <div style="min-width: 420px; max-width: 480px;">
                            @RenderFullSettings()
                        </div>
                    </ChildContent>
                </SgPopover>

                <SgButton Text="@Localizer["Common_Apply"]" OnClick="ApplySettingsAsync"
                          Variant="SgButtonVariant.Primary" Size="SgSize.Sm" />
            }

            <div class="sgc-status-dot @(_lastStatus.ToLower())" title="@_statusText"></div>
        </div>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 12px;">
            <div style="display: flex; flex-direction: column; gap: 8px;">
                <div class="sgc-llm-provider-tabs">
                    @foreach (var provider in _providers)
                    {
                        <button type="button"
                                class="sgc-provider-tab @(Config.Provider == provider ? "active" : "") @(LlmService.CurrentConfig?.Provider == provider ? "current" : "")"
                                @onclick="@(() => OnProviderChanged(provider))">
                            @provider
                        </button>
                    }
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: var(--sui-fg-muted);">
                    <span>@Localizer["Llm_Provider"]: <b>@Config.Provider</b></span>
                    <SgSwitch @bind-Value="_showLogs" Label="@Localizer["Llm_Logs"]" Size="SgSize.Sm" />
                </div>
            </div>

            @if (Config.Provider != SgLlmProvider.None)
            {
                @RenderFullSettings()

                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 4px;">
                    <div style="display: flex; align-items: center; gap: 8px; font-size: 12px;">
                        <div class="sgc-status-dot @(_lastStatus.ToLower())"></div>
                        <span style="color: var(--sui-fg-muted)">@_statusText</span>
                    </div>
                    <SgButton Text="@Localizer["Common_Apply"]" OnClick="ApplySettingsAsync" Variant="SgButtonVariant.Primary" Size="SgSize.Sm" />
                </div>

                @if (_showLogs)
                {
                    <div class="sgc-llm-logs">
                        @foreach (var log in _logs)
                        {
                            <div class="sgc-log-entry">
                                <span class="sgc-log-time">@log.Time.ToString("HH:mm:ss")</span>
                                <span class="sgc-log-msg @log.Type.ToLower()">@log.Message</span>
                            </div>
                        }
                        @if (!_logs.Any())
                        {
                            <div style="color: var(--sui-fg-muted); font-style: italic; font-size: 11px;">@Localizer["Llm_NoLogs"]</div>
                        }
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    RenderFragment RenderFullSettings() => __builder =>
    {
        <div style="display: flex; flex-direction: column; gap: 10px;">
            @* Model row *@
            <div style="display: flex; gap: 8px; align-items: flex-end;">
                <SgSwitch @bind-Value="_manualModel" Label="@Localizer["Llm_Manual"]" Style="margin-bottom: 8px; white-space: nowrap;" />
                <div style="flex: 1;">
                    @if (_manualModel)
                    {
                        <SgTextBox Label="@Localizer["Llm_ModelId"]" @bind-Value="Config.ModelId" Placeholder="gpt-4o-mini" />
                    }
                    else if (Config.Provider == SgLlmProvider.Ollama)
                    {
                        <div style="display: flex; flex-direction: column;">
                            <label class="sgc-label">@Localizer["Llm_PickModel"]</label>
                            <SgOllamaModelPicker SelectedModelId="@Config.ModelId"
                                                 BaseUrl="@Config.BaseUrl"
                                                 OnSelected="OnModelSelected"
                                                 Style="width: 100%;" />
                        </div>
                    }
                    else
                    {
                        <SgAutoComplete TItem="string" Label="@Localizer["Llm_PickModel"]" @bind-Value="Config.ModelId"
                                        Items="_orModelIds" Placeholder="@Localizer["Llm_ModelPlaceholder"]" Style="flex: 1;" MaxResults="500" />
                    }
                </div>
                <SgIconButton Icon="@SgIcons.Refresh" OnClick="LoadModelsAsync" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" Loading="_loadingModels" Style="margin-bottom: 8px;" />
            </div>

            @* Connection: API key + Base URL (+Azure deployment) *@
            <div class="sgc-llm-compact-grid">
                <SgTextBox Label="API Key" @bind-Value="Config.ApiKey" Type="password" Placeholder="sk-..." />
                @if (NeedsBaseUrl(Config.Provider))
                {
                    <SgTextBox Label="Base URL" @bind-Value="Config.BaseUrl" Placeholder="@DefaultBaseUrl(Config.Provider)" />
                }
            </div>

            @if (Config.Provider == SgLlmProvider.AzureOpenAi)
            {
                <div class="sgc-llm-compact-grid">
                    <SgTextBox Label="@Localizer["Llm_AzureDeployment"]" @bind-Value="Config.AzureDeployment" Placeholder="my-deployment" />
                    <SgTextBox Label="@Localizer["Llm_AzureApiVersion"]" @bind-Value="Config.AzureApiVersion" Placeholder="2024-10-21" />
                </div>
            }

            @* System prompt *@
            <SgTextBox Label="@Localizer["Llm_SystemPrompt"]" @bind-Value="Config.SystemPrompt" Multiline="true" Rows="2"
                       Placeholder="@Localizer["Llm_SystemPromptHint"]" />

            @* Advanced switch *@
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 4px;">
                <SgSwitch @bind-Value="Config.UseAdvanced" Label="@Localizer["Llm_Advanced"]" Size="SgSize.Sm" />
                @if (!Config.UseAdvanced)
                {
                    <span style="font-size: 11px; color: var(--sui-fg-muted);">@Localizer["Llm_BasicOnlyHint"]</span>
                }
            </div>

            @if (Config.UseAdvanced)
            {
                @* Provider context strip *@
                <div class="sgc-llm-advanced-panel">
                    @if (Config.Provider == SgLlmProvider.OpenRouter)
                    {
                        <div class="sgc-llm-info-section">
                            <SgOpenRouterKeyInfo ApiKey="@Config.ApiKey" />
                            <SgOpenRouterModelDetails ModelId="@Config.ModelId" />
                        </div>
                    }
                    else if (Config.Provider == SgLlmProvider.Ollama)
                    {
                        <div class="sgc-llm-ollama-status">
                            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px;">
                                <span>@Localizer["Llm_OllamaStatus"]:</span>
                                <SgBadge Variant="@(_lastStatus == "Success" ? SgBadgeVariant.Success : SgBadgeVariant.Danger)" Size="SgSize.Sm">
                                    @(_lastStatus == "Success" ? @Localizer["Llm_Connected"] : @Localizer["Llm_NotConnected"])
                                </SgBadge>
                            </div>
                        </div>
                    }

                    @* Sampling *@
                    <details open class="sgc-llm-group">
                        <summary>@Localizer["Llm_Sampling"]</summary>
                        <div class="sgc-llm-advanced-row">
                            <div class="sgc-llm-advanced-field">
                                <label class="sgc-label-sm">Temperature (@Config.Temperature.ToString("F2"))</label>
                                <SgSlider @bind-Value="Config.Temperature" Min="0" Max="2" Step="0.01" />
                            </div>
                            <div class="sgc-llm-advanced-field">
                                <label class="sgc-label-sm">Top P (@Config.TopP.ToString("F2"))</label>
                                <SgSlider @bind-Value="Config.TopP" Min="0" Max="1" Step="0.01" />
                            </div>
                        </div>
                        @if (SupportsTopKMinP(Config.Provider))
                        {
                            <div class="sgc-llm-advanced-row">
                                <div class="sgc-llm-advanced-field">
                                    <label class="sgc-label-sm">Top K</label>
                                    <SgNumberInput TValue="int?" @bind-Value="Config.TopK" Placeholder="Auto" Size="SgSize.Sm" />
                                </div>
                                <div class="sgc-llm-advanced-field">
                                    <label class="sgc-label-sm">Min P</label>
                                    <SgNumberInput TValue="double?" @bind-Value="Config.MinP" Placeholder="Auto" Step="0.01" Size="SgSize.Sm" />
                                </div>
                                <div class="sgc-llm-advanced-field">
                                    <label class="sgc-label-sm">Rep. Penalty</label>
                                    <SgNumberInput TValue="double?" @bind-Value="Config.RepetitionPenalty" Placeholder="1.0" Step="0.05" Size="SgSize.Sm" />
                                </div>
                            </div>
                        }
                        @if (SupportsPenalties(Config.Provider))
                        {
                            <div class="sgc-llm-advanced-row">
                                <div class="sgc-llm-advanced-field">
                                    <label class="sgc-label-sm">Pres. Pen. (@Config.PresencePenalty.ToString("F1"))</label>
                                    <SgSlider @bind-Value="Config.PresencePenalty" Min="-2" Max="2" Step="0.1" />
                                </div>
                                <div class="sgc-llm-advanced-field">
                                    <label class="sgc-label-sm">Freq. Pen. (@Config.FrequencyPenalty.ToString("F1"))</label>
                                    <SgSlider @bind-Value="Config.FrequencyPenalty" Min="-2" Max="2" Step="0.1" />
                                </div>
                            </div>
                        }
                        <div class="sgc-llm-advanced-row">
                            <SgNumberInput TValue="int?" Label="Max Tokens" @bind-Value="Config.MaxTokens" Placeholder="Auto" Style="flex: 1;" Size="SgSize.Sm" />
                            <SgNumberInput TValue="int?" Label="Seed" @bind-Value="Config.Seed" Placeholder="Random" Style="flex: 1;" Size="SgSize.Sm" />
                        </div>
                        <div class="sgc-llm-advanced-row">
                            <SgTextBox Label="@Localizer["Llm_StopSequences"]" Value="@_stopText"
                                       ValueChanged="@((string? v) => OnStopChanged(v))" Placeholder="\\n\\n, ###" Style="flex: 1;" Size="SgSize.Sm" />
                        </div>
                    </details>

                    @* Output controls *@
                    <details class="sgc-llm-group">
                        <summary>@Localizer["Llm_Output"]</summary>
                        <div class="sgc-llm-advanced-row">
                            <SgSelect TValue="string" Label="Response format" @bind-Value="Config.ResponseFormat"
                                      Items="_responseFormats" Placeholder="default" AllowClear="true" />
                            <SgSwitch @bind-Value="_logProbsBool" Label="LogProbs" Size="SgSize.Sm" />
                        </div>
                        @if (Config.ResponseFormat == "json_schema")
                        {
                            <SgTextBox Label="JSON schema" @bind-Value="Config.JsonSchema" Multiline="true" Rows="4"
                                       Placeholder=@("{\"name\":\"out\",\"schema\":{\"type\":\"object\"}}") />
                        }
                        <div class="sgc-llm-advanced-row">
                            <SgSwitch @bind-Value="_parallelToolCallsBool" Label="@Localizer["Llm_ParallelTools"]" Size="SgSize.Sm" />
                            <SgSwitch @bind-Value="_streamUsageBool" Label="@Localizer["Llm_StreamUsage"]" Size="SgSize.Sm" />
                        </div>
                    </details>

                    @* Reasoning *@
                    @if (SupportsReasoning(Config.Provider))
                    {
                        <details class="sgc-llm-group">
                            <summary>@Localizer["Llm_Reasoning"]</summary>
                            <div class="sgc-llm-advanced-row">
                                <SgSelect TValue="string" Label="reasoning_effort" @bind-Value="Config.ReasoningEffort"
                                          Items="_effortLevels" Placeholder="default" AllowClear="true" />
                                <SgSelect TValue="string" Label="verbosity" @bind-Value="Config.Verbosity"
                                          Items="_verbosityLevels" Placeholder="default" AllowClear="true" />
                            </div>
                        </details>
                    }

                    @* Anthropic-specific *@
                    @if (Config.Provider == SgLlmProvider.Anthropic)
                    {
                        <details class="sgc-llm-group">
                            <summary>Anthropic — extended thinking</summary>
                            <div class="sgc-llm-advanced-row">
                                <SgSwitch @bind-Value="_anthropicThinkingBool" Label="@Localizer["Llm_EnableThinking"]" Size="SgSize.Sm" />
                                <SgNumberInput TValue="int?" Label="Thinking budget (tok)" @bind-Value="Config.AnthropicThinkingBudgetTokens" Placeholder="4096" Size="SgSize.Sm" />
                            </div>
                        </details>
                    }

                    @* Gemini-specific *@
                    @if (Config.Provider == SgLlmProvider.Google)
                    {
                        <details class="sgc-llm-group">
                            <summary>Gemini — safety + thinking</summary>
                            <div class="sgc-llm-advanced-row">
                                <SgSelect TValue="string" Label="Safety threshold" @bind-Value="Config.GeminiSafetyThreshold"
                                          Items="_geminiSafetyLevels" Placeholder="default" AllowClear="true" />
                                <SgNumberInput TValue="int?" Label="Thinking budget" @bind-Value="Config.GeminiThinkingBudget" Placeholder="Auto" Size="SgSize.Sm" />
                            </div>
                            <SgSwitch @bind-Value="_geminiIncludeThoughtsBool" Label="@Localizer["Llm_IncludeThoughts"]" Size="SgSize.Sm" />
                        </details>
                    }

                    @* OpenRouter-specific *@
                    @if (Config.Provider == SgLlmProvider.OpenRouter)
                    {
                        <details class="sgc-llm-group">
                            <summary>OpenRouter — routing</summary>
                            <div class="sgc-llm-advanced-row">
                                <SgSelect TValue="string" Label="Provider sort" @bind-Value="Config.OrProviderSort"
                                          Items="_orSortOptions" Placeholder="auto" AllowClear="true" />
                                <SgSelect TValue="string" Label="Transforms" @bind-Value="Config.OrTransforms"
                                          Items="_orTransforms" Placeholder="none" AllowClear="true" />
                            </div>
                            <SgTextBox Label="Fallback models (comma-separated)" Value="@_orFallbackText"
                                       ValueChanged="@((string? v) => OnOrFallbackChanged(v))" Placeholder="openai/gpt-4o, anthropic/claude-3-5-sonnet" />
                            <div class="sgc-llm-advanced-row">
                                <SgTextBox Label="Allowed providers" Value="@_orAllowedText"
                                           ValueChanged="@((string? v) => OnOrAllowedChanged(v))" Placeholder="openai, anthropic" Style="flex: 1;" />
                                <SgTextBox Label="Ignored providers" Value="@_orIgnoredText"
                                           ValueChanged="@((string? v) => OnOrIgnoredChanged(v))" Placeholder="..." Style="flex: 1;" />
                            </div>
                            <div class="sgc-llm-advanced-row">
                                <SgSwitch @bind-Value="_orRequireParametersBool" Label="@Localizer["Llm_OrRequireParams"]" Size="SgSize.Sm" />
                                <SgSwitch @bind-Value="_orAllowDataCollectionBool" Label="@Localizer["Llm_OrAllowData"]" Size="SgSize.Sm" />
                            </div>
                        </details>
                    }

                    @* Service tier (OpenAI / Anthropic) *@
                    @if (SupportsServiceTier(Config.Provider))
                    {
                        <details class="sgc-llm-group">
                            <summary>@Localizer["Llm_ServiceTier"]</summary>
                            <SgSelect TValue="string" Label="service_tier" @bind-Value="Config.ServiceTier"
                                      Items="_serviceTiers" Placeholder="default" AllowClear="true" />
                        </details>
                    }

                    @* User identifier *@
                    <details class="sgc-llm-group">
                        <summary>@Localizer["Llm_AbuseProtection"]</summary>
                        <SgTextBox Label="User identifier" @bind-Value="Config.UserIdentifier"
                                   Placeholder="user-abc123" />
                    </details>
                </div>
            }
        </div>
    };
}

<style>
    .sgc-llm-compact-row {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: nowrap;
        padding: 4px 6px;
        background: var(--sg-bg);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
    }
    .sgc-llm-provider-tabs {
        display: flex;
        gap: 4px;
        overflow-x: auto;
        padding-bottom: 4px;
        border-bottom: 1px solid var(--sg-border);
        flex-wrap: nowrap;
    }
    .sgc-llm-provider-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4px;
        padding: 4px;
    }
    .sgc-provider-tab {
        padding: 6px 10px;
        border: 1px solid var(--sg-border);
        background: var(--sg-bg);
        border-radius: 6px;
        font-size: 12px;
        cursor: pointer;
        white-space: nowrap;
        color: var(--sg-fg-muted);
        transition: all 0.2s;
        flex: 0 0 auto;
    }
    .sgc-provider-tab:hover { background: var(--sg-bg-subtle); }
    .sgc-provider-tab.active {
        background: var(--sg-color-primary-subtle);
        border-color: var(--sg-color-primary);
        color: var(--sg-color-primary);
        font-weight: 600;
    }
    .sgc-provider-tab.current::after {
        content: "●";
        margin-left: 4px;
        color: var(--sg-color-success);
        font-size: 8px;
        vertical-align: middle;
    }
    .sgc-llm-compact-grid {
        display: grid;
        grid-template-columns: 1fr 1.5fr;
        gap: 12px;
    }
    .sgc-llm-advanced-panel {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 8px;
        background: var(--sg-bg-subtle);
        border: 1px solid var(--sg-border);
        border-radius: 8px;
        margin-top: 4px;
    }
    .sgc-llm-group {
        background: var(--sg-bg);
        border: 1px solid var(--sg-border);
        border-radius: 6px;
        padding: 6px 8px;
    }
    .sgc-llm-group > summary {
        cursor: pointer;
        font-size: 12px;
        font-weight: 600;
        color: var(--sg-fg);
        padding: 4px 0;
        user-select: none;
    }
    .sgc-llm-group[open] > summary { margin-bottom: 6px; }
    .sgc-llm-info-section {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 8px;
        border-bottom: 1px solid var(--sg-border);
        padding-bottom: 8px;
    }
    .sgc-llm-info-section ::deep .sgc-or-key-info,
    .sgc-llm-info-section ::deep .sgc-or-model-details {
        border: none;
        padding: 0;
        background: transparent;
    }
    .sgc-llm-ollama-status {
        padding: 8px;
        background: var(--sg-bg);
        border: 1px solid var(--sg-border);
        border-radius: 6px;
        margin-bottom: 8px;
    }
    .sgc-llm-advanced-row {
        display: flex;
        gap: 12px;
        align-items: flex-end;
        flex-wrap: wrap;
    }
    .sgc-llm-advanced-field {
        flex: 1;
        min-width: 110px;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    .sgc-label-sm {
        font-size: 10px;
        color: var(--sg-fg-muted);
        font-weight: 500;
        margin-bottom: -2px;
    }
    .sgc-status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #ccc;
    }
    .sgc-status-dot.success { background: #52c41a; box-shadow: 0 0 5px #52c41a; }
    .sgc-status-dot.error { background: #ff4d4f; box-shadow: 0 0 5px #ff4d4f; }
    .sgc-status-dot.pending { background: #1890ff; animation: sgc-pulse 1.5s infinite; }
    .sgc-llm-logs {
        background: #1e1e1e;
        color: #d4d4d4;
        padding: 8px;
        border-radius: 6px;
        font-family: var(--sg-font-mono, monospace);
        font-size: 11px;
        max-height: 120px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin-top: 8px;
    }
    .sgc-log-time { color: #888; margin-right: 8px; }
    .sgc-log-msg.error { color: #f48771; }
    .sgc-log-msg.success { color: #89d185; }

    @@keyframes sgc-pulse {
        0% { opacity: 1; }
        50% { opacity: 0.4; }
        100% { opacity: 1; }
    }
    @@media (max-width: 500px) {
        .sgc-llm-compact-grid { grid-template-columns: 1fr; }
    }
</style>
