@namespace SuperUI.Components.Llm
@using SuperUI.Services.Llm
@inject ILlmService LlmService

@*
   SgLlmSettings — единые настройки LLM для чата, глобальных настроек и экстрактора.

   Compact = true: аккуратная строка: провайдер-плашка, модель, Base URL, ключ и быстрые действия.
   Compact = false: полный редактор с теми же провайдерами и расширенными параметрами.
*@

<div class="sgc-llm-settings @(Compact ? "sgc-llm-compact" : "sgc-llm-full")" style="@Style">

    @if (Compact)
    {
        <div class="sgc-llm-compact-row">
            <div class="sgc-mini-field sgc-mini-provider">
                <SgTooltip Text="@SgLlmTooltips.Provider">
                    <span>@Localizer["Llm_ProviderTitle"]</span>
                </SgTooltip>
                <SgSelect TValue="SgLlmProvider"
                          Items="_providers"
                          Value="Config.Provider"
                          ValueChanged="OnProviderChanged"
                          LabelSelector="ProviderLabel"
                          Placeholder="@Localizer["Llm_SelectProviderHint"]"
                          Style="width: 100%;" />
            </div>

            @if (Config.Provider != SgLlmProvider.None)
            {
                <div class="sgc-mini-field sgc-mini-model">
                    <SgTooltip Text="@SgLlmTooltips.Model">
                        <span>@Localizer["Llm_ModelId"]</span>
                    </SgTooltip>
                    <SgAutoComplete TItem="string" @bind-Value="Config.ModelId" Items="FilteredModelIds"
                                    Placeholder="@Localizer["Llm_ModelPlaceholder"]" MaxResults="200"
                                    Style="width: 100%;" />
                </div>

                @if (NeedsBaseUrl(Config.Provider))
                {
                    <div class="sgc-mini-field sgc-mini-url">
                        <SgTooltip Text="@SgLlmTooltips.BaseUrl">
                            <span>@Localizer["Llm_BaseUrl"]</span>
                        </SgTooltip>
                        <SgTextBox Value="@Config.BaseUrl" ValueChanged="@((string? v) => OnBaseUrlChanged(v))" Placeholder="@DefaultBaseUrl(Config.Provider)" Style="width: 100%;" />
                    </div>
                }

                @if (ProviderRequiresKey(Config.Provider))
                {
                    <div class="sgc-mini-field sgc-mini-key">
                        <SgTooltip Text="@SgLlmTooltips.ApiKey">
                            <span>@Localizer["Llm_ApiKey"]</span>
                        </SgTooltip>
                        <SgTextBox @bind-Value="Config.ApiKey" Type="password" Placeholder="@Localizer["Llm_KeyLabel"]" Style="width: 100%;" />
                    </div>
                }

                <div class="sgc-llm-actions">
                    <SgIconButton Icon="@SgIcons.Refresh" OnClick="LoadModelsAsync"
                                  Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" Loading="_loadingModels" Title="@Localizer["Llm_UpdateModels"]" />

                    <SgPopover Title="@Localizer["Llm_Settings"]" Placement="SgPlacement.BottomEnd">
                        <TriggerContent>
                            <SgIconButton Icon="@SgIcons.Settings" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" Title="@Localizer["Llm_FullSettings"]" />
                        </TriggerContent>
                        <ChildContent>
                            <div class="sgc-llm-popover-panel">
                                @RenderFullSettings()
                            </div>
                        </ChildContent>
                    </SgPopover>

                    <SgButton Text="@Localizer["Llm_Check"]" OnClick="CheckConnectionAsync"
                              Variant="SgButtonVariant.Outlined" Size="SgSize.Sm" Loading="_checkingConnection" />
                    <SgButton Text="@Localizer["Common_Apply"]" OnClick="ApplySettingsAsync"
                              Variant="SgButtonVariant.Primary" Size="SgSize.Sm" />
                </div>
            }

            <div class="sgc-status-dot @(_lastStatus.ToLower())" title="@_statusText"></div>
        </div>
    }
    else
    {
        <div class="sgc-llm-full-layout">
            <div class="sgc-llm-heading">
                <div>
                    <div class="sgc-llm-title">@Localizer["Llm_Settings"]</div>
                    <div class="sgc-llm-subtitle">@Localizer["Llm_ConnectionProfilesSubtitle"]</div>
                </div>
                <div class="sgc-llm-heading-actions">
                    <SgSwitch @bind-Value="_showLogs" Label="@Localizer["Llm_Logs"]" Size="SgSize.Sm" />
                </div>
            </div>

            <SgCard Compact="true" NoPadding="false">
                <SgStack Orientation="SgOrientation.Vertical" Gap="12px">
                    <div class="sgc-llm-section">
                        <div class="sgc-llm-section-head">
                            <SgTooltip Text="@SgLlmTooltips.Provider">
                                <span>@Localizer["Llm_ProviderTitle"]</span>
                            </SgTooltip>
                            <small>@ProviderShortHint(Config.Provider)</small>
                        </div>
                        <div class="sgc-llm-provider-pickrow">
                            <SgSelect TValue="SgLlmProvider"
                                      Items="_providers"
                                      Value="Config.Provider"
                                      ValueChanged="OnProviderChanged"
                                      LabelSelector="ProviderLabel"
                                       Placeholder="@Localizer["Llm_SelectProviderHint"]"
                                      Style="min-width: 240px; flex: 1;" />
                            @if (LlmService.CurrentConfig?.Provider is { } current && current == Config.Provider)
                            {
                                <span class="sgc-provider-applied">● @Localizer["Llm_ConfiguredAndReady"]</span>
                            }
                        </div>
                    </div>
                </SgStack>
            </SgCard>

            @if (Config.Provider != SgLlmProvider.None)
            {
                @RenderFullSettings()

                <div class="sgc-llm-footer">
                    <div class="sgc-llm-status-text">
                        <div class="sgc-status-dot @(_lastStatus.ToLower())"></div>
                        <span>@_statusText</span>
                        @if (HasDirtyChanges)
                        {
                            <span class="sgc-dirty-badge">@Localizer["Llm_NotConfigured"]</span>
                        }
                    </div>
                    <div class="sgc-footer-actions">
                        <SgButton Text="@Localizer["Llm_Check"]" OnClick="CheckConnectionAsync" Variant="SgButtonVariant.Outlined" Size="SgSize.Sm" Loading="_checkingConnection" />
                        <SgButton Text="@Localizer["Common_Apply"]" OnClick="ApplySettingsAsync" Variant="SgButtonVariant.Primary" Size="SgSize.Sm" />
                    </div>
                </div>

                @if (_showLogs)
                {
                    <div class="sgc-llm-logs">
                        @foreach (var log in _logs)
                        {
                            <div class="sgc-log-entry">
                                <span class="sgc-log-time">@log.Time.ToString("HH:mm:ss")</span>
                                <span class="sgc-log-msg @log.Type.ToLower()">@log.Message</span>
                            </div>
                        }
                        @if (!_logs.Any())
                        {
                            <div style="color: var(--sg-fg-muted); font-style: italic; font-size: 11px;">@Localizer["Llm_NoLogs"]</div>
                        }
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    RenderFragment RenderFullSettings() => __builder =>
    {
        <div class="sgc-llm-editor">
            @RenderProfiles()
            @RenderModelSelection()
            @RenderConnection()

            @if (_diagnostics is not null)
            {
                @RenderDiagnostics()
            }

            @RenderHealthDashboard()
            @RenderCostGuard()

            <SgCard Compact="true">
                <SgTooltip Text="@SgLlmTooltips.SystemPrompt">
                    <SgTextBox Label="@Localizer["Llm_SystemPrompt"]" @bind-Value="Config.SystemPrompt" Multiline="true" Rows="2"
                               Placeholder="@Localizer["Llm_SystemPromptHint"]" />
                </SgTooltip>
            </SgCard>

            @RenderUsageLog()

            <div class="sgc-llm-advanced-toggle">
                <SgTooltip Text="@SgLlmTooltips.UseAdvanced">
                    <SgSwitch @bind-Value="Config.UseAdvanced" Label="@Localizer["Llm_Advanced"]" Size="SgSize.Sm" />
                </SgTooltip>
                @if (!Config.UseAdvanced)
                {
                    <span>@Localizer["Llm_BasicOnlyHint"]</span>
                }
            </div>

            @if (Config.UseAdvanced)
            {
                <div class="sgc-llm-advanced-panel">
                    @RenderAdvancedProviderInfo()
                    @RenderSamplingSettings()
                    @RenderOutputSettings()
                    @RenderRoutingSettings()
                    @RenderReliabilitySettings()
                    @RenderDeveloperPreview()
                </div>
            }
        </div>
    };

    RenderFragment RenderProfiles() => __builder =>
    {
        <SgCard Title="@Localizer["Llm_ConnectionProfiles"]" Subtitle="@Localizer["Llm_ConnectionProfilesSubtitle"]" Compact="true">
            <SgStack Orientation="SgOrientation.Vertical" Gap="10px">
                <div class="sgc-profile-row">
                    <SgSelect TValue="string" Items="@_profiles.Select(p => p.Id).ToList()" Value="@_selectedProfileId" ValueChanged="ApplyProfileAsync" LabelSelector="ProfileLabel" Placeholder="@Localizer["Llm_SelectProfile"]" Style="min-width: 180px; flex: 1;" />
                    <SgTextBox @bind-Value="_profileName" Placeholder="@Localizer["Llm_SaveProfile"]" Style="min-width: 180px; flex: 1;" />
                    <SgSwitch @bind-Value="_profileDefault" Label="@Localizer["Llm_SaveProfile"]" Size="SgSize.Sm" />
                    <SgButton Text="@Localizer["Llm_SaveProfile"]" OnClick="SaveProfileAsync" Variant="SgButtonVariant.Outlined" Size="SgSize.Sm" />
                    <SgButton Text="@Localizer["Llm_DeleteProfile"]" OnClick="DeleteProfileAsync" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
                </div>
                @if (_profiles.Count > 0)
                {
                    <div class="sgc-profile-hint">@(string.Join(" · ", _profiles.Select(p => p.IsDefault ? $"★ {p.Name}" : p.Name).Take(6)))</div>
                }
                <details class="sgc-profile-io">
                    <summary>@Localizer["Llm_ExportJson"] / @Localizer["Llm_ImportJson"]</summary>
                    <SgStack Orientation="SgOrientation.Vertical" Gap="8px" Style="margin-top: 8px;">
                        <div class="sgc-profile-row">
                            <SgButton Text="@Localizer["Llm_ExportJson"]" OnClick="ExportProfilesAsync" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
                            <SgButton Text="@Localizer["Llm_ImportJson"]" OnClick="ImportProfilesAsync" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
                        </div>
                        <SgTextBox @bind-Value="_profilesJson" Multiline="true" Rows="4" Placeholder="@Localizer["Llm_ExportJson"]" />
                    </SgStack>
                </details>
            </SgStack>
        </SgCard>
    };

    RenderFragment RenderModelSelection() => __builder =>
    {
        <SgCard Title="@Localizer["Llm_ModelCard"]" Subtitle="@Localizer["Llm_ModelSubtitle"]" Compact="true">
            <ActionContent>
                <SgSwitch @bind-Value="_manualModel" Label="@Localizer["Llm_Manual"]" Size="SgSize.Sm" />
            </ActionContent>
            <ChildContent>
            <SgStack Orientation="SgOrientation.Vertical" Gap="12px">
                <div class="sgc-llm-model-row">
                    <div class="sgc-llm-model-input">
                        @if (_manualModel)
                        {
                            <SgTooltip Text="@SgLlmTooltips.Model">
                                <SgTextBox Label="@Localizer["Llm_ModelId"]" @bind-Value="Config.ModelId" Placeholder="@Localizer["Llm_ModelExample"]" />
                            </SgTooltip>
                        }
                        else if (Config.Provider == SgLlmProvider.Ollama)
                        {
                            <label class="sgc-label">@Localizer["Llm_PickModel"]</label>
                            <SgOllamaModelPicker SelectedModelId="@Config.ModelId"
                                                 BaseUrl="@Config.BaseUrl"
                                                 OnSelected="OnModelSelected"
                                                 Style="width: 100%;" />
                        }
                        else
                        {
                            <SgTooltip Text="@SgLlmTooltips.Model">
                            <SgAutoComplete TItem="string" Label="@Localizer["Llm_PickModel"]" @bind-Value="Config.ModelId"
                                            Items="FilteredModelIds" Placeholder="@Localizer["Llm_ModelPlaceholder"]" Style="width: 100%;" MaxResults="500" />
                            </SgTooltip>
                        }
                    </div>
                    <SgIconButton Icon="@SgIcons.Refresh" OnClick="LoadModelsAsync" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" Loading="_loadingModels" Title="@Localizer["Llm_UpdateModels"]" />
                </div>
                <div class="sgc-model-search">
                    <SgTextBox @bind-Value="_modelSearchText" Placeholder="@Localizer["Llm_SearchModelsPlaceholder"]" Debounce="200" />
                    <select class="sgc-model-sort" @bind="_modelSort" @bind:after="OnCatalogFilterChanged" title="@Localizer["Llm_SortOrder"]">
                        <option value="recommended">Recommended first</option>
                        <option value="context">By context (desc)</option>
                        <option value="name">By name</option>
                    </select>
                    @if (HasModelFilters)
                    {
                        <button type="button" class="sgc-model-clear" @onclick="ClearModelFilters" title="@Localizer["Llm_ResetAllFilters"]">✕ @Localizer["Llm_ResetAllFilters"]</button>
                    }
                </div>
                <div class="sgc-model-filters">
                    <SgSwitch @bind-Value="_filterFreeOnly" Label="@Localizer["Llm_FreeLocalOnly"]" Size="SgSize.Sm" />
                    <SgSwitch @bind-Value="_filterVisionOnly" Label="@Localizer["Llm_VisionFilter"]" Size="SgSize.Sm" />
                    <SgSwitch @bind-Value="_filterToolsOnly" Label="@Localizer["Llm_ToolCallsTag"]" Size="SgSize.Sm" />
                    <SgSwitch @bind-Value="_filterJsonOnly" Label="@Localizer["Llm_Format"]" Size="SgSize.Sm" />
                    <SgSwitch @bind-Value="_filterReasoningOnly" Label="@Localizer["Llm_ReasoningTag"]" Size="SgSize.Sm" />
                </div>
                @if (ModelFamilies.Count > 1)
                {
                    <div class="sgc-model-families">
                        @foreach (var (fam, cnt) in ModelFamilies)
                        {
                            <button type="button"
                                    class="sgc-model-family @(_selectedFamily == fam ? "active" : "")"
                                    @onclick="@(() => ToggleFamily(fam))"
                                    title="Filter: @fam">
                                @fam <em>@cnt</em>
                            </button>
                        }
                    </div>
                }
                @if (RecommendedModels.Any())
                {
                    <div class="sgc-model-chips">
                        @foreach (var m in RecommendedModels)
                        {
                            <button type="button" class="sgc-model-chip @(Config.ModelId == m.Id ? "active" : "")" @onclick="@(() => SelectRecommendedModel(m.Id))" title="@m.Description">
                                <span>@m.Name</span>
                                @if (m.IsFree) { <em>free</em> }
                                @if (m.SupportsVision) { <em>vision</em> }
                                @if (m.SupportsTools) { <em>tools</em> }
                            </button>
                        }
                    </div>
                }
                @if (SelectedModelInfo is not null)
                {
                    <div class="sgc-model-meta">
                        <span>@SelectedModelInfo.ProviderLabel</span>
                        @if (SelectedModelInfo.ContextWindow is > 0) { <span>ctx @(SelectedModelInfo.ContextWindow.Value.ToString("N0"))</span> }
                        @if (SelectedModelInfo.SupportsVision) { <span>vision</span> }
                        @if (SelectedModelInfo.SupportsTools) { <span>tools</span> }
                        @if (SelectedModelInfo.SupportsJsonSchema) { <span>json/schema</span> }
                        @if (SelectedModelInfo.SupportsReasoning) { <span>reasoning</span> }
                    </div>
                }
                @if (_models.Count > 0)
                {
                    var filtered = FilteredModels.ToList();
                    var visible = _catalogExpanded ? filtered : filtered.Take(_catalogTop).ToList();
                    <details class="sgc-model-catalog" open="@(HasModelFilters || _catalogExpanded)">
                        <summary>Model catalog (@filtered.Count / @_models.Count)</summary>
                        @if (filtered.Count == 0)
                        {
                            <div class="sgc-model-empty">
                                <div class="sgc-model-empty-icon">🔎</div>
                                <div class="sgc-model-empty-title">@Localizer["Common_NoResults"]</div>
                                <div class="sgc-model-empty-hint">@Localizer["Llm_ClearFilters"]</div>
                                <button type="button" class="sgc-model-empty-btn" @onclick="ClearModelFilters">@Localizer["Llm_ResetAllFilters"]</button>
                            </div>
                        }
                        else
                        {
                            <div class="sgc-model-table-wrap">
                                <table class="sgc-model-table">
                                    <thead>
                                        <tr><th>@Localizer["Llm_ModelCard"]</th><th>Family</th><th>Context</th><th>Caps</th><th>Type</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var m in visible)
                                        {
                                            <tr class="@(Config.ModelId == m.Id ? "active" : "")"
                                                @onclick="@(() => SelectRecommendedModel(m.Id))"
                                                title="@(m.Description ?? m.Id)">
                                                <td><b>@m.Name</b><small>@m.Id</small></td>
                                                <td><span>@(ExtractFamily(m.Id) ?? "—")</span></td>
                                                <td>@(m.ContextWindow is > 0 ? m.ContextWindow.Value.ToString("N0") : "—")</td>
                                                <td>
                                                    @if (m.SupportsVision) { <span>vision</span> }
                                                    @if (m.SupportsTools) { <span>tools</span> }
                                                    @if (m.SupportsJsonSchema) { <span>json</span> }
                                                    @if (m.SupportsReasoning) { <span>reasoning</span> }
                                                </td>
                                                <td>@(IsModelFree(m) ? Localizer["Llm_FreeLocalOnly"] : "paid")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (filtered.Count > visible.Count)
                            {
                                <div class="sgc-model-pager">
                                    <button type="button" class="sgc-model-page-btn" @onclick="LoadMoreCatalogRows">
                                        Show 25 more (@(filtered.Count - visible.Count) left)
                                    </button>
                                    <button type="button" class="sgc-model-page-btn ghost" @onclick="ToggleCatalogExpanded">
                                        @Localizer["Common_ExpandAll"]
                                    </button>
                                </div>
                            }
                            else if (_catalogExpanded && filtered.Count > 25)
                            {
                                <div class="sgc-model-pager">
                                    <button type="button" class="sgc-model-page-btn ghost" @onclick="ToggleCatalogExpanded">
                                        @Localizer["Common_Collapse"]
                                    </button>
                                </div>
                            }
                        }
                    </details>
                }
                else if (Config.Provider != SgLlmProvider.None)
                {
                    <div class="sgc-model-empty">
                        <div class="sgc-model-empty-icon">📦</div>
                        <div class="sgc-model-empty-title">@Localizer["Llm_NotConfigured"]</div>
                        <div class="sgc-model-empty-hint">@EmptyCatalogHint</div>
                        <button type="button" class="sgc-model-empty-btn" @onclick="LoadModelsAsync" disabled="@_loadingModels">
                            @(_loadingModels ? Localizer["Common_Loading"] : Localizer["Llm_Refresh"])
                        </button>
                    </div>
                }
            </SgStack>
            </ChildContent>
        </SgCard>
    };

    RenderFragment RenderConnection() => __builder =>
    {
        <SgCard Title="@Localizer["Llm_Connection"]" Subtitle="@ProviderConnectionHint(Config.Provider)" Compact="true">
            <SgStack Orientation="SgOrientation.Vertical" Gap="12px">
                <div class="sgc-llm-connection-grid @(ProviderRequiresKey(Config.Provider) ? "" : "no-key")">
                    @if (ProviderRequiresKey(Config.Provider))
                    {
                        <SgTooltip Text="@SgLlmTooltips.ApiKey">
                            <SgTextBox Label="@Localizer["Llm_ApiKey"]" @bind-Value="Config.ApiKey" Type="password" Placeholder="@Localizer["Llm_KeyLabel"]" />
                        </SgTooltip>
                    }
                    @if (NeedsBaseUrl(Config.Provider))
                    {
                        <SgTooltip Text="@SgLlmTooltips.BaseUrl">
                            <SgTextBox Label="@Localizer["Llm_BaseUrl"]" Value="@Config.BaseUrl" ValueChanged="@((string? v) => OnBaseUrlChanged(v))" Placeholder="@DefaultBaseUrl(Config.Provider)" />
                        </SgTooltip>
                    }
                </div>
                <div class="sgc-llm-connection-options">
                    <SgSwitch @bind-Value="Config.PersistApiKey" Label="@Localizer["Llm_SaveKeyInBrowser"]" Size="SgSize.Sm" />
                    <SgSwitch @bind-Value="Config.UseBackendProxy" Label="Backend proxy" Size="SgSize.Sm" />
                </div>
                @if (Config.UseBackendProxy)
                {
                    <SgTextBox Label="Proxy URL" @bind-Value="Config.ProxyUrl" Placeholder="/api/llm or https://server.example.com/llm" />
                    <div class="sgc-llm-note">@Localizer.GetString("Llm_ApiKeyUrlHint", "")</div>
                }
                @if (IsLocalProvider(Config.Provider))
                {
                    <div class="sgc-llm-local-hints">
                        <div class="sgc-llm-local-title">@Localizer["Llm_SelectProviderHint"]</div>
                        <ul class="sgc-llm-local-list">
                            <li>@Localizer["Llm_LmStudioHint"]</li>
                            <li>@Localizer["Llm_CorsHint"]</li>
                            <li>@LocalCorsHint(Config.Provider)</li>
                        </ul>
                        <div class="sgc-llm-local-actions">
                            <SgButton Text="@Localizer["Llm_TestPort"]" Size="SgSize.Sm" Variant="SgButtonVariant.Outlined"
                                      Loading="_testingLocalPort" OnClick="TestLocalPortAsync" />
                            @if (!string.IsNullOrEmpty(_localPortStatus))
                            {
                                <span class="sgc-llm-local-status @(_localPortOk ? "ok" : "bad")">@_localPortStatus</span>
                            }
                        </div>
                    </div>
                }
                @if (Config.Provider == SgLlmProvider.GigaGpt)
                {
                    <div class="sgc-llm-giga-box">
                        <div class="sgc-llm-advanced-row">
                            <SgSelect TValue="string" Label="GigaChat auth" @bind-Value="Config.GigaAuthMode"
                                      Items="_gigaAuthModes" Placeholder="Bearer" />
                            <SgSelect TValue="string" Label="Scope" @bind-Value="Config.GigaScope"
                                      Items="_gigaScopes" Placeholder="GIGACHAT_API_PERS" />
                        </div>
                        @if (Config.GigaAuthMode == "OAuth")
                        {
                            <SgTextBox Label="OAuth URL" @bind-Value="Config.GigaOAuthUrl" Placeholder="https://ngw.devices.sberbank.ru:9443/api/v2/oauth" />
                            <div class="sgc-llm-note">In API Key field put your GigaChat authorization key. Component exchanges it for access token via POST /api/v2/oauth; for production use Backend proxy.</div>
                        }
                        else
                        {
                            <div class="sgc-llm-note">Bearer mode expects a pre-obtained GigaChat access token in the API Key field.</div>
                        }
                    </div>
                }
            </SgStack>
        </SgCard>
    };

    RenderFragment RenderDiagnostics() => __builder =>
    {
        <SgCard Title="Диагностика подключения" Subtitle="@_diagnostics?.Summary" Compact="true" Status="(_diagnostics?.Ok == true ? SgCardStatus.Success : SgCardStatus.Danger)">
            <div class="sgc-diag-list">
                @foreach (var check in _diagnostics!.Checks)
                {
                    <div class="sgc-diag-item @(check.Ok ? "ok" : "bad")">
                        <span>@(check.Ok ? "✓" : "!")</span>
                        <b>@check.Name</b>
                        <small>@check.Message</small>
                    </div>
                }
            </div>
        </SgCard>
    };

    RenderFragment RenderHealthDashboard() => __builder =>
    {
        <SgCard Title="@Localizer["Llm_HealthDashboard"]" Subtitle="@Localizer["Llm_HealthSubtitle"]" Compact="true">
            <ActionContent>
                <SgButton Text="@Localizer["Llm_TestAll"]" OnClick="CheckAllProvidersHealthAsync" Variant="SgButtonVariant.Outlined" Size="SgSize.Sm" Loading="_checkingHealth" />
            </ActionContent>
            <ChildContent>
            @if (_healthStatuses.Count > 0)
            {
                <div class="sgc-health-grid">
                    @foreach (var h in _healthStatuses)
                    {
                        <div class="sgc-health-card @(h.Ok ? "ok" : "bad")">
                            <div><span>@(h.Ok ? "✓" : "!")</span><b>@h.ProviderLabel</b></div>
                            <small>@h.Status</small>
                            <em>@h.BaseUrl</em>
                        </div>
                    }
                </div>
            }
            </ChildContent>
        </SgCard>
    };

    RenderFragment RenderCostGuard() => __builder =>
    {
        <SgCard Title="Cost guard" Subtitle="@DailyLimitText" Compact="true">
            <SgStack Orientation="SgOrientation.Vertical" Gap="12px">
                <div class="sgc-llm-advanced-row">
                    <SgTooltip Text="@SgLlmTooltips.OnlyFreeModels">
                        <SgSwitch @bind-Value="Config.OnlyFreeModels" Label="@Localizer["Llm_FreeLocalOnly"]" Size="SgSize.Sm" />
                    </SgTooltip>
                    <SgTooltip Text="@SgLlmTooltips.WarnOnPaidModels">
                        <SgSwitch @bind-Value="Config.WarnOnPaidModels" Label="@Localizer["Llm_WarnPaidModels"]" Size="SgSize.Sm" />
                    </SgTooltip>
                </div>
                <div class="sgc-llm-advanced-row">
                    <SgTooltip Text="@SgLlmTooltips.DailyTokenLimit">
                        <SgNumberInput TValue="int?" Label="@Localizer["Llm_DailyTokenLimit"]" @bind-Value="Config.DailyTokenLimit" Placeholder="e.g. 100000" Size="SgSize.Sm" />
                    </SgTooltip>
                    <SgTooltip Text="@SgLlmTooltips.RequestTokenLimit">
                        <SgNumberInput TValue="int?" Label="Max output" @bind-Value="Config.RequestTokenLimit" Placeholder="e.g. 8192" Size="SgSize.Sm" />
                    </SgTooltip>
                </div>
                @if (Config.WarnOnPaidModels && SelectedModelLooksPaid)
                {
                    <div class="sgc-llm-warning">@Localizer["Llm_WarnPaidModels"]</div>
                }
            </SgStack>
        </SgCard>
    };

    RenderFragment RenderUsageLog() => __builder =>
    {
        <SgCard Title="@Localizer["Llm_UsageLog"]" Subtitle="@Localizer["Llm_UsageLogSubtitle"]" Compact="true">
            <ActionContent>
                <SgStack Orientation="SgOrientation.Horizontal" Gap="4px">
                    <SgButton Text="@Localizer["Llm_Refresh"]" OnClick="LoadUsageAsync" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
                    <SgButton Text="@Localizer["Llm_Clear"]" OnClick="ClearUsageAsync" Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" />
                </SgStack>
            </ActionContent>
            <ChildContent>
            @if (_usageRecords.Count == 0)
            {
                <div class="sgc-profile-hint">@Localizer["Llm_NoLogs"]</div>
            }
            else
            {
                <div class="sgc-usage-list">
                    @foreach (var u in _usageRecords.Take(6))
                    {
                        <div class="sgc-usage-item @(u.Ok ? "ok" : "bad")">
                            <span>@u.Timestamp.ToLocalTime().ToString("HH:mm")</span>
                            <b>@u.ProviderLabel</b>
                            <small>@u.ModelId</small>
                            <em>@(u.Ok ? $"{u.TotalTokens:N0} tok" : u.Error)</em>
                        </div>
                    }
                </div>
            }
            </ChildContent>
        </SgCard>
    };

    RenderFragment RenderAdvancedProviderInfo() => __builder =>
    {
        @if (Config.Provider == SgLlmProvider.OpenRouter)
        {
            <div class="sgc-llm-info-section">
                <SgOpenRouterKeyInfo ApiKey="@Config.ApiKey" />
                <SgOpenRouterModelDetails ModelId="@Config.ModelId" />
            </div>
        }
        else if (Config.Provider == SgLlmProvider.Ollama)
        {
            <div class="sgc-llm-ollama-status">
                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px;">
                    <span>@Localizer["Llm_OllamaStatus"]:</span>
                    <SgBadge Variant="@StatusBadgeVariant" Size="SgSize.Sm">
                        @StatusBadgeText
                    </SgBadge>
                </div>
            </div>
        }

        @if (Config.Provider == SgLlmProvider.OpenAiCompatible || Config.Provider == SgLlmProvider.LmStudio || Config.Provider == SgLlmProvider.HuggingFace || Config.Provider == SgLlmProvider.GigaGpt)
        {
            <details class="sgc-llm-group">
                <summary>OpenAI-compatible / Microsoft.Extensions.AI</summary>
                <div class="sgc-llm-note">
                    Base params map to ChatOptions; additional fields sent only when advanced settings are enabled.
                </div>
                @if (Config.Provider == SgLlmProvider.OpenAiCompatible)
                {
                    <SgSwitch @bind-Value="_useResponsesApiBool" Label="OpenAI Responses API" Size="SgSize.Sm" />
                }
            </details>
        }
    };

    RenderFragment RenderSamplingSettings() => __builder =>
    {
        <details open class="sgc-llm-group">
            <summary>@Localizer["Llm_Sampling"]</summary>
            <SgStack Orientation="SgOrientation.Vertical" Gap="12px">
                <div class="sgc-llm-advanced-row">
                    <div class="sgc-llm-advanced-field">
                        <SgTooltip Text="@SgLlmTooltips.Temperature">
                            <label class="sgc-label-sm">Temperature (@Config.Temperature.ToString("F2"))</label>
                        </SgTooltip>
                        <SgSlider @bind-Value="Config.Temperature" Min="0" Max="2" Step="0.01" />
                    </div>
                    <div class="sgc-llm-advanced-field">
                        <SgTooltip Text="@SgLlmTooltips.TopP">
                            <label class="sgc-label-sm">Top P (@Config.TopP.ToString("F2"))</label>
                        </SgTooltip>
                        <SgSlider @bind-Value="Config.TopP" Min="0" Max="1" Step="0.01" />
                    </div>
                </div>
                @if (SupportsTopKMinP(Config.Provider))
                {
                    <div class="sgc-llm-advanced-row">
                        <div class="sgc-llm-advanced-field">
                            <label class="sgc-label-sm">Top K</label>
                            <SgNumberInput TValue="int?" @bind-Value="Config.TopK" Placeholder="Auto" Size="SgSize.Sm" />
                        </div>
                        <div class="sgc-llm-advanced-field">
                            <label class="sgc-label-sm">Min P</label>
                            <SgNumberInput TValue="double?" @bind-Value="Config.MinP" Placeholder="Auto" Step="0.01" Size="SgSize.Sm" />
                        </div>
                        <div class="sgc-llm-advanced-field">
                            <SgTooltip Text="@SgLlmTooltips.FrequencyPenalty">
                                <label class="sgc-label-sm">Rep. Penalty</label>
                            </SgTooltip>
                            <SgNumberInput TValue="double?" @bind-Value="Config.RepetitionPenalty" Placeholder="1.0" Step="0.05" Size="SgSize.Sm" />
                        </div>
                    </div>
                }
                @if (SupportsPenalties(Config.Provider))
                {
                    <div class="sgc-llm-advanced-row">
                        <div class="sgc-llm-advanced-field">
                            <SgTooltip Text="@SgLlmTooltips.PresencePenalty">
                                <label class="sgc-label-sm">Pres. Pen. (@Config.PresencePenalty.ToString("F1"))</label>
                            </SgTooltip>
                            <SgSlider @bind-Value="Config.PresencePenalty" Min="-2" Max="2" Step="0.1" />
                        </div>
                        <div class="sgc-llm-advanced-field">
                            <SgTooltip Text="@SgLlmTooltips.FrequencyPenalty">
                                <label class="sgc-label-sm">Freq. Pen. (@Config.FrequencyPenalty.ToString("F1"))</label>
                            </SgTooltip>
                            <SgSlider @bind-Value="Config.FrequencyPenalty" Min="-2" Max="2" Step="0.1" />
                        </div>
                    </div>
                }
                <div class="sgc-llm-advanced-row">
                    <SgTooltip Text="@SgLlmTooltips.MaxTokens" Style="flex: 1;">
                        <SgNumberInput TValue="int?" Label="Max Tokens" @bind-Value="Config.MaxTokens" Placeholder="Auto" Size="SgSize.Sm" />
                    </SgTooltip>
                    <SgTooltip Text="@SgLlmTooltips.Seed" Style="flex: 1;">
                        <SgNumberInput TValue="int?" Label="Seed" @bind-Value="Config.Seed" Placeholder="Random" Size="SgSize.Sm" />
                    </SgTooltip>
                </div>
                <div class="sgc-llm-advanced-row">
                    <SgTooltip Text="@SgLlmTooltips.StopSequences" Style="flex: 1;">
                        <SgTextBox Label="@Localizer["Llm_StopSequences"]" Value="@_stopText"
                                   ValueChanged="@((string? v) => OnStopChanged(v))" Placeholder="\\n\\n, ###" Size="SgSize.Sm" />
                    </SgTooltip>
                </div>
            </SgStack>
        </details>
    };

    RenderFragment RenderOutputSettings() => __builder =>
    {
        <details class="sgc-llm-group">
            <summary>@Localizer["Llm_Output"]</summary>
            <SgStack Orientation="SgOrientation.Vertical" Gap="12px">
                <div class="sgc-llm-advanced-row">
                    <SgTooltip Text="@SgLlmTooltips.ResponseFormat" Style="flex: 1;">
                        <SgSelect TValue="string" Label="Response format" @bind-Value="Config.ResponseFormat"
                                  Items="_responseFormats" Placeholder="default" AllowClear="true" />
                    </SgTooltip>
                    <SgSwitch @bind-Value="_logProbsBool" Label="LogProbs" Size="SgSize.Sm" />
                </div>
                @if (Config.ResponseFormat == "json_schema")
                {
                    <SgTextBox Label="JSON schema" @bind-Value="Config.JsonSchema" Multiline="true" Rows="4"
                               Placeholder=@("{\"name\":\"out\",\"schema\":{\"type\":\"object\"}}") />
                }
                <div class="sgc-llm-advanced-row">
                    <SgTooltip Text="@SgLlmTooltips.ParallelToolCalls">
                        <SgSwitch @bind-Value="_parallelToolCallsBool" Label="@Localizer["Llm_ParallelTools"]" Size="SgSize.Sm" />
                    </SgTooltip>
                    <SgTooltip Text="@SgLlmTooltips.StreamUsage">
                        <SgSwitch @bind-Value="_streamUsageBool" Label="@Localizer["Llm_StreamUsage"]" Size="SgSize.Sm" />
                    </SgTooltip>
                </div>

                @if (SupportsReasoning(Config.Provider))
                {
                    <div class="sgc-llm-advanced-row">
                        <SgTooltip Text="@SgLlmTooltips.ReasoningEffort" Style="flex: 1;">
                            <SgSelect TValue="string" Label="reasoning_effort" @bind-Value="Config.ReasoningEffort"
                                      Items="_effortLevels" Placeholder="default" AllowClear="true" />
                        </SgTooltip>
                        <SgTooltip Text="@SgLlmTooltips.Verbosity" Style="flex: 1;">
                            <SgSelect TValue="string" Label="verbosity" @bind-Value="Config.Verbosity"
                                      Items="_verbosityLevels" Placeholder="default" AllowClear="true" />
                        </SgTooltip>
                    </div>
                }

                @if (Config.Provider == SgLlmProvider.Anthropic)
                {
                    <div class="sgc-llm-advanced-row">
                        <SgTooltip Text="@SgLlmTooltips.AnthropicThinking">
                            <SgSwitch @bind-Value="_anthropicThinkingBool" Label="@Localizer["Llm_EnableThinking"]" Size="SgSize.Sm" />
                        </SgTooltip>
                        <SgTooltip Text="@SgLlmTooltips.ThinkingBudget">
                            <SgNumberInput TValue="int?" Label="Thinking budget (tok)" @bind-Value="Config.AnthropicThinkingBudgetTokens" Placeholder="4096" Size="SgSize.Sm" />
                        </SgTooltip>
                    </div>
                }
            </SgStack>
        </details>
    };

    RenderFragment RenderRoutingSettings() => __builder =>
    {
        @if (Config.Provider == SgLlmProvider.OpenRouter)
        {
            <details class="sgc-llm-group">
                <summary>OpenRouter — routing</summary>
                <SgStack Orientation="SgOrientation.Vertical" Gap="10px">
                    <div class="sgc-llm-advanced-row">
                        <SgSelect TValue="string" Label="Provider sort" @bind-Value="Config.OrProviderSort"
                                  Items="_orSortOptions" Placeholder="auto" AllowClear="true" />
                        <SgSelect TValue="string" Label="Transforms" @bind-Value="Config.OrTransforms"
                                  Items="_orTransforms" Placeholder="none" AllowClear="true" />
                    </div>
                    <SgTextBox Label="Fallback models (comma-separated)" Value="@_orFallbackText"
                               ValueChanged="@((string? v) => OnOrFallbackChanged(v))" Placeholder="openai/gpt-5.4-mini, anthropic/claude-sonnet-4-5" />
                    <div class="sgc-llm-advanced-row">
                        <SgTextBox Label="Allowed providers" Value="@_orAllowedText"
                                   ValueChanged="@((string? v) => OnOrAllowedChanged(v))" Placeholder="openai, anthropic" Style="flex: 1;" />
                        <SgTextBox Label="Ignored providers" Value="@_orIgnoredText"
                                   ValueChanged="@((string? v) => OnOrIgnoredChanged(v))" Placeholder="..." Style="flex: 1;" />
                    </div>
                    <div class="sgc-llm-advanced-row">
                        <SgSwitch @bind-Value="_orRequireParametersBool" Label="@Localizer["Llm_OrRequireParams"]" Size="SgSize.Sm" />
                        <SgSwitch @bind-Value="_orAllowDataCollectionBool" Label="@Localizer["Llm_OrAllowData"]" Size="SgSize.Sm" />
                    </div>
                </SgStack>
            </details>
        }

        @if (SupportsServiceTier(Config.Provider))
        {
            <details class="sgc-llm-group">
                <summary>@Localizer["Llm_ServiceTier"]</summary>
                <SgSelect TValue="string" Label="service_tier" @bind-Value="Config.ServiceTier"
                          Items="_serviceTiers" Placeholder="default" AllowClear="true" />
            </details>
        }

        <details class="sgc-llm-group">
            <summary>@Localizer["Llm_Settings"] / routing</summary>
            <div class="sgc-llm-note">Assign separate model/endpoint per purpose. Current route: <b>@TaskPurpose</b>.</div>
            <div class="sgc-route-list">
                @foreach (var purpose in _routePurposes)
                {
                    var purposeId = purpose;
                    <div class="sgc-route-row">
                        <SgSwitch Value="@IsRouteEnabled(purposeId)" ValueChanged="@((bool v) => SetRouteEnabled(purposeId, v))" Label="@purposeId" Size="SgSize.Sm" />
                        <SgSelect TValue="SgLlmProvider" Items="_providers" Value="@GetRouteProvider(purposeId)" ValueChanged="@((SgLlmProvider v) => SetRouteProvider(purposeId, v))" />
                        <SgTextBox Value="@GetRouteModel(purposeId)" ValueChanged="@((string? v) => SetRouteModel(purposeId, v))" Placeholder="@Localizer["Llm_ModelPlaceholder"]" />
                        <SgTextBox Value="@GetRouteBaseUrl(purposeId)" ValueChanged="@((string? v) => SetRouteBaseUrl(purposeId, v))" Placeholder="@Localizer["Llm_BaseUrl"]" />
                    </div>
                }
            </div>
        </details>
    };

    RenderFragment RenderReliabilitySettings() => __builder =>
    {
        <details class="sgc-llm-group">
            <summary>@Localizer["Llm_ErrorStatus"]</summary>
            <SgStack Orientation="SgOrientation.Vertical" Gap="12px">
                <div class="sgc-llm-advanced-row">
                    <SgNumberInput TValue="int?" Label="Timeout, sec" @bind-Value="Config.TimeoutSeconds" Placeholder="120" Size="SgSize.Sm" />
                    <SgNumberInput TValue="int?" Label="Retry count" @bind-Value="Config.RetryCount" Placeholder="0" Size="SgSize.Sm" />
                    <SgNumberInput TValue="int?" Label="Retry delay, ms" @bind-Value="Config.RetryDelayMs" Placeholder="500" Size="SgSize.Sm" />
                </div>
                <SgTextBox Label="Fallback Base URL" @bind-Value="Config.FallbackBaseUrl" Placeholder="e.g. http://localhost:11434" />
            </SgStack>
        </details>
    };

    RenderFragment RenderDeveloperPreview() => __builder =>
    {
        <details class="sgc-llm-group">
            <summary>Developer: raw request preview</summary>
            <pre class="sgc-raw-preview">@RawRequestPreview</pre>
        </details>

        <details class="sgc-llm-group">
            <summary>@Localizer["Llm_AbuseProtection"]</summary>
            <SgTextBox Label="User identifier" @bind-Value="Config.UserIdentifier"
                       Placeholder="user-abc123" />
        </details>
    };
}

