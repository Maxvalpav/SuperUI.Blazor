@namespace SuperUI.Components.Llm
@using SuperUI.Services.Llm
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject ILlmService LlmService
@inject IJSRuntime JS
@inject ISuperUILocalizer Localizer

<div class="sgc-llm-image-studio @CssClass" style="@Style">
    <SgLlmHeader Title="@Localizer["Llm_ImageGenTitle"]" Subtitle="@Localizer["Llm_ImageGenSubtitle"]"
                 TaskPurpose="@SgLlmTaskPurpose.Images" />

    <div class="sgc-image-toolbar">
        <SgTextArea @bind-Value="_prompt" Placeholder="@Localizer["Llm_ImageDescribePlaceholder"]" Rows="3" />

        <div class="sgc-image-controls">
            <SgSelect TValue="string" @bind-Value="_size" Items="_sizes" Label="@Localizer["Llm_ImageSize"]" />
            <SgSelect TValue="string" @bind-Value="_quality" Items="_qualities" Label="@Localizer["Llm_ImageQuality"]" />
            <SgSelect TValue="string" @bind-Value="_style" Items="_styles" Label="@Localizer["Llm_ImageStyle"]" />
            <SgNumberInput TValue="int" @bind-Value="_count" Min="1" Max="4" Label="@Localizer["Llm_ImageCount"]" />
            <SgTextBox @bind-Value="_model" Placeholder="gpt-image-1" Label="@Localizer["Llm_ImageModel"]" />
        </div>

        <div class="sgc-image-actions">
            <SgButton Text="@Localizer["Llm_Generate"]" OnClick="GenerateAsync" Loading="_busy" Variant="SgButtonVariant.Primary" />
            @if (_lastImage != null)
            {
                <SgButton Text="@Localizer["Llm_Edit"]" OnClick="@(() => _editMode = !_editMode)" Variant="SgButtonVariant.Outlined" />
            }
        </div>

        @if (_editMode)
        {
            <SgTextArea @bind-Value="_editPrompt" Placeholder="@Localizer["Llm_DescribeChanges"]" Rows="2" />
            <div class="sgc-image-label">@Localizer["Llm_MaskOptional"]</div>
            <SgFileUpload OnFilesSelected="@OnMaskSelected" Accept="image/*" />
            <SgButton Text="@Localizer["Llm_ApplyEdit"]" OnClick="EditAsync" Loading="_busy" Variant="SgButtonVariant.Primary" />
        }
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <SgAlert Variant="SgAlertVariant.Danger">@_error</SgAlert>
    }

    @if (_images.Count > 0)
    {
        <div class="sgc-image-grid">
            @foreach (var img in _images)
            {
                <div class="sgc-image-card">
                    <img src="@GetSrc(img)" alt="generated" />
                    <div class="sgc-image-card-actions">
                        <SgButton Text="@Localizer["Llm_Download"]" Size="SgSize.Sm" OnClick="@(() => Download(img))" />
                        <SgButton Text="@Localizer["Llm_UseImage"]" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost"
                                  OnClick="@(() => UseAsBase(img))" />
                    </div>
                </div>
            }
        </div>
        @if (!string.IsNullOrEmpty(_revisedPrompt))
        {
            <div class="sgc-image-revised"><b>@Localizer["Llm_RefinedPrompt"]</b> @_revisedPrompt</div>
        }
    }
</div>


@code {
    [Parameter] public string CssClass { get; set; } = "";
    /// <summary>Custom inline styles applied to the image studio container.</summary>
    [Parameter] public string Style { get; set; } = "";
    /// <summary>The purpose description for image generation.</summary>
    [Parameter] public string TaskPurpose { get; set; } = SgLlmTaskPurpose.Images;

    private string _prompt = "";
    private string _editPrompt = "";
    private string _model = "gpt-image-1";
    private string _size = "1024x1024";
    private string _quality = "standard";
    private string _style = "vivid";
    private int _count = 1;
    private bool _busy;
    private bool _editMode;
    private string _error = "";
    private string _revisedPrompt = "";
    private List<SgLlmGeneratedImage> _images = new();
    private SgLlmGeneratedImage? _lastImage;
    private byte[]? _maskBytes;
    private string? _maskMime;

    private static readonly List<string> _sizes = new() { "256x256", "512x512", "1024x1024", "1024x1792", "1792x1024" };
    private static readonly List<string> _qualities = new() { "standard", "hd", "low", "medium", "high" };
    private static readonly List<string> _styles = new() { "vivid", "natural" };

    private async Task GenerateAsync()
    {
        if (string.IsNullOrWhiteSpace(_prompt)) return;
        _busy = true; _error = ""; _images.Clear(); _revisedPrompt = "";
        try
        {
            var effective = LlmService.ResolveConfigForTask(TaskPurpose);
            await LlmService.InitializeAsync(effective);
            var res = await LlmService.GenerateImageRichAsync(new SgLlmImageRequest
            {
                Prompt = _prompt,
                Model = string.IsNullOrWhiteSpace(_model) ? effective.ModelId : _model,
                Size = _size,
                Quality = _quality,
                Style = _style,
                Count = _count
            });
            if (!string.IsNullOrEmpty(res.Error)) _error = res.Error;
            _images = res.Images;
            _revisedPrompt = res.RevisedPrompt ?? "";
            _lastImage = _images.FirstOrDefault();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task EditAsync()
    {
        if (_lastImage == null || string.IsNullOrWhiteSpace(_editPrompt)) return;
        _busy = true; _error = "";
        try
        {
            var effective = LlmService.ResolveConfigForTask(TaskPurpose);
            await LlmService.InitializeAsync(effective);
            byte[]? baseBytes = !string.IsNullOrEmpty(_lastImage.B64Json)
                ? Convert.FromBase64String(_lastImage.B64Json)
                : null;
            if (baseBytes == null) { _error = "Базовое изображение должно быть в b64_json"; return; }
            var res = await LlmService.EditImageAsync(baseBytes, _lastImage.MimeType ?? "image/png", _editPrompt,
                _maskBytes, _maskMime, string.IsNullOrWhiteSpace(_model) ? effective.ModelId : _model, _size);
            if (!string.IsNullOrEmpty(res.Error)) _error = res.Error;
            else { _images = res.Images; _lastImage = _images.FirstOrDefault(); }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task OnMaskSelected(IReadOnlyList<IBrowserFile> files)
    {
        var f = files.FirstOrDefault();
        if (f == null) return;
        _maskMime = string.IsNullOrEmpty(f.ContentType) ? "image/png" : f.ContentType;
        using var ms = new MemoryStream();
        await f.OpenReadStream(20_000_000).CopyToAsync(ms);
        _maskBytes = ms.ToArray();
    }

    private void UseAsBase(SgLlmGeneratedImage img) { _lastImage = img; _editMode = true; }

    private string GetSrc(SgLlmGeneratedImage img) =>
        !string.IsNullOrEmpty(img.Url) ? img.Url
        : $"data:{img.MimeType ?? "image/png"};base64,{img.B64Json}";

    private IJSObjectReference? _blobModule;

    private async Task<IJSObjectReference> EnsureBlobModuleAsync()
    {
        _blobModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/sg-blob.js");
        return _blobModule;
    }

    private async Task Download(SgLlmGeneratedImage img)
    {
        try
        {
            var blob = await EnsureBlobModuleAsync();
            var mime = string.IsNullOrEmpty(img.MimeType) ? "image/png" : img.MimeType;
            var ext = mime.Contains("jpeg") || mime.Contains("jpg") ? "jpg"
                     : mime.Contains("webp") ? "webp"
                     : mime.Contains("gif") ? "gif"
                     : "png";
            var stamp = DateTime.Now.ToString("yyyyMMdd-HHmmss");
            var fileName = $"image-{stamp}.{ext}";

            if (!string.IsNullOrEmpty(img.B64Json))
            {
                await blob.InvokeVoidAsync("downloadBase64", img.B64Json, mime, fileName);
            }
            else if (!string.IsNullOrEmpty(img.Url))
            {
                await blob.InvokeVoidAsync("downloadUrl", img.Url, fileName);
            }
        }
        catch (Exception ex)
        {
            _error = $"{Localizer["Llm_DownloadFailed"]}: {ex.Message}";
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_blobModule is not null)
        {
            try { await _blobModule.DisposeAsync(); }
            catch (JSDisconnectedException) { /* circuit gone */ }
            catch (TaskCanceledException) { /* shutdown in flight */ }
            catch (ObjectDisposedException) { /* already disposed */ }
            _blobModule = null;
        }
        GC.SuppressFinalize(this);
    }
}
