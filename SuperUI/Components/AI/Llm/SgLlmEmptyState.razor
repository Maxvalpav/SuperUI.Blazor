@namespace SuperUI.Components.Llm
@using SuperUI.Services.Llm
@implements IDisposable
@inject ILlmService LlmService
@inject ISuperUILocalizer Localizer

@*
   SgLlmEmptyState — стандартизированное пустое состояние для AI-компонентов.
   Подсказывает, что сделать дальше, и автоматически объясняет частые причины
   («введите API ключ», «запустите Ollama», «попробуйте Backend proxy»).
*@

<div class="sgc-llm-empty-state @CssClass">
    <div class="sgc-llm-empty-icon">@(string.IsNullOrEmpty(Icon) ? "🤖" : Icon)</div>
    <div class="sgc-llm-empty-title">@(string.IsNullOrEmpty(Title) ? Localizer["Llm_NoData"] : Title)</div>
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="sgc-llm-empty-message">@Message</div>
    }
    @if (ShowProviderHint && _hint != null)
    {
        <div class="sgc-llm-empty-hint">@_hint</div>
    }
    @if (Actions is not null)
    {
        <div class="sgc-llm-empty-actions">@Actions</div>
    }
</div>

@code {
    /// <summary>Big emoji shown at the top.</summary>
    [Parameter] public string Icon { get; set; } = "🤖";

    /// <summary>Bold one-line heading.</summary>
    [Parameter] public string Title { get; set; } = "";

    /// <summary>Free-form descriptive line under the title.</summary>
    [Parameter] public string? Message { get; set; }

    /// <summary>
    /// If true (default), append a provider-specific hint (e.g. «введите API key»,
    /// «запустите Ollama», «попробуйте Backend proxy»).
    /// </summary>
    [Parameter] public bool ShowProviderHint { get; set; } = true;

    /// <summary>Optional action buttons (rendered as a single row at the bottom).</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Extra CSS class on the outer container.</summary>
    [Parameter] public string CssClass { get; set; } = string.Empty;

    private string? _hint;

    protected override void OnInitialized()
    {
        Recompute();
        LlmService.OnConfigChanged += HandleConfigChanged;
    }

    protected override void OnParametersSet() => Recompute();

    private void HandleConfigChanged(SgLlmConfig _) { Recompute(); InvokeAsync(StateHasChanged); }

    private void Recompute()
    {
        var cfg = LlmService.CurrentConfig;
        if (cfg == null || cfg.Provider == SgLlmProvider.None)
        {
            _hint = Localizer["Llm_SelectProviderHint"];
            return;
        }

        var preset = SgLlmProviderRegistry.GetPreset(cfg.Provider);
        if (preset is { Category: SgLlmProviderCategory.Local })
        {
            _hint = cfg.Provider switch
            {
                SgLlmProvider.Ollama => Localizer["Llm_OllamaHint"],
                SgLlmProvider.LmStudio => Localizer["Llm_LmStudioHint"],
                SgLlmProvider.Vllm => Localizer["Llm_VllmHint"],
                _ => Localizer["Llm_LocalServerHint"]
            };
            return;
        }
        if (SgLlmProviderRegistry.RequiresKey(cfg.Provider) && string.IsNullOrWhiteSpace(cfg.ApiKey))
        {
            var keyUrl = preset?.ApiKeyUrl;
            _hint = string.IsNullOrEmpty(keyUrl)
                ? Localizer["Llm_ApiKeyHint"]
                : Localizer.GetString("Llm_ApiKeyUrlHint", keyUrl);
            return;
        }
        if (cfg.UseBackendProxy)
        {
            _hint = null;
            return;
        }
        _hint = Localizer["Llm_CorsHint"];
    }

    public void Dispose()
    {
        LlmService.OnConfigChanged -= HandleConfigChanged;
    }
}

