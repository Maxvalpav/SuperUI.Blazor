@namespace SuperUI.Components
@using SuperUI.Services.Llm
@inject ILlmService LlmService
@inject ISuperUILocalizer Localizer

@*
   SgLlmReranker — ранжирование документов по релевантности запросу.
   Использует Cohere /v2/rerank, для других провайдеров — fallback на cos-similarity
   эмбеддингов.
*@

<div class="sgc-llm-rerank @CssClass" style="@Style">
    <SgLlmHeader Title="@Localizer["Llm_RerankTitle"]" Subtitle="@Localizer["Llm_RerankSubtitle"]"
                 TaskPurpose="@SgLlmTaskPurpose.Rerank" />

    <SgTextBox @bind-Value="_query" Placeholder="@Localizer["Llm_RerankQueryPlaceholder"]" Label="@Localizer["Llm_RerankQuery"]" />

    <SgTextArea @bind-Value="_docs" Rows="8" Label="@Localizer["Llm_RerankDocuments"]" />

    <div class="sgc-rerank-controls">
        <SgTextBox @bind-Value="_model" Placeholder="rerank-v3.5" Label="@Localizer["Llm_RerankModel"]" />
        <SgNumberInput TValue="int" @bind-Value="_topN" Min="0" Max="50" Label="Top N (0 = все)" />
    </div>

    <div class="sgc-rerank-actions">
        <SgButton Text="@Localizer["Llm_Rerank"]" OnClick="RunAsync" Loading="_busy"
                  Variant="SgButtonVariant.Primary"
                  Disabled="@(string.IsNullOrWhiteSpace(_query) || string.IsNullOrWhiteSpace(_docs))" />
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <SgAlert Variant="SgAlertVariant.Danger">@_error</SgAlert>
    }

    @if (_results.Count == 0 && !_busy && string.IsNullOrEmpty(_error))
    {
        <SgLlmEmptyState Icon="📊" Title="@Localizer["Llm_RerankEmptyTitle"]"
                         Message="Каждая непустая строка — отдельный документ. Реранкер вернёт их в порядке релевантности." />
    }

    @if (_results.Count > 0)
    {
        <SgCard>
            <h4 style="margin:0 0 8px 0">Результаты</h4>
            @foreach (var (r, i) in _results.Select((x, idx) => (x, idx)))
            {
                <div class="sgc-rerank-row">
                    <SgBadge>@(i + 1)</SgBadge>
                    <SgBadge Variant="SgBadgeVariant.Info">score: @r.Score.ToString("F4")</SgBadge>
                    <span>@r.Document</span>
                </div>
            }
        </SgCard>
    }
</div>

<style>
    .sgc-llm-rerank { display: flex; flex-direction: column; gap: 12px; padding: 12px; }
    .sgc-rerank-controls { display: grid; grid-template-columns: 2fr 1fr; gap: 8px; }
    .sgc-rerank-actions { display: flex; gap: 8px; }
    .sgc-rerank-row { display: flex; gap: 8px; align-items: center; padding: 4px 0; border-bottom: 1px dashed var(--sg-border, #e5e7eb); }
</style>

@code {
    [Parameter] public string CssClass { get; set; } = "";
    /// <summary>Custom inline styles applied to the reranker container.</summary>
    [Parameter] public string Style { get; set; } = "";
    /// <summary>The purpose description for reranking.</summary>
    [Parameter] public string TaskPurpose { get; set; } = SgLlmTaskPurpose.Rerank;

    private string _query = "";
    private string _docs = "";
    private string _model = "";
    private int _topN;
    private bool _busy;
    private string _error = "";
    private List<SgLlmRerankResult> _results = new();

    private async Task RunAsync()
    {
        var lines = _docs.Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim()).Where(s => s.Length > 0).ToList();
        if (lines.Count == 0) return;

        _busy = true; _error = ""; _results.Clear();
        try
        {
            var effective = LlmService.ResolveConfigForTask(TaskPurpose);
            await LlmService.InitializeAsync(effective);
            _results = await LlmService.RerankAsync(new SgLlmRerankRequest
            {
                Query = _query,
                Documents = lines,
                Model = string.IsNullOrWhiteSpace(_model) ? effective.ModelId : _model,
                TopN = _topN > 0 ? _topN : null
            });
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
