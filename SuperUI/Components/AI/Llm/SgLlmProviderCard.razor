@namespace SuperUI.Components.Llm
@using SuperUI.Services.Llm
@inject ISuperUILocalizer Localizer

@*
   SgLlmProviderCard — одиночная карточка провайдера в каталоге.
   Используется в SgLlmProviderPicker. Параметризована: можно рендерить
   как кнопку (clickable=true) или как пассивный preview.
*@

<div class="sgc-llm-card-tile @(Active ? "active" : "") @(Current ? "current" : "") @CssClass"
     role="@(Clickable ? "button" : null)"
     tabindex="@(Clickable ? "0" : null)"
     @onclick="HandleClick"
     @onkeydown="HandleKey"
     @onkeydown:preventDefault="@_preventKey">
    <div class="sgc-llm-card-tile-head">
        <span class="sgc-llm-card-tile-icon">@(string.IsNullOrEmpty(Preset.Icon) ? "📡" : Preset.Icon)</span>
        <div class="sgc-llm-card-tile-title">
            <strong>@Preset.Label</strong>
            <small>@CategoryLabel · @ApiStyleLabel · @AuthLabel</small>
        </div>
        <div class="sgc-llm-card-tile-badges">
            @if (Preset.IsFree)
            {
                <span class="sgc-llm-card-tile-badge free" title="@(Preset.FreeTierNotes ?? Localizer["Llm_FreeTier"])">FREE</span>
            }
            @if (!Preset.RequiresKey)
            {
                <span class="sgc-llm-card-tile-badge nokey" title="@Localizer["Llm_NoApiKey"]">no-key</span>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Preset.Notes))
    {
        <div class="sgc-llm-card-tile-notes" title="@Preset.Notes">@Preset.Notes</div>
    }

    <div class="sgc-llm-card-tile-tags">
        @foreach (var tag in Preset.Tags)
        {
            <span class="sgc-llm-card-tile-tag @TagClass(tag)" title="@TagTooltip(tag)">@tag</span>
        }
    </div>

    @if (Clickable && ShowSelect)
    {
        <div class="sgc-llm-card-tile-foot">
            <button type="button" class="sgc-llm-card-tile-select"
                    @onclick="HandleClick" @onclick:stopPropagation="true">
                @(Active ? Localizer["Llm_Selected"] : Localizer["Llm_Select"])
            </button>
        </div>
    }
</div>

@code {
    /// <summary>Provider preset to render. Required.</summary>
    [Parameter, EditorRequired] public SgLlmProviderPreset Preset { get; set; } = default!;

    /// <summary>Renders the card with an active outline.</summary>
    [Parameter] public bool Active { get; set; }

    /// <summary>Renders the card with a "currently applied" marker.</summary>
    [Parameter] public bool Current { get; set; }

    /// <summary>If true, the card acts as a button and raises <see cref="OnClick"/>.</summary>
    [Parameter] public bool Clickable { get; set; } = true;

    /// <summary>If true, renders a visible Select button at the bottom.</summary>
    [Parameter] public bool ShowSelect { get; set; } = true;

    /// <summary>Click / Enter / Space callback.</summary>
    [Parameter] public EventCallback<SgLlmProviderPreset> OnClick { get; set; }

    /// <summary>Extra CSS classes applied to the tile.</summary>
    [Parameter] public string CssClass { get; set; } = string.Empty;

    private bool _preventKey;

    private string CategoryLabel => Preset.Category switch
    {
        SgLlmProviderCategory.Frontier => Localizer["Llm_CategoryFrontier"],
        SgLlmProviderCategory.OpenRouting => Localizer["Llm_CategoryOpenRouting"],
        SgLlmProviderCategory.FastInference => Localizer["Llm_CategoryFastInference"],
        SgLlmProviderCategory.Local => Localizer["Llm_CategoryLocal"],
        SgLlmProviderCategory.Free => Localizer["Llm_CategoryFree"],
        SgLlmProviderCategory.Russian => Localizer["Llm_CategoryRussian"],
        SgLlmProviderCategory.Specialty => Localizer["Llm_CategorySpecialty"],
        SgLlmProviderCategory.Azure => "Azure",
        _ => Preset.Category
    };

    private string ApiStyleLabel => Preset.ApiStyle switch
    {
        SgLlmApiStyle.OpenAiChat => "OpenAI chat",
        SgLlmApiStyle.OpenAiResponses => "OpenAI responses",
        SgLlmApiStyle.AnthropicMessages => "Anthropic msgs",
        SgLlmApiStyle.GoogleGemini => "Gemini",
        SgLlmApiStyle.OllamaNative => "Ollama native",
        SgLlmApiStyle.CohereV2 => "Cohere v2",
        SgLlmApiStyle.GigaChat => "GigaChat",
        SgLlmApiStyle.CloudflareWorkersAi => "CF Workers AI",
        _ => Preset.ApiStyle
    };

    private string AuthLabel => Preset.Auth switch
    {
        SgLlmAuthStyle.None => "no auth",
        SgLlmAuthStyle.Bearer => "Bearer",
        SgLlmAuthStyle.XApiKey => "x-api-key",
        SgLlmAuthStyle.OAuth => "OAuth",
        SgLlmAuthStyle.AzureApiKey => "Azure key",
        _ => Preset.Auth
    };

    private static string TagClass(string tag) => tag switch
    {
        SgLlmProviderTag.Free => "tag-free",
        SgLlmProviderTag.Local => "tag-local",
        SgLlmProviderTag.Russian => "tag-russian",
        SgLlmProviderTag.Reasoning => "tag-reasoning",
        SgLlmProviderTag.Vision => "tag-vision",
        SgLlmProviderTag.Embeddings => "tag-embeddings",
        SgLlmProviderTag.Audio => "tag-audio",
        SgLlmProviderTag.Images => "tag-images",
        SgLlmProviderTag.Tools => "tag-tools",
        SgLlmProviderTag.Agentic => "tag-agentic",
        _ => "tag-default"
    };

    private string TagTooltip(string tag) => tag switch
    {
        SgLlmProviderTag.Free => Localizer["Llm_FreeTierTag"],
        SgLlmProviderTag.Local => Localizer["Llm_LocalTag"],
        SgLlmProviderTag.Russian => Localizer["Llm_RussianTag"],
        SgLlmProviderTag.Reasoning => Localizer["Llm_ReasoningTag"],
        SgLlmProviderTag.Vision => Localizer["Llm_VisionTag"],
        SgLlmProviderTag.Embeddings => Localizer["Llm_EmbedTag"],
        SgLlmProviderTag.Audio => Localizer["Llm_AudioTag"],
        SgLlmProviderTag.Images => Localizer["Llm_ImageGenTag"],
        SgLlmProviderTag.Tools => Localizer["Llm_ToolCallsTag"],
        SgLlmProviderTag.Agentic => Localizer["Llm_AgenticTag"],
        SgLlmProviderTag.Cloud => Localizer["Llm_CloudTag"],
        SgLlmProviderTag.Specialty => Localizer["Llm_SpecializedTag"],
        _ => tag
    };

    private async Task HandleClick()
    {
        if (!Clickable) return;
        if (OnClick.HasDelegate) await OnClick.InvokeAsync(Preset);
    }

    private async Task HandleKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (!Clickable) return;
        if (e.Key == "Enter" || e.Key == " " || e.Code == "Space")
        {
            _preventKey = true;
            await HandleClick();
        }
        else
        {
            _preventKey = false;
        }
    }
}

