@namespace SuperUI.Components.Llm
@using SuperUI.Services.Llm
@inject IOpenRouterService OpenRouterService
@inject ISuperUILocalizer Localizer

<div class="sgc-or-dashboard @CssClass" style="@Style">
    <div class="sgc-or-dashboard-header">
        <div class="sgc-or-dashboard-title">
            <SgIcon Icon="@SgIcons.Cpu" Size="20px" />
            <span>OpenRouter Dashboard</span>
        </div>
        <div class="sgc-or-dashboard-actions">
            <SgSwitch @bind-Value="_showLogs" Label="@Localizer["Llm_Logs"]" Size="SgSize.Sm" />
        </div>
    </div>

    <div class="sgc-or-dashboard-main">
        <SgTabs Style="flex: 1; display: flex; flex-direction: column;">
            <SgTabPanel Title="@Localizer["Llm_ModelsTab"]">
                <Icon>@((MarkupString)SgIcons.Search)</Icon>
                <ChildContent>
                    <div class="sgc-or-tab-content">
                         <SgOpenRouterModelPicker SelectedModelId="@SelectedModelId" 
                                                 OnModelSelected="OnModelSelectedInternal" />
                     </div>
                </ChildContent>
            </SgTabPanel>
            
            <SgTabPanel Title="@Localizer["Llm_InfoTab"]">
                <Icon>@((MarkupString)SgIcons.Info)</Icon>
                <ChildContent>
                    <div class="sgc-or-tab-content" style="gap: 16px;">
                        <SgOpenRouterKeyInfo ApiKey="@ApiKey" />
                        <SgOpenRouterModelDetails ModelId="@SelectedModelId" />
                    </div>
                </ChildContent>
            </SgTabPanel>

            <SgTabPanel Title="@Localizer["Llm_SettingsTab"]">
                <Icon>@((MarkupString)SgIcons.Settings)</Icon>
                <ChildContent>
                    <div class="sgc-or-tab-content">
                        <div class="sgc-or-settings-group">
                            <label>@Localizer["Llm_KeyLabel"]</label>
                            <SgTextBox TValue="string" Value="@ApiKey" ValueChanged="OnApiKeyChanged" Type="password" Placeholder="sk-or-v1-..." />
                        </div>
                        
                        <div class="sgc-or-settings-grid">
                            <div class="sgc-or-settings-group">
                                <label>Temperature (@_temp.ToString("F1"))</label>
                                <input type="range" min="0" max="2" step="0.1" @bind="_temp" class="sg-range" />
                            </div>
                            <div class="sgc-or-settings-group">
                                <label>Top P (@_topP.ToString("F2"))</label>
                                <input type="range" min="0" max="1" step="0.05" @bind="_topP" class="sg-range" />
                            </div>
                        </div>

                        <SgButton Text="@Localizer["Llm_TestConnection"]" 
                                  Variant="SgButtonVariant.Primary" 
                                  OnClick="CheckConnectionAsync" 
                                  Loading="_checking" 
                                  Block="true" />
                    </div>
                </ChildContent>
            </SgTabPanel>
        </SgTabs>
    </div>

    @if (_showLogs)
    {
        <div class="sgc-or-dashboard-logs">
            <div class="sgc-or-logs-header">
                <span>Terminal Output</span>
                <SgButton Text="@Localizer["Llm_Clear"]" Size="SgSize.Sm" Variant="SgButtonVariant.Ghost" OnClick="() => _logs.Clear()" />
            </div>
            <div class="sgc-or-logs-body" @ref="_logRef">
                @foreach (var log in _logs)
                {
                    <div class="sgc-or-log-entry @log.Type.ToLower()">
                        <span class="sgc-or-log-time">@log.Time.ToString("HH:mm:ss")</span>
                        <span class="sgc-or-log-prefix">[@log.Type.ToUpper()]</span>
                        <span class="sgc-or-log-msg">@log.Message</span>
                    </div>
                }
                @if (!_logs.Any())
                {
                    <div class="sgc-or-log-empty">Ожидание событий...</div>
                }
            </div>
        </div>
    }
</div>

<style>
    .sgc-or-dashboard {
        display: flex;
        flex-direction: column;
        background: var(--sg-bg);
        border: 1px solid var(--sg-border);
        border-radius: var(--sg-radius-lg);
        overflow: hidden;
        height: 600px;
        box-shadow: var(--sg-shadow-lg);
    }
    .sgc-or-dashboard-header {
        padding: 12px 16px;
        background: var(--sg-bg-subtle);
        border-bottom: 1px solid var(--sg-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .sgc-or-dashboard-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        color: var(--sg-fg);
    }
    .sgc-or-dashboard-main {
        flex: 1;
        overflow: hidden;
    }
    .sgc-or-dashboard-main ::deep .sgc-tabs-strip {
        gap: 0;
    }
    .sgc-or-dashboard-main ::deep .sgc-tab {
        flex: 1;
        justify-content: center;
        padding: 10px;
        font-size: 13px;
    }
    .sgc-or-dashboard-main ::deep .sgc-tab.sgc-active {
        background: var(--sg-color-primary-subtle);
        border-bottom-width: 3px;
    }
    .sgc-or-tab-content {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 20px;
        height: 100%;
        overflow-y: auto;
    }
    .sgc-or-settings-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .sgc-or-settings-group label {
        font-size: 12px;
        font-weight: 500;
        color: var(--sg-fg-muted);
    }
    .sgc-or-settings-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
    .sgc-or-dashboard-logs {
        height: 180px;
        background: #121212;
        color: #e0e0e0;
        border-top: 1px solid var(--sg-border);
        display: flex;
        flex-direction: column;
    }
    .sgc-or-logs-header {
        padding: 4px 12px;
        background: #1a1a1a;
        font-family: var(--sg-font-mono);
        font-size: 10px;
        color: #888;
        display: flex;
        justify-content: space-between;
        align-items: center;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .sgc-or-logs-body {
        flex: 1;
        padding: 8px 12px;
        font-family: var(--sg-font-mono, monospace);
        font-size: 11px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    .sgc-or-log-entry { display: flex; gap: 8px; line-height: 1.4; }
    .sgc-or-log-time { color: #555; }
    .sgc-or-log-prefix { font-weight: bold; width: 60px; }
    .sgc-or-log-entry.info .sgc-or-log-prefix { color: #3b82f6; }
    .sgc-or-log-entry.success .sgc-or-log-prefix { color: #22c55e; }
    .sgc-or-log-entry.error .sgc-or-log-prefix { color: #ef4444; }
    .sgc-or-log-entry.warning .sgc-or-log-prefix { color: #f59e0b; }
    .sgc-or-log-msg { white-space: pre-wrap; word-break: break-all; }
    .sgc-or-log-empty { color: #444; font-style: italic; text-align: center; margin-top: 20px; }

    .sg-range {
        width: 100%;
        height: 4px;
        background: #333;
        border-radius: 2px;
        appearance: none;
        outline: none;
    }
    .sg-range::-webkit-slider-thumb {
        appearance: none;
        width: 12px;
        height: 12px;
        background: var(--sg-primary);
        border-radius: 50%;
        cursor: pointer;
    }
</style>

@code {
    [Parameter] public string? ApiKey { get; set; }
    /// <summary>Gets or sets the selected model ID.</summary>
    [Parameter] public string? SelectedModelId { get; set; }
    /// <summary>Callback invoked when the API key changes.</summary>
    [Parameter] public EventCallback<string> ApiKeyChanged { get; set; }
    /// <summary>Callback invoked when the selected model ID changes.</summary>
    [Parameter] public EventCallback<string> SelectedModelIdChanged { get; set; }
    /// <summary>Custom CSS class applied to the dashboard container.</summary>
    [Parameter] public string? CssClass { get; set; }
    /// <summary>Custom inline styles applied to the dashboard container.</summary>
    [Parameter] public string? Style { get; set; }

    private bool _showLogs = true;
    private bool _checking;
    private double _temp = 0.7;
    private double _topP = 1.0;
    private List<LogItem> _logs = new();
    private ElementReference _logRef;

    private class LogItem {
        public DateTime Time { get; set; }
        public string Message { get; set; } = "";
        public string Type { get; set; } = "info";
    }

    private void AddLog(string msg, string type = "info") {
        _logs.Add(new LogItem { Time = DateTime.Now, Message = msg, Type = type });
        if (_logs.Count > 100) _logs.RemoveAt(0);
        StateHasChanged();
    }

    private async Task OnApiKeyChanged(string value)
    {
        ApiKey = value;
        await ApiKeyChanged.InvokeAsync(value);
    }

    private async Task OnModelSelectedInternal(SgOpenRouterModel model)
    {
        SelectedModelId = model.Id;
        AddLog($"Выбрана модель: {model.Name} ({model.Id})", "info");
        await SelectedModelIdChanged.InvokeAsync(model.Id);
    }

    private async Task CheckConnectionAsync()
    {
        if (string.IsNullOrEmpty(ApiKey)) {
            AddLog("Ошибка: API Key не указан", "error");
            return;
        }

        _checking = true;
        AddLog("Проверка соединения с OpenRouter...", "info");
        try {
            var keyInfo = await OpenRouterService.GetKeyInfoAsync(ApiKey);
            if (keyInfo != null) {
                AddLog($"Соединение установлено! Ключ: {keyInfo.Label}", "success");
                AddLog($"Использование: ${keyInfo.Usage:F4} / {(keyInfo.Limit?.ToString("F2") ?? "Unlimited")}", "success");
            } else {
                AddLog("Ошибка: Не удалось проверить ключ. Проверьте правильность ввода.", "error");
            }
        } catch (Exception ex) {
            AddLog($"Исключение: {ex.Message}", "error");
        } finally {
            _checking = false;
        }
    }

    protected override void OnInitialized()
    {
        AddLog("OpenRouter Dashboard инициализирован", "info");
    }
}
