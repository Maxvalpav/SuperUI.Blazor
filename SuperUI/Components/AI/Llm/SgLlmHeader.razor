@namespace SuperUI.Components.Llm
@using SuperUI.Services.Llm
@inject ILlmService LlmService
@inject ISuperUILocalizer Localizer
@implements IDisposable

@*
   SgLlmHeader — единая шапка для всех AI-компонентов:
   иконка задачи, заголовок/подзаголовок, статус-бейдж, маршрут
   (provider · model), кнопка «⚙ настройки» в попапе.
*@

<div class="sgc-llm-header @CssClass">
    <div class="sgc-llm-header-left">
        @if (!string.IsNullOrEmpty(TaskIcon))
        {
            <span class="sgc-llm-header-icon" aria-hidden="true">@TaskIcon</span>
        }
        <div class="sgc-llm-header-titles">
            <div class="sgc-llm-header-title">@Title</div>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <div class="sgc-llm-header-subtitle">@Subtitle</div>
            }
            <div class="sgc-llm-header-route">
                <span class="sgc-llm-header-route-label">@RouteLabel</span>
                <span class="sgc-llm-header-route-arrow">→</span>
                <span class="sgc-llm-header-route-provider" title="@_resolvedConfig?.BaseUrl">@_providerLabel</span>
                <span class="sgc-llm-header-route-sep">·</span>
                <span class="sgc-llm-header-route-model" title="@_resolvedConfig?.ModelId">@_modelLabel</span>
            </div>
        </div>
    </div>

    <div class="sgc-llm-header-right">
        <span class="sgc-llm-header-status @StatusCls" title="@StatusTooltip">
            <span class="sgc-llm-header-dot"></span>
            <span class="sgc-llm-header-status-text">@StatusText</span>
        </span>

        @if (Actions is not null)
        {
            <div class="sgc-llm-header-actions">@Actions</div>
        }

        @if (!string.IsNullOrEmpty(DocsUrl))
        {
            <a class="sgc-llm-header-help" href="@DocsUrl" target="_blank" rel="noopener" title="@Localizer["Llm_ProviderDocs"]">?</a>
        }

        @if (ShowSettingsButton)
        {
            <button type="button" class="sgc-llm-header-settings" @onclick="ToggleSettings" title="@Localizer["Llm_HeaderSettings"]">⚙</button>
        }
    </div>
</div>

@if (_settingsOpen)
{
    <div class="sgc-llm-header-popover" @onclick:stopPropagation="true">
        <div class="sgc-llm-header-popover-head">
            <span>@Localizer["Llm_HeaderSettings"]</span>
            <button type="button" @onclick="ToggleSettings" title="@Localizer["Llm_Close"]">✕</button>
        </div>
        <SgLlmSettings Compact="true" />
    </div>
    <div class="sgc-llm-header-popover-backdrop" @onclick="ToggleSettings"></div>
}

@code {
    /// <summary>Bold one-line title shown on the left.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Optional one-line subtitle under the title.</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>
    /// One of <see cref="SgLlmTaskPurpose"/> values. The header resolves the
    /// route for this purpose so users see «chat → OpenAI · gpt-5.5».
    /// </summary>
    [Parameter] public string TaskPurpose { get; set; } = SgLlmTaskPurpose.Chat;

    /// <summary>Optional inline action area (rendered to the right of the route).</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Emoji icon shown on the far left. Defaults to a task-specific glyph.</summary>
    [Parameter] public string TaskIcon { get; set; } = string.Empty;

    /// <summary>Documentation link surfaced via a small «?» button.</summary>
    [Parameter] public string? DocsUrl { get; set; }

    /// <summary>If true (default), shows a ⚙ button that opens compact settings in a popover.</summary>
    [Parameter] public bool ShowSettingsButton { get; set; } = true;

    /// <summary>Extra CSS class added to the outer container.</summary>
    [Parameter] public string CssClass { get; set; } = string.Empty;

    private SgLlmConfig? _resolvedConfig;
    private string _providerLabel = "—";
    private string _modelLabel = "—";
    private bool _ready;
    private string? _lastError;
    private bool _settingsOpen;

    private string RouteLabel => TaskPurpose switch
    {
        SgLlmTaskPurpose.Chat => "chat",
        SgLlmTaskPurpose.Documents => "docs",
        SgLlmTaskPurpose.Vision => "vision",
        SgLlmTaskPurpose.Structured => "structured",
        SgLlmTaskPurpose.Embeddings => "embed",
        SgLlmTaskPurpose.Rerank => "rerank",
        SgLlmTaskPurpose.Images => "images",
        SgLlmTaskPurpose.Moderation => "moderation",
        SgLlmTaskPurpose.Speech => "speech",
        SgLlmTaskPurpose.Video => "video",
        _ => TaskPurpose
    };

    private string StatusCls => _lastError != null ? "error" : _ready ? "ok" : "idle";
    private string StatusText => _lastError != null ? Localizer["Llm_ErrorStatus"] : _ready ? Localizer["Llm_Ready"] : Localizer["Llm_NotConfigured"];
    private string StatusTooltip => _lastError ?? (_ready
        ? Localizer["Llm_ConfiguredAndReady"]
        : Localizer["Llm_SelectProviderHint"]);

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(TaskIcon)) TaskIcon = DefaultIcon(TaskPurpose);
        LlmService.OnConfigChanged += HandleConfigChanged;
        LlmService.OnReadyChanged += HandleReadyChanged;
        LlmService.OnError += HandleError;
        Refresh(LlmService.CurrentConfig);
    }

    protected override void OnParametersSet()
    {
        Refresh(LlmService.CurrentConfig);
    }

    private void HandleConfigChanged(SgLlmConfig config)
    {
        Refresh(config);
        InvokeAsync(StateHasChanged);
    }

    private void HandleReadyChanged(bool ready)
    {
        _ready = ready;
        InvokeAsync(StateHasChanged);
    }

    private void HandleError(string err)
    {
        _lastError = string.IsNullOrWhiteSpace(err) ? null : err;
        InvokeAsync(StateHasChanged);
    }

    private void Refresh(SgLlmConfig? root)
    {
        if (root == null)
        {
            _resolvedConfig = null;
            _providerLabel = "—";
            _modelLabel = Localizer["Llm_NotSelected"];
            _ready = false;
            return;
        }

        _resolvedConfig = LlmService.ResolveConfigForTask(TaskPurpose, root);
        _providerLabel = SgLlmProviderRegistry.Label(_resolvedConfig.Provider);
        _modelLabel = string.IsNullOrWhiteSpace(_resolvedConfig.ModelId) ? Localizer["Llm_ModelNotSelected"] : _resolvedConfig.ModelId!;
        _ready = !string.IsNullOrEmpty(_resolvedConfig.ModelId)
            && (!SgLlmProviderRegistry.RequiresKey(_resolvedConfig.Provider) || !string.IsNullOrEmpty(_resolvedConfig.ApiKey));

        if (string.IsNullOrEmpty(DocsUrl))
        {
            DocsUrl = SgLlmProviderRegistry.GetPreset(_resolvedConfig.Provider)?.DocsUrl;
        }
    }

    private void ToggleSettings() => _settingsOpen = !_settingsOpen;

    private static string DefaultIcon(string purpose) => purpose switch
    {
        SgLlmTaskPurpose.Chat => "💬",
        SgLlmTaskPurpose.Documents => "📄",
        SgLlmTaskPurpose.Vision => "👁",
        SgLlmTaskPurpose.Structured => "📐",
        SgLlmTaskPurpose.Embeddings => "🧬",
        SgLlmTaskPurpose.Rerank => "📊",
        SgLlmTaskPurpose.Images => "🖼",
        SgLlmTaskPurpose.Moderation => "🛡",
        SgLlmTaskPurpose.Speech => "🎙",
        SgLlmTaskPurpose.Video => "🎬",
        _ => "🤖"
    };

    public void Dispose()
    {
        LlmService.OnConfigChanged -= HandleConfigChanged;
        LlmService.OnReadyChanged -= HandleReadyChanged;
        LlmService.OnError -= HandleError;
    }
}

