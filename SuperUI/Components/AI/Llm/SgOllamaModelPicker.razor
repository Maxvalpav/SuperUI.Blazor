@namespace SuperUI.Components.Llm
@using SuperUI.Services.Llm
@inject ILlmService LlmService
@inject ISuperUILocalizer Localizer

<div class="sgc-ollama-picker @CssClass" style="@Style">
    <div class="sgc-ollama-search">
        <SgTextBox Placeholder="@Localizer["Llm_SearchLocalModels"]" @bind-Value="_searchQuery" @bind-Value:after="OnSearchChanged" AllowClear="true">
            <Prefix>@((MarkupString)SgIcons.Search)</Prefix>
        </SgTextBox>
        
        <div class="sgc-ollama-filters">
            <SgButton Text="@Localizer["Llm_RefreshList"]" Size="SgSize.Sm" OnClick="LoadModelsAsync" Loading="_loading" Variant="SgButtonVariant.Ghost">
                <Icon>@((MarkupString)SgIcons.Refresh)</Icon>
            </SgButton>
        </div>
    </div>

    <div class="sgc-ollama-list">
        @if (_loading)
        {
            <div class="sgc-ollama-state">
                <SgSpinner Size="SgSize.Sm" />
                <span>Загрузка моделей Ollama...</span>
            </div>
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <div class="sgc-ollama-state">
                @((MarkupString)SgIcons.Info)
                <span>@_error</span>
            </div>
        }
        else if (!_filteredModels.Any())
        {
            <div class="sgc-ollama-state">
                @((MarkupString)SgIcons.Info)
                <span>Модели не найдены. Убедитесь, что Ollama запущена.</span>
            </div>
        }
        else
        {
            @foreach (var model in _filteredModels)
            {
                <div class="sgc-ollama-item @(SelectedModelId == model.Name ? "sgc-active" : "")" @onclick="() => SelectModel(model)">
                    <div class="sgc-ollama-item-header">
                        <span class="sgc-ollama-model-name">@model.Name</span>
                        <SgBadge Variant="SgBadgeVariant.Info">@model.Details?.ParameterSize</SgBadge>
                    </div>
                    <div class="sgc-ollama-model-meta">
                        <span>@FormatSize(model.Size)</span>
                        <span>•</span>
                        <span>@model.Details?.QuantizationLevel</span>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .sgc-ollama-picker {
        display: flex;
        flex-direction: column;
        gap: 12px;
        background: var(--sg-bg);
        border: 1px solid var(--sg-border);
        border-radius: var(--sg-radius-lg);
        height: 100%;
        max-height: 400px;
    }
    .sgc-ollama-search {
        padding: 12px 12px 0 12px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .sgc-ollama-filters {
        display: flex;
        justify-content: flex-end;
    }
    .sgc-ollama-list {
        flex: 1;
        overflow-y: auto;
        padding: 0 8px 12px 8px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .sgc-ollama-item {
        padding: 8px 12px;
        border-radius: var(--sg-radius-md);
        cursor: pointer;
        transition: all 0.2s;
        border: 1px solid transparent;
    }
    .sgc-ollama-item:hover {
        background: var(--sg-bg-hover);
    }
    .sgc-ollama-item.sgc-active {
        background: var(--sg-primary-10);
        border-color: var(--sg-primary);
    }
    .sgc-ollama-item-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2px;
    }
    .sgc-ollama-model-name {
        font-weight: 600;
        font-size: 14px;
    }
    .sgc-ollama-model-meta {
        font-size: 11px;
        color: var(--sg-fg-muted);
        display: flex;
        gap: 6px;
    }
    .sgc-ollama-state {
        padding: 32px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        color: var(--sg-fg-muted);
        text-align: center;
        font-size: 13px;
    }
</style>

@code {
    [Parameter] public string? SelectedModelId { get; set; }
    /// <summary>Callback invoked when a model is selected. Receives the model ID.</summary>
    [Parameter] public EventCallback<string> OnSelected { get; set; }
    /// <summary>The base URL for the Ollama API.</summary>
    [Parameter] public string? BaseUrl { get; set; }
    /// <summary>Custom CSS class applied to the model picker container.</summary>
    [Parameter] public string? CssClass { get; set; }
    /// <summary>Custom inline styles applied to the model picker container.</summary>
    [Parameter] public string? Style { get; set; }

    private List<SgOllamaModel> _models = new();
    private List<SgOllamaModel> _filteredModels = new();
    private string _searchQuery = "";
    private bool _loading;
    private string _error = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadModelsAsync();
    }

    private async Task LoadModelsAsync()
    {
        _loading = true; _error = "";
        try
        {
            _models = await LlmService.GetOllamaModelsAsync(BaseUrl);
            ApplyFilters();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnSearchChanged() => ApplyFilters();

    private void ApplyFilters()
    {
        var query = _searchQuery?.Trim().ToLower() ?? "";
        _filteredModels = _models
            .Where(m => string.IsNullOrEmpty(query) || m.Name.ToLower().Contains(query))
            .ToList();
    }

    private async Task SelectModel(SgOllamaModel model)
    {
        SelectedModelId = model.Name;
        await OnSelected.InvokeAsync(model.Name);
    }

    private string FormatSize(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB", "TB" };
        double size = bytes;
        int unitIndex = 0;
        while (size >= 1024 && unitIndex < units.Length - 1)
        {
            size /= 1024;
            unitIndex++;
        }
        return $"{size:F1} {units[unitIndex]}";
    }
}
