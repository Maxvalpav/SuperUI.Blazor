@namespace SuperUI.Components
@using SuperUI.Services.Llm
@inject ILlmService LlmService

@*
   SgLlmStudio — единый хаб для возможностей LLM-провайдера:
   чат, генерация изображений, STT, TTS, эмбеддинги, модерация, анализ
   изображений и видео. Каждый таб — отдельный самодостаточный компонент.
*@

<div class="sgc-llm-studio @CssClass" style="@Style">
    @if (ShowSettings)
    {
        <SgLlmSettings Compact="true" />
    }

    <SgTabs>
        <SgTabPanel Title="Провайдеры">
            <SgLlmProviderPicker />
        </SgTabPanel>
        <SgTabPanel Title="Чат">
            <SgChat />
        </SgTabPanel>
        <SgTabPanel Title="Tools">
            <SgLlmToolPlayground />
        </SgTabPanel>
        <SgTabPanel Title="Structured">
            <SgLlmStructuredOutput />
        </SgTabPanel>
        <SgTabPanel Title="Изображения">
            <SgLlmImageStudio />
        </SgTabPanel>
        <SgTabPanel Title="STT">
            <SgLlmTranscriber />
        </SgTabPanel>
        <SgTabPanel Title="TTS">
            <SgLlmSpeaker />
        </SgTabPanel>
        <SgTabPanel Title="Эмбеддинги">
            <SgLlmEmbedder />
        </SgTabPanel>
        <SgTabPanel Title="Rerank">
            <SgLlmReranker />
        </SgTabPanel>
        <SgTabPanel Title="Модерация">
            <SgLlmModerator />
        </SgTabPanel>
        <SgTabPanel Title="Vision">
            <SgLlmVisionAnalyzer />
        </SgTabPanel>
        <SgTabPanel Title="Video">
            <SgLlmVideoAnalyzer />
        </SgTabPanel>
    </SgTabs>
</div>

<style>
    .sgc-llm-studio { display: flex; flex-direction: column; gap: 12px; }
</style>

@code {
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";
    [Parameter] public bool ShowSettings { get; set; } = true;
}
