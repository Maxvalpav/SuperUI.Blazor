@namespace SuperUI.Components
@using SuperUI.Services.Llm
@inject ILlmService LlmService
@inject ISuperUILocalizer Localizer

@*
   SgLlmStudio — единый хаб для возможностей LLM-провайдера:
   чат, генерация изображений, STT, TTS, эмбеддинги, модерация, анализ
   изображений и видео. Каждый таб — отдельный самодостаточный компонент.
*@

<div class="sgc-llm-studio @CssClass" style="@Style">
    <SgLlmHeader Title="@Localizer["Llm_StudioTitle"]" Subtitle="@Localizer["Llm_StudioSubtitle"]"
                 TaskPurpose="@SgLlmTaskPurpose.Chat" />

    <div class="sgc-llm-studio-toolbar">
        @if (ShowSettings)
        {
            <div class="sgc-llm-studio-settings">
                <SgLlmSettings Compact="true" />
            </div>
        }
        <SgButton Text="@Localizer["Llm_ProviderCatalog"]"
                  Variant="SgButtonVariant.Outlined"
                  Size="SgSize.Sm"
                  OnClick="() => _providersOpen = true">
            <Icon>@((MarkupString)SgIcons.Globe)</Icon>
        </SgButton>
    </div>

    <SgTabs>
        <SgTabPanel Title="@Localizer["Llm_ChatTab"]"><SgChat /></SgTabPanel>
        <SgTabPanel Title="Tools"><SgLlmToolPlayground /></SgTabPanel>
        <SgTabPanel Title="Structured"><SgLlmStructuredOutput /></SgTabPanel>
        <SgTabPanel Title="@Localizer["Llm_ImagesTab"]"><SgLlmImageStudio /></SgTabPanel>
        <SgTabPanel Title="STT"><SgLlmTranscriber /></SgTabPanel>
        <SgTabPanel Title="TTS"><SgLlmSpeaker /></SgTabPanel>
        <SgTabPanel Title="@Localizer["Llm_EmbeddingsTab"]"><SgLlmEmbedder /></SgTabPanel>
        <SgTabPanel Title="Rerank"><SgLlmReranker /></SgTabPanel>
        <SgTabPanel Title="@Localizer["Llm_ModerationTab"]"><SgLlmModerator /></SgTabPanel>
        <SgTabPanel Title="Vision"><SgLlmVisionAnalyzer /></SgTabPanel>
        <SgTabPanel Title="Video"><SgLlmVideoAnalyzer /></SgTabPanel>
    </SgTabs>

    <SgModal @bind-Visible="_providersOpen"
             Title="@Localizer["Llm_ProviderCatalogTitle"]"
             Width="1024px">
        <SgLlmProviderPicker Config="@LlmService.CurrentConfig" />
    </SgModal>
</div>

<style>
    .sgc-llm-studio { display: flex; flex-direction: column; gap: 12px; }
    .sgc-llm-studio-toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .sgc-llm-studio-settings { flex: 1; min-width: 0; }
</style>

@code {
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";
    [Parameter] public bool ShowSettings { get; set; } = true;

    private bool _providersOpen;
}
