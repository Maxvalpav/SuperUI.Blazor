@namespace SuperUI.Components.AI.LangGraph
@using SuperUI.Services.AI
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject SgLangGraphService LangGraphService
@inject ILogger<LangGraphProvider> Logger

<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public SgLangGraphConfig? Config { get; set; }
    [Parameter] public EventCallback<SgLangGraphStep> OnStep { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }
    [Parameter] public EventCallback<SgLangGraphSchema> OnInitialized { get; set; }
    [Parameter] public EventCallback<SgLangGraphInterrupt> OnInterrupt { get; set; }
    [Parameter] public Func<string, object, Task<SgLangGraphNodeResult>>? OnNodeExecute { get; set; }

    /// <summary>
    /// The underlying graph service. Child components subscribe to its events
    /// (<see cref="SgLangGraphService.OnStep"/> etc.) directly for in-code,
    /// multi-subscriber notifications; the <c>On*</c> <see cref="EventCallback"/>
    /// parameters above are the razor-attribute API for the parent.
    /// </summary>
    public SgLangGraphService Service => LangGraphService;
    public SgLangGraphStep? CurrentStep { get; private set; }
    public SgLangGraphSchema? Schema { get; private set; }
    public bool IsInitialized { get; private set; }

    protected override async Task OnInitializedAsync()
    {
        LangGraphService.OnStep += HandleStep;
        LangGraphService.OnError += HandleError;
        LangGraphService.OnInitialized += HandleInitialized;
        LangGraphService.OnInterrupt += HandleInterrupt;
        LangGraphService.OnNodeExecute += HandleNodeExecute;

        if (Config != null)
        {
            await LangGraphService.InitializeAsync(Config);
        }
    }

    private async Task<SgLangGraphNodeResult> HandleNodeExecute(string nodeId, object state)
    {
        if (OnNodeExecute != null)
        {
            return await OnNodeExecute.Invoke(nodeId, state);
        }
        return new SgLangGraphNodeResult { State = state };
    }

    private void HandleStep(SgLangGraphStep step)
    {
        CurrentStep = step;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await OnStep.InvokeAsync(step);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "LangGraphProvider.HandleStep failed");
            }
        });
    }

    private void HandleError(string error)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                await OnError.InvokeAsync(error);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "LangGraphProvider.HandleError failed");
            }
        });
    }

    private void HandleInitialized(SgLangGraphSchema schema)
    {
        Schema = schema;
        IsInitialized = true;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await OnInitialized.InvokeAsync(schema);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "LangGraphProvider.HandleInitialized failed");
            }
        });
    }

    private void HandleInterrupt(SgLangGraphInterrupt interrupt)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                await OnInterrupt.InvokeAsync(interrupt);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "LangGraphProvider.HandleInterrupt failed");
            }
        });
    }

    public async Task SendMessageAsync(string message)
    {
        await LangGraphService.SendMessageAsync(message);
    }

    public async Task RespondToInterruptAsync(object data)
    {
        await LangGraphService.RespondToInterruptAsync(data);
    }

    public ValueTask DisposeAsync()
    {
        LangGraphService.OnStep -= HandleStep;
        LangGraphService.OnError -= HandleError;
        LangGraphService.OnInitialized -= HandleInitialized;
        LangGraphService.OnInterrupt -= HandleInterrupt;
        LangGraphService.OnNodeExecute -= HandleNodeExecute;
        return ValueTask.CompletedTask;
    }
}
