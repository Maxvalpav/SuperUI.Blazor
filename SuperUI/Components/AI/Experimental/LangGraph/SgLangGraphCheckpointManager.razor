@namespace SuperUI.Components.AI.Experimental.LangGraph
@using SuperUI.Services.AI
@using SuperUI.Enums
@using System.Diagnostics.CodeAnalysis
@attribute [Experimental("SUPERUI_LANGGRAPH")]
@implements IDisposable

<SgCard Title="Checkpoint Manager" Compact="true">
    <SgStack Orientation="SgOrientation.Vertical" Gap="8px">
        <div class="sgc-checkpoint-info">
            <small>Thread ID: @(Provider?.Config?.ThreadId ?? "default")</small>
        </div>
        <SgButtonGroup Size="SgSize.Sm">
            <SgButton Text="Reset" Variant="SgButtonVariant.Danger" OnClick="ResetThreadAsync" />
        </SgButtonGroup>

        @if (_history.Any())
        {
            <div class="sgc-checkpoint-history">
                <h6>History</h6>
                <div class="sgc-history-list">
                    @foreach (var entry in _history)
                    {
                        <div class="sgc-history-item">
                            <span>@entry.Node</span>
                            <small>@entry.Timestamp.ToString("HH:mm:ss")</small>
                        </div>
                    }
                </div>
            </div>
        }
    </SgStack>
</SgCard>


@code {
    [CascadingParameter] public SgLangGraphProvider? Provider { get; set; }

    private List<HistoryEntry> _history = new();

    protected override void OnInitialized()
    {
        if (Provider != null)
        {
            Provider.Service.OnStep += HandleStep;
        }
    }

    private void HandleStep(SgLangGraphStep step) => _ = InvokeAsync(() =>
    {
        _history.Add(new HistoryEntry { Node = step.Node, State = step.State, Timestamp = DateTime.Now });
        StateHasChanged();
    });

    private void ResetThreadAsync()
    {
        _history.Clear();
    }

    public void Dispose()
    {
        if (Provider != null)
        {
            Provider.Service.OnStep -= HandleStep;
        }
    }

    private class HistoryEntry
    {
        public string Node { get; set; } = string.Empty;
        public object? State { get; set; }
        public DateTime Timestamp { get; set; }
    }
}
