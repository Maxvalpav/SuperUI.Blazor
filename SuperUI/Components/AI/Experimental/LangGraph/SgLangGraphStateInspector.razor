@namespace SuperUI.Components.AI.Experimental.LangGraph
@using SuperUI.Services.AI
@using SuperUI.Enums
@using System.Diagnostics.CodeAnalysis
@attribute [Experimental("SUPERUI_LANGGRAPH")]
@implements IDisposable

<SgCard Title="State Inspector" Compact="true">
    <div class="sgc-state-inspector">
        @if (_currentState == null)
        {
            <div class="sgc-state-empty">Состояние пусто</div>
        }
        else
        {
            <pre>@JsonState</pre>
        }
    </div>
</SgCard>


@code {
    [CascadingParameter] public SgLangGraphProvider? Provider { get; set; }

    private object? _currentState;
    private string? _cachedJson;

    private static readonly System.Text.Json.JsonSerializerOptions s_jsonOptions = new() { WriteIndented = true };

    protected override void OnInitialized()
    {
        if (Provider != null)
        {
            Provider.Service.OnStep += HandleStep;
        }
    }

    private void HandleStep(SgLangGraphStep step) => _ = InvokeAsync(() =>
    {
        _currentState = step.State;
        _cachedJson = null;
        StateHasChanged();
    });

    private string JsonState => _cachedJson ??= _currentState != null
        ? System.Text.Json.JsonSerializer.Serialize(_currentState, s_jsonOptions)
        : "{}";

    public void Dispose()
    {
        if (Provider != null)
        {
            Provider.Service.OnStep -= HandleStep;
        }
    }
}
