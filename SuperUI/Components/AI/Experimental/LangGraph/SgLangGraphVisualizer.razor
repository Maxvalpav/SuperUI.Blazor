@namespace SuperUI.Components.AI.Experimental.LangGraph
@using SuperUI.Services.AI
@using SuperUI.Enums
@using System.Diagnostics.CodeAnalysis
@attribute [Experimental("SUPERUI_LANGGRAPH")]
@implements IDisposable

<div class="sgc-langgraph-visualizer">
    <SgDiagram Nodes="_nodes" Edges="_edges" Layout="SgDiagramLayoutType.Hierarchy">
        <NodeTemplate>
            @{
                var isCurrent = context.Id == _currentNode;
                var color = isCurrent ? "var(--sg-color-primary)" : "var(--sg-border)";
            }
            <div class="sgc-graph-node @(isCurrent ? "current" : "")" style="border-color:@color">
                <span class="sgc-graph-node-label">@context.Label</span>
                @if (isCurrent)
                {
                    <div class="sgc-graph-node-pulse"></div>
                }
            </div>
        </NodeTemplate>
    </SgDiagram>
</div>


@code {
    [CascadingParameter] public SgLangGraphProvider? Provider { get; set; }

    private List<SgDiagramNode> _nodes = new();
    private List<SgDiagramEdge> _edges = new();
    private string? _currentNode;

    protected override void OnInitialized()
    {
        if (Provider != null)
        {
            // Subscribe to the service's multicast events directly (fired on a
            // thread-pool thread); each handler marshals onto the renderer.
            Provider.Service.OnInitialized += HandleInitialized;
            Provider.Service.OnStep += HandleStep;

            if (Provider.IsInitialized && Provider.Schema != null)
            {
                BuildGraph(Provider.Schema);
            }
        }
    }

    private void HandleInitialized(SgLangGraphSchema schema) => _ = InvokeAsync(() =>
    {
        BuildGraph(schema);
        StateHasChanged();
    });

    private void BuildGraph(SgLangGraphSchema schema)
    {
        _nodes = schema.Nodes.Select(n => new SgDiagramNode {
            Id = n.Id,
            Label = n.Label,
            Width = 100,
            Height = 40
        }).ToList();

        _edges = schema.Edges.Select(e => new SgDiagramEdge {
            SourceId = e.SourceId,
            TargetId = e.TargetId,
            Label = e.Label
        }).ToList();
    }

    private void HandleStep(SgLangGraphStep step) => _ = InvokeAsync(() =>
    {
        _currentNode = step.Node;
        StateHasChanged();
    });

    public void Dispose()
    {
        if (Provider != null)
        {
            Provider.Service.OnInitialized -= HandleInitialized;
            Provider.Service.OnStep -= HandleStep;
        }
    }
}
