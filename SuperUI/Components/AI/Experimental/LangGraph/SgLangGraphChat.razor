@namespace SuperUI.Components.AI.Experimental.LangGraph
@using SuperUI.Services.AI
@using SuperUI.Enums
@using System.Diagnostics.CodeAnalysis
@attribute [Experimental("SUPERUI_LANGGRAPH")]
@inject ISuperUILocalizer Localizer
@implements IDisposable

<div class="sgc-graph-chat">
    <div class="sgc-graph-chat-messages" @ref="_messagesRef">
        @foreach (var msg in _messages)
        {
            <div class="sgc-chat-bubble-wrapper @(msg.IsUser ? "user" : "agent")">
                <SgChatBubble Text="@msg.Text" 
                             IsUser="@msg.IsUser" 
                             Time="@msg.Timestamp.ToString("HH:mm")" />
                @if (!msg.IsUser && !string.IsNullOrEmpty(msg.Node))
                {
                    <div class="sgc-node-badge">@msg.Node</div>
                }
            </div>
        }
        
        @if (_isThinking)
        {
            <div class="sgc-thinking-indicator">
                <SgSpinner Size="SgSize.Sm" />
                <span>@Localizer["LangGraph_Thinking"] <b>@_currentNode</b>...</span>
            </div>
        }
    </div>

    <div class="sgc-graph-chat-input">
        <SgStack Orientation="SgOrientation.Horizontal" Gap="8px">
            <SgTextBox @bind-Value="_input" 
                       Placeholder="@Localizer["LangGraph_InputPlaceholder"]" 
                       OnKeyUp="HandleKeyUp" 
                       Style="flex: 1;" />
            <SgButton Variant="SgButtonVariant.Primary" 
                      OnClick="SendAsync" 
                      Disabled="_isThinking">
                <span>@Localizer["LangGraph_Send"]</span>
            </SgButton>
        </SgStack>
    </div>
</div>

<style>
    .sgc-graph-chat { display: flex; flex-direction: column; height: 100%; min-height: 400px; border: 1px solid var(--sg-border); border-radius: 8px; overflow: hidden; }
    .sgc-graph-chat-messages { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; background: var(--sg-bg-subtle); }
    .sgc-graph-chat-input { padding: 12px; border-top: 1px solid var(--sg-border); background: var(--sg-bg); }
    .sgc-chat-bubble-wrapper { position: relative; max-width: 80%; }
    .sgc-chat-bubble-wrapper.user { align-self: flex-end; }
    .sgc-chat-bubble-wrapper.agent { align-self: flex-start; }
    .sgc-node-badge { 
        position: absolute; 
        bottom: -6px; 
        right: 4px; 
        background: var(--sg-color-primary); 
        color: white; 
        font-size: 9px; 
        padding: 1px 4px; 
        border-radius: 4px;
        opacity: 0.8;
    }
    .sgc-thinking-indicator { 
        display: flex; 
        align-items: center; 
        gap: 8px; 
        font-size: 12px; 
        color: var(--sg-fg-muted); 
        padding: 8px;
    }
</style>

@code {
    [CascadingParameter] public SgLangGraphProvider? Provider { get; set; }

    private string _input = "";
    private string? _currentNode;
    private bool _isThinking;
    private List<ChatMessage> _messages = new();
    private ElementReference _messagesRef;

    protected override void OnInitialized()
    {
        if (Provider != null)
        {
            // Subscribe to the service's multicast events directly. These fire on a
            // thread-pool thread (JS callbacks), so each handler marshals its full
            // body onto the renderer's sync context via InvokeAsync.
            Provider.Service.OnStep += HandleStep;
            Provider.Service.OnError += HandleError;
        }
    }

    private void HandleStep(SgLangGraphStep step) => _ = InvokeAsync(() =>
    {
        _currentNode = step.Node;
        _isThinking = true;

        if (!string.IsNullOrEmpty(step.Content))
        {
            var lastMsg = _messages.LastOrDefault();
            if (lastMsg != null && !lastMsg.IsUser && lastMsg.Node == step.Node)
            {
                lastMsg.Text = step.Content;
            }
            else
            {
                _messages.Add(new ChatMessage {
                    Text = step.Content,
                    IsUser = false,
                    Node = step.Node,
                    Timestamp = DateTime.Now
                });
            }
        }

        // If the step is "end" or similar, we might stop thinking
        if (step.Node == "__end__" || step.Node == "end")
        {
            _isThinking = false;
        }

        StateHasChanged();
    });

    private void HandleError(string error) => _ = InvokeAsync(() =>
    {
        _isThinking = false;
        _messages.Add(new ChatMessage {
            Text = $"Error: {error}",
            IsUser = false,
            Timestamp = DateTime.Now
        });
        StateHasChanged();
    });

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_input) || Provider == null) return;

        var text = _input;
        _input = "";
        _messages.Add(new ChatMessage { Text = text, IsUser = true, Timestamp = DateTime.Now });
        _isThinking = true;
        _currentNode = "start";
        
        await Provider.SendMessageAsync(text);
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        // Shift+Enter inserts a newline; ignore Enter during IME composition
        // (e.IsComposing) so CJK users don't submit a half-typed message.
        if (e.Key == "Enter" && !e.ShiftKey && !e.IsComposing) await SendAsync();
    }

    public void Dispose()
    {
        if (Provider != null)
        {
            Provider.Service.OnStep -= HandleStep;
            Provider.Service.OnError -= HandleError;
        }
    }

    private class ChatMessage
    {
        public string Text { get; set; } = "";
        public bool IsUser { get; set; }
        public string? Node { get; set; }
        public DateTime Timestamp { get; set; }
    }
}
