@namespace SuperUI.Components.AI.Experimental.LangGraph
@using SuperUI.Services.AI
@using SuperUI.Enums
@using System.Diagnostics.CodeAnalysis
@attribute [Experimental("SUPERUI_LANGGRAPH")]
@inject SgZIndexService ZIndexService
@inject ISuperUILocalizer Localizer
@implements IDisposable

@if (_currentInterrupt != null)
{
    <div class="sgc-interrupt-overlay" style="z-index:@_interruptZIndex">
        <SgCard Title="@Localizer["LangGraph_ApprovalRequired"]" Subtitle="@_currentInterrupt.Node">
            <div class="sgc-interrupt-body">
                <p>@Localizer["LangGraph_WantsToAct"]</p>
                <div class="sgc-interrupt-data">
                    <pre>@JsonData</pre>
                </div>
                <p class="sgc-interrupt-msg">@_currentInterrupt.Message</p>
            </div>
            <SgDivider />
            <SgStack Orientation="SgOrientation.Horizontal" Gap="12px" Justify="SgJustifyContent.End">
                <SgButton Text="@Localizer["LangGraph_Reject"]" Variant="SgButtonVariant.Danger" OnClick="RejectAsync" />
                <SgButton Text="@Localizer["LangGraph_Approve"]" Variant="SgButtonVariant.Primary" OnClick="ApproveAsync" />
            </SgStack>
        </SgCard>
    </div>
}


@code {
    [CascadingParameter] public SgLangGraphProvider? Provider { get; set; }

    private SgLangGraphInterrupt? _currentInterrupt;
    private int _interruptZIndex;

    protected override void OnInitialized()
    {
        if (Provider != null)
        {
            Provider.Service.OnInterrupt += HandleInterrupt;
        }
    }

    private void HandleInterrupt(SgLangGraphInterrupt interrupt) => _ = InvokeAsync(() =>
    {
        _currentInterrupt = interrupt;
        _interruptZIndex = ZIndexService.BringToFront(this, SgZIndexService.ModalOverlayBase);
        StateHasChanged();
    });

    private async Task ApproveAsync()
    {
        if (Provider != null && _currentInterrupt != null)
        {
            await Provider.RespondToInterruptAsync(new { approved = true });
            _currentInterrupt = null;
            ZIndexService.Release(this);
            StateHasChanged();
        }
    }

    private async Task RejectAsync()
    {
        if (Provider != null && _currentInterrupt != null)
        {
            await Provider.RespondToInterruptAsync(new { approved = false });
            _currentInterrupt = null;
            ZIndexService.Release(this);
            StateHasChanged();
        }
    }

    private static readonly System.Text.Json.JsonSerializerOptions s_jsonOptions = new() { WriteIndented = true };

    private string JsonData => _currentInterrupt?.Data != null
        ? System.Text.Json.JsonSerializer.Serialize(_currentInterrupt.Data, s_jsonOptions)
        : "No data";

    public void Dispose()
    {
        ZIndexService.Release(this);
        if (Provider != null)
        {
            Provider.Service.OnInterrupt -= HandleInterrupt;
        }
    }
}
