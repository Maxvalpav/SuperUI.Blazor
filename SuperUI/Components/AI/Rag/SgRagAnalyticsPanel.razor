@namespace SuperUI.Components
@inject ISuperUILocalizer Localizer

<div class="sg-rag-analytics-panel @CssClass">
    @if (_summary != null)
    {
        <div class="sg-rag-analytics-stats">
            <div class="sg-rag-analytics-stat">
                <span class="sg-rag-analytics-value">@_summary.TotalQueries</span>
                <span class="sg-rag-analytics-label">@Localizer["Rag_TotalQueries"]</span>
            </div>
            <div class="sg-rag-analytics-stat">
                <span class="sg-rag-analytics-value">@_summary.AverageLatencyMs.ToString("0.00") ms</span>
                <span class="sg-rag-analytics-label">@Localizer["Rag_AvgLatency"]</span>
            </div>
            <div class="sg-rag-analytics-stat">
                <span class="sg-rag-analytics-value">@(_summary.NoAnswerRate.ToString("0.00") + "%")</span>
                <span class="sg-rag-analytics-label">@Localizer["Rag_NoAnswerRate"]</span>
            </div>
            <div class="sg-rag-analytics-stat">
                <span class="sg-rag-analytics-value">@_summary.TotalHits</span>
                <span class="sg-rag-analytics-label">@Localizer["Rag_TotalHits"]</span>
            </div>
        </div>
        
        @if (_summary.RecentQueries.Count > 0)
        {
            <div class="sg-rag-analytics-recent">
                <h4>@Localizer["Rag_RecentQueries"]</h4>
                <ul class="sg-rag-analytics-query-list">
                    @foreach (var query in _summary.RecentQueries.Take(10))
                    {
                        <li class="sg-rag-analytics-query-item">
                            <span class="sg-rag-analytics-query-text">@query.Query</span>
                            <span class="sg-rag-analytics-query-meta">
                                @Localizer.GetString("Rag_Latency", query.LatencyMs) · @Localizer.GetString("Rag_Hits", query.HitCount) · @(query.HasAnswer ? "✓" : "✗")
                            </span>
                        </li>
                    }
                </ul>
            </div>
        }
    }
</div>

@code {
    /// <summary>Custom CSS class applied to the analytics panel container.</summary>
    [Parameter] public string? CssClass { get; set; }
    /// <summary>The RAG analytics summary data to display.</summary>
    [Parameter] public SgRagAnalyticsSummary? Summary { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private SgRagAnalyticsSummary? _summary => Summary;
}
