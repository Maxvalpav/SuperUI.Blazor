@namespace SuperUI.Components
@inject ISuperUILocalizer Localizer

<div class="sg-rag-search-panel @CssClass" @attributes="AdditionalAttributes">
    <div class="sg-rag-search-header">
        <div class="sg-rag-search-input-wrap">
            <input type="text" class="sg-rag-search-input" 
                   @bind="_query" @bind:event="oninput" 
                    @onkeydown="@(async e => { if(e.Key == "Enter") await SearchAsync(); })"
                   placeholder="@Localizer["Rag_SearchPlaceholder"]" />
            <button class="sg-rag-search-btn" @onclick="SearchAsync" disabled="@_searching">
                @if (_searching)
                {
                    <div class="sg-rag-spinner-sm"></div>
                }
                else
                {
                    <span>🔍 @Localizer["Rag_Search"]</span>
                }
            </button>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="sg-rag-alert sg-rag-alert-error" role="alert">@_error</div>
    }

    @if (_results is not null)
    {
        @if (_results.Count == 0)
        {
            <div class="sg-rag-no-results">@Localizer["Rag_NoResults"]</div>
        }
        else
        {
            <div class="sg-rag-results" role="list">
                @foreach (var hit in _results)
                {
                    <div class="sg-rag-result-item" role="listitem">
                        <div class="sg-rag-result-header">
                            <span class="sg-rag-result-title">@hit.Document.Title</span>
                            <span class="sg-rag-badge sg-rag-badge-neutral">@Localizer.GetString("Rag_ChunkNum", hit.Chunk.Index)</span>
                            @if (hit.Chunk.Metadata.TryGetValue("language", out var lang))
                            {
                                <span class="sg-rag-badge sg-rag-badge-neutral" style="color:var(--sg-color-primary,#006fee)">@lang</span>
                            }
                            @if (hit.Chunk.Metadata.TryGetValue("startLine", out var sl) &&
                                 hit.Chunk.Metadata.TryGetValue("endLine",   out var el))
                            {
                                <span class="sg-rag-badge sg-rag-badge-neutral" style="font-size:10px">L@sl–@el</span>
                            }
                            <span class="sg-rag-result-score">@hit.Score.ToString("P0")</span>
                        </div>
                        <div class="sg-rag-result-text">
                            @if (hit.Chunk.Metadata.ContainsKey("language"))
                            {
                                @* Code chunk — render in pre/code block *@
                                <pre class="sg-rag-result-code"><code>@hit.Chunk.Text</code></pre>
                            }
                            else if (HighlightMatches && hit.HighlightSpans.Count > 0)
                            {
                                @((MarkupString)BuildHighlightedHtml(hit.Chunk.Text, hit.HighlightSpans))
                            }
                            else
                            {
                                @hit.Chunk.Text
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [CascadingParameter] private SgRagContext? _ctx { get; set; }
    private SgRagService? _ragService => _ctx?.Service;

    // ── Parameters ────────────────────────────────────────────────────────────

    /// <summary>Gets or sets the collection to search.</summary>
    [Parameter] public string Collection      { get; set; } = "default";
    /// <summary>Number of top search results.</summary>
    [Parameter] public int    TopK            { get; set; } = 10;
    /// <summary>Whether to highlight matching text.</summary>
    [Parameter] public bool   HighlightMatches{ get; set; } = true;
    /// <summary>Callback invoked when search results are ready.</summary>
    [Parameter] public EventCallback<IReadOnlyList<SgRagSearchHit>> OnResults { get; set; }
    /// <summary>Custom CSS class applied to the search panel container.</summary>
    [Parameter] public string? CssClass       { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // ── State ─────────────────────────────────────────────────────────────────

    private string  _query    = string.Empty;
    private bool    _searching;
    private string? _error;
    private IReadOnlyList<SgRagSearchHit>? _results;

    private async Task SearchAsync()
    {
        if (_ragService is null || string.IsNullOrWhiteSpace(_query)) return;
        _searching = true;
        _error = null;
        StateHasChanged();
        try
        {
            _results = await _ragService.SearchAsync(_query, Collection, TopK);
            if (OnResults.HasDelegate) await OnResults.InvokeAsync(_results);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _searching = false; StateHasChanged(); }
    }

    private static string BuildHighlightedHtml(string text, IReadOnlyList<(int Start, int End)> spans)
    {
        if (spans.Count == 0) return System.Web.HttpUtility.HtmlEncode(text);
        var sb = new System.Text.StringBuilder();
        int pos = 0;
        foreach (var (start, end) in spans.OrderBy(s => s.Start))
        {
            if (start > pos)
                sb.Append(System.Web.HttpUtility.HtmlEncode(text.Substring(pos, start - pos)));
            sb.Append("<mark class=\"sg-rag-highlight\">");
            sb.Append(System.Web.HttpUtility.HtmlEncode(text.Substring(start, end - start)));
            sb.Append("</mark>");
            pos = end;
        }
        if (pos < text.Length)
            sb.Append(System.Web.HttpUtility.HtmlEncode(text.Substring(pos)));
        return sb.ToString();
    }
}
