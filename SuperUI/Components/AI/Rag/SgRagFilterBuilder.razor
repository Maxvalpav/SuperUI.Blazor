@namespace SuperUI.Components

@if (ShowBuilder)
{
    <div class="sg-rag-filter-builder @CssClass" @attributes="AdditionalAttributes">
        <SgFilterBuilder @ref="_filterBuilderRef" />
    </div>
}

@code {
    /// <summary>Custom CSS class applied to the filter builder container.</summary>
    [Parameter] public string? CssClass { get; set; }
    /// <summary>Whether to show the filter builder.</summary>
    [Parameter] public bool ShowBuilder { get; set; }
    /// <summary>Callback invoked when filters change.</summary>
    [Parameter] public EventCallback OnFiltersChanged { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private SgFilterBuilder? _filterBuilderRef;

    public SgFilterBuilder? FilterBuilder => _filterBuilderRef;
}
