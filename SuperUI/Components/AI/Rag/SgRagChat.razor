@namespace SuperUI.Components
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ISuperUILocalizer Localizer

<div class="sg-rag-chat @CssClass" @attributes="AdditionalAttributes">

    @* Mode switcher bar *@
    <div class="sg-rag-chat-modebar">
        <div class="sg-rag-chat-mode-group" role="group" aria-label="Chat mode">
            <button type="button"
                    class="sg-rag-mode-btn @(_activeMode != SgRagAnswerMode.Direct ? "active" : "")"
                    @onclick="@(() => SetMode(Mode == SgRagAnswerMode.Direct ? SgRagAnswerMode.Strict : Mode))"
                    disabled="@_streaming">
                <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                    <path fill="currentColor" d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3Zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3Zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3Zm8 0A1.5 1.5 0 0 1 10.5 9h3A1.5 1.5 0 0 1 15 10.5v3A1.5 1.5 0 0 1 13.5 15h-3A1.5 1.5 0 0 1 9 13.5v-3Z"/>
                </svg>
                @Localizer["Rag_ModeRag"]
            </button>
            <button type="button"
                    class="sg-rag-mode-btn @(_activeMode == SgRagAnswerMode.Direct ? "active" : "")"
                    @onclick="@(() => SetMode(SgRagAnswerMode.Direct))"
                    disabled="@_streaming">
                <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                    <path fill="currentColor" d="M2.678 11.894a1 1 0 0 1 .287.801 11 11 0 0 1-.398 2c1.395-.323 2.247-.697 2.634-.893a1 1 0 0 1 .71-.074A8 8 0 0 0 8 14c3.996 0 7-2.807 7-6s-3.004-6-7-6-7 2.808-7 6c0 1.468.617 2.83 1.678 3.894m-.493 3.905a22 22 0 0 1-.713.129c-.2.032-.352-.176-.273-.362a10 10 0 0 0 .244-.637l.003-.01c.248-.72.45-1.548.524-2.319C.743 11.37 0 9.76 0 8c0-3.866 3.582-7 8-7s8 3.134 8 7-3.582 7-8 7a9 9 0 0 1-2.347-.306c-.52.263-1.639.742-3.468 1.105"/>
                </svg>
                @Localizer["Rag_ModeDirect"]
            </button>
        </div>

        @* RAG sub-mode selector (only in RAG mode) *@
        @if (_activeMode != SgRagAnswerMode.Direct)
        {
            <select class="sg-rag-mode-select" @bind="_activeMode" disabled="@_streaming">
                <option value="@SgRagAnswerMode.Strict">@Localizer["Rag_Strict"]</option>
                <option value="@SgRagAnswerMode.Hybrid">@Localizer["Rag_Hybrid"]</option>
                <option value="@SgRagAnswerMode.FreeForm">@Localizer["Rag_FreeForm"]</option>
            </select>
        }

        @* Clear history button (Direct mode) *@
        @if (_activeMode == SgRagAnswerMode.Direct && _messages.Count > 0)
        {
            <button type="button" class="sg-rag-mode-clear" @onclick="ClearHistoryAsync"
                    title="@Localizer["Rag_ClearHistory"]" disabled="@_streaming">
                <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                    <path fill="currentColor" d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                    <path fill="currentColor" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                </svg>
                @Localizer["Rag_ClearHistory"]
            </button>
        }

        @* Mode badge *@
        <span class="sg-rag-mode-badge @(_activeMode == SgRagAnswerMode.Direct ? "direct" : "rag")">
            @if (_activeMode == SgRagAnswerMode.Direct)
            {
                <span>💬 @Localizer["Rag_ModeDirect"]</span>
            }
            else
            {
                <span>🔍 @Localizer["Rag_ModeRag"] · @Localizer[$"Rag_{_activeMode}"]</span>
            }
        </span>

        @* Export button — only when there are messages *@
        @if (_messages.Count > 0 && !_streaming)
        {
            <div class="sg-rag-export-wrap">
                <button type="button" class="sg-rag-export-btn"
                        @onclick="ToggleExportMenu"
                        title="@Localizer["Rag_Export"]">
                    <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                        <path fill="currentColor" d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5"/>
                        <path fill="currentColor" d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708z"/>
                    </svg>
                    @Localizer["Rag_Export"]
                </button>
                @if (_showExportMenu)
                {
                    <div class="sg-rag-export-menu" @onclick:stopPropagation="true">
                        <button type="button" @onclick="@(() => ExportAsync("md"))">
                            📄 @Localizer["Rag_Export_Markdown"]
                        </button>
                        <button type="button" @onclick="@(() => ExportAsync("html"))">
                            🌐 @Localizer["Rag_Export_Html"]
                        </button>
                        <button type="button" @onclick="@(() => ExportAsync("txt"))">
                            📝 @Localizer["Rag_Export_Text"]
                        </button>
                    </div>
                }
            </div>
        }
    </div>

    @* Messages *@
    @if (_messages.Count == 0)
    {
        <div class="sg-rag-chat-empty">
            @if (_activeMode == SgRagAnswerMode.Direct)
            {
                <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.4" aria-hidden="true">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                <p>@Localizer["Rag_DirectHint"]</p>
            }
            else
            {
                <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.4" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
                </svg>
                <p>@Localizer["Rag_ChatHint"]</p>
            }
        </div>
    }
    else
    {
        <div class="sg-rag-messages" @ref="_messagesRef">
            @foreach (var msg in _messages)
            {
                <div class="sg-rag-msg @(msg.IsUser ? "sg-rag-msg-user" : "sg-rag-msg-bot") @(msg == _streamingMsg ? "sg-rag-msg-streaming" : "")">

                    @if (!msg.IsUser && msg == _streamingMsg && string.IsNullOrEmpty(msg.Content))
                    {
                        <div class="sg-rag-msg-bubble sg-rag-thinking" aria-label="@Localizer["Rag_Thinking"]" aria-live="polite">
                            <span class="sg-rag-dot"></span>
                            <span class="sg-rag-dot"></span>
                            <span class="sg-rag-dot"></span>
                        </div>
                    }
                    else if (msg.IsUser)
                    {
                        <div class="sg-rag-msg-bubble">@msg.Content</div>
                    }
                    else
                    {
                        @* Bot messages rendered as Markdown *@
                        <div class="sg-rag-msg-bubble sg-rag-md @(msg == _streamingMsg ? "sg-rag-md-streaming" : "")">
                            @((MarkupString)GetHtml(msg))
                        </div>
                    }

                    @if (!msg.IsUser && ShowSources && msg.Sources?.Count > 0)
                    {
                        <div class="sg-rag-sources">
                            @foreach (var (hit, i) in msg.Sources.Select((h, i) => (h, i)))
                            {
                                <span class="sg-rag-source-chip" title="@hit.Chunk.Text.Substring(0, Math.Min(hit.Chunk.Text.Length, 120))">
                                    [#@(i + 1)] @hit.Document.Title
                                </span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (_error is not null)
    {
        <div class="sg-rag-alert sg-rag-alert-error" style="margin:0 12px 8px" role="alert">@_error</div>
    }

    @* Streaming progress bar *@
    @if (_streaming)
    {
        <div class="sg-rag-stream-bar" role="status" aria-live="polite">
            <div class="sg-rag-stream-fill"></div>
            <span class="sg-rag-stream-label">
                @if (_tokenCount > 0)
                {
                    <span>@_tokenCount tokens</span>
                    <span class="sg-rag-stream-sep">·</span>
                }
                <span class="sg-rag-stream-pulse">@Localizer["Rag_Generating"]</span>
            </span>
        </div>
    }

    @* Input *@
    <div class="sg-rag-chat-footer">

        @* Attached files preview *@
        @if (_attachments.Count > 0)
        {
            <div class="sg-rag-attachments">
                @foreach (var att in _attachments)
                {
                    <div class="sg-rag-att-chip">
                        @if (att.IsImage)
                        {
                            <img src="@att.DataUrl" class="sg-rag-att-thumb" alt="@att.Name" />
                        }
                        else
                        {
                            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                                <path fill="currentColor" d="M4 0h5.293A1 1 0 0 1 10 .293L13.707 4a1 1 0 0 1 .293.707V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2m5.5 1.5v2a1 1 0 0 0 1 1h2z"/>
                            </svg>
                        }
                        <span class="sg-rag-att-name" title="@att.Name">@att.Name</span>
                        <button type="button" class="sg-rag-att-remove"
                                @onclick="@(() => RemoveAttachment(att))"
                                aria-label="Remove @att.Name">✕</button>
                    </div>
                }
            </div>
        }

        <div class="sg-rag-chat-input-row">
            @* Attach button *@
            <label class="sg-rag-attach-btn" title="@Localizer["Rag_AttachFile"]"
                   aria-label="@Localizer["Rag_AttachFile"]">
                <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                    <path fill="currentColor" d="M4.5 3a2.5 2.5 0 0 1 5 0v9a1.5 1.5 0 0 1-3 0V5a.5.5 0 0 1 1 0v7a.5.5 0 0 0 1 0V3a1.5 1.5 0 1 0-3 0v9a2.5 2.5 0 0 0 5 0V5a.5.5 0 0 1 1 0v7a3.5 3.5 0 1 1-7 0z"/>
                </svg>
                <InputFile OnChange="OnFilesAttached"
                           accept="image/*,.pdf,.txt,.md,.docx,.csv,.json"
                           multiple="true"
                           style="display:none" />
            </label>

            <textarea class="sg-rag-chat-textarea @(_streaming ? "sg-rag-textarea-busy" : "")"
                      rows="1"
                      placeholder="@(_streaming ? Localizer["Rag_Generating"] + "..." : (_activeMode == SgRagAnswerMode.Direct ? Localizer["Rag_DirectPlaceholder"] : Localizer["Rag_AskPlaceholder"]))"
                      @bind="_input"
                      @bind:event="oninput"
                      @onkeydown="OnKeyDown"
                      disabled="@_streaming"
                      aria-label="Ask a question"></textarea>

            @if (_streaming)
            {
                <button type="button" class="sg-rag-chat-stop" @onclick="StopStreaming"
                        title="@Localizer["Rag_Stop"]" aria-label="@Localizer["Rag_Stop"]">
                    <span class="sg-rag-stop-ring" aria-hidden="true"></span>
                    <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" style="position:relative;z-index:1">
                        <rect x="3" y="3" width="10" height="10" fill="currentColor" rx="1"/>
                    </svg>
                </button>
            }
            else
            {
                <button type="button" class="sg-rag-chat-send"
                        disabled="@(string.IsNullOrWhiteSpace(_input) && _attachments.Count == 0)"
                        @onclick="SendAsync"
                        title="@Localizer["Rag_Send"]" aria-label="@Localizer["Rag_Send"]">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path fill="currentColor" d="M1.724 1.053a.5.5 0 0 0-.714.545l1.403 4.85a.5.5 0 0 0 .397.354l5.69.953c.268.053.268.437 0 .49l-5.69.953a.5.5 0 0 0-.397.354l-1.403 4.85a.5.5 0 0 0 .714.545l13-6.5a.5.5 0 0 0 0-.894l-13-6.5Z"/>
                    </svg>
                </button>
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter(Name = "RagService")] private SgRagService? _ragService { get; set; }

    // ── Parameters ────────────────────────────────────────────────────────────

    /// <summary>Gets or sets the collection name to search.</summary>
    [Parameter] public string          Collection     { get; set; } = "default";
    /// <summary>Number of top results to retrieve.</summary>
    [Parameter] public int             TopK           { get; set; } = 5;
    /// <summary>System prompt for the chat.</summary>
    [Parameter] public string          SystemPrompt   { get; set; } = string.Empty;
    /// <summary>RAG chat mode.</summary>
    [Parameter] public SgRagAnswerMode Mode           { get; set; } = SgRagAnswerMode.Strict;
    /// <summary>Whether to show source references.</summary>
    [Parameter] public bool            ShowSources    { get; set; } = true;
    /// <summary>Whether to enable streaming responses.</summary>
    [Parameter] public bool            EnableStreaming { get; set; } = true;
    /// <summary>Callback invoked when an answer is generated.</summary>
    [Parameter] public EventCallback<SgRagAnswer> OnAnswer { get; set; }
    /// <summary>Custom CSS class applied to the chat container.</summary>
    [Parameter] public string?         CssClass       { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // ── State ─────────────────────────────────────────────────────────────────

    private readonly List<SgRagChatMessage> _messages = new();
    private string          _input       = string.Empty;
    private bool            _streaming;
    private int             _tokenCount;
    private string?         _error;
    private SgRagChatMessage? _streamingMsg;
    private CancellationTokenSource? _streamCts;
    private ElementReference _messagesRef;

    // Active mode — starts from the Mode parameter, can be toggled at runtime
    private SgRagAnswerMode _activeMode;

    // ── Markdown rendering ────────────────────────────────────────────────────

    private IJSObjectReference? _ragModule;
    private readonly Dictionary<string, string> _htmlCache = new();
    private int _renderCounter;
    private const int RenderEvery = 6;

    private string GetHtml(SgRagChatMessage msg)
    {
        if (_htmlCache.TryGetValue(msg.Id, out var cached)) return cached;
        return System.Web.HttpUtility.HtmlEncode(msg.Content).Replace("\n", "<br>");
    }

    private async Task EnsureModuleAsync()
    {
        if (_ragModule is not null) return;
        try { _ragModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/sg-rag.js"); }
        catch { }
    }

    private async Task RenderMarkdownAsync(SgRagChatMessage msg)
    {
        if (string.IsNullOrEmpty(msg.Content)) return;
        await EnsureModuleAsync();
        try
        {
            var html = await _ragModule!.InvokeAsync<string>("renderMarkdown",
                msg.Content,
                "https://cdn.jsdelivr.net/npm/marked@12.0.0/marked.min.js");
            _htmlCache[msg.Id] = html;
        }
        catch
        {
            _htmlCache[msg.Id] = System.Web.HttpUtility.HtmlEncode(msg.Content)
                .Replace("\n", "<br>");
        }
    }

    // ── Attachments ───────────────────────────────────────────────────────────

    private sealed class AttachmentItem
    {
        public string Name    { get; set; } = string.Empty;
        public string MimeType{ get; set; } = string.Empty;
        public string Base64  { get; set; } = string.Empty;
        public string DataUrl { get; set; } = string.Empty;
        public bool   IsImage { get; set; }
        public bool   IsPdf   { get; set; }
    }

    private readonly List<AttachmentItem> _attachments = new();

    private async Task OnFilesAttached(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(10))
        {
            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                var bytes  = ms.ToArray();
                var b64    = Convert.ToBase64String(bytes);
                var mime   = file.ContentType.Contains('/') ? file.ContentType : "application/octet-stream";
                var isImg  = mime.StartsWith("image/");
                var isPdf  = mime == "application/pdf" || file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);

                _attachments.Add(new AttachmentItem
                {
                    Name     = file.Name,
                    MimeType = mime,
                    Base64   = b64,
                    DataUrl  = $"data:{mime};base64,{b64}",
                    IsImage  = isImg,
                    IsPdf    = isPdf,
                });
            }
            catch (Exception ex)
            {
                _error = $"Failed to read {file.Name}: {ex.Message}";
            }
        }
        StateHasChanged();
    }

    private void RemoveAttachment(AttachmentItem att)
    {
        _attachments.Remove(att);
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        // Sync _activeMode from parameter only on first render
        if (_messages.Count == 0)
            _activeMode = Mode;
    }

    // ── Mode switching ────────────────────────────────────────────────────────

    private void SetMode(SgRagAnswerMode mode)
    {
        _activeMode = mode;
        _error = null;
        StateHasChanged();
    }

    private async Task ClearHistoryAsync()
    {
        if (_ragService is null) return;
        _messages.Clear();
        _htmlCache.Clear();
        _renderCounter = 0;
        await _ragService.ClearDirectHistoryAsync();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try { _streamCts?.Cancel(); } catch { }
        _streamCts?.Dispose();
        _streamCts = null;

        if (_ragModule is not null)
        {
            try { await _ragModule.DisposeAsync(); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
            catch (TaskCanceledException) { }
            catch (ObjectDisposedException) { }
            _ragModule = null;
        }
    }

    // ── Input ─────────────────────────────────────────────────────────────────

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendAsync();
    }

    private async Task SendAsync()
    {
        if (_ragService is null || (string.IsNullOrWhiteSpace(_input) && _attachments.Count == 0) || _streaming) return;

        var question = _input.Trim();
        _input      = string.Empty;
        _error      = null;
        _tokenCount = 0;

        // Snapshot and clear attachments before async work
        var attachmentSnapshot = _attachments.ToList();
        _attachments.Clear();

        // Build display content for user bubble
        var displayContent = question.Length > 0 ? question : $"[{attachmentSnapshot.Count} file(s)]";
        _messages.Add(new SgRagChatMessage { IsUser = true, Content = displayContent });

        var botMsg = new SgRagChatMessage { IsUser = false, Content = string.Empty };
        _messages.Add(botMsg);
        _streamingMsg = botMsg;
        _streaming    = true;
        StateHasChanged();
        await ScrollToBottomAsync();

        _streamCts = new CancellationTokenSource();

        try
        {
            // Build multimodal attachments payload for JS
            var jsAttachments = attachmentSnapshot.Select(a => new
            {
                name     = a.Name,
                mimeType = a.MimeType,
                base64   = a.Base64,
                isImage  = a.IsImage,
                isPdf    = a.IsPdf,
            }).ToList();

            if (_activeMode == SgRagAnswerMode.Direct)
            {
                var sb = new System.Text.StringBuilder();
                await foreach (var token in _ragService.ChatDirectStreamAsync(
                    question,
                    string.IsNullOrWhiteSpace(SystemPrompt) ? null : SystemPrompt,
                    jsAttachments.Count > 0 ? jsAttachments : null,
                    _streamCts.Token))
                {
                    sb.Append(token);
                    botMsg.Content = sb.ToString();
                    _tokenCount    = sb.Length / 4;
                    _renderCounter++;
                    if (_renderCounter % RenderEvery == 0)
                        await RenderMarkdownAsync(botMsg);
                    await InvokeAsync(StateHasChanged);
                    await ScrollToBottomAsync();
                }
                await RenderMarkdownAsync(botMsg);
            }
            else if (EnableStreaming)
            {
                var sb = new System.Text.StringBuilder();
                await foreach (var token in _ragService.AskStreamAsync(
                    question, Collection, TopK, SystemPrompt, _activeMode, _streamCts.Token))
                {
                    sb.Append(token);
                    botMsg.Content = sb.ToString();
                    _tokenCount    = sb.Length / 4;
                    _renderCounter++;
                    if (_renderCounter % RenderEvery == 0)
                        await RenderMarkdownAsync(botMsg);
                    await InvokeAsync(StateHasChanged);
                    await ScrollToBottomAsync();
                }
                await RenderMarkdownAsync(botMsg);
            }
            else
            {
                var answer = await _ragService.AskAsync(
                    question, Collection, TopK, SystemPrompt, _activeMode, _streamCts.Token);
                botMsg.Content = answer.Answer;
                botMsg.Sources = answer.Sources;
                _messages[^1]  = botMsg;
                _tokenCount    = answer.CompletionTokens;
                await RenderMarkdownAsync(botMsg);
                if (OnAnswer.HasDelegate) await OnAnswer.InvokeAsync(answer);
            }
        }
        catch (OperationCanceledException) { botMsg.Content += " [stopped]"; }
        catch (Exception ex)
        {
            _error = ex.Message;
            _messages.Remove(botMsg);
        }
        finally
        {
            _streaming    = false;
            _streamingMsg = null;
            _streamCts?.Dispose();
            _streamCts = null;
            await InvokeAsync(StateHasChanged);
            await ScrollToBottomAsync();
        }
    }

    private void StopStreaming() => _streamCts?.Cancel();

    // ── Export ────────────────────────────────────────────────────────────────

    private bool _showExportMenu;

    private void ToggleExportMenu()
    {
        _showExportMenu = !_showExportMenu;
        StateHasChanged();
    }

    private async Task ExportAsync(string format)
    {
        _showExportMenu = false;
        StateHasChanged();

        var ts   = DateTime.Now.ToString("yyyy-MM-dd_HH-mm");
        var mode = _activeMode == SgRagAnswerMode.Direct ? "direct" : "rag";

        string content;
        string mime;
        string ext;

        switch (format)
        {
            case "html":
                content = BuildHtmlExport();
                mime    = "text/html";
                ext     = "html";
                break;
            case "txt":
                content = BuildTxtExport();
                mime    = "text/plain";
                ext     = "txt";
                break;
            default: // md
                content = BuildMarkdownExport();
                mime    = "text/markdown";
                ext     = "md";
                break;
        }

        var fileName = $"chat-{mode}-{ts}.{ext}";
        var bytes    = System.Text.Encoding.UTF8.GetBytes(content);
        var b64      = Convert.ToBase64String(bytes);

        try
        {
            await EnsureModuleAsync();
            if (_ragModule is not null)
                await _ragModule.InvokeVoidAsync("downloadBlob", fileName, mime, b64);
        }
        catch { }
    }

    private string BuildMarkdownExport()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"# Chat Export — {DateTime.Now:yyyy-MM-dd HH:mm}");
        sb.AppendLine($"> Mode: {_activeMode}");
        sb.AppendLine();

        foreach (var msg in _messages)
        {
            if (msg.IsUser)
            {
                sb.AppendLine($"**You:** {msg.Content}");
            }
            else
            {
                sb.AppendLine($"**Assistant:**");
                sb.AppendLine();
                sb.AppendLine(msg.Content);
                if (msg.Sources?.Count > 0)
                {
                    sb.AppendLine();
                    sb.AppendLine("*Sources:*");
                    foreach (var (hit, i) in msg.Sources.Select((h, i) => (h, i)))
                        sb.AppendLine($"- [{i + 1}] {hit.Document.Title} (score: {hit.Score:P0})");
                }
            }
            sb.AppendLine();
            sb.AppendLine("---");
            sb.AppendLine();
        }
        return sb.ToString();
    }

    private string BuildHtmlExport()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("<!DOCTYPE html>");
        sb.AppendLine("<html lang=\"en\"><head><meta charset=\"UTF-8\">");
        sb.AppendLine($"<title>Chat Export — {DateTime.Now:yyyy-MM-dd HH:mm}</title>");
        sb.AppendLine("<style>");
        sb.AppendLine("body{font-family:system-ui,sans-serif;max-width:800px;margin:40px auto;padding:0 20px;background:#f9fafb;color:#111827}");
        sb.AppendLine("h1{font-size:1.4em;color:#374151}.meta{color:#6b7280;font-size:.85em;margin-bottom:24px}");
        sb.AppendLine(".msg{margin:16px 0;padding:12px 16px;border-radius:10px;line-height:1.6}");
        sb.AppendLine(".user{background:#006fee;color:#fff;margin-left:20%}.bot{background:#fff;border:1px solid #e5e7eb;margin-right:20%}");
        sb.AppendLine(".label{font-size:.75em;font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px;opacity:.7}");
        sb.AppendLine(".sources{margin-top:8px;font-size:.8em;color:#6b7280}");
        sb.AppendLine("pre{background:#1e1e2e;color:#cdd6f4;padding:12px;border-radius:6px;overflow-x:auto;font-size:.85em}");
        sb.AppendLine("hr{border:none;border-top:1px solid #e5e7eb;margin:8px 0}");
        sb.AppendLine("</style></head><body>");
        sb.AppendLine($"<h1>💬 Chat Export</h1>");
        sb.AppendLine($"<div class=\"meta\">{DateTime.Now:yyyy-MM-dd HH:mm} · Mode: {_activeMode} · {_messages.Count} messages</div>");

        foreach (var msg in _messages)
        {
            if (msg.IsUser)
            {
                sb.AppendLine("<div class=\"msg user\">");
                sb.AppendLine("<div class=\"label\">You</div>");
                sb.AppendLine(System.Web.HttpUtility.HtmlEncode(msg.Content).Replace("\n", "<br>"));
                sb.AppendLine("</div>");
            }
            else
            {
                sb.AppendLine("<div class=\"msg bot\">");
                sb.AppendLine("<div class=\"label\">Assistant</div>");
                // Use cached HTML if available, otherwise escape
                if (_htmlCache.TryGetValue(msg.Id, out var html))
                    sb.AppendLine(html);
                else
                    sb.AppendLine(System.Web.HttpUtility.HtmlEncode(msg.Content).Replace("\n", "<br>"));

                if (msg.Sources?.Count > 0)
                {
                    sb.AppendLine("<div class=\"sources\"><strong>Sources:</strong><br>");
                    foreach (var (hit, i) in msg.Sources.Select((h, i) => (h, i)))
                        sb.AppendLine($"[{i + 1}] {System.Web.HttpUtility.HtmlEncode(hit.Document.Title)} — {hit.Score:P0}<br>");
                    sb.AppendLine("</div>");
                }
                sb.AppendLine("</div>");
            }
        }

        sb.AppendLine("</body></html>");
        return sb.ToString();
    }

    private string BuildTxtExport()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Chat Export — {DateTime.Now:yyyy-MM-dd HH:mm}");
        sb.AppendLine($"Mode: {_activeMode}");
        sb.AppendLine(new string('=', 50));
        sb.AppendLine();

        foreach (var msg in _messages)
        {
            sb.AppendLine(msg.IsUser ? "YOU:" : "ASSISTANT:");
            sb.AppendLine(msg.Content);
            if (!msg.IsUser && msg.Sources?.Count > 0)
            {
                sb.AppendLine("Sources: " + string.Join(", ",
                    msg.Sources.Select((h, i) => $"[{i + 1}] {h.Document.Title}")));
            }
            sb.AppendLine();
            sb.AppendLine(new string('-', 40));
            sb.AppendLine();
        }
        return sb.ToString();
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await EnsureModuleAsync();
            if (_ragModule is not null)
                await _ragModule.InvokeVoidAsync("scrollToBottom", ".sg-rag-messages");
        }
        catch { }
    }
}
