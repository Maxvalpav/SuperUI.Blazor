@namespace SuperUI.Components

<div class="sgc-typing-indicator @CssClass" style="@Style">
    @if (!string.IsNullOrEmpty(AvatarUrl))
    {
        <img class="sgc-typing-avatar" src="@AvatarUrl" alt="@UserName" />
    }
    else if (ShowAvatar)
    {
        <div class="sgc-typing-avatar sgc-typing-avatar-placeholder" style="background:@AvatarColor;">
            @AvatarInitial
        </div>
    }

    <div class="sgc-typing-bubble">
        @if (!string.IsNullOrEmpty(UserName))
        {
            <div class="sgc-typing-name">@UserName</div>
        }
        <div class="sgc-typing-dots">
            <SgSpinner Type="SgSpinnerType.Typing" Size="SgSize.Sm" Color="@DotColor" />
        </div>
    </div>
</div>

@code {
    [Parameter] public string? UserName { get; set; }
    /// <summary>URL for the typing avatar.</summary>
    [Parameter] public string? AvatarUrl { get; set; }
    /// <summary>Whether to show the avatar.</summary>
    [Parameter] public bool ShowAvatar { get; set; } = true;
    /// <summary>Background color of the avatar.</summary>
    [Parameter] public string AvatarColor { get; set; } = "var(--sg-color-primary, #006fee)";
    /// <summary>Color of the typing dots.</summary>
    [Parameter] public string DotColor { get; set; } = "var(--sg-color-primary, #006fee)";
    /// <summary>Custom CSS class applied to the typing indicator container.</summary>
    [Parameter] public string? CssClass { get; set; }
    /// <summary>Custom inline styles applied to the typing indicator container.</summary>
    [Parameter] public string? Style { get; set; }

    private string AvatarInitial => string.IsNullOrEmpty(UserName) ? "?" : UserName[..1].ToUpper();
}
