@namespace SuperUI.Components
@inject IJSRuntime JS

<div class="sgc-code @(_expanded ? "sgc-code-fullscreen" : "") @(Wrap ? "sgc-code-wrap" : "") @CssClass"
     style="@Style"
     @attributes="AdditionalAttributes">

    @{ var hasHeader = HasHeader(); }
    @if (hasHeader)
    {
        <div class="sgc-code-header @(string.IsNullOrEmpty(Title) && string.IsNullOrEmpty(Filename) ? "sgc-code-header-slim" : "")">
            @if (!string.IsNullOrEmpty(Filename))
            {
                <span class="sgc-code-file" title="@Filename">
                    <span class="sgc-code-file-ico" aria-hidden="true">@((MarkupString)IconFile)</span>
                    <span class="sgc-code-file-name">@Filename</span>
                </span>
            }
            else if (!string.IsNullOrEmpty(Title))
            {
                <span class="sgc-code-title">@Title</span>
            }

            <div class="sgc-code-actions">
                @if (ShowLanguage && Language != SgCodeLanguage.Text)
                {
                    <span class="sgc-code-lang">@LanguageLabel</span>
                }
                @if (ShowWrap)
                {
                    <button type="button"
                            class="sgc-code-iconbtn @(Wrap ? "sgc-active" : "")"
                            @onclick="ToggleWrap"
                            title="@(Wrap ? "Unwrap" : "Wrap")"
                            aria-pressed="@(Wrap ? "true" : "false")">
                        @((MarkupString)IconWrap)
                    </button>
                }
                @if (ShowExpand)
                {
                    <button type="button"
                            class="sgc-code-iconbtn"
                            @onclick="ToggleExpand"
                            title="@(_expanded ? "Collapse" : "Expand")"
                            aria-pressed="@(_expanded ? "true" : "false")">
                        @((MarkupString)(_expanded ? IconCollapse : IconExpand))
                    </button>
                }
                @if (ShowCopy)
                {
                    <button type="button"
                            class="sgc-code-copy @(_copied ? "sgc-code-copy-done" : "")"
                            @onclick="CopyAsync"
                            title="Copy to clipboard">
                        @if (_copied)
                        {
                            <span class="sgc-code-copy-ico">@((MarkupString)SgIcons.Check)</span>
                            <span>Copied</span>
                        }
                        else
                        {
                            <span class="sgc-code-copy-ico">@((MarkupString)SgIcons.Copy)</span>
                            <span>Copy</span>
                        }
                    </button>
                }
            </div>
        </div>
    }

    <div class="sgc-code-body @(_effectiveMaxHeight.HasValue ? "sgc-code-scroll" : "")"
         style="@(_effectiveMaxHeight.HasValue ? $"max-height:{_effectiveMaxHeight}px;" : "")">
        @if (ShowLineNumbers)
        {
            <div class="sgc-code-lines" aria-hidden="true">
                @for (int i = 1; i <= _lineCount; i++)
                {
                    <span class="sgc-code-line-num">@i</span>
                }
            </div>
        }
        <pre class="sgc-code-pre"><code class="sgc-code-content sgc-lang-@LanguageClass">@((MarkupString)_renderedHtml)</code></pre>
    </div>
</div>

@code {
    private bool _copied;
    private bool _expanded;
    private string _displayCode = "";
    private string _renderedHtml = "";
    private int _lineCount;
    private CancellationTokenSource? _copyCts;
    private int? _effectiveMaxHeight;

    /// <summary>Gets or sets the code string to display.</summary>
    [Parameter] public string? Code { get; set; }

    /// <summary>Programming language for syntax highlighting hint.</summary>
    [Parameter] public SgCodeLanguage Language { get; set; } = SgCodeLanguage.Razor;

    /// <summary>Optional title shown in the code block header.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Optional file name; takes precedence over <see cref="Title"/> in the header.</summary>
    [Parameter] public string? Filename { get; set; }

    /// <summary>Show the copy-to-clipboard button. Default true.</summary>
    [Parameter] public bool ShowCopy { get; set; } = true;

    /// <summary>Show line numbers gutter. Default false.</summary>
    [Parameter] public bool ShowLineNumbers { get; set; }

    /// <summary>Show the language label badge. Default true.</summary>
    [Parameter] public bool ShowLanguage { get; set; } = true;

    /// <summary>Show the wrap-toggle button. Default false.</summary>
    [Parameter] public bool ShowWrap { get; set; }

    /// <summary>Show the expand/fullscreen button. Default false.</summary>
    [Parameter] public bool ShowExpand { get; set; }

    /// <summary>Soft-wrap long lines. Default false.</summary>
    [Parameter] public bool Wrap { get; set; }

    /// <summary>
    /// Maximum height in pixels before the code block scrolls.
    /// Null (default) expands to fit content.
    /// </summary>
    [Parameter] public int? MaxHeight { get; set; }

    /// <summary>Apply lightweight syntax highlighting. Default true.</summary>
    [Parameter] public bool HighlightSyntax { get; set; } = true;

    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnParametersSet()
    {
        _displayCode = TrimIndent((Code ?? "").TrimEnd('\r', '\n'));
        _lineCount = _displayCode.Length == 0 ? 1 : _displayCode.Split('\n').Length;
        _renderedHtml = HighlightSyntax
            ? Highlighter.Highlight(_displayCode, Language)
            : System.Net.WebUtility.HtmlEncode(_displayCode);
        _effectiveMaxHeight = _expanded ? null : MaxHeight;
    }

    private bool HasHeader() =>
        !string.IsNullOrEmpty(Title) ||
        !string.IsNullOrEmpty(Filename) ||
        ShowCopy ||
        ShowWrap ||
        ShowExpand ||
        (ShowLanguage && Language != SgCodeLanguage.Text);

    private void ToggleWrap() => Wrap = !Wrap;

    private void ToggleExpand()
    {
        _expanded = !_expanded;
        _effectiveMaxHeight = _expanded ? null : MaxHeight;
    }

    private async Task CopyAsync()
    {
        if (_copied) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _displayCode);
        }
        catch
        {
            // Clipboard unavailable — silently ignore.
        }
        _copied = true;
        StateHasChanged();

        _copyCts?.Cancel();
        _copyCts?.Dispose();
        _copyCts = new CancellationTokenSource();
        var token = _copyCts.Token;
        try { await Task.Delay(1800, token); }
        catch (TaskCanceledException) { return; }
        if (!token.IsCancellationRequested)
        {
            _copied = false;
            StateHasChanged();
        }
    }

    private string LanguageLabel => Language switch
    {
        SgCodeLanguage.Razor      => "Razor",
        SgCodeLanguage.CSharp     => "C#",
        SgCodeLanguage.Html       => "HTML",
        SgCodeLanguage.Css        => "CSS",
        SgCodeLanguage.Json       => "JSON",
        SgCodeLanguage.JavaScript => "JavaScript",
        SgCodeLanguage.TypeScript => "TypeScript",
        SgCodeLanguage.Xml        => "XML",
        SgCodeLanguage.Bash       => "Bash",
        SgCodeLanguage.Sql        => "SQL",
        _                         => ""
    };

    private string LanguageClass => Language switch
    {
        SgCodeLanguage.Razor      => "razor",
        SgCodeLanguage.CSharp     => "csharp",
        SgCodeLanguage.Html       => "html",
        SgCodeLanguage.Css        => "css",
        SgCodeLanguage.Json       => "json",
        SgCodeLanguage.JavaScript => "js",
        SgCodeLanguage.TypeScript => "ts",
        SgCodeLanguage.Xml        => "xml",
        SgCodeLanguage.Bash       => "bash",
        SgCodeLanguage.Sql        => "sql",
        _                         => "text"
    };

    // ── Inline icons (kept local to avoid library churn) ────────────────────
    private const string IconFile =
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path><polyline points=\"14 2 14 8 20 8\"></polyline></svg>";
    private const string IconWrap =
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"3 6 21 6\"></polyline><path d=\"M3 12h15a3 3 0 0 1 0 6h-4\"></path><polyline points=\"16 16 14 18 16 20\"></polyline><line x1=\"3\" y1=\"18\" x2=\"10\" y2=\"18\"></line></svg>";
    private const string IconExpand =
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"15 3 21 3 21 9\"></polyline><polyline points=\"9 21 3 21 3 15\"></polyline><line x1=\"21\" y1=\"3\" x2=\"14\" y2=\"10\"></line><line x1=\"3\" y1=\"21\" x2=\"10\" y2=\"14\"></line></svg>";
    private const string IconCollapse =
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"4 14 10 14 10 20\"></polyline><polyline points=\"20 10 14 10 14 4\"></polyline><line x1=\"14\" y1=\"10\" x2=\"21\" y2=\"3\"></line><line x1=\"3\" y1=\"21\" x2=\"10\" y2=\"14\"></line></svg>";

    /// <summary>
    /// Removes the common leading whitespace from all non-empty lines so that
    /// code embedded as a C# string literal renders without extra indentation.
    /// </summary>
    private static string TrimIndent(string code)
    {
        if (string.IsNullOrEmpty(code)) return code;
        var lines = code.Split('\n');
        var nonEmpty = lines.Where(l => l.Trim().Length > 0).ToList();
        if (nonEmpty.Count == 0) return code;
        var minIndent = nonEmpty.Min(l => l.Length - l.TrimStart().Length);
        if (minIndent == 0) return code;
        return string.Join('\n', lines.Select(l => l.Length >= minIndent ? l[minIndent..] : l));
    }
}
