@namespace SuperUI.Components

<div class="sgc-ribbon-group @CssClass" role="group" aria-label="@Title">
    <div class="sgc-ribbon-group-body">
        @ChildContent
    </div>
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="sgc-ribbon-group-label">@Title</div>
    }
</div>

@code {
    /// <summary>Group label shown at the bottom of the group.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Content — should contain <see cref="SgRibbonButton"/>, <see cref="SgRibbonSplit"/>, or <see cref="SgRibbonSeparator"/> components.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional CSS class.</summary>
    [Parameter] public string? CssClass { get; set; }
}
