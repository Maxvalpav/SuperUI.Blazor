@namespace SuperUI.Components
@using SuperUI.Services
@inject SgDrawerService DrawerService

@foreach (var drawer in DrawerService.Drawers)
{
    var d = drawer;
    <SgDrawer @bind-Visible="d.Visible"
              Title="@d.Title"
              Placement="@d.Config.Placement"
              Size="@d.Config.Size"
              Resizable="@d.Config.Resizable"
              ShowClose="@d.Config.ShowClose"
              ShowHeader="@d.Config.ShowHeader"
              NoPadding="@d.Config.NoPadding"
              CloseOnBackdrop="@d.Config.CloseOnBackdrop"
              CloseOnEscape="@d.Config.CloseOnEscape"
              Animation="@d.Config.Animation"
              BackdropBlur="@d.Config.BackdropBlur"
              FullScreen="@d.Config.FullScreen"
              Loading="@d.Config.Loading"
              HeaderContent="@d.Config.HeaderContent"
              FooterContent="@d.Config.FooterContent"
              CloseConfirm="@d.Config.CloseConfirm"
              OnOpened="@d.Config.OnOpened"
              OnClosed="@d.Config.OnClosed"
              OnClose="@(() => d.OnClose?.Invoke())">
        <ChildContent>
            @d.Body
        </ChildContent>
    </SgDrawer>
}

@code {
    protected override void OnInitialized()
    {
        DrawerService.StateChanged += () => InvokeAsync(StateHasChanged);
    }
}
