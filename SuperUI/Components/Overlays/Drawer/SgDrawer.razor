@namespace SuperUI.Components
@using SuperUI.Localization
@using SuperUI.Services
@inherits SgOverlayComponentBase
@inject ISuperUILocalizer Localizer

@if (Visible || IsClosing)
{
    <SgPortal>
        <div class="sgc-drawer-backdrop @(IsClosing ? "sgc-closing" : "")" 
             style="z-index: @BackdropZIndex;" 
             @onclick="BackdropClickAsync"></div>
        
        <div class="@Css("sgc-drawer").AddClass(PlacementClass).AddClass(IsClosing ? "sgc-closing" : "").Build()"
             style="@GetDrawerStyle()"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@_titleId"
             @ref="RootRef"
             @attributes="AdditionalAttributes">
            <div class="sgc-drawer-header" id="@_titleId">
                <span class="sgc-drawer-title">@Title</span>
                @if (ShowClose)
                {
                    <SgIconButton Icon="@SgIcons.X" 
                                  OnClick="CloseAsync" 
                                  Variant="SgButtonVariant.Ghost" 
                                  Size="SgSize.Sm"
                                  CssClass="sgc-drawer-close-btn" />
                }
            </div>
            <div class="sgc-drawer-body">@ChildContent</div>
            @if (FooterContent is not null)
            {
                <div class="sgc-drawer-footer">@FooterContent</div>
            }
            @if (Resizable)
            {
                <div class="sgc-drawer-resizer" />
            }
        </div>
    </SgPortal>
}

@code {
    private readonly string _titleId = SgIdGenerator.NewId("drawer-title");
    private string _runtimeSize = string.Empty;

    protected override string ModulePath => "./_content/SuperUI/superui-drawer.js";
    protected override int ZIndexBase    => SgZIndexService.DrawerBase;
    protected override int ClosingAnimationMs => 300;
    protected override string IdPrefix  => "sg-drawer";

    // ── Параметры ────────────────────────────────────────────────────────

    /// <summary>
    /// Gets or sets the drawer title text.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// Gets or sets the drawer body content.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the drawer footer content.
    /// </summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>
    /// Gets or sets the drawer placement. Default is <see cref="SgPlacement.Right"/>.
    /// </summary>
    [Parameter] public SgPlacement Placement { get; set; } = SgPlacement.Right;

    /// <summary>
    /// Gets or sets the drawer size (width for left/right, height for top/bottom). Default is "360px".
    /// </summary>
    [Parameter] public string Size { get; set; } = "360px";

    /// <summary>
    /// Callback invoked when the drawer size is changed via resizing.
    /// </summary>
    [Parameter] public EventCallback<string> SizeChanged { get; set; }

    /// <summary>
    /// Gets or sets whether the drawer is resizable. Default is false.
    /// </summary>
    [Parameter] public bool Resizable { get; set; }

    /// <summary>
    /// Gets or sets whether to show the close button. Default is true.
    /// </summary>
    [Parameter] public bool ShowClose { get; set; } = true;

    /// <summary>
    /// Gets or sets whether clicking the backdrop closes the drawer. Default is true.
    /// </summary>
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;

    /// <summary>
    /// Gets or sets whether pressing ESC closes the drawer. Default is true.
    /// </summary>
    [Parameter] public bool CloseOnEscape { get; set; } = true;

    /// <summary>
    /// Callback invoked when the drawer is closed.
    /// </summary>
    [Parameter] public EventCallback OnClose { get; set; }

    // ── Computed ─────────────────────────────────────────────────────────

    private string PlacementClass => Placement switch
    {
        SgPlacement.Left   => "sgc-drawer-left",
        SgPlacement.Top    => "sgc-drawer-top",
        SgPlacement.Bottom => "sgc-drawer-bottom",
        _                  => "sgc-drawer-right"
    };

    private string GetDrawerStyle()
    {
        var sz = string.IsNullOrEmpty(_runtimeSize) ? Size : _runtimeSize;
        return Styles()
            .AddStyle("z-index", ZIndexValue.ToString(), ZIndexValue > 0)
            .AddStyle("width",      sz,  Placement is SgPlacement.Left or SgPlacement.Right)
            .AddStyle("max-width",  "100vw", Placement is SgPlacement.Left or SgPlacement.Right)
            .AddStyle("height",     sz,  Placement is SgPlacement.Top or SgPlacement.Bottom)
            .AddStyle("max-height", "100vh", Placement is SgPlacement.Top or SgPlacement.Bottom)
            .Build();
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────

    protected override async ValueTask OnOpeningAsync()
    {
        await SafeInvokeVoidAsync("attach", RootRef, SelfRef, CloseOnEscape);
        if (Resizable)
            await SafeInvokeVoidAsync("initResize", RootRef, SelfRef, PlacementClass);
    }

    protected override async ValueTask OnClosingAsync()
    {
        await SafeInvokeVoidAsync("detach", RootRef);
    }

    protected override async ValueTask OnClosedAsync()
    {
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }

    // ── JSInvokable ───────────────────────────────────────────────────────

    [JSInvokable]
    public override Task RequestCloseAsync() => CloseAsync();

    [JSInvokable]
    public async Task UpdateSizeFromJs(string newSize)
    {
        _runtimeSize = newSize;
        if (SizeChanged.HasDelegate)
            await SizeChanged.InvokeAsync(newSize);
        await InvokeAsync(StateHasChanged);
    }

    // ── Private ───────────────────────────────────────────────────────────

    private Task BackdropClickAsync() =>
        CloseOnBackdrop ? CloseAsync() : Task.CompletedTask;
}
