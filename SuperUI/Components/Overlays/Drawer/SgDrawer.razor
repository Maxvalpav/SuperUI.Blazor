@namespace SuperUI.Components
@using SuperUI.Localization
@using SuperUI.Services
@inherits SgOverlayComponentBase
@inject ISuperUILocalizer Localizer

@if (Visible || IsClosing)
{
    <SgPortal>
        <div class="sgc-drawer-backdrop @(IsClosing ? "sgc-closing" : "")"
             style="@GetBackdropStyle()"
             @onclick="BackdropClickAsync"></div>

        <div class="@GetDrawerCssClasses()"
             style="@GetDrawerStyle()"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@_titleId"
             tabindex="-1"
             @ref="RootRef"
             @attributes="AdditionalAttributes">
            @if (ShowHeader)
            {
                <div class="@GetHeaderClasses()" id="@_titleId">
                    @if (HeaderContent is not null)
                    {
                        @HeaderContent
                    }
                    else if (TitleTemplate is not null)
                    {
                        @TitleTemplate
                        <div class="sgc-drawer-header-spacer"></div>
                        @if (HeaderActions is not null)
                        {
                            <div class="sgc-drawer-header-actions">@HeaderActions</div>
                        }
                        @if (ShowClose)
                        {
                            <button class="sgc-drawer-close-btn" type="button" @onclick="CloseAsync" aria-label="Close">
                                @if (!string.IsNullOrEmpty(CloseIcon))
                                {
                                    <SgIcon Icon="@CloseIcon" Size="16px" />
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                }
                            </button>
                        }
                    }
                    else
                    {
                        <span class="sgc-drawer-title">@Title</span>
                        @if (HeaderActions is not null)
                        {
                            <div class="sgc-drawer-header-actions">@HeaderActions</div>
                        }
                        @if (ShowClose)
                        {
                            <button class="sgc-drawer-close-btn" type="button" @onclick="CloseAsync" aria-label="Close">
                                @if (!string.IsNullOrEmpty(CloseIcon))
                                {
                                    <SgIcon Icon="@CloseIcon" Size="16px" />
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                }
                            </button>
                        }
                    }
                </div>
            }
            <div class="@GetBodyClasses()">
                @if (Loading)
                {
                    <div class="sgc-drawer-loading">
                        <div class="sgc-drawer-loading-spinner"></div>
                    </div>
                }
                else
                {
                    @ChildContent
                }
            </div>
            @if (FooterContent is not null)
            {
                <div class="@GetFooterClasses()">@FooterContent</div>
            }
            @if (Resizable)
            {
                <div class="sgc-drawer-resizer @ResizerClass" />
            }
        </div>
    </SgPortal>
}
