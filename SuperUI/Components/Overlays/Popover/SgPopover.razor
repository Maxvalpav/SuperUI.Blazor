@namespace SuperUI.Components
@using SuperUI.Enums
@inherits SgJsComponentBase

<div class="@Css("sgc-pop-wrap").Build()"
     @ref="RootRef"
     @attributes="AdditionalAttributes">
    <div class="sgc-pop-trigger"
         @ref="_triggerRef"
         @onclick="OnTriggerClickAsync"
         @onmouseenter="OnTriggerMouseEnterAsync"
         @onmouseleave="OnTriggerMouseLeaveAsync">
        @if (TriggerContent is not null)
        {
            @TriggerContent
        }
        else
        {
            <SgButton Text="@ButtonText"
                      Variant="@ButtonVariant"
                      Size="@ButtonSize" />
        }
    </div>

    @if (_open || _isClosing)
    {
        @if (UsePortal)
        {
            <SgPortal Visible="@_open" RenderAt="@PortalTarget" ZIndex="@(ZIndex ?? 0)">
                <div class="@PopoverCssClass"
                     role="@Role"
                     aria-labelledby="@_titleId"
                     tabindex="-1"
                     @ref="_popoverRef"
                     style="@PopoverInlineStyle"
                     @onclick:stopPropagation="true"
                     @onmouseenter="OnPopoverMouseEnterAsync"
                     @onmouseleave="OnPopoverMouseLeaveAsync">
                    @if (!string.IsNullOrWhiteSpace(Title))
                    {
                        <div class="sgc-pop-header" id="@_titleId">@Title</div>
                    }
                    <div class="sgc-pop-body">
                        @ChildContent
                    </div>
                </div>
            </SgPortal>
        }
        else
        {
            <div class="@PopoverCssClass"
                 role="@Role"
                 aria-labelledby="@_titleId"
                 tabindex="-1"
                 @ref="_popoverRef"
                 style="@PopoverInlineStyle"
                 @onclick:stopPropagation="true"
                 @onmouseenter="OnPopoverMouseEnterAsync"
                 @onmouseleave="OnPopoverMouseLeaveAsync">
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <div class="sgc-pop-header" id="@_titleId">@Title</div>
                }
                <div class="sgc-pop-body">
                    @ChildContent
                </div>
            </div>
        }
    }
</div>
