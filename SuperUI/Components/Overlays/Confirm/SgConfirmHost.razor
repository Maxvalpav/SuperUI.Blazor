@namespace SuperUI.Components
@implements IAsyncDisposable
@inject SgConfirmService ConfirmService

<SgModal Visible="@_visible" VisibleChanged="OnVisibleChanged" Title="@_request?.Title">
    <ChildContent>
        @if (_request is not null)
        {
            <div class="sgc-confirm-body">
                <SgAlert Variant="@_request.Variant" Dense="true" ShowIcon="true" Text="@_request.Message" />
            </div>
        }
    </ChildContent>
    <FooterContent>
        @if (_request is not null)
        {
            <SgButton Text="@_request.CancelText" OnClick="CancelAsync" />
            <SgButton Text="@_request.ConfirmText" Variant="@ConfirmButtonVariant" OnClick="ConfirmAsync" />
        }
    </FooterContent>
</SgModal>

@code {
    private SgConfirmRequest? _request;
    private TaskCompletionSource<bool>? _pending;
    private CancellationTokenRegistration? _cancelReg;
    private bool _visible;
    private bool _disposed;

    protected override void OnInitialized()
    {
        ConfirmService.Requested += ShowAsync;
    }

    private Task<bool> ShowAsync(SgConfirmRequest request)
    {
        if (_disposed) return Task.FromResult(false);

        // Отменяем предыдущий ожидающий диалог — пользователь увидит только последний запрос.
        _pending?.TrySetResult(false);
        DisposeCancelReg();

        _request = request;
        _pending = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        _visible = true;

        // Программная отмена со стороны вызывающего.
        if (request.CancellationToken.CanBeCanceled)
        {
            var tcs = _pending;
            _cancelReg = request.CancellationToken.Register(static state =>
            {
                ((TaskCompletionSource<bool>)state!).TrySetResult(false);
            }, tcs);
        }

        _ = InvokeAsync(StateHasChanged);
        return _pending.Task;
    }

    /// <summary>Maps the confirm request variant to the appropriate button variant.</summary>
    private SgButtonVariant ConfirmButtonVariant => _request?.Variant switch
    {
        SgAlertVariant.Success => SgButtonVariant.Success,
        SgAlertVariant.Warn    => SgButtonVariant.Default,
        _                      => SgButtonVariant.Danger
    };

    private async Task ConfirmAsync()
    {
        _pending?.TrySetResult(true);
        await CloseAsync();
    }

    private async Task CancelAsync()
    {
        _pending?.TrySetResult(false);
        await CloseAsync();
    }

    private async Task OnVisibleChanged(bool visible)
    {
        if (!visible && _visible)
        {
            _pending?.TrySetResult(false);
        }

        _visible = visible;
        if (!visible)
        {
            _request = null;
            DisposeCancelReg();
        }

        if (!_disposed) await InvokeAsync(StateHasChanged);
    }

    private Task CloseAsync() => OnVisibleChanged(false);

    private void DisposeCancelReg()
    {
        var reg = _cancelReg;
        _cancelReg = null;
        reg?.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        ConfirmService.Requested -= ShowAsync;

        DisposeCancelReg();
        _pending?.TrySetResult(false);
        _pending = null;
        _request = null;

        await ValueTask.CompletedTask;
    }
}
