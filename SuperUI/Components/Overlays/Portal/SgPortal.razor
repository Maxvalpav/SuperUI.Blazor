@namespace SuperUI.Components
@inherits SgJsComponentBase

<div @ref="RootRef" style="display: contents;">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override string ModulePath => "./_content/SuperUI/superui-portal.js";

    protected override async Task OnAfterRenderSafeAsync(bool firstRender)
    {
        // Teleport on EVERY render because Blazor's diff can snap the element
        // back to its original position on re-render (StateHasChanged in parent).
        await SafeInvokeVoidAsync("teleport", RootRef);
    }

    protected override async ValueTask OnDisposingAsync()
    {
        await SafeInvokeVoidAsync("remove", RootRef);
    }
}