@namespace SuperUI.Components
@inherits SgJsComponentBase

@* 
    We only render ChildContent after JS has teleported the wrapper div to the target (e.g. body).
    This prevents "flashing" in the original position and escaping transformed/clipped parents immediately.
*@
<div @ref="RootRef" style="@PortalWrapperStyle" class="@CssClass" id="@Id" @attributes="AttributesWithoutClassAndStyle">
    @ChildContent
</div>
