@namespace SuperUI.Components
@inherits SgOverlayComponentBase

<span class="sgc-tt-wrap"
      @ref="RootRef"
      @onmouseenter="OnMouseEnterAsync"
      @onmouseleave="OnMouseLeaveAsync"
      @onfocus="OnFocusAsync"
      @onblur="OnBlurAsync"
      @onclick="OnClickAsync"
      @attributes="AdditionalAttributes">
    @ChildContent
    @if (Visible)
    {
        <SgPortal Visible="true">
            <span class="@TooltipCssClass"
                  @ref="_tooltipRef"
                  role="tooltip"
                  aria-hidden="@(!Visible)"
                  style="@TooltipInlineStyle">
                @if (RichContent is not null)
                {
                    @RichContent
                }
                else
                {
                    @Text
                }
            </span>
        </SgPortal>
    }
</span>
