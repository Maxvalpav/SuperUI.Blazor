@namespace SuperUI.Components
@using Microsoft.JSInterop
@using SuperUI.Base.ComponentBases
@inherits SgJsComponentBase

<CascadingValue Value="this" IsFixed="true">
    <div class="sgc-dropdown @CssClass @(Compact ? "sgc-dropdown-compact-wrap" : "")"
         @ref="RootRef"
         @onmouseleave="HandleMouseLeaveAsync"
         @onkeydown="HandleKeyDownAsync"
         @onkeydown:stopPropagation="true">
        <div class="sgc-dropdown-trigger"
             @ref="_triggerRef"
             role="button"
             aria-haspopup="menu"
             aria-expanded="@(_open ? "true" : "false")"
             tabindex="@(Disabled ? "-1" : "0")"
             @onclick="HandleTriggerClickAsync"
             @oncontextmenu="HandleContextMenuAsync"
             @oncontextmenu:preventDefault="@(Trigger == SgDropdownTrigger.ContextMenu)"
             @onmouseenter="HandleMouseEnterAsync">
            @if (TriggerContent is not null)
            {
                @TriggerContent
            }
            else
            {
                <SgButton Text="@Text" Icon="@Icon" Variant="@Variant" Size="@Size" Disabled="@Disabled" />
            }
            @if (ShowCaret && TriggerContent is null)
            {
                <span class="sgc-dropdown-caret @(_open ? "sgc-open" : "")" aria-hidden="true">▾</span>
            }
        </div>
        @if (_open)
        {
            <div class="@MenuClasses"
                 @ref="_menuRef"
                 role="menu"
                 style="@MenuInlineStyle"
                 @onclick:stopPropagation="true"
                 @onmouseenter="HandleMenuMouseEnterAsync">
                @if (ShowArrow)
                {
                    <div class="sgc-dropdown-arrow" aria-hidden="true"></div>
                }
                @if (ShowSearch)
                {
                    <div class="sgc-dropdown-search">
                        <svg class="sgc-dropdown-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" />
                        </svg>
                        <input type="text"
                               class="sgc-dropdown-search-input"
                               placeholder="@(SearchPlaceholder ?? "Search...")"
                               value="@_searchText"
                               @ref="_searchRef"
                               @oninput="HandleSearchInput" />
                        @if (ShowSearchClear && _searchText.Length > 0)
                        {
                            <button type="button" class="sgc-dropdown-search-clear" @onclick="ClearSearch" aria-label="Clear search">✕</button>
                        }
                    </div>
                }
                @if (Loading)
                {
                    <div class="sgc-dropdown-loading">
                        <span class="sgc-spinner" aria-hidden="true"></span>
                        <span>Loading...</span>
                    </div>
                }
                else
                {
                    @if (HeaderContent is not null)
                    {
                        <div class="sgc-dropdown-header">@HeaderContent</div>
                    }
                    <div class="sgc-dropdown-list">
                        @if (Searchable && _searchText.Length > 0 && !_items.Any(i => !i.Divider && !ParentIsItemFiltered(i)))
                        {
                            <div class="sgc-dropdown-empty">@ResolvedEmptyText</div>
                        }
                        else
                        {
                            @ChildContent
                        }
                    </div>
                    @if (FooterContent is not null)
                    {
                        <div class="sgc-dropdown-footer">@FooterContent</div>
                    }
                }
            </div>
        }
    </div>
</CascadingValue>
