@namespace SuperUI.Components
@implements IDisposable

<div class="sgc-dropdown-sub @(Disabled ? "sgc-disabled" : "") @CssClass"
     @onmouseenter="HandleTriggerMouseEnter">
    <button type="button"
            class="sgc-dropdown-item sgc-dropdown-sub-trigger @(Disabled ? "sgc-disabled" : "")"
            disabled="@Disabled"
            @ref="_triggerRef"
            @onclick="HandleTriggerClick"
            aria-haspopup="true"
            aria-expanded="@(_open ? "true" : "false")">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="sgc-dropdown-item-icon" style="@(IconColor is not null ? $"color:{IconColor}" : "")">
                @((MarkupString)Icon)
            </span>
        }
        <span class="sgc-dropdown-item-text">
            <span class="sgc-dropdown-item-label">@Text</span>
        </span>
        <svg class="sgc-dropdown-sub-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12" aria-hidden="true">
            <path d="m9 18 6-6-6-6" />
        </svg>
    </button>
    @if (_open)
    {
        <div class="sgc-dropdown-sub-menu">
            @ChildContent
        </div>
    }
</div>
