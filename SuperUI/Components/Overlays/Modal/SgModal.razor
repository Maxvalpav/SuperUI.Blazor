@namespace SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Localization
@using SuperUI.Services
@inherits SgOverlayComponentBase

@if (Visible || IsClosing)
{
    <SgPortal>
        <div class="sgc-modal-backdrop @(IsClosing ? "sgc-closing" : "")" style="z-index: @BackdropZIndex" @onclick="BackdropClickAsync">
            <div class="sgc-modal sgc-modal-anim-@AnimationClass" 
                 style="@GetStyle()" 
                 role="dialog" 
                 aria-modal="true" 
                 aria-labelledby="@_titleId"
                 aria-describedby="@_bodyId"
                 tabindex="-1"
                 @ref="RootRef"
                 @onclick:stopPropagation="true">
                <div class="sgc-modal-header" @ref="_headerRef">
                    <span id="@_titleId" class="sgc-modal-title">@Title</span>
                    @if (ShowClose)
                    {
                        <button class="sgc-modal-x" type="button" @onclick="CloseAsync" aria-label="@Localizer["Common_Close"]">×</button>
                    }
                </div>
                <div id="@_bodyId" class="sgc-modal-body">
                    @ChildContent
                </div>
                @if (FooterContent is not null)
                {
                    <div class="sgc-modal-footer">@FooterContent</div>
                }
            </div>
        </div>
    </SgPortal>
}

@code {
    // ID должны быть стабильны между prerender (server) и interactive (client),
    // иначе aria-labelledby/aria-describedby ломают гидрацию. StableIdFor возвращает
    // одно значение для всего жизненного цикла одного экземпляра компонента.
    private string _titleId => SgIdGenerator.StableIdFor(this, "modal-title");
    private string _bodyId  => SgIdGenerator.StableIdFor(this, "modal-body");
    private ElementReference _headerRef;

    /// <summary>
    /// Gets or sets the modal title text.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// Gets or sets the modal body content.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the modal footer content.
    /// </summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>
    /// Gets or sets whether to show the close button in the header. Default is true.
    /// </summary>
    [Parameter] public bool ShowClose { get; set; } = true;

    /// <summary>
    /// Gets or sets whether clicking the backdrop closes the modal. Default is true.
    /// </summary>
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;

    /// <summary>
    /// Gets or sets whether pressing ESC closes the modal. Default is true.
    /// </summary>
    [Parameter] public bool CloseOnEscape { get; set; } = true;

    /// <summary>
    /// Gets or sets the modal animation type. Default is <see cref="SgModalAnimation.Scale"/>.
    /// </summary>
    [Parameter] public SgModalAnimation Animation { get; set; } = SgModalAnimation.Scale;

    /// <summary>
    /// Gets or sets whether the modal is draggable by its header.
    /// </summary>
    [Parameter] public bool Draggable { get; set; }

    /// <summary>
    /// Gets or sets the modal width (e.g., "600px", "50%").
    /// </summary>
    [Parameter] public string? Width { get; set; }

    /// <summary>
    /// Callback invoked when the modal is closed.
    /// </summary>
    [Parameter] public EventCallback OnClose { get; set; }

    [Inject]
    private ISuperUILocalizer Localizer { get; set; } = default!;

    protected override string ModulePath => "./_content/SuperUI/superui-modal.js";
    protected override int    ZIndexBase => SgZIndexService.ModalBase;
    protected override string IdPrefix   => "sg-modal";
    protected override int    ClosingAnimationMs => 200;

    protected override async ValueTask OnOpeningAsync()
    {
        await SafeInvokeVoidAsync("attach", RootRef, SelfRef, CloseOnEscape);
        if (Draggable)
            await SafeInvokeVoidAsync("initDrag", RootRef, _headerRef);
    }

    protected override async ValueTask OnClosingAsync()
    {
        await SafeInvokeVoidAsync("detach", RootRef);
    }

    protected override async ValueTask OnClosedAsync()
    {
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }

    [JSInvokable]
    public override Task RequestCloseAsync() => CloseAsync();

    private string AnimationClass => Animation switch
    {
        SgModalAnimation.Fade  => "fade",
        SgModalAnimation.Slide => "slide",
        _                      => "scale"
    };

    private string GetStyle() => Styles()
        .AddStyle("z-index", ZIndexValue.ToString(), ZIndexValue > 0)
        .AddStyle("width",   Width, !string.IsNullOrEmpty(Width))
        .Build();

    private Task BackdropClickAsync()
        => CloseOnBackdrop ? CloseAsync() : Task.CompletedTask;
}