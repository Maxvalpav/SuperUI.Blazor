@namespace SuperUI.Components
@inherits SgOverlayComponentBase

@if (Visible || IsClosing || _responsiveFull)
{
    <SgPortal>
        <div class="@GetBackdropClasses()"
             style="@GetBackdropStyle()"
             @onclick="BackdropClickAsync"
             @ref="_backdropRef">
            @if (BackdropContent is not null)
            {
                <div class="sgc-modal-backdrop-content">@BackdropContent</div>
            }
            <div class="@GetModalClasses()"
                 style="@GetStyle()"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="@_titleId"
                 aria-describedby="@_bodyId"
                 tabindex="-1"
                 @ref="RootRef"
                 @onclick:stopPropagation="true">
                @if (Loading)
                {
                    <div class="sgc-modal-loading-overlay">
                        @if (LoadingContent is not null)
                        {
                            @LoadingContent
                        }
                        else
                        {
                            <SgSpinner Type="SgSpinnerType.Dots" Size="SgSize.Lg" Label="Loading..." />
                        }
                    </div>
                }
                <div class="@GetHeaderClasses()" @ref="_headerRef">
                    @if (HeaderContent is not null)
                    {
                        @HeaderContent
                    }
                    else
                    {
                        <div class="sgc-modal-header-inner">
                            @if (Icon is not null)
                            {
                                <SgIcon Icon="@Icon" Size="20px" Color="var(--sg-primary)" />
                            }
                            <span id="@_titleId" class="sgc-modal-title">@Title</span>
                        </div>
                    }
                    <div class="sgc-modal-header-actions">
                        @if (ShowMinimize)
                        {
                            <button class="sgc-modal-header-btn" type="button"
                                    @onclick="MinimizeAsync"
                                    aria-label="Minimize"
                                    title="Minimize">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </button>
                        }
                        @if (ShowMaximize && !FullScreen && !_responsiveFull)
                        {
                            <button class="sgc-modal-header-btn" type="button"
                                    @onclick="ToggleMaximized"
                                    aria-label="@(_isMaximized ? "Restore" : "Maximize")"
                                    title="@(_isMaximized ? "Restore" : "Maximize")">
                                @if (_isMaximized)
                                {
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3v3a2 2 0 0 1-2 2H3"/><path d="M21 8h-3a2 2 0 0 1-2-2V3"/><path d="M3 16h3a2 2 0 0 1 2 2v3"/><path d="M16 21v-3a2 2 0 0 1 2-2h3"/></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/></svg>
                                }
                            </button>
                        }
                        @if (ShowClose)
                        {
                            <button class="sgc-modal-x" type="button" @onclick="CloseAsync" aria-label="@Localizer["Common_Close"]">
                                @if (CloseIcon is not null)
                                {
                                    <SgIcon Icon="@CloseIcon" Size="18px" />
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                                }
                            </button>
                        }
                    </div>
                </div>
                <div id="@_bodyId" class="@GetBodyClasses()">
                    @ChildContent
                </div>
                @if (FooterContent is not null)
                {
                    <div class="@GetFooterClasses()">@FooterContent</div>
                }
                @if (Resizable)
                {
                    <div class="sgc-modal-resize-handle sgc-modal-resize-n" data-dir="n"></div>
                    <div class="sgc-modal-resize-handle sgc-modal-resize-s" data-dir="s"></div>
                    <div class="sgc-modal-resize-handle sgc-modal-resize-e" data-dir="e"></div>
                    <div class="sgc-modal-resize-handle sgc-modal-resize-w" data-dir="w"></div>
                    <div class="sgc-modal-resize-handle sgc-modal-resize-ne" data-dir="ne"></div>
                    <div class="sgc-modal-resize-handle sgc-modal-resize-nw" data-dir="nw"></div>
                    <div class="sgc-modal-resize-handle sgc-modal-resize-se" data-dir="se"></div>
                    <div class="sgc-modal-resize-handle sgc-modal-resize-sw" data-dir="sw"></div>
                }
            </div>
        </div>
    </SgPortal>
}
