@namespace SuperUI.Components
@typeparam TItem
@typeparam TKey
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer

<div class="sgc-field @(Block ? "sgc-block" : "") @CssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sgc-label @(Required ? "sgc-required" : "")">@Label</label>
    }
    <div class="sgc-combo @(Block ? "sgc-block" : "") @(_open ? "sgc-open" : "") @(Disabled ? "sgc-disabled" : "")"
         tabindex="0"
         @onfocusout="HandleFocusOutAsync"
         @onclick:stopPropagation="true">
        <div class="sgc-combo-control" @onclick="ToggleAsync">
            @if (Editable && _open)
            {
                <input class="sgc-combo-input"
                       value="@_search"
                       placeholder="@EffectivePlaceholder"
                       @oninput="OnSearchInput"
                       @onkeydown="OnKeyDownAsync"
                       @onclick:stopPropagation="true" />
            }
            else
            {
                var sel = GetSelectedItem();
                if (sel is not null)
                {
                    <span class="sgc-combo-value">@LabelFrom(sel)</span>
                }
                else
                {
                    <span class="sgc-combo-placeholder">@EffectivePlaceholder</span>
                }
            }
            @if (AllowClear && Value is not null && !Disabled)
            {
                <button class="sgc-combo-clear" type="button" title="@ClearLabel"
                        @onclick:stopPropagation="true" @onclick="ClearAsync">×</button>
            }
            <span class="sgc-combo-caret">@(_open ? "▲" : "▼")</span>
        </div>
        @if (_open)
        {
            <div class="sgc-combo-menu">
                @{ var filtered = GetFilteredItems().ToList(); }
                @if (filtered.Count == 0)
                {
                    <div class="sgc-combo-empty">@EffectiveEmptyText</div>
                }
                else
                {
                    @for (var i = 0; i < filtered.Count; i++)
                    {
                        var idx = i;
                        var it = filtered[idx];
                        var isSel = EqualityComparer<TKey>.Default.Equals(KeySelector(it), Value!);
                        <div class="sgc-combo-option sgc-combo-option-ex @(isSel ? "sgc-selected" : "") @(idx == _activeIndex ? "sgc-active" : "")"
                             @onclick:stopPropagation="true"
                             @onclick="() => PickAsync(it)">
                            <span class="sgc-combo-opt-label">@LabelFrom(it)</span>
                            @{ var desc = DescriptionSelector?.Invoke(it); }
                            @if (!string.IsNullOrEmpty(desc))
                            {
                                <span class="sgc-combo-opt-desc">@desc</span>
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>
    @if (!string.IsNullOrEmpty(Hint))
    {
        <span class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private bool _open;
    private string _search = string.Empty;
    private int _activeIndex = -1;

    /// <summary>
    /// Gets or sets the selected item key.
    /// </summary>
    [Parameter] public TKey? Value { get; set; }
    
    /// <summary>
    /// Gets or sets the callback invoked when the selected value changes.
    /// </summary>
    [Parameter] public EventCallback<TKey?> ValueChanged { get; set; }
    
    /// <summary>
    /// Gets or sets the collection of items to display in the dropdown.
    /// </summary>
    [Parameter] public IEnumerable<TItem> Items { get; set; } = Array.Empty<TItem>();
    
    /// <summary>
    /// Gets or sets the function to extract the key from an item. Required.
    /// </summary>
    [Parameter, EditorRequired] public Func<TItem, TKey> KeySelector { get; set; } = default!;
    
    /// <summary>
    /// Gets or sets the function to extract the display label from an item. Required.
    /// </summary>
    [Parameter, EditorRequired] public Func<TItem, string> LabelSelector { get; set; } = default!;
    
    /// <summary>
    /// Gets or sets the function to extract an optional description from an item.
    /// The description is displayed below the label in the dropdown.
    /// </summary>
    [Parameter] public Func<TItem, string>? DescriptionSelector { get; set; }
    
    /// <summary>
    /// Gets or sets the placeholder text displayed when no item is selected.
    /// If not specified, uses the localized "Select" string.
    /// </summary>
    [Parameter] public string? Placeholder { get; set; }
    
    /// <summary>
    /// Gets or sets the text displayed when no items match the search filter.
    /// If not specified, uses the localized "NoMatches" string.
    /// </summary>
    [Parameter] public string? EmptyText { get; set; }
    
    /// <summary>
    /// Gets or sets the label text displayed above the combo box.
    /// </summary>
    [Parameter] public string? Label { get; set; }
    
    /// <summary>
    /// Gets or sets the hint text displayed below the combo box.
    /// </summary>
    [Parameter] public string? Hint { get; set; }
    
    /// <summary>
    /// Gets or sets whether the clear button is displayed when an item is selected.
    /// Default is true.
    /// </summary>
    [Parameter] public bool AllowClear { get; set; } = true;
    
    /// <summary>
    /// Gets or sets whether the combo box allows text input for filtering items.
    /// Default is true.
    /// </summary>
    [Parameter] public bool Editable { get; set; } = true;
    
    /// <summary>
    /// Gets or sets whether the field is marked as required with a visual indicator.
    /// </summary>
    [Parameter] public bool Required { get; set; }
    
    /// <summary>
    /// Gets or sets whether the combo box is disabled.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }
    
    /// <summary>
    /// Gets or sets whether the combo box takes the full width of its container.
    /// Default is true.
    /// </summary>
    [Parameter] public bool Block { get; set; } = true;
    
    /// <summary>
    /// Gets or sets additional CSS classes to apply to the component.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    private string EffectivePlaceholder => Placeholder ?? Localizer["Select"];
    private string EffectiveEmptyText => string.IsNullOrEmpty(EmptyText) ? Localizer["NoMatches"] : EmptyText;
    private string ClearLabel => Localizer["Clear"];

    private string LabelFrom(TItem item) => LabelSelector(item);

    private TItem? GetSelectedItem()
    {
        if (Value is null) return default;
        foreach (var it in Items)
            if (EqualityComparer<TKey>.Default.Equals(KeySelector(it), Value)) return it;
        return default;
    }

    private IEnumerable<TItem> GetFilteredItems()
    {
        if (string.IsNullOrEmpty(_search)) return Items;
        return Items.Where(i =>
            LabelFrom(i).Contains(_search, StringComparison.CurrentCultureIgnoreCase) ||
            (DescriptionSelector?.Invoke(i) ?? "").Contains(_search, StringComparison.CurrentCultureIgnoreCase));
    }

    private async Task ToggleAsync()
    {
        if (Disabled) return;
        _open = !_open;
        if (_open) { _search = string.Empty; _activeIndex = -1; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleFocusOutAsync(FocusEventArgs e)
    {
        // Небольшая задержка, чтобы успел сработать клик по элементу внутри меню
        await Task.Delay(200);
        _open = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseAsync()
    {
        _open = false; _search = string.Empty; _activeIndex = -1;
        await InvokeAsync(StateHasChanged);
    }

    private Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _activeIndex = 0;
        return InvokeAsync(StateHasChanged);
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        var filtered = GetFilteredItems().ToList();
        if (e.Key == "ArrowDown") { _activeIndex = Math.Min(filtered.Count - 1, _activeIndex + 1); await InvokeAsync(StateHasChanged); }
        else if (e.Key == "ArrowUp") { _activeIndex = Math.Max(0, _activeIndex - 1); await InvokeAsync(StateHasChanged); }
        else if (e.Key == "Enter" && _activeIndex >= 0 && _activeIndex < filtered.Count) await PickAsync(filtered[_activeIndex]);
        else if (e.Key == "Escape") await CloseAsync();
    }

    private async Task PickAsync(TItem item)
    {
        Value = KeySelector(item);
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(Value);
        await CloseAsync();
    }

    private async Task ClearAsync()
    {
        Value = default;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(default);
        await InvokeAsync(StateHasChanged);
    }
}

