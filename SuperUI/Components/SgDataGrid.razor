@code {
    private RenderFragment RenderGroups(List<GroupNode> nodes, IReadOnlyList<SgDataGridColumn<TItem>> cols) => builder =>
    {
        var colSpan = ColumnSpan; // cache — avoid property re-evaluation per row
        foreach (var node in nodes)
        {
            var nodeLocal = node;
            var collapsed = IsGroupCollapsed(nodeLocal.Path);
            builder.OpenElement(0, "tr");
