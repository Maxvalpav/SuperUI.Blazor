@if (_editModalVisible && _editModalItem is not null)
{
    <SgModal Visible="true"
             Title="@_editModalTitle"
             Width="@_editModalWidth"
             CloseOnBackdrop="false"
             CloseOnEscape="true"
             OnClose="CloseEditModal">
        <ChildContent>
            @if (_editFormColumns is not null)
            {
                <div class="sg-edit-form">
                    <div class="sg-edit-form-grid">
                        @foreach (var col in _editFormColumns)
                        {
                            var colKey = col.Key;
                            var filterType = GetColumnFilterType(colKey);
                            var hasError = _editFormErrors.TryGetValue(colKey, out var errMsg);
                            var isFullWidth = filterType == "string";

                            <div class="sgc-field sgc-block sg-edit-field @(isFullWidth ? "sg-edit-full" : "")">
                                <label class="sgc-label">@col.Title</label>

                                @if (filterType == "bool")
                                {
                                    var boolVal = _editFormValues.TryGetValue(colKey, out var bv)
                                        && bv is "true" or "True" or "1" or "✓";
                                    <div class="sg-edit-bool-row">
                                        <SgSwitch Value="@boolVal"
                                                  ValueChanged="@(v => { _editFormValues[colKey] = v ? "true" : "false"; ApplyEditValueToItem(colKey, v ? "true" : "false"); ValidateEditField(colKey); StateHasChanged(); })" />
                                        <span class="sg-edit-bool-label">
                                            @(boolVal ? Localizer["DataGrid_FilterTrue"] : Localizer["DataGrid_FilterFalse"])
                                        </span>
                                    </div>
                                }
                                else if (filterType == "enum")
                                {
                                    var enumVal = _editFormValues.TryGetValue(colKey, out var ev) ? ev : string.Empty;
                                    <SgSelect TValue="string"
                                              Value="@enumVal"
                                              ValueChanged="@(v => { _editFormValues[colKey] = v; ApplyEditValueToItem(colKey, v); ValidateEditField(colKey); StateHasChanged(); })"
                                              EnumType="@(col.ValueType ?? GetColumnByKey(colKey)?.ValueType)"
                                              Placeholder="@Localizer["DataGrid_SelectPlaceholder"]"
                                              ErrorText="@(hasError ? errMsg : null)"
                                              Block="true" />
                                }
                                else if (filterType == "date")
                                {
                                    var rawDate = _editFormValues.TryGetValue(colKey, out var dv) ? dv : null;
                                    DateTime? dateVal = null;
                                    if (!string.IsNullOrEmpty(rawDate) &&
                                        DateTime.TryParse(rawDate, System.Globalization.CultureInfo.InvariantCulture,
                                            System.Globalization.DateTimeStyles.None, out var parsedDate))
                                        dateVal = parsedDate;
                                    <SgDatePicker Value="@dateVal"
                                                  ValueChanged="@(v => { _editFormValues[colKey] = v?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture); ApplyEditValueToItem(colKey, _editFormValues.GetValueOrDefault(colKey)); ValidateEditField(colKey); StateHasChanged(); })"
                                                  ErrorText="@(hasError ? errMsg : null)"
                                                  Block="true" />
                                }
                                else if (filterType == "datetime")
                                {
                                    var rawDt = _editFormValues.TryGetValue(colKey, out var dtv) ? dtv : null;
                                    DateTime? dtVal = null;
                                    if (!string.IsNullOrEmpty(rawDt) &&
                                        DateTime.TryParse(rawDt, System.Globalization.CultureInfo.InvariantCulture,
                                            System.Globalization.DateTimeStyles.None, out var parsedDt))
                                        dtVal = parsedDt;
                                    <SgDatePicker Value="@dtVal"
                                                  ValueChanged="@(v => { _editFormValues[colKey] = v?.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture); ApplyEditValueToItem(colKey, _editFormValues.GetValueOrDefault(colKey)); ValidateEditField(colKey); StateHasChanged(); })"
                                                  ErrorText="@(hasError ? errMsg : null)"
                                                  Block="true" />
                                }
                                else if (filterType == "number")
                                {
                                    var numStr = _editFormValues.TryGetValue(colKey, out var nv) ? nv : null;
                                    decimal? numVal = null;
                                    if (!string.IsNullOrEmpty(numStr) &&
                                        decimal.TryParse(numStr, System.Globalization.NumberStyles.Any,
                                            System.Globalization.CultureInfo.InvariantCulture, out var parsedNum))
                                        numVal = parsedNum;
                                    <SgNumberEdit TValue="decimal"
                                                  Value="@(numVal ?? 0m)"
                                                  ValueChanged="@(v => { _editFormValues[colKey] = ((decimal)v).ToString(System.Globalization.CultureInfo.InvariantCulture); ApplyEditValueToItem(colKey, _editFormValues.GetValueOrDefault(colKey)); ValidateEditField(colKey); StateHasChanged(); })"
                                                  ErrorText="@(hasError ? errMsg : null)"
                                                  Block="true" />
                                }
                                else
                                {
                                    var strVal = _editFormValues.TryGetValue(colKey, out var sv) ? sv : string.Empty;
                                    <SgTextBox TValue="string"
                                               Value="@strVal"
                                               ValueChanged="@(v => { _editFormValues[colKey] = v; ApplyEditValueToItem(colKey, v); ValidateEditField(colKey); StateHasChanged(); })"
                                               ErrorText="@(hasError ? errMsg : null)"
                                               Block="true"
                                               Immediate="true" />
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </ChildContent>
        <FooterContent>
            <div class="sg-edit-form-footer">
                <span class="sg-edit-form-footer-info">
                    @if (_editFormErrors.Count > 0)
                    {
                        <span class="sg-edit-form-error">
                            @_editFormErrors.Values.First()
                        </span>
                    }
                </span>
                <SgButton Text="@Localizer["Cancel"]"
                          OnClick="@(async _ => await CloseEditModal())" />
                <SgButton Text="@Localizer["Save"]"
                          Variant="SgButtonVariant.Primary"
                          Disabled="@(_editFormErrors.Count > 0)"
                          OnClick="@(async _ => await TrySaveEditModalAsync())" />
            </div>
        </FooterContent>
    </SgModal>
}

