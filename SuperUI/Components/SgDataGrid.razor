                        }
                        else if (filterType == "number")
                        {
                            <input type="text" class="sgc-input"
                                   placeholder="@Localizer["DataGrid_BulkEditNoChange"]"
                                   value="@_bulkEditValues.GetValueOrDefault(colKey)"
                                   @oninput="@(e => { _bulkEditValues[colKey] = e.Value?.ToString(); })" />
                        }
                        else
                        {
                            <input type="text" class="sgc-input"
                                   placeholder="@Localizer["DataGrid_BulkEditNoChange"]"
                                   value="@_bulkEditValues.GetValueOrDefault(colKey)"
                                   @oninput="@(e => { _bulkEditValues[colKey] = e.Value?.ToString(); })" />
                        }
