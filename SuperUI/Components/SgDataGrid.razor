@typeparam TItem
@using Microsoft.AspNetCore.Components.Web
@using SuperUI.Localization

<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

<CascadingValue Value="Localizer" IsFixed="false">
<div class="sg-root @(ShowColumnBorders ? "sg-col-borders" : "") @(_editModalVisible ? "sg-modal-open" : "") @CssClass" 
     id="@_gridId" 
     @ref="_gridRootRef" 
     @onclick="CloseFilterMenuAsync" 
     @onclick:stopPropagation="false"
     @onkeydown="HandleKeyDownAsync"
     tabindex="0"
     style="outline: none;">
    <div class="sg-toolbar">
        @if (!string.IsNullOrEmpty(Title))
        {
            <div class="sg-title">@Title</div>
        }
        @foreach (var gk in GroupByKeys)
        {
            var gcol = GetColumnByKey(gk);
            if (gcol is null) continue;
            <div class="sg-chip sg-group-chip">
                <span>@Localizer["DataGrid_Group"]: @gcol.Title</span>
                <button class="sg-chip-x" title="@Localizer["DataGrid_RemoveGroup"]" @onclick="async () => await ToggleGroupByAsync(gk)">×</button>
            </div>
        }
        @foreach (var sortRule in SortRules)
        {
            var scol = GetColumnByKey(sortRule.Key);
            if (scol is null) continue;
            <div class="sg-chip sg-sort-chip">
                <span>@(sortRule.Dir == SortDirection.Ascending ? "▲" : "▼") @scol.Title</span>
                <button class="sg-chip-x" title="@Localizer["Clear"]" @onclick="async () => await RemoveSortAsync(sortRule.Key)">×</button>
            </div>
        }
        <div class="sg-spacer"></div>
        @if (ShowSearch)
        {
            <input class="sg-search"
                   placeholder="@Localizer["DataGrid_Search"]"
                   value="@_search"
                   @oninput="OnSearchInput" />
        }
        @if (CanCreateInlineItem)
        {
            <button class="sg-btn primary" @onclick="StartCreateModalAsync">@Localizer["DataGrid_Add"]</button>
        }
        @if (HasUndoDelete)
        {
            <button class="sg-btn" @onclick="UndoDeleteAsync">@Localizer["DataGrid_UndoDelete"]</button>
        }
        @if (HasActiveFilters)
        {
            <button class="sg-btn" @onclick="ClearAllFiltersAsync" title="@Localizer["DataGrid_ResetFilters"]">@Localizer["DataGrid_ResetFilters"]</button>
        }
        @if (HasActiveSort)
        {
            <button class="sg-btn" @onclick="ClearSortAsync" title="@Localizer["DataGrid_ResetSort"]">@Localizer["DataGrid_ResetSort"]</button>
        }
        @if (AllowAutoFit)
        {
            <button class="sg-btn" @onclick="AutoFitAsync" title="@Localizer["DataGrid_AutoFit"]">@Localizer["DataGrid_AutoFit"]</button>
        }
        @if (ShowColumnChooser)
        {
            <div @ref="_chooserRef" class="sg-chooser-wrap" @onclick:stopPropagation="true" @onfocusout="HandleChooserFocusOutAsync" tabindex="-1">
                <button class="sg-btn" @onclick="ToggleChooserAsync" title="@Localizer["DataGrid_Columns"]">@Localizer["DataGrid_Columns"]</button>
                @if (_showChooser)
                {
                    <div class="sg-chooser-menu">
                        <div class="sg-chooser-head">@Localizer["DataGrid_ShowColumns"]</div>
                        @foreach (var col in _columns)
                        {
                            var k = col.Key;
                            <label class="sg-chooser-item">
                                <input type="checkbox"
                                       checked="@(!IsColumnHidden(k))"
                                       @onchange="@(e => ToggleColumnHiddenAsync(k, e.Value is not true))" />
                                <span>@col.Title</span>
                            </label>
                        }
                    </div>
                }
            </div>
        }
@if (ShowExportCsv || ShowExportExcel)
         {
             <div @ref="_exportRef" class="sg-chooser-wrap" @onclick:stopPropagation="true" @onfocusout="HandleExportFocusOutAsync" tabindex="-1">
                 <button class="sg-btn" @onclick="ToggleExportMenuAsync" title="@Localizer["DataGrid_Export"]">@Localizer["DataGrid_Export"]</button>
                 @if (_showExportMenu)
                 {
                     <div class="sg-chooser-menu">
                         @if (ShowExportCsv)
                         {
                             <button class="sg-chooser-item sg-btn-link" @onclick="async () => { await ExportCsvAsync(); _showExportMenu = false; }">@Localizer["DataGrid_ExportCsv"]</button>
                         }
                         @if (ShowExportExcel)
                         {
                             <button class="sg-chooser-item sg-btn-link" @onclick="async () => { await ExportExcelAsync(); _showExportMenu = false; }">@Localizer["DataGrid_ExportExcel"]</button>
                         }
                     </div>
                 }
             </div>
         }
@if (SelectionEnabled && SelectedItems.Count > 0)
         {
             <div class="sg-chip">@Localizer["DataGrid_Selected"]: @SelectedItems.Count</div>
             <button class="sg-btn" @onclick="ClearSelectionAsync">@Localizer["Clear"]</button>
         }
    </div>

    <div class="sg-scroll">
        @{
            var visibleCols = VisibleColumns;
        }
        <table class="sg-table @(FullWidth ? "sg-table-full" : "")" role="grid">
            <thead>
                <tr>
                    @if (DetailTemplate is not null && DetailPlacement == DetailPlacement.Inline)
                    {
                        <th class="sg-col-expand"></th>
                    }
                    @if (SelectionEnabled)
                    {
<th class="sg-col-check sg-pinned" style="left: 0;">
                               <input type="checkbox"
                                      aria-label="@Localizer["DataGrid_SelectAll"]"
                                      checked="@AllFilteredSelected"
                                      @onchange="OnToggleAllAsync" />
                           </th>
                    }
                    @for (var i = 0; i < visibleCols.Count; i++)
                    {
                        var col = visibleCols[i];
                        var key = col.Key;
                        var sort = GetSort(key);
                        var sortIdx = _sort.Count > 1 ? GetSortIndex(key) : 0;
                        var hasFilter = _filters.ContainsKey(key);
                        var menuSide = i >= visibleCols.Count - 1 ? "right" : "left";
                        var widthStyle = GetColumnWidthStyle(col);
                        var pinStyle = GetColumnPinStyle(col);
                        var thClass = "sg-th" + (col.Pinned ? " sg-pinned" : "");
                        <th data-col-key="@key"
                            data-col-pinned="@(col.Pinned ? "1" : "0")"
                            draggable="@(col.Reorderable ? "true" : "false")"
                            aria-sort="@(col.Sortable ? (sort == SortDirection.Ascending ? "ascending" : sort == SortDirection.Descending ? "descending" : "none") : null)"
                            style="@(widthStyle + pinStyle)" class="@thClass">
                            <div class="sg-th-inner">
                                <span class="sg-th-title @(col.Sortable ? "sg-sortable" : "")"
                                      title="@(col.Sortable ? Localizer["DataGrid_Sort"] : "")"
                                      @onclick="@(async (MouseEventArgs e) => { if (col.Sortable) await ToggleSortAsync(key, e.CtrlKey || e.ShiftKey); })">
                                    @col.Title
                                    @if (sort == SortDirection.Ascending)
                                    {
                                        <span class="sg-sort-ind">▲@(sortIdx > 0 ? sortIdx.ToString() : "")</span>
                                    }
                                    else if (sort == SortDirection.Descending)
                                    {
                                        <span class="sg-sort-ind">▼@(sortIdx > 0 ? sortIdx.ToString() : "")</span>
                                    }
                                </span>
                                @if (col.Filterable)
                                {
                                    <button class="sg-filter-btn @(hasFilter ? "active" : "")"
                                            aria-label="Фильтр @col.Title"
                                            @onclick:stopPropagation="true"
                                            @onclick="async () => await ToggleFilterMenuAsync(key)">
                                        ▾
                                    </button>
                                }
                            </div>
                            @if (_openFilterColumn == key)
                            {
                                <div class="sg-filter-menu sg-filter-menu--@menuSide" @onclick:stopPropagation="true">

                                    @* AND / OR toggle *@
                                    @if (PendingRules.Count > 1)
                                    {
                                        <div class="sg-filter-logic" @onclick:stopPropagation="true">
                                            <button class="sg-btn sg-sm @(PendingRulesAnd ? "sg-btn-active" : "")" type="button"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="async () => await SetPendingRulesAndAsync(true)">AND</button>
                                            <button class="sg-btn sg-sm @(!PendingRulesAnd ? "sg-btn-active" : "")" type="button"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="async () => await SetPendingRulesAndAsync(false)">OR</button>
                                        </div>
                                    }

                                    @* Rules list *@
                                    @for (var ri = 0; ri < PendingRules.Count; ri++)
                                    {
                                        var rIdx = ri;
                                        var rule = PendingRules[rIdx];
                                        <div class="sg-filter-rule">
<select class="sg-filter-cond-select"
                                                     value="@rule.Condition.ToString()"
                                                     @onchange="async e => await SetPendingRuleConditionAsync(rIdx, Enum.Parse<FilterCondition>(e.Value!.ToString()!))">
                                                 <option value="Contains">@Localizer["DataGrid_FilterContains"]</option>
                                                 <option value="NotContains">@Localizer["DataGrid_FilterNotContains"]</option>
                                                 <option value="Equals">@Localizer["DataGrid_FilterEquals"]</option>
                                                 <option value="NotEquals">@Localizer["DataGrid_FilterNotEquals"]</option>
                                                 <option value="StartsWith">@Localizer["DataGrid_FilterStartsWith"]</option>
                                                 <option value="EndsWith">@Localizer["DataGrid_FilterEndsWith"]</option>
                                                 @if (IsNumericColumn(key))
                                                 {
                                                     <option value="GreaterThan">@Localizer["DataGrid_FilterGreaterThan"]</option>
                                                     <option value="LessThan">@Localizer["DataGrid_FilterLessThan"]</option>
                                                     <option value="GreaterOrEqual">@Localizer["DataGrid_FilterGreaterOrEqual"]</option>
                                                     <option value="LessOrEqual">@Localizer["DataGrid_FilterLessOrEqual"]</option>
                                                 }
                                                 <option value="IsEmpty">@Localizer["DataGrid_FilterIsEmpty"]</option>
                                                 <option value="IsNotEmpty">@Localizer["DataGrid_FilterIsNotEmpty"]</option>
                                             </select>
@if (rule.Condition != FilterCondition.IsEmpty && rule.Condition != FilterCondition.IsNotEmpty)
                                             {
                                                 <input class="sg-filter-rule-input"
                                                        placeholder="@Localizer["DataGrid_FilterValue"]"
                                                        value="@rule.Value"
                                                        @oninput="async e => await SetPendingRuleValueAsync(rIdx, e.Value?.ToString())" />
                                             }
                                            @if (PendingRules.Count > 1)
                                            {
<button class="sg-filter-rule-del" type="button"
                                                         title="@Localizer["DataGrid_FilterRemoveCondition"]"
                                                         @onclick="async () => await RemovePendingRuleAsync(rIdx)">×</button>
                                            }
                                        </div>
                                    }

                                    @* Add rule *@
<div class="sg-filter-add-rule">
                                         <button class="sg-btn sg-sm" type="button" @onclick="AddPendingRuleAsync">@Localizer["DataGrid_FilterAddCondition"]</button>
                                     </div>

                                     @* Quick apply *@
                                     <div class="sg-filter-cond-apply">
                                         <button class="sg-btn primary" style="width:100%" type="button"
                                                 @onclick="async () => await ApplyConditionFilterAsync(key)">
                                             @Localizer["DataGrid_FilterApply"]
                                         </button>
                                     </div>

                                     @* Divider *@
                                     <div class="sg-filter-divider">@Localizer["DataGrid_FilterOrValues"]</div>

                                    @* Checkbox list *@
                                    <div class="sg-filter-actions">
<label class="sg-filter-all">
                                             <input type="checkbox"
                                                    checked="@IsPendingAllSelected(key)"
                                                    @onchange="@(e => TogglePendingAllAsync(key, e.Value is true))" />
                                             @Localizer["DataGrid_FilterAll"]
                                         </label>
                                    </div>
<div class="sg-filter-list">
                                         @foreach (var val in GetDistinctValuesForColumn(key))
                                         {
                                             var display = val ?? Localizer["DataGrid_FilterEmpty"];
                                             var selected = IsPendingValueSelected(val);
                                             <label class="sg-filter-item" @key="val">
                                                 <input type="checkbox"
                                                        checked="@selected"
                                                        @onchange="@(e => TogglePendingValueAsync(val, e.Value is true))" />
                                                 <span>@display</span>
                                             </label>
                                         }
                                     </div>

                                     @* Footer *@
                                     <div class="sg-filter-foot">
                                         <button class="sg-btn" title="@(IsGroupedBy(key) ? Localizer["DataGrid_FilterUnGroupBy"] : Localizer["DataGrid_FilterGroupBy"])"
                                                 @onclick="async () => await ToggleGroupByAsync(key)">
                                             @(IsGroupedBy(key) ? Localizer["DataGrid_FilterUnGroupBy"] : Localizer["DataGrid_FilterGroupBy"])
                                         </button>
                                         <div class="sg-spacer"></div>
                                         <button class="sg-btn" @onclick="async () => await ClearPendingAsync(key)">@Localizer["DataGrid_FilterReset"]</button>
                                         <button class="sg-btn" @onclick="CloseFilterMenuAsync">@Localizer["DataGrid_FilterCancel"]</button>
                                         <button class="sg-btn primary" @onclick="ApplyFilterAsync">@Localizer["DataGrid_FilterOk"]</button>
                                     </div>
                                </div>
                            }
                            @if (col.Resizable)
                            {
                                <div class="sg-resizer" data-col-key="@key"></div>
                            }
                        </th>
                    }
                    @if (AllowEdit || AllowDelete)
                    {
                        <th class="sg-th sg-col-actions sg-pinned" style="right:0;"></th>
                    }
                </tr>
@if (ShowQuickFilters)
                     {
                         <tr class="sg-quick-filter-row">
                             @if (DetailTemplate is not null && DetailPlacement == DetailPlacement.Inline)
                             {
                                 <th class="sg-col-expand"></th>
                             }
                             @if (SelectionEnabled)
                             {
                                 <th class="sg-col-check sg-pinned" style="left:0;"></th>
                             }
                             @foreach (var col in visibleCols)
                             {
                                 var widthStyle = GetColumnWidthStyle(col);
                                 var pinStyle = GetColumnPinStyle(col);
                                 var thClass = "sg-th" + (col.Pinned ? " sg-pinned" : "");
                                 <th class="@($"{thClass} sg-quick-filter-cell")" style="@(widthStyle + pinStyle)">
                                     @if (col.Filterable)
                                     {
                                         <input class="sg-quick-filter-input"
                                                placeholder="@Localizer["DataGrid_QuickFilter"]"
                                                value="@(_quickFilters.TryGetValue(col.Key, out var quickValue) ? quickValue : string.Empty)"
                                                @oninput="@(e => OnQuickFilterInputAsync(col.Key, e))" />
                                     }
                                 </th>
                             }
                             @if (AllowEdit || AllowDelete)
                             {
                                 <th class="sg-th sg-col-actions sg-pinned" style="right:0;"></th>
                             }
                         </tr>
                     }
            </thead>
            <tbody>
                @{
                    var hasGroups = GroupByKeys.Count > 0;
                    var rows = hasGroups ? new List<TItem>() : GetVisibleRows();
                    var tree = hasGroups ? BuildGroupTree() : null;
                    var totalVisible = hasGroups ? TotalFilteredCount : rows.Count;
                    var useVirtualization = ShouldUseVirtualization() && !hasGroups;
                    var (startIndex, endIndex, topPadding, bottomPadding) = useVirtualization ? CalculateVirtualWindow() : (0, rows.Count, 0, 0);
                }
                @if (totalVisible == 0)
                {
                    <tr>
                        <td class="sg-empty" colspan="@ColumnSpan">@EffectiveEmptyText</td>
                    </tr>
                }
                else if (hasGroups && tree is not null)
                {
                    @RenderGroups(tree, visibleCols)
                }
                else
                {
                    @if (useVirtualization && topPadding > 0)
                    {
                        <tr style="height: @(topPadding)px;"><td colspan="@ColumnSpan"></td></tr>
                    }
                    for (var i = 0; i < rows.Count; i++)
                    {
                        @RenderRow(rows[i], visibleCols, 0)
                    }
                    @if (useVirtualization && bottomPadding > 0)
                    {
                        <tr style="height: @(bottomPadding)px;"><td colspan="@ColumnSpan"></td></tr>
                    }
                }
            </tbody>
            @if (ShowStatusBar && visibleCols.Any(c => c.Aggregate != Aggregate.None))
            {
                <tfoot>
                    <tr>
                        @if (DetailTemplate is not null && DetailPlacement == DetailPlacement.Inline)
                        {
                            <td class="sg-agg sg-col-expand"></td>
                        }
                        @if (SelectionEnabled)
                        {
                            <td class="sg-agg sg-col-check sg-pinned" style="left:0;"></td>
                        }
                        @foreach (var col in visibleCols)
                        {
                            var pinStyle = GetColumnPinStyle(col);
                            var aggClass = "sg-agg" + (col.Pinned ? " sg-pinned" : "");
                            <td class="@aggClass" style="@pinStyle">
                                @{
                                    var agg = ComputeAggregate(col);
                                }
                                @if (agg is not null)
                                {
                                    <span class="sg-agg-label">@col.Aggregate:</span>
                                    <span class="sg-agg-val">@agg</span>
                                }
                            </td>
                        }
                        @if (AllowEdit || AllowDelete)
                        {
                            <td class="sg-agg sg-col-actions sg-pinned" style="right:0;"></td>
                        }
                    </tr>
                </tfoot>
            }
        </table>
    </div>

    <div class="sg-foot">
        @{
            var filtered = TotalFilteredCount;
            var tp = TotalPages;
            var from = filtered == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;
            var to = Math.Min(filtered, CurrentPage * PageSize);
        }
        <span class="sg-foot-info">
            @if (EnablePaging)
            {
                @($"{Localizer["DataGrid_RowsFrom"]} {from}–{to} {Localizer["DataGrid_RowsOf"]} {filtered}")
            }
            else
            {
                @($"{Localizer["DataGrid_RowsShown"]} {filtered}")
            }
            @if (SelectedItems.Count > 0)
            {
                <span class="sg-foot-sel"> @Localizer["DataGrid_RowsSelectedCount"]: @SelectedItems.Count</span>
            }
        </span>
        @if (EnablePaging)
        {
            <div class="sg-pager">
                <label class="sg-pager-size">
                    @Localizer["DataGrid_PageSize"]
                    <select @onchange="OnPageSizeChange" value="@PageSize">
                        @foreach (var s in PageSizeOptions)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </label>
                <button class="sg-page-btn" disabled="@(CurrentPage <= 1)"
                        @onclick="() => GoToPageAsync(1)" aria-label="@Localizer["DataGrid_PageFirst"]">«</button>
                <button class="sg-page-btn" disabled="@(CurrentPage <= 1)"
                        @onclick="() => GoToPageAsync(CurrentPage - 1)" aria-label="@Localizer["DataGrid_PagePrev"]">‹</button>
                @foreach (var p in GetPageWindow())
                {
                    if (p == -1)
                    {
                        <span class="sg-page-gap">…</span>
                    }
                    else
                    {
                        var pageNum = p;
                        <button class="sg-page-btn @(pageNum == CurrentPage ? "current" : "")"
                                @onclick="() => GoToPageAsync(pageNum)">@pageNum</button>
                    }
                }
                <button class="sg-page-btn" disabled="@(CurrentPage >= tp)"
                        @onclick="() => GoToPageAsync(CurrentPage + 1)" aria-label="@Localizer["DataGrid_PageNext"]">›</button>
                <button class="sg-page-btn" disabled="@(CurrentPage >= tp)"
                        @onclick="() => GoToPageAsync(tp)" aria-label="@Localizer["DataGrid_PageLast"]">»</button>
            </div>
        }
    </div>
</div>
</CascadingValue>

@if (DetailTemplate is not null && _detailItem is not null && _detailDrawerVisible)
{
    <div class="sgc-drawer-backdrop" @onclick="CloseDetail">
        <aside class="sgc-drawer sgc-drawer-right" style="width:420px;max-width:100vw;"
               @onclick:stopPropagation="true">
            <div class="sgc-drawer-header">
                <span class="sgc-drawer-title">@EffectiveDetailDrawerTitle</span>
                <button type="button" class="sgc-modal-x"
                        @onclick="CloseDetail">×</button>
            </div>
            <div class="sgc-drawer-body">
                @DetailTemplate!(_detailItem!)
            </div>
        </aside>
    </div>
}

@if (DetailTemplate is not null && _detailItem is not null && _detailWindowVisible)
{
    <div class="sgc-win" style="position:fixed;left:120px;top:120px;width:@(DetailWindowWidth)px;height:@(DetailWindowHeight)px;z-index:2000;">
        <div class="sgc-win-header">
            <span class="sgc-win-title">@EffectiveDetailWindowTitle</span>
            <div class="sgc-win-actions">
                <button type="button" class="sgc-win-btn sgc-win-close"
                        @onclick="CloseDetail">×</button>
            </div>
        </div>
        <div class="sgc-win-body">@DetailTemplate!(_detailItem!)</div>
    </div>
}

@if (_editModalVisible && _editModalItem is not null)
{
    <SgModal Visible="true"
             Title="@_editModalTitle"
             Width="@_editModalWidth"
             CloseOnBackdrop="true"
             CloseOnEscape="true"
             OnClose="CloseEditModal">
        <ChildContent>
            @RenderEditForm()
        </ChildContent>
    </SgModal>
}

@code {
    private RenderFragment RenderGroups(List<GroupNode> nodes, IReadOnlyList<SgDataGridColumn<TItem>> cols) => builder =>
    {
        foreach (var node in nodes)
        {
            var nodeLocal = node;
            var collapsed = IsGroupCollapsed(nodeLocal.Path);
            builder.OpenElement(0, "tr");
            builder.AddAttribute(1, "class", "sg-group-row");
            builder.AddAttribute(19, "role", "row");
            builder.AddAttribute(20, "aria-expanded", collapsed ? "false" : "true");
            builder.OpenElement(2, "td");
            builder.AddAttribute(3, "class", "sg-group-cell");
            builder.AddAttribute(4, "colspan", ColumnSpan);
            builder.AddAttribute(5, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => ToggleGroupCollapsedAsync(nodeLocal.Path)));
            builder.OpenElement(6, "span");
            builder.AddAttribute(7, "class", "sg-group-indent");
            builder.AddAttribute(8, "style", $"padding-left:{nodeLocal.Depth * 16}px;");
            builder.CloseElement();
            builder.OpenElement(9, "span");
            builder.AddAttribute(10, "class", "sg-group-toggle");
            builder.AddContent(11, collapsed ? "▶" : "▼");
            builder.CloseElement();
            builder.OpenElement(12, "span");
            builder.AddAttribute(13, "class", "sg-group-label");
            builder.AddContent(14, $"{nodeLocal.Column.Title}: {nodeLocal.Label}");
            builder.CloseElement();
            builder.OpenElement(15, "span");
            builder.AddAttribute(16, "class", "sg-group-count");
            builder.AddContent(17, $" ({nodeLocal.TotalCount})");
            builder.CloseElement();
            builder.CloseElement();
            builder.CloseElement();

            if (!collapsed)
            {
                if (nodeLocal.Children.Count > 0)
                    builder.AddContent(18, RenderGroups(nodeLocal.Children, cols));
                foreach (var item in nodeLocal.Items)
                    builder.AddContent(19, RenderRow(item, cols, nodeLocal.Depth + 1));
            }
        }
    };

    private RenderFragment RenderRow(TItem item, IReadOnlyList<SgDataGridColumn<TItem>> cols, int indent) => builder =>
    {
        var itemLocal = item;
        // Only check selection if selection is enabled to avoid unnecessary HashSet lookups
        var isSelected = SelectionEnabled ? SelectedItems.Contains(itemLocal) : false;
        // NOTE: Do NOT check IsActiveRow() here - this would trigger re-render on every active row change
        // The sg-active class is managed by JavaScript to avoid full grid re-renders
        var rowExpanded = DetailTemplate is not null && DetailPlacement == DetailPlacement.Inline && IsRowExpanded(itemLocal);
        
        builder.OpenElement(0, "tr");
        builder.SetKey(itemLocal);
        // Only apply sg-selected class, sg-active is managed by JavaScript
        builder.AddAttribute(1, "class", isSelected ? "sg-selected" : "");
        builder.AddAttribute(2, "role", "row");
        if (SelectionEnabled)
            builder.AddAttribute(8, "aria-selected", isSelected ? "true" : "false");
        if (DetailTemplate is not null && DetailPlacement == DetailPlacement.Inline)
            builder.AddAttribute(9, "aria-expanded", rowExpanded ? "true" : "false");
        // Add onclick when row click should fire RowClicked or surface a Drawer/Window detail.
        // Inline-detail rows are toggled exclusively via the chevron, not by clicking the row.
        var rowClickActive = RowClicked.HasDelegate
            || (DetailTemplate is not null && DetailPlacement != DetailPlacement.Inline);
        if (rowClickActive)
        {
            builder.AddAttribute(3, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => OnRowClickAsync(itemLocal)));
        }
        // Only add oncontextmenu handler if OnRowContextMenu delegate is set
        if (OnRowContextMenu.HasDelegate)
        {
            builder.AddAttribute(4, "oncontextmenu", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, e => OnRowContextMenuInternal(e, itemLocal, null)));
            builder.AddEventPreventDefaultAttribute(5, "oncontextmenu", true);
        }

        // Only add ondblclick handler if RowDoubleClicked callback is set
        if (RowDoubleClicked.HasDelegate)
        {
            builder.AddAttribute(6, "ondblclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => OnRowDoubleClickAsync(itemLocal)));
        }

