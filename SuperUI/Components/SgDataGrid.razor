@typeparam TItem
@using Microsoft.AspNetCore.Components.Web
@using SuperUI.Localization

<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

<CascadingValue Value="Localizer" IsFixed="false">
<div class="sg-root @(ShowColumnBorders ? "sg-col-borders" : "") @(_editModalVisible ? "sg-modal-open" : "") @CssClass" 
     id="@_gridId" 
     @ref="_gridRootRef" 
     @onclick="CloseFilterMenuAsync" 
     @onclick:stopPropagation="false"
     @onkeydown="HandleKeyDownAsync"
     tabindex="0"
     style="outline: none;">
    <div class="sg-toolbar">
        @if (!string.IsNullOrEmpty(Title))
        {
            <div class="sg-title">@Title</div>
        }
        @foreach (var gk in GroupByKeys)
        {
            var gcol = GetColumnByKey(gk);
            if (gcol is null) continue;
            <div class="sg-chip sg-group-chip">
                <span>@Localizer["DataGrid_Group"]: @gcol.Title</span>
                <button type="button" class="sg-chip-x" title="@Localizer["DataGrid_RemoveGroup"]" aria-label="@Localizer["DataGrid_RemoveGroup"]" @onclick="async () => await ToggleGroupByAsync(gk)">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
        }
        @foreach (var sortRule in SortRules)
        {
            var scol = GetColumnByKey(sortRule.Key);
            if (scol is null) continue;
            <div class="sg-chip sg-sort-chip">
                <span class="sg-chip-icon">
                    @if (sortRule.Dir == SortDirection.Ascending)
                    {
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"></polyline></svg>
                    }
                    else
                    {
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    }
                </span>
                <span>@scol.Title</span>
                <button type="button" class="sg-chip-x" title="@Localizer["Clear"]" aria-label="@Localizer["Clear"]" @onclick="async () => await RemoveSortAsync(sortRule.Key)">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
        }
        <div class="sg-spacer"></div>
        @if (ShowSearch)
        {
            <div class="sg-search-wrap">
                <svg class="sg-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input class="sg-search"
                       placeholder="@Localizer["DataGrid_Search"]"
                       value="@_search"
                       @oninput="OnSearchInput" />
            </div>
        }
        @if (CanCreateInlineItem)
        {
            <button type="button" class="sg-btn primary" @onclick="StartCreateModalAsync">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                @Localizer["DataGrid_Add"]
            </button>
        }
        @if (HasUndoDelete)
        {
            <button type="button" class="sg-btn" @onclick="UndoDeleteAsync">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;"><path d="M3 2v6h6"></path><path d="M3 13a9 9 0 1 0 3-7.7L3 8"></path></svg>
                @Localizer["DataGrid_UndoDelete"]
            </button>
        }
        @if (HasActiveFilters)
        {
            <button type="button" class="sg-btn" @onclick="ClearAllFiltersAsync" title="@Localizer["DataGrid_ResetFilters"]">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"></path><line x1="18" y1="9" x2="12" y2="15"></line><line x1="12" y1="9" x2="18" y2="15"></line></svg>
                @Localizer["DataGrid_ResetFilters"]
            </button>
        }
        @if (HasActiveSort)
        {
            <button type="button" class="sg-btn" @onclick="ClearSortAsync" title="@Localizer["DataGrid_ResetSort"]">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;"><path d="M11 5h10"></path><path d="M11 9h7"></path><path d="M11 13h4"></path><path d="M3 17l3 3 3-3"></path><line x1="6" y1="18" x2="6" y2="4"></line></svg>
                @Localizer["DataGrid_ResetSort"]
            </button>
        }
        @if (AllowAutoFit)
        {
            <button type="button" class="sg-btn" @onclick="AutoFitAsync" title="@Localizer["DataGrid_AutoFit"]">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;"><polyline points="4 8 4 4 8 4"></polyline><polyline points="16 4 20 4 20 8"></polyline><polyline points="20 16 20 20 16 20"></polyline><polyline points="8 20 4 20 4 16"></polyline></svg>
                @Localizer["DataGrid_AutoFit"]
            </button>
        }
        @if (ShowColumnChooser)
        {
            <div @ref="_chooserRef" class="sg-chooser-wrap" @onclick:stopPropagation="true" @onfocusout="HandleChooserFocusOutAsync" tabindex="-1">
                <button type="button" class="sg-btn" @onclick="ToggleChooserAsync" title="@Localizer["DataGrid_Columns"]">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="3" x2="12" y2="21"></line></svg>
                    @Localizer["DataGrid_Columns"]
                </button>
                @if (_showChooser)
                {
                    <div class="sg-chooser-menu">
                        <div class="sg-chooser-head">@Localizer["DataGrid_ShowColumns"]</div>
                        @foreach (var col in _columns)
                        {
                            var k = col.Key;
                            <label class="sg-chooser-item">
                                <input type="checkbox"
                                       checked="@(!IsColumnHidden(k))"
                                       @onchange="@(e => ToggleColumnHiddenAsync(k, e.Value is not true))" />
                                <span>@col.Title</span>
                            </label>
                        }
                    </div>
                }
            </div>
        }
@if (ShowExportCsv || ShowExportExcel)
         {
             <div @ref="_exportRef" class="sg-chooser-wrap" @onclick:stopPropagation="true" @onfocusout="HandleExportFocusOutAsync" tabindex="-1">
                 <button type="button" class="sg-btn" @onclick="ToggleExportMenuAsync" title="@Localizer["DataGrid_Export"]">
                     <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                     @Localizer["DataGrid_Export"]
                 </button>
                 @if (_showExportMenu)
                 {
                     <div class="sg-chooser-menu">
                         @if (ShowExportCsv)
                         {
                             <button type="button" class="sg-chooser-item sg-btn-link" @onclick="async () => { await ExportCsvAsync(); _showExportMenu = false; }">@Localizer["DataGrid_ExportCsv"]</button>
                         }
                         @if (ShowExportExcel)
                         {
                             <button type="button" class="sg-chooser-item sg-btn-link" @onclick="async () => { await ExportExcelAsync(); _showExportMenu = false; }">@Localizer["DataGrid_ExportExcel"]</button>
                         }
                     </div>
                 }
             </div>
         }
@if (GroupByKeys.Count > 0)
        {
            <div class="sg-btn-group">
                <button type="button" class="sg-btn" @onclick="ExpandAllGroupsAsync" title="@Localizer["ExpandAll"]" aria-label="@Localizer["ExpandAll"]">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path><line x1="12" y1="11" x2="12" y2="17"></line><line x1="9" y1="14" x2="15" y2="14"></line></svg>
                </button>
                <button type="button" class="sg-btn" @onclick="CollapseAllGroupsAsync" title="@Localizer["CollapseAll"]" aria-label="@Localizer["CollapseAll"]">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path><line x1="9" y1="14" x2="15" y2="14"></line></svg>
                </button>
            </div>
        }
        
        @if (SelectionEnabled && SelectedItems.Count > 0)
         {
             <div class="sg-chip">@Localizer["DataGrid_Selected"]: @SelectedItems.Count</div>
             <button type="button" class="sg-btn" @onclick="ClearSelectionAsync">@Localizer["Clear"]</button>
         }
        @if (ToolbarContent is not null)
        {
            <div class="sg-toolbar-custom">@ToolbarContent</div>
        }
    </div>

    <div class="sg-scroll">
        @{
            var visibleCols = VisibleColumns;
        }
        <table class="sg-table @(FullWidth ? "sg-table-full" : "")" role="grid">
            <thead>
                <tr>
                    @if (DetailTemplate is not null && DetailPlacement == DetailPlacement.Inline)
                    {
                        <th class="sg-col-expand"></th>
                    }
                    @if (SelectionEnabled)
                    {
<th class="sg-col-check sg-pinned" style="left: 0;">
                               <input type="checkbox"
                                      aria-label="@Localizer["DataGrid_SelectAll"]"
                                      checked="@AllFilteredSelected"
                                      @onchange="OnToggleAllAsync" />
                           </th>
                    }
                    @for (var i = 0; i < visibleCols.Count; i++)
                    {
                        var col = visibleCols[i];
                        var key = col.Key;
                        var sort = GetSort(key);
                        var sortIdx = _sort.Count > 1 ? GetSortIndex(key) : 0;
                        var hasFilter = _filters.ContainsKey(key);
                        var menuSide = i >= visibleCols.Count - 1 ? "right" : "left";
                        var widthStyle = GetColumnWidthStyle(col);
                        var pinStyle = GetColumnPinStyle(col);
                        var thClass = "sg-th" + (col.Pinned ? " sg-pinned" : "");
                        <th data-col-key="@key"
                            data-col-pinned="@(col.Pinned ? "1" : "0")"
                            draggable="@(col.Reorderable ? "true" : "false")"
                            aria-sort="@(col.Sortable ? (sort == SortDirection.Ascending ? "ascending" : sort == SortDirection.Descending ? "descending" : "none") : null)"
                            style="@(widthStyle + pinStyle)" class="@thClass">
                            <div class="sg-th-inner">
                                <span class="sg-th-title @(col.Sortable ? "sg-sortable" : "")"
                                      title="@(col.Sortable ? Localizer["DataGrid_Sort"] : "")"
                                      @onclick="@(async (MouseEventArgs e) => { if (col.Sortable) await ToggleSortAsync(key, e.CtrlKey || e.ShiftKey); })">
                                    @col.Title
                                    @if (sort == SortDirection.Ascending)
                                    {
                                        <span class="sg-sort-ind">
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"></polyline></svg>
                                            @(sortIdx > 0 ? sortIdx.ToString() : "")
                                        </span>
                                    }
                                    else if (sort == SortDirection.Descending)
                                    {
                                        <span class="sg-sort-ind">
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                            @(sortIdx > 0 ? sortIdx.ToString() : "")
                                        </span>
                                    }
                                </span>
                                @if (col.Filterable)
                                {
                                    <button type="button" class="sg-filter-btn @(hasFilter ? "active" : "")"
                                            aria-label="Фильтр @col.Title"
                                            @onclick:stopPropagation="true"
                                            @onclick="async () => await ToggleFilterMenuAsync(key)">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
                                    </button>
                                }
                            </div>
                            @if (_openFilterColumn == key)
                            {
                                <div class="sg-filter-menu sg-filter-menu--@menuSide" @onclick:stopPropagation="true">

                                    @* AND / OR toggle *@
                                    @if (PendingRules.Count > 1)
                                    {
                                        <div class="sg-filter-logic" @onclick:stopPropagation="true">
                                            <button class="sg-btn sg-sm @(PendingRulesAnd ? "sg-btn-active" : "")" type="button"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="async () => await SetPendingRulesAndAsync(true)">AND</button>
                                            <button class="sg-btn sg-sm @(!PendingRulesAnd ? "sg-btn-active" : "")" type="button"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="async () => await SetPendingRulesAndAsync(false)">OR</button>
                                        </div>
                                    }

                                    @* Rules list *@
                                    @for (var ri = 0; ri < PendingRules.Count; ri++)
                                    {
                                        var rIdx = ri;
                                        var rule = PendingRules[rIdx];
                                        <div class="sg-filter-rule">
<select class="sg-filter-cond-select"
                                                     value="@rule.Condition.ToString()"
                                                     @onchange="async e => await SetPendingRuleConditionAsync(rIdx, Enum.Parse<FilterCondition>(e.Value!.ToString()!))">
                                                 <option value="Contains">@Localizer["DataGrid_FilterContains"]</option>
                                                 <option value="NotContains">@Localizer["DataGrid_FilterNotContains"]</option>
                                                 <option value="Equals">@Localizer["DataGrid_FilterEquals"]</option>
                                                 <option value="NotEquals">@Localizer["DataGrid_FilterNotEquals"]</option>
                                                 <option value="StartsWith">@Localizer["DataGrid_FilterStartsWith"]</option>
                                                 <option value="EndsWith">@Localizer["DataGrid_FilterEndsWith"]</option>
                                                 @if (IsNumericColumn(key))
                                                 {
                                                     <option value="GreaterThan">@Localizer["DataGrid_FilterGreaterThan"]</option>
                                                     <option value="LessThan">@Localizer["DataGrid_FilterLessThan"]</option>
                                                     <option value="GreaterOrEqual">@Localizer["DataGrid_FilterGreaterOrEqual"]</option>
                                                     <option value="LessOrEqual">@Localizer["DataGrid_FilterLessOrEqual"]</option>
                                                 }
                                                 <option value="IsEmpty">@Localizer["DataGrid_FilterIsEmpty"]</option>
                                                 <option value="IsNotEmpty">@Localizer["DataGrid_FilterIsNotEmpty"]</option>
                                             </select>
@if (rule.Condition != FilterCondition.IsEmpty && rule.Condition != FilterCondition.IsNotEmpty)
                                             {
                                                 <input class="sg-filter-rule-input"
                                                        placeholder="@Localizer["DataGrid_FilterValue"]"
                                                        value="@rule.Value"
                                                        @oninput="async e => await SetPendingRuleValueAsync(rIdx, e.Value?.ToString())" />
                                             }
                                            @if (PendingRules.Count > 1)
                                            {
                                                <button class="sg-filter-rule-del" type="button"
                                                         title="@Localizer["DataGrid_FilterRemoveCondition"]"
                                                         @onclick="async () => await RemovePendingRuleAsync(rIdx)">
                                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                </button>
                                            }
                                        </div>
                                    }

                                    @* Add rule *@
<div class="sg-filter-add-rule">
                                         <button class="sg-btn sg-sm" type="button" @onclick="AddPendingRuleAsync">@Localizer["DataGrid_FilterAddCondition"]</button>
                                     </div>

                                     @* Quick apply *@
                                     <div class="sg-filter-cond-apply">
                                         <button class="sg-btn primary" style="width:100%" type="button"
                                                 @onclick="async () => await ApplyConditionFilterAsync(key)">
                                             @Localizer["DataGrid_FilterApply"]
                                         </button>
                                     </div>

                                     @* Divider *@
                                     <div class="sg-filter-divider">@Localizer["DataGrid_FilterOrValues"]</div>

                                    @* Checkbox list *@
                                    <div class="sg-filter-search" style="padding: 0 0 8px 0; position: relative; display: flex; align-items: center;">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 8px; color: var(--sg-muted); pointer-events: none;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                        <input class="sg-quick-filter-input" 
                                               style="padding-left: 28px;"
                                               placeholder="@Localizer["DataGrid_QuickFilter"]..."
                                               value="@_filterMenuSearchText"
                                               @oninput="@(e => { _filterMenuSearchText = e.Value?.ToString() ?? string.Empty; })" />
                                    </div>
                                    <div class="sg-filter-actions">
<label class="sg-filter-all">
                                             <input type="checkbox"
                                                    checked="@IsPendingAllSelected(key)"
                                                    @onchange="@(e => TogglePendingAllAsync(key, e.Value is true))" />
                                             @Localizer["DataGrid_FilterAll"]
                                         </label>
                                    </div>
<div class="sg-filter-list">
                                         @foreach (var val in GetDistinctValuesForColumn(key).Where(v => string.IsNullOrEmpty(_filterMenuSearchText) || (v?.Contains(_filterMenuSearchText, StringComparison.OrdinalIgnoreCase) ?? false)))
                                         {
                                             var display = val ?? Localizer["DataGrid_FilterEmpty"];
                                             var selected = IsPendingValueSelected(val);
                                             <label class="sg-filter-item" @key="val">
                                                 <input type="checkbox"
                                                        checked="@selected"
                                                        @onchange="@(e => TogglePendingValueAsync(val, e.Value is true))" />
                                                 <span>@display</span>
                                             </label>
                                         }
                                     </div>

                                     @* Footer *@
                                     <div class="sg-filter-foot">
                                         <button type="button" class="sg-btn" title="@(IsGroupedBy(key) ? Localizer["DataGrid_FilterUnGroupBy"] : Localizer["DataGrid_FilterGroupBy"])"
                                                 @onclick="async () => await ToggleGroupByAsync(key)">
                                             @(IsGroupedBy(key) ? Localizer["DataGrid_FilterUnGroupBy"] : Localizer["DataGrid_FilterGroupBy"])
                                         </button>
                                         <div class="sg-spacer"></div>
                                         <button type="button" class="sg-btn" @onclick="async () => await ClearPendingAsync(key)">@Localizer["DataGrid_FilterReset"]</button>
                                         <button type="button" class="sg-btn" @onclick="CloseFilterMenuAsync">@Localizer["DataGrid_FilterCancel"]</button>
                                         <button type="button" class="sg-btn primary" @onclick="ApplyFilterAsync">@Localizer["DataGrid_FilterOk"]</button>
                                     </div>
                                </div>
                            }
                            @if (col.Resizable)
                            {
                                <div class="sg-resizer" data-col-key="@key"></div>
                            }
                        </th>
                    }
                    @if (AllowEdit || AllowDelete)
                    {
                        <th class="sg-th sg-col-actions sg-pinned" style="right:0;"></th>
                    }
                </tr>
@if (ShowQuickFilters)
                     {
                         <tr class="sg-quick-filter-row">
                             @if (DetailTemplate is not null && DetailPlacement == DetailPlacement.Inline)
                             {
                                 <th class="sg-col-expand"></th>
                             }
                             @if (SelectionEnabled)
                             {
                                 <th class="sg-col-check sg-pinned" style="left:0;"></th>
                             }
                             @foreach (var col in visibleCols)
                             {
                                 var widthStyle = GetColumnWidthStyle(col);
                                 var pinStyle = GetColumnPinStyle(col);
                                 var thClass = "sg-th" + (col.Pinned ? " sg-pinned" : "");
                                 <th class="@($"{thClass} sg-quick-filter-cell")" style="@(widthStyle + pinStyle)">
                                     @if (col.Filterable)
                                     {
                                         var filterType = GetColumnFilterType(col.Key);
                                         if (filterType == "bool")
                                         {
                                             <select class="sg-quick-filter-input"
                                                     value="@(_quickFilters.TryGetValue(col.Key, out var quickBoolValue) ? quickBoolValue : string.Empty)"
                                                     @onchange="@(e => OnQuickFilterInputAsync(col.Key, e))">
                                                 <option value="">@Localizer["DataGrid_FilterAll"]</option>
                                                 <option value="true">@Localizer["DataGrid_FilterTrue"]</option>
                                                 <option value="false">@Localizer["DataGrid_FilterFalse"]</option>
                                             </select>
                                         }
                                         else
                                         {
                                             <input class="sg-quick-filter-input"
                                                    placeholder="@Localizer["DataGrid_QuickFilter"]"
                                                    type="@(filterType == "number" ? "number" : filterType == "date" ? "date" : "text")"
                                                    value="@(_quickFilters.TryGetValue(col.Key, out var quickValue) ? quickValue : string.Empty)"
                                                    @oninput="@(e => OnQuickFilterInputAsync(col.Key, e))" />
                                         }
                                     }
                                 </th>
                             }
                             @if (AllowEdit || AllowDelete)
                             {
                                 <th class="sg-th sg-col-actions sg-pinned" style="right:0;"></th>
                             }
                         </tr>
                     }
            </thead>
            <tbody>
                @if (Loading)
                {
                    @for (var r = 0; r < 5; r++)
                    {
                        <tr>
                            @if (SelectionEnabled) { <td><SgSkeleton Width="16px" Height="16px" Shape="rect" /></td> }
                            @if (DetailTemplate is not null) { <td></td> }
                            @foreach (var col in _columns.Where(c => !c.Hidden))
                            {
                                <td><SgSkeleton Width="80%" Height="14px" /></td>
                            }
                            @if (AllowEdit || AllowDelete) { <td></td> }
                        </tr>
                    }
                }
                else
                {
                    var hasGroups = GroupByKeys.Count > 0;
                    var rows = hasGroups ? new List<TItem>() : GetVisibleRows();
                    var tree = hasGroups ? BuildGroupTree() : null;
                    var totalVisible = hasGroups ? TotalFilteredCount : rows.Count;
                    var useVirtualization = ShouldUseVirtualization() && !hasGroups;
                    var (startIndex, endIndex, topPadding, bottomPadding) = useVirtualization ? CalculateVirtualWindow() : (0, rows.Count - 1, 0, 0);

                    @if (totalVisible == 0)
                    {
                        <tr>
                            <td class="sg-empty" colspan="@ColumnSpan">
                                @if (EmptyDataTemplate is not null)
                                {
                                    @EmptyDataTemplate
                                }
                                else
                                {
                                    @EffectiveEmptyText
                                }
                            </td>
                        </tr>
                    }
                    else if (hasGroups && tree is not null)
                    {
                        @RenderGroups(tree, visibleCols)
                    }
                    else
                    {
                        @if (useVirtualization && topPadding > 0)
                        {
                            <tr style="height: @(topPadding)px;"><td colspan="@ColumnSpan"></td></tr>
                        }
                        @foreach (var row in rows)
                        {
                            @RenderRow(row, visibleCols, 0)
                        }
                        @if (useVirtualization && bottomPadding > 0)
                        {
                            <tr style="height: @(bottomPadding)px;"><td colspan="@ColumnSpan"></td></tr>
                        }
                    }
                }
            </tbody>
            @if (ShowStatusBar && visibleCols.Any(c => c.Aggregate != Aggregate.None))
            {
                <tfoot>
                    <tr>
                        @if (DetailTemplate is not null && DetailPlacement == DetailPlacement.Inline)
                        {
                            <td class="sg-agg sg-col-expand"></td>
                        }
                        @if (SelectionEnabled)
                        {
                            <td class="sg-agg sg-col-check sg-pinned" style="left:0;"></td>
                        }
                        @foreach (var col in visibleCols)
                        {
                            var pinStyle = GetColumnPinStyle(col);
                            var aggClass = "sg-agg" + (col.Pinned ? " sg-pinned" : "");
                            <td class="@aggClass" style="@pinStyle">
                                @{
                                    var agg = ComputeAggregate(col);
                                }
                                @if (agg is not null)
                                {
                                    <span class="sg-agg-label">@col.Aggregate:</span>
                                    <span class="sg-agg-val">@agg</span>
                                }
                            </td>
                        }
                        @if (AllowEdit || AllowDelete)
                        {
                            <td class="sg-agg sg-col-actions sg-pinned" style="right:0;"></td>
                        }
                    </tr>
                </tfoot>
            }
        </table>
    </div>

    <div class="sg-foot">
        @{
            var filtered = TotalFilteredCount;
            var tp = TotalPages;
            var from = filtered == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;
            var to = Math.Min(filtered, CurrentPage * PageSize);
        }
        <span class="sg-foot-info">
            @if (EnablePaging && !ShouldUseVirtualization())
            {
                @($"{from}–{to} {Localizer["DataGrid_RowsOf"]} {filtered}")
            }
            else
            {
                @($"{Localizer["DataGrid_RowsShown"]} {filtered}")
            }
            @if (SelectedItems.Count > 0)
            {
                <span class="sg-foot-sel"> @Localizer["DataGrid_RowsSelectedCount"]: @SelectedItems.Count</span>
            }
        </span>
        @if (EnablePaging && !ShouldUseVirtualization())
        {
            <div class="sg-pager">
                <label class="sg-pager-size">
                    <select @onchange="OnPageSizeChange" value="@PageSize">
                        @foreach (var s in PageSizeOptions)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </label>
                <button type="button" class="sg-page-btn" disabled="@(CurrentPage <= 1)"
                        @onclick="() => GoToPageAsync(1)" aria-label="@Localizer["DataGrid_PageFirst"]">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="11 17 6 12 11 7"></polyline><polyline points="18 17 13 12 18 7"></polyline></svg>
                </button>
                <button type="button" class="sg-page-btn" disabled="@(CurrentPage <= 1)"
                        @onclick="() => GoToPageAsync(CurrentPage - 1)" aria-label="@Localizer["DataGrid_PagePrev"]">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </button>
                @foreach (var p in GetPageWindow())
                {
                    if (p == -1)
                    {
                        <span class="sg-page-gap">…</span>
                    }
                    else
                    {
                        var pageNum = p;
                        <button type="button" class="sg-page-btn @(pageNum == CurrentPage ? "current" : "")"
                                @onclick="() => GoToPageAsync(pageNum)">@pageNum</button>
                    }
                }
                <button type="button" class="sg-page-btn" disabled="@(CurrentPage >= tp)"
                        @onclick="() => GoToPageAsync(CurrentPage + 1)" aria-label="@Localizer["DataGrid_PageNext"]">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </button>
                <button type="button" class="sg-page-btn" disabled="@(CurrentPage >= tp)"
                        @onclick="() => GoToPageAsync(tp)" aria-label="@Localizer["DataGrid_PageLast"]">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="13 17 18 12 13 7"></polyline><polyline points="6 17 11 12 6 7"></polyline></svg>
                </button>
            </div>
        }
    </div>
</div>
</CascadingValue>

@if (DetailTemplate is not null && _detailItem is not null && _detailDrawerVisible)
{
    <div class="sgc-drawer-backdrop" @onclick="CloseDetail">
        <aside class="sgc-drawer sgc-drawer-right" style="width:420px;max-width:100vw;"
               @onclick:stopPropagation="true">
            <div class="sgc-drawer-header">
                <span class="sgc-drawer-title">@EffectiveDetailDrawerTitle</span>
                <button type="button" class="sgc-modal-x" aria-label="@Localizer["Close"]"
                        @onclick="CloseDetail">×</button>
            </div>
            <div class="sgc-drawer-body">
                @DetailTemplate!(_detailItem!)
            </div>
        </aside>
    </div>
}

@if (DetailTemplate is not null && _detailItem is not null && _detailWindowVisible)
{
    <div class="sgc-win" style="position:fixed;left:120px;top:120px;width:@(DetailWindowWidth)px;height:@(DetailWindowHeight)px;z-index:2000;">
        <div class="sgc-win-header">
            <span class="sgc-win-title">@EffectiveDetailWindowTitle</span>
            <div class="sgc-win-actions">
                <button type="button" class="sgc-win-btn sgc-win-close" aria-label="@Localizer["Close"]"
                        @onclick="CloseDetail">×</button>
            </div>
        </div>
        <div class="sgc-win-body">@DetailTemplate!(_detailItem!)</div>
    </div>
}

@if (_editModalVisible && _editModalItem is not null)
{
    <SgModal Visible="true"
             Title="@_editModalTitle"
             Width="@_editModalWidth"
             CloseOnBackdrop="true"
             CloseOnEscape="true"
             OnClose="CloseEditModal">
        <ChildContent>
            @RenderEditForm()
        </ChildContent>
    </SgModal>
}

@code {
    private RenderFragment RenderGroups(List<GroupNode> nodes, IReadOnlyList<SgDataGridColumn<TItem>> cols) => builder =>
    {
        foreach (var node in nodes)
        {
            var nodeLocal = node;
            var collapsed = IsGroupCollapsed(nodeLocal.Path);
            builder.OpenElement(0, "tr");
            builder.AddAttribute(1, "class", "sg-group-row");
            builder.AddAttribute(19, "role", "row");
            builder.AddAttribute(20, "aria-expanded", collapsed ? "false" : "true");
            builder.OpenElement(2, "td");
            builder.AddAttribute(3, "class", "sg-group-cell");
            builder.AddAttribute(4, "colspan", ColumnSpan);
            builder.AddAttribute(5, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => ToggleGroupCollapsedAsync(nodeLocal.Path)));
            builder.OpenElement(6, "span");
            builder.AddAttribute(7, "class", "sg-group-indent");
            builder.AddAttribute(8, "style", $"padding-left:{nodeLocal.Depth * 16}px;");
            builder.CloseElement();
            builder.OpenElement(9, "span");
            builder.AddAttribute(10, "class", "sg-group-toggle");
            if (collapsed)
            {
                builder.AddContent(11, (RenderFragment)(b => {
                    b.OpenElement(0, "svg");
                    b.AddAttribute(1, "width", "10");
                    b.AddAttribute(2, "height", "10");
                    b.AddAttribute(3, "viewBox", "0 0 24 24");
                    b.AddAttribute(4, "fill", "none");
                    b.AddAttribute(5, "stroke", "currentColor");
                    b.AddAttribute(6, "stroke-width", "3");
                    b.AddAttribute(7, "stroke-linecap", "round");
                    b.AddAttribute(8, "stroke-linejoin", "round");
                    b.OpenElement(9, "polyline");
                    b.AddAttribute(10, "points", "9 18 15 12 9 6");
                    b.CloseElement();
                    b.CloseElement();
                }));
            }
            else
            {
                builder.AddContent(11, (RenderFragment)(b => {
                    b.OpenElement(0, "svg");
                    b.AddAttribute(1, "width", "10");
                    b.AddAttribute(2, "height", "10");
                    b.AddAttribute(3, "viewBox", "0 0 24 24");
                    b.AddAttribute(4, "fill", "none");
                    b.AddAttribute(5, "stroke", "currentColor");
                    b.AddAttribute(6, "stroke-width", "3");
                    b.AddAttribute(7, "stroke-linecap", "round");
                    b.AddAttribute(8, "stroke-linejoin", "round");
                    b.OpenElement(9, "polyline");
                    b.AddAttribute(10, "points", "6 9 12 15 18 9");
                    b.CloseElement();
                    b.CloseElement();
                }));
            }
            builder.CloseElement();
            builder.OpenElement(12, "span");
            builder.AddAttribute(13, "class", "sg-group-label");
            builder.AddContent(14, $"{nodeLocal.Column.Title}: {nodeLocal.Label}");
            builder.CloseElement();
            builder.OpenElement(15, "span");
            builder.AddAttribute(16, "class", "sg-group-count");
            builder.AddContent(17, $" ({nodeLocal.TotalCount})");
            builder.CloseElement();
            builder.CloseElement();
            builder.CloseElement();

            if (!collapsed)
            {
                if (nodeLocal.Children.Count > 0)
                    builder.AddContent(18, RenderGroups(nodeLocal.Children, cols));
                foreach (var item in nodeLocal.Items)
                    builder.AddContent(19, RenderRow(item, cols, nodeLocal.Depth + 1));
            }
        }
    };

    private RenderFragment RenderRow(TItem item, IReadOnlyList<SgDataGridColumn<TItem>> cols, int indent) => builder =>
    {
        var itemLocal = item;
        // Only check selection if selection is enabled to avoid unnecessary HashSet lookups
        var isSelected = SelectionEnabled ? SelectedItems.Contains(itemLocal) : false;
        // NOTE: Do NOT check IsActiveRow() here - this would trigger re-render on every active row change
        // The sg-active class is managed by JavaScript to avoid full grid re-renders
        var rowExpanded = DetailTemplate is not null && DetailPlacement == DetailPlacement.Inline && IsRowExpanded(itemLocal);
        
        builder.OpenElement(0, "tr");
        builder.SetKey(itemLocal);
        // Only apply sg-selected class, sg-active is managed by JavaScript
        builder.AddAttribute(1, "class", isSelected ? "sg-selected" : "");
        builder.AddAttribute(2, "role", "row");
        if (SelectionEnabled)
            builder.AddAttribute(8, "aria-selected", isSelected ? "true" : "false");
        if (DetailTemplate is not null && DetailPlacement == DetailPlacement.Inline)
            builder.AddAttribute(9, "aria-expanded", rowExpanded ? "true" : "false");
        // Add onclick when row click should fire RowClicked or surface a Drawer/Window detail.
        // Inline-detail rows are toggled exclusively via the chevron, not by clicking the row.
        var rowClickActive = RowClicked.HasDelegate
            || (DetailTemplate is not null && DetailPlacement != DetailPlacement.Inline);
        if (rowClickActive)
        {
            builder.AddAttribute(3, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => OnRowClickAsync(itemLocal)));
        }
        // Only add oncontextmenu handler if OnRowContextMenu delegate is set
        if (OnRowContextMenu.HasDelegate)
        {
            builder.AddAttribute(4, "oncontextmenu", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, e => OnRowContextMenuInternal(e, itemLocal, null)));
            builder.AddEventPreventDefaultAttribute(5, "oncontextmenu", true);
        }

        // Only add ondblclick handler if RowDoubleClicked callback is set
        if (RowDoubleClicked.HasDelegate)
        {
            builder.AddAttribute(6, "ondblclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => OnRowDoubleClickAsync(itemLocal)));
        }

        var seq = 10;

        if (DetailTemplate is not null && DetailPlacement == DetailPlacement.Inline)
        {
            builder.OpenElement(seq++, "td");
            builder.AddAttribute(seq++, "class", "sg-cell sg-col-expand");
            builder.AddAttribute(seq++, "role", "gridcell");
            builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
            builder.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => OnRowExpandToggle(itemLocal)));
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "sg-expand-icon");
            if (rowExpanded)
            {
                builder.AddContent(seq++, (RenderFragment)(b => {
                    b.OpenElement(0, "svg");
                    b.AddAttribute(1, "width", "10");
                    b.AddAttribute(2, "height", "10");
                    b.AddAttribute(3, "viewBox", "0 0 24 24");
                    b.AddAttribute(4, "fill", "none");
                    b.AddAttribute(5, "stroke", "currentColor");
                    b.AddAttribute(6, "stroke-width", "3");
                    b.AddAttribute(7, "stroke-linecap", "round");
                    b.AddAttribute(8, "stroke-linejoin", "round");
                    b.OpenElement(9, "polyline");
                    b.AddAttribute(10, "points", "6 9 12 15 18 9");
                    b.CloseElement();
                    b.CloseElement();
                }));
            }
            else
            {
                builder.AddContent(seq++, (RenderFragment)(b => {
                    b.OpenElement(0, "svg");
                    b.AddAttribute(1, "width", "10");
                    b.AddAttribute(2, "height", "10");
                    b.AddAttribute(3, "viewBox", "0 0 24 24");
                    b.AddAttribute(4, "fill", "none");
                    b.AddAttribute(5, "stroke", "currentColor");
                    b.AddAttribute(6, "stroke-width", "3");
                    b.AddAttribute(7, "stroke-linecap", "round");
                    b.AddAttribute(8, "stroke-linejoin", "round");
                    b.OpenElement(9, "polyline");
                    b.AddAttribute(10, "points", "9 18 15 12 9 6");
                    b.CloseElement();
                    b.CloseElement();
                }));
            }
            builder.CloseElement();
            builder.CloseElement();
        }

        if (SelectionEnabled)
        {
            builder.OpenElement(seq++, "td");
            builder.AddAttribute(seq++, "class", "sg-cell sg-col-check sg-pinned");
            builder.AddAttribute(seq++, "style", "left:0;");
            builder.AddAttribute(seq++, "role", "gridcell");
            builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "checkbox");
            builder.AddAttribute(seq++, "class", "sg-row-checkbox");
            builder.AddAttribute(seq++, "checked", isSelected);
            builder.AddAttribute(seq++, "aria-label", Localizer["DataGrid_SelectRow"]);
            builder.AddAttribute(seq++, "onchange", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e => ToggleRowAsync(itemLocal, e.Value is true)));
            builder.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, e => HandleRowSelectionClickAsync(e, itemLocal)));
            builder.CloseElement();
            builder.CloseElement();
        }

        var first = true;
        foreach (var col in cols)
        {
            var colLocal = col;
            var widthStyle = GetColumnWidthStyle(colLocal);
            var pinStyle = GetColumnPinStyle(colLocal);
            var padStyle = first && indent > 0 ? $"padding-left:{8 + indent * 16}px;" : "";
            var tdClass = GetColumnTdClass(colLocal);

            builder.OpenElement(seq++, "td");
            builder.AddAttribute(seq++, "class", tdClass);
            builder.AddAttribute(seq++, "style", widthStyle + pinStyle + padStyle);
            builder.AddAttribute(seq++, "role", "gridcell");
            // Only add oncontextmenu handler if OnRowContextMenu delegate is set
            if (OnRowContextMenu.HasDelegate)
            {
                builder.AddAttribute(seq++, "oncontextmenu", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, e => OnRowContextMenuInternal(e, itemLocal, colLocal)));
                builder.AddEventPreventDefaultAttribute(seq++, "oncontextmenu", true);
                builder.AddEventStopPropagationAttribute(seq++, "oncontextmenu", true);
            }

            if (colLocal.Editable && colLocal.OnValueChanged is not null)
            {
                builder.AddAttribute(seq++, "ondblclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => StartCellEdit(itemLocal, colLocal)));
                builder.AddEventStopPropagationAttribute(seq++, "ondblclick", true);
            }

            if (IsEditingCell(itemLocal, colLocal))
            {
                builder.OpenElement(seq++, "input");
                builder.AddAttribute(seq++, "class", "sg-editor");
                builder.AddAttribute(seq++, "value", _editingCellValue);
                builder.AddAttribute(seq++, "oninput", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, OnCellEditInput));
                builder.AddAttribute(seq++, "onkeydown", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.KeyboardEventArgs>(this, e => OnCellEditKeyDownAsync(e, itemLocal, colLocal)));
                builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
                builder.AddEventStopPropagationAttribute(seq++, "onkeydown", true);
                builder.CloseElement();
            }
            else if (colLocal.Template is not null)
            {
                builder.AddContent(seq++, colLocal.Template(itemLocal));
            }
            else
            {
                var val = colLocal.GetValue(itemLocal);
                var type = colLocal.ValueType ?? (val?.GetType());
                if (type != null) type = Nullable.GetUnderlyingType(type) ?? type;

                if (type == typeof(bool) && val is bool boolVal)
                {
                    builder.OpenElement(seq++, "div");
                    builder.AddAttribute(seq++, "class", "sg-bool-cell");
                    builder.OpenElement(seq++, "input");
                    builder.AddAttribute(seq++, "type", "checkbox");
                    builder.AddAttribute(seq++, "checked", boolVal);
                    builder.AddAttribute(seq++, "disabled", true);
                    builder.AddAttribute(seq++, "class", "sg-checkbox-readonly");
                    builder.CloseElement();
                    builder.CloseElement();
                }
                else
                {
                    builder.AddContent(seq++, colLocal.GetDisplay(itemLocal));
                }
            }
            builder.CloseElement();
            first = false;
        }

        if (AllowEdit || AllowDelete)
        {
            builder.OpenElement(seq++, "td");
            builder.AddAttribute(seq++, "class", "sg-cell sg-col-actions sg-pinned");
            builder.AddAttribute(seq++, "style", "right:0;");
            builder.AddAttribute(seq++, "role", "gridcell");
            builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "sg-actions");

            if (AllowEdit)
            {
                builder.OpenElement(seq++, "button");
                builder.AddAttribute(seq++, "class", "sg-icon-btn primary");
                builder.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => StartEditModalAsync(itemLocal)));
                builder.AddAttribute(seq++, "title", Localizer["DataGrid_Edit"]);
                builder.OpenElement(seq++, "svg");
                builder.AddAttribute(seq++, "viewBox", "0 0 24 24");
                builder.AddAttribute(seq++, "width", "16");
                builder.AddAttribute(seq++, "height", "16");
                builder.OpenElement(seq++, "path");
                builder.AddAttribute(seq++, "fill", "currentColor");
                builder.AddAttribute(seq++, "d", "M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z");
                builder.CloseElement();
                builder.CloseElement();
                builder.CloseElement();
            }
            if (AllowDelete)
            {
                builder.OpenElement(seq++, "button");
                builder.AddAttribute(seq++, "class", "sg-icon-btn danger");
                builder.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => DeleteRowAsync(itemLocal)));
                builder.AddAttribute(seq++, "title", Localizer["DataGrid_Delete"]);
                builder.OpenElement(seq++, "svg");
                builder.AddAttribute(seq++, "viewBox", "0 0 24 24");
                builder.AddAttribute(seq++, "width", "16");
                builder.AddAttribute(seq++, "height", "16");
                builder.OpenElement(seq++, "path");
                builder.AddAttribute(seq++, "fill", "currentColor");
                builder.AddAttribute(seq++, "d", "M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z");
                builder.CloseElement();
                builder.CloseElement();
                builder.CloseElement();
            }
            builder.CloseElement(); // div sg-actions
            builder.CloseElement(); // td sg-col-actions
        }
        builder.CloseElement(); // tr

        if (rowExpanded)
        {
            builder.OpenElement(seq++, "tr");
            builder.AddAttribute(seq++, "class", "sg-detail-row");
            builder.SetKey($"detail-{(itemLocal is not null ? System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(itemLocal) : 0)}");
            builder.OpenElement(seq++, "td");
            builder.AddAttribute(seq++, "class", "sg-detail-cell");
            builder.AddAttribute(seq++, "colspan", ColumnSpan);
            builder.AddAttribute(seq++, "role", "gridcell");
            builder.AddContent(seq++, DetailTemplate!(itemLocal!));
            builder.CloseElement();
            builder.CloseElement();
        }
    };
}
