                        // Section header — синий заголовок с иконкой
                        db.OpenElement(s++, "div");
                        db.AddAttribute(s++, "class", "sg-auto-detail-label");
                        db.AddAttribute(s++, "style",
                            "display:flex;align-items:center;gap:8px;" +
                            "padding:7px 12px;" +
                            "background:var(--sg-accent,#006fee);" +
                            "font-size:11px;font-weight:700;color:#fff;" +
                            "text-transform:uppercase;letter-spacing:0.06em;");

                        // Icon: form vs grid
                        db.OpenElement(s++, "svg");
                        db.AddAttribute(s++, "width", "12");
                        db.AddAttribute(s++, "height", "12");
                        db.AddAttribute(s++, "viewBox", "0 0 24 24");
                        db.AddAttribute(s++, "fill", "none");
                        db.AddAttribute(s++, "stroke", "currentColor");
                        db.AddAttribute(s++, "stroke-width", "2.5");
                        db.AddAttribute(s++, "stroke-linecap", "round");
                        db.AddAttribute(s++, "stroke-linejoin", "round");
                        db.AddAttribute(s++, "style", "opacity:0.8;flex-shrink:0;");
                        db.OpenElement(s++, "path");
                        if (isCollection)
                            db.AddAttribute(s++, "d", "M3 3h18v18H3zM3 9h18M3 15h18M9 3v18");
                        else
                            db.AddAttribute(s++, "d", "M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11");
                        db.CloseElement(); // path
                        db.CloseElement(); // svg

                        db.AddContent(s++, adpLocal.Label);
                        db.CloseElement(); // header

                        // Content
                        db.OpenElement(s++, "div");
                        db.AddAttribute(s++, "class", "sg-auto-detail-content");
                        db.AddAttribute(s++, "style", "font-size:12px;");

                        if (adpLocal.Kind == AutoDetailKind.Object && propValue is not null)
                        {
                            var formType = typeof(SgDataForm<>).MakeGenericType(adpLocal.ItemType);
                            db.OpenComponent(s++, formType);
                            db.AddAttribute(s++, "Model", propValue);
                            db.AddAttribute(s++, "ReadOnly", true);
                            db.AddAttribute(s++, "AutoGenerate", true);
                            db.AddAttribute(s++, "Columns", 2);
                            db.CloseComponent();
                        }
                        else if (adpLocal.Kind == AutoDetailKind.Collection && propValue is System.Collections.IEnumerable enumerable)
                        {
                            var gridType = typeof(SgDataGrid<>).MakeGenericType(adpLocal.ItemType);
                            var itemsList = enumerable.Cast<object>().ToList();
                            var typedList = typeof(Enumerable)
                                .GetMethod(nameof(Enumerable.Cast))!
                                .MakeGenericMethod(adpLocal.ItemType)
                                .Invoke(null, new object[] { enumerable });
                            db.OpenComponent(s++, gridType);
                            db.AddAttribute(s++, "Items", typedList);
                            db.AddAttribute(s++, "AutoGenerateColumns", true);
                            db.AddAttribute(s++, "ShowSearch", false);
                            db.AddAttribute(s++, "ShowColumnChooser", false);
                            db.AddAttribute(s++, "ShowRowHighlighter", false);
                            db.AddAttribute(s++, "ShowSavedViews", false);
                            db.AddAttribute(s++, "EnablePaging", itemsList.Count > 10);
                            db.AddAttribute(s++, "PageSize", 10);
                            db.CloseComponent();
                        }
                        else if (propValue is null)
                        {
                            db.OpenElement(s++, "span");
                            db.AddAttribute(s++, "style", "padding:12px;color:var(--sg-muted,#9ca3af);font-style:italic;display:block;");
                            db.AddContent(s++, "—");
                            db.CloseElement();
                        }

                        db.CloseElement(); // content
                        db.CloseElement(); // section
                    }
                    db.CloseElement(); // sg-auto-detail
                }));
            }
            builder.CloseElement();
            builder.CloseElement();
        }
    };
}
