@typeparam TItem
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using SuperUI.Localization
@using SuperUI.Enums
@using SortDirection = SuperUI.Enums.SgDataGridSortDirection
@using System.Text

<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

<CascadingValue Value="Localizer" IsFixed="false">
<div class="sg-root @(ShowColumnBorders ? "sg-col-borders" : "") @(_editModalVisible || _bulkEditModalOpen ? "sg-modal-open" : "") @CssClass"
     id="@_gridId"
     @ref="_gridRootRef"
     @onclick="CloseFilterMenuAsync"
     @onclick:stopPropagation="false"
     @onkeydown="HandleKeyDownAsync"
     tabindex="0"
     style="outline: none; @(string.IsNullOrEmpty(Height) ? "" : $"height: {Height};")">
    <div class="sg-toolbar">
        @if (!string.IsNullOrEmpty(Title))
        {
            <div class="sg-title">@Title</div>
        }
        @foreach (var gk in GroupByKeys)
        {
            var gcol = GetColumnByKey(gk);
            if (gcol is null) continue;
            <div class="sg-chip sg-group-chip">
                <span>@Localizer["DataGrid_Group"]: @gcol.Title</span>
                <button type="button" class="sg-chip-x" title="@Localizer["DataGrid_RemoveGroup"]" aria-label="@Localizer["DataGrid_RemoveGroup"]" @onclick="async () => await ToggleGroupByAsync(gk)">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
        }
        @foreach (var sortRule in SortRules)
        {
            var scol = GetColumnByKey(sortRule.Key);
            if (scol is null) continue;
            <div class="sg-chip sg-sort-chip">
                <span class="sg-chip-icon">
                    @if (sortRule.Dir == SortDirection.Ascending)
                    {
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"></polyline></svg>
                    }
                    else
                    {
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    }
                </span>
                <span>@scol.Title</span>
                <button type="button" class="sg-chip-x" title="@Localizer["Common_Clear"]" aria-label="@Localizer["Common_Clear"]" @onclick="async () => await RemoveSortAsync(sortRule.Key)">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
        }
        <div class="sg-spacer"></div>
        @if (ShowSearch)
        {
            <div class="sg-search-wrap">
                <svg class="sg-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input class="sg-search"
                       placeholder="@Localizer["DataGrid_Search"]"
                       value="@_search"
                       @oninput="OnSearchInput" />
            </div>
        }
        @if (CanCreateInlineItem || UseModalForEdit)
        {
            <button type="button" class="sg-btn primary" @onclick="StartCreateModalAsync">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="sg-btn-icon"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                @Localizer["DataGrid_Add"]
            </button>
        }
        @if (AllowEdit && UseModalForEdit && SelectedItems.Count == 1)
        {
            <button type="button" class="sg-btn" @onclick="() => StartEditModalAsync(SelectedItems.First())">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="sg-btn-icon"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                @Localizer["DataGrid_Edit"]
            </button>
        }
        @if (HasUndoDelete)
        {
            <button type="button" class="sg-btn" @onclick="UndoDeleteAsync">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="sg-btn-icon"><path d="M3 2v6h6"></path><path d="M3 13a9 9 0 1 0 3-7.7L3 8"></path></svg>
                @Localizer["DataGrid_UndoDelete"]
            </button>
        }
        @if (HasActiveFilters)
        {
            <button type="button" class="sg-btn" @onclick="ClearAllFiltersAsync" title="@Localizer["DataGrid_ResetFilters"]">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="sg-btn-icon"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"></path><line x1="18" y1="9" x2="12" y2="15"></line><line x1="12" y1="9" x2="18" y2="15"></line></svg>
                @Localizer["DataGrid_ResetFilters"]
            </button>
        }
        @if (HasActiveSort)
        {
            <button type="button" class="sg-btn" @onclick="ClearSortAsync" title="@Localizer["DataGrid_ResetSort"]">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="sg-btn-icon"><path d="M11 5h10"></path><path d="M11 9h7"></path><path d="M11 13h4"></path><path d="M3 17l3 3 3-3"></path><line x1="6" y1="18" x2="6" y2="4"></line></svg>
                @Localizer["DataGrid_ResetSort"]
            </button>
        }
        @if (AllowAutoFit)
        {
            <button type="button" class="sg-btn" @onclick="AutoFitAsync" title="@Localizer["DataGrid_AutoFit"]">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="sg-btn-icon"><polyline points="4 8 4 4 8 4"></polyline><polyline points="16 4 20 4 20 8"></polyline><polyline points="20 16 20 20 16 20"></polyline><polyline points="8 20 4 20 4 16"></polyline></svg>
                @Localizer["DataGrid_AutoFit"]
            </button>
        }
        @if (ShowRowHighlighter)
        {
            <button type="button" class="sg-btn" @onclick="OpenRowHighlighterAsync" title="@Localizer["DataGrid_RowHighlighter"]">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="sg-btn-icon"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L3 14.67V21h6.33l10.06-10.06a5.5 5.5 0 0 0 1.45-6.33z"></path><path d="M14.5 17.5 3 21l3.5-11.5"></path></svg>
                @Localizer["DataGrid_RowHighlighter"]
            </button>
        }
        <div class="sg-chooser-wrap sg-sort-builder-wrap" @onclick:stopPropagation="true" tabindex="-1">
            <button type="button" class="sg-btn @(_showSortBuilder ? "active" : "")" @onclick="OpenSortBuilderAsync" title="@Localizer["DataGrid_SortBuilder"]">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="sg-btn-icon"><path d="M11 5h10"/><path d="M11 9h7"/><path d="M11 13h4"/><path d="M3 17l3 3 3-3"/><line x1="6" y1="20" x2="6" y2="4"/></svg>
                @Localizer["DataGrid_SortBuilder"]
            </button>
            @if (_showSortBuilder)
            {
                <div class="sg-sort-builder-backdrop" @onclick="() => _showSortBuilder = false"></div>
                <div class="sg-sort-builder-panel">
                    <div class="sg-sort-builder-layout">
                        <!-- Left: available columns -->
                        <div class="sg-sort-builder-cols">
                            <div class="sg-chooser-head">@Localizer["DataGrid_ColumnsChooser"]</div>
                            @foreach (var col in _columns.Where(c => c.Sortable && !_sortBuilderRules.Any(r => r.Key == c.Key)))
                            {
                                var colKey = col.Key;
                                <button type="button" class="sg-sort-col-item" @onclick="() => SortBuilderAddColumn(colKey)">
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                    @col.Title
                                </button>
                            }
                        </div>
                        <!-- Right: active sort rules -->
                        <div class="sg-sort-builder-rules">
                            <div class="sg-chooser-head">@Localizer["DataGrid_SortBuilder"]</div>
                            @if (_sortBuilderRules.Count == 0)
                            {
                                <div class="sg-sort-builder-empty">@Localizer["DataGrid_AddColumnsToSort"]</div>
                            }
                            @foreach (var rule in _sortBuilderRules)
                            {
                                var ruleKey = rule.Key;
                                var ruleCol = GetColumnByKey(ruleKey);
                                if (ruleCol is null) continue;
                                <div class="sg-sort-rule-row">
                                    <span class="sg-sort-rule-title">@ruleCol.Title</span>
                                    <button type="button" class="sg-sort-dir-btn @(rule.Dir == SortDirection.Ascending ? "active" : "")"
                                            title="@Localizer["DataGrid_SortAscending"]"
                                            @onclick="() => { if (rule.Dir != SortDirection.Ascending) SortBuilderToggleDir(ruleKey); }">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
                                        @Localizer["DataGrid_SortAsc"]
                                    </button>
                                    <button type="button" class="sg-sort-dir-btn @(rule.Dir == SortDirection.Descending ? "active" : "")"
                                            title="@Localizer["DataGrid_SortDescending"]"
                                            @onclick="() => { if (rule.Dir != SortDirection.Descending) SortBuilderToggleDir(ruleKey); }">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                                        @Localizer["DataGrid_SortDesc"]
                                    </button>
                                    <button type="button" class="sg-icon-btn" title="@Localizer["DataGrid_MoveUp"]" @onclick="() => SortBuilderMoveUp(ruleKey)">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
                                    </button>
                                    <button type="button" class="sg-icon-btn" title="@Localizer["DataGrid_MoveDown"]" @onclick="() => SortBuilderMoveDown(ruleKey)">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                                    </button>
                                    <button type="button" class="sg-icon-btn sg-sort-rule-remove" title="@Localizer["Common_Remove"]" @onclick="() => SortBuilderRemoveRule(ruleKey)">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="sg-sort-builder-footer">
                        <button type="button" class="sg-btn primary" @onclick="ApplySortBuilderAsync">@Localizer["Common_Apply"]</button>
                        <button type="button" class="sg-btn" @onclick="ResetSortBuilderAsync">@Localizer["Common_Reset"]</button>
                    </div>
                </div>
            }
        </div>
        <!-- Group Builder -->
        <div class="sg-chooser-wrap sg-sort-builder-wrap" @onclick:stopPropagation="true" tabindex="-1">
            <button type="button" class="sg-btn @(_showGroupBuilder ? "active" : "")" @onclick="OpenGroupBuilderAsync" title="@Localizer["DataGrid_GroupingBuilder"]">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="sg-btn-icon"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                @Localizer["DataGrid_GroupingBuilder"]
            </button>
            @if (_showGroupBuilder)
            {
                <div class="sg-sort-builder-backdrop" @onclick="() => _showGroupBuilder = false"></div>
                <div class="sg-sort-builder-panel" style="width:600px;">
                    <div class="sg-sort-builder-layout">
                        <!-- Left: available columns -->
                        <div class="sg-sort-builder-cols">
                            <div class="sg-chooser-head">@Localizer["DataGrid_ColumnsChooser"]</div>
                            @foreach (var col in _columns.Where(c => !_groupBuilderKeys.Contains(c.Key)))
                            {
                                var colKey = col.Key;
                                <button type="button" class="sg-sort-col-item" @onclick="() => GroupBuilderAddKey(colKey)">
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                    @col.Title
                                </button>
                            }
                        </div>
                        <!-- Right: active groups + aggregates -->
                        <div class="sg-sort-builder-rules" style="flex:1;min-width:0;">
                            <div class="sg-chooser-head">@Localizer["DataGrid_GroupingBuilder"]</div>
                            @if (_groupBuilderKeys.Count == 0)
                            {
                                <div class="sg-sort-builder-empty">@Localizer["DataGrid_AddColumnsToGroup"]</div>
                            }
                            @foreach (var gKey in _groupBuilderKeys)
                            {
                                var gKeyLocal = gKey;
                                var gCol = GetColumnByKey(gKeyLocal);
                                if (gCol is null) continue;
                                <div class="sg-sort-rule-row">
                                    <span class="sg-sort-rule-title">@gCol.Title</span>
                                    <button type="button" class="sg-icon-btn" title="@Localizer["DataGrid_MoveUp"]" @onclick="() => GroupBuilderMoveUp(gKeyLocal)">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
                                    </button>
                                    <button type="button" class="sg-icon-btn" title="@Localizer["DataGrid_MoveDown"]" @onclick="() => GroupBuilderMoveDown(gKeyLocal)">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                                    </button>
                                    <button type="button" class="sg-icon-btn sg-sort-rule-remove" title="@Localizer["Common_Remove"]" @onclick="() => GroupBuilderRemoveKey(gKeyLocal)">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                    </button>
                                </div>
                            }
                            @if (_columns.Any(c => ResolveIsNumericColumn(c)))
                            {
                                <div class="sg-chooser-head" style="margin-top:8px;">@Localizer["DataGrid_NumericAggregates"]</div>
                                @foreach (var col in _columns.Where(c => ResolveIsNumericColumn(c)))
                                {
                                    var aggKey = col.Key;
                                    var curAgg = _groupBuilderAggregates.TryGetValue(aggKey, out var a) ? a : Aggregate.None;
                                    <div class="sg-group-agg-row">
                                        <span class="sg-sort-rule-title">@col.Title</span>
                                        @foreach (var aggOpt in new[] { Aggregate.None, Aggregate.Sum, Aggregate.Average, Aggregate.Count, Aggregate.Min, Aggregate.Max })
                                        {
                                            var aggOptLocal = aggOpt;
                                            var aggLabel = aggOpt switch {
                                                Aggregate.None    => "—",
                                                Aggregate.Sum     => "Σ",
                                                Aggregate.Average => "Ø",
                                                Aggregate.Count   => "#",
                                                Aggregate.Min     => "↓",
                                                Aggregate.Max     => "↑",
                                                _                 => "—"
                                            };
                                            var aggTitle = aggOpt switch {
                                                Aggregate.None    => Localizer["None"],
                                                Aggregate.Sum     => Localizer["DataGrid_AggregateSum"],
                                                Aggregate.Average => Localizer["DataGrid_AggregateAverage"],
                                                Aggregate.Count   => Localizer["DataGrid_AggregateCount"],
                                                Aggregate.Min     => Localizer["DataGrid_AggregateMin"],
                                                Aggregate.Max     => Localizer["DataGrid_AggregateMax"],
                                                _                 => Localizer["None"]
                                            };
                                            <button type="button"
                                                    class="sg-sort-dir-btn @(curAgg == aggOptLocal ? "active" : "")"
                                                    title="@aggTitle"
                                                    @onclick="() => GroupBuilderSetAggregate(aggKey, aggOptLocal)">
                                                @aggLabel
                                            </button>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    <div class="sg-sort-builder-footer">
                        <button type="button" class="sg-btn primary" @onclick="ApplyGroupBuilderAsync">@Localizer["Common_Apply"]</button>
                        <button type="button" class="sg-btn" @onclick="ResetGroupBuilderAsync">@Localizer["Common_Reset"]</button>
                    </div>
                </div>
            }
        </div>
        @if (ShowSavedViews)
        {
            <div class="sg-chooser-wrap sg-sort-builder-wrap" @onclick:stopPropagation="true" tabindex="-1">
                <button type="button" class="sg-btn @(_showSavedViewsPanel ? "active" : "")"
                        @onclick="ToggleSavedViewsPanelAsync" title="@Localizer["DataGrid_SavedViews"]">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="sg-btn-icon">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                        <polyline points="17 21 17 13 7 13 7 21"/>
                        <polyline points="7 3 7 8 15 8"/>
                    </svg>
                    @Localizer["DataGrid_Views"]
                </button>
                @if (_showSavedViewsPanel)
                {
                    <div class="sg-sort-builder-backdrop" @onclick="() => _showSavedViewsPanel = false"></div>
                    <div class="sg-saved-views-panel">
                        <SgSavedViews TItem="TItem"
                                      Grid="this"
                                      StorageKey="@(SavedViewsStorageKey ?? PersistStateKey + "_views")"
                                      ShowResetButton="true"
                                      OnShareView="@(OnSaveViewToDb.HasDelegate ? EventCallback.Factory.Create<SgSavedViews<TItem>.SavedViewItem>(this, v => OnSaveViewToDb.InvokeAsync(v)) : default)" />
                        @if (DbViews is not null && DbViews.Any())
                        {
                            <div class="sg-sv-db-section">
                                <div class="sg-chooser-head">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;vertical-align:middle;"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
                                    @Localizer["DataGrid_FromDatabase"]
                                </div>
                                @foreach (var dbView in DbViews)
                                {
                                    var dbViewLocal = dbView;
                                    <div class="sg-sv-db-item">
                                        <button type="button" class="sg-sv-db-apply" @onclick="async () => { await ImportStateJsonAsync(dbViewLocal.StateJson); _showSavedViewsPanel = false; }">
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                                            @dbViewLocal.Name
                                        </button>
                                        @if (OnDeleteViewFromDb.HasDelegate)
                                        {
                                            <button type="button" class="sg-icon-btn sg-sort-rule-remove" title="@Localizer["Common_Delete"]" @onclick="() => OnDeleteViewFromDb.InvokeAsync(dbViewLocal.Id)">
                                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
        @if (ShowColumnChooser)
        {
            <div @ref="_chooserRef" class="sg-chooser-wrap" @onclick:stopPropagation="true" @onfocusout="HandleChooserFocusOutAsync" tabindex="-1">
                <button type="button" class="sg-btn" @onclick="ToggleChooserAsync" title="@Localizer["DataGrid_Columns"]">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="sg-btn-icon"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="3" x2="12" y2="21"></line></svg>
                    @Localizer["DataGrid_Columns"]
                </button>
                @if (_showChooser)
                {
                    <div class="sg-chooser-menu" @onclick:stopPropagation="true">
                        <div class="sg-chooser-head">@Localizer["DataGrid_ShowColumns"]</div>
                        <div class="sg-chooser-items-scroll">
                            @foreach (var col in _columns)
                            {
                                var k = col.Key;
                                <div class="sg-chooser-item sg-chooser-col-row">
                                    <label class="sg-chooser-col-vis">
                                        <input type="checkbox"
                                               checked="@(!IsColumnHidden(k))"
                                               @onchange="@(e => ToggleColumnHiddenAsync(k, e.Value is not true))" />
                                        <span>@col.Title</span>
                                    </label>
                                    <label class="sg-chooser-pin-label" title="@Localizer["DataGrid_PinColumn"]">
                                        <input type="checkbox"
                                               checked="@IsColumnPinned(k)"
                                               @onchange="@(e => ToggleColumnPinnedAsync(k, e.Value is true))" />
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="17" x2="12" y2="22"/><path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24Z"/></svg>
                                    </label>
                                </div>
                            }
                        </div>
                        <div class="sg-chooser-footer">
                            <button type="button" class="sg-btn primary" @onclick="ApplyChooserChangesAsync">@Localizer["DataGrid_Apply"]</button>
                            <button type="button" class="sg-btn" @onclick="CancelChooserChangesAsync">@Localizer["DataGrid_Cancel"]</button>
                        </div>
                    </div>
                }
            </div>
        }
@if (ShowExportCsv || ShowExportExcel)
         {
             <div @ref="_exportRef" class="sg-chooser-wrap" @onclick:stopPropagation="true" @onfocusout="HandleExportFocusOutAsync" tabindex="-1">
                 <button type="button" class="sg-btn" @onclick="ToggleExportMenuAsync" title="@Localizer["DataGrid_Export"]">
                     <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="sg-btn-icon"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                     @Localizer["DataGrid_Export"]
                 </button>
                 @if (_showExportMenu)
                 {
                     <div class="sg-chooser-menu">
                         @if (ShowExportCsv)
                         {
                             <button type="button" class="sg-chooser-item sg-btn-link" @onclick="async () => { await ExportCsvAsync(); _showExportMenu = false; }">@Localizer["DataGrid_ExportCsv"]</button>
                         }
                         @if (ShowExportExcel)
                         {
                             <button type="button" class="sg-chooser-item sg-btn-link" @onclick="async () => { await ExportExcelAsync(); _showExportMenu = false; }">@Localizer["DataGrid_ExportExcel"]</button>
                         }
                     </div>
                 }
             </div>
         }
@if (GroupByKeys.Count > 0)
        {
            <div class="sg-btn-group">
                <button type="button" class="sg-btn" @onclick="ExpandAllGroupsAsync" title="@Localizer["ExpandAll"]" aria-label="@Localizer["ExpandAll"]">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path><line x1="12" y1="11" x2="12" y2="17"></line><line x1="9" y1="14" x2="15" y2="14"></line></svg>
                </button>
                <button type="button" class="sg-btn" @onclick="CollapseAllGroupsAsync" title="@Localizer["CollapseAll"]" aria-label="@Localizer["CollapseAll"]">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path><line x1="9" y1="14" x2="15" y2="14"></line></svg>
                </button>
            </div>
        }
        @if (IsTree)
        {
            <div class="sg-btn-group">
                <button type="button" class="sg-btn" @onclick="ExpandAllTreeNodesAsync" title="@Localizer["ExpandAll"]" aria-label="@Localizer["ExpandAll"]">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path><line x1="12" y1="11" x2="12" y2="17"></line><line x1="9" y1="14" x2="15" y2="14"></line></svg>
                </button>
                <button type="button" class="sg-btn" @onclick="CollapseAllTreeNodesAsync" title="@Localizer["CollapseAll"]" aria-label="@Localizer["CollapseAll"]">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path><line x1="9" y1="14" x2="15" y2="14"></line></svg>
                </button>
            </div>
        }

        @{ var _bulkEditCols = AllowBulkEdit ? GetBulkEditableColumns() : null; }
        @if (SelectionEnabled && SelectedItems.Count > 0)
         {
             <div class="sg-chip">@Localizer["DataGrid_Selected"]: @SelectedItems.Count</div>
             <button type="button" class="sg-btn" @onclick="ClearSelectionAsync">@Localizer["Common_Clear"]</button>

             @if (_bulkEditCols is { Count: > 0 })
             {
                 <div class="sg-chooser-wrap sg-bulk-edit-wrap" @onclick:stopPropagation="true">
                     <button type="button" class="sg-btn sg-btn-bulk-edit" @onclick="OpenBulkEditPicker"
                             title="@Localizer["DataGrid_BulkEdit"]">
                         <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="sg-btn-icon"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                         @Localizer["DataGrid_BulkEdit"]
                     </button>
                     @if (_bulkEditPickerOpen)
                     {
                         <div class="sg-chooser-menu sg-bulk-edit-picker">
                             <div class="sg-chooser-head">@Localizer["DataGrid_BulkEditPickColumns"]</div>
                             @foreach (var col in _bulkEditCols!)
                             {
                                 var colKey = col.Key;
                                 <label class="sg-chooser-item">
                                     <input type="checkbox"
                                            checked="@_bulkEditSelectedColumns.Contains(colKey)"
                                            @onchange="@(e => ToggleBulkEditColumn(colKey, e.Value is true))" />
                                     <span>@col.Title</span>
                                 </label>
                             }
                             <div class="sg-bulk-edit-picker-footer">
                                 <button type="button" class="sg-btn primary"
                                         disabled="@(_bulkEditSelectedColumns.Count == 0)"
                                         @onclick="OpenBulkEditModal">
                                     @Localizer["DataGrid_BulkEditEdit"] (@_bulkEditSelectedColumns.Count)
                                 </button>
                             </div>
                         </div>
                     }
                 </div>
             }
         }
        @if (ToolbarContent is not null)
        {
            <div class="sg-toolbar-custom">@ToolbarContent</div>
        }
    </div>

    <div class="sg-scroll">
        @{
            var visibleCols = VisibleColumns;
        }
        <table class="sg-table @(FullWidth ? "sg-table-full" : "")" role="grid">
            <thead>
                <tr>
                    @if (ShowRowNumbers)
                    {
                         <th class="@GetTechnicalColumnClass("sg-th sg-col-num sg-pinned", "rownum")" style="position:sticky;top:0;left:0;z-index:4;background:var(--sg-header-bg);" aria-label="@Localizer["DataGrid_RowNumber"]">#</th>
                    }
                    @if ((DetailTemplate is not null || AutoDetail) && DetailPlacement == DetailPlacement.Inline)
                    {
                        <th class="@GetTechnicalColumnClass("sg-col-expand sg-pinned", "expand")" style="position:sticky;top:0;left:@(GetTechnicalColumnLeft("expand"))px;z-index:4;background:var(--sg-header-bg);"></th>
                    }
                    @if (IsTree)
                    {
                        <th class="@GetTechnicalColumnClass("sg-col-tree-expand sg-pinned", "tree")" style="position:sticky;top:0;left:@(GetTechnicalColumnLeft("tree"))px;z-index:4;background:var(--sg-header-bg);"></th>
                    }
                    @if (SelectionEnabled)
                    {
                        <th class="@GetTechnicalColumnClass("sg-col-check sg-pinned", "check")" style="position:sticky;top:0;left:@(GetTechnicalColumnLeft("check"))px;z-index:4;background:var(--sg-header-bg);">
                               @if (!AllowSingleSelect)
                               {
                                   <div style="display:flex;align-items:center;justify-content:center;height:100%;">
                                       <input type="checkbox"
                                              aria-label="@Localizer["DataGrid_SelectAll"]"
                                              checked="@AllFilteredSelected"
                                              @onchange="OnToggleAllAsync" />
                                   </div>
                               }
                           </th>
                    }
                    @for (var i = 0; i < visibleCols.Count; i++)
                    {
                        var col = visibleCols[i];
                        var key = col.Key;
                        var sort = GetSort(key);
                        var sortIdx = _sort.Count > 1 ? GetSortIndex(key) : 0;
                        var hasFilter = _filters.ContainsKey(key);
                        var menuSide = i >= visibleCols.Count - 1 ? "right" : "left";
                        var widthStyle = GetColumnWidthStyle(col);
                        var pinStyle = GetColumnPinStyleForHeader(col);
                        var thClass = "sg-th" + (IsColumnPinned(col.Key) ? " sg-pinned" : "");
                         // Header alignment: always left by default, regardless of column type
                         thClass += col.HeaderAlign switch
                         {
                             SgColumnAlign.Left   => " sg-align-left",
                             SgColumnAlign.Center => " sg-align-center",
                             SgColumnAlign.Right  => " sg-align-right",
                             _               => string.Empty
                         };
                        <th data-col-key="@key"
                            data-col-pinned="@(IsColumnPinned(col.Key) ? "1" : "0")"
                            draggable="@(col.Reorderable ? "true" : "false")"
                            aria-sort="@(col.Sortable ? (sort == SortDirection.Ascending ? "ascending" : sort == SortDirection.Descending ? "descending" : "none") : null)"
                            style="@(widthStyle + pinStyle)" class="@thClass">
                            <div class="sg-th-inner">
                                <span class="sg-th-title @(col.Sortable ? "sg-sortable" : "")"
                                      title="@(col.Sortable ? Localizer["DataGrid_Sort"] : "")"
                                      @onclick="@(async (MouseEventArgs e) => { if (col.Sortable) await ToggleSortAsync(key, e.CtrlKey || e.ShiftKey); })">
                                    @if (col.HeaderTemplate is not null)
                                    {
                                        @col.HeaderTemplate
                                    }
                                    else
                                    {
                                        @col.Title
                                    }
                                    @if (sort == SortDirection.Ascending)
                                    {
                                        <span class="sg-sort-ind">
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"></polyline></svg>
                                            @(sortIdx > 0 ? sortIdx.ToString() : "")
                                        </span>
                                    }
                                    else if (sort == SortDirection.Descending)
                                    {
                                        <span class="sg-sort-ind">
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                            @(sortIdx > 0 ? sortIdx.ToString() : "")
                                        </span>
                                    }
                                </span>
                                @if (col.Filterable)
                                {
                                    <button type="button" class="sg-filter-btn @(hasFilter ? "active" : "")"
                                            aria-label="@Localizer.GetString("DataGrid_FilterButton", col.Title)"
                                            @onclick:stopPropagation="true"
                                            @onclick="async () => await ToggleFilterMenuAsync(key)">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
                                    </button>
                                }
                            </div>
                            @if (_openFilterColumn == key)
                            {
                                <div class="sg-filter-menu sg-filter-menu--@menuSide" @onclick:stopPropagation="true">
                                    <div class="sg-filter-menu-body">

                                    @* ── Sorting Section ────────────────────────────────────────── *@
                                    <div class="sg-filter-divider">@Localizer["DataGrid_Sort"]</div>
                                    <div class="sg-filter-sort-section">
                                        <button class="sg-filter-menu-item @(_pendingSort == SortDirection.Ascending ? "sg-filter-menu-item-selected" : "")" type="button" @onclick="@(() => SetPendingSortAsync(SortDirection.Ascending))">
                                            <span class="sg-filter-menu-icon">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 16 4 4 4-4"/><path d="M7 20V4"/><path d="M11 4h4"/><path d="M11 8h7"/><path d="M11 12h10"/></svg>
                                            </span>
                                            <span>@Localizer["DataGrid_SortAsc"]</span>
                                        </button>
                                        <button class="sg-filter-menu-item @(_pendingSort == SortDirection.Descending ? "sg-filter-menu-item-selected" : "")" type="button" @onclick="@(() => SetPendingSortAsync(SortDirection.Descending))">
                                            <span class="sg-filter-menu-icon">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 8 4-4 4 4"/><path d="M7 4v16"/><path d="M11 12h10"/><path d="M11 16h7"/><path d="M11 20h4"/></svg>
                                            </span>
                                            <span>@Localizer["DataGrid_SortDesc"]</span>
                                        </button>
                                        @if (HasColumnFilter(key) || _pendingSort.HasValue)
                                        {
                                            <button class="sg-filter-menu-item sg-filter-clear-item" type="button" @onclick="@(async () => { await ClearPendingAsync(key); await ClearPendingSortAsync(); })">
                                                <span class="sg-filter-menu-icon">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H5c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                                                </span>
                                                <span>@Localizer["DataGrid_Reset"]</span>
                                            </button>
                                        }
                                    </div>

                                    <div class="sg-filter-divider">@Localizer["DataGrid_FilterConditions"]</div>

                                    @* AND / OR toggle *@
                                    @if (PendingRules.Count > 1)
                                    {
                                        <div class="sg-filter-logic" @onclick:stopPropagation="true">
                                            <button class="sg-btn sg-sm @(PendingRulesAnd ? "sg-btn-active" : "")" type="button"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="async () => await SetPendingRulesAndAsync(true)">@Localizer["DataGrid_FilterAnd"]</button>
                                            <button class="sg-btn sg-sm @(!PendingRulesAnd ? "sg-btn-active" : "")" type="button"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="async () => await SetPendingRulesAndAsync(false)">@Localizer["DataGrid_FilterOr"]</button>
                                        </div>
                                    }

                                    @* Rules list *@
                                    @for (var ri = 0; ri < PendingRules.Count; ri++)
                                    {
                                        var rIdx = ri;
                                        var rule = PendingRules[rIdx];
                                        var colFilterType = GetColumnFilterType(key);
                                        <div class="sg-filter-rule">
                                            <select class="sg-filter-cond-select"
                                                     value="@rule.Condition.ToString()"
                                                     @onchange="async e => await SetPendingRuleConditionAsync(rIdx, Enum.Parse<FilterCondition>(e.Value!.ToString()!))">
                                                 @* Text operators — shown for string/enum columns *@
                                                 @if (colFilterType == "string" || colFilterType == "enum")
                                                 {
                                                     <option value="Contains">@Localizer["DataGrid_FilterContains"]</option>
                                                     <option value="NotContains">@Localizer["DataGrid_FilterNotContains"]</option>
                                                     <option value="StartsWith">@Localizer["DataGrid_FilterStartsWith"]</option>
                                                     <option value="EndsWith">@Localizer["DataGrid_FilterEndsWith"]</option>
                                                 }
                                                 <option value="Equals">@Localizer["DataGrid_FilterEquals"]</option>
                                                 <option value="NotEquals">@Localizer["DataGrid_FilterNotEquals"]</option>
                                                 @* Comparison operators — numeric and date columns *@
                                                 @if (colFilterType == "number" || colFilterType == "date" || colFilterType == "datetime")
                                                 {
                                                     <option value="GreaterThan">@Localizer["DataGrid_FilterGreaterThan"]</option>
                                                     <option value="LessThan">@Localizer["DataGrid_FilterLessThan"]</option>
                                                     <option value="GreaterOrEqual">@Localizer["DataGrid_FilterGreaterOrEqual"]</option>
                                                     <option value="LessOrEqual">@Localizer["DataGrid_FilterLessOrEqual"]</option>
                                                 }
                                                 <option value="IsEmpty">@Localizer["DataGrid_FilterIsEmpty"]</option>
                                                 <option value="IsNotEmpty">@Localizer["DataGrid_FilterIsNotEmpty"]</option>
                                             </select>
                                             @if (rule.Condition != FilterCondition.IsEmpty && rule.Condition != FilterCondition.IsNotEmpty)
                                             {
                                                 @if (colFilterType == "bool")
                                                 {
                                                     <select class="sg-filter-rule-input"
                                                             value="@rule.Value"
                                                             @onchange="async e => await SetPendingRuleValueAsync(rIdx, e.Value?.ToString())">
                                                         <option value="">@Localizer["DataGrid_FilterAll"]</option>
                                                         <option value="true">@Localizer["DataGrid_FilterTrue"]</option>
                                                         <option value="false">@Localizer["DataGrid_FilterFalse"]</option>
                                                     </select>
                                                 }
                                                 else if (colFilterType == "enum")
                                                 {
                                                     <select class="sg-filter-rule-input"
                                                             value="@rule.Value"
                                                             @onchange="async e => await SetPendingRuleValueAsync(rIdx, e.Value?.ToString())">
                                                         <option value="">@Localizer["DataGrid_FilterAll"]</option>
                                                         @foreach (var ei in GetColumnEnumItems(key))
                                                         {
                                                             <option value="@ei.Name">@ei.Label</option>
                                                         }
                                                     </select>
                                                 }
                                                 else if (colFilterType == "date")
                                                 {
                                                     <input class="sg-filter-rule-input"
                                                            type="date"
                                                            value="@rule.Value"
                                                            @oninput="async e => await SetPendingRuleValueAsync(rIdx, e.Value?.ToString())" />
                                                 }
                                                 else if (colFilterType == "datetime")
                                                 {
                                                     <input class="sg-filter-rule-input"
                                                            type="datetime-local"
                                                            value="@rule.Value"
                                                            @oninput="async e => await SetPendingRuleValueAsync(rIdx, e.Value?.ToString())" />
                                                 }
                                                 else
                                                 {
                                                     <input class="sg-filter-rule-input"
                                                            type="text"
                                                            placeholder="@Localizer["DataGrid_FilterValue"]"
                                                            value="@rule.Value"
                                                            @oninput="async e => await SetPendingRuleValueAsync(rIdx, e.Value?.ToString())" />
                                                 }
                                             }
                                            @if (PendingRules.Count > 1)
                                            {
                                                <button class="sg-filter-rule-del" type="button"
                                                         title="@Localizer["DataGrid_FilterRemoveCondition"]"
                                                         @onclick="async () => await RemovePendingRuleAsync(rIdx)">
                                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                </button>
                                            }
                                        </div>
                                    }

                                    @* Add rule *@
                                    <div class="sg-filter-add-rule">
                                         <button class="sg-btn sg-sm" type="button" @onclick="AddPendingRuleAsync">@Localizer["DataGrid_FilterAddCondition"]</button>
                                     </div>

                                     @* Divider *@
                                     @{
                                         var distinctValues = _filterMenuVisibleValues;
                                     }

                                     <div class="sg-filter-divider">@Localizer["DataGrid_FilterOrValues"]</div>

                                     @* Checkbox list - always render container to prevent menu collapse *@
                                     <div class="sg-filter-list-wrap">
                                         @if (_filterMenuLoading)
                                         {
                                             <div class="sg-filter-loading">
                                                 <span class="sg-filter-spinner" aria-hidden="true"></span>
                                                 <span>@Localizer["Common_Loading"]</span>
                                             </div>
                                         }
                                         else if (distinctValues.Count > 0)
                                         {
                                             <div class="sg-filter-search">
                                                 <svg class="sg-filter-search-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                                 <input class="sg-quick-filter-input sg-filter-search-input"
                                                        placeholder="@Localizer["DataGrid_QuickFilter"]..."
                                                        value="@_filterMenuSearchText"
                                                        @oninput="@(async e => await HandleFilterMenuSearchInputAsync(e.Value?.ToString()))" />
                                                 @if (!string.IsNullOrEmpty(_filterMenuSearchText))
                                                 {
                                                     <button type="button" class="sg-filter-search-clear" title="@Localizer["Common_Clear"]"
                                                             @onclick="@(async () => await HandleFilterMenuSearchInputAsync(string.Empty))"
                                                             @onclick:stopPropagation="true">
                                                         <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                                     </button>
                                                 }
                                             </div>
                                             <div class="sg-filter-actions">
                                                  <label class="sg-filter-all">
                                                      <input type="checkbox"
                                                             checked="@IsPendingAllSelected(key)"
                                                             @onchange="@(e => TogglePendingAllAsync(key, e.Value is true))" />
                                                      @Localizer["DataGrid_FilterAll"]
                                                  </label>
                                             </div>
                                              <div class="sg-filter-list">
                                                  @if (_filterTree != null && _filterTree.Count > 0)
                                                  {
                                                      @foreach (var year in _filterTree)
                                                      {
                                                          <div class="sg-filter-tree-node">
                                                              <div class="sg-filter-tree-row">
                                                                  <button type="button" class="sg-filter-tree-toggle" @onclick="@(() => year.IsExpanded = !year.IsExpanded)">
                                                                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="transform: rotate(@(year.IsExpanded ? "90deg" : "0deg"))">
                                                                          <polyline points="9 18 15 12 9 6"></polyline>
                                                                      </svg>
                                                                  </button>
                                                                  <label class="sg-filter-item">
                                                                      <input type="checkbox"
                                                                             checked="@year.IsSelected"
                                                                             @onchange="@(e => ToggleFilterTreeNode(year, e.Value is true))"
                                                                             indeterminate="@(year.IsSelected == null)" />
                                                                      <span>@year.Label</span>
                                                                  </label>
                                                              </div>
                                                              @if (year.IsExpanded && year.Children != null)
                                                              {
                                                                  <div class="sg-filter-tree-children">
                                                                      @foreach (var month in year.Children)
                                                                      {
                                                                          <div class="sg-filter-tree-node">
                                                                              <div class="sg-filter-tree-row">
                                                                                  <button type="button" class="sg-filter-tree-toggle" @onclick="@(() => month.IsExpanded = !month.IsExpanded)">
                                                                                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="transform: rotate(@(month.IsExpanded ? "90deg" : "0deg"))">
                                                                                          <polyline points="9 18 15 12 9 6"></polyline>
                                                                                      </svg>
                                                                                  </button>
                                                                                  <label class="sg-filter-item">
                                                                                      <input type="checkbox"
                                                                                             checked="@month.IsSelected"
                                                                                             @onchange="@(e => ToggleFilterTreeNode(month, e.Value is true))"
                                                                                             indeterminate="@(month.IsSelected == null)" />
                                                                                      <span>@month.Label</span>
                                                                                  </label>
                                                                              </div>
                                                                              @if (month.IsExpanded && month.Children != null)
                                                                              {
                                                                                  <div class="sg-filter-tree-children">
                                                                                      @foreach (var day in month.Children)
                                                                                      {
                                                                                          <label class="sg-filter-item sg-filter-tree-row" @key="day.Value">
                                                                                              <input type="checkbox"
                                                                                                     checked="@(day.IsSelected == true)"
                                                                                                     @onchange="@(e => ToggleFilterTreeNode(day, e.Value is true))" />
                                                                                              <span>@day.Label</span>
                                                                                          </label>
                                                                                      }
                                                                                  </div>
                                                                              }
                                                                          </div>
                                                                      }
                                                                  </div>
                                                              }
                                                          </div>
                                                      }
                                                  }
                                                  else if (distinctValues.Count > 200)
                                                  {
                                                      var virtualItems = distinctValues!;
                                                      <Virtualize TItem="string" Items="virtualItems" ItemSize="24" Context="val">
                                                          <ItemContent>
                                                              <label class="sg-filter-item" @key="val">
                                                                  <input type="checkbox"
                                                                         checked="@IsPendingValueSelected(val)"
                                                                         @onchange="@(e => TogglePendingValueAsync(val, e.Value is true))" />
                                                                  <span>@GetDisplayLabelForFilterValue(key, val)</span>
                                                              </label>
                                                          </ItemContent>
                                                      </Virtualize>
                                                  }
                                                  else
                                                  {
                                                      @foreach (var val in distinctValues)
                                                      {
                                                          var display = GetDisplayLabelForFilterValue(key, val);
                                                          var selected = IsPendingValueSelected(val);
                                                          <label class="sg-filter-item" @key="val">
                                                              <input type="checkbox"
                                                                     checked="@selected"
                                                                     @onchange="@(e => TogglePendingValueAsync(val, e.Value is true))" />
                                                              <span>@display</span>
                                                          </label>
                                                      }
                                                  }
                                              </div>@* end sg-filter-list *@
                                         }
                                         else if (!string.IsNullOrEmpty(_filterMenuSearchText))
                                         {
                                             <div class="sg-filter-empty-hint">@Localizer["Common_NoResults"]</div>
                                         }
                                     </div>@* end sg-filter-list-wrap *@

                                    </div>@* end sg-filter-menu-body *@

                                     @* Footer — always visible *@
                                     <div class="sg-filter-foot">
                                         <button type="button" class="sg-btn" title="@(IsGroupedBy(key) ? Localizer["DataGrid_FilterUnGroupBy"] : Localizer["DataGrid_FilterGroupBy"])"
                                                 @onclick="async () => await ToggleGroupByAsync(key)">
                                             @(IsGroupedBy(key) ? Localizer["DataGrid_FilterUnGroupBy"] : Localizer["DataGrid_FilterGroupBy"])
                                         </button>
                                         <div class="sg-spacer"></div>
                                         <button type="button" class="sg-btn primary" @onclick="ApplyFilterAsync">@Localizer["DataGrid_FilterOk"]</button>
                                         <button type="button" class="sg-btn" @onclick="CloseFilterMenuAsync">@Localizer["DataGrid_FilterCancel"]</button>
                                     </div>
                                </div>
                            }
                            @if (col.Resizable)
                            {
                                <div class="sg-resizer" data-col-key="@key"></div>
                            }
                        </th>
                    }
                    @if (AllowEdit || AllowDelete)
                    {
                        <th class="sg-th sg-col-actions sg-pinned" style="right:0;"></th>
                    }
                </tr>
@if (ShowQuickFilters)
                     {
                         <tr class="sg-quick-filter-row" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                             @if (ShowRowNumbers) { <th class="@GetTechnicalColumnClass("sg-th sg-col-num sg-pinned", "rownum")" style="position:sticky;top:30px;left:0;z-index:6;background:var(--sg-header-bg);"></th> }
                             @if ((DetailTemplate is not null || AutoDetail) && DetailPlacement == DetailPlacement.Inline)
                             {
                                 <th class="@GetTechnicalColumnClass("sg-th sg-col-expand sg-pinned", "expand")" style="position:sticky;top:30px;left:@(GetTechnicalColumnLeft("expand"))px;z-index:6;background:var(--sg-header-bg);"></th>
                             }
                             @if (IsTree)
                             {
                                 <th class="@GetTechnicalColumnClass("sg-th sg-col-tree-expand sg-pinned", "tree")" style="position:sticky;top:30px;left:@(GetTechnicalColumnLeft("tree"))px;z-index:6;background:var(--sg-header-bg);"></th>
                             }
                             @if (SelectionEnabled)
                             {
                                 <th class="@GetTechnicalColumnClass("sg-col-check sg-pinned", "check")" style="position:sticky;top:30px;left:@(GetTechnicalColumnLeft("check"))px;z-index:6;background:var(--sg-header-bg);"></th>
                             }
                             @foreach (var col in visibleCols)
                             {
                                 var widthStyle = GetColumnWidthStyle(col);
                                 var isPinned = IsColumnPinned(col.Key);
                                 var quickFilterStyle = isPinned
                                     ? GetColumnPinStyleForQuickFilter(col)
                                     : "position:sticky;top:30px;z-index:5;background:var(--sg-header-bg);";
                                 var thClass = "sg-th" + (isPinned ? " sg-pinned" : "");
                                 <th class="@($"{thClass} sg-quick-filter-cell")" style="@(widthStyle + quickFilterStyle)">
                                     @if (col.Filterable)
                                     {
                                         var filterType = GetColumnFilterType(col.Key);
                                         var colKey = col.Key;
                                         if (filterType == "bool")
                                         {
                                             <select class="sg-quick-filter-input"
                                                     value="@(_quickFilters.TryGetValue(colKey, out var quickBoolValue) ? quickBoolValue : string.Empty)"
                                                     @onchange="@(e => OnQuickFilterInputAsync(colKey, e))">
                                                 <option value="">@Localizer["DataGrid_FilterAll"]</option>
                                                 <option value="true">@Localizer["DataGrid_FilterTrue"]</option>
                                                 <option value="false">@Localizer["DataGrid_FilterFalse"]</option>
                                             </select>
                                         }
                                         else
                                         {
                                             <input class="sg-quick-filter-input"
                                                    placeholder="@Localizer["DataGrid_QuickFilter"]"
                                                    type="@(filterType == "date" ? "date" : filterType == "datetime" ? "datetime-local" : "text")"
                                                    value="@(_quickFilters.TryGetValue(colKey, out var quickValue) ? quickValue : string.Empty)"
                                                    @oninput="@(e => OnQuickFilterInputAsync(colKey, e))" />
                                         }
                                     }
                                 </th>
                             }
                             @if (AllowEdit || AllowDelete)
                             {
                                 <th class="sg-th sg-col-actions sg-pinned" style="position:sticky;top:30px;right:0;z-index:6;background:var(--sg-header-bg);"></th>
                             }
                         </tr>
                     }
            </thead>
            <tbody>
                @if (Loading)
                {
                    @for (var r = 0; r < 5; r++)
                    {
                        <tr>
                            @if (SelectionEnabled) { <td><SgSkeleton Width="16px" Height="16px" Shape="SgSkeletonShape.Rect" /></td> }
                            @if (DetailTemplate is not null) { <td></td> }
                            @if (IsTree) { <td class="sg-col-tree-expand"></td> }
                            @foreach (var col in _columns.Where(c => !c.Hidden))
                            {
                                <td><SgSkeleton Width="80%" Height="14px" /></td>
                            }
                            @if (AllowEdit || AllowDelete) { <td></td> }
                        </tr>
                    }
                }
                else
                {
                    var hasGroups = GroupByKeys.Count > 0;
                    var rows = hasGroups ? new List<TItem>() : GetVisibleRows();
                    var tree = (hasGroups && !_isGroupBuilding) ? BuildGroupTree() : null;
                    var totalVisible = hasGroups ? TotalFilteredCount : rows.Count;
                    var useVirtualization = ShouldUseVirtualization() && !hasGroups;
                    var (startIndex, endIndex, topPadding, bottomPadding) = useVirtualization ? CalculateVirtualWindow() : (0, rows.Count - 1, 0, 0);

                    @if (_isGroupBuilding)
                    {
                        <tr>
                            <td colspan="@ColumnSpan" class="sg-group-building">
                                <div class="sg-group-building-inner">
                                    <div class="sg-group-building-spinner"></div>
                                    <span>@Localizer["DataGrid_GroupingInProgress"]</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else @if (totalVisible == 0)
                    {
                        <tr>
                            <td class="sg-empty" colspan="@ColumnSpan">
                                @if (EmptyDataTemplate is not null)
                                {
                                    @EmptyDataTemplate
                                }
                                else
                                {
                                    @EffectiveEmptyText
                                }
                            </td>
                        </tr>
                    }
                    else if (hasGroups && tree is not null)
                    {
                        @RenderGroups(tree, visibleCols)
                    }
                    else
                    {
                        @if (useVirtualization && topPadding > 0)
                        {
                            <tr style="height: @(topPadding)px;"><td colspan="@ColumnSpan"></td></tr>
                        }
                        @for (var _ri = 0; _ri < rows.Count; _ri++)
                        {
                            var rowItem = rows[_ri];
                            var rowIndent = IsTree && _rowLevels.TryGetValue(rowItem, out var level) ? level : 0;
                            @RenderRow(rowItem, visibleCols, rowIndent, (CurrentPage - 1) * PageSize + _ri + 1)
                        }
                        @if (useVirtualization && bottomPadding > 0)
                        {
                            <tr style="height: @(bottomPadding)px;"><td colspan="@ColumnSpan"></td></tr>
                        }
                    }
                }
            </tbody>
            @if (ShowStatusBar && visibleCols.Any(c => c.Aggregate != Aggregate.None || c.FooterTemplate is not null))
            {
                <tfoot>
                    <tr>
                        @if (ShowRowNumbers) { <td class="@GetTechnicalColumnClass("sg-agg sg-col-num sg-pinned", "rownum")" style="left: 0;"></td> }
                        @if ((DetailTemplate is not null || AutoDetail) && DetailPlacement == DetailPlacement.Inline)
                        {
                            <td class="@GetTechnicalColumnClass("sg-agg sg-col-expand sg-pinned", "expand")" style="left: @(GetTechnicalColumnLeft("expand"))px;"></td>
                        }
                        @if (IsTree)
                        {
                            <td class="@GetTechnicalColumnClass("sg-agg sg-col-tree-expand sg-pinned", "tree")" style="left: @(GetTechnicalColumnLeft("tree"))px;"></td>
                        }
                        @if (SelectionEnabled)
                        {
                            <td class="@GetTechnicalColumnClass("sg-agg sg-col-check sg-pinned", "check")" style="left: @(GetTechnicalColumnLeft("check"))px;"></td>
                        }
                        @foreach (var col in visibleCols)
                        {
                            var pinStyle = GetColumnPinStyle(col);
                            var aggClass = "sg-agg" + (IsColumnPinned(col.Key) ? " sg-pinned" : "");
                            <td class="@aggClass" style="@pinStyle">
                                @if (col.FooterTemplate is not null)
                                {
                                    @col.FooterTemplate(GetFilteredItems())
                                }
                                else
                                {
                                    var agg = ComputeAggregate(col);
                                    @if (agg is not null)
                                    {
                                        <span class="sg-agg-label">@col.Aggregate:</span>
                                        <span class="sg-agg-val">@agg</span>
                                    }
                                }
                            </td>
                        }
                        @if (AllowEdit || AllowDelete)
                        {
                            <td class="sg-agg sg-col-actions sg-pinned" style="right:0;"></td>
                        }
                    </tr>
                </tfoot>
            }
        </table>
    </div>

    <div class="sg-foot">
        @{
            var filtered = TotalFilteredCount;
            var tp = TotalPages;
            var from = filtered == 0 ? 0 : (CurrentPage - 1) * _pageSize + 1;
            var to = Math.Min(filtered, CurrentPage * _pageSize);
        }
        <span class="sg-foot-info">
            @if (EnablePaging && !ShouldUseVirtualization())
            {
                @($"{from}–{to} {Localizer["DataGrid_RowsOf"]} {filtered}")
            }
            else
            {
                @($"{Localizer["DataGrid_RowsShown"]} {filtered}")
            }
            @if (SelectedItems.Count > 0)
            {
                <span class="sg-foot-sel"> @Localizer["DataGrid_RowsSelectedCount"]: @SelectedItems.Count</span>
            }
        </span>
        @if (EnablePaging && !ShouldUseVirtualization())
        {
            <div class="sg-pager">
                <label class="sg-pager-size">
                    <select @onchange="OnPageSizeChange" value="@_pageSize">
                        @if (!PageSizeOptions.Contains(_pageSize))
                        {
                            <option value="@_pageSize">@_pageSize</option>
                        }
                        @foreach (var s in PageSizeOptions)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </label>
                <button type="button" class="sg-page-btn" disabled="@(CurrentPage <= 1)"
                        @onclick="() => GoToPageAsync(1)" aria-label="@Localizer["DataGrid_PageFirst"]">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="11 17 6 12 11 7"></polyline><polyline points="18 17 13 12 18 7"></polyline></svg>
                </button>
                <button type="button" class="sg-page-btn" disabled="@(CurrentPage <= 1)"
                        @onclick="() => GoToPageAsync(CurrentPage - 1)" aria-label="@Localizer["DataGrid_PagePrev"]">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </button>
                @foreach (var p in GetPageWindow())
                {
                    if (p == -1)
                    {
                        <span class="sg-page-gap">…</span>
                    }
                    else
                    {
                        var pageNum = p;
                        <button type="button" class="sg-page-btn @(pageNum == CurrentPage ? "current" : "")"
                                @onclick="() => GoToPageAsync(pageNum)">@pageNum</button>
                    }
                }
                <button type="button" class="sg-page-btn" disabled="@(CurrentPage >= tp)"
                        @onclick="() => GoToPageAsync(CurrentPage + 1)" aria-label="@Localizer["DataGrid_PageNext"]">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </button>
                <button type="button" class="sg-page-btn" disabled="@(CurrentPage >= tp)"
                        @onclick="() => GoToPageAsync(tp)" aria-label="@Localizer["DataGrid_PageLast"]">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="13 17 18 12 13 7"></polyline><polyline points="6 17 11 12 6 7"></polyline></svg>
                </button>
            </div>
        }
    </div>
</div>
</CascadingValue>

