@typeparam TItem
@using Microsoft.AspNetCore.Components.Web
@using SuperUI.Enums
@using SuperUI.Localization
@using SortDirection = SuperUI.Enums.SgDataGridSortDirection
@inject ISuperUILocalizer Localizer

<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

<div class="sg-root @CssClass" style="@(string.IsNullOrEmpty(Height) ? "" : $"height: {Height};")">
    @if (!string.IsNullOrEmpty(Title) || ShowSearch || ShowExport)
    {
        <div class="sg-toolbar">
            @if (!string.IsNullOrEmpty(Title))
            {
                <div class="sg-title">@Title</div>
            }
            <div class="sg-spacer"></div>
            @if (ShowSearch)
            {
                <div class="sg-search-wrap">
                    <svg class="sg-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input class="sg-search"
                           placeholder="@SearchPlaceholder"
                           value="@_searchText"
                           @oninput="OnSearchInput" />
                </div>
            }
            @if (ShowExport)
            {
                <button class="sg-button" @onclick="ExportToCsv" title="@Localizer["Table_ExportCsv"]">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                </button>
            }
        </div>
    }

    <div class="sg-scroll">
        <table class="sg-table @(FullWidth ? "sg-table-full" : "")" @ref="_tableRef">
            <thead>
                @if (HeaderGroups.Any())
                {
                    <tr>
                        @if (AllowSelection)
                        {
                            <th class="sg-th sg-th-group" rowspan="2" style="width: 40px; text-align: center;">
                                @if (AllowMultiSelect)
                                {
                                    <input type="checkbox" class="sg-checkbox"
                                           checked="@_selectAll" 
                                           @onchange="async () => await ToggleSelectAll()" />
                                }
                            </th>
                        }
                        @if (ShowRowNumbers)
                        {
                            <th class="sg-th sg-th-group" rowspan="2" style="width: 50px; text-align: center;">@Localizer["Table_RowNo"]</th>
                        }
                        @foreach (var group in HeaderGroups)
                        {
                            <th class="sg-th sg-th-group" colspan="@group.ColumnCount">@group.Title</th>
                        }
                    </tr>
                }
                <tr>
                    @if (AllowSelection && !HeaderGroups.Any())
                    {
                        <th class="sg-th" style="width: 40px; text-align: center;">
                            @if (AllowMultiSelect)
                            {
                                <input type="checkbox" class="sg-checkbox"
                                       checked="@_selectAll" 
                                       @onchange="async () => await ToggleSelectAll()" />
                            }
                        </th>
                    }
                    @if (ShowRowNumbers && !HeaderGroups.Any())
                    {
                        <th class="sg-th" style="width: 50px; text-align: center;">@Localizer["Table_RowNo"]</th>
                    }
                    @for (int i = 0; i < Columns.Count; i++)
                    {
                        var col = Columns[i];
                        var colIndex = i;
                        var isSorted = _sortColumnKey == col.Key;
                        var thClass = "sg-th sg-th-resizable";
                        if (_draggedColumnIndex == colIndex) thClass += " sg-th-dragging";
                        if (_dropTargetIndex == colIndex) thClass += " sg-th-drop-target";
                        thClass += col.HeaderAlign switch
                        {
                            SgHAlign.Left => " sg-align-left",
                            SgHAlign.Center => " sg-align-center",
                            SgHAlign.Right => " sg-align-right",
                            _ => string.Empty
                        };
                        var colWidth = _columnWidths.ContainsKey(col.Key) ? $"{_columnWidths[col.Key]}px" : col.Width;
                        <th class="@thClass" 
                            style="@(string.IsNullOrEmpty(colWidth) ? "" : $"width: {colWidth}; min-width: {colWidth};")"
                            draggable="@(AllowColumnReorder ? "true" : "false")"
                            @ondragstart="@(() => OnColumnDragStart(colIndex))"
                            @ondragover:preventDefault
                            @ondragover="@(() => OnColumnDragOver(colIndex))"
                            @ondrop="@(() => OnColumnDrop(colIndex))"
                            @ondragend="OnColumnDragEnd">
                            <div class="sg-th-content">
                                <span class="sg-th-title @(col.Sortable ? "sg-sortable" : "")"
                                      @onclick="@(() => { if (col.Sortable) OnSortClick(col.Key); })">
                                    @col.Title
                                    @if (isSorted)
                                    {
                                        <span class="sg-sort-ind">
                                            @if (_sortDirection == SortDirection.Ascending)
                                            {
                                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"></polyline></svg>
                                            }
                                            else if (_sortDirection == SortDirection.Descending)
                                            {
                                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                            }
                                        </span>
                                    }
                                </span>
                                @if (AllowColumnResize)
                                {
                                    <div class="sg-resize-handle"
                                         @onmousedown="@(e => OnResizeStart(e, col.Key))"
                                         @onmousedown:stopPropagation="true"
                                         @onclick:stopPropagation="true"></div>
                                }
                            </div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (PagedItems.Any())
                {
                    var rowIndex = (CurrentPage - 1) * PageSize + 1;
                    @foreach (var item in PagedItems)
                    {
                        var rowClass = "sg-tr";
                        if (IsSelected(item)) rowClass += " sg-selected";
                        if (RowClass != null)
                        {
                            var rc = RowClass(item);
                            if (!string.IsNullOrEmpty(rc))
                                rowClass += " " + rc;
                        }
                        var rowStyle = RowStyle != null ? RowStyle(item) : null;
                        <tr class="@rowClass" style="@rowStyle"
                            @onclick="async () => await OnRowClick(item)"
                            @ondblclick="async () => await OnRowDoubleClick(item)">
                            @if (AllowSelection)
                            {
                                <td class="sg-td sg-align-center" style="width: 40px;">
                                    <input type="checkbox" class="sg-checkbox"
                                           checked="@IsSelected(item)" 
                                           @onchange="async () => await ToggleSelection(item)"
                                           @onclick:stopPropagation="true" />
                                </td>
                            }
                            @if (ShowRowNumbers)
                            {
                                <td class="sg-td sg-align-center" style="width: 50px;">@rowIndex</td>
                            }
                            @foreach (var col in Columns)
                            {
                                var value = col.GetValue(item);
                                var isBool = value is bool;
                                var isNumeric = col.IsNumericColumn;
                                var effectiveHAlign = col.HAlign == SgHAlign.Default
                                    ? (isNumeric ? SgHAlign.Right : SgHAlign.Left)
                                    : col.HAlign;
                                var tdClass = "sg-td";
                                tdClass += effectiveHAlign switch
                                {
                                    SgHAlign.Left => " sg-align-left",
                                    SgHAlign.Center => " sg-align-center",
                                    SgHAlign.Right => " sg-align-right",
                                    _ => string.Empty
                                };
                                tdClass += col.VAlign switch
                                {
                                    SgVAlign.Top => " sg-valign-top",
                                    SgVAlign.Middle => " sg-valign-middle",
                                    SgVAlign.Bottom => " sg-valign-bottom",
                                    _ => string.Empty
                                };
                                if (col.CellClass != null)
                                {
                                    var cc = col.CellClass(item);
                                    if (!string.IsNullOrEmpty(cc))
                                        tdClass += " " + cc;
                                }
                                var tdStyle = col.CellStyle != null ? col.CellStyle(item) : null;
                                <td class="@tdClass" style="@tdStyle">
                                    @if (col.Template != null)
                                    {
                                        @col.Template(item)
                                    }
                                    else if (isBool && col.Template == null)
                                    {
                                        <input type="checkbox" class="sg-checkbox" checked="@((bool)value)" disabled />
                                    }
                                    else
                                    {
                                        @col.GetDisplay(item)
                                    }
                                </td>
                            }
                        </tr>
                        rowIndex++;
                    }
                }
                else
                {
                    var totalCols = Columns.Count + (ShowRowNumbers ? 1 : 0) + (AllowSelection ? 1 : 0);
                    <tr>
                        <td class="sg-td" colspan="@totalCols" style="text-align: center; padding: 32px; color: var(--sui-text-muted);">
                            @EffectiveEmptyText
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (EnablePaging && TotalPages > 1)
    {
        <div class="sg-toolbar" style="border-top: 1px solid var(--sui-border); border-bottom: none;">
            <div style="font-size: 13px; color: var(--sui-text-secondary); display: flex; align-items: center; gap: 8px;">
                @if (TotalCount > 0)
                {
                    <span>@((CurrentPage - 1) * PageSize + 1)-@Math.Min(CurrentPage * PageSize, TotalCount) @Localizer["Table_Of"] @TotalCount</span>
                }
                @if (AllowPageSizeChange)
                {
                    <span style="margin-left: 4px; margin-right: 4px;">|</span>
                    <select class="sg-page-size-select" value="@PageSize" @onchange="OnPageSizeChange">
                        @foreach (var size in PageSizeOptions)
                        {
                            <option value="@size">@size</option>
                        }
                    </select>
                    <span style="font-size: 12px; color: var(--sui-text-muted);">@Localizer["Table_PerPage"]</span>
                }
            </div>
            <div class="sg-spacer"></div>
            <div class="sg-btn-group">
                <button class="sg-button" 
                        disabled="@(CurrentPage == 1)"
                        @onclick="GoToFirstPage"
                        title="@Localizer["First"]">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="11 17 6 12 11 7"></polyline><polyline points="18 17 13 12 18 7"></polyline></svg>
                </button>
                <button class="sg-button" 
                        disabled="@(CurrentPage == 1)"
                        @onclick="GoToPreviousPage"
                        title="@Localizer["Previous"]">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </button>
                <span style="font-size: 13px; padding: 0 8px; white-space: nowrap;">@CurrentPage / @TotalPages</span>
                <button class="sg-button" 
                        disabled="@(CurrentPage == TotalPages)"
                        @onclick="GoToNextPage"
                        title="@Localizer["Next"]">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </button>
                <button class="sg-button" 
                        disabled="@(CurrentPage == TotalPages)"
                        @onclick="GoToLastPage"
                        title="@Localizer["Last"]">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="13 17 18 12 13 7"></polyline><polyline points="6 17 11 12 6 7"></polyline></svg>
                </button>
            </div>
        </div>
    }
</div>
