@namespace SuperUI.Components
@inherits SgJsComponentBase

<div class="@Css("sgc-dock").Build()" style="@Styles().NullIfEmpty()" @ref="RootRef">

    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>

    @* ── Top toolbar ── *@
    @if (ToolbarContent is not null)
    {
        <div class="sgc-dock-toolbar">@ToolbarContent</div>
    }

    @* ── Main area: [left] | [center+bottom] | [right] ── *@
    <div class="sgc-dock-body">

        @* LEFT panel *@
        @{ var leftPanels  = VisiblePanels(SgDockPosition.Left);  }
        @{ var rightPanels = VisiblePanels(SgDockPosition.Right); }
        @{ var botPanels   = VisiblePanels(SgDockPosition.Bottom);}
        @{ var cenPanels   = VisiblePanels(SgDockPosition.Center);}

        @if ((leftPanels.Count > 0 && !_leftCollapsed) || (DesignerMode && !_leftCollapsed))
        {
            <div class="@Css("sgc-dock-side sgc-dock-left").AddClass("sgc-dock-empty", leftPanels.Count == 0).Build()" 
                 style="width: @(_leftSize.ToString("F0"))px; min-width: @MinSideSize px;">
                @RenderPaneGroup(leftPanels, SgDockPosition.Left)
            </div>
            @if (leftPanels.Count > 0)
            {
                <div class="sgc-dock-sash sgc-dock-sash-v"
                     data-sash="left"
                     @ref="_leftSash"
                     title="Drag to resize"></div>
            }
        }

        @* CENTER + BOTTOM column *@
        <div class="sgc-dock-center-col">
            <div class="@Css("sgc-dock-center").AddClass("sgc-dock-empty", cenPanels.Count == 0).Build()" 
                 style="@(botPanels.Count > 0 && !_bottomCollapsed ? $"height: calc(100% - {_bottomSize:F0}px - 4px)" : "height: 100%")">
                @RenderPaneGroup(cenPanels, SgDockPosition.Center)
            </div>

            @if ((botPanels.Count > 0 && !_bottomCollapsed) || (DesignerMode && !_bottomCollapsed))
            {
                @if (botPanels.Count > 0)
                {
                    <div class="sgc-dock-sash sgc-dock-sash-h"
                         data-sash="bottom"
                         @ref="_bottomSash"
                         title="Drag to resize"></div>
                }
                <div class="@Css("sgc-dock-side sgc-dock-bottom").AddClass("sgc-dock-empty", botPanels.Count == 0).Build()" 
                     style="height: @(_bottomSize.ToString("F0"))px; min-height: @MinSideSize px;">
                    @RenderPaneGroup(botPanels, SgDockPosition.Bottom)
                </div>
            }
        </div>

        @* RIGHT panel *@
        @if ((rightPanels.Count > 0 && !_rightCollapsed) || (DesignerMode && !_rightCollapsed))
        {
            @if (rightPanels.Count > 0)
            {
                <div class="sgc-dock-sash sgc-dock-sash-v"
                     data-sash="right"
                     @ref="_rightSash"
                     title="Drag to resize"></div>
            }
            <div class="@Css("sgc-dock-side sgc-dock-right").AddClass("sgc-dock-empty", rightPanels.Count == 0).Build()" 
                 style="width: @(_rightSize.ToString("F0"))px; min-width: @MinSideSize px;">
                @RenderPaneGroup(rightPanels, SgDockPosition.Right)
            </div>
        }
    </div>

    @* ── Status bar ── *@
    @if (StatusBarContent is not null)
    {
        <div class="sgc-dock-statusbar">@StatusBarContent</div>
    }
</div>

@code {
    protected override string ModulePath => "./_content/SuperUI/superui-dockmanager.js";
    protected override string IdPrefix => "sg-dock";

    // ── Parameters ────────────────────────────────────────────────────────────

    /// <summary>List of panels managed by the dock.</summary>
    [Parameter] public List<SgDockPanel> Panels { get; set; } = new();

    /// <summary>Callback when the panel list changes (close, reorder).</summary>
    [Parameter] public EventCallback<List<SgDockPanel>> PanelsChanged { get; set; }

    /// <summary>Template for rendering panel content. Receives the active <see cref="SgDockPanel"/>.</summary>
    [Parameter] public RenderFragment<SgDockPanel>? PanelTemplate { get; set; }

    /// <summary>Optional toolbar rendered above the dock layout.</summary>
    [Parameter] public RenderFragment? ToolbarContent { get; set; }

    /// <summary>Optional status bar rendered below the dock layout.</summary>
    [Parameter] public RenderFragment? StatusBarContent { get; set; }

    /// <summary>Initial width of the left panel in pixels. Default 220.</summary>
    [Parameter] public double LeftSize { get; set; } = 220;

    /// <summary>Initial width of the right panel in pixels. Default 240.</summary>
    [Parameter] public double RightSize { get; set; } = 240;

    /// <summary>Initial height of the bottom panel in pixels. Default 180.</summary>
    [Parameter] public double BottomSize { get; set; } = 180;

    /// <summary>Minimum size (px) for any side panel. Default 80.</summary>
    [Parameter] public double MinSideSize { get; set; } = 80;

    /// <summary>Maximum size (px) for side panels. Default 600.</summary>
    [Parameter] public double MaxSideSize { get; set; } = 600;

    /// <summary>Callback when the active panel changes.</summary>
    [Parameter] public EventCallback<SgDockPanel?> ActivePanelChanged { get; set; }

    /// <summary>Content where <see cref="SgDockPane"/> components can be placed.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Whether to show the UI constructor (add panel button).</summary>
    [Parameter] public bool EnableConstructor { get; set; }

    /// <summary>Whether the manager is in designer mode (shows empty drop zones).</summary>
    [Parameter] public bool DesignerMode { get; set; }

    // ── State ─────────────────────────────────────────────────────────────────

    private ElementReference _leftSash;
    private ElementReference _rightSash;
    private ElementReference _bottomSash;
    private bool _attached;
    private bool _initDone;

    private double _leftSize;
    private double _rightSize;
    private double _bottomSize;

    private bool _leftCollapsed;
    private bool _rightCollapsed;
    private bool _bottomCollapsed;

    private readonly List<SgDockPanel> _registeredPanels = new();

    // active tab per position
    private readonly Dictionary<SgDockPosition, string?> _activeTab = new();

    // ── Public API ────────────────────────────────────────────────────────────

    internal void RegisterPanel(SgDockPanel panel)
    {
        if (!_registeredPanels.Contains(panel))
        {
            _registeredPanels.Add(panel);
            StateHasChanged();
        }
    }

    internal void UnregisterPanel(SgDockPanel panel)
    {
        if (_registeredPanels.Contains(panel))
        {
            _registeredPanels.Remove(panel);
            StateHasChanged();
        }
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override void OnParametersSet()
    {
        if (!_initDone)
        {
            _initDone = true;
            _leftSize   = LeftSize;
            _rightSize  = RightSize;
            _bottomSize = BottomSize;
        }
    }

    protected override async ValueTask OnInteractiveAsync()
    {
        try
        {
            await SafeInvokeVoidAsync("attach", RootRef, SelfRef);
            _attached = true;
        }
        catch (JSException) { }
        catch (TaskCanceledException) { }
    }

    // ── JS callbacks ──────────────────────────────────────────────────────────

    [JSInvokable]
    public async Task JsResizeLeft(double size)
    {
        _leftSize = Math.Clamp(size, MinSideSize, MaxSideSize);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task JsResizeRight(double size)
    {
        _rightSize = Math.Clamp(size, MinSideSize, MaxSideSize);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task JsResizeBottom(double size)
    {
        _bottomSize = Math.Clamp(size, MinSideSize, MaxSideSize);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task JsMovePanel(string panelId, string targetPos)
    {
        if (Enum.TryParse<SgDockPosition>(targetPos, true, out var newPos))
        {
            var panel = Panels.FirstOrDefault(p => p.Id == panelId);
            if (panel != null)
            {
                panel.Position = newPos;
                SetActiveTab(newPos, panelId);
                
                if (PanelsChanged.HasDelegate)
                    await PanelsChanged.InvokeAsync(Panels);
                
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private IEnumerable<SgDockPanel> AllPanels => Panels.Concat(_registeredPanels);

    private List<SgDockPanel> VisiblePanels(SgDockPosition pos)
        => AllPanels.Where(p => p.Position == pos && p.Visible).ToList();

    private string? GetActiveTab(SgDockPosition pos)
    {
        if (_activeTab.TryGetValue(pos, out var id) && id != null)
        {
            if (VisiblePanels(pos).Any(p => p.Id == id)) return id;
        }
        var first = VisiblePanels(pos).FirstOrDefault();
        return first?.Id;
    }

    private void SetActiveTab(SgDockPosition pos, string id)
    {
        _activeTab[pos] = id;
        var panel = AllPanels.FirstOrDefault(p => p.Id == id);
        if (panel != null && ActivePanelChanged.HasDelegate)
            _ = ActivePanelChanged.InvokeAsync(panel);
    }

    private async Task ClosePanelAsync(SgDockPanel panel)
    {
        panel.Visible = false;
        if (PanelsChanged.HasDelegate)
            await PanelsChanged.InvokeAsync(Panels);
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleCollapse(SgDockPosition pos)
    {
        switch (pos)
        {
            case SgDockPosition.Left:   _leftCollapsed   = !_leftCollapsed;   break;
            case SgDockPosition.Right:  _rightCollapsed  = !_rightCollapsed;  break;
            case SgDockPosition.Bottom: _bottomCollapsed = !_bottomCollapsed; break;
        }
    }

    private string _newPanelTitle = "";
    private string _newPanelIcon = SgIcons.FileText;
    private SgDockPosition? _constructorPos;

    private void OpenConstructor(SgDockPosition pos)
    {
        _newPanelTitle = "";
        _newPanelIcon = SgIcons.FileText;
        _constructorPos = pos;
    }

    private async Task AddPanelFromConstructor(string title, SgDockPosition pos)
    {
        if (string.IsNullOrWhiteSpace(title)) return;

        var newPanel = SgDockPanel.Create(title)
            .WithIcon(_newPanelIcon)
            .At(pos)
            .Build();
        
        Panels.Add(newPanel);
        _constructorPos = null;
        SetActiveTab(pos, newPanel.Id);
        
        if (PanelsChanged.HasDelegate)
            await PanelsChanged.InvokeAsync(Panels);
            
        StateHasChanged();
    }

    private readonly string[] _availableIcons = new[] { 
        SgIcons.FileText, SgIcons.Search, SgIcons.Settings, SgIcons.BarChart, 
        SgIcons.Database, SgIcons.Calendar, SgIcons.Clock, SgIcons.Edit,
        SgIcons.Sigma, SgIcons.Flame
    };

    // ── Render helpers ────────────────────────────────────────────────────────

    private RenderFragment RenderPaneGroup(List<SgDockPanel> panels, SgDockPosition pos) => __builder =>
    {
        var activeId = GetActiveTab(pos);

        // Tab bar
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "class", "sgc-dock-tabbar");
        __builder.AddAttribute(2, "data-pos", pos.ToString().ToLowerInvariant());

        foreach (var p in panels)
        {
            var pLocal = p;
            var isActive = pLocal.Id == activeId;

            __builder.OpenElement(10, "div");
            __builder.AddAttribute(11, "class", "sgc-dock-tab" + (isActive ? " sgc-dock-tab-active" : ""));
            __builder.AddAttribute(12, "title", pLocal.Title);
            __builder.AddAttribute(13, "draggable", "true");
            __builder.AddAttribute(14, "data-panel-id", pLocal.Id);
            __builder.AddAttribute(15, "onclick",
                EventCallback.Factory.Create(this, () => SetActiveTab(pos, pLocal.Id)));

            // icon
            if (!string.IsNullOrEmpty(pLocal.Icon))
            {
                __builder.OpenElement(20, "span");
                __builder.AddAttribute(21, "class", "sgc-dock-tab-icon");
                __builder.AddContent(22, (MarkupString)pLocal.Icon);
                __builder.CloseElement();
            }

            // title
            __builder.OpenElement(30, "span");
            __builder.AddAttribute(31, "class", "sgc-dock-tab-title");
            __builder.AddContent(32, pLocal.Title);
            __builder.CloseElement();

            // close button
            if (pLocal.Closable)
            {
                __builder.OpenElement(40, "button");
                __builder.AddAttribute(41, "type", "button");
                __builder.AddAttribute(42, "class", "sgc-dock-tab-close");
                __builder.AddAttribute(43, "title", "Close");
                __builder.AddAttribute(44, "onclick",
                    EventCallback.Factory.Create(this, () => ClosePanelAsync(pLocal)));
                __builder.AddEventStopPropagationAttribute(45, "onclick", true);
                __builder.AddContent(46, (MarkupString)SgIcons.X);
                __builder.CloseElement();
            }

            __builder.CloseElement(); // tab
        }

        // constructor button
        if (EnableConstructor)
        {
            __builder.OpenElement(47, "button");
            __builder.AddAttribute(48, "type", "button");
            __builder.AddAttribute(49, "class", "sgc-dock-tabbar-add");
            __builder.AddAttribute(50, "title", "Add panel to this group");
            __builder.AddAttribute(51, "onclick", EventCallback.Factory.Create(this, () => OpenConstructor(pos)));
            __builder.AddContent(52, (MarkupString)SgIcons.Plus);
            __builder.CloseElement();
        }

        // collapse button (not for center)
        if (pos != SgDockPosition.Center)
        {
            __builder.OpenElement(53, "button");
            __builder.AddAttribute(54, "type", "button");
            __builder.AddAttribute(55, "class", "sgc-dock-tabbar-collapse");
            __builder.AddAttribute(56, "title", "Collapse panel");
            __builder.AddAttribute(57, "onclick",
                EventCallback.Factory.Create(this, () => { ToggleCollapse(pos); StateHasChanged(); }));
            __builder.AddContent(58, pos == SgDockPosition.Bottom
                ? (MarkupString)SgIcons.ChevronDown
                : pos == SgDockPosition.Left
                    ? (MarkupString)SgIcons.ChevronRight
                    : (MarkupString)SgIcons.ChevronRight);
            __builder.CloseElement();
        }

        __builder.CloseElement(); // tabbar

        // Visual Constructor form
        if (_constructorPos == pos)
        {
            <div class="sgc-dock-visual-constructor">
                <div class="sgc-constructor-title">Новая панель (@pos)</div>
                
                <div class="sgc-constructor-field">
                    <label>Название</label>
                    <input type="text" placeholder="Введите название..." @bind="_newPanelTitle" @onkeyup="HandleConstructorKey" autofocus />
                </div>

                <div class="sgc-constructor-field">
                    <label>Иконка</label>
                    <div class="sgc-icon-grid">
                        @foreach (var icon in _availableIcons)
                        {
                            <div class="@Css("sgc-icon-item").AddClass("sgc-active", _newPanelIcon == icon).Build()" 
                                 @onclick="() => _newPanelIcon = icon">
                                @((MarkupString)icon)
                            </div>
                        }
                    </div>
                </div>

                <div class="sgc-constructor-actions">
                    <SgButton Text="Отмена" Size="SgSize.Sm" OnClick="() => _constructorPos = null" />
                    <SgButton Text="Создать" Variant="SgButtonVariant.Primary" Size="SgSize.Sm" OnClick="() => AddPanelFromConstructor(_newPanelTitle, pos)" />
                </div>
            </div>
        }

        // Panel body — only active tab
        var activePanel = panels.FirstOrDefault(p => p.Id == activeId);
        if (activePanel != null)
        {
            <div class="sgc-dock-pane-body">
                @if (activePanel.Tag is RenderFragment rf)
                {
                    @rf
                }
                else if (PanelTemplate != null)
                {
                    @PanelTemplate(activePanel)
                }
                else
                {
                    <div style="padding: 16px; color: var(--sg-fg-muted);">@activePanel.Title</div>
                }
            </div>
        }
    };

    private async Task HandleConstructorKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newPanelTitle))
            await AddPanelFromConstructor(_newPanelTitle, _constructorPos!.Value);
        else if (e.Key == "Escape")
            _constructorPos = null;
    }


    // ── Disposal ──────────────────────────────────────────────────────────────

    protected override async ValueTask OnDisposingAsync()
    {
        if (_attached)
        {
            try { await SafeInvokeVoidAsync("detach", RootRef); }
            catch (JSException) { }
            catch (TaskCanceledException) { }
            catch { }
        }
    }
}
