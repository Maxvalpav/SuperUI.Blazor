@namespace SuperUI.Components

<div class="sgc-result sgc-result-@Status.ToString().ToLowerInvariant() @CssClass">
    <div class="sgc-result-icon">
        @if (IconContent != null)
        {
            @IconContent
        }
        else
        {
            @switch (Status)
            {
                case SgResultStatus.Success:
                    <span class="sgc-icon-success">✔</span>
                    break;
                case SgResultStatus.Error:
                    <span class="sgc-icon-error">✘</span>
                    break;
                case SgResultStatus.Info:
                    <span class="sgc-icon-info">ℹ</span>
                    break;
                case SgResultStatus.Warning:
                    <span class="sgc-icon-warning">⚠</span>
                    break;
                case SgResultStatus.Status404:
                    <span class="sgc-icon-404">404</span>
                    break;
            }
        }
    </div>
    <div class="sgc-result-title">@Title</div>
    @if (!string.IsNullOrEmpty(SubTitle))
    {
        <div class="sgc-result-subtitle">@SubTitle</div>
    }
    @if (ExtraContent != null)
    {
        <div class="sgc-result-extra">@ExtraContent</div>
    }
    @if (ChildContent != null)
    {
        <div class="sgc-result-content">@ChildContent</div>
    }
</div>

@code {
    /// <summary>
    /// Gets or sets the result status type.
    /// Determines the icon and color scheme. Default is <see cref="SgResultStatus.Info"/>.
    /// </summary>
    [Parameter] public SgResultStatus Status { get; set; } = SgResultStatus.Info;
    
    /// <summary>
    /// Gets or sets the main title text. Required.
    /// </summary>
    [Parameter, EditorRequired] public string Title { get; set; } = default!;
    
    /// <summary>
    /// Gets or sets the subtitle text displayed below the title.
    /// </summary>
    [Parameter] public string? SubTitle { get; set; }
    
    /// <summary>
    /// Gets or sets the custom icon content to replace the default status icon.
    /// </summary>
    [Parameter] public RenderFragment? IconContent { get; set; }
    
    /// <summary>
    /// Gets or sets the extra content displayed below the subtitle.
    /// Typically used for action buttons.
    /// </summary>
    [Parameter] public RenderFragment? ExtraContent { get; set; }
    
    /// <summary>
    /// Gets or sets the main content displayed at the bottom.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    
    /// <summary>
    /// Gets or sets additional CSS classes to apply to the component.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    public enum SgResultStatus
    {
        Success,
        Error,
        Info,
        Warning,
        Status404
    }
}
