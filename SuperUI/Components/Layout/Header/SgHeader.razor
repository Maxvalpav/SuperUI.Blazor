@namespace SuperUI.Components

<header class="sgc-header @CssClass">
    @if (LeadingContent is not null)
    {
        <div class="sgc-header-leading">@LeadingContent</div>
    }
    @if (LogoContent is not null)
    {
        <div class="sgc-header-logo">@LogoContent</div>
    }
    else if (!string.IsNullOrEmpty(Title))
    {
        <div class="sgc-header-logo">
            <span class="sgc-header-title">@Title</span>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <span class="sgc-header-subtitle">@Subtitle</span>
            }
        </div>
    }
    <div class="sgc-header-body">@ChildContent</div>
    @if (ActionsContent is not null)
    {
        <div class="sgc-header-actions">@ActionsContent</div>
    }
</header>

@code {
    /// <summary>Main title text displayed in the header logo area.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>Secondary text displayed below the title.</summary>
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>Custom logo content. When set, replaces the title/subtitle layout.</summary>
    [Parameter] public RenderFragment? LogoContent { get; set; }
    /// <summary>Content rendered before the logo/title on the left side.</summary>
    [Parameter] public RenderFragment? LeadingContent { get; set; }
    /// <summary>Primary content rendered in the header body (center).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Content rendered on the right side (actions, buttons, etc.).</summary>
    [Parameter] public RenderFragment? ActionsContent { get; set; }
    /// <summary>Additional CSS classes applied to the header.</summary>
    [Parameter] public string? CssClass { get; set; }
}
