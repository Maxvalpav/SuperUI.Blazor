@namespace SuperUI.Components
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="sgc-affix @(_isBottom ? "sgc-affix-bottom" : "sgc-affix-top") @CssClass" @ref="_host">
    <div class="sgc-affix-inner @(_affixed ? "sgc-affix-active" : "")" @ref="_inner">
        @if (Template is not null)
        {
            @Template(_affixed)
        }
        else
        {
            @ChildContent
        }
    </div>
</div>

@code {
    /// <summary>
    /// Content that should stick to the viewport when scrolled past the threshold.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Optional template that receives the current affixed state, useful for changing
    /// the rendered content (e.g. a denser toolbar) when pinned.
    /// </summary>
    [Parameter] public RenderFragment<bool>? Template { get; set; }

    /// <summary>
    /// Pixel offset from the top of the viewport (or scroll target) where the element should pin.
    /// Set this OR <see cref="OffsetBottom"/>, not both. Default is 0.
    /// </summary>
    [Parameter] public int? OffsetTop { get; set; } = 0;

    /// <summary>
    /// Pixel offset from the bottom of the viewport.
    /// </summary>
    [Parameter] public int? OffsetBottom { get; set; }

    /// <summary>
    /// CSS selector for a custom scrollable container. Defaults to the window.
    /// </summary>
    [Parameter] public string? Target { get; set; }

    /// <summary>
    /// Raised when the affixed state changes.
    /// </summary>
    [Parameter] public EventCallback<bool> AffixedChanged { get; set; }

    /// <summary>
    /// Raised once when the element pins to the viewport.
    /// </summary>
    [Parameter] public EventCallback OnAffix { get; set; }

    /// <summary>
    /// Raised once when the element returns to its natural position.
    /// </summary>
    [Parameter] public EventCallback OnUnaffix { get; set; }

    /// <summary>
    /// Additional CSS class for the host wrapper.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    private ElementReference _host;
    private ElementReference _inner;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SgAffix>? _self;
    private bool _attached;
    private bool _isDisposed;
    private bool _affixed;

    private bool _isBottom => OffsetBottom.HasValue;

    /// <summary>Returns true while the element is pinned.</summary>
    public bool IsAffixed => _affixed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isDisposed || !firstRender) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/superui-affix.js");
            if (_isDisposed) return;
            _self ??= DotNetObjectReference.Create(this);
            int? offsetTop = OffsetBottom.HasValue ? null : (OffsetTop ?? 0);
            int? offsetBottom = OffsetBottom;
            await _module.InvokeVoidAsync("attach", _host, _inner, _self,
                new { offsetTop, offsetBottom, target = Target });
            _attached = true;
        }
        catch (JSException) { }
        catch (TaskCanceledException) { }
    }

    [JSInvokable]
    public async Task OnAffixed(bool active)
    {
        if (_isDisposed || _affixed == active) return;
        _affixed = active;
        if (AffixedChanged.HasDelegate) await AffixedChanged.InvokeAsync(active);
        if (active && OnAffix.HasDelegate) await OnAffix.InvokeAsync();
        if (!active && OnUnaffix.HasDelegate) await OnUnaffix.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Forces the affix to recompute its pinned state. Call this after layout changes.</summary>
    public async Task RefreshAsync()
    {
        if (_module is null || !_attached || _isDisposed) return;
        try
        {
            await _module.InvokeVoidAsync("refresh", _host);
        }
        catch (JSException) { }
        catch (TaskCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_isDisposed) return;
        _isDisposed = true;
        
        // Dispose DotNetObjectReference first
        var self = _self;
        _self = null;
        self?.Dispose();

        // Notify JS to detach and dispose
        if (_module is not null)
        {
            try
            {
                if (_attached) await _module.InvokeVoidAsync("detach", _host);
                await _module.DisposeAsync();
            }
            catch (JSException) { }
            catch (TaskCanceledException) { }
            catch (ObjectDisposedException) { }
            _module = null;
        }
    }
}
