@namespace SuperUI.Components
@using SuperUI.Enums
@inherits SgJsComponentBase

<div class="@Css("sgc-split").AddClass(IsVertical ? "sgc-v" : "sgc-h").AddClass("is-dragging", _isDragging).Build()" 
     @ref="RootRef"
     @attributes="AdditionalAttributes">
    <div class="sgc-split-pane" style="@FirstStyle" @ref="_first">@First</div>
    <div class="sgc-split-bar" @ref="_bar">
        @if (Collapsible)
        {
            <div class="sgc-split-collapse-btn sgc-btn-prev" @onclick="CollapseFirst" @onclick:stopPropagation>
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3"><path d="M18 15l-6-6-6 6"/></svg>
            </div>
        }
        
        @if (ShowHandle)
        {
            <div class="sgc-split-handle"></div>
        }

        @if (Collapsible)
        {
            <div class="sgc-split-collapse-btn sgc-btn-next" @onclick="CollapseSecond" @onclick:stopPropagation>
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg>
            </div>
        }
    </div>
    <div class="sgc-split-pane sgc-split-flex">@Second</div>
</div>

@code {
    private ElementReference _first;
    private ElementReference _bar;
    private bool _lastVertical;
    private double _initialSize;
    private bool _isDragging;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _initialSize = Size;
    }

    protected override string ModulePath => "./_content/SuperUI/superui-splitter.js";
    protected override string IdPrefix   => "sg-splitter";

    [Parameter] public RenderFragment? First { get; set; }
    [Parameter] public RenderFragment? Second { get; set; }
    [Parameter] public SgOrientation Orientation { get; set; } = SgOrientation.Horizontal;
    [Parameter] public bool Vertical { get; set; }
    [Parameter] public double Size { get; set; } = 240;
    [Parameter] public EventCallback<double> SizeChanged { get; set; }
    [Parameter] public double Min { get; set; } = 80;
    [Parameter] public double Max { get; set; } = 1200;
    [Parameter] public bool ShowHandle { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Collapsible { get; set; }

    private bool IsVertical => Orientation == SgOrientation.Vertical || Vertical;

    private string FirstStyle => IsVertical
        ? $"height:{Size.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;"
        : $"width:{Size.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;";

    private async Task CollapseFirst()
    {
        if (Size > Min) await SetSize(Min);
        else await SetSize(0);
    }

    private async Task CollapseSecond()
    {
        // For simplicity, we just set it to Max or a very large value, 
        // but a better way would be to have a proper collapse state.
        // For now, let's just use double click as "reset".
        await OnReset();
    }

    protected override async ValueTask OnInteractiveAsync()
    {
        await SafeInvokeVoidAsync("attach", _bar, _first, IsVertical, Min, Max, SelfRef, Disabled);
        _lastVertical = IsVertical;
    }

    protected override async Task OnAfterRenderSafeAsync(bool firstRender)
    {
        if (!firstRender && IsInteractive && _lastVertical != IsVertical)
        {
            await SafeInvokeVoidAsync("attach", _bar, _first, IsVertical, Min, Max, SelfRef, Disabled);
            _lastVertical = IsVertical;
        }
    }

    [JSInvokable]
    public async Task SetSize(double size)
    {
        if (Math.Abs(size - Size) < 0.5) return;
        Size = size;
        if (SizeChanged.HasDelegate) await SizeChanged.InvokeAsync(size);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void SetDragging(bool dragging)
    {
        _isDragging = dragging;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnReset()
    {
        Size = _initialSize;
        if (SizeChanged.HasDelegate) await SizeChanged.InvokeAsync(Size);
        await InvokeAsync(StateHasChanged);
    }

    protected override async ValueTask OnDisposingAsync()
    {
        await SafeInvokeVoidAsync("detach", _bar);
    }
}
