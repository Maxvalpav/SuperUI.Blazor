@namespace SuperUI.Components

@{
    var hasOnClick = OnClick.HasDelegate;
}

<CascadingValue Value="_context" IsFixed="false">
    @switch (ResolvedTag)
    {
        case SgRowTag.Section:
            <section class="@ComputedClass" style="@ComputedStyle" data-density="@DensityKey"
                     @attributes="AdditionalAttributes"
                     @onclick="hasOnClick ? HandleClick : null">@ChildContent</section>
            break;
        case SgRowTag.Header:
            <header class="@ComputedClass" style="@ComputedStyle" data-density="@DensityKey"
                    @attributes="AdditionalAttributes"
                    @onclick="hasOnClick ? HandleClick : null">@ChildContent</header>
            break;
        case SgRowTag.Footer:
            <footer class="@ComputedClass" style="@ComputedStyle" data-density="@DensityKey"
                    @attributes="AdditionalAttributes"
                    @onclick="hasOnClick ? HandleClick : null">@ChildContent</footer>
            break;
        case SgRowTag.Nav:
            <nav class="@ComputedClass" style="@ComputedStyle" data-density="@DensityKey"
                 @attributes="AdditionalAttributes"
                 @onclick="hasOnClick ? HandleClick : null">@ChildContent</nav>
            break;
        case SgRowTag.Main:
            <main class="@ComputedClass" style="@ComputedStyle" data-density="@DensityKey"
                  @attributes="AdditionalAttributes"
                  @onclick="hasOnClick ? HandleClick : null">@ChildContent</main>
            break;
        case SgRowTag.Ul:
            <ul class="@ComputedClass" style="@ComputedStyle" data-density="@DensityKey"
                @attributes="AdditionalAttributes"
                @onclick="hasOnClick ? HandleClick : null">@ChildContent</ul>
            break;
        case SgRowTag.Article:
            <article class="@ComputedClass" style="@ComputedStyle" data-density="@DensityKey"
                     @attributes="AdditionalAttributes"
                     @onclick="hasOnClick ? HandleClick : null">@ChildContent</article>
            break;
        case SgRowTag.Aside:
            <aside class="@ComputedClass" style="@ComputedStyle" data-density="@DensityKey"
                   @attributes="AdditionalAttributes"
                   @onclick="hasOnClick ? HandleClick : null">@ChildContent</aside>
            break;
        default:
            <div class="@ComputedClass" style="@ComputedStyle" data-density="@DensityKey"
                 @attributes="AdditionalAttributes"
                 @onclick="hasOnClick ? HandleClick : null">@ChildContent</div>
            break;
    }
</CascadingValue>
