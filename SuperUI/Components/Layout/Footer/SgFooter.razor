@namespace SuperUI.Components

<footer class="sgc-footer @CssClass">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <span class="sgc-footer-copy">@Copyright</span>
        @if (!string.IsNullOrEmpty(Version))
        {
            <span class="sgc-footer-version">v@Version</span>
        }
    }
</footer>

@code {
    /// <summary>Custom content rendered inside the footer. Overrides the default copyright layout.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Copyright text displayed in the footer.</summary>
    [Parameter] public string Copyright { get; set; } = $"© {DateTime.Now.Year}";
    /// <summary>Optional version label displayed next to the copyright.</summary>
    [Parameter] public string? Version { get; set; }
    /// <summary>Additional CSS classes applied to the footer.</summary>
    [Parameter] public string? CssClass { get; set; }
}
