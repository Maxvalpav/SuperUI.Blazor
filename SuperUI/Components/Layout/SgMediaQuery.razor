@namespace SuperUI.Components
@using SuperUI.Services
@using SuperUI.Enums
@inherits SgJsComponentBase
@implements IAsyncDisposable

@if (IsMatch)
{
    @if (Matching is not null)
    {
        @Matching
    }
    else
    {
        @ChildContent
    }
}
else
{
    @NotMatching
}

@code {
    [Inject] private SgBreakpointService Breakpoints { get; set; } = default!;

    private string? _activeQuery;

    /// <summary>Raw CSS media query string (e.g. <c>"(max-width: 768px)"</c> or <c>"(min-width: 1024px) and (max-width: 1280px)"</c>).</summary>
    [Parameter] public string? Query { get; set; }

    /// <summary>
    /// Show content when viewport width is at or above the given breakpoint.
    /// Mutually exclusive with <see cref="Below"/>, <see cref="BetweenStart"/>, <see cref="BetweenEnd"/>.
    /// </summary>
    [Parameter] public SgBreakpoint? Above { get; set; }

    /// <summary>
    /// Show content when viewport width is strictly below the given breakpoint.
    /// Mutually exclusive with <see cref="Above"/>, <see cref="BetweenStart"/>, <see cref="BetweenEnd"/>.
    /// </summary>
    [Parameter] public SgBreakpoint? Below { get; set; }

    /// <summary>
    /// Start of an inclusive range (paired with <see cref="BetweenEnd"/>). Both must be set.
    /// </summary>
    [Parameter] public SgBreakpoint? BetweenStart { get; set; }

    /// <summary>
    /// End of an exclusive range (paired with <see cref="BetweenStart"/>). Both must be set.
    /// </summary>
    [Parameter] public SgBreakpoint? BetweenEnd { get; set; }

    /// <summary>Rendered when the query matches.</summary>
    [Parameter] public RenderFragment? Matching { get; set; }
    /// <summary>Rendered when the query does not match.</summary>
    [Parameter] public RenderFragment? NotMatching { get; set; }
    /// <summary>Default content — used as <see cref="Matching"/> when not specified.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Fires when the match state changes.</summary>
    [Parameter] public EventCallback<bool> OnChanged { get; set; }

    /// <summary>Whether the media query currently matches.</summary>
    public bool IsMatch { get; private set; }

    protected override string ModulePath => "./_content/SuperUI/superui-browser-features.js";

    protected override async ValueTask OnInteractiveAsync()
    {
        var q = BuildQuery();
        if (string.IsNullOrEmpty(q)) return;
        _activeQuery = q;
        await SafeInvokeVoidAsync("observeMediaQuery", q, SelfRef);
    }

    public override async Task SetParametersAsync(ParameterView parameters)
    {
        var prevQuery = Query;
        var prevAbove = Above;
        var prevBelow = Below;
        var prevBs = BetweenStart;
        var prevBe = BetweenEnd;

        await base.SetParametersAsync(parameters);

        if (IsJsInitialized && (prevQuery != Query || prevAbove != Above || prevBelow != Below || prevBs != BetweenStart || prevBe != BetweenEnd))
        {
            var prevQ = _activeQuery;
            var q = BuildQuery();
            if (!string.IsNullOrEmpty(prevQ) && prevQ != q)
                await SafeInvokeVoidAsync("unobserveMediaQueryFor", prevQ, SelfRef);
            if (!string.IsNullOrEmpty(q))
            {
                _activeQuery = q;
                await SafeInvokeVoidAsync("observeMediaQuery", q, SelfRef);
            }
        }
    }

    private string BuildQuery()
    {
        if (!string.IsNullOrEmpty(Query)) return Query!;

        if (Above.HasValue) return $"(min-width: {Threshold(Above.Value)}px)";
        if (Below.HasValue) return $"(max-width: {Threshold(Below.Value) - 0.02}px)";

        if (BetweenStart.HasValue && BetweenEnd.HasValue)
            return $"(min-width: {Threshold(BetweenStart.Value)}px) and (max-width: {Threshold(BetweenEnd.Value) - 0.02}px)";

        return "(max-width: 768px)";
    }

    /// <summary>Bootstrap 5 thresholds — match <see cref="SgBreakpointService"/>.</summary>
    private static double Threshold(SgBreakpoint bp) => bp switch
    {
        SgBreakpoint.Xs  => 0,
        SgBreakpoint.Sm  => 576,
        SgBreakpoint.Md  => 768,
        SgBreakpoint.Lg  => 992,
        SgBreakpoint.Xl  => 1200,
        SgBreakpoint.Xxl => 1400,
        _                => 0,
    };

    [JSInvokable]
    public async Task OnMatchChanged(bool matches)
    {
        if (IsMatch == matches) return;
        IsMatch = matches;
        await OnChanged.InvokeAsync(matches);
        StateHasChanged();
    }

    protected override async ValueTask OnDisposingAsync()
    {
        if (!string.IsNullOrEmpty(_activeQuery))
            await SafeInvokeVoidAsync("unobserveMediaQueryFor", _activeQuery, SelfRef);
    }
}
