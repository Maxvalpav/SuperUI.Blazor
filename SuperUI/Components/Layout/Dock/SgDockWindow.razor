@namespace SuperUI.Components
@using SuperUI.Services
@using SuperUI.Localization
@using SuperUI.Enums
@inherits SgOverlayComponentBase
@if (Visible || IsClosing)
{
    if (UsePortal)
    {
        <SgPortal Visible="Visible || IsClosing">
            @RenderWindow()
        </SgPortal>
    }
    else
    {
        @RenderWindow()
    }
}

@code {
    private RenderFragment RenderWindow() => __builder =>
    {
        <div id="@ResolvedId"
             class="@Css("sgc-win").AddClass("sgc-win-maximized", _maximized).AddClass("sgc-win-minimized", _minimized).AddClass("sgc-win-focus", IsFocused).AddClass("sgc-closing", IsClosing).Build()"
             style="@GetWindowStyle()"
             @ref="RootRef"
             @attributes="AdditionalAttributes">
            <div class="sgc-win-header" @ref="_titlebarRef">
                <span class="sgc-win-title">@Title</span>
                <div class="sgc-win-actions">
                    @if (ShowMinimize)
                    {
                        <button class="sgc-win-btn" title="@Localizer["Minimize"]"
                                @onclick="ToggleMinimizeAsync" @onclick:stopPropagation>─</button>
                    }
                    @if (ShowMaximize)
                    {
                        <button class="sgc-win-btn" title="@Localizer["Maximize"]"
                                @onclick="ToggleMaximizeAsync" @onclick:stopPropagation>□</button>
                    }
                    @if (ShowClose)
                    {
                        <button class="sgc-win-btn sgc-win-close"
                                title="@Localizer["Close"]" @onclick="CloseAsync" @onclick:stopPropagation>×</button>
                    }
                </div>
            </div>
            @if (!_minimized)
            {
                <div class="sgc-win-body">
                    @ChildContent
                </div>
                @if (FooterContent is not null)
                {
                    <div class="sgc-win-footer">
                        @FooterContent
                    </div>
                }
                @if (Resizable && !_maximized)
                {
                    <div class="sgc-win-resize"></div>
                }
            }
        </div>
    };

    private ElementReference _titlebarRef;
    private bool _minimized;
    private bool _maximized;

    private bool IsFocused => ZIndex.GetTopOwner() == this;

    protected override string ModulePath  => "./_content/SuperUI/superui-window.js";
    protected override int ZIndexBase     => SgZIndexService.WindowBase;
    protected override string IdPrefix    => "sg-dock-window";
    protected override int ClosingAnimationMs => 150;

    // ── Параметры ────────────────────────────────────────────────────────

    /// <summary>
    /// Gets or sets the window title.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// Gets or sets the window body content.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the footer content.
    /// </summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>
    /// Gets or sets the left position. Default is "100px".
    /// </summary>
    [Parameter] public string Left { get; set; } = "100px";

    /// <summary>
    /// Gets or sets the top position. Default is "100px".
    /// </summary>
    [Parameter] public string Top { get; set; } = "100px";

    /// <summary>
    /// Gets or sets the window width. Default is "400px".
    /// </summary>
    [Parameter] public string Width { get; set; } = "400px";

    /// <summary>
    /// Gets or sets the window height. Default is "300px".
    /// </summary>
    [Parameter] public string Height { get; set; } = "300px";

    /// <summary>
    /// Gets or sets whether the window is draggable.
    /// </summary>
    [Parameter] public bool Draggable { get; set; } = true;

    /// <summary>
    /// Gets or sets whether the window is resizable.
    /// </summary>
    [Parameter] public bool Resizable { get; set; } = true;

    /// <summary>
    /// Gets or sets whether the minimize button is shown.
    /// </summary>
    [Parameter] public bool ShowMinimize { get; set; } = true;

    /// <summary>
    /// Gets or sets whether the maximize button is shown.
    /// </summary>
    [Parameter] public bool ShowMaximize { get; set; } = true;

    /// <summary>
    /// Gets or sets whether the close button is shown.
    /// </summary>
    [Parameter] public bool ShowClose { get; set; } = true;

    /// <summary>
    /// Gets or sets whether the window should be rendered through a portal (to the body). Default is true.
    /// </summary>
    [Parameter] public bool UsePortal { get; set; } = true;

    /// <summary>
    /// Gets or sets whether the window is minimized.
    /// </summary>
    [Parameter] public bool Minimized { get; set; }

    /// <summary>
    /// Callback invoked when minimized state changes.
    /// </summary>
    [Parameter] public EventCallback<bool> MinimizedChanged { get; set; }

    /// <summary>
    /// Gets or sets whether the window is maximized.
    /// </summary>
    [Parameter] public bool Maximized { get; set; }

    /// <summary>
    /// Callback invoked when maximized state changes.
    /// </summary>
    [Parameter] public EventCallback<bool> MaximizedChanged { get; set; }

    /// <summary>
    /// Callback invoked when the window is closed.
    /// </summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Callback invoked when window bounds change.
    /// </summary>
    [Parameter] public EventCallback<WindowBounds> BoundsChanged { get; set; }

    // ── Lifecycle ─────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ZIndex.TopOwnerChanged += OnTopOwnerChanged;
        _minimized = Minimized;
        _maximized = Maximized;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Minimized != _minimized) _minimized = Minimized;
        if (Maximized != _maximized) _maximized = Maximized;
    }

    private void OnTopOwnerChanged(object? topOwner) => StateHasChanged();

    protected override async ValueTask OnDisposingAsync()
    {
        ZIndex.TopOwnerChanged -= OnTopOwnerChanged;
        await base.OnDisposingAsync();
    }

    protected override async ValueTask OnOpeningAsync()
    {
        await SafeInvokeVoidAsync("attach", RootRef, SelfRef);
    }

    protected override async ValueTask OnClosingAsync()
    {
        await SafeInvokeVoidAsync("detach", RootRef);
    }

    protected override async ValueTask OnClosedAsync()
    {
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }

    // ── Computed ─────────────────────────────────────────────────────────

    private string GetWindowStyle() =>
        Styles()
            .AddStyle("z-index",  ZIndexValue.ToString(), ZIndexValue > 0)
            .AddStyle("left",     FormatUnit(Left))
            .AddStyle("top",      FormatUnit(Top))
            .AddStyle("width",    FormatUnit(Width))
            .AddStyle("height",   FormatUnit(Height),  !_minimized && !_maximized)
            .AddStyle("display",  "none", !Visible && !IsClosing)
            .Build();

    private static string FormatUnit(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "0px";
        if (double.TryParse(value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out _))
            return value + "px";
        return value;
    }

    // ── Handlers ─────────────────────────────────────────────────────────

    /// <summary>
    /// Opens the window and brings it to front.
    /// </summary>
    public async Task OpenAsync()
    {
        bool changed = false;
        if (!Visible)
        {
            Visible = true;
            if (VisibleChanged.HasDelegate)
                await VisibleChanged.InvokeAsync(true);
        }
        if (_minimized)
        {
            _minimized = false;
            changed = true;
            if (MinimizedChanged.HasDelegate)
                await MinimizedChanged.InvokeAsync(false);
        }
        await FocusAsync();
        if (changed) StateHasChanged();
    }

    /// <summary>
    /// Maximizes or restores the window.
    /// </summary>
    public async Task ToggleMaximizeAsync()
    {
        _maximized = !_maximized;
        _minimized = false;
        if (MaximizedChanged.HasDelegate)
            await MaximizedChanged.InvokeAsync(_maximized);
        if (MinimizedChanged.HasDelegate)
            await MinimizedChanged.InvokeAsync(_minimized);
        StateHasChanged();
    }

    /// <summary>
    /// Minimizes or restores the window.
    /// </summary>
    public async Task ToggleMinimizeAsync()
    {
        _minimized = !_minimized;
        if (MinimizedChanged.HasDelegate)
            await MinimizedChanged.InvokeAsync(_minimized);
        StateHasChanged();
    }

    [JSInvokable]
    public override Task RequestCloseAsync() => CloseAsync();

    [JSInvokable]
    public async Task UpdateBoundsAsync(double left, double top, double width, double height)
    {
        Left   = $"{left}px";
        Top    = $"{top}px";
        Width  = $"{width}px";
        Height = $"{height}px";
        
        if (BoundsChanged.HasDelegate)
            await BoundsChanged.InvokeAsync(new WindowBounds(left, top, width, height));
        
        StateHasChanged();
    }

    [JSInvokable]
    public async Task MinimizeAsync() => await ToggleMinimizeAsync();

    /// <summary>
    /// Brings the window to the front of the stacking order.
    /// </summary>
    [JSInvokable]
    public async Task FocusAsync()
    {
        if (Visible)
        {
            BringToFront();
            StateHasChanged();
        }
        await Task.CompletedTask;
    }
}
