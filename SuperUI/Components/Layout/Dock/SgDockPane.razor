@namespace SuperUI.Components
@using SuperUI.Enums
@implements IDisposable

@code {
    [CascadingParameter] public SgDockManager? Manager { get; set; }

    /// <summary>Unique identifier for the panel.</summary>
    [Parameter] public string? Id { get; set; }
    /// <summary>Tab title displayed in the dock header.</summary>
    [Parameter] public string Title { get; set; } = "";
    /// <summary>Optional SVG icon markup shown in the tab.</summary>
    [Parameter] public string? Icon { get; set; }
    /// <summary>Dock position (left, right, top, bottom, center).</summary>
    [Parameter] public SgDockPosition Position { get; set; } = SgDockPosition.Center;
    /// <summary>Whether the panel can be closed by the user.</summary>
    [Parameter] public bool Closable { get; set; } = true;
    /// <summary>Whether the panel is visible.</summary>
    [Parameter] public bool Visible { get; set; } = true;
    /// <summary>Arbitrary data attached to the panel.</summary>
    [Parameter] public object? Tag { get; set; }
    /// <summary>Content rendered inside the panel.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private SgDockPanel? _panel;

    protected override void OnInitialized()
    {
        if (Manager != null)
        {
            _panel = new SgDockPanel
            {
                Id = Id ?? Guid.NewGuid().ToString("N")[..8],
                Title = Title,
                Icon = Icon,
                Position = Position,
                Closable = Closable,
                Visible = Visible,
                Tag = Tag ?? ChildContent // Store the content in Tag if not provided otherwise
            };
            Manager.RegisterPanel(_panel);
        }
    }

    public void Dispose()
    {
        if (Manager != null && _panel != null)
        {
            Manager.UnregisterPanel(_panel);
        }
    }
}
