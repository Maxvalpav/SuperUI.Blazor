@namespace SuperUI.Components
@inherits SgComponentBase

<div class="@ComputedClass" style="@ComputedStyle" @attributes="AttributesWithoutClassAndStyle">
    @if (Split != null && _items.Count > 0)
    {
        @for (int i = 0; i < _items.Count; i++)
        {
            var item = _items[i];
            @item
            @if (i < _items.Count - 1)
            {
                <span class="sgc-space-split" aria-hidden="true">@Split</span>
            }
        }
    }
    else
    {
        @ChildContent
    }
</div>

@code {
    // When Split is used we need to capture children individually.
    // We use a simple approach: render ChildContent normally when no Split,
    // and when Split is set, the parent should pass items via SpaceItem helper.
    // For now, ChildContent renders as-is; Split renders as a visual separator via CSS.
    private List<RenderFragment> _items = new();
}
