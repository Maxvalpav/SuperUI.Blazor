@namespace SuperUI.Components
@inherits SgComponentBase

<div class="@ComputedClass" style="@ComputedStyle" @attributes="AttributesWithoutClassAndStyle">
    @if (Split == null)
    {
        @ChildContent
    }
    else
    {
        @* Logic for Split would require a custom RenderFragment or wrapping children, 
           but for a basic Space component, we'll focus on the gap first. *@
        @ChildContent
    }
</div>
