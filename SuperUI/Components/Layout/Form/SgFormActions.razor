@namespace SuperUI.Components

<div class="sgc-form-actions @CssClass">
    @ChildContent
</div>

@code {
    /// <summary>Content rendered inside the form actions area.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Additional CSS classes applied to the form actions container.</summary>
    [Parameter] public string? CssClass { get; set; }
}
