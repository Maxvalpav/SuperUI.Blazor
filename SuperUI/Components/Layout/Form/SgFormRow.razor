@namespace SuperUI.Components

<div class="sgc-form-row @CssClass">
    @ChildContent
</div>

@code {
    /// <summary>Content rendered inside the form row.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Additional CSS classes applied to the form row.</summary>
    [Parameter] public string? CssClass { get; set; }
}
