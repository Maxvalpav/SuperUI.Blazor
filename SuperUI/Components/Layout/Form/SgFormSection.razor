@namespace SuperUI.Components

<fieldset class="sgc-form-section @CssClass">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="sgc-form-section-title">@Title</div>
    }
    @ChildContent
</fieldset>

@code {
    /// <summary>Section title displayed above the content.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>Content rendered inside the form section.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Additional CSS classes applied to the form section.</summary>
    [Parameter] public string? CssClass { get; set; }
}
