@namespace SuperUI.Components
@inherits SgComponentBase

@switch (ResolvedTag)
{
    case SgRowTag.Section:
        <section class="@ComputedClass" style="@ComputedStyle" data-density="@Density.ToString().ToLowerInvariant()"
                 @attributes="AttributesWithoutClassAndStyle"
                 @onclick="hasOnClick ? HandleClick : null">
            @ChildContent
        </section>
        break;
    case SgRowTag.Header:
        <header class="@ComputedClass" style="@ComputedStyle" data-density="@Density.ToString().ToLowerInvariant()"
                @attributes="AttributesWithoutClassAndStyle"
                @onclick="hasOnClick ? HandleClick : null">
            @ChildContent
        </header>
        break;
    case SgRowTag.Footer:
        <footer class="@ComputedClass" style="@ComputedStyle" data-density="@Density.ToString().ToLowerInvariant()"
                @attributes="AttributesWithoutClassAndStyle"
                @onclick="hasOnClick ? HandleClick : null">
            @ChildContent
        </footer>
        break;
    case SgRowTag.Nav:
        <nav class="@ComputedClass" style="@ComputedStyle" data-density="@Density.ToString().ToLowerInvariant()"
             @attributes="AttributesWithoutClassAndStyle"
             @onclick="hasOnClick ? HandleClick : null">
            @ChildContent
        </nav>
        break;
    case SgRowTag.Main:
        <main class="@ComputedClass" style="@ComputedStyle" data-density="@Density.ToString().ToLowerInvariant()"
              @attributes="AttributesWithoutClassAndStyle"
              @onclick="hasOnClick ? HandleClick : null">
            @ChildContent
        </main>
        break;
    default:
        <div class="@ComputedClass" style="@ComputedStyle" data-density="@Density.ToString().ToLowerInvariant()"
             @attributes="AttributesWithoutClassAndStyle"
             @onclick="hasOnClick ? HandleClick : null">
            @ChildContent
        </div>
        break;
}
