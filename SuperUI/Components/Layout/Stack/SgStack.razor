@namespace SuperUI.Components
@inherits SgComponentBase

@if (string.Equals(Tag, "nav", StringComparison.OrdinalIgnoreCase))
{
    <nav class="@ComputedClass" style="@ComputedStyle" @attributes="AttributesWithoutClassAndStyle"
         @onclick="HandleClick">
        @ChildContent
    </nav>
}
else if (string.Equals(Tag, "section", StringComparison.OrdinalIgnoreCase))
{
    <section class="@ComputedClass" style="@ComputedStyle" @attributes="AttributesWithoutClassAndStyle"
             @onclick="HandleClick">
        @ChildContent
    </section>
}
else if (string.Equals(Tag, "header", StringComparison.OrdinalIgnoreCase))
{
    <header class="@ComputedClass" style="@ComputedStyle" @attributes="AttributesWithoutClassAndStyle"
             @onclick="HandleClick">
        @ChildContent
    </header>
}
else if (string.Equals(Tag, "footer", StringComparison.OrdinalIgnoreCase))
{
    <footer class="@ComputedClass" style="@ComputedStyle" @attributes="AttributesWithoutClassAndStyle"
             @onclick="HandleClick">
        @ChildContent
    </footer>
}
else if (string.Equals(Tag, "main", StringComparison.OrdinalIgnoreCase))
{
    <main class="@ComputedClass" style="@ComputedStyle" @attributes="AttributesWithoutClassAndStyle"
           @onclick="HandleClick">
        @ChildContent
    </main>
}
else
{
    <div class="@ComputedClass" style="@ComputedStyle" @attributes="AttributesWithoutClassAndStyle"
         @onclick="HandleClick">
        @ChildContent
    </div>
}