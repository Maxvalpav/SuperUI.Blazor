@namespace SuperUI.Components
@using Microsoft.JSInterop
@using SuperUI.Base.ComponentBases
@inherits SgJsComponentBase

<div @ref="RootRef"
     class="@ContainerClass"
     style="@ContainerStyle"
     @attributes="AdditionalAttributes">

    @if (TransitionEnabled)
    {
        <div class="sgc-responsive-transition @(_transitioning ? "sgc-responsive-transition-in" : "sgc-responsive-transition-out")">
            @RenderCurrentBreakpoint
        </div>
    }
    else
    {
        @RenderCurrentBreakpoint
    }
</div>

@code {
    private double _width;
    private string _previousBreakpoint = "wide";
    private bool _transitioning;

    /// <summary>Content rendered when the container width is below the narrow threshold.</summary>
    [Parameter] public RenderFragment? OnNarrow { get; set; }
    /// <summary>Content rendered when the container width is between narrow and wide thresholds.</summary>
    [Parameter] public RenderFragment? OnMedium { get; set; }
    /// <summary>Content rendered when the container width is at or above the wide threshold.</summary>
    [Parameter] public RenderFragment? OnWide { get; set; }
    /// <summary>Width threshold in pixels below which the container is considered narrow.</summary>
    [Parameter] public int NarrowThreshold { get; set; } = 400;
    /// <summary>Width threshold in pixels at or above which the container is considered wide.</summary>
    [Parameter] public int WideThreshold { get; set; } = 800;
    /// <summary>Enables animated transitions when switching between breakpoints.</summary>
    [Parameter] public bool TransitionEnabled { get; set; }
    /// <summary>Debounce delay in milliseconds for resize observation.</summary>
    [Parameter] public int ObserveDebounceMs { get; set; } = 50;
    /// <summary>Additional CSS class applied to the root container.</summary>
    [Parameter] public string? ClassName { get; set; }
    /// <summary>Minimum height of the container.</summary>
    [Parameter] public string? MinHeight { get; set; } = "100%";
    /// <summary>Padding applied to the container.</summary>
    [Parameter] public string? Padding { get; set; } = "0";
    /// <summary>Callback invoked when the breakpoint changes. Provides the new breakpoint name.</summary>
    [Parameter] public EventCallback<string> BreakpointChanged { get; set; }
    /// <summary>Callback invoked when the container width changes. Provides the current width in pixels.</summary>
    [Parameter] public EventCallback<double> WidthChanged { get; set; }

    public string CurrentBreakpoint
    {
        get
        {
            if (_width < NarrowThreshold) return "narrow";
            if (_width < WideThreshold) return "medium";
            return "wide";
        }
    }

    public double CurrentWidth => _width;

    private RenderFragment? RenderCurrentBreakpoint => CurrentBreakpoint switch
    {
        "narrow" => OnNarrow,
        "medium" => OnMedium,
        _ => OnWide
    };

    private string ContainerClass
    {
        get
        {
            var bp = CurrentBreakpoint;
            return $"sgc-responsive-container sgc-responsive-{bp}{(ClassName != null ? " " + ClassName : "")}";
        }
    }

    private string ContainerStyle
    {
        get
        {
            var parts = new List<string>();
            if (!string.IsNullOrEmpty(MinHeight)) parts.Add($"min-height:{MinHeight}");
            if (!string.IsNullOrEmpty(Padding)) parts.Add($"padding:{Padding}");
            var styles = Styles().Build();
            if (!string.IsNullOrEmpty(styles)) parts.Add(styles);
            return string.Join(";", parts);
        }
    }

    protected override string ModulePath => "./_content/SuperUI/superui-responsive.js";
    protected override string IdPrefix => "sg-responsive";

    protected override async ValueTask OnInteractiveAsync()
    {
        await SafeInvokeVoidAsync("observeResize", RootRef, SelfRef, ObserveDebounceMs);
    }

    [JSInvokable]
    public void OnResize(double width)
    {
        var prev = CurrentBreakpoint;
        _width = width;
        var next = CurrentBreakpoint;

        if (WidthChanged.HasDelegate)
            _ = WidthChanged.InvokeAsync(width);

        if (prev != next)
        {
            if (TransitionEnabled)
            {
                _transitioning = false;
                StateHasChanged();
                _ = InvokeAsync(async () =>
                {
                    await Task.Yield();
                    _transitioning = true;
                    StateHasChanged();
                });
            }

            if (BreakpointChanged.HasDelegate)
                _ = BreakpointChanged.InvokeAsync(next);
        }

        StateHasChanged();
    }

    protected override async ValueTask OnDisposingAsync()
    {
        await SafeInvokeVoidAsync("disconnect", RootRef);
    }
}
