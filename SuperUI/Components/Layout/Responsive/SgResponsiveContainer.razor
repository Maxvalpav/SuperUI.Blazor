@namespace SuperUI.Components
@using Microsoft.JSInterop
@using SuperUI.Base.ComponentBases
@inherits SgJsComponentBase

@switch (Tag?.ToLowerInvariant())
{
    case "section":
        <section @ref="RootRef" class="@ContainerClass" style="@ContainerStyle" @attributes="AdditionalAttributes">
            @if (TransitionEnabled)
            {
                <div class="sgc-responsive-transition @(_transitioning ? "sgc-responsive-transition-in" : "sgc-responsive-transition-out")">@RenderCurrentBreakpoint</div>
            }
            else
            {
                @RenderCurrentBreakpoint
            }
            @if (ShowBreakpointIndicator)
            {
                <span class="sgc-responsive-indicator" aria-hidden="true">
                    <span class="sgc-responsive-indicator-bp">@CurrentBreakpoint</span>
                    <span class="sgc-responsive-indicator-px">@($"{_width:F0}px")</span>
                </span>
            }
        </section>
        break;
    case "article":
        <article @ref="RootRef" class="@ContainerClass" style="@ContainerStyle" @attributes="AdditionalAttributes">
            @if (TransitionEnabled)
            {
                <div class="sgc-responsive-transition @(_transitioning ? "sgc-responsive-transition-in" : "sgc-responsive-transition-out")">@RenderCurrentBreakpoint</div>
