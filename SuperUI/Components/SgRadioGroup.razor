@namespace SuperUI.Components
@typeparam TValue
@inherits SgFormFieldBase<TValue>

<div class="@GetFieldClasses()"
     style="@Style"
     role="radiogroup"
     aria-labelledby="@(string.IsNullOrEmpty(Label) ? null : $"{EffectiveId}-label")"
     aria-required="@(Required ? "true" : null)"
     aria-invalid="@(HasError ? "true" : null)"
     aria-describedby="@DescribedBy"
     @attributes="AdditionalAttributesFiltered">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label id="@($"{EffectiveId}-label")" class="sgc-label @(Required ? "sgc-required" : "")">@Label</label>
    }

    <div class="@RadioListClass" @onkeydown="OnKeyDownAsync">
        @{
            var optionList = Options as IList<RadioOption<TValue>> ?? Options.ToList();
        }
        @for (var i = 0; i < optionList.Count; i++)
        {
            var index = i;
            var option = optionList[index];
            var isChecked = EqualityComparer<TValue>.Default.Equals(Value, option.Value);
            var isDisabled = IsEffectivelyDisabled || option.Disabled;
            <label class="@GetOptionClasses(isChecked, isDisabled)">
                <input type="radio"
                       name="@_name"
                       checked="@isChecked"
                       disabled="@isDisabled"
                       tabindex="@(isChecked || (Value is null && index == FirstEnabledIndex) ? 0 : -1)"
                       data-sg-rg-index="@index"
                       @onchange="() => SelectAsync(option.Value)"
                       @onfocus="HandleFocusAsync"
                       @onblur="HandleBlurAsync" />
                <span>@option.Label</span>
            </label>
        }
    </div>

    @if (HasError)
    {
        <span id="@($"{EffectiveId}-err")" class="sgc-error">@DisplayedError</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@($"{EffectiveId}-hint")" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private readonly string _name = "sgrg-" + Guid.NewGuid().ToString("N")[..8];

    [Parameter] public IEnumerable<RadioOption<TValue>> Options { get; set; } = Array.Empty<RadioOption<TValue>>();
    [Parameter] public SgRadioOrientation Orientation { get; set; } = SgRadioOrientation.Horizontal;
    [Parameter] public bool ButtonGroup { get; set; }
    [Parameter] public bool Block { get; set; } = true;
    [Parameter] public string? CssClass { get; set; }

    protected override string ComponentPrefix => "rg";

    private string? DescribedBy => HasError ? $"{EffectiveId}-err" : (!string.IsNullOrEmpty(Hint) ? $"{EffectiveId}-hint" : null);
    private string? DisplayedError => !string.IsNullOrEmpty(ErrorText) ? ErrorText : ValidationMessages.FirstOrDefault();

    private int FirstEnabledIndex
    {
        get
        {
            var index = 0;
            foreach (var option in Options)
            {
                if (!(IsEffectivelyDisabled || option.Disabled))
                    return index;
                index++;
            }

            return 0;
        }
    }

    private string RadioListClass => ButtonGroup
        ? $"sgc-radio-btn-group {(Block ? "sgc-block" : "")}"
        : $"sgc-radio-list {(Orientation == SgRadioOrientation.Vertical ? "sgc-vertical" : "")}";

    private string GetFieldClasses() => Css("sgc-field")
        .AddIf("sgc-block", Block)
        .Add(CssClass)
        .Add(Class)
        .ToString();

    private string GetOptionClasses(bool isChecked, bool isDisabled) => Css("sgc-check")
        .AddIf("sgc-radio-btn", ButtonGroup)
        .AddIf("sgc-disabled", isDisabled)
        .AddIf("sgc-radio-btn-active", isChecked && ButtonGroup)
        .ToString();

    private Task SelectAsync(TValue? value) => SetValueAsync(value);

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (IsEffectivelyDisabled) return;

        var list = Options as IList<RadioOption<TValue>> ?? Options.ToList();
        if (list.Count == 0) return;

        var current = -1;
        for (var i = 0; i < list.Count; i++)
        {
            if (EqualityComparer<TValue>.Default.Equals(Value, list[i].Value))
            {
                current = i;
                break;
            }
        }

        var next = current;
        switch (e.Key)
        {
            case "ArrowRight":
            case "ArrowDown":
                next = NextEnabled(list, current, +1);
                break;
            case "ArrowLeft":
            case "ArrowUp":
                next = NextEnabled(list, current, -1);
                break;
            case "Home":
                next = NextEnabled(list, -1, +1);
                break;
            case "End":
                next = NextEnabled(list, list.Count, -1);
                break;
            default:
                return;
        }

        if (next >= 0 && next != current)
            await SelectAsync(list[next].Value);
    }

    private static int NextEnabled(IList<RadioOption<TValue>> list, int from, int step)
    {
        var count = list.Count;
        if (count == 0) return -1;

        for (var stepIndex = 1; stepIndex <= count; stepIndex++)
        {
            var index = ((from + step * stepIndex) % count + count) % count;
            if (!list[index].Disabled)
                return index;
        }

        return -1;
    }

    protected override IReadOnlyDictionary<string, object> BuildAriaAttributes()
    {
        return new AriaBuilder()
            .Label(Label)
            .Required(Required)
            .Invalid(HasError)
            .Disabled(Disabled)
            .Build();
    }
}
