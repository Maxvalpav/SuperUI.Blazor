@namespace SuperUI.Components
@typeparam TValue
@inherits SgInputBase<TValue>

<div class="sgc-field @(Block ? "sgc-block" : "") @CssClass"
     role="radiogroup"
     aria-label="@Label"
     aria-required="@(Required ? "true" : null)"
     aria-invalid="@(HasValidationErrors ? "true" : null)">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sgc-label @(Required ? "sgc-required" : "")">@Label</label>
    }
    <div style="display:flex; gap:12px; flex-wrap:wrap;">
        @foreach (var opt in Options)
        {
            var o = opt;
            var checkedNow = EqualityComparer<TValue>.Default.Equals(Value, o.Value);
            <label class="sgc-check @(Disabled || o.Disabled ? "sgc-disabled" : "")">
                <input type="radio"
                       role="radio"
                       name="@_name"
                       checked="@checkedNow"
                       disabled="@(Disabled || o.Disabled)"
                       aria-checked="@(checkedNow ? "true" : "false")"
                       @onchange="() => SelectAsync(o.Value)"
                       @attributes="AdditionalAttributes" />
                <span>@o.Label</span>
            </label>
        }
    </div>
    @if (HasValidationErrors)
    {
        <span class="sgc-error">@ValidationMessages.FirstOrDefault()</span>
    }
</div>

@code {
    private readonly string _name = "sgrg-" + Guid.NewGuid().ToString("N")[..8];

    /// <summary>
    /// Gets or sets the collection of radio button options to display.
    /// </summary>
    [Parameter] public IEnumerable<RadioOption<TValue>> Options { get; set; } = Array.Empty<RadioOption<TValue>>();
    
    /// <summary>
    /// Gets or sets the label text displayed above the radio group.
    /// </summary>
    [Parameter] public string? Label { get; set; }
    
    /// <summary>
    /// Gets or sets whether the radio group should take full width of its container. Default is true.
    /// </summary>
    [Parameter] public bool Block { get; set; } = true;
    
    /// <summary>
    /// Gets or sets whether a selection is required.
    /// </summary>
    [Parameter] public bool Required { get; set; }
    
    /// <summary>
    /// Gets or sets whether all radio buttons are disabled.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }
    
    /// <summary>
    /// Gets or sets additional CSS class names to apply to the field container.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the radio input elements.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private Task SelectAsync(TValue? value) => SetValueAsync(value);
}
