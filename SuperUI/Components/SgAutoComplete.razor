@namespace SuperUI.Components
@typeparam TItem
@using System.Linq.Expressions
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer
@implements IDisposable

<div class="sgc-field @(Block ? "sgc-block" : "") @CssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label id="@_labelId" class="sgc-label @(Required ? "sgc-required" : "")">@Label</label>
    }
    <div class="sgc-combo sgc-ac @(Block ? "sgc-block" : "") @(_open ? "sgc-open" : "") @(Disabled ? "sgc-disabled" : "") @(IsInvalid ? "sgc-invalid" : "")"
         role="combobox"
         aria-expanded="@(_open ? "true" : "false")"
         aria-haspopup="listbox"
         aria-labelledby="@_labelId"
         aria-required="@(Required ? "true" : null)"
         aria-disabled="@(Disabled ? "true" : null)"
         aria-invalid="@(IsInvalid ? "true" : null)"
         aria-describedby="@DescribedBy"
         @onclick:stopPropagation="true">
        <div class="sgc-combo-control">
            <input class="sgc-combo-input"
                   value="@_search"
                   placeholder="@EffectivePlaceholder"
                   disabled="@Disabled"
                   aria-autocomplete="list"
                   aria-controls="@_listboxId"
                   @onfocus="OpenAsync"
                   @oninput="OnSearchInput"
                   @onkeydown="OnKeyDownAsync" />
            @if (AllowClear && Value is not null && !Disabled)
            {
                <button class="sgc-combo-clear" type="button" aria-label="@ClearLabel" @onclick="ClearAsync">×</button>
            }
            <span class="sgc-combo-caret" aria-hidden="true">@(_open ? "▲" : "▼")</span>
        </div>
        @if (_open)
        {
            <div id="@_listboxId" class="sgc-combo-menu" role="listbox">
                @{ var filtered = GetFilteredItems().ToList(); }
                @if (_search.Length < MinCharacters)
                {
                    <div class="sgc-combo-empty" role="status">@Localizer["DataGrid_AutoCompleteMinChars"]</div>
                }
                else if (filtered.Count == 0)
                {
                    <div class="sgc-combo-empty" role="status">@EffectiveEmptyText</div>
                }
                else
                {
                    @for (var i = 0; i < filtered.Count; i++)
                    {
                        var idx = i;
                        var item = filtered[idx];
                        <div class="sgc-combo-option @(idx == _activeIndex ? "sgc-active" : "") @(IsSelected(item) ? "sgc-selected" : "")"
                             role="option"
                             aria-selected="@(IsSelected(item) ? "true" : "false")"
                             @onclick="() => PickAsync(item)">
                            @LabelFrom(item)
                        </div>
                    }
                }
            </div>
        }
    </div>
    @if (IsInvalid)
    {
        <span id="@_errorId" class="sgc-error">@DisplayedError</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@_hintId" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private readonly string _labelId = "sg-ac-label-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _listboxId = "sg-ac-listbox-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _hintId = "sg-ac-hint-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _errorId = "sg-ac-err-" + Guid.NewGuid().ToString("N")[..8];
    private bool _open;
    private string _search = string.Empty;
    private int _activeIndex = -1;
    private SgEditContextBinder<TItem?>? _binder;

    [CascadingParameter] private EditContext? CascadedEditContext { get; set; }
    
    /// <summary>
    /// Gets or sets the expression that identifies the bound value for EditContext validation.
    /// </summary>
    [Parameter] public Expression<Func<TItem?>>? ValueExpression { get; set; }
    
    /// <summary>
    /// Gets or sets the currently selected item.
    /// </summary>
    [Parameter] public TItem? Value { get; set; }
    
    /// <summary>
    /// Gets or sets the callback invoked when the selected item changes.
    /// </summary>
    [Parameter] public EventCallback<TItem?> ValueChanged { get; set; }
    
    /// <summary>
    /// Gets or sets the collection of items to search and select from.
    /// </summary>
    [Parameter] public IEnumerable<TItem> Items { get; set; } = Array.Empty<TItem>();
    
    /// <summary>
    /// Gets or sets the function to extract display text from each item.
    /// If not specified, uses ToString() on the item.
    /// </summary>
    [Parameter] public Func<TItem, string>? LabelSelector { get; set; }
    
    /// <summary>
    /// Gets or sets the placeholder text shown when no item is selected.
    /// If not specified, uses the localized "Select" string.
    /// </summary>
    [Parameter] public string? Placeholder { get; set; }
    
    /// <summary>
    /// Gets or sets the text displayed when no items match the search.
    /// If not specified, uses the localized "NoMatches" string.
    /// </summary>
    [Parameter] public string? EmptyText { get; set; }
    
    /// <summary>
    /// Gets or sets the label text displayed above the autocomplete.
    /// </summary>
    [Parameter] public string? Label { get; set; }
    
    /// <summary>
    /// Gets or sets the hint text displayed below the autocomplete.
    /// </summary>
    [Parameter] public string? Hint { get; set; }
    
    /// <summary>
    /// Gets or sets the error text to display. Takes precedence over validation messages from EditContext.
    /// </summary>
    [Parameter] public string? ErrorText { get; set; }
    
    /// <summary>
    /// Gets or sets whether a clear button is shown when an item is selected. Default is true.
    /// </summary>
    [Parameter] public bool AllowClear { get; set; } = true;
    
    /// <summary>
    /// Gets or sets whether a selection is required.
    /// </summary>
    [Parameter] public bool Required { get; set; }
    
    /// <summary>
    /// Gets or sets whether the autocomplete is disabled.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }
    
    /// <summary>
    /// Gets or sets whether the autocomplete should take full width of its container. Default is true.
    /// </summary>
    [Parameter] public bool Block { get; set; } = true;
    
    /// <summary>
    /// Gets or sets the minimum number of characters required before showing suggestions. Default is 0.
    /// </summary>
    [Parameter] public int MinCharacters { get; set; } = 0;
    
    /// <summary>
    /// Gets or sets the maximum number of suggestions to display. Default is 8.
    /// </summary>
    [Parameter] public int MaxResults { get; set; } = 8;
    
    /// <summary>
    /// Gets or sets additional CSS class names to apply to the field container.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    private string EffectivePlaceholder => Placeholder ?? Localizer["Select"];
    private string EffectiveEmptyText => string.IsNullOrEmpty(EmptyText) ? Localizer["NoMatches"] : EmptyText;
    private string ClearLabel => Localizer["Clear"];

    private bool IsInvalid => !string.IsNullOrEmpty(ErrorText) || (_binder?.HasValidationErrors ?? false);
    private string? DisplayedError => !string.IsNullOrEmpty(ErrorText) 
        ? ErrorText 
        : _binder?.ValidationMessages.FirstOrDefault();
    private string? DescribedBy => IsInvalid ? _errorId : (!string.IsNullOrEmpty(Hint) ? _hintId : null);

    protected override void OnInitialized()
    {
        _binder = new SgEditContextBinder<TItem?>(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        _binder?.Update(CascadedEditContext, ValueExpression);
        if (!_open)
        {
            _search = Value is null ? string.Empty : LabelFrom(Value);
        }
    }

    private string LabelFrom(TItem item) => LabelSelector is not null ? LabelSelector(item) : item?.ToString() ?? string.Empty;
    private bool IsSelected(TItem item) => EqualityComparer<TItem>.Default.Equals(item, Value!);

    private IEnumerable<TItem> GetFilteredItems()
    {
        if (_search.Length < MinCharacters)
        {
            return Array.Empty<TItem>();
        }

        return Items
            .Where(item => LabelFrom(item).Contains(_search, StringComparison.CurrentCultureIgnoreCase))
            .Take(Math.Max(1, MaxResults));
    }

    private Task OpenAsync()
    {
        if (Disabled) return Task.CompletedTask;
        _open = true;
        return InvokeAsync(StateHasChanged);
    }

    private Task CloseAsync()
    {
        _open = false;
        _activeIndex = -1;
        if (Value is not null)
        {
            _search = LabelFrom(Value);
        }
        return InvokeAsync(StateHasChanged);
    }

    private Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _open = true;
        _activeIndex = 0;
        if (string.IsNullOrWhiteSpace(_search) && Value is not null)
        {
            Value = default;
            if (ValueChanged.HasDelegate)
            {
                _ = ValueChanged.InvokeAsync(default);
            }
            _binder?.NotifyFieldChanged();
        }
        return InvokeAsync(StateHasChanged);
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        var filtered = GetFilteredItems().ToList();
        if (e.Key == "ArrowDown")
        {
            _open = true;
            _activeIndex = Math.Min(filtered.Count - 1, _activeIndex + 1);
        }
        else if (e.Key == "ArrowUp")
        {
            _activeIndex = Math.Max(0, _activeIndex - 1);
        }
        else if (e.Key == "Enter")
        {
            if (_activeIndex >= 0 && _activeIndex < filtered.Count)
            {
                await PickAsync(filtered[_activeIndex]);
                return;
            }
        }
        else if (e.Key == "Escape")
        {
            await CloseAsync();
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task PickAsync(TItem item)
    {
        Value = item;
        _search = LabelFrom(item);
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(item);
        }
        _binder?.NotifyFieldChanged();
        await CloseAsync();
    }

    private async Task ClearAsync()
    {
        Value = default;
        _search = string.Empty;
        _open = false;
        _activeIndex = -1;
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(default);
        }
        _binder?.NotifyFieldChanged();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => _binder?.Dispose();
}

