@* SuperUI/Components/SgToastHost.razor *@
@* ИСПРАВЛЕНИЯ:                                                         *@
@* ✅ CS0117: SgPlacement.TopRight — теперь существует в SgEnums.cs    *@
@* ✅ CS0019: сравнение enum через == (работает после добавления TopRight) *@
@* ✅ CS0535: ISgToastService — используем интерфейс вместо класса      *@

@using SuperUI.Base
@using SuperUI.Base.Services
@implements IAsyncDisposable
@inject ISgToastService ToastService

<div class="sg-toast-host @GetPositionClass()" role="region" aria-live="polite" aria-label="Уведомления">
    @foreach (var toast in _toasts)
    {
        var tLocal = toast;
        <div class="sg-toast sg-toast--@tLocal.Type.ToString().ToLowerInvariant() @(tLocal.IsClosable ? "sg-toast--closable" : "")"
             role="alert"
             aria-live="assertive"
             aria-atomic="true">

            @* Иконка *@
            <span class="sg-toast__icon">
                @if (!string.IsNullOrEmpty(tLocal.Icon))
                {
                    @tLocal.Icon
                }
                else
                {
                    <span>@GetDefaultIcon(tLocal.Type)</span>
                }
            </span>

            @* Контент *@
            <div class="sg-toast__body">
                @if (!string.IsNullOrEmpty(tLocal.Title))
                {
                    <div class="sg-toast__title">@tLocal.Title</div>
                }
                <div class="sg-toast__message">@tLocal.Message</div>
            </div>

            @* Кнопка закрытия *@
            @if (tLocal.IsClosable)
            {
                <button class="sg-toast__close"
                        aria-label="Закрыть уведомление"
                        @onclick="() => ToastService.Dismiss(tLocal.Id)">
                    ×
                </button>
            }

            @* Progress bar *@
            @if (tLocal.DurationMs.HasValue && tLocal.DurationMs > 0)
            {
                <div class="sg-toast__progress"
                     style="animation-duration: @(tLocal.DurationMs)ms"></div>
            }
        </div>
    }
</div>

@code {
    /// <summary>Позиция отображения toast на экране.</summary>
    [Parameter] public SgPlacement Placement { get; set; } = SgPlacement.TopRight;

    // ✅ FIX CS0246: SgToastMessage (не SgToast)
    private List<SgToastMessage> _toasts = [];
    private bool _disposed;

    protected override void OnInitialized()
    {
        // ✅ FIX CS0535: Added / Removed теперь в ISgToastService
        ToastService.Added   += OnToastAdded;
        ToastService.Removed += OnToastRemoved;
        _toasts = [.. ToastService.Toasts];
    }

    // ✅ FIX CS0246: SgToastMessage
    private void OnToastAdded(SgToastMessage toast)
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            // ✅ FIX CS0117: SgPlacement.TopRight теперь существует
            if (toast.Placement == Placement || Placement == SgPlacement.TopRight)
            {
                _toasts = [.. ToastService.Toasts];
                StateHasChanged();
            }
        });
    }

    // ✅ FIX CS0246: SgToastMessage
    private void OnToastRemoved(SgToastMessage toast)
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            _toasts = [.. ToastService.Toasts];
            StateHasChanged();
        });
    }

    // ✅ FIX CS0019: enum сравнение корректно
    private string GetPositionClass() => Placement switch
    {
        SgPlacement.TopRight     => "sg-toast-host--top-right",
        SgPlacement.TopLeft      => "sg-toast-host--top-left",
        SgPlacement.TopCenter    => "sg-toast-host--top-center",
        SgPlacement.BottomRight  => "sg-toast-host--bottom-right",
        SgPlacement.BottomLeft   => "sg-toast-host--bottom-left",
        SgPlacement.BottomCenter => "sg-toast-host--bottom-center",
        _                        => "sg-toast-host--top-right"
    };

    private static string GetDefaultIcon(SgToastType type) => type switch
    {
        SgToastType.Success => "✓",
        SgToastType.Error   => "✕",
        SgToastType.Warning => "⚠",
        SgToastType.Info    => "ℹ",
        SgToastType.Loading => "⟳",
        _                   => "🔔"
    };

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        ToastService.Added   -= OnToastAdded;
        ToastService.Removed -= OnToastRemoved;
        await ValueTask.CompletedTask;
    }
}
