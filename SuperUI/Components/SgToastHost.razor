@* SuperUI/Components/SgToastHost.razor *@
@* ИСПРАВЛЕНО: *@
@* ✅ CS0246: SgToast → SgToastMessage *@
@* ✅ CS1061: .Added и .Removed теперь существуют в SgToastService *@
@* ✅ CS1061: DisposeAsync — теперь SgToastService реализует IAsyncDisposable *@
@* ✅ WASM + Server совместимость: InvokeAsync для thread-safety *@

@using SuperUI.Base.Services
@implements IAsyncDisposable
@inject SgToastService ToastService

<div class="sg-toast-host sg-toast-host--@Placement.ToString().ToLower()"
     aria-live="polite"
     aria-atomic="false"
     role="log">

    @foreach (var toast in _toasts)
    {
        var tLocal = toast; @* Захват переменной для лямбды *@
        <div @key="tLocal.Id"
             class="sg-toast sg-toast--@tLocal.Type.ToString().ToLower() @(tLocal.IsClosable ? "sg-toast--closable" : "")"
             role="alert"
             aria-live="@(tLocal.Type == SgToastType.Error ? "assertive" : "polite")">

            @* Иконка *@
            @if (!string.IsNullOrEmpty(tLocal.Icon))
            {
                <span class="sg-toast__icon">@tLocal.Icon</span>
            }
            else
            {
                <span class="sg-toast__icon sg-toast__icon--auto"></span>
            }

            @* Контент *@
            <div class="sg-toast__content">
                @if (!string.IsNullOrEmpty(tLocal.Title))
                {
                    <div class="sg-toast__title">@tLocal.Title</div>
                }
                <div class="sg-toast__message">@tLocal.Message</div>
            </div>

            @* Кнопка закрытия *@
            @if (tLocal.IsClosable)
            {
                <button class="sg-toast__close"
                        aria-label="Закрыть уведомление"
                        @onclick="() => ToastService.Dismiss(tLocal.Id)">
                    ×
                </button>
            }
        </div>
    }
</div>

@code {
    /// <summary>Позиция отображения toast на экране.</summary>
    [Parameter] public SgPlacement Placement { get; set; } = SgPlacement.TopRight;

    // FIX CS0246: SgToastMessage вместо SgToast
    private List<SgToastMessage> _toasts = [];
    private bool _disposed;

    protected override void OnInitialized()
    {
        // FIX CS1061: Added и Removed теперь существуют
        ToastService.Added   += OnToastAdded;    // ← было: ToastService.Added (не существовало)
        ToastService.Removed += OnToastRemoved;  // ← было: ToastService.Removed (не существовало)
        _toasts = [.. ToastService.Toasts];
    }

    // FIX CS0246: SgToastMessage вместо SgToast
    private void OnToastAdded(SgToastMessage toast)
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            // Фильтруем по Placement если нужно
            if (toast.Placement == Placement || Placement == SgPlacement.TopRight)
            {
                _toasts = [.. ToastService.Toasts];
                StateHasChanged();
            }
        });
    }

    // FIX CS0246: SgToastMessage вместо SgToast
    private void OnToastRemoved(SgToastMessage toast)
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            _toasts = [.. ToastService.Toasts];
            StateHasChanged();
        });
    }

    // FIX CS1061: DisposeAsync — теперь SgToastService реализует IAsyncDisposable
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        ToastService.Added   -= OnToastAdded;    // ← отписываемся
        ToastService.Removed -= OnToastRemoved;  // ← отписываемся

        // FIX CS1061: DisposeAsync теперь существует (SgToastService : IAsyncDisposable)
        // НЕ диспозим сервис здесь — он управляется DI контейнером
        await ValueTask.CompletedTask;
    }
}
