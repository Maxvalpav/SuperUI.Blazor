    private bool IsHighlighted(SgWhCell c)
    {
        var o = Options;
        if (o is null) return false;
        if (!string.IsNullOrEmpty(o.HighlightSku) && (c.Sku?.Contains(o.HighlightSku, StringComparison.OrdinalIgnoreCase) ?? false))
            return true;
        if (o.HighlightStatuses is { Count: > 0 } && o.HighlightStatuses.Contains(c.Status))
            return true;
        return false;
    }

    private void OnRackClicked(SgWhRack r)
    {
        OnRackClick.InvokeAsync(new SgWhRackEventArgs { RackId = r.Id, Rack = r });
        if (Options?.ReadOnly ?? true) FocusRack(r.Id);
    }

    private void OnCellClicked(SgWhRack r, SgWhCell c)
    {
        OnCellClick.InvokeAsync(new SgWhCellEventArgs
        {
            RackId   = r.Id,
            RackCode = r.Code,
            CellId   = c.Id,
            Level    = c.Level,
            Position = c.Position,
            Cell     = c,
        });
    }

    private void ShowRackTip(MouseEventArgs e, SgWhRack r, RackStats s)
    {
        _tip  = $"<b>{r.Code}</b><br/>Заполнено: <b>{s.OccupancyPct:F0}%</b> ({s.Occupied}/{s.Total})<br/>{TempLabel(r.Temperature)}";
        _tipX = e.OffsetX + 14; _tipY = e.OffsetY + 14;
    }

    private void ShowCellTip(MouseEventArgs e, SgWhRack r, SgWhCell c)
    {
        var lines = new List<string> { $"<b>{r.Code}-{c.Level + 1:00}-{c.Position + 1:00}</b>" };
        if (!string.IsNullOrEmpty(c.Sku))         lines.Add($"SKU: <b>{c.Sku}</b>");
        if (!string.IsNullOrEmpty(c.ProductName)) lines.Add(c.ProductName!);
        if (c.Quantity is not null)               lines.Add($"Кол-во: {c.Quantity}{(c.Capacity is not null ? "/" + c.Capacity : "")}");
        if (c.Lot is not null)                    lines.Add($"Партия: {c.Lot}");
        if (c.ExpiresOn is not null)              lines.Add($"Годен до: {c.ExpiresOn:yyyy-MM-dd}");
        if (c.Abc != SgWhAbcClass.None)           lines.Add($"ABC: {c.Abc}");
        lines.Add($"Статус: {StatusLabel(c.Status)}");
        _tip  = string.Join("<br/>", lines);
        _tipX = e.OffsetX + 14; _tipY = e.OffsetY + 14;
    }

    private void HideTip() { _tip = null; }

    private static string StatusLabel(SgWhCellStatus s) => s switch
    {
        SgWhCellStatus.Empty    => "Свободно",
        SgWhCellStatus.Occupied => "Занято",
        SgWhCellStatus.Reserved => "Резерв",
        SgWhCellStatus.Picking  => "Отбор",
        SgWhCellStatus.Blocked  => "Заблокировано",
        SgWhCellStatus.Damaged  => "Брак",
        SgWhCellStatus.Expired  => "Просрочка",
        _ => s.ToString(),
    };

    private record LegendItem(string Color, string Label);

    private IEnumerable<LegendItem> BuildLegend()
    {
        var mode = Options?.ColorMode ?? SgWhColorMode.Status;
        return mode switch
        {
            SgWhColorMode.Status => new[]
            {
                new LegendItem(StatusFill(SgWhCellStatus.Empty),    "Свободно"),
                new LegendItem(StatusFill(SgWhCellStatus.Occupied), "Занято"),
                new LegendItem(StatusFill(SgWhCellStatus.Reserved), "Резерв"),
                new LegendItem(StatusFill(SgWhCellStatus.Picking),  "Отбор"),
                new LegendItem(StatusFill(SgWhCellStatus.Blocked),  "Блок"),
                new LegendItem(StatusFill(SgWhCellStatus.Damaged),  "Брак"),
                new LegendItem(StatusFill(SgWhCellStatus.Expired),  "Просрочка"),
            },
            SgWhColorMode.Occupancy => new[]
            {
                new LegendItem("#f1f5f9", "0%"),
                new LegendItem("#dcfce7", "1–40%"),
                new LegendItem("#bae6fd", "40–70%"),
                new LegendItem("#fed7aa", "70–90%"),
                new LegendItem("#fecaca", "90–100%"),
            },
            SgWhColorMode.Abc => new[]
            {
                new LegendItem(AbcFill(SgWhAbcClass.A), "A — высокая ценность"),
                new LegendItem(AbcFill(SgWhAbcClass.B), "B — средняя"),
                new LegendItem(AbcFill(SgWhAbcClass.C), "C — низкая"),
            },
            SgWhColorMode.Turnover => new[]
            {
                new LegendItem("#f1f5f9", "0 шт./30 дн"),
                new LegendItem("#dcfce7", "1–4"),
                new LegendItem("#bae6fd", "5–14"),
                new LegendItem("#fed7aa", "15–29"),
                new LegendItem("#fecaca", "≥ 30"),
            },
            SgWhColorMode.Temperature => new[]
            {
                new LegendItem(TempFill(SgWhTemperature.Ambient), "Обычная"),
                new LegendItem(TempFill(SgWhTemperature.Cool),    "+2…+8°C"),
                new LegendItem(TempFill(SgWhTemperature.Cold),    "0…+2°C"),
                new LegendItem(TempFill(SgWhTemperature.Frozen),  "−18°C"),
            },
            SgWhColorMode.Zone => Layout?.Zones.Select(z => new LegendItem(z.Color ?? ZoneFill(z.Type).Fill, z.Name)).Distinct() ?? Array.Empty<LegendItem>(),
            _ => Array.Empty<LegendItem>(),
        };
    }

    private readonly string _gridId = Guid.NewGuid().ToString("N")[..8];

    private static string F(double v) => v.ToString("F2", CultureInfo.InvariantCulture);
}
