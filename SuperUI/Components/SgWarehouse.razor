    private (string Fill, string Stroke, string Text) ZoneFill(SgWhZoneType t) => t switch
    {
        SgWhZoneType.Storage    => ("#e0f2fe", "#7dd3fc", "#0369a1"),
        SgWhZoneType.Receiving  => ("#dcfce7", "#86efac", "#15803d"),
        SgWhZoneType.Shipping   => ("#fef3c7", "#fcd34d", "#a16207"),
        SgWhZoneType.Picking    => ("#ede9fe", "#c4b5fd", "#6d28d9"),
        SgWhZoneType.Staging    => ("#fae8ff", "#e9d5ff", "#a21caf"),
        SgWhZoneType.Returns    => ("#ffe4e6", "#fda4af", "#be123c"),
        SgWhZoneType.Quarantine => ("#fee2e2", "#fca5a5", "#b91c1c"),
        SgWhZoneType.Cold       => ("#cffafe", "#67e8f9", "#0e7490"),
        SgWhZoneType.Hazard     => ("#fef9c3", "#facc15", "#854d0e"),
