@namespace SuperUI.Components
@inherits SgInputBase<string>
@using System.Timers

<div class="sgc-field @(Block ? "sgc-block" : "") @(LabelPosition == SgLabelPosition.Left ? "sgc-label-left" : LabelPosition == SgLabelPosition.Right ? "sgc-label-right" : "") @CssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sgc-label @(Required ? "sgc-required" : "")" for="@_id">@Label</label>
    }
    <div class="sgc-input-wrap">
        <textarea id="@_id"
                  class="sgc-textarea @(IsInvalid ? "sgc-invalid" : "") @(AutoResize ? "sgc-auto-resize" : "")"
                  rows="@Rows"
                  placeholder="@Placeholder"
                  disabled="@Disabled"
                  readonly="@ReadOnly"
                  required="@Required"
                  maxlength="@MaxLength"
                  aria-required="@(Required ? "true" : null)"
                  aria-invalid="@(IsInvalid ? "true" : null)"
                  aria-describedby="@DescribedBy"
                  value="@Value"
                  @oninput="OnInputAsync"
                  @onchange="OnChangeAsync"
                  @attributes="AdditionalAttributes"></textarea>
        @if (ShowClearButton && !string.IsNullOrEmpty(Value))
        {
            <button type="button" class="sgc-input-clear" @onclick="ClearAsync" aria-label="Clear">×</button>
        }
    </div>
    @if (ShowCounter && MaxLength.HasValue)
    {
        <span class="sgc-input-counter">@(Value?.Length ?? 0) / @MaxLength</span>
    }
    @if (IsInvalid)
    {
        <span id="@_errorId" class="sgc-error">@DisplayedError</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@_hintId" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private readonly string _id = "sg-ta-" + Guid.NewGuid().ToString("N")[..8];
    private string _hintId => _id + "-hint";
    private string _errorId => _id + "-err";
    private System.Timers.Timer? _debounceTimer;

    [Parameter] public string? Label { get; set; }
    [Parameter] public SgLabelPosition LabelPosition { get; set; } = SgLabelPosition.Top;
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Block { get; set; } = true;
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool Immediate { get; set; } = true;
    [Parameter] public int Debounce { get; set; }
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public bool ShowClearButton { get; set; }
    [Parameter] public bool ShowCounter { get; set; }
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public bool AutoResize { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsInvalid => !string.IsNullOrEmpty(ErrorText) || HasValidationErrors;
    private string? DisplayedError => !string.IsNullOrEmpty(ErrorText) ? ErrorText : ValidationMessages.FirstOrDefault();
    private string? DescribedBy => IsInvalid ? _errorId : (!string.IsNullOrEmpty(Hint) ? _hintId : null);

    private void OnInputAsync(ChangeEventArgs e)
    {
        if (Debounce > 0)
        {
            _debounceTimer?.Stop();
            _debounceTimer?.Dispose();
            _debounceTimer = new System.Timers.Timer(Debounce);
            _debounceTimer.Elapsed += async (_, _) =>
            {
                _debounceTimer?.Stop();
                await InvokeAsync(async () => await CommitAsync(e.Value?.ToString()));
            };
            _debounceTimer.AutoReset = false;
            _debounceTimer.Start();
        }
        else if (Immediate)
        {
            _ = SafeCommitAsync(e.Value?.ToString());
        }
    }

    private Task OnChangeAsync(ChangeEventArgs e) => !Immediate && Debounce <= 0 ? CommitAsync(e.Value?.ToString()) : Task.CompletedTask;

    private async Task SafeCommitAsync(string? raw)
    {
        try { await CommitAsync(raw); }
        catch (Exception ex) { Console.Error.WriteLine($"[SgTextArea.CommitAsync] {ex}"); }
    }

    private async Task ClearAsync()
    {
        await SetValueAsync(string.Empty);
    }

    private Task CommitAsync(string? raw) => SetValueAsync(raw ?? string.Empty);

    public override void Dispose()
    {
        _debounceTimer?.Stop();
        _debounceTimer?.Dispose();
        base.Dispose();
    }
}
