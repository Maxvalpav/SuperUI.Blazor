@namespace SuperUI.Components
@inherits SgFormFieldBase<string>
@inject IJSRuntime JS

<div class="@GetFieldClasses()" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sgc-label @(Required ? "sgc-required" : "")" for="@EffectiveId">@Label</label>
    }

    <div class="sgc-input-wrap sgc-textarea-wrap">
        <textarea id="@EffectiveId"
                  class="@GetTextAreaClasses()"
                  rows="@Rows"
                  placeholder="@Placeholder"
                  disabled="@IsEffectivelyDisabled"
                  readonly="@ReadOnly"
                  required="@Required"
                  maxlength="@MaxLength"
                  aria-required="@(Required ? "true" : null)"
                  aria-invalid="@(HasError ? "true" : null)"
                  aria-describedby="@DescribedBy"
                  value="@CurrentText"
                  @oninput="OnInputAsync"
                  @onchange="OnChangeAsync"
                  @onfocus="HandleFocusAsync"
                  @onblur="HandleBlurAsync"
                  @ref="_textareaRef"
                  @attributes="AdditionalAttributesFiltered"></textarea>

        @if (ShowClearButton && !string.IsNullOrEmpty(CurrentText))
        {
            <button type="button" class="sgc-textarea-clear" @onclick="ClearAsync" aria-label="Clear" tabindex="-1">
                <svg viewBox="0 0 16 16" width="10" height="10" fill="currentColor" aria-hidden="true">
                    <path d="M3.72 3.72a.75.75 0 011.06 0L8 6.94l3.22-3.22a.75.75 0 111.06 1.06L9.06 8l3.22 3.22a.75.75 0 11-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 01-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 010-1.06z"/>
                </svg>
            </button>
        }

        @if (ShowCounter && MaxLength.HasValue)
        {
            <span class="sgc-textarea-counter">@(CurrentText?.Length ?? 0)<span class="sgc-textarea-counter-max"> / @MaxLength</span></span>
        }
    </div>

    @if (HasError)
    {
        <span id="@($"{EffectiveId}-err")" class="sgc-error">@DisplayedError</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@($"{EffectiveId}-hint")" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private ElementReference _textareaRef;
    private IJSObjectReference? _module;

    [Parameter] public SgLabelPosition LabelPosition { get; set; } = SgLabelPosition.Top;
    [Parameter] public bool Block { get; set; } = true;
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool Immediate { get; set; } = true;
    [Parameter] public int Debounce { get; set; }
    [Parameter] public bool ShowClearButton { get; set; }
    [Parameter] public bool ShowCounter { get; set; }
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public int MaxRows { get; set; }
    [Parameter] public bool AutoResize { get; set; }
    [Parameter] public SgTextResize Resize { get; set; } = SgTextResize.Vertical;

    protected override string ComponentPrefix => "ta";

    private string? DescribedBy => HasError ? $"{EffectiveId}-err" : (!string.IsNullOrEmpty(Hint) ? $"{EffectiveId}-hint" : null);
    private string? DisplayedError => !string.IsNullOrEmpty(ErrorText) ? ErrorText : ValidationMessages.FirstOrDefault();

    private string GetFieldClasses() => Css("sgc-field")
        .AddIf("sgc-block", Block)
        .AddEnum(LabelPosition, "sgc-label-")
        .AddIf("sgc-focused", IsFocused)
        .Add(CssClass)
        .Add(Class)
        .ToString();

    private string GetTextAreaClasses() => Css("sgc-textarea")
        .AddIf("sgc-invalid", HasError)
        .AddIf("sgc-auto-resize", AutoResize)
        .Add($"sgc-resize-{ResizeClass}")
        .ToString();

    private string ResizeClass => AutoResize ? "none" : Resize switch
    {
        SgTextResize.None => "none",
        SgTextResize.Horizontal => "horizontal",
        SgTextResize.Both => "both",
        _ => "vertical"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (AutoResize && IsInteractive)
            await CallAutoResizeAsync();
    }

    private async Task CallAutoResizeAsync()
    {
        if (IsDisposed || IsStaticSSR) return;

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/superui.js");
            if (IsDisposed) return;
            await _module.InvokeVoidAsync("autoResizeTextarea", _textareaRef, Rows, MaxRows);
        }
        catch (JSException) { }
        catch (TaskCanceledException) { }
    }

    private async Task OnInputAsync(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();

        if (Debounce > 0)
        {
            await DebounceAsync(async () =>
            {
                await SetTextAsync(raw);
                if (AutoResize) await CallAutoResizeAsync();
            }, TimeSpan.FromMilliseconds(Debounce));
        }
        else if (Immediate)
        {
            await SetTextAsync(raw);
            if (AutoResize) await CallAutoResizeAsync();
        }
    }

    private async Task OnChangeAsync(ChangeEventArgs e)
    {
        if (!Immediate && Debounce <= 0)
        {
            await SetTextAsync(e.Value?.ToString());
            if (AutoResize) await CallAutoResizeAsync();
        }
    }

    private async Task ClearAsync()
    {
        await SetTextAsync(string.Empty);
        if (AutoResize) await CallAutoResizeAsync();
    }

    protected override async ValueTask DisposeComponentAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { }
        }

        await base.DisposeComponentAsync();
    }

    protected override IReadOnlyDictionary<string, object> BuildAriaAttributes()
    {
        return new AriaBuilder()
            .Label(Label)
            .Required(Required)
            .Invalid(HasError)
            .Disabled(Disabled)
            .ReadOnly(ReadOnly)
            .Build();
    }
}
