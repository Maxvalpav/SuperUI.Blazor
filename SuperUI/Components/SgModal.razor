@namespace SuperUI.Components
@using SuperUI.Localization
@using SuperUI.Services
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ISuperUILocalizer Localizer
@inject SgZIndexService ZIndex

@if (Visible || _isClosing)
{
    <div class="sgc-modal-backdrop @(_isClosing ? "sgc-closing" : "")" style="z-index: @_backdropZIndex" @onclick="BackdropClickAsync">
        <div class="sgc-modal sgc-modal-anim-@Animation.ToLowerInvariant() @CssClass" 
             style="@GetStyle()" 
             role="dialog" 
             aria-modal="true" 
             aria-labelledby="@_titleId"
             aria-describedby="@_bodyId"
             tabindex="-1"
             @ref="_modalRef"
             @onclick:stopPropagation="true">
            <div class="sgc-modal-header" @ref="_headerRef">
                <span id="@_titleId" class="sgc-modal-title">@Title</span>
                @if (ShowClose)
                {
                    <button class="sgc-modal-x" type="button" @onclick="CloseAsync" aria-label="@Localizer["Close"]">×</button>
                }
            </div>
            <div id="@_bodyId" class="sgc-modal-body">
                @ChildContent
            </div>
            @if (FooterContent is not null)
            {
                <div class="sgc-modal-footer">@FooterContent</div>
            }
        </div>
    </div>
}

@code {
    private readonly string _titleId = "modal-title-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _bodyId = "modal-body-" + Guid.NewGuid().ToString("N")[..8];
    private ElementReference _modalRef;
    private ElementReference _headerRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SgModal>? _self;
    private bool _isDisposed;
    private bool _previousVisible;
    private bool _isClosing;
    private int _zIndex;
    private int _backdropZIndex;

    /// <summary>
    /// Gets or sets whether the modal is visible.
    /// </summary>
    [Parameter] public bool Visible { get; set; }

    /// <summary>
    /// Callback invoked when <see cref="Visible"/> changes.
    /// </summary>
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    /// <summary>
    /// Gets or sets the modal title text.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// Gets or sets the modal body content.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the modal footer content.
    /// </summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>
    /// Gets or sets whether to show the close button in the header. Default is true.
    /// </summary>
    [Parameter] public bool ShowClose { get; set; } = true;

    /// <summary>
    /// Gets or sets whether clicking the backdrop closes the modal. Default is true.
    /// </summary>
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;

    /// <summary>
    /// Gets or sets whether pressing ESC closes the modal. Default is true.
    /// </summary>
    [Parameter] public bool CloseOnEscape { get; set; } = true;

    /// <summary>
    /// Gets or sets the modal animation type: "scale", "fade", "slide". Default is "scale".
    /// </summary>
    [Parameter] public string Animation { get; set; } = "scale";

    /// <summary>
    /// Gets or sets whether the modal is draggable by its header.
    /// </summary>
    [Parameter] public bool Draggable { get; set; }

    /// <summary>
    /// Gets or sets additional CSS class names for the modal.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Gets or sets inline styles for the modal.
    /// </summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>
    /// Gets or sets the modal width (e.g., "600px", "50%").
    /// </summary>
    [Parameter] public string? Width { get; set; }

    /// <summary>
    /// Callback invoked when the modal is closed.
    /// </summary>
    [Parameter] public EventCallback OnClose { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isDisposed) return;

        if (Visible && !_previousVisible)
        {
            // Modal just opened
            _zIndex = ZIndex.Allocate(this, SgZIndexService.ModalBase);
            _backdropZIndex = _zIndex - 5;
            
            try
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/superui-modal.js");
                if (_isDisposed) return;

                _self ??= DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("attach", _modalRef, _self, CloseOnEscape);

                if (Draggable)
                {
                    await _module.InvokeVoidAsync("initDrag", _modalRef, _headerRef);
                }
            }
            catch (JSException) { }
            catch (TaskCanceledException) { }
        }
        else if (!Visible && _previousVisible)
        {
            // Modal just closed
            if (_zIndex > 0)
            {
                ZIndex.Release(this);
                _zIndex = 0;
            }
            
            if (_module is not null)
            {
                try
                {
                    await _module.InvokeVoidAsync("detach");
                }
                catch (JSException) { }
                catch (TaskCanceledException) { }
            }
        }

        _previousVisible = Visible;
    }

    [JSInvokable]
    public Task CloseFromJsAsync() => CloseAsync();

    public async Task CloseAsync()
    {
        if (_isDisposed || _isClosing) return;
        
        _isClosing = true;
        StateHasChanged();

        // Wait for animation to finish (200ms in CSS)
        await Task.Delay(200);
        
        Visible = false;
        _isClosing = false;
        
        if (VisibleChanged.HasDelegate) await VisibleChanged.InvokeAsync(false);
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }

    private string GetStyle()
    {
        var styles = new List<string>();
        if (_zIndex > 0) styles.Add($"z-index: {_zIndex}");
        if (!string.IsNullOrEmpty(Width)) styles.Add($"width: {Width}");
        if (!string.IsNullOrEmpty(Style)) styles.Add(Style);
        return string.Join("; ", styles);
    }

    private Task BackdropClickAsync() => CloseOnBackdrop ? CloseAsync() : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        if (_isDisposed) return;
        _isDisposed = true;

        if (_zIndex > 0)
        {
            ZIndex.Release(this);
            _zIndex = 0;
        }

        var self = _self;
        _self = null;
        self?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("detach");
                await _module.DisposeAsync();
            }
            catch (JSException) { }
            catch (TaskCanceledException) { }
            catch (ObjectDisposedException) { }
        }
    }
}
