@namespace SuperUI.Components
@inherits SgOverlayBase
@inject ISuperUILocalizer Localizer

@if (Visible)
{
    <div class="sgc-modal-backdrop"
         style="@GetBackdropStyle()"
         @onclick="OnBackdropClick">

        <div @ref="_modalRef"
             id="@EffectiveId"
             class="@GetModalClasses()"
             style="@GetModalStyle()"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@(EffectiveId + "-title")"
             tabindex="-1"
             @onclick:stopPropagation="true">

            <div @ref="_headerRef" class="sgc-modal-header">
                <h2 id="@(EffectiveId + "-title")" class="sgc-modal-title">@Title</h2>
                @if (ShowClose)
            {
                <button class="sgc-modal-x"
                        type="button"
                        aria-label="@Localizer["Close"]"
                        @onclick="HideAsync">×</button>
            }
            </div>

            <div class="sgc-modal-body">
                @ChildContent
            </div>

            @if (FooterContent != null)
            {
                <div class="sgc-modal-footer">
                    @FooterContent
                </div>
            }
        </div>
    </div>
}
