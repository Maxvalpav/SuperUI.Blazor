@namespace SuperUI.Components.DocumentExtractor
@using Microsoft.AspNetCore.Components.Forms
@using SuperUI.Components
@using SuperUI.Components.DocumentExtractor.Models
@using SuperUI.Components.DocumentExtractor.Services
@using SuperUI.Localization
@using SuperUI.Services.Llm
@inject IJSRuntime JS
@inject ISuperUILocalizer Localizer

<div class="sg-doc-extractor @CssClass">
    <SgLlmHeader Title="@Localizer["DocExt_Title"]"
                 Subtitle="OCR / структурированное извлечение полей из PDF, DOCX, изображений"
                 TaskPurpose="@SgLlmTaskPurpose.Documents" />

    <SgCard CssClass="sg-doc-settings-card">
        <div class="sg-doc-settings-header">
            <span class="sg-doc-settings-title">@Localizer["Llm_Settings"]</span>
            <div class="sg-doc-extractor-toolbar">
                <SgSelect TValue="string"
                          Items="@Extractors.Select(e => e.Id)"
                          Value="@_selectedExtractorId"
                          ValueChanged="OnExtractorPicked"
                          Style="min-width: 180px;" />
            </div>
        </div>
        <SgLlmSettings Compact="true" Config="_llmConfig" ConfigChanged="OnLlmConfigChanged" TaskPurpose="@SgLlmTaskPurpose.Documents" />
    </SgCard>

    <div class="sg-doc-extractor-layout">
        <div class="sg-doc-extractor-main">
            <SgCard Title="@Localizer["DocExt_Document"]" Subtitle="@Localizer["DocExt_DocumentSubtitle"]">
                <SgFileUpload Label="@UploadLabel"
                              Accept=".pdf,.docx,.txt,image/*"
                              MaxFileSizeBytes="@MaxFileSizeBytes"
                              ValueChanged="OnFilesPicked" />

                <div class="sg-doc-extractor-actions">
                    <SgButton Text="@Localizer["DocExt_Extract"]"
                              Variant="SgButtonVariant.Primary"
                              Disabled="@(_source is null || _busy)"
                              Loading="_busy"
                              OnClick="ExtractAsync">
                        <Icon>@((MarkupString)SgIcons.Sparkles)</Icon>
                    </SgButton>
                    <SgButton Text="@Localizer["DocExt_Save"]"
                              Variant="SgButtonVariant.Outlined"
                              Disabled="@(_result is null || _busy)"
                              OnClick="SaveAsync">
                        <Icon>@((MarkupString)SgIcons.Download)</Icon>
                    </SgButton>
                </div>

                @if (!string.IsNullOrEmpty(_status))
                {
                    <div class="sg-doc-status">
                        <SgAlert Variant="@(_isError ? SgAlertVariant.Danger : SgAlertVariant.Info)" Text="@_status" />
                    </div>
                }
            </SgCard>

            @if (_result is not null)
            {
                <SgCard Title="@Localizer["DocExt_Result"]" Subtitle="@Localizer["DocExt_ResultSubtitle"]">
                    <div class="sg-doc-extractor-form">
                        @if (_result.Fields.Count == 0)
                        {
                            <SgAlert Variant="SgAlertVariant.Warn" Text="@Localizer["DocExt_NoFields"]" />
                        }
                        @foreach (var field in _result.Fields)
                        {
                            var f = field;
                            <div class="sg-doc-extractor-field">
                                @switch (f.Type)
                                {
                                    case SgDocumentFieldType.MultilineText:
                                        <SgTextBox TValue="string"
                                                   Label="@f.Label"
                                                   Multiline="true"
                                                   Rows="4"
                                                   Hint="@f.Hint"
                                                   Placeholder="@f.Placeholder"
                                                   Required="@f.Required"
                                                   Value="@(f.Value as string)"
                                                   ValueChanged="(string? v) => f.Value = v" />
                                        break;
                                    case SgDocumentFieldType.Number:
                                        <SgNumberInput TValue="double?"
                                                       Label="@f.Label"
                                                       Hint="@f.Hint"
                                                       Required="@f.Required"
                                                       Value="@AsNullableDouble(f.Value)"
                                                       ValueChanged="(double? v) => f.Value = v" />
                                        break;
                                    case SgDocumentFieldType.Date:
                                        <SgDatePicker Label="@f.Label"
                                                      Hint="@f.Hint"
                                                      Required="@f.Required"
                                                      Value="@AsNullableDate(f.Value)"
                                                      ValueChanged="(DateTime? v) => f.Value = v" />
                                        break;
                                    case SgDocumentFieldType.Boolean:
                                        <SgCheckBox Label="@f.Label"
                                                    Hint="@f.Hint"
                                                    Value="@AsBool(f.Value)"
                                                    ValueChanged="(bool v) => f.Value = v" />
                                        break;
                                    case SgDocumentFieldType.Select:
                                        <SgSelect TValue="string"
                                                  Label="@f.Label"
                                                  Items="@(f.Options ?? new List<string>())"
                                                  Value="@(f.Value as string)"
                                                  ValueChanged="(string? v) => f.Value = v" />
                                        break;
                                    default:
                                        <SgTextBox TValue="string"
                                                   Label="@f.Label"
                                                   Hint="@f.Hint"
                                                   Placeholder="@f.Placeholder"
                                                   Required="@f.Required"
                                                   Value="@(f.Value as string)"
                                                   ValueChanged="(string? v) => f.Value = v" />
                                        break;
                                }
                            </div>
                        }
                    </div>
                </SgCard>
            }
        </div>

        <aside class="sg-doc-extractor-side">
            <SgCard Title="@Localizer["DocExt_HowItWorks"]">
                <ol class="sg-doc-help-list">
                    <li>Выберите провайдера на общей LLM-плашке: <b>OpenRouter</b>, <b>OpenAI-compatible</b>, <b>Anthropic</b>, <b>Ollama</b>, <b>LM Studio</b>, <b>Hugging Face</b> или <b>GigaGPT</b>.</li>
                    <li><b>Base URL</b> подставится автоматически; проверьте адрес и задайте <b>API key</b>, если он нужен.</li>
                    <li>Выберите <b>экстрактор</b> — LLM или встроенный парсер.</li>
                    <li>Загрузите документ и нажмите <b>Извлечь</b>.</li>
                    <li>Отредактируйте поля и <b>сохраните</b> в исходном формате.</li>
                </ol>

                <div class="sg-doc-feature-badge">
                    <div class="sg-doc-feature-title">Модульная архитектура</div>
                    <ul class="sg-doc-feature-list">
                        <li><code>IDocumentExtractor</code> — LLM + встроенный DOCX-парсер.</li>
                        <li><code>IDocumentSaver</code> — DOCX round-trip, plain-text, passthrough для PDF/картинок.</li>
                    </ul>
                </div>
            </SgCard>
        </aside>
    </div>
</div>
