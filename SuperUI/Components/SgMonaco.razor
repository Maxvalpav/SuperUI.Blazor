@namespace SuperUI.Components
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="sg-monaco-container @CssClass"
     style="height:@Height; width:@Width; position:relative; overflow:hidden;">

    @if (_error is not null)
    {
        <div class="sg-monaco-error" role="alert">
            <span>@_error</span>
            <button type="button" class="sg-monaco-retry-btn" @onclick="RetryAsync">Повторить</button>
        </div>
    }
    else
    {
        <div @ref="_containerRef"
             class="sg-monaco-canvas"
             style="@(_ready ? null : "visibility:hidden;") width:100%;height:100%;"></div>

        @if (!_ready)
        {
            <div class="sg-monaco-loading" aria-live="polite">
                <div class="sg-monaco-spinner" aria-hidden="true"></div>
                <span>Загрузка редактора…</span>
            </div>
        }
    }
</div>

@code {
    private ElementReference _containerRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SgMonaco>? _selfRef;
    private readonly string _instanceId = $"sg-mc-{Guid.NewGuid():N}";
    private bool _ready;
    private string? _error;
    private bool _isDisposed;
    private string? _lastExternalValue;
    private bool _suppressNextChange;

    // ── Parameters ────────────────────────────────────────────────────────────

    /// <summary>Current editor value (two-way binding).</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Fires when the editor content changes.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Monaco editor options.</summary>
    [Parameter] public SgMonacoOptions? Options { get; set; }

    /// <summary>CDN source overrides.</summary>
    [Parameter] public SgMonacoSources? Sources { get; set; }

    /// <summary>Container height. Default "300px".</summary>
    [Parameter] public string Height { get; set; } = "300px";

    /// <summary>Container width. Default "100%".</summary>
    [Parameter] public string Width { get; set; } = "100%";

    /// <summary>Additional CSS class for the container.</summary>
    [Parameter] public string? CssClass { get; set; }

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnParametersSetAsync()
    {
        if (!_ready || _module is null) return;

        // If Value changed externally (not from editor itself), push it in
        if (!string.Equals(Value, _lastExternalValue, StringComparison.Ordinal))
        {
            _lastExternalValue = Value;
            _suppressNextChange = true;
            try
            {
                await _module.InvokeVoidAsync("setValue", _instanceId, Value ?? "");
            }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
            catch { }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isDisposed || !firstRender) return;
        try
        {
            _module  = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/sg-monaco.js");
            if (_isDisposed) return;
            _selfRef = DotNetObjectReference.Create(this);
            await InitAsync();
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch (Exception ex)
        {
            _error = $"Не удалось загрузить Monaco Editor: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task InitAsync()
    {
        if (_module is null || _selfRef is null) return;
        try
        {
            var opts = BuildOpts();
            var sources = Sources ?? new SgMonacoSources();
            _lastExternalValue = Value;
            await _module.InvokeVoidAsync("initEditor",
                _selfRef, _containerRef, _instanceId,
                opts, Value ?? "", sources);
            _ready = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch (Exception ex)
        {
            _error = $"Ошибка инициализации редактора: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private object BuildOpts()
    {
        var o = Options ?? new SgMonacoOptions();
        return new
        {
            language    = o.Language,
            theme       = o.Theme,
            fontSize    = o.FontSize,
            readOnly    = o.ReadOnly,
            minimap     = o.Minimap,
            lineNumbers = o.LineNumbers,
            wordWrap    = o.WordWrap,
            autoFormat  = o.AutoFormat,
        };
    }

    // ── Public methods ────────────────────────────────────────────────────────

    /// <summary>Formats the document (pretty-print JSON).</summary>
    public async Task FormatAsync()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("format", _instanceId); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch { }
    }

    /// <summary>Sets the editor language.</summary>
    public async Task SetLanguageAsync(string language)
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("setLanguage", _instanceId, language); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch { }
    }

    /// <summary>Sets the editor theme.</summary>
    public async Task SetThemeAsync(string theme)
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("setTheme", _instanceId, theme); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch { }
    }

    /// <summary>Gets the current editor value.</summary>
    public async Task<string> GetValueAsync()
    {
        if (_module is null) return Value ?? "";
        try { return await _module.InvokeAsync<string>("getValue", _instanceId); }
        catch { return Value ?? ""; }
    }

    /// <summary>Sets the editor read-only state.</summary>
    public async Task SetReadOnlyAsync(bool readOnly)
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("setReadOnly", _instanceId, readOnly); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch { }
    }

    /// <summary>Retries loading after an error.</summary>
    public async Task RetryAsync()
    {
        _error = null; _ready = false;
        await InvokeAsync(StateHasChanged);
        await InitAsync();
    }

    // ── JS callbacks ──────────────────────────────────────────────────────────

    [JSInvokable]
    public async Task OnValueChangedAsync(string value)
    {
        if (_suppressNextChange)
        {
            _suppressNextChange = false;
            return;
        }
        _lastExternalValue = value;
        if (ValueChanged.HasDelegate)
            await ValueChanged.InvokeAsync(value);
    }

    // ── Dispose ───────────────────────────────────────────────────────────────

    public async ValueTask DisposeAsync()
    {
        if (_isDisposed) return;
        _isDisposed = true;

        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("disposeEditor", _instanceId); }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException)   { }
            catch { }
        }

        var selfRef = _selfRef;
        _selfRef = null;
        selfRef?.Dispose();

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException)   { }
            catch { }
            _module = null;
        }
    }
}
