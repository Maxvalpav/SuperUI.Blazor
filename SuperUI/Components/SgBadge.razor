@namespace SuperUI.Components
@inherits SgReactiveComponentBase

@{
    using var _ = EnterScope(this);
    if (ChildContent is not null && !Standalone)
    {
        <span class="@GetWrapperClasses()" style="@Style" @attributes="AdditionalAttributesFiltered">
            @ChildContent
            @if (!Hidden && !IsZero)
            {
                <span class="@GetBadgeClasses(false)"
                      style="@ComputedOffsetStyle"
                      role="status"
                      aria-label="@BadgeAriaLabel">
                    @if (!Dot && !Processing)
                    {
                        @BadgeText
                    }
                </span>
            }
        </span>
    }
    else if (Ribbon)
    {
        <span class="@GetRibbonClasses()"
              style="@GetRibbonStyle()"
              role="status"
              aria-label="@BadgeAriaLabel"
              @attributes="AdditionalAttributesFiltered">
            @if (!Dot)
            {
                @if (Text is not null) { @Text }
                else if (InnerContent is not null) { @InnerContent }
                else { @BadgeText }
            }
        </span>
    }
    else
    {
        @if (OnClick.HasDelegate)
        {
            <button type="button"
                    class="@GetBadgeClasses(true)"
                    style="@GetStandaloneStyle()"
                    role="status"
                    aria-label="@(AriaLabel ?? Text ?? Localizer["Badge"])"
                    @onclick="OnClick"
                    @attributes="AdditionalAttributesFiltered">
                @BadgeInner
            </button>
        }
        else
        {
            <span class="@GetBadgeClasses(true)"
                  style="@GetStandaloneStyle()"
                  role="status"
                  aria-label="@(AriaLabel ?? Text ?? Localizer["Badge"])"
                  @attributes="AdditionalAttributesFiltered">
                @BadgeInner
            </span>
        }
    }
}

@code {
    private RenderFragment BadgeInner => __builder =>
    {
        if (Processing)
        {
            <span class="sgc-badge-processing-dot" aria-hidden="true"></span>
        }
        if (!Dot && !Processing)
        {
            if (Icon is not null)
            {
                <span class="sgc-badge-icon" aria-hidden="true">@((MarkupString)Icon)</span>
            }
            if (Text is not null) { @Text }
            else if (InnerContent is not null) { @InnerContent }
            else if (Count.HasValue) { @BadgeText }
        }
    };
}
