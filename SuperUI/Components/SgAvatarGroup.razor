@namespace SuperUI.Components

<div class="sgc-avatar-group @OverlapClass @CssClass">
    @ChildContent
</div>

@code {
    /// <summary>
    /// Gets or sets the content (typically SgAvatar components) to render in the group.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the overlap amount between avatars.
    /// Default is true (avatars overlap slightly).
    /// </summary>
    [Parameter] public bool Overlap { get; set; } = true;

    /// <summary>
    /// Gets or sets additional CSS classes to apply to the component.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    private string OverlapClass => Overlap ? "sgc-overlap" : "";
}
