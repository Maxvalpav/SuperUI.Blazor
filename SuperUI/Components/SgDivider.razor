@namespace SuperUI.Components

@if (Vertical)
{
    <span class="sgc-divider sgc-v @CssClass"></span>
}
else if (!string.IsNullOrEmpty(Text) || ChildContent is not null)
{
    <div class="sgc-divider sgc-h sgc-text @CssClass">
        <span class="sgc-divider-text">@ChildContent@Text</span>
    </div>
}
else
{
    <hr class="sgc-divider sgc-h @CssClass" />
}

@code {
    /// <summary>
    /// Gets or sets the text to display on the divider line.
    /// </summary>
    [Parameter] public string? Text { get; set; }
    
    /// <summary>
    /// Gets or sets the custom content to display on the divider line.
    /// Takes precedence over <see cref="Text"/>.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    
    /// <summary>
    /// Gets or sets whether the divider is rendered vertically.
    /// Default is false (horizontal).
    /// </summary>
    [Parameter] public bool Vertical { get; set; }
    
    /// <summary>
    /// Gets or sets additional CSS classes to apply to the component.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }
}
