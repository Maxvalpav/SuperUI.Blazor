@namespace SuperUI.Components

@if (_showBuilder)
{
    <div class="sg-rag-filter-builder @CssClass">
        <SgFilterBuilder @ref="_filterBuilderRef" />
    </div>
}

@code {
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool ShowBuilder { get; set; }
    [Parameter] public EventCallback OnFiltersChanged { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool _showBuilder => ShowBuilder;
    private SgFilterBuilder? _filterBuilderRef;
}
