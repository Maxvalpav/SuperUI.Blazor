@namespace SuperUI.Components
@inherits SgJsComponentBase

<div class="@Css("sgc-resizable").AddClass("sgc-resizable-disabled", Disabled).Build()"
     style="@RootStyle"
     @ref="RootRef"
     @attributes="AdditionalAttributes">
    <div class="sgc-resizable-content">
        @ChildContent
    </div>

    @if (!Disabled)
    {
        @foreach (var dir in EnabledHandles)
        {
            <div class="sgc-resizable-handle sgc-resizable-handle-@dir" data-dir="@dir"></div>
        }
    }
</div>

@code {
    protected override string ModulePath => "./_content/SuperUI/superui-resizable.js";
    protected override string IdPrefix   => "sg-resizable";

    private static readonly string[] _allDirs = new[] { "n", "s", "e", "w", "ne", "nw", "se", "sw" };

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public double Width { get; set; } = 320;
    [Parameter] public double Height { get; set; } = 200;
    [Parameter] public double MinWidth { get; set; } = 80;
    [Parameter] public double MinHeight { get; set; } = 60;
    [Parameter] public double MaxWidth { get; set; } = 4000;
    [Parameter] public double MaxHeight { get; set; } = 4000;
    [Parameter] public string Handles { get; set; } = "se,e,s";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<(double Width, double Height)> SizeChanging { get; set; }
    [Parameter] public EventCallback<(double Width, double Height)> SizeChanged { get; set; }

    private IEnumerable<string> EnabledHandles
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Handles)) yield break;
            var set = new HashSet<string>(
                Handles.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
                StringComparer.OrdinalIgnoreCase);
            foreach (var d in _allDirs)
                if (set.Contains(d)) yield return d;
        }
    }

    private string RootStyle
    {
        get
        {
            var inv = System.Globalization.CultureInfo.InvariantCulture;
            var w = Width > 0 ? $"width:{Width.ToString(inv)}px;" : "";
            var h = Height > 0 ? $"height:{Height.ToString(inv)}px;" : "";
            return w + h + Styles().Build();
        }
    }

    protected override async ValueTask OnInteractiveAsync()
    {
        await SafeInvokeVoidAsync("attach", RootRef, SelfRef,
            new
            {
                minWidth = MinWidth,
                minHeight = MinHeight,
                maxWidth = MaxWidth,
                maxHeight = MaxHeight,
                disabled = Disabled,
                liveFeedback = SizeChanging.HasDelegate
            });
    }

    [JSInvokable]
    public async Task SetSizeLive(double width, double height)
    {
        if (SizeChanging.HasDelegate)
            await SizeChanging.InvokeAsync((width, height));
    }

    [JSInvokable]
    public async Task SetSize(double width, double height)
    {
        var changed = false;
        if (Math.Abs(width - Width) > 0.5) { Width = width; changed = true; }
        if (Math.Abs(height - Height) > 0.5) { Height = height; changed = true; }
        if (!changed) return;
        if (SizeChanged.HasDelegate) await SizeChanged.InvokeAsync((Width, Height));
        await InvokeAsync(StateHasChanged);
        
        if (IsInteractive)
        {
            try
            {
                await Task.Delay(10);
                await SafeInvokeVoidAsync("reapplySize", RootRef);
            }
            catch { }
        }
    }

    protected override async ValueTask OnDisposingAsync()
    {
        await SafeInvokeVoidAsync("detach", RootRef);
    }
}
