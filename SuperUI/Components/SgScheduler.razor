@namespace SuperUI.Components
@using System.Globalization
@using SuperUI.Localization
@using SuperUI.Enums
@inject ISuperUILocalizer Localizer

<div class="sg-scheduler" style="height: @Height;">
    <div class="sg-scheduler-header">
        <div class="sg-scheduler-title">@GetHeaderTitle()</div>
        <div class="sg-scheduler-actions">
            <div style="width: 240px;">
                <SgTextBox Placeholder="@Localizer["Scheduler_SearchEvents"]" @bind-Value="_searchText" Immediate="true" />
            </div>
            <div class="sgc-icon-btn-group">
                @foreach (var viewType in Enum.GetValues<SgSchedulerView>())
                {
                    <SgButton @key="viewType" 
                              Text="@Localizer[$"Scheduler_{viewType}"]" 
                              Variant="@(View == viewType ? SgButtonVariant.Primary : SgButtonVariant.Default)"
                              Size="SgSize.Sm"
                              OnClick="@(async () => { View = viewType; await ViewChanged.InvokeAsync(viewType); })" />
                }
            </div>
            <div class="sgc-icon-btn-group">
                <SgIconButton Icon="@SgIcons.ChevronLeft" Title="@Localizer["Scheduler_PreviousPeriod"]" Size="SgSize.Sm" OnClick="async () => await PreviousRange()" />
                <SgButton Text="@Localizer["Scheduler_Today"]" Size="SgSize.Sm" OnClick="async () => await GoToToday()" />
                <SgIconButton Icon="@SgIcons.ChevronRight" Title="@Localizer["Scheduler_NextPeriod"]" Size="SgSize.Sm" OnClick="async () => await NextRange()" />
            </div>
            @if (OnAddEvent.HasDelegate || EnableCreation)
            {
                <SgButton Text="@Localizer["Scheduler_AddEvent"]" Variant="SgButtonVariant.Primary" Size="SgSize.Sm" 
                          OnClick="() => HandleAddClick(DateTime.Today)">
                    <Icon>@((MarkupString)SgIcons.Plus)</Icon>
                </SgButton>
            }
        </div>
    </div>
    <div class="sg-scheduler-body">
        @switch (View)
        {
            case SgSchedulerView.Day:
                @RenderDayView()
                break;
            case SgSchedulerView.Week:
                @RenderWeekView()
                break;
            case SgSchedulerView.Month:
                @RenderMonthView()
                break;
            case SgSchedulerView.Agenda:
                @RenderAgendaView()
                break;
            case SgSchedulerView.Timeline:
                @RenderTimelineView()
                break;
        }
    </div>
</div>

<SgModal @bind-Visible="_isModalVisible" Title="@(_isNewEvent ? Localizer["Scheduler_NewEvent"] : Localizer["Scheduler_EditEvent"])" Width="500px">
    <ChildContent>
        <SgStack Orientation="SgOrientation.Vertical" Gap="16px">
            <SgTextBox Label="@Localizer["Scheduler_Title"]" @bind-Value="_editingEvent.Title" Required="true" />
            <SgTextBox Label="@Localizer["Scheduler_Description"]" @bind-Value="_editingEvent.Description" Multiline="true" Rows="3" />
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <SgDatePicker Label="@Localizer["Scheduler_StartDate"]" @bind-Value="_editingStartDate" Required="true" />
                <SgTimePicker Label="@Localizer["Scheduler_StartTime"]" @bind-Value="_editingStartTime" />
                <SgDatePicker Label="@Localizer["Scheduler_EndDate"]" @bind-Value="_editingEndDate" Required="true" />
                <SgTimePicker Label="@Localizer["Scheduler_EndTime"]" @bind-Value="_editingEndTime" />
            </div>
            <SgCheckBox Label="@Localizer["Scheduler_AllDayEvent"]" @bind-Value="_editingEvent.IsAllDay" />
            <SgColorPicker Label="@Localizer["Scheduler_Color"]" @bind-Value="_editingEvent.Color" />
            <SgTextBox Label="@Localizer["Scheduler_Icon"]" @bind-Value="_editingEvent.Icon" Placeholder="SVG или иконка" />
        </SgStack>
    </ChildContent>
    <FooterContent>
        <div style="display: flex; gap: 8px; justify-content: space-between;">
            @if (!_isNewEvent && (OnDeleteEvent.HasDelegate || EnableEditing))
            {
                <SgButton Text="@Localizer["Delete"]" Variant="SgButtonVariant.Danger" OnClick="HandleDeleteEvent" />
            }
            <div style="display: flex; gap: 8px;">
                <SgButton Text="@Localizer["Scheduler_Cancel"]" OnClick="@(() => _isModalVisible = false)" />
                <SgButton Text="@Localizer["Scheduler_Save"]" Variant="SgButtonVariant.Primary" OnClick="SaveEvent" />
            </div>
        </div>
    </FooterContent>
</SgModal>

@code {
    [Parameter] public SgSchedulerView View { get; set; } = SgSchedulerView.Week;
    [Parameter] public EventCallback<SgSchedulerView> ViewChanged { get; set; }
    [Parameter] public DateTime Value { get; set; } = DateTime.Today;
    [Parameter] public EventCallback<DateTime> ValueChanged { get; set; }
    [Parameter] public IEnumerable<SgSchedulerEvent>? Events { get; set; }
    [Parameter] public string Height { get; set; } = "600px";
    [Parameter] public bool EnableCreation { get; set; } = true;
    [Parameter] public bool EnableEditing { get; set; } = true;
    [Parameter] public bool EnableDragAndDrop { get; set; } = true;
    [Parameter] public int StartHour { get; set; } = 0;
    [Parameter] public int EndHour { get; set; } = 24;
    [Parameter] public EventCallback<SgSchedulerEvent> OnAddEvent { get; set; }
    [Parameter] public EventCallback<SgSchedulerEvent> OnUpdateEvent { get; set; }
    [Parameter] public EventCallback<SgSchedulerEvent> OnDeleteEvent { get; set; }
    [Parameter] public EventCallback<SgSchedulerEvent> OnEventClick { get; set; }
    [Parameter] public string SearchText { get; set; } = "";

    private bool _isModalVisible;
    private bool _isNewEvent;
    private SgSchedulerEvent _editingEvent = new();
    private DateTime? _editingStartDate, _editingEndDate;
    private TimeSpan? _editingStartTime, _editingEndTime;
    private List<SgSchedulerEvent> _internalEvents = new();
    private SgSchedulerEvent? _draggedEvent;
    private string _searchText = "";

    protected override void OnInitialized() => _internalEvents = Events?.ToList() ?? new();
    
    protected override void OnParametersSet()
    {
        if (Events != null) _internalEvents = Events.ToList();
        if (_searchText != SearchText) _searchText = SearchText;
    }

    private string GetHeaderTitle() => View switch
    {
        SgSchedulerView.Day => Value.ToString("dddd, dd MMMM yyyy", CultureInfo.CurrentCulture),
        SgSchedulerView.Week => $"{GetWeekStart():dd MMMM} - {GetWeekEnd():dd MMMM yyyy}",
        SgSchedulerView.Month => Value.ToString("MMMM yyyy", CultureInfo.CurrentCulture),
        SgSchedulerView.Agenda => Localizer["Scheduler_AgendaTitle"],
        SgSchedulerView.Timeline => $"{Value:dd MMMM yyyy}",
        _ => ""
    };

    private async Task SetView(SgSchedulerView view)
    {
        if (View == view) return;
        await ViewChanged.InvokeAsync(view);
        // We don't set View = view here; we let the parent do it via the parameter
        // But if the parent doesn't have a binding, we should update it locally to remain functional
        if (!ViewChanged.HasDelegate)
        {
            View = view;
            StateHasChanged();
        }
    }

    private async Task PreviousRange()
    {
        Value = View switch
        {
            SgSchedulerView.Day => Value.AddDays(-1),
            SgSchedulerView.Week => Value.AddDays(-7),
            SgSchedulerView.Month => Value.AddMonths(-1),
            _ => Value
        };
        await ValueChanged.InvokeAsync(Value);
        StateHasChanged();
    }

    private async Task NextRange()
    {
        Value = View switch
        {
            SgSchedulerView.Day => Value.AddDays(1),
            SgSchedulerView.Week => Value.AddDays(7),
            SgSchedulerView.Month => Value.AddMonths(1),
            _ => Value
        };
        await ValueChanged.InvokeAsync(Value);
        StateHasChanged();
    }

    private async Task GoToToday() 
    { 
        Value = DateTime.Today; 
        await ValueChanged.InvokeAsync(Value); 
        StateHasChanged();
    }

    private DateTime GetWeekStart()
    {
        var dayOfWeek = (int)Value.DayOfWeek;
        return Value.AddDays(dayOfWeek == 0 ? -6 : 1 - dayOfWeek).Date;
    }

    private DateTime GetWeekEnd() => GetWeekStart().AddDays(6);
    private List<DateTime> GetWeekDays() => Enumerable.Range(0, 7).Select(i => GetWeekStart().AddDays(i)).ToList();

    private List<DateTime> GetDays()
    {
        var firstDay = new DateTime(Value.Year, Value.Month, 1);
        var days = new List<DateTime>();
        var startDay = (int)firstDay.DayOfWeek;
        startDay = startDay == 0 ? 6 : startDay - 1;
        
        for (int i = startDay; i > 0; i--) days.Add(firstDay.AddDays(-i));
        for (int i = 0; i < DateTime.DaysInMonth(Value.Year, Value.Month); i++) days.Add(firstDay.AddDays(i));
        for (int i = 0; i < 42 - days.Count; i++) days.Add(firstDay.AddDays(DateTime.DaysInMonth(Value.Year, Value.Month) + i));
        
        return days;
    }

    private string GetWeekdayHeader(DateTime date) => date.ToString("dddd", CultureInfo.CurrentCulture);
    private List<string> GetWeekdayNames() => new() { "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс" };

    private string GetDayClass(DateTime date)
    {
        var classes = new List<string> { "sg-scheduler-day" };
        if (date.Month != Value.Month) classes.Add("sg-scheduler-day-other-month");
        if (date.Date == DateTime.Today) classes.Add("sg-scheduler-day-today");
        if (date.Date == Value.Date) classes.Add("sg-scheduler-day-selected");
        if (date.DayOfWeek == DayOfWeek.Saturday || date.DayOfWeek == DayOfWeek.Sunday) classes.Add("sg-scheduler-day-weekend");
        return string.Join(" ", classes);
    }

    private async Task SelectDate(DateTime date)
    {
        Value = date;
        await ValueChanged.InvokeAsync(Value);
    }

    private void HandleDayDoubleClick(DateTime date)
    {
        if (OnAddEvent.HasDelegate || EnableCreation) HandleAddClick(date);
    }

    private List<SgSchedulerEvent> FilterEvents(List<SgSchedulerEvent> events)
    {
        if (string.IsNullOrWhiteSpace(_searchText)) return events;
        var searchLower = _searchText.ToLowerInvariant();
        return events.Where(e => 
            (e.Title?.ToLowerInvariant().Contains(searchLower) ?? false) ||
            (e.Description?.ToLowerInvariant().Contains(searchLower) ?? false)).ToList();
    }

    private List<SgSchedulerEvent> GetEventsForDate(DateTime date) => 
        FilterEvents(_internalEvents.Where(e => e.Start.Date <= date.Date && e.End.Date >= date.Date).ToList());

    private List<SgSchedulerEvent> GetEventsForSlot(DateTime start, DateTime end) => 
        FilterEvents(_internalEvents.Where(e => e.Start < end && e.End > start).ToList());

    private List<SgSchedulerEvent> GetAllEvents() => FilterEvents(_internalEvents);

    private void HandleSlotClick(DateTime slotStart)
    {
        if (OnAddEvent.HasDelegate || EnableCreation) HandleAddClick(slotStart);
    }

    private void HandleAddClick(DateTime date)
    {
        _isNewEvent = true;
        _editingEvent = new() { Start = date.Date.AddHours(9), End = date.Date.AddHours(10) };
        (_editingStartDate, _editingStartTime) = (_editingEvent.Start.Date, _editingEvent.Start.TimeOfDay);
        (_editingEndDate, _editingEndTime) = (_editingEvent.End.Date, _editingEvent.End.TimeOfDay);
        _isModalVisible = true;
    }

    private void HandleEventClick(SgSchedulerEvent ev)
    {
        if (OnEventClick.HasDelegate)
        {
            OnEventClick.InvokeAsync(ev);
        }
        else if (EnableEditing)
        {
            _isNewEvent = false;
            _editingEvent = new()
            {
                Id = ev.Id, Title = ev.Title, Description = ev.Description,
                Start = ev.Start, End = ev.End, IsAllDay = ev.IsAllDay,
                Color = ev.Color, Icon = ev.Icon, RecurrenceRule = ev.RecurrenceRule, Data = ev.Data
            };
            (_editingStartDate, _editingStartTime) = (_editingEvent.Start.Date, _editingEvent.Start.TimeOfDay);
            (_editingEndDate, _editingEndTime) = (_editingEvent.End.Date, _editingEvent.End.TimeOfDay);
            _isModalVisible = true;
        }
    }

    private async Task SaveEvent()
    {
        if (_editingStartDate.HasValue) _editingEvent.Start = _editingStartDate.Value.Add(_editingStartTime ?? TimeSpan.Zero);
        if (_editingEndDate.HasValue) _editingEvent.End = _editingEndDate.Value.Add(_editingEndTime ?? TimeSpan.Zero);
        
        if (_isNewEvent)
        {
            if (OnAddEvent.HasDelegate) await OnAddEvent.InvokeAsync(_editingEvent);
            else _internalEvents.Add(_editingEvent);
        }
        else
        {
            var existing = _internalEvents.FirstOrDefault(e => e.Id == _editingEvent.Id);
            if (existing != null)
            {
                if (OnUpdateEvent.HasDelegate) await OnUpdateEvent.InvokeAsync(_editingEvent);
                else _internalEvents[_internalEvents.IndexOf(existing)] = _editingEvent;
            }
        }
        
        _isModalVisible = false;
    }

    private async Task HandleDeleteEvent()
    {
        if (!_isNewEvent)
        {
            var existing = _internalEvents.FirstOrDefault(e => e.Id == _editingEvent.Id);
            if (existing != null)
            {
                if (OnDeleteEvent.HasDelegate) await OnDeleteEvent.InvokeAsync(_editingEvent);
                else _internalEvents.Remove(existing);
            }
            _isModalVisible = false;
        }
    }

    private async Task HandleDrop(DateTime newStart)
    {
        if (_draggedEvent == null) return;
        
        var duration = _draggedEvent.End - _draggedEvent.Start;
        _draggedEvent.Start = newStart;
        _draggedEvent.End = newStart.Add(duration);

        if (OnUpdateEvent.HasDelegate) await OnUpdateEvent.InvokeAsync(_draggedEvent);
        _draggedEvent = null;
    }

    private Task HandleDropOnDate(DateTime date) => HandleDrop(date.Date.Add(_draggedEvent?.Start.TimeOfDay ?? TimeSpan.Zero));
    private Task HandleDropOnSlot(DateTime slotStart) => HandleDrop(slotStart);

    private string GetTooltipText(SgSchedulerEvent ev, bool showTime = true)
    {
        var time = ev.IsAllDay ? Localizer["Scheduler_AllDay"] : $"{ev.Start:HH:mm} - {ev.End:HH:mm}";
        var desc = !string.IsNullOrWhiteSpace(ev.Description) ? $"\n{ev.Description}" : "";
        return showTime ? $"{ev.Title}\n{time}{desc}" : $"{ev.Title}{desc}";
    }

    private string GetEventStyle(SgSchedulerEvent ev) => 
        string.IsNullOrEmpty(ev.Color) ? "" : $"background-color: {ev.Color}; border-left-color: {ev.Color};";

    private RenderFragment RenderEvent(SgSchedulerEvent ev, bool showTime = false) => __builder =>
    {
        <SgTooltip Text="@GetTooltipText(ev, showTime)">
            <div class="sg-scheduler-event" draggable="@(EnableDragAndDrop ? "true" : "false")"
                 @ondragstart="() => { if(EnableDragAndDrop) _draggedEvent = ev; }"
                 style="@GetEventStyle(ev)"
                 @onclick:stopPropagation="true"
                 @onclick="() => HandleEventClick(ev)">
                @if (showTime)
                {
                    <span class="sg-scheduler-event-time">@ev.Start.ToString("HH:mm") - @ev.End.ToString("HH:mm")</span>
                }
                <div style="display: flex; align-items: center; gap: 4px;">
                    @if (!string.IsNullOrEmpty(ev.Icon))
                    {
                        <span class="sg-scheduler-event-icon">@((MarkupString)ev.Icon)</span>
                    }
                    <span class="sg-scheduler-event-title">@ev.Title</span>
                </div>
            </div>
        </SgTooltip>
    };

    private RenderFragment RenderTimeColumn() => __builder =>
    {
        <div class="sg-scheduler-time-column">
            @for (int hour = StartHour; hour < EndHour; hour++)
            {
                <div class="sg-scheduler-time-slot">
                    <span class="sg-scheduler-time-label">@hour.ToString("00"):00</span>
                </div>
            }
        </div>
    };

    private RenderFragment RenderDayView() => __builder =>
    {
        <div class="sg-scheduler-day-view">
            <div class="sg-scheduler-day-header">
                <div class="sg-scheduler-day-title">@GetWeekdayHeader(Value)</div>
            </div>
            <div class="sg-scheduler-day-grid">
                @RenderTimeColumn()
                <div class="sg-scheduler-events-column">
                    @for (int hour = StartHour; hour < EndHour; hour++)
                    {
                        var slotStart = Value.Date.AddHours(hour);
                        <div class="sg-scheduler-time-slot" @onclick="() => HandleSlotClick(slotStart)"
                             ondragover="event.preventDefault();" @ondrop="() => HandleDropOnSlot(slotStart)">
                            @foreach (var ev in GetEventsForSlot(slotStart, slotStart.AddHours(1)))
                            {
                                @RenderEvent(ev, true)
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    };

    private RenderFragment RenderWeekView() => __builder =>
    {
        <div class="sg-scheduler-week-view">
            <div class="sg-scheduler-week-header">
                <div class="sg-scheduler-time-header"></div>
                @foreach (var date in GetWeekDays())
                {
                    <div class="sg-scheduler-day-header-cell">
                        <div class="sg-scheduler-weekday">@GetWeekdayHeader(date)</div>
                        <div class="sg-scheduler-date">@date.Day</div>
                    </div>
                }
            </div>
            <div class="sg-scheduler-week-grid">
                @RenderTimeColumn()
                @foreach (var date in GetWeekDays())
                {
                    <div class="sg-scheduler-day-column">
                        @for (int hour = StartHour; hour < EndHour; hour++)
                        {
                            var slotStart = date.Date.AddHours(hour);
                            <div class="sg-scheduler-time-slot" @onclick="() => HandleSlotClick(slotStart)"
                                 ondragover="event.preventDefault();" @ondrop="() => HandleDropOnSlot(slotStart)">
                                @foreach (var ev in GetEventsForSlot(slotStart, slotStart.AddHours(1)))
                                {
                                    @RenderEvent(ev)
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    };

    private RenderFragment RenderMonthView() => __builder =>
    {
        <div class="sg-scheduler-month-view">
            <div class="sg-scheduler-month-weekdays">
                @foreach (var day in GetWeekdayNames())
                {
                    <div class="sg-scheduler-weekday">@day</div>
                }
            </div>
            <div class="sg-scheduler-month-grid">
                @foreach (var date in GetDays())
                {
                    <div class="@GetDayClass(date)" 
                         @onclick="() => SelectDate(date)"
                         @ondblclick="() => HandleDayDoubleClick(date)"
                         ondragover="event.preventDefault();" @ondrop="() => HandleDropOnDate(date)">
                        <div class="sg-scheduler-date-header">
                            <span class="sg-scheduler-date-value">@date.Day</span>
                        </div>
                        <div class="sg-scheduler-date-content">
                            @foreach (var ev in GetEventsForDate(date))
                            {
                                @RenderEvent(ev)
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    };

    private RenderFragment RenderAgendaView() => __builder =>
    {
        <div class="sg-scheduler-agenda-view">
            @if (GetAllEvents().Any())
            {
                @foreach (var ev in GetAllEvents().OrderBy(e => e.Start))
                {
                    <div class="sg-scheduler-agenda-item" @onclick="() => HandleEventClick(ev)">
                        <div class="sg-scheduler-agenda-date">
                            <div class="sg-scheduler-agenda-day">@ev.Start.ToString("dd")</div>
                            <div class="sg-scheduler-agenda-month">@ev.Start.ToString("MMM", CultureInfo.CurrentCulture)</div>
                        </div>
                        <div class="sg-scheduler-agenda-content">
                            <div class="sg-scheduler-agenda-title">@ev.Title</div>
                            <div class="sg-scheduler-agenda-time">
                                @if (ev.IsAllDay)
                                {
                                    <span>@Localizer["Scheduler_AllDay"]</span>
                                }
                                else
                                {
                                    <span>@ev.Start.ToString("HH:mm") - @ev.End.ToString("HH:mm")</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(ev.Description))
                            {
                                <div class="sg-scheduler-agenda-desc">@ev.Description</div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="sg-scheduler-empty">@Localizer["Scheduler_NoEvents"]</div>
            }
        </div>
    };

    private RenderFragment RenderTimelineView() => __builder =>
    {
        <div class="sg-scheduler-timeline-view" style="padding: 20px; text-align: center; color: var(--sg-fg-muted);">
            @Localizer["Scheduler_TimelineNotImplemented"]
        </div>
    };
}
