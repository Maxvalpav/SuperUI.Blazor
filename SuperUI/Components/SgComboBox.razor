@namespace SuperUI.Components
@typeparam TValue
@implements IDisposable
@using System.Linq.Expressions
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer

<div class="sgc-field @(Block ? "sgc-block" : "") @CssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label id="@_labelId" class="sgc-label @(Required ? "sgc-required" : "")">@Label</label>
    }
    <div class="sgc-combo @(Block ? "sgc-block" : "") @(_open ? "sgc-open" : "") @(Disabled ? "sgc-disabled" : "") @(IsInvalid ? "sgc-invalid" : "")"
         role="combobox"
         aria-expanded="@(_open ? "true" : "false")"
         aria-haspopup="listbox"
         aria-labelledby="@_labelId"
         aria-required="@(Required ? "true" : null)"
         aria-disabled="@(Disabled ? "true" : null)"
         aria-invalid="@(IsInvalid ? "true" : null)"
         aria-describedby="@DescribedBy"
         tabindex="@(Disabled ? "-1" : "0")"
         @onfocusout="HandleFocusOutAsync"
         @onkeydown="@((!Editable || !_open) ? EventCallback.Factory.Create<KeyboardEventArgs>(this, OnKeyDownAsync) : default)"
         @onclick:stopPropagation="true">
        <div class="sgc-combo-control" @onclick="ToggleAsync">
            @if (Editable && _open)
            {
                <input class="sgc-combo-input"
                       value="@_search"
                       placeholder="@EffectivePlaceholder"
                       aria-autocomplete="list"
                       aria-controls="@_listboxId"
                       @oninput="OnSearchInput"
                       @onkeydown="OnKeyDownAsync"
                       @onclick:stopPropagation="true" />
            }
            else if (Value is not null)
            {
                <span class="sgc-combo-value">@LabelFrom(Value!)</span>
            }
            else
            {
                <span class="sgc-combo-placeholder">@Placeholder</span>
            }
            @if (AllowClear && Value is not null && !Disabled)
            {
                <button class="sgc-combo-clear" 
                        @onclick:stopPropagation="true" 
                        @onclick="ClearAsync" 
                        type="button" 
                        aria-label="@ClearLabel"
                        title="@ClearLabel">×</button>
            }
            <span class="sgc-combo-caret" aria-hidden="true">@(_open ? "▲" : "▼")</span>
        </div>
        @if (_open)
        {
            <div id="@_listboxId" class="sgc-combo-menu" role="listbox">
                @if (IsEnumMode)
                {
                    var filteredEnum = GetFilteredEnumItems().ToList();
                    @if (filteredEnum.Count == 0)
                    {
                        <div class="sgc-combo-empty" role="status">@EffectiveEmptyText</div>
                    }
                    else
                    {
                        @for (var i = 0; i < filteredEnum.Count; i++)
                        {
                            var idx = i;
                            var ei = filteredEnum[idx];
                            var isSelected = IsEnumItemSelected(ei);
                            <div class="sgc-combo-option @(isSelected ? "sgc-selected" : "") @(idx == _activeIndex ? "sgc-active" : "")"
                                 role="option"
                                 aria-selected="@(isSelected ? "true" : "false")"
                                 title="@ei.Description"
                                 @onclick:stopPropagation="true"
                                 @onclick="() => PickEnumAsync(ei)">
                                @ei.Label
                            </div>
                        }
                    }
                }
                else
                {
                    var filtered = GetFilteredItems().ToList();
                    @if (filtered.Count == 0)
                    {
                        <div class="sgc-combo-empty" role="status">@EffectiveEmptyText</div>
                    }
                    else
                    {
                        @for (var i = 0; i < filtered.Count; i++)
                        {
                            var idx = i;
                            var it = filtered[idx];
                            var isSelected = IsSelected(it);
                            <div class="sgc-combo-option @(isSelected ? "sgc-selected" : "") @(idx == _activeIndex ? "sgc-active" : "")"
                                 role="option"
                                 aria-selected="@(isSelected ? "true" : "false")"
                                 @onclick:stopPropagation="true"
                                 @onclick="() => PickAsync(it)">
                                @LabelFrom(it)
                            </div>
                        }
                    }
                }
            </div>
        }
    </div>
    @if (IsInvalid)
    {
        <span id="@_errorId" class="sgc-error">@DisplayedError</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@_hintId" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private readonly string _labelId = "sg-combo-label-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _listboxId = "sg-combo-listbox-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _hintId = "sg-combo-hint-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _errorId = "sg-combo-err-" + Guid.NewGuid().ToString("N")[..8];
    private bool _open;
    private string _search = string.Empty;
    private int _activeIndex = -1;
    private SgEditContextBinder<TValue?>? _binder;
    private CancellationTokenSource? _blurCts;

    // enum support
    private List<SgEnumItem>? _enumItems;
    private Type? _lastEnumType;

    [CascadingParameter] private EditContext? CascadedEditContext { get; set; }
    
    /// <summary>
    /// Gets or sets the expression that identifies the bound value for EditContext validation.
    /// </summary>
    [Parameter] public Expression<Func<TValue?>>? ValueExpression { get; set; }
    
    /// <summary>
    /// Gets or sets the currently selected value.
    /// </summary>
    [Parameter] public TValue? Value { get; set; }
    
    /// <summary>
    /// Gets or sets the callback invoked when the selected value changes.
    /// </summary>
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    
    /// <summary>
    /// Gets or sets the collection of items to display in the dropdown.
    /// Ignored when <see cref="EnumType"/> is set.
    /// </summary>
    [Parameter] public IEnumerable<TValue> Items { get; set; } = Array.Empty<TValue>();

    /// <summary>
    /// When set, populates the dropdown from the specified enum type instead of
    /// <see cref="Items"/>. Supports <c>[Display]</c> and <c>[Description]</c> attributes.
    /// </summary>
    [Parameter] public Type? EnumType { get; set; }

    /// <summary>
    /// Determines whether the enum key is the member <see cref="SgEnumKeyMode.Name"/> (default)
    /// or the underlying <see cref="SgEnumKeyMode.IntValue"/>.
    /// Only relevant when <see cref="EnumType"/> is set.
    /// </summary>
    [Parameter] public SgEnumKeyMode EnumKeyMode { get; set; } = SgEnumKeyMode.Name;
    
    /// <summary>
    /// Gets or sets the function to extract display text from each item.
    /// If not specified, uses ToString() on the item (or the enum label when EnumType is set).
    /// </summary>
    [Parameter] public Func<TValue, string>? LabelSelector { get; set; }
    
    /// <summary>
    /// Gets or sets the placeholder text shown when no item is selected.
    /// </summary>
    [Parameter] public string? Placeholder { get; set; }
    
    /// <summary>
    /// Gets or sets the text displayed when no items match the search filter.
    /// </summary>
    [Parameter] public string? EmptyText { get; set; }
    
    /// <summary>
    /// Gets or sets the label text displayed above the combobox.
    /// </summary>
    [Parameter] public string? Label { get; set; }
    
    /// <summary>
    /// Gets or sets the hint text displayed below the combobox.
    /// </summary>
    [Parameter] public string? Hint { get; set; }
    
    /// <summary>
    /// Gets or sets the error text to display. Takes precedence over validation messages from EditContext.
    /// </summary>
    [Parameter] public string? ErrorText { get; set; }
    
    /// <summary>
    /// Gets or sets whether a clear button is shown when an item is selected. Default is true.
    /// </summary>
    [Parameter] public bool AllowClear { get; set; } = true;
    
    /// <summary>
    /// Gets or sets whether the input is editable for filtering items. Default is true.
    /// </summary>
    [Parameter] public bool Editable { get; set; } = true;
    
    /// <summary>
    /// Gets or sets whether the combobox is required.
    /// </summary>
    [Parameter] public bool Required { get; set; }
    
    /// <summary>
    /// Gets or sets whether the combobox is disabled.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }
    
    /// <summary>
    /// Gets or sets whether the combobox should take full width of its container. Default is true.
    /// </summary>
    [Parameter] public bool Block { get; set; } = true;
    
    /// <summary>
    /// Gets or sets additional CSS class names to apply to the field container.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    private string EffectivePlaceholder => Placeholder ?? Localizer["Select"];
    private string EffectiveEmptyText => string.IsNullOrEmpty(EmptyText) ? Localizer["NoMatches"] : EmptyText;
    private string ClearLabel => Localizer["Clear"];

    private bool IsInvalid => !string.IsNullOrEmpty(ErrorText) || (_binder?.HasValidationErrors ?? false);
    private string? DisplayedError => !string.IsNullOrEmpty(ErrorText) 
        ? ErrorText 
        : _binder?.ValidationMessages.FirstOrDefault();
    private string? DescribedBy => IsInvalid ? _errorId : (!string.IsNullOrEmpty(Hint) ? _hintId : null);

    // ── Enum support ──────────────────────────────────────────────────────────

    private bool IsEnumMode => _enumItems is not null;

    protected override void OnInitialized()
    {
        _binder = new SgEditContextBinder<TValue?>(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        _binder?.Update(CascadedEditContext, ValueExpression);

        if (EnumType is not null && EnumType != _lastEnumType)
        {
            _lastEnumType = EnumType;
            _enumItems = SgEnumHelper.GetItems(EnumType);
        }
        else if (EnumType is null)
        {
            _enumItems = null;
            _lastEnumType = null;
        }
    }

    // ── Label helpers ─────────────────────────────────────────────────────────

    private string LabelFrom(TValue v)
    {
        if (LabelSelector is not null) return LabelSelector(v);
        if (IsEnumMode)
        {
            var str = v?.ToString() ?? "";
            var ei = _enumItems!.FirstOrDefault(e => e.Name == str || e.IntValue.ToString() == str);
            return ei?.Label ?? str;
        }
        return v?.ToString() ?? "";
    }

    // Label from SgEnumItem directly (used in dropdown list)
    private string EnumItemLabel(SgEnumItem ei) => ei.Label;

    // ── Filtered items ────────────────────────────────────────────────────────

    private IEnumerable<TValue> GetFilteredItems()
    {
        if (IsEnumMode) return Array.Empty<TValue>(); // handled separately
        if (string.IsNullOrEmpty(_search)) return Items;
        return Items.Where(i =>
            LabelFrom(i).Contains(_search, StringComparison.CurrentCultureIgnoreCase));
    }

    private IEnumerable<SgEnumItem> GetFilteredEnumItems()
    {
        if (_enumItems is null) return Array.Empty<SgEnumItem>();
        if (string.IsNullOrEmpty(_search)) return _enumItems;
        return _enumItems.Where(ei =>
            ei.Label.Contains(_search, StringComparison.CurrentCultureIgnoreCase) ||
            ei.Name.Contains(_search, StringComparison.CurrentCultureIgnoreCase));
    }

    private bool IsSelected(TValue v) => EqualityComparer<TValue>.Default.Equals(v, Value!);

    private bool IsEnumItemSelected(SgEnumItem ei)
    {
        if (Value is null) return false;
        var str = Value.ToString() ?? "";
        return ei.Name == str || ei.IntValue.ToString() == str;
    }

    // ── Toggle / focus ────────────────────────────────────────────────────────

    private async Task ToggleAsync()
    {
        if (Disabled) return;
        _blurCts?.Cancel();
        _open = !_open;
        if (_open) { _search = string.Empty; _activeIndex = -1; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleFocusOutAsync(FocusEventArgs e)
    {
        _blurCts?.Cancel();
        _blurCts = new CancellationTokenSource();
        var token = _blurCts.Token;
        try
        {
            await Task.Delay(200, token);
            if (_open)
            {
                _open = false;
                _search = string.Empty;
                _activeIndex = -1;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { }
    }

    private async Task CloseAsync()
    {
        _open = false;
        _search = string.Empty;
        _activeIndex = -1;
        await InvokeAsync(StateHasChanged);
    }

    private Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _activeIndex = 0;
        return InvokeAsync(StateHasChanged);
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        var count = IsEnumMode
            ? GetFilteredEnumItems().Count()
            : GetFilteredItems().Count();

        if (e.Key == "ArrowDown")
        {
            _activeIndex = Math.Min(count - 1, _activeIndex + 1);
            await InvokeAsync(StateHasChanged);
        }
        else if (e.Key == "ArrowUp")
        {
            _activeIndex = Math.Max(0, _activeIndex - 1);
            await InvokeAsync(StateHasChanged);
        }
        else if (e.Key == "Enter")
        {
            if (_activeIndex >= 0)
            {
                if (IsEnumMode)
                {
                    var items = GetFilteredEnumItems().ToList();
                    if (_activeIndex < items.Count)
                        await PickEnumAsync(items[_activeIndex]);
                }
                else
                {
                    var items = GetFilteredItems().ToList();
                    if (_activeIndex < items.Count)
                        await PickAsync(items[_activeIndex]);
                }
            }
        }
        else if (e.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    // ── Pick ──────────────────────────────────────────────────────────────────

    private async Task PickAsync(TValue v)
    {
        Value = v;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(v);
        _binder?.NotifyFieldChanged();
        await CloseAsync();
    }

    private async Task PickEnumAsync(SgEnumItem ei)
    {
        var v = ParseEnumValue(ei);
        Value = v;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(v);
        _binder?.NotifyFieldChanged();
        await CloseAsync();
    }

    private TValue? ParseEnumValue(SgEnumItem ei)
    {
        var targetType = typeof(TValue);
        var underlying = Nullable.GetUnderlyingType(targetType) ?? targetType;
        try
        {
            if (underlying == typeof(string))
                return (TValue)(object)(EnumKeyMode == SgEnumKeyMode.IntValue
                    ? ei.IntValue.ToString()
                    : ei.Name);
            if (underlying == typeof(int))
                return (TValue)(object)ei.IntValue;
            if (underlying.IsEnum)
                return (TValue)Enum.Parse(underlying, ei.Name);
        }
        catch { }
        return default;
    }

    private async Task ClearAsync()
    {
        Value = default;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(default);
        _binder?.NotifyFieldChanged();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _blurCts?.Cancel();
        _blurCts?.Dispose();
        _binder?.Dispose();
    }
}

