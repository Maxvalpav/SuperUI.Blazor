@namespace SuperUI.Components
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer

<span class="sgc-spinner @(Size == "lg" ? "sgc-lg" : "") @CssClass" 
      role="status" 
      aria-busy="true"
      aria-label="@(string.IsNullOrEmpty(Label) ? Localizer["Loading"] : Label)"></span>

@code {
    /// <summary>
    /// Gets or sets the spinner size.
    /// Supported values: "md", "lg". Default is "md".
    /// </summary>
    [Parameter] public string Size { get; set; } = "md";
    
    /// <summary>
    /// Gets or sets the accessibility label for screen readers.
    /// </summary>
    [Parameter] public string? Label { get; set; }
    
    /// <summary>
    /// Gets or sets additional CSS classes to apply to the component.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }
}
