@namespace SuperUI.Components
@typeparam TValue
@inherits SgFormFieldBase<TValue>
@inject ISuperUILocalizer Localizer

<div class="@GetFieldClasses()" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sgc-label @(Required ? "sgc-required" : "")" for="@EffectiveId">@Label</label>
    }

    <div class="@GetWrapperClasses()">
        <button type="button"
                class="sgc-num-btn sgc-num-dec"
                disabled="@(IsEffectivelyDisabled || ReadOnly || IsAtMin)"
                @onclick="DecrementAsync"
                aria-label="@Localizer["NumberInput_Decrement"]"
                tabindex="-1">
            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" fill="currentColor">
                <rect x="2" y="7" width="12" height="2" rx="1"/>
            </svg>
        </button>

        <input id="@EffectiveId"
               type="number"
               class="sgc-num-input"
               step="@StepStr"
               min="@MinStr"
               max="@MaxStr"
               placeholder="@Placeholder"
               disabled="@IsEffectivelyDisabled"
               readonly="@ReadOnly"
               required="@Required"
               aria-required="@(Required ? "true" : null)"
               aria-invalid="@(HasError ? "true" : null)"
               aria-describedby="@DescribedBy"
               value="@DisplayValue"
               @oninput="OnInputAsync"
               @onchange="OnChangeAsync"
               @onkeydown="OnKeyDownAsync"
               @onfocus="HandleFocusAsync"
               @onblur="HandleBlurAsync"
               @attributes="AdditionalAttributesFiltered" />

        @if (!string.IsNullOrEmpty(Suffix))
        {
            <span class="sgc-num-suffix">@Suffix</span>
        }

        <button type="button"
                class="sgc-num-btn sgc-num-inc"
                disabled="@(IsEffectivelyDisabled || ReadOnly || IsAtMax)"
                @onclick="IncrementAsync"
                aria-label="@Localizer["NumberInput_Increment"]"
                tabindex="-1">
            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" fill="currentColor">
                <rect x="7" y="2" width="2" height="12" rx="1"/>
                <rect x="2" y="7" width="12" height="2" rx="1"/>
            </svg>
        </button>
    </div>

    @if (HasError)
    {
        <span id="@($"{EffectiveId}-err")" class="sgc-error">@DisplayedError</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@($"{EffectiveId}-hint")" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    [Parameter] public TValue? Step { get; set; }
    [Parameter] public TValue? Min { get; set; }
    [Parameter] public TValue? Max { get; set; }
    [Parameter] public string? Suffix { get; set; }
    [Parameter] public int? Decimals { get; set; }
    [Parameter] public bool Block { get; set; } = true;
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool Immediate { get; set; } = true;
    [Parameter] public EventCallback OnEnterPressed { get; set; }

    protected override string ComponentPrefix => "num";

    private string? DisplayedError => !string.IsNullOrEmpty(ErrorText) ? ErrorText : ValidationMessages.FirstOrDefault();
    private string? DescribedBy => HasError ? $"{EffectiveId}-err" : (!string.IsNullOrEmpty(Hint) ? $"{EffectiveId}-hint" : null);

    private string? DisplayValue
    {
        get
        {
            if (Value is null || EqualityComparer<TValue>.Default.Equals(Value, default!))
                return null;

            if (Decimals.HasValue)
                return Convert.ToDouble(Value, System.Globalization.CultureInfo.InvariantCulture)
                    .ToString($"F{Decimals.Value}", System.Globalization.CultureInfo.InvariantCulture);

            return Convert.ToString(Value, System.Globalization.CultureInfo.InvariantCulture);
        }
    }

    private string? StepStr => Step is null ? "1" : Convert.ToString(Step, System.Globalization.CultureInfo.InvariantCulture);
    private string? MinStr => Min is null ? null : Convert.ToString(Min, System.Globalization.CultureInfo.InvariantCulture);
    private string? MaxStr => Max is null ? null : Convert.ToString(Max, System.Globalization.CultureInfo.InvariantCulture);
    private bool IsAtMin => Min is not null && Value is not null && ToDouble(Value) <= ToDouble(Min);
    private bool IsAtMax => Max is not null && Value is not null && ToDouble(Value) >= ToDouble(Max);
    private TValue? StepValue => Step ?? FromDouble(1);

    private string GetFieldClasses() => Css("sgc-field")
        .AddIf("sgc-block", Block)
        .AddIf("sgc-invalid", HasError)
        .Add(CssClass)
        .Add(Class)
        .ToString();

    private string GetWrapperClasses() => Css("sgc-num-wrap")
        .AddIf("sgc-num-invalid", HasError)
        .AddIf("sgc-num-disabled", IsEffectivelyDisabled)
        .ToString();

    private Task OnInputAsync(ChangeEventArgs e)
        => Immediate ? CommitAsync(e.Value?.ToString()) : Task.CompletedTask;

    private Task OnChangeAsync(ChangeEventArgs e)
        => !Immediate ? CommitAsync(e.Value?.ToString()) : Task.CompletedTask;

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowUp") { await IncrementAsync(); return; }
        if (e.Key == "ArrowDown") { await DecrementAsync(); return; }
        if (e.Key == "Enter" && OnEnterPressed.HasDelegate)
            await OnEnterPressed.InvokeAsync();
    }

    private async Task IncrementAsync()
    {
        var next = ToDouble(Value) + ToDouble(StepValue);
        if (Max is not null) next = Math.Min(next, ToDouble(Max));
        await SetValueAsync(FromDouble(next));
    }

    private async Task DecrementAsync()
    {
        var next = ToDouble(Value) - ToDouble(StepValue);
        if (Min is not null) next = Math.Max(next, ToDouble(Min));
        await SetValueAsync(FromDouble(next));
    }

    private Task CommitAsync(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return SetValueAsync(default);

        if (double.TryParse(raw, System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out var parsed))
        {
            if (Min is not null) parsed = Math.Max(parsed, ToDouble(Min));
            if (Max is not null) parsed = Math.Min(parsed, ToDouble(Max));
            return SetValueAsync(FromDouble(parsed));
        }

        return Task.CompletedTask;
    }

    private static double ToDouble(TValue? value)
    {
        if (value is null) return 0;
        try { return Convert.ToDouble(value, System.Globalization.CultureInfo.InvariantCulture); }
        catch { return 0; }
    }

    private static TValue? FromDouble(double value)
    {
        try
        {
            var target = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
            return (TValue)Convert.ChangeType(value, target, System.Globalization.CultureInfo.InvariantCulture);
        }
        catch
        {
            return default;
        }
    }

    protected override IReadOnlyDictionary<string, object> BuildAriaAttributes()
    {
        return new AriaBuilder()
            .Label(Label)
            .Required(Required)
            .Invalid(HasError)
            .Disabled(Disabled)
            .ReadOnly(ReadOnly)
            .Build();
    }
}
