@namespace SuperUI.Components
@using System.Linq.Expressions
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer
@implements IDisposable

<div class="sgc-field sgc-cron-picker @(Block ? "sgc-block" : "") @CssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sgc-label @(Required ? "sgc-required" : "")">@Label</label>
    }

    <div class="sgc-cron-picker-wrap @(_open ? "sgc-open" : "") @(Disabled ? "sgc-disabled" : "") @(IsInvalid ? "sgc-invalid" : "")"
         @onfocusout="HandleFocusOutAsync"
         @onclick:stopPropagation="true">

        <button type="button"
                class="sgc-cron-picker-trigger"
                disabled="@Disabled"
                aria-haspopup="dialog"
                aria-expanded="@(_open ? "true" : "false")"
                @onclick="ToggleAsync">
            <span class="sgc-cron-picker-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                    <circle cx="12" cy="15" r="2.5"></circle>
                </svg>
            </span>
            <span class="sgc-cron-picker-value">
                @if (!string.IsNullOrWhiteSpace(_currentExpression))
                {
                    <code class="sgc-cron-picker-expr">@_currentExpression</code>
                }
                else
                {
                    <span class="sgc-cron-picker-placeholder">@(Placeholder ?? Localizer["Cron_SelectSchedule"])</span>
                }
            </span>
            @if (AllowClear && !string.IsNullOrWhiteSpace(Value) && !Disabled)
            {
                <button type="button"
                        class="sgc-combo-clear"
                        title="@Localizer["Clear"]"
                        aria-label="@Localizer["Clear"]"
                        @onclick:stopPropagation="true"
                        @onclick="ClearAsync">×</button>
            }
            <span class="sgc-cron-picker-caret" aria-hidden="true">▾</span>
        </button>

        @if (_open)
        {
            <div class="sgc-cron-picker-popup" role="dialog" aria-modal="false">
                <SgCron Value="@_draftExpression"
                        ValueChanged="OnInnerValueChanged"
                        Presets="Presets"
                        ShowPresets="ShowPresets"
                        Compact="Compact"
                        Disabled="Disabled"
                        Block="true" />

                <div class="sgc-cron-picker-foot">
                    <button type="button" class="sgc-btn sgc-sm sgc-ghost" @onclick="CloseAsync">@Localizer["Cancel"]</button>
                    <button type="button" class="sgc-btn sgc-sm sgc-primary" @onclick="AcceptAsync">@Localizer["Apply"]</button>
                </div>
            </div>
        }
    </div>

    @if (IsInvalid)
    {
        <span class="sgc-error">@DisplayedError</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private bool _open;
    private string? _currentExpression;
    private string? _draftExpression;
    private CancellationTokenSource? _blurCts;
    private SgEditContextBinder<string?>? _binder;

    [CascadingParameter] private EditContext? CascadedEditContext { get; set; }

    /// <summary>Bound cron expression (5-field).</summary>
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string?>>? ValueExpression { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Block { get; set; } = true;
    [Parameter] public bool AllowClear { get; set; } = true;
    [Parameter] public bool ShowPresets { get; set; } = true;
    [Parameter] public bool Compact { get; set; }
    [Parameter] public IReadOnlyList<SgCronPreset> Presets { get; set; } = SgCronPreset.Defaults;
    [Parameter] public string? CssClass { get; set; }

    private bool IsInvalid => !string.IsNullOrEmpty(ErrorText) || (_binder?.HasValidationErrors ?? false);
    private string? DisplayedError => !string.IsNullOrEmpty(ErrorText)
        ? ErrorText
        : _binder?.ValidationMessages.FirstOrDefault();

    protected override void OnInitialized()
    {
        _binder = new SgEditContextBinder<string?>(StateHasChanged);
        _currentExpression = string.IsNullOrWhiteSpace(Value) ? null : Value;
    }

    protected override void OnParametersSet()
    {
        _binder?.Update(CascadedEditContext, ValueExpression);
        if (!_open && Value != _currentExpression)
        {
            _currentExpression = string.IsNullOrWhiteSpace(Value) ? null : Value;
        }
    }

    private Task ToggleAsync()
    {
        if (Disabled) return Task.CompletedTask;
        _blurCts?.Cancel();
        _open = !_open;
        if (_open)
        {
            _draftExpression = string.IsNullOrWhiteSpace(_currentExpression) ? "* * * * *" : _currentExpression;
        }
        return InvokeAsync(StateHasChanged);
    }

    private Task CloseAsync()
    {
        _open = false;
        _draftExpression = null;
        return InvokeAsync(StateHasChanged);
    }

    private void OnInnerValueChanged(string? expr)
    {
        _draftExpression = expr;
    }

    private async Task AcceptAsync()
    {
        var newExpr = _draftExpression ?? _currentExpression ?? "* * * * *";
        _currentExpression = newExpr;
        _open = false;
        Value = newExpr;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(newExpr);
        _binder?.NotifyFieldChanged();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearAsync()
    {
        _currentExpression = null;
        _open = false;
        Value = null;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(null);
        _binder?.NotifyFieldChanged();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleFocusOutAsync(FocusEventArgs e)
    {
        _blurCts?.Cancel();
        _blurCts = new CancellationTokenSource();
        var token = _blurCts.Token;
        try
        {
            await Task.Delay(180, token);
            if (_open)
            {
                _open = false;
                _draftExpression = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { }
    }

    public void Dispose()
    {
        _blurCts?.Cancel();
        _blurCts?.Dispose();
        _binder?.Dispose();
    }
}
