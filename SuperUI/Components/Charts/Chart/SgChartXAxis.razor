@namespace SuperUI.Components
@typeparam TItem where TItem : class

@code {
    [CascadingParameter] public SgChart<TItem>? Chart { get; set; }
    
    [Parameter] public string? Title { get; set; }
    [Parameter] public string Type { get; set; } = "category";
    [Parameter] public double? Min { get; set; }
    [Parameter] public double? Max { get; set; }
    [Parameter] public bool Display { get; set; } = true;
    [Parameter] public string? GridColor { get; set; }
    [Parameter] public bool ShowGrid { get; set; } = true;

    protected override void OnInitialized()
    {
        var axis = new SgChartXAxis
        {
            Title = Title,
            Type = Type,
            Min = Min,
            Max = Max,
            Display = Display,
            GridColor = GridColor,
            ShowGrid = ShowGrid
        };

        Chart?.RegisterXAxis(axis);
    }
}
