@namespace SuperUI.Components
@using SuperUI.Localization
@inherits SgJsComponentBase

<div class="@Css("sg-echarts-container").Build()"
     style="@Styles().AddStyle("height", Height).AddStyle("width", Width).Build()"
     @attributes="AttributesWithoutClassAndStyle">

    @if (_error is not null)
    {
        <div class="sg-echarts-error" role="alert">
            <p>@_error</p>
            <button type="button" class="sg-btn" @onclick="RetryAsync">@Localizer["ECharts_Retry"]</button>
        </div>
    }
    else
    {
        <div @ref="_containerRef"
             class="sg-echarts-canvas"
             role="img"
             aria-label="@(Options?.AriaLabel ?? $"Chart: {ChartType}")"
             style="@(_ready ? null : "visibility:hidden;") width:100%;height:100%;"></div>

        @if (!_ready)
        {
            <div class="sg-echarts-loading" aria-live="polite">
                <div class="sg-echarts-skeleton">
                    <span></span><span></span><span></span><span></span><span></span>
                </div>
                <span class="sg-echarts-loading-text">@Localizer["ECharts_Loading"]</span>
            </div>
        }
    }
</div>

@code {
    private ElementReference _containerRef;
    private readonly string _instanceId = SgIdGenerator.NewId("sg-ec");
    private bool _ready;
    private string? _error;
    private bool _isDisposed;

    // Change-detection snapshots
    private SgEChartsType _lastType;
    private object? _lastDataRef;
    private object? _lastGraphRef;
    private object? _lastCandleRef;
    private object? _lastOptsRef;
    private bool _refreshScheduled;
    private bool _refreshPending;

    /// <summary>Chart type.</summary>
    [Parameter] public SgEChartsType ChartType { get; set; } = SgEChartsType.Line;

    /// <summary>Data points for most chart types.</summary>
    [Parameter] public IEnumerable<SgEChartsDataPoint>? Data { get; set; }

    /// <summary>Graph data for Sankey / Tree / Sunburst.</summary>
    [Parameter] public SgEChartsGraphData? GraphData { get; set; }

    /// <summary>OHLC data for Candlestick charts.</summary>
    [Parameter] public IEnumerable<SgEChartsCandlePoint>? CandleData { get; set; }

    /// <summary>Chart options.</summary>
    [Parameter] public SgEChartsOptions? Options { get; set; }

    /// <summary>Container height. Default "400px".</summary>
    [Parameter] public string Height { get; set; } = "400px";

    /// <summary>Container width. Default "100%".</summary>
    [Parameter] public string Width { get; set; } = "100%";

    /// <summary>ECharts source URL override.</summary>
    [Parameter] public SgEChartsSources? Sources { get; set; }

    /// <summary>Fired when a data point is clicked.</summary>
    [Parameter] public EventCallback<SgEChartsClickEventArgs> OnDataPointClick { get; set; }

    [Inject]
    private new ISuperUILocalizer Localizer { get; set; } = default!;

    protected override string ModulePath => "./_content/SuperUI/sg-echarts.js";
    protected override string IdPrefix   => "sg-ec";

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override void OnParametersSet()
    {
        if (!_ready) return;
        var changed =
            ChartType != _lastType ||
            !ReferenceEquals(Data,       _lastDataRef)   ||
            !ReferenceEquals(GraphData,  _lastGraphRef)  ||
            !ReferenceEquals(CandleData, _lastCandleRef) ||
            !ReferenceEquals(Options,    _lastOptsRef);
        if (changed && !_refreshScheduled)
        {
            _refreshScheduled = true;
            _ = ScheduleRefreshAsync();
        }
    }

    private async Task ScheduleRefreshAsync()
    {
        try   { await RefreshAsync(); }
        finally
        {
            _refreshScheduled = false;
            if (_refreshPending)
            {
                _refreshPending   = false;
                _refreshScheduled = true;
                _ = ScheduleRefreshAsync();
            }
        }
    }

    protected override async ValueTask OnInteractiveAsync()
    {
        await InitAsync();
    }

    private async Task InitAsync()
    {
        if (Module is null || SelfRef is null) return;
        try
        {
            var opts   = BuildOpts();
            var data   = Data?.ToList();
            var graph  = GraphData;
            var candle = CandleData?.ToList();
            await SafeInvokeVoidAsync("initECharts",
                SelfRef, _containerRef, _instanceId,
                ChartType.ToString(), data, graph, candle, opts,
                Sources ?? new SgEChartsSources());
            CaptureSnapshot();
            _ready = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _error = $"{Localizer["ECharts_FailedToInitialize"]}: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CaptureSnapshot()
    {
        _lastType      = ChartType;
        _lastDataRef   = Data;
        _lastGraphRef  = GraphData;
        _lastCandleRef = CandleData;
        _lastOptsRef   = Options;
    }

    private object BuildOpts()
    {
        var o = Options ?? new SgEChartsOptions();
        return new
        {
            showLegend       = o.ShowLegend,
            showGrid         = o.ShowGrid,
            showLabels       = o.ShowLabels,
            enableZoom       = o.EnableZoom,
            animate          = o.Animate,
            animationDuration= o.AnimationDuration,
            valueSuffix      = o.ValueSuffix,
            valueDecimals    = o.ValueDecimals,
            showToolbar      = o.ShowToolbar,
            stacked          = o.Stacked,
            smooth           = o.Smooth,
            showPoints       = o.ShowPoints,
            colors           = o.Colors,
            gaugeMin         = o.GaugeMin,
            gaugeMax         = o.GaugeMax,
            donutInnerRadius = o.DonutInnerRadius,
            backgroundColor  = o.BackgroundColor,
        };
    }

    // ── Public methods ────────────────────────────────────────────────────────

    /// <summary>Redraws the chart with current parameters.</summary>
    public async Task RefreshAsync()
    {
        if (Module is null || !_ready) { _refreshPending = true; return; }
        try
        {
            var opts   = BuildOpts();
            var data   = Data?.ToList();
            var graph  = GraphData;
            var candle = CandleData?.ToList();
            await SafeInvokeVoidAsync("updateECharts",
                _instanceId, ChartType.ToString(), data, graph, candle, opts);
            CaptureSnapshot();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _error = $"{Localizer["ECharts_FailedToRefresh"]}: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Downloads the chart as a PNG file.</summary>
    public async Task ExportImageAsync()
    {
        if (Module is null) return;
        await SafeInvokeVoidAsync("exportImage", _instanceId);
    }

    /// <summary>Retries loading after an error.</summary>
    public async Task RetryAsync()
    {
        _error = null; _ready = false;
        await InvokeAsync(StateHasChanged);
        await InitAsync();
    }

    // ── JS callbacks ──────────────────────────────────────────────────────────

    [JSInvokable]
    public async Task OnDataPointClickedAsync(SgEChartsClickEventArgs args)
    {
        if (OnDataPointClick.HasDelegate)
            await OnDataPointClick.InvokeAsync(args);
    }

    // ── Dispose ───────────────────────────────────────────────────────────────

    protected override async ValueTask OnDisposingAsync()
    {
        if (Module is not null)
        {
            await SafeInvokeVoidAsync("disposeECharts", _instanceId);
        }
    }
}