@namespace SuperUI.Components
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ISuperUILocalizer Localizer

<div class="sg-d3-container @(_ready ? null : "sg-d3-state-loading") @CssClass"
     style="height: @Height; width: @Width;"
     @attributes="AdditionalAttributes">

    @if (_error is not null)
    {
        <div class="sg-d3-error" role="alert">
            <p>@_error</p>
            <button type="button" class="sg-btn" @onclick="RetryAsync">@Localizer["D3_Retry"]</button>
        </div>
    }
    else
    {
        @if (ShowToolbar && _ready)
        {
            <div class="sg-d3-toolbar" role="toolbar">
                <button type="button" class="sg-d3-tool" title="@Localizer["D3_ResetZoom"]"
                        @onclick="ResetZoomAsync" aria-label="@Localizer["D3_ResetZoom"]">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path fill="currentColor" d="M3 8a5 5 0 1 1 1.46 3.54l1-1A3.5 3.5 0 1 0 4.5 8H6L4 10.5 2 8h1Z"/>
                    </svg>
                </button>
                <button type="button" class="sg-d3-tool" title="@Localizer["D3_ExportSvg"]"
                        @onclick="ExportSvgAsync" aria-label="@Localizer["D3_ExportSvg"]">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path fill="currentColor" d="M2 2h7l3 3v9H2V2Zm7 0v3h3M8 7v5M6 9l2 3 2-3"/>
                    </svg>
                </button>
                <button type="button" class="sg-d3-tool" title="@Localizer["D3_ExportPng"]"
                        @onclick="ExportPngAsync" aria-label="@Localizer["D3_ExportPng"]">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path fill="currentColor" d="M8 1v8.6L5.7 7.3 4.3 8.7 8 12.4l3.7-3.7-1.4-1.4L9 9.6V1H8Zm-6 12h12v2H2v-2Z"/>
                    </svg>
                </button>
            </div>
        }

        <div @ref="_containerRef"
             class="sg-d3-canvas"
             style="@(_ready ? null : "visibility:hidden;")"></div>

        @if (!_ready)
        {
            <div class="sg-d3-loading" aria-live="polite">
                <div class="sg-d3-skeleton">
                    <span></span><span></span><span></span><span></span><span></span>
                </div>
                <span class="sg-d3-loading-text">@Localizer["D3_Loading"]</span>
            </div>
        }
    }
</div>

@code {
    private ElementReference _containerRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SgD3Chart>? _selfRef;
    private readonly string _chartId = $"sg-d3-{Guid.NewGuid():N}";
    private bool _ready;
    private string? _error;
    private bool _isDisposed;

    // Change-detection snapshots
    private SgD3ChartType _lastType;
    private object? _lastDataRef;
    private object? _lastGraphRef;
    private object? _lastOptsRef;
    private bool _refreshScheduled;
    private bool _refreshPending;

    // ── Parameters ────────────────────────────────────────────────────────────

    /// <summary>Visualisation type.</summary>
    [Parameter] public SgD3ChartType ChartType { get; set; } = SgD3ChartType.Bar;

    /// <summary>Data points for all chart types except <see cref="SgD3ChartType.ForceGraph"/>.</summary>
    [Parameter] public IEnumerable<SgD3DataPoint>? Data { get; set; }

    /// <summary>Graph data for <see cref="SgD3ChartType.ForceGraph"/>.</summary>
    [Parameter] public SgD3GraphData? GraphData { get; set; }

    /// <summary>Chart options.</summary>
    [Parameter] public SgD3Options? Options { get; set; }

    /// <summary>Container height. Default "400px".</summary>
    [Parameter] public string Height { get; set; } = "400px";

    /// <summary>Container width. Default "100%".</summary>
    [Parameter] public string Width { get; set; } = "100%";

    /// <summary>Show built-in toolbar (zoom reset, SVG/PNG export).</summary>
    [Parameter] public bool ShowToolbar { get; set; } = false;

    /// <summary>D3.js source URL override.</summary>
    [Parameter] public SgD3Sources? Sources { get; set; }

    /// <summary>Additional CSS class for the container.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Fired when the user clicks a data element.</summary>
    [Parameter] public EventCallback<SgD3ClickEventArgs> OnDataPointClick { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override void OnParametersSet()
    {
        if (!_ready) return;
        var changed =
            ChartType != _lastType ||
            !ReferenceEquals(Data,      _lastDataRef)  ||
            !ReferenceEquals(GraphData, _lastGraphRef) ||
            !ReferenceEquals(Options,   _lastOptsRef);

        if (changed && !_refreshScheduled)
        {
            _refreshScheduled = true;
            _ = ScheduleRefreshAsync();
        }
    }

    private async Task ScheduleRefreshAsync()
    {
        try   { await RefreshAsync(); }
        finally
        {
            _refreshScheduled = false;
            if (_refreshPending)
            {
                _refreshPending   = false;
                _refreshScheduled = true;
                _ = ScheduleRefreshAsync();
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isDisposed || !firstRender) return;
        try
        {
            _module  = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/sg-d3.js");
            if (_isDisposed) return;
            _selfRef = DotNetObjectReference.Create(this);
            await InitAsync();
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch (Exception)
        {
            _error = Localizer["D3_FailedToLoad"];
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task InitAsync()
    {
        if (_module is null || _selfRef is null) return;
        try
        {
            var data      = Data?.ToList()      ?? new List<SgD3DataPoint>();
            var graphData = GraphData           ?? new SgD3GraphData();
            var opts      = BuildOpts();
            await _module.InvokeVoidAsync("initD3",
                _selfRef, _containerRef, _chartId,
                ChartType.ToString(), data, graphData, opts,
                Sources ?? new SgD3Sources());
            CaptureSnapshot();
            _ready = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch (Exception)
        {
            _error = Localizer["D3_FailedToInitialize"];
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CaptureSnapshot()
    {
        _lastType      = ChartType;
        _lastDataRef   = Data;
        _lastGraphRef  = GraphData;
        _lastOptsRef   = Options;
    }

    private object BuildOpts()
    {
        var o = Options ?? new SgD3Options();
        return new
        {
            showGrid         = o.ShowGrid,
            showLabels       = o.ShowLabels,
            showLegend       = o.ShowLegend,
            enableZoom       = o.EnableZoom,
            animate          = o.Animate,
            animationDuration= o.AnimationDuration,
            colors           = o.Colors,
            valueSuffix      = o.ValueSuffix,
            valueDecimals    = o.ValueDecimals,
            donutInnerRadius = o.DonutInnerRadius,
            curve            = o.Curve,
            showPoints       = o.ShowPoints,
            stacked          = o.Stacked,
            forceDistance    = o.ForceDistance,
            forceCharge      = o.ForceCharge,
        };
    }

    // ── Public methods ────────────────────────────────────────────────────────

    /// <summary>Redraws the chart with current parameters.</summary>
    public async Task RefreshAsync()
    {
        if (_module is null || !_ready) { _refreshPending = true; return; }
        try
        {
            var data      = Data?.ToList()      ?? new List<SgD3DataPoint>();
            var graphData = GraphData           ?? new SgD3GraphData();
            var opts      = BuildOpts();
            await _module.InvokeVoidAsync("updateD3", _chartId, ChartType.ToString(), data, graphData, opts);
            CaptureSnapshot();
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch (Exception)
        {
            _error = Localizer["D3_FailedToRefresh"];
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Resets zoom to the default view.</summary>
    public async Task ResetZoomAsync()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("resetZoom", _chartId); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch { }
    }

    /// <summary>Downloads the chart as an SVG file.</summary>
    public async Task ExportSvgAsync()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("exportSvg", _chartId); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch { }
    }

    /// <summary>Downloads the chart as a PNG file.</summary>
    public async Task ExportPngAsync()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("exportPng", _chartId); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch { }
    }

    /// <summary>Retries loading after an error.</summary>
    public async Task RetryAsync()
    {
        _error = null; _ready = false;
        await InvokeAsync(StateHasChanged);
        await InitAsync();
    }

    // ── JS callbacks ──────────────────────────────────────────────────────────

    [JSInvokable]
    public async Task OnDataPointClickedAsync(SgD3ClickEventArgs args)
    {
        if (OnDataPointClick.HasDelegate)
            await OnDataPointClick.InvokeAsync(args);
    }

    // ── Dispose ───────────────────────────────────────────────────────────────

    public async ValueTask DisposeAsync()
    {
        if (_isDisposed) return;
        _isDisposed = true;

        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _chartId); }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException)   { }
            catch { }
        }

        var selfRef = _selfRef;
        _selfRef = null;
        selfRef?.Dispose();

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException)   { }
            catch { }
            _module = null;
        }
    }
}
