@namespace SuperUI.Components
@implements IDisposable

<button type="button"
        class="sgc-fab @VariantClass @SizeClass @(Extended ? "sgc-fab-extended" : "") @CssClass"
        style="@Style"
        disabled="@(Disabled || Loading)"
        title="@Title"
        aria-label="@(AriaLabel ?? Title ?? Label)"
        @onclick="OnClickAsync"
        @attributes="AdditionalAttributes">
    @if (Loading)
    {
        <span class="sgc-spinner" style="width:18px;height:18px;border-width:2px;border-color:#fff;border-top-color:transparent;"></span>
    }
    else if (!string.IsNullOrEmpty(Icon))
    {
        <span class="sgc-fab-icon">@((MarkupString)Icon)</span>
    }
    @if (Extended && !string.IsNullOrEmpty(Label))
    {
        <span class="sgc-fab-label">@Label</span>
    }
</button>

@code {
    private bool _disposed;

    /// <summary>SVG icon markup.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Label shown when <see cref="Extended"/> is true.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Tooltip text.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Explicit aria-label.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>When true, shows label next to icon (pill shape). Default false.</summary>
    [Parameter] public bool Extended { get; set; }

    /// <summary>Visual variant. Default is <see cref="SgButtonVariant.Primary"/>.</summary>
    [Parameter] public SgButtonVariant Variant { get; set; } = SgButtonVariant.Primary;

    /// <summary>Size. Default is <see cref="SgSize.Md"/>.</summary>
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;

    /// <summary>When true, the button is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>When true, shows a loading spinner.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>Additional CSS class.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Inline style.</summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>Click callback.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string VariantClass => Variant switch
    {
        SgButtonVariant.Danger  => "sgc-fab-danger",
        SgButtonVariant.Success => "sgc-fab-success",
        SgButtonVariant.Ghost   => "sgc-fab-ghost",
        _                       => "sgc-fab-primary"
    };

    private string SizeClass => Size switch
    {
        SgSize.Sm => "sgc-fab-sm",
        SgSize.Lg => "sgc-fab-lg",
        _         => ""
    };

    private async Task OnClickAsync(MouseEventArgs e)
    {
        if (Disabled || Loading) return;
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(e);
    }

    public void Dispose() => _disposed = true;
}
