@namespace SuperUI.Components

<div class="sgc-desc @(Bordered ? "sgc-bordered" : "") @CssClass">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="sgc-desc-title">@Title</div>
    }
    <div class="sgc-desc-grid" style="--sgc-desc-cols:@Columns;">
        @foreach (var it in Items ?? Array.Empty<DescriptionItem>())
        {
            <div class="sgc-desc-row">
                <div class="sgc-desc-label">@it.Label</div>
                <div class="sgc-desc-value">@it.Value</div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    /// <summary>Collection of label-value pairs to display in the description list.</summary>
    [Parameter] public IEnumerable<DescriptionItem> Items { get; set; } = Array.Empty<DescriptionItem>();
    /// <summary>Number of grid columns. Default is 2.</summary>
    [Parameter] public int Columns { get; set; } = 2;
    /// <summary>Whether to show a border around the description list. Default is true.</summary>
    [Parameter] public bool Bordered { get; set; } = true;
    /// <summary>Additional CSS classes for the root element.</summary>
    [Parameter] public string? CssClass { get; set; }
}
