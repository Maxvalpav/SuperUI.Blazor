@namespace SuperUI.Components
@using Microsoft.AspNetCore.Components.Web
@using SuperUI.Enums

<div @ref="_containerRef"
     class="sgc-timeline sgc-timeline-@ModeClass @(Reverse ? "sgc-timeline-reverse" : "") @(Animation ? "sgc-timeline-animated" : "") @DotSizeClass @LineStyleClass @DensityClass @DotShapeClass @(GradientTail ? "sgc-tl-gradient-tail" : "") @CssClass"
     style="@Style"
     role="list"
     aria-label="@(AriaLabel ?? "Timeline")">

    @_renderContent

    @if (Pending is not null)
    {
        @RenderPending(Pending)
    }

    @if (ChildContent is not null)
    {
        @ChildContent
    }
</div>

@code {
    private string ModeClass => Mode switch
    {
        SgTimelineMode.Right => "right",
        SgTimelineMode.Alternate => "alternate",
        SgTimelineMode.AlternateReverse => "alternate",
        SgTimelineMode.Horizontal => "horizontal",
        _ => "left"
    };

    private RenderFragment? _renderContent;

    private RenderFragment RenderPending(TimelineItem pending) => __builder =>
    {
        var isGrouped = _groups.Count > 0;
        <div class="sgc-timeline-item sgc-timeline-item-pending" role="listitem" aria-label="@(pending.Title ?? PendingLabel ?? "Pending")">
            @if (!isGrouped && (Mode == SgTimelineMode.Alternate || Mode == SgTimelineMode.AlternateReverse))
            {
                <div class="sgc-timeline-item-time sgc-timeline-item-time-left">
                    @if (!string.IsNullOrEmpty(pending.Time)) { <span>@pending.Time</span> }
                </div>
            }
            <div class="sgc-timeline-item-axis" aria-hidden="true">
                <div class="sgc-timeline-item-dot sgc-timeline-item-dot-pending sgc-timeline-item-dot-ghost"
                     style="@GetDotStyle(pending)">
                    @if (pending.DotContent is not null) { @pending.DotContent }
                    else if (pending.Icon is not null) { <span class="sgc-timeline-item-icon">@pending.Icon</span> }
                </div>
            </div>
            <div class="sgc-timeline-item-content">
                @if (!isGrouped && Mode != SgTimelineMode.Alternate && Mode != SgTimelineMode.AlternateReverse && !string.IsNullOrEmpty(pending.Time))
                {
                    <div class="sgc-timeline-item-time">@pending.Time</div>
                }
                @if (!string.IsNullOrEmpty(pending.Title))
                {
                    <div class="sgc-timeline-item-title sgc-tl-pending-text">@pending.Title</div>
                }
                @if (!string.IsNullOrEmpty(pending.Description))
                {
                    <div class="sgc-timeline-item-description">@pending.Description</div>
                }
            </div>
        </div>;
    };

    private async Task HandleItemKeyDownAsync(KeyboardEventArgs e, TimelineItem item)
    {
        if (!IsItemClickable(item)) return;
        if (e.Key is "Enter" or " ")
            await HandleItemClickAsync(item);
    }

    private void ToggleCollapse(TimelineItem item)
    {
        if (!item.Collapsible) return;
        item.Collapsed = !item.Collapsed;
        StateHasChanged();
    }

    private string? GetTailStyle(TimelineItem item)
    {
        if (!GradientTail) return null;
        var color = item.Color ?? Color;
        if (string.IsNullOrEmpty(color)) return null;
        return $"--sgc-tl-tail-color:{color};";
    }
}