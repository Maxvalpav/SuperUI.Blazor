@namespace SuperUI.Components

<div class="sgc-timeline @(Reverse ? "sgc-timeline-reverse" : "") sgc-timeline-@Mode.ToString().ToLowerInvariant() @CssClass" style="@Style">
    @if (_items.Count == 0)
    {
        <div class="sgc-timeline-empty">@EmptyText</div>
    }
    else if (Virtualize)
    {
        <SgVirtualList TItem="TimelineItem" Items="_items" Height="@Height" ItemHeight="72">
            <ChildContent>
                @RenderItem(context)
            </ChildContent>
        </SgVirtualList>
    }
    else
    {
        @for (var i = 0; i < _items.Count; i++)
        {
            var item = _items[i];
            var last = i == _items.Count - 1;
            @RenderItem(item, last)
        }
    }
    @ChildContent
</div>

@code {
    private RenderFragment RenderItem(TimelineItem item, bool isLast = false) =>
        @<div class="sgc-timeline-item @(isLast ? "sgc-timeline-item-last" : "")">
            @if (Mode == SgTimelineMode.Alternate)
            {
                <div class="sgc-timeline-item-time sgc-timeline-item-time-left">
                    @if (!string.IsNullOrEmpty(item.Time)) { <span>@item.Time</span> }
                </div>
            }
            <div class="sgc-timeline-item-axis">
                <div class="sgc-timeline-item-dot sgc-timeline-item-dot-@item.Status"
                     style="@GetDotStyle(item)">
                    @if (item.DotContent is not null)
                    {
                        @item.DotContent
                    }
                    else if (item.Icon is not null)
                    {
                        <span class="sgc-timeline-item-icon" aria-hidden="true">@item.Icon</span>
                    }
                </div>
                @if (!isLast)
                {
                    <div class="sgc-timeline-item-tail"></div>
                }
            </div>
            <div class="sgc-timeline-item-content">
                @if (Mode != SgTimelineMode.Alternate && !string.IsNullOrEmpty(item.Time))
                {
                    <div class="sgc-timeline-item-time">@item.Time</div>
                }
                @if (!string.IsNullOrEmpty(item.Title))
                {
                    <div class="sgc-timeline-item-title">@item.Title</div>
                }
                @if (!string.IsNullOrEmpty(item.Description))
                {
                    <div class="sgc-timeline-item-description">@item.Description</div>
                }
                @if (item.ExtraContent is not null)
                {
                    <div class="sgc-timeline-item-extra">@item.ExtraContent</div>
                }
            </div>
        </div>;
}
