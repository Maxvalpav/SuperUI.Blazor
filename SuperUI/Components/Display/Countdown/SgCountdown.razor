@namespace SuperUI.Components
@implements IDisposable

<div class="sgc-countdown @CssClass @SizeClass @FinishedClass"
     style="@Style"
     role="timer"
     aria-live="polite"
     aria-label="@AriaLabel"
     @attributes="AdditionalAttributes">

    @if (ShowLabels)
    {
        <div class="sgc-cd-blocks">
            @if (ShowDays && (TimeLeft.Days > 0 || AlwaysShowDays))
            {
                <div class="sgc-cd-block">
                    <div class="sgc-cd-value @(Animated ? "sgc-cd-value-animated" : "")">@FormatValue(TimeLeft.Days)</div>
                    <div class="sgc-cd-label">@Localizer["Common_Days"]</div>
                </div>
                @if (ShowSeparators) { <div class="sgc-cd-separator @SeparatorClass">:</div> }
            }

            @if (ShowHours)
            {
                <div class="sgc-cd-block">
                    <div class="sgc-cd-value @(Animated ? "sgc-cd-value-animated" : "")">@FormatValue(TimeLeft.Hours)</div>
                    <div class="sgc-cd-label">@Localizer["Common_Hours"]</div>
                </div>
                @if (ShowSeparators) { <div class="sgc-cd-separator @SeparatorClass">:</div> }
            }

            @if (ShowMinutes)
            {
                <div class="sgc-cd-block">
                    <div class="sgc-cd-value @(Animated ? "sgc-cd-value-animated" : "")">@FormatValue(TimeLeft.Minutes)</div>
                    <div class="sgc-cd-label">@Localizer["Common_Minutes"]</div>
                </div>
                @if (ShowSeparators && ShowSeconds) { <div class="sgc-cd-separator @SeparatorClass">:</div> }
            }

            @if (ShowSeconds)
            {
                <div class="sgc-cd-block">
                    <div class="sgc-cd-value @(Animated ? "sgc-cd-value-animated" : "")">@FormatValue(TimeLeft.Seconds)</div>
                    <div class="sgc-cd-label">@Localizer["Common_Seconds"]</div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="sgc-cd-text">
            @if (ShowDays && (TimeLeft.Days > 0 || AlwaysShowDays))
            {
                <span class="sgc-cd-text-unit">@TimeLeft.Days<span class="sgc-cd-text-sep">:</span></span>
            }
            @if (ShowHours)
            {
                <span class="sgc-cd-text-unit">@FormatValue(TimeLeft.Hours)<span class="sgc-cd-text-sep">:</span></span>
            }
            @if (ShowMinutes)
            {
                <span class="sgc-cd-text-unit">@FormatValue(TimeLeft.Minutes)<span class="sgc-cd-text-sep">:</span></span>
            }
            @if (ShowSeconds)
            {
                <span class="sgc-cd-text-unit">@FormatValue(TimeLeft.Seconds)</span>
            }
        </div>
    }

    @if (ShowProgress && !IsFinished)
    {
        <div class="sgc-cd-progress-track">
            <div class="sgc-cd-progress-fill" style="width: @((Progress * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
        </div>
    }

    @if (IsFinished && !string.IsNullOrEmpty(FinishedMessage))
    {
        <div class="sgc-cd-finished">@FinishedMessage</div>
    }
</div>
