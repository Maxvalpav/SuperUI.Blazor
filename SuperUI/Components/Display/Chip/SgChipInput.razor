@namespace SuperUI.Components
@using System.Globalization
@inherits SgComponentBase

<div class="@Css("sgc-chip-input").Build()"
     @attributes="AttributesWithoutClassAndStyle"
     role="listbox"
     aria-label="@(AriaLabel ?? "Chip input")">

    @foreach (var item in Items)
    {
        <SgChip Text="@GetItemText(item)"
                Value="@GetItemValue(item)"
                Variant="@Variant"
                Size="@Size"
                Closable="!Disabled"
                Disabled="@Disabled"
                OnClose="@(() => RemoveItem(item))" />
    }

    @if (!Disabled && (!MaxItems.HasValue || Items.Count < MaxItems.Value))
    {
        <div class="sgc-chip-input-field" role="presentation">
            <input type="text"
                   class="sgc-chip-input-inner"
                   value="@_inputValue"
                   @oninput="OnInputAsync"
                   @onkeydown="HandleKeyDown"
                   @onfocus="OnFocusAsync"
                   @onblur="OnBlurAsync"
                   placeholder="@Placeholder"
                   disabled="@(MaxItems.HasValue && Items.Count >= MaxItems.Value)"
                   aria-label="Type to add chip" />

            @if (ShowSuggestions && _suggestions is not null && _suggestions.Any() && _showDropdown)
            {
                <div class="sgc-chip-input-suggestions" role="listbox" aria-label="Suggestions">
                    @foreach (var s in _suggestions)
                    {
                        <button type="button"
                                class="sgc-chip-input-suggestion @(s == _highlightedSuggestion ? "sgc-highlighted" : "")"
                                role="option"
                                aria-selected="@(s == _highlightedSuggestion ? "true" : "false")"
                                @onclick="() => SelectSuggestionAsync(s)"
                                @onmouseenter="() => _highlightedSuggestion = s">
                            @GetItemText(s)
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    /// <summary>List of items (strings or objects with string representation).</summary>
    [Parameter] public List<string> Items { get; set; } = new();

    /// <summary>Callback when the item list changes.</summary>
    [Parameter] public EventCallback<List<string>> ItemsChanged { get; set; }

    /// <summary>Placeholder text for the input.</summary>
    [Parameter] public string? Placeholder { get; set; } = "Type and press Enter...";

    /// <summary>Variant applied to all chips.</summary>
    [Parameter] public SgChipVariant Variant { get; set; } = SgChipVariant.Primary;

    /// <summary>Size applied to all chips.</summary>
    [Parameter] public SgSize Size { get; set; } = SgSize.Sm;

    /// <summary>Maximum number of chips allowed.</summary>
    [Parameter] public int? MaxItems { get; set; }

    /// <summary>Whether duplicate items are allowed.</summary>
    [Parameter] public bool AllowDuplicates { get; set; }

    /// <summary>Whether the input is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Suggestions list for autocomplete.</summary>
    [Parameter] public List<string>? Suggestions { get; set; }

    /// <summary>Whether to show the suggestions dropdown.</summary>
    [Parameter] public bool ShowSuggestions { get; set; }

    /// <summary>Accessibility label.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Custom function to get display text from an item.</summary>
    [Parameter] public Func<string, string>? ItemText { get; set; }

    /// <summary>Custom function to get unique value from an item.</summary>
    [Parameter] public Func<string, string>? ItemValue { get; set; }

    private string _inputValue = "";
    private List<string>? _filteredSuggestions;
    private string _highlightedSuggestion = "";
    private bool _showDropdown;

    private List<string>? _suggestions
    {
        get
        {
            if (!ShowSuggestions || Suggestions is null) return null;
            if (string.IsNullOrEmpty(_inputValue)) return Suggestions.Take(10).ToList();
            return Suggestions
                .Where(s => s.StartsWith(_inputValue, StringComparison.OrdinalIgnoreCase))
                .Take(10)
                .ToList();
        }
    }

    private string GetItemText(string item) => ItemText?.Invoke(item) ?? item;
    private string GetItemValue(string item) => ItemValue?.Invoke(item) ?? item;

    private async Task OnInputAsync(ChangeEventArgs e)
    {
        _inputValue = e.Value?.ToString() ?? "";
        _showDropdown = true;
        _highlightedSuggestion = _suggestions?.FirstOrDefault() ?? "";
        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_inputValue))
        {
            var value = _inputValue.Trim();
            if (_showDropdown && !string.IsNullOrEmpty(_highlightedSuggestion)
                && _suggestions?.Contains(_highlightedSuggestion) == true)
            {
                value = _highlightedSuggestion;
            }
            await AddItemAsync(value);
        }
        else if (e.Key == "Backspace" && string.IsNullOrEmpty(_inputValue) && Items.Any())
        {
            await RemoveItemAsync(Items[^1]);
        }
        else if (e.Key == "ArrowDown" && _suggestions?.Any() == true)
        {
            var idx = _suggestions.IndexOf(_highlightedSuggestion);
            _highlightedSuggestion = _suggestions[Math.Min(idx + 1, _suggestions.Count - 1)];
            StateHasChanged();
        }
        else if (e.Key == "ArrowUp" && _suggestions?.Any() == true)
        {
            var idx = _suggestions.IndexOf(_highlightedSuggestion);
            _highlightedSuggestion = _suggestions[Math.Max(idx - 1, 0)];
            StateHasChanged();
        }
        else if (e.Key == "Escape")
        {
            _showDropdown = false;
            StateHasChanged();
        }
    }

    private async Task AddItemAsync(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        if (!AllowDuplicates && Items.Contains(value)) return;
        if (MaxItems.HasValue && Items.Count >= MaxItems.Value) return;
        Items.Add(value);
        _inputValue = "";
        _showDropdown = false;
        _highlightedSuggestion = "";
        if (ItemsChanged.HasDelegate)
            await ItemsChanged.InvokeAsync(Items);
    }

    private async Task RemoveItem(string item)
    {
        if (Disabled) return;
        await RemoveItemAsync(item);
    }

    private async Task RemoveItemAsync(string item)
    {
        Items.Remove(item);
        if (ItemsChanged.HasDelegate)
            await ItemsChanged.InvokeAsync(Items);
    }

    private async Task SelectSuggestionAsync(string suggestion)
    {
        _inputValue = suggestion;
        _showDropdown = false;
        await AddItemAsync(suggestion);
    }

    private async Task OnFocusAsync(FocusEventArgs e)
    {
        _showDropdown = true;
    }

    private async Task OnBlurAsync(FocusEventArgs e)
    {
        // Delay to allow click on suggestion
        await Task.Delay(150);
        _showDropdown = false;
        StateHasChanged();
    }
}
