@namespace SuperUI.Components
@inject ISuperUILocalizer Localizer

@if (!string.IsNullOrEmpty(Href) && !Disabled)
{
    <a class="@RootClasses"
       style="@BuildStyle()"
       href="@Href"
       target="@Target"
       rel="@Rel"
       aria-label="@(AriaLabel ?? Text)"
       aria-busy="@(Loading ? "true" : null)"
       draggable="@(Draggable ? "true" : null)"
       title="@(Disabled && !string.IsNullOrEmpty(DisabledTooltip) ? DisabledTooltip : null)"
       @ondragstart="HandleDragStartAsync"
       @ondragend="HandleDragEndAsync"
       @onclick="HandleClickAsync"
       @attributes="AdditionalAttributes">
        @ChipBody
    </a>
}
else
{
    <span class="@RootClasses"
          style="@BuildStyle()"
          role="@Role"
          tabindex="@(Interactive ? "0" : null)"
          aria-pressed="@AriaPressed"
          aria-disabled="@(Disabled ? "true" : null)"
          aria-label="@(AriaLabel ?? Text)"
          aria-busy="@(Loading ? "true" : null)"
          draggable="@(Draggable ? "true" : null)"
          title="@(Disabled && !string.IsNullOrEmpty(DisabledTooltip) ? DisabledTooltip : null)"
          @ondragstart="HandleDragStartAsync"
          @ondragend="HandleDragEndAsync"
          @onclick="HandleClickAsync"
          @onkeydown="HandleKeyDownAsync"
          @attributes="AdditionalAttributes">
        @ChipBody
    </span>
}

@code {
    private RenderFragment ChipBody => __builder =>
    {
        @if (DragHandle)
        {
            <span class="sgc-chip-drag-handle" aria-hidden="true">
                <svg viewBox="0 0 12 12" fill="currentColor">
                    <circle cx="3" cy="2" r="1.2"/>
                    <circle cx="9" cy="2" r="1.2"/>
                    <circle cx="3" cy="6" r="1.2"/>
                    <circle cx="9" cy="6" r="1.2"/>
                    <circle cx="3" cy="10" r="1.2"/>
                    <circle cx="9" cy="10" r="1.2"/>
                </svg>
            </span>
        }

        @if (Loading)
        {
            <span class="sgc-chip-spinner" aria-hidden="true"></span>
        }
        else if (Selected && ShowCheck)
        {
            <span class="sgc-chip-check" aria-hidden="true">
                <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="2.5,6.5 5,9 9.5,3.5"/>
                </svg>
            </span>
        }
        else if (Avatar is not null)
        {
            <span class="sgc-chip-avatar" aria-hidden="true">@Avatar</span>
        }
        else if (Dot)
        {
            <span class="sgc-chip-dot" aria-hidden="true"></span>
        }
        else if (LeadingContent is not null)
        {
            <span class="sgc-chip-leading" aria-hidden="true">@LeadingContent</span>
        }
        else if (Icon is not null)
        {
            <span class="sgc-chip-icon" aria-hidden="true">@Icon</span>
        }
        else if (!string.IsNullOrEmpty(LeadingIcon))
        {
            <span class="sgc-chip-leading" aria-hidden="true">@((MarkupString)LeadingIcon)</span>
        }

        <span class="sgc-chip-text">@ChildContent@Text</span>

        @if (Count.HasValue && !Loading)
        {
            <span class="sgc-chip-count" aria-label="@Count">@(Count.Value > MaxCount ? $"{MaxCount}+" : Count.Value.ToString())</span>
        }
        else if (TrailingContent is not null && !Loading)
        {
            <span class="sgc-chip-trailing" aria-hidden="true">@TrailingContent</span>
        }
        else if (!string.IsNullOrEmpty(TrailingIcon) && !Loading)
        {
            <span class="sgc-chip-trailing" aria-hidden="true">@((MarkupString)TrailingIcon)</span>
        }

        @if ((Closable || Removable) && !Loading && !Disabled && !_isRemoving)
        {
            <button type="button"
                    class="sgc-chip-x"
                    tabindex="-1"
                    aria-label="@Localizer.GetString("RemoveItem", Text ?? Localizer["Item"])"
                    @onclick:stopPropagation="true"
                    @onclick="HandleRemoveAsync">
                <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="2" y1="2" x2="10" y2="10"/>
                    <line x1="10" y1="2" x2="2" y2="10"/>
                </svg>
            </button>
        }
    };

    // ── Group cascading ────────────────────────────────────────────────────────

    /// <summary>Chip group context received from parent <see cref="SgChipGroup"/>.</summary>
    [CascadingParameter] public SgChipGroup? ChipGroup { get; set; }

    // ── State fields ───────────────────────────────────────────────────────────

    private bool _isRemoving;
    private bool _isDragging;

    // ── Parameters ─────────────────────────────────────────────────────────────

    /// <summary>Accessibility label for screen readers.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Chip text content.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Custom content inside the chip. Takes precedence over <see cref="Text"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Icon rendered before the text (RenderFragment). Takes precedence over <see cref="LeadingIcon"/>.</summary>
    [Parameter] public RenderFragment? Icon { get; set; }

    /// <summary>Avatar rendered before the text (replaces <see cref="Icon"/>).</summary>
    [Parameter] public RenderFragment? Avatar { get; set; }

    /// <summary>Leading content. Takes precedence over <see cref="Icon"/>.</summary>
    [Parameter] public RenderFragment? LeadingContent { get; set; }

    /// <summary>Trailing content rendered after the text.</summary>
    [Parameter] public RenderFragment? TrailingContent { get; set; }

    /// <summary>SVG markup string for a leading icon. Simpler alternative to <see cref="Icon"/>. Ignored if <see cref="Icon"/> is set.</summary>
    [Parameter] public string? LeadingIcon { get; set; }

    /// <summary>SVG markup string for a trailing icon. Ignored if <see cref="TrailingContent"/> is set.</summary>
    [Parameter] public string? TrailingIcon { get; set; }

    /// <summary>Renders a small status dot before the text.</summary>
    [Parameter] public bool Dot { get; set; }

    /// <summary>Numeric count badge rendered after the text.</summary>
    [Parameter] public int? Count { get; set; }

    /// <summary>Maximum count before showing "Max+". Default 99.</summary>
    [Parameter] public int MaxCount { get; set; } = 99;

    /// <summary>Outlined visual style.</summary>
    [Parameter] public bool Outlined { get; set; }

    /// <summary>Visual variant. Default <see cref="SgChipVariant.Default"/>. Overridden by parent <see cref="SgChipGroup"/>.</summary>
    [Parameter] public SgChipVariant? Variant { get; set; }

    /// <summary>Chip size. Default <see cref="SgSize.Md"/>. Overridden by parent <see cref="SgChipGroup"/>.</summary>
    [Parameter] public SgSize? Size { get; set; }

    /// <summary>Renders a close button (immediate removal).</summary>
    [Parameter] public bool Closable { get; set; }

    /// <summary>Renders a close button with a fade-out animation before invoking <see cref="OnClose"/>.</summary>
    [Parameter] public bool Removable { get; set; }

    /// <summary>Shows a drag handle (⠿ grid) on the left side of the chip.</summary>
    [Parameter] public bool DragHandle { get; set; }

    /// <summary>Makes the chip draggable (adds draggable="true" and drag events).</summary>
    [Parameter] public bool Draggable { get; set; }

    /// <summary>When true and no explicit <see cref="Color"/> is set, generates a deterministic HSL color from the <see cref="Text"/> hash.</summary>
    [Parameter] public bool ColorFromText { get; set; }

    /// <summary>Tooltip text shown via native title attribute when the chip is <see cref="Disabled"/>.</summary>
    [Parameter] public string? DisabledTooltip { get; set; }

    /// <summary>Makes the chip activatable (button-like).</summary>
    [Parameter] public bool Clickable { get; set; }

    /// <summary>
    /// Two-way bindable selected state. When set, the chip behaves as a toggle (filter chip).
    /// Setting this implicitly enables interaction.
    /// </summary>
    [Parameter] public bool Selected { get; set; }

    /// <summary>Selected state changed callback (for two-way binding).</summary>
    [Parameter] public EventCallback<bool> SelectedChanged { get; set; }

    /// <summary>Marks the chip as a toggle even without an initial selected state (renders selectable affordances).</summary>
    [Parameter] public bool Selectable { get; set; }

    /// <summary>When the chip is selected, shows a check icon in the leading slot. Default true for toggles.</summary>
    [Parameter] public bool ShowCheck { get; set; } = true;

    /// <summary>Disables interactions and lowers opacity.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Shows a spinner and disables interactions.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>Renders the chip as an anchor with the given href.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Anchor target attribute (used with <see cref="Href"/>).</summary>
    [Parameter] public string? Target { get; set; }

    /// <summary>Anchor rel attribute (used with <see cref="Href"/>).</summary>
    [Parameter] public string? Rel { get; set; }

    /// <summary>Custom background color.</summary>
    [Parameter] public string? Color { get; set; }

    /// <summary>Custom text color.</summary>
    [Parameter] public string? TextColor { get; set; }

    /// <summary>Callback invoked when the close button is clicked.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Callback invoked when the chip is clicked.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>Additional CSS classes.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Inline CSS styles.</summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>Additional HTML attributes for the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // ── Internals ────────────────────────────────────────────────────────────

    private SgSize EffectiveSize => Size ?? ChipGroup?.Size ?? SgSize.Md;

    private SgChipVariant EffectiveVariant => Variant ?? ChipGroup?.Variant ?? SgChipVariant.Default;

    private bool Interactive => (Clickable || Selectable || SelectedChanged.HasDelegate) && !Disabled;

    private string Role => !string.IsNullOrEmpty(Href) ? "" :
        (SelectedChanged.HasDelegate || Selectable) ? "switch" :
        Clickable ? "button" : "";

    private string? AriaPressed => (Selectable || SelectedChanged.HasDelegate)
        ? (Selected ? "true" : "false")
        : null;

    private string? ComputedColor => !string.IsNullOrEmpty(Color) ? Color :
        (ColorFromText && !string.IsNullOrEmpty(Text) ? HashToHsl(Text) : null);

    private string SizeClass => EffectiveSize switch
    {
        SgSize.Sm => "sgc-chip-sm",
        SgSize.Lg => "sgc-chip-lg",
        SgSize.Xl => "sgc-chip-xl",
        _         => ""
    };

    private string VariantClass => EffectiveVariant switch
    {
        SgChipVariant.Primary => "sgc-primary",
        SgChipVariant.Success => "sgc-success",
        SgChipVariant.Danger  => "sgc-danger",
        SgChipVariant.Warn    => "sgc-warn",
        SgChipVariant.Info    => "sgc-info",
        _                     => ""
    };

    private string RootClasses
    {
        get
        {
            var sb = new System.Text.StringBuilder("sgc-chip ");
            if (!string.IsNullOrEmpty(VariantClass)) sb.Append(VariantClass).Append(' ');
            if (!string.IsNullOrEmpty(SizeClass))    sb.Append(SizeClass).Append(' ');
            if (Outlined)               sb.Append("sgc-outlined ");
            if (Closable || Removable)  sb.Append("sgc-closable ");
            if (Loading)                sb.Append("sgc-chip-loading ");
            if (Interactive)            sb.Append("sgc-chip-clickable ");
            if (Selected)               sb.Append("sgc-chip-selected ");
            if (Disabled)               sb.Append("sgc-chip-disabled ");
            if (Draggable)              sb.Append("sgc-chip-draggable ");
            if (_isDragging)            sb.Append("sgc-chip-dragging ");
            if (_isRemoving)            sb.Append("sgc-chip-removing ");
            if (!string.IsNullOrEmpty(CssClass)) sb.Append(CssClass);
            return sb.ToString().TrimEnd();
        }
    }

    private string BuildStyle()
    {
        var sb = new System.Text.StringBuilder();
        var bgColor = ComputedColor;
        if (!string.IsNullOrEmpty(bgColor))    sb.Append("background:").Append(bgColor).Append(';');
        if (!string.IsNullOrEmpty(TextColor))  sb.Append("color:").Append(TextColor).Append(';');
        if (!string.IsNullOrEmpty(Style))      sb.Append(Style);
        return sb.ToString();
    }

    private static string HashToHsl(string text)
    {
        int hash = 0;
        foreach (char c in text)
            hash += c;
        int hue = hash % 360;
        return $"hsl({hue}, 60%, 70%)";
    }

    private async Task HandleRemoveAsync()
    {
        if (Disabled || Loading || _isRemoving) return;
        if (Removable)
        {
            _isRemoving = true;
            StateHasChanged();
            await Task.Delay(300);
        }
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }

    private async Task HandleDragStartAsync(DragEventArgs e)
    {
        if (!Draggable) return;
        _isDragging = true;
        StateHasChanged();
    }

    private async Task HandleDragEndAsync(DragEventArgs e)
    {
        if (!Draggable) return;
        _isDragging = false;
        StateHasChanged();
    }

    private async Task HandleClickAsync(MouseEventArgs e)
    {
        if (Disabled || Loading || _isRemoving) return;
        if (Selectable || SelectedChanged.HasDelegate)
        {
            Selected = !Selected;
            if (SelectedChanged.HasDelegate) await SelectedChanged.InvokeAsync(Selected);
        }
        if (OnClick.HasDelegate) await OnClick.InvokeAsync(e);
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (!Interactive) return;
        if (e.Key is "Enter" or " ") await HandleClickAsync(new MouseEventArgs());
        else if ((e.Key is "Delete" or "Backspace") && (Closable || Removable)) await HandleRemoveAsync();
    }

}
