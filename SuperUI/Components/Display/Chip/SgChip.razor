@namespace SuperUI.Components
@inject ISuperUILocalizer Localizer
@inject IJSRuntime JS

@if (!string.IsNullOrEmpty(Href) && !Disabled)
{
    <a class="@RootClasses"
       style="@BuildStyle()"
       href="@Href"
       target="@Target"
       rel="@Rel"
       aria-label="@(AriaLabel ?? Text)"
       aria-busy="@(Loading ? "true" : null)"
       draggable="@(Draggable ? "true" : null)"
        title="@ComputeTitle()"
        @ondragstart="HandleDragStartAsync"
        @ondragend="HandleDragEndAsync"
        @onclick="HandleClickAsync"
        @attributes="AdditionalAttributes">
        @if (Ripple) { <span class="sgc-chip-ripple"></span> }
        @ChipBody
    </a>
}
else
{
    <span class="@RootClasses"
          style="@BuildStyle()"
          role="@Role"
          tabindex="@(Interactive ? "0" : null)"
          aria-pressed="@AriaPressed"
          aria-disabled="@(Disabled ? "true" : null)"
          aria-label="@(AriaLabel ?? Text)"
          aria-busy="@(Loading ? "true" : null)"
          draggable="@(Draggable ? "true" : null)"
           title="@ComputeTitle()"
           @ondragstart="HandleDragStartAsync"
           @ondragend="HandleDragEndAsync"
           @onclick="HandleClickAsync"
           @onkeydown="HandleKeyDownAsync"
           @attributes="AdditionalAttributes">
        @if (Ripple) { <span class="sgc-chip-ripple"></span> }
        @ChipBody
    </span>
}

@code {
    private RenderFragment ChipBody => __builder =>
    {
        @if (DragHandle)
        {
            <span class="sgc-chip-drag-handle" aria-hidden="true">
                <svg viewBox="0 0 12 12" fill="currentColor">
                    <circle cx="3" cy="2" r="1.2"/><circle cx="9" cy="2" r="1.2"/>
                    <circle cx="3" cy="6" r="1.2"/><circle cx="9" cy="6" r="1.2"/>
                    <circle cx="3" cy="10" r="1.2"/><circle cx="9" cy="10" r="1.2"/>
                </svg>
            </span>
        }

        @if (Loading)
        {
            <span class="sgc-chip-spinner" aria-hidden="true"></span>
        }
        else if (Skeleton)
        {
            <span class="sgc-chip-skeleton" aria-hidden="true"></span>
        }
        else if ((ChipGroup is not null ? GroupSelected : Selected) && ShowCheck)
        {
            <span class="sgc-chip-check" aria-hidden="true">
                <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="2.5,6.5 5,9 9.5,3.5"/>
                </svg>
            </span>
        }
        else if (Avatar is not null)
        {
            <span class="sgc-chip-avatar" aria-hidden="true">@Avatar</span>
        }
        else if (!string.IsNullOrEmpty(AvatarSrc))
        {
            <span class="sgc-chip-avatar" aria-hidden="true"><img src="@AvatarSrc" alt="" class="sgc-chip-avatar-img" /></span>
        }
        else if (Dot)
        {
            <span class="sgc-chip-dot" aria-hidden="true"></span>
        }
        else if (LeadingContent is not null)
        {
            <span class="sgc-chip-leading" aria-hidden="true">@LeadingContent</span>
        }
        else if (Icon is not null)
        {
            <span class="sgc-chip-icon" aria-hidden="true">@Icon</span>
        }
        else if (!string.IsNullOrEmpty(LeadingIcon))
        {
            <span class="sgc-chip-leading" aria-hidden="true">@((MarkupString)LeadingIcon)</span>
        }

        @if (Status is not null && Status.Value != SgChipStatus.None)
        {
            <span class="@StatusClass" aria-hidden="true"></span>
        }

        if (!Skeleton)
        {
            var textStyle = !string.IsNullOrEmpty(MaxWidth) ? $"max-width:{MaxWidth};" : (Truncate ? "max-width:120px;" : "");
            <span class="sgc-chip-text@(Truncate || !string.IsNullOrEmpty(MaxWidth) ? " sgc-chip-truncate" : "")" style="@textStyle">@ChildContent@Text</span>
        }

        @if (!Loading && !Skeleton)
        {
            if (Count.HasValue)
            {
                <span class="sgc-chip-count" aria-label="@Count">@(Count.Value > MaxCount ? $"{MaxCount}+" : Count.Value.ToString())</span>
            }
            else if (TrailingContent is not null)
            {
                <span class="sgc-chip-trailing" aria-hidden="true">@TrailingContent</span>
            }
            else if (!string.IsNullOrEmpty(TrailingIcon))
            {
                <span class="sgc-chip-trailing" aria-hidden="true">@((MarkupString)TrailingIcon)</span>
            }
        }

        @if ((Closable || Removable) && !Loading && !Disabled && !_isRemoving && !Skeleton)
        {
            <button type="button"
                    class="sgc-chip-x"
                    tabindex="-1"
                    aria-label="@Localizer.GetString("RemoveItem", Text ?? Localizer["Item"])"
                    @onclick:stopPropagation="true"
                    @onclick="HandleRemoveAsync">
                <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="2" y1="2" x2="10" y2="10"/>
                    <line x1="10" y1="2" x2="2" y2="10"/>
                </svg>
            </button>
        }
    };

    // ── Group cascading ────────────────────────────────────────────────────────
    [CascadingParameter] public SgChipGroup? ChipGroup { get; set; }
    [CascadingParameter(Name = "SgChipGroupSearch")] public string? GroupSearch { get; set; }

    // ── State fields ───────────────────────────────────────────────────────────
    private bool _isRemoving;
    private bool _isDragging;

    // ── Parameters ─────────────────────────────────────────────────────────────
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public RenderFragment? Avatar { get; set; }
    [Parameter] public RenderFragment? LeadingContent { get; set; }
    [Parameter] public RenderFragment? TrailingContent { get; set; }
    [Parameter] public string? LeadingIcon { get; set; }
    [Parameter] public string? TrailingIcon { get; set; }
    [Parameter] public bool Dot { get; set; }
    [Parameter] public int? Count { get; set; }
    [Parameter] public int MaxCount { get; set; } = 99;
    [Parameter] public bool Outlined { get; set; }
    [Parameter] public bool Pill { get; set; } = true;
    [Parameter] public SgChipVariant? Variant { get; set; }
    [Parameter] public SgSize? Size { get; set; }
    [Parameter] public bool Closable { get; set; }
    [Parameter] public bool Removable { get; set; }
    [Parameter] public bool DragHandle { get; set; }
    [Parameter] public bool Draggable { get; set; }
    [Parameter] public bool ColorFromText { get; set; }
    [Parameter] public string? DisabledTooltip { get; set; }
    [Parameter] public bool Clickable { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback<bool> SelectedChanged { get; set; }
    [Parameter] public bool Selectable { get; set; }
    [Parameter] public bool ShowCheck { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Skeleton { get; set; }
    [Parameter] public bool Pulse { get; set; }
    [Parameter] public bool Glow { get; set; }
    [Parameter] public bool Gradient { get; set; }
    [Parameter] public bool Shadow { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Target { get; set; }
    [Parameter] public string? Rel { get; set; }
    [Parameter] public string? Color { get; set; }
    [Parameter] public string? TextColor { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // ── New Feature Parameters ─────────────────────────────────────────
    [Parameter] public string? AvatarSrc { get; set; }
    [Parameter] public string? MaxWidth { get; set; }
    [Parameter] public bool Truncate { get; set; }
    [Parameter] public string? Tooltip { get; set; }
    [Parameter] public SgEntranceAnimation? Entrance { get; set; }
    [Parameter] public bool Ripple { get; set; }
    [Parameter] public bool Glass { get; set; }
    [Parameter] public SgChipStatus? Status { get; set; }
    [Parameter] public bool Copyable { get; set; }
    [Parameter] public bool Neon { get; set; }
    [Parameter] public string? Value { get; set; }

    // ── Internals ────────────────────────────────────────────────────────────
    private SgSize EffectiveSize => Size ?? ChipGroup?.Size ?? SgSize.Md;
    private SgChipVariant EffectiveVariant => Variant ?? ChipGroup?.Variant ?? SgChipVariant.Default;
    private bool Interactive => (Clickable || Selectable || SelectedChanged.HasDelegate) && !Disabled;

    private string Role => !string.IsNullOrEmpty(Href) ? "" :
        (SelectedChanged.HasDelegate || Selectable) ? "switch" :
        Clickable ? "button" : "";

    private string? AriaPressed => (Selectable || SelectedChanged.HasDelegate)
        ? (Selected ? "true" : "false") : null;

    private string? ComputedColor => !string.IsNullOrEmpty(Color) ? Color :
        (ColorFromText && !string.IsNullOrEmpty(Text) ? HashToHsl(Text) : null);

    private bool GroupSelected => ChipGroup?.IsSelected(Value) ?? Selected;
    private bool GroupFilteredOut => !string.IsNullOrEmpty(GroupSearch)
        && !string.IsNullOrEmpty(Text)
        && !Text.Contains(GroupSearch, StringComparison.OrdinalIgnoreCase);

    private string? ComputeTitle()
    {
        if (Disabled && !string.IsNullOrEmpty(DisabledTooltip)) return DisabledTooltip;
        if (!string.IsNullOrEmpty(Tooltip)) return Tooltip;
        if (Truncate || !string.IsNullOrEmpty(MaxWidth)) return Text;
        return null;
    }

    private string? StatusClass => Status switch
    {
        SgChipStatus.Online => "sgc-chip-status sgc-chip-status-online",
        SgChipStatus.Offline => "sgc-chip-status sgc-chip-status-offline",
        SgChipStatus.Busy => "sgc-chip-status sgc-chip-status-busy",
        SgChipStatus.Away => "sgc-chip-status sgc-chip-status-away",
        _ => null
    };

    private string? EntranceClass => Entrance switch
    {
        SgEntranceAnimation.Fade => "sgc-entrance-fade",
        SgEntranceAnimation.SlideUp => "sgc-entrance-slide-up",
        SgEntranceAnimation.SlideDown => "sgc-entrance-slide-down",
        SgEntranceAnimation.SlideLeft => "sgc-entrance-slide-left",
        SgEntranceAnimation.SlideRight => "sgc-entrance-slide-right",
        SgEntranceAnimation.Scale => "sgc-entrance-scale",
        _ => null
    };

    private string SizeClass => EffectiveSize switch
    {
        SgSize.Sm => "sgc-chip-sm",
        SgSize.Lg => "sgc-chip-lg",
        SgSize.Xl => "sgc-chip-xl",
        _         => ""
    };

    private string VariantClass => EffectiveVariant switch
    {
        SgChipVariant.Primary => "sgc-primary",
        SgChipVariant.Success => "sgc-success",
        SgChipVariant.Danger  => "sgc-danger",
        SgChipVariant.Warn    => "sgc-warn",
        SgChipVariant.Info    => "sgc-info",
        _                     => ""
    };

    private string RootClasses
    {
        get
        {
            var sb = new System.Text.StringBuilder("sgc-chip ");
            if (!string.IsNullOrEmpty(VariantClass)) sb.Append(VariantClass).Append(' ');
            if (!string.IsNullOrEmpty(SizeClass))    sb.Append(SizeClass).Append(' ');
            if (Outlined)        sb.Append("sgc-outlined ");
            if (!Pill)           sb.Append("sgc-chip-square ");
            if (Closable || Removable) sb.Append("sgc-closable ");
            if (Loading)         sb.Append("sgc-chip-loading ");
            if (Skeleton)        sb.Append("sgc-chip-loading sgc-chip-skeleton-mode ");
            if (Interactive)     sb.Append("sgc-chip-clickable ");
            if (GroupSelected)   sb.Append("sgc-chip-selected ");
            if (GroupFilteredOut) sb.Append("sgc-chip-filtered-out ");
            if (Disabled)        sb.Append("sgc-chip-disabled ");
            if (Draggable)       sb.Append("sgc-chip-draggable ");
            if (_isDragging)     sb.Append("sgc-chip-dragging ");
            if (_isRemoving)     sb.Append("sgc-chip-removing ");
            if (Pulse)           sb.Append("sgc-chip-pulse ");
            if (Glow)            sb.Append("sgc-chip-glow ");
            if (Neon)            sb.Append("sgc-chip-neon ");
            if (Glass)           sb.Append("sgc-chip-glass ");
            if (Gradient && string.IsNullOrEmpty(ComputedColor)) sb.Append("sgc-chip-gradient ");
            if (Shadow)          sb.Append("sgc-chip-shadow ");
            if (Copyable)        sb.Append("sgc-chip-copyable ");
            if (!string.IsNullOrEmpty(EntranceClass)) sb.Append(EntranceClass).Append(' ');
            if (!string.IsNullOrEmpty(CssClass)) sb.Append(CssClass);
            return sb.ToString().TrimEnd();
        }
    }

    private string BuildStyle()
    {
        var sb = new System.Text.StringBuilder();
        var bgColor = ComputedColor;
        if (!string.IsNullOrEmpty(bgColor))
        {
            if (Gradient)
            {
                sb.Append("background:linear-gradient(135deg,").Append(bgColor)
                  .Append(",color-mix(in srgb,").Append(bgColor).Append(",white 35%));");
                sb.Append("border-color:").Append(bgColor).Append(';');
            }
            else
            {
                sb.Append("background:").Append(bgColor).Append(';');
                sb.Append("border-color:").Append(bgColor).Append(';');
            }
        }
        if (!string.IsNullOrEmpty(TextColor)) sb.Append("color:").Append(TextColor).Append(';');
        if (Glow && !string.IsNullOrEmpty(bgColor))
            sb.Append("--sgc-chip-glow-color:").Append(bgColor).Append(';');
        if (Neon && !string.IsNullOrEmpty(bgColor))
        {
            sb.Append("--sgc-chip-neon-color:").Append(bgColor).Append(';');
            sb.Append("box-shadow:0 0 6px ").Append(bgColor).Append(",0 0 20px ").Append(bgColor).Append(';');
        }
        if (!string.IsNullOrEmpty(Style)) sb.Append(Style);
        return sb.ToString();
    }

    private static string HashToHsl(string text)
    {
        int hash = 397;
        foreach (char c in text)
            hash = (hash * 31 + c) & 0x7FFFFFFF;
        int hue = hash % 360;
        int sat = 55 + (hash / 7) % 20;
        int lig = 60 + (hash / 13) % 15;
        return $"hsl({hue}, {sat}%, {lig}%)";
    }

    private async Task HandleRemoveAsync()
    {
        if (Disabled || Loading || _isRemoving) return;
        if (Removable)
        {
            _isRemoving = true;
            StateHasChanged();
            await Task.Delay(300);
        }
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }

    private async Task HandleDragStartAsync(DragEventArgs e)
    {
        if (!Draggable) return;
        _isDragging = true;
        StateHasChanged();
    }

    private async Task HandleDragEndAsync(DragEventArgs e)
    {
        if (!Draggable) return;
        _isDragging = false;
        StateHasChanged();
    }

    private async Task HandleClickAsync(MouseEventArgs e)
    {
        if (Disabled || Loading || _isRemoving) return;
        if (Copyable && !string.IsNullOrEmpty(Text))
        {
            try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", Text); }
            catch { /* clipboard unavailable */ }
        }
        if (Selectable || SelectedChanged.HasDelegate)
        {
            if (ChipGroup is not null && ChipGroup.Selectable && !ChipGroup.AllowMultiple)
            {
                Selected = true;
            }
            else
            {
                Selected = !Selected;
            }
            if (SelectedChanged.HasDelegate) await SelectedChanged.InvokeAsync(Selected);
            if (ChipGroup is not null && !string.IsNullOrEmpty(Value))
                ChipGroup.NotifyValueChanged(Value, Selected);
        }
        if (OnClick.HasDelegate) await OnClick.InvokeAsync(e);
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (!Interactive) return;
        if (e.Key is "Enter" or " ") await HandleClickAsync(new MouseEventArgs());
        else if ((e.Key is "Delete" or "Backspace") && (Closable || Removable)) await HandleRemoveAsync();
    }
}
