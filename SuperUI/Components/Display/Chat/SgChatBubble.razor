@namespace SuperUI.Components
@inherits SgComponentBase

<div class="@Css("sgc-chat-bubble").AddClass("sgc-chat-sent", Sent).AddClass("sgc-chat-received", !Sent).Build()"
     @attributes="AttributesWithoutClassAndStyle">
    <div class="sgc-chat-bubble-inner">
        @if (!string.IsNullOrEmpty(Sender))
        {
            <div class="sgc-chat-sender">@Sender</div>
        }
        <div class="sgc-chat-text">
            @ChildContent
        </div>
        @if (!string.IsNullOrEmpty(Time))
        {
            <div class="sgc-chat-time">@Time</div>
        }
    </div>
</div>

@code {
    /// <summary>
    /// Gets or sets whether the message was sent by the current user.
    /// </summary>
    [Parameter] public bool Sent { get; set; }

    /// <summary>
    /// Gets or sets the name of the sender.
    /// </summary>
    [Parameter] public string? Sender { get; set; }

    /// <summary>
    /// Gets or sets the time the message was sent.
    /// </summary>
    [Parameter] public string? Time { get; set; }

    /// <summary>
    /// Gets or sets the message content.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
