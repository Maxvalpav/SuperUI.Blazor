@namespace SuperUI.Components
@using SuperUI.Enums
@inject ISuperUILocalizer Localizer
@implements IDisposable

@if (ChildContent is not null && !Standalone)
{
    <span class="sgc-badge-wrap @(Block ? "sgc-badge-block" : "") @CssClass" style="@Style" @attributes="AdditionalAttributes">
        @ChildContent
        @if (!Hidden && !_hidden && !IsZero)
        {
            <span class="@WrapBadgeClasses"
                  style="@ComputedOffsetStyle"
                  role="status"
                  aria-label="@BadgeAriaLabel"
                  title="@BadgeTooltip">
                @if (!Dot && !Processing)
                {
                    @BadgeText
                }
            </span>
        }
    </span>
}
else if (Ribbon)
{
    <span class="sgc-badge sgc-badge-ribbon @VariantClass @PlacementClass @(Square ? "sgc-badge-square" : "") @AnimationClasses @CssClass"
          style="@ComputedColorStyle @Style"
          role="status"
          aria-label="@BadgeAriaLabel"
          title="@BadgeTooltip"
          @attributes="AdditionalAttributes">
        @if (!Hidden && !_hidden && !Dot)
        {
            @if (Text is not null) { @Text }
            else if (InnerContent is not null) { @InnerContent }
            else { @BadgeText }
        }
    </span>
}
else
{
    @if (!Hidden && !_hidden)
    {
        @if (OnClick.HasDelegate)
        {
            <button type="button"
                    class="@StandaloneBadgeClasses sgc-badge-clickable"
                    style="@ComputedColorStyle @Style"
                    role="status"
                    aria-label="@(AriaLabel ?? Text ?? Localizer["Badge"])"
                    title="@BadgeTooltip"
                    @onclick="OnClick"
                    @attributes="AdditionalAttributes">
                @BadgeInner
            </button>
        }
        else
        {
            <span class="@StandaloneBadgeClasses"
                  style="@ComputedColorStyle @Style"
                  role="status"
                  aria-label="@(AriaLabel ?? Text ?? Localizer["Badge"])"
                  title="@BadgeTooltip"
                  @attributes="AdditionalAttributes">
                @BadgeInner
            </span>
        }
    }
}

@code {
    private RenderFragment BadgeInner => __builder =>
    {
        if (Processing)
        {
            <span class="sgc-badge-processing-dot" aria-hidden="true"></span>
        }
        if (!Dot && !Processing)
        {
            if (Icon is not null)
            {
                <span class="sgc-badge-icon" aria-hidden="true">@((MarkupString)Icon)</span>
            }
            if (Text is not null) { @Text }
            else if (InnerContent is not null) { @InnerContent }
            else if (Count.HasValue) { @BadgeText }
        }
    };

    /// <summary>Content to wrap. When set, the badge is positioned as an overlay over this content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Inner content of a standalone badge. Takes precedence over <see cref="Text"/>.</summary>
    [Parameter] public RenderFragment? InnerContent { get; set; }

    /// <summary>Badge text for standalone mode.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Numeric count (capped at <see cref="Max"/>).</summary>
    [Parameter] public int? Count { get; set; }

    /// <summary>Maximum count before showing "Max+". Default 99.</summary>
    [Parameter] public int Max { get; set; } = 99;

    /// <summary>When true and <see cref="Count"/> is 0, the badge stays visible. Default false (hidden when count is 0).</summary>
    [Parameter] public bool ShowZero { get; set; }

    /// <summary>Renders as a small dot without text.</summary>
    [Parameter] public bool Dot { get; set; }

    /// <summary>Hides the badge.</summary>
    [Parameter] public bool Hidden { get; set; }

    /// <summary>Adds a pulsing animation to draw attention.</summary>
    [Parameter] public bool Pulse { get; set; }

    /// <summary>When true, the badge blinks (sharp opacity toggle) in a repeating pattern. Different from Pulse — Blink is a sharp on/off, Pulse is a smooth breathing.</summary>
    [Parameter] public bool Blink { get; set; }

    /// <summary>Auto-hide delay in milliseconds. After the specified delay the badge becomes hidden automatically.</summary>
    [Parameter] public int? AutoHide { get; set; }

    /// <summary>When true, the badge background uses a gradient from the base color to a lighter variant.</summary>
    [Parameter] public bool Gradient { get; set; }

    /// <summary>When true, adds a pulsing box-shadow glow effect matching the badge color.</summary>
    [Parameter] public bool Glow { get; set; }

    /// <summary>Custom CSS border-color for the badge. Useful for setting a distinct border on outlined badges.</summary>
    [Parameter] public string? BorderColor { get; set; }

    /// <summary>When true, adds a subtle drop shadow to the badge.</summary>
    [Parameter] public bool Shadow { get; set; }

    /// <summary>Animation style for badge visual effects. When non-default, takes precedence over <see cref="Pulse"/> and <see cref="Blink"/>.</summary>
    [Parameter] public SgBadgeAnimation BadgeAnimation { get; set; } = SgBadgeAnimation.None;

    /// <summary>Native browser tooltip text shown on hover.</summary>
    [Parameter] public string? Tooltip { get; set; }

    /// <summary>Renders an animated processing dot (replaces text).</summary>
    [Parameter] public bool Processing { get; set; }

    /// <summary>Outlined visual style.</summary>
    [Parameter] public bool Outlined { get; set; }

    /// <summary>Square shape — removes border-radius. Default false (pill/rounded).</summary>
    [Parameter] public bool Square { get; set; }

    /// <summary>Renders as a corner ribbon (use standalone over a positioned container).</summary>
    [Parameter] public bool Ribbon { get; set; }

    /// <summary>Forces standalone rendering even when <see cref="ChildContent"/> is set.</summary>
    [Parameter] public bool Standalone { get; set; }

    /// <summary>Makes the wrapper element <c>display:block</c> (so the badge anchors to a block child like a card).</summary>
    [Parameter] public bool Block { get; set; }

    /// <summary>Visual variant. Default <see cref="SgBadgeVariant.Default"/>.</summary>
    [Parameter] public SgBadgeVariant Variant { get; set; } = SgBadgeVariant.Default;

    /// <summary>Badge size. Default <see cref="SgSize.Md"/>.</summary>
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;

    /// <summary>Placement of the wrapped/ribbon badge. Default top-right.</summary>
    [Parameter] public SgBadgePlacement Placement { get; set; } = SgBadgePlacement.TopRight;

    /// <summary>Horizontal offset (px) applied to the wrapper badge.</summary>
    [Parameter] public int? OffsetX { get; set; }

    /// <summary>Vertical offset (px) applied to the wrapper badge.</summary>
    [Parameter] public int? OffsetY { get; set; }

    /// <summary>Custom badge background color (any CSS color value).</summary>
    [Parameter] public string? Color { get; set; }

    /// <summary>Optional SVG/HTML icon rendered before the text in standalone mode.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Click callback. When set, the badge renders as a <c>&lt;button&gt;</c>.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>Accessibility label for screen readers.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Additional CSS classes.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Inline CSS styles.</summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>Additional HTML attributes for the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // ── Internals ────────────────────────────────────────────────────────────

    private bool _hidden;
    private CancellationTokenSource? _autoHideCts;

    protected override void OnInitialized()
    {
        ResetAutoHide();
    }

    protected override void OnParametersSet()
    {
        _hidden = false;
        ResetAutoHide();
    }

    void IDisposable.Dispose()
    {
        _autoHideCts?.Cancel();
        _autoHideCts?.Dispose();
    }

    private void ResetAutoHide()
    {
        _autoHideCts?.Cancel();
        _autoHideCts?.Dispose();
        _autoHideCts = null;

        if (AutoHide.HasValue && AutoHide.Value > 0)
        {
            _autoHideCts = new CancellationTokenSource();
            var token = _autoHideCts.Token;
            _ = AutoHideAsync(AutoHide.Value, token);
        }
    }

    private async Task AutoHideAsync(int delayMs, CancellationToken token)
    {
        try
        {
            await Task.Delay(delayMs, token);
            if (!token.IsCancellationRequested)
            {
                _hidden = true;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed or parameters changed — no-op
        }
    }

    private bool IsZero => Count is 0 && !ShowZero && string.IsNullOrEmpty(Text) && InnerContent is null && !Dot && !Processing;

    private string VariantClass => Variant switch
    {
        SgBadgeVariant.Danger  => "sgc-danger",
        SgBadgeVariant.Success => "sgc-success",
        SgBadgeVariant.Warn    => "sgc-warn",
        SgBadgeVariant.Muted   => "sgc-muted",
        SgBadgeVariant.Info    => "sgc-info",
        _                      => ""
    };

    private string SizeClass => Size switch
    {
        SgSize.Sm => "sgc-badge-sm",
        SgSize.Lg => "sgc-badge-lg",
        SgSize.Xl => "sgc-badge-xl",
        _         => ""
    };

    private string PlacementClass => Placement switch
    {
        SgBadgePlacement.TopLeft     => "sgc-badge-tl",
        SgBadgePlacement.BottomLeft  => "sgc-badge-bl",
        SgBadgePlacement.BottomRight => "sgc-badge-br",
        _                            => "sgc-badge-tr"
    };

    private string AnimationClasses
    {
        get
        {
            if (BadgeAnimation != SgBadgeAnimation.None)
            {
                return BadgeAnimation switch
                {
                    SgBadgeAnimation.Pulse  => " sgc-badge-pulse",
                    SgBadgeAnimation.Blink  => " sgc-badge-blink",
                    SgBadgeAnimation.Ripple => " sgc-badge-ripple",
                    SgBadgeAnimation.Shine  => " sgc-badge-shine",
                    _ => ""
                };
            }
            var sb = new System.Text.StringBuilder();
            if (Pulse) sb.Append(" sgc-badge-pulse");
            if (Blink) sb.Append(" sgc-badge-blink");
            return sb.ToString();
        }
    }

    private string ComputedOffsetStyle
    {
        get
        {
            var sb = new System.Text.StringBuilder();
            if (OffsetX.HasValue) sb.Append("--sgc-badge-ox:").Append(OffsetX.Value).Append("px;");
            if (OffsetY.HasValue) sb.Append("--sgc-badge-oy:").Append(OffsetY.Value).Append("px;");
            AppendColorStyle(sb);
            AppendFeatureStyle(sb);
            return sb.ToString();
        }
    }

    private string ComputedColorStyle
    {
        get
        {
            var sb = new System.Text.StringBuilder();
            AppendColorStyle(sb);
            AppendFeatureStyle(sb);
            return sb.ToString();
        }
    }

    private void AppendColorStyle(System.Text.StringBuilder sb)
    {
        if (string.IsNullOrEmpty(Color)) return;
        if (Gradient)
        {
            sb.Append("background:linear-gradient(135deg,").Append(Color)
              .Append(",color-mix(in srgb,").Append(Color).Append(",white 35%));");
            sb.Append("border-color:").Append(Color).Append(";");
        }
        else
        {
            sb.Append("background:").Append(Color).Append(";border-color:").Append(Color).Append(";");
        }
    }

    private void AppendFeatureStyle(System.Text.StringBuilder sb)
    {
        if (!string.IsNullOrEmpty(BorderColor))
            sb.Append("border-color:").Append(BorderColor).Append(";");
        if (Glow)
        {
            var gc = !string.IsNullOrEmpty(Color) ? Color : "";
            if (!string.IsNullOrEmpty(gc))
                sb.Append("--sgc-badge-glow-color:").Append(gc).Append(";");
        }
        if (Shadow)
            sb.Append("filter:drop-shadow(0 1px 2px rgba(0,0,0,0.2));");
    }

    private string WrapBadgeClasses
    {
        get
        {
            var sb = new System.Text.StringBuilder("sgc-badge ");
            sb.Append(VariantClass).Append(' ').Append(SizeClass).Append(' ').Append(PlacementClass);
            if (Dot)        sb.Append(" sgc-badge-dot");
            if (Outlined)   sb.Append(" sgc-badge-outlined");
            if (Square)     sb.Append(" sgc-badge-square");
            if (Processing) sb.Append(" sgc-badge-processing");
            if (Gradient && string.IsNullOrEmpty(Color)) sb.Append(" sgc-badge-gradient");
            if (Glow)       sb.Append(" sgc-badge-glow");
            if (Shadow)     sb.Append(" sgc-badge-shadow");
            sb.Append(AnimationClasses);
            return sb.ToString();
        }
    }

    private string StandaloneBadgeClasses
    {
        get
        {
            var sb = new System.Text.StringBuilder("sgc-badge sgc-badge-inline ");
            sb.Append(VariantClass).Append(' ').Append(SizeClass);
            if (Dot)        sb.Append(" sgc-badge-dot");
            if (Outlined)   sb.Append(" sgc-badge-outlined");
            if (Square)     sb.Append(" sgc-badge-square");
            if (Processing) sb.Append(" sgc-badge-processing");
            if (Gradient && string.IsNullOrEmpty(Color)) sb.Append(" sgc-badge-gradient");
            if (Glow)       sb.Append(" sgc-badge-glow");
            if (Shadow)     sb.Append(" sgc-badge-shadow");
            sb.Append(AnimationClasses);
            if (Icon is not null && (Text is not null || Count.HasValue)) sb.Append(" sgc-badge-with-icon");
            if (!string.IsNullOrEmpty(CssClass)) sb.Append(' ').Append(CssClass);
            return sb.ToString();
        }
    }

    private string BadgeText
    {
        get
        {
            if (Count.HasValue) return Count.Value > Max ? $"{Max}+" : Count.Value.ToString();
            return Text ?? "";
        }
    }

    private string BadgeAriaLabel
    {
        get
        {
            if (!string.IsNullOrEmpty(AriaLabel)) return AriaLabel;
            if (Dot) return Localizer["Notification"];
            if (Processing) return Localizer["Processing"];
            if (Count.HasValue) return Count.Value > Max
                ? $"{Max}+ {Localizer["Notifications"]}"
                : $"{Count.Value} {Localizer["Notifications"]}";
            return Text ?? Localizer["Badge"];
        }
    }

    private string? BadgeTooltip => Tooltip;
}
