@namespace SuperUI.Components
@using SuperUI.Enums
@inject ISuperUILocalizer Localizer

@{
    var tag = TagName;
    var cls = ComputedClasses;
}
@switch (tag)
{
    case "h1":
        <h1 class="@cls" style="@ComputedStyle" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</h1>
        break;
    case "h2":
        <h2 class="@cls" style="@ComputedStyle" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</h2>
        break;
    case "h3":
        <h3 class="@cls" style="@ComputedStyle" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</h3>
        break;
    case "h4":
        <h4 class="@cls" style="@ComputedStyle" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</h4>
        break;
    case "h5":
        <h5 class="@cls" style="@ComputedStyle" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</h5>
        break;
    case "h6":
        <h6 class="@cls" style="@ComputedStyle" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</h6>
        break;
    case "code":
        <code class="@cls" style="@ComputedStyle" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</code>
        break;
    case "pre":
        <pre class="@cls" style="@ComputedStyle" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</pre>
        break;
    case "blockquote":
        <blockquote class="@cls" style="@ComputedStyle" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</blockquote>
        break;
    case "label":
        <label class="@cls" style="@ComputedStyle" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</label>
        break;
    case "div":
        <div class="@cls" style="@ComputedStyle" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</div>
        break;
    case "span":
        <span class="@cls" style="@ComputedStyle" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</span>
        break;
    default:
        <p class="@cls" style="@ComputedStyle" @onclick="HandleClick" @attributes="AdditionalAttributes">@ChildContent</p>
        break;
}

@code {
    /// <summary>Content to render inside the typography element.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Semantic HTML element to render. Default "p".</summary>
    [Parameter] public SgTypographyElement As { get; set; } = SgTypographyElement.P;

    /// <summary>Visual variant. When set, overrides <see cref="As"/> for styling only.</summary>
    [Parameter] public SgTypographyVariant Variant { get; set; }

    /// <summary>Font size. Default <see cref="SgTypographySize.Base"/>.</summary>
    [Parameter] public SgTypographySize Size { get; set; } = SgTypographySize.Base;

    /// <summary>Font weight. Default <see cref="SgTypographyWeight.Normal"/>.</summary>
    [Parameter] public SgTypographyWeight Weight { get; set; } = SgTypographyWeight.Normal;

    /// <summary>Text color. Any CSS color value or CSS variable.</summary>
    [Parameter] public string? Color { get; set; }

    /// <summary>Text alignment.</summary>
    [Parameter] public SgTypographyAlign? Align { get; set; }

    /// <summary>Text transform.</summary>
    [Parameter] public SgTypographyTransform? Transform { get; set; }

    /// <summary>Text decoration.</summary>
    [Parameter] public SgTypographyDecoration? Decoration { get; set; }

    /// <summary>Font family. Default <see cref="SgTypographyFont.Sans"/>.</summary>
    [Parameter] public SgTypographyFont Font { get; set; } = SgTypographyFont.Sans;

    /// <summary>Letter spacing (tracking).</summary>
    [Parameter] public SgTypographyTracking? Tracking { get; set; }

    /// <summary>Line height (leading).</summary>
    [Parameter] public SgTypographyLeading? Leading { get; set; }

    /// <summary>Single-line truncation with ellipsis.</summary>
    [Parameter] public bool Truncate { get; set; }

    /// <summary>Multi-line clamp (2-5). Overrides <see cref="Truncate"/>.</summary>
    [Parameter] public int? Clamp { get; set; }

    /// <summary>Gradient colors (comma-separated CSS colors) for gradient text.</summary>
    [Parameter] public string? Gradient { get; set; }

    /// <summary>Italic style.</summary>
    [Parameter] public bool Italic { get; set; }

    /// <summary>Inline code style.</summary>
    [Parameter] public bool IsCode { get; set; }

    /// <summary>Mark/highlight style.</summary>
    [Parameter] public bool Mark { get; set; }

    /// <summary>Strikethrough style.</summary>
    [Parameter] public bool Strike { get; set; }

    /// <summary>Underline style.</summary>
    [Parameter] public bool Underline { get; set; }

    /// <summary>Additional CSS classes.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Inline CSS styles.</summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>Additional HTML attributes.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Prevents text from wrapping.</summary>
    [Parameter] public bool NoWrap { get; set; }

    /// <summary>Allows long words to break and wrap to the next line.</summary>
    [Parameter] public bool WordBreak { get; set; }

    /// <summary>Makes the text selectable (user-select: all) with a copy cursor.</summary>
    [Parameter] public bool Copyable { get; set; }

    /// <summary>CSS text-shadow value. Example: "0 2px 4px rgba(0,0,0,0.3)".</summary>
    [Parameter] public string? TextShadow { get; set; }

    /// <summary>Text opacity (0.0–1.0). Null means no override.</summary>
    [Parameter] public double? Opacity { get; set; }

    /// <summary>Fires when the element is clicked.</summary>
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnClick { get; set; }

    /// <summary>Enables fluid/responsive typography using CSS clamp(). Sizes scale with viewport.</summary>
    [Parameter] public bool Fluid { get; set; }

    /// <summary>Enables CSS hyphens: auto for better word breaking across lines.</summary>
    [Parameter] public bool Hyphens { get; set; }

    /// <summary>CSS text-indent value. Example: "2em" or "20px".</summary>
    [Parameter] public string? TextIndent { get; set; }

    // ── Internals ────────────────────────────────────────────────────────────

    private string TagName => Variant.ToString() switch
    {
        "Heading1" => "h1",
        "Heading2" => "h2",
        "Heading3" => "h3",
        "Heading4" => "h4",
        "Heading5" => "h5",
        "Heading6" => "h6",
        "Blockquote" => "blockquote",
        "Code" or "Pre" when Variant == SgTypographyVariant.Pre => "pre",
        "Code" when Variant == SgTypographyVariant.Code => "code",
        _ => As switch
        {
            SgTypographyElement.H1 => "h1",
            SgTypographyElement.H2 => "h2",
            SgTypographyElement.H3 => "h3",
            SgTypographyElement.H4 => "h4",
            SgTypographyElement.H5 => "h5",
            SgTypographyElement.H6 => "h6",
            SgTypographyElement.Span => "span",
            SgTypographyElement.Div => "div",
            SgTypographyElement.Label => "label",
            SgTypographyElement.Code => "code",
            SgTypographyElement.Pre => "pre",
            SgTypographyElement.Blockquote => "blockquote",
            _ => "p"
        }
    };

    private string ComputedClasses
    {
        get
        {
            var sb = new System.Text.StringBuilder("sgc-typography");

            if (Variant != SgTypographyVariant.None)
                sb.Append(" sgc-typo-").Append(Variant.ToString().ToLowerInvariant());
            else if (As == SgTypographyElement.P)
                sb.Append(" sgc-typo-body");

            sb.Append(" sgc-typo-size-").Append(SizeClass());
            sb.Append(" sgc-typo-weight-").Append(WeightClass());
            sb.Append(" sgc-typo-font-").Append(FontClass());

            if (Align.HasValue)
                sb.Append(" sgc-typo-align-").Append(Align.Value.ToString().ToLowerInvariant());
            if (Transform.HasValue)
                sb.Append(" sgc-typo-transform-").Append(Transform.Value.ToString().ToLowerInvariant());
            if (Decoration.HasValue)
                sb.Append(" sgc-typo-deco-").Append(Decoration.Value.ToString().ToLowerInvariant());
            if (Tracking.HasValue)
                sb.Append(" sgc-typo-tracking-").Append(Tracking.Value.ToString().ToLowerInvariant());
            if (Leading.HasValue)
                sb.Append(" sgc-typo-leading-").Append(Leading.Value.ToString().ToLowerInvariant());

            if (Truncate) sb.Append(" sgc-typo-truncate");
            if (Clamp.HasValue) sb.Append(" sgc-typo-clamp-").Append(Clamp.Value);
            if (Italic) sb.Append(" sgc-typo-italic");
            if (IsCode) sb.Append(" sgc-typo-inline-code");
            if (Mark) sb.Append(" sgc-typo-mark");
            if (Strike) sb.Append(" sgc-typo-strike");
            if (Underline) sb.Append(" sgc-typo-underline");
            if (Gradient is not null) sb.Append(" sgc-typo-gradient");
            if (NoWrap) sb.Append(" sgc-typo-nowrap");
            if (WordBreak) sb.Append(" sgc-typo-word-break");
            if (Copyable) sb.Append(" sgc-typo-copyable");
            if (Fluid) sb.Append(" sgc-typo-fluid");
            if (Hyphens) sb.Append(" sgc-typo-hyphens");

            if (!string.IsNullOrEmpty(CssClass))
                sb.Append(' ').Append(CssClass);

            return sb.ToString();
        }
    }

    private string ComputedStyle
    {
        get
        {
            var sb = new System.Text.StringBuilder();
            if (!string.IsNullOrEmpty(Color))
                sb.Append("color:").Append(Color).Append(';');
            if (!string.IsNullOrEmpty(Gradient))
            {
                sb.Append("--sgc-typo-gradient:").Append(Gradient).Append(';');
                sb.Append("background-image:linear-gradient(to right,").Append(Gradient).Append(");");
                sb.Append("-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;");
            }
            if (!string.IsNullOrEmpty(TextShadow))
                sb.Append("text-shadow:").Append(TextShadow).Append(';');
            if (Opacity.HasValue)
                sb.Append("opacity:").Append(Opacity.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)).Append(';');
            if (!string.IsNullOrEmpty(TextIndent))
                sb.Append("text-indent:").Append(TextIndent).Append(';');
            if (!string.IsNullOrEmpty(Style))
                sb.Append(Style);
            return sb.ToString();
        }
    }

    private string SizeClass() => Size switch
    {
        SgTypographySize.Xs => "xs",
        SgTypographySize.Sm => "sm",
        SgTypographySize.Base => "base",
        SgTypographySize.Lg => "lg",
        SgTypographySize.Xl => "xl",
        SgTypographySize.Xxl => "2xl",
        SgTypographySize.Xxxl => "3xl",
        _ => "base"
    };

    private string WeightClass() => Weight switch
    {
        SgTypographyWeight.Normal => "normal",
        SgTypographyWeight.Medium => "medium",
        SgTypographyWeight.Semibold => "semibold",
        SgTypographyWeight.Bold => "bold",
        _ => "normal"
    };

    private string FontClass() => Font switch
    {
        SgTypographyFont.Sans => "sans",
        SgTypographyFont.Mono => "mono",
        _ => "sans"
    };

    private async Task HandleClick(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(e);
    }
}
