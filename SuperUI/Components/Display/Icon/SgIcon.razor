@namespace SuperUI.Components
@inherits SgComponentBase

<span class="@Css("sgc-icon").Build()" style="@GetIconStyle()" aria-hidden="true">
    @((MarkupString)Icon)
</span>

@code {
    /// <summary>SVG markup of the icon.</summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = "";

    /// <summary>Size of the icon (e.g., "16px"). Sets both width and height.</summary>
    [Parameter] public string? Size { get; set; }

    /// <summary>Width of the icon.</summary>
    [Parameter] public string? Width { get; set; }

    /// <summary>Height of the icon.</summary>
    [Parameter] public string? Height { get; set; }

    /// <summary>Color of the icon (CSS color).</summary>
    [Parameter] public string? Color { get; set; }

    private string GetIconStyle()
    {
        var w = Width ?? Size;
        var h = Height ?? Size;

        return Styles()
            .Add("width", w, !string.IsNullOrEmpty(w))
            .Add("min-width", w, !string.IsNullOrEmpty(w))
            .Add("height", h, !string.IsNullOrEmpty(h))
            .Add("min-height", h, !string.IsNullOrEmpty(h))
            .Add("display", "inline-flex", !string.IsNullOrEmpty(w) || !string.IsNullOrEmpty(h))
            .Add("align-items", "center", !string.IsNullOrEmpty(w) || !string.IsNullOrEmpty(h))
            .Add("justify-content", "center", !string.IsNullOrEmpty(w) || !string.IsNullOrEmpty(h))
            .Add("color", Color, !string.IsNullOrEmpty(Color))
            .Build();
    }

    public override void Dispose() { }
}
