@namespace SuperUI.Components

<div class="sgc-status-panel @CssClass">
    @if (HeaderContent is not null || !string.IsNullOrWhiteSpace(Title))
    {
        <div class="sgc-status-panel-header">
            <div>
                @if (HeaderContent is not null)
                {
                    @HeaderContent
                }
                else
                {
                    <div class="sgc-status-panel-title">@Title</div>
                    @if (!string.IsNullOrWhiteSpace(Subtitle))
                    {
                        <div class="sgc-status-panel-subtitle">@Subtitle</div>
                    }
                }
            </div>
            @if (ActionsContent is not null)
            {
                <div class="sgc-status-panel-actions">@ActionsContent</div>
            }
        </div>
    }

    <div class="sgc-status-panel-grid" style="@GridStyle">
        @foreach (var item in Items)
        {
            <div class="sgc-status-panel-card">
                <div class="sgc-status-panel-top">
                    <div class="sgc-status-panel-card-title">@item.Title</div>
                    @if (!string.IsNullOrWhiteSpace(item.BadgeText))
                    {
                        <SgBadge Text="@item.BadgeText" Variant="@item.BadgeVariant" />
                    }
                </div>

                <SgStatistic Title="@item.Subtitle" Value="@item.Value" TrendValue="@item.TrendValue" />

                @if (!string.IsNullOrWhiteSpace(item.Hint))
                {
                    <div class="sgc-status-panel-hint">@item.Hint</div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    /// <summary>Secondary text displayed below the title in the panel header.</summary>
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>Collection of status panel items to display in the grid.</summary>
    [Parameter] public IEnumerable<StatusPanelItem> Items { get; set; } = Array.Empty<StatusPanelItem>();
    /// <summary>Number of grid columns. Default is 3.</summary>
    [Parameter] public int Columns { get; set; } = 3;
    /// <summary>Additional CSS classes for the root element.</summary>
    [Parameter] public string? CssClass { get; set; }
    /// <summary>Custom header content. Replaces the default title and subtitle when set.</summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    /// <summary>Custom action content rendered on the right side of the header.</summary>
    [Parameter] public RenderFragment? ActionsContent { get; set; }

    private string GridStyle => $"grid-template-columns: repeat({Math.Max(1, Columns)}, minmax(0, 1fr));";
}
