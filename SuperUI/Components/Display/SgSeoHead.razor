@namespace SuperUI.Components

@if (!string.IsNullOrEmpty(Title))
{
    <PageTitle>@Title</PageTitle>
}

<HeadContent>
    @if (!string.IsNullOrEmpty(Description))
    {
        <meta name="description" content="@Description" />
    }

    @if (!string.IsNullOrEmpty(Keywords))
    {
        <meta name="keywords" content="@Keywords" />
    }

    @* Open Graph *@
    <meta property="og:type" content="@(OgType ?? "website")" />

    @{ var resolvedTitle = OgTitle ?? Title; }
    @if (!string.IsNullOrEmpty(resolvedTitle))
    {
        <meta property="og:title" content="@resolvedTitle" />
        <meta name="twitter:title" content="@resolvedTitle" />
    }

    @{ var resolvedDescription = OgDescription ?? Description; }
    @if (!string.IsNullOrEmpty(resolvedDescription))
    {
        <meta property="og:description" content="@resolvedDescription" />
        <meta name="twitter:description" content="@resolvedDescription" />
    }

    @if (!string.IsNullOrEmpty(OgImage))
    {
        <meta property="og:image" content="@OgImage" />
        <meta name="twitter:image" content="@OgImage" />
    }

    @if (!string.IsNullOrEmpty(OgImageAlt))
    {
        <meta property="og:image:alt" content="@OgImageAlt" />
        <meta name="twitter:image:alt" content="@OgImageAlt" />
    }

    @if (!string.IsNullOrEmpty(OgUrl))
    {
        <meta property="og:url" content="@OgUrl" />
    }

    @if (!string.IsNullOrEmpty(OgLocale))
    {
        <meta property="og:locale" content="@OgLocale" />
    }

    @if (!string.IsNullOrEmpty(OgSiteName))
    {
        <meta property="og:site_name" content="@OgSiteName" />
    }

    <meta name="twitter:card" content="@(TwitterCard ?? "summary_large_image")" />

    @if (!string.IsNullOrEmpty(CanonicalUrl))
    {
        <link rel="canonical" href="@CanonicalUrl" />
    }

    @MetaTags
    @JsonLd
</HeadContent>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Keywords { get; set; }

    [Parameter] public string? OgTitle { get; set; }
    [Parameter] public string? OgDescription { get; set; }
    [Parameter] public string? OgImage { get; set; }
    [Parameter] public string? OgImageAlt { get; set; }
    [Parameter] public string? OgType { get; set; } = "website";
    [Parameter] public string? OgUrl { get; set; }
    [Parameter] public string? OgLocale { get; set; }
    [Parameter] public string? OgSiteName { get; set; }

    [Parameter] public string? TwitterCard { get; set; } = "summary_large_image";

    [Parameter] public string? CanonicalUrl { get; set; }

    [Parameter] public RenderFragment? JsonLd { get; set; }
    [Parameter] public RenderFragment? MetaTags { get; set; }
}
