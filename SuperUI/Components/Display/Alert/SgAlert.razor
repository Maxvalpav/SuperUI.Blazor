@namespace SuperUI.Components
@implements IDisposable

@if (IsVisible || _dismissing)
{
    <div class="@ComputedClass"
         style="@Style"
         role="@ResolvedRole"
         aria-live="@ResolvedAriaLive"
         @onclick="HandleClick"
         @attributes="AdditionalAttributes">

        @if (Loading)
        {
            <div class="sgc-alert-shimmer" aria-hidden="true">
                <div class="sgc-alert-shimmer-icon"></div>
                <div class="sgc-alert-shimmer-lines">
                    <div class="sgc-alert-shimmer-line" style="width:45%"></div>
                    <div class="sgc-alert-shimmer-line" style="width:80%"></div>
                </div>
            </div>
        }
        else
        {
            @if (ShowIcon)
            {
                <div class="sgc-alert-icon" aria-hidden="true">
                    @if (IconTemplate is not null)
                    {
                        @IconTemplate
                    }
                    else if (IsSvgIcon)
                    {
                        @((MarkupString)ComputedIcon)
                    }
                    else
                    {
                        @ComputedIcon
                    }
                </div>
            }

            <div class="sgc-alert-body">
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <div class="sgc-alert-title">@Title</div>
                }

                @if (ChildContent is not null)
                {
                    <div class="sgc-alert-content">@ChildContent</div>
                }
                else if (!string.IsNullOrWhiteSpace(Text))
                {
                    <div class="sgc-alert-content">@Text</div>
                }
            </div>

            @if (ActionsContent is not null)
            {
                <div class="sgc-alert-actions">@ActionsContent</div>
            }

            @if (Dismissible)
            {
                <button type="button" class="sgc-alert-close" @onclick="CloseAsync" aria-label="@Localizer["Alert_Close"]">
                    <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
                        <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
                    </svg>
                </button>
            }
        }
    </div>
}


