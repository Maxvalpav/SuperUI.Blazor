@namespace SuperUI.Components
@implements IDisposable

@if (IsVisible || _dismissing)
{
    <div class="@ComputedClass"
         style="@Style"
         role="@ResolvedRole"
         aria-live="@ResolvedAriaLive"
         tabindex="0"
         @onclick="HandleClick"
         @onkeydown="HandleKeyDown"
         @attributes="AdditionalAttributes">

        @if (Loading)
        {
            <div class="sgc-alert-shimmer" aria-hidden="true">
                <div class="sgc-alert-shimmer-icon"></div>
                <div class="sgc-alert-shimmer-lines">
                    <div class="sgc-alert-shimmer-line" style="width:45%"></div>
                    <div class="sgc-alert-shimmer-line" style="width:80%"></div>
                </div>
            </div>
        }
        else
        {
            @if (ShowIcon && IconTop)
            {
                <div class="sgc-alert-icon" aria-hidden="true">
                    @if (IconTemplate is not null)
                    {
                        @IconTemplate
                    }
                    else if (IsSvgIcon)
                    {
                        @((MarkupString)ComputedIcon)
                    }
                    else
                    {
                        @ComputedIcon
                    }
                </div>
            }

            <div class="sgc-alert-body">
                @if (ShowIcon && !IconTop)
                {
                    <div class="sgc-alert-icon" aria-hidden="true">
                        @if (IconTemplate is not null)
                        {
                            @IconTemplate
                        }
                        else if (IsSvgIcon)
                        {
                            @((MarkupString)ComputedIcon)
                        }
                        else
                        {
                            @ComputedIcon
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <div class="sgc-alert-title">
                        <span>@Title</span>
                        @if (Collapsible)
                        {
                            <button type="button" class="sgc-alert-collapse-btn" @onclick="ToggleCollapse"
                                    aria-expanded="@(!_collapsed)" aria-label="Toggle content">
                                <svg viewBox="0 0 20 20" fill="currentColor" width="12" height="12" aria-hidden="true"
                                     style="transform:rotate(@(_collapsed ? 0 : 180)deg);transition:transform 0.2s;">
                                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
                                </svg>
                            </button>
                        }
                    </div>
                }

                @if (Collapsible)
                {
                    <div class="sgc-alert-content sgc-alert-content-collapsible @(_collapsed ? "sgc-alert-content-hidden" : "")">
                        @if (ChildContent is not null)
                        {
                            if (ListMode) { <ul class="sgc-alert-list">@ChildContent</ul> }
                            else { @ChildContent }
                        }
                        else if (!string.IsNullOrWhiteSpace(Text))
                        {
                            @Text
                        }
                    </div>
                }
                else
                {
                    @if (ChildContent is not null)
                    {
                        if (ListMode) { <ul class="sgc-alert-list">@ChildContent</ul> }
                        else { @ChildContent }
                    }
                    else if (!string.IsNullOrWhiteSpace(Text))
                    {
                        @Text
                    }
                }
            </div>

            @if (PrimaryActionText is not null && OnPrimaryAction.HasDelegate)
            {
                <div class="sgc-alert-actions">
                    <SgButton Text="@PrimaryActionText"
                              Variant="SgButtonVariant.Primary"
                              Size="SgSize.Sm"
                              OnClick="HandlePrimaryClick" />
                </div>
            }

            @if (ActionsContent is not null)
            {
                <div class="sgc-alert-actions">@ActionsContent</div>
            }

            @if (Footer is not null)
            {
                <div class="sgc-alert-footer">@Footer</div>
            }

            @if (Dismissible)
            {
                <button type="button" class="sgc-alert-close" @onclick="CloseAsync" aria-label="@Localizer["Alert_Close"]">
                    <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
                        <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
                    </svg>
                </button>
            }
        }

        @if (ShowProgress && Timeout > 0 && !_dismissing)
        {
            <div class="sgc-alert-progress" aria-hidden="true">
                <div class="sgc-alert-progress-bar" style="animation-duration:@(Timeout)ms"></div>
            </div>
        }
    </div>
}
