@namespace SuperUI.Components
@using System.Globalization
@using SuperUI.Components.Display.Avatar

<span class="sgc-avatar @ResolvedSizeClass @ResolvedShapeClass @StatusClass @StateClass @CssClass"
      role="@(Clickable ? "button" : "img")"
      tabindex="@(Clickable && !Disabled ? "0" : null)"
      aria-label="@AriaLabelComputed"
      aria-disabled="@(Disabled ? "true" : null)"
      title="@Title"
      style="@BuildStyle()"
      @onclick="HandleClickAsync"
      @attributes="AdditionalAttributes">

    @if (Loading)
    {
        <span class="sgc-avatar-spinner" aria-hidden="true"></span>
    }
    else if (!string.IsNullOrEmpty(ImageUrl))
    {
        <img src="@ImageUrl"
             alt="@(Title ?? "")"
             loading="lazy"
             decoding="async"
             draggable="false" />
    }
    else if (!string.IsNullOrEmpty(ComputedInitials))
    {
        <span class="sgc-avatar-initials" aria-hidden="true">@ComputedInitials</span>
    }
    else if (Icon is not null)
    {
        <span class="sgc-avatar-icon" aria-hidden="true">@Icon</span>
    }
    else if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <svg class="sgc-avatar-fallback" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
        </svg>
    }

    @if (StatusDot != SgAvatarStatus.None)
    {
        <span class="sgc-avatar-status sgc-avatar-status-@StatusDot.ToString().ToLowerInvariant() @(StatusPulse ? "sgc-pulse" : "")" aria-hidden="true"></span>
    }

    @if (BadgeContent is not null)
    {
        <div class="sgc-avatar-badge">@BadgeContent</div>
    }
</span>

@code {
    [Inject] private ISuperUILocalizer Localizer { get; set; } = default!;

    /// <summary>Image source URL.</summary>
    [Parameter] public string? ImageUrl { get; set; }

    /// <summary>Initials to display if no image is available.</summary>
    [Parameter] public string? Initials { get; set; }

    /// <summary>Title/Name used for auto-initials and tooltip.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Icon rendered when no image / initials are available.</summary>
    [Parameter] public RenderFragment? Icon { get; set; }

    /// <summary>Custom content rendered inside the avatar.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Optional badge content overlaid on the avatar.</summary>
    [Parameter] public RenderFragment? BadgeContent { get; set; }

    [CascadingParameter] private SgAvatarGroupContext? GroupContext { get; set; }

    /// <summary>Avatar size. Default <see cref="SgSize.Md"/>.</summary>
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;

    /// <summary>Custom pixel size. Overrides <see cref="Size"/>.</summary>
    [Parameter] public int? PixelSize { get; set; }

    /// <summary>Avatar shape. Default <see cref="SgAvatarShape.Circle"/>.</summary>
    [Parameter] public SgAvatarShape Shape { get; set; } = SgAvatarShape.Circle;

    /// <summary>Status indicator dot.</summary>
    [Parameter] public SgAvatarStatus StatusDot { get; set; } = SgAvatarStatus.None;

    /// <summary>Whether the status dot should pulse.</summary>
    [Parameter] public bool StatusPulse { get; set; }

    /// <summary>Background color (CSS color string).</summary>
    [Parameter] public string? Color { get; set; }

    /// <summary>Foreground / text color.</summary>
    [Parameter] public string? TextColor { get; set; }

    /// <summary>Whether the avatar is clickable.</summary>
    [Parameter] public bool Clickable { get; set; }

    /// <summary>Whether the avatar is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Shows a loading spinner.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>Shows a white border (useful for overlapping).</summary>
    [Parameter] public bool Bordered { get; set; }

    /// <summary>Custom aria-label.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Additional CSS classes.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Inline CSS styles.</summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>Click callback.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private SgSize ResolvedSize => GroupContext?.Size ?? Size;

    private SgAvatarShape ResolvedShape => GroupContext?.Shape ?? Shape;

    private string ResolvedSizeClass => PixelSize.HasValue ? "sgc-avatar-custom" : ResolvedSize switch
    {
        SgSize.Sm => "sgc-sm",
        SgSize.Lg => "sgc-lg",
        SgSize.Xl => "sgc-xl",
        _         => "sgc-md"
    };

    private string ResolvedShapeClass => ResolvedShape switch
    {
        SgAvatarShape.Square  => "sgc-square",
        SgAvatarShape.Rounded => "sgc-rounded",
        _                     => ""
    };

    private string StatusClass => StatusDot != SgAvatarStatus.None ? "sgc-has-status" : "";

    private string StateClass
    {
        get
        {
            var b = new System.Text.StringBuilder();
            if (Bordered) b.Append(" sgc-avatar-bordered");
            if (Clickable && !Disabled) b.Append(" sgc-avatar-clickable");
            if (Disabled) b.Append(" sgc-avatar-disabled");
            if (Loading) b.Append(" sgc-avatar-loading");
            if (BadgeContent is not null) b.Append(" sgc-avatar-has-badge");
            return b.ToString();
        }
    }

    private string AriaLabelComputed => AriaLabel ?? Title ?? Localizer["Avatar"];

    private string ComputedInitials =>
        !string.IsNullOrEmpty(Initials) ? Initials :
        !string.IsNullOrEmpty(Title) ? GetInitials(Title) : "";

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "";
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpper();
    }

    private string BuildStyle()
    {
        var sb = new System.Text.StringBuilder();
        if (PixelSize.HasValue)
        {
            sb.Append($"width:{PixelSize.Value}px;height:{PixelSize.Value}px;font-size:{PixelSize.Value / 2.5}px;");
        }
        if (!string.IsNullOrEmpty(Color)) sb.Append($"background-color:{Color};");
        if (!string.IsNullOrEmpty(TextColor)) sb.Append($"color:{TextColor};");
        if (!string.IsNullOrEmpty(Style)) sb.Append(Style);
        return sb.ToString();
    }

    private async Task HandleClickAsync(MouseEventArgs e)
    {
        if (!Disabled && OnClick.HasDelegate) await OnClick.InvokeAsync(e);
    }
}
