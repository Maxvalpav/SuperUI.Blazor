@namespace SuperUI.Components
@inherits SgComponentBase

<span class="@Css("sgc-icon").Build()" style="@GetIconStyle()" aria-hidden="true">
    @((MarkupString)ResolvedIcon)
</span>

@code {
    private string? _resolvedIcon;
    private string? _lastName;
    private string? _lastVariant;

    /// <summary>Heroicon name (from <see cref="SgHeroicons.Names"/>), e.g. <c>SgHeroicons.Names.AcademicCap</c>.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>Icon variant: Outline (default), Solid, Mini, or Micro.</summary>
    [Parameter] public string Variant { get; set; } = "Outline";

    /// <summary>Size of the icon (e.g., "16px"). Sets both width and height.</summary>
    [Parameter] public string? Size { get; set; }

    /// <summary>Width of the icon.</summary>
    [Parameter] public string? Width { get; set; }

    /// <summary>Height of the icon.</summary>
    [Parameter] public string? Height { get; set; }

    /// <summary>Color of the icon (CSS color).</summary>
    [Parameter] public string? Color { get; set; }

    private string ResolvedIcon
    {
        get
        {
            if (_resolvedIcon is null || _lastName != Name || _lastVariant != Variant)
            {
                _lastName = Name;
                _lastVariant = Variant;
                _resolvedIcon = SgHeroicons.Get(Name, Variant) ?? "";
            }
            return _resolvedIcon;
        }
    }

    private string GetIconStyle()
    {
        var b = Styles();
        var w = Width ?? Size;
        var h = Height ?? Size;
        if (!string.IsNullOrEmpty(w)) { b.Add("width", w); b.Add("min-width", w); }
        if (!string.IsNullOrEmpty(h)) { b.Add("height", h); b.Add("min-height", h); }
        if (!string.IsNullOrEmpty(w) || !string.IsNullOrEmpty(h))
        {
            b.Add("display", "inline-flex");
            b.Add("align-items", "center");
            b.Add("justify-content", "center");
        }
        if (!string.IsNullOrEmpty(Color)) b.Add("color", Color);
        return b.Build();
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (_lastName != Name || _lastVariant != Variant)
        {
            _resolvedIcon = null;
        }
    }

    /// <inheritdoc />
    public override void Dispose() { }
}
