@namespace SuperUI.Components
@implements IDisposable
@inject SgNotificationService Notifications

<SgPopover Placement="@Placement" Trigger="SgTrigger.Click" CssClass="sgc-notification-bell">
    <TriggerContent>
        <button type="button" class="sgc-notification-bell-btn @(Notifications.UnreadCount > 0 ? "sgc-bell-has-unread" : "")" aria-label="@AriaLabel">
            @if (IconContent is not null)
            {
                @IconContent
            }
            else
            {
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
                    <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
                </svg>
            }
            @if (Notifications.UnreadCount > 0)
            {
                <span class="sgc-notification-bell-badge sgc-bell-badge-animated" aria-label="@($"{Notifications.UnreadCount} unread")" key="@Notifications.UnreadCount">
                    @(Notifications.UnreadCount > 99 ? "99+" : Notifications.UnreadCount.ToString())
                </span>
            }
        </button>
    </TriggerContent>
    <ChildContent>
        <div class="sgc-notification-bell-pop">
            <SgNotificationPanel Items="Notifications.Items"
                                 Title="@Title"
                                 MaxHeight="@MaxHeight"
                                 ShowFilter="@ShowFilter"
                                 ShowDefaultActions="@ShowDefaultActions"
                                 ShowHeader="@ShowHeader"
                                 AllowDismiss="@AllowDismiss"
                                 AllowClear="@AllowClear"
                                 ShowPinnedSeparately="@ShowPinnedSeparately"
                                 AllowBulkActions="@AllowBulkActions"
                                 AllowSearch="@AllowSearch"
                                 CollapsibleGroups="@CollapsibleGroups"
                                 ImportanceThreshold="@ImportanceThreshold"
                                 AllowSnooze="@AllowSnooze"
                                 AllowSwipeDismiss="@AllowSwipeDismiss"
                                 ShowChannel="@ShowChannel"
                                 OnItemClick="HandleItemClick"
                                 OnReadToggle="HandleReadToggle"
                                 OnDismiss="HandleDismiss"
                                 OnMarkAllRead="HandleMarkAllRead"
                                 OnClearAll="HandleClearAll"
                                 OnBulkMarkRead="HandleBulkMarkRead"
                                 OnBulkDismiss="HandleBulkDismiss"
                                 OnBulkMarkUnread="HandleBulkMarkUnread"
                                 OnSnooze="HandleSnooze"
                                 FooterContent="FooterContent" />
        </div>
    </ChildContent>
</SgPopover>

@code {
    /// <summary>Panel header title.</summary>
    [Parameter] public string Title { get; set; } = "Notifications";

    /// <summary>Popover placement. Default is <see cref="SgPlacement.BottomEnd"/>.</summary>
    [Parameter] public SgPlacement Placement { get; set; } = SgPlacement.BottomEnd;

    /// <summary>Max height of the scrollable list area.</summary>
    [Parameter] public string? MaxHeight { get; set; } = "420px";

    /// <summary>Accessibility label for the trigger button.</summary>
    [Parameter] public string AriaLabel { get; set; } = "Notifications";

    /// <summary>Custom icon for the trigger button. Defaults to bell glyph.</summary>
    [Parameter] public RenderFragment? IconContent { get; set; }

    /// <summary>Footer content for the panel.</summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>Whether filter tabs are shown.</summary>
    [Parameter] public bool ShowFilter { get; set; } = true;

    /// <summary>Whether default header actions are shown.</summary>
    [Parameter] public bool ShowDefaultActions { get; set; } = true;

    /// <summary>Whether the panel header is visible.</summary>
    [Parameter] public bool ShowHeader { get; set; } = true;

    /// <summary>Whether per-item dismiss is allowed.</summary>
    [Parameter] public bool AllowDismiss { get; set; } = true;

    /// <summary>Whether clear-all is allowed.</summary>
    [Parameter] public bool AllowClear { get; set; } = true;

    /// <summary>Whether pinned items appear in a separate group.</summary>
    [Parameter] public bool ShowPinnedSeparately { get; set; } = true;

    /// <summary>Enables bulk select checkboxes and action toolbar.</summary>
    [Parameter] public bool AllowBulkActions { get; set; }

    /// <summary>Shows a search input that filters notifications.</summary>
    [Parameter] public bool AllowSearch { get; set; }

    /// <summary>Makes group headers clickable to collapse/expand.</summary>
    [Parameter] public bool CollapsibleGroups { get; set; }

    /// <summary>Items at or below this priority are collapsed under a "Show more" link.</summary>
    [Parameter] public SgNotificationPriority ImportanceThreshold { get; set; } = SgNotificationPriority.Default;

    /// <summary>Shows a snooze button with preset durations on each item.</summary>
    [Parameter] public bool AllowSnooze { get; set; }

    /// <summary>Enables touch-swipe-to-dismiss on notification items.</summary>
    [Parameter] public bool AllowSwipeDismiss { get; set; }

    /// <summary>Shows channel badge on items that have a channel value.</summary>
    [Parameter] public bool ShowChannel { get; set; }

    /// <summary>Raised when an item is clicked.</summary>
    [Parameter] public EventCallback<NotificationItem> OnItemClick { get; set; }

    /// <summary>Raised when bulk mark-read is triggered.</summary>
    [Parameter] public EventCallback<IEnumerable<string>> OnBulkMarkRead { get; set; }

    /// <summary>Raised when bulk dismiss is triggered.</summary>
    [Parameter] public EventCallback<IEnumerable<string>> OnBulkDismiss { get; set; }

    /// <summary>Raised when bulk mark-unread is triggered.</summary>
    [Parameter] public EventCallback<IEnumerable<string>> OnBulkMarkUnread { get; set; }

    /// <summary>Raised when an item is snoozed.</summary>
    [Parameter] public EventCallback<(string Id, DateTimeOffset Until)> OnSnooze { get; set; }

    protected override void OnInitialized()
    {
        Notifications.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task HandleItemClick(NotificationItem item)
    {
        Notifications.MarkAsRead(item.Id);
        if (OnItemClick.HasDelegate) await OnItemClick.InvokeAsync(item);
    }

    private void HandleReadToggle(NotificationItem item) => Notifications.ToggleRead(item.Id);

    private void HandleDismiss(NotificationItem item) => Notifications.Remove(item.Id);

    private void HandleMarkAllRead() => Notifications.MarkAllAsRead();

    private void HandleClearAll() => Notifications.Clear();

    private void HandleBulkMarkRead(IEnumerable<string> ids) => Notifications.MarkManyAsRead(ids);

    private void HandleBulkDismiss(IEnumerable<string> ids) => Notifications.RemoveMany(ids);

    private void HandleBulkMarkUnread(IEnumerable<string> ids) => Notifications.MarkManyAsUnread(ids);

    private void HandleSnooze((string Id, DateTimeOffset Until) args) => Notifications.Snooze(args.Id, args.Until);

    public void Dispose()
    {
        Notifications.Changed -= OnChanged;
    }
}
