@namespace SuperUI.Components
@implements IDisposable
@inject SgNotificationService Notifications

<SgPopover Placement="@Placement" Trigger="SgTrigger.Click" CssClass="sgc-notification-bell">
    <TriggerContent>
        <button type="button" class="sgc-notification-bell-btn @(Notifications.UnreadCount > 0 ? "sgc-bell-has-unread" : "")" aria-label="@AriaLabel">
            @if (IconContent is not null)
            {
                @IconContent
            }
            else
            {
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
                    <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
                </svg>
            }
            @if (Notifications.UnreadCount > 0)
            {
                <span class="sgc-notification-bell-badge" aria-label="@($"{Notifications.UnreadCount} unread")">
                    @(Notifications.UnreadCount > 99 ? "99+" : Notifications.UnreadCount.ToString())
                </span>
            }
        </button>
    </TriggerContent>
    <ChildContent>
        <div class="sgc-notification-bell-pop">
            <SgNotificationPanel Items="Notifications.Items"
                                 Title="@Title"
                                 MaxHeight="@MaxHeight"
                                 ShowFilter="@ShowFilter"
                                 ShowDefaultActions="@ShowDefaultActions"
                                 ShowHeader="@ShowHeader"
                                 AllowDismiss="@AllowDismiss"
                                 AllowClear="@AllowClear"
                                 ShowPinnedSeparately="@ShowPinnedSeparately"
                                 OnItemClick="HandleItemClick"
                                 OnReadToggle="HandleReadToggle"
                                 OnDismiss="HandleDismiss"
                                 OnMarkAllRead="HandleMarkAllRead"
                                 OnClearAll="HandleClearAll"
                                 FooterContent="FooterContent" />
        </div>
    </ChildContent>
</SgPopover>

@code {
    /// <summary>Panel header title.</summary>
    [Parameter] public string Title { get; set; } = "Notifications";

    /// <summary>Popover placement. Default is <see cref="SgPlacement.BottomEnd"/>.</summary>
    [Parameter] public SgPlacement Placement { get; set; } = SgPlacement.BottomEnd;

    /// <summary>Max height of the scrollable list area.</summary>
    [Parameter] public string? MaxHeight { get; set; } = "420px";

    /// <summary>Accessibility label for the trigger button.</summary>
    [Parameter] public string AriaLabel { get; set; } = "Notifications";

    /// <summary>Custom icon for the trigger button. Defaults to bell glyph.</summary>
    [Parameter] public RenderFragment? IconContent { get; set; }

    /// <summary>Footer content for the panel.</summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>Whether filter tabs are shown.</summary>
    [Parameter] public bool ShowFilter { get; set; } = true;

    /// <summary>Whether default header actions are shown.</summary>
    [Parameter] public bool ShowDefaultActions { get; set; } = true;

    /// <summary>Whether the panel header is visible.</summary>
    [Parameter] public bool ShowHeader { get; set; } = true;

    /// <summary>Whether per-item dismiss is allowed.</summary>
    [Parameter] public bool AllowDismiss { get; set; } = true;

    /// <summary>Whether clear-all is allowed.</summary>
    [Parameter] public bool AllowClear { get; set; } = true;

    /// <summary>Whether pinned items appear in a separate group.</summary>
    [Parameter] public bool ShowPinnedSeparately { get; set; } = true;

    /// <summary>Raised when an item is clicked.</summary>
    [Parameter] public EventCallback<NotificationItem> OnItemClick { get; set; }

    protected override void OnInitialized()
    {
        Notifications.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task HandleItemClick(NotificationItem item)
    {
        Notifications.MarkAsRead(item.Id);
        if (OnItemClick.HasDelegate) await OnItemClick.InvokeAsync(item);
    }

    private void HandleReadToggle(NotificationItem item) => Notifications.ToggleRead(item.Id);

    private void HandleDismiss(NotificationItem item) => Notifications.Remove(item.Id);

    private void HandleMarkAllRead() => Notifications.MarkAllAsRead();

    private void HandleClearAll() => Notifications.Clear();

    public void Dispose()
    {
        Notifications.Changed -= OnChanged;
    }
}
