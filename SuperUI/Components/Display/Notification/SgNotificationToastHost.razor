@namespace SuperUI.Components
@implements IDisposable
@inject SgNotificationService Notifications
@inject SgToastService Toasts
@{
    DeprecationWarning();
}

@* Backward-compat rendering: maps notification toasts through SgToastHost's SgToastService *@

@code {
    /// <summary>
    /// Toast stack position on screen. Default is <see cref="SgPlacement.BottomEnd"/> (bottom-right).
    /// </summary>
    [Parameter] public SgPlacement Position { get; set; } = SgPlacement.BottomEnd;

    /// <summary>Additional HTML attributes.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Raised when a toast is clicked.</summary>
    [Parameter] public EventCallback<SgNotificationToastItem> OnToastClick { get; set; }

    /// <summary>
    /// <strong>Deprecated:</strong> This component is kept for backward compatibility.
    /// Notifications pushed via <see cref="SgNotificationService.PushToast"/> are now
    /// automatically routed through <see cref="SgToastService"/> and rendered by
    /// <see cref="SgToastHost"/>. Remove this component from your layout and keep only
    /// <c>&lt;SgToastHost /&gt;</c>.
    /// </summary>
    [Obsolete("SgNotificationToastHost is deprecated. Notifications now render through SgToastHost. Remove <SgNotificationToastHost> and keep only <SgToastHost> in your layout.", false)]
    public string? _deprecatedMessage = null;

    private static bool _warned;

    private static void DeprecationWarning()
    {
        if (!_warned)
        {
            _warned = true;
            Console.Error.WriteLine("[SuperUI] SgNotificationToastHost is deprecated. Remove it from your layout and keep only <SgToastHost />. Notifications pushed via SgNotificationService.PushToast now render through SgToastService automatically.");
        }
    }
}
