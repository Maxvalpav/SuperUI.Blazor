@namespace SuperUI.Components
@inject ISuperUILocalizer Localizer

@{
    var pct = EffectivePct;
    var bufferPct = BufferPct;
    var isComplete = pct >= 100;
}

<div class="@RootClass" 
     style="@RootStyle"
     role="progressbar"
     aria-valuemin="0"
     aria-valuemax="@Max"
     aria-valuenow="@(Indeterminate ? null : Value)"
     aria-label="@AriaLabel"
     @attributes="AdditionalAttributes">
    
    @if (Circular)
    {
        @* ═══════════════════════════════════════════════════════════════════════ *@
        @*                          CIRCULAR PROGRESS                              *@
        @* ═══════════════════════════════════════════════════════════════════════ *@
        <svg class="sg-progress-circular-svg" viewBox="0 0 100 100">
            <defs>
                @* Gradient Definitions *@
                <linearGradient id="sg-grad-@_uniqueId-primary" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#006fee" />
                    <stop offset="100%" stop-color="#338ef7" />
                </linearGradient>
                <linearGradient id="sg-grad-@_uniqueId-info" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#0ea5e9" />
                    <stop offset="100%" stop-color="#22d3ee" />
                </linearGradient>
                <linearGradient id="sg-grad-@_uniqueId-success" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#10b981" />
                    <stop offset="100%" stop-color="#34d399" />
                </linearGradient>
                <linearGradient id="sg-grad-@_uniqueId-warn" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#f59e0b" />
                    <stop offset="100%" stop-color="#fbbf24" />
                </linearGradient>
                <linearGradient id="sg-grad-@_uniqueId-danger" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#ef4444" />
                    <stop offset="100%" stop-color="#f87171" />
                </linearGradient>
                
                @* Glow Filter *@
                @if (Glow)
                {
                    <filter id="sg-glow-@_uniqueId">
                        <feGaussianBlur stdDeviation="2" result="coloredBlur"/>
                        <feMerge>
                            <feMergeNode in="coloredBlur"/>
                            <feMergeNode in="SourceGraphic"/>
                        </feMerge>
                    </filter>
                }
            </defs>
            
            @* Background Circle *@
            <circle class="sg-progress-circular-bg"
                    cx="50" cy="50" r="@CircularRadius"
                    fill="none"
                    stroke-width="@StrokeWidth" />
            
            @* Progress Circle *@
            <circle class="sg-progress-circular-bar @(Indeterminate ? "sg-indeterminate" : "")"
                    cx="50" cy="50" r="@CircularRadius"
                    fill="none"
                    stroke-width="@StrokeWidth"
                    stroke-dasharray="@CircularDashArray"
                    stroke-dashoffset="@CircularDashOffset"
                    stroke="@CircularStroke"
                    stroke-linecap="round"
                    filter="@(Glow ? $"url(#sg-glow-{_uniqueId})" : "")"
                    transform="rotate(-90 50 50)" />
        </svg>
        
        @* Center Label *@
        @if (ShowLabel && !Indeterminate)
        {
            <div class="sg-progress-circular-label">
                @if (CustomLabel != null)
                {
                    @CustomLabel
                }
                else
                {
                    <span class="sg-progress-value">@($"{pct:0}")</span>
                    <span class="sg-progress-unit">%</span>
                }
            </div>
        }
        else if (Indeterminate)
        {
            <div class="sg-progress-circular-label">
                <span class="sg-progress-spinner">⟳</span>
            </div>
        }
    }
    else
    {
        @* ═══════════════════════════════════════════════════════════════════════ *@
        @*                           LINEAR PROGRESS                               *@
        @* ═══════════════════════════════════════════════════════════════════════ *@
        
        @* Title / Label Top *@
        @if (!string.IsNullOrEmpty(Title) && LabelPosition == SgLabelPosition.Top)
        {
            <div class="sg-progress-header">
                <span class="sg-progress-title">@Title</span>
                @if (ShowLabel && !Indeterminate)
                {
                    <span class="sg-progress-percentage">@($"{pct:0}%")</span>
                }
            </div>
        }
        
        @* Progress Track *@
        <div class="sg-progress-track @(Vertical ? "sg-vertical" : "")">
            @if (Indeterminate)
            {
                @* Indeterminate Animation *@
                <div class="sg-progress-bar sg-indeterminate" style="@BarColorStyle"></div>
            }
            else
            {
                @* Buffer Bar (Background) *@
                @if (BufferValue.HasValue && BufferValue.Value > 0)
                {
                    <div class="sg-progress-bar sg-buffer" 
                         style="@GetBarStyle(bufferPct, true)"></div>
                }
                
                @* Main Progress Bar *@
                @if (Segmented)
                {
                    @* Segmented Progress *@
                    <div class="sg-progress-segments" style="@GetBarStyle(pct, false)">
                        @for (int i = 0; i < Segments; i++)
                        {
                            var segmentPct = 100.0 / Segments;
                            var segmentStart = i * segmentPct;
                            var isActive = pct > segmentStart;
                            var segmentFill = isActive ? Math.Min(100, ((pct - segmentStart) / segmentPct) * 100) : 0;
                            
                            <div class="sg-progress-segment @(isActive ? "sg-active" : "")"
                                 style="@($"--segment-fill: {segmentFill}%;")"></div>
                        }
                    </div>
                }
                else
                {
                    @* Solid Progress Bar *@
                    <div class="sg-progress-bar @(Striped ? "sg-striped" : "") @(Animated ? "sg-animated" : "")" 
                         style="@GetBarStyle(pct, false)">
                        @if (Gradient)
                        {
                            <div class="sg-progress-gradient"></div>
                        }
                        @if (Glow)
                        {
                            <div class="sg-progress-glow"></div>
                        }
                    </div>
                }
            }
        </div>
        
        @* Label Right / Bottom *@
        @if (ShowLabel && !Indeterminate && LabelPosition == SgLabelPosition.Right)
        {
            <span class="sg-progress-label-right">@($"{pct:0}%")</span>
        }
        
        @* Description *@
        @if (!string.IsNullOrEmpty(Description))
        {
            <div class="sg-progress-description">@Description</div>
        }
    }
</div>

@code {
    private string _uniqueId = Guid.NewGuid().ToString("N")[..8];
    
    // ═══════════════════════════════════════════════════════════════════════════
    //                              PARAMETERS
    // ═══════════════════════════════════════════════════════════════════════════
    
    /// <summary>Current progress value (0 to Max)</summary>
    [Parameter] public double Value { get; set; }
    
    /// <summary>Maximum value (default: 100)</summary>
    [Parameter] public double Max { get; set; } = 100;
    
    /// <summary>Buffer value for buffered progress (streaming, loading)</summary>
    [Parameter] public double? BufferValue { get; set; }
    
    /// <summary>Show percentage label</summary>
    [Parameter] public bool ShowLabel { get; set; } = true;
    
    /// <summary>Indeterminate loading state</summary>
    [Parameter] public bool Indeterminate { get; set; }
    
    /// <summary>Striped pattern</summary>
    [Parameter] public bool Striped { get; set; }
    
    /// <summary>Animate stripes</summary>
    [Parameter] public bool Animated { get; set; }
    
    /// <summary>Vertical orientation</summary>
    [Parameter] public bool Vertical { get; set; }
    
    /// <summary>Circular progress indicator</summary>
    [Parameter] public bool Circular { get; set; }
    
    /// <summary>Segmented progress bar</summary>
    [Parameter] public bool Segmented { get; set; }
    
    /// <summary>Number of segments (when Segmented = true)</summary>
    [Parameter] public int Segments { get; set; } = 10;
    
    /// <summary>Gradient fill</summary>
    [Parameter] public bool Gradient { get; set; }
    
    /// <summary>Glow effect</summary>
    [Parameter] public bool Glow { get; set; }
    
    /// <summary>Pulse animation on complete</summary>
    [Parameter] public bool PulseOnComplete { get; set; } = true;
    
    /// <summary>Sticky to top (for page loading)</summary>
    [Parameter] public bool StickyTop { get; set; }
    
    /// <summary>Size variant</summary>
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;
    
    /// <summary>Color variant</summary>
    [Parameter] public SgSpinnerVariant Variant { get; set; } = SgSpinnerVariant.Default;
    
    /// <summary>Custom color (overrides Variant)</summary>
    [Parameter] public string? Color { get; set; }
    
    /// <summary>Title text</summary>
    [Parameter] public string? Title { get; set; }
    
    /// <summary>Description text (below progress)</summary>
    [Parameter] public string? Description { get; set; }
    
    /// <summary>Label position</summary>
    [Parameter] public SgLabelPosition LabelPosition { get; set; } = SgLabelPosition.Top;
    
    /// <summary>Custom label content</summary>
    [Parameter] public RenderFragment? CustomLabel { get; set; }
    
    /// <summary>Bar height in pixels (linear only)</summary>
    [Parameter] public int? Height { get; set; }
    
    /// <summary>Stroke width for circular (default: auto based on size)</summary>
    [Parameter] public double? StrokeWidth { get; set; }
    
    /// <summary>Additional CSS classes</summary>
    [Parameter] public string? CssClass { get; set; }
    
    /// <summary>Additional inline styles</summary>
    [Parameter] public string? Style { get; set; }
    
    /// <summary>Additional HTML attributes</summary>
    [Parameter(CaptureUnmatchedValues = true)] 
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
    
    // ═══════════════════════════════════════════════════════════════════════════
    //                           COMPUTED PROPERTIES
    // ═══════════════════════════════════════════════════════════════════════════
    
    private double EffectivePct => Max <= 0 ? 0 : Math.Clamp(Value / Max * 100, 0, 100);
    private double BufferPct => BufferValue.HasValue && Max > 0 
        ? Math.Clamp(BufferValue.Value / Max * 100, 0, 100) 
        : 0;
    
    private string AriaLabel => !string.IsNullOrEmpty(Title) 
        ? Title 
        : Indeterminate 
            ? Localizer["Common_Loading"] 
            : $"{Localizer["Common_Progress"]}: {EffectivePct:0}%";
    
    // ─────────────────────────────────────────────────────────────────────────
    //                              SIZE MAPPING
    // ─────────────────────────────────────────────────────────────────────────
    
    private int BarHeight => Height ?? Size switch
    {
        SgSize.Sm => 4,
        SgSize.Md => 8,
        SgSize.Lg => 12,
        SgSize.Xl => 16,
        _ => 8
    };
    
    private double CircularRadius => 42; // Fixed for viewBox 100x100
    
    private double EffectiveStrokeWidth => StrokeWidth ?? Size switch
    {
        SgSize.Sm => 4,
        SgSize.Md => 6,
        SgSize.Lg => 8,
        SgSize.Xl => 10,
        _ => 6
    };
    
    private int CircularSize => Size switch
    {
        SgSize.Sm => 48,
        SgSize.Md => 64,
        SgSize.Lg => 96,
        SgSize.Xl => 128,
        _ => 64
    };
    
    // ─────────────────────────────────────────────────────────────────────────
    //                           CIRCULAR CALCULATIONS
    // ─────────────────────────────────────────────────────────────────────────
    
    private double CircularCircumference => 2 * Math.PI * CircularRadius;
    private string CircularDashArray => $"{CircularCircumference}";
    private string CircularDashOffset => Indeterminate 
        ? "0" 
        : $"{CircularCircumference * (1 - EffectivePct / 100)}";
    
    private string CircularStroke => Color ?? (Gradient ? $"url(#sg-grad-{_uniqueId}-{VariantName})" : VariantColor);
    
    private string VariantName => Variant switch
    {
        SgSpinnerVariant.Info => "info",
        SgSpinnerVariant.Success => "success",
        SgSpinnerVariant.Warn => "warn",
        SgSpinnerVariant.Danger => "danger",
        _ => "primary"
    };
    
    private string VariantColor => Variant switch
    {
        SgSpinnerVariant.Info => "#0ea5e9",
        SgSpinnerVariant.Success => "#10b981",
        SgSpinnerVariant.Warn => "#f59e0b",
        SgSpinnerVariant.Danger => "#ef4444",
        _ => "#006fee"
    };
    
    // ─────────────────────────────────────────────────────────────────────────
    //                              CSS CLASSES
    // ─────────────────────────────────────────────────────────────────────────
    
    private string RootClass
    {
        get
        {
            var classes = new List<string> { "sg-progress" };
            
            if (Circular) classes.Add("sg-circular");
            if (Vertical && !Circular) classes.Add("sg-vertical");
            if (StickyTop) classes.Add("sg-sticky-top");
            if (PulseOnComplete && EffectivePct >= 100) classes.Add("sg-complete");
            
            classes.Add($"sg-size-{Size.ToString().ToLower()}");
            classes.Add($"sg-variant-{VariantName}");
            
            if (!string.IsNullOrEmpty(CssClass)) classes.Add(CssClass);
            
            return string.Join(" ", classes);
        }
    }
    
    private string RootStyle
    {
        get
        {
            var styles = new List<string>();
            
            if (Circular)
            {
                styles.Add($"width: {CircularSize}px");
                styles.Add($"height: {CircularSize}px");
            }
            else if (Vertical)
            {
                styles.Add($"height: 200px");
                styles.Add($"width: {BarHeight}px");
            }
            else
            {
                styles.Add($"--bar-height: {BarHeight}px");
            }
            
            if (Color != null)
            {
                styles.Add($"--progress-color: {Color}");
            }
            
            if (!string.IsNullOrEmpty(Style))
            {
                styles.Add(Style);
            }
            
            return string.Join("; ", styles);
        }
    }
    
    // ─────────────────────────────────────────────────────────────────────────
    //                            BAR STYLES
    // ─────────────────────────────────────────────────────────────────────────
    
    private string BarColorStyle
    {
        get
        {
            if (Color != null)
                return $"background-color: {Color};";
            
            return $"background-color: {VariantColor};";
        }
    }
    
    private string GetBarStyle(double percentage, bool isBuffer)
    {
        var styles = new List<string>();
        
        if (Vertical)
        {
            styles.Add($"height: {percentage}%");
        }
        else
        {
            styles.Add($"width: {percentage}%");
        }
        
        if (isBuffer)
        {
            styles.Add("opacity: 0.3");
        }
        
        if (Color != null && !Gradient)
        {
            styles.Add($"background-color: {Color}");
        }
        else if (!Gradient)
        {
            styles.Add($"background-color: {VariantColor}");
        }
        else if (Gradient && !isBuffer)
        {
            var gradientDir = Vertical ? "180deg" : "90deg";
            var color1 = Color ?? VariantColor;
            var color2 = Color ?? GetGradientEndColor();
            styles.Add($"background: linear-gradient({gradientDir}, {color1}, {color2})");
        }
        
        return string.Join("; ", styles);
    }
    
    private string GetGradientEndColor() => Variant switch
    {
        SgSpinnerVariant.Info => "#22d3ee",
        SgSpinnerVariant.Success => "#34d399",
        SgSpinnerVariant.Warn => "#fbbf24",
        SgSpinnerVariant.Danger => "#f87171",
        _ => "#338ef7"
    };
}
