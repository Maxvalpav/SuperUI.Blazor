@namespace SuperUI.Components
@using SuperUI.Services
@using SuperUI.Themes
@using SuperUI.Localization
@inject SgThemeService ThemeService
@inject ISuperUILocalizer Localizer
@implements IAsyncDisposable

<div class="sgc-appearance-settings">
    <div class="sgc-appearance-header">
        <div class="sgc-appearance-header-main">
            <div class="sgc-appearance-eyebrow">@Localizer["Theme_Appearance"]</div>
            <div class="sgc-appearance-title">@ThemeService.CurrentTheme.Name</div>
        </div>
        <button type="button" 
                class="sgc-appearance-reset-btn" 
                @onclick="ResetToDefaultAsync"
                title="@Localizer["Theme_ResetToDefault"]">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
        </button>
    </div>

    <div class="sgc-appearance-modes">
        <button type="button" 
                class="sgc-appearance-mode-btn @(ThemeService.CurrentMode == "light" ? "is-active" : "")"
                @onclick='() => SetModeAsync("light")'
                title="@Localizer["Theme_LightModeTitle"]">
            <span class="sgc-appearance-mode-text">@Localizer["Theme_LightMode"]</span>
            <span class="sgc-appearance-mode-icon"><SgIcon Icon="@SgIcons.Sun" Size="14px" /></span>
        </button>
        <button type="button" 
                class="sgc-appearance-mode-btn @(ThemeService.CurrentMode == "dark" ? "is-active" : "")"
                @onclick='() => SetModeAsync("dark")'
                title="@Localizer["Theme_DarkModeTitle"]">
            <span class="sgc-appearance-mode-text">@Localizer["Theme_DarkMode"]</span>
            <span class="sgc-appearance-mode-icon"><SgIcon Icon="@SgIcons.Moon" Size="14px" /></span>
        </button>
        <button type="button" 
                class="sgc-appearance-mode-btn @(ThemeService.CurrentMode == "auto" ? "is-active" : "")"
                @onclick='() => SetModeAsync("auto")'
                title="@Localizer["Theme_AutoModeTitle"]">
            <span class="sgc-appearance-mode-text">@Localizer["Theme_AutoMode"]</span>
            <span class="sgc-appearance-mode-icon"><SgIcon Icon="@SgIcons.Monitor" Size="14px" /></span>
        </button>
    </div>

    <div class="sgc-appearance-divider"></div>

    @functions {
        static string GetFontName(string fontFamily)
        {
            var name = fontFamily.Split(',')[0].Trim().Trim('\'');
            return name;
        }

        static string GetHueGroup(IThemeDefinition theme)
        {
            // Parse hue from oklch(... H) in Primary500
            var raw = theme.Primitives.Primary500;
            // oklch(L C H) or oklch(L C H / A)
            var hueStr = "";
            var parts = raw.Split(' ');
            if (parts.Length >= 3)
            {
                hueStr = parts[2].TrimEnd(')', '/');
            }
            var hue = double.TryParse(hueStr, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var h) ? h : 0;

            // Map hue to a named group — wrap around at 0/360
            var group = hue switch
            {
                >= 340 or < 20  => "Rose / Red",
                >= 20  and < 40 => "Red / Orange",
                >= 40  and < 60 => "Orange / Gold",
                >= 60  and < 90 => "Yellow / Amber",
                >= 90  and < 150 => "Green",
                >= 150 and < 200 => "Teal / Cyan",
                >= 200 and < 280 => "Blue",
                >= 280 and < 340 => "Purple / Violet",
                _ => "Neutral"
            };
            return group;
        }

        static int GroupOrder(string group) => group switch
        {
            "Blue"           => 0,
            "Green"          => 1,
            "Purple / Violet"=> 2,
            "Teal / Cyan"    => 3,
            "Yellow / Amber" => 4,
            "Orange / Gold"  => 5,
            "Red / Orange"   => 6,
            "Rose / Red"     => 7,
            "Neutral"        => 8,
            _ => 9
        };
    }
    @{
        var grouped = ThemeService.GetAvailableThemes()
            .GroupBy(t => GetHueGroup(t))
            .OrderBy(g => GroupOrder(g.Key))
            .Select(g => new { Group = g.Key, Themes = g.OrderBy(t => t.Name) });
    }
    @foreach (var g in grouped)
    {
        <div class="sgc-appearance-group-label">@g.Group</div>
        <div class="sgc-appearance-grid">
            @foreach (var theme in g.Themes)
            {
                <button type="button" 
                        class="sgc-appearance-grid-item @(ThemeService.CurrentTheme.Id == theme.Id ? "is-active" : "")"
                        @onclick='() => SetThemeAsync(theme.Id)'
                        title="@theme.Description">
                    <div class="sgc-appearance-grid-preview" style="--p-color: @theme.Light.ColorPrimary; --s-color: @theme.Light.Surface;">
                        <div class="sgc-appearance-grid-preview-primary"></div>
                        <div class="sgc-appearance-grid-preview-surface">
                            <span class="sgc-appearance-grid-name">@theme.Name</span>
                            <span class="sgc-appearance-grid-font">@GetFontName(theme.Primitives.FontSans)</span>
                        </div>
                        @if (ThemeService.CurrentTheme.Id == theme.Id)
                        {
                            <span class="sgc-appearance-grid-check">
                                <SgIcon Icon="@SgIcons.Check" Size="10px" />
                            </span>
                        }
                    </div>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback OnChange { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ThemeService.InitializeAsync();
        ThemeService.ThemeChanged += HandleThemeChanged;
    }

    private async Task SetModeAsync(string mode)
    {
        await ThemeService.SetModeAsync(mode);
        await OnChange.InvokeAsync();
    }

    private async Task SetThemeAsync(string themeId)
    {
        await ThemeService.SetThemeAsync(themeId);
        await OnChange.InvokeAsync();
    }

    private async Task ResetToDefaultAsync()
    {
        await ThemeService.SetThemeAsync("natura-ui");
        await ThemeService.SetModeAsync("light");
        await OnChange.InvokeAsync();
    }

    private void HandleThemeChanged(IThemeDefinition theme, string mode)
    {
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        ThemeService.ThemeChanged -= HandleThemeChanged;
        await Task.CompletedTask;
    }
}
