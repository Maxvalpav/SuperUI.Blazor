@namespace SuperUI.Components
@using SuperUI.Enums
@implements IDisposable

<div class="sgc-accordion-item @(_open ? "sgc-open" : "") @(Disabled ? "sgc-disabled" : "") @CssClass">
    <button type="button"
            class="sgc-accordion-header"
            @onclick="ToggleAsync"
            @onfocus="() => IsFocused = true"
            @onblur="() => IsFocused = false"
            @ref="_buttonRef"
            disabled="@Disabled"
            aria-expanded="@(_open ? "true" : "false")"
            aria-disabled="@(Disabled ? "true" : "false")"
            id="@_headerId"
            aria-controls="@_contentId">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="sgc-accordion-icon">@((MarkupString)Icon)</span>
        }
        <span class="sgc-accordion-title-wrap">
            @if (HeaderContent is not null)
            {
                <span class="sgc-accordion-title">@HeaderContent</span>
            }
            else
            {
                <span class="sgc-accordion-title">@Title</span>
            }
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <span class="sgc-accordion-subtitle">@Subtitle</span>
            }
        </span>
        @if (ExtraContent is not null)
        {
            <span class="sgc-accordion-extra" @onclick:stopPropagation="true">@ExtraContent</span>
        }
        <span class="sgc-accordion-arrow">@((MarkupString)SgIcons.ChevronDown)</span>
    </button>
    <div class="sgc-accordion-content-wrapper"
         id="@_contentId"
         role="region"
         aria-labelledby="@_headerId">
        <div class="sgc-accordion-content">
            <div class="sgc-accordion-content-inner">
                @ChildContent
            </div>
        </div>
    </div>
</div>

@code {
    private readonly string _id = Guid.NewGuid().ToString("N")[..8];
    private string _headerId => $"sg-acc-h-{_id}";
    private string _contentId => $"sg-acc-c-{_id}";
    private ElementReference _buttonRef;

    public bool IsFocused { get; private set; }

    public async Task FocusAsync()
    {
        try { await _buttonRef.FocusAsync(); } catch { }
    }

    private bool _open;
    private bool _initialized;

    /// <summary>
    /// Gets or sets the parent <see cref="SgAccordion"/> component.
    /// </summary>
    [CascadingParameter] public SgAccordion? Owner { get; set; }

    /// <summary>
    /// Gets or sets the custom CSS class for the accordion item.
    /// </summary>
    [Parameter] public string CssClass { get; set; } = "";
    
    /// <summary>
    /// Gets or sets the title text displayed in the accordion item header.
    /// </summary>
    [Parameter] public string Title { get; set; } = "";

    /// <summary>
    /// Gets or sets a secondary line shown under the title in the header.
    /// </summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>
    /// Gets or sets custom header content. Takes precedence over <see cref="Title"/>.
    /// </summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    /// <summary>
    /// Gets or sets whether the accordion item is disabled and cannot be toggled.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Raised when the open state of the item changes.
    /// </summary>
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }

    /// <summary>
    /// Gets or sets extra content rendered on the right side of the header (e.g. badges, actions).
    /// </summary>
    [Parameter] public RenderFragment? ExtraContent { get; set; }

    /// <summary>
    /// Optional SVG markup for an icon rendered before the title.
    /// </summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>
    /// Gets or sets the content to display when the accordion item is expanded.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    
    /// <summary>
    /// Gets or sets whether the accordion item is initially expanded.
    /// Default is false.
    /// </summary>
    [Parameter] public bool Expanded { get; set; }

    /// <summary>
    /// Gets or sets the animation duration in milliseconds. Default is 250.
    /// </summary>
    [Parameter] public int AnimationDuration { get; set; } = 250;

    protected override void OnParametersSet()
    {
        if (!_initialized)
        {
            _initialized = true;
            _open = Expanded;
            Owner?.Register(this);
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            ApplyAnimationDuration();
        }
    }

    private void ApplyAnimationDuration()
    {
        var styleTag = $"<style>.sgc-accordion-item[data-id=\"{_id}\"] .sgc-accordion-content-wrapper{{transition-duration:{AnimationDuration}ms!important}}</style>";
        // Applied via CSS class instead
    }

    public async Task ToggleAsync()
    {
        if (Disabled) return;
        _open = !_open;
        if (_open) Owner?.NotifyExpanded(this);
        if (ExpandedChanged.HasDelegate) await ExpandedChanged.InvokeAsync(_open);
        await InvokeAsync(StateHasChanged);
    }

    public void Collapse()
    {
        if (!_open) return;
        _open = false;
        if (ExpandedChanged.HasDelegate) _ = ExpandedChanged.InvokeAsync(false);
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Owner?.Unregister(this);
}
