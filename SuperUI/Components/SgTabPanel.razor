@namespace SuperUI.Components
@implements IDisposable

@code {
    private bool _registered;

    internal readonly string TabId    = "sg-tab-"    + Guid.NewGuid().ToString("N")[..8];
    internal readonly string PanelId  = "sg-panel-"  + Guid.NewGuid().ToString("N")[..8];

    [CascadingParameter] public SgTabs? Owner { get; set; }
    
    /// <summary>
    /// Gets or sets the tab title displayed in the tab strip.
    /// </summary>
    [Parameter, EditorRequired] public string Title { get; set; } = default!;

    /// <summary>
    /// Gets or sets the icon to display before the tab title.
    /// </summary>
    [Parameter] public RenderFragment? Icon { get; set; }

    /// <summary>
    /// Gets or sets the badge content to display after the tab title.
    /// </summary>
    [Parameter] public object? Badge { get; set; }

    /// <summary>
    /// Gets or sets the color variant for the badge. Default is <see cref="SgBadgeVariant.Default"/>.
    /// </summary>
    [Parameter] public SgBadgeVariant BadgeVariant { get; set; } = SgBadgeVariant.Default;

    /// <summary>
    /// Gets or sets whether this tab is disabled. Disabled tabs cannot be activated by clicking.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }
    
    /// <summary>
    /// Gets or sets the content to render when this tab is active.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnParametersSet()
    {
        if (!_registered)
        {
            _registered = true;
            Owner?.Register(this);
        }
    }

    public void Dispose() => Owner?.Unregister(this);
}
