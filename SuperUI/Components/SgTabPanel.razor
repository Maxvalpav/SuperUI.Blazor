@namespace SuperUI.Components
@implements IDisposable

@code {
    [CascadingParameter] public SgTabs? Owner { get; set; }
    
    /// <summary>
    /// Gets or sets the tab title displayed in the tab strip.
    /// </summary>
    [Parameter, EditorRequired] public string Title { get; set; } = default!;

    /// <summary>
    /// Gets or sets the icon to display before the tab title.
    /// </summary>
    [Parameter] public RenderFragment? Icon { get; set; }

    /// <summary>
    /// Gets or sets the badge content to display after the tab title.
    /// </summary>
    [Parameter] public object? Badge { get; set; }

    /// <summary>
    /// Gets or sets the color variant for the badge.
    /// </summary>
    [Parameter] public string BadgeVariant { get; set; } = "default";
    
    /// <summary>
    /// Gets or sets the content to render when this tab is active.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        Owner?.Register(this);
    }

    public void Dispose() => Owner?.Unregister(this);
}
