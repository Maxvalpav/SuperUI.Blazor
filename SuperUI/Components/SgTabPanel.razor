@namespace SuperUI.Components
@using SuperUI.Enums
@implements IDisposable

@code {
    private bool _registered;

    internal readonly string TabId    = "sg-tab-"    + Guid.NewGuid().ToString("N")[..8];
    internal readonly string PanelId  = "sg-panel-"  + Guid.NewGuid().ToString("N")[..8];

    [CascadingParameter] public SgTabs? Owner { get; set; }
    
    [Parameter, EditorRequired] public string Title { get; set; } = default!;
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public object? Badge { get; set; }
    [Parameter] public SgBadgeVariant BadgeVariant { get; set; } = SgBadgeVariant.Default;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnParametersSet()
    {
        if (!_registered && Owner != null)
        {
            _registered = true;
            Owner.Register(this);
        }
    }

    public void Dispose() => Owner?.Unregister(this);
}
