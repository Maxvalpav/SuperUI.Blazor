@namespace SuperUI.Components
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (_visible)
{
    <button type="button"
            class="sgc-backbottom @CssClass"
            style="@PositionStyle"
            title="@Title"
            aria-label="@Title"
            @onclick="OnClickAsync">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            <span class="sgc-backtop-icon">@((MarkupString)SgIcons.ArrowDown)</span>
        }
    </button>
}

@code {
    /// <summary>
    /// Optional custom content. When null, an arrow-down icon is rendered.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Scroll distance (in pixels) from bottom before the button becomes visible. Default 200.
    /// </summary>
    [Parameter] public int VisibilityHeight { get; set; } = 200;

    /// <summary>
    /// CSS selector for a custom scrollable container. Defaults to the window.
    /// </summary>
    [Parameter] public string? Target { get; set; }

    /// <summary>
    /// When true, scroll uses smooth behavior. Default true.
    /// </summary>
    [Parameter] public bool Smooth { get; set; } = true;

    /// <summary>
    /// Bottom offset in pixels. Default 32.
    /// </summary>
    [Parameter] public int Bottom { get; set; } = 32;

    /// <summary>
    /// Right offset in pixels. Default 32.
    /// </summary>
    [Parameter] public int Right { get; set; } = 32;

    /// <summary>
    /// Tooltip text. Default "Scroll to bottom".
    /// </summary>
    [Parameter] public string Title { get; set; } = "Scroll to bottom";

    /// <summary>
    /// Additional CSS class for the button.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Raised when the user clicks the button (after the scroll request is sent).
    /// </summary>
    [Parameter] public EventCallback OnClick { get; set; }

    private IJSObjectReference? _module;
    private DotNetObjectReference<SgBackBottom>? _self;
    private int _handleId = -1;
    private bool _isDisposed;
    private bool _visible;

    private string PositionStyle => $"bottom:{Bottom}px;right:{Right}px;";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isDisposed) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/superui-affix.js");
            if (_isDisposed) return;
            _self ??= DotNetObjectReference.Create(this);
            
            if (firstRender || _handleId < 0)
            {
                _handleId = await _module.InvokeAsync<int>("backtopAttach", _self,
                    new { target = Target, threshold = VisibilityHeight, direction = "bottom" });
            }
        }
        catch (JSException) { }
        catch (TaskCanceledException) { }
    }

    [JSInvokable]
    public async Task OnVisibilityChanged(bool visible)
    {
        if (_isDisposed || _visible == visible) return;
        _visible = visible;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnClickAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("scrollToBottom", Target, Smooth);
            await OnClick.InvokeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        if (_handleId >= 0 && _module is not null)
        {
            try { await _module.InvokeVoidAsync("backtopDetach", _handleId); } catch { }
        }
        _self?.Dispose();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { }
        }
    }
}
