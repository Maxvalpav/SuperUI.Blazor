@namespace SuperUI.Components

<div class="sgc-toolbar @CssClass">
    @ChildContent
</div>

@code {
    /// <summary>Content rendered inside the toolbar.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Additional CSS classes applied to the toolbar.</summary>
    [Parameter] public string? CssClass { get; set; }
}
