@namespace SuperUI.Components
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer

@* Application / File menu. Sits at the start of the ribbon tab bar (left of normal tabs).
   Opens a wide dropdown menu with arbitrary content (typically SgRibbonMenuSection + SgRibbonMenuItem + SgRibbonMenuSeparator). *@

<div class="sgc-ribbon-file-menu @(_open ? "sgc-ribbon-file-menu-open" : "") @CssClass">
    <button type="button"
            class="sgc-ribbon-file-menu-btn"
            disabled="@Disabled"
            title="@Tooltip"
            aria-haspopup="true"
            aria-expanded="@(_open ? "true" : "false")"
            @onclick="ToggleDropdown">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="sgc-ribbon-btn-icon">@((MarkupString)Icon)</span>
        }
        <span class="sgc-ribbon-file-menu-text">@Text</span>
        <svg class="sgc-ribbon-file-menu-chev" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"/>
        </svg>
    </button>

    @if (_open && ChildContent is not null)
    {
        <div class="sgc-ribbon-file-menu-popup" @onclick:stopPropagation="true">
            <CascadingValue Value="this" IsFixed="true">
                @ChildContent
            </CascadingValue>
        </div>
    }
</div>

@code {
    private bool _open;

    /// <summary>Button label (default "File").</summary>
    [Parameter] public string Text { get; set; } = "File";

    /// <summary>Optional SVG icon (e.g. hamburger, gear, save-floppy).</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Tooltip text.</summary>
    [Parameter] public string? Tooltip { get; set; }

    /// <summary>When true, the menu is non-interactive.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>User-defined menu content (SgRibbonMenuSection/Item/Separator).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Fired whenever a child SgRibbonMenuItem is clicked.</summary>
    [Parameter] public EventCallback<SgRibbonMenuItem> OnSelect { get; set; }

    /// <summary>Fired when the dropdown opens/closes.</summary>
    [Parameter] public EventCallback<bool> OnOpenChanged { get; set; }

    /// <summary>Additional CSS class for the wrapper.</summary>
    [Parameter] public string? CssClass { get; set; }

    private async Task ToggleDropdown()
    {
        if (Disabled) return;
        _open = !_open;
        if (OnOpenChanged.HasDelegate)
            await OnOpenChanged.InvokeAsync(_open);
    }

    /// <summary>Programmatically close the dropdown (called by cascading SgRibbonMenuItem).</summary>
    internal async Task Close()
    {
        if (!_open) return;
        _open = false;
        if (OnOpenChanged.HasDelegate)
            await OnOpenChanged.InvokeAsync(false);
    }
}
