@namespace SuperUI.Components
@using SuperUI.Enums
@implements IDisposable

@* Tab registers itself with the parent ribbon — content is rendered by the ribbon *@

@code {
    internal readonly string Id = "rt-" + Guid.NewGuid().ToString("N")[..8];

    [CascadingParameter] private SgRibbon? Owner { get; set; }

    /// <summary>Tab label text.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Optional SVG icon shown before the tab label.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>When true, the tab label is highlighted with the accent colour (e.g. contextual tabs).</summary>
    [Parameter] public bool Highlight { get; set; }

    /// <summary>When true, the tab cannot be activated.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>When false, the tab is hidden (not rendered, not focusable).</summary>
    [Parameter] public bool Visible { get; set; } = true;

    /// <summary>Single-letter Alt+key shortcut (e.g. "H" for Home). Shown as a small overlay when the ribbon keytips are active.</summary>
    [Parameter] public string? KeyTip { get; set; }

    /// <summary>Optional badge text shown on the tab (e.g. notification count).</summary>
    [Parameter] public string? Badge { get; set; }

    /// <summary>Badge colour variant. Default <see cref="SgBadgeVariant.Default"/>.</summary>
    [Parameter] public SgBadgeVariant BadgeVariant { get; set; } = SgBadgeVariant.Default;

    /// <summary>Additional CSS class for the tab.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Content rendered inside the ribbon panel when this tab is active.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    internal string BadgeVariantClass => BadgeVariant switch
    {
        SgBadgeVariant.Info => "sgc-badge-info",
        SgBadgeVariant.Success => "sgc-badge-success",
        SgBadgeVariant.Warn => "sgc-badge-warn",
        SgBadgeVariant.Danger => "sgc-badge-danger",
        SgBadgeVariant.Muted => "sgc-badge-muted",
        _ => "sgc-badge-default"
    };

    // Track only the Visible parameter so that re-renders (e.g. when the parent
    // re-evaluates its own parameters) do NOT re-notify the ribbon. The previous
    // OnParametersSet implementation called NotifyTabVisibilityChanged on every
    // parameter set, and Notify unconditionally called StateHasChanged — this
    // produced a tight re-render loop that froze the browser on /ribbon-demo.
    private bool _initialized;
    private bool _lastSeenVisible = true;

    public override Task SetParametersAsync(ParameterView parameters)
    {
        var newVisible = parameters.GetValueOrDefault<bool>(nameof(Visible));
        var isInit = !_initialized;

        var task = base.SetParametersAsync(parameters);

        if (isInit)
        {
            _initialized = true;
            _lastSeenVisible = Visible;
            // First-time registration is handled by OnInitialized → RegisterTab.
        }
        else if (newVisible != _lastSeenVisible)
        {
            _lastSeenVisible = newVisible;
            Owner?.NotifyTabVisibilityChanged(this, newVisible);
        }

        return task;
    }

    protected override void OnInitialized() => Owner?.RegisterTab(this);

    public void Dispose() => Owner?.UnregisterTab(this);
}
