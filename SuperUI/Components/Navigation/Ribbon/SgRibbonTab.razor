@namespace SuperUI.Components
@implements IDisposable

@* Tab registers itself with the parent ribbon — content is rendered by the ribbon *@

@code {
    internal readonly string Id = "rt-" + Guid.NewGuid().ToString("N")[..8];

    [CascadingParameter] private SgRibbon? Owner { get; set; }

    /// <summary>Tab label text.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Optional SVG icon shown before the tab label.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>When true, the tab label is highlighted with the accent colour (e.g. contextual tabs).</summary>
    [Parameter] public bool Highlight { get; set; }

    /// <summary>When true, the tab cannot be activated.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Content rendered inside the ribbon panel when this tab is active.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized() => Owner?.RegisterTab(this);

    public void Dispose() => Owner?.UnregisterTab(this);
}
