@namespace SuperUI.Components

@* Group of menu items under a titled section (rendered inside SgRibbonSplit.DropdownContent or SgRibbonFileMenu). *@

<div class="sgc-ribbon-menu-section" role="group" aria-label="@Title">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="sgc-ribbon-menu-section-title">@Title</div>
    }
    <div class="sgc-ribbon-menu-section-body">
        @ChildContent
    </div>
</div>

@code {
    /// <summary>Section title shown above the items.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Menu items in this section.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional CSS class.</summary>
    [Parameter] public string? CssClass { get; set; }
}
