@namespace SuperUI.Components
@using SuperUI.Enums

@*
    Container that groups contextual tabs (which appear together based on user context).
    Renders inside SgRibbon alongside normal SgRibbonTab children.
    When Visible=false, all child tabs are hidden from the tab bar.
*@

@if (Visible)
{
    <div class="sgc-ribbon-contextual-tabs @ColorClass @CssClass" role="presentation">
        <div class="sgc-ribbon-contextual-strip" aria-hidden="true"></div>
        <CascadingValue Value="ContextualContext" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </div>
}

@code {
    /// <summary>Accent colour for the contextual tab group (shown as a top accent strip + tab text colour).</summary>
    [Parameter] public SgContextualColor Color { get; set; } = SgContextualColor.Magenta;

    /// <summary>When false, the entire group of tabs is hidden from the tab bar.</summary>
    [Parameter] public bool Visible { get; set; } = true;

    /// <summary>Child <c>SgRibbonTab</c> components.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional CSS class.</summary>
    [Parameter] public string? CssClass { get; set; }

    internal SgRibbonContextualContext ContextualContext { get; } = new();

    internal string ColorClass => Color switch
    {
        SgContextualColor.Magenta => "sgc-ribbon-contextual-magenta",
        SgContextualColor.Pink    => "sgc-ribbon-contextual-pink",
        SgContextualColor.Purple  => "sgc-ribbon-contextual-purple",
        SgContextualColor.Blue    => "sgc-ribbon-contextual-blue",
        SgContextualColor.Teal    => "sgc-ribbon-contextual-teal",
        SgContextualColor.Green   => "sgc-ribbon-contextual-green",
        SgContextualColor.Orange  => "sgc-ribbon-contextual-orange",
        SgContextualColor.Red     => "sgc-ribbon-contextual-red",
        _                         => "sgc-ribbon-contextual-primary"
    };

    /// <summary>Programmatically activates the first visible, non-disabled child tab (no-op if none).</summary>
    public void ActivateFirstTab() { /* no-op placeholder; user calls SgRibbon.ActivateTabByTitle or sets ActiveTabIndex directly */ }

    /// <summary>Marker for tabs nested inside an <see cref="SgRibbonContextualTabs"/>.</summary>
    internal sealed class SgRibbonContextualContext
    {
    }
}
