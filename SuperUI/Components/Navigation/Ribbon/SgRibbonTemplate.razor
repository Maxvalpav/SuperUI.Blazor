@namespace SuperUI.Components

@* Pass-through container for arbitrary custom content inside a ribbon group. *@

<div class="sgc-ribbon-template @CssClass" style="@Style">
    @ChildContent
</div>

@code {
    /// <summary>Custom content to render inside the group.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional CSS class.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Inline styles.</summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>Fixed pixel/minmax width (e.g. "120px", "minmax(120px, 1fr)").</summary>
    [Parameter] public string? Width { get; set; }

    /// <summary>Fixed pixel height.</summary>
    [Parameter] public string? Height { get; set; }
}
