@namespace SuperUI.Components
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer

<div class="sgc-ribbon-split @SizeClass @PlacementClass @(Disabled ? "sgc-ribbon-btn-disabled" : "") @(!Visible ? "sgc-ribbon-btn-hidden" : "") @CssClass"
     @onkeydown="HandleKeyDown"
     @onfocusout="HandleFocusOut"
     @onclick:stopPropagation="true">
    @* Main action button *@
    <button type="button"
            class="sgc-ribbon-split-main"
            disabled="@Disabled"
            title="@Tooltip"
            @onclick="OnMainClickAsync">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="sgc-ribbon-btn-icon">@((MarkupString)Icon)</span>
        }
        @if (!string.IsNullOrEmpty(Text))
        {
            <span class="sgc-ribbon-btn-text">@Text</span>
        }
        @if (!string.IsNullOrEmpty(KeyTip))
        {
            <span class="sgc-ribbon-keytip" aria-hidden="true">@KeyTip</span>
        }
    </button>

    @* Dropdown arrow *@
    <button type="button"
            class="sgc-ribbon-split-arrow"
            disabled="@Disabled"
            title="@Localizer["RibbonSplit_MoreVariants"]"
            aria-haspopup="true"
            aria-expanded="@(_open ? "true" : "false")"
            @onclick="ToggleDropdown"
            @onclick:stopPropagation="true">
        <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"/>
        </svg>
    </button>

    @* Dropdown menu *@
    @if (_open && DropdownContent is not null)
    {
        <div class="sgc-ribbon-split-menu" @onclick:stopPropagation="true">
            @DropdownContent
        </div>
    }
</div>

@code {
    private bool _open;

    /// <summary>Button label text.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>SVG icon markup.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Tooltip text.</summary>
    [Parameter] public string? Tooltip { get; set; }

    /// <summary>Button display size. Default is <see cref="SgRibbonButtonSize.Large"/>.</summary>
    [Parameter] public SgRibbonButtonSize Size { get; set; } = SgRibbonButtonSize.Large;

    /// <summary>Where the dropdown opens relative to the button. Default <see cref="SgRibbonSplitPlacement.BottomEnd"/>.</summary>
    [Parameter] public SgRibbonSplitPlacement Placement { get; set; } = SgRibbonSplitPlacement.BottomEnd;

    /// <summary>When true, the button is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>When false, the button is hidden.</summary>
    [Parameter] public bool Visible { get; set; } = true;

    /// <summary>Single-letter Alt+key shortcut for the main action.</summary>
    [Parameter] public string? KeyTip { get; set; }

    /// <summary>Single-letter Alt+key shortcut for the dropdown arrow.</summary>
    [Parameter] public string? KeyTipArrow { get; set; }

    /// <summary>Main action click callback.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>Called when a child <c>SgRibbonMenuItem</c> inside <see cref="DropdownContent"/> is clicked.</summary>
    [Parameter] public EventCallback<SgRibbonMenuItem> OnSelect { get; set; }

    /// <summary>Content rendered inside the dropdown menu.</summary>
    [Parameter] public RenderFragment? DropdownContent { get; set; }

    /// <summary>Additional CSS class.</summary>
    [Parameter] public string? CssClass { get; set; }

    private string SizeClass => Size switch
    {
        SgRibbonButtonSize.Small => "sgc-ribbon-btn-sm",
        SgRibbonButtonSize.Medium => "sgc-ribbon-btn-md",
        _ => "sgc-ribbon-btn-lg"
    };

    private string PlacementClass => Placement switch
    {
        SgRibbonSplitPlacement.BottomStart => "sgc-ribbon-split-placement-bottom-start",
        SgRibbonSplitPlacement.Bottom      => "sgc-ribbon-split-placement-bottom",
        SgRibbonSplitPlacement.RightStart  => "sgc-ribbon-split-placement-right-start",
        SgRibbonSplitPlacement.RightEnd    => "sgc-ribbon-split-placement-right-end",
        _                                  => "sgc-ribbon-split-placement-bottom-end"
    };

    private async Task OnMainClickAsync(MouseEventArgs e)
    {
        if (Disabled) return;
        _open = false;
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(e);
    }

    private void ToggleDropdown()
    {
        if (!Disabled) _open = !_open;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _open)
        {
            _open = false;
        }
    }

    private async Task HandleFocusOut(FocusEventArgs e)
    {
        if (!_open) return;
        // Defer slightly so any click-outside completes before we close.
        await Task.Yield();
        if (_open) _open = false;
    }

    /// <summary>Closes the dropdown (called by parent ribbon or by child menu items via cascading parameter).</summary>
    internal void CloseDropdown() => _open = false;
}
