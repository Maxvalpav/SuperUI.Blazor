@namespace SuperUI.Components
@using Microsoft.AspNetCore.Components.Web
@using SuperUI.Base.ComponentBases
@inherits SgJsComponentBase

@if (_visible)
{
    <div class="sgc-command-palette-overlay" @onclick="Close">
        <div class="sgc-command-palette" @onclick:stopPropagation="true">
            <div class="sgc-command-palette-search">
                <div class="sgc-command-palette-input-wrapper">
                    <SgIcon Icon="@SgIcons.Search" />
                    <input type="text" @ref="_searchInput" placeholder="@Placeholder" @oninput="OnSearchInput" @onkeydown="OnKeyDown" />
                    <div class="sgc-command-palette-hotkey-hint">ESC</div>
                </div>
            </div>
            <div class="sgc-command-palette-results">
                @if (!_filteredGroups.Any())
                {
                    <div class="sgc-command-palette-empty">Ничего не найдено</div>
                }
                @foreach (var group in _filteredGroups)
                {
                    <div class="sgc-command-group">
                        <div class="sgc-command-group-title">@group.Title</div>
                        @foreach (var command in group.Commands)
                        {
                            <div class="sgc-command-item @(command == _selectedCommand ? "selected" : "")" @onclick="() => ExecuteCommand(command)">
                                <span class="sgc-command-icon">@(command.Icon ?? (RenderFragment)(builder => builder.AddContent(0, "•")))</span>
                                <span class="sgc-command-text">@command.Text</span>
                                @if (!string.IsNullOrEmpty(command.Shortcut))
                                {
                                    <span class="sgc-command-shortcut">@command.Shortcut</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="sgc-command-palette-footer">
                <span><kbd>↑↓</kbd> Навигация</span>
                <span><kbd>Enter</kbd> Выбрать</span>
            </div>
        </div>
    </div>
}

<style>
    .sgc-command-palette-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(4px);
        display: flex;
        justify-content: center;
        padding-top: 15vh;
        z-index: 9999;
        animation: sgc-fade-in 0.2s ease-out;
    }

    .sgc-command-palette {
        background: var(--sg-surface, #fff);
        width: 640px;
        max-height: 480px;
        border-radius: 12px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid var(--sg-border, #eee);
        animation: sgc-slide-down 0.2s ease-out;
    }

    .sgc-command-palette-search {
        padding: 16px;
        border-bottom: 1px solid var(--sg-divider, #eee);
    }

    .sgc-command-palette-input-wrapper {
        display: flex;
        align-items: center;
        padding: 0 16px;
        height: 48px;
        background: var(--sg-bg-alt, #f5f5f5);
        border-radius: 24px;
        border: 2px solid transparent;
        transition: border-color 0.2s;
    }

    .sgc-command-palette-input-wrapper:focus-within {
        border-color: var(--sg-primary, #1890ff);
        background: #fff;
    }

    .sgc-command-palette-search input {
        border: none;
        outline: none;
        flex: 1;
        font-size: 16px;
        margin-left: 12px;
        background: transparent;
        color: var(--sg-text, #333);
    }

    .sgc-command-palette-hotkey-hint {
        font-size: 10px;
        background: #fff;
        padding: 2px 6px;
        border-radius: 4px;
        border: 1px solid #ddd;
        color: #999;
    }

    .sgc-command-palette-results {
        overflow-y: auto;
        padding: 8px;
        flex: 1;
    }

    .sgc-command-palette-empty {
        padding: 32px;
        text-align: center;
        color: #999;
    }

    .sgc-command-group-title {
        font-size: 11px;
        font-weight: 600;
        color: var(--sg-text-secondary, #999);
        padding: 12px 12px 4px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .sgc-command-item {
        padding: 12px;
        display: flex;
        align-items: center;
        border-radius: 8px;
        cursor: pointer;
        margin: 2px 4px;
        transition: all 0.1s;
    }

    .sgc-command-item.selected {
        background: var(--sg-primary, #1890ff);
        color: #fff;
    }

    .sgc-command-item:not(.selected):hover {
        background: var(--sg-bg-alt, #f5f5f5);
    }

    .sgc-command-icon {
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0.7;
    }

    .sgc-command-item.selected .sgc-command-icon {
        opacity: 1;
    }

    .sgc-command-text {
        flex: 1;
        margin-left: 12px;
        font-size: 14px;
    }

    .sgc-command-shortcut {
        font-size: 11px;
        opacity: 0.6;
        background: rgba(0,0,0,0.1);
        padding: 2px 6px;
        border-radius: 4px;
        font-family: monospace;
    }

    .sgc-command-palette-footer {
        padding: 12px 16px;
        background: var(--sg-bg-alt, #fafafa);
        border-top: 1px solid var(--sg-divider, #eee);
        display: flex;
        gap: 16px;
        font-size: 12px;
        color: #888;
    }

    .sgc-command-palette-footer kbd {
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 3px;
        padding: 1px 4px;
        font-family: inherit;
    }

    @@keyframes sgc-fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes sgc-slide-down {
        from { transform: translateY(-20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
</style>

@code {
    private bool _visible;
    private string _search = "";
    private ElementReference _searchInput;
    private List<SgCommandGroup> _groups = new();
    private List<SgCommandGroup> _filteredGroups = new();
    private SgCommand? _selectedCommand;

    [Parameter] public string Placeholder { get; set; } = "Поиск команд...";

    protected override string ModulePath => "./_content/SuperUI/superui-command-palette.js";

    protected override async ValueTask OnInteractiveAsync()
    {
        await SafeInvokeVoidAsync("init", SelfRef);
    }

    public async Task Open()
    {
        _visible = true;
        _search = "";
        FilterCommands();
        StateHasChanged();
        await Task.Delay(50); // Даем время на рендер
        await _searchInput.FocusAsync();
    }

    public void Close()
    {
        _visible = false;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task HandleGlobalHotkey()
    {
        if (!_visible) await Open();
        else Close();
    }

    public void RegisterGroup(SgCommandGroup group)
    {
        if (!_groups.Any(g => g.Title == group.Title))
        {
            _groups.Add(group);
            FilterCommands();
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        FilterCommands();
    }

    private void FilterCommands()
    {
        _filteredGroups = _groups.Select(g => new SgCommandGroup
        {
            Title = g.Title,
            Commands = g.Commands.Where(c => 
                string.IsNullOrEmpty(_search) || 
                c.Text.Contains(_search, StringComparison.OrdinalIgnoreCase)
            ).ToList()
        }).Where(g => g.Commands.Any()).ToList();

        _selectedCommand = _filteredGroups.FirstOrDefault()?.Commands.FirstOrDefault();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Close();
        else if (e.Key == "Enter" && _selectedCommand != null) ExecuteCommand(_selectedCommand);
        else if (e.Key == "ArrowDown" || e.Key == "ArrowUp")
        {
            Navigate(e.Key == "ArrowDown" ? 1 : -1);
        }
    }

    private void Navigate(int direction)
    {
        var allCommands = _filteredGroups.SelectMany(g => g.Commands).ToList();
        if (!allCommands.Any()) return;

        var currentIndex = _selectedCommand == null ? -1 : allCommands.IndexOf(_selectedCommand);
        var nextIndex = currentIndex + direction;

        if (nextIndex < 0) nextIndex = allCommands.Count - 1;
        if (nextIndex >= allCommands.Count) nextIndex = 0;

        _selectedCommand = allCommands[nextIndex];
        StateHasChanged();
    }

    private void ExecuteCommand(SgCommand command)
    {
        command.OnExecute.InvokeAsync();
        Close();
    }
}
