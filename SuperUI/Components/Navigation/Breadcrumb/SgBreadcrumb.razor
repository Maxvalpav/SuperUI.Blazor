@namespace SuperUI.Components
@using SuperUI.Enums

@inject NavigationManager Navigation
@inject ISuperUILocalizer Localizer
@using System.Globalization
@implements IDisposable

@{
    var arr = GetItems();
    var total = arr.Count;
    var showCollapsed = MaxItems.HasValue && MaxItems.Value > 0 && total > MaxItems.Value;
    var half = showCollapsed ? (MaxItems!.Value - 2) / 2 : total;
    var separatorIcon = Variant switch
    {
        SgBreadcrumbVariant.Arrow => "<svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"/></svg>",
        SgBreadcrumbVariant.Bullet => "•",
        _ => Separator
    };
}

<nav class="@GetNavClass()" role="navigation" aria-label="@AriaLabel">
    <ol class="sgc-bc-list" role="list">
        @for (var i = 0; i < total; i++)
        {
            var it = arr[i];
            var last = i == total - 1;
            var isCollapsed = showCollapsed && i > 0 && i < total - 1
                && !(i < half || i >= total - (MaxItems!.Value - half - 1));

            @if (isCollapsed && i == half)
            {
                <li class="sgc-bc-item sgc-bc-collapsed" role="listitem">
                    <button type="button" class="sgc-bc-collapse-btn" title="@CollapsedTooltip" @onclick="ToggleCollapsed">
                        <span class="sgc-bc-collapse-text">@CollapsedText</span>
                    </button>
                    <span class="sgc-bc-sep" aria-hidden="true">@GetSeparatorContent(separatorIcon)</span>
                </li>
            }

            if (!isCollapsed)
            {
                <li class="@GetItemClass(it, last)" role="listitem" style="@GetItemStyle(it)">
                    @if (ShowHomeIcon && i == 0 && string.IsNullOrEmpty(it.Icon))
                    {
                        <span class="sgc-bc-icon">@((MarkupString)HomeIcon)</span>
                    }
                    else if (!string.IsNullOrEmpty(it.Icon))
                    {
                        <span class="sgc-bc-icon">@((MarkupString)it.Icon)</span>
                    }
                    @if (!last && !string.IsNullOrEmpty(it.Href) && !it.Disabled)
                    {
                        <a class="sgc-bc-link" href="@it.Href"
                           aria-label="@it.Text"
                           @onclick="() => HandleItemClick(it)"
                           @onclick:preventDefault="false">
                            @TruncateText(it.Text)
                        </a>
                    }
                    else
                    {
                        <span class="@(last ? "sgc-bc-current" : "sgc-bc-text")"
                              aria-current="@(last ? "page" : null)">@TruncateText(it.Text)</span>
                    }
                    @if (!last)
                    {
                        <span class="sgc-bc-sep" aria-hidden="true">@GetSeparatorContent(separatorIcon)</span>
                    }
                </li>
            }
        }
    </ol>
</nav>

@code {
    private bool _collapsedExpanded;

    private string TruncateText(string text)
    {
        if (!Truncate || TruncateMaxLength <= 0 || string.IsNullOrEmpty(text)) return text;
        return text.Length <= TruncateMaxLength ? text : text[..TruncateMaxLength] + "...";
    }

    /// <summary>
    /// Gets or sets the collection of breadcrumb items to display.
    /// If not provided, items will be auto-generated from the current URI.
    /// </summary>
    [Parameter] public IEnumerable<BreadcrumbItem>? Items { get; set; }

    /// <summary>
    /// Gets or sets whether to auto-generate breadcrumbs from the current URI.
    /// Default is true if <see cref="Items"/> is not provided.
    /// </summary>
    [Parameter] public bool AutoGenerate { get; set; } = true;

    /// <summary>
    /// Gets or sets the separator content displayed between breadcrumb items.
    /// Default is "/". Can be HTML/SVG markup for custom separators.
    /// </summary>
    [Parameter] public string Separator { get; set; } = "/";

    /// <summary>
    /// Gets or sets the breadcrumb visual variant: Slash (default), Arrow, or Bullet.
    /// </summary>
    [Parameter] public SgBreadcrumbVariant Variant { get; set; } = SgBreadcrumbVariant.Slash;

    /// <summary>
    /// Gets or sets the size variant of the breadcrumb.
    /// Supports <see cref="SgSize.Sm"/>, <see cref="SgSize.Md"/> (default), and <see cref="SgSize.Lg"/>.
    /// </summary>
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;

    /// <summary>
    /// Gets or sets the maximum number of items to display before collapsing.
    /// Set to 0 or null to disable collapsing. Default is null (no collapse).
    /// </summary>
    [Parameter] public int? MaxItems { get; set; }

    /// <summary>
    /// Gets or sets the text displayed for collapsed breadcrumb items. Default is "...".
    /// </summary>
    [Parameter] public string CollapsedText { get; set; } = "...";

    /// <summary>
    /// Gets or sets the tooltip for the collapsed expand button.
    /// </summary>
    [Parameter] public string CollapsedTooltip { get; set; } = "Show all breadcrumbs";

    /// <summary>
    /// Gets or sets the aria-label for the breadcrumb navigation landmark.
    /// </summary>
    [Parameter] public string AriaLabel { get; set; } = "Breadcrumb";

    /// <summary>
    /// Gets or sets whether to show a home icon on the first breadcrumb item.
    /// Default is false.
    /// </summary>
    [Parameter] public bool ShowHomeIcon { get; set; }

    /// <summary>
    /// Gets or sets the SVG/HTML markup for the home icon. Default is a house SVG icon.
    /// </summary>
    [Parameter] public string HomeIcon { get; set; } = "<svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/><polyline points=\"9 22 9 12 15 12 15 22\"/></svg>";

    /// <summary>
    /// Gets or sets whether to truncate long breadcrumb text.
    /// </summary>
    [Parameter] public bool Truncate { get; set; }

    /// <summary>
    /// Gets or sets the maximum character length before truncation. Default is 20.
    /// </summary>
    [Parameter] public int TruncateMaxLength { get; set; } = 20;

    /// <summary>
    /// Gets or sets additional CSS classes to apply to the component.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Fired when any breadcrumb link is clicked, with the clicked item.
    /// </summary>
    [Parameter] public EventCallback<BreadcrumbItem> OnItemClick { get; set; }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private string GetNavClass()
    {
        var sizeClass = Size switch
        {
            SgSize.Sm => "sgc-bc-sm",
            SgSize.Lg => "sgc-bc-lg",
            _ => ""
        };
        var variantClass = Variant switch
        {
            SgBreadcrumbVariant.Arrow => "sgc-bc-arrow",
            SgBreadcrumbVariant.Bullet => "sgc-bc-bullet",
            _ => ""
        };
        return $"sgc-bc {sizeClass} {variantClass} {CssClass}".Trim();
    }

    private string GetItemClass(BreadcrumbItem item, bool last)
    {
        var classes = new List<string> { "sgc-bc-item" };
        if (last) classes.Add("sgc-bc-item-current");
        if (item.Disabled) classes.Add("sgc-bc-item-disabled");
        return string.Join(" ", classes);
    }

    private string? GetItemStyle(BreadcrumbItem item)
    {
        return item.MaxWidth.HasValue ? $"max-width:{item.MaxWidth}px" : null;
    }

    private RenderFragment GetSeparatorContent(string icon) => builder =>
    {
        if (string.IsNullOrEmpty(icon)) return;

        if (icon.Contains('<') || icon.Contains('&'))
        {
            builder.AddMarkupContent(0, icon);
        }
        else
        {
            builder.AddContent(0, icon);
        }
    };

    private void ToggleCollapsed()
    {
        _collapsedExpanded = !_collapsedExpanded;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (Items == null && AutoGenerate)
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleItemClick(BreadcrumbItem item)
    {
        if (OnItemClick.HasDelegate)
        {
            await OnItemClick.InvokeAsync(item);
        }
    }

    private List<BreadcrumbItem> GetItems()
    {
        if (Items != null) return Items.ToList();
        if (!AutoGenerate) return new List<BreadcrumbItem>();

        var uri = Navigation.ToBaseRelativePath(Navigation.Uri);
        var pathOnly = uri.Split('?', 2)[0];
        var parts = pathOnly
                       .Split('/', StringSplitOptions.RemoveEmptyEntries);
        var result = new List<BreadcrumbItem> { new BreadcrumbItem(Localizer["Home"], "/") };
        var path = "";

        foreach (var part in parts)
        {
            if (string.IsNullOrEmpty(part)) continue;

            path += "/" + part;
            var text = part.Replace("-", " ");
            if (text.Length > 0)
            {
                text = char.ToUpper(text[0], CultureInfo.CurrentCulture) + (text.Length > 1 ? text[1..] : "");
            }
            result.Add(new BreadcrumbItem(text, path));
        }

        return result;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}