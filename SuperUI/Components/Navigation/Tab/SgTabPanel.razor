@namespace SuperUI.Components
@using SuperUI.Enums
@implements IDisposable

@code {
    private bool _registered;

    internal readonly string TabId    = "sg-tab-"    + Guid.NewGuid().ToString("N")[..8];
    internal readonly string PanelId  = "sg-panel-"  + Guid.NewGuid().ToString("N")[..8];
    internal ElementReference TabElementRef;

    [CascadingParameter] public SgTabs? Owner { get; set; }

    /// <summary>
    /// The title text displayed on the tab header.
    /// </summary>
    [Parameter, EditorRequired] public string Title { get; set; } = default!;

    /// <summary>
    /// Optional icon rendered before the title text.
    /// </summary>
    [Parameter] public RenderFragment? Icon { get; set; }

    /// <summary>
    /// Optional badge content (e.g. count, status) displayed after the title.
    /// </summary>
    [Parameter] public object? Badge { get; set; }

    /// <summary>
    /// The visual variant for the badge. Default is <see cref="SgBadgeVariant.Default"/>.
    /// </summary>
    [Parameter] public SgBadgeVariant BadgeVariant { get; set; } = SgBadgeVariant.Default;

    /// <summary>
    /// When true, the tab cannot be selected or focused.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Optional tooltip text shown on hover over the tab header.
    /// </summary>
    [Parameter] public string? Tooltip { get; set; }

    /// <summary>
    /// The content rendered when this tab is selected.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnParametersSet()
    {
        if (!_registered && Owner != null)
        {
            _registered = true;
            Owner.Register(this);
        }
    }

    public void Dispose() => Owner?.Unregister(this);
}
