@namespace SuperUI.Components
@inject ISuperUILocalizer Localizer
@inject IJSRuntime JS

<CascadingValue Value="this" IsFixed="true">
    @ChildContent
    <div class="sgc-tabs @GetVariantClass() @(Vertical ? "sgc-tabs-vertical" : "") @GetAlignClass() @GetSizeClass() @(Scrollable ? "sgc-tabs-scrollable" : "") @CssClass" style="@Style">
        <div class="sgc-tabs-strip" role="tablist" @ref="_stripRef">
            @if (AddOnBefore is not null)
            {
                <div class="sgc-tabs-addon sgc-tabs-addon-before">@AddOnBefore</div>
            }
            @foreach (var t in _tabs)
            {
                var tLocal = t;
                var isActive = _active == tLocal;
                <div class="sgc-tab @(isActive ? "sgc-active" : "") @(tLocal.Disabled ? "sgc-disabled" : "")"
                     role="tab"
                     id="@tLocal.TabId"
                     aria-selected="@(isActive ? "true" : "false")"
                     aria-disabled="@(tLocal.Disabled ? "true" : null)"
                     aria-controls="@tLocal.PanelId"
                     tabindex="@(isActive ? "0" : "-1")"
                     title="@tLocal.Tooltip"
                     @ref="tLocal.TabElementRef"
                     @onclick="() => { if (!tLocal.Disabled) _ = ActivateAsync(tLocal); }"
                     @onkeydown="@(e => OnKeyDownAsync(e, tLocal))">
                    @if (tLocal.Icon is not null)
                    {
                        <span class="sgc-tab-icon">@tLocal.Icon</span>
                    }
                    <span class="sgc-tab-text">@tLocal.Title</span>
                    @if (tLocal.Badge is not null)
                    {
                        <SgBadge Variant="@tLocal.BadgeVariant" CssClass="sgc-tab-badge">@tLocal.Badge</SgBadge>
                    }
                </div>
            }
            @if (AddOnAfter is not null)
            {
                <div class="sgc-tabs-addon sgc-tabs-addon-after">@AddOnAfter</div>
            }
        </div>
        <div class="sgc-tabs-body">
            @if (!_tabs.Any())
            {
                <div class="sgc-tabs-empty">@Localizer["Common_NoData"]</div>
            }
            else if (_active is not null)
            {
                <div role="tabpanel"
                     id="@_active.PanelId"
                     aria-labelledby="@_active.TabId"
                     tabindex="0">
                    @_active.ChildContent
                </div>
            }
        </div>
    </div>
</CascadingValue>

@code {
    private readonly List<SgTabPanel> _tabs = new();
    private SgTabPanel? _active;
    private ElementReference _stripRef;

    /// <summary>
    /// Whether to display tabs vertically (side panel layout).
    /// </summary>
    [Parameter] public bool Vertical { get; set; }

    /// <summary>
    /// When true, the tab strip becomes horizontally scrollable if tabs overflow.
    /// Useful for many tabs in constrained containers.
    /// </summary>
    [Parameter] public bool Scrollable { get; set; }

    /// <summary>
    /// The visual variant of the tab strip. Default is <see cref="SgTabsVariant.Line"/>.
    /// </summary>
    [Parameter] public SgTabsVariant Variant { get; set; } = SgTabsVariant.Line;

    /// <summary>
    /// Horizontal alignment of tab headers within the strip. Default is <see cref="SgTabsAlign.Start"/>.
    /// </summary>
    [Parameter] public SgTabsAlign Align { get; set; } = SgTabsAlign.Start;

    /// <summary>
    /// Size of the tab headers. Default is <see cref="SgSize.Md"/>.
    /// </summary>
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;

    /// <summary>
    /// Gets or sets the child content containing <see cref="SgTabPanel"/> components.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Optional content rendered at the start of the tab strip (before tab headers).
    /// </summary>
    [Parameter] public RenderFragment? AddOnBefore { get; set; }

    /// <summary>
    /// Optional content rendered at the end of the tab strip (after tab headers).
    /// </summary>
    [Parameter] public RenderFragment? AddOnAfter { get; set; }

    /// <summary>
    /// Gets or sets additional CSS class names to apply to the tabs container.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Gets or sets additional inline CSS styles to apply to the tabs container.
    /// </summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>
    /// Gets or sets the title of the currently active tab for two-way binding.
    /// </summary>
    [Parameter] public string? ActiveTitle { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the active tab changes.
    /// </summary>
    [Parameter] public EventCallback<string> ActiveTitleChanged { get; set; }

    private string GetVariantClass() => Variant switch
    {
        SgTabsVariant.Card => "sgc-tabs-card",
        SgTabsVariant.Pills => "sgc-tabs-pill",
        SgTabsVariant.Underline => "sgc-tabs-underline",
        _ => ""
    };

    private string GetAlignClass() => Align switch
    {
        SgTabsAlign.Center => "sgc-tabs-align-center",
        SgTabsAlign.End => "sgc-tabs-align-end",
        _ => ""
    };

    private string GetSizeClass() => Size switch
    {
        SgSize.Sm => "sgc-tabs-sm",
        SgSize.Lg => "sgc-tabs-lg",
        _ => ""
    };

    internal void Register(SgTabPanel panel)
    {
        if (_tabs.Contains(panel)) return;
        _tabs.Add(panel);
        if (_active is null || (ActiveTitle is not null && panel.Title == ActiveTitle))
            _active = panel;
        _ = InvokeAsync(StateHasChanged);
    }

    internal void Unregister(SgTabPanel panel)
    {
        _tabs.Remove(panel);
        if (_active == panel) _active = _tabs.FirstOrDefault(t => !t.Disabled);
        _ = InvokeAsync(StateHasChanged);
    }

    internal bool IsActive(SgTabPanel panel) => _active == panel;

    private async Task ActivateAsync(SgTabPanel tab)
    {
        if (_active == tab) return;
        _active = tab;
        if (ActiveTitleChanged.HasDelegate)
            await ActiveTitleChanged.InvokeAsync(tab.Title);
        await InvokeAsync(StateHasChanged);

        if (Scrollable)
        {
            try
            {
                await JS.InvokeVoidAsync("eval",
                    $"document.getElementById('{tab.TabId}')?.scrollIntoView({{behavior:'smooth',block:'nearest',inline:'nearest'}})");
            }
            catch { }
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e, SgTabPanel tab)
    {
        var index = _tabs.IndexOf(tab);
        if (index < 0) return;

        SgTabPanel? target = null;

        if (e.Key == "ArrowRight")
        {
            for (var i = 1; i <= _tabs.Count; i++)
            {
                var t = _tabs[(index + i) % _tabs.Count];
                if (!t.Disabled) { target = t; break; }
            }
        }
        else if (e.Key == "ArrowLeft")
        {
            for (var i = 1; i <= _tabs.Count; i++)
            {
                var t = _tabs[(index - i + _tabs.Count) % _tabs.Count];
                if (!t.Disabled) { target = t; break; }
            }
        }
        else if (e.Key == "Home")
        {
            target = _tabs.FirstOrDefault(t => !t.Disabled);
        }
        else if (e.Key == "End")
        {
            target = _tabs.LastOrDefault(t => !t.Disabled);
        }
        else if (e.Key == "Enter" || e.Key == " ")
        {
            target = tab.Disabled ? null : tab;
        }

        if (target is not null)
        {
            await ActivateAsync(target);

            // Roving tabindex: ActivateAsync re-renders so `target` now has tabindex=0 and the
            // previously-focused tab has tabindex=-1. Without moving DOM focus here, focus would be
            // stranded on the now-unfocusable old tab, breaking Arrow/Home/End keyboard navigation.
            try { await target.TabElementRef.FocusAsync(); }
            catch (JSException) { /* element gone (unmounted mid-nav) */ }
            catch (InvalidOperationException) { /* ref not yet assigned */ }
        }
    }
}
