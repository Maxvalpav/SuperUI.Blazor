@namespace SuperUI.Components
@implements IDisposable
@inject IJSRuntime JS
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer

<SgSelect TValue="string" 
          Items="_languages"
          LabelSelector="GetLanguageLabel"
          @bind-Value="CurrentLanguage"
          Placeholder="@Localizer["LanguageSwitcher_Placeholder"]"
          Style="width: 150px;" />

@code {
    private readonly List<string> _languages = new() { "en-US", "ru-RU" };
    private string _currentLanguage = "en-US";

    private string CurrentLanguage
    {
        get => _currentLanguage;
        set
        {
            if (_currentLanguage != value)
            {
                _currentLanguage = value;
                var locale = MapToLocale(value);
                Localizer.SetLanguage(locale);
                _ = PersistLanguageAsync(locale);
            }
        }
    }

    protected override void OnInitialized()
    {
        _currentLanguage = Localizer.CurrentLanguage switch
        {
            "en" => "en-US",
            "ru" => "ru-RU",
            _ => "en-US"
        };
        Localizer.OnLocaleChanged += HandleLocaleChanged;
    }

    private void HandleLocaleChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Localizer.OnLocaleChanged -= HandleLocaleChanged;
    }

    private async Task PersistLanguageAsync(string locale)
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "sui-language", locale);
        }
        catch { }
    }

    private string GetLanguageLabel(string lang)
    {
        return lang switch
        {
            "en-US" => Localizer["Language_English"],
            "ru-RU" => Localizer["Language_Russian"],
            _ => lang
        };
    }

    private static string MapToLocale(string displayCode) => displayCode switch
    {
        "en-US" => "en",
        "ru-RU" => "ru",
        _ => "en"
    };
}
