@namespace SuperUI.Components
@using SuperUI.Components.Navigation.Tour

@code {
    [CascadingParameter] public SgTour? Tour { get; set; }

    /// <summary>CSS selector of the target element to highlight.</summary>
    [Parameter] public string? Target { get; set; }
    /// <summary>Title text displayed in the step popover.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>Body content text displayed in the step popover.</summary>
    [Parameter] public string? Content { get; set; }
    /// <summary>Placement of the popover relative to the target element.</summary>
    [Parameter] public SgTourPlacement Placement { get; set; } = SgTourPlacement.Bottom;
    /// <summary>Whether to mask the background with a dark overlay.</summary>
    [Parameter] public bool Mask { get; set; } = true;
    /// <summary>Custom content rendered in the step body. Overrides <see cref="Content"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Custom content rendered in the step header. Overrides <see cref="Title"/>.</summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    protected override void OnInitialized()
    {
        Tour?.AddStep(this);
    }
}
