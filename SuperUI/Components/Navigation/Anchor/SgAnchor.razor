@namespace SuperUI.Components
@inherits SgJsComponentBase
@using SuperUI.Localization
<div class="@Css("sgc-anchor").AddClass(Position.ToLowerInvariant()).AddClass(Orientation.ToLowerInvariant()).Build()" 
     style="@Styles().NullIfEmpty()" 
     @ref="RootRef"
     @attributes="AdditionalAttributes">
    
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="sgc-anchor-title">@Title</div>
    }
    
     <nav class="sgc-anchor-nav" aria-label="@Localizer["SgAnchor_NavigationAriaLabel"]">
        @foreach (var item in ProcessedItems)
        {
            <a href="#@item.Id" 
               class="sgc-anchor-link @(item.Level > 2 ? "sgc-anchor-sub" : "") @(item.IsActive ? "active" : "")"
               style="padding-left: @(GetIndent(item.Level))rem"
               @onclick="() => ScrollToAsync(item.Id)"
               @onclick:preventDefault
               title="@item.Title">
                @if (!string.IsNullOrEmpty(item.Icon))
                {
                    <span class="sgc-anchor-icon">@item.Icon</span>
                }
                <span class="sgc-anchor-text">@item.Title</span>
                @if (ShowBadge && item.Level == 2)
                {
                    <span class="sgc-anchor-badge">H@(item.Level)</span>
                }
            </a>
        }
    </nav>
    
    @if (ShowScrollProgress)
    {
        <div class="sgc-anchor-progress">
            <div class="sgc-anchor-progress-bar" style="width: @(_scrollProgress)%"></div>
        </div>
    }
</div>

@code {
    private string? _activeId;
    private double _scrollProgress;

    protected override string ModulePath => "./_content/SuperUI/Components/Navigation/Anchor/SgAnchor.razor.js";
    protected override string IdPrefix   => "sg-anchor";
    
    /// <summary>Optional title displayed above the anchor links.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>Manual list of anchor items. Ignored when <see cref="AutoScan"/> is true.</summary>
    [Parameter] public List<AnchorItem> Items { get; set; } = new();
    /// <summary>If true, automatically scans the page for headings matching <see cref="Selector"/>.</summary>
    [Parameter] public bool AutoScan { get; set; } = true;
    /// <summary>CSS selector for headings to scan (e.g. "h2, h3, h4").</summary>
    [Parameter] public string Selector { get; set; } = "h2, h3, h4";
    /// <summary>Scroll offset in pixels from the top when navigating to an anchor.</summary>
    [Parameter] public int Offset { get; set; } = 80;
    /// <summary>CSS position value ("Sticky", "Fixed", or "Relative").</summary>
    [Parameter] public string Position { get; set; } = "Sticky";
    /// <summary>Layout orientation ("Vertical" or "Horizontal").</summary>
    [Parameter] public string Orientation { get; set; } = "Vertical";
    /// <summary>Whether to show heading level badges next to sub-items.</summary>
    [Parameter] public bool ShowBadge { get; set; } = false;
    /// <summary>Whether to show a scroll progress indicator bar.</summary>
    [Parameter] public bool ShowScrollProgress { get; set; } = false;
    /// <summary>Callback invoked when the active anchor changes.</summary>
    [Parameter] public EventCallback<string> OnAnchorChanged { get; set; }
    
    public List<AnchorItem> ProcessedItems { get; private set; } = new();
    
    protected override async ValueTask OnInteractiveAsync()
    {
        if (AutoScan && Items.Count == 0)
        {
            await ScanHeadersAsync();
        }
        else
        {
            ProcessedItems = Items.Select(x => x.WithIsActive(false)).ToList();
        }
        
        await SafeInvokeVoidAsync("init", SelfRef, Selector, Offset);
    }
    
    private int GetIndent(int level) => Math.Max(0, level - 2);
    
    public async Task ScrollToAsync(string id) =>
        await SafeInvokeVoidAsync("scrollTo", id, Offset);
    
    /// <summary>
    /// Scans the document for headings matching <see cref="Selector"/> and populates <see cref="ProcessedItems"/>.
    /// </summary>
    public async Task ScanHeadersAsync()
    {
        if (!IsInteractive) return;
        var headers = await SafeInvokeAsync<List<AnchorItem>>("scanHeaders", Selector);
        if (headers != null)
        {
            ProcessedItems = headers.Select(x => x.WithIsActive(false)).ToList();
            StateHasChanged();
        }
    }
    
    [JSInvokable]
    public void UpdateActiveAnchor(string id, double progress)
    {
        _activeId = id;
        _scrollProgress = progress;
        
        var newList = new List<AnchorItem>();
        foreach (var item in ProcessedItems)
        {
            newList.Add(item.WithIsActive(item.Id == id));
        }
        ProcessedItems = newList;
        
        InvokeAsync(() => StateHasChanged());
        
        if (OnAnchorChanged.HasDelegate)
        {
            OnAnchorChanged.InvokeAsync(id);
        }
    }
    
    protected override async ValueTask OnDisposingAsync()
    {
        await SafeInvokeVoidAsync("dispose");
    }
}