@namespace SuperUI.Components
@typeparam TValue

<div class="sgc-segmented @SizeClass @(_block ? "sgc-block" : "") @CssClass"
     role="tablist"
     aria-label="@AriaLabel">
    @{
        var optionList = Options as IList<SgSegmentedOption<TValue>> ?? Options.ToList();
    }
    @for (var i = 0; i < optionList.Count; i++)
    {
        var idx = i;
        var o = optionList[idx];
        var isActive = EqualityComparer<TValue>.Default.Equals(Value, o.Value);
        var isDisabled = Disabled || o.Disabled;
        <button type="button"
                class="sgc-segmented-item @(isActive ? "sgc-active" : "") @(isDisabled ? "sgc-disabled" : "")"
                role="tab"
                aria-selected="@(isActive ? "true" : "false")"
                disabled="@isDisabled"
                tabindex="@(isActive ? 0 : -1)"
                @onclick="() => SelectAsync(o.Value)">
            @if (o.Icon is not null)
            {
                <span class="sgc-segmented-icon">@o.Icon</span>
            }
            <span>@o.Label</span>
        </button>
    }
</div>

@code {
    /// <summary>
    /// Gets or sets the collection of segmented options to display.
    /// </summary>
    [Parameter] public IEnumerable<SgSegmentedOption<TValue>> Options { get; set; } = Array.Empty<SgSegmentedOption<TValue>>();

    /// <summary>
    /// Gets or sets the currently selected value.
    /// </summary>
    [Parameter] public TValue? Value { get; set; }

    /// <summary>
    /// Callback invoked when the selected value changes.
    /// </summary>
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }

    /// <summary>
    /// Gets or sets whether the control should take full width of its container.
    /// </summary>
    [Parameter] public bool Block { get; set; }

    /// <summary>
    /// Gets or sets whether all segments are disabled.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets the size of the segmented control.
    /// Supported values: "sm", "md", "lg". Default is "md".
    /// See <see cref="SgSize"/> for available values.
    /// </summary>
    [Parameter] public string Size { get; set; } = "md";

    /// <summary>
    /// Gets or sets the accessible label for the control.
    /// </summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// Gets or sets additional CSS class names to apply to the container.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    private bool _block => Block;

    private string SizeClass => Size switch
    {
        "sm" => "sgc-segmented-sm",
        "lg" => "sgc-segmented-lg",
        _ => ""
    };

    private async Task SelectAsync(TValue? value)
    {
        if (Disabled) return;
        if (EqualityComparer<TValue>.Default.Equals(value, Value)) return;

        Value = value;
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(value);
        }
    }
}
