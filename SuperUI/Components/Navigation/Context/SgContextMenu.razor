@namespace SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Services
@inherits SgOverlayComponentBase

<div class="@Css("sgc-context-menu-wrap").Build()"
     @ref="RootRef"
     @oncontextmenu="OnContextMenuAsync"
     @oncontextmenu:preventDefault="true"
     @attributes="AdditionalAttributes">
    @ChildContent
    
    @if (Visible || IsClosing)
    {
        <div class="@Css("sgc-context-menu").AddClass("sgc-closing", IsClosing).Build()"
             style="@GetMenuStyle()"
             role="menu"
             tabindex="-1"
             @onclick:stopPropagation="true">
            @MenuContent
        </div>
    }
</div>

@code {
    private double _x;
    private double _y;

    protected override string ModulePath => "./_content/SuperUI/superui-contextmenu.js";
    protected override int ZIndexBase    => SgZIndexService.PopoverBase;
    protected override string IdPrefix   => "sg-ctxmenu";

    // ── Параметры ────────────────────────────────────────────────────────

    /// <summary>
    /// Содержимое, на котором появляется меню (триггер).
    /// </summary>
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Пункты контекстного меню.
    /// </summary>
    [Parameter, EditorRequired] public RenderFragment? MenuContent { get; set; }

    /// <summary>
    /// Закрывать меню по клику вне. По умолчанию true.
    /// </summary>
    [Parameter] public bool CloseOnOutsideClick { get; set; } = true;

    /// <summary>
    /// Закрывать по ESC. По умолчанию true.
    /// </summary>
    [Parameter] public bool CloseOnEscape { get; set; } = true;

    // ── Lifecycle ─────────────────────────────────────────────────────────

    protected override async ValueTask OnOpeningAsync()
    {
        await SafeInvokeVoidAsync("attach", RootRef, SelfRef,
            CloseOnOutsideClick, CloseOnEscape, _x, _y);
    }

    protected override async ValueTask OnClosingAsync()
    {
        await SafeInvokeVoidAsync("detach", RootRef);
    }

    // ── Computed ─────────────────────────────────────────────────────────

    private string GetMenuStyle() =>
        Styles()
            .AddStyle("z-index", ZIndexValue.ToString(), ZIndexValue > 0)
            .AddStyle("left", $"{_x}px")
            .AddStyle("top",  $"{_y}px")
            .Build();

    // ── Handlers ─────────────────────────────────────────────────────────

    private async Task OnContextMenuAsync(MouseEventArgs e)
    {
        _x = e.ClientX;
        _y = e.ClientY;
        
        if (!Visible)
        {
            // Сигнализируем родителю через two-way binding
            if (VisibleChanged.HasDelegate)
                await VisibleChanged.InvokeAsync(true);
        }
    }

    [JSInvokable]
    public override Task RequestCloseAsync() => CloseAsync();
}
