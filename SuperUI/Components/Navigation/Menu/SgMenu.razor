@namespace SuperUI.Components
@using SuperUI.Enums

<CascadingValue Value="this" IsFixed="true">
    <div class="@GetCssClasses()" style="@Style" role="menu" @onkeydown="OnKeyDownAsync">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private readonly List<SgMenuItem> _items = new();
    private int _focusedIndex = -1;

    /// <summary>
    /// Gets or sets the menu content containing menu items.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the visual variant of the menu container.
    /// Supported: <c>Default</c>, <c>Bordered</c>, <c>Elevated</c>, <c>Ghost</c>.
    /// </summary>
    [Parameter] public SgMenuVariant Variant { get; set; } = SgMenuVariant.Default;

    /// <summary>
    /// Gets or sets the size of the menu items.
    /// Supported: <c>Sm</c>, <c>Md</c> (default), <c>Lg</c>.
    /// </summary>
    [Parameter] public SgSize Size { get; set; } = SgSize.Md;

    /// <summary>
    /// Gets or sets whether the menu uses compact padding.
    /// </summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes to apply to the component.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Gets or sets additional inline styles to apply to the component.
    /// </summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the menu is closed (Escape key).
    /// </summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Fires when any non-disabled menu item is clicked.
    /// </summary>
    [Parameter] public EventCallback<SgMenuItem> OnItemClick { get; set; }

    private string GetCssClasses()
    {
        var classes = new List<string> { "sgc-menu" };
        classes.Add(Variant switch
        {
            SgMenuVariant.Bordered => "sgc-menu-bordered",
            SgMenuVariant.Elevated => "sgc-menu-elevated",
            SgMenuVariant.Ghost    => "sgc-menu-ghost",
            _ => ""
        });
        if (Size == SgSize.Sm) classes.Add("sgc-menu-sm");
        else if (Size == SgSize.Lg) classes.Add("sgc-menu-lg");
        if (Compact) classes.Add("sgc-menu-compact");
        if (!string.IsNullOrEmpty(CssClass)) classes.Add(CssClass);
        return string.Join(" ", classes.Where(c => !string.IsNullOrEmpty(c)));
    }

    internal void RegisterItem(SgMenuItem item)
    {
        if (_items.Contains(item)) return;
        _items.Add(item);
    }

    internal void UnregisterItem(SgMenuItem item)
    {
        _items.Remove(item);
        if (_focusedIndex >= _items.Count)
            _focusedIndex = _items.Count - 1;
    }

    internal async Task NotifyItemClicked(SgMenuItem item)
    {
        if (OnItemClick.HasDelegate)
            await OnItemClick.InvokeAsync(item);
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown":
            {
                var next = _focusedIndex + 1;
                if (next >= _items.Count) next = 0;
                _focusedIndex = next;
                await FocusItemAsync(_focusedIndex);
                break;
            }
            case "ArrowUp":
            {
                var prev = _focusedIndex - 1;
                if (prev < 0) prev = _items.Count - 1;
                _focusedIndex = prev;
                await FocusItemAsync(_focusedIndex);
                break;
            }
            case "Home":
            {
                _focusedIndex = 0;
                await FocusItemAsync(_focusedIndex);
                break;
            }
            case "End":
            {
                _focusedIndex = _items.Count - 1;
                await FocusItemAsync(_focusedIndex);
                break;
            }
            case "Escape":
            {
                // Close all open sub-menus
                foreach (var item in _items)
                    item.CloseSubMenu();
                if (OnClose.HasDelegate)
                    await OnClose.InvokeAsync();
                break;
            }
        }
    }

    private async Task FocusItemAsync(int index)
    {
        if (index >= 0 && index < _items.Count)
        {
            await _items[index].FocusAsync();
        }
    }
}
