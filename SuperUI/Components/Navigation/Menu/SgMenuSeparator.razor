@namespace SuperUI.Components

@if (!string.IsNullOrEmpty(Label))
{
    <div class="sgc-menu-header">@Label</div>
}
else
{
    <div class="sgc-menu-sep"></div>
}

@code {
    /// <summary>
    /// Gets or sets an optional label for a grouped separator (menu section header).
    /// When set, renders as a section header instead of a horizontal line.
    /// </summary>
    [Parameter] public string? Label { get; set; }
}
