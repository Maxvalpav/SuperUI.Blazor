@namespace SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer

@{
    var navClass = string.Join(" ", new[]
    {
        "sgc-nav",
        Mini ? "sgc-nav-mini" : "",
        Orientation == SgOrientation.Horizontal ? "sgc-nav-horizontal" : "",
        Borderless ? "sgc-nav-borderless" : "",
        Rounded ? "sgc-nav-rounded" : "",
        _collapsed ? "sgc-nav-collapsed" : "",
        CssClass
    }.Where(x => !string.IsNullOrEmpty(x)));
    var navStyle = !string.IsNullOrEmpty(Width) ? $"--sgc-nav-w: {Width};" : null;
}
<nav class="@navClass" style="@navStyle">
    <div class="sgc-nav-header">
            @if (!Mini)
            {
                @if (HeaderContent is not null)
                {
                    @HeaderContent
                }
                else if (LogoContent is not null)
                {
                    <div class="sgc-nav-logo">@LogoContent</div>
                }
                else if (!string.IsNullOrEmpty(Title))
                {
                    <span class="sgc-nav-brand">@Title</span>
                }
            }
            else
            {
                <div class="sgc-nav-logo-mini">
                    <svg width="22" height="22" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
                        <rect width="32" height="32" rx="5" fill="rgba(255,255,255,0.15)"/>
                        <rect x="3" y="3" width="12" height="12" rx="2" fill="rgba(255,255,255,0.9)"/>
                        <rect x="17" y="3" width="12" height="12" rx="2" fill="rgba(255,255,255,0.4)"/>
                        <rect x="3" y="17" width="12" height="12" rx="2" fill="rgba(255,255,255,0.4)"/>
                        <rect x="17" y="17" width="12" height="12" rx="2" fill="rgba(255,255,255,0.15)"/>
                        <rect x="20" y="20" width="6" height="6" rx="1.5" fill="rgba(255,255,255,0.7)"/>
                    </svg>
                </div>
            }
            @if (Collapsible)
            {
                var collapseTitle = Mini ? Localizer["Expand"] : Localizer["Collapse"];
                <button type="button" class="sgc-nav-collapse-btn" @onclick="ToggleMiniAsync" title="@collapseTitle">
                    @(Mini ? "›" : "‹")
                </button>
            }
        <button type="button" class="sgc-nav-toggle" @onclick="ToggleMobileAsync" aria-label="@Localizer["Menu"]">
            <span></span><span></span><span></span>
        </button>
    </div>
    @if (ShowSearch && !Mini)
    {
        <div class="sgc-nav-search">
            <span class="sgc-nav-search-icon">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </span>
            <input type="text"
                   class="sgc-nav-search-input"
                   placeholder="@(!string.IsNullOrEmpty(SearchPlaceholder) ? SearchPlaceholder : Localizer["Grid_SearchPlaceholder"])"
                   @bind-value="SearchQuery"
                   @bind-value:event="oninput"
                   aria-label="@(!string.IsNullOrEmpty(SearchPlaceholder) ? SearchPlaceholder : Localizer["Grid_SearchPlaceholder"])" />
            @if (!string.IsNullOrEmpty(SearchQuery))
            {
                <button type="button" class="sgc-nav-search-clear" @onclick="ClearSearchAsync" aria-label="@Localizer["Common_Clear"]">
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            }
        </div>
    }
    <div class="sgc-nav-body">
        <CascadingValue Value="this" IsFixed="true">
            <CascadingValue Name="Mini" Value="Mini">
                    <CascadingValue Value="SearchQuery">
                        <CascadingValue Name="Accordion" Value="Accordion">
                            <CascadingValue Value="(Action<SgNavGroup>?)CollapseSiblings">
                                <CascadingValue Name="IsHorizontal" Value="Orientation == SgOrientation.Horizontal">
                                <CascadingValue Name="NavDepth" Value="0">
                                @ChildContent
                                @if (BottomContent is not null)
                                {
                                    <div class="sgc-nav-bottom">@BottomContent</div>
                                }
                                </CascadingValue>
                                </CascadingValue>
                            </CascadingValue>
                        </CascadingValue>
                    </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </div>
    @if (FooterContent is not null)
    {
        <div class="sgc-nav-footer">
            @if (!Mini) { @FooterContent }
        </div>
    }
</nav>

@if (_collapsed)
{
    <div class="sgc-nav-backdrop" @onclick="ToggleMobileAsync"></div>
}

@code {
    private bool _collapsed;
    private string _searchQuery = "";
    private readonly List<SgNavGroup> _topGroups = new();
    private readonly List<SgNavGroup> _allGroups = new();

    /// <summary>
    /// Gets or sets the navigation title.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// Gets or sets custom logo content.
    /// </summary>
    [Parameter] public RenderFragment? LogoContent { get; set; }

    /// <summary>
    /// Gets or sets custom header content (replaces logo/title).
    /// </summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    /// <summary>
    /// Gets or sets the child content (links and groups).
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets content pinned to the bottom of the nav body.
    /// </summary>
    [Parameter] public RenderFragment? BottomContent { get; set; }

    /// <summary>
    /// Gets or sets footer content.
    /// </summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Gets or sets whether the collapse button is visible. Default true.
    /// </summary>
    [Parameter] public bool Collapsible { get; set; } = true;

    /// <summary>
    /// Gets or sets whether to show a search input. Default false.
    /// </summary>
    [Parameter] public bool ShowSearch { get; set; }

    /// <summary>
    /// Gets or sets the search placeholder text.
    /// </summary>
    [Parameter]     public string SearchPlaceholder { get; set; } = "";

    /// <summary>
    /// Gets or sets whether to scroll to the active link on navigation.
    /// </summary>
    [Parameter] public bool ScrollToActive { get; set; } = true;

    /// <summary>
    /// Gets or sets whether the sidebar is in mini (icon-only) mode.
    /// </summary>
    [Parameter] public bool Mini { get; set; }

    /// <summary>
    /// Fired when the mini mode changes.
    /// </summary>
    [Parameter] public EventCallback<bool> MiniChanged { get; set; }

    /// <summary>
    /// Gets or sets whether to remove the sidebar border.
    /// </summary>
    [Parameter] public bool Borderless { get; set; }

    /// <summary>
    /// Gets or sets whether to add rounded corners to the sidebar.
    /// </summary>
    [Parameter] public bool Rounded { get; set; }

    /// <summary>
    /// Gets or sets accordion mode: only one group expanded at a time. Default false.
    /// </summary>
    [Parameter] public bool Accordion { get; set; }

    /// <summary>
    /// Gets or sets the navigation orientation: Vertical (sidebar) or Horizontal (top bar with dropdowns). Default Vertical.
    /// </summary>
    [Parameter] public SgOrientation Orientation { get; set; } = SgOrientation.Vertical;

    /// <summary>
    /// Fired when orientation changes.
    /// </summary>
    [Parameter] public EventCallback<SgOrientation> OrientationChanged { get; set; }

    /// <summary>
    /// Gets or sets the sidebar width (any CSS length, e.g. <c>"220px"</c>, <c>"18rem"</c>). Default 220px.
    /// </summary>
    [Parameter] public string? Width { get; set; }

    /// <summary>
    /// Gets the current search query for cascading to nav items.
    /// </summary>
    public string SearchQuery
    {
        get => _searchQuery;
        set => _searchQuery = value;
    }

    /// <summary>
    /// Expands all groups.
    /// </summary>
    public async Task ExpandAllAsync()
    {
        foreach (var g in _allGroups.ToArray())
            g.Expand();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Collapses all groups.
    /// </summary>
    public async Task CollapseAllAsync()
    {
        foreach (var g in _allGroups.ToArray())
            g.Collapse();
        await InvokeAsync(StateHasChanged);
    }

    internal void RegisterGroup(SgNavGroup group)
    {
        if (!_allGroups.Contains(group))
            _allGroups.Add(group);
    }

    internal void UnregisterGroup(SgNavGroup group)
    {
        _allGroups.Remove(group);
    }

    internal void RegisterTopGroup(SgNavGroup group)
    {
        if (!_topGroups.Contains(group))
            _topGroups.Add(group);
    }

    internal void UnregisterTopGroup(SgNavGroup group)
    {
        _topGroups.Remove(group);
    }

    internal void CollapseSiblings(SgNavGroup expandingGroup)
    {
        foreach (var g in _topGroups)
        {
            if (g != expandingGroup)
                g.Collapse();
        }
    }

    private async Task ToggleMiniAsync()
    {
        Mini = !Mini;
        await MiniChanged.InvokeAsync(Mini);
    }

    /// <summary>
    /// Toggles the mobile menu.
    /// </summary>
    public Task ToggleMobileAsync()
    {
        _collapsed = !_collapsed;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Closes the mobile menu.
    /// </summary>
    public Task CloseMobileAsync()
    {
        _collapsed = false;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Clears the search query.
    /// </summary>
    public Task ClearSearchAsync()
    {
        SearchQuery = "";
        return InvokeAsync(StateHasChanged);
    }
}
