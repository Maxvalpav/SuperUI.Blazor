@namespace SuperUI.Components
@inject IPermissionService PermissionService

@if (_hasPermission)
{
    @ChildContent
}
else if (FallbackContent != null)
{
    @FallbackContent
}

@code {
    private bool _hasPermission;

    /// <summary>
    /// Gets or sets the content to render when the user has the required permission.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the content to render when the user does not have the required permission.
    /// </summary>
    [Parameter] public RenderFragment? FallbackContent { get; set; }

    /// <summary>
    /// Gets or sets the required permission to render the child content.
    /// </summary>
    [Parameter] public string? Permission { get; set; }

    /// <summary>
    /// Gets or sets the required permissions - any of these permissions will grant access.
    /// </summary>
    [Parameter] public IEnumerable<string>? Permissions { get; set; }

    /// <summary>
    /// Gets or sets the required permissions - all of these permissions must be granted for access.
    /// </summary>
    [Parameter] public IEnumerable<string>? RequireAllPermissions { get; set; }

    /// <summary>
    /// Gets or sets the required role to render the child content.
    /// </summary>
    [Parameter] public string? Role { get; set; }

    /// <summary>
    /// Gets or sets the required roles - any of these roles will grant access.
    /// </summary>
    [Parameter] public IEnumerable<string>? Roles { get; set; }

    /// <summary>
    /// Gets or sets a custom authorization predicate.
    /// </summary>
    [Parameter] public Func<Task<bool>>? AuthorizeAsync { get; set; }

    /// <summary>
    /// Gets or sets whether to use OR logic for multiple permissions (any) vs AND logic (all). Default is OR.
    /// </summary>
    [Parameter] public bool RequireAll { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes to apply to the wrapper element when RenderWrapper is true.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Gets or sets whether to render a wrapper div around the content. Default is false.
    /// </summary>
    [Parameter] public bool RenderWrapper { get; set; }

    /// <summary>
    /// Gets or sets the wrapper tag name. Default is "div".
    /// </summary>
    [Parameter] public string WrapperTag { get; set; } = "div";

    protected override async Task OnInitializedAsync()
    {
        await CheckPermissionAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await CheckPermissionAsync();
    }

    private async Task CheckPermissionAsync()
    {
        if (AuthorizeAsync != null)
        {
            _hasPermission = await AuthorizeAsync();
            return;
        }

        if (!string.IsNullOrEmpty(Permission))
        {
            _hasPermission = await PermissionService.HasPermissionAsync(Permission);
            return;
        }

        if (Permissions != null)
        {
            if (RequireAll)
            {
                _hasPermission = true;
                foreach (var perm in Permissions)
                {
                    if (!await PermissionService.HasPermissionAsync(perm))
                    {
                        _hasPermission = false;
                        break;
                    }
                }
            }
            else
            {
                _hasPermission = false;
                foreach (var perm in Permissions)
                {
                    if (await PermissionService.HasPermissionAsync(perm))
                    {
                        _hasPermission = true;
                        break;
                    }
                }
            }
            return;
        }

        if (RequireAllPermissions != null)
        {
            _hasPermission = true;
            foreach (var perm in RequireAllPermissions)
            {
                if (!await PermissionService.HasPermissionAsync(perm))
                {
                    _hasPermission = false;
                    break;
                }
            }
            return;
        }

        if (!string.IsNullOrEmpty(Role))
        {
            _hasPermission = await PermissionService.IsInRoleAsync(Role);
            return;
        }

        if (Roles != null)
        {
            _hasPermission = false;
            foreach (var role in Roles)
            {
                if (await PermissionService.IsInRoleAsync(role))
                {
                    _hasPermission = true;
                    break;
                }
            }
            return;
        }

        _hasPermission = true;
    }
}
