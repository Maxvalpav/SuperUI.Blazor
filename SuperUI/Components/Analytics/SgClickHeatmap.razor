@using SuperUI.Services.Analytics
@namespace SuperUI.Components
@inject SgHeatmapService HeatmapService
@inject NavigationManager NavManager
@implements IDisposable

@* This component is invisible and handles global click tracking and heatmap overlay management *@

@code {
    /// <summary>Whether click tracking starts automatically on initialization.</summary>
    [Parameter] public bool AutoStart { get; set; } = true;
    /// <summary>Gets or sets whether to activate admin (heatmap overlay) mode on initialization.</summary>
    [Parameter] public bool InitialAdminMode { get; set; }

    private bool _disposed;
    private bool _started;

    protected override void OnInitialized()
    {
        // JS interop is not safe here (prerender / renderer not yet interactive).
        // All JS work is deferred to OnAfterRenderAsync.
        NavManager.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed || _started) return;
        _started = true;
        try
        {
            if (AutoStart)
            {
                await HeatmapService.StartTrackingAsync();
            }
            if (InitialAdminMode || HeatmapService.IsAdminMode)
            {
                await Task.Delay(1000); // Give some time for the page to stabilize
                if (_disposed) return;
                await HeatmapService.ToggleAdminModeAsync(true);
            }
        }
        catch (Microsoft.JSInterop.JSException) { /* optional analytics must never crash render */ }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_disposed) return;
        if (HeatmapService.IsAdminMode)
        {
            try
            {
                // Refresh heatmap for new page
                await Task.Delay(500); // Wait for page to render
                if (_disposed) return;
                await InvokeAsync(async () =>
                {
                    if (_disposed) return;
                    await HeatmapService.ToggleAdminModeAsync(true);
                });
            }
            catch (Microsoft.JSInterop.JSException) { }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
            catch (TaskCanceledException) { }
            catch (ObjectDisposedException) { }
            catch (InvalidOperationException) { }
        }
    }

    public void Dispose()
    {
        _disposed = true;
        NavManager.LocationChanged -= HandleLocationChanged;
    }
}
