@namespace SuperUI.Components
@inject ISuperUILocalizer Localizer

<div class="sgc-stepper @(Vertical ? "sgc-vertical" : "") @CssClass" role="navigation" aria-label="Progress steps">
    @{ var arr = (Steps ?? Array.Empty<StepperItem>()).ToList(); }
    @for (var i = 0; i < arr.Count; i++)
    {
        var idx = i;
        var s = arr[idx];
        var status = GetStepStatus(idx, s);
        var state = status.ToString().ToLowerInvariant();
        var isCurrent = status == SgStepStatus.Process;
        var icon = status switch
        {
            SgStepStatus.Done => "✓",
            SgStepStatus.Error => "✕",
            _ => (idx + 1).ToString()
        };
        <div class="sgc-step sgc-@state @(CanNavigateTo(idx) ? "" : "sgc-disabled")"
             role="@(Clickable && CanNavigateTo(idx) ? "button" : null)"
             tabindex="@(Clickable && CanNavigateTo(idx) ? (isCurrent ? "0" : "-1") : "-1")"
             aria-current="@(isCurrent ? "step" : null)"
             aria-label="@(Localizer.GetString("StepLabel", idx + 1, s.Title, GetStatusLabel(status)))"
             @onclick="() => GoAsync(idx)"
             @onkeydown="(e) => OnKeyDownAsync(e, idx)">
            <div class="sgc-step-mark" aria-hidden="true">@icon</div>
            <div class="sgc-step-text">
                <div class="sgc-step-title">@s.Title</div>
                @if (!string.IsNullOrEmpty(s.Description))
                {
                    <div class="sgc-step-desc">@s.Description</div>
                }
            </div>
        </div>
        @if (idx < arr.Count - 1)
        {
            <div class="sgc-step-line" aria-hidden="true"></div>
        }
    }
</div>

@code {
    /// <summary>
    /// Gets or sets the collection of steps to display.
    /// </summary>
    [Parameter] public IEnumerable<StepperItem> Steps { get; set; } = Array.Empty<StepperItem>();
    
    /// <summary>
    /// Gets or sets the index of the currently active step (0-based).
    /// </summary>
    [Parameter] public int Active { get; set; }
    
    /// <summary>
    /// Gets or sets the callback invoked when the active step changes.
    /// </summary>
    [Parameter] public EventCallback<int> ActiveChanged { get; set; }
    
    /// <summary>
    /// Gets or sets whether the stepper is displayed vertically.
    /// Default is false (horizontal).
    /// </summary>
    [Parameter] public bool Vertical { get; set; }
    
    /// <summary>
    /// Gets or sets whether steps can be clicked to navigate.
    /// Default is true.
    /// </summary>
    [Parameter] public bool Clickable { get; set; } = true;

    /// <summary>
    /// Gets or sets whether the stepper uses linear navigation.
    /// When true, users can only navigate to completed steps or the next pending step.
    /// Default is false.
    /// </summary>
    [Parameter] public bool Linear { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes to apply to the component.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Callback invoked before changing steps. Return false to prevent navigation.
    /// </summary>
    [Parameter] public Func<int, int, Task<bool>>? BeforeChangeAsync { get; set; }

    private SgStepStatus GetStepStatus(int idx, StepperItem item)
    {
        if (item.Status.HasValue) return item.Status.Value;
        if (idx < Active) return SgStepStatus.Done;
        if (idx == Active) return SgStepStatus.Process;
        return SgStepStatus.Pending;
    }

    private string GetStatusLabel(SgStepStatus status) => status switch
    {
        SgStepStatus.Done => Localizer["Completed"],
        SgStepStatus.Process => Localizer["Current"],
        SgStepStatus.Error => Localizer["Error"],
        _ => ""
    };

    private bool CanNavigateTo(int idx)
    {
        if (!Linear) return true;
        // In linear mode, allow navigation to completed steps, current step, or the immediate next step
        return idx <= Active + 1 || GetStepStatus(idx, (Steps ?? Array.Empty<StepperItem>()).ElementAtOrDefault(idx) ?? new StepperItem()) == SgStepStatus.Done;
    }

    private async Task GoAsync(int i)
    {
        if (!Clickable || i == Active || !CanNavigateTo(i)) return;

        if (BeforeChangeAsync is not null)
        {
            var canChange = await BeforeChangeAsync.Invoke(Active, i);
            if (!canChange) return;
        }

        Active = i;
        if (ActiveChanged.HasDelegate) await ActiveChanged.InvokeAsync(i);
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e, int idx)
    {
        if (!Clickable) return;
        if (e.Key == "Enter" || e.Key == " ")
        {
            await GoAsync(idx);
        }
    }
}
