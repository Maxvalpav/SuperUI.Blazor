@namespace SuperUI.Components
@inherits SgFormFieldBase<string>
@using System.Globalization
@using System.Text

<div class="@GetFieldClasses()" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sgc-label @(Required ? "sgc-required" : "")" for="@EffectiveId">@Label</label>
    }

    <div class="sgc-input-wrap @(PrefixContent != null ? "sgc-has-prefix" : "") @(SuffixContent != null ? "sgc-has-suffix" : "")">
        @if (PrefixContent is not null)
        {
            <span class="sgc-input-affix sgc-input-affix-prefix">@PrefixContent</span>
        }

        <input id="@EffectiveId"
               type="text"
               inputmode="@InputMode"
               class="@GetInputClasses()"
               placeholder="@EffectivePlaceholder"
               disabled="@IsEffectivelyDisabled"
               readonly="@ReadOnly"
               required="@Required"
               aria-required="@(Required ? "true" : null)"
               aria-invalid="@(HasError ? "true" : null)"
               aria-describedby="@DescribedBy"
               value="@DisplayValue"
               maxlength="@MaxDisplayLength"
               @oninput="OnInputAsync"
               @onchange="OnChangeAsync"
               @onfocus="HandleMaskedFocusAsync"
               @onblur="HandleMaskedBlurAsync"
               @onkeydown="OnKeyDownAsync"
               @attributes="AdditionalAttributesFiltered" />

        @if (SuffixContent is not null)
        {
            <span class="sgc-input-affix sgc-input-affix-suffix">@SuffixContent</span>
        }

        @if (ShowClearButton && !string.IsNullOrEmpty(Value) && !IsEffectivelyDisabled && !ReadOnly)
        {
            <button type="button" class="sgc-input-clear" @onclick="ClearAsync" aria-label="@Localizer["Clear"]" tabindex="-1">
                <svg viewBox="0 0 16 16" width="10" height="10" fill="currentColor" aria-hidden="true">
                    <path d="M3.72 3.72a.75.75 0 011.06 0L8 6.94l3.22-3.22a.75.75 0 111.06 1.06L9.06 8l3.22 3.22a.75.75 0 11-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 01-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 010-1.06z"/>
                </svg>
            </button>
        }
    </div>

    @if (HasError)
    {
        <span id="@($"{EffectiveId}-err")" class="sgc-error">@DisplayedError</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@($"{EffectiveId}-hint")" class="sgc-hint">@Hint</span>
    }
</div>
