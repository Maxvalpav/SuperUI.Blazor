@using System.Text.Json
@using SuperUI.Enums
@using SuperUI.Localization
@using SuperUI.Base.ComponentBases
@namespace SuperUI.Components
@inherits SgJsComponentBase

<div class="sgc-locale-editor">
    @* ── Toolbar ── *@
    <SgStack Horizontal Space="SgSize.Md" Align="SgAlignItems.Center" Style="margin-bottom: 1rem; flex-wrap: wrap;">
        <SgTypography Variant="SgTypographyVariant.Heading5" Weight="SgTypographyWeight.Semibold" Style="margin: 0; flex-shrink: 0;">
            @Localizer["Settings_Language"]
        </SgTypography>

        <SgTextBox TValue="string" @bind-Value="_search"
                   Placeholder="@(Localizer["Common_Search"] + "...")"
                   Style="flex: 1; min-width: 200px;" />

        <SgBadge Text="@($"{_catalog.Count} keys · {_domains.Count} domains")" Variant="SgBadgeVariant.Info" />

        <SgButton Variant="SgButtonVariant.Primary" Size="SgSize.Sm"
                  Disabled="@(!_hasChanges)" OnClick="SaveAllAsync">
            @Localizer["Common_Save"]
        </SgButton>

        <SgButton Variant="SgButtonVariant.Outlined" Size="SgSize.Sm"
                  Disabled="@(!_hasChanges)" OnClick="DiscardAllAsync">
            @Localizer["Common_Reset"]
        </SgButton>

        <div style="flex: 1; min-width: 0;"></div>

        <SgButton Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" OnClick="DownloadOverridesAsync">
            ⬇ Download JSON
        </SgButton>

        <SgButton Variant="SgButtonVariant.Ghost" Size="SgSize.Sm" OnClick="UploadOverridesAsync">
            ⬆ Upload JSON
        </SgButton>
    </SgStack>

    @* ── Messages ── *@
    @if (_savedIndicator)
    {
        <SgAlert Variant="SgAlertVariant.Success" Dense="true" Dismissible="false" Style="margin-bottom: 1rem;">
            @Localizer["Common_Saved"]
        </SgAlert>
    }
    @if (_errorMessage is not null)
    {
        <SgAlert Variant="SgAlertVariant.Danger" Dense="true" Dismissible="true" Style="margin-bottom: 1rem;">
            @_errorMessage
        </SgAlert>
    }

    @* ── Domain sections ── *@
    @foreach (var domain in _filteredDomains)
    {
        var entries = _filteredEntries[domain];
        var isExpanded = _expandedDomains.Contains(domain);
        var editedCount = _editedValues.Keys.Count(k => k.StartsWith(domain + "_", StringComparison.Ordinal) || k == domain);

        <div class="sgc-locale-domain">
             <div class="sgc-locale-domain-header" @onclick="() => ToggleDomain(domain)" role="button" tabindex="0"
                 @onkeydown="(KeyboardEventArgs ke) => ToggleDomainOnKey(domain, ke)">
                <span class="sgc-locale-arrow @(isExpanded ? "expanded" : "")">▶</span>
                <span class="sgc-locale-domain-title">@domain</span>
                <span class="sgc-locale-domain-count">@entries.Count keys</span>
                @if (editedCount > 0)
                {
                    <span class="sgc-locale-domain-edited">@editedCount edited</span>
                }
            </div>
            @if (isExpanded)
            {
                <div class="sgc-locale-entries">
                    <div class="sgc-locale-row sgc-locale-row-header">
                        <span class="sgc-locale-cell-key">Key</span>
                        <span class="sgc-locale-cell-value">@Localizer["Common_Value"]</span>
                        <span class="sgc-locale-cell-override">Override</span>
                        <span class="sgc-locale-cell-action"></span>
                    </div>
                    @foreach (var entry in entries)
                    {
                        var original = entry.OriginalValue;
                        var currentVal = Localizer[entry.Key];
                        var editVal = _editedValues.GetValueOrDefault(entry.Key, original);
                        var isOverridden = _originalOverrides.ContainsKey(entry.Key);
                        var hasChanged = isOverridden && _editedValues.GetValueOrDefault(entry.Key) != _originalOverrides.GetValueOrDefault(entry.Key)
                            || !isOverridden && _editedValues.ContainsKey(entry.Key) && _editedValues[entry.Key] != original;

                        <div class="sgc-locale-row">
                            <span class="sgc-locale-cell-key" title="@entry.Key">@entry.Key</span>
                            <span class="sgc-locale-cell-value">
                                @if (currentVal != original)
                                {
                                    <span class="sgc-locale-original-old">@original</span>
                                    <br />
                                    <span class="sgc-locale-current">@currentVal</span>
                                }
                                else
                                {
                                    @original
                                }
                            </span>
                            <span class="sgc-locale-cell-override">
                                 @{
                                        var inputClass = "sgc-locale-input" + (hasChanged ? " modified" : "");
                                    }
                                    <input type="text"
                                           value="@editVal"
                                           @onchange="(ChangeEventArgs e) => OnEditChanged(entry.Key, e.Value)"
                                           class="@inputClass" />
                            </span>
                            <span class="sgc-locale-cell-action">
                                @if (hasChanged)
                                {
                                    <button @onclick="() => RevertKey(entry.Key)" class="sgc-locale-undo-btn" title="@Localizer["Common_Undo"]">↶</button>
                                }
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>
