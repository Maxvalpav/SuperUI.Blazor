@namespace SuperUI.Components

<div class="sg-timeline @(Reverse ? "sg-timeline-reverse" : "") sg-timeline-mode-@Mode.ToLowerInvariant() @CssClass" style="@Style">
    @if (Items != null)
    {
        @if (Virtualize)
        {
            <SgVirtualList TItem="TimelineItem" Items="Items" Height="@Height" ItemHeight="60">
                <ChildContent>
                    @RenderItem(context)
                </ChildContent>
            </SgVirtualList>
        }
        else
        {
            @foreach (var item in Items)
            {
                @RenderItem(item)
            }
        }
    }
    @ChildContent
</div>

@code {
    private RenderFragment RenderItem(TimelineItem item) => @<div class="sg-timeline-item">
        <div class="sg-timeline-item-tail"></div>
        <div class="sg-timeline-item-dot @(!string.IsNullOrEmpty(item.Color) ? "sg-timeline-item-dot-custom" : "")" 
             style="@(GetDotStyle(item))">
            @if (item.DotContent != null)
            {
                @item.DotContent
            }
            else if (item.Icon != null)
            {
                <div class="sg-timeline-item-icon">@item.Icon</div>
            }
        </div>
        <div class="sg-timeline-item-content">
            @if (!string.IsNullOrEmpty(item.Time))
            {
                <div class="sg-timeline-item-time">@item.Time</div>
            }
            @if (!string.IsNullOrEmpty(item.Title))
            {
                <div class="sg-timeline-item-title">@item.Title</div>
            }
            @if (!string.IsNullOrEmpty(item.Description))
            {
                <div class="sg-timeline-item-description">@item.Description</div>
            }
        </div>
    </div>;
}
