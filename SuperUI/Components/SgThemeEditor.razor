@namespace SuperUI.Components
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer

<div class="sg-theme-editor">
    <div class="sg-theme-editor-header">
        <h4 class="sg-theme-editor-title">@Localizer["ThemeEditor"]</h4>
    </div>
    <div class="sg-theme-editor-body">
        <div class="sg-theme-field">
            <label>@Localizer["PrimaryColor"]</label>
            <div style="display:flex; gap:8px;">
                <input type="color" @bind="_primaryColor" @bind:after="UpdateTheme" />
                <input type="text" class="sgc-input" style="width:80px;" @bind="_primaryColor" @bind:after="UpdateTheme" />
            </div>
        </div>
        <div class="sg-theme-field">
            <label>@Localizer["SuccessColor"]</label>
            <div style="display:flex; gap:8px;">
                <input type="color" @bind="_successColor" @bind:after="UpdateTheme" />
                <input type="text" class="sgc-input" style="width:80px;" @bind="_successColor" @bind:after="UpdateTheme" />
            </div>
        </div>
        <div class="sg-theme-field">
            <label>@Localizer["DangerColor"]</label>
            <div style="display:flex; gap:8px;">
                <input type="color" @bind="_dangerColor" @bind:after="UpdateTheme" />
                <input type="text" class="sgc-input" style="width:80px;" @bind="_dangerColor" @bind:after="UpdateTheme" />
            </div>
        </div>
        <div class="sg-theme-field">
            <label>@Localizer["BorderRadius"]</label>
            <select class="sgc-select" @bind="_borderRadius" @bind:after="UpdateTheme">
                <option value="0px">@Localizer["None"] (0px)</option>
                <option value="2px">@Localizer["Small"] (2px)</option>
                <option value="4px">@Localizer["Medium"] (4px)</option>
                <option value="8px">@Localizer["Large"] (8px)</option>
                <option value="16px">@Localizer["ExtraLarge"] (16px)</option>
            </select>
        </div>
        <div class="sg-theme-field">
            <label>@Localizer["BaseFontSize"]</label>
            <select class="sgc-select" @bind="_fontSize" @bind:after="UpdateTheme">
                <option value="12px">12px</option>
                <option value="13px">13px</option>
                <option value="14px">14px</option>
                <option value="15px">15px</option>
                <option value="16px">16px</option>
            </select>
        </div>
    </div>
    <div class="sg-theme-editor-footer">
        <button type="button" class="sgc-btn" @onclick="ResetTheme">@Localizer["ResetToDefaults"]</button>
    </div>
</div>
