@namespace SuperUI.Components
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="sgc-pop-wrap @CssClass" @ref="_root">
    <div class="sgc-pop-trigger" @ref="_triggerRef"
         @onclick="OnTriggerClickAsync"
         @onmouseenter="OnTriggerMouseEnterAsync"
         @onmouseleave="OnTriggerMouseLeaveAsync">
        @if (TriggerContent is not null)
        {
            @TriggerContent
        }
        else
        {
            <SgButton Text="@ButtonText" Variant="@ButtonVariant" Size="@ButtonSize" />
        }
    </div>

    @if (_open || _isClosing)
    {
        <div class="sgc-pop @(PlacementClass) @(ShowArrow ? "sgc-pop-arrow" : "") @(_isClosing ? "sgc-closing" : "")"
             role="@Role"
             aria-labelledby="@_titleId"
             tabindex="-1"
             @ref="_popoverRef"
             @onclick:stopPropagation="true"
             @onmouseenter="OnPopoverMouseEnterAsync"
             @onmouseleave="OnPopoverMouseLeaveAsync">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <div class="sgc-pop-header" id="@_titleId">@Title</div>
            }
            <div class="sgc-pop-body">
                @ChildContent
            </div>
        </div>
    }
</div>

@code {
    private const int CloseAnimationMs = 200;
    private const int HoverGraceMs = 120;

    private readonly string _titleId = "popover-title-" + Guid.NewGuid().ToString("N")[..8];
    private ElementReference _root;
    private ElementReference _triggerRef;
    private ElementReference _popoverRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SgPopover>? _self;
    private bool _attached;
    private bool _isDisposed;
    private bool _isClosing;
    private bool _lastRenderedOpen;
    private bool _open;
    private bool _lastSyncedOpen;
    private CancellationTokenSource? _closeCts;
    private CancellationTokenSource? _hoverCts;

    /// <summary>
    /// Gets or sets whether the popover is currently open.
    /// </summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the open state changes.
    /// </summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>
    /// Gets or sets the placement of the popover relative to the trigger. Default is <see cref="SgPlacement.BottomStart"/>.
    /// </summary>
    [Parameter] public SgPlacement Placement { get; set; } = SgPlacement.BottomStart;

    /// <summary>
    /// Gets or sets the ARIA role attribute for the popover. Default is "dialog".
    /// </summary>
    [Parameter] public string Role { get; set; } = "dialog";

    /// <summary>
    /// Gets or sets the title text displayed in the popover header.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// Gets or sets whether to display an arrow pointing to the trigger element.
    /// </summary>
    [Parameter] public bool ShowArrow { get; set; }

    /// <summary>
    /// Gets or sets whether the popover closes when clicking outside of it. Default is true.
    /// </summary>
    [Parameter] public bool CloseOnOutsideClick { get; set; } = true;

    /// <summary>
    /// Gets or sets whether the popover closes when pressing the Escape key. Default is true.
    /// </summary>
    [Parameter] public bool CloseOnEscape { get; set; } = true;

    /// <summary>
    /// Gets or sets the trigger behavior for the popover. Default is <see cref="SgTrigger.Click"/>.
    /// When <see cref="SgTrigger.Manual"/>, use <see cref="OpenAsync"/>/<see cref="CloseAsync"/> or the <see cref="Open"/> parameter.
    /// </summary>
    [Parameter] public SgTrigger Trigger { get; set; } = SgTrigger.Click;

    /// <summary>
    /// Gets or sets whether the popover is disabled.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets the text for the default trigger button. Default is "Open".
    /// </summary>
    [Parameter] public string ButtonText { get; set; } = "Open";

    /// <summary>
    /// Gets or sets the variant for the default trigger button. Default is <see cref="SgButtonVariant.Default"/>.
    /// </summary>
    [Parameter] public SgButtonVariant ButtonVariant { get; set; } = SgButtonVariant.Default;

    /// <summary>
    /// Gets or sets the size for the default trigger button. Default is <see cref="SgSize.Md"/>.
    /// </summary>
    [Parameter] public SgSize ButtonSize { get; set; } = SgSize.Md;

    /// <summary>
    /// Gets or sets additional CSS classes to apply to the component.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Gets or sets the custom trigger content.
    /// When provided, replaces the default button trigger.
    /// </summary>
    [Parameter] public RenderFragment? TriggerContent { get; set; }

    /// <summary>
    /// Gets or sets the content to display inside the popover. Required.
    /// </summary>
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }

    private string PlacementClass => Placement switch
    {
        SgPlacement.TopStart    => "sgc-pop-top-start",
        SgPlacement.TopEnd      => "sgc-pop-top-end",
        SgPlacement.Top         => "sgc-pop-top",
        SgPlacement.RightStart  => "sgc-pop-right-start",
        SgPlacement.Right       => "sgc-pop-right",
        SgPlacement.RightEnd    => "sgc-pop-right-end",
        SgPlacement.LeftStart   => "sgc-pop-left-start",
        SgPlacement.Left        => "sgc-pop-left",
        SgPlacement.LeftEnd     => "sgc-pop-left-end",
        SgPlacement.Bottom      => "sgc-pop-bottom",
        SgPlacement.BottomEnd   => "sgc-pop-bottom-end",
        _                       => "sgc-pop-bottom-start"
    };

    protected override void OnParametersSet()
    {
        // Sync local _open with parameter Open only when the parameter itself changed,
        // not on every render (which would clobber clicks/hover-driven state).
        if (Open != _lastSyncedOpen)
        {
            _lastSyncedOpen = Open;
            _open = Open;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isDisposed) return;

        if (_open && !_lastRenderedOpen)
        {
            _lastRenderedOpen = true;
            await AttachJsAsync();
        }
        else if (!_open && _lastRenderedOpen)
        {
            _lastRenderedOpen = false;
            await DetachJsAsync();
            await ScheduleClosingFlagResetAsync();
        }
    }

    private async Task AttachJsAsync()
    {
        // Cancel any pending close-animation so reopening is immediate.
        _closeCts?.Cancel();
        _closeCts?.Dispose();
        _closeCts = null;

        _attached = false;
        _isClosing = false;

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/superui-popover.js");
            if (_isDisposed) return;

            _self ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _root, _popoverRef, _triggerRef, _self, CloseOnOutsideClick, CloseOnEscape);
            _attached = true;
        }
        catch (JSException) { }
        catch (TaskCanceledException) { }
    }

    private async Task DetachJsAsync()
    {
        if (!_attached || _module is null) return;

        try
        {
            await _module.InvokeVoidAsync("detach", _root);
        }
        catch (JSException) { }
        catch (TaskCanceledException) { }
        finally
        {
            _attached = false;
        }
    }

    private async Task ScheduleClosingFlagResetAsync()
    {
        _closeCts?.Cancel();
        _closeCts?.Dispose();
        _closeCts = new CancellationTokenSource();
        var token = _closeCts.Token;
        try
        {
            await Task.Delay(CloseAnimationMs, token);
            if (!_isDisposed && !token.IsCancellationRequested)
            {
                _isClosing = false;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }

    private async Task OnTriggerClickAsync()
    {
        if (Disabled || Trigger != SgTrigger.Click) return;
        await SetOpenAsync(!_open);
    }

    private async Task OnTriggerMouseEnterAsync()
    {
        if (Disabled || Trigger != SgTrigger.Hover) return;
        CancelHoverClose();
        await SetOpenAsync(true);
    }

    private Task OnTriggerMouseLeaveAsync()
    {
        if (Disabled || Trigger != SgTrigger.Hover) return Task.CompletedTask;
        ScheduleHoverClose();
        return Task.CompletedTask;
    }

    private Task OnPopoverMouseEnterAsync()
    {
        if (Trigger != SgTrigger.Hover) return Task.CompletedTask;
        CancelHoverClose();
        return Task.CompletedTask;
    }

    private Task OnPopoverMouseLeaveAsync()
    {
        if (Trigger != SgTrigger.Hover) return Task.CompletedTask;
        ScheduleHoverClose();
        return Task.CompletedTask;
    }

    private void CancelHoverClose()
    {
        _hoverCts?.Cancel();
        _hoverCts?.Dispose();
        _hoverCts = null;
    }

    private void ScheduleHoverClose()
    {
        CancelHoverClose();
        _hoverCts = new CancellationTokenSource();
        var token = _hoverCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(HoverGraceMs, token);
                if (token.IsCancellationRequested || _isDisposed) return;
                await InvokeAsync(() => SetOpenAsync(false));
            }
            catch (TaskCanceledException) { }
        });
    }

    /// <summary>
    /// Manually opens the popover. For use when Trigger is <see cref="SgTrigger.Manual"/>.
    /// </summary>
    public Task OpenAsync() => SetOpenAsync(true);

    /// <summary>
    /// Manually closes the popover. For use when Trigger is <see cref="SgTrigger.Manual"/>.
    /// </summary>
    public Task CloseAsync() => SetOpenAsync(false);

    [JSInvokable]
    public Task CloseFromJsAsync() => SetOpenAsync(false);

    private async Task SetOpenAsync(bool value)
    {
        if (_open == value || _isDisposed || (value && Disabled)) return;

        if (!value)
        {
            _isClosing = true;
        }

        _open = value;
        _lastSyncedOpen = value;

        if (OpenChanged.HasDelegate)
        {
            await OpenChanged.InvokeAsync(value);
        }

        if (!_isDisposed)
        {
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_isDisposed) return;
        _isDisposed = true;

        _closeCts?.Cancel();
        _closeCts?.Dispose();
        _closeCts = null;

        _hoverCts?.Cancel();
        _hoverCts?.Dispose();
        _hoverCts = null;

        if (_module is not null)
        {
            try
            {
                if (_attached)
                {
                    await _module.InvokeVoidAsync("detach", _root);
                }
            }
            catch (JSException) { }
            catch (TaskCanceledException) { }
            catch (ObjectDisposedException) { }
        }

        var self = _self;
        _self = null;
        self?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSException) { }
            catch (TaskCanceledException) { }
            catch (ObjectDisposedException) { }
            _module = null;
        }
    }
}
