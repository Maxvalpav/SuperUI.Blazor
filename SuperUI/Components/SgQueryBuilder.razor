@namespace SuperUI.Components
@using SuperUI.Localization
@using System.Text
@using System.Text.Json
@implements IDisposable
@inject ISuperUILocalizer Localizer
@inject IJSRuntime JS

<div class="sgc-query-builder @CssClass">
    @RenderGroup(RootGroup, null, true)

    @if (ShowPreview)
    {
        <div class="sgc-qb-preview">
            <div class="sgc-qb-preview-tabs">
                <button type="button" class="sgc-qb-preview-tab @(_previewMode == "LINQ" ? "sgc-active" : "")" @onclick='() => _previewMode = "LINQ"'>LINQ</button>
                <button type="button" class="sgc-qb-preview-tab @(_previewMode == "SQL" ? "sgc-active" : "")" @onclick='() => _previewMode = "SQL"'>SQL</button>
            </div>
            <div class="sgc-qb-preview-content">
                <pre><code>@GetPreview()</code></pre>
            </div>
        </div>
    }

    @if (ShowStorageActions)
    {
        <div class="sgc-qb-storage-actions">
            <SgButton Text="@Localizer["Save"]" Size="SgSize.Sm" OnClick="SaveToLocalStorageAsync" />
            <SgButton Text="@Localizer["Load"]" Size="SgSize.Sm" OnClick="LoadFromLocalStorageAsync" Variant="SgButtonVariant.Ghost" />
        </div>
    }
</div>

@code {
    private const int ValueDebounceMs = 300;

    private CancellationTokenSource? _valueDebounceCts;

    [Parameter] public QueryGroup RootGroup { get; set; } = new();
    [Parameter] public IReadOnlyList<QueryField> Fields { get; set; } = Array.Empty<QueryField>();
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public EventCallback<QueryGroup> OnChanged { get; set; }

    /// <summary>
    /// Gets or sets whether to show the LINQ/SQL preview.
    /// </summary>
    [Parameter] public bool ShowPreview { get; set; }

    /// <summary>
    /// Gets or sets whether to show Save/Load buttons for localStorage.
    /// </summary>
    [Parameter] public bool ShowStorageActions { get; set; }

    /// <summary>
    /// Key used for localStorage.
    /// </summary>
    [Parameter] public string StorageKey { get; set; } = "sg-query-builder-default";

    private string _previewMode = "LINQ";

    protected override void OnParametersSet()
    {
        RootGroup ??= new QueryGroup();
        EnsureGroupHasContent(RootGroup);
    }

    private string GetPreview()
    {
        return _previewMode == "LINQ" ? ToLinq(RootGroup) : ToSql(RootGroup);
    }

    public string ToLinq(QueryGroup group)
    {
        var sb = new StringBuilder();
        BuildLinq(group, sb);
        return sb.ToString();
    }

    private void BuildLinq(QueryGroup group, StringBuilder sb)
    {
        var parts = new List<string>();
        foreach (var rule in group.Rules.Where(r => !string.IsNullOrEmpty(r.FieldName)))
        {
            parts.Add(FormatRuleLinq(rule));
        }
        foreach (var g in group.Groups)
        {
            var innerSb = new StringBuilder();
            BuildLinq(g, innerSb);
            var inner = innerSb.ToString();
            if (!string.IsNullOrEmpty(inner)) parts.Add($"({inner})");
        }

        var op = group.Operator == QueryLogicOperator.And ? " && " : " || ";
        sb.Append(string.Join(op, parts));
    }

    private string FormatRuleLinq(QueryRule rule)
    {
        var field = rule.FieldName;
        var val = rule.Value?.ToString() ?? "null";
        if (rule.Value is string || (GetField(rule.FieldName)?.Type == typeof(string))) val = $"\"{val}\"";

        return rule.Operator switch
        {
            QueryFieldOperator.Equals => $"{field} == {val}",
            QueryFieldOperator.NotEquals => $"{field} != {val}",
            QueryFieldOperator.Contains => $"{field}.Contains({val})",
            QueryFieldOperator.NotContains => $"!{field}.Contains({val})",
            QueryFieldOperator.StartsWith => $"{field}.StartsWith({val})",
            QueryFieldOperator.EndsWith => $"{field}.EndsWith({val})",
            QueryFieldOperator.GreaterThan => $"{field} > {val}",
            QueryFieldOperator.LessThan => $"{field} < {val}",
            QueryFieldOperator.GreaterThanOrEqual => $"{field} >= {val}",
            QueryFieldOperator.LessThanOrEqual => $"{field} <= {val}",
            QueryFieldOperator.IsNull => $"{field} == null",
            QueryFieldOperator.IsNotNull => $"{field} != null",
            _ => $"{field} {rule.Operator} {val}"
        };
    }

    public string ToSql(QueryGroup group)
    {
        var sb = new StringBuilder();
        BuildSql(group, sb);
        return sb.ToString();
    }

    private void BuildSql(QueryGroup group, StringBuilder sb)
    {
        var parts = new List<string>();
        foreach (var rule in group.Rules.Where(r => !string.IsNullOrEmpty(r.FieldName)))
        {
            parts.Add(FormatRuleSql(rule));
        }
        foreach (var g in group.Groups)
        {
            var innerSb = new StringBuilder();
            BuildSql(g, innerSb);
            var inner = innerSb.ToString();
            if (!string.IsNullOrEmpty(inner)) parts.Add($"({inner})");
        }

        var op = group.Operator == QueryLogicOperator.And ? " AND " : " OR ";
        sb.Append(string.Join(op, parts));
    }

    private string FormatRuleSql(QueryRule rule)
    {
        var field = $"[{rule.FieldName}]";
        var val = rule.Value?.ToString() ?? "NULL";
        var isStr = GetField(rule.FieldName)?.Type == typeof(string);
        if (isStr && val != "NULL") val = $"'{val.Replace("'", "''")}'";

        return rule.Operator switch
        {
            QueryFieldOperator.Equals => $"{field} = {val}",
            QueryFieldOperator.NotEquals => $"{field} <> {val}",
            QueryFieldOperator.Contains => $"{field} LIKE '%{rule.Value}%'",
            QueryFieldOperator.NotContains => $"{field} NOT LIKE '%{rule.Value}%'",
            QueryFieldOperator.StartsWith => $"{field} LIKE '{rule.Value}%'",
            QueryFieldOperator.EndsWith => $"{field} LIKE '%{rule.Value}'",
            QueryFieldOperator.GreaterThan => $"{field} > {val}",
            QueryFieldOperator.LessThan => $"{field} < {val}",
            QueryFieldOperator.GreaterThanOrEqual => $"{field} >= {val}",
            QueryFieldOperator.LessThanOrEqual => $"{field} <= {val}",
            QueryFieldOperator.IsNull => $"{field} IS NULL",
            QueryFieldOperator.IsNotNull => $"{field} IS NOT NULL",
            _ => $"{field} {rule.Operator} {val}"
        };
    }

    public async Task SaveToLocalStorageAsync()
    {
        var json = JsonSerializer.Serialize(RootGroup);
        await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, json);
    }

    public async Task LoadFromLocalStorageAsync()
    {
        var json = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
        if (!string.IsNullOrEmpty(json))
        {
            try
            {
                var group = JsonSerializer.Deserialize<QueryGroup>(json);
                if (group != null)
                {
                    RootGroup = group;
                    await NotifyChangedImmediateAsync();
                }
            }
            catch { }
        }
    }

    private RenderFragment RenderGroup(QueryGroup group, QueryGroup? parent, bool isRoot) => @<div class="sgc-qb-group">
        <div class="sgc-qb-group-header">
            <div class="sgc-qb-logic">
                <button type="button"
                        class="sgc-qb-logic-btn @(group.Operator == QueryLogicOperator.And ? "sgc-active" : "")"
                        @onclick="() => SetOperator(group, QueryLogicOperator.And)">
                    AND
                </button>
                <button type="button"
                        class="sgc-qb-logic-btn @(group.Operator == QueryLogicOperator.Or ? "sgc-active" : "")"
                        @onclick="() => SetOperator(group, QueryLogicOperator.Or)">
                    OR
                </button>
            </div>
            <div class="sgc-qb-actions">
                <button type="button" class="sgc-qb-btn" @onclick="() => AddRule(group)">+ @Localizer["Condition"]</button>
                <button type="button" class="sgc-qb-btn" @onclick="() => AddGroup(group)">+ @Localizer["Group"]</button>
                @if (!isRoot && parent is not null)
                {
                    <button type="button" class="sgc-qb-btn sgc-qb-btn-danger" @onclick="() => RemoveGroup(parent, group)">@Localizer["Remove"]</button>
                }
            </div>
        </div>

        <div class="sgc-qb-group-body">
            @foreach (var rule in group.Rules)
            {
                var field = GetField(rule.FieldName);
                var operators = GetOperatorsForField(field);
                var inputKind = GetInputKind(field);
                <div class="sgc-qb-rule" @key="rule">
                    <select class="sgc-qb-select"
                            value="@(rule.FieldName ?? string.Empty)"
                            @onchange="e => SetRuleField(rule, e.Value?.ToString())">
                        <option value="">@Localizer["SelectField"]</option>
                        @foreach (var availableField in Fields)
                        {
                            <option value="@availableField.Name">@availableField.Label</option>
                        }
                    </select>

                    <select class="sgc-qb-select"
                            value="@rule.Operator.ToString()"
                            @onchange="e => SetRuleOperator(rule, e.Value?.ToString())">
                        @foreach (var op in operators)
                        {
                            <option value="@op">@GetOperatorLabel(op)</option>
                        }
                    </select>

                    @if (IsUnaryOperator(rule.Operator))
                    {
                        <div class="sgc-qb-readonly-value">@Localizer["WithoutValue"]</div>
                    }
                    else
                    {
                        @switch (inputKind)
                        {
                            case InputKind.Bool:
                                <select class="sgc-qb-select"
                                        value="@(rule.Value?.ToString() ?? string.Empty)"
                                        @onchange="e => CommitRuleValue(rule, e.Value?.ToString())">
                                    <option value="">@Localizer["SelectValue"]</option>
                                    <option value="true">@Localizer["Yes"]</option>
                                    <option value="false">@Localizer["No"]</option>
                                </select>
                                break;
                            case InputKind.Enum:
                                <select class="sgc-qb-select"
                                        value="@(rule.Value?.ToString() ?? string.Empty)"
                                        @onchange="e => CommitRuleValue(rule, e.Value?.ToString())">
                                    <option value="">@Localizer["SelectValue"]</option>
                                    @foreach (var opt in field?.EnumOptions ?? Array.Empty<QueryFieldEnumOption>())
                                    {
                                        <option value="@opt.Name">@opt.Label</option>
                                    }
                                </select>
                                break;
                            case InputKind.Date:
                                <input class="sgc-qb-input" type="date"
                                       value="@(rule.Value?.ToString() ?? string.Empty)"
                                       @onchange="e => CommitRuleValue(rule, e.Value?.ToString())" />
                                break;
                            case InputKind.DateTime:
                                <input class="sgc-qb-input" type="datetime-local"
                                       value="@(rule.Value?.ToString() ?? string.Empty)"
                                       @onchange="e => CommitRuleValue(rule, e.Value?.ToString())" />
                                break;
                            case InputKind.Time:
                                <input class="sgc-qb-input" type="time"
                                       value="@(rule.Value?.ToString() ?? string.Empty)"
                                       @onchange="e => CommitRuleValue(rule, e.Value?.ToString())" />
                                break;
                            case InputKind.Integer:
                                <input class="sgc-qb-input" type="number" step="1" inputmode="numeric"
                                       value="@(rule.Value?.ToString() ?? string.Empty)"
                                       placeholder="@GetValuePlaceholder(field)"
                                       @oninput="e => OnRuleValueInput(rule, e.Value?.ToString())"
                                       @onchange="e => CommitRuleValue(rule, e.Value?.ToString())" />
                                break;
                            case InputKind.Decimal:
                                <input class="sgc-qb-input" type="number" step="any" inputmode="decimal"
                                       value="@(rule.Value?.ToString() ?? string.Empty)"
                                       placeholder="@GetValuePlaceholder(field)"
                                       @oninput="e => OnRuleValueInput(rule, e.Value?.ToString())"
                                       @onchange="e => CommitRuleValue(rule, e.Value?.ToString())" />
                                break;
                            default:
                                <input class="sgc-qb-input"
                                       value="@(rule.Value?.ToString() ?? string.Empty)"
                                       placeholder="@GetValuePlaceholder(field)"
                                       @oninput="e => OnRuleValueInput(rule, e.Value?.ToString())"
                                       @onchange="e => CommitRuleValue(rule, e.Value?.ToString())" />
                                break;
                        }
                    }

                    <button type="button" class="sgc-qb-btn sgc-qb-btn-danger" @onclick="() => RemoveRule(group, rule)">@Localizer["Remove"]</button>
                </div>
            }

            @foreach (var subGroup in group.Groups)
            {
                @RenderGroup(subGroup, group, false)
            }
        </div>
    </div>;

    private QueryField? GetField(string? fieldName) =>
        string.IsNullOrWhiteSpace(fieldName) ? null : Fields.FirstOrDefault(f => f.Name == fieldName);

    private void EnsureGroupHasContent(QueryGroup group)
    {
        if (group.Rules.Count == 0 && group.Groups.Count == 0)
        {
            group.Rules.Add(new QueryRule());
        }

        foreach (var childGroup in group.Groups)
        {
            EnsureGroupHasContent(childGroup);
        }
    }

    private async Task SetOperator(QueryGroup group, QueryLogicOperator op)
    {
        if (group.Operator == op)
        {
            return;
        }

        group.Operator = op;
        await NotifyChangedImmediateAsync();
    }

    private async Task AddRule(QueryGroup group)
    {
        group.Rules.Add(new QueryRule());
        await NotifyChangedImmediateAsync();
    }

    private async Task AddGroup(QueryGroup group)
    {
        group.Groups.Add(new QueryGroup
        {
            Rules = new List<QueryRule> { new() }
        });
        await NotifyChangedImmediateAsync();
    }

    private async Task RemoveRule(QueryGroup group, QueryRule rule)
    {
        group.Rules.Remove(rule);
        EnsureGroupHasContent(group);
        await NotifyChangedImmediateAsync();
    }

    private async Task RemoveGroup(QueryGroup parent, QueryGroup group)
    {
        parent.Groups.Remove(group);
        EnsureGroupHasContent(parent);
        await NotifyChangedImmediateAsync();
    }

    private async Task SetRuleField(QueryRule rule, string? fieldName)
    {
        rule.FieldName = fieldName;
        rule.Operator = GetOperatorsForField(GetField(fieldName)).First();
        rule.Value = null;
        await NotifyChangedImmediateAsync();
    }

    private async Task SetRuleOperator(QueryRule rule, string? opStr)
    {
        if (Enum.TryParse<QueryFieldOperator>(opStr, out var op))
        {
            rule.Operator = op;
            if (IsUnaryOperator(op))
            {
                rule.Value = null;
            }

            await NotifyChangedImmediateAsync();
        }
    }

    // Live typing — only update model + schedule debounced parent notify; no StateHasChanged.
    private void OnRuleValueInput(QueryRule rule, string? value)
    {
        rule.Value = value;
        ScheduleDebouncedNotify();
    }

    // Native commit (blur / select change / date picker pick).
    private async Task CommitRuleValue(QueryRule rule, string? value)
    {
        rule.Value = value;
        CancelDebounce();
        if (OnChanged.HasDelegate)
        {
            await OnChanged.InvokeAsync(RootGroup);
        }
    }

    private void ScheduleDebouncedNotify()
    {
        if (!OnChanged.HasDelegate)
            return;

        CancelDebounce();
        var cts = new CancellationTokenSource();
        _valueDebounceCts = cts;
        _ = DebouncedNotifyAsync(cts.Token);
    }

    private async Task DebouncedNotifyAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(ValueDebounceMs, ct);
            if (ct.IsCancellationRequested) return;
            await OnChanged.InvokeAsync(RootGroup);
        }
        catch (OperationCanceledException) { }
    }

    private void CancelDebounce()
    {
        try
        {
            _valueDebounceCts?.Cancel();
            _valueDebounceCts?.Dispose();
        }
        catch { }
        _valueDebounceCts = null;
    }

    private async Task NotifyChangedImmediateAsync()
    {
        CancelDebounce();
        await InvokeAsync(StateHasChanged);
        if (OnChanged.HasDelegate)
        {
            await OnChanged.InvokeAsync(RootGroup);
        }
    }

    public void Dispose() => CancelDebounce();

    private enum InputKind
    {
        Text,
        Integer,
        Decimal,
        Bool,
        Enum,
        Date,
        DateTime,
        Time
    }

    private static InputKind GetInputKind(QueryField? field)
    {
        if (field is null) return InputKind.Text;
        var t = Nullable.GetUnderlyingType(field.Type) ?? field.Type;

        if (t == typeof(bool)) return InputKind.Bool;
        if (t.IsEnum) return InputKind.Enum;
        if (t == typeof(DateOnly)) return InputKind.Date;
        if (t == typeof(TimeOnly)) return InputKind.Time;
        if (t == typeof(DateTime) || t == typeof(DateTimeOffset))
            return field.ShowTime ? InputKind.DateTime : InputKind.Date;
        if (t == typeof(byte) || t == typeof(sbyte) || t == typeof(short) || t == typeof(ushort)
            || t == typeof(int) || t == typeof(uint) || t == typeof(long) || t == typeof(ulong))
            return InputKind.Integer;
        if (t == typeof(float) || t == typeof(double) || t == typeof(decimal))
            return InputKind.Decimal;

        return InputKind.Text;
    }

    private IEnumerable<QueryFieldOperator> GetOperatorsForField(QueryField? field)
    {
        if (field is null)
        {
            return new[]
            {
                QueryFieldOperator.Equals,
                QueryFieldOperator.NotEquals,
                QueryFieldOperator.Contains,
                QueryFieldOperator.IsNull,
                QueryFieldOperator.IsNotNull
            };
        }

        var fieldType = Nullable.GetUnderlyingType(field.Type) ?? field.Type;

        if (fieldType == typeof(string))
        {
            return new[]
            {
                QueryFieldOperator.Contains,
                QueryFieldOperator.NotContains,
                QueryFieldOperator.Equals,
                QueryFieldOperator.NotEquals,
                QueryFieldOperator.StartsWith,
                QueryFieldOperator.EndsWith,
                QueryFieldOperator.IsNull,
                QueryFieldOperator.IsNotNull
            };
        }

        if (fieldType == typeof(bool))
        {
            return new[]
            {
                QueryFieldOperator.Equals,
                QueryFieldOperator.NotEquals,
                QueryFieldOperator.IsNull,
                QueryFieldOperator.IsNotNull
            };
        }

        if (fieldType.IsEnum)
        {
            return new[]
            {
                QueryFieldOperator.Equals,
                QueryFieldOperator.NotEquals,
                QueryFieldOperator.IsNull,
                QueryFieldOperator.IsNotNull
            };
        }

        if (IsDateLikeType(fieldType) || IsNumericType(fieldType))
        {
            return new[]
            {
                QueryFieldOperator.Equals,
                QueryFieldOperator.NotEquals,
                QueryFieldOperator.GreaterThan,
                QueryFieldOperator.GreaterThanOrEqual,
                QueryFieldOperator.LessThan,
                QueryFieldOperator.LessThanOrEqual,
                QueryFieldOperator.IsNull,
                QueryFieldOperator.IsNotNull
            };
        }

        return new[]
        {
            QueryFieldOperator.Equals,
            QueryFieldOperator.NotEquals,
            QueryFieldOperator.IsNull,
            QueryFieldOperator.IsNotNull
        };
    }

    private string GetOperatorLabel(QueryFieldOperator op) =>
        op switch
        {
            QueryFieldOperator.Equals => Localizer["Operator_Equals"],
            QueryFieldOperator.NotEquals => Localizer["Operator_NotEquals"],
            QueryFieldOperator.Contains => Localizer["Operator_Contains"],
            QueryFieldOperator.NotContains => Localizer["Operator_NotContains"],
            QueryFieldOperator.StartsWith => Localizer["Operator_StartsWith"],
            QueryFieldOperator.EndsWith => Localizer["Operator_EndsWith"],
            QueryFieldOperator.GreaterThan => Localizer["Operator_GreaterThan"],
            QueryFieldOperator.LessThan => Localizer["Operator_LessThan"],
            QueryFieldOperator.GreaterThanOrEqual => Localizer["Operator_GreaterThanOrEqual"],
            QueryFieldOperator.LessThanOrEqual => Localizer["Operator_LessThanOrEqual"],
            QueryFieldOperator.In => Localizer["Operator_In"],
            QueryFieldOperator.NotIn => Localizer["Operator_NotIn"],
            QueryFieldOperator.IsNull => Localizer["Operator_IsNull"],
            QueryFieldOperator.IsNotNull => Localizer["Operator_IsNotNull"],
            _ => op.ToString()
        };

    private string GetValuePlaceholder(QueryField? field)
    {
        if (field is null)
        {
            return Localizer["EnterValue"];
        }

        var fieldType = Nullable.GetUnderlyingType(field.Type) ?? field.Type;
        if (IsDateLikeType(fieldType))
        {
            return Localizer["DateExample"];
        }

        if (fieldType == typeof(bool))
        {
            return "true / false";
        }

        if (IsNumericType(fieldType))
        {
            return Localizer["NumericValue"];
        }

        return Localizer.GetString("ValueFor", field.Label.ToLowerInvariant());
    }

    private static bool IsUnaryOperator(QueryFieldOperator op) =>
        op == QueryFieldOperator.IsNull || op == QueryFieldOperator.IsNotNull;

    private static bool IsDateLikeType(Type type) =>
        type == typeof(DateTime) || type == typeof(DateTimeOffset)
        || type == typeof(DateOnly) || type == typeof(TimeOnly);

    private static bool IsNumericType(Type type) =>
        type == typeof(byte) ||
        type == typeof(short) ||
        type == typeof(int) ||
        type == typeof(long) ||
        type == typeof(float) ||
        type == typeof(double) ||
        type == typeof(decimal) ||
        type == typeof(sbyte) ||
        type == typeof(ushort) ||
        type == typeof(uint) ||
        type == typeof(ulong);
}
