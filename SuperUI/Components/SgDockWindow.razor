@namespace SuperUI.Components
@using SuperUI.Services
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject SgZIndexService ZIndex

@if (Visible)
{
    <div class="sgc-win @(_maximized ? "sgc-win-maximized" : "") @(_isFocused ? "sgc-win-focus" : "") @CssClass"
         style="@ComputedStyle"
         @ref="_el">
        <div class="sgc-win-header">
            <span class="sgc-win-title">@Title</span>
            <div class="sgc-win-actions">
                @if (ShowMinimize)
                {
                    <button type="button" class="sgc-win-btn" title="@Localizer["Minimize"]" @onclick="MinimizeAsync">—</button>
                }
                @if (ShowMaximize)
                {
                    <button type="button" class="sgc-win-btn" title="@Localizer["Maximize"]" @onclick="ToggleMaximizeAsync">@(_maximized ? "❐" : "▢")</button>
                }
                @if (ShowClose)
                {
                    <button type="button" class="sgc-win-btn sgc-win-close" title="@Localizer["Close"]" @onclick="CloseAsync">×</button>
                }
            </div>
        </div>
        @if (!_minimized)
        {
            <div class="sgc-win-body">@ChildContent</div>
            @if (FooterContent is not null)
            {
                <div class="sgc-win-footer">@FooterContent</div>
            }
            <div class="sgc-win-resize"></div>
        }
    </div>
}

@code {
    private ElementReference _el;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SgDockWindow>? _self;
    private bool _attached;
    private bool _maximized;
    private bool _minimized;
    private bool _isFocused;
    private bool _isDisposed;
    private int _zIndex;

    [Parameter] public bool Visible { get; set; } = true;
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public double Left { get; set; } = 80;
    [Parameter] public double Top { get; set; } = 80;
    [Parameter] public double Width { get; set; } = 420;
    [Parameter] public double Height { get; set; } = 300;
    [Parameter] public bool ShowClose { get; set; } = true;
    [Parameter] public bool ShowMaximize { get; set; } = true;
    [Parameter] public bool ShowMinimize { get; set; } = true;
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string ComputedStyle
    {
        get
        {
            var styles = new List<string>();
            if (_zIndex > 0) styles.Add($"z-index: {_zIndex}");

            if (_maximized)
            {
                styles.Add("left:0;top:0;right:0;bottom:0;width:auto;height:auto;");
            }
            else
            {
                var ci = System.Globalization.CultureInfo.InvariantCulture;
                var h = _minimized ? "auto" : Height.ToString(ci) + "px";
                styles.Add($"left:{Left.ToString(ci)}px");
                styles.Add($"top:{Top.ToString(ci)}px");
                styles.Add($"width:{Width.ToString(ci)}px");
                styles.Add($"height:{h}");
            }
            return string.Join("; ", styles);
        }
    }

    protected override void OnInitialized()
    {
        ZIndex.TopOwnerChanged += HandleTopOwnerChanged;
    }

    private void HandleTopOwnerChanged(object? topOwner)
    {
        var isTop = ReferenceEquals(topOwner, this);
        if (_isFocused != isTop)
        {
            _isFocused = isTop;
            InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isDisposed) return;
        if (!Visible)
        {
            if (_zIndex > 0)
            {
                ZIndex.Release(this);
                _zIndex = 0;
                _isFocused = false;
            }
            _attached = false;
            return;
        }

        if (_zIndex == 0)
        {
            _zIndex = ZIndex.Allocate(this, SgZIndexService.WindowBase);
        }

        if (_attached) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/superui-window.js");
            if (_isDisposed) return;
            
            _self ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _el, _self);
            _attached = true;
        }
        catch (JSException) { }
        catch (TaskCanceledException) { }
    }

    [JSInvokable]
    public async Task FocusAsync()
    {
        if (_isDisposed || _isFocused) return;
        _zIndex = ZIndex.Allocate(this, SgZIndexService.WindowBase);
        _isFocused = true;
        await InvokeAsync(StateHasChanged);
    }

    private Task MinimizeAsync()
    {
        _minimized = !_minimized;
        return InvokeAsync(StateHasChanged);
    }

    private Task ToggleMaximizeAsync()
    {
        _maximized = !_maximized;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task CloseAsync()
    {
        Visible = false;
        _attached = false;
        if (_zIndex > 0)
        {
            ZIndex.Release(this);
            _zIndex = 0;
        }
        if (VisibleChanged.HasDelegate) await VisibleChanged.InvokeAsync(false);
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_isDisposed) return;
        _isDisposed = true;
        _attached = false;

        ZIndex.TopOwnerChanged -= HandleTopOwnerChanged;

        if (_zIndex > 0)
        {
            ZIndex.Release(this);
            _zIndex = 0;
        }

        _self?.Dispose();

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSException) { }
            catch (TaskCanceledException) { }
            catch (ObjectDisposedException) { }
        }
    }
}
