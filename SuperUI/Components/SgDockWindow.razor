@namespace SuperUI.Components
@using SuperUI.Services
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject SgZIndexService ZIndex

@if (Visible)
{
    <div class="sgc-win @(_maximized ? "sgc-win-maximized" : "") @(_minimized ? "sgc-win-minimized" : "") @(_isFocused ? "sgc-win-focus" : "") @CssClass"
         style="@ComputedStyle"
         role="dialog"
         aria-label="@(Title ?? "Window")"
         aria-modal="false"
         @ref="_el"
         @attributes="AdditionalAttributes">
        <div class="sgc-win-header">
            <span class="sgc-win-title">@Title</span>
            <div class="sgc-win-actions">
                @if (ShowMinimize)
                {
                    <button type="button" class="sgc-win-btn"
                            title="@(_minimized ? Localizer["Restore"] : Localizer["Minimize"])"
                            aria-label="@(_minimized ? Localizer["Restore"] : Localizer["Minimize"])"
                            @onclick="MinimizeAsync">@(_minimized ? "▣" : "—")</button>
                }
                @if (ShowMaximize)
                {
                    <button type="button" class="sgc-win-btn"
                            title="@(_maximized ? Localizer["Restore"] : Localizer["Maximize"])"
                            aria-label="@(_maximized ? Localizer["Restore"] : Localizer["Maximize"])"
                            @onclick="ToggleMaximizeAsync">@(_maximized ? "❐" : "▢")</button>
                }
                @if (ShowClose)
                {
                    <button type="button" class="sgc-win-btn sgc-win-close"
                            title="@Localizer["Close"]"
                            aria-label="@Localizer["Close"]"
                            @onclick="CloseAsync">×</button>
                }
            </div>
        </div>
        @if (!_minimized)
        {
            <div class="sgc-win-body">@ChildContent</div>
            @if (FooterContent is not null)
            {
                <div class="sgc-win-footer">@FooterContent</div>
            }
            <div class="sgc-win-resize"></div>
        }
    </div>
}

@code {
    private ElementReference _el;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SgDockWindow>? _self;
    private bool _attached;
    private bool _maximized;
    private bool _minimized;
    private bool _isFocused;
    private bool _isDisposed;
    private int _zIndex;
    private double _savedLeft;
    private double _savedTop;
    private double _savedWidth;
    private double _savedHeight;
    private double _lastParentLeft = double.NaN;
    private double _lastParentTop = double.NaN;
    private double _lastParentWidth = double.NaN;
    private double _lastParentHeight = double.NaN;

    [Parameter] public bool Visible { get; set; } = true;
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public double Left { get; set; } = 80;
    [Parameter] public double Top { get; set; } = 80;
    [Parameter] public double Width { get; set; } = 420;
    [Parameter] public double Height { get; set; } = 300;
    [Parameter] public bool ShowClose { get; set; } = true;
    [Parameter] public bool ShowMaximize { get; set; } = true;
    [Parameter] public bool ShowMinimize { get; set; } = true;
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public EventCallback<double> LeftChanged { get; set; }
    [Parameter] public EventCallback<double> TopChanged { get; set; }
    [Parameter] public EventCallback<double> WidthChanged { get; set; }
    [Parameter] public EventCallback<double> HeightChanged { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedStyle
    {
        get
        {
            var styles = new List<string>();
            if (_zIndex > 0) styles.Add($"z-index: {_zIndex}");

            if (_maximized)
            {
                styles.Add("left:0;top:0;right:0;bottom:0;width:auto;height:auto;");
            }
            else
            {
                var ci = System.Globalization.CultureInfo.InvariantCulture;
                var h = _minimized ? "auto" : Height.ToString(ci) + "px";
                styles.Add($"left:{Left.ToString(ci)}px");
                styles.Add($"top:{Top.ToString(ci)}px");
                styles.Add($"width:{Width.ToString(ci)}px");
                styles.Add($"height:{h}");
            }
            return string.Join("; ", styles);
        }
    }

    protected override void OnInitialized()
    {
        ZIndex.TopOwnerChanged += HandleTopOwnerChanged;
        _lastParentLeft = Left;
        _lastParentTop = Top;
        _lastParentWidth = Width;
        _lastParentHeight = Height;
    }

    // Track parent-supplied parameter values separately from JS-driven runtime state.
    // Without this, any parent re-render (e.g. typing in an unrelated input) resets
    // Left/Top back to the literal values supplied in markup, undoing user drag/resize.
    protected override void OnParametersSet()
    {
        var leftChangedByParent = !double.IsNaN(_lastParentLeft) && Left != _lastParentLeft;
        var topChangedByParent = !double.IsNaN(_lastParentTop) && Top != _lastParentTop;
        var widthChangedByParent = !double.IsNaN(_lastParentWidth) && Width != _lastParentWidth;
        var heightChangedByParent = !double.IsNaN(_lastParentHeight) && Height != _lastParentHeight;

        if (!leftChangedByParent && _runtimeLeft is { } rl) Left = rl;
        if (!topChangedByParent && _runtimeTop is { } rt) Top = rt;
        if (!widthChangedByParent && _runtimeWidth is { } rw) Width = rw;
        if (!heightChangedByParent && _runtimeHeight is { } rh) Height = rh;

        _lastParentLeft = Left;
        _lastParentTop = Top;
        _lastParentWidth = Width;
        _lastParentHeight = Height;
    }

    private double? _runtimeLeft;
    private double? _runtimeTop;
    private double? _runtimeWidth;
    private double? _runtimeHeight;

    private void HandleTopOwnerChanged(object? topOwner)
    {
        var isTop = ReferenceEquals(topOwner, this);
        if (_isFocused != isTop)
        {
            _isFocused = isTop;
            InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isDisposed) return;
        if (!Visible)
        {
            if (_zIndex > 0)
            {
                ZIndex.Release(this);
                _zIndex = 0;
                _isFocused = false;
            }
            _attached = false;
            return;
        }

        if (_zIndex == 0)
        {
            _zIndex = ZIndex.Allocate(this, SgZIndexService.WindowBase);
        }

        if (_attached) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/superui-window.js");
            if (_isDisposed) return;
            
            _self ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _el, _self);
            _attached = true;
        }
        catch (JSException) { }
        catch (TaskCanceledException) { }
    }

    [JSInvokable]
    public async Task FocusAsync()
    {
        if (_isDisposed || _isFocused) return;
        _zIndex = ZIndex.Allocate(this, SgZIndexService.WindowBase);
        _isFocused = true;
        await InvokeAsync(StateHasChanged);
    }

    private Task MinimizeAsync()
    {
        _minimized = !_minimized;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task ToggleMaximizeAsync()
    {
        if (!_maximized)
        {
            _savedLeft = Left;
            _savedTop = Top;
            _savedWidth = Width;
            _savedHeight = Height;
        }
        else
        {
            Left = _savedLeft;
            Top = _savedTop;
            Width = _savedWidth;
            Height = _savedHeight;
        }
        _maximized = !_maximized;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task UpdateBoundsAsync(double left, double top, double width, double height)
    {
        Left = left;
        Top = top;
        Width = width;
        Height = height;
        _runtimeLeft = left;
        _runtimeTop = top;
        _runtimeWidth = width;
        _runtimeHeight = height;
        _lastParentLeft = left;
        _lastParentTop = top;
        _lastParentWidth = width;
        _lastParentHeight = height;
        if (LeftChanged.HasDelegate) await LeftChanged.InvokeAsync(left);
        if (TopChanged.HasDelegate) await TopChanged.InvokeAsync(top);
        if (WidthChanged.HasDelegate) await WidthChanged.InvokeAsync(width);
        if (HeightChanged.HasDelegate) await HeightChanged.InvokeAsync(height);
    }

    [JSInvokable]
    public async Task CloseAsync()
    {
        Visible = false;
        _attached = false;
        if (_zIndex > 0)
        {
            ZIndex.Release(this);
            _zIndex = 0;
        }
        if (VisibleChanged.HasDelegate) await VisibleChanged.InvokeAsync(false);
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_isDisposed) return;
        _isDisposed = true;
        _attached = false;

        ZIndex.TopOwnerChanged -= HandleTopOwnerChanged;

        if (_zIndex > 0)
        {
            ZIndex.Release(this);
            _zIndex = 0;
        }

        _self?.Dispose();

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSException) { }
            catch (TaskCanceledException) { }
            catch (ObjectDisposedException) { }
        }
    }
}
