@namespace SuperUI.Components
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject SgZIndexService ZIndex

@if (_visible)
{
    <SgPortal>
        <div class="sgc-context-menu-overlay" 
             style="z-index: @_overlayZIndex"
             @onclick="Close" 
             @oncontextmenu:preventDefault 
             @oncontextmenu="Close">
            <div class="sgc-context-menu" 
                 style="@_style" 
                 role="menu"
                 aria-label="@AriaLabel"
                 @ref="_menuRef"
                 @onclick:stopPropagation="true">
                @ChildContent
            </div>
        </div>
    </SgPortal>
}

@code {
    private ElementReference _menuRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SgContextMenu>? _self;
    private bool _isDisposed;
    private bool _visible;
    private bool _attached;
    private string _style = "";
    private int _zIndex;
    private int _overlayZIndex;
    private ElementReference? _triggerElement;

    /// <summary>
    /// Gets or sets the menu content.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the ARIA label for the menu.
    /// </summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// Callback invoked when the menu is shown.
    /// </summary>
    [Parameter] public EventCallback OnShow { get; set; }

    /// <summary>
    /// Callback invoked when the menu is closed.
    /// </summary>
    [Parameter] public EventCallback OnClose { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isDisposed || !_visible || _attached) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/superui-contextmenu.js");
            if (_isDisposed) return;
            _self ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _menuRef, _self);
            _attached = true;
        }
        catch (JSException) { }
        catch (TaskCanceledException) { }
    }

    /// <summary>
    /// Opens the context menu at the specified coordinates.
    /// </summary>
    public async Task Open(double x, double y, ElementReference? triggerElement = null)
    {
        if (_isDisposed) return;
        
        _triggerElement = triggerElement;
        _zIndex = ZIndex.Allocate(this, SgZIndexService.PopoverBase);
        _overlayZIndex = _zIndex - 1;
        _style = $"left: {x}px; top: {y}px; z-index: {_zIndex}";
        _visible = true;
        _attached = false;
        if (OnShow.HasDelegate) await OnShow.InvokeAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Opens the context menu at the mouse event position.
    /// </summary>
    public Task Show(MouseEventArgs e, ElementReference? triggerElement = null) => Open(e.ClientX, e.ClientY, triggerElement);

    [JSInvokable]
    public Task CloseFromJsAsync() => Close();

    /// <summary>
    /// Closes the context menu.
    /// </summary>
    public async Task Close()
    {
        if (_isDisposed) return;
        _visible = false;
        
        if (_zIndex > 0)
        {
            ZIndex.Release(this);
            _zIndex = 0;
        }
        
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
        
        if (_module is not null && _attached)
        {
            try { await _module.InvokeVoidAsync("detach", _menuRef); }
            catch (JSException) { }
            catch (TaskCanceledException) { }
        }
        _attached = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_isDisposed) return;
        _isDisposed = true;

        if (_zIndex > 0)
        {
            ZIndex.Release(this);
            _zIndex = 0;
        }

        // 1. Уведомить JS о dispose
        if (_module is not null && _attached)
        {
            try { await _module.InvokeVoidAsync("detach", _menuRef); }
            catch (JSException) { }
            catch (TaskCanceledException) { }
            catch { }
        }

        // 2. Очистить DotNetObjectReference
        var self = _self;
        _self = null;
        self?.Dispose();

        // 3. Очистить JS модуль
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSException) { }
            catch (TaskCanceledException) { }
            catch (ObjectDisposedException) { }
            _module = null;
        }
        _attached = false;
    }
}
