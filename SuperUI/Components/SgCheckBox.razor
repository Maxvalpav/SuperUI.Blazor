@namespace SuperUI.Components
@inherits SgFormFieldBase<bool>
@inject IJSRuntime JS

<div class="@GetRootClasses()">
    <label class="@GetCheckClasses()">
        <input type="checkbox"
               checked="@Value"
               disabled="@IsEffectivelyDisabled"
               aria-checked="@AriaChecked"
               aria-invalid="@(HasError ? "true" : null)"
               aria-describedby="@DescribedBy"
               @onchange="OnChangeAsync"
               @attributes="AdditionalAttributes"
               @ref="_inputRef" />
        @if (ChildContent is not null) { @ChildContent }
        else if (!string.IsNullOrEmpty(Label)) { <span>@Label</span> }
    </label>
    @if (HasError)
    {
        <span id="@_errorId" class="sgc-error">@(!string.IsNullOrEmpty(ErrorText) ? ErrorText : ValidationMessages.FirstOrDefault())</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@_hintId" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private readonly string _id = "sg-chk-" + Guid.NewGuid().ToString("N")[..8];
    private string _hintId => _id + "-hint";
    private string _errorId => _id + "-err";
    private ElementReference _inputRef;
    private IJSObjectReference? _module;
    private bool _lastIndeterminate;

    [Parameter] public bool Indeterminate { get; set; }
    [Parameter] public EventCallback<bool> IndeterminateChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Block { get; set; }

    protected override string ComponentPrefix => "chk";

    private string AriaChecked => Indeterminate ? "mixed" : Value.ToString().ToLowerInvariant();
    private string? DescribedBy => HasError ? _errorId : (!string.IsNullOrEmpty(Hint) ? _hintId : null);

    private string GetRootClasses() => Css("sgc-check-field")
        .AddIf("sgc-block", Block)
        .Add(Class)
        .ToString();

    private string GetCheckClasses() => Css("sgc-check")
        .AddIf("sgc-disabled", IsEffectivelyDisabled)
        .AddIf("sgc-indeterminate", Indeterminate)
        .AddIf("sgc-check-invalid", HasError)
        .ToString();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (IsDisposed) return;
        if (firstRender || _lastIndeterminate != Indeterminate)
        {
            _lastIndeterminate = Indeterminate;
            await SetIndeterminateAsync();
        }
    }

    private async Task SetIndeterminateAsync()
    {
        if (IsStaticSSR) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/superui.js");
            if (IsDisposed) return;
            await _module.InvokeVoidAsync("setIndeterminate", _inputRef, Indeterminate);
        }
        catch (JSException) { }
        catch (TaskCanceledException) { }
    }

    private async Task OnChangeAsync(ChangeEventArgs e)
    {
        if (IsEffectivelyDisabled) return;

        if (Indeterminate)
        {
            Indeterminate = false;
            await SetIndeterminateAsync();
            if (IndeterminateChanged.HasDelegate)
                await IndeterminateChanged.InvokeAsync(false);
            await SetValueAsync(true);
        }
        else
        {
            await SetValueAsync(e.Value is true);
        }
    }

    protected override async ValueTask DisposeComponentAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { }
        }
        await base.DisposeComponentAsync();
    }
}
