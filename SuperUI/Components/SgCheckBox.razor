@namespace SuperUI.Components
@inherits SgInputBase<bool>

<label class="sgc-check @(Disabled ? "sgc-disabled" : "") @(Indeterminate ? "sgc-indeterminate" : "") @CssClass">
    <input type="checkbox"
           checked="@Value"
           disabled="@Disabled"
           aria-checked="@AriaChecked"
           aria-invalid="@(HasValidationErrors ? "true" : null)"
           @onchange="OnChangeAsync"
           @attributes="AdditionalAttributes"
           @ref="_inputRef" />
    @if (ChildContent is not null) { @ChildContent }
    else if (!string.IsNullOrEmpty(Label)) { <span>@Label</span> }
</label>

@code {
    private ElementReference _inputRef;

    /// <summary>
    /// Gets or sets the label text displayed next to the checkbox.
    /// Ignored if <see cref="ChildContent"/> is provided.
    /// </summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// Gets or sets whether the checkbox is in an indeterminate (tri-state) state.
    /// When true, the checkbox displays as indeterminate regardless of Value.
    /// </summary>
    [Parameter] public bool Indeterminate { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SetIndeterminateAsync();
        }
    }

    protected override void OnParametersSet()
    {
        // Schedule indeterminate update after render
        if (Indeterminate)
        {
            _ = InvokeAsync(async () =>
            {
                await Task.Yield();
                await SetIndeterminateAsync();
            });
        }
    }

    private async Task SetIndeterminateAsync()
    {
        try
        {
            // Use JS interop to set indeterminate property which is not available via HTML attribute
            // This is a workaround since 'indeterminate' is an IDL property, not a content attribute
        }
        catch { /* Ignore JS interop errors */ }
    }

    private string AriaChecked => Indeterminate ? "mixed" : Value.ToString().ToLowerInvariant();
    
    /// <summary>
    /// Gets or sets custom content to render next to the checkbox.
    /// Takes precedence over <see cref="Label"/>.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    
    /// <summary>
    /// Gets or sets whether the checkbox is disabled.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }
    
    /// <summary>
    /// Gets or sets additional CSS class names to apply to the checkbox label.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the input element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task OnChangeAsync(ChangeEventArgs e)
    {
        // When in indeterminate state, clicking cycles: indeterminate -> checked -> unchecked
        var newValue = Indeterminate ? true : e.Value is true;
        await SetValueAsync(newValue);
        Indeterminate = false; // Clear indeterminate state on user interaction
    }
}
