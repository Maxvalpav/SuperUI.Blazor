@namespace SuperUI.Components
@inherits SgInputBase<bool>
@inject IJSRuntime JS

<label class="sgc-check @(Disabled ? "sgc-disabled" : "") @(Indeterminate ? "sgc-indeterminate" : "") @CssClass">
    <input type="checkbox"
           checked="@Value"
           disabled="@Disabled"
           aria-checked="@AriaChecked"
           aria-invalid="@(HasValidationErrors ? "true" : null)"
           @onchange="OnChangeAsync"
           @attributes="AdditionalAttributes"
           @ref="_inputRef" />
    @if (ChildContent is not null) { @ChildContent }
    else if (!string.IsNullOrEmpty(Label)) { <span>@Label</span> }
</label>

@code {
    private ElementReference _inputRef;
    private IJSObjectReference? _module;
    private bool _lastIndeterminate;
    private bool _isDisposed;

    /// <summary>Label text shown next to the checkbox. Ignored when <see cref="ChildContent"/> is set.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Whether the checkbox is in indeterminate (tri-state) state.</summary>
    [Parameter] public bool Indeterminate { get; set; }

    /// <summary>Callback raised when <see cref="Indeterminate"/> changes. Supports <c>@bind-Indeterminate</c>.</summary>
    [Parameter] public EventCallback<bool> IndeterminateChanged { get; set; }

    /// <summary>Custom content rendered next to the checkbox. Takes precedence over <see cref="Label"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Whether the checkbox is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Additional CSS class names applied to the label element.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Additional HTML attributes applied to the input element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string AriaChecked => Indeterminate ? "mixed" : Value.ToString().ToLowerInvariant();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isDisposed) return;
        if (firstRender || _lastIndeterminate != Indeterminate)
        {
            _lastIndeterminate = Indeterminate;
            await SetIndeterminateAsync();
        }
    }

    private async Task SetIndeterminateAsync()
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/superui.js");
            if (_isDisposed) return;
            await _module.InvokeVoidAsync("setIndeterminate", _inputRef, Indeterminate);
        }
        catch (JSException) { }
        catch (TaskCanceledException) { }
    }

    private async Task OnChangeAsync(ChangeEventArgs e)
    {
        if (Indeterminate)
        {
            // indeterminate → checked: clear indeterminate first, then set value true
            await SetIndeterminateAsync();
            if (IndeterminateChanged.HasDelegate)
                await IndeterminateChanged.InvokeAsync(false);
            await SetValueAsync(true);
        }
        else
        {
            await SetValueAsync(e.Value is true);
        }
    }

    public override void Dispose()
    {
        _isDisposed = true;
        base.Dispose();
    }
}
