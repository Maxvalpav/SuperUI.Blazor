@namespace SuperUI.Components
@inherits SgInputBase<bool>

<label class="sgc-check @(Disabled ? "sgc-disabled" : "") @CssClass">
    <input type="checkbox"
           role="checkbox"
           checked="@Value"
           disabled="@Disabled"
           aria-checked="@Value.ToString().ToLowerInvariant()"
           aria-invalid="@(HasValidationErrors ? "true" : null)"
           @onchange="OnChangeAsync" />
    @if (ChildContent is not null) { @ChildContent }
    else if (!string.IsNullOrEmpty(Label)) { <span>@Label</span> }
</label>

@code {
    /// <summary>
    /// Gets or sets the label text displayed next to the checkbox.
    /// Ignored if <see cref="ChildContent"/> is provided.
    /// </summary>
    [Parameter] public string? Label { get; set; }
    
    /// <summary>
    /// Gets or sets custom content to render next to the checkbox.
    /// Takes precedence over <see cref="Label"/>.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    
    /// <summary>
    /// Gets or sets whether the checkbox is disabled.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }
    
    /// <summary>
    /// Gets or sets additional CSS class names to apply to the checkbox label.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    private Task OnChangeAsync(ChangeEventArgs e) => SetValueAsync(e.Value is true);
}
