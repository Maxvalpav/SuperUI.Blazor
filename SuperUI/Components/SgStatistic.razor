@namespace SuperUI.Components

<div class="sgc-statistic @CssClass" style="@Style" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="sgc-statistic-title">@Title</div>
    }
    <div class="sgc-statistic-content">
        @if (PrefixContent != null)
        {
            <span class="sgc-statistic-prefix">@PrefixContent</span>
        }
        <span class="sgc-statistic-value">@Value</span>
        @if (SuffixContent != null)
        {
            <span class="sgc-statistic-suffix">@SuffixContent</span>
        }
    </div>
    @if (TrendValue != null)
    {
        <div class="sgc-statistic-trend @(TrendValue >= 0 ? "sgc-trend-up" : "sgc-trend-down")">
            @(TrendValue >= 0 ? "▲" : "▼") @FormattedTrend
        </div>
    }
</div>

@code {
    /// <summary>Title displayed above the value.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Pre-formatted main value text.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Optional content rendered before the value (e.g. icon, currency symbol).</summary>
    [Parameter] public RenderFragment? PrefixContent { get; set; }

    /// <summary>Optional content rendered after the value.</summary>
    [Parameter] public RenderFragment? SuffixContent { get; set; }

    /// <summary>
    /// Trend ratio expressed as a fraction (e.g. <c>0.15</c> renders as 15.0%).
    /// Sign controls the up/down arrow.
    /// </summary>
    [Parameter] public double? TrendValue { get; set; }

    /// <summary>
    /// Numeric format string for the trend value. Default is <c>"P1"</c> (percent with 1 decimal).
    /// </summary>
    [Parameter] public string TrendFormat { get; set; } = "P1";

    /// <summary>
    /// Gets or sets additional CSS classes to apply to the component.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Gets or sets inline CSS styles to apply to the statistic container.
    /// </summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string FormattedTrend
    {
        get
        {
            if (TrendValue is null) return string.Empty;
            var value = Math.Abs(TrendValue.Value);
            return value.ToString(TrendFormat);
        }
    }
}
