@namespace SuperUI.Components
@using SuperUI.Base.Services
@using SuperUI.Localization
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ISuperUILocalizer Localizer
@inject IZIndexService ZIndex

@if (Visible || _isClosing)
{
    <div class="sg-drawer-backdrop @(_isClosing ? "sg-drawer-backdrop--closing" : "")"
         style="z-index:@(_backdropZIndex)"
         @onclick="BackdropAsync" />

    <div @ref="_drawerRef"
         class="sg-drawer sg-drawer--@PlacementClass @(_isClosing ? "sg-drawer--closing" : "") @CssClass"
         style="@SizeStyle"
         role="dialog"
         aria-modal="true"
         aria-labelledby="@_titleId"
         tabindex="-1"
         @onkeydown="HandleKeyDownAsync">

        <div class="sg-drawer__header">
            <h2 id="@_titleId" class="sg-drawer__title">@Title</h2>
            @if (ShowClose)
            {
                <button class="sg-drawer__close"
                        aria-label="@Localizer["Close"]"
                        @onclick="CloseAsync">×</button>
            }
        </div>

        @if (Resizable)
        {
            <div class="sg-drawer__resize-handle sg-drawer__resize-handle--@PlacementClass" />
        }

        <div class="sg-drawer__body">
            @ChildContent
        </div>

        @if (FooterContent is not null)
        {
            <div class="sg-drawer__footer">
                @FooterContent
            </div>
        }
    </div>
}

@code {
    // ── IDs ──────────────────────────────────────────────────────────────────────
    private readonly string _titleId = "drawer-title-" + Guid.NewGuid().ToString("N")[..8];

    // ── Состояние ────────────────────────────────────────────────────────────────
    private ElementReference _drawerRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SgDrawer>? _self;
    private int  _disposed;   // Interlocked
    private bool _previousVisible;
    private bool _isClosing;
    private int  _zIndex;
    private int  _backdropZIndex;
    private CancellationTokenSource? _closeCts;
    private string _runtimeSize = string.Empty;

    // ── Параметры ────────────────────────────────────────────────────────────────
    [Parameter] public bool              Visible         { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string?           Title           { get; set; }
    [Parameter] public RenderFragment?   ChildContent    { get; set; }
    [Parameter] public RenderFragment?   FooterContent   { get; set; }
    [Parameter] public SgPlacement       Placement       { get; set; } = SgPlacement.Right;
    [Parameter] public string            Size            { get; set; } = "360px";
    [Parameter] public EventCallback<string> SizeChanged { get; set; }
    [Parameter] public bool              Resizable       { get; set; }
    [Parameter] public bool              ShowClose       { get; set; } = true;
    [Parameter] public bool              CloseOnBackdrop { get; set; } = true;
    [Parameter] public bool              CloseOnEscape   { get; set; } = true;
    [Parameter] public EventCallback     OnClose         { get; set; }
    [Parameter] public string?           CssClass        { get; set; }

    // ── Вспомогательные ──────────────────────────────────────────────────────────
    private bool IsDisposed => Volatile.Read(ref _disposed) == 1;

    private string PlacementClass => Placement switch
    {
        SgPlacement.Left   => "left",
        SgPlacement.Top    => "top",
        SgPlacement.Bottom => "bottom",
        _                  => "right"
    };

    private string SizeStyle
    {
        get
        {
            var sz    = string.IsNullOrEmpty(_runtimeSize) ? Size : _runtimeSize;
            var parts = new List<string>();
            if (_zIndex > 0) parts.Add($"z-index:{_zIndex}");
            if (Placement is SgPlacement.Left or SgPlacement.Right)
            {
                parts.Add($"width:{sz}");
                parts.Add("max-width:100vw");
            }
            else
            {
                parts.Add($"height:{sz}");
                parts.Add("max-height:100vh");
            }
            return string.Join(";", parts) + ";";
        }
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────────────
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsDisposed) return;

        if (Visible && !_previousVisible)
        {
            // ИСПРАВЛЕНО: Allocate(int) вместо Allocate(this, SgZIndexService.DrawerBase)
            _zIndex         = ZIndex.Allocate(ZIndexService.DrawerBase);
            _backdropZIndex = _zIndex - 5;

            try
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>(
                    "import", "_content/SuperUI/superui-drawer.js");
                if (IsDisposed) return;
                _self ??= DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("attach", _drawerRef, _self, CloseOnEscape);
                if (Resizable)
                    await _module.InvokeVoidAsync("initResize", _drawerRef, _self, PlacementClass);
            }
            catch (JSException) { }
            catch (TaskCanceledException) { }
            catch (JSDisconnectedException) { }
        }
        else if (!Visible && _previousVisible)
        {
            if (_zIndex > 0)
            {
                // ИСПРАВЛЕНО: Release(_zIndex) вместо Release(this)
                ZIndex.Release(_zIndex);
                _zIndex = 0;
            }
            if (_module is not null)
            {
                try   { await _module.InvokeVoidAsync("detach"); }
                catch (JSException) { }
                catch (TaskCanceledException) { }
                catch (JSDisconnectedException) { }
            }
        }

        _previousVisible = Visible;
    }

    // ── JS-invokable ──────────────────────────────────────────────────────────────
    [JSInvokable]
    public Task CloseFromJsAsync() => CloseAsync();

    [JSInvokable]
    public async Task UpdateSizeFromJs(string newSize)
    {
        _runtimeSize = newSize;
        if (SizeChanged.HasDelegate) await SizeChanged.InvokeAsync(newSize);
        await InvokeAsync(StateHasChanged);
    }

    // ── Keyboard ──────────────────────────────────────────────────────────────────
    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (CloseOnEscape && e.Key == "Escape") await CloseAsync();
    }

    // ── CloseAsync ────────────────────────────────────────────────────────────────
    public async Task CloseAsync()
    {
        if (IsDisposed || _isClosing) return;

        _closeCts?.Cancel();
        _closeCts?.Dispose();
        _closeCts = new CancellationTokenSource();
        var token = _closeCts.Token;

        _isClosing = true;
        StateHasChanged();

        try   { await Task.Delay(300, token); }
        catch (TaskCanceledException) { return; }

        _isClosing = false;
        if (VisibleChanged.HasDelegate) await VisibleChanged.InvokeAsync(false);
        if (OnClose.HasDelegate)        await OnClose.InvokeAsync();
    }

    private Task BackdropAsync() => CloseOnBackdrop ? CloseAsync() : Task.CompletedTask;

    // ── IAsyncDisposable ──────────────────────────────────────────────────────────
    public async ValueTask DisposeAsync()
    {
        if (Interlocked.Exchange(ref _disposed, 1) == 1) return;

        _closeCts?.Cancel();
        _closeCts?.Dispose();

        if (_zIndex > 0)
        {
            ZIndex.Release(_zIndex);
            _zIndex = 0;
        }

        if (_module is not null)
        {
            try   { await _module.InvokeVoidAsync("detach"); }
            catch (JSException) { }
            catch (TaskCanceledException) { }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }

        var self = _self;
        _self = null;
        self?.Dispose();

        if (_module is not null)
        {
            try   { await _module.DisposeAsync(); }
            catch (JSException) { }
            catch (TaskCanceledException) { }
            catch (ObjectDisposedException) { }
            _module = null;
        }
    }
}
