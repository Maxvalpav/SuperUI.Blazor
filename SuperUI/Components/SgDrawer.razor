@namespace SuperUI.Components
@using SuperUI.Localization
@using SuperUI.Services
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ISuperUILocalizer Localizer
@inject SgZIndexService ZIndex

@if (Visible || _isClosing)
{
    <div class="sgc-drawer-backdrop @(_isClosing ? "sgc-closing" : "")" style="z-index: @_backdropZIndex" @onclick="BackdropAsync">
        <aside class="sgc-drawer sgc-drawer-@Placement @CssClass"
               style="@SizeStyle"
               role="complementary"
               aria-labelledby="@_titleId"
               tabindex="-1"
               @ref="_drawerRef"
               @onclick:stopPropagation="true">
            <div class="sgc-drawer-header">
                <span id="@_titleId" class="sgc-drawer-title">@Title</span>
                @if (ShowClose)
                {
                    <button type="button" class="sgc-modal-x" @onclick="CloseAsync" aria-label="@Localizer["Close"]">×</button>
                }
            </div>
            @if (Resizable)
            {
                <div class="sgc-drawer-resizer sgc-drawer-resizer-@Placement" role="separator" aria-label="Resize drawer" aria-orientation="@(Placement is "left" or "right" ? "vertical" : "horizontal")"></div>
            }
            <div class="sgc-drawer-body">@ChildContent</div>
            @if (FooterContent is not null)
            {
                <div class="sgc-drawer-footer">@FooterContent</div>
            }
        </aside>
    </div>
}

@code {
    private readonly string _titleId = "drawer-title-" + Guid.NewGuid().ToString("N")[..8];
    private ElementReference _drawerRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SgDrawer>? _self;
    private bool _isDisposed;
    private bool _previousVisible;
    private bool _isClosing;
    private int _zIndex;
    private int _backdropZIndex;
    private CancellationTokenSource? _closeCts;
    private string _runtimeSize = string.Empty;

    /// <summary>
    /// Gets or sets whether the drawer is visible.
    /// </summary>
    [Parameter] public bool Visible { get; set; }

    /// <summary>
    /// Callback invoked when <see cref="Visible"/> changes.
    /// </summary>
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    /// <summary>
    /// Gets or sets the drawer title text.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// Gets or sets the drawer body content.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the drawer footer content.
    /// </summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>
    /// Gets or sets the drawer placement: "right", "left", "top", or "bottom". Default is "right".
    /// </summary>
    [Parameter] public string Placement { get; set; } = "right";

    /// <summary>
    /// Gets or sets the drawer size (width for left/right, height for top/bottom). Default is "360px".
    /// </summary>
    [Parameter] public string Size { get; set; } = "360px";

    /// <summary>
    /// Callback invoked when the drawer size is changed via resizing.
    /// </summary>
    [Parameter] public EventCallback<string> SizeChanged { get; set; }

    /// <summary>
    /// Gets or sets whether the drawer is resizable. Default is false.
    /// </summary>
    [Parameter] public bool Resizable { get; set; }

    /// <summary>
    /// Gets or sets whether to show the close button. Default is true.
    /// </summary>
    [Parameter] public bool ShowClose { get; set; } = true;

    /// <summary>
    /// Gets or sets whether clicking the backdrop closes the drawer. Default is true.
    /// </summary>
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;

    /// <summary>
    /// Gets or sets whether pressing ESC closes the drawer. Default is true.
    /// </summary>
    [Parameter] public bool CloseOnEscape { get; set; } = true;

    /// <summary>
    /// Callback invoked when the drawer is closed.
    /// </summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Gets or sets additional CSS class names for the drawer.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    private string SizeStyle
    {
        get
        {
            var sz = string.IsNullOrEmpty(_runtimeSize) ? Size : _runtimeSize;
            var styles = new List<string>();
            if (_zIndex > 0) styles.Add($"z-index: {_zIndex}");
            if (Placement is "left" or "right")
            { styles.Add($"width:{sz}"); styles.Add("max-width:100vw"); }
            else
            { styles.Add($"height:{sz}"); styles.Add("max-height:100vh"); }
            return string.Join("; ", styles) + ";";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isDisposed) return;

        if (Visible && !_previousVisible)
        {
            // Drawer just opened
            _zIndex = ZIndex.Allocate(this, SgZIndexService.DrawerBase);
            _backdropZIndex = _zIndex - 5;
            
            try
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperUI/superui-drawer.js");
                if (_isDisposed) return;

                _self ??= DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("attach", _drawerRef, _self, CloseOnEscape);
                
                if (Resizable)
                {
                    await _module.InvokeVoidAsync("initResize", _drawerRef, _self, Placement);
                }
            }
            catch (JSException) { }
            catch (TaskCanceledException) { }
        }
        else if (!Visible && _previousVisible)
        {
            // Drawer just closed
            if (_zIndex > 0)
            {
                ZIndex.Release(this);
                _zIndex = 0;
            }
            
            if (_module is not null)
            {
                try
                {
                    await _module.InvokeVoidAsync("detach");
                }
                catch (JSException) { }
                catch (TaskCanceledException) { }
            }
        }

        _previousVisible = Visible;
    }

    [JSInvokable]
    public Task CloseFromJsAsync() => CloseAsync();

    [JSInvokable]
    public async Task UpdateSizeFromJs(string newSize)
    {
        _runtimeSize = newSize;
        if (SizeChanged.HasDelegate) await SizeChanged.InvokeAsync(newSize);
        await InvokeAsync(StateHasChanged);
    }

    public async Task CloseAsync()
    {
        if (_isDisposed || _isClosing) return;

        _closeCts?.Cancel();
        _closeCts = new CancellationTokenSource();
        var token = _closeCts.Token;

        _isClosing = true;
        StateHasChanged();

        try { await Task.Delay(300, token); }
        catch (TaskCanceledException) { return; }

        _isClosing = false;
        if (VisibleChanged.HasDelegate) await VisibleChanged.InvokeAsync(false);
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }

    private Task BackdropAsync() => CloseOnBackdrop ? CloseAsync() : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        if (_isDisposed) return;
        _isDisposed = true;

        _closeCts?.Cancel();
        _closeCts?.Dispose();

        if (_zIndex > 0) { ZIndex.Release(this); _zIndex = 0; }

        var self = _self;
        _self = null;
        self?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("detach");
                await _module.DisposeAsync();
            }
            catch (JSException) { }
            catch (TaskCanceledException) { }
            catch (ObjectDisposedException) { }
        }
    }
}
