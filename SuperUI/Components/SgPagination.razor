@namespace SuperUI.Components
@using SuperUI.Localization
@inject ISuperUILocalizer Localizer
@inject IJSRuntime JS

<div class="sg-pager @CssClass">
    @if (ShowInfo)
    {
        <div class="sg-pager-info">
            @{
                var startRow = (Page - 1) * PageSize + 1;
                var endRow = Math.Min(Page * PageSize, TotalItems);
                if (TotalItems == 0) startRow = 0;
            }
            @startRow-@endRow @(Localizer["Table_Of"] ?? "из") @TotalItems
            
            @if (SelectedCount > 0)
            {
                <span class="sg-pager-selected">
                    @(Localizer["Selected"] ?? "Выбрано"): @SelectedCount
                </span>
            }
        </div>
    }

    @if (PageSizeOptions?.Any() == true)
    {
        <div class="sg-pager-size">
            <select value="@PageSize" @onchange="OnPageSizeChangedAsync">
                @foreach (var size in PageSizeOptions)
                {
                    <option value="@size">@size</option>
                }
            </select>
        </div>
    }

    <button class="sg-page-btn" type="button" disabled="@(Page <= 1)" @onclick="() => GoAsync(1)" title="@Localizer["First"]">«</button>
    <button class="sg-page-btn" type="button" disabled="@(Page <= 1)" @onclick="() => GoAsync(Page - 1)" title="@Localizer["Previous"]">‹</button>
    
    @foreach (var p in BuildPages())
    {
        if (p < 0)
        {
            <span class="sg-page-gap">...</span>
        }
        else
        {
            var pl = p;
            <button class="sg-page-btn @(pl == Page ? "current" : "")"
                    type="button" @onclick="() => GoAsync(pl)">@pl</button>
        }
    }
    
    <button class="sg-page-btn" type="button" disabled="@(Page >= TotalPages)" @onclick="() => GoAsync(Page + 1)" title="@Localizer["Next"]">›</button>
    <button class="sg-page-btn" type="button" disabled="@(Page >= TotalPages)" @onclick="() => GoAsync(TotalPages)" title="@Localizer["Last"]">»</button>

    @if (ShowJump)
    {
        <div class="sg-pager-jump">
            <span>@(Localizer["GoTo"] ?? "Перейти к")</span>
            <input type="number"
                   class="sg-pager-input"
                   value="@Page"
                   @onchange="OnJumpChanged"
                   min="1" max="@TotalPages" />
        </div>
    }
</div>

@code {
    [Parameter] public bool ShowJump { get; set; }
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public int PageSize { get; set; } = 25;
    [Parameter] public int TotalItems { get; set; }
    [Parameter] public int SelectedCount { get; set; }
    [Parameter] public int Siblings { get; set; } = 1;
    [Parameter] public bool ShowInfo { get; set; } = true;
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool ScrollToTop { get; set; }
    [Parameter] public IEnumerable<int>? PageSizeOptions { get; set; }
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalItems / Math.Max(1, PageSize)));

    private async Task GoAsync(int p)
    {
        p = Math.Max(1, Math.Min(TotalPages, p));
        if (p == Page) return;
        Page = p;
        if (PageChanged.HasDelegate) await PageChanged.InvokeAsync(p);

        if (ScrollToTop)
        {
            try
            {
                await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
            }
            catch { }
        }
    }

    private async Task OnJumpChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var p))
        {
            await GoAsync(p);
        }
    }

    private async Task OnPageSizeChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
        {
            PageSize = size;
            if (PageSizeChanged.HasDelegate) await PageSizeChanged.InvokeAsync(size);
            await GoAsync(1);
        }
    }

    private IEnumerable<int> BuildPages()
    {
        var total = TotalPages;
        var current = Page;
        var window = Siblings > 0 ? Siblings : 2;

        if (total <= 7)
        {
            for (int i = 1; i <= total; i++) yield return i;
            yield break;
        }

        yield return 1;

        int start = Math.Max(2, current - window);
        int end = Math.Min(total - 1, current + window);

        if (start > 2) yield return -1;

        for (int i = start; i <= end; i++) yield return i;

        if (end < total - 1) yield return -2;

        yield return total;
    }
}

