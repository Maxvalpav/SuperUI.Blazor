@namespace SuperUI.Components
@inject ISuperUILocalizer Localizer

<span class="sgc-chip @VariantClass @(Outlined ? "sgc-outlined" : "") @(Closable ? "sgc-closable" : "") @CssClass"
      style="@Style"
      aria-label="@(AriaLabel ?? Text)"
      @attributes="AdditionalAttributes">
    @if (LeadingContent is not null)
    {
        <span class="sgc-chip-leading" aria-hidden="true">@LeadingContent</span>
    }
    else if (Icon is not null)
    {
        <span class="sgc-chip-icon" aria-hidden="true">@Icon</span>
    }
    <span class="sgc-chip-text">@ChildContent@Text</span>
    @if (TrailingContent is not null)
    {
        <span class="sgc-chip-trailing" aria-hidden="true">@TrailingContent</span>
    }
    @if (Closable)
    {
        <button type="button" class="sgc-chip-x" aria-label="@Localizer.GetString("RemoveItem", Text ?? Localizer["Item"])" @onclick="OnCloseAsync">×</button>
    }
</span>

@code {
    /// <summary>
    /// Gets or sets the accessibility label for screen readers.
    /// </summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// Gets or sets the chip text.
    /// </summary>
    [Parameter] public string? Text { get; set; }
    
    /// <summary>
    /// Gets or sets the custom content to render inside the chip.
    /// Takes precedence over <see cref="Text"/>.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    
    /// <summary>
    /// Gets or sets the icon to display before the chip text.
    /// </summary>
    [Parameter] public RenderFragment? Icon { get; set; }

    /// <summary>
    /// Gets or sets the content to display before the chip text.
    /// Takes precedence over <see cref="Icon"/>.
    /// </summary>
    [Parameter] public RenderFragment? LeadingContent { get; set; }

    /// <summary>
    /// Gets or sets the content to display after the chip text.
    /// </summary>
    [Parameter] public RenderFragment? TrailingContent { get; set; }

    /// <summary>
    /// Gets or sets whether the chip has an outlined style.
    /// Default is false (filled style).
    /// </summary>
    [Parameter] public bool Outlined { get; set; }
    
    /// <summary>
    /// Gets or sets the visual variant of the chip.
    /// Supported values: "default", "primary", "success", "danger", "warn". Default is "default".
    /// </summary>
    [Parameter] public string Variant { get; set; } = "default";
    
    /// <summary>
    /// Gets or sets whether the chip displays a close button.
    /// </summary>
    [Parameter] public bool Closable { get; set; }
    
    /// <summary>
    /// Gets or sets the callback invoked when the close button is clicked.
    /// </summary>
    [Parameter] public EventCallback OnClose { get; set; }
    
    /// <summary>
    /// Gets or sets additional CSS classes to apply to the component.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Gets or sets additional inline styles to apply to the component.
    /// </summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string VariantClass => Variant switch
    {
        "primary" => "sgc-primary",
        "success" => "sgc-success",
        "danger" => "sgc-danger",
        "warn" => "sgc-warn",
        _ => ""
    };

    private async Task OnCloseAsync()
    {
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }
}
