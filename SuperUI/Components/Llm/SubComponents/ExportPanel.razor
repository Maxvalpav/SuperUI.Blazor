@namespace SuperUI.Components.Llm.SubComponents
@using SuperUI.Components.Llm.Models
@using SuperUI.Components

<div class="sg-export-panel">
    <div class="sg-export-panel-header">
        <div class="sg-export-panel-info">
            <strong>📥 Export Document</strong>
            <span>Download extracted data in your preferred format</span>
        </div>

        <SgCheckBox Label="Use original as template (preserve structure)"
                    Value="@UseTemplateMode"
                    ValueChanged="HandleTemplateModeChanged" />
    </div>

    <div class="sg-export-panel-actions">
        <SgButton Text="JSON"
                  Variant="SgButtonVariant.Outlined"
                  Disabled="@Disabled"
                  OnClick="() => ExportJsonRequested.InvokeAsync()">
            <Icon>📄</Icon>
        </SgButton>
        <SgButton Text="PDF"
                  Variant="SgButtonVariant.Primary"
                  Disabled="@Disabled"
                  OnClick="() => HandleExport(ExportFormat.Pdf)">
            <Icon>📕</Icon>
        </SgButton>
        <SgButton Text="Word"
                  Variant="SgButtonVariant.Primary"
                  Disabled="@Disabled"
                  OnClick="() => HandleExport(ExportFormat.Word)">
            <Icon>📘</Icon>
        </SgButton>
        <SgButton Text="Both"
                  Variant="SgButtonVariant.Default"
                  Disabled="@Disabled"
                  OnClick="() => HandleExport(ExportFormat.Both)">
            <Icon>📦</Icon>
        </SgButton>
    </div>
</div>

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool UseTemplateMode { get; set; } = true;
    [Parameter] public EventCallback<bool> UseTemplateModeChanged { get; set; }
    [Parameter] public EventCallback ExportJsonRequested { get; set; }
    [Parameter] public EventCallback<ExportFormat> ExportRequested { get; set; }

    private Task HandleTemplateModeChanged(bool value)
    {
        UseTemplateMode = value;
        return UseTemplateModeChanged.InvokeAsync(value);
    }

    private Task HandleExport(ExportFormat format) => ExportRequested.InvokeAsync(format);
}
