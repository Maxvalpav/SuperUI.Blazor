@namespace SuperUI.Components.Llm.SubComponents
@using SuperUI.Components
@using SuperUI.Components.Llm.Models
@using SuperUI.Services.Llm
@using Microsoft.AspNetCore.Components.Forms

<SgCollapse Title="⚙️ AI Settings" Variant="SgCollapseVariant.Bordered" @bind-Expanded="_expanded">
    <div class="sg-settings-grid">
        <div class="sg-settings-row">
            <SgSelect TValue="LlmProvider"
                      Label="Provider"
                      @bind-Value="Settings.Provider"
                      EnumType="typeof(LlmProvider)" />

            <SgTextBox TValue="string"
                       Label="API Key"
                       Type="password"
                       Placeholder="sk-..."
                       @bind-Value="Settings.ApiKey" />

            <SgTextBox TValue="string"
                       Label="Base URL"
                       Placeholder="https://api.openai.com/v1"
                       @bind-Value="Settings.BaseUrl" />
        </div>

        <div class="sg-settings-row">
            <SgNumberEdit TValue="double"
                          Label="Temperature"
                          Min="0" Max="2" Step="0.1"
                          Value="Settings.Temperature"
                          ValueChanged="@((double? v) => Settings.Temperature = v ?? 0.1)" />

            <SgNumberEdit TValue="int"
                          Label="Max Tokens"
                          Min="256" Max="16000" Step="256"
                          Value="Settings.MaxTokens"
                          ValueChanged="@((int? v) => Settings.MaxTokens = v ?? 4096)" />

            <div class="sg-settings-model">
                @if (Settings.Provider == LlmProvider.OpenRouter)
                {
                    <div style="display:flex; gap:8px; align-items:flex-end;">
                        @if (OpenRouterModels.Count > 0)
                        {
                            <SgSelect TValue="string"
                                      Label="Model"
                                      @bind-Value="Settings.Model"
                                      Items="_openRouterModelIds"
                                      LabelSelector="LabelForOpenRouter"
                                      CssClass="sg-settings-model-select" />
                        }
                        else
                        {
                            <SgTextBox TValue="string"
                                       Label="Model"
                                       Placeholder="google/gemini-2.0-flash-001:free"
                                       @bind-Value="Settings.Model"
                                       CssClass="sg-settings-model-select" />
                        }
                        <SgButton Text="Load Models"
                                  Variant="SgButtonVariant.Outlined"
                                  OnClick="@(_ => LoadModelsRequested.InvokeAsync())" />
                    </div>
                }
                else
                {
                    <SgSelect TValue="string"
                              Label="Model"
                              @bind-Value="Settings.Model"
                              Items="OpenAiSettings.OpenAIModels" />
                }
            </div>
        </div>

        <SgTextArea Label="System Prompt (optional)"
                    Placeholder="Custom extraction instructions..."
                    Rows="3"
                    @bind-Value="Settings.SystemPrompt" />
    </div>
</SgCollapse>

@code {
    [Parameter] public OpenAiSettings Settings { get; set; } = new();
    [Parameter] public List<SgLlmModelInfo> OpenRouterModels { get; set; } = new();
    [Parameter] public EventCallback LoadModelsRequested { get; set; }

    private bool _expanded = false;

    private IEnumerable<string> _openRouterModelIds => OpenRouterModels.Select(m => m.Id);

    private string LabelForOpenRouter(string id) =>
        OpenRouterModels.FirstOrDefault(m => m.Id == id)?.Name ?? id;
}
