@namespace SuperUI.Components.Llm.SubComponents
@using SuperUI.Components.Llm.Models

<div class="sg-file-preview-grid">
    @foreach (var file in Files)
    {
        <div class="sg-preview-card">
            <div class="sg-preview-thumb">
                @if (file.Category == FileCategory.Image)
                {
                    <img src="data:@file.ContentType;base64,@file.Base64Content" />
                }
                else
                {
                    <div class="sg-file-icon @file.Category.ToString().ToLower()">
                        @GetIcon(file.Category)
                        <span>@file.Category</span>
                    </div>
                }
            </div>
            <div class="sg-preview-info">
                <span class="name" title="@file.FileName">@file.FileName</span>
                <span class="size">@(file.Size / 1024) KB</span>
            </div>
            <button class="sg-remove-btn" @onclick="() => OnRemove.InvokeAsync(file)">✕</button>
        </div>
    }
</div>

@code {
    [Parameter] public List<UploadedFile> Files { get; set; } = new();
    [Parameter] public EventCallback<UploadedFile> OnRemove { get; set; }

    private string GetIcon(FileCategory cat) => cat switch
    {
        FileCategory.Pdf => "📕",
        FileCategory.Word => "📘",
        _ => "📄"
    };
}
