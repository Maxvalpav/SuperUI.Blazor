@namespace SuperUI.Components
@inherits SgFormFieldBase<DateTime?>

<div class="@GetFieldClasses()" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sgc-label @(Required ? "sgc-required" : "")" for="@EffectiveId">@Label</label>
    }
    <div class="@GetControlClasses()"
         role="combobox"
         aria-expanded="@(_open ? "true" : "false")"
         aria-haspopup="dialog"
         aria-disabled="@(IsEffectivelyDisabled ? "true" : null)"
         aria-invalid="@(HasError ? "true" : null)"
         tabindex="@(IsEffectivelyDisabled ? "-1" : "0")"
         @onfocusout="HandleFocusOutAsync"
         @onclick:stopPropagation="true">
        
        <div class="sgc-date-control" @onclick="ToggleAsync">
            @if (Value.HasValue)
            {
                <span class="sgc-date-value">@Value.Value.ToString(Format, Culture)</span>
            }
            else
            {
                <span class="sgc-date-placeholder">@(Placeholder ?? Localizer["SelectDate"])</span>
            }
            
            @if (AllowClear && Value.HasValue && !IsEffectivelyDisabled)
            {
                <button class="sgc-combo-clear" type="button"
                        aria-label="@ClearLabel"
                        title="@ClearLabel"
                        @onclick:stopPropagation="true"
                        @onclick="ClearAsync">
                    @((MarkupString)SgIcons.X)
                </button>
            }
            <span class="sgc-date-caret" aria-hidden="true">
                @((MarkupString)SgIcons.Calendar)
            </span>
        </div>

        @if (_open)
        {
            <div class="sgc-date-popup" role="dialog" aria-modal="false" @onclick:stopPropagation="true">
                <div class="sgc-date-head">
                    <button class="sgc-date-nav" type="button" 
                            @onclick="() => ShiftYear(-1)" 
                            @onmousedown:preventDefault="true"
                            title="@Localizer["PreviousYear"]">«</button>
                    <button class="sgc-date-nav" type="button" 
                            @onclick="() => Shift(-1)" 
                            @onmousedown:preventDefault="true"
                            title="@Localizer["PreviousMonth"]">‹</button>
                    <div class="sgc-date-title">
                        <button type="button" class="sgc-date-mode-btn" 
                                @onclick="ToggleQuickPick"
                                @onmousedown:preventDefault="true">
                            @_view.ToString("MMMM yyyy", Culture)
                        </button>
                    </div>
                    <button class="sgc-date-nav" type="button" 
                            @onclick="() => Shift(1)" 
                            @onmousedown:preventDefault="true"
                            title="@Localizer["NextMonth"]">›</button>
                    <button class="sgc-date-nav" type="button" 
                            @onclick="() => ShiftYear(1)" 
                            @onmousedown:preventDefault="true"
                            title="@Localizer["NextYear"]">»</button>
                </div>

                <div class="sgc-date-body">
                    <div class="sgc-date-grid @(ShowWeekNumbers ? "sgc-with-weeks" : "")">
                        @if (ShowWeekNumbers)
                        {
                            <div class="sgc-date-dow sgc-week-num-head">#</div>
                        }
                        @for (var i = 0; i < 7; i++)
                        {
                            var dow = ((int)Culture.DateTimeFormat.FirstDayOfWeek + i) % 7;
                            <div class="sgc-date-dow">@Culture.DateTimeFormat.AbbreviatedDayNames[dow]</div>
                        }
                        @for (int i = 0; i < 6; i++)
                        {
                            var weekStart = _grid[i * 7];
                            if (ShowWeekNumbers)
                            {
                                <div class="sgc-date-week-num">@GetWeekNumber(weekStart)</div>
                            }
                            @for (int j = 0; j < 7; j++)
                            {
                                var dl = _grid[i * 7 + j];
                                var inMonth = dl.Month == _view.Month;
                                var isToday = dl.Date == DateTime.Today;
                                var isSel = Value.HasValue && dl.Date == Value.Value.Date;
                                var isDisabled = IsDateDisabled(dl);
                                var isHighlight = IsHighlightDay(dl);
                                
                                <div class="sgc-date-cell @(inMonth ? "" : "sgc-out") @(isToday ? "sgc-today" : "") @(isSel ? "sgc-selected" : "") @(isDisabled ? "sgc-date-disabled" : "") @(isHighlight ? "sgc-highlight" : "")"
                                     role="button"
                                     aria-disabled="@(isDisabled ? "true" : null)"
                                     aria-selected="@(isSel ? "true" : null)"
                                     @onmousedown:preventDefault="true"
                                     @onclick="() => { if (!isDisabled) _ = PickAsync(dl); }">
                                    @if (DayTemplate != null)
                                    {
                                        @DayTemplate(dl)
                                    }
                                    else
                                    {
                                        <span>@dl.Day</span>
                                    }
                                </div>
                            }
                        }
                    </div>

                    @if (_showQuickPick)
                    {
                        <div class="sgc-date-quick-pick">
                            <div class="sgc-date-quick-months sgc-thin-scroll">
                                @for (int m = 1; m <= 12; m++)
                                {
                                    var month = m;
                                    <div class="sgc-date-quick-item @(_view.Month == month ? "sgc-selected" : "")"
                                         @onmousedown:preventDefault="true"
                                         @onclick="() => SelectMonth(month)">
                                        @Culture.DateTimeFormat.GetMonthName(month)
                                    </div>
                                }
                            </div>
                            <div id="sg-datepicker-years" class="sgc-date-quick-years sgc-thin-scroll">
                                @for (int y = _view.Year - 50; y <= _view.Year + 50; y++)
                                {
                                    var year = y;
                                    var isSelected = (Value?.Year ?? DateTime.Today.Year) == year;
                                    <div class="sgc-date-quick-item @(isSelected ? "sgc-selected" : "")"
                                         @onmousedown:preventDefault="true"
                                         @onclick="() => SelectYear(year)">
                                        @year
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="sgc-date-foot">
                    <button class="sgc-btn sgc-sm" type="button" 
                            @onclick="TodayAsync"
                            @onmousedown:preventDefault="true">@Localizer["Today"]</button>
                    @if (AllowClear)
                    {
                        <button class="sgc-btn sgc-sm sgc-ghost" type="button" 
                                @onclick="ClearAsync"
                                @onmousedown:preventDefault="true">@Localizer["Clear"]</button>
                    }
                </div>
            </div>
        }
    </div>
    @if (HasError)
    {
        <span class="sgc-error">@ValidationMessages.FirstOrDefault()</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span class="sgc-hint">@Hint</span>
    }
</div>
