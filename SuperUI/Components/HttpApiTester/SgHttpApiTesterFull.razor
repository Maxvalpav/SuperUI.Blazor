    // ─── Variable Substitution ────────────────────────────────────────────────
    private string ResolveVariables(string input)
    {
        if (string.IsNullOrEmpty(input)) return input;
        var env = _environments.FirstOrDefault(e => e.Name == _activeEnvName);
        if (env is null) return input;
        
        return System.Text.RegularExpressions.Regex.Replace(input, @"\{\{(\w+)\}\}", m =>
        {
            var kv = env.Variables.FirstOrDefault(v => v.Key == m.Groups[1].Value && v.Enabled);
            return kv?.Value ?? m.Value;
        });
    }
    
    // ─── Pre-request Script ───────────────────────────────────────────────────
    private void RunPreRequestScript()
    {
        try
        {
            var env = _environments.FirstOrDefault(e => e.Name == _activeEnvName);
            var runtime = new ScriptRuntime(_currentTab, null, env);
            
            // Simple script execution - in real implementation use Roslyn scripting
            var lines = _currentTab.PreScript.Split('\n', StringSplitOptions.RemoveEmptyEntries);
            foreach (var line in lines)
            {
                if (line.Trim().StartsWith("//")) continue;
                
                // pm.environment.set("key", "value")
                if (line.Contains("pm.environment.set"))
                {
                    var match = System.Text.RegularExpressions.Regex.Match(line, @"pm\.environment\.set\(['""](\w+)['""],\s*['""]([^'""]+)['""]");
                    if (match.Success && env is not null)
                    {
                        runtime.EnvSet(match.Groups[1].Value, match.Groups[2].Value);
                    }
                }
                
                // pm.request.setHeader("key", "value")
                if (line.Contains("pm.request.setHeader"))
                {
                    var match = System.Text.RegularExpressions.Regex.Match(line, @"pm\.request\.setHeader\(['""]([^'""]+)['""],\s*['""]([^'""]+)['""]");
                    if (match.Success)
                    {
                        runtime.SetHeader(match.Groups[1].Value, match.Groups[2].Value);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Toasts.Info($"Pre-request script error: {ex.Message}");
        }
    }
    
