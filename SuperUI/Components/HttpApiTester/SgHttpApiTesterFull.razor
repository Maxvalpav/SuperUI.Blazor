    private async Task SendRequestAsync()
    {
        if (_runnerMode)
        {
            await RunCollectionLoopAsync();
            return;
        }

        _isLoading = true;
        _hasError = false;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            // Run pre-request script
            if (!string.IsNullOrWhiteSpace(_currentTab.PreScript))
            {
                RunPreRequestScript();
            }

            var sw = Stopwatch.StartNew();
            
            var url = ResolveVariables(_currentTab.Url);
            var enabledParams = _currentTab.QueryParams.Where(p => p.Enabled).ToList();
            if (enabledParams.Any())
            {
                var queryString = string.Join("&", enabledParams.Select(p => 
                    $"{Uri.EscapeDataString(ResolveVariables(p.Key))}={Uri.EscapeDataString(ResolveVariables(p.Value))}"));
                url += (url.Contains('?') ? "&" : "?") + queryString;
            }

            // Check mock server
            if (_mockEnabled)
            {
                var mock = _mockEndpoints.FirstOrDefault(m =>
                    m.Enabled &&
                    m.Method == _currentTab.Method &&
                    url.EndsWith(m.Path, StringComparison.OrdinalIgnoreCase));

                if (mock is not null)
                {
                    if (mock.DelayMs > 0)
                        await Task.Delay(mock.DelayMs);
                    mock.HitCount++;
                    
                    var mockSnapshot = new ResponseSnapshot
                    {
                        Status = mock.StatusCode,
                        StatusText = "Mock",
                        ElapsedMs = mock.DelayMs,
                        ContentType = mock.ContentType,
                        RawBody = mock.Body,
                        PrettyBody = FormatBody(mock.Body, mock.ContentType),
                        ReceivedAt = DateTime.Now
                    };
                    
                    _currentTab.LastResponse = mockSnapshot;
                    AddToHistory(mockSnapshot);
                    AddToStats(mockSnapshot);
                    Toasts.Info($"🎭 Mock hit: {mock.Method} {mock.Path}");
                    return;
                }
            }

            var request = new HttpRequestMessage(new HttpMethod(_currentTab.Method), url);

            foreach (var header in _currentTab.Headers.Where(h => h.Enabled))
            {
                if (!string.IsNullOrWhiteSpace(header.Key))
                {
                    request.Headers.TryAddWithoutValidation(
                        ResolveVariables(header.Key), 
                        ResolveVariables(header.Value));
                }
            }

            if (_currentTab.AuthType == "Bearer Token" && !string.IsNullOrWhiteSpace(_currentTab.BearerToken))
            {
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue(
                    "Bearer", ResolveVariables(_currentTab.BearerToken));
            }
            else if (_currentTab.AuthType == "Basic Auth")
            {
                var credentials = Convert.ToBase64String(
                    Encoding.UTF8.GetBytes($"{_currentTab.BasicUser}:{_currentTab.BasicPassword}"));
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Basic", credentials);
            }
            else if (_currentTab.AuthType == "API Key" && !string.IsNullOrWhiteSpace(_currentTab.ApiKeyName))
            {
                request.Headers.TryAddWithoutValidation(
                    ResolveVariables(_currentTab.ApiKeyName), 
                    ResolveVariables(_currentTab.ApiKeyValue));
            }

            if (_currentTab.Method != "GET" && _currentTab.Method != "HEAD" && _currentTab.BodyType != "None")
            {
                if (_currentTab.BodyType == "Form")
                {
                    var formData = _currentTab.FormFields.Where(f => f.Enabled)
                        .ToDictionary(f => ResolveVariables(f.Key), f => ResolveVariables(f.Value));
                    request.Content = new FormUrlEncodedContent(formData);
                }
                else if (!string.IsNullOrWhiteSpace(_currentTab.Body))
                {
                    var mediaType = _currentTab.BodyType switch
                    {
                        "JSON" => "application/json",
                        "XML" => "application/xml",
                        _ => "text/plain"
                    };
                    request.Content = new StringContent(ResolveVariables(_currentTab.Body), Encoding.UTF8, mediaType);
                }
            }

            var response = await Http.SendAsync(request);
            sw.Stop();

            var responseBody = await response.Content.ReadAsStringAsync();
            var responseContentType = response.Content.Headers.ContentType?.MediaType ?? "";
            
            var snapshot = new ResponseSnapshot
            {
                Status = (int)response.StatusCode,
                StatusText = response.ReasonPhrase ?? "",
                ElapsedMs = sw.ElapsedMilliseconds,
                SizeBytes = Encoding.UTF8.GetByteCount(responseBody),
                ContentType = responseContentType,
                RawBody = responseBody,
                PrettyBody = FormatBody(responseBody, responseContentType),
                ReceivedAt = DateTime.Now
            };

            foreach (var header in response.Headers)
            {
                snapshot.Headers.Add(new KvPair(header.Key, string.Join(", ", header.Value)));
            }
            foreach (var header in response.Content.Headers)
            {
                snapshot.Headers.Add(new KvPair(header.Key, string.Join(", ", header.Value)));
            }

            if (responseContentType.Contains("json"))
            {
                try
                {
                    var jsonNode = JsonNode.Parse(responseBody);
                    if (jsonNode is JsonArray jsonArray && jsonArray.Count > 0)
                    {
                        snapshot.IsJsonArray = true;
                        ParseJsonArrayToGrid(jsonArray, snapshot);
                    }
                }
                catch { }
            }

            if (!string.IsNullOrWhiteSpace(_currentTab.TestScript))
            {
                RunTests(snapshot);
            }

            _currentTab.LastResponse = snapshot;
            AddToHistory(snapshot);
            AddToStats(snapshot);
            
            Toasts.Success($"Request completed in {sw.ElapsedMilliseconds}ms");
        }
        catch (Exception ex)
        {
            _hasError = true;
            _errorMessage = ex.Message;
            
            _history.Add(new HistoryEntry
            {
                Method = _currentTab.Method,
                Url = _currentTab.Url,
                Timestamp = DateTime.Now
            });
            
            Toasts.Error($"Request failed: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private string FormatBody(string body, string contentType)
    {
        if (string.IsNullOrWhiteSpace(body)) return "";
        
        if (contentType.Contains("json"))
        {
            try
            {
                var jsonDoc = JsonDocument.Parse(body);
                return JsonSerializer.Serialize(jsonDoc, new JsonSerializerOptions { WriteIndented = true });
            }
            catch { }
        }
        
        return body;
    }

    private void ParseJsonArrayToGrid(JsonArray jsonArray, ResponseSnapshot snapshot)
    {
        var columns = new HashSet<string>();
        var rows = new List<Dictionary<string, object?>>();

        foreach (var item in jsonArray)
        {
            if (item is JsonObject jsonObj)
            {
                var row = new Dictionary<string, object?>();
                foreach (var prop in jsonObj)
                {
                    columns.Add(prop.Key);
                    row[prop.Key] = prop.Value?.ToString();
                }
                rows.Add(row);
            }
        }

        snapshot.GridColumns = columns.ToList();
        snapshot.GridRows = rows;
    }

    private void RunTests(ResponseSnapshot snapshot)
    {
        try
        {
            var runtime = new ScriptRuntime(_currentTab, snapshot, null);
            
            var lines = _currentTab.TestScript.Split('\n', StringSplitOptions.RemoveEmptyEntries);
            foreach (var line in lines)
            {
                if (line.Trim().StartsWith("//")) continue;
                
                if (line.Contains("pm.test"))
                {
                    var testName = ExtractTestName(line);
                    var condition = EvaluateTestCondition(line, runtime);
                    runtime.Test(testName, () => condition);
                }
            }

            snapshot.Tests = runtime.Results.ToList();
        }
        catch (Exception ex)
        {
            snapshot.Tests.Add(new TestResult
            {
                Name = "Test Execution Error",
                Passed = false,
                Message = ex.Message
            });
        }
    }

    private string ExtractTestName(string line)
    {
        var start = line.IndexOf('\'');
        if (start < 0) start = line.IndexOf('"');
        if (start < 0) return "Test";
        
        var end = line.IndexOf('\'', start + 1);
        if (end < 0) end = line.IndexOf('"', start + 1);
        if (end < 0) return "Test";
        
        return line.Substring(start + 1, end - start - 1);
    }

    private bool EvaluateTestCondition(string line, ScriptRuntime runtime)
    {
        if (line.Contains("ResponseStatus") && line.Contains("=="))
        {
            var expectedStatus = ExtractNumber(line);
            return runtime.ResponseStatus == expectedStatus;
        }
        
        if (line.Contains("ResponseTime") && line.Contains("<"))
        {
            var maxTime = ExtractNumber(line);
            return runtime.ResponseTime < maxTime;
        }
        
        return true;
    }

    private int ExtractNumber(string line)
    {
        var match = System.Text.RegularExpressions.Regex.Match(line, @"\d+");
        return match.Success ? int.Parse(match.Value) : 0;
    }

