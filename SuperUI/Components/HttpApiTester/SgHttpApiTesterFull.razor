    // ─── cURL Import ──────────────────────────────────────────────────────────
    private void ImportFromCurl()
    {
        try
        {
            var curl = _curlInput.Replace("\\\n", " ").Replace("\\", "");
            
            // Method
            var methodMatch = System.Text.RegularExpressions.Regex.Match(curl, @"-X\s+(\w+)");
            if (methodMatch.Success)
            {
                _currentTab.Method = methodMatch.Groups[1].Value.ToUpper();
            }
            
            // URL
            var urlMatch = System.Text.RegularExpressions.Regex.Match(curl, @"curl\s+(?:-X\s+\w+\s+)?['""]?(https?://[^\s'""]+)['""]?");
            if (urlMatch.Success)
            {
                _currentTab.Url = urlMatch.Groups[1].Value;
            }
            
            // Headers
            _currentTab.Headers.Clear();
            _currentTab.Headers.Add(new KvPair("Content-Type", "application/json"));
            foreach (System.Text.RegularExpressions.Match hm in System.Text.RegularExpressions.Regex.Matches(curl, @"-H\s+['""]([^:]+):\s*([^'""]+)['""]"))
            {
                _currentTab.Headers.Add(new KvPair(hm.Groups[1].Value.Trim(), hm.Groups[2].Value.Trim()));
            }
            
            // Body
            var bodyMatch = System.Text.RegularExpressions.Regex.Match(curl, @"-d\s+['""](.+?)['""]");
            if (bodyMatch.Success)
            {
                _currentTab.Body = bodyMatch.Groups[1].Value.Replace("\\\"", "\"");
                _currentTab.BodyType = "JSON";
            }
            
            _curlImportOpen = false;
            _curlInput = "";
            Toasts.Success("cURL imported successfully");
        }
        catch (Exception ex)
        {
            Toasts.Error($"Import failed: {ex.Message}");
        }
    }
    
