@namespace SuperUI.Components
@using System.Net.Http
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@using System.Text.Json.Nodes
@using System.Text.RegularExpressions
@using System.Diagnostics
@inject HttpClient Http
@inject SgToastService Toasts

<div class="sg-http-api-tester-full" style="display:flex; flex-direction:column; height:100%; width:100%; min-height:0; overflow:hidden; @Style">
    
    @* Top Bar with URL and Send Button *@
    <div style="padding:18px 20px; border-bottom:2px solid var(--sg-border); background:var(--sg-bg-alt); flex-shrink:0;">
        <div style="display:flex; gap:12px; align-items:flex-end; width:100%;">
            <div style="flex:0 0 150px;">
                <div style="margin-bottom:6px; font-size:12px; font-weight:600; color:var(--sg-text-muted); text-transform:uppercase; letter-spacing:0.5px;">Method</div>
                <SgSelect @bind-Value="_currentTab.Method"
                          Items="@_methods"
                          TextSelector="@GetMethodText"
                          ValueSelector="@GetMethodValue"
                          Size="SgSize.Lg"
                          Style="width:100%; height:44px;" />
            </div>
            <div style="flex:1 1 auto; min-width:0;">
                <div style="margin-bottom:6px; font-size:12px; font-weight:600; color:var(--sg-text-muted); text-transform:uppercase; letter-spacing:0.5px;">Request URL</div>
                <SgTextBox @bind-Value="_currentTab.Url"
                           Placeholder="https://api.example.com/endpoint"
                           Size="SgSize.Lg"
                           Style="width:100%; height:44px; font-size:14px;" />
            </div>
            <SgButton Variant="SgButtonVariant.Primary"
                      Size="SgSize.Lg"
                      OnClick="SendRequestAsync"
                      Disabled="_isLoading"
                      Style="min-width:110px; height:44px; font-weight:600;">
                @if (_isLoading)
                {
                    <text>Sending...</text>
                }
                else
                {
                    <text>Send</text>
                }
            </SgButton>
            <SgButton Variant="SgButtonVariant.Default"
                      Size="SgSize.Lg"
                      OnClick="SaveCurrentRequest"
                      Style="min-width:90px; height:44px;">
                Save
            </SgButton>
        </div>
    </div>

    @* Main Layout: Sidebar + Content *@
    <div style="display:flex; flex:1; min-height:0;">
        
        @* Left Sidebar *@
        <div style="width:320px; border-right:1px solid var(--sg-border); overflow:hidden; display:flex; flex-direction:column; background:var(--sg-bg-alt);">
            <div style="padding:16px; border-bottom:1px solid var(--sg-border);">
                <SgTextBox @bind-Value="_searchText"
                           Placeholder="Search collections..."
                           Size="SgSize.Lg"
                           Style="width:100%;" />
            </div>
            
            <div style="flex:1; overflow:auto;">
                <SgTabs>
                    <SgTabPanel Title="Collections">
                        <div style="padding:14px;">
                            @foreach (var col in _collections)
                            {
                                <div style="margin-bottom:14px; background:var(--sg-bg); border:1px solid var(--sg-border); border-radius:8px; padding:12px;">
                                    <div style="font-weight:600; font-size:14px; margin-bottom:10px; display:flex; align-items:center; justify-content:space-between;">
                                        <span>📁 @col.Name</span>
                                        <span style="font-size:11px; color:var(--sg-text-muted); font-weight:400;">@col.Requests.Count item(s)</span>
                                    </div>
                                    @if (!col.Requests.Any())
                                    {
                                        <div style="font-size:12px; color:var(--sg-text-muted); padding:6px 0;">No saved requests</div>
                                    }
                                    @foreach (var req in col.Requests.Take(8))
                                    {
                                        <div style="padding:8px 10px; cursor:pointer; font-size:13px; border-radius:6px; margin-bottom:5px; background:var(--sg-bg-alt); border:1px solid var(--sg-border); display:flex; align-items:center; gap:8px;"
                                             @onclick="() => LoadRequest(req)">
                                            <SgBadge Variant="@GetMethodVariant(req.Tab.Method)"
                                                     Text="@req.Tab.Method"
                                                     Style="font-size:10px;" />
                                            <span style="font-weight:500; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@req.Name</span>
                                        </div>
                                    }
                                </div>
                            }
                            <SgButton Variant="SgButtonVariant.Default"
                                      Size="SgSize.Md"
                                      OnClick="CreateNewCollection"
                                      Style="width:100%;">
                                + New Collection
                            </SgButton>
                        </div>
                    </SgTabPanel>

                    <SgTabPanel Title="History">
                        <div style="padding:14px;">
                            @if (!_history.Any())
                            {
                                <SgEmpty Description="No history yet" />
                            }
                            else
                            {
                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                                    <span style="font-size:12px; color:var(--sg-text-muted);">@_history.Count entries</span>
                                    <SgButton Variant="SgButtonVariant.Default" Size="SgSize.Sm" OnClick="ClearHistory">Clear</SgButton>
                                </div>
                                @foreach (var entry in _history.Take(30).Reverse())
                                {
                                    <div style="padding:10px; cursor:pointer; font-size:13px; background:var(--sg-bg); margin-bottom:6px; border-radius:6px; border:1px solid var(--sg-border);"
                                         @onclick="() => LoadHistoryEntry(entry)">
                                        <div style="display:flex; align-items:center; gap:6px; margin-bottom:4px;">
                                            <SgBadge Variant="@GetMethodVariant(entry.Method)"
                                                     Text="@entry.Method"
                                                     Style="font-size:10px;" />
                                            @if (entry.Status > 0)
                                            {
                                                <SgBadge Variant="@GetStatusVariant(entry.Status)"
                                                         Text="@entry.Status.ToString()"
                                                         Style="font-size:10px;" />
                                            }
                                        </div>
                                        <div style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--sg-text-muted); font-size:12px;">
                                            @entry.Url
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </SgTabPanel>

                    <SgTabPanel Title="Snippets">
                        <div style="padding:14px;">
                            <div style="font-size:12px; color:var(--sg-text-muted); margin-bottom:10px; line-height:1.5;">
                                Click any snippet to load it into the current request.
                            </div>
                            @foreach (var snippet in _snippets)
                            {
                                <div style="padding:10px 12px; cursor:pointer; font-size:13px; background:var(--sg-bg); margin-bottom:8px; border-radius:6px; border:1px solid var(--sg-border);"
                                     @onclick="() => LoadSnippet(snippet)">
                                    <div style="display:flex; align-items:center; gap:6px; margin-bottom:4px;">
                                        <SgBadge Variant="@GetMethodVariant(snippet.Tab.Method)"
                                                 Text="@snippet.Tab.Method"
                                                 Style="font-size:10px;" />
                                        <span style="font-weight:600;">@snippet.Name</span>
                                    </div>
                                    <div style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--sg-text-muted); font-size:11px;">
                                        @snippet.Tab.Url
                                    </div>
                                    @if (!string.IsNullOrEmpty(snippet.Description))
                                    {
                                        <div style="font-size:11px; color:var(--sg-text-muted); margin-top:4px; line-height:1.4;">
                                            @snippet.Description
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </SgTabPanel>

                    <SgTabPanel Title="Env">
                        <div style="padding:14px;">
                            <div style="margin-bottom:6px; font-size:12px; font-weight:600; color:var(--sg-text-muted); text-transform:uppercase; letter-spacing:0.5px;">Active Environment</div>
                            <SgSelect TValue="string" TItem="string"
                                      @bind-Value="_activeEnvName"
                                      Items="_environments.Select(e => e.Name).ToList()"
                                      TextSelector="@((Func<string, string>)(n => n))"
                                      ValueSelector="@((Func<string, string>)(n => n))"
                                      Size="SgSize.Md"
                                      Style="width:100%; margin-bottom:12px;" />
                            <SgButton Variant="SgButtonVariant.Default"
                                      Size="SgSize.Md"
                                      OnClick="() => _envModalOpen = true"
                                      Style="width:100%;">
                                Manage Environments
                            </SgButton>

                            @{
                                var activeEnv = _environments.FirstOrDefault(e => e.Name == _activeEnvName);
                            }
                            @if (activeEnv is not null && activeEnv.Variables.Any())
                            {
                                <div style="margin-top:16px;">
                                    <div style="font-size:12px; font-weight:600; color:var(--sg-text-muted); margin-bottom:6px; text-transform:uppercase; letter-spacing:0.5px;">Variables</div>
                                    @foreach (var v in activeEnv.Variables.Where(x => x.Enabled))
                                    {
                                        <div style="padding:6px 8px; background:var(--sg-bg); border-radius:4px; border:1px solid var(--sg-border); margin-bottom:4px; font-family:monospace; font-size:11px;">
                                            <span style="color:var(--sg-primary); font-weight:600;">{{@v.Key}}</span>
                                            <span style="color:var(--sg-text-muted);"> = </span>
                                            <span style="overflow:hidden; text-overflow:ellipsis;">@v.Value</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </SgTabPanel>
                </SgTabs>
            </div>
        </div>

        @* Main Content Area *@
        <div style="flex:1; display:flex; flex-direction:column; overflow:hidden; min-height:0;">
            
            @* Request Configuration *@
            <div style="flex:0 0 45%; min-height:240px; overflow:auto; border-bottom:1px solid var(--sg-border);">
                <SgTabs Style="height:100%;">
                    <SgTabPanel Title="@($"Headers ({_currentTab.Headers.Count(h => h.Enabled)})")">
                        <div style="padding:20px;">
                            <div style="margin-bottom:12px; font-size:14px; font-weight:600;">Request Headers</div>
                            <SgHttpApiTesterKvEditor Items="_currentTab.Headers" />
                        </div>
                    </SgTabPanel>

                    <SgTabPanel Title="@($"Params ({_currentTab.QueryParams.Count(p => p.Enabled)})")">
                        <div style="padding:20px;">
                            <div style="margin-bottom:12px; font-size:14px; font-weight:600;">Query Parameters</div>
                            <SgHttpApiTesterKvEditor Items="_currentTab.QueryParams" ShowComment="false" />
                        </div>
                    </SgTabPanel>

                    <SgTabPanel Title="Body">
                        <div style="padding:20px;">
                            <div style="margin-bottom:16px;">
                                <div style="margin-bottom:8px; font-size:13px; font-weight:500; color:var(--sg-text-muted);">Body Type</div>
                                <SgSegmented TValue="string" 
                                             @bind-Value="_currentTab.BodyType"
                                             Options="_bodyTypeOptions"
                                             Size="SgSize.Lg" />
                            </div>
                            
                            @if (_currentTab.BodyType == "JSON" || _currentTab.BodyType == "XML" || _currentTab.BodyType == "Text")
                            {
                                <SgTextArea @bind-Value="_currentTab.Body"
                                            Rows="14"
                                            Placeholder="@GetBodyPlaceholder()"
                                            Style="width:100%; font-size:14px; font-family:monospace; line-height:1.6;" />
                            }
                            else if (_currentTab.BodyType == "Form")
                            {
                                <div style="margin-top:12px;">
                                    <div style="margin-bottom:12px; font-size:14px; font-weight:600;">Form Data</div>
                                    <SgHttpApiTesterKvEditor Items="_currentTab.FormFields" ShowComment="false" />
                                </div>
                            }
                        </div>
                    </SgTabPanel>

                    <SgTabPanel Title="Auth">
                        <div style="padding:20px;">
                            <div style="margin-bottom:6px; font-size:13px; font-weight:500; color:var(--sg-text-muted);">Authentication Type</div>
                            <SgSelect @bind-Value="_currentTab.AuthType"
                                      Items="@_authTypes"
                                      TextSelector="@GetAuthTypeText"
                                      ValueSelector="@GetAuthTypeValue"
                                      Size="SgSize.Lg"
                                      Style="width:280px; margin-bottom:20px;" />
                            
                            @if (_currentTab.AuthType == "Bearer Token")
                            {
                                <div>
                                    <div style="margin-bottom:6px; font-size:13px; font-weight:500; color:var(--sg-text-muted);">Token</div>
                                    <SgTextBox @bind-Value="_currentTab.BearerToken"
                                               Placeholder="your-token-here"
                                               Size="SgSize.Lg"
                                               Style="width:100%;" />
                                </div>
                            }
                            else if (_currentTab.AuthType == "Basic Auth")
                            {
                                <div style="margin-bottom:16px;">
                                    <div style="margin-bottom:6px; font-size:13px; font-weight:500; color:var(--sg-text-muted);">Username</div>
                                    <SgTextBox @bind-Value="_currentTab.BasicUser"
                                               Placeholder="username"
                                               Size="SgSize.Lg"
                                               Style="width:100%;" />
                                </div>
                                <div>
                                    <div style="margin-bottom:6px; font-size:13px; font-weight:500; color:var(--sg-text-muted);">Password</div>
                                    <SgTextBox @bind-Value="_currentTab.BasicPassword"
                                               Type="password"
                                               Placeholder="password"
                                               Size="SgSize.Lg"
                                               Style="width:100%;" />
                                </div>
                            }
                            else if (_currentTab.AuthType == "API Key")
                            {
                                <div style="margin-bottom:16px;">
                                    <div style="margin-bottom:6px; font-size:13px; font-weight:500; color:var(--sg-text-muted);">Key Name</div>
                                    <SgTextBox @bind-Value="_currentTab.ApiKeyName"
                                               Placeholder="X-API-Key"
                                               Size="SgSize.Lg"
                                               Style="width:100%;" />
                                </div>
                                <div>
                                    <div style="margin-bottom:6px; font-size:13px; font-weight:500; color:var(--sg-text-muted);">Key Value</div>
                                    <SgTextBox @bind-Value="_currentTab.ApiKeyValue"
                                               Placeholder="your-api-key"
                                               Size="SgSize.Lg"
                                               Style="width:100%;" />
                                </div>
                            }
                        </div>
                    </SgTabPanel>

                    <SgTabPanel Title="Scripts">
                        <div style="padding:20px;">
                            <div style="margin-bottom:20px;">
                                <div style="margin-bottom:8px; font-weight:600; font-size:14px;">Pre-request Script</div>
                                <div style="margin-bottom:8px; font-size:12px; color:var(--sg-text-muted);">JavaScript code to run before sending the request</div>
                                <SgTextArea @bind-Value="_currentTab.PreScript"
                                            Rows="5"
                                            Placeholder="// pm.environment.set('key', 'value')"
                                            Style="width:100%; font-family:monospace; font-size:13px; line-height:1.6;" />
                            </div>
                            <div>
                                <div style="margin-bottom:8px; font-weight:600; font-size:14px;">Test Script</div>
                                <div style="margin-bottom:8px; font-size:12px; color:var(--sg-text-muted);">JavaScript code to validate the response</div>
                                <SgTextArea @bind-Value="_currentTab.TestScript"
                                            Rows="7"
                                            Placeholder="// pm.test('Status is 200', () => pm.ResponseStatus == 200)"
                                            Style="width:100%; font-family:monospace; font-size:13px; line-height:1.6;" />
                            </div>
                        </div>
                    </SgTabPanel>

                    <SgTabPanel Title="Settings">
                        <div style="padding:20px;">
                            <div style="margin-bottom:20px;">
                                <div style="margin-bottom:6px; font-size:13px; font-weight:500; color:var(--sg-text-muted);">Request Timeout</div>
                                <SgTextBox @bind-Value="_timeoutSeconds"
                                           Type="number"
                                           Placeholder="30"
                                           Size="SgSize.Lg"
                                           Style="width:200px;" />
                            </div>
                            <div style="margin-bottom:16px;">
                                <SgSwitch @bind-Value="_followRedirects" Label="Follow Redirects" Size="SgSize.Lg" />
                            </div>
                            <div style="margin-bottom:16px;">
                                <SgSwitch @bind-Value="_prettyPrint" Label="Pretty-print JSON responses" Size="SgSize.Lg" />
                            </div>
                            <div style="margin-bottom:16px;">
                                <SgSwitch @bind-Value="_mockEnabled" Label="Use Mock Server" Size="SgSize.Lg" />
                            </div>
                            <SgDivider />
                            <div style="margin-top:20px; margin-bottom:16px;">
                                <SgSwitch @bind-Value="_runnerMode" Label="Collection Runner Mode" Size="SgSize.Lg" />
                            </div>
                            @if (_runnerMode)
                            {
                                <SgStack Orientation="SgOrientation.Horizontal" Gap="16">
                                    <div>
                                        <div style="margin-bottom:6px; font-size:13px; font-weight:500; color:var(--sg-text-muted);">Iterations</div>
                                        <SgTextBox @bind-Value="_runnerIterations" 
                                                   Type="number"
                                                   Size="SgSize.Lg"
                                                   Style="width:140px;" />
                                    </div>
                                    <div>
                                        <div style="margin-bottom:6px; font-size:13px; font-weight:500; color:var(--sg-text-muted);">Delay (ms)</div>
                                        <SgTextBox @bind-Value="_runnerDelayMs" 
                                                   Type="number"
                                                   Size="SgSize.Lg"
                                                   Style="width:140px;" />
                                    </div>
                                </SgStack>
                            }
                        </div>
                    </SgTabPanel>
                </SgTabs>
            </div>

            @* Response Panel *@
            <div style="flex:1 1 55%; min-height:280px; overflow:auto; background:var(--sg-bg);">
                <div style="padding:20px;">
                    <div style="margin-bottom:12px; font-size:14px; font-weight:600;">Response</div>
                    <SgHttpApiTesterResponsePanel Snapshot="_currentTab.LastResponse"
                                                  HasError="_hasError"
                                                  ErrorMessage="_errorMessage" />
                </div>
            </div>

        </div>
    </div>
</div>

@* ════════════════════════════════════════════════════════
     MODALS & DOCK WINDOWS
════════════════════════════════════════════════════ *@

@* Save Request Modal *@
<SgModal Title="Save Request" @bind-Visible="_saveModalOpen" Width="520px">
    <SgStack Orientation="SgOrientation.Vertical" Gap="16">
        <div>
            <div style="margin-bottom:6px; font-size:13px; font-weight:500; color:var(--sg-text-muted);">Request Name</div>
            <SgTextBox @bind-Value="_saveRequestName" 
                       Placeholder="My API Request" 
                       Size="SgSize.Lg"
                       Style="width:100%;" />
        </div>
        <div>
            <div style="margin-bottom:6px; font-size:13px; font-weight:500; color:var(--sg-text-muted);">Description (optional)</div>
            <SgTextArea @bind-Value="_saveRequestDescription" 
                        Rows="3" 
                        Placeholder="Optional description..." 
                        Style="width:100%;" />
        </div>
        <div>
            <div style="margin-bottom:6px; font-size:13px; font-weight:500; color:var(--sg-text-muted);">Collection</div>
            <SgSelect @bind-Value="_saveToCollectionId"
                      Items="_collections.Select(c => c.Id.ToString()).ToList()"
                      TextSelector="@GetCollectionNameById"
                      ValueSelector="@(id => id)"
                      Size="SgSize.Lg"
                      Style="width:100%;" />
        </div>
        <SgStack Orientation="SgOrientation.Horizontal" Gap="8" Justify="SgJustifyContent.End" Style="margin-top:8px;">
            <SgButton Variant="SgButtonVariant.Default" 
                      Size="SgSize.Lg"
                      OnClick="() => _saveModalOpen = false">
                Cancel
            </SgButton>
            <SgButton Variant="SgButtonVariant.Primary" 
                      Size="SgSize.Lg"
                      OnClick="SaveRequestToCollection">
                Save
            </SgButton>
        </SgStack>
    </SgStack>
</SgModal>

@* Environment Manager Modal *@
<SgModal Title="🌍 Environment Manager" @bind-Visible="_envModalOpen" Width="740px">
    <SgStack Orientation="SgOrientation.Vertical" Gap="16">
        <SgStack Orientation="SgOrientation.Horizontal" Gap="12">
            <div style="flex:1;">
                <div style="margin-bottom:6px; font-size:13px; font-weight:500; color:var(--sg-text-muted);">Select Environment</div>
                <SgSelect TValue="string" TItem="string"
                          @bind-Value="_editEnvName"
                          Items="_environments.Select(e => e.Name).ToList()"
                          TextSelector="@((Func<string, string>)(n => n))"
                          ValueSelector="@((Func<string, string>)(n => n))"
                          Size="SgSize.Lg"
                          Style="width:100%;" />
            </div>
            <div style="align-self:flex-end;">
                <SgButton Variant="SgButtonVariant.Default" 
                          Size="SgSize.Lg"
                          OnClick="CreateEnvironment">
                    + New
                </SgButton>
            </div>
            <div style="align-self:flex-end;">
                <SgButton Variant="SgButtonVariant.Danger" 
                          Size="SgSize.Lg"
                          OnClick="DeleteEnvironment">
                    🗑 Delete
                </SgButton>
            </div>
        </SgStack>
        @{
            var editEnv = _environments.FirstOrDefault(e => e.Name == _editEnvName);
        }
        @if (editEnv is not null)
        {
            <div style="margin-top:8px;">
                <div style="margin-bottom:12px; font-size:14px; font-weight:600;">Environment Variables</div>
                <SgHttpApiTesterKvEditor Items="editEnv.Variables" ShowComment="true" />
            </div>
        }
        <SgStack Orientation="SgOrientation.Horizontal" Gap="8" Justify="SgJustifyContent.End" Style="margin-top:8px;">
            <SgButton Variant="SgButtonVariant.Primary" 
                      Size="SgSize.Lg"
                      OnClick="() => _envModalOpen = false">
                Done
            </SgButton>
        </SgStack>
    </SgStack>
</SgModal>

@* cURL Import Modal *@
<SgModal Title="📥 Import from cURL" @bind-Visible="_curlImportOpen" Width="680px">
    <div style="margin-bottom:12px;">
        <div style="margin-bottom:8px; font-size:13px; font-weight:500; color:var(--sg-text-muted);">Paste cURL Command</div>
        <SgTextArea @bind-Value="_curlInput" 
                    Rows="10"
                    Style="font-family:monospace; font-size:13px; line-height:1.6; width:100%;"
                    Placeholder="curl -X POST 'https://api.example.com/data' \&#10;  -H 'Authorization: Bearer token' \&#10;  -d '{&quot;key&quot;:&quot;value&quot;}'" />
    </div>
    <SgStack Direction="SgDirection.Horizontal" Gap="8" Style="justify-content:flex-end; margin-top:12px;">
        <SgButton Variant="SgButtonVariant.Default" 
                  Size="SgSize.Lg"
                  OnClick="() => _curlImportOpen = false">
            Cancel
        </SgButton>
        <SgButton Variant="SgButtonVariant.Primary" 
                  Size="SgSize.Lg"
                  OnClick="ImportFromCurl">
            Import
        </SgButton>
    </SgStack>
</SgModal>

@code {
    /// <summary>Inline CSS style for the root element.</summary>
    [Parameter] public string? Style { get; set; }
    /// <summary>Additional CSS class for the root element.</summary>
    [Parameter] public string? Class { get; set; }

    private RequestTab _currentTab = new();
    private bool _isLoading = false;
    private bool _hasError = false;
    private string? _errorMessage;
    private string _searchText = "";

    private readonly string[] _methods = { "GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS" };
    private readonly List<SgSegmentedOption<string>> _bodyTypeOptions = new()
    {
        new() { Value = "JSON", Label = "JSON" },
        new() { Value = "XML", Label = "XML" },
        new() { Value = "Text", Label = "Text" },
        new() { Value = "Form", Label = "Form" },
        new() { Value = "None", Label = "None" }
    };
    private readonly string[] _authTypes = { "None", "Bearer Token", "Basic Auth", "API Key", "OAuth 2.0" };

    private List<Collection> _collections = new() { new Collection { Name = "My Collection" } };
    private List<HistoryEntry> _history = new();
    private List<SavedRequest> _snippets = new()
    {
        new SavedRequest
        {
            Name = "JSONPlaceholder — Get Posts",
            Description = "Fetch a list of demo posts.",
            Tab = new RequestTab
            {
