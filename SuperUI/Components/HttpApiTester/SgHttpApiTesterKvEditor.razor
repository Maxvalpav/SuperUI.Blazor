@namespace SuperUI.Components

@{
    var gridCols = ShowComment ? "32px 1fr 1fr 1fr 44px" : "32px 1fr 1fr 44px";
}

<div style="display:flex; flex-direction:column; gap:8px; width:100%;">

    @* Заголовки колонок *@
    <div style="display:grid; grid-template-columns:@gridCols; gap:10px; padding:6px 8px; align-items:center; background:var(--sg-bg-alt); border-radius:6px; border:1px solid var(--sg-border);">
        <span></span>
        <span style="font-size:11px; color:var(--sg-text-muted); font-weight:700; letter-spacing:0.5px;">KEY</span>
        <span style="font-size:11px; color:var(--sg-text-muted); font-weight:700; letter-spacing:0.5px;">VALUE</span>
        @if (ShowComment)
        {
            <span style="font-size:11px; color:var(--sg-text-muted); font-weight:700; letter-spacing:0.5px;">DESCRIPTION</span>
        }
        <span></span>
    </div>

    @if (!Items.Any())
    {
        <div style="padding:16px; text-align:center; color:var(--sg-text-muted); font-size:13px; border:1px dashed var(--sg-border); border-radius:6px;">
            No items. Click "+ Add Row" below.
        </div>
    }

    @for (int i = 0; i < Items.Count; i++)
    {
        var idx = i;
        var item = Items[idx];
        <div style="display:grid; grid-template-columns:@gridCols; gap:10px; align-items:center; padding:0 4px;">
            <div style="display:flex; justify-content:center;">
                <SgCheckBox @bind-Value="item.Enabled" />
            </div>
            <SgTextBox @bind-Value="item.Key"
                       Placeholder="key"
                       Style="@($"width:100%; opacity:{(item.Enabled ? 1 : 0.45)}")" />
            <SgTextBox @bind-Value="item.Value"
                       Placeholder="value"
                       Style="@($"width:100%; opacity:{(item.Enabled ? 1 : 0.45)}")" />
            @if (ShowComment)
            {
                <SgTextBox @bind-Value="item.Comment"
                           Placeholder="description"
                           Style="width:100%; opacity:0.7;" />
            }
            <SgButton Variant="SgButtonVariant.Danger"
                      Size="SgSize.Sm"
                      OnClick="() => Items.RemoveAt(idx)"
                      Style="width:44px; min-width:44px; padding:0;">✕</SgButton>
        </div>
    }

    <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; padding-top:12px; border-top:1px solid var(--sg-border);">
        <SgButton Variant="SgButtonVariant.Primary" Size="SgSize.Sm" OnClick="AddRow"
                  Style="min-width:110px;">
            + Add Row
        </SgButton>
        @if (Items.Any())
        {
            <SgButton Variant="SgButtonVariant.Default" Size="SgSize.Sm" OnClick="DisableAll"
                      Style="min-width:110px;">
                Disable All
            </SgButton>
            <SgButton Variant="SgButtonVariant.Default" Size="SgSize.Sm" OnClick="ClearAll"
                      Style="min-width:90px;">
                Clear
            </SgButton>
        }
        @if (AllowBulkPaste)
        {
            <SgButton Variant="SgButtonVariant.Default" Size="SgSize.Sm" OnClick="() => _pasteOpen = true"
                      Style="min-width:120px;">
                Bulk Paste
            </SgButton>
        }
    </div>

</div>

@* Bulk paste modal *@
<SgModal Title="Bulk Paste (key: value per line)"
         @bind-Visible="_pasteOpen"
         Width="480px">
    <SgTextArea @bind-Value="_bulkText" Rows="10"
                Placeholder="Content-Type: application/json&#10;Authorization: Bearer token123" />
    <SgStack Direction="SgDirection.Horizontal" Gap="6" Style="justify-content:flex-end; margin-top:8px;">
        <SgButton Variant="SgButtonVariant.Default" OnClick="() => _pasteOpen = false">Cancel</SgButton>
        <SgButton Variant="SgButtonVariant.Primary" OnClick="ApplyBulkPaste">Apply</SgButton>
    </SgStack>
</SgModal>

@code {
    [Parameter] public List<KvPair> Items { get; set; } = new();
    [Parameter] public bool ShowComment { get; set; } = true;
    [Parameter] public bool AllowBulkPaste { get; set; } = true;

    private bool _pasteOpen = false;
    private string _bulkText = "";

    private void AddRow() => Items.Add(new KvPair());
    private void DisableAll() => Items.ForEach(i => i.Enabled = false);
    private void ClearAll() => Items.Clear();

    private void ApplyBulkPaste()
    {
        foreach (var line in _bulkText.Split('\n', StringSplitOptions.RemoveEmptyEntries))
        {
            var idx = line.IndexOf(':');
            if (idx < 0) continue;
            Items.Add(new KvPair(line[..idx].Trim(), line[(idx + 1)..].Trim()));
        }
        _bulkText = "";
        _pasteOpen = false;
    }
}
