@namespace SuperUI.Components
@typeparam TValue where TValue : struct, IComparable<TValue>
@implements IDisposable
@inject ISuperUILocalizer Localizer

<div class="sgc-field @(Block ? "sgc-block" : "") @(LabelPosition == SgLabelPosition.Left ? "sgc-label-left" : LabelPosition == SgLabelPosition.Right ? "sgc-label-right" : "") @CssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sgc-label @(Required ? "sgc-required" : "")" for="@_id">@Label</label>
    }
    <div class="sgc-num @(IsInvalid ? "sgc-invalid" : "") @(Disabled ? "sgc-disabled" : "")">
        @if (ShowButtons)
        {
            <button type="button" class="sgc-num-btn" tabindex="-1"
                    aria-label="@Localizer["NumberInput_Decrement"]"
                    disabled="@Disabled" @onclick="StepDownAsync">−</button>
        }
        <input id="@_id"
               type="text"
               inputmode="decimal"
               class="sgc-num-input"
               value="@CurrentText"
               placeholder="@Placeholder"
               disabled="@Disabled"
               readonly="@ReadOnly"
               required="@Required"
               aria-required="@(Required ? "true" : null)"
               aria-invalid="@(IsInvalid ? "true" : null)"
               aria-describedby="@DescribedBy"
               aria-valuemin="@(Min.HasValue ? Convert.ToDouble(Min.Value) : null)"
               aria-valuemax="@(Max.HasValue ? Convert.ToDouble(Max.Value) : null)"
               aria-valuenow="@(Value.HasValue ? Convert.ToDouble(Value.Value) : null)"
               @oninput="OnInputAsync"
               @onchange="OnChangeAsync"
               @onkeydown="OnKeyDownAsync"
               @attributes="AdditionalAttributes" />
        @if (!string.IsNullOrEmpty(Suffix))
        {
            <span class="sgc-num-suffix">@Suffix</span>
        }
        @if (ShowButtons)
        {
            <button type="button" class="sgc-num-btn" tabindex="-1"
                    aria-label="@Localizer["NumberInput_Increment"]"
                    disabled="@Disabled" @onclick="StepUpAsync">+</button>
        }
    </div>
    @if (IsInvalid)
    {
        <span id="@_errorId" class="sgc-error">@DisplayedError</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span id="@_hintId" class="sgc-hint">@Hint</span>
    }
</div>

@code {
    private readonly string _id = "sg-" + Guid.NewGuid().ToString("N")[..8];
    private string _hintId => _id + "-hint";
    private string _errorId => _id + "-err";

    private SgEditContextBinder<TValue?>? _binder;

    [CascadingParameter] private EditContext? CascadedEditContext { get; set; }

    /// <summary>
    /// Gets or sets the current numeric value.
    /// </summary>
    [Parameter] public TValue? Value { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the value changes.
    /// </summary>
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }

    /// <summary>
    /// Gets or sets the expression that identifies the bound value for EditContext validation.
    /// </summary>
    [Parameter] public Expression<Func<TValue?>>? ValueExpression { get; set; }

    /// <summary>
    /// Gets or sets the minimum allowed value.
    /// </summary>
    [Parameter] public TValue? Min { get; set; }

    /// <summary>
    /// Gets or sets the maximum allowed value.
    /// </summary>
    [Parameter] public TValue? Max { get; set; }

    /// <summary>
    /// Gets or sets the increment/decrement step value. Default is 1.
    /// </summary>
    [Parameter] public TValue Step { get; set; } = OneOf();

    private static TValue OneOf()
    {
        try { return (TValue)Convert.ChangeType(1, typeof(TValue), CultureInfo.InvariantCulture); }
        catch { return default; }
    }

    /// <summary>
    /// Gets or sets the number format string (e.g., "N2", "C2").
    /// </summary>
    [Parameter] public string? Format { get; set; }

    /// <summary>
    /// Gets or sets the suffix text displayed after the input (e.g., "kg", "%").
    /// </summary>
    [Parameter] public string? Suffix { get; set; }

    /// <summary>
    /// Gets or sets the placeholder text shown when the input is empty.
    /// </summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>
    /// Gets or sets the label text displayed above the input.
    /// </summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// Gets or sets the position of the label. Default is Top.
    /// </summary>
    [Parameter] public SgLabelPosition LabelPosition { get; set; } = SgLabelPosition.Top;

    /// <summary>
    /// Gets or sets the hint text displayed below the input.
    /// </summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>
    /// Gets or sets the error text to display. Takes precedence over validation messages from EditContext.
    /// </summary>
    [Parameter] public string? ErrorText { get; set; }

    /// <summary>
    /// Gets or sets whether to show increment/decrement buttons. Default is true.
    /// </summary>
    [Parameter] public bool ShowButtons { get; set; } = true;

    /// <summary>
    /// Gets or sets whether the input is required.
    /// </summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>
    /// Gets or sets whether the input is disabled.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets whether the input is read-only.
    /// </summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>
    /// Gets or sets whether the input should take full width of its container. Default is true.
    /// </summary>
    [Parameter] public bool Block { get; set; } = true;

    /// <summary>
    /// Gets or sets whether value updates on input (true) or on change (false).
    /// </summary>
    [Parameter] public bool Immediate { get; set; }

    /// <summary>
    /// Gets or sets additional CSS class names to apply to the field container.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the input element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnInitialized()
    {
        _binder = new SgEditContextBinder<TValue?>(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        _binder?.Update(CascadedEditContext, ValueExpression);
    }

    private bool IsInvalid => !string.IsNullOrEmpty(ErrorText) || (_binder?.HasValidationErrors ?? false);
    private string? DisplayedError => !string.IsNullOrEmpty(ErrorText)
        ? ErrorText
        : _binder?.ValidationMessages.FirstOrDefault();
    private string? DescribedBy => IsInvalid
        ? _errorId
        : (!string.IsNullOrEmpty(Hint) ? _hintId : null);

    private string? CurrentText
    {
        get
        {
            if (Value is null) return string.Empty;
            if (!string.IsNullOrEmpty(Format))
                return string.Format(CultureInfo.CurrentCulture, "{0:" + Format + "}", Value.Value);
            return Convert.ToString(Value.Value, CultureInfo.CurrentCulture);
        }
    }

    private Task OnInputAsync(ChangeEventArgs e) => Immediate ? CommitAsync(e.Value?.ToString()) : Task.CompletedTask;
    private Task OnChangeAsync(ChangeEventArgs e) => !Immediate ? CommitAsync(e.Value?.ToString()) : Task.CompletedTask;

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (Disabled || ReadOnly) return;
        if (e.Key == "ArrowUp" || e.Key == "ArrowDown")
        {
            if (e.Key == "ArrowUp") await StepUpAsync();
            else await StepDownAsync();
        }
    }

    private Task StepUpAsync() => StepAsync(true);
    private Task StepDownAsync() => StepAsync(false);

    private async Task StepAsync(bool up)
    {
        if (Disabled || ReadOnly) return;
        var current = Value ?? default;
        var next = ApplyStep(current, up);
        next = Clamp(next);
        await SetAsync(next);
    }

    private async Task CommitAsync(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            await SetAsync(null);
            return;
        }
        var t = typeof(TValue);
        try
        {
            var parsed = (TValue)Convert.ChangeType(raw, t, CultureInfo.CurrentCulture);
            await SetAsync(Clamp(parsed));
        }
        catch
        {
            // ignore invalid input
        }
    }

    private async Task SetAsync(TValue? next)
    {
        if (EqualityComparer<TValue?>.Default.Equals(next, Value)) return;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(next);
        _binder?.NotifyFieldChanged();
    }

    private TValue Clamp(TValue v)
    {
        if (Min.HasValue && v.CompareTo(Min.Value) < 0) return Min.Value;
        if (Max.HasValue && v.CompareTo(Max.Value) > 0) return Max.Value;
        return v;
    }

    private TValue ApplyStep(TValue current, bool up)
    {
        var ci = CultureInfo.InvariantCulture;
        var c = Convert.ToDecimal(current, ci);
        var s = Convert.ToDecimal(Step, ci);
        var r = up ? c + s : c - s;
        return (TValue)Convert.ChangeType(r, typeof(TValue), ci);
    }

    public void Dispose() => _binder?.Dispose();
}
