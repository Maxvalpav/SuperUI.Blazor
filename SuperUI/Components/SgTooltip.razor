@namespace SuperUI.Components
@using SuperUI.Base.Services
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IZIndexService ZIndex

<span @ref="_triggerRef"
      class="sg-tooltip-trigger @CssClass"
      @onmouseenter="OnMouseEnterAsync"
      @onmouseleave="OnMouseLeaveAsync"
      @onfocus="OnFocusAsync"
      @onblur="OnBlurAsync"
      @onclick="OnClickAsync">
    @ChildContent
</span>

@if (_visible)
{
    <div @ref="_tooltipRef"
         class="sg-tooltip sg-tooltip--@PlacementString"
         style="@_tooltipStyle"
         role="tooltip">
        @Text
    </div>
}

@code {
    // ── Состояние ────────────────────────────────────────────────────────────────
    private ElementReference _triggerRef;
    private ElementReference _tooltipRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SgTooltip>? _self;
    private int  _disposed;    // Interlocked
    private bool _visible;
    private string _tooltipStyle = "";
    private int    _zIndex;
    private CancellationTokenSource? _delayCts;

    // ── Параметры ────────────────────────────────────────────────────────────────
    [Parameter, EditorRequired] public string Text { get; set; } = default!;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public SgPlacement     Placement    { get; set; } = SgPlacement.Top;
    [Parameter] public SgTrigger       Trigger      { get; set; } = SgTrigger.Hover;
    [Parameter] public int             OpenDelay    { get; set; }
    [Parameter] public int             CloseDelay   { get; set; }
    [Parameter] public bool            Disabled     { get; set; }
    [Parameter] public string?         CssClass     { get; set; }

    // ── Вспомогательные ──────────────────────────────────────────────────────────
    private bool IsDisposed => Volatile.Read(ref _disposed) == 1;

    private string PlacementString => Placement switch
    {
        SgPlacement.Bottom => "bottom",
        SgPlacement.Left   => "left",
        SgPlacement.Right  => "right",
        _                  => "top"
    };

    // ── Lifecycle ─────────────────────────────────────────────────────────────────
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsDisposed) return;
        if (!firstRender) return;

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "_content/SuperUI/superui-tooltip.js");
            if (IsDisposed) return;
            _self ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _triggerRef, _tooltipRef, PlacementString, _self);
        }
        catch (JSException) { }
        catch (TaskCanceledException) { }
        catch (JSDisconnectedException) { }
    }

    // ── Trigger handlers ──────────────────────────────────────────────────────────
    private Task OnMouseEnterAsync() => HandleTriggerAsync(SgTrigger.Hover, true);
    private Task OnMouseLeaveAsync() => HandleTriggerAsync(SgTrigger.Hover, false);
    private Task OnFocusAsync()      => HandleTriggerAsync(SgTrigger.Focus, true);
    private Task OnBlurAsync()       => HandleTriggerAsync(SgTrigger.Focus, false);
    private Task OnClickAsync()      => HandleTriggerAsync(SgTrigger.Click, !_visible);

    private Task HandleTriggerAsync(SgTrigger triggerType, bool show)
    {
        if (Trigger != triggerType) return Task.CompletedTask;
        return show ? ShowAsync() : HideAsync();
    }

    // ── ShowAsync ─────────────────────────────────────────────────────────────────
    public async Task ShowAsync()
    {
        if (IsDisposed || _visible || Disabled) return;
        CancelDelay();

        if (OpenDelay > 0)
        {
            _delayCts = new CancellationTokenSource();
            var token = _delayCts.Token;
            try
            {
                await Task.Delay(OpenDelay, token);
                await InvokeAsync(DoShowAsync);
            }
            catch (TaskCanceledException) { }
            return;
        }
        await DoShowAsync();
    }

    private async Task DoShowAsync()
    {
        _visible = true;
        // ИСПРАВЛЕНО: Allocate(int) вместо Allocate(this, SgZIndexService.TooltipBase)
        _zIndex = ZIndex.Allocate(ZIndexService.TooltipBase);
        _tooltipStyle = $"position:fixed;pointer-events:none;z-index:{_zIndex};opacity:0;transition:opacity 0.15s;";
        StateHasChanged();

        await Task.Yield(); // Дождаться рендера _tooltipRef
        try
        {
            if (_module is not null)
                await _module.InvokeVoidAsync("show", _triggerRef, _tooltipRef, PlacementString);
        }
        catch (JSException) { }
        catch (TaskCanceledException) { }
        catch (JSDisconnectedException) { }
    }

    // ── HideAsync ─────────────────────────────────────────────────────────────────
    public async Task HideAsync()
    {
        if (IsDisposed || !_visible) return;
        CancelDelay();

        if (CloseDelay > 0)
        {
            _delayCts = new CancellationTokenSource();
            var token = _delayCts.Token;
            try
            {
                await Task.Delay(CloseDelay, token);
                await InvokeAsync(DoHideAsync);
            }
            catch (TaskCanceledException) { }
            return;
        }
        await DoHideAsync();
    }

    private async Task DoHideAsync()
    {
        _visible = false;
        if (_zIndex > 0)
        {
            // ИСПРАВЛЕНО: Release(_zIndex) вместо Release(this)
            ZIndex.Release(_zIndex);
            _zIndex = 0;
        }
        try
        {
            if (_module is not null)
                await _module.InvokeVoidAsync("hide", _tooltipRef);
        }
        catch (JSException) { }
        catch (TaskCanceledException) { }
        catch (JSDisconnectedException) { }

        await InvokeAsync(StateHasChanged);
    }

    private void CancelDelay()
    {
        _delayCts?.Cancel();
        _delayCts?.Dispose();
        _delayCts = null;
    }

    [JSInvokable]
    public Task HideFromJsAsync() => HideAsync();

    // ── IAsyncDisposable ──────────────────────────────────────────────────────────
    public async ValueTask DisposeAsync()
    {
        if (Interlocked.Exchange(ref _disposed, 1) == 1) return;

        CancelDelay();
        if (_zIndex > 0)
        {
            ZIndex.Release(_zIndex);
            _zIndex = 0;
        }

        if (_module is not null)
        {
            try   { await _module.InvokeVoidAsync("detach"); }
            catch (JSException) { }
            catch (TaskCanceledException) { }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }

        var self = _self;
        _self = null;
        self?.Dispose();

        if (_module is not null)
        {
            try   { await _module.DisposeAsync(); }
            catch (JSException) { }
            catch (TaskCanceledException) { }
            catch (ObjectDisposedException) { }
            _module = null;
        }
    }
}
