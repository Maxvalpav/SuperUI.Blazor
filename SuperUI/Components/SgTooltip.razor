@namespace SuperUI.Components
@using SuperUI.Enums
@using SuperUI.Services
@inherits SgOverlayComponentBase

<span class="sgc-tt-wrap"
      @ref="RootRef"
      @onmouseenter="OnMouseEnterAsync"
      @onmouseleave="OnMouseLeaveAsync"
      @onfocus="OnFocusAsync"
      @onblur="OnBlurAsync"
      @onclick="OnClickAsync">
    @ChildContent
    @if (_visible)
    {
        <span class="sgc-tt" 
              @ref="_tooltipRef" 
              role="tooltip"
              aria-hidden="@(!_visible)"
              style="@_tooltipStyle">
            @Text
        </span>
    }
</span>

@code {
    private ElementReference _tooltipRef;
    private bool _visible;
    private string _tooltipStyle = "";

    private readonly SgDebouncer _showDebouncer = new();
    private readonly SgDebouncer _hideDebouncer = new();

    /// <summary>
    /// Gets or sets the tooltip text to display. Required.
    /// </summary>
    [Parameter, EditorRequired] public string Text { get; set; } = default!;
    
    /// <summary>
    /// Gets or sets the content that triggers the tooltip on hover.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    
    /// <summary>
    /// Gets or sets the preferred placement of the tooltip. Default is <see cref="SgPlacement.Top"/>.
    /// </summary>
    [Parameter] public SgPlacement Placement { get; set; } = SgPlacement.Top;

    /// <summary>
    /// Gets or sets the trigger behavior for the tooltip. Default is <see cref="SgTrigger.Hover"/>.
    /// </summary>
    [Parameter] public SgTrigger Trigger { get; set; } = SgTrigger.Hover;

    /// <summary>
    /// Gets or sets the delay in milliseconds before showing the tooltip.
    /// Default is 0 (no delay).
    /// </summary>
    [Parameter] public int OpenDelay { get; set; }

    /// <summary>
    /// Gets or sets the delay in milliseconds before hiding the tooltip.
    /// Default is 0 (no delay).
    /// </summary>
    [Parameter] public int CloseDelay { get; set; }

    /// <summary>
    /// Gets or sets whether the tooltip is disabled.
    /// Default is false.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    protected override string ModulePath => "./_content/SuperUI/superui-tooltip.js";
    protected override int    ZIndexBase => SgZIndexService.TooltipBase;

    private string PlacementString => Placement switch
    {
        SgPlacement.Bottom => "bottom",
        SgPlacement.Left   => "left",
        SgPlacement.Right  => "right",
        _                  => "top"
    };

    protected override async ValueTask OnInteractiveAsync()
    {
        await SafeInvokeVoidAsync("attach", RootRef, _tooltipRef,
            PlacementString, SelfRef);
    }

    protected override async ValueTask OnClosingAsync()
    {
        await SafeInvokeVoidAsync("detach");
    }

    private async Task OnMouseEnterAsync() => await HandleTriggerAsync(SgTrigger.Hover, true);
    private async Task OnMouseLeaveAsync() => await HandleTriggerAsync(SgTrigger.Hover, false);
    private async Task OnFocusAsync() => await HandleTriggerAsync(SgTrigger.Focus, true);
    private async Task OnBlurAsync() => await HandleTriggerAsync(SgTrigger.Focus, false);
    private async Task OnClickAsync() => await HandleTriggerAsync(SgTrigger.Click, !_visible);

    private async Task HandleTriggerAsync(SgTrigger triggerType, bool show)
    {
        if (Trigger != triggerType) return;
        if (show) await ShowAsync();
        else await HideAsync();
    }

    /// <summary>
    /// Manually shows the tooltip. For use when Trigger is "manual".
    /// </summary>
    public async Task ShowAsync()
    {
        if (IsDisposed || _visible || Disabled) return;
        _hideDebouncer.Cancel();
        if (OpenDelay > 0)
            await _showDebouncer.RunAsync(
                _ => InvokeAsync(DoShowAsync),
                TimeSpan.FromMilliseconds(OpenDelay));
        else
            await DoShowAsync();
    }

    private async Task DoShowAsync()
    {
        _visible = true;
        ZIndex.Allocate(this, ZIndexBase);
        _tooltipStyle = "position: fixed; pointer-events: none; opacity: 0; transition: opacity 0.15s;";

        StateHasChanged();

        // Wait for render to complete so _tooltipRef is populated
        await Task.Yield();

        await SafeInvokeVoidAsync("show", RootRef, _tooltipRef, PlacementString);
    }

    /// <summary>
    /// Manually hides the tooltip. For use when Trigger is "manual".
    /// </summary>
    public async Task HideAsync()
    {
        if (IsDisposed || !_visible) return;
        _showDebouncer.Cancel();
        if (CloseDelay > 0)
            await _hideDebouncer.RunAsync(
                _ => InvokeAsync(DoHideAsync),
                TimeSpan.FromMilliseconds(CloseDelay));
        else
            await DoHideAsync();
    }

    private async Task DoHideAsync()
    {
        _visible = false;
        ZIndex.Release(this);
        await SafeInvokeVoidAsync("hide", _tooltipRef);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task HideFromJsAsync() => HideAsync();

    protected override ValueTask OnDisposingAsync()
    {
        _showDebouncer.Dispose();
        _hideDebouncer.Dispose();
        ZIndex.Release(this);
        return base.OnDisposingAsync();
    }
}