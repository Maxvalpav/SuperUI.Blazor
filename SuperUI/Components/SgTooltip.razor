@namespace SuperUI.Components
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject SgZIndexService ZIndex

<span class="sgc-tt-wrap @CssClass" 
      @ref="_triggerRef"
      @onmouseenter="ShowAsync" 
      @onmouseleave="HideAsync"
      @onfocus="ShowAsync"
      @onblur="HideAsync">
    @ChildContent
</span>

@if (_visible)
{
    <SgPortal>
        <span class="sgc-tt" 
              @ref="_tooltipRef" 
              role="tooltip"
              aria-hidden="@(!_visible)"
              style="@_tooltipStyle">
            @Text
        </span>
    </SgPortal>
}

@code {
    private ElementReference _triggerRef;
    private ElementReference _tooltipRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SgTooltip>? _self;
    private bool _isDisposed;
    private bool _visible;
    private string _tooltipStyle = "";
    private int _zIndex;

    /// <summary>
    /// Gets or sets the tooltip text to display. Required.
    /// </summary>
    [Parameter, EditorRequired] public string Text { get; set; } = default!;
    
    /// <summary>
    /// Gets or sets the content that triggers the tooltip on hover.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    
    /// <summary>
    /// Gets or sets the preferred placement of the tooltip: "top", "bottom", "left", "right". Default is "top".
    /// </summary>
    [Parameter] public string Placement { get; set; } = "top";
    
    /// <summary>
    /// Gets or sets additional CSS classes to apply to the component.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isDisposed || !_visible) return;

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/_content/SuperUI/superui-tooltip.js");
            if (_isDisposed) return;

            _self ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _triggerRef, _tooltipRef, Placement, _self);
        }
        catch (JSException) { }
        catch (TaskCanceledException) { }
    }

    private async Task ShowAsync()
    {
        if (_isDisposed || _visible) return;
        
        _visible = true;
        _zIndex = ZIndex.Allocate(this, SgZIndexService.TooltipBase);
        _tooltipStyle = $"position: fixed; pointer-events: none; z-index: {_zIndex}; opacity: 0; transition: opacity 0.15s;";
        
        StateHasChanged();
        
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/_content/SuperUI/superui-tooltip.js");
            if (_isDisposed) return;
            await _module.InvokeVoidAsync("show", _triggerRef, _tooltipRef, Placement);
        }
        catch (JSException) { }
        catch (TaskCanceledException) { }
    }

    private async Task HideAsync()
    {
        if (_isDisposed || !_visible) return;
        
        _visible = false;
        
        if (_zIndex > 0)
        {
            ZIndex.Release(this);
            _zIndex = 0;
        }
        
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("hide", _tooltipRef);
            }
            catch (JSException) { }
            catch (TaskCanceledException) { }
        }
        
        StateHasChanged();
    }

    [JSInvokable]
    public Task HideFromJsAsync() => HideAsync();

    public async ValueTask DisposeAsync()
    {
        if (_isDisposed) return;
        _isDisposed = true;

        if (_zIndex > 0)
        {
            ZIndex.Release(this);
            _zIndex = 0;
        }

        var self = _self;
        _self = null;
        self?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("detach");
                await _module.DisposeAsync();
            }
            catch (JSException) { }
            catch (TaskCanceledException) { }
            catch (ObjectDisposedException) { }
        }
    }
}
