<?xml version="1.0" encoding="utf-8" ?>
<!--
  SuperUI.TrimmerRoots.xml
  ILLink roots — защищают reflection-based код от удаления при trimming.
  Включено в SuperUI.csproj через:
    <TrimmerRootDescriptor Include="SuperUI.TrimmerRoots.xml" />
-->
<linker>
  <!-- Preserve attribute types themselves -->
  <assembly fullname="SuperUI">
    <type fullname="SuperUI.Base.Optimization.SgPreserveAttribute" preserve="all" />
    <type fullname="SuperUI.Base.Optimization.SgComponentAttribute" preserve="all" />
    <type fullname="SuperUI.Base.Optimization.SgConverterAttribute" preserve="all" />

    <!-- Reactive: signals, effects, computed (reflection used by SgEffect/SgComputed) -->
    <type fullname="SuperUI.Base.Reactive.SgSignalBase" preserve="all" />
    <type fullname="SuperUI.Base.Reactive.SgSignal`1" preserve="all" />
    <type fullname="SuperUI.Base.Reactive.SgComputedBase" preserve="all" />
    <type fullname="SuperUI.Base.Reactive.SgComputed`1" preserve="all" />
    <type fullname="SuperUI.Base.Reactive.SgEffect" preserve="all" />
    <type fullname="SuperUI.Base.Reactive.ComponentSignalTracker" preserve="all" />

    <!-- Component infrastructure -->
    <type fullname="SuperUI.Base.SgComponentBase" preserve="all" />
    <type fullname="SuperUI.Base.SgComponentBase`1" preserve="all" />

    <!-- Converters (used via reflection in SgConverterService) -->
    <type fullname="SuperUI.Base.Converters.ISgConverter" preserve="all" />
    <type fullname="SuperUI.Base.Converters.SgConverter`1" preserve="all" />

    <!-- Services (DI + reflection) -->
    <type fullname="SuperUI.Base.Services.IComponentOptionsService" preserve="all" />
    <type fullname="SuperUI.Base.Services.ComponentOptionsService" preserve="all" />

    <!-- Diagnostics (reflects over components in DEBUG) -->
    <type fullname="SuperUI.Base.Diagnostics.ComponentDiagnostics" preserve="all" />
    <type fullname="SuperUI.Base.Diagnostics.ISgDiagnosticsCollector" preserve="all" />
  </assembly>
</linker>
