{
  "name": "superui",
  "version": "1.4.1",
  "private": true,
  "description": "Build tooling for SuperUI Blazor component library",
  "scripts": {
    "css:autoprefix": "postcss \"SuperUI/wwwroot/**/*.css\" --dir SuperUI/wwwroot --no-map --replace",
    "css:minify": "csso -i SuperUI/wwwroot/superui-components.css -o SuperUI/wwwroot/superui-components.css --comments none",
    "build:css": "npm run css:autoprefix && npm run css:minify"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 major versions",
    "not dead",
    "not op_mini all"
  ]
}
